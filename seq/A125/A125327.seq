%N A125327 Number of base 17 circular n-digit numbers with adjacent digits differing by 3 or less.
%C A125327 Empirical: a(base,n) = a(base-1,n) + A025012(n+1) for base >= 3*floor(n/2) + 1.
%H A125327 Rafał Wiktorowicz, <a href="/A125327/b125327.txt">Table of n, a(n) for n = 0..200</a>
%H A125327 OEIS Wiki, <a href="/wiki/Number_of_base_k_circular_n-digit_numbers_with_adjacent_digits_differing_by_d_or_less">Number of base k circular n-digit numbers with adjacent digits differing by d or less</a>
%H A125327 <a href="/index/Rec#order_15">Index entries for linear recurrences with constant coefficients</a>, signature (17,-91,91,540,-966,-1256,2422,1426,-2638,-845,1379,249,-327,-27,27).
%F A125327 From _Rafał Wiktorowicz_, Aug 05 2026: (Start)
%F A125327 a(n) = 17*a(n-1) - 91*a(n-2) + 91*a(n-3) + 540*a(n-4) - 966*a(n-5) - 1256*a(n-6) + 2422*a(n-7) + 1426*a(n-8) - 2638*a(n-9) - 845*a(n-10) + 1379*a(n-11) + 249*a(n-12) - 327*a(n-13) - 27*a(n-14) + 27*a(n-15) for n >= 16.
%F A125327 G.f.: (1 - 91*x^2 + 182*x^3 + 1620*x^4 - 3864*x^5 - 6280*x^6 + 14532*x^7 + 9982*x^8 - 21104*x^9 - 7605*x^10 + 13790*x^11 + 2739*x^12 - 3924*x^13 - 351*x^14 + 378*x^15) / (1 - 17*x + 91*x^2 - 91*x^3 - 540*x^4 + 966*x^5 + 1256*x^6 - 2422*x^7 - 1426*x^8 + 2638*x^9 + 845*x^10 - 1379*x^11 - 249*x^12 + 327*x^13 + 27*x^14 - 27*x^15). (End)
%o A125327 (S/R) stvar $[N]:(0..M-1) init $[]:=0 asgn $[]->{*} kill +[i in 0..N-1](($[i]`-$[(i+1)mod N]`>3)+($[(i+1)mod N]`-$[i]`>3))
