%e A325279                                          (5211)   (6211)     (4331)
%e A325279                                          (32211)  (33211)    (4421)
%e A325279                                          (33111)  (42211)    (5411)
%e A325279                                                   (2221111)  (6221)
%e A325279                                                              (6311)
%e A325279                                                              (7211)
