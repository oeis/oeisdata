%I A325515 #12 Nov 04 2026 19:42:05
%S A325515 0,0,1,2,3,5,8,11,14,22,29,37,50,63,81,106,129,160,203,246,303,373,
%T A325515 449,541,654,782,932,1116,1322,1559,1848,2167,2537,2978,3470,4041,
%U A325515 4706,5449,6303,7291,8402,9665,11117,12744,14592,16708,19062,21730,24757,28141
%N A325515 Sum of sums of omegas of the parts over all strict integer partitions of n.
%C A325515 Also omega of the product of products of parts over all strict integer partitions of n.
%C A325515 The omega of n is A001222(n), the number of prime factors of n counted with multiplicity.
%H A325515 Vladeta Jovovic, <a href="/A325515/b325515.txt">Table of n, a(n) for n = 0..10000</a>
%F A325515 a(n) = A001222(A325504(n)).
%F A325515 a(n) = (1/2)*Sum_{k=1..n} A000005(k)*A001222(k)*(q(n-k) - 2*q(n-2*k)), where q(m) = A000009(m) for m >= 0 and q(m) = 0 for m < 0. - _Vladeta Jovovic_, Nov 04 2026
%p A325515 b:= proc(n, i) option remember; `if`(i*(i+1)/2<n, 0, `if`(n=0, [1, 0],
%p A325515       b(n, i-1)+(p-> p+[0, p[1]*numtheory[bigomega](i)])(b(n-i, min(n-i, i-1)))))
%p A325515     end:
%p A325515 a:= n-> b(n$2)[2]:
%p A325515 seq(a(n), n=0..49);  # _Alois P. Heinz_, Nov 04 2026
%t A325515 Table[Sum[Total[PrimeOmega/@s],{s,Select[IntegerPartitions[n],UnsameQ@@#&]}],{n,0,30}]
%Y A325515 Cf. A000005, A000009, A001222, A003963, A015716, A015723, A022629, A056239, A066189, A112798, A147655, A246867, A325504, A325506.
%K A325515 nonn,changed
%O A325515 0,4
