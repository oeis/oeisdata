%N A090782 Numbers that can be expressed as the difference of the squares of primes in just three distinct ways.
%H A090782 Robert Israel, <a href="/A090782/b090782.txt">Table of n, a(n) for n = 1..10000</a>
%e A090782 120 = 13^2-7^2 = 17^2-13^2 = 31^2-29^2.
%p A090782 f:= proc(n)
%p A090782    nops(select(d -> d^2 > n and (d-n/d)::even and isprime((d + n/d)/2) and isprime((d - n/d)/2),
%p A090782      NumberTheory:-Divisors(n)))
%p A090782 end proc:
%p A090782 select(f=3, [$1..11000]); # _Robert Israel_, Nov 12 2026
