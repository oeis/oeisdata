%S A090618 0,0,0,0,0,0,1,1,1,2,2,2,2,2,2,3,3,3,4,4,4,4,4,4,5,5,5,6,6,6,7,7,7,7,
%T A090618 7,7,8,8,8,9,9,9,9,9,9,10,10,10,11,11,11,11,11,11,13,13,13,13,13,13,
%U A090618 14,14,14,15,15,15,15,15,15,16,16,16,17,17,17,17,17,17,18,18,18,20,20,20,20
%N A090618 Exponent of highest power of 9 dividing n!.
%H A090618 Amiram Eldar, <a href="/A090618/b090618.txt">Table of n, a(n) for n = 0..10000</a>
%F A090618 a(n) = A090622(n, 9) = floor(A054861(n)/2) = floor(floor(n/3) + floor(n/9) + floor(n/27) + floor(n/81) + ...)/2.
%e A090618 a(9) = 2 since 9! = 362880 = 9^2*4480.
%t A090618 IntegerExponent[Range[0,90]!,9] (* _Harvey P. Dale_, Jun 07 2016 *)
%t A090618 (* Alternative: *)
%t A090618 a[n_] := Floor[(n - DigitSum[n, 3])/4]; Array[a, 100, 0] (* _Amiram Eldar_, Sep 28 2026 *)
%o A090618 (PARI) a(n) = (n - sumdigits(n, 3)) \ 4; \\ _Amiram Eldar_, Sep 28 2026
%Y A090618 Cf. A011371, A054861, A090616, A027868, A054896, A090617.
%K A090618 nonn,easy,changed
%O A090618 0,10
