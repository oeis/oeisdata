%I A359978 #24 Sep 04 2026 01:13:45
%S A359978 13,17,31,37,71,73,79,97,113,127,131,149,157,163,173,181,191,197,199,
%T A359978 271,277,311,313,317,331,337,359,367,373,379,397,419,479,491,571,577,
%U A359978 593,617,631,673,719,727,733,739,757,761,787,797,811,839,877,911,919,937
%N A359978 Prime numbers whose decimal representation can be split into two nonempty parts without leading 0, say x and y (in that order), and such that the concatenation of y and x yields a different prime number.
%H A359978 Robert Israel, <a href="/A359978/b359978.txt">Table of n, a(n) for n = 1..10000</a>
%H A359978 Rémy Sigrist, <a href="/A359978/a359978.gp.txt">PARI program</a>
%e A359978 The first terms, alongside the corresponding other prime numbers, are:
%e A359978   n   a(n)  Other prime numbers
%e A359978   --  ----  -------------------
%e A359978    1    13  {31}
%e A359978    2    17  {71}
%e A359978    3    31  {13}
%e A359978    4    37  {73}
%e A359978    5    71  {17}
%e A359978    6    73  {37}
%e A359978    7    79  {97}
%e A359978    8    97  {79}
%e A359978    9   113  {131, 311}
%e A359978   10   127  {271}
%e A359978   11   131  {113, 311}
%e A359978   12   149  {491}
%p A359978 f:= proc(n) local k,a,b,m;
%p A359978   if not isprime(n) then return false fi;
%p A359978   for k from 1 to ilog10(n) do
%p A359978     b:= n mod 10^k;
%p A359978     if b < 10^(k-1) then next fi;
%p A359978     a:= (n-b)/10^k;
%p A359978     m:= b*10^(1+ilog10(a))+a;
%p A359978     if isprime(m) and m <> n then return true fi;
%p A359978   od;
%p A359978   false
%p A359978 end proc:
%p A359978 select(f, [seq(i,i=13..1000,2)]); # _Robert Israel_, Sep 03 2026
%o A359978 (PARI) \\ See Links section.
%o A359978 (Python)
%o A359978 from sympy import isprime
%o A359978 def ok(n):
%o A359978     if not isprime(n): return False
%o A359978     s = str(n)
%o A359978     return any(isprime(int(r)) for i in range(1, len(s)) if s[i]!='0' and (r:=s[i:]+s[:i])!=s)
%o A359978 print([k for k in range(940) if ok(k)]) # _Michael S. Branicky_, Sep 03 2026
