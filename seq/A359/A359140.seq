%N A359140 Expansion of g.f. (1+z+z^2-sqrt(1+2*z-z^2-6*z^3-3*z^4))/(2*z^2*(1+z)).
%H A359140 Robert Israel, <a href="/A359140/b359140.txt">Table of n, a(n) for n = 0..4192</a>
%H A359140 Naiomi T. Cameron and Asamoah Nkwanta, <a href="https://www.ams.org/journals/notices/202302/rnoti-p231.pdf">Riordan matrices and lattice path enumeration</a>, Notices Amer. Math. Soc., 70:2 (2023), 231-243.
%F A359140 D-finite with recurrence: (3 + 3*n)*a(n) + (18 + 9*n)*a(n + 1) + (19 + 7*n)*a(2 + n) + (-7 - n)*a(n + 3) + (-18 - 3*n)*a(n + 4) + (-7 - n)*a(n + 5) = 0. - _Robert Israel_, Nov 11 2026
%p A359140 with(gfun):
%p A359140 g:= (1+z+z^2-sqrt(1+2*z-z^2-6*z^3-3*z^4))/(2*z^2*(1+z)):
%p A359140 eq:= map(t -> t^2, isolate(g=y, sqrt(1+2*z-z^2-6*z^3-3*z^4))):
%p A359140 de:= algeqtodiffeq(eq, y(z)):
%p A359140 rec:= diffeqtorec(de, y(z), a(n)):
%p A359140 f:= rectoproc(rec,a(n),remember):
%p A359140 map(f, [$0..50]); # _Robert Israel_, Nov 11 2026
%t A359140 CoefficientList[Series[(1+z+z^2-Sqrt[1+2*z-z^2-6*z^3-3*z^4])/(2*z^2*(1+z)),{z,0,47}],z] (* _Stefano Spezia_, Sep 05 2025 *)
