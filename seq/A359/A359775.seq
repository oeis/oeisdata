%N A359775 Positions of odd terms in A359773, where A359773 is the Dirichlet inverse of A356163.
%H A359775 Robert Israel, <a href="/A359775/b359775.txt">Table of n, a(n) for n = 1..10000</a>
%p A359775 A356163:= proc(n) option remember; local t;
%p A359775   add(t[1]*t[2],t=ifactors(n)[2])+1 mod 2
%p A359775 end proc:
%p A359775 A358773:= proc(n) option remember; local d;
%p A359775       - add(procname(d)*A356163(n/d),d=NumberTheory:-Divisors(n) minus {n})
%p A359775 end proc:
%p A359775 A358773(1):= 1:
%p A359775 select(t -> A358773(t)::odd, [$1..300]); # _Robert Israel_, Oct 29 2026
%o A359775 (PARI) isA359775(n) = A359774(n);
