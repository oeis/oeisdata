%I A359512 #18 Oct 30 2026 00:12:58
%S A359512 1,1,2,3,3,4,4,4,4,4,4,4,3,4,3,4,4,3,4,3,1,4,2,4,4,2,4,3,2,4,1,3,1,0,
%T A359512 4,2,3,4,2,4,2,1,4,2,3,2,0,4,1,1,3,0,1,0,0,4,2,3,3,2,4,2,1,4,1,2,1,0,
%U A359512 4,2,2,3,0,2,0,0,4,1,1,1,0,3,0,0,1,0,0,0,0,4,2,3,3
%N A359512 Number of partitions of n into at most 3 positive Fibonacci numbers (with a single type of 1).
%C A359512 From _Robert Israel_, Oct 29 2026: (Start)
%C A359512 a(n) <= 4, with equality in the following cases:
%C A359512     F(n) = F(n-1) + F(n-2) = F(n-1) + F(n-3) + F(n-4) = 2*F(n-2)+F(n-3).
%C A359512     F(n) + F(n-2) = F(n-1) + 2*F(n-2) = F(n) + F(n-3) + F(n-4) = 2*F(n-1) + F(n-4).
%C A359512     F(n) + F(n-3) = 2*F(n-1) = F(n-1) + F(n-2) + F(n-3) = F(n) + F(n-4) + F(n-5).
%C A359512     F(n) + F(n-4) = F(n) + F(n-5) + F(n-6) = F(n-1) + F(n-2) + F(n-4) = 3*F(n-2).
%C A359512     F(n) + F(n-5) = F(n) + F(n-6) + F(n-7) = F(n-1) + F(n-2) + F(n-5) = F(n-1) + 2*F(n-3). (End)
%H A359512 Robert Israel, <a href="/A359512/b359512.txt">Table of n, a(n) for n = 0..10000</a>
%F A359512 a(n) = Sum_{k=0..3} A319394(n,k). - _Alois P. Heinz_, Jan 03 2023
%p A359512 N:= 200: fibs:= [seq(combinat:-fibonacci(i),i=2..ceil(log[(1+sqrt(5))/2](N)))]:
%p A359512 V:= Array(0..N):
%p A359512 V[0]:= 1:
%p A359512 for i from 1 to nops(fibs) do
%p A359512   V[fibs[i]]:= V[fibs[i]]+1;
%p A359512   for j from 1 to i do
%p A359512     v:= fibs[i] + fibs[j];
%p A359512     if v > N then break fi;
%p A359512     V[v]:= V[v]+1;
%p A359512     for k from 1 to j do
%p A359512       v:= fibs[i]+fibs[j]+fibs[k];
%p A359512       if v > N then break fi;
%p A359512       V[v]:= V[v]+1
%p A359512 od od od:
%p A359512 convert(V,list); # _Robert Israel_, Oct 29 2026
%Y A359512 Cf. A000045, A003107, A319394, A319396, A359511, A359513, A359515.
%K A359512 nonn,changed
%O A359512 0,3
%A A359512 _Ilya Gutkovskiy_, Jan 03 2023
