%t A371739 Table[32^n - Binomial[5*n, 1+n] * Hypergeometric2F1[1, 1 - 4*n, 2+n, -1], {n, 0, 20}] (* _Vaclav Kotesovec_, Apr 05 2024 *)
%o A371739 (PARI) a(n) = sum(k=0, n, binomial(5*n, k));
