%I A371517 #20 Oct 08 2026 00:01:22
%S A371517 1,4,26,188,1459,11892,100444,871528,7722557,69590628,635807180,
%T A371517 5876094308,54836925779,516029817620,4891147100886,46653935716492,
%U A371517 447490869463145,4313492172957396,41763413498670702,405968522259130636,3960526930400038404
%N A371517 G.f. A(x) satisfies A(x) = (1 + x*A(x) / (1-x))^4.
%H A371517 Robert Israel, <a href="/A371517/b371517.txt">Table of n, a(n) for n = 0..980</a>
%F A371517 a(n) = 4 * Sum_{k=0..n} binomial(n-1,n-k) * binomial(4*k+3,k)/(3*k+4) = Sum_{k=0..n} binomial(n-1,n-k) * binomial(4*k+4,k)/(k+1).
%F A371517 G.f.: A(x) = B(x)^4 where B(x) is the g.f. of A349331.
%F A371517 D-finite with recurrence: -283*n*(n + 2)*(n + 1)*a(n) + 12*(73*n + 251)*(n + 2)*(n + 1)*a(n + 1) - 6*(n + 2)*(155*n^2 + 1213*n + 2384)*a(n + 2) + 4*(n + 4)*(91*n^2 + 824*n + 1869)*a(n + 3) - 3*(n + 5)*(3*n + 14)*(3*n + 16)*a(n + 4) = 0. - _Robert Israel_, Oct 07 2026
%p A371517 with(gfun):
%p A371517 eq:= numer(-y + (1+x*y/(1-x))^4):
%p A371517 de:= algeqtodiffeq(eq,y(x)):
%p A371517 rec:= diffeqtorec(de,y(x),a(n)):
%p A371517 f:= rectoproc(rec,a(n),remember):
%p A371517 map(f, [$0..30]); # _Robert Israel_, Oct 07 2026
%o A371517 (PARI) a(n) = 4*sum(k=0, n, binomial(n-1, n-k)*binomial(4*k+3, k)/(3*k+4));
%Y A371517 Cf. A045868, A371516, A371520, A371521.
%Y A371517 Cf. A349331, A371483, A371518.
%Y A371517 Cf. A371486.
%K A371517 nonn,changed
%O A371517 0,2
