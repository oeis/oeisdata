%I A371903 #48 Nov 17 2026 09:13:00
%S A371903 0,1,3,5,15,44,134,427,1408,4753,16321,56812,200046,711425,2551886,
%T A371903 9222147,33544682,122712465,451169747,1666248405,6178586630,
%U A371903 22994275870,85859249486,321562877934,1207665205311,4547078084804,17160814017810,64906293058915,245986431195699
%N A371903 Total number of levels in all Dyck paths of semilength n containing exactly 2 path nodes.
%H A371903 Alois P. Heinz, <a href="/A371903/b371903.txt">Table of n, a(n) for n = 0..1000</a>
%H A371903 Wikipedia, <a href="https://en.wikipedia.org/wiki/Lattice_path#Counting_lattice_paths">Counting lattice paths</a>
%F A371903 G.f.: Sum_{k>=0} (x*C(x)+sqrt(x)*U_{k-1}(1/(2*sqrt(x))) / U_k(1/(2*sqrt(x)))) / U_k(1/(2*sqrt(x)))^2, where C(x) is the Catalan g.f. and U_k(x) are Chebyshev polynomials of the second kind. - _Alois P. Heinz_, Nov 17 2026
%e A371903 a(3) = 3 + 2 + 0 + 0 + 0 = 5:
%e A371903    1
%e A371903   _2   /\      _2           1           1
%e A371903   _2  /  \      3  /\/\     3  /\       3    /\     3
%e A371903   _2 /    \    _2 /    \    3 /  \/\    3 /\/  \    4 /\/\/\    .
%p A371903 g:= proc(x, y, p) (h-> `if`(x=0, add(`if`(coeff(h, z, i)=2, 1, 0),
%p A371903       i=0..degree(h)), b(x, y, h)))(p+`if`(coeff(p, z, y)<3, z^y, 0))
%p A371903     end:
%p A371903 b:= proc(x, y, p) option remember; `if`(y+2<=x,
%p A371903       g(x-1, y+1, p), 0)+`if`(y>0, g(x-1, y-1, p), 0)
%p A371903     end:
%p A371903 a:= n-> g(2*n, 0$2):
%p A371903 seq(a(n), n=0..18);
%p A371903 # Alternative:
%p A371903 nn:= 28:  # number of terms
%p A371903 C:= (1-sqrt(1-4*x))/(2*x): U:= ChebyshevU: f:= 1/(2*sqrt(x)):
%p A371903 gf:= add((x*C+sqrt(x)*U(k-1, f)/U(k, f))/U(k, f)^2, k=0..nn):
%p A371903 gfun[seriestolist](series(gf, x, 1+nn))[];  # _Alois P. Heinz_, Nov 17 2026
%Y A371903 Column k=2 of A371928.
%Y A371903 Cf. A000108, A008312, A051485, A053117, A152880.
%K A371903 nonn,changed
%O A371903 0,3
