%S A371518 1,2,11,72,525,4104,33647,285526,2486809,22103726,199697284,
%T A371518 1828472914,16929944932,158246198836,1491210732346,14151603542612,
%U A371518 135130396860130,1297381593071890,12516650939119421,121281286192026308,1179769340479567499
%N A371518 G.f. A(x) satisfies A(x) = (1 + x*A(x)^2 / (1-x))^2.
%H A371518 Robert Israel, <a href="/A371518/b371518.txt">Table of n, a(n) for n = 0..980</a>
%F A371518 a(n) = 2 * Sum_{k=0..n} binomial(n-1,n-k) * binomial(4*k+1,k)/(3*k+2).
%F A371518 G.f.: A(x) = B(x)^2 where B(x) is the g.f. of A349331.
%F A371518 D-finite with recurrence: -283*n*(n + 2)*(n + 1)*a(n) + 2*(438*n + 1223)*(n + 2)*(n + 1)*a(n + 1) - 2*(n + 2)*(465*n^2 + 3046*n + 5012)*a(n + 2) + 2*(182*n^3 + 2039*n^2 + 7601*n + 9426)*a(n + 3) - 3*(n + 4)*(3*n + 14)*(3*n + 13)*a(n + 4) = 0. - _Robert Israel_, Oct 07 2026
%p A371518 with(gfun):
%p A371518 eq:= numer(-y + (1+x*y^2/(1-x))^2):
%p A371518 de:= algeqtodiffeq(eq,y(x)):
%p A371518 rec:= diffeqtorec(de,y(x),a(n)):
%p A371518 f:= rectoproc(rec,a(n),remember):
%p A371518 map(f, [$0..30]); # _Robert Israel_, Oct 07 2026
%o A371518 (PARI) a(n) = 2*sum(k=0, n, binomial(n-1, n-k)*binomial(4*k+1, k)/(3*k+2));
%Y A371518 Cf. A349331, A371483, A371517.
%Y A371518 Cf. A270386, A371523.
%K A371518 nonn,changed
%O A371518 0,2
