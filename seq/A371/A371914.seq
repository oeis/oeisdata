%I A371914 #14 Aug 11 2026 19:47:41
%S A371914 1,1,3,7,15,43,168,626,2005,6245,22266,87365,328727,1154975,4086410,
%T A371914 15464587,60368094,229327457,847539610,3174058754,12277874065,
%U A371914 47912709420,184171945435,701491726600,2700878181660,10556457650417,41330116314628
%N A371914 G.f. A(x) satisfies A(x) = 1 - x/A(x)^3 * (1 - A(x) - A(x)^5).
%H A371914 Robert Israel, <a href="/A371914/b371914.txt">Table of n, a(n) for n = 0..1627</a>
%H A371914 Robert Israel, <a href="/A371914/a371914.txt">Recurrence of order 13</a>
%F A371914 a(n) = (1/n) * Sum_{k=0..n} binomial(n,k) * binomial(2*n-5*k,n-k-1) for n > 0.
%F A371914 D-finite with recurrence of order 13 (see link). - _Robert Israel_, Aug 11 2026
%p A371914 with(gfun):
%p A371914 eq:= numer(-y + 1 - x/y^3 * (1 - y - y^5)):
%p A371914 de:= algeqtodiffeq(eq, y(x)):
%p A371914 rec:= diffeqtorec(subs(RootOf(_Z^2-_Z)=1, de), y(x), a(n)):
%p A371914 f:= rectoproc(rec, a(n), remember):
%p A371914 map(f, [$0..30]); # Robert Israel, Aug 11 2026
%o A371914 (PARI) a(n) = if(n==0, 1, sum(k=0, n, binomial(n, k)*binomial(2*n-5*k, n-k-1))/n);
%Y A371914 Cf. A349332, A367725, A371913, A371915.
%K A371914 nonn
%O A371914 0,3
%A A371914 _Seiichi Manyama_, Apr 12 2024
