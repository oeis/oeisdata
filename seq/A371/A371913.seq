%S A371913 1,1,2,0,-6,12,67,-152,-740,2296,9017,-35979,-113936,579516,1454975,
%T A371913 -9493390,-18317155,157178640,220172289,-2618995381,-2377680689,
%U A371913 43783556265,19149194005,-732638868460,16196837316,12246524817736,-5891297294673
%N A371913 G.f. A(x) satisfies A(x) = 1 - x/A(x)^4 * (1 - A(x) - A(x)^5).
%H A371913 Robert Israel, <a href="/A371913/b371913.txt">Table of n, a(n) for n = 0..1565</a>
%H A371913 Robert Israel, <a href="/A371913/a371913.txt">Recurrence of order 13</a>
%F A371913 a(n) = (1/n) * Sum_{k=0..n} binomial(n,k) * binomial(n-5*k,n-k-1) for n > 0.
%F A371913 D-finite with recurrence of order 13 (see link). - _Robert Israel_, Aug 11 2026
%p A371913 with(gfun):
%p A371913 eq:= numer(-y + 1 - x/y^4 * (1 - y - y^5)):
%p A371913 de:= algeqtodiffeq(eq,y(x)):
%p A371913 rec:= diffeqtorec(subs(RootOf(_Z^2-_Z)=1,de),y(x),a(n)):
%p A371913 f:= rectoproc(rec,a(n),remember):
%p A371913 map(f, [$0..30]); # _Robert Israel_, Aug 11 2026
%o A371913 (PARI) a(n) = if(n==0, 1, sum(k=0, n, binomial(n, k)*binomial(n-5*k, n-k-1))/n);
%Y A371913 Cf. A349332, A367725, A371914, A371915.
%Y A371913 Cf. A371889, A371890.
%K A371913 sign
%O A371913 0,3
