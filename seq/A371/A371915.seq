%S A371915 1,1,4,17,80,414,2289,13199,78306,474630,2926744,18304543,115837726,
%T A371915 740379722,4772461321,30989448116,202518745795,1330961476358,
%U A371915 8791022012712,58325109518331,388523983047285,2597516226459845,17423367396517210,117223205014488833
%N A371915 G.f. A(x) satisfies A(x) = 1 - x/A(x)^2 * (1 - A(x) - A(x)^5).
%H A371915 Robert Israel, <a href="/A371915/b371915.txt">Table of n, a(n) for n = 0..1167</a>
%H A371915 Robert Israel, <a href="/A371915/a371915.txt">Recurrence of order 12</a>
%F A371915 a(n) = (1/n) * Sum_{k=0..n} binomial(n,k) * binomial(3*n-5*k,n-k-1) for n > 0.
%F A371915 D-finite with recurrence of order 12 (see link). - _Robert Israel_, Aug 11 2026
%p A371915 with(gfun):
%p A371915 eq:= numer(-y + 1 - x/y^2 * (1 - y - y^5)):
%p A371915 de:= algeqtodiffeq(eq,y(x)):
%p A371915 rec:= diffeqtorec(subs(RootOf(_Z^2-_Z)=1,de),y(x),a(n)):
%p A371915 f:= rectoproc(subs(_C[0] = 17 + 397, rec),a(n),remember):
%p A371915 map(f, [$0..30]); # _Robert Israel_, Aug 11 2026
%o A371915 (PARI) a(n) = if(n==0, 1, sum(k=0, n, binomial(n, k)*binomial(3*n-5*k, n-k-1))/n);
%Y A371915 Cf. A349332, A367725, A371913, A371914.
%K A371915 nonn
%O A371915 0,3
%A A371915 _Seiichi Manyama_, Apr 12 2024
