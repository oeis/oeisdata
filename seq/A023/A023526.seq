%N A023526 Greatest exponent in prime-power factorization of prime(n)*prime(n-1) + 1; a(1) = 1.
%H A023526 Amiram Eldar, <a href="/A023526/b023526.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..2000 from Vincenzo Librandi)
%F A023526 a(n) = A051903(A023523(n)). - _Amiram Eldar_, Sep 22 2026
%t A023526 Join[{1},Max[Transpose[FactorInteger[Times@@#+1]][[2]]]&/@Partition[ Prime[ Range[80]],2,1]] (* _Harvey P. Dale_, Aug 15 2013 *)
%o A023526 (PARI) a(n) = if(n == 1, 1, vecmax(factor(prime(n-1)*prime(n)+1)[,2])); \\ _Amiram Eldar_, Sep 22 2026
