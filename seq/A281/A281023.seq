%N A281023 Partial sums of A067392.
%H A281023 Amiram Eldar, <a href="/A281023/b281023.txt">Table of n, a(n) for n = 1..10000</a>
%F A281023 a(n) = Sum_{i=1..n} A067392(i).
%F A281023 a(n) ~ (1/6 - 1/(Pi^2)) * n^3. - _Amiram Eldar_, Sep 07 2026
%t A281023 f[n_] := n*(n + 1)/2 - n*EulerPhi[n]/2; f[1] = 0; Accumulate[Array[f, 50]] (* _Amiram Eldar_, Sep 07 2026 *)
%o A281023 (Magma) [0] cat [&+[&+[h: h in [2..k] | GCD(h,k) ne 1]: k in [2..n]]: n in [2..100]];
%o A281023 (PARI) list(nmax) = {my(s = 0); print1(s, ", "); for(n = 2, nmax, s += n*(n + 1 - eulerphi(n))/2; print1(s, ", "));} \\ _Amiram Eldar_, Sep 07 2026
