%T A159054 186623,213443,272483,287123,412163,531523,551603,675683,695971,
%U A159054 742019,777923,927547,1065023,1081003,1120243,1127843,1165343,1192463,1327103,1553203,1695203,1954307
%N A159054 Members of A159053 which are not multiples of 3.
%H A159054 Chai Wah Wu, <a href="/A159054/b159054.txt">Table of n, a(n) for n = 1..589</a>
%F A159054 A159053 INTERSECT A001651. - _R. J. Mathar_, Apr 05 2009
%t A159054 lst={};Do[If[Mod[(Fibonacci[n-3]),n]==0,If[Mod[n,3]!=0,AppendTo[lst,n]]], {n,5*8!}];lst
%o A159054 (PARI) isok(k) = !(fibonacci(k-3) % k) && (k%3); \\ _Michel Marcus_, Oct 09 2025
%o A159054 (Python)
%o A159054 from itertools import count, islice
%o A159054 from oeis_sequences.OEISsequences import fibonacci_mod
%o A159054 def A159054_gen(): # generator of terms
%o A159054     for i in count(1):
%o A159054         if i%3 and not fibonacci_mod(i-3,i):
%o A159054             yield i
%o A159054 A159054_list = list(islice(A159054_gen(),20)) # _Chai Wah Wu_, Jul 24 2026
