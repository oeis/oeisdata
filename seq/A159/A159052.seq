%T A159052 29441477,30613277,39337157,52487381,56648369,109282169,113490317,
%U A159052 177944197,193194137,337788929,337929113,554553749,644317913,783269237,951612437,1143903917,1395844517,1411886297
%N A159052 Odd terms in A159051.
%H A159052 Chai Wah Wu, <a href="/A159052/b159052.txt">Table of n, a(n) for n = 1..67</a>
%t A159052 lst={};Do[If[Mod[(Fibonacci[n-2]),n]==0,If[OddQ[n],AppendTo[lst,n]]],{n,2,10^5}];lst
%t A159052 (* Alternative: *)
%t A159052 a = c = 0; b = 1; lst = {}; Do[c = a + b; If[ Mod[a, n] == 0 && OddQ@n, Print@n]; a = b; b = c, {n, 2, 10^5}] (* _Robert G. Wilson v_, Apr 05 2009 *)
%o A159052 (Python)
%o A159052 from itertools import count, islice, filterfalse
%o A159052 from oeis_sequences.OEISsequences import fibonacci_mod
%o A159052 def A159052_gen(startvalue=3): # generator of terms >= startvalue
%o A159052     return filterfalse(lambda i: fibonacci_mod(i-2,i), count(max(startvalue+(startvalue&1^1),3),2))
%o A159052 A159052_list = list(islice(A159052_gen(),5)) # _Chai Wah Wu_, Jul 24 2026
%Y A159052 Cf. A123976, A159051.
