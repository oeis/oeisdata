%I A159610 #19 Oct 18 2026 09:53:50
%S A159610 1,3,2,11,11,9,53,53,53,44,309,309,309,309,265,2119,2119,2119,2119,
%T A159610 2119,1854,16687,16687,16687,16687,16687,16687,14833,148329,148329,
%U A159610 148329,148329,148329,148329,148329,133496,1468457,1468457,1468457,1468457,1468457,1468457,1468457,1468457,1334961
%N A159610 Triangle read by rows: row n consists of n copies of A000255(n+1) followed by A000166(n+2).
%C A159610 n-th row sum gives A002469(n+4), related to the game of Mousetrap.
%F A159610 T(n,k) = A000255(n+1) for 0 <= k < n; T(n,n) = A000166(n+2).
%F A159610 Sum_{k=0..n} T(n,k) = n*A000255(n+1) + A000166(n+2) = A002469(n+4).
%e A159610 First few rows of the triangle:
%e A159610       1;
%e A159610       3,     2;
%e A159610      11,    11,     9;
%e A159610      53,    53,    53,    44;
%e A159610     309,   309,   309,   309,   265;
%e A159610    2119,  2119,  2119,  2119,  2119,  1854;
%e A159610   16687, 16687, 16687, 16687, 16687, 16687, 14833;
%e A159610   ...
%o A159610 (PARI) a255(n) = sum(k=0, n, (-1)^k*(n-k+1)*n!/k!); \\ A000255
%o A159610 a166(n) = n!*sum(k=0, n, (-1)^k/k!); \\ A000166
%o A159610 T(n, k) = if(k<n, a255(n+1), a166(n+2)); \\ 0 <= k <= n
%o A159610 for(n=0, 8, for(k=0, n, print1(T(n, k), ", "))) \\ _Alper Ferudun_, Oct 17 2026
%Y A159610 Cf. A002469, A000166, A000255.
%K A159610 nonn,tabl,changed
%O A159610 0,2
