%U A318451 2,2,1,3,1,1,4,1,2,2,1,1,7,1,1,2,2,1,2,1,1,4,2,1,2,1,2,1,1,3,4,3,1,2,1,1,3
%N A318451 The 2-adic valuation of A318450.
%H A318451 Antti Karttunen, <a href="/A318451/b318451.txt">Table of n, a(n) for n = 1..65537</a>
%F A318451 a(n) = A007814(A318450(n)).
%F A318451 From _Amiram Eldar_, Oct 23 2026: (Start)
%F A318451 Additive with a(2^e) = 0, and a(p^e) = A005187(e) for an odd prime p.
%F A318451 a(n) = A046645(A000265(n)).
%F A318451 a(n) = A046645(n) - A318455(n). (End)
%t A318451 f[p_, e_] := 2*e - DigitSum[e, 2]; f[2, e_] := 0; a[1] = 0; a[n_] := Plus @@ f @@@ FactorInteger[n]; Array[a, 100] (* _Amiram Eldar_, Oct 23 2026 *)
%o A318451 (PARI) A318451(n) = valuation(A318450(n),2); \\ Needs also code from A318450.
%o A318451 (PARI) a(n) = vecsum([if(f[1] == 2, 0, 2*f[2] - hammingweight(f[2])) | f<-factor(n)~]); \\ _Amiram Eldar_, Oct 23 2026
%Y A318451 Cf. A000265, A005187, A007814, A318450.
%Y A318451 Cf. also A046645, A317946, A318315, A318455.
%K A318451 nonn,changed
%O A318451 1,9
