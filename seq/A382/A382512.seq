%T A382512 1,196,1,16,132,34,420,96,1,38,182,350,1,588,1,308,615,46,1,160,924,
%U A382512 740,306,481,1,198,2002,1744,380,58,1,1605,1,62,3234,32,3640
%N A382512 Expansion of Sum_{p prime} x^p / (1 - x^p)^p.
%H A382512 Amiram Eldar, <a href="/A382512/b382512.txt">Table of n, a(n) for n = 1..10000</a>
%F A382512 a(n) = Sum_{p|n, p prime} binomial(n/p+p-2, p-1).
%t A382512 nmax = 65; CoefficientList[Series[Sum[x^Prime[k]/(1 - x^Prime[k])^Prime[k], {k, 1, nmax}], {x, 0, nmax}], x] // Rest
%t A382512 (* Alternative: *)
%t A382512 a[n_] := Sum[Binomial[n/p + p - 2, p - 1], {p, FactorInteger[n][[;; , 1]]}]; a[1] = 0; Array[a, 65] (* _Amiram Eldar_, Nov 03 2026 *)
%o A382512 (PARI) a(n) = vecsum([binomial(n/p + p - 2, p - 1) | p <- factor(n)[, 1]~]); \\ _Amiram Eldar_, Nov 03 2026
