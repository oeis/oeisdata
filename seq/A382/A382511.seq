%T A382511 115,1,196,1,136,72,156,43,249,1,193,97,246,1,357,1,263,165,279,1,436,
%U A382511 28,380,159,361,1,549,81,442,196,438,1,753,1,499,276,528,106
%N A382511 Expansion of Sum_{p prime} x^p / (1 - x^p)^3.
%H A382511 Amiram Eldar, <a href="/A382511/b382511.txt">Table of n, a(n) for n = 1..10000</a>
%F A382511 a(n) = Sum_{p|n, p prime} A000217(n/p).
%F A382511 a(n) = (A069359(n) + A322078(n)) / 2.
%t A382511 nmax = 65; CoefficientList[Series[Sum[x^Prime[k]/(1 - x^Prime[k])^3, {k, 1, nmax}], {x, 0, nmax}], x] // Rest
%t A382511 (* Alternative: *)
%t A382511 a[n_] := Sum[(n/p)*(n/p + 1)/2, {p, FactorInteger[n][[;; , 1]]}]; a[1] = 0; Array[a, 65] (* _Amiram Eldar_, Nov 03 2026 *)
%o A382511 (PARI) a(n) = vecsum([(n/p)*(n/p + 1)/2 | p <- factor(n)[, 1]~]); \\ _Amiram Eldar_, Nov 03 2026
