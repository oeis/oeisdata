%N A382513 Expansion of Sum_{p prime} p * x^p / (1 - p * x^p).
%H A382513 Amiram Eldar, <a href="/A382513/b382513.txt">Table of n, a(n) for n = 1..1000</a>
%F A382513 a(n) = Sum_{p|n, p prime} p^(n/p).
%t A382513 nmax = 45; CoefficientList[Series[Sum[Prime[k] x^Prime[k]/(1 - Prime[k] x^Prime[k]), {k, 1, nmax}], {x, 0, nmax}], x] // Rest
%t A382513 (* Alternative: *)
%t A382513 a[n_] := Sum[p^(n/p), {p, FactorInteger[n][[;; , 1]]}]; a[1] = 0; Array[a, 45] (* _Amiram Eldar_, Nov 03 2026 *)
%o A382513 (PARI) a(n) = vecsum([p^(n/p) | p <- factor(n)[, 1]~]); \\ _Amiram Eldar_, Nov 03 2026
