%I A382211 #21 Oct 29 2026 00:04:44
%S A382211 61,181,2557,98057,338323,8389141,48829699,536871757,1162268353,
%T A382211 2147484613,2199023257237,27368747340087430811,196525143636054676607,
%U A382211 4656612873077421210401,239072435917782732706099,1978419655679387077928203,9671406556917033397656301
%N A382211 Prime of the form p^q + q^r + r^p, for primes p, q and r.
%H A382211 Robert Israel, <a href="/A382211/b382211.txt">Table of n, a(n) for n = 1..283</a> (terms <= 10^600)
%e A382211 61=2^2+2^5+5^2, 181=2^2+2^7+7^2, 2557=3^3+3^7+7^3, 98057=5^5+5^7+7^5. The first prime constructed from three different primes is 338323=3^11+11^5+5^3.
%p A382211 N:= 10^50: # for terms < N
%p A382211 R:= NULL:
%p A382211 p:= 1:
%p A382211 do
%p A382211   p:= nextprime(p);
%p A382211   if 2^p > N then break fi;
%p A382211   q:= 1;
%p A382211   do
%p A382211     q:= nextprime(q);
%p A382211     if p^q > N then break fi;
%p A382211     r:= 1;
%p A382211     do
%p A382211       r:= nextprime(r);
%p A382211       v:= p^q + q^r + r^p;
%p A382211       if v > N then break fi;
%p A382211       if isprime(v) then
%p A382211         R:= R,v;
%p A382211       fi
%p A382211 od od od:
%p A382211 sort(convert({R},list)); # _Robert Israel_, Oct 28 2026
%Y A382211 Subsequence of A123207.
%K A382211 nonn,changed
%O A382211 1,1
%A A382211 _Karst Koymans_, Mar 18 2025
