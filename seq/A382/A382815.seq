%I A382815 #80 Aug 16 2026 22:06:37
%S A382815 1,8,11,51464,51819,52174,573204,37362253,42781604,122925461,
%T A382815 534483448,3083975227,860103093554,881156436695,902209779836
%N A382815 Positive numbers k such that abs((sin k)^k) sets a new record.
%C A382815 Conjecture: every term is either the numerator of an odd-denominator convergent (A096456) or an odd-denominator semiconvergent of Pi/2. Of the first 15 terms, 12 are convergents and 3 are semiconvergents: 8, 51464 and 860103093554. - _Jwalin Bhatt_, Aug 08 2026
%H A382815 Jwalin Bhatt, <a href="/A382815/a382815.txt">Conjectured table of n, a(n) for n = 1..1193</a>
%e A382815 The first few values of abs((sin k)^k), k >= 1, are:
%e A382815   abs(sin(1)^1)   = 0.8414709848
%e A382815   abs(sin(2)^2)   = 0.8268218104
%e A382815   abs(sin(3)^3)   = 0.002810384737
%e A382815   abs(sin(4)^4)   = 0.3280425818
%e A382815   abs(sin(5)^5)   = 0.8108146063
%e A382815   abs(sin(6)^6)   = 0.0004758860207
%e A382815   abs(sin(7)^7)   = 0.05283182049
%e A382815   abs(sin(8)^8)   = 0.9179702884
%e A382815   abs(sin(9)^9)   = 0.0003429247681
%e A382815   abs(sin(10)^10) = 0.002270688338
%e A382815   abs(sin(11)^11) = 0.9998922779
%e A382815   abs(sin(12)^12) = 0.0005695672234
%e A382815 and the record high points are at k = 1, 8, 11, ... - N. J. A. Sloane, Apr 28 2025
%t A382815 Module[{x, y, runningMax = 0, positions = {}},
%t A382815   x = Range[1, 10^6];y = Abs[Sin[x]^x];
%t A382815   Do[If[y[[i]] > runningMax,runningMax = y[[i]];AppendTo[positions, i];],{i, Length[y]}];
%t A382815   positions
%t A382815 ]
%o A382815 (Python)
%o A382815 from mpmath import iv
%o A382815 running_max, A382815 = 0, []
%o A382815 for i in range(1, 52175):
%o A382815     while True:
%o A382815         x = abs(iv.sin(i)**i)
%o A382815         if (comparison:=x>running_max) is None:
%o A382815             iv.dps += 1
%o A382815             running_max = abs(iv.sin(A382815[-1])**A382815[-1])
%o A382815         else: break
%o A382815     if comparison:
%o A382815         A382815.append(i)
%o A382815         running_max = x
%o A382815 print(A382815)  # _Jwalin Bhatt_, Jan 19 2026
%Y A382815 Cf. A004112 (analog for |sin n|), A096456, A382564, A383540.
%K A382815 nonn,more
%O A382815 1,2
%A A382815 _Jwalin Bhatt_, Apr 28 2025
%E A382815 a(10)-a(12) from _David Consiglio, Jr._, Apr 28 2025
%E A382815 a(13)-a(15) from _Jwalin Bhatt_, Aug 08 2026
