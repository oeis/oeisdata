%I A280182 #34 Sep 08 2026 16:33:10
%S A280182 4592307816,5923078164,2790814356,7908143562,4192705638,457618932,
%T A280182 5768134920,395648127,9654032187,4726530981,8213496075,758496231,
%U A280182 1539628074,632175894,2103598746,9462805371,6391708245,4985673021,3261879405,3578016924
%N A280182 Pandigital 10-digit numbers in the decimal expansion of Pi, in order of appearance.
%C A280182 Numbers can start with 0. For example, a(6) = 0457618932.
%H A280182 Harvey P. Dale, <a href="/A280182/b280182.txt">Table of n, a(n) for n = 1..3599</a> (* All terms in the first 10^7 digits. *)
%t A280182 t = Table[Take[RealDigits[Pi,10,i+9][[1]],-10], {i,50000}];
%t A280182 a = Select[t, Length@Union@#==10 &];
%t A280182 FromDigits/@a (* _XU Pingya_, Apr 29 2020 *)
%t A280182 (* Alternative: *)
%t A280182 FromDigits/@With[{p=RealDigits[Pi,10,100000][[1]]},Select[Partition[p,10,1],Union[#]==Range[0,9]&]] (* _Harvey P. Dale_, Sep 08 2026 *)
%Y A280182 Cf. A000796, A258157, A280183.
%K A280182 nonn,base,changed
%O A280182 1,1
