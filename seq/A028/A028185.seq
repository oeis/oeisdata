%F A028185 a(n) = (11^(n+3)-3*9^(n+3)+3*7^(n+3)-5^(n+3))/48. - _Yahia Kahloune_, Jun 05 2013
%F A028185 a(n) = (7^(n+1)-5^(n+1))/2+20*a(n-1)-99*a(n-2). - _Vincenzo Librandi_, Jul 24 2026
%t A028185 CoefficientList[Series[1/((1-5x)(1-7x)(1-9x)(1-11x)),{x,0,20}],x] (* _Harvey P. Dale_, Feb 26 2011 *)
