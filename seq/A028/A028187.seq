%t A028187 a[0]=1;a[1]=33;Do[a[n]=(7^(n+1)-5^(n+1))/2+21*a[n-1]-110*a[n-2],{n,2,22}];Table[a[n],{n,0,18}] (* _Vincenzo Librandi_, Jul 31 2026 *)
