%F A028193 a(n) = 21*a(n-1) - 110*a(n-2) + (8^(n+1) - 5^(n+1))/3, n >= 2. - _Vincenzo Librandi_, Mar 12 2011
%F A028193 a(n) = (8^(n+3) + 11^(n+3) - 18*10^(n+2) - 5^(n+2))/18. - _Bruno Berselli_, Mar 12 2011
%t A028193 a[0]=1;a[1]=34;Do[a[n]=(8^(n+1)-5^(n+1))/3+21*a[n-1]-110*a[n-2],{n,2,22}];Table[a[n],{n,0,18}] (* _Vincenzo Librandi_, Sep 10 2026 *)
%o A028193 (Magma) I:=[1, 34]; [n le 2 select I[n] else (8^n-5^n)/3+21*Self(n-1)-110*Self(n-2): n in [1..19]]; // _Vincenzo Librandi_, Sep 10 2026
