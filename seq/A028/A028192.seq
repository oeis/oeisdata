%N A028192 Expansion of 1/((1-5*x)*(1-8*x)*(1-9*x)*(1-12*x)).
%H A028192 Vincenzo Librandi, <a href="/A028192/b028192.txt">Table of n, a(n) for n = 0..900</a>
%H A028192 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (34,-421,2244,-4320).
%F A028192 a(n) = 21*a(n-1) - 108*a(n-2) + (8^(n+1) - 5^(n+1))/3, n >= 2. - _Vincenzo Librandi_, Mar 12 2011
%F A028192 a(n) = (7*8^(n+3) - 7*9^(n+3) + 12^(n+3) - 5^(n+3))/84. - _Bruno Berselli_, Mar 12 2011
%t A028192 a[0]=1;a[1]=34;Do[a[n]=(8^(n+1)-5^(n+1))/3+21*a[n-1]-108*a[n-2],{n,2,22}];Table[a[n],{n,0,18}] (* _Vincenzo Librandi_, Aug 16 2026 *)
%t A028192 (* Alternative: *)
%t A028192 Table[(7*8^(n+3)-7*9^(n+3)+12^(n+3)-5^(n+3))/84,{n,0,25}] (* _Vincenzo Librandi_, Aug 16 2026 *)
%o A028192 (Magma) I:=[1, 34]; [n le 2 select I[n] else (8^n-5^n)/3+21*Self(n-1)-108*Self(n-2): n in [1..19]]; // _Vincenzo Librandi_, Aug 16 2026
