%N A028190 Expansion of 1/((1-5*x)*(1-8*x)*(1-9*x)*(1-10*x)).
%H A028190 Vincenzo Librandi, <a href="/A028190/b028190.txt">Table of n, a(n) for n = 0..900</a>
%H A028190 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (32,-377,1930,-3600).
%F A028190 a(n) = 19*a(n-1) - 90*a(n-2) + (8^(n+1) - 5^(n+1))/3; a(0)=1, a(1)=32. - _Vincenzo Librandi_, Mar 12 2011
%F A028190 a(n) = 32*a(n-1) - 377*a(n-2) + 1930*a(n-3) - 3600*a(n-4); a(0)=1, a(1)=32, a(2)=647, a(3)=10570. - _Harvey P. Dale_, Apr 28 2013
%F A028190 a(n) = (6*10^(n+3) - 15*9^(n+3) + 10*8^(n+3) - 5^(n+3))/60. - _Yahia Kahloune_, Jun 05 2013
%F A028190 E.g.f.: exp(5*x)*(1200*exp(5*x) - 2187*exp(4*x) + 1024*exp(3*x) - 25)/12. - _Stefano Spezia_, Aug 16 2026
%t A028190 CoefficientList[Series[1/((1-5x)(1-8x)(1-9x)(1-10x)),{x,0,18}],x] (* _Harvey P. Dale_, Apr 28 2013 *)
