%t A028190 a[0]=1;a[1]=32;Do[a[n]=(8^(n+1)-5^(n+1))/3+19*a[n-1]-90*a[n-2],{n,2,22}];Table[a[n],{n,0,18}] (* _Vincenzo Librandi_, Aug 14 2026 *)
