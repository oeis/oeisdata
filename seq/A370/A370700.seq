%N A370700 Expansion of e.g.f. exp(-x^2)/(1-x).
%H A370700 Alois P. Heinz, <a href="/A370700/b370700.txt">Table of n, a(n) for n = 0..450</a>
%F A370700 a(n) = n! * Sum_{k=0..floor(n/2)} (-1)^k/k!.
%p A370700 a:= proc(n) option remember; `if`(n<3, [1,1,0][n+1],
%p A370700       2*(n-1)*(n-2)*a(n-3)-2*(n-1)*a(n-2)+n*a(n-1))
%p A370700     end:
%p A370700 seq(a(n), n=0..22);  # _Alois P. Heinz_, Aug 30 2026
%o A370700 (PARI) my(N=30, x='x+O('x^N)); Vec(serlaplace(exp(-x^2)/(1-x)))
%o A370700 (PARI) a(n) = n!*sum(k=0, n\2, (-1)^k/k!);
