%T A370891 144895284,685566370,3263309844,15616322995,75085908112,362563417968,
%U A370891 1757412095456,8548129677400,41710100368160,204110896990686,1001480947876276,4925833177966164
%N A370891 G.f. A(x) satisfies A(x) = ( 1 + x * A(x)^(1/4) * (1 + A(x)^(3/4)) )^2.
%H A370891 Robert Israel, <a href="/A370891/b370891.txt">Table of n, a(n) for n = 0..1392</a>
%H A370891 Robert Israel, <a href="/A370891/a370891.txt">Recurrence of order 22</a>
%F A370891 G.f.: B(x)^4 where B(x) is the g.f. of A106228.
%F A370891 a(n) = 2 * Sum_{k=0..n} binomial(n,k) * binomial(n/2+3*k/2+2,n)/(n/2+3*k/2+2).
%F A370891 D-finite with recurrence of order 22 (see link). - _Robert Israel_, Nov 22 2026
%p A370891 with(gfun):
%p A370891 eq1:= y - (1 + x*w*(w^3 + 1))^2:
%p A370891 eq2:= w^4-y:
%p A370891 eq:= resultant(eq1,eq2,w):
%p A370891 de:= algeqtodiffeq(eq,y(x)):
%p A370891 rec:= subs(_t[2]=4, _t[3]=14, _t[4]=52, diffeqtorec(de, y(x), a(n))):
%p A370891 f:= rectoproc(rec,a(n),remember):
%p A370891 map(f, [$0..30]); # _Robert Israel_, Nov 22 2026
%o A370891 (PARI) a(n) = 2*sum(k=0, n, binomial(n, k)*binomial(n/2+3*k/2+2, n)/(n/2+3*k/2+2));
