%T A282031 -120,108,72,-225,93,126,-231,168,90,-270,96,189,-180,162,144,-483,
%U A282031 114,180,-210,270,126,-360,132,252,-414,216,144,-465,171,279,-270,294,162,-693,216,360,-300,270,180
%N A282031 Coefficients in q-expansion of (9*E_2(q^3) - E_2(q))/8.
%H A282031 Paolo Xausa, <a href="/A282031/b282031.txt">Table of n, a(n) for n = 0..10000</a>
%H A282031 Hossein Movasati and Younes Nikdelan, <a href="https://arxiv.org/abs/1603.09411">Gauss-Manin Connection in Disguise: Dwork Family</a>, arXiv:1603.09411 [math.AG], 2016-2021. See t_2(q) in (1.11), also Table 1.
%F A282031 Conjecture: -3*A122858(n) - A229616(n) + 4*a(n) = 0 for all n. - _Thomas Baruchel_, Jun 23 2018
%F A282031 a(n) = 3*sigma(n) - 27*sigma(n/3) = 3 * Sum_{d | n} A061347(d)*d, with the convention that sigma(n/3) = 0 if 3 does not divide n. - _Peter Bala_, Sep 17 2026
%p A282031 with(numtheory):
%p A282031 a:= n-> `if`(n=0, 1, 3*add(-2*cos(2*Pi*d*(1/3))*d, d in divisors(n))):
%p A282031 seq(a(n), n = 0..60); # _Peter Bala_, Sep 17 2026
%t A282031 A282031[n_] := If[n == 0, 1, 3*DivisorSigma[1, n] - If[Divisible[n, 3], 27*DivisorSigma[1, n/3], 0]];
%t A282031 Array[A282031, 100, 0] (* _Paolo Xausa_, Sep 18 2026 *)
