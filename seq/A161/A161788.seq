%T A161788 1,7,3,1,1,3,1,1,7,1,1,15,1,1,3,7,1,3,1,1,3,1,7,3,1,1,15,1,31,63,1,1,
%U A161788 3,1,1,3,7,1,3,1,1,15,1,7,3,1,1,3,1,1,7,1,1,3,1,1,15,7,1,31,1,1,3,1,7,3,1,1
%N A161788 a(n) is the largest integer of the form 2^k - 1 that divides n.
%H A161788 Robert Israel, <a href="/A161788/b161788.txt">Table of n, a(n) for n = 1..10000</a>
%F A161788 a(n) = 2^A161789(n) - 1.
%F A161788 a(A161790(n)) = 1.
%p A161788 A161788 := proc(n) for k from ilog2(n+1) to 0 by -1 do if n mod (2^k-1) = 0 then RETURN(2^k-1); fi; od: end: seq(A161788(n),n=1..120) ; # _R. J. Mathar_, Jun 27 2009
%p A161788 # Alternative:
%p A161788 N:= 120: # for a(1) .. a(N)
%p A161788 V:= Vector(N,1):
%p A161788 for k from 2 do
%p A161788   t:= 2^k-1;
%p A161788   if t > N then break fi;
%p A161788   V[[seq(j,j=t..N,t)]]:= t
%p A161788 od:
%p A161788 convert(V,list); # _Robert Israel_, Aug 30 2026
%Y A161788 Cf. A000225, A161789, A161790.
%K A161788 nonn,changed
%O A161788 1,3
