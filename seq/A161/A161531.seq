%I A161531 #15 Sep 05 2026 13:04:13
%S A161531 1,4,13,34,75,152,301,482,794,1197,1842,2522,3582,4772,6408,8229,
%T A161531 10728,13285,16851,20569,25361,30380,36927,43251,51692,60199,70668,
%U A161531 81452,95083,107664,124360,140539,160222,179821,204026,226607,255551,283320,316071,348155
%N A161531 The number of reachable states in a simple two-player counting game, in which each player starts with the pair (1,1) and one move is to add one of the opponent's numbers to one of your own numbers, but no number can grow above a pre-defined maximum n. The game continues until one of the players has no legal moves left. The winner is the one having the higher sum of his numbers.
%C A161531 For many n (1 <= n <= 100), optimal play leads to a draw.
%H A161531 Michael S. Branicky, <a href="/A161531/b161531.txt">Table of n, a(n) for n = 1..200</a>
%H A161531 Michael S. Branicky, <a href="/A161531/a161531.py.txt">Python program for generating b-file</a>
%e A161531 For n = 2 there are 4 valid states of the game: (A=1,1 B=1,1) starts the game. There is only one valid move, leading to (A=1,1 B=1,2). Now A also has only one choice (A=1,2 B=1,2), and B ends the game in the state (A=1,2 B=2,2) and wins. A has no valid move, since then one of his numbers would be larger than 2.
%o A161531 (C++)
%o A161531 #include <climits>
%o A161531 #include <iostream>
%o A161531 #include <map>
%o A161531 class State;
%o A161531 typedef unsigned char byte;
%o A161531 typedef std::map<State, int> ScoreMap;
%o A161531 static inline int min(int a, int b) { return a < b ? a : b; }
%o A161531 static inline int max(int a, int b) { return a > b ? a : b; }
%o A161531 static inline int compare(int a, int b) { return a - b; }
%o A161531 static int MAX = 0;
%o A161531 static ScoreMap score;
%o A161531 struct State
%o A161531 {
%o A161531     byte a, b, c, d;
%o A161531     State() : a(0), b(0), c(0), d(0) {}
%o A161531     State(byte a, byte b, byte c, byte d)
%o A161531         : a(min(a,b)), b(max(a,b)), c(min(c,d)), d(max(c,d)) {}
%o A161531     int getChildren(State *children)
%o A161531     {
%o A161531         int n = 0;
%o A161531         if (a + c <= MAX)
%o A161531             children[n++] = State(c, d, a + c, b);
%o A161531         if (a + d <= MAX && c != d)
%o A161531             children[n++] = State(c, d, a + d, b);
%o A161531         if (a != b && b + c <= MAX)
%o A161531             children[n++] = State(c, d, a, b + c);
%o A161531         if (a != b && c != d && b + d <= MAX)
%o A161531             children[n++] = State(c, d, a, b + d);
%o A161531         return n;
%o A161531     }
%o A161531     int getScore()
%o A161531     {
%o A161531         ScoreMap::iterator it = score.find(*this);
%o A161531         if (it != score.end())
%o A161531             return it->second;
%o A161531         State children[4];
%o A161531         int nchildren = getChildren(&children[0]);
%o A161531         int iscore;
%o A161531         if (nchildren == 0)
%o A161531         {
%o A161531             iscore = compare(a + b, c + d);
%o A161531         }
%o A161531         else
%o A161531         {
%o A161531             iscore = INT_MIN;
%o A161531             for (int i = 0; i < nchildren; i++)
%o A161531                 iscore = max(iscore, -children[i].getScore());
%o A161531         }
%o A161531         score.insert(ScoreMap::value_type(*this, iscore));
%o A161531         return iscore;
%o A161531     }
%o A161531 };
%o A161531 static bool operator<(State a, State b)
%o A161531 {
%o A161531     if (a.a < b.a) return true;
%o A161531     if (a.a > b.a) return false;
%o A161531     if (a.b < b.b) return true;
%o A161531     if (a.b > b.b) return false;
%o A161531     if (a.c < b.c) return true;
%o A161531     if (a.c > b.c) return false;
%o A161531     if (a.d < b.d) return true;
%o A161531     if (a.d > b.d) return false;
%o A161531     return false;
%o A161531 }
%o A161531 int main()
%o A161531 {
%o A161531     std::cout << "max\tscore\tnstates" << std::endl;
%o A161531     for (int max = 1; max < 1024; max++)
%o A161531     {
%o A161531         MAX = max;
%o A161531         score.clear();
%o A161531         int iscore = State(1, 1, 1, 1).getScore();
%o A161531         std::cout << max << "\t" << iscore << "\t" << score.size() << std::endl;
%o A161531     }
%o A161531     return 0;
%o A161531 }
%o A161531 (Python)
%o A161531 from collections import deque
%o A161531 def a(n):
%o A161531     reach, pq = {((1, 1), (1, 1))}, deque([((1, 1), (1, 1))])
%o A161531     while len(pq) > 0:
%o A161531         qa, qb = pq.pop()  # first tuple, qa, is player-to-move
%o A161531         for i, j in [(0, 0), (0, 1), (1, 0), (1, 1)]:
%o A161531             if qa[i] + qb[j] <= n:
%o A161531                 qn = (qb, tuple(sorted((qa[i] + qb[j], qa[1-i]))))
%o A161531                 if qn not in reach:
%o A161531                     pq.append(qn)
%o A161531                     reach.add(qn)
%o A161531     return len(reach)
%o A161531 print([a(n) for n in range(1, 41)]) # _Michael S. Branicky_, Jan 30 2023
%o A161531 (Python) # see link for faster generation of initial segment of sequence
