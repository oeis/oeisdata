%S A246961 0,4,146,3034,52916,857824,13426406,206324374,3138660776,47471139964,
%T A246961 715573119866,10765074628114,161759034582236,2428929817996504,
%U A246961 36456836245518926,547058495778290254,8207730761823753296,123132640134289171444,1847139704277091999586,27708446454015214334794,415638854666404701309956
%N A246961 Numerator of the expected number of random moves in Tower of Hanoi problem with n disks starting at a randomly chosen valid configuration and ending with all disks at peg 1.
%C A246961 The expected number of random moves is given by a(n)/3^n = a(n)/A000244(n).
%H A246961 Paolo Xausa, <a href="/A246961/b246961.txt">Table of n, a(n) for n = 0..850</a>
%H A246961 Max A. Alekseyev and Toby Berger, <a href="https://arxiv.org/abs/1304.3780">Solving the Tower of Hanoi with Random Moves</a>, arXiv:1304.3780 [math.CO], 2013-2014. In: J. Beineke, J. Rosenhouse (eds.) The Mathematics of Various Entertaining Subjects: Research in Recreational Math, Princeton University Press, 2016, pp. 65-79. ISBN 978-0-691-16403-8.
%H A246961 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (32,-342,1440,-2025).
%F A246961 a(n) = ((3^n - 1)*(5^(n+1) - 2*3^(n+1)) + 5^n - 3^n) / 4.
%F A246961 a(n) = 3^n*A007798(n) + 2*A134939(n).
%F A246961 G.f.: -2*x*(135*x^2-9*x-2) / ((3*x-1)*(5*x-1)*(9*x-1)*(15*x-1)). - _Colin Barker_, Sep 17 2014
%F A246961 From _Elmo R. Oliveira_, Nov 20 2026: (Start)
%F A246961 E.g.f.: (1/2)*exp(9*x)*(-3 - 2*exp(-4*x) + 5*cosh(6*x)).
%F A246961 a(n) = 32*a(n-1) - 342*a(n-2) + 1440*a(n-3) - 2025*a(n-4). (End)
%t A246961 A246961[n_] := (5^n*(5*# - 4) + #*(5 - 6*#))/4 & [3^n];
%t A246961 Array[A246961, 25, 0] (* _Paolo Xausa_, Aug 20 2026 *)
%o A246961 (PARI) concat(0, Vec(-2*x*(135*x^2-9*x-2)/((3*x-1)*(5*x-1)*(9*x-1)*(15*x-1)) + O(x^100))) \\ _Colin Barker_, Sep 17 2014
%Y A246961 Cf. A000244, A007798, A134939, A226511.
%K A246961 nonn,easy,changed
%O A246961 0,2
