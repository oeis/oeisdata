%I A008507 #55 Jul 30 2026 11:02:38
%S A008507 0,0,0,1,1,2,2,3,5,5,7,8,8,9,11,13,13,15,16,16,18,19,21,24,25,25,26,
%T A008507 26,27,33,34,36,36,40,40,42,44,45,47,49,49,53,53,54,54,59,64,65,65,66,
%U A008507 68,68,72,74,76,78,78,80,81,81,85,91,92,92,93,99,101,105,105,106,108,111,113,115,116,118
%N A008507 Number of odd composite numbers less than n-th odd prime.
%C A008507 For n>=4, a(n) = k+1, where A000217(j) is the smallest triangular number such that A000217(j) - A033286(n+1) also is a triangular number, i.e., A000217(k). Example n=29, a(29) = 27: A033286(30) = 3390, A000217(86) = 3741. 3741-3390 = 351 = A000217(26); k=26, 26+1 = 27. - _Bob Selcoe_, Apr 12 2016
%C A008507 a(n) = n iff n = 24 or 25. For instance, the 24th odd prime is 97 and the 24th odd composite is A071904(24) = 95, so a(24) = 24. - _Bernard Schott_, Jul 23 2026
%H A008507 Paolo Xausa, <a href="/A008507/b008507.txt">Table of n, a(n) for n = 1..10000</a>
%F A008507 a(n) = A005097(n) - A000027(n). - _William A. Tedeschi_, Apr 25 2008
%F A008507 a(n) = A067076(n) - n + 1. - _Vincenzo Librandi_, Feb 02 2013
%F A008507 a(n) = (A000040(n+1) - 1) / 2 - n. - _Ruud H.G. van Tol_, Jul 16 2026
%t A008507 A008507[n_] := (Prime[n+1] - 1)/2 - n; Array[A008507, 100] (* _Paolo Xausa_, Jul 30 2026 *)
%o A008507 (PARI) a(n) = (prime(n+1)-1)/2-n; \\ _Ruud H.G. van Tol_, Jul 16 2026
%Y A008507 Cf. A067076.
%Y A008507 Cf. A000040 (prime numbers), A000217 (triangular numbers), A033286 (n*prime(n)).
%Y A008507 Partial sums of A100820.
%K A008507 nonn,easy
%O A008507 1,6
%A A008507 Gary Findley (chfindley(AT)alpha.nlu.edu)
%E A008507 More terms from _David W. Wilson_, Jan 13 2000
