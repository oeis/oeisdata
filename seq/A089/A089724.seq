%N A089724 Primes p congruent to 9, 19 or 29 (mod 70).
%H A089724 Robert Israel, <a href="/A089724/b089724.txt">Table of n, a(n) for n = 1..10000</a>
%p A089724 select(isprime, [seq(seq(70*i+j, j=[9,19,29]),i=0..100)]); # _Robert Israel_, Nov 01 2026
%t A089724 f[x_, d_, m_] := Mod[x/d, m]; Do[If[PrimeQ[n]&&Equal[Mod[n, 10], 9]&&!Greater[f[n, 7, 10], 5], Print[n]], {n, 1, 1000}]
