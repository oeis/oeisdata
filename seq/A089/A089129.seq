%N A089129 Greatest common divisor of n^2 - 7 and n^2 + 7.
%C A089129 a(n) is the product of the periodic sequences [1,2]*[7,1,1,1,1,1,1]. - _Gary Detlefs_, Apr 22 2011
%C A089129 Continued fraction expansion of (sqrt(100491) + 287)/82. - _Amiram Eldar_, Aug 08 2026
%H A089129 Vincenzo Librandi, <a href="/A089129/b089129.txt">Table of n, a(n) for n = 0..1000</a>
%F A089129 From _Gary Detlefs_, Apr 22 2011: (Start)
%F A089129 a(n) = gcd(n+7, 14).
%F A089129 a(n) = (6*(1-(n^6 mod 7))+1)*((n mod 2)+1). (End)
%t A089129 a[n_] := GCD[n^2-7, n^2+7]; Array[a, 100, 0] (* _Amiram Eldar_, Aug 08 2026 *)
%o A089129 (PARI) a(n) = gcd(n^2-7,n^2+7);
%o A089129 (Magma) [Gcd(n^2+7,n^2-7): n in [0..100] ]; // _Vincenzo Librandi_, Apr 22 2011
%K A089129 easy,nonn
%O A089129 0,1
