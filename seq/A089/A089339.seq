%S A089339 0,0,0,1,1,0,1,1,1,2,1,1,1,0,2,3,1,1,3,2,2,3,2,3,1,2,4,2,2,4,3,2,6,2,
%T A089339 4,5,2,2,7,2,2,6,2,3,5,4,2,4,4,3,3,3,2,8,3,5,6,3,3,7,5,4,9,2,4,5,5,4,
%U A089339 6,3,2,9,2,4,10,2,6,8,3,4,8,7,4,8,6,5,11,7,4,8,3,2,8,9,3,10,4,7,7,4,4,11,5
%N A089339 Number of primes beginning with n and of the form n concatenated with p where p takes all the prime values less than n.
%C A089339 Conjecture: There are finitely many zeros in this sequence. What is the largest value of n such that a(n) = 0? Perhaps n = 14.
%H A089339 Chris R. Rehmann, <a href="/A089339/b089339.txt">Table of n, a(n) for n = 1..10000</a>
%e A089339 a(10) = 2 and 103 and 107 are the associated primes.
%o A089339 (MATLAB)
%o A089339 N = 103; N1 = min(N,90071991);  % Ensures concatenations are < 2^53 = flintmax
%o A089339 p = primes(N1); a = zeros(1,N1);
%o A089339 for n = 1:N1
%o A089339    q = p(p<n);
%o A089339    if ~isempty(q)
%o A089339        x = n*10.^ceil(log10(q))+q;
%o A089339        a(n) = sum(isprime(x));
%o A089339    end
%o A089339 end
%o A089339 disp(regexprep(num2str(a), ' +', ', ')) % _Chris R. Rehmann_, Oct 13 2026
%Y A089339 Cf. A089340.
%K A089339 base,nonn,changed
%O A089339 1,10
