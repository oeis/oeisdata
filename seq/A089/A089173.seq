%S A089173 2,2,4,3,6,3,5,4,4,10,9,6,14,5,11,16,6,5,8,20,15,7,24,8,26,12,19,7,8,
%T A089173 10,7,25,36,9,8,12,40,13,29,12,22,35,17,54,11,14,39,56,9,10,16,28,45,
%U A089173 13,12,66,49,11,51,23,74,18,13,18,59,84,15,27,11,61,14,18,90,20,65,42,94,13,69,71
%N A089173 Solutions x for x^4-1 = kp where p is prime and k=1,2...
%C A089173 From _Robert Israel_, Jul 29 2026: (Start)
%C A089173 Terms ordered by increasing k, then by increasing p.
%C A089173 The first two k's that correspond to more than one x are k = 1680, corresponding to a(38) = 13 and a(39) = 29, and k = 9520, corresponding to a(78) = 13 and a(79) = 69.
%C A089173 (End)
%H A089173 Robert Israel, <a href="/A089173/b089173.txt">Table of n, a(n) for n = 1..1000</a>
%p A089173 f:= proc(k) local M,x;
%p A089173   M:= map(t -> rhs(op(t)), [msolve(x^4-1,k)]);
%p A089173   op(sort(select(x -> isprime((x^4-1)/k),M)));
%p A089173 end proc:
%p A089173 map(f, [$2..10000]); # _Robert Israel_, Jul 29 2026
%o A089173 (PARI) xpm1(n,m,pow) = { for(k=1,m, for(x=1,n, y= x^pow - 1; z=floor(y/k); if(floor(y/k)*k==y, if(isprime(z), print1(x",") ) ) ) )
%K A089173 easy,nonn,look
%O A089173 1,1
%A A089173 _Cino Hilliard_, Dec 07 2003
%E A089173 More terms from _Robert Israel_, Jul 29 2026
