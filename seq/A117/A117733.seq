%I A117733 #24 Sep 17 2026 04:36:28
%S A117733 2,2,3,7,10,34,54,234,402,1938,17490,19590,209670,237390,2933070,
%T A117733 43575630,696759630,697240110,12541643310,12550832490,250832355690,
%U A117733 5267285475690,115880076771690,115880290164870,2781121832820870,69528040466292870,1807729046546292870
%N A117733 Sum of the n-th primorial and the n-th compositorial number.
%C A117733 The primorial numbers A034386 define their exponential generating function
%C A117733 A034386(x) = Sum_{n>=0} A034386(n)*x^n/n! = Sum_{n>=0} x^n/A049614(n).
%C A117733 The compositorial numbers A049614 define their exponential generating function
%C A117733 A049614(x) = Sum_{n>=0} A049614(n)*x^n/n! = Sum_{n>=0} x^n/A034386(n).
%C A117733 Two special values of these are
%C A117733 A049614(x=1) = 4.5892461266379861713581024207350707369274... and
%C A117733 A034386(x=1) = 2.9200509773161347120925629171120194680027... . So here we have
%C A117733 A117733(x=1) = 7.5092971039541208834506653378470902049301... = Sum_{n>=0} a(n)/n!.
%H A117733 Alois P. Heinz, <a href="/A117733/b117733.txt">Table of n, a(n) for n = 0..530</a>
%F A117733 a(n) = A034386(n) + A049614(n).
%e A117733 The primorial numbers A034386 are 1, 1, 2, 6, 6, 30, 30, ..., and the compositorial numbers A049614 are 1, 1, 1, 1, 4, 4, 24, ..., so this sequence is the sum of corresponding entries: 2, 2, 3, 7, 10, 34, 54, .... - _Michael B. Porter_, Sep 15 2026
%p A117733 b:= proc(n) option remember; `if`(n=0, [1$2], ((x, y)->
%p A117733      `if`(isprime(n), [x*n, y], [x, y*n]))(b(n-1)[]))
%p A117733     end:
%p A117733 a:= n-> add(i, i=b(n)):
%p A117733 seq(a(n), n=0..26);  # _Alois P. Heinz_, Sep 15 2026
%t A117733 f[n_] := If[PrimeQ[n] == True, 1, n] cf[0] = 1; cf[n_Integer?Positive] := cf[n] = f[n]*cf[n - 1] g[n_] := If[PrimeQ[n] == True, n, 1] p[0] = 1; p[n_Integer?Positive] := p[n] = g[n]*p[n - 1] a=Table[cf[n] + p[n], {n, 1, 20}]
%Y A117733 Cf. A034386, A049614, A117683, A249270, A339499.
%K A117733 nonn,easy,changed
