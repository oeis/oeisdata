%I A117680 #19 Aug 10 2026 14:59:58
%S A117680 1,4,9,100,400,900,2025,2304,2601,3600,8100,10000,10201,10404,11025,
%T A117680 12100,14400,22500,32400,40000,40401,44100,62001,90000,101124,103041,
%U A117680 121104,123201,152100,199809,202500,230400,251001,260100,288369,294849,301401,360000
%N A117680 Squares for which the sum of the digits, the product of the digits, the digital root and the multiplicative digital root are all squares.
%C A117680 If k is a term, then so is 100*k. - _Robert Israel_, Aug 10 2026
%D A117680 Elena Deza and Michel Marie Deza, Figurate numbers, World Scientific Publishing (2012), page 422.
%H A117680 Robert Israel, <a href="/A117680/b117680.txt">Table of n, a(n) for n = 1..10000</a>
%e A117680 288369 is in the sequence because (1) it's a square, (2) the sum of the digits 2+8+8+3+6+9=36 is a square, (3) the product of the digits 2*8*8*3*6*9=20736 is a square, (4) the digital root 9 is a square and (5) the multiplicative digital root 0 is also a square.
%p A117680 f:= proc(k) local L,s,p;
%p A117680   if k mod 9 = 7 then return false fi;
%p A117680   L:= convert(k,base,10);
%p A117680   s:= convert(L,`+`);
%p A117680   if not (issqr(s) and issqr(s mod 9)) then return false fi;
%p A117680   p:= convert(L,`*`);
%p A117680   if not issqr(p) then return false fi;
%p A117680   while p > 10 do p:= convert(convert(p,base,10),`*`) od:
%p A117680   issqr(p);
%p A117680 end proc:
%p A117680 select(f, [seq(i^2, i = 1 .. 1000)]); # _Robert Israel_, Aug 10 2026
