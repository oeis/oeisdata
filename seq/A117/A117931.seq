%S A117931 1,2,7,5,9,3,10,4,14,6,19,8,23,11,25,12,28,13,31,15,33,16,35,17,38,18,
%T A117931 41,20,43,21,46,22,50,24,53,26,56,27,59,29,62,30,66,32,70,34,73,36,76,
%U A117931 37,79,39,82,40,86,42,89,44,92,45,95,47,97,48,100,49,103,51,106,52,109
%N A117931 Inductive sum-and-difference sequence.
%C A117931 A permutation of the natural numbers.
%F A117931 a(1)=1, a(2)=2, and for n>=3 let F(n-1)={a(1),a(2),...,a(n-1)}. For odd n>=3, a(n) = least positive integer not in F(n-1) of the form x+y, where x and y are distinct positive integers not in F(n-1); for even n>=3, a(n) = least positive difference x-y such that x,y are in F(n-1) and x-y is not in F(n-1). [Corrected by _Qiyuan Gu_, Aug 11 2026]
%e A117931 a(3)=3+4, a(4)=7-2, a(5)=3+6, a(6)=5-2, a(7)=4+6. Here a(5) is not 3+4: although 3 and 4 are the two least numbers not in F(4)={1,2,5,7}, their sum 7 is already in F(4), so the least admissible sum is 3+6=9.
%o A117931 (Python)
%o A117931 from itertools import count, islice
%o A117931 def agen():
%o A117931     a, s = [1, 2], {1, 2}
%o A117931     yield from a
%o A117931     while True:
%o A117931         if len(a) % 2 == 0:
%o A117931             t = next(v for v in count(1) if v not in s
%o A117931                      and any(x not in s and v-x not in s
%o A117931                              for x in range(1, (v-1)//2 + 1)))
%o A117931         else:
%o A117931             t = next(v for v in count(1) if v not in s and any(x+v in s for x in a))
%o A117931         a.append(t); s.add(t)
%o A117931         yield t
%o A117931 print(list(islice(agen(), 71))) # _Qiyuan Gu_, Aug 11 2026
%Y A117931 Cf. A117932, A117933.
