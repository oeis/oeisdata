%S A117682 3,11,13,23,31,37,47,53,59,61,73,101,103,107,109,113,131,137,149,173,
%T A117682 227,229,251,263,307,311,317,353,401,409,419,433,491,503,509,521,601,
%U A117682 607,661,701,709,769,809,853,907,941,967,1009,1013,1019,1021,1031,1033
%N A117682 Prime numbers for which the product of the digits is a triangular number.
%C A117682 Contains A062800, and therefore is infinite by Dirichlet's theorem on primes in arithmetic progressions. - _Robert Israel_, Aug 10 2026
%D A117682 Elena Deza and Michel Marie Deza, Figurate numbers, World Scientific Publishing (2012), page 292.
%H A117682 Robert Israel, <a href="/A117682/b117682.txt">Table of n, a(n) for n = 1..10000</a>
%e A117682 59 is in the sequence because (1) it is a prime number and (2) the product of its digits 5*9=45 is a triangular number.
%p A117682 filter:= n -> isprime(n) and issqr(1+8*convert(convert(n,base,10),`*`)):
%p A117682 select(filter, [seq(i,i=3..10000,2)]); # _Robert Israel_, Aug 10 2026
%Y A117682 Cf. A000217, A053666, A062800.
%K A117682 nonn,base,changed
