%T A117637 1005,1321,245,783,185,61,431,153,1205,423,465,2547,1257,891,351,25,
%U A117637 945,937,431,453,4221,2763,251,783,1761,1381,2493,2125,5241,2871,255,4507
%N A117637 Least odd k such that (k*2^n)^2+k*2^n-1 is the first of twin primes with n>0.
%e A117637 (1*2^1)^2+1*2^1-1=5, 5 and 7 twin primes so k(1)=1
%e A117637 (1*2^2)^2+1*2^2-1=19 prime but 21 not prime
%e A117637 (3*2^2)^2+3*2^2-1=155 not prime
%e A117637 (5*2^2)^2+5*2^2-1=419, 419 and 421 twin primes so k(2)=5
%t A117637 Table[Module[{k=1},While[AnyTrue[(k 2^n)^2+(k 2^n)-1+{0,2},CompositeQ],k=k+2];k],{n,60}] (* _Harvey P. Dale_, Jul 26 2026 *)
%K A117637 nonn
