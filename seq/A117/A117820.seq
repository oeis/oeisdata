%S A117820 1,3,15,216,255,1080,1728,8640,18360,19344,65535,146880,182880,309504,
%T A117820 1226400,2967888,3456000,4718520,7132320,14738400,22866096,23408640,
%U A117820 37748160,46835712,47486208,58752000,76658400,79233024,124416000,174182400,297198720
%N A117820 Numbers k such that UnitaryPhi(2*UnitaryPhi(k)) = k.
%C A117820 Odd terms are of the form Product_{i=0..m} F_i, 0<=m<=4, where F_i is a Fermat prime 2^(2^i)+1.
%C A117820 Contains also 1226400, 3456000, 14738400, 174182400, and 4294967295.
%H A117820 Donovan Johnson, <a href="/A117820/b117820.txt">Table of n, a(n) for n = 1..41</a> (terms < 2^35)
%e A117820 a(11) = 3*5*17*257.
%t A117820 uphi[k_] := Times @@ (-1 + Power @@@ FactorInteger[k]); uphi[1] = 1;
%t A117820 q[k_] := uphi[2*uphi[k]] == k; Select[Range[1.3*10^6], q] (* _Amiram Eldar_, Aug 24 2026 *)
%o A117820 (PARI) uphi(k) = {my(f = factor(k)); prod(i = 1, #f~, f[i, 1]^f[i, 2]-1);}
%o A117820 isok(k) = uphi(2*uphi(k)) == k; \\ _Amiram Eldar_, Aug 24 2026
%Y A117820 Cf. A019434, A047994, A120453.
%K A117820 nonn,changed
