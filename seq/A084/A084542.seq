%N A084542 Numbers k such that 3^k + 10i is a Gaussian Prime.
%C A084542 9^k + 100 is an ordinary prime. No more terms under 2000.
%t A084542 Flatten[Position[Table[PrimeQ[3^n + 10 I], {n, 1, 1000}], True]]
%o A084542 (Python)
%o A084542 from gmpy2 import is_prime
%o A084542 def ok(k): return is_prime(9**k + 100)
%o A084542 print([k for k in range(1700) if ok(k)]) # _Michael S. Branicky_, Oct 29 2026
