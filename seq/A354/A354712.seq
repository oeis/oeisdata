%N A354712 Nonprime numbers k such that the number of divisors of k divides k-1.
%C A354712 Nonprime numbers k such that k == 1 (mod A000005(k)).
%C A354712 Includes p^(q-1) if p and q are distinct primes with q odd, and p*q if p and q are distinct primes with p == q (mod 4). - _Robert Israel_, Sep 17 2026
%H A354712 Robert Israel, <a href="/A354712/b354712.txt">Table of n, a(n) for n = 1..10000</a>
%p A354712 filter:= k -> not isprime(k) and (k-1) mod NumberTheory:-tau(k) = 0:
%p A354712 select(filter, [$1..500]); # _Robert Israel_, Sep 17 2026
%t A354712 Select[Range[500], ! PrimeQ[#] && Divisible[# - 1, DivisorSigma[0, #]] &] (* _Amiram Eldar_, Jun 03 2022 *)
