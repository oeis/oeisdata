%I A354471 #21 Sep 29 2026 17:39:55
%S A354471 4,3,4,6,5,9,6,10,12,9,10,20,9,13,16,25,11,18,20,22,24,12,22,44,19,28,
%T A354471 20,22,25,42,24,40,36,30,24,55,33,16,36,58,29,48,34,52,48,34,38,82,46,
%U A354471 25,58,28,39,74,40,80,40,47,54,95,61,39,48,75
%N A354471 Number of fusion rings of rank 3 and multiplicity n.
%C A354471 See A348305 for the basic definitions and references about fusion rings.
%C A354471 The first 16 terms of the sequence were computed by J. Slingerland and G. Vercleyen (see paper in reference below, Table 2).
%H A354471 Sébastien Palcoux, <a href="/A354471/b354471.txt">Table of n, a(n) for n = 1..1000</a>
%H A354471 V. Ostrik, <a href="https://arxiv.org/abs/1309.4822">Pivotal fusion categories of rank 3</a>, arXiv:1309.4822 [math.QA], 2013. See Section 3.1, Proposition 3.1 and Remark 3.2(i).
%H A354471 Sébastien Palcoux, <a href="https://github.com/sebastienpalcoux/fusion-ring-census/tree/7f1b36e74df53a8a1cf8597db45d261e408d61b2">Fusion ring census: data, code and verification</a>, repository revision of September 21, 2026.
%H A354471 Sébastien Palcoux, <a href="https://github.com/sebastienpalcoux/fusion-ring-census/blob/7f1b36e74df53a8a1cf8597db45d261e408d61b2/manuscripts/rank3.pdf">Rank-3 fusion rings: A reproducible census through multiplicity 1000</a>, computational companion, 2026.
%H A354471 G. Vercleyen and J. Slingerland, <a href="https://arxiv.org/abs/2205.15637v4">On Low Rank Fusion Rings</a>, arXiv:2205.15637 [math-ph], 2023. See Table 2.
%F A354471 a(n) = KroneckerDelta(n,1) + (1/2)*#{(k,l,p,q) in {0,...,n}^4: k^2+l^2 = 1+l*p+k*q and max(1,k,l,p,q) = n}.
%e A354471 a(1) = A348305(3).
%o A354471 (Python)
%o A354471 def terms(M):
%o A354471     """Return a(1), ..., a(M), at exact multiplicity."""
%o A354471     # Boundary solutions and the unique non-self-dual ring.
%o A354471     a = [0] + [1] * M
%o A354471     a[1] = 4
%o A354471     for k in range(1, M):
%o A354471         for ell in range(k + 1, M + 1):
%o A354471             if gcd(k, ell) != 1:
%o A354471                 continue
%o A354471             c = k*k + ell*ell - 1
%o A354471             p0 = 0 if k == 1 else (c * pow(ell, -1, k)) % k
%o A354471             q0 = (c - ell*p0) // k
%o A354471             lo = max(0, (q0 - M + ell - 1) // ell)
%o A354471             hi = min((M - p0) // k, q0 // ell)
%o A354471             for t in range(lo, hi + 1):
%o A354471                 p, q = p0 + k*t, q0 - ell*t
%o A354471                 a[max(ell, p, q)] += 1
%o A354471     return a[1:]
%o A354471 print(terms(64))
%Y A354471 Cf. A348305.
%K A354471 nonn,changed
%O A354471 1,1
%A A354471 _Sébastien Palcoux_, Jun 01 2022
%E A354471 a(17) and beyond from _Sébastien Palcoux_, Sep 21 2026
