%T A354110 3,3,1,2,3,3,1,4,2,5,3,2,2,5,2,1,3,2,1,2,5,4,4,1,3,4,1,3,4,5,2,6,3,2,
%U A354110 4,3,5,4,1,1,3,3,6,3,2,4,2,1,2,5,2,2,3,6,1,3,3,3,5,2,3,6,1,2,6,2,1,3,4,3,5
%N A354110 The 2-adic valuation of phi(A267099(n)), where A267099 is fully multiplicative involution swapping the positions of 4k+1 and 4k+3 primes, and phi is Euler totient function.
%H A354110 Antti Karttunen, <a href="/A354110/b354110.txt">Table of n, a(n) for n = 1..100000</a>
%F A354110 a(n) = A007814(A354102(n)) = A053574(A267099(n)).
%F A354110 Additive with a(2^e) = e-1, and a(p^e) = A007814(A267099(p)-1) for an odd prime p. - _Amiram Eldar_, Oct 20 2026
%t A354110 p4[1, 3] = 3; p4[1, 1] = 5; p4[n_, r_] := p4[n, r] = NestWhile[NextPrime, NextPrime[p4[n - 1, r]], Mod[#, 4] != r &];
%t A354110 f[p_, e_] := Module[{r = Mod[p, 4], n = 1}, If[r != 1 && r != 3, e-1, While[p4[n, r] < p, n++]; IntegerExponent[p4[n, 4-r]-1, 2]]];
%t A354110 a[1] = 0; a[n_] := Plus @@ f @@@ FactorInteger[n]; Array[a, 105] (* _Amiram Eldar_, Oct 20 2026 *)
%o A354110 (PARI)
%o A354110 \\ Uses also the program from A267099:
%o A354110 A354102(n) = eulerphi(A267099(n));
%o A354110 A354110(n) = valuation(A354102(n),2);
%Y A354110 Cf. A000010, A007814, A053574, A267099, A354102, A354107.
%K A354110 nonn,changed
%O A354110 1,3
%A A354110 _Antti Karttunen_, May 20 2022
