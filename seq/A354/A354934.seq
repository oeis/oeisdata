%T A354934 117,121,125,129,137,149,157,169,173,181,185,193,197,201,217,229,233,
%U A354934 237,241,253,257,269,277,281,289,293,297,301,309,313,317,337,341,349,353,361,373,381,389,397,401,409,413,417,421,425
%N A354934 Row 4 of A354940: Numbers k for which A345992(k) = 4, divided by 4.
%C A354934 Apparently a subsequence of A016813.
%C A354934 From _Robert Israel_, Oct 15 2026: (Start)
%C A354934 This is true. Let m = A344005(4*k), the least m such that 4*k | m*(m+1).  Thus k is a term iff gcd(4*k, m) = 4.
%C A354934 A term k can't be even, as then 8 | 4*k and also 8 | m = A344005(4*k) as well, but we need gcd(4*k, m) = 4.
%C A354934 On the other hand, if k is an odd term, any odd prime power divisor p^j of k must divide m+1 since if it divided m, it would divide gcd(4*k,m).  Thus k | m+1.  However, if k == 3 (mod 4), m = k-1 doesn't work because m*(m+1) would not be divisible by 4.  But we know m <= k, because 4*k | k*(k+1).  The only m such that m+1 has a proper divisor >= m is 1 with divisor 1, so this is a contradiction. The conclusion is that k == 1 (mod 4).
%C A354934 (End)
%H A354934 Robert Israel, <a href="/A354934/b354934.txt">Table of n, a(n) for n = 1..10000</a>
%p A354934 filter:= proc(n) local m;
%p A354934   for m from 1 do if m*(m+1) mod (4*n) = 0 then return igcd(4*n,m) = 4 fi od
%p A354934 end proc:
%p A354934 select(filter, [seq(i,i=1..1000,4)]); # _Robert Israel_, Oct 15 2026
%t A354934 q[n_] := Module[{m = 1}, While[!Divisible[m*(m + 1), 4*n], m++]; GCD[4*n, m] == 4]; Select[Range[425], q] (* _Amiram Eldar_, Jun 17 2022 *)
%o A354934 (PARI) A354934(n) = A354940sq(4,n);
%Y A354934 Row 4 of A354940.
%Y A354934 Cf. A016813, A344005, A345992.
%K A354934 nonn,changed
%O A354934 1,1
%A A354934 _Antti Karttunen_, Jun 15 2022
