%I A354104 #13 Oct 25 2026 04:11:47
%S A354104 1,-1,-4,-1,-2,4,-12,-1,-4,2,-16,4,-6,12,8,-1,-10,4,-28,2,48,16,-36,4,
%T A354104 -2,6,-4,12,-18,-8,-40,-1,64,10,24,4,-22,28,24,2,-30,-48,-52,16,8,36,
%U A354104 -60,4,-12,2,40,6,-42,4,32,12,112,18,-72,-8,-46,40,48,-1,12,-64,-88,10,144,-24,-96,4,-58,22,8,28,192,-24
%N A354104 Dirichlet inverse of A354102.
%H A354104 Antti Karttunen, <a href="/A354104/b354104.txt">Table of n, a(n) for n = 1..19683</a>
%F A354104 Multiplicative with a(p^e) = (1-q), where q = A267101(A000720(p)).
%F A354104 a(n) = A023900(A267099(n)).
%F A354104 a(1) = 1, and for n > 1, a(n) = -Sum_{d|n, d < n} A354102(n/d) * a(d).
%F A354104 a(n) = A354105(n) - A354102(n).
%t A354104 p4[1, 3] = 3; p4[1, 1] = 5; p4[n_, r_] := p4[n, r] = NestWhile[NextPrime, NextPrime[p4[n-1, r]], Mod[#, 4] != r &];
%t A354104 q[p_] := q[p] = Module[{r = Mod[p, 4], n = 1}, If[r != 1 && r != 3, 2, While[p4[n, r] < p, n++]; p4[n, 4-r]]];
%t A354104 f[p_, e_] := 1 - q[p]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 78] (* _Amiram Eldar_, Oct 25 2026 *)
%o A354104 (PARI) A354104(n) = { my(f=factor(n)); prod(k=1,#f~,(1-A267101(primepi(f[k,1])))); }; \\ Code for A267101 can be found in A267099.
%Y A354104 Cf. A023900, A267099, A267101, A354102, A354105.
%K A354104 sign,mult,changed
%O A354104 1,3
%A A354104 _Antti Karttunen_, May 18 2022
