%U A354145 212,225,230,231,232,236,238,242,244,245,248,250,255,261,266,268,273,275,279,284,285,286,290,292,296,297,310,315,316,322,325,328,332,333,338,344
%N A354145 Deficient numbers that are neither prime powers nor semiprimes.
%C A354145 A354144 is a subset of the deficient numbers A001500. This is the set {A005100 \ A354144}.
%H A354145 N. J. A. Sloane, <a href="/A354145/b354145.txt">Table of n, a(n) for n = 1..10000</a>
%t A354145 q[k_] := Module[{f = FactorInteger[k], p, e}, p = f[[;; , 1]]; e = f[[;; , 2]]; Times @@ ((p^(e + 1) - 1)/(p - 1)) < 2*k && !( Length[e] == 1 || e == {1, 1})]; q[1] = False; Select[Range[350], q] (* _Amiram Eldar_, Oct 11 2026 *)
%o A354145 (PARI) isok(k) = {my(f = factor(k), e = f[, 2]~); sigma(f, -1) < 2 && !(#e < 2 || e == [1, 1]);} \\ _Amiram Eldar_, Oct 11 2026
%Y A354145 Cf. A000961, A001358, A005100, A354144.
%K A354145 nonn,changed
