%U A354936 343,349,361,367,373,379,397,409,421,433,439,457,463,487,499,523,529,541,547,571,577,601,607,613,619,625,631,643,661
%N A354936 Row 6 of A354940: Numbers k for which A345992(k) = 6, divided by 6.
%H A354936 Robert Israel, <a href="/A354936/b354936.txt">Table of n, a(n) for n = 1..10000</a>
%H A354936 Robert Israel, <a href="/A354936/a354936.pdf">Proof that all terms == 1 (mod 6)</a>
%p A354936 filter:= proc(k) local m;
%p A354936 for m from 1 do if m*(m+1) mod (6*k) = 0 then return igcd(m,6*k)=6 fi od
%p A354936 end proc:
%p A354936 select(filter, [seq(i,i=1..1000,6)]); # _Robert Israel_, Oct 16 2026
%t A354936 q[n_] := Module[{m = 1}, While[!Divisible[m*(m + 1), 6*n], m++]; GCD[6*n, m] == 6]; Select[Range[660], q] (* _Amiram Eldar_, Jun 17 2022 *)
%o A354936 (PARI) A354936(n) = A354940sq(6,n);
%Y A354936 Row 6 of A354940.
%Y A354936 A subsequence of A016921.
%Y A354936 Cf. A344005, A345992.
%K A354936 nonn
%O A354936 1,1
