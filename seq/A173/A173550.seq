%I A173550 #11 Sep 19 2026 09:24:51
%S A173550 1,41,81,256,2810,19680,131516,1812049
%N A173550 a(n) = k smallest exponent of N = 2^k of first prime(1) = 2 where string "p(1) ... p(n)" appears in the decimal representation of N (n = 1,2,...).
%D A173550 Julian Havil, Impossible?: Surprising Solutions to Counterintuitive Conundrums, Princeton University Press, 2008.
%e A173550 n=1: 2^1 = 2.
%e A173550 n=2: 2^41 = 2199023255552, "23" appears on decimals 6-7.
%e A173550 n=3: 2^81 = 2417851639229258349412352, "235" appears on decimals 22-24.
%e A173550 n=4: 2^256 has 78 decimals, "2357" appears on decimals 20-23, 2^256 = 115792089237316195423570985008687907853269984665640564039457584007913129639936.
%t A173550 a[n_] := a[n] = Module[{s = StringJoin[ToString /@ Prime[Range[n]]], k = If[n > 1, a[n-1], 1], pow}, pow = 2^k; While[! StringContainsQ[ToString[pow], s], k++; pow *= 2]; k]; Array[a, 6] (* _Amiram Eldar_, Sep 19 2026 *)
%Y A173550 Cf. A000079, A018802, A171132, A171242, A171489, A171652, A171768
%K A173550 nonn,base,more,changed
%O A173550 1,2
