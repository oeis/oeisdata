%S A173481 10,100,3000,10000,100000,3000000,70000000,100000000,9000000000,
%T A173481 10000000000,1100000000000,3000000000000,130000000000000,
%U A173481 700000000000000,3000000000000000,10000000000000000,1700000000000000000,9000000000000000000,190000000000000000000,100000000000000000000
%N A173481 a(n) = the smallest number ending in n zeros divisible by n.
%H A173481 Amiram Eldar, <a href="/A173481/b173481.txt">Table of n, a(n) for n = 1..997</a>
%F A173481 From _Amiram Eldar_, Oct 03 2026: (Start)
%F A173481 a(n) = 10 * A173478(n).
%F A173481 a(n) = lcm(n, 10^n).
%F A173481 a(n) = n * 2^(n - A007814(n)) * 5^(n - A112765(n)).
%F A173481 Sum_{n>=1} 1/a(n) = log(10/9) - (1/2) * Sum_(k>=1} log(1 - 1/10^(2^k)) - (4/5) * Sum_{k>=1} log(1 - 1/10^(5^k)) - (2/5) * Sum_{k1,k2>=1} log(1 - 1/10^(2^k1*5^k2)) = 0.11044369116474404266... . (End)
%t A173481 a[n_] := n * 2^(n - IntegerExponent[n, 2]) * 5^(n - IntegerExponent[n, 5]); Array[a, 20] (* _Amiram Eldar_, Oct 03 2026 *)
%o A173481 (PARI) a(n) = n * 1 << (n - valuation(n, 2)) * 5^(n - valuation(n, 5)); \\ _Amiram Eldar_, Oct 03 2026
