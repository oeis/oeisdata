%N A173478 a(n) = the smallest number ending in n-1 zeros divisible by n.
%H A173478 Amiram Eldar, <a href="/A173478/b173478.txt">Table of n, a(n) for n = 1..998</a>
%F A173478 From _Amiram Eldar_, Oct 03 2026: (Start)
%F A173478 a(n) = A173481(n)/10.
%F A173478 a(n) = lcm(n, 10^(n-1)).
%F A173478 a(n) = n * 2^(n - A007814(n) - 1) * 5^(n - A112765(n) - 1).
%F A173478 Sum_{n>=1} 1/a(n) = 10*log(10/9) - 5 * Sum_(k>=1} log(1 - 1/10^(2^k)) - 8 * Sum_{k>=1} log(1 - 1/10^(5^k)) - 4 * Sum_{k1,k2>=1} log(1 - 1/10^(2^k1*5^k2)) = 1.10443691164744042661... . (End)
%t A173478 a[n_] := n * 2^(n - IntegerExponent[n, 2] - 1) * 5^(n - IntegerExponent[n, 5] - 1); Array[a, 21] (* _Amiram Eldar_, Oct 03 2026 *)
%o A173478 (PARI) a(n) = n * 1 << (n - valuation(n, 2) - 1) * 5^(n - valuation(n, 5) - 1); \\ _Amiram Eldar_, Oct 03 2026
