%I A334856 #21 Sep 09 2026 01:19:54
%S A334856 1,2,8,48,376,3552,38072,433664,4677184,29762560,-793410432,
%T A334856 -54950522880,-2386117894016,-93904016252928,-3620999060747776,
%U A334856 -140559707495727104,-5551125947636719616,-223832352597495644160,-9212210790951194357760,-385841470335205512314880
%N A334856 E.g.f. A(x) satisfies: A(x) = sin(x * exp(A(x))).
%H A334856 Peter Bala, <a href="/A334856/a334856.pdf">Notes on A334856</a>.
%F A334856 E.g.f.: series reversion of arcsin(x) / exp(x).
%F A334856 From _Peter Bala_, Sep 06 2026: (Start)
%F A334856 a(n) = (n-1)! * [x^n] (exp(n*sin(x)) = A293021(n)/n. Cf. A227463.
%F A334856 a(n) = Sum_{k = 1..n} (-i)^(n-k) * A136630(n, k) * n^(k-1).
%F A334856 a(2*n) == 0 (mod 2*n); a(4*n+1) == 1 (mod 4*n+1); a(4*n+3) == -1 (mod 4*n+3).
%F A334856 For prime p == 1 (mod 4), a(p+1) == 2 (mod p).
%F A334856 For prime p == 3 (mod 4), a(p+1) == 0 (mod p).
%F A334856 Let r be a positive integer. The following supercongruences hold:
%F A334856 a(3^r) == (-1)^r (mod 3^(2*r)).
%F A334856 a(p^r) == 1 (mod p^(2*r+1)) for all primes p == 1 (mod 4) and
%F A334856 a(p^r) == (-1)^r (mod p^(2*r+1)) for all primes p == 3 (mod 4), p > 3.
%F A334856 Conjectural 2-adic values: v_2(a(8*n+4)) = 8*n + 4;
%F A334856 v_2(a(8*n+2)) = 8*n + p(n) where {p(n)}n>=1 is the periodic sequence [2, 1, 1, 2, 1, 1, 2, 1, 1, ...];
%F A334856 v_2(a(8*n+6)) = 8*n + q(n) where {q(n)}n>=1 is the periodic sequence [5, 6, 5, 5, 6, 5, 5, 6, 5, ...]. (End)
%e A334856 From _Peter Bala_, Sep 06 2026: (Start)
%e A334856 a(3^2) - 1 = 4677184 - 1 = (3^4)*7*73*113 == 0 (mod 3^4).
%e A334856 a(5) - 1 = 376 - 1 = 3*(5^3) == 0 (mod 5^3);
%e A334856 a(7) + 1 = 38072 + 1 = 3*(7^3)*37 == 0 (mod 7^3). (End)
%p A334856 seq((n-1)!*coeftayl(exp(n*sin(x)), x = 0, n), n = 1..20); # _Peter Bala_, Sep 05 2026
%t A334856 nmax = 20; CoefficientList[InverseSeries[Series[ArcSin[x]/Exp[x], {x, 0, nmax}], x], x] Range[0, nmax]! // Rest
%Y A334856 Cf. A136630, A227463, A227464, A227465, A293021.
%K A334856 sign,easy,changed
%O A334856 1,2
%A A334856 _Ilya Gutkovskiy_, May 13 2020
