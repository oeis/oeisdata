%I A334209 #16 Aug 12 2026 13:20:32
%S A334209 0,0,2,0,2,2,0,2,4,2,2,4,2,2,8,2,4,6,2,6,6,4,8,6,4,6,10,4,10,10,0,10,
%T A334209 12,6,10,10,6,8,16,8,8,12,10,10,14,12,8,14,12,10,18,10,14,16,8,14,20,
%U A334209 14,10,20,10,10,32,10,12,22,10,18,22,16,16,20,16,16
%N A334209 Number of solutions to n = i+j, 0 <= i,j <= n for which A010060(i)=A010060(j)=0, i != j.
%C A334209 This is the same as the number of solutions to n = i+j, 0 <= i,j <= n for which A010060(i)=A010060(j)=1, i != j.
%H A334209 Robert Israel, <a href="/A334209/b334209.txt">Table of n, a(n) for n = 1..10000</a>
%H A334209 J. Lambek and L. Moser, <a href="https://doi.org/10.4153/CMB-1959-013-x">On some two way classifications of integers</a>, Can. Math. Bull 2 (1959) 85-89.
%F A334209 We have
%F A334209 a(4n+1) = -a(2n)+a(2n+1)+a(4n)
%F A334209 a(4n+2) = a(2n)+a(2n+1)
%F A334209 a(8n) = 3a(2n)+a(2n+1)
%F A334209 a(8n+3) = 3a(2n)+a(2n+1)-a(4n)+a(4n+3)
%F A334209 a(8n+4) = 2a(2n+1)+a(4n)
%F A334209 a(8n+7) = 4a(2n+1),
%F A334209 which provides a fast algorithm to compute a(n).
%e A334209 For n = 19 the only solutions are (i,j) in {(9,10), (10,9)}, so a(19) = 2.
%p A334209 f:= proc(n) option remember;
%p A334209   local r;
%p A334209   r:= n mod 8;
%p A334209   if r = 0 then 3*procname(n/4) + procname(n/4+1)
%p A334209   elif r = 1 or r = 5 then -procname((n-1)/2) + procname((n+1)/2) + procname(n-1)
%p A334209   elif r = 2 or r = 6 then procname((n-2)/2) + procname(n/2)
%p A334209   elif r = 3 then 3*procname((n-3)/4) + procname((n+1)/4) - procname((n-3)/2) + procname((n+3)/2)
%p A334209   elif r = 4 then 2*procname(n/4) + procname((n-4)/2)
%p A334209   else 4*procname((n-3)/4)
%p A334209   fi
%p A334209 end proc:
%p A334209 f(1):= 0: f(2):= 0: f(3):= 2: f(4):= 0:
%p A334209 map(f, [$1..100]); # _Robert Israel_, Aug 12 2026
%Y A334209 Cf. A010060.
%K A334209 nonn,look
%O A334209 1,3
%A A334209 _Jeffrey Shallit_, Apr 18 2020
