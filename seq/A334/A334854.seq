%U A334854 36708748623872000,1716785996161588625,69798035394846720000,2571598453132219756375,84313566554397999104000
%N A334854 E.g.f. A(x) satisfies: A(x) = arctan(x * exp(A(x))).
%F A334854 E.g.f.: series reversion of tan(x) / exp(x).
%F A334854 From _Peter Bala_, Sep 05 2026: (Start)
%F A334854 a(n) = Sum_{k = 1..n} A049218(n, k)*n^(k-1).
%F A334854 For odd prime p, a(p) == (-1)^(p+1)/2 (mod p).
%F A334854 a(2*n+1) is odd.
%F A334854 2-adic value v_2(a(2^n + 2)) = 2^n for n >= 2. (End)
%p A334854 a := n -> (n-1)!*coeftayl(exp(n*arctan(x)), x = 0, n):
%p A334854 seq(a(n), n = 1..20); # _Peter Bala_, Sep 05 2026
%t A334854 nmax = 20; CoefficientList[InverseSeries[Series[Tan[x]/Exp[x], {x, 0, nmax}], x], x] Range[0, nmax]! // Rest
%Y A334854 Cf. A049218, A227464, A227465, A227466, A334855
%K A334854 sign,easy,changed
%O A334854 1,2
