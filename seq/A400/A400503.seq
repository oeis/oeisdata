%N A400503 Decimal expansion of alpha_N, the unique minimizer of Sum_{n >= 2} 1/(n*log(n)^alpha)for alpha > 1.
%C A400503 E(alpha) = Sum_{n >= 2} 1/(n*log(n)^alpha) is strictly convex on (1, oo), tends to +oo as alpha -> 1+ and as alpha -> oo, and has a unique minimizer alpha_N = 2.4881010104... .
%C A400503 alpha_N is larger than the corresponding prime minimizer alpha_P = 1.6049933417... (A400502).
%C A400503 The minimum value is E(alpha_N) = 1.98340908674230233506638542356... .
%H A400503 Ramón Moya, <a href="https://doi.org/10.5281/zenodo.23005107">The critical exponent alpha_P of the Alpha family over the primes</a>, Zenodo, 2026, Proposition 4.1.
%F A400503 alpha_N is the unique root for alpha > 1 of Integral_{t=0..oo} t^(alpha-1)*(log(t) - Psi(alpha))*(zeta(1+t) - 1) dt = 0, where Psi is the digamma function.
%e A400503 2.488101010489803035024055554095047115420838295851489713788982...
%o A400503 (Python)
%o A400503 from mpmath import mp, mpf, quad, zeta, log, gamma, digamma, findroot, inf
%o A400503 mp.dps = 40
%o A400503 def dE(alpha):
%o A400503     w = lambda t: t**(alpha - 1) * (log(t) - digamma(alpha))
%o A400503     reg = quad(
%o A400503         lambda t: w(t) * (zeta(1 + t) - 1 - 1/t),
%o A400503         [0, mpf(1)/4, 1]
%o A400503     )
%o A400503     sing = -1/(alpha - 1)**2 - digamma(alpha)/(alpha - 1)
%o A400503     tail = quad(
%o A400503         lambda t: w(t) * (zeta(1 + t) - 1),
%o A400503         [1, 4, 16, 64, 256, inf]
%o A400503     )
%o A400503     return (reg + sing + tail) / gamma(alpha)
%o A400503 print(findroot(dE, mpf("2.488")))
%Y A400503 Cf. A137245, A115563, A400502.
%K A400503 nonn,cons,new
%O A400503 1,1
