%N A400480 G.f. A(x) satisfies A(x) = (1 + x*A(x^2))^4.
%H A400480 Seiichi Manyama, <a href="/A400480/b400480.txt">Table of n, a(n) for n = 0..10000</a>
%F A400480 a(0) = 1; a(2*n+1) = 4*a(n) + 4*Sum_{i,j,k>=0 and i+j+k=n-1} a(i)*a(j)*a(k) and a(2*n+2) = 6*Sum_{k=0..n} a(k)*a(n-k) + Sum_{i,j,k,l>=0 and i+j+k+l=n-1} a(i)*a(j)*a(k)*a(l) for n >= 0.
%F A400480 a(0) = 1; a(n) = (1/n) * Sum_{k=0..floor((n-1)/2)} (-n+10*k+5)*a(k)*a(n-1-2*k).
%t A400480 terms = 37; A[_] = 1; Do[A[x_] = (1 + x*A[x^2])^4 + O[x]^terms // Normal, terms]; CoefficientList[A[x], x] (* _Stefano Spezia_, Sep 27 2026 *)
