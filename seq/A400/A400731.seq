%S A400731 2,3,4,5,6,11,12,13,14,15,16,18,20,21,22,27,28,29,30,32,34,36,38,40,
%T A400731 42,43,45,47,52,53,54,56,58,59,60,61,63,65,66,67,68,69,70,72,75,77,78,
%U A400731 79,81,83,84,85,86,88,90,92,93,94,96,102,104,106,107,108,109,110
%N A400731 Numbers k such that k^2 - 1 is an exponentially odd number (A268335).
%C A400731 A square has a prime factorization with only even exponents, while an exponentially odd number has only odd exponents.
%C A400731 The asymptotic density of this sequence is (5/4) * Product_{p prime} (1 - 2/(p*(p+1))) = (5/4) * A307868 = 0.58960076701624733509... .
%H A400731 Amiram Eldar, <a href="/A400731/b400731.txt">Table of n, a(n) for n = 1..10000</a>
%e A400731 2 is a term since 2^2-1 = 3 is an exponentially odd number.
%e A400731 3 is a term since 3^2-1 = 8 = 2^3 is an exponentially odd number (the exponent 3 is odd).
%t A400731 expOddQ[k_] := AllTrue[FactorInteger[k][[;;, 2]], OddQ];
%t A400731 q[k_] := expOddQ[k^2-1]; q[1] = False; Select[Range[110], q]
%o A400731 (PARI) isexpodd(n) = {my(f = factor(n)); for(i=1, #f~, if (!(f[i, 2] % 2), return (0))); 1;}
%o A400731 isok(k) = k > 1 && isexpodd(k^2-1);
%Y A400731 Cf. A268335, A307868, A367695, A400730.
%Y A400731 Subsequences: A067874, A400732.
