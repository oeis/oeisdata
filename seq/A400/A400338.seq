%N A400338 G.f.: 1/G(x), where G(x) is g.f. for A225543.
%H A400338 Vaclav Kotesovec, <a href="/A400338/b400338.txt">Table of n, a(n) for n = 0..10000</a>
%F A400338 G.f.: 1/Product_{k>=1} (1 - x^k)^4 * (1 - (-x)^k)^8.
%F A400338 G.f.: Product_{k>=1} (1 + x^(2*k))^8 / ((1 - x^k)^12 * (1 + x^k)^16).
%F A400338 a(n) ~ (-1)^n * exp(Pi*sqrt(6*n)) * 3^(13/4) / (2^(33/4) * n^(15/4)).
%t A400338 CoefficientList[Series[1/(QPochhammer[x]^4 * QPochhammer[-x]^8), {x, 0, 30}], x]
%t A400338 (* Alternative: *)
%t A400338 nmax = 30; CoefficientList[Series[Product[(1 + x^(2*k))^8/((1 - x^k)^12*(1 + x^k)^16), {k, 1, nmax}], {x, 0, nmax}], x]
