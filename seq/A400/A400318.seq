%N A400318 G.f. A(x) satisfies A(x) = (1 + x)^3 * A(x^4 * (1 + x)), with A(0) = 1.
%F A400318 a(0) = 1; a(n) = Sum_{k=0..floor(n/4)} binomial(k+3,n-4*k) * a(k).
%F A400318 G.f.: B(x)^3 where B(x) is the g.f. of A400271.
%o A400318 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=0, i\4, binomial(j+3, i-4*j)*v[j+1])); v;
%Y A400318 Cf. A400271, A400316, A400319.
