%N A400530 E.g.f. A(x) satisfies A(x) = exp(2*x*A(x^3)).
%F A400530 E.g.f.: B(x)^2 where B(x) is the e.g.f. of A400528.
%F A400530 a(0) = 1; a(n) = 2 * (n-1)! * Sum_{k=0..floor((n-1)/3)} (3*k+1) * a(k) * a(n-1-3*k)/(k! * (n-1-3*k)!).
%o A400530 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=2*(i-1)!*sum(j=0, (i-1)\3, (3*j+1)*v[j+1]*v[i-3*j]/(j!*(i-1-3*j)!))); v;
