%I A400540 #10 Oct 04 2026 15:03:01
%S A400540 1,2,4,84,3000,3150,53742260
%N A400540 a(n) is the least number that is the sum of two balanced numbers in exactly n ways, or -1 if there is no such number.
%C A400540 a(n) is the position of the first occurrence of the value n in A347822, or -1 if n does not occur in that sequence.
%C A400540 a(7) > 10^8 if it is not -1.
%e A400540 a(0) = 1 because A347822(1) = 0.
%e A400540 a(1) = 2 because 2 = 1 + 1.
%e A400540 a(2) = 4 because 4 = 1 + 3 = 2 + 2.
%e A400540 a(3) = 84 because 84 = 6 + 78 = 14 + 70 = 42 + 42.
%e A400540 a(4) = 3000 because 3000 = 30 + 2970 = 270 + 2730 = 420 + 2580 = 910 + 2090.
%e A400540 a(5) = 3150 because 3150 = 15 + 3135 = 70 + 3080 = 420 + 2730 = 570 + 2580 = 714 + 2436.
%e A400540 a(6) = 53742260 because 53742260 = 1542840 + 52199420 = 9019680 + 44722580 = 14374868 + 39367392 = 15942680 + 37799580 = 22868604 + 30873656 = 26871130 + 26871130.
%p A400540 N:= 10000: # for terms <= N
%p A400540 Bal:= select(t -> NumberTheory:-sigma(t) mod NumberTheory:-phi(t) = 0, [$1..N]):
%p A400540 nB:= nops(Bal):
%p A400540 V:= Vector(N):
%p A400540 for i from 1 to nB while 2*Bal[i] <= N do
%p A400540   for j from i to nB do
%p A400540     v:= Bal[i]+Bal[j]; if v > N then break fi;
%p A400540     V[v]:= V[v]+1
%p A400540 od od:
%p A400540 R:= Array(0..max(V)):
%p A400540 for i from 0 to max(V) do
%p A400540   if member(i,V,'k') then R[i]:= k fi
%p A400540 od;
%p A400540 convert(R,list);
%Y A400540 Cf. A020492, A347822.
%K A400540 nonn,hard,more,new
%O A400540 0,2
%A A400540 _Robert Israel_, Sep 29 2026
