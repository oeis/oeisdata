%I A400613 #28 Oct 07 2026 14:53:08
%S A400613 21,1,11,121,252,672,585,2184,525,4032,5265,21216,5175,44064,24024,
%T A400613 26208,5775,68544,44352,202176,50625,217728,215424,239904,53550,
%U A400613 417312,235872,55125,266112,445536,288288,471744,51975,2193408,891072,2104704,507150,2159136,2010624,2195424
%N A400613 a(n) is the smallest number m with exactly n divisors d whose last digit equals the first digit of m.
%C A400613 We note that a(n) = A399630(n) for n = 1, 2, 3, 4, 5 (see examples section).
%e A400613 Of the 24 divisors of 672, five have their last digit equals to the first digit of 672: {6, 16, 56, 96, 336}, and there is no integer < 672 with 5 such divisors, hence a(5) = 672.
%p A400613 f:= proc(k) local t;
%p A400613   t:= floor(k/10^ilog10(k));
%p A400613   nops(select(d -> d mod 10 = t, NumberTheory:-Divisors(k)))
%p A400613 end proc:
%p A400613 N:= 40: # for a(0) .. a(N)
%p A400613 V:= Array(0..N): count:= 0:
%p A400613 for i from 1 while count < N+1 do
%p A400613   v:= f(i);
%p A400613   if v <= N and V[v] = 0 then V[v]:= i; count:= count+1; fi;
%p A400613 od:
%p A400613 convert(V,list); # _Robert Israel_, Oct 05 2026
%t A400613 f[n_] := DivisorSum[n, 1 &, IntegerDigits[n][[1]] == Mod[#, 10] &]; seq[max_] := TakeWhile[FirstPosition[Array[f, max], #] & /@ Range[0, 50] // Flatten, NumberQ]; seq[10^6] (* _Amiram Eldar_, Oct 01 2026 *)
%o A400613 (PARI) a(n) = my(m=1); while (sumdiv(m, d, (d%10) == digits(m)[1]) != n, m++); m; \\ _Michel Marcus_, Oct 05 2026
%o A400613 (PARI) a(n) = for(i = 1, oo, if(g(i) == n, return(i)))
%o A400613 g(n) = my(f=factor(n), ld=digits(n)[1], fr=vector(10), v); fr[2]=1; for(i=1, #f~, cfr = fr; v = vector(10); P=Mod(1, 10); for(e=1, f[i,2], P*=f[i, 1]; v[lift(P)+1]++); for(j=1, 10, if(v[j] > 0, for(k = 1, 10, cfr[((k-1)*(j-1)) % 10 + 1] += fr[k] * v[j]))); fr=cfr); fr[ld+1] \\ _David A. Corneth_, Oct 05 2026
%Y A400613 Cf. A335491 (last digit), A357300 (first digit), A399630 (analog).
%Y A400613 Cf. A400612.
