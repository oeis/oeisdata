%t A400790 cyclenumber[ptn_] := Total[ptn]!/Product[Tally[ptn][[j]][[1]]^Tally[ptn][[j]][[2]]Tally[ptn][[j]][[2]]!, {j, 1, Length[Tally[ptn]]}]
%t A400790 qt[t_] := Series[Sum[((-1)^k) q^(t (k/2) (3 k - 1)), {k, -15, 15}], {q, 0, 300}]
%t A400790 BiggerMatrix = Table[Table[0, {c, 1, 301}], {r, 0, 20}];
%t A400790 BiggerMatrix[[1]][[1]] = 1;
%t A400790 For[t = 1, t < 21, t++, tpoly = Series[(1/t!)*Sum[cyclenumber[IntegerPartitions[t][[j]]]/Product[qt[IntegerPartitions[t][[j]][[k]]], {k, 1, Length[IntegerPartitions[t][[j]]]}], {j, 1, PartitionsP[t]}], {q, 0, 300}];
%t A400790  currlist = CoefficientList[tpoly, q];
%t A400790  For[i = 1, i < 301, i++, BiggerMatrix[[t + 1]][[i]] = currlist[[i]]]
%t A400790 ];
%t A400790 MatrixForm[BiggerMatrix]
%Y A400790 Main diagonal gives A001970.
%Y A400790 Cf. A000041 (column 1), A281357 (column 2), A400782 (column 3), A400783 (column 4), A400784 (column 5).
%Y A400790 Cf. A061260.
