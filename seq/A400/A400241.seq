%N A400241 G.f. A(x) satisfies A(x) = A(x^2/(1 - x)^3) / (1 - x), with A(0) = 1.
%F A400241 a(0) = 1; a(n) = Sum_{k=0..floor(n/2)} binomial(n+k,3*k) * a(k).
%o A400241 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=0, i\2, binomial(i+j, 3*j)*v[j+1])); v;
