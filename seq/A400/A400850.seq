%I A400850 #33 Oct 18 2026 15:51:56
%S A400850 1,9,36,80,225,240,441,560,720,880,1040,1089,1200,1250,1360,1520,1521,
%T A400850 1620,1680,1840,2160,2320,2480,2601,2640,2960,3120,3249,3280,3440,
%U A400850 3760,4050,4080,4240,4560,4720,4761,4880,5040,5360,5520,5680,5840,6160,6320,6640,6960
%N A400850 Refactorable numbers k (A033950) such that d(k/d(k)) = d(d(k)), where d(x) is the number of divisors of x (A000005).
%C A400850 For a number k to be in this sequence, it must first be a refactorable number. Furthermore, when k is divided by its own divisor count, the resulting cofactor must have exactly the same number of divisors as the divisor count itself.
%e A400850 For k = 80: k is refactorable (80 mod 10 = 0) and d(80 / 10) = d(8) = d(10) = 4, satisfying the dual-mode equivalence.
%p A400850 with(numtheory):
%p A400850 is_a := proc(n)
%p A400850     local d := tau(n);
%p A400850     if n mod d = 0 and tau(n/d) = tau(d) then n else NULL fi;
%p A400850 end proc:
%p A400850 seq(is_a(n), n=1..7000);
%t A400850 Select[Range[7000], Mod[#, DivisorSigma[0, #]] == 0 && DivisorSigma[0, # / DivisorSigma[0, #]] == DivisorSigma[0, DivisorSigma[0, #]] &]
%o A400850 (PARI) is_a(n) = my(d=numdiv(n)); (n%d==0) && (numdiv(n/d) == numdiv(d));
%o A400850 for(n=1, 7000, if(is_a(n), print1(n, ", ")))
%o A400850 (Python)
%o A400850 from sympy import divisor_count
%o A400850 def is_a(n):
%o A400850     d = divisor_count(n)
%o A400850     return n % d == 0 and divisor_count(n // d) == divisor_count(d)
%o A400850 print([n for n in range(1, 7001) if is_a(n)])
%Y A400850 Subsequence of A033950.
%Y A400850 Cf. A000005.
%K A400850 nonn,new
%O A400850 1,2
%A A400850 _Maxwell C. P. Brown_, Oct 07 2026
