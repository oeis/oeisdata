%I A400712 #20 Nov 01 2026 23:17:36
%S A400712 2,3,16,17,6,7,20,21,10,11,24,25,14,15,28,29,18,19,128,129,22,23,132,
%T A400712 133,26,27,136,137,30,31,140,141,34,35,48,49,38,39,52,53,42,43,56,57,
%U A400712 46,47,60,61,50,51,160,161,54,55,164,165,58,59,168,169,62,63,172
%N A400712 Row n = 2 of the array in A400710.
%C A400712 a(n) is the sum of n and 2 using the addition rule defined in A400710.
%C A400712 Let b = (b(0), b(1), b(2), ...) denote the binary expansion of n, where b(0) is the least significant bit, padded with infinitely many extra zeros on the right.
%C A400712 Let k >= 0 be the smallest number such that b(3*k+1) = 0.
%C A400712 Then (compare the formula in A400711) a(n) = n + 2*(8^k - Sum_{i=0..k-1} 8^i).
%H A400712 Michael S. Branicky, <a href="/A400712/b400712.txt">Table of n, a(n) for n = 0..10000</a>
%o A400712 (Python)
%o A400712 def T(n, k):
%o A400712     if n == 0: return k
%o A400712     if k == 0: return n
%o A400712     return T(n^k, (n&k)<<3)
%o A400712 def a(n): return T(n, 2)
%o A400712 print([a(n) for n in range(63)]) # _Michael S. Branicky_, Nov 01 2026
%Y A400712 Cf. A400710, A400711.
%K A400712 nonn,changed
%O A400712 0,1
