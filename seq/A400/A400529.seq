%N A400529 E.g.f. A(x) satisfies A(x) = exp(2*x*A(x^2)).
%F A400529 E.g.f.: B(x)^2 where B(x) is the e.g.f. of A400527.
%F A400529 a(0) = 1; a(n) = 2 * (n-1)! * Sum_{k=0..floor((n-1)/2)} (2*k+1) * a(k) * a(n-1-2*k)/(k! * (n-1-2*k)!).
%o A400529 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=2*(i-1)!*sum(j=0, (i-1)\2, (2*j+1)*v[j+1]*v[i-2*j]/(j!*(i-1-2*j)!))); v;
