%I A400099 #14 Nov 26 2026 17:50:50
%S A400099 1,5,25,125,311,625,1555,3125,6221,7775,15551,15625,31105,38875,77755,
%T A400099 78125,93307,96721,155501,155525,194375,311021,388775,390625,466535,
%U A400099 483605,777505,777551,777625,971875,1555105,1556251,1934731,1943875,1953125,2332675,2418025
%N A400099 Numbers k such that the trajectory of k->ord(6,k) reaches 1 before reaching a number not coprime to 6. Here ord(b,k) is the multiplicative order of b modulo k.
%C A400099 Closed under multiplication; see A400096 for details.
%H A400099 Jianing Song, <a href="/A400099/b400099.txt">Table of n, a(n) for n = 1..288</a> (all terms <= 10^10)
%e A400099 Powers of 5 are terms: 5^n -> 5^(n-1) -> ... -> 5 -> 1;
%e A400099 18198701 is a term: 18198701 -> 25 -> 5 -> 1;
%e A400099 40185601 is a term: 40185601 -> 25 -> 5 -> 1;
%e A400099 If p is any prime factor of (6^125 - 1)/(5*(6^25 - 1)), then p is a term: p -> 125 -> 25 -> 5 -> 1;
%e A400099 If p is any prime factor of (6^311 - 1)/5, then p is a term: p -> 311 -> 5 -> 1.
%t A400099 (* okQ is defined at A400096 *)
%t A400099 Select[Range[2000000], okQ[#, 6] &] (* _Paolo Xausa_, Nov 26 2026 *)
%o A400099 (PARI) isok(n, 6) \\ see A400096 for isok
%Y A400099 See A400096 for list of sequences in other bases.
%K A400099 nonn,new
%O A400099 1,2
%A A400099 _Jianing Song_, Nov 24 2026
