%I A400238 #52 Nov 18 2026 21:04:27
%S A400238 1,3,1,17,9,1,101,78,15,1,629,636,175,21,1,4019,5031,1795,308,27,1,
%T A400238 26131,39009,17090,3794,477,33,1,172019,298298,154878,42098,6849,682,
%U A400238 39,1,1142937,2257890,1355140,435344,86643,11176,923,45,1
%N A400238 Array read by upwards antidiagonals: T(n,k) is the coefficient of x^n in (1 - 2*x - 3*x^2 - 4*x/(1-x))^(-k - 1/2) for n >= 0, k >= 0.
%C A400238 Illustrates the modular integrality theorem (Theorem 2 in Dmytryshyn, 2026) for half-integer convolutions: for generating functions of the form (1 - delta*(2*x + 3*x^2) - 4*x*P(x))^(-k - 1/2) with integer power series P(x), all coefficients remain strictly integers despite the rational divisors (n - 1) in the non-stationary recurrence. Here delta = 1 and P(x) = 1/(1 - x) combine the central trinomial triangle (A111960, for P(x) = 0) and Seiichi Manyama's array (A377197-A377200, for delta = 0) into a single 4th-order holonomic recurrence whose order is invariant with respect to k.
%H A400238 Dmytro Dmytryshyn, <a href="https://doi.org/10.13140/RG.2.2.32268.68489">A Method of Non-Stationary Recurrence Relations for Computing Convolutions of Higher and Fractional Orders</a>, 2026.
%F A400238 G.f. for column k: (1 - 2*x - 3*x^2 - 4*x/(1-x))^(-k - 1/2).
%F A400238 n*T(n,k) = (8*n - 5 + 6*k)*T(n-1,k) - (6*n - 13 - 2*k)*T(n-2,k) - (4*n - 7 + 10*k)*T(n-3,k) + 3*(n - 3 + 2*k)*T(n-4,k) for n >= 2 with T(0,k) = 1, T(1,k) = 3 + 6*k (and T(n,k) = 0 for n < 0).
%e A400238 The array T(n,k) (with n >= 0, k >= 0) begins:
%e A400238        k = 0      k = 1      k = 2      k = 3      k = 4        k = 5
%e A400238 ========================================================================
%e A400238 n = 0:     1,         1,         1,         1,         1,           1
%e A400238 n = 1:     3,         9,        15,        21,        27,          33
%e A400238 n = 2:    17,        78,       175,       308,       477,         682
%e A400238 n = 3:   101,       636,      1795,      3794,      6849,       11176
%e A400238 n = 4:   629,      5031,     17090,     42098,     86643,      158609
%e A400238 n = 5:  4019,     39009,    154878,    427838,    964342,     2037915
%p A400238 T := proc(n, k) local G := (1-2*z-3*z^2-4*z/(1-z))^(-k-1/2):
%p A400238        coeff(series(G, z, n+2), z, n)
%p A400238      end proc:
%p A400238 seq(seq(T(d-k, k), k=0..d), d=0..8);
%Y A400238 Cf. A016945 (row n=1), A085362, A377197, A377199, A377200, A111960.
%K A400238 nonn,easy,tabl,new
%O A400238 0,2
%A A400238 _Dmytro Dmytryshyn_, Nov 04 2026
