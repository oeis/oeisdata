%S A400255 2,2,2,2,2,2,2,2,2,4,6,2,2,2,2,4,2,2,2,2,4,2,2,2,2,8,2,2,6,4,6,2,2,4,
%T A400255 2,2,4,4,2,2,2,3,2,2,2,4,2,2,2,2,4,2,2,4,2,4,2,2,4,6,4,2,3,2,2,2,4,4,
%U A400255 2,2,3,2,2,2,4,2,3,2,4,2,2,4,2,2,3,2,8,6,2,4,2,2,2,2,2,6,2,2,2,4,2,4,4,2,2
%N A400255 a(n) = k for those numbers [sequence A400254] whose k-th arithmetic derivative is zero for some k, but which themselves are not derivative of any number.
%H A400255 Antti Karttunen, <a href="/A400255/b400255.txt">Table of n, a(n) for n = 1..7296</a>
%F A400255 a(n) = A099307(A400254(n)).
%F A400255 {A099307(k) for those k for which A099302(k)=0 and A099307(k)>0}.
%o A400255 (PARI)
%o A400255 A003415checked(n) = if(n<=1, 0, my(f=factor(n), s=0); for(i=1, #f~, if(f[i,2]>=f[i,1],return(0), s += f[i, 2]/f[i, 1])); (n*s));
%o A400255 A099307(n) = { my(s=1); while(n>1, n = A003415checked(n); s++); if(n,s,0); };
%o A400255 k=0; n=1; while(n<1025, n++; if(0==A099302(n) && (s=A099307(n))>0, print1(s, ", ")));
%Y A400255 Cf. A003415, A098700, A099302, A099308, A189760, A400254.
%K A400255 nonn,new
%O A400255 1,1
%A A400255 _Antti Karttunen_, Oct 07 2026
