%S A400234 350,370300,292723200,205686097400,135495228793750,85686874160025600,
%T A400234 52682956769402100050,31730077999377203849200,
%U A400234 18811902258650627643686400,11015374215523479409853787500,6385589440413978218680676115850,3671120201658032122273489607884800
%N A400234 Number of spanning trees in the Klein bottle graph K_{3,2n}.
%C A400234 The Klein bottle graph K_{m,L} is defined on the m X L grid with periodic boundary conditions in the vertical direction (cylinder) and antiperiodic boundary conditions with twist in the horizontal direction: (r,L-1) ~ (m-1-r,0).
%C A400234 For m=3 and L=2n, the graph has 6n vertices and is 4-regular (with multi-edges on the middle row r=1 where the twist maps r -> m-1-r = 1).
%C A400234 This sequence is part of a family of spanning tree enumerations on surfaces: cf. A006235 (cylinder), A020871 (Möbius strip).
%e A400234 For n=1, the Klein bottle graph K_{3,2} has 6 vertices and 12 edges (including 2 multi-edges). It has a(1) = 350 spanning trees.
%e A400234 For n=2, the Klein bottle graph K_{3,4} has 12 vertices and 24 edges, and a(2) = 370300.
%o A400234 (Python)
%o A400234 import sympy as sp
%o A400234 def klein_laplacian(m, L):
%o A400234     V = m * L
%o A400234     L_mat = sp.zeros(V, V)
%o A400234     def idx(r, c): return (r % m) * L + (c % L)
%o A400234     for r in range(m):
%o A400234         for c in range(L):
%o A400234             u = idx(r, c)
%o A400234             v_down = idx((r + 1) % m, c)
%o A400234             v_up = idx((r - 1) % m, c)
%o A400234             if c == 0:
%o A400234                 v_right = idx(r, 1)
%o A400234                 v_left = idx(m - 1 - r, L - 1)
%o A400234             elif c == L - 1:
%o A400234                 v_right = idx(m - 1 - r, 0)
%o A400234                 v_left = idx(r, L - 2)
%o A400234             else:
%o A400234                 v_right = idx(r, c + 1)
%o A400234                 v_left = idx(r, c - 1)
%o A400234             L_mat[u, u] = 4
%o A400234             for v in [v_down, v_up, v_right, v_left]:
%o A400234                 if u != v:
%o A400234                     L_mat[u, v] -= 1
%o A400234     return L_mat
%o A400234 def a(n):
%o A400234     L_mat = klein_laplacian(3, 2 * n)
%o A400234     L_red = L_mat[:-1, :-1]
%o A400234     return int(L_red.det())
%Y A400234 Cf. A006235 (cylinder), A020871 (Möbius strip).
%K A400234 nonn,hard,new
%O A400234 1,1
