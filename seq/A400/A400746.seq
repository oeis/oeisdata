%N A400746 G.f. A(x) satisfies: A(x) = 1 + x * A(2*x/(1 - 2*x)) / (1 - x)^2.
%F A400746 a(0) = 1; a(n) = n + Sum_{k=1..n-1} Sum_{j=k..n-1} binomial(j-1, k-1) * (n-j) * 2^j * a(k) for n >= 1.
%t A400746 nmax = 16; A[_] = 0; Do[A[x_] = 1 + x A[2 x/(1 - 2 x)]/(1 - x)^2 + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A400746 (* Alternative: *)
%t A400746 a[0] = 1; a[n_] := a[n] = n + Sum[Sum[Binomial[j - 1, k - 1] (n - j) 2^j a[k] , {j, k, n - 1}], {k, 1, n - 1}]; Table[a[n], {n, 0, 16}]
%Y A400746 Cf. A007405, A040027, A126443, A352859.
%K A400746 nonn,new
%O A400746 0,3
