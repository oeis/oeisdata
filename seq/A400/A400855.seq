%T A400855 32,33,35,36,39,40,41,42,44,45,46,48,50,51,52,53,54,55,56,58,60,63,64,
%U A400855 65,66,68,69,70,72,74,75,78,80,81,82,83,84,86,87,88,89,90,92,95,96,98,99,100,102,104,105,106,108,110,111,112,113,114,115,116,117,119,120,123,125,126,128,130,131,132,134,135,136,138,140,141,144,145,146,147,148,150,153,154,155,156,158,159,160,162,164,165,166,168,171,172,173,174,175,176,178,179,180,183
%N A400855 Values taken by A046073.
%C A400855 If the multiplicative group of integers modulo k is of the form C_{2m_1} X ... X C_{2m_r}, with m_1 | m_2 | ... | m_r, then the number of squares modulo k is A046073(k) = m_1*...*m_r. In particular, any k with A046073(k) = n must divide A079612(2*n).
%C A400855 For squarefree n > 1, A046073(k) = n if and only if the multiplicative group of integers modulo k is of the form (C_2)^r X C_{2n} (cf. A400852).
%C A400855 More terms are shown to distinguish this sequence from A396684: 175 is a term here but not in A396684, while 182 is a term in A396684 but not here. Cf. A398925.
%H A400855 Jianing Song, <a href="/A400855/b400855.txt">Table of n, a(n) for n = 1..10000</a>
%H A400855 Jianing Song, <a href="/A399566/a399566.txt">List of k such that A046073(k) = n <= 1889</a>.
%H A400855 Jianing Song, <a href="/A400852/a400852_2.txt">PARI program for A400852</a>.
%o A400855 (PARI)
%o A400855 v(n) = select(x->A046073(x)==n, divisors(A079612(2*n))); \\ Gives the list of k such that A046073(k) = n; see A046073 and A079612 for their PARI programs. Warning: This is very inefficient since A079612(2*n) can easily have tens of millions of divisors. For squarefree n, it is much more advised to use multgp() given in the link of the PARI program for A400852.
%o A400855 isA400855(n,first_search=10) = {
%o A400855   my(found=(multgp(n)!=[])); if(found, return(1)); \\ check if the multiplicative groups of squares modulo k can be cyclic of order n, using multgp() in the PARI program for A400852
%o A400855   if(issquarefree(n) && !found, return(0));
%o A400855   for(k=1, n*first_search, if(A046073(k)==n, return(1))); \\ do a naive search to see if a small solution is available
%o A400855   return(v(n)!=[]);
%o A400855 };
%Y A400855 Cf. A399566, A398925, A046073, A079612, A396684, A400852.
%K A400855 nonn,new
%O A400855 1,2
%A A400855 _Jianing Song_, Oct 07 2026
