%I A400741 #4 Oct 11 2026 18:51:48
%S A400741 1,1,1,1,2,3,6,7,16,25,57,68,210,293,541,1017,2570,2778,9198,11310,
%T A400741 27530,47906
%N A400741 Number of monic polynomials g(x) of degree n over GF(2) such that g(x^2+x) is a primitive polynomial.
%C A400741 Equivalently, the number of primitive polynomials f of degree 2n over GF(2) such that f(x+1) = f(x).
%F A400741 a(n) = (1/(2*n)) * #{u in GF(4^n) : u has multiplicative order 2^n+1 and u + u^(2^n) is a primitive element of GF(2^n)}.
%e A400741 a(2) = 1: g(x) = x^2+x+1 gives g(x^2+x) = x^4+x+1, which is primitive.
%o A400741 (PARI) a(n) = {my(N=2^(2*n)-1, fa=factor(N)[,1], c=0, g, f, r, ok); for(k=0, 2^n-1, g=Mod(1,2)*(x^n+Pol(binary(k))); f=subst(g,x,x^2+x); if(polcoef(f,0)==0, next); if(!polisirreducible(f), next); r=Mod(x,f); ok=1; for(i=1, #fa, if(r^(N/fa[i])==1, ok=0; break)); if(ok, c++)); c}
%o A400741 (PARI) \\ Faster program, using the formula
%o A400741 V2(m,t) = {my(u=0*t, w=t, b=binary(m)); for(i=1, #b, if(b[i]==0, [u,w]=[u^2,u*w+t], [u,w]=[u*w+t,w^2])); u}
%o A400741 a2(n) = {my(q=2^n, K, fq, fu, t, y, s, ok, c=0, v0, v1, v2, i=0); if(n==1, return(1)); K=ffgen(2^n,'z); fq=factor(q-1)[,1]; fu=factor(q+1)[,1]; until(ok, i++; t=K^i; y=1/t; s=0*t; for(j=1, n, s+=y; y=y^2); ok=(s==1); if(ok, for(j=1, #fu, if(V2((q+1)/fu[j], t)==0, ok=0; break)))); v0=0*t; v1=t; for(k=1, q/2, if(gcd(k,q+1)==1, ok=1; for(j=1, #fq, if(v1^((q-1)/fq[j])==1, ok=0; break)); if(ok, c++)); v2=t*v1+v0; v0=v1; v1=v2); c/n}
%Y A400741 Cf. A000048.
%K A400741 nonn,more,new
%O A400741 1,5
