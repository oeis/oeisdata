%N A400262 The length of primorial base (A049345) representation of the arithmetic derivative of n; a(0) = a(1) = 0 by convention.
%C A400262 The one-based index of the most significant digit of n' [the arithmetic derivative of n, A003415] in the primorial base; a(0) = a(1) = 0 by convention.
%H A400262 Antti Karttunen, <a href="/A400262/b400262.txt">Table of n, a(n) for n = 0..10000</a>
%H A400262 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400262 a(n) = A235224(A003415(n)).
%F A400262 a(n) = A061395(A327859(n)).
%F A400262 a(n) = A055396(A400153(n)).
%o A400262 (PARI) A400262(n) = if(n<=1, 0, my(f=factor(n), ad = n*sum(i=1, #f~, f[i, 2]/f[i, 1]), p=2, i=0); while(ad, d = ad%p; ad \= p; p = nextprime(1+p); i++); (i));
%Y A400262 Cf. A003415, A049345, A055396, A061395, A235224, A327859, A400153, A400260, A400261.
%K A400262 nonn,base,easy,new
%O A400262 0,5
