%U A400536 14,2,7,5,14,2,15,2,5,9,7,5,14,2,11,5,5,2,19
%N A400536 a(n) = A238690(A071364(n)).
%C A400536 Row lengths of A400535.
%H A400536 Michael De Vlieger, <a href="/A400536/b400536.txt">Table of n, a(n) for n = 1..10000</a>
%t A400536 a071364[x_] := If[x == 1, 1, Times @@ MapIndexed[Prime[First[#2]]^#1 &, FactorInteger[x][[All, -1]] ] ];
%t A400536 a238690[x_] := If[Abs[x] <= 1, 1, Module[{facs = FactorInteger@ Abs[x]}, Count[Tuples@ Map[Range[0, #] &, If[x == 1, {}, Flatten[ConstantArray[PrimePi[#1], #2] & @@@ facs] ] ], _?(OrderedQ[#, LessEqual] &) ] ] ];
%t A400536 Array[a238690 @* a071364, 90]
%Y A400536 Cf. A071364, A238690, A400535.
%K A400536 nonn,new
