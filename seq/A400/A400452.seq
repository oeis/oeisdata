%T A400452 0,4,0,0,0,4,0,0,0,2,2,0,0,6,1,2,0,2,0,4,0,4,0,0,0,4,0,0,2,5,0,0,0,2,
%U A400452 0,0,0,6,0,0,2,2,0,0,0,6,3,0,0,4,0,0,0,4,0,4
%N A400452 The number of divisors d of n such that gcd(d, n/d) is a prime power (A246655).
%C A400452 Differs from A048105 at n = 36, 72, 100, 108, 144, 180, 196, 200, ... .
%C A400452 a(n) depends only on the prime signature of n (A118914).
%H A400452 Amiram Eldar, <a href="/A400452/b400452.txt">Table of n, a(n) for n = 1..10000</a>
%F A400452 a(n) = A007875(n) * A046660(n).
%F A400452 a(n) = 0 if and only if n is squarefree (A005117).
%F A400452 a(n) = 1 if and only if n is a square of a prime (A001248).
%F A400452 a(n) = 2 if and only if n is a term in A285508.
%F A400452 a(n) = 3 if and only if n is a 4th power of a prime (A030514).
%F A400452 a(n) is an odd prime p if and only if n is a prime power of the form q^(p+1) where q is a prime.
%F A400452 a(p^e) = e-1 for a prime p and e >= 1. Therefore, each nonnegative number occurs infinitely many times in this sequence.
%t A400452 a[n_] := Module[{e = FactorInteger[n][[;;, 2]]}, 2^(Length[e]-1) * Total[e - 1]]; Array[a, 90]
%o A400452 (PARI) a(n) = {my(e = factor(n)[,2]); 2^(#e-1) * (vecsum(e) - #e);}
%Y A400452 Cf. A001248, A005117, A007875, A030514, A046660, A048105, A118914, A246655, A285508, A400390.
%Y A400452 The number of divisors d of n such that gcd(d, n/d) is: A034444 (1), A069733 (odd), A365171 (square), A365173 (exponentially odd), A365207 (power of 2), A365208 (3-smooth), A365210 (5-rough), A369310 (powerful), A400450 (prime), this sequence (prime power).
%K A400452 nonn,easy,new
%O A400452 1,8
