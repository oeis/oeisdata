%U A400245 23006564474,72183117372,226513350420,710931841948,2231710832280,7006835166723,22002746056237,69103319850336
%N A400245 G.f. A(x) satisfies A(x) = A(x^2/(1 - x)^3) / (1 - x)^3, with A(0) = 1.
%F A400245 a(0) = 1; a(n) = Sum_{k=0..floor(n/2)} binomial(n+k+2,3*k+2) * a(k).
%F A400245 G.f.: B(x)^3 where B(x) is the g.f. of A400241.
%o A400245 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=0, i\2, binomial(i+j+2, 3*j+2)*v[j+1])); v;
%Y A400245 Cf. A400241, A400243.
%Y A400245 Cf. A354695.
