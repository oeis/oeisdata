%S A400397 1,5,6,13,8,30,10,27,19,40,14,78,16,50,48,51,20,95,22,104,60,70,26,
%T A400397 162,37,80,52,130,32,240,34,93,84,100,80,247,40,110,96,216,44,300,46,
%U A400397 182,152,130,50,306,63,185,120,208,56,260,112,270,132,160,62,624,64,170,190,169
%N A400397 a(n) = Sum_{d_1|n, d_2|n} gcud(d_1, d_2), where gcud is the greatest common unitary divisor.
%H A400397 Amiram Eldar, <a href="/A400397/b400397.txt">Table of n, a(n) for n = 1..10000</a>
%F A400397 Multiplicative with a(p^e) = (p^(e+1)-1)/(p-1) + e*(e+1).
%F A400397 Dirichlet g.f.: zeta(s-1) * zeta(s)^3 * Product_{p prime} (1 - 2/p^(2*s-1) + 1/p^(2*s)).
%F A400397 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = zeta(2)^3 * Product_{p prime} (1 - 2/p^3 + 1/p^4) = 3.31454724162534245982... .
%t A400397 f[p_, e_] := (p^(e+1)-1)/(p-1) + e*(e+1);
%t A400397 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n];
%t A400397 Array[a, 100]
%o A400397 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, (f[i,1]^(f[i,2]+1)-1)/(f[i,1]-1) + f[i,2]*(f[i,2]+1));}
%Y A400397 Cf. A060724 (gcd analog), A077610, A165430, A400391.
%K A400397 nonn,mult,easy,new
%O A400397 1,2
%A A400397 _Amiram Eldar_, Sep 25 2026
