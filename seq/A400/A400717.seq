%N A400717 G.f. A(x) satisfies: A(x) = 1 + x * A(2*x/(1 - 2*x)^2) / (1 - x).
%F A400717 a(0) = 1; a(n) = a(n-1) + 2^(n-1) * Sum_{k=1..n-1} binomial(n+k-2,2*k-1) * a(k) for n >= 1.
%t A400717 nmax = 16; A[_] = 0; Do[A[x_] = 1 + x A[2 x/(1 - 2 x)^2]/(1 - x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A400717 (* Alternative: *)
%t A400717 a[0] = 1; a[n_] := a[n] = a[n - 1] + 2^(n - 1) Sum[Binomial[n + k - 2, 2 k - 1] a[k], {k, 1, n - 1}]; Table[a[n], {n, 0, 16}]
%Y A400717 Cf. A007405, A125273, A126443, A390837.
