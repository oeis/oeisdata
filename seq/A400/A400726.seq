%N A400726 Least prime factor of 4^n - 3^n.
%C A400726 See A398834 for a guide to related sequences.
%F A400726 a(n) = A020639(A005061(n)).
%t A400726 {x, y} = {4, 3}; p[n_] := p[n] = (x^n - y^n)/(x - y);
%t A400726 f[n_] := f[n] = FactorInteger[p[n]];
%t A400726 Map[First, Table[First[f[n]], {n, 2, 80}]]
%o A400726 (PARI) a(n) = vecmin(factor(4^n - 3^n)[,1]); \\ _Michel Marcus_, Nov 14 2026
