%N A400274 G.f. A(x) satisfies A(x) = (1 + x) * A(x^4 * (1 + x)^4), with A(0) = 1.
%F A400274 a(0) = 1; a(n) = Sum_{k=0..floor(n/4)} binomial(4*k+1,n-4*k) * a(k).
%o A400274 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=0, i\4, binomial(4*j+1, i-4*j)*v[j+1])); v;
