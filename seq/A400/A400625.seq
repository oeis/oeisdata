%I A400625 #20 Nov 11 2026 17:10:31
%S A400625 4,24,40,60,120,180,210,360,420,720,840,840,840,2520,3780,4620,6300,
%T A400625 7560,12600,13860,13860,15120,25200,25200,32760,33264,49140,55440,
%U A400625 55440,55440,55440,138600,163800,163800,166320,166320,166320,166320,166320,240240,277200
%N A400625 Smallest k such that A400943(k) >= n.
%C A400625 A400943(k) is the maximum length J of a chain of factorizations j*k = d(j)*e(j) (j = 1..J) with d(1), e(1) >= 2, d(j+1) >= d(j) + 2 and e(j+1) >= e(j) + 2.
%C A400625 Since A400943(m) <= A400943(k) whenever m divides k, the set of k with A400943(k) >= n is closed under multiplication; a(n) is its least element.
%C A400625 Every term is a term of A400583. A run of equal terms a(n) = ... = a(n+s) occurs exactly when A400943 jumps from n-1 to n+s at that record holder; e.g. a(11) = a(12) = a(13) = 840, where A400943 jumps from 10 to 13.
%C A400625 a(n) >= 16*n - 8 for n >= 2, with equality for n = 2 and n = 3 (see A400943).
%C A400625 All of the first 78 terms are 2-dense (A174973).
%C A400625 Terms computed with the exact state recursion for A400943 for all k <= 6*10^6, in agreement with the independent computation for k <= 1.5*10^6 in Pohl, "Divisorkettenfolgen".
%H A400625 Siegfried Pohl, <a href="/A400625/b400625.txt">Table of n, a(n) for n = 1..78</a>
%H A400625 Siegfried Pohl, <a href="https://doi.org/10.13140/RG.2.2.13829.72167">Divisorkettenfolgen</a>, ResearchGate.
%e A400625 a(2) = 24: 24 = 4*6, 48 = 6*8 is a chain of length 2, and no k < 24 has such a chain.
%e A400625 a(3) = 40: 40 = 5*8, 80 = 8*10, 120 = 10*12.
%p A400625 DDNext := proc(n, j, R) local N, S, d, e, U, Dv; N := (j+1)*n; S := {}; for d in R do e := iquo(j*n, d); U := iquo(N, e+2); for Dv in NumberTheory:-Divisors(N) do if d+2 <= Dv and Dv <= U then S := S union {Dv}; end if; end do; end do; return S; end proc:
%p A400625 A := proc(n) local R, j; R := select(d -> 2 <= d and 2*d <= n, NumberTheory:-Divisors(n)); j := 0; while 0 < nops(R) do j := j+1; R := DDNext(n, j, R); end do; return j; end proc:
%p A400625 M := proc(K, N) local L, best, n, v, k; L := Array(1..K, fill = 0); best := 0; for n from 2 to N while best < K do v := A(n); if v > best then for k from best+1 to min(v, K) do L[k] := n; end do; best := v; end if; end do; return convert(L, list); end proc:
%p A400625 M(20, 20000);
%Y A400625 Cf. A400943, A400583, A174973.
%K A400625 nonn,new
%O A400625 1,1
%A A400625 _Siegfried Pohl_, Nov 04 2026
