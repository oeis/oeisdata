%U A400750 72694902357968,695377504240903,6862522822268573,69786624638712808,730471902362487071,7861949530785052999,86923269409274774870
%N A400750 G.f. A(x) satisfies: A(x) = 1 + x * A(x/(1 - x)) / (1 - 2*x)^2.
%F A400750 a(0) = 1; a(n) = n * 2^(n-1) + Sum_{k=1..n-1} Sum_{j=0..n-k-1} binomial(n-j-2,k-1) * (j+1) * 2^j * a(k) for n >= 1.
%t A400750 nmax = 24; A[_] = 0; Do[A[x_] = 1 + x A[x/(1 - x)]/(1 - 2 x)^2 + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A400750 (* Alternative: *)
%t A400750 a[0] = 1; a[n_] := a[n] = n 2^(n - 1) + Sum[Sum[Binomial[n - j - 2, k - 1] (j + 1) 2^j a[k], {j, 0, n - k - 1}], {k, 1, n - 1}]; Table[a[n], {n, 0, 24}]
%Y A400750 Cf. A005493, A040027.
%K A400750 nonn,new
%O A400750 0,3
