%N A400603 a(1) = 1; a(n+1) = Sum_{k=1..n} a(n/gcd(n,k)) * a(k/gcd(n,k)).
%F A400603 a(p+1) = 1 + a(p) * Sum_{k=1..p-1} a(k), for prime p.
%t A400603 a[1] = 1; a[n_] := a[n] = Sum[a[(n - 1)/GCD[n - 1, k]] a[k/GCD[n - 1, k]], {k, 1, n - 1}]; Table[a[n], {n, 13}]
