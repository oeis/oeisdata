%S A400597 1,6,18,38,66,102,65,99,63,35,15,14,12,30,54,28,10,24,46,78,48,26,50,
%T A400597 84,126,174,230,231,175,176,234,300,372,298,370,450,540,636,740,741,
%U A400597 742,638,744,858,978,1106,1105,975,854,855,856,976,1104,1240,1386,1540
%N A400597 Squares visited by a chess king moving on the square spiral, always moving to an adjacent unvisited square whose number has the greatest number of distinct prime factors; ties are resolved by choosing the lowest number.
%C A400597 The board is numbered by the standard square spiral, with 1 at the origin, 2 immediately to its right, and 3 above 2. The king starts at square 1. At each step it moves to one of the eight adjacent squares that has not previously been visited.
%C A400597 The sequence is finite. The last term is a(126) = 29.
%H A400597 Bartlomiej Pawlik, <a href="/A400597/b400597.txt">Table of n, a(n) for n = 1..126</a>
%e A400597 Starting from a(4) = 38, the unvisited squares adjacent to 38 are 17, 36, 37, 39, 66, 67 and 68. The numbers 36, 39 and 68 each have two distinct prime factors, 17, 37 and 67 each have one, while 66 has three distinct prime factors. Hence a(5) = 66.
%t A400597 Module[{d=DeleteCases[Tuples[{-1,0,1},2],{0,0}],u,w,p={0,0},s={1},a,c},u[{x_,y_}]:=1+Which[y>=Abs[x],4y^2-y-x,-x>=Abs[y],4x^2-x-y,-y>=Abs[x],(4y-3)y+x,True,(4x-3)x+y];w[1]=0;w[n_]:=Length[FactorInteger[n]];While[True,c=Select[{u[#],#}&/@((p+#)&/@d),!MemberQ[s,#[[1]]]&];If[c=={},Break[]];a=First@SortBy[c,{-w[#[[1]]]&,#[[1]]&}];p=a[[2]];AppendTo[s,a[[1]]]];s]
%Y A400597 Cf. A001221, A335816, A333713, A335856, A335661.
%K A400597 nonn,walk,fini,full
%O A400597 1,2
