%T A400142 4,6,2,4,4,8,2,8,2,4,6,4,2,4,3,6,4,4,2,8,4,8,4,4,2,8,2,4,6,4,4,8,2,4,
%U A400142 4,8,2,12,2,4,6,4,4,8,2,4,5,4,2,8,4,4,4,8,2,12
%N A400142 The number of divisors d of n such that gcid(d, n/d) is odd, where gcid is the greatest common infinitary divisor.
%C A400142 Differs from A399832 at 16, 32, 48, 64, 80, ... .
%C A400142 The sum of these divisors is A400145(n).
%H A400142 Amiram Eldar, <a href="/A400142/b400142.txt">Table of n, a(n) for n = 1..10000</a>
%F A400142 Multiplicative with a(2^e) = 2^A000120(e) = A001316(e), and a(p^e) = e+1 for an odd prime p.
%F A400142 a(n) = A000005(n) * A037445(n) / A400143(n).
%F A400142 a(n) = A000005(n) * A001316(A007814(n)) / (A007814(n)+1) <= A000005(n).
%F A400142 Dirichlet g.f.: zeta(s)^2 * (1 - 1/2^s)^2 * Product_{k>=0} (1 + 1/2^(2^k*s-1)).
%t A400142 f[p_, e_] := e+1; f[2, e_] := 2^DigitSum[e, 2];
%t A400142 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A400142 (PARI) a(n) = {my(e = valuation(n, 2)); 2^hammingweight(e) * numdiv(n >> e);}
%Y A400142 Cf. A000005, A000120, A001316, A007814, A069733 (analogous with gcd), A399832 (unitary analog), A400137, A400145.
%Y A400142 The number of divisors d of n such that gcid(d, n/d) is: A037445 (1), A400138 (squarefree), A400139 (powerful), A400140 (square), A400141 (exponentially odd), this sequence (odd), A400143 (power of 2).
%K A400142 nonn,mult,easy,new
%O A400142 1,2
%A A400142 _Amiram Eldar_, Sep 20 2026
