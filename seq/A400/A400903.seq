%I A400903 #7 Oct 09 2026 08:45:49
%S A400903 7107,89281,91001,139897,176149,204001,289081,493697,1432999,2024641,
%T A400903 2165801,3438667,4014361,4154977,4864501,5733649,5768533,5894461,
%U A400903 5938141,7635121,7970689,8237773,8727121,10185841,12932989,14903461,15358641,16149169,23631049,25873381
%N A400903 Semi-Carmichael numbers (A400902) that are neither semiprimes nor Carmichael numbers.
%H A400903 Amiram Eldar, <a href="/A400903/b400903.txt">Table of n, a(n) for n = 1..128</a>
%H A400903 Miguel Ángel López, <a href="https://arxiv.org/abs/2610.09129">Idempotence in Carmichael and Giuga numbers and its application to the Agoh-Giuga conjecture</a>, arXiv:2610.09129 [math.NT], 2026. See p. 20.
%t A400903 q[k_] := CompositeQ[k] && Module[{f = FactorInteger[k]}, Length[f] > 2 && Max[f[[;; , 2]]] == 1 && !AllTrue[f[[;; , 1]], Divisible[k - 1, # - 1] &] && AllTrue[f[[;; , 1]], PowerMod[#, k, k] == # &]]; Select[Range[300000], q]
%o A400903 (PARI) isok(k) = if(k == 1 || isprime(k), 0, my(f = factor(k), iscarm = 1); if(!issquarefree(f) || #f~ < 3, return(0)); for(i = 1, #f~, if((k-1)%(f[i, 1]-1), iscarm = 0)); if(iscarm, return(0)); for(i = 1, #f~, if(Mod(f[i, 1], k)^k != f[i, 1], return(0))); 1);
%Y A400903 Subsequence of A005117 and A400902.
%Y A400903 Cf. A002997, A006881.
%K A400903 nonn,new
%O A400903 1,1
%A A400903 _Amiram Eldar_, Oct 08 2026
