%o A400993 (Python)
%o A400993 from math import prod
%o A400993 from sympy import primepi, factorint, integer_nthroot
%o A400993 from oeis_sequences.OEISsequences import bisection
%o A400993 def A400993(n):
%o A400993     def f(x): return int(n+x-1-sum(primepi(integer_nthroot(x,k)[0]) for k in range(1,x.bit_length())))
%o A400993     return prod(map(lambda x:primepi(x[0])**x[1],factorint(bisection(f,n,n)).items())) # _Chai Wah Wu_, Oct 15 2026
