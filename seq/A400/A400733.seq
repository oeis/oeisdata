%I A400733 #8 Oct 05 2026 15:34:04
%S A400733 36,900,1116,1756,1764,2340,2564,2916,3492,3996,4132,4508,5212,5508,
%T A400733 5860,6012,6300,7812,7964,8316,9692,10908,11484,12124,13212,14716,
%U A400733 15012,15740,16740,17308,17316,19620,19684,19836,20060,20124,20700,20708,20764,20988,23004
%N A400733 Numbers that are both preceded and followed by runs of 7 consecutive exponentially odd numbers (A268335).
%C A400733 The longest possible run of consecutive numbers that are all exponentially odd numbers is 7 since numbers of the form 8*k + 4 are not exponentially odd (A007814(8*k + 4) = 2 is even). Therefore, all the terms are of the form 8*k + 4 (A017113).
%C A400733 The asymptotic density of this sequence is (1/144) * Product_{p prime >= 5} (1 - 14/(p*(p+1))) = 0.001828335394460875306... .
%H A400733 Amiram Eldar, <a href="/A400733/b400733.txt">Table of n, a(n) for n = 1..10000</a>
%e A400733 36 is a term since {29, 30 = 2*3*5, 31, 32 = 2^5, 33 = 3*11, 34 = 2*17, 35 = 5*7} is a run of 7 consecutive exponentially odd numbers that precedes 36, and {37, 38 = 2*19, 39 = 3*13, 40 = 2^3*5, 41, 42 = 2*3*7, 43} is a run of 7 consecutive exponentially odd numbers that follows 36.
%t A400733 expOddQ[n_] := AllTrue[FactorInteger[n][[;; , 2]], OddQ];
%t A400733 q[n_] := AllTrue[8*n + Range[5, 11], expOddQ] && AllTrue[8*n + Range[-3, 3], expOddQ]; 8*Select[Range[2875], q] + 4
%o A400733 (PARI) isexpodd(n) = {my(f = factor(n)); for(i=1, #f~, if (!(f[i, 2] % 2), return (0))); 1;}
%o A400733 isok(k) = if(k % 8 == 4, for(i = -7, 7, if(i != 0 && !isexpodd(k + i), return(0))); 1, 0);
%Y A400733 Subsequence of A017113 and {A325058(k)-1 | k >= 1}.
%Y A400733 Cf. A007814, A068088, A268335.
%K A400733 nonn,easy,new
%O A400733 1,1
%A A400733 _Amiram Eldar_, Oct 05 2026
