%U A400199 2,1,1,4,5,3,0,3,5,4,0,5,5,5,6,7,1,1,1,1,1,0,6,1,0,1,2,3,4,6,2,1
%N A400199 H_x(y, z), the x-th hyperoperation of y and z, where (x, y, z) is the n-th triple in the canonical shell ordering of N^3 given by A144625.
%C A400199 a(312) = H_6(3, 2) = H_5(3, 3) = H_4(3, 7625597484987) is too large to include.
%H A400199 Wikipedia, <a href="https://en.wikipedia.org/wiki/Hyperoperation">Hyperoperation</a>
%F A400199 a(n) = H_x(A144628(n), A144629(n)) where x = A144627(n).
%F A400199 a(n) = H_x(A144625(3*n+1), A144625(3*n+2)) where x = A144625(3*n).
%F A400199 a(n) = H_x(A057556(3*n+2), A057556(3*n+1)) where x = A057556(3*n+3).
%F A400199 A189896(n) = a((9*n^3 + 14*n^2 + 7*n)/2).
%e A400199 a(2) = H_x(A144625(7), A144625(8)) where x = A144625(6) = H_0(1, 0) = 1.
%e A400199 a(76) = H_x(A144628(76), A144629(76)) where x = A144627(76) = H_1(2, 3) = 5.
%e A400199 a(201) = H_x(A057556(605), A057556(604)) where x = A057556(606) = H_3(2, 4) = 16.
%o A400199 (Python)
%o A400199 def H(b, c, d):
%o A400199     if not b:
%o A400199         return d + 1
%o A400199     elif not d:
%o A400199         if b == 1:
%o A400199             return c
%o A400199         elif b == 2:
%o A400199             return 0
%o A400199         else:
%o A400199             return 1
%o A400199     else:
%o A400199         return H(b-1, c, H(b, c, d-1))
%o A400199 def generate_sequence(max_shell: int):
%o A400199     n = 0
%o A400199     for s in range(max_shell + 1):
%o A400199         for z in range(s + 1):
%o A400199             for y in range(s - z + 1):
%o A400199                 x = s - z - y
%o A400199                 print(H(x, y, z), end=", ")
%o A400199                 n = n + 1
%o A400199 generate_sequence(max_shell=9)
