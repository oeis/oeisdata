%t A400546 (* First, load the regs program from A369609. Note: effective maximum for this method is nn = 16 for most computers. *)
%t A400546 nn = 14; P[x_] := Product[Prime[i], {i, x}]; s[0] = {1}; c = 0;
%t A400546 Table[Set[s[n], regs[-P[n], 2^nn * P[nn] ] ], {n, nn}];
%t A400546 Table[Set[m[n], Length[s[n]]], {n, 0, nn}];
%t A400546 Reap[Do[If[PrimeNu[#] == c, Sow[#]; c++] &@
%t A400546   Min@ Array[If[j > m[#], Infinity, s[#][[j]] ] &, nn + 1, 0],
%t A400546   {j, m[nn - 2]}] ][[-1, 1]]
