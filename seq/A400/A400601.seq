%S A400601 1,3,8,21,24,72,48,147,136,216,120,648,168,432,576,1029,288,1608,360,
%T A400601 1944,1152,1080,528,5544,1176,1512,2312,3888,840,7488,960,7203,2880,
%U A400601 2592,3456,17160,1368,3240,4032,16632,1680,14976,1848,9720,12864,4752,2208,45864,4656,14040
%N A400601 a(1) = 1; a(n) = Sum_{d|n, d<n} J_2(n/d) * a(d), where J_2 = Jordan function (A007434).
%F A400601 G.f. A(x) satisfies: A(x) = x + Sum_{k>=2} J_2(k) * A(x^k).
%F A400601 Dirichlet g.f.: 1 / (2 - zeta(s-2)/zeta(s)).
%F A400601 a(p) = p^2 - 1, where p is prime.
%F A400601 Sum_{k=1..n} a(k) ~ zeta(r) * n^r / (r*(2*zeta'(r) - zeta'(r-2))), where r = 3.6223199515704712933621305061261375931975746024858141866... is the root of the equation zeta(r-2)/zeta(r) = 2. - _Vaclav Kotesovec_, Oct 29 2026
%t A400601 a[1] = 1; a[n_] := a[n] = Sum[If[d < n, DirichletConvolve[j^2, MoebiusMu[j], j, n/d] a[d], 0], {d, Divisors[n]}]; Table[a[n], {n, 1, 50}]
%Y A400601 Cf. A006874, A007434, A046970.
