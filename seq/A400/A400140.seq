%T A400140 4,4,2,4,4,8,2,8,2,4,4,4,2,6,2,4,4,4,2,8,4,8,4,4,2,8,2,4,4,4,4,8,2,4,
%U A400140 4,8,2,8,2,4,4,4,4,8,2,6,3,4,2,8,4,4,4,8,2,8,4
%N A400140 The number of divisors d of n such that gcid(d, n/d) is a square, where gcid is the greatest common infinitary divisor.
%C A400140 First differs from A376887 at n = 64.
%C A400140 The sum of these divisors is A400144(n).
%H A400140 Amiram Eldar, <a href="/A400140/b400140.txt">Table of n, a(n) for n = 1..10000</a>
%F A400140 Multiplicative with a(p^e) = A029578(e+2).
%F A400140 a(n) <= A000005(n), with equality if and only if n is an exponentially odd number (A268335).
%F A400140 Dirichlet g.f.: zeta(2*s)^2 * Product_{p prime} (1 + 2/p^s).
%t A400140 f[p_, e_] := If[OddQ[e], e + 1, e/2 + 1];
%t A400140 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A400140 (PARI) f(e) = if(e % 2, e+1, e/2 + 1);
%o A400140 a(n) = vecprod(apply(f, factor(n)[, 2]));
%Y A400140 Cf. A000005, A000290, A029578, A268335, A365171 (analogous with gcd), A376887, A399830 (unitary analog), A400137, A400144.
%Y A400140 The number of divisors d of n such that gcid(d, n/d) is: A037445 (1), A400138 (squarefree), A400139 (powerful), this sequence (square), A400141 (exponentially odd), A400142 (odd), A400143 (power of 2).
%K A400140 nonn,mult,easy,new
%O A400140 1,2
