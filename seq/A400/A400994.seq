%I A400994 #12 Oct 20 2026 15:55:09
%S A400994 1,54,258,270,276,366,609,639,1197,1199,1441,1782,1892,2167,2365,2398,
%T A400994 2628,2650,2882,2893,3311,3377,3409,3679,3784,4103,4257,4323,4334,
%U A400994 4343,4455,4730,5203,5302,5786,5995,6181,6501,6523,7205,7249,13461,15126,16062,17332
%N A400994 Numbers k such that the circulant matrix formed by their decimal digits and the one formed by the decimal digits of the sum of their divisors have the same determinant.
%H A400994 Paolo P. Lava, <a href="/A400994/b400994.txt">Table of n, a(n) for n = 1..4100</a>
%e A400994                                                    | 1 2 0 |
%e A400994 a(2) = 54 -> sigma(54) = 120 and det | 5 4 | = det | 0 1 2 | = 9;
%e A400994                                      | 4 5 |       | 2 0 1 |
%e A400994 .
%e A400994                                                | 1 3 4 6 1 |       | 2 0 5 4 4 |
%e A400994                                                | 1 1 3 4 6 |       | 4 2 0 5 4 |
%e A400994 a(42) = 13461 -> sigma(13461) = 20544 and  det | 6 1 1 3 4 | = det | 4 4 2 0 5 | = 5325.
%e A400994                                                | 4 6 1 1 3 |       | 5 4 4 2 0 |
%e A400994                                                | 3 4 6 1 1 |       | 0 5 4 4 2 |
%p A400994 with(numtheory): with(linalg): CM:=proc(w) local a,b,c,d,k,j,t; a:=convert(w,base,10); c:=[]; d:=length(w);
%p A400994 for k from 1 to nops(a) do c:=[op(c),a[-k]]; od; t:=[op([]), c]; for k from 2 to d do b:=[op([]),c[nops(c)]];
%p A400994 for j from 1 to nops(c)-1 do b:=[op(b),c[j]]; od; c:=b; t:=[op(t),c]; od; det(t); end:
%p A400994 P:=proc(q) local n,z; z:=[];
%p A400994 for n from 1 to q do if CM(n)=CM(sigma(n)) then z:=[op(z),n]; fi; od; op(z); end: P(2*10^4);
%Y A400994 Cf. A000203.
%K A400994 nonn,base,new
%O A400994 1,2
