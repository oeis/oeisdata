%T A400337 2359548,5379244,11762872,25630949,54071872,113448296,231961048,
%U A400337 471210808,937241768,1851281614,3592909944,6923856699,13144813540,24780874588,46118628376,85245073049,155799186368
%N A400337 G.f.: 1/G(-x), where G(x) is g.f. for A225543.
%C A400337 Fourth convolution of A400360.
%H A400337 Vaclav Kotesovec, <a href="/A400337/b400337.txt">Table of n, a(n) for n = 0..10000</a>
%F A400337 a(n) = |A400338(n)|.
%F A400337 G.f.: 1/Product_{k>=1} (1 - (-x)^k)^4 * (1 - x^k)^8.
%F A400337 G.f.: Product_{k>=1} (1 + x^k)^4 * (1 + x^(2*k))^4 / (1 - x^(2*k))^12.
%F A400337 a(n) ~ exp(Pi*sqrt(6*n)) * 3^(13/4) / (2^(33/4) * n^(15/4)).
%t A400337 CoefficientList[Series[1/(QPochhammer[-x]^4 * QPochhammer[x]^8), {x, 0, 30}], x]
%t A400337 (* Alternative: *)
%t A400337 nmax = 30; CoefficientList[Series[Product[(1 + x^k)^4 * (1 + x^(2*k))^4 / (1 - x^(2*k))^12, {k, 1, nmax}], {x, 0, nmax}], x]
%Y A400337 Cf. A002290, A225543, A399317, A400338, A400339, A400360.
