%N A400476 G.f. A(x) satisfies A(x) = (1 + x*A(x^2))^3.
%H A400476 Seiichi Manyama, <a href="/A400476/b400476.txt">Table of n, a(n) for n = 0..10000</a>
%F A400476 a(0) = 1; a(2*n+1) = 3*a(n) + Sum_{i,j,k>=0 and i+j+k=n-1} a(i)*a(j)*a(k) and a(2*n+2) = 3*Sum_{k=0..n} a(k)*a(n-k) for n >= 0.
%F A400476 a(0) = 1; a(n) = (1/n) * Sum_{k=0..floor((n-1)/2)} (-n+8*k+4)*a(k)*a(n-1-2*k).
%t A400476 terms = 42; A[_] = 1; Do[A[x_] = (1 + x*A[x^2])^3 + O[x]^terms // Normal, terms]; CoefficientList[A[x], x] (* _Stefano Spezia_, Sep 27 2026 *)
