%I A400658 #16 Oct 11 2026 20:14:57
%S A400658 0,1,2,7,11,4,5,10,8,20,16,30,6,3,12,15,21,24,40,14,13,23,22,32,31,41,
%T A400658 50,44,25,34,35,28,56,52,19,26,18,36,54,39,27,55,62,9,60,45,57,42,66,
%U A400658 47,46,80,64,43,38,70,33,48,72,68,58,17,29,76,82,74,75,81
%N A400658 Lexicographically earliest sequence of distinct natural numbers such that the concatenation of a(n-1) with a(n) is divisible by the sum of their digits and no quotient repeats.
%C A400658 Rearrangement of the natural numbers.
%C A400658 If we remove the condition that the terms must be distinct, the sequence consists of zeros interspersed with distinct numbers: 0, 1, 0, 12, 0, 18, 0, ...
%H A400658 Paolo P. Lava, <a href="/A400658/b400658.txt">Table of n, a(n) for n = 1..1000</a>
%e A400658 a(1) = 0;
%e A400658 a(2) = 1 -> (concatenation of 0 and 1) / (0 + 1) = 01 / 1 = 1;
%e A400658 a(3) = 2 -> (concatenation of 1 and 2) / (1 + 2) = 12 / 3 = 4;
%e A400658 a(4) = 7 -> (concatenation of 2 and 7) / (2 + 7) = 27 / 9 = 3;
%e A400658 a(5) = 11 -> (concatenation of 7 and 11) / (7 + 1 + 1) = 711 / 9 = 79; etc.
%p A400658 P:=proc(q) local a,b,c,d,k,j,n,v; v:=[]; a:=[0]; for j from 1 to q do
%p A400658 for k from 0 do if numboccur(k,a)=0 then b:=cat(a[nops(a)],k);
%p A400658 c:=convert(convert(a[nops(a)],base,10),`+`)+convert(convert(k,base,10),`+`);
%p A400658 if c>0 then d:=parse(b)/c; if frac(d)=0 then if numboccur(d,v)=0 then
%p A400658 v:=[op(v),d]; a:=[op(a),k]; break; fi; fi; fi; fi; od; od; op(a); end: P(10^3);
%Y A400658 Cf. A173660.
%K A400658 nonn,base,easy
%O A400658 1,3
%A A400658 _Paolo P. Lava_, Oct 02 2026
