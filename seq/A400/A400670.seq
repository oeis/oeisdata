%I A400670 #15 Oct 30 2026 12:40:49
%S A400670 1,1,1,2,2,4,6,9,13,21,31,48,69,106,152,233,332,499,714,1061,1519,
%T A400670 2237,3200,4682,6692,9743,13910,20175,28777,41602,59295,85487,121775,
%U A400670 175163,249403,358043,509606,730394,1039235,1487446,2115806,3024840,4301619,6143768,8735239
%N A400670 Number of distinct symmetric upper envelopes of primitive Dyck paths with area n.
%C A400670 The area of a Dyck path is half the number of complete unit squares beneath the path. Equivalently, it is the sum of the starting heights of its up-steps. Note that the envelope need not have area n. We classify paths according to their original area, then count their distinct envelopes.
%C A400670 The symmetric upper envelope E(P) is the pointwise least symmetric Dyck path lying weakly above P. Equivalently, E(P) is the pointwise maximum of P and P*, where P* is the reflection of P about its vertical midpoint.
%C A400670 The transformation P -> E(P) is a closure operator on the set of primitive Dyck paths of a fixed semilength, ordered by pointwise height. It is extensive, monotone and idempotent. Its fixed points are the symmetric primitive Dyck paths.
%H A400670 Peter Luschny, <a href="/A400670/a400670.txt">Python and SageMath program</a>.
%H A400670 Peter Luschny, <a href="/A400670/a400670.png">Illustration for n = 6</a>.
%e A400670 For n = 6, the 9 primitive paths split into the 6 envelope classes as follows:
%e A400670 E1 = UUUUDDDD       is a fixed point.
%e A400670 E2 = UUUDUDUDDD     is the envelope of UUDUUDUDDD and UUUDUDDUDD.
%e A400670 E3 = UUUDDUUDDD     is a fixed point.
%e A400670 E4 = UUUDDUDUUDDD   is the envelope of UUDUDUDUUDDD and UUUDDUDUDUDD.
%e A400670 E5 = UUDUUDUDDUDD   is the envelope of UUDUDUUDDUDD and UUDUUDDUDUDD.
%e A400670 E6 = UUDUDUDUDUDUDD is a fixed point.
%e A400670 This example is shown in the plot in the links.
%p A400670 A400670_list := proc(N) local H,lo,hi,A,n,h,r,d,k,u,m,t,x,y,L,S,a,prev;
%p A400670     H := iquo(1 + isqrt(8*N+1), 2);
%p A400670     lo := Array(0..H-1, 1..H, fill=0); hi := Array(0..H-1, 1..H, fill=0);
%p A400670     A  := Array(0..N); lo[0,1] := 1; hi[0,1] := 1;
%p A400670     a := 0; prev := 0; m := 1; t := 1;
%p A400670     for n from 0 to N do
%p A400670         if n = t then m += 1; t += m fi;
%p A400670         r := irem(n, H); d := r+1; if d = H then d := 0 fi;
%p A400670         L := 0; S := 0; k := r;
%p A400670         for h from 1 to m do
%p A400670             x := lo[r, h]; y := hi[r, h]; L += x; S += y;
%p A400670             lo[r, h] := 0; hi[r, h] := 0;
%p A400670             u := k+1; if u = H then u := 0 fi;
%p A400670             if h < H then lo[u, h+1] += x; hi[u, h+1] += y fi;
%p A400670             if h > 1 then lo[d, h-1] += x; hi[k, h-1] += y fi;
%p A400670             k := u; od;
%p A400670         a += L - prev; prev := S; A[n] := a;
%p A400670     od;
%p A400670 convert(A, list) end: A400670_list(44);
%o A400670 (Python) # See links.
%Y A400670 Cf. A005169, A400282.
%K A400670 nonn,new
%O A400670 0,4
