%T A400521 2,0,1,0,3,0,1,0,2,0,1,0,0,1,0,2,0,1,0,3,0,1,0,2,0,1,0,6,0,1,0,2,0,1,
%U A400521 0,3,0,1,0,2,0,1,0,1,0,2,0,1,0,3,0,1,0,2,0,1,0,5,0,1,0,2
%N A400521 The exponent of the highest power of 2 dividing the n-th exponentially squarefree number (A209061).
%H A400521 Amiram Eldar, <a href="/A400521/b400521.txt">Table of n, a(n) for n = 1..10000</a>
%F A400521 a(n) = A007814(A209061(n)).
%F A400521 a(n) <= A391899(n).
%F A400521 Asymptotic mean: Limit_{m->oo} (1/m) * Sum_{k=1..m} a(k) = Sum_{k>=1} k*mu(k)^2/2^k / (1 + Sum_{k>=1} mu(k)^2/2^k) = A371134 / (1 + A333182) = 0.87911805183287923423..., where mu(k)^2 = A008683(k)^2 = A008966(k).
%t A400521 IntegerExponent[Select[Range[100], AllTrue[FactorInteger[#][[;; , 2]], SquareFreeQ] &], 2]
%o A400521 (PARI) isexpsqf(n) = {my(e = factor(n)[,2]); for(i = 1, #e, if(!issquarefree(e[i]), return(0))); 1;}
%o A400521 list(kmax) = for(k = 1, kmax, if(isexpsqf(k), print1(valuation(k, 2), ", ")));
%Y A400521 Cf. A007814, A008683, A008966, A209061, A333182, A371134, A383029, A391899.
%Y A400521 Similar sequences: 1-A373550 (squarefree), A383004 (cubefree), A383005 (biquadratefree), A383006 (powerful), A383007 (cubefull), A383029 (exponentially odd), A386536 (cubefree but not squarefree).
%K A400521 nonn,easy,new
%O A400521 1,4
%A A400521 _Amiram Eldar_, Sep 29 2026
