%N A400341 Expansion of e.g.f. 1 / (1 + x)^sinh(x).
%F A400341 a(n) ~ (-1)^n * n! / ( Gamma(-sinh(1)) * n^(1+sinh(1)) ).
%t A400341 nmax = 25; CoefficientList[Series[1/(1 + x)^Sinh[x], {x, 0, nmax}], x] Range[0, nmax]!
%t A400341 (* Alternative: *)
%t A400341 a[0] = 1; a[n_] := a[n] = Sum[Sum[(-1)^(k - 1) Binomial[n - 1, k - 1] Binomial[k, 2 j - 1] (k - 2 j)! a[n - k], {j, 1, Floor[k/2]}], {k, 1, n}]; Table[a[n], {n, 0, 25}]
%Y A400341 Cf. A003724, A007118, A007119, A009198, A009231.
%K A400341 sign,new
%O A400341 0,3
