%I A400213 #12 Oct 03 2026 22:14:40
%S A400213 1,1,2,3,4,5,7,8,10,11,14,16,19,20,24,27,30,31,37,40,44,45,52,56,61,
%T A400213 62,70,73,80,82,91,96,102,104,114,120,127,129,140,147,154,156,169,176,
%U A400213 184,186,200,208,217,219,234,243,252,255,271,280,290,291,310,320,331
%N A400213 a(n) is the number of distinct areas of triangles formed by three vertices of a regular n-gon.
%C A400213 Represent a triangle by the unordered triple (r, s, t), where r, s, t are the numbers of polygon sides in the three arcs between consecutive chosen vertices. Then r + s + t = n, and for circumradius R its area is 2*R^2*sin(Pi*r/n)*sin(Pi*s/n)*sin(Pi*t/n).
%C A400213 A069905(n) is the number of these triangle shapes. The equal-area pairs of distinct shapes are exactly the following:
%C A400213   If n = 4*m: (k, 2*m - 2*k, 2*m + k) and (2*k, m - k, 3*m - k), 1 <= k < m/2. This gives floor((n - 4)/8) pairs.
%C A400213   If n = 24*h: (2*h, 10*h, 12*h) and (3*h, 6*h, 15*h).
%C A400213   If n = 30*h: (h, 11*h, 18*h) and (2*h, 6*h, 22*h); (4*h, 12*h, 14*h) and (6*h, 7*h, 17*h).
%C A400213 Equal areas occur iff (n >= 12 and 4 | n) or 30 | n.
%H A400213 Felix Huber, <a href="/A400213/b400213.txt">Table of n, a(n) for n = 3..10000</a>.
%H A400213 Felix Huber, <a href="https://doi.org/10.5281/zenodo.23082778">Equal Areas of Vertex Triangles in a Regular Polygon</a>, Oct 01 2026.
%H A400213 Felix Huber, <a href="/A400213/a400213.pdf">Illustration of the term a(12) = 11</a>.
%H A400213 Bjorn Poonen and Michael Rubinstein, <a href="https://doi.org/10.1137/S0895480195281246">The Number of Intersection Points Made by the Diagonals of a Regular Polygon</a>, SIAM J. Discrete Math. 11 (1998), 135-156.
%F A400213 a(n) = round(n^2/12) - [4 | n]*floor((n - 4)/8) - [24 | n] - 2*[30 | n], where [condition] = 1 if the condition is true and 0 otherwise.
%F A400213 a(2*k + 1) = A069905(2*k + 1) for positive integers k.
%e A400213 For n = 12 there are A069905(12) = 12 triangle shapes. The two shapes represented by (1, 4, 7) and (2, 2, 8) have the same area, so a(12) = 11.
%e A400213 For n = 30 there are A069905(30) = 75 triangle shapes. The shapes (1, 11, 18) and (2, 6, 22) have the same area, as do (4, 12, 14) and (6, 7, 17), so a(30) = 73.
%p A400213 A400213 := proc(n)
%p A400213     local a;
%p A400213     a := round(n^2/12);
%p A400213     if irem(n, 4) = 0 then a := a - floor((n - 4)/8) end if;
%p A400213     if irem(n, 24) = 0 then a := a - 1 end if;
%p A400213     if irem(n, 30) = 0 then a := a - 2 end if;
%p A400213     a
%p A400213 end proc:
%p A400213 seq(A400213(n), n = 3 .. 63);
%t A400213 A400213[n_] := Round[n^2/12] - If[Divisible[n, 4], Quotient[n - 4, 8] + Boole[Divisible[n, 24]], 0] - 2*Boole[Divisible[n, 30]];
%t A400213 Array[A400213, 100, 3] (* _Paolo Xausa_, Oct 03 2026 *)
%Y A400213 Cf. A069905, A371973, A004526, A005044, A008642, A079978, A174257.
%K A400213 nonn,new
%O A400213 3,3
