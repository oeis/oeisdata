%U A400572 821,853,857,859,877,911,941,967,997,1013,1049,1061,1063,1069,1097,1123,1151,1181,1193
%N A400572 Primes of the form the product of two semiprimes plus 1.
%C A400572 A prime p belongs to this sequence if and only if Omega(p - 1) = 4 (A001222), i.e., if and only if p-1 belongs to A014613.
%H A400572 Paolo Xausa, <a href="/A400572/b400572.txt">Table of n, a(n) for n = 1..10000</a>
%F A400572 Intersection of { A014613 + 1 } and { A000040 }.
%e A400572 37 is a term since 37 = (2*2)*(3*3) + 1 is a prime.
%p A400572 q:= n-> isprime(n) and numtheory[bigomega](n-1)=4:
%p A400572 select(q, [$1..1200])[];  # _Alois P. Heinz_, Sep 30 2026
%t A400572 Select[Prime[Range[200]], PrimeOmega[# - 1] == 4 &] (* _Paolo Xausa_, Oct 06 2026 *)
%Y A400572 Cf. A000040, A001222, A001358, A014613, A063640.
%K A400572 nonn,less,new
