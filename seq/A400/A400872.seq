%T A400872 1,9,1,1,1,3,1,1,1,3,3,1,1,6,3,3,1,3,1,3,1,3,1,1,1,3,1,1,3,9,1,1,1,3,
%U A400872 1,1,1,9,1,1,3,3,1,1,1,6,6,1,1,3,1,1,1,3
%N A400872 The total number of exponential divisors of the exponential divisors of n.
%C A400872 First differs from A388067 at n = 32.
%C A400872 The number of pairs of exponential divisors d_1 <= d_2 of n such that d_1 is an exponential divisor of d_2.
%C A400872 The sum of these divisors is A400873(n).
%H A400872 Amiram Eldar, <a href="/A400872/b400872.txt">Table of n, a(n) for n = 1..10000</a>
%F A400872 a(n) = Sum_{d exponential divisor of n} A049419(d) = Sum_{k=1..A049419(n)} A049419(A322791(n, k)).
%F A400872 Multiplicative with a(p^e) = A007425(e).
%F A400872 Asymptotic mean: Limit_{m->oo} (1/m) * Sum_{k=1..m} a(k) = Product_{p prime} (1-1/p)*(1 + Sum_{k>=1} A007425(k)/p^k) = 2.50298215217212840667... .
%t A400872 f1[p_, e_] := (e + 1)*(e + 2)/2; s[1] = 1; s[n_] := s[n] = Times @@ f1 @@@ FactorInteger[n];
%t A400872 f2[p_, e_] := s[e]; a[1] = 1; a[n_] := Times @@ f2 @@@ FactorInteger[n]; Array[a, 88]
%o A400872 (PARI) s(n) = vecprod(apply(e -> (e + 1)*(e + 2)/2, factor(n)[, 2]));
%o A400872 a(n) = vecprod(apply(e -> s(e), factor(n)[, 2]));
%Y A400872 Cf. A007425, A049419, A056624, A322791, A400873.
%Y A400872 Analogous sequences: A007425 (with all the divisors), A074816 (unitary), A375230 (infinitary).
%K A400872 nonn,mult,easy
%O A400872 1,4
%A A400872 _Amiram Eldar_, Oct 08 2026
