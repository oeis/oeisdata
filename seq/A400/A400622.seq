%U A400622 2841946482349046496,131758278257574407904,6487526857913619435720,338099914222611671723040,18593338034989875993605328
%N A400622 a(0) = 1; a(n) = Sum_{k=1..n} binomial(2*n+k,k) * a(n-k).
%F A400622 G.f. A(x) satisfies A(x) = (1-3*x) * (2*A(x*(1-x)^2) - 1).
%F A400622 3|a(n) for n > 0.
%o A400622 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(2*i+j, j)*v[i-j+1])); v;
