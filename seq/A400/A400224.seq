%U A400224 -4018520071561445376,-450168756921950011392,-5727935935131420524544,2820530234951242830839808,266018136814329304092770304
%N A400224 Sum_{n>=0} a(n) * x^n / (n!)^2 = exp(Si(x)), where Si(x) = Integral_{t=0..x} sin(t) / t dt.
%p A400224 a:= n-> n!^2*coeff(series(exp(Si(x)), x, n+1), x, n):
%p A400224 seq(a(n), n=0..20);  # _Alois P. Heinz_, Sep 22 2026
%t A400224 nmax = 20; CoefficientList[Series[Exp[SinIntegral[x]], {x, 0, nmax}], x] Range[0, nmax]!^2
%t A400224 (* Alternative: *)
%t A400224 a[0] = 1; a[n_] := a[n] = n! Sum[Binomial[n - 1, k - 1] If[EvenQ[k], 0, (-1)^Floor[k/2]/k] a[n - k]/(n - k)!, {k, 1, n}]; Table[a[n], {n, 0, 20}]
%Y A400224 Cf. A002017, A061079.
%K A400224 sign,new
%O A400224 0,3
