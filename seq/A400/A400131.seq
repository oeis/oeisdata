%S A400131 1,2,3,4,6,7,9,11,12,14,15,16,19,21,22,23,24,27,30,31,33,34,36,38,39,
%T A400131 42,44,46,47,48,49,51,54,56,57,59,60,63,64,66,67,69,70,71,73,74,75,76,
%U A400131 77,78,79,81,84,86,87,88,89,91,93,94,95,96,100,102,103,105,106,107,108
%N A400131 Positive integers k that are not narcissistic (Armstrong) numbers in any base b with 2 <= b <= k-2.
%C A400131 A positive integer k is narcissistic in base b if the sum of its base-b digits raised to the power of the number of digits equals k.
%C A400131 For b > k the representation is a single digit. For b = k-1 (n >= 3) the representation is 11_b and 1^2 + 1^2 = 2 != k. Hence only bases 2 <= b <= k-2 are checked.
%e A400131 4 is a term because 4 = 100_2 and 1^3 + 0^3 + 0^3 = 1 != 4.
%e A400131 5 is not a term because 5 = 12_3 and 1^2 + 2^2 = 5.
%t A400131 Select[Range[150], Function[n, n < 4 || ! AnyTrue[Range[2, n-2], Total[IntegerDigits[n, #]^IntegerLength[n, #]] == n &]]]
%Y A400131 Complement of A256359.
%Y A400131 Cf. A005188, A016038, A256360, A256361, A256362, A256363, A256364, A256365.
%K A400131 nonn,base,new
%O A400131 1,2
