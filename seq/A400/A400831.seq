%I A400831 #10 Oct 09 2026 12:23:39
%S A400831 1,2,2,12,2,24,2,180,36,72,2,2160,2,40,20,67500,2,38880,2,32400,60,
%T A400831 360,2,12150000,60,200,27000,90000,2,324000,2,59062500,100,1800,180,
%U A400831 19683000000,2,1000,300,17010000,2,2700000,2,45360,675000,9000,2,3986718750000,100,24300000,500,126000,2,6123600000,300,10631250000
%N A400831 a(n) = Product_{d|n} A276086(A300251(d)), where A300251 is Möbius transform of arithmetic derivative and A276086 is the primorial base exp-function.
%H A400831 Antti Karttunen, <a href="/A400831/b400831.txt">Table of n, a(n) for n = 1..10000</a>
%H A400831 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400831 A276085(a(n)) = A003415(n), A392878(a(n)) = A327859(n).
%o A400831 (PARI)
%o A400831 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400831 A300251(n) = sumdiv(n,d,moebius(n/d)*A003415(d));
%o A400831 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400831 A400831(n) = { my(m=1); fordiv(n, d, m *= A276086(A300251(d))); (m); };
%Y A400831 Cf. A003415, A276085, A276086, A300251, A327859, A392878, A400832 (rgs-transform).
%Y A400831 Cf. also A380459, A400833.
%K A400831 nonn,base,easy,new
%O A400831 1,2
%A A400831 _Antti Karttunen_, Oct 09 2026
