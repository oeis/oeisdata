%U A400574 13720135935702706032841,-6498998106243323820442489,3580493448912932766377169877,-2270057218726761113965745831053,1641055028288925900590269702851169
%N A400574 Expansion of 1/(1 + 1^2*x/(1 + 3*2^2*x/(1 + 3^2*x/(1 + 3*4^2*x/(1 + 5^2*x/(1 + 3*6^2*x/(1 + 7^2*x/(1 + ...)))))))), a continued fraction.
%H A400574 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/JacobiEllipticFunctions.html">Jacobi Elliptic Functions</a>.
%F A400574 Sum_{n>=0} a(n) * x^(2*n) / (2*n)! = cn(x,3), where cn() is the Jacobi elliptic function.
%F A400574 a(0) = 1; a(n) = 5 * a(n-1) - 6 * Sum_{i+j+k=n-1} (2*n-2)! / ((2*i)! * (2*j)! * (2*k)!) * a(i) * a(j) * a(k), n >= 1.
%F A400574 a(n) ~ (-1)^n * c * d^n * n^(2*n + 1/2), where d = 16*AGM(1, sqrt(3))^2 / (Pi^2*exp(2)) = 0.39449880858021103760429453275503849906872184... and c = 8*AGM(1, sqrt(3)) / sqrt(3*Pi) = 3.494311636945687135682602996416844970328367... - _Vaclav Kotesovec_, Oct 03 2026
%t A400574 nmax = 16; CoefficientList[Series[1/(1 + ContinuedFractionK[k^2 (2 + (-1)^k) x, 1, {k, 1, nmax}]), {x, 0, nmax}], x]
%t A400574 (* Alternative: *)
%t A400574 nmax = 16; DeleteCases[CoefficientList[JacobiCN[x, 3] + O[x]^(2 nmax + 2), x], 0] (2 Range[0, nmax])!
%Y A400574 Cf. A028296, A193540, A193544, A370543.
%K A400574 sign,new
%O A400574 0,3
