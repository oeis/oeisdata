%S A400891 1,3,5,6,7,9,11,13,14,15,17,19,21,22,23,25,26,27,29,30,31,33,35,37,38,
%T A400891 39,41,43,45,46,47,49,51,53,54,55,57,58,59,61,62,63,65,67,69,70,71,73,
%U A400891 75,77,78,79,81,83,85,86,87,89,90,91,93,94,95,97,99,101,102
%N A400891 Numbers k such that the 2-adic valuation of 3*k+2 is even.
%C A400891 This is used in A400894 for a bipartition of the positive odd numbers A005408 based on present even v2(3*k+2) = A007814(3*k+2) numbers.
%F A400891 v2(3*k+2) = A007814(3*k+2) is even iff k = a(n), for n >= 0.
%e A400891 5 is a term because A007814(17) = 0 because 17 is odd. (17/2^0 = 17).
%p A400891 q:= k-> is(irem(padic[ordp](3*k+2,2),2)=0):
%p A400891 select(q, [$0..102])[];  # _Alois P. Heinz_, Oct 08 2026
%t A400891 q[k_] := EvenQ[IntegerExponent[3*k + 2, 2]]; Select[Range[102], q] (* _Amiram Eldar_, Oct 08 2026 *)
%Y A400891 Cf. A005408, A007814, A400894.
%K A400891 nonn,easy
%O A400891 1,2
%A A400891 _Wolfdieter Lang_, Oct 08 2026
