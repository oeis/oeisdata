%I A400732 #8 Oct 05 2026 11:52:59
%S A400732 2,3,4,5,6,11,12,13,14,15,16,20,21,22,27,28,29,30,34,36,40,42,45,47,
%T A400732 52,53,54,56,58,59,60,61,63,65,66,67,68,69,72,75,77,78,79,81,83,84,85,
%U A400732 86,88,90,92,94,96,102,104,106,108,109,110,111,112,113,114,115
%N A400732 Numbers k such that k^2 - 1 and k^2 + 1 are both exponentially odd numbers (A268335).
%C A400732 A square has a prime factorization with only even exponents, while an exponentially odd number has only odd exponents.
%C A400732 The sequence of numbers k such that k^2 - 1 and k^2 + 1 are both squarefree numbers (twice the terms of A375497) is a subsequence of this sequence.
%C A400732 The asymptotic density of this sequence is (5/6) * Product_{prime p == 1 (mod 4)} (1 - 4/(p*(p+1))) * Product_{prime p == 3 (mod 4)} (1 - 2/(p*(p+1))) = 0.533182539214... .
%H A400732 Amiram Eldar, <a href="/A400732/b400732.txt">Table of n, a(n) for n = 1..10000</a>
%e A400732 2 is a term since 2^2-1 = 3 and 2^2+1 = 5 are both exponentially odd numbers.
%e A400732 3 is a term since 3^2-1 = 8 = 2^3 and 3^2+1 = 10 = 2*5 are both exponentially odd numbers (the exponents 1 and 3 are odd numbers).
%t A400732 expOddQ[k_] := AllTrue[FactorInteger[k][[;; , 2]], OddQ];
%t A400732 q[k_] := expOddQ[k^2-1] && expOddQ[k^2+1]; q[1] = False; Select[Range[115], q]
%o A400732 (PARI) isexpodd(n) = {my(f = factor(n)); for(i=1, #f~, if (!(f[i, 2] % 2), return (0))); 1;}
%o A400732 isok(k) = k > 1 && isexpodd(k^2-1) && isexpodd(k^2+1);
%Y A400732 Intersection of A400730 and A400731.
%Y A400732 Cf. A268335, A375497.
%K A400732 nonn,easy,new
%O A400732 1,1
%A A400732 _Amiram Eldar_, Oct 05 2026
