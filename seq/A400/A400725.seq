%S A400725 1,2,3,5,6,7,9,10,11,13,15,17,18,19,21,22,23,25,26,27,29,30,31,33,34,
%T A400725 35,37,38,39,41,43,45,46,47,49,50,51,53,54,57,58,59,61,62,63,65,66,67,
%U A400725 69,71,73,74,75,77,79,81,82,83,85,86,87,89,90,91,93,94
%N A400725 Numbers k such that 4^k - 3^k is squarefree.
%C A400725 See A398834 for a guide to related sequences.
%e A400725 4^1 - 3^1 = 1, 4^2 - 3^2 = 7, 4^3 - 3^3 = 37, 4^4-3^4 = 7*5^2, so that 1, 2, 3, are in the sequence and 4 is not.
%t A400725 {x, y} = {4, 3}; p[n_] := p[n] = (x^n - y^n)/(x - y);
%t A400725 Position[Map[SquareFreeQ, Table[p[n], {n, 1, 150}]], True] // Flatten
%o A400725 (PARI) isok(k) = issquarefree(4^k - 3^k); \\ _Michel Marcus_, Nov 13 2026
%Y A400725 Cf. A398834, A400724, A400726, A400727.
