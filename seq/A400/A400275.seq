%I A400275 #25 Oct 01 2026 14:32:24
%S A400275 1,2,2,9,8,40,52,303,446,2852,4527,29853,49542,334740,570292,3930123,
%T A400275 6823418,47768740,84155487,596755025,1063750750,7623606338,
%U A400275 13722384557,99223603971,180072089908,1311954533780,2397708652289,17583199464293,32330394085542,238436666075628,440746546654452
%N A400275 Number of strongly connected components of a directed graph Gamma_{2,n}(Z) related to wild frieze patterns.
%C A400275 Paths in the graph correspond to (possibly wild) SL_2-frieze patterns of height n over the integers.
%H A400275 M. Cuntz, <a href="https://doi.org/10.1080/10586458.2016.1172526">On wild frieze patterns</a>, Experimental Mathematics, Volume 26(2017), 342-348.
%H A400275 Leon Eickhoff, <a href="https://arxiv.org/abs/2609.20967">Wild frieze patterns over the integers</a>, arXiv:2609.20967 [math.CO], 2026.
%F A400275 a(n) = C(n+1)/(n+3) + (2/3)*C(n/3) + n/2 if n is even,
%F A400275 a(n) = 2*(C(n+1)/(n+3) + C((n+1)/2)/2 + (2/3)*C(n/3)) + (n-1)/2 if n is odd,
%F A400275 where C(k) is the k-th Catalan number (A000108) if k is an integer and 0 otherwise.
%F A400275 a(n) = A001683(n+3) + A004526(n) if n is even.
%F A400275 a(n) = 2*A001683(n+3) + A004526(n) if n is odd.
%o A400275 (Magma)
%o A400275 Cat := function(k)
%o A400275      if k in Integers() then
%o A400275           return Catalan(Floor(k));
%o A400275      else
%o A400275           return 0;
%o A400275      end if;
%o A400275 end function;
%o A400275 for k in [0..n] do
%o A400275      if k mod 2 eq 0 then
%o A400275           Cat(k+1)/(k+3)+2*Cat(k/3)/3+k/2;
%o A400275      else
%o A400275           2*(Cat(k+1)/(k+3)+Cat((k+1)/2)/2+2*Cat(k/3)/3)+(k-1)/2;
%o A400275      end if;
%o A400275 end for;
%Y A400275 Cf. A000108, A001683, A004526.
%K A400275 easy,nonn,new
%O A400275 0,2
%A A400275 _Leon Eickhoff_, Sep 22 2026
