%N A400479 G.f. A(x) satisfies A(x) = (1 + x*A(x^3))^3.
%H A400479 Seiichi Manyama, <a href="/A400479/b400479.txt">Table of n, a(n) for n = 0..10000</a>
%F A400479 a(0) = 1; a(3*n+1) = 3*a(n), a(3*n+2) = 3*Sum_{k=0..n} a(k)*a(n-k) and a(3*n+3) = Sum_{i,j,k>=0 and i+j+k=n} a(i)*a(j)*a(k) for n >= 0.
%F A400479 a(0) = 1; a(n) = (1/n) * Sum_{k=0..floor((n-1)/3)} (-n+12*k+4)*a(k)*a(n-1-3*k).
%t A400479 terms = 56; A[_] = 1; Do[A[x_] = (1 + x*A[x^3])^3 + O[x]^terms // Normal, terms]; CoefficientList[A[x], x] (* _Stefano Spezia_, Sep 27 2026 *)
