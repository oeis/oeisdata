%I A400291 #17 Nov 04 2026 16:53:28
%S A400291 3,7,13,353,449,641,353,449,641,1409,1621,8101,19441,27541,68041,1621,
%T A400291 8101,19441,27541,68041,119881,15901,63601,95401,111301,349801,
%U A400291 5724001,5739901,1879421,13155941,39467821,45106081,107126941,327019081,360848641,2317324861
%N A400291 Triangular array where row n lists the smallest n-tuple of primes p for which 1/p has the same period length in base 10, with respect to the sup norm.
%C A400291 We exclude the primes 2 and 5 which are usually considered to have no period at all, although they might be considered to have a period of length 0 (so they would constitute row 2), or even a period of length 1, viz. 1/2 = 0.4(9) and 1/5 = 0.1(9).
%e A400291   n | period length | primes
%e A400291 ----+---------------+------------------------------------
%e A400291   1 |       1       | 3:      1/3 = 0.(3)
%e A400291   2 |       6       | 7, 13:  1/7 = 0.(142857), 1/13 = 0.(076923)
%e A400291   3 |       32      | 353, 449, 641
%e A400291   4 |       32      | 353, 449, 641, 1409
%e A400291   5 |      1620     | 1621, 8101, 19441, 27541, 68041
%e A400291   6 |      1620     | 1621, 8101, 19441, 27541, 68041, 119881
%e A400291   7 |     15900     | 15901, 63601, 95401, 111301, 349801, 5724001, 5739901
%e A400291   8 |    1879420    | 1879421, 13155941, 39467821, 45106081, 107126941, 327019081, 360848641, 2317324861
%o A400291 (PARI) A400291_row(n)={my(M=Map(),P,s); forprime(p=2,, 10%p||next; mapput(M, P= znorder(Mod(10,p)), s=if(mapisdefined(M,P,&s), concat(s,p), [p])); #s<n || return(s))}
%Y A400291 Cf. A002329 (periods of reciprocals of integers prime to 10), A084680 (order of 10 modulo n).
%Y A400291 Cf. A400292 (period lengths), A400293 (largest prime of the least n-tuple).
%K A400291 nonn,base,tabl,hard,new
%O A400291 1,1
%A A400291 _M. F. Hasler_, Oct 19 2026
%E A400291 Row 8 from _Alper Ferudun_, Oct 20 2026
