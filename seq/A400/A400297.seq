%I A400297 #8 Nov 18 2026 17:32:59
%S A400297 1,2,4,6,9,12,14,15,17,19,21,23,25,27,29,31,33,35,37,39,41,43,45,47,
%T A400297 49,53,55,60,61,64,65,71,73,75,79,81,85,95,96,100,102,103,105,108,111,
%U A400297 114,115,117,122,124,125,127,130,132,133,137,141,143,146,152,155,158,162,163,165,167,169,171
%N A400297 a(n) is the maximum number of consecutive primes that sum up to A400296(n), the least prime establishing a new record for that number.
%H A400297 M. F. Hasler, <a href="/A400297/b400297.txt">Table of n, a(n) for n = 1..2500</a>
%F A400297 a(n) = max { k | A070281(k) = A400296(n) }.
%e A400297 See A400296.
%e A400297 Note that the smaller prime A070281(9) = 127 < A070281(7) = 197 = A070281(12) establishes a record with a(5) = 9, although it comes after 197 in A070281, but then 197 establishes a record as sum of a(6) = 12 consecutive primes.
%o A400297 (PARI) A400297=List(); my(A=A70281, N=#A-!A[#A], m, k); while(k<N, m=vecmin([p|p<-A[k++..N], p]); listput(A400297, k=vecmax([k|k<-[k..N], A[k]==m]))) \\ assuming A70281 is a precomputed initial segment of that sequence.
%Y A400297 Cf. A400296, A070281.
%K A400297 nonn,new
%O A400297 1,2
%A A400297 _M. F. Hasler_, Nov 12 2026
