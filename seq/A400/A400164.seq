%S A400164 0,1,1,2,1,2,1,2,2,2,1,3,1,3,2,3,1,3,1,3,3,3,1,3,2,3,3,3,1,3,1,3,3,3,
%T A400164 3,3,1,3,3,3,1,3,1,3,3,3,1,3,3,3,3,3,1,3,3,3,3,3,1,4,1,4,3,4,3,4,1,4,
%U A400164 3,4,1,4,1,4,3,4,3,4,1,4,3,4,1,4,3,4,3,4,1,4,3,4,4,4,3,4,1,4,4,4,1,4,1,4,4
%N A400164 The index of the largest prime dividing A380459(n), with a(1) = 0 by convention.
%H A400164 Antti Karttunen, <a href="/A400164/b400164.txt">Table of n, a(n) for n = 1..10000</a>
%H A400164 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400164 a(n) = Max_{d|n, d is a prime power (in A246655)} A235224(n/d).
%F A400164 a(n) <= A235224(n).
%F A400164 a(n) <= A400262(n).
%F A400164 a(n) = A061395(A380459(n)).
%F A400164 a(n) = A000720(A400165(n)).
%F A400164 a(n) = A235224(n) - A400166(n).
%F A400164 a(n) = A400262(n) - A400168(n).
%o A400164 (PARI)
%o A400164 A235224(n) = { my(s=0, p=2); while(n, s++; n = n\p; p = nextprime(1+p)); (s); };
%o A400164 A400164(n) = { my(m=0); fordiv(n, d, if(isprimepower(d), m = max(m,A235224(n/d)))); (m); };
%Y A400164 Cf. A000720, A061395, A235224, A246655, A349394, A380459, A400163, A400165 (corresponding prime), A400166, A400167 [k for which a(k) = A235224(k)], A400168, A400169 [k for which a(k)= A400262(k)], A400170, A400262.
%Y A400164 For n > 1, a(n) is the column index of the rightmost nonzero term on row n of array A400250.
%K A400164 nonn,easy,new
%O A400164 1,4
%A A400164 _Antti Karttunen_, Sep 22 2026
