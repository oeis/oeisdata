%U A400478 16586481160947012000,1096241819349768977750,89611393069672223157250,8231909066279988238693500,838656660340662549600233750
%N A400478 a(1)=1, a(2)=2; thereafter a(n) = (a(n-1)-a(n-2))*sum of digits(a(n-1)+a(n-2)).
%F A400478 a(1)=1, a(2)=2; a(n) = (a(n-1)-a(n-2))*A007953(a(n-1)+a(n-2)), n>=3.
%e A400478 a(3)=(2-1)*sum of digits(3)=1*3=3;
%e A400478 a(4)=(3-2)*sum of digits(5)=1*5=5;
%e A400478 a(5)=(5-3)*sum of digits(8)=2*8=16.
%o A400478 (Python)
%o A400478 def A400478(terms):
%o A400478     if terms == 1: return [1]
%o A400478     a = [1, 2]
%o A400478     for _ in range(terms - 2):
%o A400478         next_term = (a[-1] - a[-2]) * sum(int(d) for d in str(a[-1] + a[-2]))
%o A400478         a.append(next_term)
%o A400478     return a
%o A400478 print(A400478(22))
