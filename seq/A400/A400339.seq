%H A400339 Vaclav Kotesovec, <a href="/A400339/b400339.txt">Table of n, a(n) for n = 0..10000</a>
%t A400339 A225543[n_] := SeriesCoefficient[QPochhammer[x]^4 * QPochhammer[-x]^8, {x, 0, n}];
%t A400339 A400338[n_] := SeriesCoefficient[1/(QPochhammer[x]^4*QPochhammer[-x]^8), {x, 0, n}];
