%I A400534 #8 Oct 10 2026 21:26:57
%S A400534 0,0,1,2,3,4,4,6,7,8,8,10,9,12,12,12,15,16,16,18,17,18,20,22,21,24,24,
%T A400534 26,25,28,27,30,31,30,32,30,33,36,36,36,37,40,39,42,41,40,44,46,45,48,
%U A400534 48,48,48,52,52,50,53,54,56,58,57,60,60,58,63,62,63,66,65
%N A400534 a(n) is the maximum number of entries in row n of Pascal's triangle divisible by the same prime.
%C A400534 Entries are counted by position, so equal entries in symmetric positions are counted separately.
%C A400534 If n = Sum_i n_i*p^i is the base-p expansion of n, then Lucas' theorem implies that the number of entries in row n not divisible by p is Product_i (n_i + 1).
%C A400534 For n >= 2, a(n) <= n - 1 since the two end entries are 1. Equality holds if and only if n is a prime power.
%C A400534 a(n) = n - 2 if and only if n = 2*p^r for an odd prime p and r >= 1.
%C A400534 Let q be the largest prime <= n. By Bertrand's postulate, q > n/2 for n > 1, and the base-q expansion n = q + (n - q) gives a(n) >= 2*q - n - 1. Since q/n -> 1 by the prime number theorem, it follows that a(n)/n -> 1.
%C A400534 For every fixed M >= 2, the set of n such that n + 1 - a(n) <= M has natural density 0. In particular, n + 1 - a(n) is unbounded.
%C A400534 For every fixed prime p, the set of n for which p attains the maximum in the definition of a(n) has natural density 0.
%H A400534 Felix Huber, <a href="/A400534/b400534.txt">Table of n, a(n) for n = 0..10000</a>.
%H A400534 Danilo Bazzanella, <a href="https://doi.org/10.1017/S1446788709000020">Prime Numbers in Intervals Starting at a Fixed Power of the Integers</a>, J. Aust. Math. Soc. 87 (2009), 83-99.
%H A400534 N. J. Fine, <a href="https://doi.org/10.2307/2304500">Binomial Coefficients Modulo a Prime</a>, Amer. Math. Monthly 54 (1947), 589-592.
%H A400534 Felix Huber, <a href="/A400534/a400534.txt">Divisibility Concentration in Rows of Pascal's Triangle</a>.
%H A400534 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/BertrandsPostulate.html">Bertrand's Postulate</a>.
%H A400534 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/LucasCorrespondenceTheorem.html">Lucas Correspondence Theorem</a>.
%H A400534 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/PrimeNumberTheorem.html">Prime Number Theorem</a>.
%F A400534 a(n) = n + 1 - min_{p prime, p <= n} Product_i (n_i(p) + 1) for n >= 2, where n_i(p) are the base-p digits of n.
%F A400534 a(n) >= A048967(n).
%F A400534 a(n) = n - 1 if and only if n is in A000961.
%F A400534 a(n) = n - 2 if and only if n > 2 and n is in A278568.
%F A400534 lim_{n->infinity} a(n)/n = 1.
%F A400534 liminf_{n->infinity} (n + 1 - a(n)) = 2.
%F A400534 limsup_{n->infinity} (n + 1 - a(n)) = infinity.
%e A400534 For n = 12, the values of Product_i (n_i(p) + 1) for p = 2, 3, 5, 7, 11 are 4, 4, 9, 12, 4, respectively. Hence a(12) = 13 - 4 = 9.
%e A400534 For n = 16 = 2^4, all 15 non-end entries in row 16 are even, so a(16) = 15.
%p A400534 A400534 := proc(n)
%p A400534     option remember;
%p A400534     local b, d, m, p, q;
%p A400534     b := n + 1;
%p A400534     p := 2;
%p A400534     while p <= n do
%p A400534         m := n;
%p A400534         q := 1;
%p A400534         while m > 0 do
%p A400534             d := irem(m, p);
%p A400534             q := q*(d + 1);
%p A400534             m := iquo(m, p)
%p A400534         end do;
%p A400534         if q < b then
%p A400534             b := q
%p A400534         end if;
%p A400534         if b = 2 then
%p A400534             return n - 1
%p A400534         end if;
%p A400534         p := nextprime(p)
%p A400534     end do;
%p A400534     n + 1 - b
%p A400534 end proc:
%p A400534 seq(A400534(n), n = 0 .. 68);
%Y A400534 Cf. A000961, A001316, A006047, A007318, A048967, A278568.
%K A400534 nonn
%O A400534 0,4
%A A400534 _Felix Huber_, Oct 02 2026
