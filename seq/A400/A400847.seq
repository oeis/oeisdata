%T A400847 1063,1091,1231,1427,1543,1607,1669,1759,1789,2039,2087,2287,2423,
%U A400847 2687,2791,2819,3307,3413,3449,3467,3527,3607,4139,4289,4507,4787,4799,4831,4903,4951,5059,5197,5407,5563,5939
%N A400847 Primes p such that (p^2 + nextprime(p))/2 is also prime.
%H A400847 Paolo Xausa, <a href="/A400847/b400847.txt">Table of n, a(n) for n = 1..10000</a>
%e A400847 3 is a term because (3^2 + 5)/2 = 7, which is prime.
%e A400847 11 is a term because (11^2 + 13)/2 = 67, which is prime.
%e A400847 31 is a term because (31^2 + 37)/2 = 499, which is prime.
%e A400847 71 is a term because (71^2 + 73)/2 = 2521, which is prime.
%e A400847 107 is a term because (107^2 + 109)/2 = 5779, which is prime.
%p A400847 q:= p-> andmap(isprime, [p, (p^2+nextprime(p))/2]):
%p A400847 select(q, [$3..6000])[];  # _Alois P. Heinz_, Oct 07 2026
%t A400847 Pick[Most[#], PrimeQ[(Most[#]^2 + Rest[#])/2]] & [Prime[Range[1000]]] (* _Paolo Xausa_, Oct 14 2026 *)
%Y A400847 Cf. A000040, A000217, A001223, A151800.
%K A400847 nonn,less,changed
%O A400847 1,1
