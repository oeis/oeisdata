%S A400873 1,2,3,8,5,6,7,12,15,10,11,24,13,14,15,30,17,30,19,40,21,22,23,36,35,
%T A400873 26,33,56,29,30,31,36,33,34,35,120,37,38,39,60,41,42,43,88,75,46,47,
%U A400873 90,63,70,51,104,53,66,55,84,57,58,59,120,61,62,105,96,65,66,67,136
%N A400873 The total sum of exponential divisors of the exponential divisors of n.
%C A400873 The number of these divisors is A400872(n).
%H A400873 Amiram Eldar, <a href="/A400873/b400873.txt">Table of n, a(n) for n = 1..10000</a>
%F A400873 a(n) = Sum_{d exponential divisor of n} A051377(d) = Sum_{k=1..A049419(n)} A051377(A322791(n, k)).
%F A400873 a(n) = n if and only if n is squarefree (A005117).
%F A400873 Multiplicative with a(p^e) = Sum_{d|e} tau(d) * p^(e/d), where tau(d) is the number of divisors of d (A000005).
%F A400873 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = Product_{p prime} (1 + (1-1/p) * Sum_{k>=2} Sum_{d|k, d>2} tau(d)/p^(2*k-k/d)) = 1.28662838597230023721... .
%t A400873 f[p_, e_] := DivisorSum[e, DivisorSigma[0, #] * p^(e/#) &]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 68]
%o A400873 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, sumdiv(f[i, 2], d, numdiv(d) * f[i, 1]^(f[i, 2]/d)));}
%Y A400873 Cf. A000005, A005117, A049419, A051377, A322791, A400872.
%Y A400873 Analogous sequences: A007429 (with all the divisors), A107759 (unitary), A400874 (infinitary).
%K A400873 nonn,mult,easy,new
%O A400873 1,2
%A A400873 _Amiram Eldar_, Oct 08 2026
