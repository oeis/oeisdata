%I A400146 #7 Sep 21 2026 15:39:50
%S A400146 1,3,4,7,6,12,8,15,10,18,12,28,14,24,24,31,18,30,20,42,32,36,24,60,26,
%T A400146 42,40,56,30,72,32,63,48,54,48,70,38,60,56,90,42,96,44,84,60,72,48,
%U A400146 124,50,78,72,98,54,120,72,120,80,90,60,168,62,96,80,127,84,144,68,126
%N A400146 The sum of divisors d of n such that gcid(d, n/d) is a power of 2, where gcid is the greatest common infinitary divisor.
%C A400146 First differs from A399839 at n = 81.
%C A400146 First differs from A107749 at n = 27.
%C A400146 The number of these divisors is A400143(n).
%H A400146 Amiram Eldar, <a href="/A400146/b400146.txt">Table of n, a(n) for n = 1..10000</a>
%F A400146 Multiplicative with a(2^e) = 2^(e+1) - 1, and a(p^e) = Sum_{i=0..e} (binomial(e, i) mod 2) * p^i, for an odd prime p.
%F A400146 a(n) = A000203(n) * A049417(n) / A400145(n).
%F A400146 Sum_{k=1..n} a(k) ~ c * n^2, where c = (2/3) * Product_{p odd prime, k>=0} (1-1/p)*(1 + 1/p^(2^k) + 1/p^(2^(k+1))) = 0.79241420704311227942... .
%t A400146 f[2, e_] := 2^(e + 1) - 1; f[p_, e_] := Sum[Mod[Binomial[e, i], 2]*p^i, {i, 0, e}];
%t A400146 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A400146 (PARI) fun(p, e) = sum(i = 0, e, (binomial(e, i) % 2) * p^i);
%o A400146 a(n) = {my(f = factor(n)); prod(i = 1, #f~, if(f[i,1] == 2, 2^(f[i,2]+1) - 1 , fun(f[i, 1], f[i, 2])));}
%Y A400146 Cf. A000203, A107749 (analogous with gcd), A399839 (unitary analog), A400137, A400143.
%Y A400146 The sum of divisors d of n such that gcid(d, n/d) is: A049417 (1), A400144 (square), A400145 (odd), this sequence (power of 2).
%K A400146 nonn,mult,easy,new
%O A400146 1,2
%A A400146 _Amiram Eldar_, Sep 20 2026
