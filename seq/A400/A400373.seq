%U A400373 0,15,0,0,0,16,0,0,1,17,0,0,0,14,6,0,0,17,0,0,0,18,0,6,0,21,0,0,0,16
%N A400373 Number of numbers k < n not dividing n such that gcd(n,k) is divisible by a square > 1.
%H A400373 Michael De Vlieger, <a href="/A400373/b400373.txt">Table of n, a(n) for n = 1..10000</a>
%F A400373 a(n) = Sum_{d|n} (phi(d)-1) * (1-mu(n/d)^2).
%F A400373 a(n) = Sum_{k=1..n} (1 - mu(gcd(n,k))^2) * (ceiling(n/k) - floor(n/k)).
%F A400373 a(n) = A063658(n) - A048105(n).
%t A400373 Table[Sum[(EulerPhi[d] - 1)*(1 - MoebiusMu[n/d]^2), {d, Divisors[n]}], {n, 100}]
%o A400373 (PARI) a(n) = {my(f = factor(n)); n - prod(i = 1, #f~, if(f[i, 2] == 1, f[i, 1], f[i, 1]^(f[i, 2]-2) * (f[i, 1]^2 - 1))) - vecprod(apply(x -> x+1, f[, 2])) + 2^#f~;} \\ _Amiram Eldar_, Nov 27 2026
%Y A400373 Cf. A000010 (phi), A008683 (mu), A048105, A063658.
%K A400373 nonn,easy,new
%O A400373 1,20
%A A400373 _Wesley Ivan Hurt_, Nov 26 2026
