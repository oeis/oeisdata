%o A400047 (Python)
%o A400047 from sympy import nextprime
%o A400047 from itertools import count, islice
%o A400047 def row(n):
%o A400047     start = p = 2
%o A400047     size = 1
%o A400047     while True:
%o A400047         q = int(nextprime(p))
%o A400047         if q - p > 2*n:
%o A400047             yield size
%o A400047             start, size = q, 0
%o A400047         size += 1
%o A400047         p = q
%o A400047 def gen_A400047():
%o A400047     rows = []
%o A400047     for d in count(1):
%o A400047         rows.append(row(d))
%o A400047         for r in rows:
%o A400047             yield next(r)
%o A400047 print(list(islice(gen_A400047(), 78)))
