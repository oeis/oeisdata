%N A400249 Möbius transform of A085731, where A085731(n) = gcd(n,n'), and n' is the arithmetic derivative of n.
%H A400249 Antti Karttunen, <a href="/A400249/b400249.txt">Table of n, a(n) for n = 1..65537</a>
%F A400249 a(n) = Sum_{d|n} A008683(n/d)*A085731(d).
%F A400249 a(n) = Sum_{d|n} A000010(n/d)*A400248(d) = Sum{k=1..n} A400248(gcd(n,k)).
%F A400249 Multiplicative with a(p^e) = p^e - p^(e-2) if e is a multiple of p, 0 if e-1 is a multiple of p, and p^(e-1) - p^(e-2) otherwise. - _Amiram Eldar_, Sep 24 2026
%t A400249 f[p_, e_] := If[Divisible[e, p], p^e - p^(e-2), If[Divisible[e-1, p], 0, p^(e-1) - p^(e-2)]]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100] (* _Amiram Eldar_, Sep 24 2026 *)
%o A400249 (PARI)
%o A400249 A085731(n) = { my(f = factor(n)); for (i=1, #f~, if (f[i, 2] % f[i, 1], f[i, 2]--); ); factorback(f); };
%o A400249 A400249(n) = sumdiv(n,d,moebius(n/d)*A085731(d));
%Y A400249 Cf. A000010, A008683, A085731, A400248, A400251 (positions of terms > 0).
%Y A400249 Cf. also A369068.
%K A400249 nonn,mult,easy,new
%O A400249 1,4
%A A400249 _Antti Karttunen_, Sep 24 2026
