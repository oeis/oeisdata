%T A400578 259993,280771,473929,559549,569581,1012423,1026943,1361743,1468969,
%U A400578 1696693,1736419,1899343,2345479,2718889,6436009,6948079,7078303,8695201,9727141,12894841,13783069,15701551
%N A400578 Twin primes equal to the sum of the first k twin primes (represented as the list 3, 5, 5, 7, 11, 13, ...) for some k.
%H A400578 Robert Israel, <a href="/A400578/b400578.txt">Table of n, a(n) for n = 1..2500</a> (first 164 terms from Michael De Vlieger)
%H A400578 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/TwinPrimes.html">Twin Primes</a>.
%e A400578 First twin prime pairs: (3,5), (5,7), (11,13), ...
%e A400578 Flattened list: 3, 5, 5, 7, 11, 13, ...
%e A400578 31 is term because 31 = 3 + 5 + 5 + 7 + 11 and 31 is a twin prime.
%p A400578 LTP:= select(t -> isprime(t) and isprime(t+2), [3,seq(i,i=5 .. 10000,6)]):
%p A400578 TP:= [seq(op([t,t+2]), t = LTP)]:
%p A400578 PS:= ListTools:-PartialSums(TP):
%p A400578 select(t -> isprime(t) and (isprime(t+2) or isprime(t-2)), PS); # _Robert Israel_, Nov 03 2026
%t A400578 c[_] = False; s = 0; Reap[Do[If[#2 - #1 == 2, s += #1; c[s] = True; s += #2; c[s] = True; If[c[#1], Sow[#1] ]; If[c[#2], Sow[#2] ] ] & @@ Prime[{i, i + 1}], {i, 2^20}] ][[-1, 1]] (* _Michael De Vlieger_, Oct 04 2026 *)
