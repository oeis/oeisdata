%T A400751 1919749903,20803306999,237410023286,2844250550881,35671507157061,
%U A400751 467171918087161,6374757036542700,90449938197392525,1332045961344688962,20327144193468725431,320938488461856275384,5235425454317984954327
%N A400751 G.f. A(x) satisfies: A(x) = 1 + x * A(x/(1 - x)^2) / (1 - 2*x)^2.
%F A400751 a(0) = 1; a(n) = Sum_{k=1..n} Sum_{j=0..n-k} binomial(n-k+j-1,n-k-j) * k * 2^(k-1) * a(j) for n >= 1.
%t A400751 nmax = 23; A[_] = 0; Do[A[x_] = 1 + x A[x/(1 - x)^2]/(1 - 2 x)^2 + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A400751 (* Alternative: *)
%t A400751 a[0] = 1; a[n_] := a[n] = Sum[Sum[Binomial[n - k + j - 1, n - k - j] k 2^(k - 1) a[j], {j, 0, n - k}], {k, 1, n}]; Table[a[n], {n, 0, 23}]
%Y A400751 Cf. A005493, A040027, A125273, A125274.
%K A400751 nonn,new
%O A400751 0,3
