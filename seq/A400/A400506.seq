%S A400506 1,1,1,2,1,1,2,2,2,3,2,35,1,7,3,2,3,15,10,2,7,21,17,1,6,13,2,10,5,23,
%T A400506 21,146,22,11,17,7,46,13,2,86,13,43,19,21,11,19,3,3,15,22,33,167,42,
%U A400506 31,5,17,69,46,39,23,29,17,55,38,57,1,11,1,22,21,3,11,46
%N A400506 a(n) is the smallest divisor d of the n-th primorial such that prime(n)#/d - d is prime; a(1) = 1.
%C A400506 For n>1, a(n) = 1 iff n belongs to A057704.
%F A400506 Conjecture: Limit_{N->oo} (Sum_{n=1..N} a(n)) / (Sum_{n=1..N} prime(n)) = 0.
%e A400506 a(4) = 2 because prime(4)#/2 - 2 = 2*3*5*7/2 - 2 = 103 and 103 is a prime.
%o A400506 (PARI) a(n)=if(n==1, return(1)); my(P=vecprod(primes(n))); for(d=1, P, if(P%d==0 && ispseudoprime(P/d-d), return(d)))
%Y A400506 Cf. A002110, A057704, A295741.
%K A400506 nonn,new
%O A400506 1,4
%A A400506 _Alain Rocchelli_, Oct 29 2026
