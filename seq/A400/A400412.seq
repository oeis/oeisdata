%e A400412    ...
%t A400412 (* implementation using 2-dense sublists of divisors of v rather than SRS(v) *)
%t A400412 t400412[b_, r_] := Module[{list=Table[0, {i, 1, r}, {j, 1, i}], v, divL, n, k}, For[v=1, v<=b, v++, divL=Divisors[v]; n=Length[Select[divL, OddQ]]; k=Length[Split[divL, #2 - 2*#1 <=0&]]; If[n<=r&&list[[n, k]]==0, list[[n, k]]=v]]; list]
%t A400412 (* Any 0 value returned by t400412[b, r] needs to be verified according to the Comments section *)
%t A400412 a400412[b_, r_] := Apply[Join, t400412[b, r]]
%t A400412 a400412[3025, 9] (* includes the first complete 9 rows of triangle *)
%Y A400412 Cf. A003056, A174973, A237048, A237270, A237271, A237593, A239929, A320066.
