%N A400068 Number of compositions (ordered partitions) of n such that (greatest part) - (least part) <= 2.
%F A400068 G.f.: Sum_{j>=1} x^j / ( (1 - x^j - x^(j+1) - x^(j+2)) * (1 - x^(j+1) - x^(j+2)) ).
%e A400068 a(5) = 14 because we have [5], [3,2], [2,3], [3,1,1], [1,3,1], [1,1,3], [2,2,1], [2,1,2], [1,2,2], [2,1,1,1], [1,2,1,1], [1,1,2,1], [1,1,1,2] and [1,1,1,1,1].
%t A400068 nmax = 36; CoefficientList[Series[Sum[x^j/((1 - x^j - x^(j + 1) - x^(j + 2)) (1 - x^(j + 1) - x^(j + 2))), {j, 1, nmax}], {x, 0, nmax}], x] // Rest
