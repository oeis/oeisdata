%I A400833 #8 Oct 09 2026 12:23:49
%S A400833 1,2,2,12,2,24,2,180,36,72,2,2160,2,40,20,67500,2,5400,2,32400,60,360,
%T A400833 2,12150000,60,200,20250,90000,2,324000,2,59062500,100,1800,180,
%U A400833 157500,2,1000,300,17010000,2,2700000,2,45360,675000,9000,2,3986718750000,100,7560,500,126000,2,88593750,300,10631250000,1500,45000
%N A400833 a(n) = Product_{d|n, d squarefree} A276086(A400173(n/d)), where A400173 is Dirichlet convolution of arithmetic derivative with Liouville's lambda and A276086 is the primorial base exp-function.
%H A400833 Antti Karttunen, <a href="/A400833/b400833.txt">Table of n, a(n) for n = 1..10000</a>
%H A400833 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400833 a(n) = Product_{d|n} A276086(A400173(n/d))^A008966(d).
%F A400833 a(n) = Product_{d|A007947(n)} A276086(A400173(n/d)).
%F A400833 A276085(a(n)) = A003415(n), A392878(a(n)) = A327859(n).
%o A400833 (PARI)
%o A400833 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400833 A008836(n) = ((-1)^bigomega(n));
%o A400833 A400173(n) = sumdiv(n, d, A008836(n/d)*A003415(d));
%o A400833 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400833 A400833(n) = { my(m=1); fordiv(n, d, m *= A276086(A400173(n/d))^issquarefree(d)); (m); };
%Y A400833 Cf. A003415, A007947, A008836, A008966, A276085, A276086, A327859, A392878, A400173, A400834 (rgs-transform).
%Y A400833 Cf. also A380459, A400831.
%K A400833 nonn,easy,new
%O A400833 1,2
%A A400833 _Antti Karttunen_, Oct 09 2026
