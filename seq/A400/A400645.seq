%I A400645 #21 Oct 11 2026 22:07:30
%S A400645 0,0,0,1,1,1,2,2,3,4,5,7,9,12,16,21,28,37,48,63,83,109,143,188,247,
%T A400645 324,425,558,732,961,1261,1655,2172,2850,3740,4908,6441,8452,11092,
%U A400645 14556,19101,25066,32894,43166,56646,74336,97549,128012,167988,220447,289289
%N A400645 a(n+1) = round(sqrt(a(n)^2 + a(n-1)^2 + a(n-2)^2 - a(n-3)^2)).
%C A400645 Numerical evidence suggests that the ratio of consecutive terms (a(n+1)/a(n)) tends to 1.3122819079... (sqrt(A289917)) which is the largest real root of the asymptotic equation of this sequence: x^8-x^6-x^4-x^2+1. This is related to A116732 where the asymptotic equation is y^4-y^3-y^2-y+1 via y=x^2.
%t A400645 RecurrenceTable[{a[n+1] == Round[Sqrt[a[n]^2 + a[n-1]^2 + a[n-2]^2 - a[n-3]^2]], a[1] == a[2] == a[3] == 0, a[4] == 1}, a, {n, 1, 51}] (* _Amiram Eldar_, Oct 04 2026 *)
%o A400645 (Python)
%o A400645 from math import isqrt
%o A400645 def A400645_list(N):
%o A400645     a = [0, 0, 0, 1][:N]
%o A400645     while len(a) < N:
%o A400645         s = sum(x*x for x in a[-3:])-a[-4]*a[-4]
%o A400645         r = isqrt(s)
%o A400645         a.append(r + (s > r*r + r))
%o A400645     return a
%Y A400645 Cf. A063827 (two-term all-positive rounded square-root analog), A116732 (its characteristic polynomial y^4-y^3-y^2-y+1 is obtained from the conjectured asymptotic equation here by y = x^2), A289917 (decimal expansion of the larger root y, the square of the conjectured limiting ratio), A400644 (three-term positive-definite variant).
%K A400645 nonn,easy
%O A400645 1,7
%A A400645 _Bence Bernáth_, Oct 02 2026
