%S A400172 1,2,6,9,10,15,18,30,42,45,50,63,70,75,90,98,105,125,126,147,150,175,
%T A400172 198,210,225,245,250,294,315,330,343,350,375,441,450,462,490,495,525,
%U A400172 550,625,630,686,693,726,735,750,770,825,875,882,990,1029,1050,1078,1089,1125,1155,1210,1225,1250,1375,1386,1470,1575
%N A400172 Numbers k not divisible by any p^p and for which A003415(k) >= A276085(k), where A003415 is the arithmetic derivative and A276085 is the primorial base log-function.
%H A400172 Antti Karttunen, <a href="/A400172/b400172.txt">Table of n, a(n) for n = 1..28447</a>
%o A400172 (PARI)
%o A400172 A359550(n) = { my(pp); forprime(p=2, , pp = p^p; if(!(n%pp), return(0)); if(pp > n, return(1))); };
%o A400172 is_A392869(n) = { my(f = factor(n), ad=n*sum(i=1, #f~, f[i, 2]/f[i, 1]), pr=1, q=1, s=0); for(k=1, #f~, forprime(p = nextprime(1+q), f[k, 1]-1, pr *= p; if(pr > ad, return(0)); q = p); s += f[k, 2]*pr; if(s > ad, return(0))); (1); };
%o A400172 is_A400172(k) = (A359550(k) && is_A392869(k));
%Y A400172 Intersection of A048103 and A392869.
%Y A400172 Cf. A400171 (subsequence).
%K A400172 nonn,new
%O A400172 1,2
%A A400172 _Antti Karttunen_, Sep 23 2026
