%o A400046 (Python)
%o A400046 from sympy import nextprime
%o A400046 from itertools import count, islice
%o A400046 def row(n):
%o A400046     start = p = 2
%o A400046     size = 1
%o A400046     while True:
%o A400046         q = int(nextprime(p))
%o A400046         if q - p > 2*n:
%o A400046             yield p - start
%o A400046             start, size = q, 0
%o A400046         size += 1
%o A400046         p = q
%o A400046 def gen_A400046():
%o A400046     rows = []
%o A400046     for d in count(1):
%o A400046         rows.append(row(d))
%o A400046         for r in rows:
%o A400046             yield next(r)
%o A400046 print(list(islice(gen_A400046(), 66)))
