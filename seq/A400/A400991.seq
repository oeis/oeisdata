%U A400991 11825917084472115425596908020393,6284635285877404616456991538006569697,10019656881704764326793027611913426929424250
%N A400991 G.f. A(x) satisfies: A(x) = 1 + x * A(3*x/(1 + x)) / (1 + x).
%F A400991 a(0) = 1; a(n) = (-1)^(n-1) * Sum_{k=0..n-1} binomial(n-1,k) * (-3)^k * a(k).
%t A400991 nmax = 14; A[_] = 0; Do[A[x_] = 1 + x A[3 x/(1 + x)]/(1 + x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A400991 (* Alternative: *)
%t A400991 a[0] = 1; a[n_] := a[n] = (-1)^(n - 1) Sum[Binomial[n - 1, k] (-3)^k a[k], {k, 0, n - 1}]; Table[a[n], {n, 0, 14}]
%Y A400991 Cf. A000587, A317996, A355081, A400992.
