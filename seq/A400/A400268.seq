%S A400268 101,111,121,131,141,151,161,171,181,191,201,212,224,238,301,313,329,
%T A400268 401,414,501,515,601,616,701,717,801,818,901,919,1001,1101,1111,1121,
%U A400268 1131,1141,1151,1161,1171,1181,1191,1201,1211,1221,1231,1241,1251,1261,1271,1281,1291,1301,1311
%N A400268 Numbers that can be obtained by concatenating the decimal representations of x, y, and x^y for x >= 1 and y >= 0.
%C A400268 The exponentiation analog of A398649, which concatenates x, y, and x+y.
%C A400268 A term may arise from more than one pair (x, y); the smallest such is 1101, from x = 1, y = 10 (1^10 = 1) and x = 11, y = 0 (11^0 = 1). Such coincidences are very common here, because x^0 = 1 and 1^y = 1 both end in 1.
%C A400268 Some terms have three representations; the smallest is 110111101 = concat(1, 1011110, 1) = concat(1101, 1, 1101) = concat(1101111, 0, 1).
%F A400268 If y has q digits and x^y has r digits, then the term formed from (x, y) is x*10^(q + r) + y*10^r + x^y.
%e A400268 224 is a term because it is the concatenation of x = 2, y = 2 and x^y = 4.
%e A400268 329 is a term because it is the concatenation of x = 3, y = 2 and x^y = 9.
%e A400268 1101 is a term because it can be formed by x = 1, y = 10 or x = 11, y = 0.
%t A400268 f[x_, y_] := FromDigits[Join @@ IntegerDigits /@ {x, y, x^y}];
%t A400268 nn = 100000; Union@Reap[x = 1; While[FromDigits[Join @@ IntegerDigits /@ {x, 0, 1}] <= nn, y = 0; While[(v = f[x, y]) <= nn, Sow[v]; y++]; x++]][[2, 1]]
%o A400268 (Python)
%o A400268 def aupto(limit):
%o A400268     terms = set()
%o A400268     x = 1
%o A400268     while int(f"{x}01") <= limit:
%o A400268         y = 0
%o A400268         while True:
%o A400268             v = int(f"{x}{y}{x**y}")
%o A400268             if v > limit:
%o A400268                 break
%o A400268             terms.add(v)
%o A400268             y += 1
%o A400268         x += 1
%o A400268     return sorted(terms)
%o A400268 print(aupto(100000))
%Y A400268 Cf. A398566, A398647, A398649, A399016.
%K A400268 base,nonn,new
%O A400268 1,1
%A A400268 _Jakub Mráček_, Sep 22 2026
