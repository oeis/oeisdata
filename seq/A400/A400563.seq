%I A400563 #11 Sep 30 2026 21:31:35
%S A400563 3,5,7,7,15,9,15,25,31,15,31,47,63,17,31,49,63,81,95,113,127,31,63,95,
%T A400563 127,159,191,223,255,33,63,97,127,161,191,225,255,289,319,353,383,417,
%U A400563 447,481,511,63,127,191,255,319,383,447,511,575,639,703,767,831,895,959,1023
%N A400563 Irregular triangle read by rows: Row n >= 2 lists numbers 1 <= k <= 2^n such that chi_{2^n,k}(k) = -1, where chi_{N,k} is the Dirichlet character modulo N with label k in the Conrey labeling system.
%C A400563 Note that chi_{2^n,5^u*(-1)^v}(5^a*(-1)^b) = zeta^(u*a)*(-1)^(v*b) for n >= 2, where zeta = exp(2*Pi*I/2^(n-2)). In particular, chi_{2^n,k}(k) is of the form zeta^d, where
%C A400563   d == 1 (mod 8), 4 (mod 32), ..., 2^(n-7) (mod 2^(n-4)) or d == 0, 2^(n-5) (mod 2^(n-3)), n >= 5 odd;
%C A400563   d == 1 (mod 8), 4 (mod 32), ..., 2^(n-6) (mod 2^(n-3)) or d == 0 (mod 2^(n-4)), n >= 4 even.
%C A400563 Let r = floor(n/2) + 1, then row n has length 2^(n-r).
%H A400563 Jianing Song, <a href="/A400563/b400563.txt">Table of n, a(n) for n = 2..16382</a> (rows n = 2..26)
%H A400563 LMFDB, <a href="https://www.lmfdb.org/Character/Dirichlet/Labels">Dirichlet character labels</a>.
%H A400563 Jianing Song, <a href="/A400562/a400562.txt">Table of characters modulo 4, 8, 16, 32, 64</a>.
%F A400563 T(n,k) = 2^r*k - (-1)^(n*k) for n >= 2, 1 <= k <= 2^(n-r). In other words, row n consists of numbers congruent to -1 modulo 2^r for even n and numbers congruent to 2^r+1 or -1 modulo 2^(r+1) for odd n.
%e A400563 Table begins
%e A400563   3
%e A400563   5, 7
%e A400563   7, 15
%e A400563   9, 15, 25, 31
%e A400563   15, 31, 47, 63
%e A400563   17, 31, 49, 63, 81, 95, 113, 127
%e A400563   31, 63, 95, 127, 159, 191, 223, 255
%e A400563   33, 63, 97, 127, 161, 191, 225, 255, 289, 319, 353, 383, 417, 447, 481, 511
%e A400563   63, 127, 191, 255, 319, 383, 447, 511, 575, 639, 703, 767, 831, 895, 959, 1023
%e A400563 9 is an element in row 5: Since 9 == 5^6 (mod 32), we have chi_{32,9}(9) = zeta^(6^2) = -1.
%o A400563 (PARI) row(n) = my(G=znstar(2^n, 1)); select(m->chareval(G, m, m)==1/2, vector(2^(n-1), i, 2*i-1)) \\ the naive method
%o A400563 (PARI) row(n) = my(r=n\2+1); apply(x->2^r*x-(-1)^(n*x), vector(2^(n-r),i,i))
%Y A400563 Cf. A400562. First column is A086341.
