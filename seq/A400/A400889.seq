%I A400889 #12 Oct 15 2026 16:37:53
%S A400889 0,0,10,22,28,10,40,42,250,28,30,208,198,40,37,918,1062,388,85,28,
%T A400889 1132,208,757,388,1272,369,1785,742,610,1053,36,2998,208,1258,958,388,
%U A400889 322,85,6544,1321,2181,3046,9874,208,2014,1353,5677,918,2497,4593,20157,5161
%N A400889 Least k such that n divides A400888(k).
%C A400889 a(n) is the rank of apparition of n in A400888. It is well-defined since A400888(3*2^(n-1) - 2) = n*gcd(n-1,2) is divisible by n for n >= 1.
%C A400889 Every apparition recurs infinitely often since n divides A400888(4^j*(a(n)+1) - 1) for j >= 0.
%F A400889 a(n) <= 3*2^(n-1) - 2, for n >= 1.
%F A400889 a(4*n + 2) <= 3*2^(2*n) - 2, for n >= 0.
%F A400889 a(n) is not congruent to 3 modulo 4.
%e A400889 a(3)=10 because A400888(10)=6 is divisible by 3, whereas none of A400888(0)..A400888(9) is divisible by 3.
%e A400889 The general bound gives a(5) <= 46. In fact, a(5)=28 because A400888(28)=20 is divisible by 5, whereas no previous term of A400888 is divisible by 5.
%o A400889 (PARI)
%o A400889 f(v, c, h=0) = [2*(x + h) + c - (2*c + 1)*(x%2) | x <- v];
%o A400889 w(n) = {my(m = n\2); if(n < 1, if(n, [], [1]), if(n%2, f(w(m), m%3 != 2, 1), concat(f(w(m), m%3 != 0), f(w(m - 1), m%3 != 2))))};
%o A400889 d(n) = {my(v = vecsort(w(n), , 4), p = 1, q = 1, ones, zeros); ones = sum(i = 1, #v, v[i]%2); zeros = #v - ones; for(i = 1, #v, if(v[i]%2, p += q, q += p)); gcd(p - zeros, q + ones)};
%o A400889 a(n) = {my(k=0); while(d(k)%n, k++); k};
%o A400889 vector(50, n, a(n))
%Y A400889 Cf. A400888.
%K A400889 nonn,new
%O A400889 1,3
%A A400889 _M. Jeremie Lafitte (Levitas)_, Oct 08 2026
