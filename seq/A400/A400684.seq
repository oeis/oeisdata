%N A400684 Primes p such that p+2 and (p-1)^2+1 are also prime.
%e A400684 For p = 41, p+2 = 43 and (p-1)^2+1 = 1601 are prime, so 41 is a term.
%p A400684 q:= p-> andmap(isprime, [p, p+2, (p-1)^2+1]):
%p A400684 select(q, [$2..12000])[];  # _Alois P. Heinz_, Oct 03 2026
%t A400684 Select[Prime[Range[1350]], And @@ PrimeQ[{# + 2, (# - 1)^2 + 1}] &] (* _Amiram Eldar_, Oct 03 2026 *)
%o A400684 (Python)
%o A400684 from sympy import isprime
%o A400684 def ok(p):
%o A400684     return isprime(p) and isprime(p + 2) and isprime((p - 1)**2 + 1)
%Y A400684 Intersection of A001359 and A127435.
