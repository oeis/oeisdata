%U A400253 0,8,3,5,0,7,0,1,6,3,2,2,0,30,13,3,0,4,4,1,3,14,0,7,0,8,1,3,2,17,0,8,8,12
%N A400253 The exponent of the highest power of 3 dividing A380459(n).
%H A400253 Antti Karttunen, <a href="/A400253/b400253.txt">Table of n, a(n) for n = 1..10000</a>
%H A400253 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400253 a(n) = A007949(A380459(n)).
%o A400253 (PARI)
%o A400253 A007949(n) = valuation(n, 3);
%o A400253 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400253 A349394(n) = { my(p=0, e); if((e=isprimepower(n, &p)), p^(e-1), 0); };
%o A400253 A380459(n) = { my(m=1); fordiv(n, d, m *= A276086(d)^A349394(n/d)); (m); };
%o A400253 A400253(n) = A007949(A380459(n));
%Y A400253 Cf. A007949, A380459.
%Y A400253 Cf. also A400252, A400263.
%K A400253 nonn,new
%O A400253 1,6
%A A400253 _Antti Karttunen_, Sep 22 2026
