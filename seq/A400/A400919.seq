%S A400919 0,0,0,1,2,1,3,5,6,4,7,10,14,11,11,16,21,19,25,26,28,24,31,42,45,40,
%T A400919 44,46,55,50,60,70,76,70,69,79,91,84,92,100,113,108,122,125,121,113,
%U A400919 128,155,164,150,162,166,183,178,180,191,205,195,214,229,249,238
%N A400919 Sum of the remainders of n modulo the odd numbers 3, 5, ..., 2*floor(n/3)+1.
%C A400919 Writing n = (2k+1)*q_k + r_k with 0 <= r_k < 2k+1 for k = 1..floor(n/3) and summing gives n*floor(n/3) = Sum_{k} (2k+1)*q_k + a(n).
%C A400919 Subtracting successively the sums of the odd numbers d in [3, 2*floor(n/3)+1] with floor(n/d) >= j, for j = 1, 2, ..., each odd d is removed exactly floor(n/d) times, which leads to the third formula below. Since floor(n/j) takes only O(sqrt(n)) distinct values, a(n) can be computed with O(sqrt(n)) operations by grouping the j with equal floor(n/j).
%C A400919 For odd m >= 5, m is prime if and only if a(m) - a(m-1) = floor((m-1)/3). Indeed, by the formula for the first differences, a(m) - a(m-1) = floor((m-1)/3) - (A000593(m) - 1 - m) for odd m not divisible by 3, and A000593(m) = m + 1 exactly when m is prime. If 3 divides m (m >= 9), then a(m) - a(m-1) = 2*floor((m-1)/3) - (A000593(m) - 1 - m) < floor((m-1)/3), since A000593(m) - m - 1 > m/3 - 1.
%C A400919 Numerically, a(n)/n^2 agrees with 17/36 - Pi^2/24 to about 14 digits at n = 10^14.
%F A400919 a(n) = Sum_{k=1..floor(n/3)} (n mod (2k+1)).
%F A400919 a(n) = n*floor(n/3) - Sum_{k=1..floor(n/3)} (2k+1)*floor(n/(2k+1)).
%F A400919 a(n) = n*x - x*(x+2) - Sum_{j=2..x} (m_j^2 - 1), where x = floor(n/3) and m_j = floor((floor(n/j)+1)/2).
%F A400919 a(n) = (17/36 - Pi^2/24)*n^2 + O(n*log(n)), where 17/36 - Pi^2/24 = 0.06098870551016...
%F A400919 a(n+1) - a(n) = floor(n/3)*(1 + [3 | n+1]) - (A000593(n+1) - 1 - [n+1 odd]*(n+1)), where [ ] is the Iverson bracket.
%F A400919 a(n) ~ (17/36 - Pi^2/24)*n^2, where 17/36 - Pi^2/24 = 0.06098870551016...
%e A400919 a(15) = (15 mod 3) + (15 mod 5) + (15 mod 7) + (15 mod 9) + (15 mod 11) = 0 + 0 + 1 + 6 + 4 = 11.
%o A400919 (Python)
%o A400919 def a(n):
%o A400919     x = n // 3
%o A400919     tot = x*(x + 2)
%o A400919     j = 2
%o A400919     while j <= x:
%o A400919         q = n // j
%o A400919         j2 = min(n // q, x)
%o A400919         m = (q + 1) // 2
%o A400919         tot += (j2 - j + 1)*(m*m - 1)
%o A400919         j = j2 + 1
%o A400919     return n*x - tot
%o A400919 (PARI) a(n) = sum(k=1, n\3, n % (2*k+1)); \\ _Michel Marcus_, Oct 16 2026
%Y A400919 Cf. A000593, A004125, A346879, A346869, A130823.
