%I A400160 #9 Sep 21 2026 17:22:35
%S A400160 1,2,3,4,5,6,7,8,11,12,13,14,16,17,18,19,20,23,24,26,28,29,31,32,36,
%T A400160 37,38,40,41,43,44,47,48,52,53,54,56,59,60,61,62,64,67,68,71,72,73,74,
%U A400160 76,79,80,83,84,86,88,89,90,92,96,97,100,101,103,104,107,108,109,112,113,116,120,122,124,126,127,128,131
%N A400160 Numbers k such that either the smallest prime q for which valuation(A380459(k),q) >= q is their smallest nonunitary prime factor, or such prime q does not exist (in which case k is by necessity squarefree).
%C A400160 Lemma given in A380468 guarantees that such prime q exists for all nonsquarefree numbers.
%H A400160 Antti Karttunen, <a href="/A400160/b400160.txt">Table of n, a(n) for n = 1..10000</a>
%F A400160 {k such that A380528(k) = A249739(k)}.
%o A400160 (PARI)
%o A400160 A249739(n) = {f = factor(n/core(n)); vsq = select(x->((x%2) == 0), f[, 2], 1); if (#vsq, f[vsq[1], 1], 1); };
%o A400160 A129252(n) = { my(pp); forprime(p=2, , pp = p^p; if(!(n%pp), return(p)); if(pp > n, return(1))); };
%o A400160 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400160 A349394(n) = { my(p=0, e); if((e=isprimepower(n, &p)), p^(e-1), 0); };
%o A400160 A380459(n) = { my(m=1); fordiv(n, d, m *= A276086(d)^A349394(n/d)); (m); };
%o A400160 is_A400160(n) = (A249739(n)==A129252(A380459(n)));
%Y A400160 Cf. A129252, A249739, A380459, A380468, A380528.
%Y A400160 Positions of 0's in A400159.
%Y A400160 Disjoint union of A380468 (squarefree terms) and A400162 (nonsquarefree terms).
%K A400160 nonn,new
%O A400160 1,2
%A A400160 _Antti Karttunen_, Sep 21 2026
