%I A400687 #13 Oct 14 2026 00:03:16
%S A400687 1,2,38,42,267,276,1060,2356,4381,4406,8762,8798,17079,28104,42504,
%T A400687 42568,65977,66058,102158,146258,199619,199740,275916,365916,471541,
%U A400687 594742,737626,737822,927047,927272,1173288,1452072,1766793,2120818,2517718,2518042,3012251,3561332,4169732,4170132
%N A400687 a(n) = Sum_{k=1..n} gcd(k!, k*(k+1)/2)^2.
%C A400687 gcd(k!, T_k) = T_k = k*(k+1)/2 except when k+1 = p is an odd prime, where it equals (p-1)/2. So the squared deficit at k = p-1 is ((p-1)/2)^2*(p^2-1).
%F A400687 a(n) = Sum_{k=1..n} (k*(k+1)/2)^2 - Sum_{odd primes p <= n+1} ((p-1)/2)^2*(p^2-1).
%F A400687 a(n) = a(n-1) + A069268(n)^2 for n >= 2.
%F A400687 Sum_{k=1..n} (k*(k+1)/2)^2 = A024166(n).
%e A400687 a(4) = 1^2 + 1^2 + 6^2 + 2^2 = 42.
%t A400687 Accumulate[Table[GCD[k!, k*(k+1)/2]^2, {k, 40}]]
%o A400687 (Python)
%o A400687 from math import gcd, factorial
%o A400687 def a(n): return sum(gcd(factorial(k), k*(k+1)//2)**2 for k in range(1, n+1))
%o A400687 (Python)
%o A400687 from sympy import primerange
%o A400687 def A400687(n): return n*(n*(n*(n*(3*(n+5))+25)+15)+2)//15-sum(p*(p**2*(p-2)+2)-1 for p in primerange(3,n+2))>>2 # _Chai Wah Wu_, Oct 11 2026
%o A400687 (PARI) a(n) = sum(k=1, n, gcd(k!, k*(k+1)/2)^2); \\ _Michel Marcus_, Oct 04 2026
