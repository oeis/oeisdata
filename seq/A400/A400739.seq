%I A400739 #4 Oct 06 2026 00:05:35
%S A400739 3,5,31,1913,9011
%N A400739 Numbers k such that (49^k + 4^k)/53 is prime.
%C A400739 The definition implies that k must be a prime.
%C A400739 a(6) > 10^5.
%H A400739 P. Bourdelais, <a href="https://listserv.nodak.edu/cgi-bin/wa.exe?A2=NMBRTHRY;417ab0d6.0906">A Generalized Repunit Conjecture</a>.
%H A400739 J. Brillhart et al., <a href="https://doi.org/10.1090/conm/022">Factorizations of b^n +- 1</a>, Contemporary Mathematics, Vol. 22, Amer. Math. Soc., Providence, RI, 3rd edition, 2002.
%H A400739 H. Dubner and T. Granlund, <a href="http://www.cs.uwaterloo.ca/journals/JIS/VOL3/DUBNER/dubner.html">Primes of the Form (b^n+1)/(b+1)</a>, J. Integer Sequences, 3 (2000), #P00.2.7.
%H A400739 H. Lifchitz, <a href="http://www.primenumbers.net/Henri/us/MersFermus.htm">Mersenne and Fermat primes field</a>
%H A400739 OEIS Wiki, <a href="https://oeis.org/wiki/Primes_of_the_form_(a%5En%2Bb%5En)/(a%2Bb)_and_(a%5En-b%5En)/(a-b)">Primes of the form (a^n+b^n)/(a+b) and (a^n-b^n)/(a-b)</a>
%H A400739 Eric Weisstein's World of Mathematics, <a href="http://mathworld.wolfram.com/Repunit.html">Repunit</a>.
%t A400739 Select[Prime[Range[10000]], PrimeQ[(49^# + 4^#)/53] &]
%Y A400739 Cf. A057187, A057188, A062587, A062589, A127996, A127997, A128344, A204940, A217320, A225807, A228922, A229542, A375161, A375236, A377031, A377856.
