%S A400155 0,1,2,4,6,7,8,12,16,18,24,30,34,36,60,72,90,91,108,120,144,150,180,
%T A400155 210,228,420,450,630,840,900,1050,1260,1333,1350,1356,1470,1472,1482,
%U A400155 1500,1680,1800,1890,1968,2100,2250,2310,2340,2520,2556,3150,4620,4680,4830,5040,5112,6300,6930,7020,7560,7668,9240,9360
%N A400155 Numbers k that are multiples of A342002(k), where A342002(k) = A342001(A276086(k)).
%H A400155 Antti Karttunen, <a href="/A400155/b400155.txt">Table of n, a(n) for n = 1..1025</a>
%H A400155 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400155 {0} U {k such that k == 0 mod A342002(k)}.
%o A400155 (PARI)
%o A400155 A342002(n) = { my(s=0, m=1, p=2, e); while(n, e = (n%p); m *= p^(e>0); s += (e/p); n = n\p; p = nextprime(1+p)); (s*m); };
%o A400155 is_A400155(k) = (!k || !(k%A342002(k)));
%Y A400155 Cf. A083345, A276086, A342001, A342002.
%Y A400155 Subsequences: A380527.
%Y A400155 Cf. also A399379, A399380.
%K A400155 nonn,new
%O A400155 1,3
%A A400155 _Antti Karttunen_, Sep 20 2026
