%I A400145 #7 Sep 21 2026 15:38:00
%S A400145 1,3,4,5,6,12,8,15,13,18,12,20,14,24,24,17,18,39,20,30,32,36,24,60,31,
%T A400145 42,40,40,30,72,32,51,48,54,48,65,38,60,56,90,42,96,44,60,78,72,48,68,
%U A400145 57,93,72,70,54,120,72,120,80,90,60,120,62,96,104,85,84,144,68,90,96
%N A400145 The sum of divisors d of n such that gcid(d, n/d) is odd, where gcid is the greatest common infinitary divisor.
%C A400145 Differs from A399838 at n = 16, 32, 48, 64, ... .
%C A400145 The number of these divisors is A400142(n).
%H A400145 Amiram Eldar, <a href="/A400145/b400145.txt">Table of n, a(n) for n = 1..10000</a>
%F A400145 Multiplicative with a(2^e) = A001317(e), and a(p^e) = p^(e+1)-1)/(p-1) for an odd prime p.
%F A400145 a(n) = A000203(n) * A049417(n) / A400146(n).
%F A400145 Sum_{k=1..n} a(k) ~ c * n^2, where c = (Pi^2/32) * Product_{k>=0} (1 + 1/2^(2^k) + 1/2^(2^(k+1))) = 0.75843120874118159188... .
%t A400145 f[p_, e_] := (p^(e+1)-1)/(p-1); f[2, e_] := Sum[Mod[Binomial[e, i], 2]*2^i, {i, 0, e}];
%t A400145 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A400145 (PARI) a(n) = {my(e = valuation(n, 2)); sum(i = 0, e, (binomial(e, i) % 2) * 2^i) * sigma(n >> e);}
%Y A400145 Cf. A000203, A001317, A069184 (analogous with gcd), A399838 (unitary analog), A400137, A400142.
%Y A400145 The sum of divisors d of n such that gcid(d, n/d) is: A049417 (1), A400144 (square), this sequence (odd), A400146 (power of 2).
%K A400145 nonn,mult,easy,new
%O A400145 1,2
%A A400145 _Amiram Eldar_, Sep 20 2026
