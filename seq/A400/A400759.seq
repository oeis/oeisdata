%T A400759 3,11,8,9,2,5,13,8,3,4,12,12,5,3,13,10,4,7,9,8,12,7,2,0,10,6,4,8,6,14,
%U A400759 4,5,10,6,14,2,4,9,0,11,12,15,13,9,5,14,15,1
%N A400759 Hexadecimal expansion of the square root of 3.
%H A400759 Adam Reichert, <a href="/A400759/b400759.txt">Table of n, a(n) for n = 1..10000</a>
%H A400759 Adam Reichert, <a href="/A400759/a400759.py.txt">Python program</a>
%H A400759 Eric W. Weisstein, <a href="https://mathworld.wolfram.com/Hexadecimal.html">Hexadecimal</a>, MathWorld.
%H A400759 Eric W. Weisstein, <a href="https://mathworld.wolfram.com/TheodorussConstant.html">Theodorus's Constant</a>, MathWorld.
%F A400759 a(1) = 1; for n >= 2, a(n) = 8*A004547(4*n-6) + 4*A004547(4*n-5) + 2*A004547(4*n-4) + A004547(4*n-3).
%e A400759 sqrt(3) = (1.BB67AE8584CAA73B25742D7078B83B8925D834CC53DA4798C720...)_16.
%e A400759 a(7) = 14 because A004547(22), ..., A004547(25) are 1, 1, 1, 0, giving 8*1 + 4*1 + 2*1 + 0 = 14.
%t A400759 First[RealDigits[Sqrt[3], 16, 100]] (* _Paolo Xausa_, Oct 06 2026 *)
%o A400759 (Python) # See Reichert link.
%o A400759 (Python)
%o A400759 from math import isqrt
%o A400759 def A400759(n): return isqrt(3*(1<<(n-1<<3)))&15 # _Chai Wah Wu_, Oct 06 2026
