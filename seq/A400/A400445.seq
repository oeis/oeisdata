%I A400445 #11 Oct 02 2026 22:19:41
%S A400445 1,0,5,5,51,118,715,2400,12075,48120,226935,979725,4538325,20376450,
%T A400445 94317405,432496365,2011547475,9342702600,43715604975,204814574055,
%U A400445 963900058665,4545471571050,21501666281025,101919955617150,484255713013701,2305209932570448
%N A400445 a(n) = (n-1)*(2*a(n-1) + 15*a(n-2))/(n+1) with a(0)=1, a(1)=0.
%C A400445 This sequence is a special case for m = 2 (with p = 2, q = 15) of a family of integer sequences defined by the holonomic recurrence relation a(n) = ((n - 1)/(n + 1)) * (2*a(n-1) + (4^m - 1)*a(n-2)) with a(0) = 1, a(1) = 0.
%C A400445 For any m >= 1, the generating function has the form G(x) = (1 - ((1 - (2^m + 1)*x) / (1 + (2^m - 1)*x))^(1/(2*m))) / (2*x).
%C A400445 For any m >= 1, the explicit formula is a(n) = - (1/2) * Sum_{k=0..n+1} (binomial(1/(2^m), k) * binomial(-1/(2^m), n+1-k) * (-(2^m + 1))^k * (2^m - 1)^(n + 1 - k)) for n >= 1.
%H A400445 Dmytro Dmytryshyn, <a href="https://doi.org/10.13140/RG.2.2.14652.60804">On a Generalization of the Riordan Numbers</a>, Preprint ResearchGate, 2026.
%F A400445 G.f.: (1 - ((1 - 5*x) / (1 + 3*x))^(1/4)) / (2*x).
%F A400445 a(n) = -(1/2) * Sum_{k=0..n+1} (binomial(1/4, k) * binomial(-1/4, n + 1 - k) * (-5)^k * 3^(n + 1 - k)) for n >= 1.
%F A400445 a(n) ~ Gamma(1/4) * 5^(n + 5/4) / (Pi * 2^(17/4) * n^(5/4)). - _Vaclav Kotesovec_, Sep 26 2026
%F A400445 a(n) = -3^(n+1)*binomial(-1/4, n+1)*hypergeom([-1/4, -n-1], [-n-1/4], -5/3)/2 for n > 0. - _Stefano Spezia_, Sep 27 2026
%p A400445 a := proc(n) option remember: if n = 0 then 1 elif n = 1 then 0 else ((n - 1)/(n + 1)) * (2 * a(n-1) + 15 * a(n-2)) end if: end proc: seq(a(n), n = 0..25);
%t A400445 a[0]=1; a[n_]:=-3^(n+1)*Binomial[-1/4,n+1]*Hypergeometric2F1[-1/4,-n-1,-n-1/4,-5/3]/2; Array[a,26,0] (* _Stefano Spezia_, Sep 27 2026 *)
%Y A400445 Cf. A005043.
%K A400445 nonn,easy,new
%O A400445 0,3
%A A400445 _Dmytro Dmytryshyn_, Sep 26 2026
