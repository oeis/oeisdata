%I A400418 #19 Oct 02 2026 00:26:49
%S A400418 1,3,5,6,10,14,16,12,15,27,29,27,35,39,45,28,44,38,52,54,68,72,74,50,
%T A400418 53,83,63,77,93,109,111,65,99,117,123,82,114,130,140,108,140,158,160,
%U A400418 142,142,176,178,100,103,117,175,179,207,131,185,153,211,229,231
%N A400418 a(n) = Sum_{k=1..n} A007947(floor(n/k)).
%C A400418 Asymptotic growth: a(n) ~ C*n*log n where C is approx. 0.7044...
%C A400418 From _Natalia L. Skirrow_, Sep 26 2026: (Start)
%C A400418 C = A065463 = 0.7044422009991655... = lim_{n->oo} (2/n^2)*Sum_{k=1..n} A007947(k); by differentiating the asymptotic, this can be restated as "the expected value of A007947(n) is ~ A065463*n."
%C A400418 By removing the floors in the second formula, n/k - n/(k+1) = n/(k*(k+1)), so a(n) is approximately n*Sum_{k=1..n} A007947(k)/(k*(k+1)) ~ n*Sum_{k=1..n} A065463/(k+1) = A065463*n*(Harmonic(n+1)-1) ~ A065463*n*log n.
%C A400418 (End)
%F A400418 a(n) = Sum_{k=1..n} A007947(floor(n/k)).
%F A400418 a(n) = Sum_{k=1..n} A007947(k)*(floor(n/k) - floor(n/(k+1))).
%F A400418 a(n) = Sum_{k=1..n} floor(n/k)*(A007947(k) - A007947(k-1)).
%F A400418 a(n) = a(n-1) + Sum_{d|n} A007947(d) - A007947(d-1).
%F A400418 From _Natalia L. Skirrow_, Sep 26 2026: (Start)
%F A400418 O.g.f.: Sum_{k>=1} f(x^k)*(1-x^k)/(1-x), where f is A007947's o.g.f.
%F A400418 a(n) = Sum_{k=1..n, k squarefree} phi(k)*Sum_{j=1..floor(n/k)} floor(n/(k*j)) - floor(n/(k*j+1)), where phi(n)=A000010(n). When iterating over non-squarefree k too, this produces A006218.
%F A400418 (End)
%e A400418 For n = 4: a(4) = A007947(floor(4/1)) + A007947(floor(4/2)) + A007947(floor(4/3)) + A007947(floor(4/4)) = 2 + 2 + 1 + 1 = 6.
%t A400418 f[n_] := f[n] = Times @@ FactorInteger[n][[;; , 1]]; a[n_] := Sum[f[Floor[n/k]], {k, 1, n}]; Array[a, 100] (* _Amiram Eldar_, Sep 26 2026 *)
%o A400418 (Python)
%o A400418 from sympy import factorint
%o A400418 A007947=lambda n: prod(factorint(n))
%o A400418 A400418=lambda n: sum(A007947(n//k) for k in range(1,n+1)) # _Natalia L. Skirrow_, Sep 26 2026
%o A400418 print([A400418(n) for n in range(1,101)])
%o A400418 (Python)
%o A400418 from sympy import totient,mobius
%o A400418 A400418=lambda n: sum(totient(k)*sum(n//(k*j)-n//(k*j+1) for j in range(1,n//k+1)) for k in range(1,n+1) if mobius(k)) # _Natalia L. Skirrow_, Sep 26 2026
%o A400418 (PARI) a(n) = sum(k=1, n, factorback(factorint(n\k)[, 1]);); \\ _Michel Marcus_, Sep 26 2026
%Y A400418 Cf. A000010, A006218, A007947, A065463.
%K A400418 nonn,new
%O A400418 1,2
