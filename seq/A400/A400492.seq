%S A400492 4260,431155,9971573,101043428
%N A400492 Consider the finite sequence S(n) consisting of those primes in which every suffix is prime and there is no run of more than n consecutive zeros; a(n) is the number of terms in S(n).
%e A400492 S(0) is A024785, and contains a(0) = 4260 terms.
%e A400492 S(1) is A400420, and contains a(1) = 431155 terms.
%o A400492 (Python)
%o A400492 from gmpy2 import is_prime
%o A400492 from itertools import islice
%o A400492 def a(n):
%o A400492     primestrs, c, d = ["2", "3", "5", "7"], 4, 1
%o A400492     while len(primestrs) > 0:
%o A400492         print("...", n, d, len(primestrs), time()-time0, alst, flush=True)
%o A400492         cands = set(d+p for p in primestrs for d in "0123456789" if d!="0" or p[0:n]!="0"*n)
%o A400492         primestrs = [c for c in cands if c[0] == "0" or is_prime(int(c))]
%o A400492         c += sum(1 for p in primestrs if p[0]!="0")
%o A400492         d += 1
%o A400492     return c
%Y A400492 Cf. A024785, A033664, A308711, A400420.
%K A400492 nonn,base,hard,more,new
