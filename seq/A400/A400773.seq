%I A400773 #11 Oct 06 2026 16:27:35
%S A400773 150,294,300,450,490,588,600,726,735,750,882,900,980,1014,1050,1176,
%T A400773 1200,1210,1350,1452,1500,1650,1690,1694,1734,1764,1800,1815,1950,
%U A400773 1960,2028,2058,2100,2166,2178,2205,2250,2352,2366,2400,2420,2450,2535,2541,2550,2646,2700,2850,2890,2904,3000
%N A400773 Numbers divisible by the square of their third smallest distinct prime factor.
%H A400773 Peter Munn, <a href="/A400773/b400773.txt">Table of n, a(n) for n = 1..10000</a>
%F A400773 {j = A000977(k), k >= 1 : A400427(k)^2 | j} = {k in A000977 : A124010(k,3) >= 2}.
%e A400773 1500 = 2^2 * 3 * 5^3 has {2,3,5} as its distinct prime factors, of which 5 is the 3rd smallest, and 5^2 = 25 divides 1500 so 1500 is in the sequence.
%e A400773 72 = 2^3 * 3^2 has only 2 distinct prime factors, 2 and 3, so 72 is not in the sequence.
%t A400773 A400773Q[k_] := Length[#] >= 3 && Divisible[k, #[[3, 1]]^2] & [FactorInteger[k]];
%t A400773 Select[Range[3000], A400773Q] (* _Paolo Xausa_, Oct 06 2026 *)
%o A400773 (PARI)
%o A400773 k=1;for(n=1,10000,while(omega(k)<3||factor(k)[3,2]<2,k=k+1);print(n," ",k);k=k+1)
%Y A400773 Cf. A124010, A283050, A398375, A400427.
%Y A400773 Subsequence of A000977, A375397.
%K A400773 nonn,easy,new
%O A400773 1,1
%A A400773 _Peter Munn_, Oct 06 2026
