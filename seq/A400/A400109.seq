%S A400109 5,7,11,23,29,23,41,47,53,59,109,47,181,139,59,127,101,107,113,199,83,
%T A400109 131,229,191,199,467,107,223,463,179,433,191,197,271,349,359,443,227,
%U A400109 311,239,409,167,601,439,179,643,751,479,293,499,509,311,317,431,439,1231,227,463,1297,359,853,743
%N A400109 a(n) is the least prime p such that there is a prime q < p with gcd(q+1, p+1) = 2*n.
%C A400109 Such primes p and q always exist.  Thus for any n, by Dirichlet's theorem on primes in arithmetic progressions we can take q to be a prime == -1 (mod 2*n), and p a prime == 2*n-1 (mod q+1) and > q.
%H A400109 Robert Israel, <a href="/A400109/b400109.txt">Table of n, a(n) for n = 1..10000</a>
%e A400109 a(5) = 29 because with p = 29 and q = 19 we have gcd(q+1, p+1) = gcd(20, 30) = 10 = 2*5, and no smaller p works.
%p A400109 P:= select(isprime,[seq(i,i=3..1000,2)]): nP:= nops(P):
%p A400109 V:= Vector(100): count:= 0:
%p A400109 for n from 1 to nP while count < 100 do
%p A400109   for k from 1 to n-1 while count < 10000 do
%p A400109     v:= igcd(P[k]+1,P[n]+1)/2;
%p A400109     if v <= 100 and V[v] = 0 then V[v]:= P[n]; count:= count+1; fi;
%p A400109   od
%p A400109 od:
%p A400109 convert(V,list);
%Y A400109 Cf. A038700, A358127, A397895.
%K A400109 nonn,new
%O A400109 1,1
%A A400109 _Robert Israel_, Sep 18 2026
