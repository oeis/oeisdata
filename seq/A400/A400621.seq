%I A400621 #33 Nov 12 2026 21:46:25
%S A400621 1,5,9,18,30,39,56,68,90,115,132,162,195,217,255,280,323,369,399,450,
%T A400621 483,539,598,636,700,767,810,882,928,1005,1085,1136,1221,1309,1365,
%U A400621 1458,1517,1615,1716,1780,1886,1953,2064,2178,2250,2369,2491,2568,2695,2775
%N A400621 Row sums of a triangle where row n consists of the smallest n available positive integers, and each integer k is removed from the pool of available integers after appearing in k rows.
%C A400621 Because the right endpoint of row n advances by at least 1 at each step while the left endpoint advances by at most 1, each integer k >= 1 first appears in row F(k) = ceiling(k/phi), appears in k consecutive rows, and is retired immediately after row R(k) = floor(k*phi) = A000201(k), where phi = (1+sqrt(5))/2 is the golden ratio.
%C A400621 Consequently, row n always consists of n consecutive integers starting at s(n) = ceiling(n/phi) = A019446(n).
%C A400621 This sequence originally inspired the prime grouping structure in A320228.
%F A400621 a(n) = n * ceiling(n/phi) + n*(n-1)/2, where phi = (1+sqrt(5))/2 = A001622.
%F A400621 a(n) = n * A019446(n) + A000217(n-1).
%F A400621 a(n) = (1/(2*phi) + 1/2)*n^2 + O(n) = ((sqrt(5)+1)/4)*n^2 + O(n) as n -> infinity.
%e A400621 The rows of the triangle and the retirement of integers (when k has been used k times) are:
%e A400621   n = 1: 1 = 1 (1 has been used 1 time, retired);
%e A400621   n = 2: 2 + 3 = 5;
%e A400621   n = 3: 2 + 3 + 4 = 9 (2 has been used 2 times, retired);
%e A400621   n = 4: 3 + 4 + 5 + 6 = 18 (3 has been used 3 times, retired);
%e A400621   n = 5: 4 + 5 + 6 + 7 + 8 = 30;
%e A400621   n = 6: 4 + 5 + 6 + 7 + 8 + 9 = 39 (4 has been used 4 times, retired);
%e A400621   n = 7: 5 + 6 + 7 + 8 + 9 + 10 + 11 = 56;
%e A400621   n = 8: 5 + 6 + 7 + 8 + 9 + 10 + 11 + 12 = 68 (5 has been used 5 times, retired).
%t A400621 Table[n*Ceiling[n/GoldenRatio] + n*(n - 1)/2, {n, 1, 50}]
%o A400621 (Python)
%o A400621 from math import isqrt
%o A400621 def a(n):
%o A400621     # Exact integer arithmetic for ceil(n / phi) = 1 + floor(n*(sqrt(5)-1)/2)
%o A400621     s_n = 1 + (isqrt(5 * n**2) - n) // 2
%o A400621     return n * s_n + n * (n - 1) // 2
%o A400621 print([a(n) for n in range(1, 51)])
%Y A400621 Cf. A000201 (retirement row of k), A000217, A001622, A019446 (first term of row n), A320228.
%K A400621 nonn,easy,new
%O A400621 1,2
