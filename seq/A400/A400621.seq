%I A400621 #18 Oct 07 2026 20:50:54
%S A400621 0,0,2,0,5,0,10,0,2,3,17,0,28,8,2,0,41,0,58,3,7,15,77,0,5,26,2,8,100,
%T A400621 0,129,0,14,39,5,0,160,56,25,3,197,5,238,15,2,75,281,0,10,3,38,26,328,
%U A400621 0,12,8,55,98,381,0,440,127,7,0,23,12,501,39,74,3,568,0,639,158,2,56,10,23,712
%N A400621 Sum of primes less than P(n) that do not divide n, where P(n) is the largest prime factor of n; a(1) = 0.
%C A400621 a(n) = 0 if and only if n contains every prime up to its largest prime factor as a factor (e.g. powers of 2, primorials).
%C A400621 Writing n = m*P(n) with all prime factors of m less than P(n), a(n) = Sigma(P(n)) - S(m), where Sigma(p) = sum of primes < p and S(m) = sum of distinct prime factors of m.
%C A400621 Fixed points of a(n) = n correspond to m*p + S(m) = Sigma(p) for p = P(n) prime. The only known fixed points, found by a search over primes p < 3*10^7, are 5, 26, 4220.
%H A400621 Paolo Xausa, <a href="/A400621/b400621.txt">Table of n, a(n) for n = 1..10000</a>
%F A400621 a(n) = Sigma(P(n)) - Sum_{q|n, q<P(n), q prime} q, where Sigma(p) = Sum_{q<p, q prime} q.
%e A400621 a(14) = 8: P(14) = 7, primes below 7 are 2, 3, 5; 2 divides 14 but 3 and 5 do not, so a(14) = 3+5 = 8.
%e A400621 a(26) = 26: P(26) = 13, primes below 13 not dividing 26 are 3, 5, 7, 11, summing to 26.
%t A400621 A400621[n_] := Total[Prime[Complement[Range[Last[#]], #]]] & [PrimePi[FactorInteger[n][[All, 1]]]];
%t A400621 Array[A400621, 100] (* _Paolo Xausa_, Oct 07 2026 *)
%t A400621 (* Alternative, faster: *)
%t A400621 A400621list[nmax_] := With[{s = Accumulate[Prime[Range[PrimePi[nmax]]]]}, Join[{0}, Table[s[[Last[#]]] - Total[Prime[#]] & [PrimePi[FactorInteger[n][[All, 1]]]], {n, 2, nmax}]]];
%t A400621 A400621list[100] (* _Paolo Xausa_, Oct 07 2026 *)
%o A400621 (Python)
%o A400621 from sympy import primerange, primefactors
%o A400621 def a(n):
%o A400621     if n == 1: return 0
%o A400621     m = n; P = None; d = 2
%o A400621     while d*d <= m:
%o A400621         while m % d == 0:
%o A400621             P = d; m //= d
%o A400621         d += 1
%o A400621     if m > 1: P = m
%o A400621     div = set(primefactors(n))
%o A400621     return sum(q for q in primerange(2, P) if q not in div)
%Y A400621 Cf. A006530.
%K A400621 nonn,new
%O A400621 1,3
%A A400621 _Nishant R. Gautam_, Oct 01 2026
