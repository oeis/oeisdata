%I A400887 #18 Oct 15 2026 21:34:51
%S A400887 0,1,1,2,2,3,2,4,3,3,4,3,5,3,4,5,3,6,4,5,5,4,7,3,6,6,5,7,4,7,4,6,8,4,
%T A400887 8,7,6,9,5,8,5,7,7,6,9,8,7,5,6,10,5,8,8,7,10,6,9,6,8,11,6,10,9,8,11,7,
%U A400887 11,7,9,12,10,11,10,10,7,9,12,9,10,10,9,12,10
%N A400887 a(n+1) = a(n-a(a(n))^2) + 1, a(0) = 0.
%C A400887 Each term a(n+1) is obtained by adding 1 to an earlier term a(n-a(a(n))^2). These self-references to earlier terms define a tree with a(0) at its root, where a(n) equals the depth of node n (see the term-referencing trees visualized in the Links section).
%C A400887 The sequence appears to grow proportionally to sqrt(n). This is also suggested by the continuum approximation f(x+1) - f(x - f(f(x))^2) ~ 1, for which f(x) = 2^(1/4)*sqrt(x) gives an asymptotic balance.
%H A400887 Paolo Xausa, <a href="/A400887/b400887.txt">Table of n, a(n) for n = 0..10000</a>
%H A400887 Rok Cestnik, <a href="/A400887/a400887.pdf">Term-referencing tree for 100 terms. </a>
%H A400887 Rok Cestnik, <a href="/A400887/a400887_1.pdf">Term-referencing tree for 1000 terms. </a>
%F A400887 a(n) ~ 2^(1/4)*n^(1/2) (conjectured).
%e A400887 a(1) = a(0-a(a(0))^2)+1 = a(0-0)+1 = 1.
%e A400887 a(2) = a(1-a(a(1))^2)+1 = a(1-1)+1 = 1.
%e A400887 a(3) = a(2-a(a(2))^2)+1 = a(2-1)+1 = 2.
%t A400887 A400887[n_] := A400887[n] = If[n == 0, 0, A400887[n - 1 - A400887[A400887[n - 1]]^2] + 1];
%t A400887 Array[A400887, 100,0] (* _Paolo Xausa_, Oct 15 2026 *)
%t A400887 (* Alternative: with no recursion: *)
%t A400887 Module[{a = ConstantArray[0, #]}, Do[a[[k + 1]] = a[[k - a[[a[[k]] + 1]]^2]] + 1, {k, # - 1}]; a] & [100] (* _Paolo Xausa_, Oct 15 2026 *)
%o A400887 (Python)
%o A400887 a = [0]
%o A400887 for n in range(82):
%o A400887     a.append(a[n-a[a[n]]**2]+1)
%Y A400887 Cf. A364197, A340224, A339929.
%K A400887 nonn,easy,new
%O A400887 0,4
