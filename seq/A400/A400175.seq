%I A400175 #11 Sep 22 2026 10:34:44
%S A400175 1,2,1,4,2,1,12,4,2,1,48,24,4,2,1,240,144,44,4,2,1,1440,1440,304,72,4,
%T A400175 2,1,10080,14400,5360,528,108,4,2,1,80640,201600,65440,14880,816,152,
%U A400175 4,2,1,725760,2822400,1578080,198720,34032,1168,204,4,2,1
%N A400175 Array read by ascending antidiagonals: A(n,k) = n! * [x^n] ((1 + k*x)/(1 - k*x))^(1/k), with 1 <= k <= n.
%F A400175 A(0,k) = 1, A(1,k) = 2, and A(n,k) = 2*A(n-1,k) + k^2*(n - 1)*(n - 2)*A(n-2,k) for n > 1.
%e A400175 The array begins as:
%e A400175      1,     1,     1,      1,      1,      1, ...
%e A400175      2,     2,     2,      2,      2,      2, ...
%e A400175      4,     4,     4,      4,      4,      4, ...
%e A400175     12,    24,    44,     72,    108,    152, ...
%e A400175     48,   144,   304,    528,    816,   1168, ...
%e A400175    240,  1440,  5360,  14880,  34032,  68000, ...
%e A400175   1440, 14400, 65440, 198720, 476064, 976960, ...
%e A400175   ...
%t A400175 A[n_,k_]:=n!*SeriesCoefficient[((1+k*x)/(1-k*x))^(1/k),{x,0,n}]; Table[A[n-k,k],{n,0,10},{k,n}]//Flatten
%t A400175 (* Alternative: *)
%t A400175 A[0,k_]:=1; A[1,k_]:=2; A[n_,k_]:=A[n,k]=2*A[n-1,k]+k^2*(n-1)*(n-2)*A[n-2,k]; Table[A[n-k,k],{n,0,10},{k,n}]//Flatten
%Y A400175 Columns k=1..2 give A098558, A110491.
%Y A400175 Rows n=0..2 give A000012, A007395, A010709.
%Y A400175 Antidiagonal sums give A400176.
%Y A400175 Cf. A063886, A303537, A303538, A304915, A305608.
%K A400175 nonn,tabl,easy,new
%O A400175 0,2
