%S A400894 3,7,11,13,15,19,23,27,29,31,35,39,43,45,47,51,53,55,59,61,63,67,71,
%T A400894 75,77,79,83,87,91,93,95,99,103,107,109,111,115,117,119,123,125,127,
%U A400894 131,135,139,141,143,147,151,155,157,159,163,167,171,173,175,179,181,183
%N A400894 Bipartition of the positive odd numbers depending on the parity of the 2-adic valuation A007814(3*k + 2). Here the part with even valuation based on A400891.
%C A400894 See A400893.
%F A400894 a(n) = 2*A400891(n) + 1.
%e A400894 a(3) = 11 because A400891(3) = 5.
%p A400894 q:= k-> is(irem(padic[ordp](3*k+2,2),2)=0):
%p A400894 map(x-> 2*x+1, select(q, [$0..91]))[];  # _Alois P. Heinz_, Oct 08 2026
%t A400894 2*Select[Range[91], EvenQ[IntegerExponent[3*# + 2, 2]] &] + 1 (* _Amiram Eldar_, Oct 08 2026 *)
%Y A400894 See A400893 for the odd part.
%Y A400894 Cf. A005408, A007814, A075677, A400891.
%K A400894 nonn,easy
%O A400894 1,1
%A A400894 _Wolfdieter Lang_, Oct 08 2026
