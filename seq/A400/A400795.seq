%I A400795 #13 Oct 13 2026 23:33:19
%S A400795 2,4,7,13,22,25,31,52,61,73,82,88,97,115,133,145,157,172,178,193,232,
%T A400795 238,277,283,292,313,337,358,361,397,418,421,442,451,472,481,535,553,
%U A400795 613,658,661,682,718,733,742,757,802,817,841,871,922,955,973,997,1018,1048,1102,1117,1123
%N A400795 Strongly nontriangular numbers, defined as the complement of the generalized triangular numbers in the reference below. Generalized triangular numbers include 1 and those in the range of the function P(i,j) = (i*j+i+j-gcd(i,j))/2 for integers i, j > 1.
%C A400795 It is conjectured that this sequence is infinite and has natural density zero. The sequence arises in an attempt to study "generalized triangular numbers" of the form P(i,j) = (i*j+i+j-gcd(i,j))/2. This formula counts the number of lattice points in the triangle with vertices (0,0), (i,0), (0,j), excluding points on the hypotenuse.
%H A400795 Kyle Petersen, <a href="/A400795/b400795.txt">Table of n, a(n) for n = 1..2271</a>
%H A400795 T. K. Petersen, J. Validashti, and C. Wayland, <a href="https://doi.org/10.1080/0025570X.2026.2627861">Strongly Nontriangular Numbers</a>, Mathematics Magazine, (2026).
%p A400795 P:=proc(a,b)
%p A400795  (a*b+a+b-gcd(a,b))/2;
%p A400795 end:
%p A400795 Psieve:=proc(n) local b, base, r, i, j, k, ns, Sbig, S, T, Snew;
%p A400795  Sbig:=[seq(i,i=2..n*(n+1)/2)];
%p A400795  S:=[];
%p A400795  for b from 2 to n do
%p A400795   base:=b*(b+1)/2;
%p A400795   i:=1;
%p A400795   ns:=nops(Sbig);
%p A400795   while Sbig[i]<base and i<ns do
%p A400795    i:=i+1;
%p A400795   od:
%p A400795   S:=[op(S),op(1..i-1,Sbig)];
%p A400795   Sbig:=Sbig[i..-1];
%p A400795   if nops(Sbig)=0 then RETURN(S) fi;
%p A400795   #We can quit when there are no big numbers remaining
%p A400795   for r from 0 to b-1 do
%p A400795    k:=P(b+r,b) mod base;
%p A400795     #These numbers are multiply realized
%p A400795     #if bigger or equal to base
%p A400795    Snew:={op(Sbig)};
%p A400795    for j from 1 to nops(Sbig) do
%p A400795     if Sbig[j] mod base = k then
%p A400795      Snew:=Snew minus {Sbig[j]}; #throw out stuff
%p A400795     fi;
%p A400795    od;
%p A400795    Sbig:=[op(Snew)];
%p A400795   od:
%p A400795  od:
%p A400795  S;
%p A400795 end:
%K A400795 nonn
%O A400795 1,1
%A A400795 _Kyle Petersen_, Oct 06 2026
