%I A400132 #15 Sep 27 2026 16:26:02
%S A400132 1,2,3,4,12,504,1020675
%N A400132 Numbers k such that A007504(k) - 1 is a perfect square.
%e A400132 1 is a term: A007504(1) = 2; 2 - 1 = 1; 1 = 1^2.
%e A400132 2 is a term: A007504(2) = 5; 5 - 1 = 4; 4 = 2^2.
%e A400132 3 is a term: A007504(3) = 10; 10 - 1 = 9; 9 = 3^2.
%e A400132 4 is a term: A007504(4) = 17; 17 - 1 = 16; 16 = 4^2.
%e A400132 12 is a term: A007504(12) = 197; 197 - 1 = 196; 196 = 14^2.
%e A400132 504 is a term: A007504(504) = 839057; 839057 - 1 = 839056; 839056 = 916^2.
%p A400132 P:= select(isprime, [2,seq(i,i=3..2*10^6,2)]):
%p A400132 S:= ListTools:-PartialSums(P) -~ 1:
%p A400132 select(k -> issqr(S[k]),[$1..nops(S)]); # _Robert Israel_, Sep 19 2026
%o A400132 (PARI) isok(k) = issquare(vecsum(primes(k)) - 1); \\ _Michel Marcus_, Sep 20 2026
%Y A400132 Cf. A000040, A000290, A007504, A264858 (same with +1).
%K A400132 nonn,more,new
%O A400132 1,2
%A A400132 _Om S. M. Yadav_, Sep 19 2026
