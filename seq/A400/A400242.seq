%N A400242 G.f. A(x) satisfies A(x) = A(x^3/(1 - x)^4) / (1 - x), with A(0) = 1.
%F A400242 a(0) = 1; a(n) = Sum_{k=0..floor(n/3)} binomial(n+k,4*k) * a(k).
%o A400242 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=0, i\3, binomial(i+j, 4*j)*v[j+1])); v;
