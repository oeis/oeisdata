%U A400523 0,1,0,0,1,0,4,0,1,0,1,0,1,0,0,0,1,0,0,1,0,1,0,0,1
%N A400523 The exponent of the highest power of 2 dividing the n-th number whose prime factorization exponents are squares (A197680).
%H A400523 Amiram Eldar, <a href="/A400523/b400523.txt">Table of n, a(n) for n = 1..10000</a>
%F A400523 a(n) = A007814(A197680(n)).
%F A400523 a(n) <= A369935(n).
%F A400523 Asymptotic mean: Limit_{m->oo} (1/m) * Sum_{k=1..m} a(k) = Sum_{k>=1} k^2/2^(k^2) / Sum_{k>=0} 1/2^(k^2) = 0.49078843940176632753... .
%t A400523 IntegerExponent[Select[Range[150], AllTrue[FactorInteger[#][[;; , 2]], IntegerQ[Sqrt[#1]] &] &], 2]
%o A400523 (PARI) isexpsq(n) = {my(e = factor(n)[,2]); for(i = 1, #e, if(!issquare(e[i]), return(0))); 1;}
%o A400523 list(kmax) = for(k = 1, kmax, if(isexpsq(k), print1(valuation(k, 2), ", ")));
%Y A400523 Cf. A007814, A197680, A319015, A369935.
%Y A400523 Similar sequences: 1-A373550 (squarefree), A383004 (cubefree), A383005 (biquadratefree), A383006 (powerful), A383007 (cubefull), A383029 (exponentially odd), A386536 (cubefree but not squarefree).
%K A400523 nonn,easy,new
%O A400523 1,12
