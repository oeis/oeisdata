%N A400779 a(n) = Sum_{d|n} gcd(n,d+1).
%C A400779 Sequence is not multiplicative: a(2) = 3, a(3) = 2 and a(6) = 8.
%F A400779 a(2^k) = k+2.
%F A400779 a(p^k) = k+1 for p an odd prime.
%t A400779 Table[DivisorSum[n, GCD[n, # + 1] &], {n, 80}] (* _Michael De Vlieger_, Oct 06 2026 *)
%o A400779 (Python)
%o A400779 from math import gcd
%o A400779 from sympy import divisors
%o A400779 def A400779(n): return sum(gcd(n,d+1) for d in divisors(n,generator=True))
