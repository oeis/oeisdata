%I A400396 #9 Sep 26 2026 09:37:40
%S A400396 1,3,4,6,6,12,8,15,11,18,12,24,14,24,24,28,18,33,20,36,32,36,24,60,27,
%T A400396 42,40,48,30,72,32,63,48,54,48,66,38,60,56,90,42,96,44,72,66,72,48,
%U A400396 112,51,81,72,84,54,120,72,120,80,90,60,144,62,96,88,120,84,144,68,108,96,144
%N A400396 a(n) = Sum_{d|n} d / gcud(d, n/d), where gcud is the greatest common unitary divisor.
%H A400396 Amiram Eldar, <a href="/A400396/b400396.txt">Table of n, a(n) for n = 1..10000</a>
%F A400396 Multiplicative with a(p^e) = (p^(e+1)-1)/(p-1) if e is odd, and (p^(e+1)-1)/(p-1) - p^(e/2) + 1 if e is even.
%F A400396 a(n) <= A000203(n), with equality if and only if n is an exponentially odd number (A268335).
%F A400396 Dirichlet g.f.: zeta(s-1) * zeta(2*s-1) * zeta(2*s) * Product_{p prime} (1 + 1/p^s - 2/p^(2*s-1) + 1/p^(2*s) + 1/p^(3*s-2) - 2/p^(3*s-1)).
%F A400396 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = zeta(3) * zeta(4) * Product_{p prime} (1 + 1/p^2 - 2/p^3 + 2/p^4 - 2/p^5) = 1.55982724048608344416... .
%t A400396 f[p_, e_] := (p^(e+1)-1)/(p-1) - If[OddQ[e], 0, p^(e/2)-1];
%t A400396 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n];
%t A400396 Array[a, 100]
%o A400396 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, (f[i,1]^(f[i,2]+1)-1)/(f[i,1]-1) - if(!(f[i,2] % 2), f[i,1]^(f[i,2]/2) - 1));}
%Y A400396 Cf. A000203, A002117, A013662, A077610, A165430, A268335, A332619 (gcd analog), A400391.
%K A400396 nonn,mult,easy,new
%O A400396 1,2
%A A400396 _Amiram Eldar_, Sep 25 2026
