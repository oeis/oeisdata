%S A400392 1,2,2,4,2,4,2,4,5,4,2,8,2,4,4,8,2,10,2,8,4,4,2,8,7,4,4,8,2,8,2,6,4,4,
%T A400392 4,20,2,4,4,8,2,8,2,8,10,4,2,16,9,14,4,8,2,8,4,8,4,4,2,16,2,4,10,14,4,
%U A400392 8,2,8,4,8,2,20,2,4,14,8,4,8,2,16,13,4,2,16,4,4,4,8
%N A400392 a(n) = Sum_{d|n} gcud(d, n/d), where gcud is the greatest common unitary divisor.
%H A400392 Amiram Eldar, <a href="/A400392/b400392.txt">Table of n, a(n) for n = 1..10000</a>
%H A400392 Vaclav Kotesovec, <a href="/A400392/a400392.jpg">Graph - the asymptotic ratio (10000 terms)</a>
%F A400392 Multiplicative with a(p^e) = e+1 if e is odd, and p^(e/2) + e if e is even.
%F A400392 a(n) >= A000005(n), with equality if and only if n is an exponentially odd number (A268335).
%F A400392 Dirichlet g.f.: zeta(s) * zeta(2*s) * zeta(2*s-1) * Product_{p prime} (1 + 1/p^s - 1/p^(2*s) - 2/p^(3*s-1) + 1/p^(3*s)).
%F A400392 From _Vaclav Kotesovec_, Sep 25 2026: (Start)
%F A400392 Let f(s) = Product_{p prime} (1 - (p^s+2*p-1) / ((p^s+1)*p^(2*s))).
%F A400392 Dirichlet g.f.: zeta(2*s-1) * zeta(s)^2 * f(s).
%F A400392 Sum_{k=1..n} a(k) ~ n*f(1)*(log(n)^2 + (8*gamma - 2)*(log(n) - 1) + (2*log(n) - 2 + 8*gamma)*f'(1)/f(1) + 10*gamma^2 - 12*sg1 + f''(1)/f(1))/4, where
%F A400392 f(1) = Product_{primes p} (1 - (3*p-1)/(p^2*(p+1))) = A394002 = 0.3582316300019614145675042904101021501172418443408199250701117168...,
%F A400392 f'(1) = f(1) * Sum_{primes p} 2*(4*p^2+p-1) * log(p) / ((p+1)*(p^3+p^2-3*p+1)) = f(1) * 3.2351393083626006860030075110983760787378752217510375525198174828...,
%F A400392 f''(1) = f'(1)^2/f(1) + f(1) * Sum_{primes p} (-2*p*(11*p^5+19*p^4+6*p^3-5*p+1) * log(p)^2 / ((p+1)^2*(p^3+p^2-3*p+1)^2)) = f'(1)^2/f(1) + f(1) * (-14.99022215809238933688394857177989603187796839256070082519193855484...),
%F A400392 gamma is the Euler-Mascheroni constant A001620 and sg1 is the first Stieltjes constant (see A082633). (End)
%t A400392 f[p_, e_] := e + If[EvenQ[e], p^(e/2), 1];
%t A400392 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n];
%t A400392 Array[a, 100]
%o A400392 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, f[i,2] + if(f[i,2] % 2, 1, f[i,1]^(f[i,2]/2)));}
%Y A400392 Row sums of A400391.
%Y A400392 Cf. A000005, A055155 (gcd analog), A077610, A165430, A225174, A268335, A400393 (gcid analog), A394002.
%K A400392 nonn,mult,easy,new
%O A400392 1,2
