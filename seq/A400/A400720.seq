%S A400720 1,2,3,4,5,6,7,8,9,12,13,14,15,16,17,18,19,21,23,24,25,26,27,28,29,31,
%T A400720 32,34,35,36,37,38,39,41,43,45,46,47,48,49,51,53,54,56,58,59,61,62,63,
%U A400720 64,65,67,68,69,71,72,73,74,75,76,78,79,81,82,83,85,86
%N A400720 Numbers k such that 3^k-2^k is squarefree.
%C A400720 See A398834 for a guide to related sequences.
%e A400720 Let p(k) = 3^k - 2^k. The first five squarefree values of p(k) are 1, 5, 19, 65, 211.
%t A400720 {x, y} = {3, 2}; p[n_] := p[n] = (x^n - y^n)/(x - y);
%t A400720 f[n_] := f[n] = FactorInteger[p[n]]; Table[f[n], {n, 1, 10}] // Column
%t A400720 Table[Length[f[n]], {n, 0, 100}];
%t A400720 Position[Map[SquareFreeQ, Table[p[n], {n, 1, 150}]], True] // Flatten
%Y A400720 Cf. A001047, A049093, A280149 (complement), A398834, A399911.
%K A400720 nonn,easy,new
%O A400720 1,2
%A A400720 _Clark Kimberling_, Oct 22 2026
