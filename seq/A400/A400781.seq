%I A400781 #22 Oct 19 2026 10:55:08
%S A400781 1,65,12384,1950354,854533526901
%N A400781 Smallest positive integer expressible as the sum of n distinct positive n-th powers in n ways, with no n-th power repeated across the representations.
%C A400781 For a given n, we search for the smallest integer N that can be written as N = x_1^n + x_2^n + ... + x_n^n in n different ways, such that the set of all base numbers used across all n representations contains no duplicates.
%C A400781 From _Seiichi Manyama_, Oct 19 2026: (Start)
%C A400781 The definition requires at least n representations, n of which have pairwise disjoint sets of bases; additional representations are allowed even if they share bases with the selected representations. For n = 1, ..., 5, a(n) has exactly n representations in total. (End)
%e A400781 a(2) = 65: 1^2 + 8^2 = 4^2 + 7^2.
%e A400781 a(3) = 12384: 1^3 + 6^3 + 23^3 = 2^3 + 12^3 + 22^3 = 15^3 + 16^3 + 17^3.
%o A400781 (Python)
%o A400781 from itertools import combinations
%o A400781 from collections import defaultdict
%o A400781 def find(n, M):
%o A400781     d = defaultdict(list)
%o A400781     for c in combinations(range(1, M + 1), n):
%o A400781         d[sum(x**n for x in c)].append(c)
%o A400781     for N in sorted(d):
%o A400781         r = d[N]
%o A400781         def f(i, chosen, used):
%o A400781             if len(chosen) == n:
%o A400781                 return chosen
%o A400781             for j in range(i, len(r)):
%o A400781                 if not set(r[j]) & used:
%o A400781                     ans = f(j + 1, chosen + [r[j]], used | set(r[j]))
%o A400781                     if ans:
%o A400781                         return ans
%o A400781         ans = f(0, [], set())
%o A400781         if ans:
%o A400781             return N, ans
%o A400781 for n in range(1, 5):
%o A400781     result = find(n, 100)
%o A400781     if result:
%o A400781         N, reps = result
%o A400781         print(N)
%o A400781         for r in reps:
%o A400781             print(" + ".join(f"{x}^{n}" for x in r), "=", N)
%Y A400781 Cf. A393788, A347362, A146756, A345863, A345864.
%K A400781 nonn,hard,more,new
%O A400781 1,2
%A A400781 _Abhishek Kumar_, Oct 06 2026
%E A400781 a(5) from _Seiichi Manyama_, Oct 19 2026
