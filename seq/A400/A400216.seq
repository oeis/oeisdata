%S A400216 -1,-1,1,1,5,31,83,361,1373,3895,15803,50449,154613,580879,1717475,
%T A400216 5616889,19470797,56506279,191825867,618195745,1827325157,6239681791,
%U A400216 19032942707,58321973641,195142538045,577395661591,1833773717723,5920407224881,17430033083093
%N A400216 Scaled x-coordinates of the vertices of a Boerdijk-Coxeter helix starting at a tetrahedron with vertices (-1,-1,-1), (1, -1, 1), (-1, 1, 1), and (1, 1, -1).
%C A400216 Each coordinate is scaled by a factor of k, where k = 1 if n <= 3, otherwise k = 3^(n-3).
%C A400216 There are 24 possible choices for Boerdijk-Coxeter helices with this starting tetrahedron, one for each symmetry of the tetrahedron. This helix is the choice that asymptotically maximizes the x-value and then maximizes the y-value.
%H A400216 Wikipedia, <a href="https://en.wikipedia.org/wiki/Boerdijk%E2%80%93Coxeter_helix">Boerdijk-Coxeter helix</a>
%F A400216 G.f. (54*x^6 - 84*x^5 - 66*x^4 + 23*x^3 + 9*x^2 + x - 1)/((3*x - 1)^2 * (9*x^2 + 4*x + 1) (conjectured).
%e A400216 The first ten vertices are at
%e A400216   (  -1/1,     -1/1,     -1/1),
%e A400216   (  -1/1,      1/1,      1/1),
%e A400216   (   1/1,     -1/1,      1/1),
%e A400216   (   1/1,      1/1,     -1/1),
%e A400216   (   5/3,      5/3,      5/3),
%e A400216   (  31/9,      1/9,      1/9),
%e A400216   (  83/27,    77/27,   -13/27),
%e A400216   ( 361/81,   169/81,   151/81),
%e A400216   (1373/243,  413/243, -163/243), and
%e A400216   (3895/729, 3145/729,  265/729).
%Y A400216 Cf. A400217 (y-values), A400218 (z-values).
%K A400216 sign,frac,new
%O A400216 0,5
%A A400216 _Peter Kagey_, Sep 21 2026
