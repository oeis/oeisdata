%N A400505 Array A(n,k), n >= 2, k >= 2, read by antidiagonals: number of unit squares in the k^n cubic grid.
%C A400505 For n >= 2, there are binomial(n,2) pairs of coordinate axes, k^(n-2) coordinate-parallel planes per axis pair, and (k-1)^2 unit squares per plane.
%H A400505 Eddie Lin Rui, <a href="/A400505/b400505.txt">Table of n, a(n) for n = 2..10012; the first 141 antidiagonals of the array</a>
%F A400505 A(n,k) = binomial(n,2)*k^(n-2)*(k-1)^2.
%e A400505 For a 3-dimensional, 4 X 4 X 4 cubic grid, there are 3 pairs of coordinate axes: xy, xz, and yz. Each pair has 4 coordinate-parallel planes, each containing (4-1)^2 = 9 unit squares. Therefore, A(3,4) = 3*4*9 = 108.
%e A400505 The array begins:
%e A400505        k=2      3       4        5         6          7          8           9
%e A400505  n=2     1      4       9       16        25         36         49          64
%e A400505  n=3     6     36     108      240       450        756       1176        1728
%e A400505  n=4    24    216     864     2400      5400      10584      18816       31104
%e A400505  n=5    80   1080    5760    20000     54000     123480     250880      466560
%e A400505  n=6   240   4860   34560   150000    486000    1296540    3010560     6298560
%e A400505  n=7   672  20412  193536  1050000   4082400   12706092   33718272    79361856
%e A400505  n=8  1792  81648 1032192  7000000  32659200  118590192  359661568   952342272
%e A400505  n=9  4608 314928 5308416 45000000 251942400 1067311728 3699376128 11019960576
%e A400505  ....
%e A400505 A(3,4) = binomial(3,2)*4^(3-2)*(4-1)^2 = 3*4*9 = 108.
%t A400505 A400505[n_, k_] := Binomial[n, 2]*k^(n - 2)*(k - 1)^2;
%t A400505 Table[A400505[k, n - k + 2], {n, 2, 10}, {k, 2, n}] (* _Paolo Xausa_, Nov 04 2026 *)
%o A400505 (Python)
%o A400505 def A(n, k):
%o A400505     return n*(n-1)//2*k**(n-2)*(k-1)**2
%o A400505 a = []
%o A400505 for d in range(1, 10):
%o A400505     a.extend(A(n, d + 3 - n) for n in range(2, d + 2))
%o A400505 print(a)
