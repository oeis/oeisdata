%S A400248 1,-1,-2,2,-4,2,-6,-4,0,4,-10,-4,-12,6,8,8,-16,0,-18,-8,12,10,-22,8,0,
%T A400248 12,18,-12,-28,-8,-30,-16,20,16,24,0,-36,18,24,16,-40,-12,-42,-20,0,
%U A400248 22,-46,-16,0,0,32,-24,-52,-18,40,24,36,28,-58,16,-60,30,0,32,48,-20,-66,-32,44,-24,-70,0,-72,36,0,-36,60,-24
%N A400248 Dirichlet convolution of A085731 with A055615 (Dirichlet inverse of n), where A085731(n) = gcd(n,n'), and n' is the arithmetic derivative of n.
%H A400248 Antti Karttunen, <a href="/A400248/b400248.txt">Table of n, a(n) for n = 1..10000</a>
%F A400248 a(n) = Sum_{d|n} A055615(n/d)*A085731(d).
%F A400248 Multiplicative with a(p^e) = p^e - p^(e-1) if e is a multiple of p, p^(e-1) - p^e if e-1 is a multiple of p, and 0 otherwise. - _Amiram Eldar_, Sep 24 2026
%t A400248 f[p_, e_] := If[Divisible[e, p], p^e - p^(e-1), If[Divisible[e-1, p], p^(e-1) - p^e, 0]]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100] (* _Amiram Eldar_, Sep 24 2026 *)
%o A400248 (PARI)
%o A400248 A085731(n) = { my(f = factor(n)); for (i=1, #f~, if (f[i, 2] % f[i, 1], f[i, 2]--); ); factorback(f); };
%o A400248 A055615(n) = (n*moebius(n));
%o A400248 A400248(n) = sumdiv(n,d,A055615(n/d)*A085731(d));
%Y A400248 Cf. A003415, A085731, A055615.
%Y A400248 Cf. also A359577, A400249.
%K A400248 sign,mult,easy,new
%O A400248 1,3
%A A400248 _Antti Karttunen_, Sep 24 2026
