%N A400243 G.f. A(x) satisfies A(x) = A(x^2/(1 - x)^3) / (1 - x)^2, with A(0) = 1.
%F A400243 a(0) = 1; a(n) = Sum_{k=0..floor(n/2)} binomial(n+k+1,3*k+1) * a(k).
%F A400243 G.f.: B(x)^2 where B(x) is the g.f. of A400241.
%o A400243 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=0, i\2, binomial(i+j+1, 3*j+1)*v[j+1])); v;
