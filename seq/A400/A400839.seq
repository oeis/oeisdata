%S A400839 1,7,10,29,30,31,36,40,47,48,49,53,54,59,61,66,69,81,90,91,102,104,
%T A400839 107,115,117,121,142,148,154,155,169,174,181,184,192,198,203,214,227,
%U A400839 232,239,241,243,247,260,264,267,269,274,294,303,310,313,324,325,335,339,363,370,371,375,379,382,392,411,419,428,429
%N A400839 Numbers k such that prime(1+k) divides 1+2*prime(k)#/prime(i)# for some i in range 1..k, where prime(n)# = A002110(n) is the n-th primorial number.
%C A400839 Numbers k for which there exists i in range 1..n such that 1+2*(A002110(k)/A002110(i)) is a multiple of prime(1+k).
%H A400839 Antti Karttunen, <a href="/A400839/b400839.txt">Table of n, a(n) for n = 1..4005</a>
%H A400839 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%e A400839 Term 29 occurs because A400838(29) = 18. We have A000040(29+1) = 113, A000040(18+1) = 67, and actually, 113^2 * 67 = 855523. See also comments in A373487.
%o A400839 (PARI)
%o A400839 A400838(n) = if(1==n,1,my(p=prime(1+n),pr=Mod(2,p)); forstep(k=n,1,-1, pr *= Mod(prime(k),p); if((p-1)==lift(pr), return(k-1))); (-1));
%o A400839 is_A400839(n) = (A400838(n)>0);
%Y A400839 Positions of strictly positive terms in A400838 and in A401050.
%Y A400839 Cf. A400842 [= A000040(1+a(n))].
%K A400839 nonn
%O A400839 1,2
%A A400839 _Antti Karttunen_, Oct 14 2026
