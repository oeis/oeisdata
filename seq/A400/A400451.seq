%I A400451 #8 Sep 27 2026 11:19:38
%S A400451 0,1,2,4,6,8,12,16,20,24,32,40,48,56,64,80,96,112,128,144,160,192,224,
%T A400451 256,288,320,352,384,448,512,576,640,704,768,832,896,1024,1152,1280,
%U A400451 1408,1536,1664,1792,1920,2048,2304,2560,2816,3072,3328,3584,3840,4096,4352,4608,5120
%N A400451 Distinct values of A400450 in increasing order.
%C A400451 Possible values of the number of divisors d of a positive number k such that gcd(d, k/d) is prime.
%C A400451 0 and numbers of the form 2^k * (2*m+1), where k >= 0 and 0 <= m <= k.
%C A400451 0 and positive numbers k such that A007814(k) >= (A000265(k)-1)/2.
%H A400451 Amiram Eldar, <a href="/A400451/b400451.txt">Table of n, a(n) for n = 1..10000</a>
%F A400451 Sum_{n>=2} 1/a(n) = 2 * sqrt(2) * log(1+sqrt(2)) = 4 * A196525.
%t A400451 q[k_] := Module[{e = IntegerExponent[k, 2]}, k/2^e <= 2*e + 1]; Select[Range[0, 5120], q]
%t A400451 (* Alternative: *)
%t A400451 seq[lim_] := Module[{s = {0}, k = 0}, While[k < Log2[lim], s = Join[s, Select[2^k*(2*Range[0, k] + 1), # <= lim &]]; k++]; Sort[s]]; seq[5120]
%o A400451 (PARI) isok(k) = if(k == 0, 1, my(e = valuation(k, 2)); k >> e <= 2*e+1);
%Y A400451 Cf. A000265, A007814, A196525, A400390, A400450.
%K A400451 nonn,easy,new
%O A400451 1,3
%A A400451 _Amiram Eldar_, Sep 26 2026
