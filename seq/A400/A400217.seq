%S A400217 -1,1,-1,1,5,1,77,169,413,3145,5573,23761,104117,196369,993725,
%T A400217 3115129,7293773,35259481,89862197,270243745,1123535717,2630035489,
%U A400217 9586834733,33287781961,80430818045,320118478441,945468327077,2563091910769,10046230134293
%N A400217 Scaled y-coordinates of the vertices of a Boerdijk-Coxeter helix starting at a tetrahedron with vertices (-1,-1,-1), (1, -1, 1), (-1, 1, 1), and (1, 1, -1).
%C A400217 Each coordinate is scaled by a factor of k, where k = 1 if n <= 3, otherwise k = 3^(n-3).
%C A400217 There are 24 possible choices for Boerdijk-Coxeter helices with this starting tetrahedron, one for each symmetry of the tetrahedron. This helix is the choice that asymptotically maximizes the x-value and then maximizes the y-value.
%H A400217 Wikipedia, <a href="https://en.wikipedia.org/wiki/Boerdijk%E2%80%93Coxeter_helix">Boerdijk-Coxeter helix</a>
%F A400217 G.f.: (-54*x^6 + 84*x^5 - 90*x^4 + 15*x^3 + 3*x^2 + 3*x - 1)/((3*x - 1)^2*(9*x^2 + 4*x + 1)) (conjectured).
%e A400217 The first ten vertices are at
%e A400217 (  -1/1,     -1/1,     -1/1),
%e A400217 (  -1/1,      1/1,      1/1),
%e A400217 (   1/1,     -1/1,      1/1),
%e A400217 (   1/1,      1/1,     -1/1),
%e A400217 (   5/3,      5/3,      5/3),
%e A400217 (  31/9,      1/9,      1/9),
%e A400217 (  83/27,    77/27,   -13/27),
%e A400217 ( 361/81,   169/81,   151/81),
%e A400217 (1373/243,  413/243, -163/243), and
%e A400217 (3895/729, 3145/729,  265/729).
%Y A400217 Cf. A400216 (x-values), A400218 (z-values).
%K A400217 sign,frac,new
%O A400217 0,5
