%T A400154 301,308,329,330,374,418,429,484,506,561,605,627,638,715,759,832,847,
%U A400154 935,1001,1040,1045,1248,1309,1331,1404,1456,1463,1560,1573,1716,1768,1820,1950,1976,2028,2057,2106,2132,2184,2189,2236,2299,2321,2340,2392,2444,2453,2457,2497,2519,2548,2563,2574,2629,2651
%N A400154 Numbers k that are multiples of A400153(k).
%H A400154 Antti Karttunen, <a href="/A400154/b400154.txt">Table of n, a(n) for n = 1..10000</a>
%H A400154 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400154 {k such that k == 0 mod A400153(k)}.
%o A400154 (PARI)
%o A400154 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400154 A400152(n) = { my(p=2,q=1,d=0); while(n, d = n%p; n = n\p; q = p; p = nextprime(1+p)); (q^d); };
%o A400154 A400153(n) = A400152(A003415(n));
%o A400154 is_A400154(k) = !(k%A400153(k));
%Y A400154 Cf. A003415, A400152, A400153.
%Y A400154 Subsequences: A370115.
%Y A400154 Cf. also A399378, A399379.
%K A400154 nonn,new
%O A400154 1,3
