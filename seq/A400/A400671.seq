%I A400671 #22 Oct 21 2026 15:21:16
%S A400671 0,1,1,2,2,3,3,3,4,6,4,4,5,7,10,5,5,6,8,11,15,6,6,7,9,12,16,21,7,7,8,
%T A400671 10,13,17,22,28,8,8,9,11,14,18,23,29,36,9,9,10,12,15,19,24,30,37,45,
%U A400671 10,10,11,13,16,20,25,31,38,46,55
%N A400671 Triangle read by rows: T(n, k) = n + binomial(k, 2).
%C A400671 T(n, k) is the area of any Dyck path that begins with U^{k+1} and in which the remaining up-steps have starting heights summing to n - k. The area of a Dyck path is half the number of complete unit squares beneath the path. Equivalently, it is the sum of the starting heights of its up-steps.
%C A400671 A168396(n, k) is the number of primitive Dyck paths of area T(n, k) that begin with U^(k+1), for 1 <= k <= n. Conversely, each composition as described by A168396 uniquely determines a primitive Dyck path.
%F A400671 T(n, k) = binomial(k + 1, 2) + (n - k) = n - k + k*(k + 1) / 2.
%F A400671 G.f.: x*(x*y*(3 - x*y) - y - 1)/((x - 1)^2*(x*y - 1)^3).
%F A400671 G.f. of column k: (x^k*(2*x - k*(k + 1)*(x - 1)))/(2*(x - 1)^2).
%F A400671 E.g.f. in n, o.g.f. in k: (y^2*exp(x*y)*(x^2*y*(y - 1)^2 / 2 + x*(y - 1)*(y - 2) + 1) - exp(x)*(x*(y - 1)^2 + y^2))/(y - 1)^3.
%F A400671 T(n, k) = T(n, k-1) + (k-1), with T(n, 0) = n.
%F A400671 T(n, k) = T(n-1, k) + 1 for 0 <= k < n, and T(k, k) = binomial(k+1, 2).
%F A400671 Sum_{k=0..n} T(n, k) = n*(n+1)*(n+5)/6 = A005581(n + 1).
%e A400671 Triangle starts:
%e A400671   [0] [0]
%e A400671   [1] [1, 1]
%e A400671   [2] [2, 2,  3]
%e A400671   [3] [3, 3,  4,  6]
%e A400671   [4] [4, 4,  5,  7, 10]
%e A400671   [5] [5, 5,  6,  8, 11, 15]
%e A400671   [6] [6, 6,  7,  9, 12, 16, 21]
%e A400671   [7] [7, 7,  8, 10, 13, 17, 22, 28]
%e A400671   [8] [8, 8,  9, 11, 14, 18, 23, 29, 36]
%e A400671   [9] [9, 9, 10, 12, 15, 19, 24, 30, 37, 45]
%e A400671 .
%e A400671 For n >= 0, U^(n+1)D^(n+1) is the unique primitive Dyck path that begins with U^(n+1) and has area T(n, n) = binomial(n+1, 2) = A000217(n).
%e A400671 .
%e A400671 The composition (2,3,1) is counted by A168396(6,2). It corresponds to U^4 D^3 U D^2. The up-steps start at heights 0, 1, 2, 3, 1, which sums to 7 = T(6,2).
%p A400671 gf := x*(x*y*(3-x*y)-y-1)/((x-1)^2*(x*y-1)^3): PREC := 10:
%p A400671 serx := expand(series(gf, x, PREC+1)): cx := n -> coeff(serx, x, n):
%p A400671 Trow := n -> local k; seq(coeff(cx(n), y, k), k = 0..n):
%p A400671 seq(print(Trow(n)), n = 0..PREC);
%t A400671 nmax = 10;
%t A400671 egf = (y^2 Exp[x y] (x^2 y (y - 1)^2/2 + x (y - 1) (y - 2) + 1) - Exp[x] (x (y - 1)^2 + y^2))/(y - 1)^3;
%t A400671 ser = Normal[Series[egf, {x, 0, nmax}]];
%t A400671 rows = Table[PadRight[CoefficientList[Together[n! Coefficient[ser, x, n]], y], n + 1], {n, 0, nmax}]; Flatten[rows]
%o A400671 (Python)
%o A400671 from math import comb
%o A400671 def T(n, k): return n + comb(k, 2)
%o A400671 for n in range(10):
%o A400671     print([T(n, k) for k in range(n + 1)])
%Y A400671 Cf. A000217 (main diagonal), A000124 (subdiagonal), A152948, A152949, A152950, A145018, A005581 (row sums).
%Y A400671 Cf. A168396.
%K A400671 nonn,tabl,easy,new
%O A400671 0,4
