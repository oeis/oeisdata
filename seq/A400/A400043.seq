%S A400043 1,7,19,35,57,82,113,147,187,230,279,331,389,450,517,587,663,742,827,
%T A400043 915,1009,1106,1209,1315,1427,1542,1663,1787,1917,2050,2189,2331,2479,
%U A400043 2630,2787,2947,3113,3282,3457,3635,3819,4006,4199,4395,4597,4802,5013,5227
%N A400043 Maximum number of unit-cube interiors intersected by a plane in an n X n X n subdivision of a cube.
%C A400043 Contacts only on the boundaries of unit cubes do not count.
%H A400043 Eric W. Weisstein, <a href="/A400043/b400043.txt">Table of n, a(n) for n = 1..1000</a>
%H A400043 I. Barany and P. Frankl, <a href="https://doi.org/10.1080/00029890.2021.1901463">How (Not) to Cut Your Cheese</a>.
%H A400043 Palomar Registry, <a href="https://palomar-registry.org/entry.html?id=PALOMAR-2026-11-22-000015&amp;version=2">Cube-cutting problem, record PALOMAR-2026-11-22-000015, version 2</a>.
%H A400043 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Cube-CuttingProblem.html">Cube-Cutting Problem</a>.
%H A400043 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (2,0,-2,1).
%F A400043 a(1) = 1, a(2) = 7, and a(n) = floor((9*n^2 + 4*n - 17)/4) for n >= 3.
%F A400043 G.f.: x*(1 + 5*x + 5*x^2 - x^3 - x^5)/((1-x)^3*(1+x)).
%F A400043 a(n) = 2*a(n-1) - 2*a(n-3) + a(n-4) for n >= 7.
%t A400043 Join[{1, 7}, Table[Floor[(9 n^2 + 4 n - 17)/4], {n, 3, 20}]]
%t A400043 Join[{1, 7}, LinearRecurrence[{2, 0, -2, 1}, {19, 35, 57, 82}, 18]]
%K A400043 nonn,easy,new
%O A400043 1,2
%A A400043 _Eric W. Weisstein_, Nov 23 2026
