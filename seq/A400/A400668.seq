%I A400668 #26 Oct 05 2026 11:17:53
%S A400668 0,1,0,2,1,4,2,9,6,21,13,48,32,111,73,257,172,593,396,1370,920,3165,
%T A400668 2124,7309,4915,16880,11350,38982,26227,90019,60568,207874,139894,
%U A400668 480022,323052,1108453,746037,2559596,1722748,5910499,3978190,13648213,9186300,31515693
%N A400668 Number self-conjugate skew Ferrers diagrams with n cells that are edge-connected.
%C A400668 A diagram is 'edge-connected' if the diagram is joined through shared edges, not merely at isolated corner contacts.
%C A400668 Leroux and Rassart (1999) call a(n) the number of d_2-symmetric parallelogram polyominoes of area n. The present sequence is listed under the 'Fix(d_2)' heading in Table 2 in their Appendix.
%H A400668 Peter Luschny, <a href="/A400668/b400668.txt">Table of n, a(n) for n = 0..1000</a>.
%H A400668 M. P. Delest and J. M. Fedou, <a href="https://doi.org/10.1016/0012-365X(93)90224-H">Enumeration of skew Ferrers diagrams</a>, Discrete Mathematics, vol. 112 (1993), no. 1-3, pp. 65-79.
%H A400668 Pierre Leroux and Etienne Rassart, <a href="https://arxiv.org/abs/math/9901135">Enumeration of Symmetry Classes of Parallelogram Polyominoes</a>, arXiv:math/9901135 [math.CO], 1999, Appendix Table 2.
%F A400668 a(n) = [q^n](K(q) / H(q)), where K(q) = Sum_{n>=1}(-1)^(n-1) * ((q^(n*(n+1)-1)) / ((1-q^(4*n-2)) * (q^2; q^2)_{n-1}^2) + (q^(n*(n+3))) / ((1+q^(2*n)) * (q^2; q^2)_{n}^2)), and H(q) = Sum_{n>=0} ((-1)^n * q^(n*(n+1))) / (q^2; q^2)_n^2, where (q; n) is the q-Pochhammer symbol.
%F A400668 a(n) = [q^n] S(q) where S(q) = D_1(1, 1, q) and D_1 as in $3.2.1, equation 20 in Leroux/Rassart.
%e A400668 There are two connected skew Ferrers diagrams with 2 cells, neither one is fixed by conjugation, thus a(2) = 0.
%o A400668 (SageMath)
%o A400668 def A400668_series(prec):
%o A400668     R = PowerSeriesRing(ZZ, 'q', default_prec=prec)
%o A400668     q = R.gen()
%o A400668     num = R(0); den = R(1); rinv = R(1)
%o A400668     n = 1; sign = 1
%o A400668     while True:
%o A400668         e1 = n*(n + 1) - 1
%o A400668         if e1 >= prec: break
%o A400668         term1 = (q^e1 * rinv / (1 - q^(4*n - 2)))
%o A400668         rinv /= (1 - q^(2*n))^2
%o A400668         num += sign * term1
%o A400668         e2 = n*(n + 3)
%o A400668         if e2 < prec:
%o A400668             term2 = (q^e2 * rinv / (1 + q^(2*n)))
%o A400668             num += sign * term2
%o A400668         eH = n*(n + 1)
%o A400668         if eH < prec:
%o A400668             den -= sign * q^eH * rinv
%o A400668         n += 1
%o A400668         sign = -sign
%o A400668     return (num / den).add_bigoh(prec)
%o A400668 prec = 54; ser = A400668_series(prec)
%o A400668 print([ser[n] for n in range(prec)])
%Y A400668 Cf. A006958, A075125, A161492, A400281, A400669 (refinement).
%K A400668 nonn,new
%O A400668 0,4
