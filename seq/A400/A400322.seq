%T A400322 4,7,12,30,120,1,2,3,4,5,10,18,40,165,1,2,3,4,5,8,13,24,55,220,1,2,3,
%U A400322 4,5,6,11,16,30,70,286,1,2,3,4,5,6,9,14,22,40,91,364,1,2,3,4,5,6,7,12,17,28,50,112,455
%N A400322 Square array A(n,k), n >= 0, k >= 1, read by antidiagonals: A(n,k) is the number of nonnegative integer solutions to x + y + kz + kw = n.
%C A400322 This array acts as a master table unifying the counting sequences for anisotropic quantum state degeneracies (Fermi seas) across all integer aspect ratios k.
%C A400322 Physically, A(n,k) represents the number of particles in a degenerate Fermi gas trapped in a three-dimensional cigar-shaped anisotropic harmonic oscillator with aspect ratio k and Fermi energy parameter n (O'Sullivan and Busch, 2008, Eq. 10b).
%D A400322 B. O'Sullivan and T. Busch, Spontaneous emission in ultra-cold spin-polarised anisotropic Fermi seas, Phys. Rev. A 79, 033602 (2009).
%H A400322 Jishnu Babu Ranitha, <a href="/A400322/b400322.txt">Table of n, a(n) for n = 1..10011</a>
%F A400322 A(n,k) = (q + 1) * (q + 2) * (k * q + 3 * r + 3) / 6, where q = floor(n/k) and r = n mod k.
%F A400322 G.f. for column k: G_k(x) = Sum_{n>=0} A(n,k) * x^n = 1 / ((1 - x)^2 * (1 - x^k)^2).
%e A400322 Square array A(n,k) begins:
%e A400322   n\k |  1   2   3   4   5   6   7
%e A400322   ----+---------------------------
%e A400322    0  |  1   1   1   1   1   1   1
%e A400322    1  |  4   2   2   2   2   2   2
%e A400322    2  | 10   5   3   3   3   3   3
%e A400322    3  | 20   8   6   4   4   4   4
%e A400322    4  | 35  14   9   7   5   5   5
%e A400322    5  | 56  20  12  10   8   6   6
%e A400322    6  | 84  30  18  13  11   9   7
%t A400322 A[n_, k_] := With[{q = Floor[n/k], r = Mod[n, k]}, (q + 1) * (q + 2) * (k * q + 3 * r + 3) / 6];
%t A400322 Flatten[Table[A[n - 1, s - n + 1], {s, 1, 13}, {n, 1, s}]]
%o A400322 (Python)
%o A400322 def A(n, k):
%o A400322     q, r = divmod(n, k)
%o A400322     return (q + 1) * (q + 2) * (k * q + 3 * r + 3) // 6
%o A400322 print([A(n, s - n) for s in range(1, 14) for n in range(s)])
