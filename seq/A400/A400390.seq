%e A400390   1, 2, 1, 1, 2, 1
%t A400390 row[n_] := Table[GCD[d, n/d], {d, Divisors[n]}];
%t A400390 Array[row, 26] // Flatten
%o A400390 (PARI) row(n) = apply(x -> gcd(x, n/x), divisors(n));
%Y A400390 Cf. A000005 (row lengths), A000188 (maximum value in row n), A034444 (number of 1's in row n), A046951 (number of distinct values in row n), A055155 (row sums).
