%S A400933 1,2,2,2,4,4,6,3,3,3,8,8,8,9,9,9,9,9,9,10,5,5,5,5,5,14,7,7,7,7,7,7,7,
%T A400933 16,16,16,16,16,16,21,21,21,21,22,11,11,11,11,11,11,11,11,11,11,11,25,
%U A400933 25,25,25,25,25,25,25,25,25,25,25,25,25,25,25,25,25
%N A400933 a(1) = 1, a(2) = 2; for n > 2, a(n) is the smallest number > 1 such that it shares a factor with anywhere from 1 to a(n) previous terms.
%C A400933 Each prime p > 2 appears in p consecutive terms, and is introduced by a term 2*p. The primes form the terms in the lower line of the graph. The missing numbers begin 12, 15, 18, 20, 24, 28, 30, 33, 35, 36, ... .
%H A400933 Scott R. Shannon, <a href="/A400933/b400933.txt">Table of n, a(n) for n = 1..10000</a>
%e A400933 a(8) = 3 as as 3 shares a factor with one previous terms, a(7), and 1 <= 1 <= 3.
%o A400933 (Python)
%o A400933 from math import gcd
%o A400933 from collections import Counter
%o A400933 from itertools import count, islice
%o A400933 def A400933(): # generator of terms
%o A400933     c = Counter([2])
%o A400933     yield from [1, 2]
%o A400933     for n in count(3):
%o A400933         for k in count(2):
%o A400933             v = sum(c[t] for t in c if gcd(t, k)>1)
%o A400933             if 1 <= v <= k:
%o A400933                 an = k
%o A400933                 break
%o A400933         yield an
%o A400933         c[an] += 1
%o A400933 print(list(islice(A400933(), 73))) # _Michael S. Branicky_, Nov 11 2026
