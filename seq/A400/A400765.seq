%e A400765   596: (3,2,2,3)
%e A400765   636: (3,1,1,1,1,3)
%t A400765 stc[n_]:=Differences[Prepend[Join @@ Position[Reverse[IntegerDigits[n,2]],1],0]] // Reverse;
%t A400765 Select[Range[0,100], EvenQ[Length[stc[#]]] && stc[#]==Reverse[stc[#]]&]
