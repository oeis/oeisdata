%N A400576 a(n) = (1/n) * Sum_{k=0..n-1} binomial(n+k-1,k) * binomial(n^2,n-k-1).
%F A400576 a(n) = [x^n] Series_Reversion( x * (1 - x) / (1 + x)^n ).
%F A400576 a(n) ~ sqrt(e) * (e*n)^n / (sqrt(2*Pi) * n^(5/2)).
%t A400576 Table[(1/n) Sum[Binomial[n + k - 1, k] Binomial[n^2, n - k - 1], {k, 0, n - 1}], {n, 1, 18}]
%t A400576 (* Alternative: *)
%t A400576 Table[SeriesCoefficient[InverseSeries[Series[x (1 - x)/(1 + x)^n, {x, 0, n}], x], {x, 0, n}], {n, 1, 18}]
%t A400576 (* Alternative: *)
%t A400576 Table[Binomial[n^2, n-1] * Hypergeometric2F1[1 - n, n, 2 - n + n^2, -1]/n, {n, 1, 18}] (* _Vaclav Kotesovec_, Sep 30 2026 *)
