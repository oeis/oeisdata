%N A400270 G.f. A(x) satisfies A(x) = (1 + x) * A(x^3 * (1 + x)^5), with A(0) = 1.
%F A400270 a(0) = 1; a(n) = Sum_{k=0..floor(n/3)} binomial(5*k+1,n-3*k) * a(k).
%o A400270 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=0, i\3, binomial(5*j+1, i-3*j)*v[j+1])); v;
