%I A400515 #21 Oct 03 2026 22:14:29
%S A400515 0,0,9,243,4725,82035,1359909,22099203,356008725,5713237395,
%T A400515 91532072709,1465357443363,23451638491125,375267689387955,
%U A400515 6004573495911909,96075209798502723,1537217596239347925,24595581225736373715,393529997451784333509,6296484844263184637283
%N A400515 a(n) = (16^n + 3*4^n - 4*7^n)/12.
%C A400515 In the linked Equilateral Completion paper, a(n) is the number of nonlocal equilateral centroid triangles in order-n floretion triangular coordinates, where local triangles are those arising from synchronized digitwise cyclic actions.
%H A400515 Paolo Xausa, <a href="/A400515/b400515.txt">Table of n, a(n) for n = 0..800</a>
%H A400515 Creighton Dement, <a href="https://arxiv.org/abs/2608.15925">Equilateral Completion in Floretion Triangular Coordinates: Locality, Product Points, and Reflection Symmetry</a>, arXiv:2608.15925 [math.CO], 2026. See Corollary 5.9 and Appendix C.
%H A400515 Creighton Dement, <a href="https://www.floretions.com">Online Floretion Calculator</a>; see also the OEIS tab.
%H A400515 Creighton Dement, <a href="https://arxiv.org/abs/2605.20265">Bitwise Triangular Coordinates for Central Products of Quaternion Groups: Floretion Base Vectors, Digitwise S3-Actions, and Centralizer Tiles</a>, arXiv:2605.20265 [math.GM], 2026.
%H A400515 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (27,-204,448).
%F A400515 a(n) = 27*a(n-1)-204*a(n-2)+448*a(n-3), n >= 3, with a(0)=0, a(1)=0, a(2)=9.
%F A400515 G.f.: 9*x^2/((1-16*x)*(1-7*x)*(1-4*x)).
%F A400515 For n >= 1, a(n) = A166984(n-1)-A016150(n-1).
%F A400515 E.g.f.: exp(4*x)*(3 - 4*exp(3*x) + exp(12*x))/12. - _Stefano Spezia_, Sep 28 2026
%e A400515 For n=3, there are 336 equilateral centroid triangles, of which 93 are local, so a(3)=336-93=243. For example, T = {iie,ejj,ekk} is a nonlocal product-centered triangle. It is nonlocal because its first-coordinate digits are i,e,e: they are not all equal, and they are not a permutation of i,j,k. Nevertheless its unsigned product word is p(T)=iei, and its product point and Euclidean center both equal P(iei).
%t A400515 A400515[n_] := (16^n + 3*4^n - 4*7^n)/12; Array[A400515, 25, 0] (* _Paolo Xausa_, Oct 03 2026 *)
%t A400515 (* Alternative: *)
%t A400515 LinearRecurrence[{27, -204, 448}, {0, 0, 9}, 25] (* _Paolo Xausa_, Oct 03 2026 *)
%Y A400515 Cf. A166984, A016150.
%K A400515 nonn,easy,new
%O A400515 0,3
%A A400515 _Creighton Dement_, Sep 28 2026
