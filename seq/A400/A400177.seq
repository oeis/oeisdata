%S A400177 1,1,1,3,1,1,4,5,1,3,1,5,7,1,7,1,3,4,6,9,1,5,1,7,8,9,10,11,1,3,5,1,4,
%T A400177 8,13,1,7,11,13,1,3,5,6,7,9,13,15,1,11,13,1,4,5,10,11,12,13,16,17,1,3,
%U A400177 7,9,1,8,11,16,17,19,1,5,9,15,19,1,3,4,6,7,8,10,12,14,18,21,1,5,7,11
%N A400177 Irregular triangle: row n consists of the numbers x in [1,...,n-1] coprime to n such that (1/x) mod n < (-1/x) mod n.
%C A400177 Row n consists of numbers x coprime to n such that x*y == 1 (mod n) for some y with 1 <= y < n/2.
%C A400177 For each x in [1,...,n-1] coprime to n, exactly one of x and n-x is in row n. In particular, row n has A023022(n) = A000010(n)/2 terms.
%C A400177 Each row starts with 1.
%C A400177 For all terms k of row n of A354940, k mod n is a term in row n of this sequence.
%H A400177 Robert Israel, <a href="/A400177/b400177.txt">Table of n, a(n) for n = 3..10103</a> (rows 3 to 257, flattened)
%e A400177 5 is a term of row 7 because (1/5) mod 7 = 3 < 4 = (-1/5) mod 7.
%e A400177 Triangle starts:
%e A400177   k=3: 1
%e A400177   k=4: 1
%e A400177   k=5: 1, 3
%e A400177   k=6: 1
%e A400177   k=7: 1, 4, 5
%e A400177   k=8: 1, 3
%e A400177   k=9: 1, 5, 7
%e A400177   k=10: 1, 7
%e A400177   k=11: 1, 3, 4, 6, 9
%p A400177 F:= n -> op(select(x -> igcd(x,n)=1 and (1/x) mod n < (-1/x) mod n, [$1..n-1])):
%p A400177 for n from 3 to 20 do F(n) od;
%Y A400177 Cf. A000010, A023022, A354940.
%K A400177 nonn,tabf,new
%O A400177 3,4
%A A400177 _Robert Israel_, Oct 18 2026
