%S A400562 1,1,3,1,9,1,7,17,23,1,17,33,49,1,15,33,47,65,79,97,111,1,33,65,97,
%T A400562 129,161,193,225,1,31,65,95,129,159,193,223,257,287,321,351,385,415,
%U A400562 449,479,1,65,129,193,257,321,385,449,513,577,641,705,769,833,897,961
%N A400562 Irregular triangle read by rows: Row n >= 2 lists numbers 1 <= k <= 2^n such that chi_{2^n,k}(k) = 1, where chi_{N,k} is the Dirichlet character modulo N with label k in the Conrey labeling system.
%C A400562 Note that chi_{2^n,5^u*(-1)^v}(5^a*(-1)^b) = zeta^(u*a)*(-1)^(v*b) for n >= 2, where zeta = exp(2*Pi*I/2^(n-2)). In particular, chi_{2^n,k}(k) is of the form zeta^d, where
%C A400562   d == 1 (mod 8), 4 (mod 32), ..., 2^(n-7) (mod 2^(n-4)) or d == 0, 2^(n-5) (mod 2^(n-3)), n >= 5 odd;
%C A400562   d == 1 (mod 8), 4 (mod 32), ..., 2^(n-6) (mod 2^(n-3)) or d == 0 (mod 2^(n-4)), n >= 4 even.
%C A400562 Let r = floor(n/2) + 1, then row n has length 2^(n-r).
%H A400562 Jianing Song, <a href="/A400562/b400562.txt">Table of n, a(n) for n = 2..16382</a> (rows n = 2..26)
%H A400562 LMFDB, <a href="https://www.lmfdb.org/Character/Dirichlet/Labels">Dirichlet character labels</a>.
%H A400562 Jianing Song, <a href="/A400562/a400562.txt">Table of characters modulo 4, 8, 16, 32, 64</a>.
%F A400562 T(n,k) = 2^r*(k-1) + (-1)^(n*(k-1)) for n >= 2, 1 <= k <= 2^(n-r). In other words, row n consists of numbers congruent to 1 modulo 2^r for even n and numbers congruent to 1 or 2^r-1 modulo 2^(r+1) for odd n.
%e A400562 Table begins
%e A400562   1
%e A400562   1, 3
%e A400562   1, 9
%e A400562   1, 7, 17, 23
%e A400562   1, 17, 33, 49
%e A400562   1, 15, 33, 47, 65, 79, 97, 111
%e A400562   1, 33, 65, 97, 129, 161, 193, 225
%e A400562   1, 31, 65, 95, 129, 159, 193, 223, 257, 287, 321, 351, 385, 415, 449, 479
%e A400562   1, 65, 129, 193, 257, 321, 385, 449, 513, 577, 641, 705, 769, 833, 897, 961
%e A400562 23 is an element in row 5: Since 23 == -5^6 (mod 32), we have chi_{32,23}(23) = -zeta^(6^2) = 1.
%o A400562 (PARI) row(n) = my(G=znstar(2^n, 1)); select(m->chareval(G, m, m)==0, vector(2^(n-1), i, 2*i-1)) \\ the naive method
%o A400562 (PARI) row(n) = my(r=n\2+1); apply(x->2^r*x+(-1)^(n*x), vector(2^(n-r),i,i-1))
%Y A400562 Cf. A400563.
%K A400562 nonn,tabf,easy,new
%O A400562 2,3
