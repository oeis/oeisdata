%I A400307 #6 Sep 28 2026 22:06:50
%S A400307 49,343,1849,11449,57121,63001,79507,85849,94249,196249,310249,332929,
%T A400307 351649,368449,413449,552049,822649,1225043,1697809,1708249,2105401,
%U A400307 2199289,2229049,2380849,2582449,2866249,2968729,3636649,4592449,4870849,5031049,5139289,5555449,5726449,6466849,7327849
%N A400307 Composite numbers k such that A351207(k) = 2.
%C A400307 Composite numbers k such that there are only two ordered pairs of divisors (s,t) of k whose sum is squarefree.
%C A400307 All terms are prime powers p^j, p in A049098 and j >= 2, and the two ordered pairs are (1,1) and (p,p).
%H A400307 Robert Israel, <a href="/A400307/b400307.txt">Table of n, a(n) for n = 1..10000</a>
%e A400307 a(3) = 1849 is a term because 1849 = 43^2 and none of 1+43, 1+43^2, 43+43^2 and 43^2 + 43^2 are squarefree.
%p A400307 N:= 10^7: # for terms <= N
%p A400307 R:= NULL: p:= 2:
%p A400307 do
%p A400307   p:= nextprime(p);
%p A400307   if p^2 > N then break fi;
%p A400307   if NumberTheory:-IsSquareFree(p+1) then next fi;
%p A400307   for i from 2 do
%p A400307     if p^i >= N then  break fi;
%p A400307     if ormap(j -> NumberTheory:-IsSquareFree(p^i+p^j), [$0..i]) then break fi;
%p A400307     R:= R,p^i
%p A400307   od;
%p A400307 od:
%Y A400307 Cf. A049098, A351207.
%K A400307 nonn,new
%O A400307 1,1
%A A400307 _Robert Israel_, Sep 22 2026
