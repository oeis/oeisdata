%I A400039 #8 Nov 27 2026 16:54:27
%S A400039 1,8,16,32,64,128,216,256,432,512,648,864,1024,1296,1728,1944,2048,
%T A400039 2592,3456,3888,4096,5184,5832,6912,7776,8192,10368,11664,13824,15552,
%U A400039 16384,17496,20736,23328,27000,27648,31104,32768,34992,41472,46656,52488,54000,55296
%N A400039 Cubefull numbers with a squarefree kernel that is a product of the smallest primes.
%C A400039 a(1) = 1 by convention, as 1 is the product of an empty set of primes.
%C A400039 Intersection of A036966 and A055932.
%C A400039 Subset of A387901.
%C A400039 Smallest term with k > 0 distinct prime factors is 2*A002110(k)^3.
%H A400039 Michael De Vlieger, <a href="/A400039/b400039.txt">Table of n, a(n) for n = 1..10000</a>
%e A400039 Let s = A055932.
%e A400039 Table of n, a(n) for select n:
%e A400039     n       a(n)
%e A400039   ------------------------------------------------
%e A400039     1         1 = s(1)    = 1
%e A400039     2         8 = s(5)    = 2^3
%e A400039     3        16 = s(7)    = 2^4
%e A400039     4        32 = s(11)   = 2^5
%e A400039     7       216 = s(29)   = 2^3 * 3^3
%e A400039     9       432 = s(39)   = 2^4 * 3^3
%e A400039    11       648 = s(48)   = 2^3 * 3^4
%e A400039    12       864 = s(54)   = 2^5 * 3^3
%e A400039    16      1944 = s(77)   = 2^3 * 3^5
%e A400039    35     27000 = s(219)  = 2^3 * 3^3 * 5^3
%e A400039    48     81000 = s(329)  = 2^3 * 3^4 * 5^3
%e A400039   168   9261000 = s(1623) = 2^3 * 3^3 * 5^3 * 7^3
%t A400039 (* Load function f at Mathematica link at A377854, then: *)
%t A400039 g[x_] := Times @@ Flatten@ MapIndexed[Prime[#2]^#1 &, x]; {1}~Join~Union@ Map[g, Select[Join @@ f[7, 0, 1], AllTrue[#, # > 2 &] &] ]
%Y A400039 Cf. A002110, A007947, A036966, A055932, A387901.
%K A400039 nonn,new
%O A400039 1,2
%A A400039 _Michael De Vlieger_, Nov 23 2026
