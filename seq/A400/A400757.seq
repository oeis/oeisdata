%I A400757 #24 Nov 18 2026 22:25:33
%S A400757 0,0,1,1,2,2,3,4,4,5,7,8,9,11,9,12,15,16,19,22,19,23,26,28,30,34,34,
%T A400757 37,42,44,48,54,50,56,55,59,65,71,70,75,81,84,90,98,91,100,105,111,
%U A400757 113,120,117,126,134,141,139,148,145,155,164,168,177,188,183,196
%N A400757 Number of doubly shaded cells in an n X n grid with inverted axes using Euler's totient function.
%C A400757 Similar to A395245.
%C A400757 The n X n grid is indexed starting from the bottom-left corner.
%C A400757 The axes are inverted: the label at position k (k=1 nearest to the bottom-left) is n-k+1.
%C A400757 Let phi be Euler's totient function and define f(i) = phi(n-i+1) for i = 1..n.
%C A400757 - For every odd index i shade vertically the first f(i) cells of column i.
%C A400757 - For every even index j shade horizontally the first f(j) cells of row j.
%C A400757 a(n) is the number of cells shaded by both rules, i.e., the number of pairs (r,c) with r even, c odd, 1 <= r,c <= n, r <= f(c) and c <= f(r).
%F A400757 a(n) = #{(i,j) : 1 <= i <= n odd, 1 <= j <= n even, j <= phi(n-i+1), i <= phi(n-j+1)}.
%e A400757 For n = 4 the inverted labels are 4,3,2,1.
%e A400757 f(1)=phi(4)=2, f(2)=phi(3)=2, f(3)=phi(2)=1, f(4)=phi(1)=1.
%e A400757 The only doubly shaded cell is (2,1). Thus a(4) = 1.
%e A400757 For n = 5 the inverted labels are 5,4,3,2,1.
%e A400757 f(1)=phi(5)=4, f(2)=phi(4)=2, f(3)=phi(3)=2, f(4)=phi(2)=1, f(5)=phi(1)=1.
%e A400757 The doubly shaded cells are (2,1) and (4,1). Thus a(5) = 2.
%o A400757 (Python)
%o A400757 from math import gcd
%o A400757 def phi(k):
%o A400757     return sum(1 for i in range(1, k+1) if gcd(i, k) == 1)
%o A400757 def a(n):
%o A400757     c = 0
%o A400757     for r in range(2, n+1, 2):
%o A400757         fr = phi(n - r + 1)
%o A400757         for col in range(1, n+1, 2):
%o A400757             if r <= phi(n - col + 1) and col <= fr:
%o A400757                 c += 1
%o A400757     return c
%Y A400757 Cf. A395245, A397145, A397137, A398003.
%K A400757 nonn,new
%O A400757 1,5
