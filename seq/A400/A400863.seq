%S A400863 1,1,3,2,5,5,5,4,9,9,11,10,13,9,11,8,17,17,19,18,19,21,23,20,25,25,27,
%T A400863 18,29,21,21,16,33,33,33,34,37,37,39,36,41,37,43,42,41,45,47,40,47,49,
%U A400863 43,50,53,53,55,36,57,57,59,42,61,41,43,32,65,65,67,66,69
%N A400863 Least degree of a nonzero polynomial P(t) over GF(2) such that x^n - 1 divides P(1 + x + x^3).
%C A400863 Let f be the residue class of 1 + x + x^3 in GF(2)[x]/(x^n - 1). Then a(n) is the dimension over GF(2) of the subalgebra GF(2)[f]. The definition applies also when n is even and the ambient quotient has nilpotent elements.
%C A400863 There is an observation interpretation of r(n) = 2*a(n). Let S be the cyclic shift on GF(2)^n, with sites indexed 0, ..., n - 1, and let I be the identity. Put T(u, v) = (v, u + (I + S + S^3)v). Then r(n) is the rank over GF(2) of the linear map taking the initial state (u, v) to the vector of 2*n readings of the coordinate at site 0 of the second component of T^t(u, v), for t = 0, ..., 2*n - 1. These readings determine all later readings at that site.
%C A400863 There are therefore 2^r(n) = 2^(2*a(n)) possible infinite observation sequences, with exactly 2^(2*n - r(n)) = 2^(2*n - 2*a(n)) initial states producing each one. When n is a power of 2 greater than 1, half the initial information remains undetermined even after arbitrarily long observation.
%C A400863 The sequence has arbitrarily large downward jumps at powers of 2: a(2^k - 1) - a(2^k) = (2^(k-1) + (-1)^k)/3 for k >= 2.
%H A400863 Vicenzo P DeMaar, <a href="/A400863/b400863.txt">Table of n, a(n) for n = 1..128</a>
%F A400863 a(2*n) = 2*a(n) - (1 - (-1)^n)/2, for n >= 1.
%F A400863 a(2^k*m) = 2^(k-1)*(2*a(m) - 1), for odd m >= 1 and k >= 1.
%F A400863 a(2^k) = 2^(k-1), for k >= 1.
%F A400863 a(2^m - 1) = (2^(m+1) + (-1)^m)/3 = A001045(m+1), for m >= 1.
%e A400863 For n=3, f=1+x+x^3 equals x in GF(2)[x]/(x^3-1). Since 1,x,x^2 are linearly independent and x^3=1, its minimal polynomial is t^3+1, of degree 3. Hence a(3)=3.
%o A400863 (Python)
%o A400863 def a(n):
%o A400863     # Polynomial coefficients over GF(2) are encoded as bits.
%o A400863     modulus = (1 << n) | 1
%o A400863     pivots = {}
%o A400863     power = 1
%o A400863     for degree in range(n + 1):
%o A400863         value = power
%o A400863         while value and value.bit_length() in pivots:
%o A400863             value ^= pivots[value.bit_length()]
%o A400863         if value == 0:
%o A400863             return degree
%o A400863         pivots[value.bit_length()] = value
%o A400863         # Multiply by 1+x+x^3, then reduce modulo x^n+1.
%o A400863         power ^= (power << 1) ^ (power << 3)
%o A400863         while power.bit_length() > n:
%o A400863             power ^= modulus << (power.bit_length() - n - 1)
%o A400863 print([a(n) for n in range(1, 70)])
%Y A400863 Cf. A000079, A000225, A001045.
%K A400863 nonn,easy,new
