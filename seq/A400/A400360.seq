%N A400360 Expansion of Product_{k>=1} (1+x^k) * (1+x^(2*k)) / (1-x^(2*k))^3.
%H A400360 Vaclav Kotesovec, <a href="/A400360/b400360.txt">Table of n, a(n) for n = 0..10000</a>
%F A400360 a(n) ~ 3 * exp(Pi*sqrt(3*n/2)) / (32*n^(3/2)).
%t A400360 CoefficientList[Series[1/(QPochhammer[-x]*QPochhammer[x]^2), {x, 0, 60}], x]
%t A400360 (* Alternative: *)
%t A400360 nmax = 60; CoefficientList[Series[Product[(1+x^k)*(1+x^(2*k))/(1-x^(2*k))^3, {k, 1, nmax}], {x, 0, nmax}], x]
