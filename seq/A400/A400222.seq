%I A400222 #6 Sep 23 2026 23:37:45
%S A400222 1,2890,7545043100
%N A400222 a(n) is the least positive integer that can be expressed as the sum of one or more consecutive positive odd squares in exactly n ways.
%F A400222 Sequence grows super-polynomially: log a(n) >> log n log log n. - _Charles R Greathouse IV_, Sep 22 2026
%e A400222 For n = 2: 2890 = 7^2 + 9^2 + ... + 25^2 = 37^2 + 39^2.
%e A400222 For n = 3: 7545043100 = 21^2 + 23^2 + ... + 3563^2 = 2201^2 + 2203^2 + ... + 3823^2 = 4713^2 + 4715^2 + ... + 5311^2.
%o A400222 (PARI) print_list(lim)=my(a=vector(20)); forfactored(K=3,lim\1*3, if(K[1]%3!=0,next); my(m=K[1],k=m/3,c); fordiv(K[2],u, if(4*u^3-u<=m, my(w2=m/u-u^2+1,w); if(w2%3==0, w2/=3; if(issquare(w2,&w) && (w-u)%2==0, c++)))); if(c>0, if(c>#a, a=concat(a,vector(max(c-#a,10)))); if(!a[c], a[c]=k; print("a("c") = "k)))) \\ _Charles R Greathouse IV_, Sep 22 2026
%Y A400222 Cf. A016754, A068314, A234311, A298467.
%K A400222 nonn,bref,hard,more,new
%O A400222 1,2
%A A400222 _Ilya Gutkovskiy_, Sep 21 2026
