%S A400406 0,0,0,0,1,3,7,14,25,41,64,98,150,231,358,558,875,1381,2192,3490,5552,
%T A400406 8787,13783,21370,32715,49485,74150,110560,165035,248383,379552,
%U A400406 592094,945367,1543557,2567345,4325616,7338345,12467199,21118267,35553052,59361900
%N A400406 Number of ways of tiling a strip of length n with squares (length 1) and dominos (length 2) such that the number of dominos used is prime.
%H A400406 Paolo Xausa, <a href="/A400406/b400406.txt">Table of n, a(n) for n = 0..1000</a>
%F A400406 a(n) = Sum_{p prime, 2*p <= n} binomial(n-p, p).
%F A400406 G.f.: A(x) = Sum_{p prime} x^(2*p)/(1-x)^(p+1).
%e A400406 For n=5, we must use 2 dominos. There are three possible locations for the square (beginning of strip, middle of strip, end of strip); therefore, there are three total tilings.
%t A400406 A400406[n_] := Sum[Binomial[n - p, p], {p, Prime[Range[PrimePi[n/2]]]}];
%t A400406 Array[A400406, 50, 0] (* _Paolo Xausa_, Nov 03 2026 *)
%K A400406 nonn,new
%O A400406 0,6
