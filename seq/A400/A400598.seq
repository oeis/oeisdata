%I A400598 #8 Oct 05 2026 23:51:49
%S A400598 1,2,10,11,3,12,30,13,31,32,14,4,5,6,20,21,22,23,24,25,26,50,51,52,53,
%T A400598 27,28,54,55,29
%N A400598 Squares visited by a chess king moving on the square spiral, always moving to an adjacent unvisited square whose number has the smallest digit sum; ties are resolved by choosing the lowest number.
%C A400598 The board is numbered by the standard square spiral, with 1 at the origin, 2 immediately to its right, and 3 above 2. The king starts at square 1. At each step it moves to one of the eight adjacent squares that has not previously been visited.
%C A400598 The sequence is finite. The last term is a(30) = 29.
%e A400598 Starting from a(2) = 2, the available adjacent squares are 3, 4, 9, 10 and 11. Their digit sums are 3, 4, 9, 1 and 2, respectively, so the minimum is attained by 10. Hence a(3) = 10.
%t A400598 Module[{d=DeleteCases[Tuples[{-1,0,1},2],{0,0}],u,f,p={0,0},s={1},a,c},u[{x_,y_}]:=1+Which[y>=Abs[x],4y^2-y-x,-x>=Abs[y],4x^2-x-y,-y>=Abs[x],(4y-3)y+x,True,(4x-3)x+y];f[n_]:=Total[IntegerDigits[n]];While[True,c=Select[{u[#],#}&/@((p+#)&/@d),!MemberQ[s,#[[1]]]&];If[c=={},Break[]];a=First@SortBy[c,{f[#[[1]]]&,#[[1]]&}];p=a[[2]];AppendTo[s,a[[1]]]];s]
%Y A400598 Cf. A007953, A335816, A333713, A335856, A335661, A400599.
%K A400598 nonn,walk,fini,full,new
%O A400598 1,2
%A A400598 _Bartlomiej Pawlik_, Oct 01 2026
