%I A400293 #12 Nov 04 2026 17:12:39
%S A400293 3,13,641,1409,68041,119881,5739901,2317324861
%N A400293 Least prime p such that there are n-1 smaller primes for which the reciprocals 1/p have the same period length in base 10.
%C A400293 The complete n-tuples are listed as rows in A400291.
%C A400293 a(9) <= 27470420267701, since appending this prime to row 8 of A400291 yields a quintuplet of primes with period 1879420. - _M. F. Hasler_, Oct 29 2026
%o A400293 (PARI) apply( {A400293(n)=my(M=Map(),P,s); forprime(p=2,, 10%p||next; mapput(M, P=znorder(Mod(10,p)), if(mapisdefined(M,P,&s), concat(s,p), s=0; [p]));#s<n-1||return(p))}, [1..6])
%Y A400293 Cf. A002329 (periods of reciprocals of integers prime to 10), A084680 (order of 10 modulo n).
%Y A400293 Cf. A400291 (complete n-tuples), A400292 (period lengths).
%K A400293 nonn,more,hard,base,new
%O A400293 1,1
%A A400293 _M. F. Hasler_, Oct 19 2026
%E A400293 a(8) from _Alper Ferudun_, Oct 19 2026
