%I A400580 #14 Oct 29 2026 14:42:42
%S A400580 0,0,1,0,1,2,0,1,0,0,1,1,0,0,0,2,0,1,0,0,1,0,0
%N A400580 Number of connected quintic symmetric graphs on 2n vertices.
%C A400580 Graphs are simple and undirected, and are counted up to isomorphism. Here "symmetric" means vertex- and edge-transitive, equivalently arc-transitive for odd valency.
%C A400580 The counts through n = 23 are obtained from Conder's complete census of connected symmetric graphs on at most 47 vertices.
%H A400580 Marston Conder, <a href="https://www.math.auckland.ac.nz/~conder/symmetricgraphs-orderupto47-byedges.txt">Connected symmetric graphs of order 2 to 47</a>, December 2021.
%H A400580 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/ConnectedGraph.html">Connected Graph</a>.
%H A400580 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/QuinticSymmetricGraph.html">Quintic Symmetric Graph</a>.
%H A400580 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/SymmetricGraph.html">Symmetric Graph</a>.
%F A400580 a(n) = A401568(n) - A401569(n).
%e A400580 a(3) = 1, corresponding to the complete graph K_6.
%t A400580 Module[{lines, c},
%t A400580 	lines = StringTrim /@ Import["https://www.math.auckland.ac.nz/~conder/symmetricgraphs-orderupto47-byedges.txt", "Lines"];
%t A400580 	c = Counts[FromDigits[Last[StringSplit[lines[[# - 1]]]]]/2 & /@ Flatten[Position[lines, "Valency 5"]]];
%t A400580 	c = Lookup[c, Range[23], 0];
%t A400580 	c
%t A400580 ]
%Y A400580 Cf. A401568 (all).
%Y A400580 Cf. A401569 (disconnected).
%K A400580 nonn,more,new
%O A400580 1,6
%A A400580 _Eric W. Weisstein_, Oct 29 2026
