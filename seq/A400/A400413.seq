%S A400413 0,1,0,4,1,2,1,12,4,3,2,9,6,7,2,28,13,8,7,12,7,8,7,28,18,17,8,15,12,
%T A400413 11,10,67,34,21,16,20,17,18,13,32,25,24,23,30,15,16,15,66,50,43,26,31,
%U A400413 28,23,18,39,30,29,28,39,36,37,24,144,75,46,45,38,33,32
%N A400413 a(n) = Sum_{k=1..n} (2^A007814(floor(n/k)) - 1).
%C A400413 a(n) measures the cumulative 2-adic divisibility structure of floor quotients floor(n/k). The sequence exhibits local maxima at powers of 2, since 2^A007814(2^m) = 2^m.
%F A400413 a(n) = Sum_{k=1..n} (2^A007814(floor(n/k)) - 1).
%e A400413 For n = 4: a(4) = (2^A007814(floor(4/1))) - 1) + (2^A007814(floor(4/2))) - 1) + (2^(A007814(floor(4/3))) - 1) + (2^(A007814(floor(4/4))) - 1) = 3 + 1 + 0 + 0 = 4.
%t A400413 a[n_] := Sum[2^IntegerExponent[Floor[n/k], 2] - 1, {k, 1, n}]; Array[a, 70] (* _Amiram Eldar_, Sep 25 2026 *)
%o A400413 (PARI) a(n) = sum(k=1, n, 2^valuation(n\k, 2)-1); \\ _Michel Marcus_, Sep 25 2026
%o A400413 (Python)
%o A400413 def A400413(n):
%o A400413     c, j = -n, 1
%o A400413     while j <= n:
%o A400413         k = n//j
%o A400413         m = n//k
%o A400413         c += (m-j+1)<<(~k & k-1).bit_length()
%o A400413         j = m+1
%o A400413     return c # _Chai Wah Wu_, Oct 02 2026
