%I A400151 #9 Sep 20 2026 12:38:20
%S A400151 1,1,2,2,3,2,6,2,5,5,10,2,15,2,30,15,21,2,30,2,5,15,10,2,105,15,30,30,
%T A400151 21,2,14,2,105,15,10,5,7,2,30,15,105,2,210,2,35,210,10,2,105,15,210,
%U A400151 15,105,2,210,15,21,15,14,2,21,2,42,210,35,5,14,2,35,15,210,2,35,2,210,70,105,5,210,2,105,35,70,2
%N A400151 a(n) = A328571(A003415(n)).
%H A400151 Antti Karttunen, <a href="/A400151/b400151.txt">Table of n, a(n) for n = 0..10000</a>
%H A400151 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400151 a(n) = A007947(A327859(n)) = A083346(A327859(n)).
%o A400151 (PARI)
%o A400151 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400151 A328571(n) = { my(m=1, p=2); while(n, m *= (p^!!(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400151 A400151(n) = A328571(A003415(n));
%Y A400151 Cf. A003415, A007947, A083346, A328571, A327859, A399379 [k such that a(k)|k].
%K A400151 nonn,easy,new
%O A400151 0,3
%A A400151 _Antti Karttunen_, Sep 20 2026
