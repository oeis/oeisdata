%U A400752 76006956397365893604010118916699679056804575045184861296893341126293768156178492144623811454935709493419802624
%N A400752 Number of maps from {0,1}^n to {0,1}^n under permutations of variables in the domain and range.
%C A400752 Two maps F,G: {0,1}^n -> {0,1}^n are equivalent if G = tau o F o sigma^(-1) for some permutations sigma, tau in S_n acting on the coordinates of the domain and range, respectively.
%F A400752 For lambda = (1^m_1, 2^m_2, ...), a partition of n, let z_lambda = Product_{r>=1} r^m_r*m_r!.
%F A400752 Let c_lambda(d) = (1/d)*Sum_{e|d} mu(d/e)*2^(Sum_{r>=1} m_r*gcd(r,e)).
%F A400752 For nu = (1^k_1, 2^k_2, ...), a partition of n, let H_nu(d) = Sum_{s>=1} k_s*gcd(s,d).
%F A400752 a(n) = Sum_{lambda,nu partitions of n} 2^(Sum_{d>=1} c_lambda(d)*H_nu(d))/(z_lambda*z_nu).
%e A400752 For n = 2, let the inputs be ordered as 00,01,10,11. The maps with output lists
%e A400752 (00,00,01,11) and (00,10,00,11) are equivalent: the transposition (1 2)
%e A400752 is applied to the coordinates in both the domain and the range.
%o A400752 (SageMath)
%o A400752 from collections import Counter
%o A400752 def a(n):
%o A400752     P = Partitions(n)
%o A400752     z = lambda l: prod(r**m * factorial(m) for r, m in Counter(l).items())
%o A400752     c = lambda l, d: sum(moebius(d // e) * 2**sum(gcd(r, e) for r in l)
%o A400752                      for e in divisors(d)) // d
%o A400752     return ZZ(sum(QQ(2)**sum(c(l, d) * sum(gcd(s, d) for s in v)
%o A400752               for d in divisors(lcm(l))) / (z(l) * z(v)) for l in P for v in P))
%o A400752 for n in range(7): print(n, a(n)) # _Peter Luschny_, Oct 06 2026
%Y A400752 Cf. A000653 (invertible maps under the same equivalence).
%K A400752 nonn,new
%O A400752 0,2
%A A400752 _Vladeta Jovovic_, Oct 05 2026
