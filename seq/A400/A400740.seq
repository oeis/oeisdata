%I A400740 #10 Oct 06 2026 06:09:19
%S A400740 1,1,4,1244,2975715453360,34063293885010496952697691130064803840,
%T A400740 719889065898882989353200731787408264002949512086135961465186020547858579157709822984389238055829504
%N A400740 Number of invertible self-dual Boolean functions of n variables.
%C A400740 a(n) is the number of equivalence classes of self-dual invertible maps F: {0,1}^n -> {0,1}^n, F(1-x) = 1-F(x), under permutations of the variables in the domain and permutations and complementations of the variables in the range. Self-dual analog of A000725.
%F A400740 For lambda = (1^m_1, 2^m_2, ...), a partition of n, let z_lambda = Product_{r>=1} r^m_r*m_r! and F_lambda(k) = 2^(Sum_{r>=1} m_r*gcd(r,k)).
%F A400740 Let G_lambda(k) = F_lambda(k) if r/gcd(r,k) is even for every r with m_r > 0, and G_lambda(k) = 0 otherwise.
%F A400740 Let q_lambda(d) = (1/(2*d))*Sum_{e|d, e odd} mu(e)*G_lambda(d/e).
%F A400740 Let p_lambda(d) = (1/(2*d))*Sum_{e|d} mu(d/e)*(F_lambda(e) - 2*Sum_{2*j|e} j*q_lambda(j)).
%F A400740 Let Z_lambda = Product_{d>=1} (2*d)^(p_lambda(d)+q_lambda(d))*p_lambda(d)!*q_lambda(d)!.
%F A400740 Then a(n) = Sum_{lambda partition of n} Z_lambda/(2^l(lambda)*z_lambda^2), where l(lambda) is the number of parts of lambda.
%e A400740 For n = 1, the two self-dual invertible maps, F(0) = 0, F(1) = 1 and F(0) = 1, F(1) = 0, are equivalent by complementation of the range, so a(1) = 1.
%o A400740 (SageMath)
%o A400740 from collections import Counter
%o A400740 def term(lam):
%o A400740     m = Counter(lam); D = divisors(lcm(lam))
%o A400740     F = lambda k: 2**sum(c*gcd(r, k) for r, c in m.items())
%o A400740     G = lambda k: F(k) if all(r//gcd(r, k) % 2 == 0 for r in m) else 0
%o A400740     q = {d: sum(moebius(e)*G(d//e) for e in divisors(d) if e % 2) // (2*d) for d in D}
%o A400740     p = {d: sum(moebius(d//e)*(F(e) - 2*sum(j*q[j] for j in D if e % (2*j) == 0))
%o A400740         for e in divisors(d)) // (2*d) for d in D}
%o A400740     Z = prod((2*d)**(p[d]+q[d]) * factorial(p[d]) * factorial(q[d]) for d in D)
%o A400740     z = prod(r**c * factorial(c) for r, c in m.items())
%o A400740     return Z / (2**len(lam) * z**2)
%o A400740 def a(n): return ZZ(sum(term(l) for l in Partitions(n)))
%o A400740 for n in range(1, 11): print([n], a(n))  # _Peter Luschny_, Oct 05 2026
%Y A400740 Cf. A000725 (without the self-duality condition).
%K A400740 nonn,new
%O A400740 1,3
%A A400740 _Vladeta Jovovic_, Oct 05 2026
