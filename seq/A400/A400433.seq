%N A400433 Numbers k of the form rad(k) * lpf(k)^m, m > 1, where rad = A007947 and lpf(k) is the least prime factor of k.
%C A400433 Smallest term with j > 0 distinct prime factors is 2 * A002110(j).
%H A400433 Michael De Vlieger, <a href="/A400433/b400433.txt">Table of n, a(n) for n = 1..10000</a>
%e A400433 Table of n, a(n) for select n:
%e A400433    n   a(n)
%e A400433   -----------------------
%e A400433    1     4 = 2^2
%e A400433    2     8 = 2^3
%e A400433    3     9 = 3^2
%e A400433    4    12 = 2^2 * 3
%e A400433    5    16 = 2^4
%e A400433    6    20 = 2^2 * 5
%e A400433    7    24 = 2^3 * 3
%e A400433   14    45 = 3^2 * 5
%e A400433   19    60 = 2^2 * 3 * 5
%e A400433   26    84 = 2^2 * 3 * 7
%e A400433   35   120 = 2^3 * 3 * 5
%e A400433   99   340 = 2^2 * 5 * 17
%t A400433 Select[Range[200], And[First[#] > 1, Total[Rest[#] - 1] == 0] &@ FactorInteger[#][[;; , -1]] &]
