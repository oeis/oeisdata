%S A400617 1,2,1,1,4,2,1,1,6,3,8,4,2,1,1,8,4,2,1,1,10,5,14,7,16,8,4,2,1,1,12,6,
%T A400617 3,14,7,18,9,20,10,5,16,8,4,2,1,1,14,7,20,10,5,18,9,22,11,24,12,6,3,
%U A400617 16,8,4,2,1,1,16,8,4,2,1,1,18,9,26,13,30,15,32,16,8,4,2,1
%N A400617 Irregular array where the n-th row is the trajectory obtained when starting with t = 1; then if t is odd add 2*n-1; if even divide by 2. Stop when you reach 1.
%C A400617 For n >= 2, 2*n-1 is a prime with primitive root 2 if and only if row n has 3*(n-1) steps back to 1 (length 3*n-2). T(n,2) = 2*n and T(n,3) = n.
%C A400617 Length of each row = A165783(n) + 1.
%H A400617 Paolo Xausa, <a href="/A400617/b400617.txt">Table of n, a(n) for n = 1..12550</a> (rows 1..150 of triangle, flattened).
%e A400617 Array begins:
%e A400617   1, 2, 1;
%e A400617   1, 4, 2, 1;
%e A400617   1, 6, 3, 8, 4, 2, 1;
%e A400617   1, 8, 4, 2, 1;
%e A400617   1, 10, 5, 14, 7, 16, 8, 4, 2, 1;
%e A400617   1, 12, 6, 3, 14, 7, 18, 9, 20, 10, 5, 16, 8, 4, 2, 1;
%e A400617   1, 14, 7, 20, 10, 5, 18, 9, 22, 11, 24, 12, 6, 3, 16, 8, 4, 2, 1;
%e A400617   1, 16, 8, 4, 2, 1;
%e A400617   ...
%t A400617 A400617row[n_] := Join[{1}, NestWhileList[If[OddQ[#], # + 2*n - 1, #/2] &, 2*n, # > 1 &]];
%t A400617 Array[A400617row, 10] (* _Paolo Xausa_, Oct 21 2026 *)
%Y A400617 Cf. A001122, A217948, A051733, A165783.
%K A400617 nonn,easy,tabf,new
%O A400617 1,2
