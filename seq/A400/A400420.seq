%I A400420 #37 Oct 05 2026 23:21:57
%S A400420 2,3,5,7,13,17,23,37,43,47,53,67,73,83,97,103,107,113,137,167,173,197,
%T A400420 223,283,307,313,317,337,347,353,367,373,383,397,443,467,503,523,547,
%U A400420 607,613,617,643,647,653,673,683,743,773,797,823,853,883,907,937,947,953,967,983,997,1013,1097,1103,1223,1283,1307,1367,1373,1523,1607,1613,1823,1907,1997,2017,2053,2083,2113,2137,2347
%N A400420 Every suffix is prime and no two consecutive digits are both zero.
%C A400420 The restriction on consecutive 0's places the sequence strictly between:
%C A400420   - A024785 (no 0's permitted), which is finite with last term a(4260) = 357686312646216567629137 (24 digits);
%C A400420   - A033664 (no restriction on 0's), which is infinite.
%C A400420 Last term is a(431155) = 60905090403035090132930309060601060807092099426096073547 (56 digits).
%C A400420 First differs from A033664 at a(75) = 2017 != 2003 = A033664(75), hence more than the usual number of terms is shown.
%D A400420 I. O. Angell and H. J. Godwin, On Truncatable Primes, Math. Comput. 31 (1977), 265-267.
%H A400420 Robert J. Vanderbei, <a href="/A400420/b400420.txt">Table of n, a(n) for n = 1..10000</a>
%H A400420 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/TruncatablePrime.html">Truncatable Prime</a>.
%H A400420 Wikipedia, <a href="https://en.wikipedia.org/wiki/Truncatable_prime">Truncatable prime</a>.
%e A400420 503 is a term since it does not contain 00 and all its suffixes are prime: 503, (0)3 and 3.
%e A400420 907 is a term since it does not contain 00 and all its suffixes are prime: 907, (0)7 and 7.
%e A400420 9007 is not a term even though 9007, (00)7, (0)7 and 7 are all prime, since it contains 00.
%o A400420 (Python)
%o A400420 from gmpy2 import is_prime
%o A400420 from itertools import islice
%o A400420 def agen():
%o A400420     yield from [2, 3, 5, 7]
%o A400420     primestrs = ["2", "3", "5", "7"]
%o A400420     while len(primestrs) > 0:
%o A400420         cands = set(d+p for p in primestrs for d in "0123456789" if d!="0" or p[0]!="0")
%o A400420         primestrs = [c for c in cands if c[0] == "0" or is_prime(int(c))]
%o A400420         yield from sorted(map(int, (p for p in primestrs if p[0]!="0")))
%o A400420 print(list(islice(agen(), 50))) # _Michael S. Branicky_, Sep 25 2026
%Y A400420 Cf. A024785, A033664, A050987, A400492.
%K A400420 nonn,base,fini,new
%O A400420 1,1
%A A400420 _Robert J. Vanderbei_, Sep 25 2026
%E A400420 Although this has a considerable overlap with two existing sequences, it is included in the OEIS since it is needed to clarify the definition of A400492. - _N. J. A. Sloane_, Oct 05 2026
