%U A400252 2,2,1,1,4,1,1,7,2,2,1,1,8,40,1,1,2,2,1,2,4,1,1,2,2,2,1,2,16,1,1,5,2,1,1,1,4,3
%N A400252 The exponent of the highest power of 2 dividing A380459(n).
%C A400252 Question: Does A006899\{3, 9} give the positions of records in this sequence?
%H A400252 Antti Karttunen, <a href="/A400252/b400252.txt">Table of n, a(n) for n = 1..19683</a>
%H A400252 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400252 a(n) = A007814(A380459(n)).
%o A400252 (PARI)
%o A400252 A007814(n) = valuation(n, 2);
%o A400252 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400252 A349394(n) = { my(p=0, e); if((e=isprimepower(n, &p)), p^(e-1), 0); };
%o A400252 A380459(n) = { my(m=1); fordiv(n, d, m *= A276086(d)^A349394(n/d)); (m); };
%o A400252 A400252(n) = A007814(A380459(n));
%Y A400252 Cf. A006899, A007814, A380459.
%Y A400252 Cf. A165560 [parity, A000035(a(n))], A006519 [even bisection, a(2*n)], A171977 [quadrisection, a(4*n)].
%Y A400252 Cf. also A400253.
%K A400252 nonn,new
%O A400252 1,4
%A A400252 _Antti Karttunen_, Sep 22 2026
