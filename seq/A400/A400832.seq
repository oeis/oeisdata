%I A400832 #8 Oct 09 2026 12:23:45
%S A400832 1,2,2,3,2,4,2,5,6,7,2,8,2,9,10,11,2,12,2,13,14,15,2,16,14,17,18,19,2,
%T A400832 20,2,21,22,23,5,24,2,25,26,27,2,28,2,29,30,31,2,32,22,33,34,35,2,36,
%U A400832 26,37,38,39,2,40,2,41,42,43,44,45,2,46,47,48,2,49,2,50,51,52,44,53,2,54,55,56,2,57,38,58,59,60,2,61,34
%N A400832 Lexicographically earliest infinite sequence such that a(i) = a(j) => A400831(i) = A400831(j), for all i, j >= 1, where A400831(n) = Product_{d|n} A276086(A300251(d)).
%C A400832 Restricted growth sequence transform of A400831.
%C A400832 For all i, j >= 1:
%C A400832   A305800(i) = A305800(j) => a(i) = a(j) => A003415(i) = A003415(j).
%H A400832 Antti Karttunen, <a href="/A400832/b400832.txt">Table of n, a(n) for n = 1..65537</a>
%H A400832 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%o A400832 (PARI)
%o A400832 up_to = 65537;
%o A400832 rgs_transform(invec) = { my(om = Map(), outvec = vector(length(invec)), u=1); for(i=1, length(invec), if(mapisdefined(om,invec[i]), my(pp = mapget(om, invec[i])); outvec[i] = outvec[pp] , mapput(om,invec[i],i); outvec[i] = u; u++ )); outvec; };
%o A400832 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400832 A300251(n) = sumdiv(n,d,moebius(n/d)*A003415(d));
%o A400832 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400832 A400831(n) = { my(m=1); fordiv(n, d, m *= A276086(A300251(d))); (m); };
%o A400832 v400832 = rgs_transform(vector(up_to, n, A400831(n)));
%o A400832 A400832(n) = v400832[n];
%Y A400832 Cf. A003415, A276085, A276086, A300251, A400831.
%Y A400832 Differs from related A400834 first at n=220, where a(220) = 155.
%Y A400832 Cf. also A380460.
%K A400832 nonn,easy,new
%O A400832 1,2
%A A400832 _Antti Karttunen_, Oct 09 2026
