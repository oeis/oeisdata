%U A400259 4,5,8,1,6,1,4,6,6,3,6,1,10,6,4,1,6,5,5,2,8,1,6,4,4,3,5,4,4,1,7,6,8,1,4,1,8,6
%N A400259 Sum of digits when n' [the arithmetic derivative of n] is written in primorial base (A049345).
%H A400259 Antti Karttunen, <a href="/A400259/b400259.txt">Table of n, a(n) for n = 0..10000</a>
%H A400259 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400259 a(n) = A276150(A003415(n)).
%F A400259 a(n) = A001222(A327859(n)).
%F A400259 a(n) = Sum_{i=0..A400262(n)} A400260(n,i).
%F A400259 a(n) >= A400258(n).
%o A400259 (PARI)
%o A400259 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400259 A276150(n) = { my(s=0, p=2, d); while(n, d = (n%p); s += d; n = (n-d)/p; p = nextprime(1+p)); (s); };
%o A400259 A400259(n) = A276150(A003415(n));
%Y A400259 Row sums of array A400260.
%Y A400259 Cf. A001222, A003415, A276150, A327859, A328232 (positions of 1's), A400258, A400262.
%K A400259 nonn,base,easy,new
%O A400259 0,5
%A A400259 _Antti Karttunen_, Sep 22 2026
