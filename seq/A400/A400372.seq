%T A400372 0,0,9,4,0,8,1,0,1,0,0,6,1,0,2,0,0,0,0,0,7,3,0,6,1,0,1,0,0,9,2,0,4,0,
%U A400372 0,0,0,0,3,0,0,0,0,0,0,0,0,9,5,0,10,3,0,3,0,0,15,6,0,12,2,0,2,0,0,9,2
%N A400372 Expansion of Product_{k>=0} (1 + Sum_{j>=0} x^(3^(k+j))).
%F A400372 a(0) = 1; a(3*n) = a(n) + a(n-1) + ... + a(n-3^k) + ... where a(j) = 0 for j < 0, a(3*n+1) = a(n), a(3*n+2) = 0.
%t A400372 nmax = 100; CoefficientList[Series[Product[1 + Sum[x^(3^(k + j)), {j, 0, Floor[Log[3, nmax]] - k}], {k, 0, Log[3, nmax]}], {x, 0, nmax}], x]
%t A400372 (* Alternative: *)
%t A400372 a[0] = 1;
%t A400372 a[n_?Negative] := 0;
%t A400372 a[n_ /; Mod[n, 3] == 0] := a[n] = a[n/3] + Sum[a[n/3 - 3^k], {k, 0, Floor[Log[3, n/3]]}];
%t A400372 a[n_ /; Mod[n, 3] == 1] := a[n] = a[(n - 1)/3];
%t A400372 a[n_ /; Mod[n, 3] == 2] := a[n] = 0;
%t A400372 Table[a[n], {n, 0, 100}]
%Y A400372 Cf. A039966, A086449.
%K A400372 nonn,new
%O A400372 0,4
%A A400372 _Ilya Gutkovskiy_, Sep 24 2026
