%S A400284 0,1,1,0,-1,-3,-4,-6,-6,-6,-4,-1,5,11,20,30,40,50,59,65,67,64,52,34,4,
%T A400284 -36,-90,-152,-230,-314,-410,-507,-609,-701,-788,-849,-890,-888,-845,
%U A400284 -737,-568,-314,22,462,999,1650,2404,3271,4232,5285,6404,7571,8752,9909
%N A400284 a(n) = [q^n] J_1(q), where J_1(q) is the q-series of Flajolet and Sedgewick.
%C A400284 The functions J_0(q) = J_0(q, 1) and J_1(q) = J_1(q, 1) are introduced in [Flajolet-Sedgewick, 2009] as q-Bessel-type functions.
%C A400284 Define x0 as the smallest positive x with J_0(q) = J_1(q). The value 1/sqrt(x0) = A400283 and is the growth constant in the asymptotic development of A400281.
%H A400284 Philippe Flajolet and Robert Sedgewick, <a href="https://algo.inria.fr/flajolet/Publications/books.html">Analytic Combinatorics</a>, 2009; Chapter IX, §IX.6, Eq. (43), page 661.
%H A400284 Stavros Garoufalidis, <a href="https://people.mpim-bonn.mpg.de/stavros/publications/printed/quantum_knot_invariants.pdf">Quantum knot invariants</a>, Research in the Mathematical Sciences, Vol. 5 (2018), p.15.
%H A400284 Stavros Garoufalidis and Don Zagier, <a href="https://doi.org/10.3842/SIGMA.2023.082">Knots and Their Related q-Series</a>, SIGMA 19, 082, (2023), page 4.
%H A400284 Peter Luschny, <a href="/A400284/a400284.png">Illustrating the J_0 and J_1 q-series</a>.
%F A400284 a(n) = [q^n] J_1(q), where J_1(q) = Sum_{n>=1} ((-1)^(n-1)*q^(n*(n+1)/2)) / ((q;q)_(n-1)*(q;q)_n), and (a;q)_n is the q-Pochhammer function.
%F A400284 Alternative formulas for a(n) arise from alternative representations of J_1(q) that can be derived from formulas given by Garoufalidis, for instance from the expansion J_1(q) = (q;q)_{oo} * Sum_{n>=1} ((-1)^(n - 1) * q^(n*(3*n - 1) / 2)) / ((q;q)_{n-1} * (q;q)_n^2).
%t A400284 qpoch[q_, n_Integer?NonNegative] := Product[1 - q^j, {j, 1, n}];
%t A400284 J1[q_, Nmax_Integer : 100] := Sum[(-1)^(n - 1) q^(n (n + 1)/2) / (qpoch[q, n - 1] qpoch[q, n]), {n, 1, Nmax}];
%t A400284 A400284List[N_] := CoefficientList[Series[J1[q, N], {q, 0, N}], q]; A400284List[53]
%t A400284 (* Alternative: *)
%t A400284 J1Alt[q_, Nmax_Integer : 100] := Product[1 - q^j, {j, 1, Nmax}] * Sum[(-1)^(n - 1) q^(n (3 n - 1)/2) / (qpoch[q, n - 1] qpoch[q, n]^2), {n, 1, Nmax} ];
%t A400284 aList[N_] := CoefficientList[Series[J1Alt[q, N], {q, 0, N}], q]; aList[60]
%o A400284 (SageMath)
%o A400284 from sage.combinat.q_analogues import q_pochhammer
%o A400284 def J1(q, Nmax=100):
%o A400284     return sum((-1)^(n - 1) * q^(n * (n + 1) // 2) /
%o A400284         (q_pochhammer(n - 1, q, q) * q_pochhammer(n, q, q))
%o A400284         for n in range(1, Nmax + 1))
%o A400284 def A400284List(N):
%o A400284     R.<q> = PowerSeriesRing(QQ, default_prec=N + 1)
%o A400284     f = J1(q, N)
%o A400284     return [f[k] for k in range(N + 1)]
%o A400284 L = A400284List(53); print(L)
%Y A400284 Cf. A301735 (J_0), A400285 (J0 - J1), A400283, A400281.
%K A400284 sign,new
%O A400284 0,6
