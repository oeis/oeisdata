%U A400744 2580355932463184685394526,21174344370419230021280406494,347237805250664608997605818582766,11383841688998598237774931735485096174
%N A400744 G.f. A(x) satisfies: A(x) = 1 + x * A(2*x/(1 - x)) / (1 - 2*x).
%F A400744 a(0) = a(1) = 1; a(n) = 2 * a(n-1) + Sum_{k=1..n-1} binomial(n-2,k-1) * 2^k * a(k) for n >= 2.
%t A400744 nmax = 16; A[_] = 0; Do[A[x_] = 1 + x A[2 x/(1 - x)]/(1 - 2 x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A400744 (* Alternative: *)
%t A400744 a[0] = a[1] = 1; a[n_] := a[n] = 2 a[n - 1] + Sum[Binomial[n - 2, k - 1] 2^k a[k], {k, 1, n - 1}]; Table[a[n], {n, 0, 16}]
%Y A400744 Cf. A005493, A126443.
%K A400744 nonn,new
