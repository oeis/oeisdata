%N A400721 Greatest prime factor of 3^n - 2^n.
%C A400721 See A398834 for a guide to related sequences.
%F A400721 a(n) = A006530(A001047(n)).
%t A400721 {x, y} = {3, 2}; p[n_] := p[n] = (x^n - y^n)/(x - y);
%t A400721 f[n_] := f[n] = FactorInteger[p[n]];
%t A400721 Map[First, Table[Last[f[n]], {n, 2, 80}]]
%o A400721 (PARI) a(n) = vecmax(factor(3^n-2^n)[,1]); \\ _Michel Marcus_, Nov 04 2026
