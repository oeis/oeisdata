%S A400624 1,0,0,3,3,4,11,19,33,63,115,211,390,715,1315,2422,4452,8187,15062,
%T A400624 27702,50950,93714,172366,317030,583111,1072506,1972646,3628265,
%U A400624 6673417,12274326,22576009,41523753,76374087,140473849,258371689,475219625,874065164,1607656477
%N A400624 Number of dense tilings of a 5 X n rectangle by unit squares and the Ferrers tile (3,1,1).
%C A400624 Dense means that no column in the tiling is empty. The Ferrers tile (3,1,1) has three columns of heights 3, 1, and 1.
%H A400624 John Ahlberg and Per Alexandersson, <a href="https://arxiv.org/abs/2605.03473">Polynomials from tilings of rectangles</a>, arXiv:2605.03473 [math.CO], 2026.
%H A400624 <a href="/index/Rec#order_07">Index entries for linear recurrences with constant coefficients</a>, signature (0,0,3,3,4,2,1).
%F A400624 G.f.: 1/((1 + x^2)*(1 + x + x^2)*(1 - x - x^2 - x^3)).
%F A400624 With a(0)=1 and a(n)=0 for n<0, a(n) = 3*a(n-3) + 3*a(n-4) + 4*a(n-5) + 2*a(n-6) + a(n-7) for n >= 1.
%t A400624 CoefficientList[Series[1/(1 - 3*x^3 - 3*x^4 - 4*x^5 - 2*x^6 - x^7), {x, 0, 37}], x]
%K A400624 nonn,easy,new
%O A400624 0,4
%A A400624 _Per W. Alexandersson_, Oct 31 2026
