%I A400851 #28 Oct 22 2026 20:19:30
%S A400851 1,2,18,92,548,3112,17928,102832,590608,3390752,19469088,111783872,
%T A400851 641826368,3685144192,21158840448,121486803712,697535619328,
%U A400851 4005010514432,22995398251008,132031698148352,758080775103488,4352640081897472,24991368078624768,143491873133473792
%N A400851 a(n) = 4*a(n-1) + 10*a(n-2), with a(0)=1 and a(1)=2.
%C A400851 Lucas-type companion to A180226, halved to remove the common factor 2. The case n = 2 of the Deca-Lucas family in Rajput (2026).
%H A400851 Paolo Xausa, <a href="/A400851/b400851.txt">Table of n, a(n) for n = 0..999</a>
%H A400851 Chetansing Rajput, <a href="https://doi.org/10.51846/jnhm.v2i2.5488">Deca-metallic ratios: a base-10 analogue of metallic means with their geometric origin in primitive Pythagorean triples</a>, J. New Horiz. Math., 2026.
%H A400851 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (4,10).
%F A400851 a(n) = 4*a(n-1) + 10*a(n-2) for n > 1, with a(0)=1 and a(1)=2.
%F A400851 a(n) = ((2+sqrt(14))^n + (2-sqrt(14))^n)/2.
%F A400851 From _Stefano Spezia_, Oct 10 2026: (Start)
%F A400851 G.f.: (1 - 2*x)/(1 - 4*x - 10*x^2).
%F A400851 E.g.f.: exp(2*x)*cosh(sqrt(14)*x). (End)
%t A400851 LinearRecurrence[{4, 10}, {1, 2}, 25] (* _Paolo Xausa_, Oct 22 2026 *)
%o A400851 (Python)
%o A400851 a, b = 1, 2
%o A400851 for n in range(25):
%o A400851     print(a, end=", ")
%o A400851     a, b = b, 4*b + 10*a
%Y A400851 Cf. A180226, A133343, A399405, A399776.
%K A400851 nonn,easy,new
%O A400851 0,2
%A A400851 _Chetansing Rajput_, Oct 07 2026
