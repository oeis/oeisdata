%I A400212 #24 Oct 03 2026 09:55:30
%S A400212 98,998,4504,5494,9998,10890,89108,99998,109890,890108,999998,1099890,
%T A400212 1207801,2198791,2306702,3297692,3405603,4396593,4504504,5495494,
%U A400212 5603405,6594395,6702306,7693296,7801207,8792197,8900108,9891098,9999998,10999890,89000108,98901098,99999998
%N A400212 Numbers k > R(k) such that k - R(k) = floor(k/10) where R(k) is the digit reversal of k.
%C A400212 Consider a digit abcd, its reversal is dcba; abcd - dcba = abc. For all further iterations (that is abc - cba = ab and so on...) k = 98 is the only satisfying term for k <= 10^8.
%C A400212 Numbers k >= 10 such that k - R(k) = floor(k/10). If k > R(k) is not a constraint, then 0,1,..,9 are terms as well. - _Chai Wah Wu_, Sep 30 2026
%e A400212 98 is a term: 98 - 89 = 9.
%e A400212 998 is a term: 998 - 899 = 99.
%e A400212 4504 is a term: 4504 - 4054 = 450.
%e A400212 5494 is a term: 5494 - 4945 = 549.
%e A400212 9998 is a term: 9998 - 8999 = 999.
%t A400212 okQ[k_]:=k>IntegerReverse[k]&&k-IntegerReverse[k]==Floor[k/10];Select[Range[10^6],okQ] (* _James C. McMahon_, Sep 30 2026 *)
%o A400212 (Python)
%o A400212 from itertools import count, islice
%o A400212 def A400212_gen(startvalue=10): # generator of terms >= startvalue
%o A400212     return filter(lambda k: k-int(str(k)[::-1])==k//10, count(max(startvalue,10)))
%o A400212 A400212_list = list(islice(A400212_gen(),30)) # _Chai Wah Wu_, Sep 30 2026
%Y A400212 Cf. A004086, A113602.
