%S A400346 1,1,2,2,4,5,6,8,10,16,15,26,21,42,29,64,39,96,55,148,70,207,96,310,
%T A400346 117,414,159,614,188,794,252,1148,291,1454,387,2060,442,2590,590,3588,
%U A400346 660,4489,867,6048,963,7600,1273,9990,1390,12625,1804,16058,1963,20552,2577,25466,2765,33029,3559,39494,3811
%N A400346 a(0) = 1; a(2*n) = a(2*n-2) + a(n), a(2*n+1) = Sum_{j=0..n} a(j) * a(n-j).
%F A400346 G.f. A(x) satisfies: A(x) = x * A(x^2)^2 + A(x^2) / (1 - x^2).
%F A400346 a(2*n) = Sum_{j=0..n} a(j).
%t A400346 a[0] = 1; a[n_] := a[n] = If[EvenQ[n], a[n - 2] + a[n/2], Sum[a[j] a[(n - 1)/2 - j], {j, 0, (n - 1)/2}]]; Table[a[n], {n, 0, 60}]
%t A400346 (* Alternative: *)
%t A400346 nmax = 60; A[_] = 1; Do[A[x_] = x A[x^2]^2 + A[x^2]/(1 - x^2) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%Y A400346 Cf. A002487, A073711, A086450, A400350.
%K A400346 nonn,new
%O A400346 0,3
