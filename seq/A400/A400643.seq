%S A400643 2,3,4,7,13,35,163,210,284,527
%N A400643 Numbers k such that (k+1)^k-(k+2) is prime.
%C A400643 a(11) > 10^4. - _Michael S. Branicky_, Oct 03 2026
%e A400643 3 is a term since (3+1)^3 - (3+2) = 64 - 5 = 59, prime.
%e A400643 5 is not a term since (5+1)^5 - (5+2) = 7769 = 17*457, composite.
%t A400643 q[k_] := PrimeQ[(k + 1)^k - (k + 2)]; Select[Range[600], q] (* _Amiram Eldar_, Oct 02 2026 *)
