%I A400419 #10 Sep 26 2026 15:44:26
%S A400419 1,1,4,18,170,1570,24872,355082,7519542,150244794,3970627202,
%T A400419 99920609602,3231737799380,98139640241474,3694439384926474,
%U A400419 133194567643097760,5722726932688522562,236389784118231290050,11512475283053847220346,536484538620663729658994,28994342992368172739490372
%N A400419 Number of endofunctions on [n] whose connected components have the same size.
%C A400419 A connected component is understood as a weakly connected component of the functional digraph of the endofunction.
%H A400419 Alois P. Heinz, <a href="/A400419/b400419.txt">Table of n, a(n) for n = 0..386</a>
%F A400419 a(0) = 1. For n >= 1, a(n) = Sum_{d|n} n!*A001865(d)^(n/d)/((n/d)!*(d!)^(n/d)).
%e A400419 For n = 4, if the common component size is 1, 2, or 4, the numbers of endofunctions are 1, 27, and 142, respectively. Hence a(4) = 1 + 27 + 142 = 170.
%p A400419 N:= 30:
%p A400419 C:= series(-log(1+LambertW(-x)), x=0, N+1):
%p A400419 c:= n-> n!*coeff(C, x, n):
%p A400419 a:= proc(n) local d;
%p A400419   if n=0 then return 1 fi;
%p A400419   add(n!*c(d)^(n/d)/((n/d)!*(d!)^(n/d)),
%p A400419       d in numtheory[divisors](n))
%p A400419 end:
%p A400419 seq(a(n), n=0..N);
%Y A400419 Cf. A001865, A209324, A350135.
%K A400419 nonn,new
%O A400419 0,3
%A A400419 _Vladeta Jovovic_, Sep 25 2026
