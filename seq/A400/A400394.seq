%I A400394 #7 Sep 26 2026 09:37:45
%S A400394 1,3,4,9,6,12,8,15,19,18,12,36,14,24,24,43,18,57,20,54,32,36,24,60,51,
%T A400394 42,40,72,30,72,32,63,48,54,48,171,38,60,56,90,42,96,44,108,114,72,48,
%U A400394 172,99,153,72,126,54,120,72,120,80,90,60,216,62,96,152,183,84,144,68,162
%N A400394 a(n) = Sum_{d|n} d * gcud(d, n/d), where gcud is the greatest common unitary divisor.
%H A400394 Amiram Eldar, <a href="/A400394/b400394.txt">Table of n, a(n) for n = 1..10000</a>
%F A400394 Multiplicative with a(p^e) = sigma(p^e) if e is odd, and sigma(p^e) + p^e - p^(e/2) if e is even, where sigma(p^e) = A000203(p^e) = (p^(e+1)-1)/(p-1).
%F A400394 a(n) >= A000203(n), with equality if and only if n is an exponentially odd number (A268335).
%F A400394 Dirichlet g.f.: zeta(s) * zeta(2*s-2) * zeta(2*s-1) * Product_{p prime} (1 + 1/p^(s-1) + 1/p^(2*s-2) - 2/p^(2*s-1) - 2/p^(3*s-2) + 1/p^(3*s-1)).
%F A400394 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = zeta(2) * zeta(3) * Product_{p prime} (1 + 1/p^2 - 3/p^3 + 1/p^4) = 1.98240081427950737115... .
%t A400394 f[p_, e_] := (p^(e+1)-1)/(p-1) + If[OddQ[e], 0, p^e - p^(e/2)];
%t A400394 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n];
%t A400394 Array[a, 100]
%o A400394 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, (f[i,1]^(f[i,2]+1)-1)/(f[i,1]-1) + if(!(f[i,2] % 2), f[i,1]^f[i,2] - f[i,1]^(f[i,2]/2)));}
%Y A400394 Cf. A000203, A077610, A165430, A268335, A337180 (gcd analog), A400391.
%Y A400394 Cf. A002117, A013661, A183699.
%K A400394 nonn,mult,easy,new
%O A400394 1,2
%A A400394 _Amiram Eldar_, Sep 25 2026
