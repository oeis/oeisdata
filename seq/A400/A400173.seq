%S A400173 0,1,1,3,1,3,1,9,5,5,1,9,1,7,6,23,1,12,1,15,8,11,1,23,9,13,22,21,1,14,
%T A400173 1,57,12,17,10,36,1,19,14,41,1,20,1,33,27,23,1,57,13,30,18,39,1,42,14,
%U A400173 59,20,29,1,42,1,31,37,135,16,32,1,51,24,34,1,88,1,37,39,57,16,38,1,103,86,41,1,60,20,43,30,95
%N A400173 Dirichlet convolution of the arithmetic derivative with Liouville's lambda.
%H A400173 Antti Karttunen, <a href="/A400173/b400173.txt">Table of n, a(n) for n = 1..10000</a>
%F A400173 a(n) = Sum_{d|n} A008836(n/d)*A003415(d).
%F A400173 a(n) = Sum_{d|n} A206369(n/d)*A349394(d), thus a(n) >= 0 for all n.
%F A400173 From _Amiram Eldar_, Oct 12 2026: (Start)
%F A400173 a(n) = A206369(n) * b(n) where b(n) is additive with b(p^e) = ((e*p^(e+1) + (e+1)*p^e - (-1)^e)/(p+1)^2) / A206369(p^e).
%F A400173 Dirichlet g.f.: (zeta(s-1) * zeta(2*s) / zeta(s)) * Sum_{p prime} (1/(p^s - p)).
%F A400173 Sum_{k=1..n} a(k) ~ c * n^2, where c = (Pi^2/30) * Sum_{p prime} 1/(p*(p-1)) = A195055 * A136141 / 10 = 0.25435834878618155647... . (End)
%t A400173 f1[p_, e_] := (p^(e+1) + (-1)^e)/(p+1);
%t A400173 f2[p_, e_] := (e*p^(e+1) + (e+1)*p^e - (-1)^e)/(p+1)^2;
%t A400173 a[1] = 0; a[n_] := Module[{fct = FactorInteger[n]}, (Times @@ f1 @@@ fct) * Total[(f2[#1, #2]/f1[#1, #2]) & @@@ fct]]; Array[a, 88] (* _Amiram Eldar_, Oct 12 2026 *)
%o A400173 (PARI)
%o A400173 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400173 A008836(n) = ((-1)^bigomega(n));
%o A400173 A400173(n) = sumdiv(n, d, A008836(n/d)*A003415(d));
%o A400173 (PARI) f1(p, e) = (p^(e+1) + (-1)^e)/(p+1);
%o A400173 f2(p, e) = (e*p^(e+1) + (e+1)*p^e - (-1)^e)/(p+1)^2;
%o A400173 a(n) = {my(f = factor(n), p = f[, 1], e = f[, 2]); prod(i = 1, #p, f1(p[i], e[i])) * sum(i = 1, #f~, f2(p[i], e[i])/f1(p[i], e[i]));} \\ _Amiram Eldar_, Oct 12 2026
%Y A400173 Cf. A003415, A008836, A206369, A400833.
%Y A400173 Cf. also A300251, A347395, A349394.
%Y A400173 Cf. A136141, A195055.
%K A400173 nonn,easy,new
%O A400173 1,4
%A A400173 _Antti Karttunen_, Oct 09 2026
