%I A400756 #35 Oct 07 2026 17:33:19
%S A400756 1,1,1,1,1,0,2,1,1,0,0,2,1,3,1,1,0,0,0,2,0,2,3,3,4,1,1,0,0,0,0,2,0,0,
%T A400756 2,4,0,6,5,6,5,1,1,0,0,0,0,0,2,0,0,0,2,3,2,0,6,7,3,12,9,10,6,1,1,0,0,
%U A400756 0,0,0,0,2,0,0,0,0,2,3,0,2,1,6,4,6,3,15,11,12,21,16,15,7,1
%N A400756 Irregular triangle read by rows. T(n,k) is the number of compositions c of the integer n such that f(c) = k, 0<=k<=binomial(n,2), n>=0, where f(c) is defined in the comments below.
%C A400756 Let c = (x1,x2,x3,...xj) be a composition of n. Then f(c) = x1*(n-x1) + x2*(n-x1-x2) + x3*(n-x1-x2-x3) + ... + xj*0.
%C A400756 Let G be a properly colored simple labeled graph such that the sizes of the color classes correspond to the composition c.  Then f(c) is the maximum possible number of edges in G.
%H A400756 Alois P. Heinz, <a href="/A400756/b400756.txt">Rows n = 0..50, flattened</a>
%F A400756 Sum_{k=0..binomial(n,2)} Sum_{n>=0} T(n,k)*q^k*z^n/q^binomial(n,2) = 1/(2-e(z)) where e(z) = Sum_{n>=0} z^n/q^binomial(n,2).
%F A400756 Sum_{k=0..binomial(n,2)} T(n,k)*2^k = A335343(n).
%F A400756 From _Alois P. Heinz_, Oct 05 2026: (Start)
%F A400756 Sum_{k>=0} k * T(n,k) = A055580(n-2) for n>=2.
%F A400756 Sum_{k>=0} (binomial(n,2) - k) * T(n,k) = A000337(n-1) for n>=1. (End)
%e A400756 Triangle begins:
%e A400756   1;
%e A400756   1;
%e A400756   1, 1;
%e A400756   1, 0, 2, 1;
%e A400756   1, 0, 0, 2, 1, 3, 1;
%e A400756   1, 0, 0, 0, 2, 0, 2, 3, 3, 4, 1;
%e A400756   1, 0, 0, 0, 0, 2, 0, 0, 2, 4, 0, 6, 5, 6, 5, 1;
%e A400756   ...
%e A400756 T(n,0) = 1 because we have the composition with only one part.
%e A400756 T(n,binomial(n,2)) = 1 because we have the composition containing all 1's.
%e A400756 T(6,9) = 4 because we have the compositions {4,1,1}, {1,1,4}, {1,4,1}, {3,3}.
%p A400756 b:= proc(n, s) option remember; `if`(n=0, x^s,
%p A400756       add(b(n-j, s+j*(n-j)), j=1..n))
%p A400756     end:
%p A400756 T:= n-> (p-> seq(coeff(p, x, i), i=0..degree(p)))(b(n, 0)):
%p A400756 seq(T(n), n=0..10);  # _Alois P. Heinz_, Oct 05 2026
%t A400756 nn = 8; B[n_] := q^Binomial[n, 2] ; e[z_] := Sum[z^n/B[n],{n,0,nn}];Map[CoefficientList[#, q] &,Table[B[n], {n, 0, nn}] CoefficientList[Series[1/(1 - (e[z] - 1)), {z, 0, nn}], z]] // Grid
%Y A400756 Cf. A000337, A011782 (row sums), A055580, A069999 (number of positive terms in rows), A161680, A335343.
%K A400756 nonn,tabf,new
%O A400756 0,7
%A A400756 _Geoffrey Critzer_, Oct 05 2026
