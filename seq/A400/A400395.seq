%I A400395 #12 Sep 26 2026 09:04:52
%S A400395 1,4,6,10,10,24,14,32,21,40,22,60,26,56,60,68,34,84,38,100,84,88,46,
%T A400395 192,55,104,108,140,58,240,62,192,132,136,140,210,74,152,156,320,82,
%U A400395 336,86,220,210,184,94,408,105,220,204,260,106,432,220,448,228,232,118,600,122,248
%N A400395 a(n) = Sum_{d|n} n / gcud(d, n/d), where gcud is the greatest common unitary divisor.
%H A400395 Amiram Eldar, <a href="/A400395/b400395.txt">Table of n, a(n) for n = 1..10000</a>
%H A400395 Vaclav Kotesovec, <a href="/A400395/a400395.jpg">Graph - the asymptotic ratio (100000 terms)</a>
%F A400395 Multiplicative with a(p^e) = (e+1) * p^e if e is odd, and e*p^e + p^(e/2) if e is even.
%F A400395 Dirichlet g.f.: zeta(s-1) * zeta(2*s-2) * zeta(2*s-1) * Product_{p prime} (1 + 1/p^(s-1) - 1/p^(2*s-2) + 1/p^(3*s-3) - 2/p^(3*s-2)).
%F A400395 From _Vaclav Kotesovec_, Sep 25 2026: (Start)
%F A400395 Let f(s) = Product_{p prime} (1 - (p-1)*p*(p^s-p) / ((p^s+p)*(p^(2*s)-p))).
%F A400395 Dirichlet g.f.: zeta(s-1)^2 * f(s).
%F A400395 Sum_{k=1..n} a(k) ~ ((2*log(n) + 4*gamma - 1)*f(2) + 2*f'(2)) * n^2/4, where
%F A400395 f(2) = Product_{p prime} (1 - (p-1)/((p+1)*(p^2+p+1))) = 0.8617168145323172411807679374265263773404591911016379278641835402587420761679...,
%F A400395 f'(2) = f(2) * Sum_{p prime} 2*p*(p^3-p-1) * log(p) / ((p+1)*(p^2+p+1)*(p^3+2*p^2+p+2)) = 0.34542412028839341050247564511793279867145632619351166008192272080502328385...
%F A400395  and gamma is the Euler-Mascheroni constant A001620. (End)
%t A400395 f[p_, e_] := e * p^e + If[OddQ[e], p^e, p^(e/2)];
%t A400395 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n];
%t A400395 Array[a, 100]
%o A400395 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, f[i,2] * f[i,1]^f[i,2] + f[i,1]^if(f[i,2] % 2, f[i,2], f[i,2]/2));}
%Y A400395 Cf. A057670 (gcd analog), A077610, A165430, A400391.
%K A400395 nonn,mult,easy,new
%O A400395 1,2
%A A400395 _Amiram Eldar_, Sep 25 2026
