%S A400370 1,0,-1,-1,-2,-1,-3,-4,-7,-3,4,1,-3,-2,-5,-7,-2,-9,-11,-20,-31,-11,20,
%T A400370 31,51,20,-31,-11,-42,-31,-73,-42,-115,-73,-188,-261,-449,-710,-261,
%U A400370 449,188,637,449,1086,1535,2621,4156,1535,5691,7226,12917,20143,33060
%N A400370 Deterministic version of the random Fibonacci sequence, with signs from A030190 and the seed as (1,0).
%C A400370 Viswanath's random Fibonacci sequence flips a fair coin for each sign. Reading the signs off one fixed word instead gives a single integer sequence, and A030190 is normal in base 2, so every finite sign pattern still occurs with the frequency a coin would give it. Digit A030190(n-2) drives step n, with "1" adding and "0" subtracting.
%H A400370 Jwalin Bhatt, <a href="/A400370/b400370.txt">Table of n, a(n) for n = 0..10000</a>
%H A400370 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/RandomFibonacciSequence.html">Random Fibonacci Sequence</a>
%H A400370 Wikipedia, <a href="https://en.wikipedia.org/wiki/Random_Fibonacci_sequence">Random Fibonacci sequence</a>
%F A400370 For n>=2: a(n) = a(n-1) + a(n-2) if A030190(n-2) = 1, otherwise a(n-1) - a(n-2).
%F A400370 Conjecture: lim_{n->oo} |a(n)|^(1/n) = 1.1319882487943... (A078416), Viswanath's constant.
%e A400370 A030190 begins 0, 1, 1, 0, 1, 1, 1, 0, 0, 1, 0, ..., so the signs applied at steps n = 2, 3, 4, ... are -, +, +, -, +, +, +, -, -, +, ...
%e A400370 a(2) = a(1) - a(0) = 0 - 1 = -1, since A030190(0) = 0.
%e A400370 a(3) = a(2) + a(1) = -1 + 0 = -1, since A030190(1) = 1.
%e A400370 a(4) = a(3) + a(2) = -1 - 1 = -2, since A030190(2) = 1.
%e A400370 a(5) = a(4) - a(3) = -2 + 1 = -1, since A030190(3) = 0.
%t A400370 Module[{c = First[RealDigits[ChampernowneNumber[2], 2, 50, 0]], a}, a[n_] := a[n] = If[n <= 1, 1-n, a[n-1] + (2*Sign[c[[n-1]]] - 1)*a[n-2]]; Array[a, Length[c] + 2, 0]]
%o A400370 (Python)
%o A400370 from itertools import count, islice
%o A400370 def A030190():  return (int(d) for m in count(0) for d in bin(m)[2:])
%o A400370 def A400370(n_terms):
%o A400370     a, d = [1, 0], list(islice(A030190(), n_terms))
%o A400370     for n in range(2, n_terms):
%o A400370         a.append(a[n-1] + a[n-2] if d[n-2] else a[n-1] - a[n-2])
%o A400370     return a
%o A400370 print(A400370(53))
%Y A400370 Cf. A000045, A030190, A078416, A399952.
%K A400370 sign,new
