%N A400642 a(0) = 1; a(n) = Sum_{k=1..n} (-1)^(k+1) * binomial(4*n-3*k,k) * 2^(k*(n-k)) * a(n-k).
%F A400642 1 = Sum_{n>=0} a(n) * x^n / (1 + 2^n * x)^(4*n+1).
%F A400642 From _Vaclav Kotesovec_, Oct 03 2026: (Start)
%F A400642 a(n) ~ c * d^n * n^(n + f) * 2^(n^2/2), where
%F A400642 d = 0.6992374113064293382087942460197748...
%F A400642 f = 0.2282002924655290506219141526250532...
%F A400642 c = 1.0155660639562794412810729869795411... (End)
%t A400642 a[0] = 1; a[n_] := a[n] = Sum[(-1)^(k + 1) Binomial[4 n - 3 k, k] 2^(k (n - k)) a[n - k], {k, 1, n}]; Table[a[n], {n, 0, 14}]
