%S A400886 -3,-1,-2,1,-1,-7,3,1,-3,-3,5,5,1,-1,-3,7,4,1,1,-2,-4,9,11,9,9,0,-1,
%T A400886 -15,11,7,13,7,6,1,-7,-13,13,17,17,19,1,13,1,-2,-9,15,10,21,6,18,10,9,
%U A400886 5,-8,-6,17,23,5,29,12,9,1,1,1,-1,-14
%N A400886 Table read by descending antidiagonals: T(n, k) = (k*n-sigma(n))/gcd(tau(n)-k, k*n-sigma(n)), n>=2, k>=0.
%C A400886 Along with A400885, this gives the 2 solutions for u and v, k*(u*n+v) = Sum_{d|n} (u*n+v), where u and v are coprime and not both 0. First solution is u = A400885(n, k), v = T(n, k), second solution is u = -A400885(n, k), v = -T(n, k).
%H A400886 Žiga Pirc, <a href="/A400886/b400886.txt">First 200 antidiagonals</a>
%F A400886 abs(T(n, 0)) = A057020(n).
%F A400886 T(n, 2) = A398982(n).
%e A400886 Array begins:
%e A400886    -3, -1, 1,  3,  5,  7,  9, 11, 13, 15 ...
%e A400886    -2, -1, 1,  5,  4, 11,  7, 17, 10, 23 ...
%e A400886    -7, -3, 1,  1,  9, 13, 17, 21,  5, 29 ...
%e A400886    -3, -1, 1,  9,  7, 19,  6, 29, 17, 39 ...
%e A400886    -3, -2, 0,  6,  1, 18, 12, 10,  9, 42 ...
%e A400886    -4, -1, 1, 13, 10,  9, 17, 41,  8, 55 ...
%e A400886   -15, -7, 1,  9,  1, 25, 33, 41, 49, 57 ...
%e A400886   -13, -2, 5,  1, 23, 16, 41, 25, 59, 34 ...
%e A400886    -9, -8, 1, 12,  1, 32, 21, 52, 31, 72 ...
%e A400886    -6, -1, 1, 21, 16, 43, 27, 13, 38, 87 ...
%e A400886   ...
%e A400886 T(6, 5) = 18, since 5*(-1*6+18) = 60 = (-1+18) + (-2+18) + (-3+18) + (-6+18).
%t A400886 T[n_, k_]:=(k*n-DivisorSigma[1,n])/GCD[DivisorSigma[0,n]-k, k*n-DivisorSigma[1,n]]; Table[Reverse[Table[T[n-k,k],{k,0,n-2}]],{n,2,12}]//Flatten (* _Stefano Spezia_, Oct 11 2026 *)
%o A400886 (PARI) T(n, k) = (k*n-sigma(n))/gcd(numdiv(n)-k, k*n-sigma(n));
%Y A400886 Cf. A000005, A000203, A400885, A057020, A398982.
