%S A400957 437,551,1037,1159,1273,1349,1403,1541,1769,1943,2329,2363,2419,3071,
%T A400957 3713,5111,7313,8357,8479,9017,11357,11983,16117,16343,19043,19879,
%U A400957 21797,26657,27343,29279,33611,36917,38989,40687,44689,50429,51923,52043,54871,61337,71087,75499,77113
%N A400957 Pillai composite numbers: composite numbers c such that there exists an integer m with m! + 1 == 0 (mod c) and c != 1 (mod m).
%C A400957 They are composite numbers which meet the congruency requirements for being a Pillai prime, A063980.
%C A400957 Subsequence of A256519, its defining condition omits c != 1 (mod m).
%C A400957 To be a Pillai composite number, at least one of its factors must be a Pillai prime.
%H A400957 Robert G. Wilson v, <a href="/A400957/b400957.txt">Table of n, a(n) for n = 1..697</a>
%t A400957 fQ = Compile[{{n, _Integer}}, Block[{r = 1, m = 2}, While[r = Mod[r*m, n]; m < n && r + 1 != n || Mod[n, m] == 1, m++]; m != n]]; Select[ Range[2, 50000], ! PrimeQ[#] && fQ[#] &]
%Y A400957 Cf. A002808, A063980, A256519.
%K A400957 nonn,new
%O A400957 1,1
%A A400957 _Robert G. Wilson v_, Oct 10 2026
