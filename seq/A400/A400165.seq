%N A400165 The largest prime dividing A380459(n), with a(1) = 1 by convention.
%H A400165 Antti Karttunen, <a href="/A400165/b400165.txt">Table of n, a(n) for n = 1..10000</a>
%H A400165 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400165 a(n) = Max_{d|n, d is a prime power (in A246655)} A000040(A235224(n/d)).
%F A400165 a(n) = A006530(A380459(n)).
%F A400165 For n > 1, a(n) = A000040(A400164(n)).
%o A400165 (PARI)
%o A400165 A235224(n) = { my(s=0, p=2); while(n, s++; n = n\p; p = nextprime(1+p)); (s); };
%o A400165 A400165(n) = { my(m=1); fordiv(n, d, if(isprimepower(d), m = max(m,prime(A235224(n/d))))); (m); };
%Y A400165 Cf. A000040, A006530, A235224, A246655, A380459, A400164.
%K A400165 nonn,easy,new
%O A400165 1,2
%A A400165 _Antti Karttunen_, Sep 22 2026
