%I A400100 #13 Nov 26 2026 17:50:55
%S A400100 1,2,3,4,5,6,8,9,10,11,12,13,15,16,17,18,19,20,22,23,24,25,26,27,30,
%T A400100 31,32,33,34,36,37,38,39,40,41,43,44,45,46,47,48,50,51,52,53,54,55,57,
%U A400100 60,61,62,64,65,66,67,68,69,72,73,74,75,76,78,79,80,81,82,83
%N A400100 Numbers k such that the trajectory of k->ord(7,k) reaches 1 before reaching a number not coprime to 7. Here ord(b,k) is the multiplicative order of b modulo k.
%C A400100 Closed under multiplication.
%C A400100 Also numbers k such that the trajectory of k->ord(-7,k) reaches 1 before reaching a number not coprime to -7. See A400096 for general discussions.
%H A400100 Jianing Song, <a href="/A400100/b400100.txt">Table of n, a(n) for n = 1..10000</a>
%e A400100 Powers of 2 are terms: 2^n -> 2^(n-3) -> 2^(n-6) -> ... -> 16 or 8 or 4 -> 2 -> 1;
%e A400100 Powers of 3 are terms: 3^n -> 3^(n-1) -> ... -> 3 -> 1;
%e A400100 11 is a term: 11 -> 10 -> 4 -> 2 -> 1.
%t A400100 (* okQ is defined at A400096 *)
%t A400100 Select[Range[100], okQ[#, 7] &] (* _Paolo Xausa_, Nov 26 2026 *)
%o A400100 (PARI) isok(n, 7) \\ see A400096 for isok
%Y A400100 See A400096 for list of sequences in other bases.
%K A400100 nonn,new
%O A400100 1,2
%A A400100 _Jianing Song_, Nov 24 2026
