%S A400258 0,0,1,1,1,1,2,1,1,1,2,1,2,1,3,2,2,1,3,1,1,2,2,1,3,2,3,3,2,1,2,1,3,2,
%T A400258 2,1,1,1,3,2,3,1,4,1,2,4,2,1,3,2,4,2,3,1,4,2,2,2,2,1,2,1,3,4,2,1,2,1,
%U A400258 2,2,4,1,2,1,4,3,3,1,4,1,3,2,3,1,2,2,4,2,3,1,3,2,2,2,3,1,3,1,4,4,3,1,2,1,3,4
%N A400258 Number of nonzero digits in primorial base representation of n' [where n' stands for the arithmetic derivative of n, A003415].
%H A400258 Antti Karttunen, <a href="/A400258/b400258.txt">Table of n, a(n) for n = 0..10000</a>
%H A400258 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400258 a(n) = A267263(A003415(n)).
%F A400258 a(n) = A001221(A327859(n)).
%F A400258 a(n) <= A400259(n).
%o A400258 (PARI)
%o A400258 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400258 A267263(n) = { my(s=0, p=2, d); while(n, d = (n%p); s += !!d; n = (n-d)/p; p = nextprime(1+p)); (s); };
%o A400258 A400258(n) = A267263(A003415(n));
%Y A400258 Number of nonzero terms on row n of array A400260.
%Y A400258 Cf. A001221, A003415, A267263, A327859, A328232 (positions of 1's), A400259, A400262.
%K A400258 nonn,base,easy,new
%O A400258 0,7
%A A400258 _Antti Karttunen_, Sep 22 2026
