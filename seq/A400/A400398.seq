%I A400398 #12 Sep 26 2026 09:05:46
%S A400398 1,2,2,3,2,4,2,6,3,4,2,6,2,4,4,7,2,6,2,6,4,4,2,12,3,4,8,6,2,8,2,14,4,
%T A400398 4,4,9,2,4,4,12,2,8,2,6,6,4,2,14,3,6,4,6,2,16,4,12,4,4,2,12,2,4,6,15,
%U A400398 4,8,2,6,4,8,2,18,2,4,6,6,4,8,2,14,9,4,2,12,4,4,4,12,2,12
%N A400398 a(n) = Sum_{d|n} gcd(d, n/d) / gcud(d, n/d), where gcud is the greatest common unitary divisor.
%H A400398 Amiram Eldar, <a href="/A400398/b400398.txt">Table of n, a(n) for n = 1..10000</a>
%H A400398 Vaclav Kotesovec, <a href="/A400398/a400398.jpg">Graph - the asymptotic ratio (1000000 terms)</a>
%F A400398 Multiplicative with a(p^e) = 2*(p^((e+1)/2)-1)/(p-1) if e is odd, and 2*(p^(e/2)-1)/(p-1) + 1 if e is even.
%F A400398 Dirichlet g.f.: zeta(2*s-1) * zeta(2*s) * Product_{p prime} (1 + 2/p^s - 1/p^(2*s-1) + 2/p^(2*s)).
%F A400398 From _Vaclav Kotesovec_, Sep 25 2026: (Start)
%F A400398 Let f(s) = Product_{p prime} (1 + 2*(p-1) / ((p^s+1)*(p^(2*s)-p))).
%F A400398 Dirichlet g.f.: zeta(s)^2 * f(s).
%F A400398 Sum_{k=1..n} a(k) ~ f(1) * n * (log(n) + 2*gamma - 1 + f'(1)/f(1)), where
%F A400398 f(1) = Product_{p prime} (1 + 2/(p*(p+1))) = 1.820876398793974385716080924374392337255385963894642089460039346897811147308...,
%F A400398 f'(1) = f(1) * Sum_{p prime} -2*p*(3*p+1) * log(p) / ((p-1)*(p+1)*(p^2+p+2)) = f(1) * (-2.4897965248311654321648970312059455721706717785398040241174808659203379622...)
%F A400398 and gamma is the Euler-Mascheroni constant A001620. (End)
%t A400398 f[p_, e_] := If[OddQ[e], 2*(p^((e+1)/2) - 1)/(p-1), 2*(p^(e/2) - 1)/(p-1) + 1];
%t A400398 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n];
%t A400398 Array[a, 100]
%o A400398 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, if(f[i,2] % 2, 2*(f[i,1]^((f[i,2]+1)/2) - 1)/(f[i,1]-1), 2*(f[i,1]^(f[i,2]/2) - 1)/(f[i,1]-1) + 1));}
%o A400398 (PARI) for(n=1, 100, print1(direuler(p=2, n, (1 - p*X^2 + 2*X^2 + 2*X) / ((1 - p*X^2)*(1 - X^2)))[n], ", ")) \\ _Vaclav Kotesovec_, Sep 25 2026
%Y A400398 Cf. A077610, A165430, A400390, A400391.
%K A400398 nonn,mult,easy,new
%O A400398 1,2
%A A400398 _Amiram Eldar_, Sep 25 2026
