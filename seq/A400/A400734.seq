%I A400734 #7 Oct 05 2026 15:34:01
%S A400734 1,7,10,13,55,73,82,85,87,127,136,142,160,202,214,238,280,301,313,317,
%T A400734 322,334,343,346,352,357,373,376,382,398,406,415,433,442,469,487,519,
%U A400734 535,544,573,586,589,598,601,607,613,614,682,685,694,697,709,727,736,742
%N A400734 Numbers k such that 4*(2*k+1)^2 is both preceded and followed by runs of 7 consecutive exponentially odd numbers (A268335).
%C A400734 Squares are numbers whose prime factorization contains only even exponents, while exponentially odd numbers are numbers whose prime factorization contains only odd exponents.
%C A400734 Numbers k such that 4*(2*k+1)^2 is a term in A400733. All the squares in A400733 are of the form 4*(2*k+1)^2, i.e., their square root is congruent to 2 (mod 4).
%C A400734 The numbers of terms that do not exceed 10^k, for k = 1, 2, ..., are 3, 9, 75, 816, 8080, 80619, 806842, 8069650, 80695223, ... . It appears that the asymptotic density of this sequence exists and equals 0.08069... .
%H A400734 Amiram Eldar, <a href="/A400734/b400734.txt">Table of n, a(n) for n = 1..10000</a>
%e A400734 1 is a term since 4*(2*1+1)^2 = 36 is a term in A400733.
%t A400734 expOddQ[n_] := AllTrue[FactorInteger[n][[;; , 2]], OddQ];
%t A400734 q[n_] := AllTrue[n + DeleteCases[Range[-7, 7], 0], expOddQ]; Select[Range[750], q[4*(2*# + 1)^2] &]
%o A400734 (PARI) isexpodd(n) = {my(f = factor(n)); for(i=1, #f~, if (!(f[i, 2] % 2), return (0))); 1;}
%o A400734 isok(k) = {my(m = 4*(2*k+1)^2); for(i = -7, 7, if(i != 0 && !isexpodd(m + i), return(0))); 1;}
%Y A400734 Cf. A268335, A400733.
%K A400734 nonn,easy,new
%O A400734 1,2
%A A400734 _Amiram Eldar_, Oct 05 2026
