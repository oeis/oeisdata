%I A400286 #14 Oct 21 2026 18:13:37
%S A400286 1,1,1,2,1,2,1,2,2,1,1,3,1,2,2,3,1,3,1,2,1,1,1,3,2,2,2,3,1,2,1,3,1,1,
%T A400286 2,4,1,2,2,3,1,2,1,2,3,1,1,4,2,2,2,2,1,3,1,3,1,1,1,4,1,2,2,4,2,2,1,2,
%U A400286 1,2,1,5,1,2,3,3,2,3,1,4,3,1,1,3,1,2,2,3
%N A400286 a(n) is the maximum cardinality of an antichain in {sigma(d) : d divides n}, ordered by divisibility.
%C A400286 For fixed positive exponents e_1, ..., e_r, the maximum of a(p_1^e_1*...*p_r^e_r) over distinct primes p_1, ..., p_r equals the largest number of tuples (k_1, ..., k_r), with 1 <= k_i <= e_i + 1, that can be chosen so that, for any two distinct chosen tuples, neither divides the other coordinatewise. Here, one tuple divides another if each coordinate divides the corresponding coordinate. This maximum is attained infinitely often.
%C A400286 For each r >= 1, every integer from 1 to binomial(r, floor(r/2)) occurs as a(n) for infinitely many squarefree n with omega(n) = r.
%C A400286 Every positive integer occurs as a value of the sequence.
%C A400286 If a(n) = 1, then n is squarefree.
%H A400286 Felix Huber, <a href="/A400286/b400286.txt">Table of n, a(n) for n = 1..10000</a>
%H A400286 Felix Huber, <a href="https://arxiv.org/abs/2610.02264">Antichains among Divisor Sums of Divisors</a>, arXiv:2610.02264 [math.CO], 2026.
%F A400286 If m divides n, then a(m) <= a(n).
%F A400286 a(p^e) = ceil((e + 1)/2) for prime p and e >= 0.
%F A400286 For primes p < q, a(p*q) = 1 if p + 1 divides q + 1, and a(p*q) = 2 otherwise.
%F A400286 If n is squarefree with omega(n) = r, then 1 <= a(n) <= binomial(r, floor(r/2)).
%e A400286 For n = 6, the distinct values sigma(d) for divisors d of 6 are {1, 3, 4, 12}. The set {3, 4} is a largest antichain under divisibility, so a(6) = 2.
%e A400286 For n = 10, the distinct values are {1, 3, 6, 18}, which form a divisibility chain, so a(10) = 1.
%e A400286 For n = 12, the distinct values are {1, 3, 4, 7, 12, 28}. The set {3, 4, 7} is a largest antichain under divisibility, so a(12) = 3.
%p A400286 s := proc(n)
%p A400286     option remember;
%p A400286     NumberTheory:-sigma(n)
%p A400286 end proc:
%p A400286 A400286 := proc(n)
%p A400286     local a, d, e, g, i, j, m, v;
%p A400286     d := NumberTheory:-Divisors(n);
%p A400286     v := sort([op({seq(s(i), i in d)})]);
%p A400286     m := nops(v);
%p A400286     e := {seq(seq(`if`(irem(v[j], v[i]) = 0, {i, m + j}, NULL), j = i + 1 .. m), i = 1 .. m - 1)};
%p A400286     if e = {} then
%p A400286         a := m
%p A400286     else
%p A400286         g := GraphTheory:-Graph(e);
%p A400286         a := m - GraphTheory:-BipartiteMatching(g, 'output = size')
%p A400286     end if;
%p A400286     a
%p A400286 end proc:
%p A400286 seq(A400286(n), n = 1 .. 88);
%Y A400286 Cf. A000203, A005117, A096825, A096826, A173439, A184395, A206028, A206030, A285573.
%K A400286 nonn,new
