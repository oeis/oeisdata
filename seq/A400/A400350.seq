%S A400350 1,1,2,2,5,4,8,6,18,11,26,15,48,23,64,29,121,47,154,58,266,84,322,99,
%T A400350 566,147,656,170,1098,234,1220,263,2120,384,2270,431,3831,585,3954,
%U A400350 643,6928,909,6882,993,11839,1315,11346,1414,20422,1980,18844,2127,33523,2783,29884,2953,55676,4051,47716,4285,88247
%N A400350 a(0) = a(1) = 1; a(2*n) = Sum_{j=0..n} a(j) * a(n-j), a(2*n+1) = a(2*n-1) + a(n).
%F A400350 G.f. A(x) satisfies: A(x) = A(x^2)^2 + x * A(x^2) / (1 - x^2).
%F A400350 a(2*n+1) = Sum_{j=0..n} a(j).
%t A400350 a[0] = a[1] = 1; a[n_] := a[n] = If[EvenQ[n], Sum[a[j] a[n/2 - j], {j, 0, n/2}], a[n - 2] + a[(n - 1)/2]]; Table[a[n], {n, 0, 60}]
%t A400350 (* Alternative: *)
%t A400350 nmax = 60; A[_] = 1; Do[A[x_] = A[x^2]^2 + x A[x^2]/(1 - x^2) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%Y A400350 Cf. A002487, A073711, A086450, A400346.
