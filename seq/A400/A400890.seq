%S A400890 0,2,4,8,10,12,16,18,20,24,28,32,34,36,40,42,44,48,50,52,56,60,64,66,
%T A400890 68,72,74,76,80,82,84,88,92,96,98,100,104,108,112,114,116,120,124,128,
%U A400890 130,132,136,138,140,144,146,148,152,156,160,162,164,168,170,172,176
%N A400890 Numbers k such that the 2-adic valuation of 3*k+2 is odd.
%C A400890 All terms are even.
%C A400890 This is used in A400893 for a bipartition of the positive odd numbers A005408 based on the present odd valued v2(3*k+2) = A007814(3*k+2) numbers.
%F A400890 v2(3*k + 2) = A007814(3*k + 2) is odd iff k = a(n) for n >= 0.
%e A400890 8 is a term because A007814(26) = 1 is odd (26/2^1 = 13).
%p A400890 q:= k-> is(irem(padic[ordp](3*k+2,2),2)=1):
%p A400890 select(q, [$0..200])[];  # _Alois P. Heinz_, Oct 08 2026
%t A400890 q[k_] := OddQ[IntegerExponent[3*k + 2, 2]]; Select[Range[0, 176], q] (* _Amiram Eldar_, Oct 08 2026 *)
%Y A400890 Cf. A005408, A007814, A400893.
%K A400890 nonn,easy,new
%O A400890 1,2
%A A400890 _Wolfdieter Lang_, Oct 08 2026
