%U A400263 0,1,2,0,0,0,1,0,1,0,2,0,1,0,0,0,2,2,1,1,1,0,1,1,0,2,0,0,1,0,2,1,1,0,0,0,1,2
%N A400263 The second least significant digit of n' [the arithmetic derivative of n, A003415] in the primorial base, A049345.
%C A400263 The exponent of the highest power of 3 dividing A276086(A003415(n)), where A003415 is the arithmetic derivative, and A276086 is the primorial base exp-function.
%H A400263 Antti Karttunen, <a href="/A400263/b400263.txt">Table of n, a(n) for n = 0..10000</a>
%H A400263 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400263 a(n) = A007949(A327859(n)).
%F A400263 For n >= 1, a(n) = A007949(A392879(A392879(A380459(n)))).
%o A400263 (PARI)
%o A400263 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400263 A007949(n) = valuation(n, 3);
%o A400263 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400263 A327859(n) = A276086(A003415(n));
%o A400263 A400263(n) = A007949(A327859(n));
%Y A400263 The second column of A400260.
%Y A400263 Cf. A003415, A007949, A049345, A276086, A327859, A380459, A392879.
%Y A400263 Cf. also A165560, A400265, A400267, and A400253.
%K A400263 nonn,base,new
%O A400263 0,5
%A A400263 _Antti Karttunen_, Sep 22 2026
