%N A400723 Least prime factor of (4^n - 1)/3.
%C A400723 See A398834 for a guide to related sequences.
%F A400723 a(n) = A020639(A002450(n)).
%t A400723 {x, y} = {4, 1}; p[n_] := p[n] = (x^n - y^n)/(x - y);
%t A400723 f[n_] := f[n] = FactorInteger[p[n]];
%t A400723 Map[First, Table[First[f[n]], {n, 2, 80}]]
%o A400723 (PARI) a(n) = vecmin(factor((4^n - 1)/3)[,1]); \\ _Michel Marcus_, Nov 13 2026
