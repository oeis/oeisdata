%I A400611 #10 Oct 11 2026 17:02:59
%S A400611 0,1,4,10,20,22,27,54,56,70,81,94,100,108,121,135,162,166,202,216,224,
%T A400611 232,243,245,250,260,265,266,270,272,274,308,324,340,344,346,351,355,
%U A400611 382,405,432,445,454,459,513,517,518,526,540,562,567,594,610,621,634,648,675,702,706,729,784,806
%N A400611 Numbers k such that digsum(k') is a multiple of digsum(k), where k' = A003415(k) is the arithmetic derivative of k and digsum(x) = A007953(x) is the sum of decimal digits of x.
%H A400611 Robert Israel, <a href="/A400611/b400611.txt">Table of n, a(n) for n = 1..10000</a>
%e A400611 a(5) = 20 is a term because digsum(20') = digsum(24) = 6 is a multiple of digsum(20) = 2.
%p A400611 ader:= proc(n) local F,t;
%p A400611       F:= ifactors(n)[2];
%p A400611       n*add(t[2]/t[1],t=F)
%p A400611 end proc:
%p A400611 filter:= n -> convert(convert(ader(n),base,10),`+`) mod convert(convert(n,base,10),`+`) = 0:
%p A400611 filter(0):= true:
%p A400611 select(filter, [$0..1000]);
%t A400611 d[ n_] := If[ Abs @ n < 2, 0, n Total[ #2 / #1 & @@@ FactorInteger[ Abs @ n]]];dsum[k_]:=Plus @@ IntegerDigits @ k;dsum[24];Join[{0},Select[Range[806],Mod[dsum[d[#]],dsum[#]]==0&]] (* _James C. McMahon_, Oct 05 2026 *)
%Y A400611 Cf. A003415, A007953, A400610.
%Y A400611 Includes A011557 and A213240.
%K A400611 nonn,base,changed
%O A400611 1,3
%A A400611 _Robert Israel_, Oct 01 2026
