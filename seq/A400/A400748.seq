%U A400748 4237711066815034799201572,34825178568638897475439835586,571549240593518128029322225288208,18745656930615920309484433627839097022
%N A400748 G.f. A(x) satisfies: A(x) = 1 + x * A(2*x/(1 - x)^2) / (1 - 2*x).
%F A400748 a(0) = 1; a(n) = Sum_{k=0..n-1} Sum_{j=0..n-k-1} binomial(n+k-1,j) * 2^k * a(k) for n >= 1.
%t A400748 nmax = 16; A[_] = 0; Do[A[x_] = 1 + x A[2 x/(1 - x)^2]/(1 - 2 x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A400748 (* Alternative: *)
%t A400748 a[0] = 1; a[n_] := a[n] = Sum[Sum[Binomial[n + k - 1, j] 2^k a[k], {j, 0, n - k - 1}], {k, 0, n - 1}]; Table[a[n], {n, 0, 16}]
%Y A400748 Cf. A005493, A125273, A126443, A390837.
