%U A400343 98304,79744,159488,122368,244736,195072,390144,290816,581632,456960,913920,664576,1329152,1031168,2062336
%N A400343 a(0) = 1; a(2*n) = Sum_{j=0..n} a(j) * a(n-j), a(2*n+1) = 2 * a(2*n).
%F A400343 G.f. A(x) satisfies: A(x) = (1 + 2*x) * A(x^2)^2.
%F A400343 G.f.: Product_{k>=0} (1 + 2*x^(2^k))^(2^k).
%t A400343 a[0] = 1; a[n_] := a[n] = If[EvenQ[n], Sum[a[j] a[n/2 - j], {j, 0, n/2}], 2 a[n - 1]]; Table[a[n], {n, 0, 45}]
%t A400343 (* Alternative: *)
%t A400343 nmax = 45; CoefficientList[Series[Product[(1 + 2 x^(2^k))^(2^k), {k, 0, Floor[Log[2, nmax]] + 1}], {x, 0, nmax}], x]
%Y A400343 Cf. A001316, A073707, A308985.
