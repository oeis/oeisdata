%U A400103 2601540071862357569,112868361136614138319,5204663537137641623506,254190736843193600340726
%N A400103 Number of endofunctions on [n] whose second-largest component has size 1.
%C A400103 For every prime p, a(p+1) == 0 (mod p) and a(p) == 1 (mod p).
%C A400103 For n >= 2, n is prime if and only if a(n+1) - a(n) + 1 == 0 (mod n).
%F A400103 E.g.f.: -(exp(x)-1)*log(1+LambertW(-x))+(1-x)*exp(x)-1.
%F A400103 Limit_{n->oo} sqrt(n)*a(n)/n^n = sqrt(Pi/2)*(exp(1/e)-1).
%F A400103 a(n) = 1 + Sum_{k=2..n-1} binomial(n,k)*A001865(k), for n >= 2.
%p A400103 a := -(exp(x)-1)*log(1+LambertW(-x))+(1-x)*exp(x)-1:
%p A400103 ser := series(a, x = 0, 21): seq(n!*coeff(ser, x, n), n = 0 .. 19);
%o A400103 (Python)
%o A400103 from math import comb, factorial as f
%o A400103 c = lambda n: sum(f(n-1)//f(j)*n**j for j in range(n))
%o A400103 a = lambda n: (n>1)+sum(comb(n,k)*c(k) for k in range(2,n))
%o A400103 print([a(n) for n in range(20)])
%Y A400103 Column k=1 of triangle A350078.
%Y A400103 Cf. A000312, A001865, A350079.
