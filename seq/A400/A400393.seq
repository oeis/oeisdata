%S A400393 1,2,2,4,2,4,2,4,5,4,2,8,2,4,4,10,2,10,2,8,4,4,2,8,7,4,4,8,2,8,2,12,4,
%T A400393 4,4,20,2,4,4,8,2,8,2,8,10,4,2,20,9,14,4,8,2,8,4,8,4,4,2,16,2,4,10,16,
%U A400393 4,8,2,8,4,8,2,20,2,4,14,8,4,8,2,20,17,4,2,16,4,4
%N A400393 a(n) = Sum_{d|n} gcid(d, n/d), where gcid is the greatest common infinitary divisor.
%H A400393 Amiram Eldar, <a href="/A400393/b400393.txt">Table of n, a(n) for n = 1..10000</a>
%F A400393 Multiplicative with a(p^e) = Sum_{k=0..e} p^bitand(k, e-k).
%t A400393 f[p_, e_] := Sum[p^BitAnd[k, e-k], {k, 0, e}];
%t A400393 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n];
%t A400393 Array[a, 100]
%o A400393 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, sum(k = 0, f[i, 2], f[i, 1]^bitand(k, f[i, 2]-k)));}
%Y A400393 Cf. A055155 (gcd analog), A077609, A400137, A400392 (gcud analog).
%K A400393 nonn,mult,easy,new
%O A400393 1,2
