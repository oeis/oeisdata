%S A400724 1,2,2,6,4,8,2,12,4,16,4,48,4,12,32,48,2,64,4,128,8,32,16,192,8,32,16,
%T A400724 144,16,1024,8,96,16,16,16,1536,8,16,64,2048,16,768,4,768,256,128,4,
%U A400724 6144,16,128,8,384,4,2048,96,1152,32,128,2,65536,8,64,64,384
%N A400724 Number of divisors of 4^n - 3^n.
%C A400724 Let I[x] denote the set of polynomials p = p(x) all of whose coefficients are integers. For p(x) in I[x], denote by f(x,i), for i=1..m, the irreducible divisors in I[x] of p(x). Let c be an integer. The numbers f(c,i), together with 1, are here called type 1 (p,c)-divisors of p(c). The products of two or more of the numbers f(c,i) that are divisors of p(c) are type 2 (p,c)-divisors of p(c); and all other divisors of p(c) are type 3 (p,c)-divisors. These definitions generalize naturally to polynomials in more than 1 variable. (See A398834 for examples.)
%C A400724 For this sequence, the a(n) divisors of (4^n - 1)/3, for selected values of n are partitioned into the 3 types as shown below. Note that primes can occur in both types 1 or 3, or both, depending on n.
%C A400724    n    type 1         type 2                 type 3
%C A400724    1    1              none                   none
%C A400724    2    1,7            none                   none
%C A400724    3    1,37           none                   none
%C A400724    4    1,7,25         175                    5,35
%C A400724    5    1,781          none                   11,71
%C A400724    6    1,7,1337       91,259,481,3367        none
%C A400724    7    1,14197        none                   none
%C A400724    8    1,7,25,337     175,2359,8425,58975    5,35,1685,11795
%C A400724 See A398834 for a guide to related sequences.
%F A400724 a(n) = A000005(A005061(n)).
%t A400724 {x, y} = {4, 3}; p[n_] := p[n] = (x^n - y^n)/(x - y);
%t A400724 Table[DivisorSigma[0, p[n]], {n, 1, 100}]
%Y A400724 Cf. A000005, A005061, A398834.
%K A400724 nonn,new
%O A400724 1,2
