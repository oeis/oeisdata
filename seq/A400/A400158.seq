%S A400158 1,2,6,9,686,4802,33614,117649,1519999338,2143588810,645375395558,
%T A400158 4824360975786,220435728466551,36088733854723069,3308129062990582958,
%U A400158 434078036870135594962,360665304490236789918,17594926227624891228541,28202070770160592048842094,375379097823970025725891805,576852205741203783354114512997
%N A400158 a(1) = 1, a(2) = 2, and for n > 2, a(n) is the least number whose (n-1)-th arithmetic derivative (A003415) is one and A051903(n) = n-2, where A051903(n) is the largest exponent in the prime factorization of n.
%C A400158 Not monotonic, as for example, a(17) < a(16).
%C A400158 Question: Are there any other common terms with A000169 apart from 1, 2, 9 and 117649?
%F A400158 A400257(a(n)) = n-1.
%F A400158 For n >= 2, a(n) >= A394885(n-2).
%F A400158 For n >= 0, a(n+2) >= A151800(n)^n > A000312(n).
%o A400158 (PARI)
%o A400158 A400257(n,g=factor(n),prevme=if(1==n,0,vecmax(g[,2]))) = if(n<=1, 0, my(nextme, s=1, f); while(!isprime(n), f = g; n = n*sum(i=1, #f~, f[i, 2]/f[i, 1]); g = factor(n); nextme = vecmax(g[,2]); if(nextme != prevme-(1-isprime(n)), return(0), s++; prevme = nextme)); (s));
%o A400158 A400158(n) = if(n<=2, n, my(e=n-2, pp, best=0); forprime(p=nextprime(1+e), , print(n,": Now checking prime ",p); pp = p^e; if(best && pp>best, return(best)); for(m=1,oo,if(A400257(m*pp)==(1+e) && (!best || (m*pp < best)), best = m*pp; print("New best=",best); break); if(best && m*pp > best, break))));
%Y A400158 Cf. A000169, A003415, A051903.
%Y A400158 a(n) is the index of the first occurrence of n-1 in A400257.
%Y A400158 After the initial 1, all terms occur in A400256, thus also in A048103.
%Y A400158 Cf. also A189760, A394885, A400828.
%K A400158 nonn,new
%O A400158 1,2
%A A400158 _Antti Karttunen_, Oct 08 2026
