%I A400414 #24 Nov 01 2026 13:05:54
%S A400414 5,2,11,5,23,7,37,11,47,17,67,19,83,23,97,29,127,31,137,37,149,41,167,
%T A400414 47,197,53,211,59,223,59,257,67,277,71,307,79,317,83,337,89,359,97,
%U A400414 383,97,397,101,431,113,457,127,467,127,487,127,521,137,541,137,557
%N A400414 a(n) is the smallest prime greater than 2*prime(n) if n is odd, and greater than prime(n)/2 otherwise.
%C A400414 Conjecture 1: Iterating the map x -> a(x) starting from any prime eventually leads to a periodic orbit.
%C A400414 Conjecture 2: Iterating the map on any prime leads to the same periodic orbit, which contains 13 primes {11, 23, 47, 97, 197, 397, 199, 101, 53, 29, 17, 37, 19}.
%H A400414 James C. McMahon, <a href="/A400414/b400414.txt">Table of n, a(n) for n = 1..10000</a>
%F A400414 a(n) = A059786(n) for odd n; a(n) = A079953(n) for even n.
%e A400414 a(1) = 5 because n = 1 is odd, prime(1) = 2, and the smallest prime greater than 2*prime(1) is 5.
%e A400414 a(6) = 7 because n = 6 is even, prime(6) = 13, and the smallest prime greater than prime(6)/2 is 7.
%t A400414 a[n_]:=If[OddQ[n],NextPrime[2Prime[n]],NextPrime[Prime[n]/2]];Array[a,59] (* _James C. McMahon_, Nov 01 2026 *)
%o A400414 (Python)
%o A400414 from sympy import prime, nextprime as np
%o A400414 def A400414(n): p = prime(n); return np(p/2) if n%2 == 0 else np(p*2)
%o A400414 for n in range(1, 60): print(A400414(n), end = ', ')
%Y A400414 Interspersion of A059786 and A079953.
%K A400414 nonn,new
%O A400414 1,1
%A A400414 _Ya-Ping Lu_, Oct 24 2026
