%I A400666 #23 Oct 29 2026 18:06:12
%S A400666 2,6,23,1838,15000,6992,2888377,795420,37366496,8803255110,
%T A400666 1462927131789,36810773632272,2879846318370304
%N A400666 The smallest integer k greater than n such that c(k) is divisible by c(n), where c(n) is formed by concatenating 1, 2, 3, ..., n.
%e A400666 a(3) = 23, since c(23) = 12345678....20212223 is the smallest c(k) that is divisible by c(3) = 123, where c(n) is formed by concatenating 1, 2, 3, ..., n.
%t A400666 a[n_]:=Module[{Cn,r=0,k=n+1},Cn=FromDigits[Flatten[IntegerDigits/@Range[n]]];
%t A400666 While[True,r=Mod[r*PowerMod[10,IntegerLength[k],Cn]+k,Cn];
%t A400666 If[r==0,Return[k]];k++]];
%o A400666 (PARI)
%o A400666 a(n) = {my(c = eval(concat(vector(n, i, Str(i)))), r = 0, k = n + 1); while (1,
%o A400666     r = (r * lift(Mod(10, c)^#Str(k)) + k) % c; if (r == 0, return(k)); k++;);}
%Y A400666 Cf. A007908, A075019, A332867.
%K A400666 base,nonn,more,hard,changed
