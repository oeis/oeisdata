%I A400209 #34 Nov 13 2026 14:10:17
%S A400209 0,0,1,0,1,0,1,2,3,0,1,0,1,254,3,0,1,0,1,2,3,0,1,8,253,4,25,0,1,0,1,2,
%T A400209 9,52
%N A400209 Number of steps to reach a prime under x -> p*(x - p), with p being the largest prime < x, starting at x = n, or -1 if no such number exists.
%C A400209 For this iteration to end, it must hit a number k such that k - 1 is prime.
%C A400209 a(36) > 3520 if it exists.
%H A400209 Giacomo Ambrosini, <a href="/A400209/a400209.txt">Table of n, a(n) for n=2..100, with ">k" as the lower bound for unknown values</a>
%F A400209 a(p) = 0, for p prime.
%e A400209 a(10) = 3 since the 3 iterations are 7*(10-7)=21 -> 19*(21-19)=38 -> 37*(38-37)=37, prime.
%o A400209 (Python)
%o A400209 from sympy import isprime, prevprime
%o A400209 def a(n):
%o A400209     k = 0
%o A400209     while not isprime(n):
%o A400209         p = prevprime(n)
%o A400209         n = p*(n - p)
%o A400209         k = k + 1
%o A400209     return k
%o A400209 print([a(n) for n in range(2, 36)])
%o A400209 (PARI) a(n) = my(nb=0); while (!isprime(n), my(p=precprime(n-1)); n=p*(n-p); nb++); nb; \\ _Michel Marcus_, Oct 31 2026
%Y A400209 Cf. A037271, A064924, A151799.
%K A400209 nonn,hard,more,new
%O A400209 2,8
