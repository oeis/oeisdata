%I A400862 #17 Oct 13 2026 14:58:52
%S A400862 1,5,7,32,11,13,0,17,19,25,23,65,0,29,31,85,0,37,0,41,43,115,47,119,0,
%T A400862 53,81,145,59,61,0,256,67,0,71,73,0,0,79,187,83,203,0,89,209,235,0,97,
%U A400862 0,101,103,265,107,109,121,113,0,295,0,287,0,0,127,512,131
%N A400862 Smallest k such that A046073(k) = n, or 0 if no such k exists.
%C A400862 If the multiplicative group of integers modulo k is of the form C_{2m_1} X ... X C_{2m_r}, with m_1 | m_2 | ... | m_r, then the number of squares modulo k is A046073(k) = m_1*...*m_r. In particular, any k with A046073(k) = n must divide A079612(2*n).
%C A400862 For squarefree n > 1, A046073(k) = n if and only if the multiplicative group of integers modulo k is of the form (C_2)^r X C_{2n} (cf. A400852).
%H A400862 Jianing Song, <a href="/A400862/b400862.txt">Table of n, a(n) for n = 1..10000</a>
%H A400862 Jianing Song, <a href="/A399566/a399566.txt">List of k such that A046073(k) = n <= 1889</a>.
%H A400862 Jianing Song, <a href="/A400852/a400852_2.txt">PARI program for A400852</a>.
%o A400862 (PARI) v(n) = select(x->A046073(x)==n, divisors(A079612(2*n))); \\ Gives the list of k such that A046073(k) = n; see A046073 and A079612 for their PARI programs. Warning: This is very inefficient since A079612(2*n) can easily have tens of millions of divisors. For squarefree n, it is much more advised to use multgp() given in the link of the PARI program for A400852.
%o A400862 A400862(n, first_search=10) = {
%o A400862   my(list);
%o A400862   if(issquarefree(n), list=multgp(n); return(if(list, vecmin(list), 0)));
%o A400862   for(k=1, n*first_search, if(A046073(k)==n, return(k))); \\ do a naive search to see if a small solution is available
%o A400862   list=v(n); return(if(list, vecmin(list), 0));
%o A400862 };
%Y A400862 Cf. A399566, A400854, A046073, A079612, A400852.
%K A400862 nonn
%O A400862 1,2
%A A400862 _Jianing Song_, Oct 07 2026
