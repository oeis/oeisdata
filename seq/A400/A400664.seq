%I A400664 #30 Oct 21 2026 18:20:27
%S A400664 1,12,93,640,4205,26964,170233,1062912,6581529,40487260,247756949,
%T A400664 1509575808,9164568517,55466937764,334817863665,2016441892864,
%U A400664 12119595157553,72713853520812,435569584191949,2605438137974400,15564950249393181,92877555772827892,553624317522209513
%N A400664 Expansion of g.f. ((3 - z)/(z^2 - 6*z + 1)^(3/2) - 1/(z - 1)^2) / 2.
%C A400664 This sequence is strictly integer-valued. It represents the algebraic integral mean of the continuous family of deformable Gegenbauer polynomial kernels with fractional convolution parameter s = 1/2, integrated over the internal parameter p from alpha = 2 to beta = 6 (see 3rd formula).
%C A400664 The sequence is computed via a 2D holonomic recurrence relation of fixed order (see the preprint in the LINKS section). The modular symmetry of the boundary parameters fully compensates the fractional contributions of the half-integer exponent.
%H A400664 Dmytro Dmytryshyn, <a href="https://doi.org/10.13140/RG.2.2.32268.68489">A Method of Non-Stationary Recurrence Relations for Computing Convolutions of Higher and Fractional Orders</a>, Preprint, ResearchGate, Sep 2026.
%F A400664 a(n) = (n + 1) * ( GegenbauerC(n + 1, 1/2, 3) - GegenbauerC(n + 1, 1/2, 1) ) / 2 for n >= 1, with a(0) = 1.
%F A400664 a(n) = (3*X(n, 6) - X(n-1, 6) - X(n, 2) + X(n-1, 2)) / 2 for n >= 1, where the two-dimensional holonomic components satisfy n*X(n, p) = p*(n + 1/2)*X(n-1, p) - (n + 1)*X(n-2, p) with X(-1, p) = 0, X(0, p) = 1 and p in {2, 6}.
%F A400664 a(0) = 1 and a(n) = ((n + 1)/4) * Integral_{p=2..6} GegenbauerC(n, 3/2, p/2) dp for n >= 1.
%F A400664 a(n) = (A364634(n+1) - (n+1)) / 2.
%F A400664 a(n) = (n+1) * (Sum_{k=0..n+1} (binomial(n+1, k)^2 * 2^k) - 1) / 2.
%F A400664 a(n) ~ (1 + sqrt(2))^(2*n+3) * sqrt(n) / (2^(9/4) * sqrt(Pi)). - _Vaclav Kotesovec_, Oct 03 2026
%p A400664 X := proc (n, p) option remember: if n < 0 then 0 elif n = 0 then 1 else (p*(n+1/2)*X(n-1, p)-(n+1)*X(n-2, p))/n end if end proc: a := proc (n) if n = 0 then 1 else (3/2)*X(n, 6)-(1/2)*X(n-1, 6)-(1/2)*X(n, 2)+(1/2)*X(n-1, 2) end if end proc: seq(a(n), n = 0..22);
%p A400664 # Alternative:
%p A400664 G :=(1/2)* ((3-z) / (z^2-6*z+1)^(3/2)-1/(1-z)^2); S := series(G, z = 0, 23); a := proc (n) options operator, arrow: coeff(S, z, n) end proc: seq(a(n), n = 0..22);
%Y A400664 Cf. A050146, A364634.
%K A400664 nonn,easy,new
%O A400664 0,2
%A A400664 _Dmytro Dmytryshyn_, Oct 03 2026
