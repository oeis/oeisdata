%S A400351 1,1,2,1,5,2,6,1,16,5,18,2,37,6,32,1,87,16,78,5,176,18,126,2,360,37,
%T A400351 256,6,621,32,348,1,1176,87,702,16,1931,78,932,5,3504,176,1782,18,
%U A400351 5312,126,2124,2,9351,360,4144,37,13680,256,4806,6,23536,621,9048,32,32389,348,9496,1,55015,1176
%N A400351 a(0) = 1; a(2*n) = Sum_{j=0..n} a(j) * a(n-j), a(2*n+1) = a(n).
%F A400351 G.f. A(x) satisfies: A(x) = A(x^2) * (x + A(x^2)).
%t A400351 a[0] = 1; a[n_] := a[n] = If[EvenQ[n], Sum[a[j] a[n/2 - j], {j, 0, n/2}], a[(n - 1)/2]]; Table[a[n], {n, 0, 65}]
%t A400351 (* Alternative: *)
%t A400351 nmax = 65; A[_] = 1; Do[A[x_] = A[x^2] (x + A[x^2]) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%Y A400351 Cf. A002487, A073707, A073711, A086450.
%K A400351 nonn,new
%O A400351 0,3
