%U A400673 97,761,39714817,17,257,17,257,547601,19457,73,76801,91841,97,7129,4567553,73,236993
%N A400673 Smallest prime factor of (2*n)^(4*n^2) + 1.
%C A400673 Equivalent in form to n^(n^2) + 1, or (n^n)^n + 1, where n = 2*k.
%C A400673 a(n) is of the form x * 2^(2*v_2(n)+3) + 1 for some x >= 1 and for all n >= 1, where v_2 is the 2-adic valuation of n (number of times 2 divides n).
%C A400673 Only numbers of the form 2*k are considered, since a(2*k+1) = 2 for all k >= 0. Indeed, (2*k+1)^((2*k+1)^2) is odd, so adding 1 gives an even number.
%H A400673 Jakub Buczak, <a href="/A400673/b400673.txt">Table of n, a(n) for n = 1..387</a>
%e A400673 4^(4^2) + 1 = 4294967297, the smallest prime factor of 4294967297 is 641, thus a(2) = 641.
%o A400673 (Python)
%o A400673 from itertools import count
%o A400673 def a(n):
%o A400673     m = 1 << (2 * (n & -n).bit_length() - 1)
%o A400673     for p in count(m + 1, m):
%o A400673         if p%3==0 or p%5==0 or p%7==0 or p%11==0 or p%13==0: continue
%o A400673         if pow(2*n, 4*n*n, p) == p - 1: return p
%o A400673 (PARI) a(n) = my(k=(2*n)^(4*n^2) + 1); if (isprime(k), return(k)); my(D=10, f); while (#(f=factor(k, D))~ == 1, D = 10*D); f[1,1]; \\ _Michel Marcus_, Oct 04 2026
%Y A400673 Cf. A002489, A007814, A000215, A093179.
