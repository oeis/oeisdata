%S A400128 1,1,3,7,20,64,210,717,2521,9032,32908,121547,453956,1711618,6506270,
%T A400128 24906495,95933280,371524831,1445793216,5650723686,22171453830,
%U A400128 87300325758,344850154968,1366209137388,5427133763730,21612125141826,86261251911675,345026315863312,1382743189937366,5551688389612612
%N A400128 Number of recursively defined forms of weight n, where a form is either a unit, an ordered fusion of two forms, or a propagation of one form whose weight is tripled.
%C A400128 Forms are recursively defined by three constructors: U, F(A,B), and P(A) with weights w(U)=1, w(F(A,B)) = w(A) + w(B), w(P(A))=3*w(A).
%C A400128 The binary constructor F is ordered, so F(A,B) and F(B,A) are generally distinct.
%C A400128 a(n) counts structurally distinct forms of weight n.
%H A400128 Alois P. Heinz, <a href="/A400128/b400128.txt">Table of n, a(n) for n = 1..1606</a>
%F A400128 a(n) = Sum_{k=1..n-1} a(k)*a(n-k) + [n == 0 (mod 3)] * a(n/3) for n > 1, where [] is the Iverson bracket.
%F A400128 G.f.: A(x) satisfies A(x) = x + A(x)^2 + A(x^3). - _Andrew Howroyd_, Sep 19 2026
%e A400128 a(3)=3 because the forms of weight 3 are F(F(U,U),U), F(U,F(U,U)), and P(U).
%e A400128 For n=4, a form whose outer constructor is F has weight split 1+3, 2+2, or 3+1. These contribute 3, 1, and 3 forms respectively, so a(4)=3+1+3=7.
%e A400128 Explicitly, the seven forms are: F(U,F(F(U,U),U)), F(U,F(U,F(U,U))), F(U,P(U)), F(F(U,U),F(U,U)), F(F(F(U,U),U),U), F(F(U,F(U,U)),U), F(P(U),U).
%p A400128 a:= proc(n) option remember; `if`(n=1, 1,
%p A400128      `if`(irem(n, 3, 'q')=0, a(q), 0))+add(a(j)*a(n-j), j=1..n-1)
%p A400128     end:
%p A400128 seq(a(n), n=1..30);  # _Alois P. Heinz_, Sep 19 2026
%o A400128 (Python)
%o A400128 def forms_sequence(N):
%o A400128     a = [0]*(N+1)
%o A400128     if N >= 1:
%o A400128         a[1] = 1
%o A400128     for n in range(2, N+1):
%o A400128         a[n] = sum(a[k]*a[n-k] for k in range(1, n))
%o A400128         if n % 3 == 0:
%o A400128             a[n] += a[n//3]
%o A400128     return a[1:]
%o A400128 print(forms_sequence(20))
%o A400128 (PARI) seq(n) = my(g=x+O(x^2)); for(n=2, n, g = x + g^2 + subst(g,x,x^3)); Vec(g) \\ _Andrew Howroyd_, Sep 19 2026
%Y A400128 Cf. A000108, A226909 (case for P constructor doubling weight).
%K A400128 nonn,new
%O A400128 1,3
%A A400128 _Byron Pickell_, Sep 19 2026
