%I A400688 #6 Oct 08 2026 22:46:35
%S A400688 2,4,5,8,12,14,16,29,37,42,32,70,98,118,132,64,169,261,331,387,429,
%T A400688 128,408,694,934,1130,1298,1430,256,985,1845,2645,3317,3905,4433,4862,
%U A400688 512,2378,4906,7476,9786,11802,13650,15366,16796,1024,5741,13045,21120,28932,35862,42198,48204,53924,58786
%N A400688 Triangle of the Catalan Pell numbers read by rows: T(n,k) = [x^n] (1 - 2*x - Sum_{h=1..k-1} A000108(h)*x^(h+1))^(-1), with 0 < k <= n.
%H A400688 Lara Bossinger and Ömer Gürdoğan, <a href="https://arxiv.org/abs/2609.38456">A combinatorial interpolation between the hypercube and the associahedron</a>, arXiv:2609.38456 [math.CO], 2026. See pp. 2-3.
%F A400688 T(n,n) = A000108(n+1).
%F A400688 T(n,2) = A000129(n+1).
%e A400688 The triangle begins as:
%e A400688    2;
%e A400688    4,   5;
%e A400688    8,  12,  14;
%e A400688   16,  29,  37,  42;
%e A400688   32,  70,  98, 118, 132;
%e A400688   64, 169, 261, 331, 387, 429;
%e A400688   ...
%t A400688 T[n_,d_]:=SeriesCoefficient[(1-2x-Sum[CatalanNumber[k]*x^(k+1),{k,d-1}])^(-1),{x,0,n}]; Table[T[n,k],{n,10},{k,n}]//Flatten
%Y A400688 Cf. A000079 (k=1), A000108, A000129, A077938 (k=3), A400689 (row sums).
%K A400688 nonn,tabl,new
%O A400688 1,1
%A A400688 _Stefano Spezia_, Oct 03 2026
