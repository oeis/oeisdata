%I A400841 #6 Oct 09 2026 23:33:26
%S A400841 1,2,2,3,2,4,2,5,5,6,2,7,2,8,9,10,2,11,2,12,13,14,2,15,16,17,18,19,2,
%T A400841 20,2,21,22,23,7,24,2,25,26,27,2,28,2,29,30,31,2,32,16,33,34,35,2,36,
%U A400841 37,38,39,40,2,41,2,42,43,44,45,46,2,47,48,49,2,50,2,51,52,53,11,54,2,55,38,56,2,57,58,59,60,61,2,62,63,64,12
%N A400841 Lexicographically earliest infinite sequence such that a(i) = a(j) => A360121(i) = A360121(j), for all i, j >= 1, where A360121 is Dirichlet convolution of A342001 with A342002.
%C A400841 Restricted growth sequence transform of A360121.
%C A400841 For all i, j >= 1:
%C A400841   A305800(i) = A305800(j) => a(i) = a(j) => A360122(i) = A360122(j).
%H A400841 Antti Karttunen, <a href="/A400841/b400841.txt">Table of n, a(n) for n = 1..65537</a>
%H A400841 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%o A400841 (PARI)
%o A400841 up_to = 65537;
%o A400841 rgs_transform(invec) = { my(om = Map(), outvec = vector(length(invec)), u=1); for(i=1, length(invec), if(mapisdefined(om,invec[i]), my(pp = mapget(om, invec[i])); outvec[i] = outvec[pp] , mapput(om,invec[i],i); outvec[i] = u; u++ )); outvec; };
%o A400841 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400841 A003557(n) = (n/factorback(factorint(n)[, 1]));
%o A400841 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400841 A342001(n) = (A003415(n) / A003557(n));
%o A400841 A342002(n) = A342001(A276086(n));
%o A400841 A360121(n) = sumdiv(n,d,A342001(n/d)*A342002(d));
%o A400841 v400841 = rgs_transform(vector(up_to, n, A360121(n)));
%o A400841 A400841(n) = v400841[n];
%Y A400841 Cf. A305800, A342001, A342002, A360121, A360122.
%K A400841 nonn,easy,new
%O A400841 1,2
%A A400841 _Antti Karttunen_, Oct 09 2026
