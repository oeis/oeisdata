%I A400762 #30 Nov 24 2026 20:31:26
%S A400762 9,45,153,513,1593,4941,14985,45441,136809,411885,1237113,3715713,
%T A400762 11151513,33467661,100416105,301287681,903902409,2711825325,
%U A400762 8135594073,24407136513,73221763833,219666354381,659000126025,1977003566721,5931013888809,17793051232365
%N A400762 Sum of 3^min(L,R) over all ternary words of length n, where L and R are the lengths of the initial and terminal maximal runs of equal symbols.
%C A400762 For a constant word, the initial and terminal runs coincide (L = R = n), so it contributes weight 3^n.
%C A400762 The closed forms in the Formula section follow by grouping the words according to the value of min(L,R) and summing the resulting geometric series. The same argument works for any alphabet size q (see the generalization B_q(n) in the Formula section). For q = 1 the sequence is constantly 1.
%H A400762 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (3,3,-9).
%F A400762 a(n) = 7*3^n - 6*3^(n/2) if n is even.
%F A400762 a(n) = 7*3^n - 12*3^((n-1)/2) if n is odd.
%F A400762 a(n) = 3*a(n-1) + 3*a(n-2) - 9*a(n-3), n >= 4.
%F A400762 G.f.: 9*x*(1+2*x-x^2)/((1-3*x)*(1-3*x^2)).
%F A400762 a(n) = 7*A000244(n) - 6*A038754(n), n >= 1.
%F A400762 More generally, for q >= 1, define
%F A400762 B_q(n) = sum_{w in {1,...,q}^n} q^min(L(w),R(w)).
%F A400762 B_q(2*m) = (2*q+1)*q^(2*m) - 2*q^(m+1), m >= 1.
%F A400762 B_q(2*m+1) = (2*q+1)*q^(2*m+1) - (q+1)*q^(m+1), m >= 0.
%F A400762 G.f. = q^2*x*(1+(q-1)*x-x^2)/((1-q*x)*(1-q*x^2)).
%e A400762 For n=2, there are 3 constant words (00, 11, 22), each with L=R=2 and weight 3^2=9. The other 6 words have L=R=1 and weight 3. Hence a(2)=3*9+6*3=45.
%o A400762 (Python)
%o A400762 def a(n):
%o A400762     if n % 2 == 0:
%o A400762         return 7 * 3**n - 6 * 3**(n//2)
%o A400762     else:
%o A400762         return 7 * 3**n - 12 * 3**((n-1)//2)
%o A400762 print([a(n) for n in range(1, 27)])
%Y A400762 Cf. A000244, A038754.
%K A400762 nonn,easy,new
%O A400762 1,1
%A A400762 _Göktuğ Omay_, Nov 15 2026
