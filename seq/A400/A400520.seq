%S A400520 1,1,18,1,9,3,6,5,15,1,12,48,3,315,100980,1,33,72,2,945,6,195,24,
%T A400520 26520,5,49,23460,12,50490,1435,4,4488,5017320,16,36,1,1,560019,
%U A400520 49544003448,105,3,1015,33660,4972379765496,12,91,13260,17282830224,11,25,960498,24
%N A400520 a(n) is the least multiplier k such that either n*k or n*k+1 is a square, and either n*k or n*k+1 is a triangular number, or -1 if no such k exists.
%C A400520 Conjecture: a(n) > 0.
%e A400520 a(3)=1 because 4 is a square, and 3 is a triangular number.
%e A400520 a(5)=3 because 5*3+1=16 is a square, and 5*3=15 is a triangular number.
%o A400520 (PARI) a(n) = {if(n<2, return(1)); for(x=2, oo, if((x^2-1)%n==0 && (ispolygonal(x^2-1,3) || ispolygonal(x^2,3)), return((x^2-1)\n)); if(x^2%n==0 && (ispolygonal(x^2,3) || ispolygonal(x^2+1,3)), return(x^2\n)))} \\ _Jason Yuen_, Nov 08 2026
%Y A400520 Cf. A000217, A000290.
%Y A400520 Cf. A001110, A182334.
%K A400520 nonn,hard,new
%O A400520 0,3
