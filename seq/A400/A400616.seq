%I A400616 #15 Oct 06 2026 09:22:38
%S A400616 0,0,1,1,1,1,2,3,3,1,3,5,3,2,6,7,4,3,5,7,8,3,6,13,7,3,10,10,7,6,8,15,
%T A400616 12,4,12,16,9,5,14,19,10,8,11,15,19,6,12,29,14,7,18,17,13,10,18,26,20,
%U A400616 7,15,30,15,8,26,31,20,12,17,22,24,12,18,42,18,9,31,25,24,14,20,43
%N A400616 a(n) is the signed number of partitions of n into exactly two distinct part sizes, each occurring an odd number of times.
%H A400616 Paolo Xausa, <a href="/A400616/b400616.txt">Table of n, a(n) for n = 1..10000</a>
%H A400616 Mircea Merca, <a href="https://arxiv.org/abs/2609.33770">The two-block odd partition function</a>, arXiv:2609.33770 [math.NT], 2026.
%H A400616 Mircea Merca, <a href="https://arxiv.org/abs/2610.05020">Dyadic Structure of the Two-Block Odd Partition Function and Theta-Weighted Congruences for pod(n)</a>, arXiv:2610.05020 [math.NT], 2026.
%F A400616 a(n) = (sigma(n) - A002654(n))/4 - sigma(n/2)/2 + sigma(n/4) where sigma(x)=A000203(x) if x is an integer, otherwise 0.
%t A400616 A400616[n_] := #[n]/4 - #[n/2]/2 + #[n/4] - SquaresR[2, n]/16 & [If[IntegerQ[#], DivisorSigma[1, #], 0] &];
%t A400616 Array[A400616, 100] (* _Paolo Xausa_, Oct 01 2026 *)
%o A400616 (PARI)
%o A400616 lambd(n) = sumdiv( n, d, (d%4==1) - (d%4==3)); \\ A002654
%o A400616 sigm(n) = if (denominator(n)==1, sigma(n));
%o A400616 a(n) = (sigm(n)-lambd(n))/4 - sigm(n/2)/2 + sigm(n/4);
%Y A400616 Cf. A000203, A002654.
%K A400616 nonn,look,new
%O A400616 1,7
%A A400616 _Michel Marcus_, Oct 01 2026
