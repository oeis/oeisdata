%S A400144 1,3,4,5,6,12,8,15,10,18,12,20,14,24,24,21,18,30,20,30,32,36,24,60,26,
%T A400144 42,40,40,30,72,32,63,48,54,48,50,38,60,56,90,42,96,44,60,60,72,48,84,
%U A400144 50,78,72,70,54,120,72,120,80,90,60,120,62,96,80,85,84,144,68,90,96,144
%N A400144 The sum of divisors d of n such that gcid(d, n/d) is a square, where gcid is the greatest common infinitary divisor.
%C A400144 First differs from A376888 at n = 64.
%C A400144 The number of these divisors is A400140(n).
%H A400144 Amiram Eldar, <a href="/A400144/b400144.txt">Table of n, a(n) for n = 1..10000</a>
%F A400144 Multiplicative with a(p^e) = (p^(e+1)-1)/(p-1) if e is odd, and (p^(e+1)-1)/(p-1) - p*(p^e-1)/(p^2-1) if e is even.
%F A400144 Dirichlet g.f.: zeta(2*s-2) * zeta(2*s) * Product_{p prime} (1 + 1/p^(s-1) + 1/p^s).
%F A400144 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = zeta(2)*zeta(4)/zeta(3) = 1.48108658899021608024... .
%t A400144 f[p_, e_] := (p^(e + 1) - 1)/(p-1) - If[OddQ[e], 0, p*(p^e - 1)/(p^2-1)];
%t A400144 a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A400144 (PARI) fun(p, e) = (p^(e + 1) - 1)/(p-1) - if(e % 2, 0, p*(p^e - 1)/(p^2-1));
%o A400144 a(n) = {my(f = factor(n)); prod(i = 1, #f~, fun(f[i, 1], f[i, 2]));}
%Y A400144 Cf. A000290, A365172 (analogous with gcd), A376888, A399836 (unitary analog), A400137, A400140.
%Y A400144 Cf. A002117, A013661, A013662.
%Y A400144 The sum of divisors d of n such that gcid(d, n/d) is: A049417 (1), this sequence (square), A400145 (odd), A400146 (power of 2).
%K A400144 nonn,mult,easy,new
%O A400144 1,2
%A A400144 _Amiram Eldar_, Sep 20 2026
