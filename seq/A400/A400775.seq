%I A400775 #21 Oct 13 2026 23:18:54
%S A400775 1,2,0,3,2,0,4,4,2,0,5,6,8,2,0,6,8,24,2048,2,0,7,10,64
%N A400775 Fast-growing hierarchy {f_n(k)} read by antidiagonals, n >= 0, k >= 0.
%C A400775 The next term f_3(3) = A036289(402653184) has more than 10^8 digits and is too large to include.
%H A400775 Wikipedia, <a href="https://en.wikipedia.org/wiki/Fast-growing_hierarchy">Fast-growing hierarchy</a>.
%F A400775 f_0(k) = k + 1.
%F A400775 f_1(k) = 2 * k.
%F A400775 f_2(k) = 2^k * k.
%F A400775 f_{n+1}(k) = f_n^k(k), where f^k is k-th iterate of f.
%e A400775 Table begins:
%e A400775   1,    2,    3,    4,    5,    6,    7, ...
%e A400775   0,    2,    4,    6,    8,   10, ...
%e A400775   0,    2,    8,   24,   64, ...
%e A400775   0,    2, 2048, ...
%e A400775   0,    2, ...
%e A400775   0, ...
%o A400775 (Python)
%o A400775 def fast_growing_hierarchy(alpha, n):
%o A400775     if alpha == 0:
%o A400775         return n + 1
%o A400775     else:
%o A400775         current_value = n
%o A400775         for _ in range(n):
%o A400775             current_value = fast_growing_hierarchy(alpha - 1, current_value)
%o A400775         return current_value
%Y A400775 Cf. A000027 (0th row), A005843 (first row), A036289 (second row), A000007 (0th column), A007395 (first column), A154714 (second column).
