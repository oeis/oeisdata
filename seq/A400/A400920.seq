%S A400920 3,5565047531,11275486097,11925875327,34085972027,44232022697,
%T A400920 48246520337,80347204211,97472326421,102964188797,103202776097,
%U A400920 105098734127,119725258031,125279537861,127813460111,138995281427,149721804611,153806779337,164675373647,168210997607,245783409167
%N A400920 Primes p such that p+2, (p-1)^2+1, (p-1)^2+3, (p-1)^4+1, (p-1)^4+3 and (p-1)^8+1 are all prime.
%C A400920 Equivalently, with a = p-1, the seven numbers a+1, a+3, a^2+1, a^2+3, a^4+1, a^4+3 and a^8+1 are all prime.
%C A400920 The numbers (p-1)^2+1, (p-1)^4+1 and (p-1)^8+1 are iterates of T(n) = (n-1)^2+1 starting at p.
%C A400920 This is a subsequence of A400684. As in A400684, p = 3 (a = 2) is included.
%C A400920 For every term p > 3, a = p-1 == 4 (mod 6). Proof: p and p+2 are both prime and > 3, so p is odd and p == 2 (mod 3), since p == 1 (mod 3) would give 3 | p+2. Hence a is even and a == 1 (mod 3), so a == 4 (mod 6).
%C A400920 For every term p > 3, a = p-1 must lie in one of the residue classes 1156, 1666, 1786, 1870, 2296, 2380, 2500, 3010 (mod 3570), the classes for which none of the seven numbers is divisible by 2, 3, 5, 7 or 17 (finite check).
%C A400920 The Bateman-Horn conjecture predicts that this sequence is infinite. This is a conjecture, not proved.
%D A400920 P. T. Bateman and R. A. Horn, A heuristic asymptotic formula concerning the distribution of prime numbers, Math. Comp. 16 (1962), 363-367.
%e A400920 For n = 1, p = a(1) = 3 (a = 2): the seven numbers are p = 3, p+2 = 5, a^2+1 = 5, a^2+3 = 7, a^4+1 = 17, a^4+3 = 19 and a^8+1 = 257, all prime.
%e A400920 For n = 2, p = a(2) = 5565047531 (a = 5565047530): p+2 = 5565047533, a^2+1 = 30969754011159100901, a^2+3 = 30969754011159100903, a^4+1 = 959125663511705219592882732896380810001, a^4+3 = 959125663511705219592882732896380810003 and a^8+1 = 919922038406768785267010714299586648091086088343576011893844396536256100000001 are all prime.
%o A400920 (Python)
%o A400920 from sympy import isprime
%o A400920 def is_a(n):
%o A400920     p = n
%o A400920     a = p - 1
%o A400920     return (
%o A400920         isprime(p) and
%o A400920         isprime(p + 2) and
%o A400920         isprime(a**2 + 1) and
%o A400920         isprime(a**2 + 3) and
%o A400920         isprime(a**4 + 1) and
%o A400920         isprime(a**4 + 3) and
%o A400920         isprime(a**8 + 1)
%o A400920     )
%o A400920 def a(n):
%o A400920     p, k = 3, 0
%o A400920     while True:
%o A400920         if is_a(p):
%o A400920             k += 1
%o A400920             if k == n:
%o A400920                 return p
%o A400920         p += 2
%o A400920 print("a(1) =", a(1))
%Y A400920 Cf. A400684, A002496.
