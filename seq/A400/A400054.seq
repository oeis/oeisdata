%I A400054 #12 Nov 25 2026 15:19:19
%S A400054 0,0,0,1,0,4,0,4,4,6,0,14,0,8,12,12,0,20,0,20,16,10,0,38,9,12,16,28,0,
%T A400054 46,0,28,20,14,24,59,0,16,24,56,0,64,0,36,48,18,0,86,16,42,28,42,0,70,
%U A400054 30,74,32,20,0,130,0,22,64,62,36,84,0,50,36,90,0,148,0,24,72,56,40,96,0,124,52,26,0,170
%N A400054 a(n) = Sum_{d|n} pi(d) * pi(n/d), where pi(n) is the number of primes <= n, A000720.
%C A400054 Dirichlet convolution of pi(n) with itself.
%H A400054 Antti Karttunen, <a href="/A400054/b400054.txt">Table of n, a(n) for n = 1..10000</a>
%F A400054 From _Robert Israel_, Nov 24 2026: (Start)
%F A400054 a(p) = 0 if p is prime.
%F A400054 a(prime(i)^2) = i^2.
%F A400054 a(prime(i)*prime(j)) = 2*i*j if i <> j. (End)
%p A400054 f:= proc(n) uses NumberTheory;
%p A400054   add(pi(d)*pi(n/d),d=Divisors(n))
%p A400054 end proc:
%p A400054 map(f, [$1..100]); # _Robert Israel_, Nov 24 2026
%t A400054 Table[Sum[PrimePi[d]*PrimePi[n/d], {d, Divisors[n]}], {n, 100}]
%o A400054 (PARI) A400054(n) = sumdiv(n, d, primepi(d)*primepi(n/d)); \\ _Antti Karttunen_, Nov 25 2026
%Y A400054 Cf. A000720 (pi), A062774.
%Y A400054 Cf. also A369747.
%K A400054 nonn,easy,look,new
%O A400054 1,6
%A A400054 _Wesley Ivan Hurt_, Nov 23 2026
