%I A400542 #44 Oct 31 2026 17:39:21
%S A400542 4,3,2,3,5,4,7,6,4,5,6,12,11,12,14,13,16,15,13,14,6,10,9,10,12,11,14,
%T A400542 13,11,12,9,13,12,13,15,14,17,16,14,15,5,9,8,9,11,10,13,12,10,11,10,
%U A400542 14,13,14,16,15,18,17,15,16,13,17,16,17,19,18,21,20,18,19,12,16,15,16,18,17,20,19,17,18,10,14,13,14,16,15,18,17,15,16,11,15,14,15,17,16,19,18,16,17,7
%N A400542 Number of letters in n in Albanian (excluding spaces).
%C A400542 a(n) is the number of letters in the standard Albanian spelling of the number n, excluding spaces.
%C A400542 Uses the standard forms (ASCII transliteration): zero, nje, dy, tre, kater, pese, gjashte, shtate, tete, nente, dhjete, njembedhjete, dymbedhjete, ..., njezet, tridhjete, dyzet, pesedhjete, ..., njeqind, etc. For 40, the shorter form "dyzet" is used.
%D A400542 Akademia e Shkencave e Shqiperise, Instituti i Gjuhesise dhe i Letersise, Fjalor i gjuhes shqipe, Tirane, 2006 (authors: Jani Thomai, Mico Samara, Pavli Haxhillari, Hajri Shehu, Thanas Feka, Valter Memisha, Artan Goga; approx. 48,000 words; ISBN 99943-817-5-X).
%D A400542 Akademia e Shkencave e RPS te Shqiperise, Instituti i Gjuhesise dhe i Letersise, Fjalor i gjuhes se sotme shqipe (me rreth 41.000 fjale), Tirane, 1980.
%D A400542 Akademia e Shkencave e RP te Shqiperise, Instituti i Gjuhesise dhe i Letersise, Drejtshkrimi i gjuhes shqipe, Tirane, 1973 (323 pages).
%H A400542 Marko Radulovic, <a href="/A400542/a400542_6.py.txt">Python program</a>
%H A400542 Unicode CLDR, <a href="https://unicode.org/cldr/charts/latest/verify/numbers/sq.html">Albanian number formats</a>
%H A400542 Wikipedia, <a href="https://en.wikipedia.org/wiki/Albanian_language">Albanian language</a>
%H A400542 <a href="/index/Lc#letters">Index entries for sequences related to number of letters in n</a>
%e A400542 a(0) = 4 because "zero" has 4 letters.
%e A400542 a(1) = 3 because "nje" has 3 letters.
%e A400542 a(4) = 5 because "kater" has 5 letters.
%e A400542 a(11) = 12 because "njembedhjete" has 12 letters.
%e A400542 a(21) = 10 because "njezet e nje" (without spaces) has 10 letters.
%e A400542 a(40) = 5 because "dyzet" has 5 letters.
%e A400542 a(100) = 7 because "njeqind" has 7 letters.
%t A400542 a[n_]:=StringLength[StringDelete[IntegerName[n, {"Albanian"}], " "]]; Array[a, 101, 0] (* _Stefano Spezia_, Sep 30 2026 *)
%o A400542 (Python) # see Links
%Y A400542 Cf. A056597, A005589, A167507, A344894, A380770.
