%T A400386 307174,634713,1596965,3324562,8376721,17549873,44272898,93264529,
%U A400386 235520689,498516530,1260028901,2678261881,6774756742,14453792345,36586620293,78316514866
%N A400386 Rows sum of triangle A106580.
%H A400386 Vincenzo Librandi, <a href="/A400386/b400386.txt">Table of n, a(n) for n = 0..1000</a>
%F A400386 If d is the diagonal of A106580 the sum S(n) = d(n+2) - d(n). Example: (2-1)=1, (3-1)=2, (7-2)=5, (12-3)=9, etc.
%F A400386 G.f.: ((1 - x^2)*2/((1 - x)^2 + sqrt(1 - 6*x^2 + x^4)) - 1 - x)/x^2.
%t A400386 f[z_]:=2/((1-z)^2+Sqrt[1-6 z^2+z^4]); a=Table[SeriesCoefficient[((1-z^2) f[z]-1-z)/z^2,{z,0,n}],{n,0,31}]; a
%o A400386 (Magma) m := 31; P<x> := PowerSeriesRing(Rationals(), m+3); f := 2/((1-x)^2 + Sqrt(1-6*x^2+x^4)); s := ((1-x^2)*f - 1 - x)/x^2; [Coefficient(s,n) : n in [0..m] ];
%Y A400386 Cf. A089324, A106580.
%K A400386 nonn,new
