%I A400285 #10 Oct 05 2026 10:56:28
%S A400285 1,-2,-3,-2,-1,3,5,11,13,17,17,17,9,3,-12,-30,-52,-76,-105,-131,-157,
%T A400285 -178,-187,-189,-173,-138,-75,5,125,266,447,649,889,1136,1415,1677,
%U A400285 1950,2181,2388,2507,2562,2483,2287,1900,1343,541,-479,-1791,-3359,-5239,-7388,-9839
%N A400285 a(n) = [q^n] (J0(q) - J1(q)), where J0 and J1 are q-series defined by Flajolet and Sedgewick.
%C A400285 The functions J_0(q) = J_0(q, 1) and J_1(q) = J_1(q, 1) are introduced in [Flajolet-Sedgewick, 2009] as q-Bessel-type functions.
%H A400285 Philippe Flajolet and Robert Sedgewick, <a href="https://algo.inria.fr/flajolet/Publications/books.html">Analytic Combinatorics</a>, 2009; Chapter IX, §IX.6, Eq. (43), page 661.
%H A400285 Stavros Garoufalidis, <a href="https://people.mpim-bonn.mpg.de/stavros/publications/printed/quantum_knot_invariants.pdf">Quantum knot invariants</a>, Research in the Mathematical Sciences, Vol. 5 (2018), p.15.
%H A400285 Stavros Garoufalidis and Don Zagier, <a href="https://doi.org/10.3842/SIGMA.2023.082">Knots and Their Related q-Series</a>, SIGMA 19, 082, (2023), page 4.
%F A400285 J0(q) = Sum_{n>=0} ((-1)^n*q^(n*(n+1)/2)) / ((q;q)_n*(q;q)_n).
%F A400285 J1(q) = Sum_{n>=1} ((-1)^(n-1)*q^(n*(n+1)/2)) / ((q;q)_(n-1)*(q;q)_n).
%F A400285 J0(q) - J1(q) = (q;q)_{oo} * Sum_{n>=0} (-1)^n*q^((3*n^2 - n)/2) / (q;q)_n^3.
%F A400285 Here (q;q)_n = Product_{k=1..n} (1 - q^k) with (q;q)_0 = 1.
%t A400285 J0m1Series[N_] := Module[{qpochInf, qpochN = 1, s = 0, n, exponent},
%t A400285   qpochInf = Product[1 - q^k, {k, 1, N}];
%t A400285   For[n = 0, n <= N, n++,
%t A400285     exponent = (3 n^2 - n)/2;
%t A400285     If[exponent > N, Break[]];
%t A400285     If[n > 0, qpochN *= (1 - q^n)];
%t A400285     s += (-1)^n q^exponent/qpochN^3;];
%t A400285   Normal@Series[qpochInf s, {q, 0, N}] ]
%t A400285 A400285List[N_] := Table[Coefficient[J0m1Series[N], q, k], {k, 0, N}]
%t A400285 A400285List[51]
%o A400285 (SageMath)
%o A400285 def J0m1_series(N):
%o A400285     R.<q> = PowerSeriesRing(QQ, default_prec=N+1)
%o A400285     qpoch_inf = prod(1 - q^k for k in range(1, N+1))
%o A400285     S = R(0)
%o A400285     qpoch_n = R(1)
%o A400285     for n in range(0, N+1):
%o A400285         exponent = (3*n*n - n) // 2
%o A400285         if exponent > N: break
%o A400285         if n > 0: qpoch_n *= (1 - q^n)
%o A400285         S += (-1)^n * q^exponent / qpoch_n^3
%o A400285     return (qpoch_inf * S).add_bigoh(N+1)
%o A400285 def A400285List(N):
%o A400285     J = J0m1_series(N)
%o A400285     return [J[n] for n in range(N+1)]
%o A400285 L = A400285List(51); print(L)
%Y A400285 Cf. A301735 (J_0), A400284 (J_1), A400283.
%K A400285 sign,new
%O A400285 0,2
