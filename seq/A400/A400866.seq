%S A400866 1,5,25,41,101,125,205,505,625,809,821,1025,1681,2525,3125,4045,4105,
%T A400866 4141,5125,6473,7001,8101,8405,10169,10201,12625,15625,16421,20201,
%U A400866 20225,20525,20705,25625,25889,28001,32321,32365,33169,33661,35005,40505,42025,50845,51005
%N A400866 Numbers k such that the trajectory of k->ord(-4,k) reaches 1 before reaching a number not coprime to -4. Here ord(b,k) is the multiplicative order of b modulo k.
%C A400866 Closed under multiplication; see A400096 for details.
%H A400866 Jianing Song, <a href="/A400866/b400866.txt">Table of n, a(n) for n = 1..4279</a> (all terms <= 10^10)
%F A400866 Powers of 5 are terms: 5^n -> 5^(n-1) -> ... -> 5 -> 1;
%F A400866 809 is a term: 809 -> 101 -> 25 -> 5 -> 1;
%F A400866 821 is a term: 821 -> 205 -> 5 -> 1;
%F A400866 If p is any prime factor of (2^82 + 1)/5, then p is a term: p -> 41 -> 5 -> 1.
%t A400866 (* okQ is defined at A400096 *)
%t A400866 Select[Range[60000], okQ[#, -4] &] (* _Paolo Xausa_, Nov 26 2026 *)
%o A400866 (PARI) isok(n, -4) \\ see A400096 for isok
%Y A400866 See A400096 for list of sequences in other bases.
%K A400866 nonn,new
%O A400866 1,2
