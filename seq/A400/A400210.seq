%I A400210 #22 Nov 03 2026 13:51:54
%S A400210 0,2,2,6,4,10,6,14,10,16,10,26,12,22,20,30,16,36,18,40,28,34,22,58,28,
%T A400210 40,36,54,28,68,30,62,44,52,44,88,36,58,52,88,40,92,42,82,72,70,46,
%U A400210 122,54,90,68,96,52,116,68,118,76,88,58,164,60,94,98,126,80,140,66,124
%N A400210 a(n) = sigma(n) - tau(m) where m is the largest odd divisor of positive integer n, sigma = A000203 and tau = A000005.
%C A400210 All terms are even.
%C A400210 James Tattersall asks to show this property (see reference).
%C A400210 Proof:
%C A400210 We have to prove that sigma(n)-tau(m) == 0 (mod 2).
%C A400210 As m is the largest odd divisor of the positive integer n, we can write n = 2^k * m with some k >= 0.
%C A400210 Since sigma is multiplicative: sigma(n) = sigma(2^k) * sigma(m) = (2^(k+1) - 1) * sigma(m).
%C A400210 As (2^(k+1) - 1) is odd, we get sigma(n) == sigma(m) (mod 2)  (1)
%C A400210 As m is odd, all its divisors are odd; so the sum sigma(m) of its divisors has same parity of their number tau(m): sigma(m) == tau(m) (mod 2)  (2)
%C A400210 Conclusion: from congruences (1) and (2), we get sigma(n) == tau(m) (mod 2) <==> sigma(n) - tau(m) == 0 (mod 2).
%D A400210 James J. Tattersall, Elementary Number Theory in Nine Chapters, Cambridge University Press, 1999, problem 38 p. 95.
%F A400210 a(2^k * m) = a(m) + 2*(2^k-1)*sigma(m).
%F A400210 For p odd prime, a(p) = p-1.
%F A400210 For r = 2^k, k >= 0, a(r) = 2*(r-1).
%F A400210 a(n) = A000203(n) - A001227(n).
%F A400210 a(n) = 2 * A086670(n).
%e A400210 12 = 3 * 4; sigma(12) = 1+2+3+4+6+12 = 28, tau(3) = 2, and a(12) = 28-2 = 26.
%t A400210 a[n_] := DivisorSigma[1, n] - DivisorSigma[0, n/2^IntegerExponent[n, 2]]; Array[a, 68] (* _Amiram Eldar_, Oct 27 2026 *)
%Y A400210 Cf. A000005, A000203, A001227, A086670.
%K A400210 nonn,new
%O A400210 1,2
%A A400210 _Bernard Schott_, Oct 27 2026
