%I A400485 #19 Oct 11 2026 20:21:07
%S A400485 1,3,3,7,6,6,13,21,15,25,18,15,14,14,29,45,31,49,34,27,24,23,23,47,36,
%T A400485 31,29,57,43,73,52,42,75,109,72,54,91,129,84,62,103,145,94,69,57,103,
%U A400485 75,123,86,68,119,171,112,83,69,125,91,149,104,82,143,205,134
%N A400485 a(1) = 1; for n > 1: if a(n-1) + n is odd, a(n) = a(n-1) + n else a(n) = (a(n-1) + n)/2.
%C A400485 Consecutive terms repeat when a(n-1) = n and such pairs occur for n = 3, 6, 14, 23, 211, 793, 8190, 8208. The next pair is at n = 62906549.
%C A400485 The value of a(n)/n appears to be bound between 1 and approximately 3.66. This range is also observed for sequences when a(1) is seeded with integers > 1 (except for initial terms).
%H A400485 James C. McMahon, <a href="/A400485/b400485.txt">Table of n, a(n) for n = 1..10000</a>
%H A400485 Vincenzo Manto, <a href="/A400485/a400485.png">a(n) vs n and phase of a(n) graphs</a>
%F A400485 Repeating values: when a(n-1) = n, a(n-1) + n = 2n (even), therefore, a(n) = 2n/2 = n. Additionally, when a(n-2) = n + 1, a(n-2) + (n-1) = 2n (even), therefore a(n - 1) = 2n/2 = n.
%e A400485 For n = 2: a(n-1) + n = 1 + 2 = 3 (odd), so a(2) = 3.
%e A400485 For n = 3: a(n-1) + n = 3 + 3 = 6 (even), so a(3) = 6/2 = 3.
%t A400485 s={1}; Do[If[OddQ[s[[-1]]+n],AppendTo[s,s[[-1]]+n],AppendTo[s,(s[[-1]]+n)/2]],{n,2,63}];s
%o A400485 (Python)
%o A400485 def generate_sequence(size, a1=1):
%o A400485   a = [0] * (size + 1)
%o A400485   a[1] = a1
%o A400485   for n in range(2, size + 1):
%o A400485     val = a[n - 1] + n
%o A400485     if val % 2 != 0:
%o A400485       a[n] = val
%o A400485     else:
%o A400485       a[n] = val // 2
%o A400485   return a[1:]
%o A400485 print(generate_sequence(63))
%Y A400485 Cf. A006370.
%K A400485 nonn,easy,new
%O A400485 1,2
%A A400485 _James C. McMahon_ and _Vincenzo Manto_, Sep 27 2026
