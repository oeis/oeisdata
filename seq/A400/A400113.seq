%S A400113 1,3,6,1,6,0,3,11,20,5,16,2,5,19,34,9,26,4,7,27,48,13,36,6,9,35,62,17,
%T A400113 46,8,11,43,76,21,56,10,13,51,90,25,66,12,15,59,104,29,76,14,17,67,
%U A400113 118,33,86,16,19,75,132,37,96,18,21,83,146,41,106,20,23,91,160,45
%N A400113 a(1) = 1; for n > 1: if a(n-1) is odd, a(n) = a(n-1) + n else a(n) = floor(abs(a(n-1) - n)/2).
%C A400113 The value of a(n)/n, for n >= 10, appears to be bounded between 1/6 and 7/3.
%C A400113 It appears that sequences seeded with initial values a(1) > 1 eventually merge into the same trajectory after a finite number of steps.
%H A400113 Vincenzo Manto, <a href="/A400113/b400113.txt">Table of n, a(n) for n = 1..10000</a>
%H A400113 Vincenzo Manto, <a href="/A400113/a400113.png">a(n) vs n and phase of a(n) graphs</a>.
%F A400113 When a(n-1) is odd, a(n) = a(n-1) + n. When a(n-1) is even, a(n) = floor(abs(a(n-1) - n)/2).
%e A400113 For n = 2: a(1) is odd (1), so a(2) = 1 + 2 = 3.
%e A400113 For n = 3: a(2) is odd (3), so a(3) = 3 + 3 = 6.
%e A400113 For n = 4: a(3) is even (6), so a(4) = abs(6 - 4)/2 = 2/2 = 1.
%e A400113 For n = 6: a(5) is even (6), so a(6) = abs(6 - 6)/2 = 0.
%t A400113 s={1};Do[If[OddQ[s[[-1]]],AppendTo[s,s[[-1]]+n],AppendTo[s,Quotient[Abs[s[[-1]]-n],2]]],{n,2,70}];s
%o A400113 (Python)
%o A400113 def generate_sequence(size, a1=1):
%o A400113   a = [0] * (size + 1)
%o A400113   a[1] = a1
%o A400113   for n in range(2, size + 1):
%o A400113     prev = a[n - 1]
%o A400113     if prev % 2 != 0:
%o A400113       a[n] = prev + n
%o A400113     else:
%o A400113       a[n] = abs(prev - n) // 2
%o A400113   return a[1:]
%o A400113 print(generate_sequence(70))
%Y A400113 Cf. A400485, A006370.
%K A400113 nonn,easy,new
%O A400113 1,2
