%I A400828 #21 Oct 08 2026 08:35:35
%S A400828 1,2,6,21,138,375,950,1815,2170,14090,38962,40050,296199,508130,
%T A400828 1213250,2616625,8171841,18112694,26128245,64965330,111698550,
%U A400828 211448466,630097027
%N A400828 Least number whose (n-1)-th arithmetic derivative (A003415) is one, and for n > 1, the (n-2)-th derivative, which by necessity is prime, is distinct from the corresponding primes that occur for all other terms of the sequence.
%C A400828 The sequence is monotonic by definition.
%F A400828 For n >= 1, a(n) >= A189760(n).
%e A400828 See triangle A400830 for an illustration.
%o A400828 (PARI)
%o A400828 A003415checked(n) = if(n<=1, 0, my(f=factor(n), s=0); for(i=1, #f~, if(f[i,2]>=f[i,1],return(0), s += f[i, 2]/f[i, 1])); (n*s));
%o A400828 is_kth_ad_prime(n,k) = { my(s=1); while(k && n>1, n = A003415checked(n); k--); if(isprime(n),n,0); };
%o A400828 primes_found = Map();
%o A400828 write("b400828.txt", 1, " ", 1);
%o A400828 k=1; for(n=2,31, my(x=0); for(t=1+x,oo,if(!(t%(2^26)),print1("("t")")); if((p=is_kth_ad_prime(t,n-2)) && !mapisdefined(primes_found,p), mapput(primes_found,p,t); x=t; break)); if(x, k++; write("b400828.txt", k, " ", x); write("b400829.txt", k, " ", p); print1(x,", ")));
%Y A400828 Leading column of triangle A400830.
%Y A400828 Cf. A003415, A400829 (corresponding primes for n > 1).
%Y A400828 Subsequence of A099308, thus also a subsequence of A048103.
%Y A400828 Cf. also A189760.
%K A400828 nonn,more,new
%O A400828 1,2
%A A400828 _Antti Karttunen_, Oct 07 2026
