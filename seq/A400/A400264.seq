%I A400264 #16 Oct 10 2026 16:24:20
%S A400264 1,125,343,625,2197,12167,28561,29791,50653,79507,103823,923521,
%T A400264 1225043,1442897,2048383,2825761,3418801,3442951,4330747,9393931,
%U A400264 11089567,12117361,12649337,13997521,16974593,25411681,31855013,36264691,38272753,51895117,62742241,81182737,86938307,99252847,163667323
%N A400264 Nonprime numbers k such that A400833(k) has no divisors of the form p^p, for any prime p.
%C A400264 Nonprime numbers k for which A400833(k) = A327859(k).
%C A400264 Appears to be a subsequence of A025475: consider A400173 as a Dirichlet convolution of A206369 and A349394.
%H A400264 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400264 {k such that A010051(k) = 0 and A359550(A400833(k)) = 1}.
%o A400264 (PARI)
%o A400264 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400264 A400173(n) = sumdiv(n, d, ((-1)^bigomega(d))*A003415(n/d));
%o A400264 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400264 A359550(n) = { my(pp); forprime(p=2, , pp = p^p; if(!(n%pp), return(0)); if(pp > n, return(1))); };
%o A400264 is_A400264(n) = if(isprime(n), 0, my(m=1); fordiv(n, d, if(issquarefree(d), m *= A276086(A400173(n/d)); if(!(m%4) || !A359550(m), return(0)))); A359550(m));
%Y A400264 Cf. A025475, A048103, A359550, A327859, A400833.
%Y A400264 Cf. also A380468.
%K A400264 nonn,new
%O A400264 1,2
%A A400264 _Antti Karttunen_, Oct 09 2026
