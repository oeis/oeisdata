%S A400875 -1,-1,-7,1,-1,-7,7,-7,-17,-23,7,-1,-1,-7,-17,23,1,-17,-31,-41,-47,17,
%T A400875 1,-7,-1,-23,-7,-31,47,17,-1,-31,-49,-7,-73,-79,31,7,-1,-7,-1,-17,-41,
%U A400875 -23,-49,79,41,7,-23,-49,-71,-89,-103,-113,-119,49,7,1,-1,-23,-1,-47,-7,-7,-17,-71
%N A400875 Array read by ascending antidiagonals: A(n,k) = numerator((n^2 - 2*n*k - k^2)/(n^2 + k^2)), with k > 0.
%C A400875 abs(A(n,k)/A400876(n,k)) is the square root of the ratio between (n^2 - 2*n*k - k^2)^2 and (n^2 + k^2)^2, respectively, the smallest and the middle perfect squares of the three perfect squares in arithmetic progression having common difference equal to 4*n*k*(n^2 - k^2) = 24*A399542(n,k).
%D A400875 Martin Erickson, Beautiful Mathematics, Mathematical Association of America, 2011, p. 94.
%H A400875 Stefano Spezia, <a href="/A400875/b400875.txt">Table of n, a(n) for n = 1..11325</a> (first 150 antidiagonals, flattened)
%e A400875 The array of fractions begins as:
%e A400875      -1,  -7/5,   -7/5, -23/17, -17/13, -47/37, ...
%e A400875    -1/5,    -1, -17/13,   -7/5, -41/29,   -7/5, ...
%e A400875     1/5, -7/13,     -1, -31/25, -23/17,   -7/5, ...
%e A400875    7/17,  -1/5, -17/25,     -1, -49/41, -17/13, ...
%e A400875    7/13,  1/29,  -7/17, -31/41,     -1, -71/61, ...
%e A400875   23/37,   1/5,   -1/5,  -7/13, -49/61,     -1, ...
%e A400875   17/25, 17/53,  -1/29, -23/65, -23/37, -71/85, ...
%e A400875   ...
%e A400875 For n = 7 and k = 5, (-23/37)^2 = 2116/5476 = 46^2/74^2 with 74^2 - 46^2 = 4*7*5*(7^2 - 5^2) = = 24*A399542(7,5).
%t A400875 A[n_,k_]:=Numerator[(n^2-2*n*k-k^2)/(n^2+k^2)]; Table[A[n-k+1,k],{n,11},{k,n}]//Flatten
%Y A400875 Cf. A057428 (main diagonal), A399542, A400876 (denominators).
%K A400875 sign,easy,frac,look,tabl,changed
%O A400875 1,3
%A A400875 _Stefano Spezia_, Oct 08 2026
