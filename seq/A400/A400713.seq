%U A400713 2,2,2,1,2,2,2,2,1,2,2,2,1,1,2,1,2,2,2,2,2,1,3,2,4,4,2,2,1,2,3,1,2,3,2,1,3,2,1,2,2,3,2,4
%N A400713 Let b(k) denote A377091(k). A "crossing" in A377091 is a pair of terms b(k), b(k+1) with opposite signs, and the "root" of this crossing is sqrt(|b(k)-b(k+1)|); then a(n) = number of crossings with root n.
%C A400713 The values k such that b(k),b(k+1) is a crossing are listed in A400714, and A379797 lists the corresponding roots.
%C A400713 No term is bigger than 4. A proof is in preparation, as a by-product of a (under review, not yet published) proof that A377091 is a permutation of the integers. - _Paolo Xausa_, Nov 12 2026
%H A400713 N. J. A. Sloane, <a href="/A400713/b400713.txt">Table of n, a(n) for n = 1..1385</a>
%H A400713 N. J. A. Sloane, <a href="/A400713/a400713.jpg">Table showing the first 27 crossings.</a> [Here a(n) is A377091(n). The first four columns specify the crossing, and the fifth column (A379797) is the root. The first column, A400714, is an interleaving of A379790 and A380837; the second column is an interleaving of A379791 and A379794; and the fourth column is an interleaving of A379789 and A379793. Hand-written table!]
%t A400713 (* A377091list is defined at A377091 *)
%t A400713 A400713list[upto_] := Module[{A377091 = A377091list[upto], cross, roots},
%t A400713   cross = Flatten[Position[Sign[Most[A377091]*Rest[A377091]], -1]];
%t A400713   If[cross == {}, {},
%t A400713     roots = Sqrt[Abs[Differences[A377091]]][[cross]];
%t A400713     Table[Lookup[Counts[roots], n, 0], {n, Max[roots] - 1}]
%t A400713   ]
%t A400713 ];
%t A400713 A400713list[10000] (* _Paolo Xausa_, Nov 12 2026 *)
%Y A400713 Cf. A377091, A379728-A379795, A379797, A380337, A400106, A400714.
%K A400713 nonn,new
%O A400713 1,2
%A A400713 _N. J. A. Sloane_, Nov 12 2026
