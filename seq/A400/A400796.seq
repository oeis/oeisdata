%I A400796 #17 Oct 13 2026 20:57:10
%S A400796 0,1,0,1,4,5,8,9,12,17,20,25,28,33,40,45,52,57,64,73,80,89,96,105,116,
%T A400796 125,136,145,156,169,180,193,204,217,232,245,260,273,288,305,320,337,
%U A400796 352,369,388,405,424,441,460,481,500,521,540,561,584,605,628,649
%N A400796 a(n) = (n^2 + 4*Legendre(n,5))/5.
%C A400796 a(n) is always an integer, and a(n) - n^2/5 = (4/5)*Legendre(n,5) is 0, 4/5 or -4/5.
%C A400796 Conversely, for n >= 1, a(n) is a perfect square if and only if n is a Lucas number.
%H A400796 Lluis Garcia Torcal, <a href="/A400796/b400796.txt">Table of n, a(n) for n = 0..10000</a>
%H A400796 Lluis Garcia Torcal, <a href="https://doi.org/10.5281/zenodo.23183108">The Pentametric Cycle: A Nested Palindrome Encoding the Pythagorean Consonances</a>, preprint, Zenodo, 2026.
%H A400796 Lluis Garcia Torcal, <a href="https://github.com/lluisgarcia/The-Pentametric-Cycle">The Pentametric Cycle</a>, GitHub repository with paper, proofs and data, 2026.
%H A400796 Herbert L. Holden, <a href="https://www.mathstat.dal.ca/FQ/Scanned/13-1/holden.pdf">Fibonacci tiles</a>, Fibonacci Quarterly 13 (1975), 45-49.
%H A400796 <a href="/index/Rec#order_07">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,0,0,1,-2,1).
%F A400796 a(n) = (n^2 + 4*A080891(n))/5.
%F A400796 a(n) = A118015(n) + [n == 1 or 4 (mod 5)], where [] is the Iverson bracket.
%F A400796 a(n) = (n^2 + (8/sqrt(5))*(cos(2*Pi*n/5) - cos(4*Pi*n/5)))/5.
%F A400796 a(n) = 2*a(n-1) - a(n-2) + a(n-5) - 2*a(n-6) + a(n-7) for n >= 7.
%F A400796 G.f.: x*(1 + x)*(1 - 3*x + 5*x^2 - 3*x^3 + x^4)/((1-x)^2*(1-x^5)).
%F A400796 a(A000032(k)) = A007598(k).
%e A400796 a(7) = (49 + 4*Legendre(7,5))/5 = (49 - 4)/5 = 9. Since 7 = L(4), this equals F(4)^2 = 3^2.
%e A400796 a(6) = (36 + 4)/5 = 8, which is not a square, since 6 is not a Lucas number.
%p A400796 a := n -> (n^2 + 4*[0, 1, -1, -1, 1][(n mod 5) + 1])/5:
%p A400796 seq(a(n), n = 0..57);
%t A400796 Table[(n^2 + 4 JacobiSymbol[n, 5])/5, {n, 0, 57}]
%o A400796 (PARI) a(n) = (n^2 + 4*kronecker(n, 5))/5;
%o A400796 (Python) def a(n): return (n*n + 4*(0, 1, -1, -1, 1)[n % 5])//5
%Y A400796 Cf. A000032, A000045, A007598, A080891, A118015, A400797.
%K A400796 nonn,easy
%O A400796 0,5
