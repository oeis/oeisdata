%U A400251 972,1024,1089,1125,1156,1225,1323,1331,1369,1372,1444,1521,1600,1681,1728,1764,1849,1936,2000,2116,2197,2209,2304,2401,2500
%N A400251 Numbers k for which A400249(k) is not zero, where A400249 is Möbius transform of A085731, with A085731(n) = gcd(n,n'), and n' the arithmetic derivative of n.
%C A400251 Numbers k such that, for each prime divisor p with exponent e in the prime factorization of k, e is not congruent to 1 (mod p). - _Amiram Eldar_, Sep 24 2026
%H A400251 Antti Karttunen, <a href="/A400251/b400251.txt">Table of n, a(n) for n = 1..10000</a>
%F A400251 Sum_{n>=1} 1/a(n) = Product_{p prime} (p/(p-1) - 1/(p-1/p^(p-1))) = zeta(2) * Product_{p prime} (1 + (p^(p-2)-1)/(p*(p^p-1))) = 1.7085517387... . - _Amiram Eldar_, Sep 24 2026
%F A400251 {k such that A400249(k) > 0}.
%t A400251 q[n_] := n == 1 || AllTrue[FactorInteger[n], !Divisible[Last[#] - 1, First[#]] &]; Select[Range[2500], q] (* _Amiram Eldar_, Sep 24 2026 *)
%o A400251 (PARI) is_A400251(n) = { my(f = factor(n)); for(i=1, #f~, if(1==(f[i, 2] % f[i, 1]), return(0))); (1); };
