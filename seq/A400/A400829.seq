%I A400829 #12 Oct 08 2026 08:35:45
%S A400829 2,5,7,13,71,31,41,103,401,113,191,73,1031,439,19,101,251,61,2531,739,
%T A400829 2411,1723
%N A400829 The (n-2)-th arithmetic derivative of A400828(n): a(n) = A003415^(n-2)(A400828(n)).
%C A400829 The penultimate strictly positive term in the sequence of successive derivatives starting from A400828(n). These are by necessity primes, all distinct by definition of A400828.
%F A400829 For n > 2, a(n) = A327968(A400828(n)).
%o A400829 (PARI)
%o A400829 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400829 A400829(n) = { my(k=n-2); n = A400828(n); while(k, n = A003415(n); k--); (n); };
%Y A400829 Penultimate diagonal of A400830.
%Y A400829 Cf. A003415, A327968, A400828.
%K A400829 nonn,more,new
%O A400829 2,1
%A A400829 _Antti Karttunen_, Oct 07 2026
