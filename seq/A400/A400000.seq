%F A400000 Conjecture: limsup_{n->oo} (Sum_{k=1..n} a(k))/n <= 3. See A397740. - _Paolo Xausa_, Sep 28 2026
%e A400000 For n = 8:
%e A400000 A height of 0 would see a(6)=2 and a(7)=1, but must see 0 other buildings.
%e A400000 A height of 1 would see a(6)=2 and a(7)=1, but must see 1 other building.
%e A400000 A height of 2 would see a(4)=2, a(6)=2, and a(7)=1, but must see 2 other buildings.
%e A400000 A height of 3 sees a(4)=2, a(6)=2, and a(7)=1, exactly 3 other buildings, so a(8)=3.
%e A400000                   *
%e A400000           *   *   *
%e A400000       * * * * * * *
%e A400000 n = 1 2 3 4 5 6 7 8
%t A400000 A400000list = Compile[{{nmax, _Integer}},
%t A400000   Module[{a = ConstantArray[0, nmax], h, c, i, dx0, dy0, dy},
%t A400000     Do[h = 1;
%t A400000       While[c = dx0 = dy0 = 0; i = 1;
%t A400000         While[i < n && c <= h,
%t A400000           dy = a[[n - i]] - h; If[dx0*dy >= i*dy0, c++; If[c <= h, dx0 = i; dy0 = dy]]; i++];
%t A400000         c != h, h++];
%t A400000       a[[n]] = h, {n, 2, nmax}]; a]];
%t A400000 A400000list[100] (* _Paolo Xausa_, Sep 27 2026, after _Pontus von Brömssen_ *)
%o A400000 (C#) // See Links section.
%o A400000 (Python)
%o A400000 from itertools import count
%o A400000 def A400000_generator():
%o A400000     a_list = []
%o A400000     while 1:
%o A400000         for a in count():
%o A400000             c = dx0 = dy0 = 0
%o A400000             for dx,y in enumerate(reversed(a_list),1):
%o A400000                 dy = y-a
%o A400000                 if dx0*dy >= dx*dy0:
%o A400000                     c += 1
%o A400000                     if c > a: break
%o A400000                     dx0,dy0 = dx,dy
%o A400000             else:
%o A400000                 if c == a: break
%o A400000         yield a
%o A400000         a_list.append(a) # _Pontus von Brömssen_, Sep 24 2026
%Y A400000 Cf. A399763 (indices of the first appearances of each height).
