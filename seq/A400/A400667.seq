%T A400667 313,321,325,351,363,373,375,381,409,425,435,443,457,471,477,493,501,
%U A400667 531,561,583,617,627,665,669,673,677,703,731,785,793,801,823,833,841,843,855,861,885,913,943,963,981,993
%N A400667 Odd numbers k for which the sum of digits equals the product of digits in at least one base b from 4 to floor(sqrt(k)).
%C A400667 Also known as "spy numbers".
%C A400667 Restricted to odd numbers: every even n >= 8 trivially has the 2-digit representation "22" in base b = n/2 - 1, since 2 + 2 = 2 * 2 = 4.
%C A400667 Odd terms require >= 3 digits because the unique positive integer solution to d_1 + d_0 = d_1 * d_0 is d_1 = d_0 = 2, which forces n to be even. Hence, for odd n, any valid base must satisfy b <= floor(sqrt(n)).
%C A400667 No nontrivial solutions exist in base 2 or base 3 (excluding n = 1): in base 2 the product of nonzero digits is always 1, while in base 3 the exponential growth of the product prevents nontrivial equality with the sum.
%C A400667 Solutions occur predominantly in even bases, though odd bases are possible (e.g., 793 = 11313_5, where sum=product=9).
%H A400667 GeeksforGeeks, <a href="https://www.geeksforgeeks.org/javascript/build-a-spy-number-checker-with-html-css-and-javascript/">Build a Spy Number Checker using HTML CSS and JavaScript</a>.
%e A400667 27 is in the sequence because in base 4 it is written as 123 (1*16 + 2*4 + 3 = 27). The sum of the digits is 1+2+3 = 6, and the product of the digits is 1*2*3 = 6.
%e A400667 793 is in the sequence because in base 5 it is written as 11313 (1*625 + 1*125 + 3*25 + 1*5 + 3 = 793). The sum of the digits is 1+1+3+1+3 = 9, and the product of the digits is 1*1*3*1*3 = 9.
%t A400667 Select[Range[1000], Function[n, Mod[n, 2] == 1 && AnyTrue[Range[4, Floor[Sqrt[n]]], Function[b, With[{digits = IntegerDigits[n, b]}, And[FreeQ[digits, 0], Total[digits] == Times @@ digits]]]]]]
%o A400667 (Python)
%o A400667 import math
%o A400667 def is_spy_in_base(n, base):
%o A400667     digits = []
%o A400667     temp = n
%o A400667     while temp > 0:
%o A400667         digits.append(temp % base)
%o A400667         temp //= base
%o A400667     if 0 in digits:
%o A400667         return False
%o A400667     digit_sum = sum(digits)
%o A400667     digit_product = 1
%o A400667     for d in digits:
%o A400667         digit_product *= d
%o A400667     return digit_sum == digit_product
%o A400667 def list_odd_spy_numbers(limit):
%o A400667     result = []
%o A400667     for n in range(1, limit + 1, 2):
%o A400667         max_base = math.isqrt(n)
%o A400667         for b in range(4, max_base + 1):
%o A400667             if is_spy_in_base(n, b):
%o A400667                 result.append(n)
%o A400667                 break
%o A400667     return result
%o A400667 (PARI) isok(k) = if (k%2, sum(b=4, sqrtint(k), my(d=digits(k, b)); vecsum(d) == vecprod(d)) >= 1); \\ _Michel Marcus_, Oct 09 2026
%Y A400667 Cf. A034710 (base 10).
