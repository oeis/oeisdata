%I A400450 #8 Oct 02 2026 00:06:34
%S A400450 0,0,0,1,0,0,0,2,1,0,0,2,0,0,0,2,0,2,0,2,0,0,0,4,1,0,2,2,0,0,0,2,0,0,
%T A400450 0,4,0,0,0,4,0,0,0,2,2,0,0,4,1,2,0,2,0,4,0,4,0,0,0,4,0,0,2,2,0,0,0,2,
%U A400450 0,0,0,6,0,0,2,2,0,0,0,4,2,0,0,4,0,0,0,4,0,4
%N A400450 The number of divisors d of n such that gcd(d, n/d) is prime.
%C A400450 a(n) depends only on the prime signature of n (A118914).
%H A400450 Amiram Eldar, <a href="/A400450/b400450.txt">Table of n, a(n) for n = 1..10000</a>
%F A400450 a(n) = A007875(n) * b(n), where b(n) is an additive function with b(p^e) = min(e-1, 2).
%F A400450 a(n) = 0 if and only if n is squarefree (A005117).
%F A400450 a(n) = 1 if and only if n is a square of a prime (A001248).
%t A400450 f[e_] := Min[e - 1, 2]; a[1] = 0; a[n_] := (Total[f /@ #[[;; , 2]]]*2^(Length[#] - 1))& @ FactorInteger[n]; Array[a, 100]
%o A400450 (PARI) a(n) = {my(e = factor(n)[,2]); 2^(#e-1) * vecsum(apply(x -> min(x-1, 2), e));}
%Y A400450 Cf. A001248, A005117, A007875, A118914, A400390, A400451 (distinct values).
%Y A400450 The number of divisors d of n such that gcd(d, n/d) is: A034444 (1), A069733 (odd), A365171 (square), A365173 (exponentially odd), A365207 (power of 2), A365208 (3-smooth), A365210 (5-rough), A369310 (powerful), this sequence (prime), A400452 (prime power).
%K A400450 nonn,easy,new
%O A400450 1,8
%A A400450 _Amiram Eldar_, Sep 26 2026
