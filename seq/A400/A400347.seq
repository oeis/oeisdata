%I A400347 #25 Oct 01 2026 14:56:41
%S A400347 2,3,7,43,13,547,11,463,5,31,930931,101081,199,7965968011,
%T A400347 339145584810391,71,2842129291,19,17,97,397,425458009,20434830440461,
%U A400347 625718039318369143651868149403,844055391432854015436971848972209558112455979,41,53,28096209351211,163
%N A400347 a(1) = 2; a(n+1) is the least prime factor of 1 + Product_{k=1..n, a(k)<=a(n)} a(k) which is not yet in the sequence.
%C A400347 A variant of the Euclid-Mullin sequence A000945.
%C A400347 It is not proven that there is always at least one prime factor that is not yet in the sequence (this is not trivial because of the way we exclude certain values already in the sequence when forming the product for term n).
%H A400347 Tesfamichael Bogale, <a href="/A400347/b400347.txt">Table of n, a(n) for n = 1..77</a>
%H A400347 Wikipedia, <a href="https://en.wikipedia.org/wiki/Euclid%E2%80%93Mullin_sequence">Euclid-Mullin sequence</a>.
%e A400347 a(1) = 2.
%e A400347 Active set {2}. N = 2+1 = 3, so a(2) = 3.
%e A400347 Active set {2, 3, 7}. N = 2*3*7 + 1 = 43, so a(4) = 43.
%e A400347 Active set {2, 3, 7, 43}. N = 2*3*7*43 + 1 = 1807 = 13 * 139., so a(5) = 13.
%e A400347 Active set {2, 3, 7, 13}. N = 2*3*7*13 + 1 = 547, so a(6) = 547.
%e A400347 Active set {2, 3, 7, 13, 43, 547}. N = 2*3*7*13*43*547 + 1 = 12842467 = 11 * 1167497, so a(7) = 11.
%e A400347 ...
%o A400347 (Python)
%o A400347 from sympy import factorint
%o A400347 def smallest_new_prime_factor(n, discovered):
%o A400347     remainder = n
%o A400347     while True:
%o A400347         f = min(factorint(remainder).keys())
%o A400347         if f not in discovered:
%o A400347             return f
%o A400347         while remainder % f == 0:
%o A400347             remainder //= f  # discard a previously-seen prime, keep searching
%o A400347 def a_list(N):
%o A400347     seq = [2, 3]
%o A400347     while len(seq) < N:
%o A400347         endpoint = seq[-1]
%o A400347         active = [p for p in seq if p <= endpoint]
%o A400347         n = 1
%o A400347         for p in active:
%o A400347             n *= p
%o A400347         n += 1
%o A400347         seq.append(smallest_new_prime_factor(n, set(seq)))
%o A400347     return seq[:N]
%o A400347 print(a_list(15))
%Y A400347 Cf. A000945, A020639.
%K A400347 nonn,hard,new
%O A400347 1,1
