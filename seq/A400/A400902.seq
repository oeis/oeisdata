%I A400902 #8 Oct 09 2026 08:46:31
%S A400902 65,133,301,561,793,1105,1729,2041,2413,2465,2501,2701,2821,3781,4699,
%T A400902 5617,5963,6601,7081,7107,7991,8911,9073,9881,9937,10261,10349,10585,
%U A400902 12209,13213,13333,14111,14981,15841,18721,20737,24727,27133,29341,31201,31621,35431
%N A400902 Semi-Carmichael numbers: composite numbers k such that d^k == d (mod k) for every divisor d of k.
%C A400902 Equivalently, composite numbers k such that p^k == p (mod k) for every prime divisor p of k.
%C A400902 All the terms are squarefree (A005117).
%C A400902 All the Carmichael numbers (A002997) are terms.
%H A400902 Amiram Eldar, <a href="/A400902/b400902.txt">Table of n, a(n) for n = 1..4000</a>
%H A400902 Miguel Ángel López, <a href="https://arxiv.org/abs/2610.09129">Idempotence in Carmichael and Giuga numbers and its application to the Agoh-Giuga conjecture</a>, arXiv:2610.09129 [math.NT], 2026. See p. 20.
%t A400902 q[k_] := CompositeQ[k] && Module[{f = FactorInteger[k]}, Max[f[[;; , 2]]] == 1 && AllTrue[f[[;; , 1]], PowerMod[#, k, k] == # &]]; Select[Range[40000], q]
%o A400902 (PARI) isok(k) = if(k == 1 || isprime(k), 0, my(f = factor(k)); if(!issquarefree(f), return(0)); for(i = 1, #f~, if(Mod(f[i, 1], k)^k != f[i, 1], return(0))); 1);
%Y A400902 Subsequence of A005117.
%Y A400902 Subsequences: A002997, A400903.
%K A400902 nonn,new
%O A400902 1,1
%A A400902 _Amiram Eldar_, Oct 08 2026
