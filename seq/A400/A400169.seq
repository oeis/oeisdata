%I A400169 #12 Sep 23 2026 08:49:56
%S A400169 1,2,3,4,5,6,7,11,12,13,14,17,18,19,20,21,22,23,26,27,29,31,33,34,35,
%T A400169 37,38,39,41,43,46,47,49,51,53,55,57,59,60,61,62,64,65,66,67,68,69,70,
%U A400169 71,72,73,74,76,77,78,79,80,82,83,84,85,86,88,89,90,91,92,93,94,95,97,98,99,100,101,102,103,104,105
%N A400169 Numbers k such that A235224(A003415(k)) = A400164(k), where A235224 is the length of primorial base representation, A400164(n) = Max_{d|n, d is a prime power} A235224(n/d), and A003415 is the arithmetic derivative.
%C A400169 Numbers k such that the greatest prime dividing A327859(k) is equal to A400165(k), the greatest prime dividing A380459(k).
%C A400169 Indices of such rows in arrays A400250 and A400260 where their rightmost nonzero elements occur in the same column, i.e., where the primorial base carry resolving (see A392879, A400157) does not propagate the carry beyond the original gpf-position of A380459(k).
%H A400169 Antti Karttunen, <a href="/A400169/b400169.txt">Table of n, a(n) for n = 1..10000</a>
%H A400169 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400169 {k such that A400164(k) = A400262(k)}.
%F A400169 {k such that A006530(A327859(k)) = A006530(A380459(k)}.
%o A400169 (PARI)
%o A400169 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400169 A235224(n) = { my(s=0, p=2); while(n, s++; n = n\p; p = nextprime(1+p)); (s); };
%o A400169 A400164(n) = { my(m=0); fordiv(n, d, if(isprimepower(d), m = max(m,A235224(n/d)))); (m); };
%o A400169 is_A400169(k) = (A235224(A003415(k))==A400164(k));
%Y A400169 Positions of 0's in A400168.
%Y A400169 Cf. A003415, A006530, A235224, A327859, A380459, A392879, A400157, A400164, A400165, A400262, A400170 (complement).
%Y A400169 Subsequences: A380468.
%Y A400169 Cf. arrays A400250 and A400260.
%Y A400169 Cf. also A400167.
%K A400169 nonn,new
%O A400169 1,2
%A A400169 _Antti Karttunen_, Sep 23 2026
