%S A400707 1,2,1,1,2,1,2,2,2,3,1,1,2,1,1,2,2,2,3,1,1,2,1,2,2,2,3,1,1,2,2,2,3,1,
%T A400707 2,1,1,2,1,2,2,2,3,1,1,2,1,1,2,2,2,3,1,1,2,1,2,2,2,3,1,1,2,2,2,3,2,1,
%U A400707 1,2,1,1,2,2,2,3,1,1,2,1,1,2,2,2,3,2,1,1,2,1,1,2,2,2,3,1,1,2,2,2,3,2,1,1,2,1,1,2,2,2,3
%N A400707 A variant of Gijswijt's sequence A090822, starting with 1,2 instead of 1.
%C A400707 Start with S = [1,2] and extend S by appending its curling number; repeat.
%C A400707 Wenlin Zhang (Oct 03 2026) made the surprising discovery that this sequence never merges with Gijswijt's sequence.
%C A400707 The first 4 in Gijswijt's sequence appears at term 220. In the present sequence, 4 first appears at term 727.
%D A400707 Wenlin Zhang, Emails to N. J. A. Sloane, Oct 03 2026 and later.
%H A400707 Michael S. Branicky, <a href="/A400707/b400707.txt">Table of n, a(n) for n = 1..24000</a> (first 2000 terms from N. J. A. Sloane)
%H A400707 Benjamin Chaffin, John P. Linderman, N. J. A. Sloane, and Allan R. Wilks, <a href="https://arxiv.org/abs/1212.6102">On Curling Numbers of Integer Sequences</a>, arXiv:1212.6102 [math.CO], Dec 25 2012.
%H A400707 Benjamin Chaffin, John P. Linderman, N. J. A. Sloane, and Allan R. Wilks, <a href="https://cs.uwaterloo.ca/journals/JIS/VOL16/Sloane/sloane3.html">On Curling Numbers of Integer Sequences</a>, J. Int. Seq. 16 (2013), Art. 13.4.3.
%H A400707 Benjamin Chaffin and N. J. A. Sloane, <a href="https://neilsloane.com/doc/CNC.pdf">The Curling Number Conjecture</a>, preprint.
%t A400707 Reverse[Nest[Prepend[#, Max[Table[Length[First[Split[Partition[#, k]]]], {k, Length[#]/2}]]] &, {2, 1}, 100]] (* _Paolo Xausa_, Oct 08 2026 *)
%o A400707 (Python)
%o A400707 from itertools import count, islice
%o A400707 def k(s):
%o A400707     maxk = 1
%o A400707     for m in range(1, len(s)+1):
%o A400707         i, y, kk = 1, s[-m:], len(s)//m
%o A400707         if kk <= maxk: return maxk
%o A400707         while s[-(i+1)*m:-i*m] == y: i += 1
%o A400707         maxk = max(maxk, i)
%o A400707 def agen(): # generator of terms
%o A400707     alst = [1, 2]
%o A400707     yield from alst
%o A400707     for n in count(3):
%o A400707         an = k(alst)
%o A400707         alst.append(an)
%o A400707         yield an
%o A400707 print(list(islice(agen(), 50))) # _Michael S. Branicky_, Oct 08 2026
%Y A400707 Cf. A090822.
%K A400707 nonn,new
%O A400707 1,2
%A A400707 _N. J. A. Sloane_, Oct 07 2026
