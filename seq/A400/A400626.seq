%I A400626 #7 Oct 04 2026 15:40:16
%S A400626 1,1,1,1,4,6,28,58,320,905,5811,21086,169473
%N A400626 Number of connected self-dual unlabeled posets on n elements.
%C A400626 A poset is self-dual if it is isomorphic to its dual poset.
%F A400626 Let D(x) = Sum_{n>=0} A133983(n)*x^n and b(n) = A000608(n). Then
%F A400626 D(x) = Product_{n>=1} (1+x^n)^((a(n)-b(n))/2)/(1-x^n)^((a(n)+b(n))/2).
%F A400626 a(n) = 2*A323658(n) - A000608(n).
%e A400626 For n = 4, among the 10 connected unlabeled posets (A000608(4)), 4 are self-dual, so a(4) = 4.
%Y A400626 Cf. A000608, A133983, A323658.
%K A400626 nonn,more,new
%O A400626 0,5
%A A400626 _Vladeta Jovovic_, Oct 01 2026
