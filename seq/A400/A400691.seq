%I A400691 #22 Nov 13 2026 16:25:09
%S A400691 1,-28,692,-16496,388326,-9087920,211983848,-4934664640,114717314701,
%T A400691 -2664371218728,61839675069468,-1434566545354432,33266445685780334,
%U A400691 -771188749114541408,17873521172342398392,-414166114477724141312,9595534264106417828370
%N A400691 a(n) = c_4(n)/n, where c_4(n) are the Fourier coefficients of the level-2 K3 meromorphic modular form C_4 defined below.
%C A400691 Bönisch, Duhr and Maggio introduced C_4 and conjectured that it is magnetic of depth 1. Shvets proved the stronger denominator-one statement n | c_4(n) for every n >= 1 (Theorem 1.1 and Corollary 3.3), so a(n) is always an integer.
%C A400691 Weight-4 member of the level-2 K3 packet; A398383 and A398901 are the two weight-6 members (c_6a(n)/n^2 and c_6b(n)/n^2). A398186 encodes the same depth-one statement in the Hauptmodul coordinate x instead of q.
%C A400691 It appears that (-1)^(n+1)*a(n) > 0 and that 2^(2*r) divides a(2^r*m) for odd m (equivalently 2^(3*r) | c_4(2^r*m)); both verified for n <= 200.
%H A400691 Alex Shvets, <a href="/A400691/b400691.txt">Table of n, a(n) for n = 1..200</a>
%H A400691 Kilian Bönisch, Claude Duhr and Sara Maggio, <a href="https://arxiv.org/abs/2404.04085">Some conjectures around magnetic modular forms</a>, arXiv:2404.04085 [math.NT], 2024.
%H A400691 Alex Shvets, <a href="https://arxiv.org/abs/2607.19427">Integral magneticity of the level-two K3 packet: CM theta lifts and a 2-isogeny trace contraction</a>, arXiv:2607.19427 [math.NT], 2026.
%F A400691 a(n) = (1/n)*[q^n] C_4(q), where C_4(q) = t(q)*H(q)^4/(1 + 64*t(q)), t(q) = Sum_{k>=1} A014103(k)*q^k, and H(q) = Sum_{k>=0} A104794(k)*q^k.
%F A400691 a(n) ~ (-1)^(n+1) * exp(Pi*n) / 16. - _Vaclav Kotesovec_, Nov 01 2026
%e A400691 c_4(2) = -56, hence a(2) = -56/2 = -28. c_4(3) = 2076, hence a(3) = 2076/3 = 692.
%t A400691 nn = 20;
%t A400691 tt = Series[q*Product[(1 + q^m)^24, {m, 1, nn}], {q, 0, nn}];
%t A400691 hh = Series[Product[((1 - q^m)/(1 + q^m))^2, {m, 1, nn}], {q, 0, nn}];
%t A400691 cc = Normal@Series[tt*hh^4/(1 + 64*tt), {q, 0, nn}];
%t A400691 Table[Coefficient[cc, q, n]/n, {n, 1, nn}]
%o A400691 (SageMath)
%o A400691 N = 20
%o A400691 R.<q> = PowerSeriesRing(QQ, default_prec=N+1)
%o A400691 t = q*prod((1+q^m)^24 for m in range(1,N+1))
%o A400691 H = prod(((1-q^m)/(1+q^m))^2 for m in range(1,N+1))
%o A400691 C4 = t*H^4/(1+64*t)
%o A400691 [C4[n]/n for n in range(1,N+1)]
%Y A400691 Cf. A014103, A104794 (coefficients of t and H, respectively); A398186, A398383, A398901 (same K3 packet).
%K A400691 sign,new
%O A400691 1,2
%A A400691 _Alex Shvets_, Nov 01 2026
