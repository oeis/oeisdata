%N A400315 G.f. A(x) satisfies A(x) = A(x^4/(1 - x)) / (1 - x)^2, with A(0) = 1.
%F A400315 a(0) = 1; a(n) = Sum_{k=0..floor(n/4)} binomial(n-3*k+1,k+1) * a(k).
%F A400315 G.f.: B(x)^2 where B(x) is the g.f. of A352041.
%o A400315 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=0, i\4, binomial(i-3*j+1, j+1)*v[j+1])); v;
