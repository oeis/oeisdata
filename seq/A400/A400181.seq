%I A400181 #36 Oct 05 2026 16:51:28
%S A400181 9753086421,99775533108866442201,999777555333110888666444222001,
%T A400181 9999777755553333111088886666444422220001,
%U A400181 99999777775555533333111108888866666444442222200001,999999777777555555333333111110888888666666444444222222000001,9999999777777755555553333333111111088888886666666444444422222220000001
%N A400181 a(n) = D_n - A_n, where D_n is the descending permutation and A_n is the ascending permutation of n copies of each decimal digit 0..9.
%C A400181 For each n >= 1, a(n) is a 10n-digit Kaprekar fixed point under the standard Kaprekar routine T(x) = D(x) - A(x).
%C A400181 Generalizes the 10-digit pandigital Kaprekar fixed point 9753086421.
%F A400181 a(n) = 9^(n) * 10^(9n) + 7^(n) * 10^(8n) + 5^(n) * 10^(7n) + 3^(n) * 10^(6n) + 1^(n-1) * 10^(5n+1) + 0 * 10^(5n) + 8^(n) * 10^(4n) + 6^(n) * 10^(3n) + 4^(n) * 10^(2n) + 2^(n) * 10^(n) + 1, where d^(m) denotes the repdigit string of m copies of digit d.
%F A400181 Concatenation formula for string representation:
%F A400181 a(n) = '9'*n + '7'*n + '5'*n + '3'*n + '1'*(n-1) + '0' + '8'*n + '6'*n + '4'*n + '2'*n + '0'*(n-1) + '1'.
%e A400181 For n = 1: 9876543210 - 0123456789 = 9753086421.
%e A400181 For n = 2: 99887766554433221100 - 00112233445566778899 = 99775533108866442201.
%e A400181 For n = 3: 999888777666555444333222111000 - 000111222333444555666777888999 = 999777555333110888666444222001.
%o A400181 (Python)
%o A400181 def A(n):
%o A400181     s = '9'*n + '7'*n + '5'*n + '3'*n + '1'*(n-1) + '0' + '8'*n + '6'*n + '4'*n + '2'*n + '0'*(n-1) + '1'
%o A400181     return int(s)
%o A400181 print([A(n) for n in range(1, 8)])
%o A400181 (PARI)
%o A400181 a(n) = {
%o A400181   my(R(d, m) = if(m < 1, 0, d * (10^m - 1) / 9));
%o A400181   R(9,n)*10^(9*n) + R(7,n)*10^(8*n) + R(5,n)*10^(7*n) + R(3,n)*10^(6*n) +
%o A400181   R(1,n-1)*10^(5*n+1) + R(8,n)*10^(4*n) + R(6,n)*10^(3*n) +
%o A400181   R(4,n)*10^(2*n) + R(2,n)*10^n + 1
%o A400181 }
%Y A400181 Cf. A151949 (Kaprekar map n' - n''), A099009 (fixed points of A151949), A214559.
%K A400181 nonn,base,easy,new
%O A400181 1,1
