%S A400582 1,2,3,8,27,102,413,1752,7686,34584,158730,740220,3497390,16706172,
%T A400582 80545218,391439824,1915566681,9431168814,46683501695,232185539580,
%U A400582 1159751366235,5815255354590,29260992554685,147702958481520,747739568702880,3795495117745032,19313086329443808
%N A400582 Convolution of the number of dissections of a convex (n+2)-gon into triangles and quadrilaterals by nonintersecting diagonals (A001002).
%C A400582 Conjecturally, a(n) is the number of rc-simple permutations of length 2n which are invariant under the reverse-complement map and which avoid 2413 (or equivalently, 3142).  Here we say a permutation of length 2n which is invariant under the reverse-complement map is rc-simple whenever it contains no nontrivial intervals among its first n entries.
%H A400582 Alois P. Heinz, <a href="/A400582/b400582.txt">Table of n, a(n) for n = 0..1372</a>
%F A400582 a(n) = 2*A001002(n-1) + Sum_{k=0..n-2} A001002(k) * A001002(n-2-k) for n>=1, a(0)=1.
%e A400582 a(3) = 8;  the rc-simple permutations of length 2*3 = 6 which avoid 2413 and are invariant under the reverse-complement map are 142536, 153426, 415263, 513462, 514362, 531642, 624351, and 642531.
%p A400582 a:= proc(n) option remember; `if`(n<3, n+1, (3*(3*n-7)*
%p A400582      (3*n-8)*a(n-2)+2*(n-1)*(11*n-14)*a(n-1))/((5*(n-1))*n))
%p A400582     end:
%p A400582 seq(a(n), n=0..26);  # _Alois P. Heinz_, Sep 30 2026
