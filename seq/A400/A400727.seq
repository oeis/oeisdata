%U A400727 1440528320401,500111,36174709,376853,295324633,2131,687147718331,4338014017,496393931749,17050729021
%N A400727 Greatest prime factor of 4^n - 3^n.
%C A400727 See A398834 for a guide to related sequences.
%F A400727 a(n) = A006530(A005061(n)).
%t A400727 {x, y} = {4, 3}; p[n_] := p[n] = (x^n - y^n)/(x - y);
%t A400727 f[n_] := f[n] = FactorInteger[p[n]]; Table[f[n], {n, 1, 10}] // Column
%t A400727 Map[First, Table[Last[f[n]], {n, 2, 80}]]
%o A400727 (PARI) a(n) = vecmax(factor(4^n-3^n)[, 1]); \\ _Michel Marcus_, Nov 13 2026
%Y A400727 Cf. A006530, A005061.
%Y A400727 Cf. A089082, A398834, A400722, A400726.
