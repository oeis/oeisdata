%N A400067 Number of partitions of n such that (greatest part) - (least part) >= 4.
%F A400067 G.f.: -1 - x * (1 + x - x^3 - x^4 + x^5) / ( (1 - x) * (1 - x^2) * (1 - x^3)^2 ) + Product_{j>=1} 1 / (1 - x^j).
%e A400067 a(9) = 8 because we have [8,1], [7,2], [7,1,1], [6,2,1], [6,1,1,1], [5,3,1], [5,2,1,1] and [5,1,1,1,1].
%t A400067 nmax = 48; CoefficientList[Series[-1 - x (1 + x - x^3 - x^4 + x^5)/((1 - x) (1 - x^2) (1 - x^3)^2) + Product[1/(1 - x^j), {j, 1, nmax}], {x, 0, nmax}], x] // Rest
