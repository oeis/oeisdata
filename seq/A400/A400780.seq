%I A400780 #8 Oct 13 2026 18:13:32
%S A400780 6,10,12,14,15,20,21,26,33,35,34,38,44,48,46,51,55,57,65,58,68,90,85,
%T A400780 96,74,93,112,86,116,135,111,123,143,118,145,141,155,161,185,210,208,
%U A400780 158,177,188,203,209,224,225,166,205,221,215,178,212,252,201,194,206,294,297,300,304,306,320,267
%N A400780 Table listed by rows: row n consists of the numbers x such that A075254(x) = A050778(n).
%C A400780 Row n consists of the numbers x, in increasing order, such that x + sum of prime factors of x, counted by multiplicity, is the n-th prime for which such x exists.
%H A400780 Robert Israel, <a href="/A400780/b400780.txt">Table of n, a(n) for n = 1..10000</a> (first 5712 rows, flattened)
%F A400780 A075254(T(n,k)) = A050778(n).
%e A400780 The first 5 rows are
%e A400780   6      (because 6 + 2 + 3 = 11 = A050778(1))
%e A400780   10     (because 10 + 2 + 5 = 17 = A050778(2))
%e A400780   12     (because 12 + 2 + 2 + 3 = 19 = A050778(3))
%e A400780   14, 15 (because 14 + 2 + 7 = 15 + 3 + 5 = 23 = A050778(4))
%e A400780   20     (because 20 + 2 + 2 + 5 = 29 = A050778(5)).
%p A400780 g:= proc(n) local t; n + add(t[1]*t[2],t=ifactors(n)[2]) end proc:
%p A400780 N:= 1000: # for T(n,k) for n where A050778(n) < N
%p A400780 R:= {}:
%p A400780 for x from 4 to N do
%p A400780 v:= g(x);
%p A400780 if member(v,R) then V[v]:= V[v],x
%p A400780 elif v < N and isprime(v) then R:= R union {v}: V[v]:= x
%p A400780 fi
%p A400780 od:
%p A400780 R:= sort(convert(R,list)):
%p A400780 for v in R do
%p A400780 V[v]
%p A400780 od;
%Y A400780 Cf. A050703, A050778, A075254.
%K A400780 nonn,tabf,new
%O A400780 1,1
%A A400780 _Will Gosnell_ and _Robert Israel_, Oct 06 2026
