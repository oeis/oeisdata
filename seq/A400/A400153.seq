%I A400153 #8 Sep 20 2026 15:17:30
%S A400153 1,1,2,2,9,2,9,2,25,5,5,2,25,2,5,5,7,2,125,2,625,5,25,2,7,5,25,625,7,
%T A400153 2,7,2,49,25,125,25,49,2,125,25,49,2,7,2,7,7,625,2,343,25,7,125,7,2,
%U A400153 49,25,343,125,7,2,343,2,7,7,117649,125,49,2,49,625,7,2,16807,2,7,7,49,125,49,2,16807,343,7,2,2401
%N A400153 a(0)=a(1)=1, after which a(n) = p^{the most significant digit of n' in primorial base, A049345}, where p is the corresponding radix prime of the most significant digit, and n' stands for the arithmetic derivative of n, A003415(n).
%H A400153 Antti Karttunen, <a href="/A400153/b400153.txt">Table of n, a(n) for n = 0..10000</a>
%H A400153 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400153 a(n) = A400152(A003415(n)) = A053585(A327859(n)).
%o A400153 (PARI)
%o A400153 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400153 A400152(n) = { my(p=2,q=1,d=0); while(n, d = n%p; n = n\p; q = p; p = nextprime(1+p)); (q^d); };
%o A400153 A400153(n) = A400152(A003415(n));
%Y A400153 Cf. A003415, A049345, A053585, A327859, A400152, A400154 [k such that a(k)|k].
%K A400153 nonn,new
%O A400153 0,3
%A A400153 _Antti Karttunen_, Sep 20 2026
