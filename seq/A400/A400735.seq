%S A400735 983,1091,1631,1685,1739,2117,2441,2603,2927,3035,3089,4115,4385,4601,
%T A400735 4979,5141,5357,5843,6329,6437,6491,7031,7625,7733,8435,8489,9029,
%U A400735 9083,9191,9677,10379,10487,10865,11351,11621,12107,13133,13241,13619,13727,13781,14105,14591
%N A400735 Numbers that start a run of 17 consecutive odd numbers that are all exponentially odd numbers (A268335).
%C A400735 17 is the length of the longest possible run since in every run of 18 consecutive odd numbers there are two multiples of 9, and only one of them is divisible by 27. Therefore, the second multiple of 9 has a 3-adic valuation 2 and it is not an exponentially odd number.
%C A400735 The asymptotic density of this sequence is (1/72) * Product_{p prime >= 5} (1 - 17/(p*(p+1))) = 0.0025140971339935622575... .
%H A400735 Amiram Eldar, <a href="/A400735/b400735.txt">Table of n, a(n) for n = 1..10000</a>
%F A400735 a(n) == 11 (mod 18) for all n.
%t A400735 expOddQ[n_] := expOddQ[n] = AllTrue[FactorInteger[n][[;; , 2]], OddQ];
%t A400735 q[n_] := AllTrue[n + 2*Range[0, 16], expOddQ]; Select[Range[11, 15000, 18], q]
%o A400735 (PARI) isexpodd(n) = {my(f = factor(n)); for(i=1, #f~, if (!(f[i, 2] % 2), return (0))); 1;}
%o A400735 isok(k) = if(k % 18 != 11, 0, forstep(i = 0, 32, 2, if(!isexpodd(k + i), return(0))); 1);
%Y A400735 Subsequence of A268335 and A376218.
%Y A400735 Cf. A325058, A398951.
%K A400735 nonn,cons,new
%O A400735 1,1
%A A400735 _Amiram Eldar_, Oct 05 2026
