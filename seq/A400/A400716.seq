%T A400716 289570046647683,301934420184896899,624645017327748777347,
%U A400716 2572840200605296447776131,21140848638939014239199733123,346941599013587603682897379730819,11378635344052791495237230360699807107
%N A400716 G.f. A(x) satisfies: A(x) = 1 + x * A(2*x/(1 - 2*x)) / (1 - x).
%F A400716 a(0) = 1; a(n) = a(n-1) + 2^(n-1) * Sum_{k=1..n-1} binomial(n-2,k-1) * a(k) for n >= 1.
%t A400716 nmax = 16; A[_] = 0; Do[A[x_] = 1 + x A[2 x/(1 - 2 x)]/(1 - x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A400716 (* Alternative: *)
%t A400716 a[0] = 1; a[n_] := a[n] = a[n - 1] + 2^(n - 1) Sum[Binomial[n - 2, k - 1] a[k], {k, 1, n - 1}]; Table[a[n], {n, 0, 16}]
%Y A400716 Cf. A000110, A007405, A035009, A126443.
%K A400716 nonn,new
%O A400716 0,3
