%S A400571 2,2,4,2,6,6,2,8,10,8,2,10,16,14,10,2,12,24,24,18,12,2,14,32,40,32,22,
%T A400571 14,2,16,42,64,56,40,26,16,2,18,54,88,96,72,48,30,18,2,20,66,120,160,
%U A400571 128,88,56,34,20,2,22,80,162,224,224,160,104,64,38,22
%N A400571 Array A(n,k) read by antidiagonals, where A(n,k) is the surface area of an n-dimensional hyperrectangle obtained from the unit n-cube by adding k unit layers, one dimension at a time, maximizing the surface area at each step.
%C A400571 Start with the unit n-cube. At each step, increase the length of one side by one, choosing the side that maximizes the resulting total surface area. For n = 2, all choices are tied. For n >= 3, the shortest side should always be lengthened. A(n,k) is the surface area of the n-dimensional hyperrectangle after k steps.
%H A400571 Eddie Lin Rui, <a href="/A400571/b400571.txt">Table of n, a(n) for n = 1..10011; the first 141 antidiagonals of the array</a>
%F A400571 Let q = floor(k/n), r = k mod n. If r = 0, A(n,k) = 2*n*(q+1)^(n-1). If 1 <= r < n, A(n,k) = 2*(q+1)^(n-r-1)*(q+2)^(r-1)*(n*q + 2*n - r).
%e A400571 The array begins:
%e A400571        k=0   1   2    3    4    5    6    7
%e A400571   n=1    2   2   2    2    2    2    2    2
%e A400571   n=2    4   6   8   10   12   14   16   18
%e A400571   n=3    6  10  16   24   32   42   54   66
%e A400571   n=4    8  14  24   40   64   88  120  162
%e A400571   n=5   10  18  32   56   96  160  224  312
%e A400571   n=6   12  22  40   72  128  224  384  544
%e A400571   n=7   14  26  48   88  160  288  512  896
%e A400571   n=8   16  30  56  104  192  352  640 1152
%e A400571 Using the array formula, for n = 3, k = 5: q = floor(5/3) = 1, r = 5 mod 3 = 2, A(3,5) = 2*(q+2)*(3*q+4) = 2*3*7 = 42.
%t A400571 A400571[n_, k_] := With[{q = Quotient[k, n], r = Mod[k, n]}, 2*(q + 1)^(n - r - 1)*If[r == 0, n, (q + 2)^(r - 1)*(n*(q + 2) - r)]];
%t A400571 Table[A400571[k + 1, n - k - 1], {n, 15}, {k, 0, n - 1}] (* _Paolo Xausa_, Oct 09 2026 *)
%o A400571 (Python)
%o A400571 def A(n, k):
%o A400571     q, r = divmod(k, n)
%o A400571     if r == 0:
%o A400571         return 2*n*(q+1)**(n-1)
%o A400571     return 2*(q+1)**(n-r-1)*(q+2)**(r-1)*(n*q + 2*n - r)
%o A400571 print([A(n, d-n) for d in range(1, 13) for n in range(1, d+1)])
%Y A400571 Cf. rows n = 1,2,3: A007395, A005843, A030511.
%Y A400571 Cf. columns k = 0,1,2: A005843, A016825, A008590.
%Y A400571 Cf. A057711 (main diagonal).
%Y A400571 Cf. A152072, the analogous volume-maximizing array.
