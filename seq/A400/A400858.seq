%S A400858 1,1,1,1,1,2,1,4,1,1,7,3,1,12,8,1,1,20,18,4,1,33,38,13,1,1,54,76,35,5,
%T A400858 1,88,147,86,19,1,1,143,277,197,59,6,1,232,512,430,164,26,1,1,376,932,
%U A400858 904,420,91,7,1,609,1676,1846,1014,281,34,1,1,986,2984,3682,2338,792,132,8
%N A400858 Irregular triangle read by rows: the stretched Riordan array ( 1/(1 - x), x^2/(1 - x - x^2) ).
%H A400858 Paul Barry, <a href="https://arxiv.org/abs/2611.05673">Orthogonal polynomials on two or more intervals: the Sprugnoli context</a>, arXiv:2611.05673 [math.CO], 2026. See p. 9.
%e A400858 The irregular triangle begins as:
%e A400858   1;
%e A400858   1;
%e A400858   1,  1;
%e A400858   1,  2;
%e A400858   1,  4,  1;
%e A400858   1,  7,  3;
%e A400858   1, 12,  8,  1;
%e A400858   1, 20, 18,  4;
%e A400858   1, 33, 38, 13, 1;
%e A400858   ...
%t A400858 g[x_]:=1/(1-x); f[x_]:=x/(1-x-x^2); T[n_,k_]:=SeriesCoefficient[g[x]/(1-x*y*f[x]),{x,0,n},{y,0,k}]; Table[T[n,k],{n,0,15},{k,0,Floor[n/2]}]//Flatten
%Y A400858 Row lengths give A008619.
%Y A400858 Row sums give A005578.
%Y A400858 Cf. A115524.
%K A400858 nonn,easy,tabf,new
%O A400858 0,6
%A A400858 _Stefano Spezia_, Nov 12 2026
