%U A400475 2,0,6,5,5,0,5,5,4,1,7,4,4,0,5,2,5,4,6,4,6,0,3
%N A400475 The number of integers k such that 2^n+2^k-1 is a prime, for 0 < k < n.
%H A400475 Michael S. Branicky, <a href="/A400475/b400475.txt">Table of n, a(n) for n = 1..5000</a>
%e A400475 a(4)=3 because there are 3 primes between 16 and 32 such that their binary representation has form 1{0}{1}, where {0} is a run of 0's and {1} is a run of 1's: 17 = 10001_2, 19 = 10011_2 and 23 = 10111_2.
%t A400475 a[n_]:=Length[Select[Range[n-1],PrimeQ[2^n+2^#-1] &]]; Array[a,90] (* _Stefano Spezia_, Sep 27 2026 *)
%o A400475 (PARI) a(n) = sum(x=1, n-1, isprime(2^n+2^x-1)); \\ _Michel Marcus_, Sep 27 2026
%o A400475 (Python)
%o A400475 from gmpy2 import is_prime
%o A400475 def a(n): return sum(1 for x in range(1, n) if is_prime(2**n+2**x-1))
%o A400475 print([a(n) for n in range(1, 91)]) # _Michael S. Branicky_, Sep 27 2026
%Y A400475 Cf. A000040, A188713, A239712.
%Y A400475 Cf. A346146 (indices of zeros).
