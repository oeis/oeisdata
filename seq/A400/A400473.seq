%T A400473 62,21,3,17,7,46,13,2,13,7,21,19,10,11,10,3,2,7,19,31,15,13,5,5,17,19,
%U A400473 5,39,23,6,15,2,35,13,1,11,1,7,21,3,11,26,97,1,91,2,26,19,39,17,22
%N A400473 a(n) is the smallest divisor d of the n-th primorial such that prime(n)#/d + d or prime(n)#/d - d is prime.
%C A400473 a(n) = 1 iff n belongs to A014545 or A057704.
%C A400473 Conjecture: a(n) < prime(n) for n > 0.
%F A400473 a(n) = min(A295741(n), A400506(n)).
%F A400473 Conjecture: Limit_{N->oo} (Sum_{n=1..N} a(n)) / (Sum_{n=1..N} prime(n)) = 0.
%e A400473 a(7) = 2 because prime(7)#/2 - 2 = 510510/2 - 2 = 255253 and 255253 is prime; while prime(7)# + 1, prime(7)# - 1 and prime(7)#/2 + 2 are not prime.
%o A400473 (PARI) a(n)=my(P=vecprod(primes(n))); for(d=1, P, if(P%d==0 && (ispseudoprime(P/d+d) || ispseudoprime(P/d-d)), return(d)));
%Y A400473 Cf. A002110, A014545, A057704, A295741, A400506.
%K A400473 nonn,new
%O A400473 1,7
