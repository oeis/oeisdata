%U A400427 7,47,19,13,29,7,5,17,11,31,13,7,53,23,5,7,17,19,23,29,7,59,17,5,13,61,37,31,17
%N A400427 3rd least distinct prime factor of numbers with 3 or more distinct prime factors.
%C A400427 In other words, a(n) is the 3rd least prime number that divides A000977(n), the n-th number that is divisible by 3 or more prime numbers.
%C A400427 For sufficiently large n the median value of terms a(1)..a(n) is A284411(3) = 42719.
%H A400427 Peter Munn, <a href="/A400427/b400427.txt">Table of n, a(n) for n = 1..10000</a>
%F A400427 a(n) = A020639(A028234^2(A000977(n))).
%o A400427 (PARI)
%o A400427 k=1;for(n=1,10000,while(omega(k)<3,k=k+1);print(n," ",factor(k)[3,1]);k=k+1)
%Y A400427 Cf. A000977, A020639, A028234, A089992, A179938, A284411.
%K A400427 nonn,easy,new
%O A400427 1,1
%A A400427 _Peter Munn_, Sep 25 2026
