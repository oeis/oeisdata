%I A400846 #26 Oct 07 2026 17:39:49
%S A400846 1,1,1,2,1,0,6,6,1,0,0,8,6,36,24,1,0,0,0,10,0,20,60,90,240,120,1,0,0,
%T A400846 0,0,12,0,0,30,110,0,360,570,1080,1800,720,1,0,0,0,0,0,14,0,0,0,42,
%U A400846 126,70,0,630,1260,630,5040,6720,12600,15120,5040
%N A400846 Irregular triangular array read by rows. T(n,k) is the number of ordered set partitions of [n] whose associated composition c is such that f(c)=k, 0<=k<=binomial(n,2), n>=0 (where associated composition and f(c) are defined below in the comments section).
%C A400846 Let pi = (b_1,b_2,...,b_j) be a set partition of [n] where the b_i are the blocks of pi.  Then we associate to pi the composition c = (|b_1|,|b_2|,...,|b_j|).
%C A400846 Let c = x1+x2+x3+...+xj  be a composition of n.  Then f(c) = x1*(n-x1) + x2*(n-x1-x2) + x3*(n-x1-x2-x3) + ... + xj*0.
%C A400846 Let G be a properly colored simple labeled graph such that the sizes of the color classes correspond to the composition c.  Then f(c) is the maximum possible number of edges in G.
%H A400846 Alois P. Heinz, <a href="/A400846/b400846.txt">Rows n = 0..50, flattened</a>
%F A400846 Sum_{k>=0} Sum_{n>=0} T(n,k)*q^k*z^n/(n!*q^binomial(n,2)) = 1/(2-e(z)) where e(z) = Sum_{n>=0} z^n/(n!*q^binomial(n,2)).
%F A400846 Sum_{k>=0} T(n,k)*2^k = A334282(n).
%F A400846 From _Alois P. Heinz_, Oct 07 2026: (Start)
%F A400846 (1/2) * Sum_{k>=0} k * T(n,k) = A240796(n).
%F A400846 Sum_{k>=0} (binomial(n,2) - k) * T(n,k) = A240797(n). (End)
%e A400846 Triangle begins...
%e A400846   1;
%e A400846   1;
%e A400846   1, 2;
%e A400846   1, 0, 6, 6;
%e A400846   1, 0, 0, 8,  6, 36, 24;
%e A400846   1, 0, 0, 0, 10,  0, 20, 60, 90, 240, 120;
%e A400846   1, 0, 0, 0,  0, 12,  0,  0, 30, 110,   0, 360, 570, 1080, 1800, 720;
%e A400846   ...
%e A400846 T(n,0) = 1 because we have the set partition with only one block.
%e A400846 T(n,binomial(n,2) = n! because there are n! ordered set partitions all of whose blocks contain exactly one element.
%p A400846 b:= proc(n, s) option remember; `if`(n=0, x^s,
%p A400846       add(b(n-j, s+j*(n-j))*binomial(n,j), j=1..n))
%p A400846     end:
%p A400846 T:= n-> (p-> seq(coeff(p, x, i), i=0..degree(p)))(b(n, 0)):
%p A400846 seq(T(n), n=0..7);  # _Alois P. Heinz_, Oct 07 2026
%t A400846 nn = 7; B[n_] := n! q^Binomial[n, 2];e[z_] := Sum[z^n/B[n], {n,0,nn}]; Map[CoefficientList[#, q] &,Table[B[n], {n, 0, nn}] CoefficientList[ Series[1/(2 - e[z]), {z, 0, nn}], z]] // Grid
%Y A400846 Cf. A000142, A000670 (row sums), A240796, A240797, A271024, A334282.
%K A400846 nonn,tabf,new
%O A400846 0,4
