%S A400893 1,5,9,17,21,25,33,37,41,49,57,65,69,73,81,85,89,97,101,105,113,121,
%T A400893 129,133,137,145,149,153,161,165,169,177,185,193,197,201,209,217,225,
%U A400893 229,233,241,249,257,261,265,273,277,281,289,293,297,305,313,321,325,329,337,341
%N A400893 Bipartition of the positive odd numbers depending on the parity of the 2-adic valuation A007814(3*k + 2). Here the part with odd valuation based on A400890.
%C A400893 This can be used for the reduced Collatz function A075677 which is R(2*k+1) = (3*k + 2)/2^v2(3*k+2), with v2 = A007814.
%F A400893 a(n) = 2*A400890(n) + 1.
%e A400893 a(3) = 17 because A400890(3) = 8.
%p A400893 q:= k-> is(irem(padic[ordp](3*k+2,2),2)=1):
%p A400893 map(x-> 2*x+1, select(q, [$0..170]))[];  # _Alois P. Heinz_, Oct 08 2026
%t A400893 2*Select[Range[0, 170], OddQ[IntegerExponent[3*# + 2, 2]] &] + 1 (* _Amiram Eldar_, Oct 08 2026 *)
%Y A400893 See A400894 for the even part.
%Y A400893 Cf. A005408, A007814, A075677, A400890.
%K A400893 nonn,easy
%O A400893 1,2
%A A400893 _Wolfdieter Lang_, Oct 08 2026
