%N A400662 a(0) = 1; a(n) = Sum_{k=1..n} (-1)^(k+1) * binomial(4*n-3*k,k) * (n-k+1)^k * a(n-k).
%F A400662 1 = Sum_{n>=0} a(n) * x^n / (1 + (n+1) * x)^(4*n+1).
%t A400662 a[0] = 1; a[n_] := a[n] = Sum[(-1)^(k + 1) Binomial[4 n - 3 k, k] (n - k + 1)^k a[n - k], {k, 1, n}]; Table[a[n], {n, 0, 17}]
