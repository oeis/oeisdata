%I A400738 #10 Nov 07 2026 23:06:06
%S A400738 3,13,31,61,109,181,283,2081,1153,1453,2711,1481,2027,4241,3299,4337,
%T A400738 3557,4651,4967,6793,11171,19423,8599,11351,30139,13829,13219,12613,
%U A400738 27751,25031,55439,34159,37589,21613,26263,39229,32533,29389,32561,97861,35899,39509,51239
%N A400738 For n >= 1, a(n) is the smallest twin prime representable as the sum of 2*n - 1 consecutive terms of A077800.
%H A400738 Robert Israel, <a href="/A400738/b400738.txt">Table of n, a(n) for n = 1..10000</a>
%e A400738 13 is the smallest twin prime equal to the sum of 2*2 - 1 = 3 consecutive terms of A077800, namely [3, 5, 5]. So a(2) = 13.
%e A400738 2081 is the smallest twin prime equal to the sum of 2*8 - 1 = 15 consecutive terms of A077800, namely [71, 73, 101, 103, 107, 109, 137, 139, 149, 151, 179, 181, 191, 193, 197]. So a(8) = 2081.
%p A400738 LTP:= select(t -> isprime(t) and isprime(t+2), [3,seq(i,i=5 .. 10^4,6)]):
%p A400738 TP:= [seq(op([t,t+2]), t = LTP)]:
%p A400738 PS:= [0,op(ListTools:-PartialSums(TP))]: m:= nops(PS):
%p A400738 f:= proc(n) local i,v; for i from 2 to m-(2*n-1) do v:= PS[i+2*n-2]-PS[i-1]; if isprime(v) and (isprime(v+2) or isprime(v-2)) then return v fi od; FAIL end proc:
%p A400738 map(f, [$1..30]); # _Robert Israel_, Nov 03 2026
%Y A400738 Cf. A001097, A013918, A053845, A071151, A077800, A400578.
%K A400738 nonn,changed
%O A400738 1,1
