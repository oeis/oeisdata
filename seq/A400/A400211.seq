%I A400211 #27 Sep 30 2026 09:33:20
%S A400211 0,1,0,-1,4,5,0,-5,-4,9,16,11,0,-11,-16,-9,16,33,32,19,0,-19,-32,-33,
%T A400211 -16,25,56,63,52,29,0,-29,-52,-63,-56,-25,36,85,104,99,76,41,0,-41,
%U A400211 -76,-99,-104,-85,-36,49,120,155,160,141,104,55,0,-55,-104,-141
%N A400211 a(n) = x^3 - m*(m+1)*x, where m = floor(sqrt(n)) and x = n - m*(m+1).
%C A400211 For the depressed cubic P_m(x) = x^3 - m*(m+1)*x, the roots are at x = -sqrt(m*(m+1)), 0, sqrt(m*(m+1)). a(n) samples P_m(x) at the integer points between and including the outer roots. Consequently, the zero positions are the oblong numbers m*(m+1) (cf. A002378).
%C A400211 For n > 0, the sequence can also be computed from the integer parabola family (cf. A400150), b(n) = |2*b(n-1) - b(n-2) - c| with c = 1, by taking the backward difference of b(n)^2. Proof: using the closed-form formula for b(n): b(n) = (m*(m+1) - x*(x+1))/2. Thus, b(n)^2 - b(n-1)^2 = (b(n)-b(n-1))*(b(n)+b(n-1)) = (-x)*(m*(m+1) - x^2) = x^3 - m*(m+1)*x = a(n).
%H A400211 Eddie Lin Rui, <a href="/A400211/b400211.txt">Table of n, a(n) for n = 0..10000</a>
%F A400211 a(n) = b(n)^2 - b(n-1)^2, for n > 0, where b(0) = 0, b(1) = 1, b(n) = |2*b(n-1) - b(n-2) - 1| for n >= 2. a(0) = 0 from the closed-form formula.
%e A400211 For m = 1, P_1(x) = x^3 - 2*x, with roots (-sqrt(2), 0, sqrt(2)) ~= (-1.414..., 0, 1.414...), the integer sample points are x = -1, 0, 1, thus: a(1), a(2), a(3) = 1, 0, -1.
%e A400211 Arranged by rows indexed by m:
%e A400211   m=0:  0
%e A400211   m=1:  1, 0, -1
%e A400211   m=2:  4, 5, 0, -5, -4
%e A400211   m=3:  9, 16, 11, 0, -11, -16, -9
%e A400211 From the iteration rule: b(0) = 0, b(1) = 1, b(2) = |2*1 - 0 - 1| = 1, hence a(1) = b(1)^2 - b(0)^2 = 1 - 0 = 1 and a(2) = b(2)^2 - b(1)^2 = 1 - 1 = 0.
%t A400211 A400211[n_] := With[{m = Floor[Sqrt[n]]}, {x = n - m*(m + 1)}, x^3 - m*(m + 1)*x];
%t A400211 Array[A400211, 100, 0] (* _Paolo Xausa_, Sep 30 2026 *)
%o A400211 (Python)
%o A400211 from math import isqrt
%o A400211 def a(n):
%o A400211     m = isqrt(n)
%o A400211     x = n - m*(m+1)
%o A400211     return x**3 - m*(m+1)*x
%o A400211 print([a(n) for n in range(0, 101)])
%Y A400211 Cf. A002378, A400150.
%K A400211 sign,easy,tabf,new
%O A400211 0,5
%A A400211 _Eddie Lin Rui_, Sep 21 2026
