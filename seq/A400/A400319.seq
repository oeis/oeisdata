%N A400319 G.f. A(x) satisfies A(x) = (1 + x)^4 * A(x^4 * (1 + x)), with A(0) = 1.
%F A400319 a(0) = 1; a(n) = Sum_{k=0..floor(n/4)} binomial(k+4,n-4*k) * a(k).
%F A400319 G.f.: B(x)^4 where B(x) is the g.f. of A400271.
%o A400319 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=0, i\4, binomial(j+4, i-4*j)*v[j+1])); v;
