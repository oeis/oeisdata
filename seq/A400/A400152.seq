%T A400152 625,625,625,625,625,625,7,7,7,7,7,7,7,7,7,7,7,7,7,7,7,7,7,7,7,7,7,7,
%U A400152 7,7,7,7,7,7,7,7,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49,49
%N A400152 a(n) = p^{the most significant digit of n in primorial base, A049345}, where p is the corresponding radix prime; a(0) = 1.
%H A400152 Antti Karttunen, <a href="/A400152/b400152.txt">Table of n, a(n) for n = 0..10000</a>
%H A400152 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400152 a(n) = A053585(A276086(n)), where A053585(n) = p_k^e_k for n = p_1^e_1 * ... * p_k^e_k, p_1 < ... < p_k primes, and A276086 is the primorial base exp-function.
%F A400152 a(0) = 1, for n > 0, a(n) = A000040(A235224(n))^A276153(n).
%o A400152 (PARI) A400152(n) = { my(p=2,q=1,d=0); while(n, d = n%p; n = n\p; q = p; p = nextprime(1+p)); (q^d); };
%Y A400152 Cf. A000040, A049345, A053585, A235224, A276086, A276153, A400153 [= a(A003415(n))].
%K A400152 nonn,new
%O A400152 0,2
