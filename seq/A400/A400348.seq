%T A400348 16455,2812,185,6,1,19825,267500,307833,78608,7115,300,7,1,108545,
%U A400348 3009050,5850000,2245364,282245,15570,455,8,1,598417,34150000,112445112,65098616,11424400,831624,30646,656,9,1
%N A400348 Array read by ascending antidiagonals: A(n,k) = [x^n] 1/(1 - k^2*x/(1 - x))^(n/k), with k > 0.
%F A400348 A(0,k) = 1 and A(n,k) = Sum_{j=1..n} binomial(n-1, j-1)*binomial(n/k+j-1, j)*k^(2*j).
%F A400348 A(0,k) = 1 and A(n,k) = k*n*hypergeom([1-n, 1+n/k], [2], -k^2).
%F A400348 A(2,k) = A062158(k+1).
%e A400348 The array begins as:
%e A400348     1,     1,      1,       1, ...
%e A400348     1,     2,      3,       4, ...
%e A400348     5,    20,     51,     104, ...
%e A400348    25,   206,    900,    2812, ...
%e A400348   129,  2200,  16455,   78608, ...
%e A400348   681, 24062, 307833, 2245364, ...
%e A400348   ...
%t A400348 A[n_,k_]:=SeriesCoefficient[1/(1 - k^2*x/(1 - x))^(n/k),{x,0,n}]; Table[A[n-k+1,k],{n,0,9},{k,n+1}]//Flatten
%t A400348 (* Alternative: *)
%t A400348 A[0,k_]:=1; A[n_,k_]:=Sum[Binomial[n-1,j-1]Binomial[n/k+j-1,j]k^(2j),{j,n}]; Table[A[n-k+1,k],{n,0,9},{k,n+1}]//Flatten
%t A400348 (* Alternative: *)
%t A400348 A[0,k_]:=1; A[n_,k_]:=k*n*Hypergeometric2F1[1-n, 1+n/k, 2,-k^2]; Table[A[n-k+1,k],{n,0,9},{k,n+1}]//Flatten
%Y A400348 Columns k=1..3 give abs(A182626), A378551, A378552.
%Y A400348 Rows n=0..1 give A000012, A000027.
%Y A400348 Antidiagonal sums give A400349.
%Y A400348 Cf. A062158.
%K A400348 nonn,tabl,new
%O A400348 0,4
