%I A400827 #12 Oct 10 2026 16:25:16
%S A400827 4,27,40,45,52,72,76,80,88,99,100,104,105,117,140,172,195,207,248,252,
%T A400827 288,292,308,316,324,328,344,369,380,387,396,405,412,436,464,465,468,
%U A400827 472,477,484,488,500,504,549,555,556,560,567,580,584,608,609,620,627,639,652,657,675,680,684,704,728,740,747,772,792
%N A400827 Numbers m such that the locations of nonzero digits in the primorial base representations (A049345) of m and m' are equal, where m' is the arithmetic derivative of m, A003415.
%H A400827 Antti Karttunen, <a href="/A400827/b400827.txt">Table of n, a(n) for n = 1..10000</a>
%H A400827 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400827 {k such that A328571(k) = A328571(A003415(k))}.
%F A400827 {k such that A007947(A276086(k)) = A007947(A327859(k))}.
%e A400827 A049345(45) = 1211, while A003415(45) = 45' = 39, with A049345(39) = 1111, thus in both exactly the same digit positions contain nonzero values, and 45 is included in this sequence.
%e A400827 A049345(2700) = 116000, and A049345(A003415(2700)) = 286000, thus in both exactly the same digit positions contain nonzero values, and therefore 2700 is included in this sequence.
%o A400827 (PARI)
%o A400827 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400827 A328571(n) = { my(m=1, p=2); while(n, m *= (p^!!(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400827 is_A400827(k) = (A328571(k)==A328571(A003415(k)));
%Y A400827 Cf. A003415, A007947, A049345, A327859, A328571.
%Y A400827 Cf. A051674 (subsequence).
%Y A400827 Cf. also A201009, A399379, A399380.
%K A400827 nonn,base
%O A400827 1,1
%A A400827 _Antti Karttunen_, Oct 10 2026
