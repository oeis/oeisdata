%I A400288 #13 Oct 08 2026 18:28:48
%S A400288 0,7,5,21,33,4,15,1,66,63,8,1,99,7,2,136,132,5,45,133,16,26,2,161,198,
%T A400288 20,14,189,4,203,272,217,264,3,10,28,297,259,95,21,32,287,52,301,4,
%U A400288 408,115,329,396,7,40,15,28,371,135,5,8,399,145,413,544,427,155,78,528,52,6,469,20,483
%N A400288 Successor function of the FRACTRAN program COLLATZGAME (A365328/A365329).
%C A400288 COLLATZGAME is a FRACTRAN program consisting of the 10 fractions f[k] = A365328(k) / A365329(k). Since A365329(10) = 1, the successor function a(n) = n*f[k(n)] with k(n) := min { k >= 1 : A365329(k) | n } is well defined for all integers n, viz. 1 <= k(n) <= 10.
%C A400288 This FRACTRAN program realizes the Collatz- or 3x+1 map A014682 by considering the trajectory of 2^k under iterations of this successor function; the next power of 2 appearing in the trajectory is 2^A014682(k).
%e A400288 Starting with k = 2^0 = 1 -> a(1) = 7 -> a(7) = 1 = 2^0 and indeed, 0 = A014682(0).
%e A400288 Starting with k = 2^1 = 2 -> a(2) = 5 -> a(5) = 4 = 2^2 and indeed, 2 = A014682(1).
%e A400288 Starting with k = 2^2 = 4 -> a(4) = 33 -> a(33) = 3 -> a(3) = 21 -> a(21) = 26 -> a(26) = 14 -> a(14) = 2 = 2^1 and indeed, 1 = A014682(2).
%e A400288 Starting with k = 2^3 = 8 -> 66 -> 6 -> 15 -> 136 -> 40 -> 32 = 2^5 and indeed, 5 = A014682(3).
%e A400288 Starting with k = 2^4 = 16 -> 132 -> 12 -> 99 -> 9 -> 63 -> 78 -> 42 -> 52 -> 28 -> 4 = 2^2 and indeed, 2 = A014682(4).
%o A400288 (PARI) A400288(n)=for(i=1,#A365328,n%A365329[i]||return(n\A365329[i]*A365328[i]))
%o A400288 /* illustration of the trajectory of 2^k */
%o A400288 traj(k,n=2^k)=until(hammingweight(n=A400288(n))==1,print1(n" -> "));print(n" = 2^"logint(n,2))
%Y A400288 Cf. A365328, A365329, A014682.
%K A400288 nonn,easy,new
%O A400288 0,2
%A A400288 _M. F. Hasler_, Sep 24 2026
