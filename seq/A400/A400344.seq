%I A400344 #11 Sep 24 2026 16:09:56
%S A400344 1,2,8,50,430,4797,66678,1121607,22333478,517363584,13749077502,
%T A400344 414348225641,14023303965952,528602461957770,22034114539744684,
%U A400344 1009345988835616028,50533287868645010997,2751642508070220990674,162253006771716155999952,10320006445300248925512344
%N A400344 Number of upper triangular n X n binary matrices having all row and column sums in {0,1,2}.
%C A400344 Equivalently, a(n) is the number of subgraphs of the bipartite graph with vertices L_1,...,L_n and R_1,...,R_n and edges L_i R_j for i <= j, having maximum degree at most 2. Thus every nontrivial connected component is a path or a cycle.
%H A400344 Alois P. Heinz, <a href="/A400344/b400344.txt">Table of n, a(n) for n = 0..329</a>
%F A400344 Put D_x = d/dx and D_y = d/dy, and define L = (1 + y*D_x + D_y + (y^2/2)*D_x^2 + y*D_x*D_y + (1/2)*D_y^2)*x.
%F A400344 Let P_n(x,y) = L^n(x). Then a(n) = P_n(1,1).
%e A400344 For n = 2, all 2^3 = 8 upper triangular binary matrices satisfy the conditions, so a(2) = 8.
%p A400344 L:= f-> (f+y*diff(f, x)+diff(f, y)+(y^2/2)*diff(f, x, x)+
%p A400344            y*diff(f, x, y)+diff(f, y, y)/2)*x:
%p A400344 p:= proc(n) option remember; `if`(n=0, x, expand(L(p(n-1)))) end:
%p A400344 a:= n-> subs(x=1, y=1, p(n)):
%p A400344 seq(a(n), n=0..19);  # _Alois P. Heinz_, Sep 24 2026
%Y A400344 Cf. A396698 (row and column sums in {0,2}).
%K A400344 nonn,new
%O A400344 0,2
%A A400344 _Vladeta Jovovic_, Sep 23 2026
