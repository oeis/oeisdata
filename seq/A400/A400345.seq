%I A400345 #4 Sep 29 2026 21:27:25
%S A400345 1,0,1,1,2,0,3,1,5,-2,5,3,8,-2,9,4,14,-7,12,7,17,-2,20,5,28,-10,26,11,
%T A400345 35,-5,39,10,53,-21,46,19,58,-5,65,10,82,-19,80,22,100,-15,105,23,133,
%U A400345 -38,123,36,149,-15,160,24,195,-40,190,44,229,-29,239,43,292,-74,271,67,317,-27,336
%N A400345 a(0) = 1, a(1) = 0; a(2*n) = a(2*n-2) + a(n), a(2*n+1) = a(n+1) - a(n).
%F A400345 G.f. A(x) satisfies: A(x) = (1 - x^2) * (A(x^2) - 1) / x + A(x^2) / (1 - x^2).
%F A400345 a(2*n) = Sum_{j=0..n} a(j).
%t A400345 a[0] = 1; a[1] = 0; a[n_] := a[n] = If[EvenQ[n], a[n - 2] + a[n/2], a[(n + 1)/2] - a[(n - 1)/2]]; Table[a[n], {n, 0, 70}]
%t A400345 (* Alternative: *)
%t A400345 nmax = 70; A[_] = 1; Do[A[x_] = (1 - x^2) (A[x^2] - 1)/x + A[x^2]/(1 - x^2) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%Y A400345 Cf. A002487, A005590, A086450, A288310.
%K A400345 sign,new
%O A400345 0,5
%A A400345 _Ilya Gutkovskiy_, Sep 23 2026
