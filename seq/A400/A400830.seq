%e A400830 The leftmost column (A400828) has been constructed in such a way that its n-th term contains the smallest natural number such that applying the arithmetic derivative (A003415) to it n-1 times yields 1, with an extra condition that the terms on the penultimate diagonal, (A400829, 2, 5, 7, 13, 71, 31, ...), should be all distinct.
%o A400830 (PARI)
%o A400830 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400830 v400828 = [1, 2, 6, 21, 138, 375, 950, 1815, 2170, 14090, 38962, 40050, 296199, 508130, 1213250, 2616625, 8171841, 18112694, 26128245, 64965330, 111698550, 211448466, 630097027];
%o A400830 rows_up_to = #v400828;
%o A400830 A400828(n) = v400828[n];
%o A400830 A400830_tr(n,k) = if(1==k,A400828(n),A003415(A400830_tr(n,k-1)));
%o A400830 A400830_list(rows_up_to) = { my(lista=List([])); for(row=1,rows_up_to, for(k=1, row, listput(lista,A400830_tr(row,k)))); Vec(lista); };
%o A400830 v400830 = A400830_list(rows_up_to);
%o A400830 A400830(n) = v400830[n];
