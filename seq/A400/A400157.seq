%S A400157 0,0,0,1,0,0,0,2,2,1,0,2,0,0,2,3,0,1,0,2,1,1,0,3,2,0,2,3,0,2,0,3,2,1,
%T A400157 2,3,0,0,1,3,0,1,0,3,3,1,0,3,2,2,2,3,0,2,2,3,1,2,0,3,0,0,3,3,2,2,0,3,
%U A400157 2,1,0,3,0,0,3,3,2,1,0,3,3,1,0,3,2,0,3,3,0,2,1,3,1,1,2,4,0,2,3,3,0,2,0,3,3
%N A400157 a(n) is the number of iterations of map k -> A392879(k) needed to reach the fixed point A327859(n), when starting from k = A380459(n).
%H A400157 Antti Karttunen, <a href="/A400157/b400157.txt">Table of n, a(n) for n = 1..10000</a>
%H A400157 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400157 a(n) = A392880(A380459(n)).
%e A400157 a(5005) = 5; see the last example in A392880.
%o A400157 (PARI)
%o A400157 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400157 A349394(n) = { my(p=0, e); if((e=isprimepower(n, &p)), p^(e-1), 0); };
%o A400157 A380459(n) = { my(m=1); fordiv(n, d, m *= A276086(d)^A349394(n/d)); (m); };
%o A400157 A129252(n) = { my(pp); forprime(p=2, , pp = p^p; if(!(n%pp), return(p)); if(pp > n, return(1))); };
%o A400157 A392879(n) = { my(p=A129252(n), e); if(1==p, return(n), e = valuation(n, p); (n * p^((e%p)-e) * nextprime(1+p)^(e\p))); };
%o A400157 A392880(n) = { my(u, c=0); while((u=A392879(n))!=n, n = u; c++); (c); };
%o A400157 A400157(n) = A392880(A380459(n));
%Y A400157 Cf. A129252, A327859, A380459, A392879, A392880.
%Y A400157 Cf. A380468 (positions of 0's).
%K A400157 nonn,easy,new
%O A400157 1,8
%A A400157 _Antti Karttunen_, Sep 22 2026
