%S A400499 25,32,36,40,44,45,49,50,56,63,64,65,68,72,75,76,80,81,85,88,90,91,92,
%T A400499 96,98,99,100,104,105,108,112,117,120,125,126,128,130,132,135,136,140,
%U A400499 143,144,147,150,153,154,156,160,162,165,168,169,171,175
%N A400499 Integer circumradii of non-isosceles cyclic quadrilaterals with integer sides.
%C A400499 a,b,c,d are distinct (scalene); i.e. no two sides equal. Quadrilateral inequality and cyclicity are assumed.
%e A400499 a(1) = 25 is in the sequence because it is the smallest possible integer circumradius of a non-isosceles cyclic quadrilateral with integer sides. The unique minimal configuration has sides (14, 30, 40, 48) and an integer area of 936.
%e A400499 The next few terms and their minimal non-isosceles side configurations are:
%e A400499   R = 32: sides (8, 36, 57, 62)
%e A400499   R = 36: sides (3, 26, 49, 66)
%e A400499   R = 40: sides (28, 41, 67, 76)
%e A400499   R = 44: sides (11, 24, 38, 66)
%o A400499 (Python)
%o A400499 def is_valid_R(R):
%o A400499     diameter = 2 * R
%o A400499     for a in range(1, diameter):
%o A400499         for b in range(a + 1, diameter):
%o A400499             for c in range(b + 1, diameter):
%o A400499                 min_d = c + 1
%o A400499                 max_d = min(diameter, a + b + c)
%o A400499                 for d in range(min_d, max_d):
%o A400499                     s = (a + b + c + d) / 2
%o A400499                     area_sq = (s - a) * (s - b) * (s - c) * (s - d)
%o A400499                     if area_sq <= 0: continue
%o A400499                     num_R = (a*b + c*d) * (a*c + b*d) * (a*d + b*c)
%o A400499                     if num_R == 16 * area_sq * R * R:
%o A400499                         return True
%o A400499     return False
%o A400499 # Prints the first terms of the sequence
%o A400499 print([R for R in range(1, 101) if is_valid_R(R)])
%Y A400499 Cf. A233315 (Integer areas of cyclic quadrilaterals with integer sides and circumradius).
%Y A400499 Cf. A210250 (Sorted areas of cyclic quadrilaterals with integer sides and circumradius).
%K A400499 nonn
