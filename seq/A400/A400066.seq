%N A400066 Number of partitions of n such that (greatest part) - (least part) >= 3.
%F A400066 G.f.: -1 - x * (1 + x - x^2) / ( (1 - x) * (1 - x^2)^2 ) + Product_{j>=1} 1 / (1 - x^j).
%e A400066 a(8) = 8 because we have [7,1], [6,2], [6,1,1], [5,2,1], [5,1,1,1], [4,3,1], [4,2,1,1] and [4,1,1,1,1].
%t A400066 nmax = 48; CoefficientList[Series[-1 - x (1 + x - x^2)/((1 - x) (1 - x^2)^2) + Product[1/(1 - x^j), {j, 1, nmax}], {x, 0, nmax}], x] // Rest
