%S A400289 10,17,78,89,170,454,477,509,563,653,743,797,921,949,1054,1258,1297,
%T A400289 1439,1441,1621,1739,2115,2246,2265,2306,2854,3290,3474,3719,3920,
%U A400289 4084,4201,4224,4381,4561,4673,4701,5035,5126,5261,5265,5541,5909,6012,6101,6151,6436
%N A400289 Bases b in which the digits of prime(b*x + y) are the reversal of the digits of prime(b*y + x) for some 0 < x < y < b.
%C A400289 Inspired by the well known property that prime(12) = 37 and prime(21) = 73 in base 10 (where additionally 21 = 3 * 7), mentioned among others in Big Bang Theory S4E10.
%H A400289 Jeff Sponaugle, <a href="/A400289/b400289.txt">Table of n, a(n) for n = 1..519</a>
%e A400289 In base 10, for x = 1, y = 2 we have prime(12) = 37 and prime(21) = 73.
%e A400289 In base 17, prime(167 = 9*17 + 14) = 375[17] and prime(247 = 14*17 + 9) = 573[17] where [b] means "read in base b".
%e A400289 In base 78, prime(3491 = 44*78 + 59) = (5,27,7)[78] and prime(4646 = 59*78 + 44) = (7,27,5)[78].
%e A400289 In base 89, prime(99 = 1*89 + 10) = 5*89 + 78 and prime(891 = 10*89 + 1) = 78*89 + 5.
%o A400289 (PARI) select( {is_A400289(b)=my(u=[1,b], v=[b,1]);forvec(xy=[[1,b-1], [1,b-1]]~, Vecrev(digits(prime(u*xy),b))==digits(prime(v*xy),b)&& return(xy),2)}, [2..200])
%o A400289 (Python)
%o A400289 from sympy.ntheory import digits, sieve
%o A400289 def ok(b):
%o A400289     for x in range(1, b-1):
%o A400289         for y in range(x+1, b):
%o A400289             if digits(sieve[b*x+y], b)[1:][::-1] == digits(sieve[b*y+x], b)[1:]:
%o A400289                 return True
%o A400289     return False
%o A400289 print([b for b in range(200) if ok(b)]) # _Michael S. Branicky_, Nov 05 2026
%Y A400289 Cf. A400290 for the indices b*x + y.
%K A400289 nonn,base,new
%O A400289 1,1
%A A400289 _M. F. Hasler_, Nov 05 2026
%E A400289 a(6) onward from _Michael S. Branicky_, Nov 05 2026
