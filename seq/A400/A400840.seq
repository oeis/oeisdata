%e A400840 The leftmost column (A189760) has been constructed in such a way that its n-th term contains the smallest natural number such that applying the arithmetic derivative (A003415) n-1 times to it yields 1. Each subsequence term to the right is obtained by applying A003415 to the previous term, for example: 33' = 14, 14' = 9, 9' = 6, 6' = 5, 5' = 1.
%o A400840 (PARI)
%o A400840 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400840 v189760 = [1, 2, 6, 9, 14, 33, 62, 177, 414, 1155, 1719, 2625, 4018, 6849, 9770, 17675, 30206, 90609, 260343, 336006, 757995, 1290874, 2029875, 4059746, 7037655, 17594075, 50850483, 68589598, 186888243, 373659254, 1884639669];
%o A400840 rows_up_to = #v189760;
%o A400840 A189760(n) = v189760[n];
%o A400840 A400840_tr(n,k) = if(1==k,A189760(n),A003415(A400840_tr(n,k-1)));
%o A400840 A400840_list(rows_up_to) = { my(lista=List([])); for(row=1,rows_up_to, for(k=1, row, listput(lista,A400840_tr(row,k)))); Vec(lista); };
%o A400840 v400840 = A400840_list(rows_up_to);
%o A400840 A400840(n) = v400840[n];
%Y A400840 Cf. A003415, A189760 (leading column), A000012 (trailing diagonal).
