%N A400342 Expansion of e.g.f. 1 / (1 + x)^tan(x).
%F A400342 a(n) ~ (-1)^n * n! / ( Gamma(-tan(1)) * n^(1+tan(1)) ).
%t A400342 nmax = 24; CoefficientList[Series[1/(1 + x)^Tan[x], {x, 0, nmax}], x] Range[0, nmax]!
%t A400342 (* Alternative: *)
%t A400342 a[0] = 1; a[n_] := a[n] = Sum[Sum[(-1)^(k + 1) Binomial[n - 1, k - 1] Binomial[k, 2 j - 1] (k - 2 j)! 2^(2 j) (2^(2 j) - 1) Abs[BernoulliB[2 j]] a[n - k]/(2 j), {j, 1, Floor[k/2]}], {k, 1, n}]; Table[a[n], {n, 0, 24}]
%Y A400342 Cf. A006229, A009249, A009269, A399237.
%K A400342 sign,new
%O A400342 0,3
