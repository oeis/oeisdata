%S A400764 1,2,3,4,7,8,10,13,15,16,22,25,27,29,31,32,36,42,46,49,51,53,55,57,59,
%T A400764 61,63,64,76,82,86,90,94,97,99,101,103,105,107,109,111,113,115,117,
%U A400764 119,121,123,125,127,128,136,148,156,162,166,170,174,178,182,186
%N A400764 Numbers k > 0 such that the k-th composition in standard order has the same first and last parts.
%C A400764 These compositions are counted by A128209.
%C A400764 Palindrome compositions are A400763, counted by A016116.
%C A400764 The k-th composition in standard order (graded reverse-lexicographic, A066099) is obtained by taking the set of positions of 1's in the reversed binary expansion of k, prepending 0, taking first differences, and reversing again. This gives a bijective correspondence between nonnegative integers and integer compositions.
%e A400764 The 46-th composition in standard order is (2,1,1,2), so 46 is in the sequence.
%e A400764 The terms together with corresponding compositions begin:
%e A400764    1: (1)
%e A400764    2: (2)
%e A400764    3: (1,1)
%e A400764    4: (3)
%e A400764    7: (1,1,1)
%e A400764    8: (4)
%e A400764   10: (2,2)
%e A400764   13: (1,2,1)
%e A400764   15: (1,1,1,1)
%e A400764   16: (5)
%e A400764   22: (2,1,2)
%e A400764   25: (1,3,1)
%e A400764   27: (1,2,1,1)
%e A400764   29: (1,1,2,1)
%e A400764   31: (1,1,1,1,1)
%e A400764   32: (6)
%e A400764   36: (3,3)
%e A400764   42: (2,2,2)
%e A400764   46: (2,1,1,2)
%e A400764   49: (1,4,1)
%t A400764 stc[n_]:=Differences[Prepend[Join @@ Position[Reverse[IntegerDigits[n,2]],1],0]]//Reverse;
%t A400764 Select[Range[100],First[stc[#]]==Last[stc[#]]&]
%Y A400764 For a full palindrome we have A016116, ranked by A400763 (a superset).
%Y A400764 For conjugate partitions instead of cycles we have A088902, counted by A000700.
%Y A400764 Compositions of this type are counted by A128209.
%Y A400764 For odd length we have A401877, counted by A128209, for palindromes A400766.
%Y A400764 For even length we have A401878, counted by A078008, for palindromes A400765.
%Y A400764 The complement is A401974, counted by A167030.
%Y A400764 A000740 counts aperiodic compositions, ranks A328594.
%Y A400764 A011782 counts compositions.
%Y A400764 A059893 reverses standard compositions.
%Y A400764 A066099 lists compositions in standard order.
%Y A400764 A098124 counts compositions with max part = length, ranks A389532.
%Y A400764 Cf. A001045, A006995, A029837, A059966, A091065, A098504, A124767, A154809, A272919, A390675.
