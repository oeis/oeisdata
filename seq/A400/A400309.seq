%T A400309 29,22,23,23,18,15,12,10,6,5,3,1,1,34,38,49,62,61,59,66,62,56,55,47,
%U A400309 39,35,30,21,17,13,8,6,3,2,1,55,71,98,135,138,156,169
%N A400309 Triangle read by rows: T(n,k) is the number of involutions p of {1,...,n} such that inv(p) + rlmin(p) - n = k, where inv is the number of inversions and rlmin the number of right-to-left minima.
%C A400309 The statistic inv(p) + rlmin(p) - n is nonnegative, since every position that is not a right-to-left minimum starts at least one inversion.
%H A400309 Sean A. Irvine, <a href="/A400309/b400309.txt">Table of n, a(n) for n = 0..834</a>
%F A400309 Row sums: Sum_{k} T(n,k) = A000085(n).
%e A400309 Triangle begins:
%e A400309   1;
%e A400309   1;
%e A400309   2;
%e A400309   3,  1;
%e A400309   5,  2,  2,  1;
%e A400309   8,  5,  4,  5,  2,  1,  1;
%e A400309  13, 10, 11, 11,  9,  7,  6,  4,  2,  2,  1;
%e A400309  ...
%e A400309 For n = 3 the involutions are 123 (inv = 0, rlmin = 3), 132 (inv = 1, rlmin = 2), 213 (inv = 1, rlmin = 2) and 321 (inv = 3, rlmin = 1), so the statistic inv + rlmin - 3 takes the values 0, 0, 0, 1, giving T(3,0) = 3 and T(3,1) = 1.
%o A400309 (Python)
%o A400309 from itertools import permutations
%o A400309 from collections import Counter
%o A400309 def row(n):
%o A400309     C = Counter()
%o A400309     for p in permutations(range(n)):
%o A400309         if all(p[p[i]] == i for i in range(n)):  # involution
%o A400309             inv = sum(p[i] > p[j] for i in range(n) for j in range(i+1, n))
%o A400309             m, r = n, 0
%o A400309             for v in reversed(p):  # right-to-left minima
%o A400309                 if v < m: m, r = v, r + 1
%o A400309             C[inv + r - n] += 1
%o A400309     return [C[k] for k in range(max(C) + 1)]
%o A400309 print([t for n in range(10) for t in row(n)])
%Y A400309 Cf. A000045, A000085 (row sums), A001629, A016116, A129178.
%K A400309 nonn,tabf,new
