%o A400532 (PARI) A400532(n,k) = if(gcd(n,k)>1, return(0)); my(r=1, f=factor(n)); for(j=1, #f[, 1], my(p=f[j, 1], e=f[j, 2]); if(k%p^e!=1, r*=if(p>2, p*gcd(znorder(Mod(k,p^e)),p^(e-1)), if(k%2^e==2^e-1, 4, 4*znorder(Mod(k,2^e)))))); return(r);
%Y A400532 Cf. A007431. A399106 is the reduced version.
