%S A400874 1,4,5,6,7,20,9,24,11,28,13,30,15,36,35,18,19,44,21,42,45,52,25,120,
%T A400874 27,60,55,54,31,140,33,72,65,76,63,66,39,84,75,168,43,180,45,78,77,
%U A400874 100,49,90,51,108,95,90,55,220,91,216,105,124,61,210,63,132,99,108,105
%N A400874 The total sum of infinitary divisors of the infinitary divisors of n.
%C A400874 Differs from A107759 at n = 8, 24, 27, 32, 40, 54, 56, 64, 72, 88, 96, ... .
%C A400874 The number of these divisors is A375230(n).
%H A400874 Amiram Eldar, <a href="/A400874/b400874.txt">Table of n, a(n) for n = 1..10000</a>
%F A400874 a(n) = Sum_{d infinitary divisor of n} A049417(d) = Sum_{k=1..A037445(n)} A049417(A077609(n, k)).
%F A400874 Multiplicative with a(p^e) = Product_{i>=0, b_i = 1} (p^(2^i) + 2), where b_i is the i-th bit of e: e = Sum_{i} (b_i * 2^i).
%F A400874 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = Product_{p prime} ((1-1/p) * Product_{k>=0} (1 + 1/p^(2^k) + 2/p^(2^(k+1)))) = 2.07180140470607931804... .
%t A400874 f[p_, e_] := p^(2^(-1 + Position[Reverse@IntegerDigits[e, 2], _?(# == 1 &)])); a[1] = 1; a[n_] := Times @@ (Flatten@(f @@@ FactorInteger[n]) + 2); Array[a, 65]
%o A400874 (PARI) a(n) = {my(f = factor(n), b); prod(i = 1, #f~, b = binary(f[i, 2]); prod(k = 1, #b, if(b[k], 2 + f[i, 1]^(2^(#b-k)), 1)));}
%Y A400874 Cf. A037445, A049417, A077609, A375230.
%Y A400874 Analogous sequences: A007429 (with all the divisors), A107759 (unitary), A400873 (exponential).
%K A400874 nonn,mult,easy,new
%O A400874 1,2
%A A400874 _Amiram Eldar_, Oct 08 2026
