%U A400541 18,17,23,18,16,18,18,19,19,17,19,16,20,23,23,21
%N A400541 Number of ways to write 2n as the sum of two integers each of which has an odd number of prime factors counted with multiplicity.
%C A400541 a(n) >= 1 is the Liouville version of the Goldbach conjecture.
%C A400541 Considers that x+y and y+x are the same, since the name does not say "ordered sum". - _Michel Marcus_, Oct 11 2026
%H A400541 Lookonchain, <a href="https://www.lookonchain.com/feeds/73381">GPT-6 Astra solves Liouville's version of the Goldbach conjecture, with independent verification and approval by Lean</a>.
%F A400541 Limit_{n->oo} a(n)/n = 1/4 if Chowla's conjecture holds.
%e A400541 For n = 4, 2*n = 8, 8 = 1+7 = 2+6 = 3+5 = 4+4, where only (3,5) has both odd bigomega, so a(4) = 1.
%o A400541 (Python)
%o A400541 from sympy import primeomega
%o A400541 def A400541(n):
%o A400541     ct = 0
%o A400541     for m in range(1, n+1):
%o A400541         if (-1)**primeomega(m) == -1 and (-1)**primeomega(2*n-m) == -1: ct += 1
%o A400541     return ct
%o A400541 for n in range(2, 74): print(A400541(n), end = ', ')
%o A400541 (PARI) a(n) = sum(x=1, n, (bigomega(x)%2) && (bigomega(2*n-x)%2)); \\ _Michel Marcus_, Oct 11 2026
%o A400541 (PARI) first(n) = {n++; my(res = vector(2*n), v = select(x->bigomega(x)%2, [1..2*n]), odds = select(x->x%2, v), evens = select(x->!(x%2), v)); odds = concat(odds, [2*n+1]); evens = concat(evens, [2*n]); t = 1; while(odds[t] <= n, u = t; while(odds[t] + odds[u] <= #res, res[odds[t] + odds[u]]++; u++); t++); t = 1; while(evens[t] <= n, u = t; while(evens[t] + evens[u] <= #res, res[evens[t] + evens[u]]++; u++); t++); vector(n, i, res[2*i])[^1]} \\ _David A. Corneth_, Oct 11 2026
%Y A400541 Cf. A001222, A002375, A008836.
