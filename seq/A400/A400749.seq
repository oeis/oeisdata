%U A400749 9546659692819205512119501,78680829903534251829971084952,1293342160343091637052076146624611,42455122490324378791160160496094259758,2784968726193737999979088893858861738511353
%N A400749 G.f. A(x) satisfies: A(x) = 1 + x * A(2*x/(1 - 2*x)^2) / (1 - x)^2.
%F A400749 a(0) = 1; a(n) = Sum_{k=0..n-1} Sum_{j=0..k} binomial(k+j-1,k-j) * (n-k) * 2^k * a(j) for n >= 1.
%t A400749 nmax = 17; A[_] = 0; Do[A[x_] = 1 + x A[2 x/(1 - 2 x)^2]/(1 - x)^2 + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A400749 (* Alternative: *)
%t A400749 a[0] = 1; a[n_] := a[n] = Sum[Sum[Binomial[k + j - 1, k - j] (n - k) 2^k a[j], {j, 0, k}], {k, 0, n - 1}]; Table[a[n], {n, 0, 17}]
