%I A400356 #25 Oct 05 2026 08:33:26
%S A400356 1,4,56,1064,23296,553784,13891584,361936848,9699655680,265667843672,
%T A400356 7403728797696,209265229242160,5984658567200768,172854898283093040,
%U A400356 5035020528130195456,147741151501121395104,4362948440649199779840,129570623140411539906456
%N A400356 G.f. A(x) satisfies A(x) = 1 + 4*x*A(x)^(7/2).
%H A400356 Robert Israel, <a href="/A400356/b400356.txt">Table of n, a(n) for n = 0..662</a>
%H A400356 Wikipedia, <a href="https://en.wikipedia.org/wiki/Fuss-Catalan_number">Fuss-Catalan number</a>.
%F A400356 G.f. A(x) satisfies A(x) = 1/A(-x*A(x)^6).
%F A400356 G.f.: B(x)^2 where B(x) is the g.f. of A399168.
%F A400356 a(n) = 4^n * binomial(7*n/2,n)/(5*n/2 + 1).
%F A400356 D-finite with recurrence: (-3294172*n^6 - 19765032*n^5 - 47059600*n^4 - 56471520*n^3 - 35650048*n^2 - 11063808*n - 1290240)*a(n) + (3125*n^6 + 28125*n^5 + 102500*n^4 + 193500*n^3 + 199520*n^2 + 106560*n + 23040)*a(n + 2) = 0. - _Robert Israel_, Sep 30 2026
%p A400356 with(gfun):
%p A400356 eq:= 16*x^2*y^7 - y^2 + 2*y - 1:
%p A400356 de:= algeqtodiffeq(eq, y(x)):
%p A400356 rec:= {op(diffeqtorec(de, y(x), a(n))), a(1) = 4}:
%p A400356 f:= rectoproc(rec, a(n), remember):
%p A400356 map(f, [$0..20]); # _Robert Israel_, Sep 30 2026
%t A400356 A400356[n_] := 4^n*Binomial[7*n/2, n]/(5*n/2 + 1);
%t A400356 Array[A400356, 20, 0] (* _Paolo Xausa_, Oct 05 2026 *)
%o A400356 (PARI) apr(n, p, r) = r*binomial(n*p+r, n)/(n*p+r);
%o A400356 a(n) = 4^n*apr(n, 7/2, 1);
%Y A400356 Cf. A135863, A214377, A214553.
%Y A400356 Cf. A399165, A399168.
%K A400356 nonn,easy,changed
%O A400356 0,2
%A A400356 _Seiichi Manyama_, Sep 24 2026
