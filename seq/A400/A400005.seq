%e A400005 The spiral begins:
%e A400005     G--*--*--*--*--*--B--*--R--*--B
%e A400005     |                             |
%e A400005     *  G--*--G--B--G--R--B--B--B  R
%e A400005     |  |                       |  |
%e A400005     G  G  B--G--R--*--*--*--R  *  B
%e A400005     |  |  |                 |  |  |
%e A400005     *  G  *  *--*--*--*--*  *  *  *
%e A400005     |  |  |  |           |  |  |  |
%e A400005     G  *  *  *  G--R--B  R  G  *  B
%e A400005     |  |  |  |  |     |  |  |  |  |
%e A400005     *  R  *  R  B  R--G  R  *  R  G
%e A400005     |  |  |  |  |        |  |  |  |
%e A400005     *  *  B  *  *--*--*--*  *  *  *
%e A400005     |  |  |  |              |  |  |
%e A400005     *  B  R  B--*--*--R--G--R  G  R
%e A400005     |  |  |                    |  |
%e A400005     *  B  G--B--R--*--R--G--R--G  R
%e A400005     |  |                          |
%e A400005     *  *--*--*--*--*--*--*--*--*--*
%e A400005     |
%e A400005     B--G--B--*--B--R--G--R--G--R--G
