%I A400456 #12 Oct 04 2026 18:57:40
%S A400456 2,4,16,443426488243037769948249630619149892803
%N A400456 Let m be the n-th hyperoperation applied to n (see A189896). a(n) is the n-th hyperoperation applied to m.
%C A400456 Next term a(4) is too large to include.
%F A400456 a(n) = H_n(m,m) where m=A189896(n), that is, m=H_n(n,n), where H_n is the n-th hyperoperation.
%e A400456 a(0) = H_0(1,1) = 1+1 = 2,
%e A400456 a(1) = H_1(2,2) = 2+2 = 4,
%e A400456 a(2) = H_2(4,4) = 4*4 = 16,
%e A400456 a(3) = H_3(27, 27) = 27^27 = 443426488243037769948249630619149892803.
%o A400456 (Python)
%o A400456 def H(b, c, d):
%o A400456     if b == 0:
%o A400456         return d + 1
%o A400456     elif b == 1:
%o A400456         return c + d
%o A400456     elif b == 2:
%o A400456         return c * d
%o A400456     elif b == 3:
%o A400456         return c ** d
%o A400456     elif d == 0:
%o A400456         return 1
%o A400456     inner = H(b, c, d - 1)
%o A400456     return H(b - 1, c, inner)
%o A400456 def A400456(n):
%o A400456     m = H(n, n, n)
%o A400456     return H(n, m, m)
%o A400456 for n in range(4):
%o A400456     print(A400456(n), end=', ')
%Y A400456 Cf. A213619, A399497, A400199, A400200.
%K A400456 nonn,new
%O A400456 0,1
