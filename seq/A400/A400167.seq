%I A400167 #13 Sep 23 2026 08:49:45
%S A400167 4,12,14,16,18,20,21,22,24,26,27,28,60,62,64,66,68,70,72,74,76,78,80,
%T A400167 82,84,86,88,90,92,93,94,96,98,99,100,102,104,105,106,108,110,111,112,
%U A400167 114,116,117,118,120,122,123,124,126,128,129,130,132,134,135,136,138,140,141,142,144,146,147,148,150,152,153
%N A400167 Numbers k such that A235224(k) = A400164(k), where A235224(n) is the length of primorial base representation of n, and A400164(n) = Max_{d|n, d is a prime power} A235224(n/d).
%C A400167 Numbers k such that the greatest prime dividing A276086(k) is equal to A400165(k), the greatest prime dividing A380459(k).
%H A400167 Antti Karttunen, <a href="/A400167/b400167.txt">Table of n, a(n) for n = 1..10000</a>
%H A400167 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400167 {k such that A235224(k) = A400164(k)}.
%o A400167 (PARI)
%o A400167 A235224(n) = { my(s=0, p=2); while(n, s++; n = n\p; p = nextprime(1+p)); (s); };
%o A400167 A349394(n) = { my(p=0, e); if((e=isprimepower(n, &p)), p^(e-1), 0); };
%o A400167 A400164(n) = { my(m=0); fordiv(n, d, if(isprimepower(d), m = max(m,A235224(n/d)))); (m); };
%o A400167 is_A400167(k) = (A235224(k)==A400164(k));
%Y A400167 Positions of 0's in A400166.
%Y A400167 Cf. A235224, A276086, A380459, A400164, A400165.
%Y A400167 Cf. also A400169.
%K A400167 nonn,new
%O A400167 1,1
%A A400167 _Antti Karttunen_, Sep 23 2026
