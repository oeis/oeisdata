%N A400422 a(n) is the permanent of the (n+1) X (n+1) circulant matrix whose rows are formed by successively rotating the vector (binomial(n,0), ..., binomial(n,n)) right.
%e A400422 a(3) = 440:
%e A400422   [1, 1, 3, 3]
%e A400422   [3, 1, 1, 3]
%e A400422   [3, 3, 1, 1]
%e A400422   [1, 3, 3, 1]
%t A400422 CirculantMatrix[l_List?VectorQ]:=NestList[RotateRight, RotateRight[l], Length[l] - 1]; a[n_]:=Permanent[CirculantMatrix[Binomial[n,Range[0, n]]]]; Array[a, 14,0]
%Y A400422 Cf. A199572 (determinants), A392131, A392132.
