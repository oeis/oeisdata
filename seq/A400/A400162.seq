%I A400162 #21 Sep 21 2026 16:47:16
%S A400162 4,8,12,16,18,20,24,28,32,36,40,44,48,52,54,56,60,64,68,72,76,80,84,
%T A400162 88,90,92,96,100,104,108,112,116,120,124,126,128,132,136,140,144,148,
%U A400162 150,152,156,160,162,164,168,172,176,180,184,188,192,196,198,200,204,208,212,216,220,224,228,232,234,236,240,244
%N A400162 Nonsquarefree numbers k such that their smallest non-unitary prime factor is also the smallest prime q for which valuation(A380459(k),q) >= q.
%C A400162 Lemma given in A380468 guarantees that such prime q exists for all nonsquarefree numbers.
%C A400162 All terms are even (because when A380459 is applied to an odd nonsquarefree number, it always gives a multiple of 4), and all nonzero multiples of 4 are included.
%H A400162 Antti Karttunen, <a href="/A400162/b400162.txt">Table of n, a(n) for n = 1..10000</a>
%F A400162 {k such that A008683(k) = 0 and A249739(k) = A380528(k)}.
%e A400162 A380459(8) = 1296 = 2^4 * 3^4, with the least overflowing prime [prime whose exponent is >= that prime] here being 2, which is equal to the least non-unitary prime factor in 8 (= 2^8), therefore 8 is included in this sequence.
%e A400162 A380459(54) = 1153300781250 = 2^1 * 3^10 * 5^10, with the least overflowing prime here being 3, which is equal to the least non-unitary prime factor in 54 (= 2 * 3^2), therefore 54 is included in this sequence.
%o A400162 (PARI)
%o A400162 A249739(n) = {f = factor(n/core(n)); vsq = select(x->((x%2) == 0), f[, 2], 1); if (#vsq, f[vsq[1], 1], 1); };
%o A400162 A129252(n) = { my(pp); forprime(p=2, , pp = p^p; if(!(n%pp), return(p)); if(pp > n, return(1))); };
%o A400162 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400162 A349394(n) = { my(p=0, e); if((e=isprimepower(n, &p)), p^(e-1), 0); };
%o A400162 A380459(n) = { my(m=1); fordiv(n, d, m *= A276086(d)^A349394(n/d)); (m); };
%o A400162 is_A400162(n) = (!issquarefree(n) && A249739(n)==A129252(A380459(n)));
%Y A400162 Cf. A129252, A249739, A380459, A380468, A380528.
%Y A400162 Setwise difference A013929 \ A400161.
%Y A400162 Setwise difference A400160 \ A380468.
%Y A400162 Subsequences: A008586\{0}.
%K A400162 nonn,new
%O A400162 1,1
%A A400162 _Antti Karttunen_, Sep 21 2026
