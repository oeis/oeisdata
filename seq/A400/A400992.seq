%U A400992 771357400167501996849249511936073,3235298943980292298184030000087465794331,54279270384091026116011090037536129508126863921
%N A400992 G.f. A(x) satisfies: A(x) = 1 + x * A(4*x/(1 + x)) / (1 + x).
%F A400992 a(0) = 1; a(n) = (-1)^(n-1) * Sum_{k=0..n-1} binomial(n-1,k) * (-4)^k * a(k).
%t A400992 nmax = 13; A[_] = 0; Do[A[x_] = 1 + x A[4 x/(1 + x)]/(1 + x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A400992 (* Alternative: *)
%t A400992 a[0] = 1; a[n_] := a[n] = Sum[(-1)^(n - 1) Binomial[n - 1, k] (-4)^k a[k], {k, 0, n - 1}]; Table[a[n], {n, 0, 13}]
%Y A400992 Cf. A000587, A318179, A355082, A400991.
%K A400992 nonn
%O A400992 0,3
