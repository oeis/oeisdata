%T A400226 373022081408,12194137180062,433804178257726,16683943246617078,
%U A400226 689789416696708987,30509016571948179516,1437416354557052313572,71870148428202389345628,3800826173266917577420312
%N A400226 a(0) = 1; a(n) = Sum_{k=1..n} binomial(2*n-k,k) * a(n-k).
%F A400226 G.f. A(x) satisfies: 2*A(x) = 1 + A(x/(1 - x)^2) / (1 - x).
%t A400226 a[0] = 1; a[n_] := a[n] = Sum[Binomial[2 n - k, k] a[n - k], {k, 1, n}]; Table[a[n], {n, 0, 19}]
%t A400226 (* Alternative: *)
%t A400226 nmax = 19; A[_] = 0; Do[A[x_] = 1 - A[x] + A[x/(1 - x)^2]/(1 - x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%Y A400226 Cf. A000108, A000670, A125273.
