%I A400161 #21 Sep 21 2026 16:47:07
%S A400161 9,25,27,45,49,50,63,75,81,98,99,117,121,125,135,147,153,169,171,175,
%T A400161 189,207,225,242,243,245,250,261,275,279,289,294,297,315,325,333,338,
%U A400161 343,350,351,361,363,369,375,387,405,423,425,441,459,475,477,490,495,507,513,525,529,531,539,549,550,567,575,578,585
%N A400161 Nonsquarefree numbers k such that their smallest non-unitary prime factor is larger than the smallest prime q for which valuation(A380459(k),q) >= q.
%C A400161 Lemma given in A380468 guarantees that such prime q exists for all non-squarefree numbers.
%C A400161 For all odd non-squarefree numbers A380459(.) is a multiple of 4, therefore A053850 is a subsequence of this sequence.
%H A400161 Antti Karttunen, <a href="/A400161/b400161.txt">Table of n, a(n) for n = 1..10000</a>
%F A400161 {k such that A249739(k) > A380528(k)}.
%e A400161 A380459(27) = 3317760 = 2^13 * 3^4 * 5^1, with the least overflowing prime [prime whose exponent is >= that prime] here being A380528(27) = 2, which is less than the least non-unitary prime factor 3 in 27 (= 3^3), therefore 27 is included in this sequence.
%e A400161 A380459(50) = 13668750 = 2^1 * 3^7 * 5^5, with the least overflowing prime here 3, which is less than the least non-unitary prime factor 5 in 50 (= 2 * 5^2), therefore 50 is included in this sequence.
%o A400161 (PARI)
%o A400161 A249739(n) = {f = factor(n/core(n)); vsq = select(x->((x%2) == 0), f[, 2], 1); if (#vsq, f[vsq[1], 1], 1); };
%o A400161 A129252(n) = { my(pp); forprime(p=2, , pp = p^p; if(!(n%pp), return(p)); if(pp > n, return(1))); };
%o A400161 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400161 A349394(n) = { my(p=0, e); if((e=isprimepower(n, &p)), p^(e-1), 0); };
%o A400161 A380459(n) = { my(m=1); fordiv(n, d, m *= A276086(d)^A349394(n/d)); (m); };
%o A400161 is_A400161(n) = (A249739(n)>A129252(A380459(n)));
%Y A400161 Cf. A249739, A380459, A380468, A380528.
%Y A400161 Positions of strictly positive terms in A400159.
%Y A400161 Setwise difference A013929 \ A400162.
%Y A400161 Subsequence: A053850.
%K A400161 nonn,new
%O A400161 1,1
%A A400161 _Antti Karttunen_, Sep 21 2026
