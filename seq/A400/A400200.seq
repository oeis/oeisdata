%S A400200 1,2,1,0,3,2,1,1,1,0,4,3,2,1,2,2,2,0,0,1,5,4,3,2,1,3,3,3,3,0,1,0,0,1,
%T A400200 1,6,5,4,3,2,1,4,4,4,4,4,0,2,2,0,0,1,1,0,1,1,7,6,5,4,3,2,1,5,5,5,5,5,
%U A400200 5,0,3,4,3,0,0,1,2,1,1,1,1,0,1,1,8,7,6,5,4,3,2,1,6,6,6,6,6,6,6,0
%N A400200 H_x(y, z), the x-th hyperoperation of y and z, where (x, y, z) is the triple with index n+1 in the lexicographic shell ordering of N^3 given by A057556.
%C A400200 a(331) = H_4(3, 4) = 3^3^3^3 has 3638334640025 decimal digits and is too large to include.
%H A400200 Jens Ahlström, <a href="/A400200/b400200.txt">Table of n, a(n) for n = 0..329</a>
%H A400200 Wikipedia, <a href="https://en.wikipedia.org/wiki/Hyperoperation">Hyperoperation</a>
%F A400200 a(n) = H_x(A144628(n), A144627(n)) where x = A144629(n).
%F A400200 a(n) = H_x(A144625(3*n+1), A144625(3*n)) where x = A144625(3*n+2).
%F A400200 a(n) = H_x(A057556(3*n+2), A057556(3*n+3)) where x = A057556(3*n+1).
%F A400200 a((9*n^3 + 14*n^2 + 7*n)/2) = A189896(n).
%e A400200 a(2) = H_x(A144625(7), A144625(6)) where x = A144625(8) = H_0(1, 0) = 1.
%e A400200 a(76) = H_x(A144628(76), A144627(76)) where x = A144629(76) = H_3(2, 1) = 2.
%e A400200 a(201) = H_x(A057556(605), A057556(606)) where x = A057556(604) = H_4(2, 3) = 16.
%o A400200 (Python)
%o A400200 def H(b, c, d):
%o A400200     if b == 0:
%o A400200         return d + 1
%o A400200     elif b == 1:
%o A400200         return c + d
%o A400200     elif b == 2:
%o A400200         return c * d
%o A400200     elif b == 3:
%o A400200         return c ** d
%o A400200     elif d == 0:
%o A400200         return 1
%o A400200     inner = H(b, c, d - 1)
%o A400200     return H(b - 1, c, inner)
%o A400200 for s in range(8):
%o A400200     for x in range(s + 1):
%o A400200         for y in range(s - x + 1):
%o A400200             z = s - x - y
%o A400200             print(H(x, y, z), end=', ')  # _Jens Ahlström_, Sep 29 2026
%Y A400200 Cf. A399497, A054871 (y=3, z=2), A001695 (x=z, y=2), A189896 (x=y=z), A255176 (y=z=2), A256131 (y=10, z=2), A253855 (y=4, z=2), A261143 (y=1, z=2), A213619, A400199.
%K A400200 tabf,nonn,easy,new
%O A400200 0,2
