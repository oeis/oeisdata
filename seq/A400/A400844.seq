%N A400844 Numbers k of the form prime(i)*prime(i+1)^m, m > 1.
%C A400844 Let k = p*q^m, primes p < q, m > 1, and let g = pi(q) = A000720(A006530(k)).
%C A400844 Nonsquarefree k such that A238690(k) = binomial(g+m+1,g)-1.
%C A400844 Squarefree kernels are in A006094.
%H A400844 Michael De Vlieger, <a href="/A400844/b400844.txt">Table of n, a(n) for n = 1..10000</a>
%e A400844 Let k = p*q^m, primes p < q.
%e A400844 Let f = A238690 and let s = binomial(g+m+1,g).
%e A400844    n    a(n)           f(a(n)) s(a(n))
%e A400844   ------------------------------------
%e A400844    1     18 = 2 * 3^2      9      10
%e A400844    2     54 = 2 * 3^3     14      15
%e A400844    3     75 = 3 * 5^2     19      20
%e A400844    4    162 = 2 * 3^4     20      21
%e A400844    5    245 = 5 * 7^2     34      35
%e A400844    6    375 = 3 * 5^3     34      35
%e A400844    7    486 = 2 * 3^5     27      28
%e A400844    8    847 = 7 * 11^2    55      56
%e A400844    9   1458 = 2 * 3^6     35      36
%e A400844   10   1715 = 5 * 7^3     69      70
%e A400844   11   1859 = 11 * 13^2   83      84
%e A400844   12   1875 = 3 * 5^4     55      56
%t A400844 nn = 19; m = Prime[nn - 1]*Prime[nn]^2; Union@ Reap[Do[Set[{p, q}, Prime[{i, i + 1}] ]; j = 2; While[Set[k, p*q^j] <= m, j++; Sow[k] ], {i, nn}] ][[-1, 1]]
