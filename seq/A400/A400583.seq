%I A400583 #31 Nov 17 2026 22:44:07
%S A400583 1,4,24,40,60,120,180,210,360,420,720,840,2520,3780,4620,6300,7560,
%T A400583 12600,13860,15120,25200,32760,33264,49140,55440,138600,163800,166320,
%U A400583 240240,277200,514080,554400,665280,720720,942480,1081080,1441440,1884960,2702700,2827440
%N A400583 Record positions in A400943.
%C A400583 A record value can exceed the previous one by more than 1 (e.g. 10 -> 13 at a(12) = 840); then several thresholds of A400943 are reached first at the same number, see A400625.
%C A400583 All of the first 46 terms are 2-dense (A174973); i.e., consecutive divisors differ at most by the factor 2; equivalently p_i <= 2*Product_{j<i} p_j^e_j for k = Product p_j^e_j with p_1 < p_2 < ... It is not known whether every term is 2-dense.
%H A400583 Siegfried Pohl, <a href="/A400583/b400583.txt">Table of n, a(n) for n = 1..46</a>
%H A400583 Siegfried Pohl, <a href="https://doi.org/10.13140/RG.2.2.13829.72167">Divisorkettenfolgen</a>, ResearchGate.
%e A400583 a(4) = 40: 40 = 5*8, 80 = 8*10, 120 = 10*12 is a chain of length 3, and A400943(k) <= 2 for all k < 40.
%e A400583 a(12) = 840: A400943(840) = 13, while A400943(k) <= 10 for all k < 840.
%p A400583 DDNext := proc(n, j, R) local N, S, d, e, U, Dv; N := (j+1)*n; S := {}; for d in R do e := iquo(j*n, d); U := iquo(N, e+2); for Dv in NumberTheory:-Divisors(N) do if d+2 <= Dv and Dv <= U then S := S union {Dv}; end if; end do; end do; return S; end proc:
%p A400583 A := proc(n) local R, j; R := select(d -> 2 <= d and 2*d <= n, NumberTheory:-Divisors(n)); j := 0; while 0 < nops(R) do j := j+1; R := DDNext(n, j, R); end do; return j; end proc:
%p A400583 R := proc(N) local L, best, n, v; L := [1]; best := 0; for n from 2 to N do v := A(n); if v > best then L := [op(L), n]; best := v; end if; end do; return L; end proc:
%p A400583 R(10000);
%Y A400583 Cf. A400943, A400625, A002182, A174973.
%K A400583 nonn,new
%O A400583 1,2
