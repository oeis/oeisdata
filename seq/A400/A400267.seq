%T A400267 0,0,2,0,0,0,2,0,1,0,1,1,0,0,3,0,1,0,1,0,2,0,3,0,1,0,3,0,1,1,6,0,2,0,
%U A400267 2,0,1,0,5,0,1,1,2,0,2,0,5,3,1,0,4,0,1,1,4,0,4,0,3,1,1,0,2,0,2,2,4,0,3,0,5,2
%N A400267 The fourth least significant digit of n' [the arithmetic derivative of n, A003415] in the primorial base, A049345.
%C A400267 The exponent of the highest power of 7 dividing A276086(A003415(n)), where A003415 is the arithmetic derivative, and A276086 is the primorial base exp-function.
%H A400267 Antti Karttunen, <a href="/A400267/b400267.txt">Table of n, a(n) for n = 0..10000</a>
%H A400267 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400267 a(n) = A214411(A327859(n)).
%F A400267 For n >= 1, a(n) = A214411(A392879(A392879(A392879(A392879(A380459(n)))))).
%o A400267 (PARI)
%o A400267 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400267 A214411(n) = valuation(n, 7);
%o A400267 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400267 A327859(n) = A276086(A003415(n));
%o A400267 A400267(n) = A214411(A327859(n));
%Y A400267 The fourth column of A400260.
%Y A400267 Cf. A003415, A049345, A214411, A276086, A327859, A380459, A392879.
%Y A400267 Cf. also A165560, A400253, A400263, A400265.
%K A400267 nonn,base,easy,new
%O A400267 0,33
