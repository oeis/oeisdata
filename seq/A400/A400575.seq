%N A400575 a(n) = (1/n) * Sum_{k=0..n-1} binomial(n+k-1,k) * binomial(n,n-k-1) * n^k.
%F A400575 a(n) = Sum_{k=0..n-1} binomial(n+k-1,2*k) * A000108(k) * n^k.
%F A400575 a(n) = [x^n] Series_Reversion( x * (1 - n * x) / (1 + x) ).
%F A400575 a(n) ~ sqrt(e) * (4*n)^n / (4*sqrt(Pi) * n^(5/2)).
%t A400575 Table[(1/n) Sum[Binomial[n + k - 1, k] Binomial[n, n - k - 1] n^k, {k, 0, n - 1}], {n, 1, 18}]
%t A400575 (* Alternative: *)
%t A400575 Table[SeriesCoefficient[InverseSeries[Series[x (1 - n x)/(1 + x), {x, 0, n}], x], {x, 0, n}], {n, 1, 18}]
%t A400575 (* Alternative: *)
%t A400575 Table[Hypergeometric2F1[1 - n, n, 2, -n], {n, 1, 18}] (* _Vaclav Kotesovec_, Sep 30 2026 *)
