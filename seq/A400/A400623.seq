%U A400623 7575811785690410880,486623692716732862688,33356879982104123958272,2430490894704649591255728,187586508183144826066323584
%N A400623 a(0) = 1; a(n) = Sum_{k=1..n} binomial(3*n+k,k) * a(n-k).
%F A400623 G.f. A(x) satisfies A(x) = (1-4*x) * (2*A(x*(1-x)^3) - 1).
%F A400623 4|a(n) for n > 0.
%o A400623 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(3*i+j, j)*v[i-j+1])); v;
%Y A400623 Cf. A011782, A400622, A401626.
