%S A400870 1,3,3,3,3,9,3,10,3,9,3,9,3,9,9,3,3,9,3,9,9,9,3,30,3,9,10,9,3,27,3,9,
%T A400870 9,9,9,9,3,9,9,30,3,27,3,9,9,9,3,9,3,9,9,9,3,30,9,30,9,9,3,27,3,9,9,
%U A400870 10,9,27,3,9,9,27,3,30,3,9,9,9,9,27,3,9,3,9,3,27
%N A400870 The number of ordered pairs of infinitary divisors (d_1, d_2) of n such that d_1*d_2 is also an infinitary divisor of n.
%H A400870 Amiram Eldar, <a href="/A400870/b400870.txt">Table of n, a(n) for n = 1..10000</a>
%F A400870 Multiplicative with a(p^e) = A400869(e).
%F A400870 a(n) >= 3 for n > 1, with equality if an only if n is a "Fermi-Dirac prime" (A050376).
%F A400870 a(n) is a power of 3 if all the exponents in the prime factorization of n are Fibbinary numbers (A003714).
%t A400870 g[e_] := g[e] = Product[2^(k-1)*(2^k+1), {k, Length /@ Select[Split[IntegerDigits[e, 2]], First[#] == 1 &]}];
%t A400870 f[p_, e_] := g[e]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 84]
%o A400870 (PARI) lengths(n) = {my(b = binary(n), r = []); for(i = 1, #b, if(b[i], if(i == 1 || !b[i-1], r = concat(r, 1), r[#r]++))); r;}
%o A400870 f(k) = 2^(k-1)*(2^k+1);
%o A400870 s(n) = my(r = lengths(n)); prod(i = 1, #r, f(r[i]));
%o A400870 a(n) = vecprod(apply(s, factor(n)[, 2]));
%Y A400870 Cf. A003714, A037445, A050376, A077609, A375230, A400869.
%Y A400870 Analogous sequences: A007425 (with all the divisors), A074816 (unitary), A400871 (exponential).
%K A400870 nonn,mult,easy,new
%O A400870 1,2
%A A400870 _Amiram Eldar_, Oct 08 2026
