%S A400218 -1,1,1,-1,5,1,-13,151,-163,265,3323,-6929,24053,44881,-159805,943879,
%T A400218 -211507,-1271591,26121803,-35647265,79679717,518667169,-1242104173,
%U A400218 4949458039,5328243005,-24016681559,173636777627,-101824261169,-25715808043,4408436020465
%N A400218 Scaled z-coordinates of the vertices of a Boerdijk-Coxeter helix starting at a tetrahedron with vertices (-1,-1,-1), (1, -1, 1), (-1, 1, 1), and (1, 1, -1).
%C A400218 Each coordinate is scaled by a factor of k, where k = 1 if n <= 3, otherwise k = 3^(n-3).
%C A400218 There are 24 possible choices for Boerdijk-Coxeter helices with this starting tetrahedron, one for each symmetry of the tetrahedron. This helix is the choice that asymptotically maximizes the x-value and then maximizes the y-value.
%H A400218 Wikipedia, <a href="https://en.wikipedia.org/wiki/Boerdijk%E2%80%93Coxeter_helix">Boerdijk-Coxeter helix</a>
%F A400218 G.f.: (18*x^5 + 26*x^4 - 24*x^3 - 5*x^2 + 1)/(27*x^3 + 3*x^2 - x - 1) (conjectured).
%e A400218 The first ten vertices are at
%e A400218 (  -1/1,     -1/1,     -1/1),
%e A400218 (  -1/1,      1/1,      1/1),
%e A400218 (   1/1,     -1/1,      1/1),
%e A400218 (   1/1,      1/1,     -1/1),
%e A400218 (   5/3,      5/3,      5/3),
%e A400218 (  31/9,      1/9,      1/9),
%e A400218 (  83/27,    77/27,   -13/27),
%e A400218 ( 361/81,   169/81,   151/81),
%e A400218 (1373/243,  413/243, -163/243), and
%e A400218 (3895/729, 3145/729,  265/729).
%Y A400218 Cf. A400216 (x-values), A400217 (y-values).
%K A400218 sign,frac,new
%O A400218 0,5
%A A400218 _Peter Kagey_, Sep 21 2026
