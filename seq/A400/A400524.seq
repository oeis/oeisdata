%S A400524 1,0,2,1,0,3,0,2,1,0,4,1,2,1,0,3,0,1,0,5,1,0,2,1,0,3,1,0,2,0,4,2,1,3,
%T A400524 1,0,2,1,0,1,0,2,1,0,3,1,0,1,0,4,0,2,1,0,3,1,2,1,0,5,1,1,0,3,1,0,2,1,
%U A400524 0,4,1,0,2,0,3,0,2,7,1,0,2,1,0,1,0,2,1,0,4,1,0,1
%N A400524 The exponent of the highest power of 2 dividing the number following the n-th squarefree number.
%C A400524 The asymptotic density of the occurrences of k is 1/3 for k = 0, and 1/(3*2^(k-1)) for k >= 1.
%H A400524 Amiram Eldar, <a href="/A400524/b400524.txt">Table of n, a(n) for n = 1..10000</a>
%F A400524 a(n) = A007814(A005117(n)+1).
%F A400524 a(n) <= A399088(n).
%F A400524 Asymptotic mean: Limit_{m->oo} (1/m) * Sum_{k=1..m} a(k) = 4/3.
%t A400524 IntegerExponent[Select[Range[150], SquareFreeQ] + 1, 2]
%o A400524 (PARI) list(kmax) = for(k = 1, kmax, if(issquarefree(k), print1(valuation(k+1, 2), ", ")));
%Y A400524 Cf. A005117, A007814, A023512, A399088, A400525.
%K A400524 nonn,easy,new
%O A400524 1,3
%A A400524 _Amiram Eldar_, Sep 29 2026
