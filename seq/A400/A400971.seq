%I A400971 #16 Nov 10 2026 17:06:53
%S A400971 0,0,0,0,0,0,0,0,0,40,144,408,1268,3960,11376,36906,109930,316568,
%T A400971 988696,2977168,9195492,29144712,89762856,276988018,892103138,
%U A400971 2868433960,9144472216,30309898568,99122622884,324627077064,1101674029000,3678451477296,12345671326856
%N A400971 Number of ordered pairs of distinct subsets A,B of {1,...,n} with equal sums of elements and equal sums of cubes of elements.
%C A400971 Equivalently, a(n) is the number of subsets of {-n, ..., -1, 1, ..., n} that are not symmetric about zero and whose first and third power sums both vanish.
%C A400971 Every such subset contains at least five elements, and this lower bound is sharp, as shown by {-9, -5, -1, 7, 8}.
%F A400971 a(n) = [x^0*y^0] Product_{k=1..n} (2 + x^k*y^(k^3) + x^(-k)*y^(-k^3)) - 2^n.
%F A400971 a(n) = Sum_{s,t} r_n(s,t)*(r_n(s,t)-1), where F_n(x,y) = Product_{k=1..n} (1 + x^k*y^(k^3)) = Sum_{s,t} r_n(s,t)*x^s*y^t.
%F A400971 a(n+1) >= 2*a(n).
%F A400971 a(n) == 0 (mod 2); if n == 1 or 2 (mod 4), then a(n) == 0 (mod 4).
%e A400971 For n=9, after removing the common intersection, the two unordered pairs are ({7,8},{1,5,9}) and ({5,7,8},{2,3,6,9}). Their common sums are 15 and 20, and their common cube sums are 855 and 980. Adding a common subset of the unused elements and reversing the pair gives 2*2^4 + 2*2^2 = 40 ordered pairs.
%o A400971 (Python)
%o A400971 from collections import defaultdict
%o A400971 def distribution(values):
%o A400971     counts = {(0, 0): 1}
%o A400971     for k in values:
%o A400971         nxt = defaultdict(int)
%o A400971         for (s, t), w in counts.items():
%o A400971             nxt[s, t] += 2*w
%o A400971             nxt[s+k, t+k**3] += w
%o A400971             nxt[s-k, t-k**3] += w
%o A400971         counts = dict(nxt)
%o A400971     return counts
%o A400971 def a(n):
%o A400971     m = n//2
%o A400971     left = distribution(range(1, m+1))
%o A400971     right = distribution(range(m+1, n+1))
%o A400971     total = sum(w*right.get((-s, -t), 0)
%o A400971                 for (s, t), w in left.items())
%o A400971     return total - 2**n
%o A400971 print([a(n) for n in range(31)])
%K A400971 nonn,new
%O A400971 0,10
