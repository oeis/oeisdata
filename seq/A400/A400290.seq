%I A400290 #22 Nov 12 2026 21:58:25
%S A400290 12,167,3491,99,10146,15928,1440,1566,21441,18987,29022,16786,18491,
%T A400290 13320,17940,36545,59727,11575,426513,131401,132275,108003,67448,
%U A400290 151859,233035,265554,237008,93840,100572,70714,147150,96860,697195,736218,255550,317978,362130
%N A400290 Least index x*b+y for which the base-b digits of prime(x*b+y) are the reversal of the base-b digits of prime(y*b+x), 0 < x < y < b = A400289(n).
%C A400290 Inspired by the well known property that prime(12) = 37 and prime(21) = 73 in base 10 (where additionally 21 = 3 * 7), mentioned among others in Big Bang Theory S4E10.
%H A400290 Jeff Sponaugle, <a href="/A400290/b400290.txt">Table of n, a(n) for n = 1..519</a>
%e A400290 In base A400289(1) = 10, for x = 1, y = 2 we have prime(12) = 37 and prime(21) = 73.
%e A400290 In base A400289(2) = 17, prime(167 = 9*17 + 14) = 375[17] and prime(247 = 14*17 + 9) = 573[17] where [b] means "read in base b".
%e A400290 In base A400289(3) = 78, prime(3491 = 44*78 + 59) = (5,27,7)[78] and prime(4646 = 59*78 + 44) = (7,27,5)[78].
%e A400290 In base A400289(4) = 89, prime(99 = 1*89 + 10) = 5*89 + 78 and prime(891 = 10*89 + 1) = 78*89 + 5.
%o A400290 (PARI) A400290(n, b=A400289[n])=[1,b]*is_A400289(b) \\ where A400289 must be precomputed or the base b given "by hand" as 2nd argument; the function is_A400289 is expected to return [x,y]~.
%o A400290 (Python)
%o A400290 from sympy.ntheory import digits, sieve
%o A400290 def ok_value(b): # returns least index x*b+y showing b in A400289, else False
%o A400290     for x in range(1, b-1):
%o A400290         for y in range(x+1, b):
%o A400290             if digits(sieve[b*x+y], b)[1:][::-1] == digits(sieve[b*y+x], b)[1:]:
%o A400290                 return b*x+y
%o A400290     return False
%o A400290 print([v for b in range(200) if (v:=ok_value(b))]) # _Michael S. Branicky_, Nov 05 2026
%K A400290 nonn,base,new
%O A400290 1,1
%A A400290 _M. F. Hasler_, Nov 05 2026
%E A400290 a(6) onward from _Michael S. Branicky_, Nov 05 2026
