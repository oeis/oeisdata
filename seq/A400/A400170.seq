%I A400170 #11 Sep 23 2026 08:50:08
%S A400170 8,9,10,15,16,24,25,28,30,32,36,40,42,44,45,48,50,52,54,56,58,63,75,
%T A400170 81,87,96,108,112,120,125,128,136,144,145,152,156,160,161,162,168,176,
%U A400170 180,184,189,192,196,198,200,203,204,208,209,210,212,216,220,221,224,225,228,232,234,236,240,243,244,246,247,248
%N A400170 Numbers k such that A235224(A003415(k)) > A400164(k), where A235224 is the length of primorial base representation, A400164(n) = Max_{d|n, d is a prime power} A235224(n/d), and A003415 is the arithmetic derivative.
%C A400170 Numbers k such that the greatest prime dividing A327859(k) is greater than to A400165(k), the greatest prime dividing A380459(k).
%C A400170 Indices of such rows in arrays A400250 and A400260 where their rightmost nonzero elements do not occur in the same column, but the last nonzero term occurs later on the row k of A400260 than of A400250, i.e., where the primorial base carry resolving (see A392879, A400157) propagates the carry past the original gpf-position of A380459(k).
%H A400170 Antti Karttunen, <a href="/A400170/b400170.txt">Table of n, a(n) for n = 1..10000</a>
%H A400170 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400170 {k such that A400262(k) > A400164(k)}.
%F A400170 {k such that A006530(A327859(k)) > A006530(A380459(k)}.
%o A400170 (PARI)
%o A400170 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A400170 A235224(n) = { my(s=0, p=2); while(n, s++; n = n\p; p = nextprime(1+p)); (s); };
%o A400170 A400164(n) = { my(m=0); fordiv(n, d, if(isprimepower(d), m = max(m,A235224(n/d)))); (m); };
%o A400170 is_A400170(k) = (A235224(A003415(k))>A400164(k));
%Y A400170 Positions of nonzero terms in A400168.
%Y A400170 Cf. A003415, A006530, A235224, A327859, A380459, A392879, A400157,  A400164, A400262, A400169 (complement).
%Y A400170 Cf. arrays A400250 and A400260.
%K A400170 nonn,new
%O A400170 1,1
%A A400170 _Antti Karttunen_, Sep 23 2026
