%S A400599 1,2,10,11,12,30,13,3,4,14,15,5,6,20,40,70,106,105,104,103,102,100,
%T A400599 101,143,142,141,140,190,250,191,251,192,252,320,321,322,323,324,400,
%U A400599 401,402,403,404,405,406,330,260,200,201,202,150,203,204,205,206,207
%N A400599 Squares visited by a chess king moving on the square spiral, always moving to an adjacent unvisited square whose number has the smallest product of digits; ties are resolved by choosing the lowest number.
%C A400599 The board is numbered by the standard square spiral, with 1 at the origin, 2 immediately to its right, and 3 above 2. The king starts at square 1. At each step it moves to one of the eight adjacent squares that has not previously been visited.
%C A400599 The sequence is finite. The last term is a(151) = 82.
%H A400599 Bartlomiej Pawlik, <a href="/A400599/b400599.txt">Table of n, a(n) for n = 1..151</a>
%e A400599 Starting from a(2) = 2, the available adjacent squares are 3, 4, 9, 10 and 11. Their products of digits are 3, 4, 9, 0 and 1, respectively, so the minimum is attained by 10. Hence a(3) = 10.
%t A400599 Module[{d=DeleteCases[Tuples[{-1,0,1},2],{0,0}],u,f,p={0,0},s={1},a,c},u[{x_,y_}]:=1+Which[y>=Abs[x],4y^2-y-x,-x>=Abs[y],4x^2-x-y,-y>=Abs[x],(4y-3)y+x,True,(4x-3)x+y];f[n_]:=Times@@IntegerDigits[n];While[True,c=Select[{u[#],#}&/@((p+#)&/@d),!MemberQ[s,#[[1]]]&];If[c=={},Break[]];a=First@SortBy[c,{f[#[[1]]]&,#[[1]]&}];p=a[[2]];AppendTo[s,a[[1]]]];s]
%Y A400599 Cf. A007954, A335816, A333713, A335856, A335661, A400598.
%K A400599 nonn,walk,fini,full,base,new
%O A400599 1,2
%A A400599 _Bartlomiej Pawlik_, Oct 01 2026
