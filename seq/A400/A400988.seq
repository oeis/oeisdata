%e A400988   8 |         105 12460 128492  212976    40320
%e A400988   9 |              5985 257068 1731276  2239344    362880
%e A400988  10 |               945 217350 5031460 24403176  25659360   3628800
%e A400988  11 |                    79695 6536530 97266620 361732536 318540960 39916800
%p A400988 with(orthopoly): Tpoly := (n, x) -> simplify(L(n, -x, -x)):
%p A400988 T := (n, k) -> n! * coeff(Tpoly(n, x), x, n - k):
%p A400988 seq(seq(T(n, k), k = 0..n), n = 0..9); # _Peter Luschny_, Oct 19 2026
%t A400988 rows=10;CoefficientList[CoefficientList[Series[(1-x*y)^(1/y-1)*E^(x/(1-x*y)),{x,0,rows}],x]*Range[0,rows]!,y]//MatrixForm
%o A400988 (Python)
%o A400988 from functools import cache
%o A400988 A400988=cache(lambda n,k: int(0<=k<=n<=2*k and (n==k==0 or (2*n-1)*A400988(n-1,k-1) - (n-1)*((n-1)*A400988(n-2,k-2) - A400988(n-2,k-1)))))
%Y A400988 Cf. A000262 (row sums), A058349 (column sums), A008299, A066668, A067318 (T(n,n-1)), A400987.
%Y A400988 Cf. A001008/A002805 (H(n)), A007406/A007407 (H(n,2)).
%K A400988 nonn,tabl,new
%O A400988 0,6
%A A400988 _Natalia L. Skirrow_, Oct 15 2026
