%N A400163 The exponent of the largest prime dividing A380459(n), with a(1) = 0 by convention.
%H A400163 Antti Karttunen, <a href="/A400163/b400163.txt">Table of n, a(n) for n = 1..10000</a>
%H A400163 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A400163 a(n) = A071178(A380459(n)).
%F A400163 For n > 1, a(n) = A400250(n, A400164(n)).
%o A400163 (PARI)
%o A400163 A071178(n) = if(1==n, 0, factor(n)[omega(n), 2]);
%o A400163 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A400163 A349394(n) = { my(p=0, e); if((e=isprimepower(n, &p)), p^(e-1), 0); };
%o A400163 A380459(n) = { my(m=1); fordiv(n, d, m *= A276086(d)^A349394(n/d)); (m); };
%o A400163 A400163(n) = A071178(A380459(n));
%Y A400163 Cf. A071178, A380459, A400164, A400165 (the corresponding prime).
%Y A400163 For n > 1, the rightmost nonzero term on row n of array A400250.
%K A400163 nonn,base,easy,new
%O A400163 1,6
%A A400163 _Antti Karttunen_, Sep 22 2026
