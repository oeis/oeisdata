%U A367040 5738510504979,37234351046835,242567430368298,1585979835198675,10403866383915844,68453912880893025
%N A367040 G.f. satisfies A(x) = 1 + x^2 + x*A(x)^3.
%H A367040 Robert Israel, <a href="/A367040/b367040.txt">Table of n, a(n) for n = 0..1181</a>
%F A367040 a(n) = Sum_{k=0..floor(n/2)} binomial(2*(n-2*k)+1,k) * binomial(3*(n-2*k),n-2*k)/(2*(n-2*k)+1).
%F A367040 D-finite with recurrence: 15*(3*n + 4)*(3*n - 1)*a(n) + 9*(33*n^2 + 141*n + 140)*a(n + 2) + 9*(21*n^2 + 165*n + 316)*a(n + 4) - 10*(2*n + 11)*(n + 3)*a(n + 5) + 3*(3*n + 20)*(3*n + 19)*a(n + 6) - 2*(2*n + 15)*(n + 7)*a(n + 7). - _Robert Israel_, Oct 09 2026
%p A367040 with(gfun):
%p A367040 eq:= -y + 1 + x^2 + x*y^3:
%p A367040 de:= algeqtodiffeq(eq,y(x)):
%p A367040 rec:= diffeqtorec(de,y(x),a(n)):
%p A367040 f:= rectoproc(rec,a(n),remember):
%p A367040 map(f, [$0..30]); # _Robert Israel_, Oct 09 2026
%o A367040 (PARI) a(n) = sum(k=0, n\2, binomial(2*(n-2*k)+1, k)*binomial(3*(n-2*k), n-2*k)/(2*(n-2*k)+1));
