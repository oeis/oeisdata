%U A367029 -7839760737,-21249466773,24651743523,356735365223,941396264159,-1257287146286,-16589782316762
%N A367029 G.f. satisfies A(x) = 1 + x*A(x) - x^2*A(x)^4.
%H A367029 Robert Israel, <a href="/A367029/b367029.txt">Table of n, a(n) for n = 0..1725</a>
%F A367029 a(n) = Sum_{k=0..floor(n/2)} (-1)^k * binomial(n+2*k,k) * binomial(n+k,n-2*k) / (3*k+1).
%F A367029 D-finite with recurrence: (-27*n^3 - 81*n^2 - 69*n - 15)*a(n) + (54*n^3 + 81*n^2 - 165*n - 237)*a(n + 1) + (-229*n^3 - 888*n^2 - 590*n + 510)*a(n + 2) + (-620*n^3 - 6510*n^2 - 21538*n - 22218)*a(n + 3) + (-229*n^3 - 3921*n^2 - 21821*n - 39675)*a(n + 4) + (54*n^3 + 1053*n^2 + 6639*n + 13635)*a(n + 5) + (-27*n^3 - 486*n^2 - 2904*n - 5760)*a(n + 6) = 0. - _Robert Israel_, Aug 31 2026
%p A367029 with(gfun):
%p A367029 eq:= -y+1+x*y-x^2*y^4:
%p A367029 de:= algeqtodiffeq(eq,y(x)):
%p A367029 rec:= diffeqtorec(de,y(x),a(n)):
%p A367029 f:= rectoproc(rec,a(n),remember):
%p A367029 map(f,[$0..40]); # _Robert Israel_, Aug 31 2026
%o A367029 (PARI) a(n) = sum(k=0, n\2, (-1)^k*binomial(n+2*k, k)*binomial(n+k, n-2*k)/(3*k+1));
%Y A367029 Cf. A343773, A367028, A367030.
%K A367029 sign,changed
