%U A367028 802102322,3376515404,2496314012,-21558225312,-80113377828,-37101814188,579611761168
%N A367028 G.f. satisfies A(x) = 1 + x*A(x) - x^2*A(x)^3.
%H A367028 Robert Israel, <a href="/A367028/b367028.txt">Table of n, a(n) for n = 0..2052</a>
%F A367028 a(n) = Sum_{k=0..floor(n/2)} (-1)^k * binomial(n+k,k) * binomial(n,n-2*k) / (2*k+1).
%F A367028 D-finite with recurrence: (-4*n^2 - 6*n - 2)*a(n) + (31*n^2 + 81*n + 50)*a(n + 1) + (66*n^2 + 414*n + 636)*a(n + 2) + (-20*n^2 - 156*n - 304)*a(n + 3) + (8*n^2 + 72*n + 160)*a(n + 4) = 0. - _Robert Israel_, Aug 31 2026
%p A367028 with(gfun):
%p A367028 eq:= -y+1+x*y-x^2*y^3:
%p A367028 de:= algeqtodiffeq(eq,y(x)):
%p A367028 rec:= diffeqtorec(de,y(x),a(n)):
%p A367028 f:= rectoproc(rec,a(n),remember):
%p A367028 map(f, [$0..40]); # _Robert Israel_, Aug 31 2026
%o A367028 (PARI) a(n) = sum(k=0, n\2, (-1)^k*binomial(n+k, k)*binomial(n, n-2*k)/(2*k+1));
