%S A367043 1,1,4,23,144,997,7304,55646,436320,3497846,28538852,236203518,
%T A367043 1978290648,16735471979,142789868112,1227339581084,10617748941840,
%U A367043 92377468226466,807769888050640,7095187345173620,62574408414192220,553881698543850337
%N A367043 G.f. satisfies A(x) = 1 + x^3 + x*A(x)^4.
%H A367043 Robert Israel, <a href="/A367043/b367043.txt">Table of n, a(n) for n = 0..1022</a>
%F A367043 a(n) = Sum_{k=0..floor(n/3)} binomial(3*(n-3*k)+1,k) * binomial(4*(n-3*k),n-3*k)/(3*(n-3*k)+1).
%F A367043 D-finite with recurrence: -6400*(2*n + 9)*(-1 + 2*n)*(n + 2)*a(n) - 640*(128*n^3 + 1416*n^2 + 5074*n + 5805)*a(n + 3) - 128*(722*n^3 + 11946*n^2 + 65923*n + 121644)*a(n + 6) - 64*(652*n^3 + 15090*n^2 + 115718*n + 295605)*a(n + 9) + 300*(3*n + 11)*(n + 7)*(3*n + 31)*a(n + 10) - 16*(368*n^3 + 12576*n^2 + 140779*n + 513702)*a(n + 12) + 30*(3*n + 40)*(6*n^2 + 127*n + 613)*a(n + 13) - 8*(4*n + 61)*(2*n + 31)*(4*n + 63)*a(n + 15) + 3*(3*n + 47)*(3*n + 49)*(n + 16)*a(n + 16) = 0. - _Robert Israel_, Oct 09 2026
%p A367043 with(gfun):
%p A367043 eq:= -y + 1 + x^3 + x*y^4:
%p A367043 de:= algeqtodiffeq(eq,y(x)):
%p A367043 rec:= diffeqtorec(de,y(x),a(n)):
%p A367043 f:= rectoproc(rec,a(n),remember):
%p A367043 map(f, [$0..30]); # _Robert Israel_, Oct 09 2026
%o A367043 (PARI) a(n) = sum(k=0, n\3, binomial(3*(n-3*k)+1, k)*binomial(4*(n-3*k), n-3*k)/(3*(n-3*k)+1));
%Y A367043 Cf. A366676, A367042.
%K A367043 nonn,changed
%O A367043 0,3
