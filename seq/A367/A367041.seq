%U A367041 153442147343648,1379250344938676,12453816724761706,112907775890596400,1027394297869071687
%N A367041 G.f. satisfies A(x) = 1 + x^2 + x*A(x)^4.
%H A367041 Robert Israel, <a href="/A367041/b367041.txt">Table of n, a(n) for n = 0..1009</a>
%F A367041 a(n) = Sum_{k=0..floor(n/2)} binomial(3*(n-2*k)+1,k) * binomial(4*(n-2*k),n-2*k)/(3*(n-2*k)+1).
%F A367041 D-finite with recurrence: -392*(2*n + 3)*(4*n + 13)*(4*n - 1)*a(n) - 56*(736*n^3 + 5904*n^2 + 15314*n + 12621)*a(n + 2) - 16*(3040*n^3 + 36144*n^2 + 143798*n + 191469)*a(n + 4) - 16*(1504*n^3 + 24912*n^2 + 137462*n + 253371)*a(n + 6) + 147*(n + 5)*(3*n + 22)*(3*n + 8)*a(n + 7) - 8*(544*n^3 + 12816*n^2 + 99326*n + 252525)*a(n + 8) + 42*(3*n + 28)*(3*n^2 + 44*n + 148)*a(n + 9) - 8*(4*n + 41)*(2*n + 21)*(4*n + 43)*a(n + 10) + 3*(3*n + 32)*(3*n + 34)*(n + 11)*a(n + 11) = 0. - _Robert Israel_, Oct 09 2026
%p A367041 with(gfun):
%p A367041 eq:= -y + 1 + x^2 + x*y^4:
%p A367041 de:= algeqtodiffeq(eq,y(x)):
%p A367041 rec:= diffeqtorec(de,y(x),a(n)):
%p A367041 f:= rectoproc(rec,a(n),remember):
%p A367041 map(f, [$0..30]); # _Robert Israel_, Oct 09 2026
%o A367041 (PARI) a(n) = sum(k=0, n\2, binomial(3*(n-2*k)+1, k)*binomial(4*(n-2*k), n-2*k)/(3*(n-2*k)+1));
