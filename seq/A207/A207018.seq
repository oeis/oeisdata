%S A207018 1,1,2,4,10,28,116,576,3634,26620,223440,2100964,21888712,250062982,
%T A207018 3108430640,41762486984,603024399320,9312477808574,153154194408352,
%U A207018 2672380453947284,49309410264078102,959254803782758748,19622393359826324024,421052876057659665400,9456644032257629698976
%N A207018 Number of permutations in S_n with major index equal to inversion number.
%C A207018 At first equal to and eventually greater than corresponding entry of A195924, number of fixed points of Foata's bijection.
%C A207018 For any large n, the two permutations with maj and inv both 2 are 2314..n, and 14235..n.
%H A207018 Alois P. Heinz, <a href="/A207018/b207018.txt">Table of n, a(n) for n = 0..140</a> (terms n = 1..100 from Damian Faye)
%H A207018 Joerg Arndt, <a href="https://www.jjj.de/fxt/demo/seq/#A207018">C++ program to compute terms</a>.
%F A207018 a(n) = constant term in q of Sum_{T subset {1..n-1}} q-multinomial(n; blocks cut at T) * Product_{j in T} q^(-j) * Product_{j not in T, j<n} (1 - q^(-j)), by inclusion-exclusion over descent sets; this gives a polynomial-time algorithm. - _Damian Faye_, Oct 19 2026
%e A207018 A(4)=10: the 10 permutations of 4 elements with major index equal to inversion number are
%e A207018    #:       perm      #inv.   inversion table
%e A207018    1:    [ 0 1 2 3 ]   0    [ 0 0 0 ]
%e A207018    2:    [ 0 3 1 2 ]   2    [ 0 2 0 ]
%e A207018    3:    [ 1 0 2 3 ]   1    [ 0 0 1 ]
%e A207018    4:    [ 1 2 0 3 ]   2    [ 0 1 1 ]
%e A207018    5:    [ 1 2 3 0 ]   3    [ 1 1 1 ]
%e A207018    6:    [ 2 1 0 3 ]   3    [ 0 1 2 ]
%e A207018    7:    [ 2 1 3 0 ]   4    [ 1 1 2 ]
%e A207018    8:    [ 2 3 1 0 ]   5    [ 1 2 2 ]
%e A207018    9:    [ 3 0 2 1 ]   4    [ 1 0 3 ]
%e A207018   10:    [ 3 2 1 0 ]   6    [ 1 2 3 ]
%p A207018 b:= proc(u, o, c) option remember; (n-> `if`(abs(c)>n*(n+1)/2, 0,
%p A207018      `if`(n=0, 1, add(b(u-j, o-1+j, c-j-o), j=1..u)+
%p A207018       add(b(u+j-1, o-j, c+u+j-1), j=1..o))))(u+o)
%p A207018     end:
%p A207018 a:= proc(n) a(n):= `if`(n=0, 1, add(b(j-1, n-j, j-1), j=1..n)) end:
%p A207018 seq(a(n), n=0..24);  # _Alois P. Heinz_, Oct 21 2026
