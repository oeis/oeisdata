%I A276464 #22 Aug 20 2026 00:44:50
%S A276464 0,1,2,5,8,21,34,144,4181,75025
%N A276464 Fibbinary Fibonacci numbers.
%C A276464 Intersection of A000045 and A003714.
%C A276464 Next term > 10^10000, if it exists. - _Joerg Arndt_, Sep 05 2016
%C A276464 Conjecture: 75025 is the last term of this sequence. - _Altug Alkan_, Jul 07 2020
%C A276464 This conjecture is similar to Erdos's conjecture that 256 is the largest power of 2 whose ternary representation does not contain the digit 2. - _Geoffrey Caveney_, Aug 19 2026
%o A276464 (PARI) { my(f0=0, f1=1, t); while ( f0 < 10^10000, if( bitand(f0, f0>>1)==0, print1(f0,", ") ); t=f0; f0=f1; f1=t+f0; ); } \\ _Joerg Arndt_, Sep 05 2016
%Y A276464 Cf. A000045, A003714.
%K A276464 nonn,more,changed
%O A276464 1,3
%A A276464 _Altug Alkan_, Sep 04 2016
