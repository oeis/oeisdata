%I A067195 #26 Sep 16 2026 20:09:09
%S A067195 1,2,4,30,33,38,42,45,47,48,57,59,60,64,66,69,77,82,85,104,106,118,
%T A067195 121,194,196,201,285,287,288,290,465,467,468,470,499,500,510,610,614,
%U A067195 626,628,631,632,642,718,723,724,785,793,798,811,812,814,823,824,825,838
%N A067195 Numbers k such that M(k) = Sum_{i=1..k} mu(sigma(i)) where M(k) is the Mertens function A002321(k).
%H A067195 Amiram Eldar, <a href="/A067195/b067195.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..263 from Indranil Ghosh)
%t A067195 M[n_] := Sum[MoebiusMu[k], {k, n}]; Select[Range@ 838, Sum[MoebiusMu[DivisorSigma[1, i]], {i, #}] == M[#] &] (* _Indranil Ghosh_, Mar 16 2017 *)
%t A067195 (* Alternative: *)
%t A067195 Position[Accumulate[Array[Differences[MoebiusMu[{#, DivisorSigma[1, #]}]][[1]] &, 840]], 0] // Flatten (* _Amiram Eldar_, Sep 16 2026 *)
%o A067195 (PARI) mertens(k) = sum(i = 1, k, moebius(i));
%o A067195 isok(n) = sum(i = 1, n, moebius(sigma(i))) == mertens(n); \\ _Michel Marcus_, Sep 24 2013
%o A067195 (PARI) list(kmax) = {my(s = 0); for(k = 1, kmax, s += (moebius(k)- moebius(sigma(k))); if(s == 0, print1(k, ", ")));} \\ _Amiram Eldar_, Sep 16 2026
%Y A067195 Cf. A000203, A002321, A008683.
%K A067195 nonn,changed
%O A067195 1,2
%A A067195 _Benoit Cloitre_, Feb 19 2002
