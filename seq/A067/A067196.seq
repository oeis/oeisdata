%I A067196 #19 Sep 16 2026 18:29:31
%S A067196 1,6,142,154,157,167,168,169,209,213,214,231,232,235,236,238,239,240,
%T A067196 242,243,244,245,247,248,251,252,257,259,260,261,263,264,266,269,270,
%U A067196 278,279,280,301,318,362,363,364,366,367,368,369,371,372,391,392,402
%N A067196 Numbers k such that M(k) = Sum_{i=1..k} mu(phi(i)) where M(k) is the Mertens function A002321(k).
%H A067196 Amiram Eldar, <a href="/A067196/b067196.txt">Table of n, a(n) for n = 1..10000</a>
%t A067196 mQ[n_]:=Sum[MoebiusMu[i],{i,n}]==Sum[MoebiusMu[EulerPhi[i]],{i,n}]; Select[Range[405],mQ[#] &] (* _Jayanta Basu_, May 22 2013 *)
%t A067196 (* Alternative: *)
%t A067196 Position[Accumulate[Array[Differences[MoebiusMu[{#, EulerPhi[#]}]][[1]] &, 410]], 0] // Flatten (* _Amiram Eldar_, Sep 16 2026 *)
%o A067196 (PARI) list(kmax) = {my(s = 0); for(k = 1, kmax, s += (moebius(k)- moebius(eulerphi(k))); if(s == 0, print1(k, ", ")));} \\ _Amiram Eldar_, Sep 16 2026
%Y A067196 Cf. A000010, A002321, A008683.
%K A067196 nonn,changed
%O A067196 1,2
%A A067196 _Benoit Cloitre_, Feb 19 2002
