%S A214034 1,2,3,3,5,7,7,2,3,5,11,13,7,11,15,8,5,8,3,23,5,21,23,19,13,8,7,27,11,
%T A214034 31,31,5,17,7,11,37,17,41,7,20,23,20,11,11,21,45,47,7,19,8,27,51,17,
%U A214034 11,7,8,27,14,11,61,31,23,63,27,5,32,35,65,7,69,23,35,37,59,35,23,41,79,15
%N A214034 The apparition sequence for 2,4 continued fractions.
%C A214034 See A214030 for an explanation. There seems to be no corresponding linear recurrence.
%C A214034 From _M. Jeremie Lafitte (Levitas)_, Aug 26 2026: (Start)
%C A214034 This is the 2,4 analog of the 2,3 mechanism in A214030. Define U(0)=0, U(1)=1, and for k>=1, U(k+1) = 2*U(k) + U(k-1) if k is odd, U(k+1) = 4*U(k) + U(k-1) if k is even. Put M(c)={{c,1},{1,0}}. One period is given by B=M(4)*M(2)={{9,4},{2,1}}. Cayley-Hamilton provides B^2-10*B+I=0 and the linear recurrence U(k+4) = 10*U(k+2) - U(k).
%C A214034 The successive projective states [U(k+1):U(k)] are obtained from [1:0] by alternately applying [u:v] -> [2u+v:u] and [u:v] -> [4u+v:u]. Modulo n, z_U(n) (see Formula) is their first return time to infinity [w:0], with gcd(w,n)=1. (End)
%H A214034 M. Jeremie Lafitte (Levitas), <a href="/A214034/b214034.txt">Table of n, a(n) for n = 1..10000</a>
%F A214034 For n>=1, a(n) = z_U(n+1)-1, where z_U(n) = min{k>=1: n | U(k)} and U is defined above. - _M. Jeremie Lafitte (Levitas)_, Aug 26 2026
%e A214034 From _M. Jeremie Lafitte (Levitas)_, Aug 26 2026: (Start)
%e A214034 For n=3, 3[3,2,3] = [10,3,2], which does not yet satisfy the endpoint condition, whereas 3[3,2,4,3] = [10,2,1,9] does: first and last elements are both >=3^2. With the present offset, this gives a(2)=2. Equivalently, 3 divides neither U(1)=1 nor U(2)=2, but divides U(3)=9, hence z_U(3)=3 and a(2)=2. Modulo 3, the projective orbit is [1:0] -> [2:1] -> [0:2] -> [2:0], whose first return to infinity occurs at k=3.
%e A214034 For n=4, the continued fraction procedure gives 4[4,2,4] = [17,1,3,2], 4[4,2,4,4] = [17,1,3,1,3], and finally 4[4,2,4,2,4] = [17,1,3,1,17], where the first and last elements have common value 17>=4^2, hence a(3)=3. Equivalently, 4 divides none of U(1)=1, U(2)=2 and U(3)=9, but divides U(4)=20, hence z_U(4)=4 and a(3)=3. Modulo 4, [1:0] -> [2:1] -> [1:2] -> [0:1] -> [1:0]. (End)
%o A214034 (PARI)
%o A214034 {a24(n)=local(t,m=1,s=[n]);if(n<2,0,while(1,if(m%2,s=concat(s,2),s=concat(s,4));
%o A214034 t=contfracpnqn(concat(s,n));
%o A214034 t=contfrac(n*t[1,1]/t[2,1]);
%o A214034 if(t[1]<n^2||t[#t]<n^2,m++,break));m)};
%o A214034 /* To print out the sequence A214034 */
%o A214034 for(i=2,80,print1(a24(i),", "))
%o A214034 (PARI)
%o A214034 {zU24proj(n)=my(u=1,v=0,t,k=0); if(n==1,return(1)); while(1, k++; t=u; u=(if(k%2,2,4)*u+v)%n; v=t; if(v==0,return(k)))};
%o A214034 a(n)=zU24proj(n+1)-1;
%o A214034 for(i=1, 80, print1(a(i), ", "));  \\ _M. Jeremie Lafitte (Levitas)_, Aug 29 2026
