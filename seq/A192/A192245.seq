%U A192245 19790484,34860084,61193859,107080413,186826121,325073906,564190391
%N A192245 1-sequence of reduction of triangular number sequence by x^2 -> x+1.
%C A192245 See A192232 for definition of "k-sequence of reduction of [sequence] by [substitution]".
%H A192245 Rafał Wiktorowicz, <a href="/A192245/b192245.txt">Table of n, a(n) for n = 1..100</a>
%H A192245 Rafał Wiktorowicz, <a href="/A192245/a192245.pdf">Proof of the recurrence and generating function</a>, 2026.
%F A192245 Empirical g.f.: x^2*(3-3*x+2*x^2)/(1-x)/(1-x-x^2)^3. - _Colin Barker_, Feb 10 2012
%F A192245 a(n) = (1/2)*Sum_{i=0..n-1} A000045(i)*(i^2+3*i+2). - _John M. Campbell_, Feb 06 2016. [I assume this is also an empirical observation, not a theorem? - _N. J. A. Sloane_, Feb 28 2016]
%F A192245 From _Rafał Wiktorowicz_, Jul 21 2026: (Start)
%F A192245 The above conjectures are true. See link for a proof.
%F A192245 a(n) = 4*a(n-1) - 3*a(n-2) - 5*a(n-3) + 5*a(n-4) + 3*a(n-5) - 2*a(n-6) - a(n-7) for n >= 8.
%F A192245 a(n) = Sum_{k=0..n-1} A000217(k+1)*Fibonacci(k). (End)
%p A192245 with(combinat): seq((1/2)*(sum(fibonacci(i)*(i^2+3*i+2), i=0..n-1)), n=1..40); # _John M. Campbell_, Feb 06 2016
%t A192245 (* See A192244. *)
