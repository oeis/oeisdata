%I A192064 #34 Sep 26 2026 15:31:33
%S A192064 0,1,2,2,1,2,2,1,1,2,2,1,2,2,1,0,1,3,3,2,3,3,2,2,2,0,1,0,0,1,0,2,2,2,
%T A192064 0,1,3,2,0,2,0,2,3,0,1,0,1,0,0,0,2,0,1,0,2,1,3,3,2,1,0,3,1,1,1,1,2,5,
%U A192064 1,1,1,0,0,1,3,0,2,2,1,1,1,2,1,1,2,2,4,1,0,5,4,2
%N A192064 Number of primes in the range [2^n-n, 2^n].
%H A192064 Amiram Eldar, <a href="/A192064/b192064.txt">Table of n, a(n) for n = 0..1000</a>
%F A192064 a(A192542(n)) = 0. - _Amiram Eldar_, Sep 26 2026
%e A192064 a(0) = 0 because the are no primes in the range [2^0-0, 2^0] = [1, 1].
%e A192064 a(1) = 1 because 2 is in the range [2^1-1, 2^1] = [1,2].
%e A192064 a(2) = 2 because 2 and 3 are in the range [2^2-2, 2^2] = [2, 4].
%e A192064 a(3) = 2 because 5 and 7 are in the range [2^3-3, 2^3] = [5, 8].
%e A192064 a(4) = 1 because 13 is in the range [2^4-4, 2^4] = [12, 16].
%e A192064 a(5) = 2 because 29 and 31 are in the range [2^5-5, 2^5] = [27, 32].
%p A192064 A192064 := proc(n) numtheory[pi](2^n)-numtheory[pi](2^n-n-1) ; end proc: # _R. J. Mathar_, Jul 07 2011
%t A192064 a[n_] := Sum[Boole[PrimeQ[k]], {k, 2^n - n, 2^n}]; Array[a, 100, 0] (* _Amiram Eldar_, Sep 26 2026 *)
%o A192064 (PARI) a(n)=sum(k=2^n-n,2^n,isprime(k)) \\ _Charles R Greathouse IV_, Jul 03 2011
%Y A192064 Cf. A192542.
%K A192064 nonn,changed
%O A192064 0,3
%A A192064 _Juri-Stepan Gerasimov_, Jul 03 2011
