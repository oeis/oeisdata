%I A192594 #8 Nov 08 2026 23:08:19
%S A192594 1,7,19,37,43,73,79,97,109,151,163,181,193,199,223,229,241,271,307,
%T A192594 313,331,337,367,373,379,397,409,421,433,439,457,463,487,499,523,541,
%U A192594 547,571,577,601,613,619,631,643,661,673,691,709,727,739,751,757,769
%N A192594 Monotonic ordering of set S generated by these rules:  if x and y are in S and 5x+2y is a prime, then 5x+2y is in S, and 1 is in S.
%C A192594 See the discussions at A192476 and A192580.
%H A192594 Robert Israel, <a href="/A192594/b192594.txt">Table of n, a(n) for n = 1..10000</a>
%p A192594 V:= [1]: count:= 1:
%p A192594 for s from 7 by 2 while count < 100 do
%p A192594   if not isprime(s) then next fi;
%p A192594   for x in V while 5*x < s do
%p A192594      y:= (s-5*x)/2;
%p A192594      if ListTools:-BinarySearch(V,y)<> 0 then
%p A192594         V:= [op(V),s];
%p A192594         count:= count+1;
%p A192594         break
%p A192594      fi
%p A192594   od;
%p A192594 od:
%p A192594 V; # _Robert Israel_, Nov 08 2026
%t A192594 start = {1}; primes = Table[Prime[n], {n, 1, 1000}];
%t A192594 f[x_, y_] := If[MemberQ[primes, 5 x + 2 y], 5 x + 2 y]
%t A192594 b[x_] :=
%t A192594   Block[{w = x},
%t A192594    Select[Union[
%t A192594      Flatten[AppendTo[w,
%t A192594        Table[f[w[[i]], w[[j]]], {i, 1, Length[w]}, {j, 1,
%t A192594          Length[w]}]]]], # < 2000 &]];
%t A192594 t = FixedPoint[b, start]    (* A192594 *)
%t A192594 PrimePi[t]    (* A192595 *)
%Y A192594 Cf. A192595, A192476, A192580.
%K A192594 nonn,changed
%O A192594 1,2
%A A192594 _Clark Kimberling_, Jul 05 2011
