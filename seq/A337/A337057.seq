%I A337057 #25 Aug 30 2026 16:31:49
%S A337057 1,0,2,3,52,255,4146,38766,688584,9685017,195875110,3655101703,
%T A337057 84872077500,1955205893680,51896551499898,1412668946049315,
%U A337057 42475968202854160,1328074354724554471,44778480417250291566,1577210136570598631318
%N A337057 a(n) = exp(-n) * Sum_{k>=0} (k - n)^n * n^k / k!.
%C A337057 a(n) is the number of partitions of [n] into a set of subsets of size >=2, with each subset given one of n colors. - _Natalia L. Skirrow_, Aug 29 2026
%H A337057 Vaclav Kotesovec, <a href="/A337057/b337057.txt">Table of n, a(n) for n = 0..400</a>
%F A337057 a(n) = n! * [x^n] exp(n*(exp(x) - 1 - x)).
%F A337057 a(n) = Sum_{k=0..n} binomial(n,k) * (-n)^(n-k) * BellPolynomial_k(n).
%F A337057 From _Natalia L. Skirrow_, Aug 29 2026: (Start)
%F A337057 a(n) = E[(Poiss(n)-n)^n] (n-th central moment of a Poisson variable with rate parameter n).
%F A337057 E.g.f.: A(x) = (d/dx) -exp(1-exp(B(x))) = 1/(1 - B*(exp(B)-1)), where B = B(x) satisfies B = x*exp(exp(B)-1-B).
%F A337057 a(n) = Sum_{k=0..floor(n/2)} A008299(n,k)*n^k, with the extension A008299(n,0) = [n=0].
%F A337057 a(n) = Sum_{k=0..n} A039621(n,k)*n^k = (-1)^n * Sum_{k=0..n} A354794(n,k)*(-n)^k.
%F A337057 a(n) ~ (b*n)^n/c, where
%F A337057  * r = 0.8064659942363268... satisfies exp(r)-1 = 1/r (A399273),
%F A337057  * b = 0.7037060450572022... = exp(exp(r)-r-2)/r = exp(1/r-1)/(r+1),
%F A337057  * c = 1.5674352918369274... = sqrt(1+r^2*exp(r)) = sqrt(1+r+r^2).
%F A337057 (End)
%t A337057 Table[n! SeriesCoefficient[Exp[n (Exp[x] - 1 - x)], {x, 0, n}], {n, 0, 19}]
%t A337057 (* Alternative: *)
%t A337057 Unprotect[Power]; 0^0 = 1; Table[Sum[Binomial[n, k] (-n)^(n - k) BellB[k, n], {k, 0, n}], {n, 0, 19}]
%t A337057 (* Alternative: *)
%t A337057 n=19;CoefficientList[Series[D[-Exp[InverseSeries[Series[-Exp[a]*(1-a)*Log[1/(1-a)],{a,0,n+1}],x]],x],{x,0,n}],x]*Range[0,n]! (* _Natalia L. Skirrow_, Aug 29 2026 *)
%t A337057 (* Alternative: *)
%t A337057 n=19;CoefficientList[Series[D[-Exp[1-Exp[InverseSeries[Series[a/Exp[Exp[a]-1-a],{a,0,n+1}],x]]],x],{x,0,n}],x]*Range[0,n]! (* _Natalia L. Skirrow_, Aug 29 2026 *)
%Y A337057 Cf. A000296, A194689, A242817, A334242, A335867, A399273.
%Y A337057 Summands: A008299, A039621 = (-1)^(n-k) * A354794.
%K A337057 nonn,changed
%O A337057 0,3
%A A337057 _Ilya Gutkovskiy_, Aug 13 2020
