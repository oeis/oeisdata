%S A337431 3,5,7,9,13,14,17,19,26,27,31,33,34,35,37,46,49,51,59,61,62,65,69,74,
%T A337431 77,78,82,83,86,89,93,97,103,107,115,118,121,122,123,127,129,130,131,
%U A337431 133,137,141,142,143,144,145,147,150,153,154,165,166,169,170,174,175
%N A337431 Numbers k such that the largest prime factor of 2^k - 1 is greater than the largest prime factor of 2^k + 1.
%C A337431 From _Thomas Ordowski_, Aug 25 2026: (Start)
%C A337431 Conjecture: these are exactly the numbers k such that gpf(2^k - 1) = gpf(2^m - 1) for the smallest possible m > k, except for k = 109. Such repetitions occur only for m = 2k or m = 3k. This seems provable.
%C A337431 For k < 109, whenever gpf(2^k - 1) > gpf(4^k + 2^k + 1), one also has gpf(2^k - 1) > gpf(2^k + 1). Any further k > 109 satisfying the former inequality, if they exist, should likewise be a term of this sequence. (End)
%H A337431 Amiram Eldar, <a href="/A337431/b337431.txt">Table of n, a(n) for n = 1..428</a>
%t A337431 Select[Range[175], FactorInteger[2^# - 1][[-1, 1]] > FactorInteger[2^# + 1][[-1, 1]] &] (* _Amiram Eldar_, Aug 25 2026 *)
%o A337431 (PARI) for(n=2,175,my(p=vecmax(factor(2^n-1)[,1]),q=vecmax(factor(2^n+1)[,1]));if(p>q,print1(n,", ")))
