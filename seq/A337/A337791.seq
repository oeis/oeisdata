%I A337791 #58 Aug 06 2026 01:01:06
%S A337791 191,643,134339,25233137
%N A337791 6-Wall-Sun-Sun primes: primes p such that p^2 divides F_6(A175185(p)), where F_6(i) is the i-th 6-Fibonacci number.
%H A337791 Zakariae Bouazzaoui, <a href="https://www.fq.math.ca/Papers1/58-5/bouazzaoui.pdf">On Periods of Fibonacci Sequences and Real Quadratic p-rational Fields</a>, Fibonacci Quart. 58 (2020), no. 5, 103-110. See p. 7.
%H A337791 Wikipedia, <a href="https://en.wikipedia.org/wiki/Wall%E2%80%93Sun%E2%80%93Sun_prime">Wall-Sun-Sun prime</a>
%o A337791 (PARI) my(b=6); forprime(p=2, , if( (([0, 1; 1, b]*Mod(1, p^2))^(p-kronecker(b^2+4, p)))[1, 2]==0, print1(p, ", "); ); );
%o A337791 (Python)
%o A337791 from itertools import islice
%o A337791 from sympy import nextprime, kronecker_symbol
%o A337791 def A337791_gen(): # generator of terms
%o A337791     def k_Fibonacci_mod(k,n,m):
%o A337791         """ n-th k-Fibonacci number mod m """
%o A337791         a2, b2, c2, d2 = 1, 0, 0, 1
%o A337791         for x in bin(n)[2:]:
%o A337791             e, f = b2*c2%m, t if (t:=a2+d2)<m else t-m
%o A337791             a2, b2, c2, d2 = (a2*a2+e)%m, b2*f%m, c2*f%m, (d2*d2+e)%m
%o A337791             if x=='1':
%o A337791                 a2, b2, c2, d2 = (a2*k+b2)%m, a2, (c2*k+d2)%m, c2
%o A337791         return b2
%o A337791     p = 1
%o A337791     while (p:=nextprime(p)):
%o A337791         if not k_Fibonacci_mod(6,p-kronecker_symbol(40,p),p*p):
%o A337791             yield p
%o A337791 A337791_list = list(islice(A337791_gen(),4)) # _Chai Wah Wu_, Aug 05 2026
%Y A337791 Cf. A175185, A238736 (2-Wall-Sun-Sun primes), A271782 (smallest n-Wall-Sun-Sun prime).
%K A337791 nonn,hard,more
%O A337791 1,1
