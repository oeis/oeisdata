%N A337524 a(n) = d(n) * (d(n) - 1), where d is the number of divisors of n (A000005).
%C A337524 Number of distinct nonsquare m X n matrices such that m and n are divisors of n.
%H A337524 Antti Karttunen, <a href="/A337524/b337524.txt">Table of n, a(n) for n = 1..10000</a> (first 1000 terms from Harvey P. Dale)
%H A337524 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%F A337524 a(n) = 2*A066446(n).
%F A337524 a(n) = A063647(n) + A394997(n). - _Antti Karttunen_, Nov 27 2026
%t A337524 Table[DivisorSigma[0, n]^2 - DivisorSigma[0, n], {n, 100}]
%t A337524 #(#-1)&/@DivisorSigma[0,Range[100]] (* _Harvey P. Dale_, Nov 03 2022 *)
%o A337524 (PARI) A337524(n) = ((x->(x^2 - x))(numdiv(n))); \\ _Antti Karttunen_, Nov 27 2026
