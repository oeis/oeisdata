%S A002861 0,1,2,4,9,20,51,125,329,862,2311,6217,16949,46350,127714,353272,
%T A002861 981753,2737539,7659789,21492286,60466130,170510030,481867683,
%U A002861 1364424829,3870373826,10996890237,31293083540,89173833915,254445242754,726907585652,2079012341822,5952451249381
%N A002861 Number of connected functions (or mapping patterns) on n unlabeled points, or number of rings and branches with n edges.
%C A002861 From _Peter Luschny_, Sep 21 2026: (Start)
%C A002861 Following standard practice in graph theory, the empty graph K_0 (0 vertices) is explicitly defined as not connected, so there are 0 connected functions on 0 points.
%C A002861 Assume the theory of combinatorial species (Bergeron et al.). Then a(n) is the number of unlabeled classes of size n, specified by T = Z x MSET(T) (rooted trees), C = CYC(T) (connected functional graphs), and Z is the singleton class (one object, size 1). Since Z has no object of size 0, neither T has, and since a C-object is a nonempty cycle of T-objects, C has no object of size 0. Therefore a(0) = 0. The corresponding g.f. is given in the formula section (see the translation rule in Flajolet/Sedgewick, Theorem I.1). Maple ('combstruct') and SageMath ('species.library') implement these standard species constructions, and independently confirm 0 for n = 0. (End)
%D A002861 F. Bergeron, G. Labelle, and P. Leroux, Combinatorial Species and Tree-Like Structures, Cambridge, 1998, chapter 4.
%D A002861 S. R. Finch, Mathematical Constants, Cambridge, 2003, Section 5.6.6.
%D A002861 R. A. Fisher, Contributions to Mathematical Statistics, Wiley, 1950, 41.399.
%D A002861 N. J. A. Sloane, A Handbook of Integer Sequences, Academic Press, 1973 (includes this sequence).
%D A002861 N. J. A. Sloane and Simon Plouffe, The Encyclopedia of Integer Sequences, Academic Press, 1995 (includes this sequence).
%H A002861 Alois P. Heinz, Table of n, a(n) for n = 0..1000 (first 500 terms from C. G. Bower).
%H A002861 A. L. Agore, A. Chirvasitu, and G. Militaru, <a href="https://arxiv.org/abs/2303.06700">The set-theoretic Yang-Baxter equation, Kimura semigroups and functional graphs</a>, arXiv:2303.06700 [math.QA], 2023.
%H A002861 C. G. Bower, <a href="/transforms2.html">Transforms (2)</a>
%H A002861 Oscar Defrain, Antonio E. Porreca and Ekaterina Timofeeva, <a href="https://doi.org/10.1016/j.dam.2024.05.030">Polynomial-delay generation of functional digraphs up to isomorphism</a>, Disc. Appl. Math., vol 357 (2024), pp. 24-33.
%H A002861 Philippe Flajolet and Robert Sedgewick, <a href="https://algo.inria.fr/flajolet/Publications/books.html">Analytic Combinatorics</a>, 2009; see page 480.
%H A002861 R. K. Guy, <a href="/A000081/a000081.pdf">Letter to N. J. A. Sloane, 1988-04-12</a> (annotated scanned copy)
%H A002861 INRIA Algorithms Project, <a href="http://ecs.inria.fr/services/structure?nbr=118">Encyclopedia of Combinatorial Structures 118</a>
%H A002861 Peter Luschny, <a href="/A002861/a002861.txt">Python implementation of A002861</a>.
%H A002861 Marko Riedel, <a href="/A217860/a217860_2.pdf">Counting components of nonisomorphic maps</a>.
%F A002861 CIK transform of A000081.
%F A002861 a(n) = A000081 + A027852 + A029852 + A029853 + A029868 + ... - _Geoffrey Critzer_, Oct 12 2012
%F A002861 From _Peter Luschny_, Sep 20 2026: (Start)
%F A002861 a(n) = (1/n) * Sum_{d|n} EulerPhi(n/d) * A399661(d) for n >= 1, a(0) = 0.
%F A002861 a(n) = [x^n] Sum_{j=1..n} (EulerPhi(j)/j) * log(1/(1-A(x^j))), where A is the g.f. of A000081. (End)
%p A002861 spec2861 := [B, {A=Prod(Z,Set(A)), B=Cycle(A)}, unlabeled];
%p A002861 [seq(combstruct[count](spec2861,size=n), n=0..27)];
%p A002861 # Alternative:
%p A002861 A002861 := n -> ifelse(n = 0, 0, (1/n)*add(NumberTheory:-Totient(n/d)*A399661(d), d = NumberTheory:-Divisors(n))): seq(A002861(n), n = 0..100); # _Peter Luschny_, Sep 19 2026
%p A002861 # Alternative: series expansion (using A000081).
%p A002861 A002861List := proc(N) local a, l, j, ser;
%p A002861 a := add(A000081(j)*x^j, j = 1..N);
%p A002861 l := add(numtheory:-phi(j)/j * (-ln(1-subs(x = x^j, a))), j = 1..N);
%p A002861 ser := series(l, x = 0, N + 1); seq(coeff(ser, x, j), j = 0..N) end:
%p A002861 A002861List(31);  # _Peter Luschny_, Sep 20 2026
%t A002861 Needs["Combinatorica`"];
%t A002861 nn = 30; s[n_, k_] := s[n, k] = a[n + 1 - k] + If[n < 2 k, 0, s[n - k, k]]; a[1] = 1; a[n_] := a[n] = Sum[a[i] s[n - 1, i] i, {i, 1, n - 1}]/(n - 1); rt = Table[a[i],{i, 1, nn}]; Apply[Plus, Table[Take[CoefficientList[CycleIndex[CyclicGroup[n], s] /. Table[s[j] -> Table[Sum[rt[[i]] x^(k * i), {i, nn}], {k, 1, nn}][[j]], {j, nn}], x], nn], {n, 30}]]  (* _Geoffrey Critzer_, Oct 12 2012, after code given by _Robert A. Russell_ in A000081 *)
%t A002861 (* Alternative: *)
%t A002861 a081[0] = 0; a081[1] = 1; a081[n_] := a081[n] = 1/(n-1) Sum[m*a081[m]*a081[n-k*m], {m, 1, n - 1}, {k, 1, Quotient[n-1, m]}]; a107[0] = 1; a107[n_] := a107[n] = Sum[a081[i]*a107[n-i], {i, 1, n}]; Sarr[0] = 0; Sarr[n_] := Sarr[n] = Sum[i*a081[i]*a107[n-i], {i, 1, n}];
%t A002861 A002861[0] = 0; A002861[n_] := 1/n DivisorSum[n, EulerPhi[n/#]*Sarr[#] &];
%t A002861 Table[A002861[n], {n, 0, 100}]  (* _Peter Luschny_, Sep 19 2026 *)
%o A002861 (PARI)
%o A002861 N=66;  A=vector(N+1, j, 1);
%o A002861 for (n=1, N, A[n+1] = 1/n * sum(k=1, n, sumdiv(k, d, d * A[d]) * A[n-k+1] ) );
%o A002861 A000081=concat([0], A);
%o A002861 H(t)=subst(Ser(A000081, 't), 't, t);
%o A002861 x='x+O('x^N);
%o A002861 L=sum(j=1,N, eulerphi(j)/j * log(1/(1-H(x^j))));
%o A002861 res = concat([0], Vec(L));
%o A002861 print(res)
%o A002861 \\ _Joerg Arndt_, Jul 10 2014
%o A002861 (SageMath)
%o A002861 from sage.combinat.species.library import (
%o A002861     CombinatorialSpecies, SingletonSpecies, SetSpecies, CycleSpecies)
%o A002861 A = CombinatorialSpecies()
%o A002861 A.define(SingletonSpecies() * SetSpecies(min=0)(A))
%o A002861 B = CycleSpecies()(A)
%o A002861 iso = B.isotype_generating_series()
%o A002861 print([iso.coefficient(n) for n in range(1, 10)])
%o A002861 # _Peter Luschny_, Sep 19 2026
%o A002861 (Python)  # see links.
%Y A002861 Cf. A000081, A000107, A001372, A027852, A029852, A029853, A029868, A399661.
%Y A002861 Row sums of A339428.
%K A002861 nonn,nice,changed
%O A002861 0,3
%A A002861 _N. J. A. Sloane_
%E A002861 More terms from _Philippe Flajolet_ and _Paul Zimmermann_, Mar 15 1996
