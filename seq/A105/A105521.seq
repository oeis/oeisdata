%I A105521 #22 Nov 24 2026 11:05:21
%S A105521 18,60,100,140,270,280,294,462,648,728,756,1078,1080,1210,1496,1530,
%T A105521 1584,1768,2028,2090,2574,2772,2860,2990,3150,3588,3910,4550,4624,
%U A105521 4680,4950,5434,5670,5984,6498,6960,7140,7548,8330,8398,8432,8436,8820,9568,10098
%N A105521 Sums of area and perimeter of primitive Pythagorean triples.
%H A105521 Robert Israel, <a href="/A105521/b105521.txt">Table of n, a(n) for n = 1..10000</a>
%H A105521 Douglas Butler, <a href="https://www.tsm-resources.com/tsm/lists/trip.html">Table of Pythagorean triples up to 2100</a>, Oundle School iCT Training Centre
%H A105521 Ron Knott, <a href="http://www.maths.surrey.ac.uk/hosted-sites/R.Knott/Pythag/pythag.html#anyint">Pythagorean triples</a>.
%e A105521 The first term that arises from more than one primitive Pythagorean triple is a(117) = 61380, which comes from the two triples (231, 520, 569) (area 231*520/2 = 60060, perimeter 231+520+569 = 1320, 60060 + 1320 = 61380) and (124, 957, 965) (area 124*957/2 = 59334, perimeter 124+957+965 = 2046, 59334 + 2046 = 61380). - _Robert Israel_, Nov 24 2026
%p A105521 N:= 20000: # for terms <= N
%p A105521 S:= {}:
%p A105521 for u from 1 while u*(u+1)^2 <= N do
%p A105521   for v from 1 + (u mod 2) to u-1 by 2 do
%p A105521     ap:= u*(v + u)*(u*v - v^2 + 2);
%p A105521     if ap > N then break fi;
%p A105521     if igcd(u,v) > 1 then next fi;
%p A105521     S:= S union {ap}
%p A105521   od;
%p A105521   if v < u then
%p A105521    for v from u-1 by -2 do
%p A105521      ap:= u*(v + u)*(u*v - v^2 + 2);
%p A105521      if ap > N then break fi;
%p A105521      if igcd(u,v) > 1 then next fi;
%p A105521      S:= S union {ap}
%p A105521 od fi od:
%p A105521 sort(convert(S,list)); # _Robert Israel_, Nov 24 2026
%Y A105521 Cf. A103605, A103606, A024364, A024406, A105520
