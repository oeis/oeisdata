%I A105205 #18 Oct 16 2026 09:21:07
%S A105205 1,1,4,6,13,24,51,101,205,407,814,1624,3248,6490,12979,25950,51898,
%T A105205 103798,207619,415288,830690,1661590,3323566,6647779,13296602,
%U A105205 26594769,53191708,106386020,212774300,425548246,851088095,1702147794,3404222459
%N A105205 Number of compositions of n such that the greatest part occurs with odd multiplicity.
%F A105205 G.f.: Sum_{l>=1} ((1 - x)^(2*l) * Sum_{k>=1} (x^((2*l - 1)*k) / (1 - 2*x + x^k)^(2*l))).
%e A105205 a(4)=6 because we have (4),(3,1),(1,3),(2,1,1),(1,2,1) and (1,1,2).
%p A105205 nMax := 33: G := add((1-x)^(2*l) * add(x^((2*l-1)*k) / (1-2*x+x^k)^(2*l), k = 1..nMax), l = 1..20): Gser := series(G, x=0, nMax+2): seq(coeff(Gser, x^n), n = 1..nMax); # _Emeric Deutsch_, Jun 07 2005
%o A105205 (PARI)
%o A105205 a(n) = polcoef(sum(l=1, n, sum(k=1, n\(2*l-1), (1-x)^(2*l)*x^((2*l-1)*k)/(1-2*x + x^k)^(2*l) + O(x^(n+1)))), n); \\ _Alper Ferudun_, Oct 15 2026
%o A105205 (SageMath)
%o A105205 PREC = 33
%o A105205 R = PowerSeriesRing(ZZ, 'x', default_prec=PREC+1)
%o A105205 x = R.gen()
%o A105205 F = R(0)
%o A105205 for m in range(1, PREC + 1):
%o A105205     S = sum(x^j for j in range(1, m))
%o A105205     F += x^m / ((1 - S)^2 - x^(2*m))
%o A105205 print([F[n] for n in range(1, PREC + 1)])  # _Peter Luschny_, Oct 16 2026
%Y A105205 Cf. A105201, A105200.
%K A105205 easy,nonn
%O A105205 1,3
%A A105205 _Vladeta Jovovic_, Apr 12 2005
%E A105205 More terms from _Emeric Deutsch_, Jun 07 2005
%E A105205 a(31)-a(33) corrected by _Alper Ferudun_, Oct 15 2026
