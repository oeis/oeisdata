%o A055553 b=read("carm10e24.bin"); d=10^3; C=0; foreach(b, c, if(c>=d, print1(C", "); d=d*10); C+=1); print(C) \\ _Hermann Stamm-Wilbrandt_, Mar 07 2026
%o A055553 (Python)
%o A055553 from math import isqrt
%o A055553 def carmichael_below(limit, seg=1 << 22):
%o A055553     r = isqrt(limit)
%o A055553     is_prime = bytearray([1]) * (r + 1)
%o A055553     primes = []
%o A055553     for p in range(3, r + 1, 2):
%o A055553         if is_prime[p]:
%o A055553             primes.append(p)
%o A055553             is_prime[p * p::2 * p] = bytes(len(range(p * p, r + 1, 2 * p)))
%o A055553     found = []
%o A055553     for lo in range(0, limit, seg):
%o A055553         hi = min(lo + seg, limit)
%o A055553         acc = [1] * (hi - lo)
%o A055553         for p in primes:
%o A055553             m = p * (p - 1)
%o A055553             first = p + m
%o A055553             if first < lo:
%o A055553                 first += -(-(lo - first) // m) * m
%o A055553             for n in range(first, hi, m):
%o A055553                 acc[n - lo] *= p
%o A055553         found += [n for n, a in enumerate(acc, lo) if a == n and n > 1]
%o A055553     return found
%o A055553 def A055553_list(nmax):
%o A055553     c = carmichael_below(10**nmax)
%o A055553     return [sum(1 for x in c if x < 10**n) for n in range(1, nmax + 1)]
%o A055553 print(A055553_list(8))  # _Jeff Sponaugle_, Nov 23 2026
