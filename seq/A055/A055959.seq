%I A055959 #14 Nov 02 2026 10:21:30
%S A055959 0,0,0,0,0,0,0,0,0,8,0,-8,-16,-24,-32,-40,-48,-56,16,8,0,-8,-16,-24,
%T A055959 -32,-40,-48,24,16,8,0,-8,-16,-24,-32,-40,32,24,16,8,0,-8,-16,-24,-32,
%U A055959 40,32,24,16,8,0,-8,-16,-24,48,40,32,24,16,8,0,-8,-16,56,48,40,32,24,16,8,0,-8,64,56,48,40,32,24,16,8,0,80,0,-80,-160
%N A055959 n - reversal of base 9 digits of n (written in base 10).
%C A055959 a(n) is a multiple of 8.
%H A055959 Robert Israel, <a href="/A055959/b055959.txt">Table of n, a(n) for n = 0..10000</a>
%F A055959 a(n) = n - A030108(n).
%p A055959 f:= proc(n) local L,i;
%p A055959    L:= convert(n,base,9);
%p A055959    n - add(L[-i]*9^(i-1),i=1..nops(L))
%p A055959 end proc:
%p A055959 map(f, [$0..100]); # _Robert Israel_, Nov 02 2026
%t A055959 Table[n-FromDigits[Reverse[IntegerDigits[n,9]],9],{n,0,120}] (* _Harvey P. Dale_, Dec 17 2022 *)
%Y A055959 Cf. A030108, A056965.
%K A055959 base,sign,changed
%O A055959 0,10
%A A055959 _Henry Bottomley_, Jul 18 2000
