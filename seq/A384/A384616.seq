%o A384616 (Python)
%o A384616 import itertools
%o A384616 import numpy as np
%o A384616 def max_difference_sum(m, n):
%o A384616     nums = list(range(1, m * n + 1))
%o A384616     max_sum = 0
%o A384616     best_matrix = None
%o A384616     for perm in itertools.permutations(nums):
%o A384616         matrix = np.array(perm).reshape((m, n))
%o A384616         diff_sum = np.sum(np.abs(matrix[:,1:]-matrix[:,:-1])) + np.sum(np.abs(matrix[1:,:]-matrix[:-1,:]))
%o A384616         if diff_sum > max_sum:
%o A384616             max_sum = diff_sum
%o A384616             best_matrix = matrix.copy()
%o A384616     return max_sum, best_matrix
%o A384616 for m in range(1, 10):
%o A384616     for n in range(1, m+1):
%o A384616         max_sum, best = max_difference_sum(m, n)
%o A384616         print(max_sum, end=', ')
%o A384616 (Python)
%o A384616 from ortools.sat.python import cp_model
%o A384616 def A384616(m, n):
%o A384616     N = m * n
%o A384616     if N <= 1: return 0
%o A384616     cells = [(r, c) for r in range(m) for c in range(n)]
%o A384616     edges = [((r, c), (r + dr, c + dc)) for r, c in cells for dr, dc in ((1, 0), (0, 1)) if r + dr < m and c + dc < n]
%o A384616     model = cp_model.CpModel()
%o A384616     y = {(v, k): model.NewBoolVar(f"y_{v}_{k}") for v in cells for k in range(1, N)}
%o A384616     for v in cells:
%o A384616         for k in range(1, N - 1): model.Add(y[(v, k)] >= y[(v, k + 1)])
%o A384616     for k in range(1, N): model.Add(sum(y[(v, k)] for v in cells) == N - k)
%o A384616     z_all = []
%o A384616     for idx, (u, v) in enumerate(edges):
%o A384616         for k in range(1, N):
%o A384616             z = model.NewBoolVar(f"z_{idx}_{k}")
%o A384616             model.Add(z <= y[(u, k)] + y[(v, k)])
%o A384616             model.Add(z <= 2 - y[(u, k)] - y[(v, k)])
%o A384616             z_all.append(z)
%o A384616     model.Maximize(sum(z_all))
%o A384616     solver = cp_model.CpSolver()
%o A384616     solver.Solve(model)
%o A384616     return int(solver.ObjectiveValue()) # _Byron Baxley_, Nov 01 2026
