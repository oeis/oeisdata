%S A384490 41,61,109,149,241,269,389,409,449,569,601,641,701,821,929,1129,1181,
%T A384490 1201,1301,1321,1429,1481,1489,1609,1801,1889,1901,1949,2129,2141,
%U A384490 2309,2341,2381,2549,2609,2741,2909,3061,3109,3181,3209,3221,3229,3361,3449,3541
%N A384490 Prime numbers p such that both roots of x^2 - x - 1 modulo p are primitive roots modulo p.
%C A384490 Empirical observation: For each p in this sequence A001175(p) = p-1 and A015134(p) = p+2.
%C A384490 Conjecture: these numbers are all in A106963. - _Michael Somos_, Oct 01 2026
%C A384490 All terms are congruent to 1 modulo 4: The product of the two roots of x^2 - x - 1 is congruent to -1 modulo p, and if p == 3 (mod 4) then one (and exactly one) of these roots must be a quadratic residue modulo p. - _Jianing Song_, Oct 02 2026
%H A384490 Robert Israel, <a href="/A384490/b384490.txt">Table of n, a(n) for n = 1..10000</a>
%H A384490 Wikipedia, <a href="https://en.wikipedia.org/wiki/Primitive_root_modulo_n">Primitive root modulo n</a>.
%e A384490 For p = 41 the roots of x^2 - x - 1 (mod 41) are 7 and 35. 7 and 35 are both primitive roots modulo 41.
%p A384490 filter:= proc(p) local R;
%p A384490   if not isprime(p) then return false fi;
%p A384490   R:= map(rhs @ op, [msolve(x^2-x-1,p)]);
%p A384490   nops(R)=2 and map(NumberTheory:-MultiplicativeOrder,R,p)= [p-1,p-1]
%p A384490 end proc:
%p A384490 select(filter, [seq(i,i=5 .. 10000, 4)]); # _Robert Israel_, Oct 02 2026
%t A384490 test[p_]:=Module[{inv2,sqr},If[JacobiSymbol[5,p]==1,inv2=ModularInverse[2,p]; sqr=PowerMod[5,1/2,p]; {MultiplicativeOrder[Mod[inv2*(sqr-1),p],p],MultiplicativeOrder[Mod[inv2*(-sqr-1),p],p]} == {p-1,p-1},False]]; Cases[Prime[Range[4, 5000]], _?(test[#] &)] (* _Shenghui Yang_, Jun 01 2025 *)
%o A384490 (PARI) { forprime(p=2, 3600, s=polrootsmod(x^2 - x - 1,p);
%o A384490  if( #s==2 && p-1==znorder(Mod(s[1],p)) && p-1==znorder(Mod(s[2],p)),
%o A384490  print1(p,", "); ); ); } \\ _Joerg Arndt_, May 31 2025
%Y A384490 Cf. A001175, A015134, A106963.
%K A384490 nonn,changed
%O A384490 1,1
