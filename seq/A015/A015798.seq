%N A015798 Numbers k such that phi(k) + 7 | sigma(k).
%t A015798 Cases[Range[100000],
%t A015798 x_ /; Divisible[DivisorSigma[1, x], EulerPhi[x] + 7] == True] (* _David Nacin_, Feb 28 2012 *)
%t A015798 (* Alternative: *)
%t A015798 Select[Range[800000],Mod[DivisorSigma[1,#],EulerPhi[#]+7]==0&] (* The program generates the first 10 terms of the sequence. *) (* _Harvey P. Dale_, Sep 13 2026 *)
%Y A015798 Cf. A000010 (phi), A000203 (sigma).
