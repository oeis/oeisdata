%U A015864 1,-1,1,-1,1,0,-1,1,-1,1,0,0,0,-1,1,0,0,0
%N A015864 Inverse of 1855th cyclotomic polynomial.
%C A015864 Periodic with period length 1855. - _Ray Chandler_, Apr 07 2017
%H A015864 Ray Chandler, <a href="/A015864/b015864.txt">Table of n, a(n) for n = 0..2000</a>
%H A015864 <a href="/index/Per#periodic">Index entries for periodic sequences</a>, period 1855.
%H A015864 <a href="/index/Rec#order_1248">Index entries for linear recurrences with constant coefficients</a>, order 1248.
%H A015864 <a href="/index/Pol#poly_cyclo_inv">Index to sequences related to inverse of cyclotomic polynomials</a>
%p A015864 with(numtheory,cyclotomic); c := n->series(1/cyclotomic(n,x),x,80);
%t A015864 Module[{x, nmax = 100}, PadRight[CoefficientList[Series[1/Cyclotomic[1855, x], {x, 0, nmax}], x], nmax + 1]] (* _Paolo Xausa_, Oct 07 2026 *)
%o A015864 (PARI) first(n)=Vec(1/polcyclo(1855)+O(x^(n+1))) \\ _Charles R Greathouse IV_, Jun 01 2026
%K A015864 sign,easy,changed
%O A015864 0,1
%A A015864 _Simon Plouffe_
