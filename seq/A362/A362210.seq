%T A362210 24283705558,224677646416,2081054132179,19293026227024,
%U A362210 178996540057615,1661743445778403,15435351753092176,143439377236572826,1333496145331028230
%N A362210 Expansion of 1/(1 - x/(1-9*x)^(2/3)).
%H A362210 Robert Israel, <a href="/A362210/b362210.txt">Table of n, a(n) for n = 0..1027</a>
%F A362210 a(n) = Sum_{k=0..n} (-9)^k * binomial(-2*(n-k)/3,k) = Sum_{k=0..n} 9^(n-k) * binomial(n-k/3-1,n-k).
%F A362210 D-finite with recurrence: 27*(3*n + 2)*(3*n + 1)*a(n) - 54*(367*n^2 + 374*n + 89)*a(n + 1) + 6*(2555*n^2 + 7677*n + 6028)*a(n + 2) - (4375*n^2 + 20421*n + 24374)*a(n + 3) + 54*(11*n^2 + 68*n + 106)*a(n + 4) - 3*(n + 4)*(13*n + 47)*a(n + 5) + (n + 5)*(n + 4)*a(n + 6) = 0. - _Robert Israel_, Oct 04 2026
%p A362210 with(gfun):
%p A362210 g:=  1/(1 - x/(1-9*x)^(2/3)):
%p A362210 de:= holexprtodiffeq(g,y(x)):
%p A362210 rec:= diffeqtorec(de,y(x),a(n)):
%p A362210 f:= rectoproc(rec,a(n),remember):
%p A362210 map(f, [$0..30]); # _Robert Israel_, Oct 04 2026
%o A362210 (PARI) my(N=30, x='x+O('x^N)); Vec(1/(1-x/(1-9*x)^(2/3)))
%Y A362210 Cf. A362206.
%K A362210 nonn,easy,changed
