%t A287534 Select[Flatten@ Array[FromDigits /@ Tuples[{1, 3, 7, 9}, #] &, 3], CompositeQ] (* _Michael De Vlieger_, Jun 01 2017 *)
%o A287534 (Python)
%o A287534 from gmpy2 import is_prime, mpz
%o A287534 from itertools import count, islice, product
%o A287534 def A287534(): # generator of terms
%o A287534     yield 9
%o A287534     for d in count(2):
%o A287534         for p in product("1379", repeat=d):
%o A287534             if not is_prime(t:=mpz("".join(p))):
%o A287534                 yield int(t)
%o A287534 print(list(islice(A287534(), 52))) # _Michael S. Branicky_, Oct 24 2026
