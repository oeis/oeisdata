%N A363663 a(n) = Sum_{d|n} (n/d)^(d-1) * binomial(d+n-1,n).
%H A363663 Robert Israel, <a href="/A363663/b363663.txt">Table of n, a(n) for n = 1..1656</a>
%F A363663 a(n) = [x^n] Sum_{k>0} x^k/(1 - k*x^k)^(n+1).
%p A363663 f:= proc(n) local d;
%p A363663    add((n/d)^(d-1) * binomial(n+d-1, n), d = NumberTheory:-Divisors(n))
%p A363663 end proc:
%p A363663 map(f, [$1..30]); # _Robert Israel_, Aug 02 2026
%t A363663 a[n_] := DivisorSum[n, (n/#)^(#-1) * Binomial[# + n - 1, n] &]; Array[a, 25] (* _Amiram Eldar_, Jul 12 2023 *)
%o A363663 (PARI) a(n) = sumdiv(n, d, (n/d)^(d-1)*binomial(d+n-1, n));
