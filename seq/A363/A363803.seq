%N A363803 a(n) = Sum_{d|n, d == 0, 2, or 5 mod 7} d.
%C A363803 a(n) <= A000203(n) - 1, with equality if and only if n = 7^k or 7^k * p where k >= 0 and p is a prime == 2 or 5 (mod 7). - _Robert Israel_, Aug 09 2026
%H A363803 Robert Israel, <a href="/A363803/b363803.txt">Table of n, a(n) for n = 1..10000</a>
%F A363803 G.f.: Sum_{k>0, k == 0, 2 or 5 mod 7} k * x^k/(1 - x^k).
%p A363803 f:= n -> convert(select(d -> member(d mod 7, {0,2,5}), NumberTheory:-Divisors(n)),`+`):
%p A363803 map(f, [$1..100]); # _Robert Israel_, Aug 09 2026
%t A363803 a[n_] := DivisorSum[n, # &, MemberQ[{0, 2, 5}, Mod[#, 7]] &]; Array[a, 100] (* _Amiram Eldar_, Jun 23 2023 *)
%o A363803 (PARI) my(N=90, x='x+O('x^N)); concat(0, Vec(sum(k=1, N, [1, 0, 1, 0, 0, 1, 0][k%7+1]*k*x^k/(1-x^k))))
%Y A363803 Cf. A000203, A284363, A284443, A284446, A363804.
%Y A363803 Cf. A363800.
