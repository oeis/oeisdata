%N A363664 a(n) = Sum_{d|n} (n/d)^(n-n/d) * binomial(d+n-1,n).
%H A363664 Robert Israel, <a href="/A363664/b363664.txt">Table of n, a(n) for n = 1..593</a>
%F A363664 a(n) = [x^n] Sum_{k>0} x^k/(1 - (k*x)^k)^(n+1).
%p A363664 f:= proc(n) local d;
%p A363664    add((n/d)^(n-n/d) * binomial(n+d-1, n), d = NumberTheory:-Divisors(n))
%p A363664 end proc:
%p A363664 map(f, [$1..30]); # _Robert Israel_, Aug 02 2026
%t A363664 a[n_] := DivisorSum[n, (n/#)^(n-n/#) * Binomial[# + n - 1, n] &]; Array[a, 25] (* _Amiram Eldar_, Jul 12 2023 *)
%o A363664 (PARI) a(n) = sumdiv(n, d, (n/d)^(n-n/d)*binomial(d+n-1, n));
