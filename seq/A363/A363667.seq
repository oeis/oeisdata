%N A363667 a(n) = Sum_{d|n} (n/d)^(n-n/d) * binomial(d+n-2,n-1).
%H A363667 Robert Israel, <a href="/A363667/b363667.txt">Table of n, a(n) for n = 1..593</a>
%F A363667 a(n) = [x^n] Sum_{k>0} x^k/(1 - (k*x)^k)^n.
%p A363667 f:= proc(n) local d;
%p A363667    add((n/d)^(n-n/d) * binomial(n+d-2, n-1), d = NumberTheory:-Divisors(n))
%p A363667 end proc:
%p A363667 map(f, [$1..30]); # _Robert Israel_, Aug 02 2026
%t A363667 a[n_] := DivisorSum[n, (n/#)^(n-n/#) * Binomial[# + n - 2, n - 1] &]; Array[a, 25] (* _Amiram Eldar_, Jul 12 2023 *)
%o A363667 (PARI) a(n) = sumdiv(n, d, (n/d)^(n-n/d)*binomial(d+n-2, n-1));
