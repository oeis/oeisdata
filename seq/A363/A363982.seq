%T A363982 107615,-9028280,-34695607,-17401607,367885509,1598468196,1350497961,
%U A363982 -15317000747,-75391402496,-88375867528,643505487144,3611942077216,5376931884971
%N A363982 G.f. satisfies A(x) = 1 + x*A(x)^2 / (1 + x*A(x)^3).
%H A363982 Vincenzo Librandi, <a href="/A363982/b363982.txt">Table of n, a(n) for n = 0..1000</a>
%F A363982 a(n) = (1/n) * Sum_{k=0..n-1} (-1)^k * binomial(n,k) * binomial(2*n+k,n-1-k) for n > 0.
%F A363982 D-finite with recurrence: -400*n*(n + 1)*(2*n + 1)*a(n) - 20*(n + 1)*(854*n^2 + 1883*n + 1023)*a(n + 1) - 10*(2170*n^3 + 15915*n^2 + 37753*n + 29102)*a(n + 2) + 2*(17126*n^3 + 181561*n^2 + 634081*n + 730436)*a(n + 3) - 6*(1789*n^3 + 22065*n^2 + 90524*n + 123520)*a(n + 4) + 3*(747*n^3 + 10728*n^2 + 51115*n + 80782)*a(n + 5) - 9*(3*n + 17)*(3*n + 19)*(n + 6)*a(n + 6) = 0. - _Robert Israel_, Oct 25 2026
%p A363982 with(gfun):
%p A363982 eq:= (-y+1)*(1+x*y^3)+x*y^2:
%p A363982 de:= algeqtodiffeq(eq,y(x)):
%p A363982 rec:= diffeqtorec(de,y(x),a(n)):
%p A363982 f:= rectoproc(rec,a(n),remember):
%p A363982 map(f, [$0..30]); # _Robert Israel_, Oct 25 2026
%t A363982 a[n_]:=If[n==0,1,Sum[(-1)^k*Binomial[n,k]*Binomial[2 n+k,n-1-k],{k,0,n-1}]/n];Table[a[n],{n,0,30}] (* _Vincenzo Librandi_, Oct 22 2025 *)
%o A363982 (PARI) a(n) = if(n==0, 1, sum(k=0, n-1, (-1)^k*binomial(n, k)*binomial(2*n+k, n-1-k))/n);
%o A363982 (Magma) a := [1]; for n in [1..30] do Append(~a, &+[(-1)^k * Binomial(n, k) * Binomial(2*n + k, n - 1 - k) : k in [0..n-1]] / n); end for; a; // _Vincenzo Librandi_, Oct 22 2025
