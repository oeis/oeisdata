%N A363662 a(n) = Sum_{d|n} (n/d)^n * binomial(d+n,n).
%H A363662 Robert Israel, <a href="/A363662/b363662.txt">Table of n, a(n) for n = 1..384</a>
%F A363662 a(n) = [x^n] Sum_{k>0} (1/(1 - (k*x)^k)^(n+1) - 1).
%p A363662 f:= proc(n) local d;
%p A363662    add((n/d)^n * binomial(n+d, n), d = NumberTheory:-Divisors(n))
%p A363662 end proc:
%p A363662 map(f, [$1..30]); # _Robert Israel_, Aug 02 2026
%t A363662 a[n_] := DivisorSum[n, (n/#)^n * Binomial[# + n, n] &]; Array[a, 20] (* _Amiram Eldar_, Jul 12 2023 *)
%o A363662 (PARI) a(n) = sumdiv(n, d, (n/d)^n*binomial(d+n, n));
