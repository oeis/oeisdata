%N A363101 Even numbers that are neither prime powers nor squarefree.
%C A363101 Even numbers k such that A001222(k) > A001221(k) > 1.
%H A363101 Michael De Vlieger, <a href="/A363101/b363101.txt">Table of n, a(n) for n = 1..10000</a>
%F A363101 Equals 2*(A177712 U A053850). - _Charles Kusniec_, Jul 28 2026
%t A363101 Select[Range[2, 242, 2], Nor[PrimePowerQ[#], SquareFreeQ[#]] &]
%o A363101 (Python)
%o A363101 from math import isqrt
%o A363101 from sympy import mobius
%o A363101 from oeis_sequences.OEISsequences import bisection
%o A363101 def A363101(n):
%o A363101     def f(x): return int(n-2+sum(mobius(k)*((x>>1)//k**2+1>>1) for k in range(1, isqrt(x>>1)+1,2))+x.bit_length()+(x+1>>1))
%o A363101     return bisection(f,n+1,n+1) # _Chai Wah Wu_, Jul 29 2026
%Y A363101 Cf. A001221, A001222, A005418, A024619, A126706, A360769.
%Y A363101 Intersection of A013929 and A177712.
%Y A363101 Cf. A177712 (even nonprime-power composites), A053850 (odd nonsquarefree composites).
%K A363101 nonn
%O A363101 1,1
