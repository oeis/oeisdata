%T A363282 196,221,225,256,265,289,313,324,361,365,400,421,441,481,484,529,545,
%U A363282 576,613,625,676,685,729,761,784,841,900,925,961,1013,1024,1089,1105
%N A363282 Squares (A000290) and centered squares (A001844), in increasing order (i.e., sorted and without duplicates).
%C A363282 This sequence consists of the numbers in A363267 arranged in increasing order. [Edited by _Jianing Song_, Sep 10 2026]
%H A363282 Chai Wah Wu, <a href="/A363282/b363282.txt">Table of n, a(n) for n = 1..10000</a>
%t A363282 c[1] = 1; c[2] = 1;
%t A363282 c[n_] := If[OddQ[n], c[n - 2] + n, 2 c[n - 1] - n + 1]
%t A363282 u = Table[c[n], {n, 1, 120}]  (* A363267 *)
%t A363282 Union[u] (* A363282 *)
%o A363282 (Python)
%o A363282 from math import isqrt
%o A363282 from oeis_sequences.OEISsequences import bisection
%o A363282 def A363282(n):
%o A363282     def f(x):
%o A363282         a, b, c = 1, 5, n+x-isqrt(x)-(isqrt(2*x-1)+1>>1)
%o A363282         while a*a <= x:
%o A363282             a, b = b, 6*b-a
%o A363282             c += 1
%o A363282         return c
%o A363282     return bisection(f,n,n) # _Chai Wah Wu_, Sep 13 2026
