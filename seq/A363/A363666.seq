%N A363666 a(n) = Sum_{d|n} (n/d)^(d-1) * binomial(d+n-2,n-1).
%H A363666 Robert Israel, <a href="/A363666/b363666.txt">Table of n, a(n) for n = 1..1656</a>
%F A363666 a(n) = [x^n] Sum_{k>0} x^k/(1 - k*x^k)^n.
%p A363666 f:= proc(n) local d;
%p A363666    add((n/d)^(d-1) * binomial(n+d-2, n-1), d = NumberTheory:-Divisors(n))
%p A363666 end proc:
%p A363666 map(f, [$1..30]); # _Robert Israel_, Aug 02 2026
%t A363666 a[n_] := DivisorSum[n, (n/#)^(#-1) * Binomial[# + n - 2, n - 1] &]; Array[a, 25] (* _Amiram Eldar_, Jul 12 2023 *)
%o A363666 (PARI) a(n) = sumdiv(n, d, (n/d)^(d-1)*binomial(d+n-2, n-1));
