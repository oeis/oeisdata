%S A363936 0,0,1,2,6,11,22,40,72,120,203,331,526,828,1277,1947,2931,4372,6408,
%T A363936 9376,13530,19414,27572,39001,54616,76183,105448,145300,198982,271322,
%U A363936 367727,496641,667401,893215,1190519,1580798,2091013,2756357,3620738,4740024,6186656
%N A363936 Number of Frobenius partitions of 2*n wherein the number of columns plus the weight on the top row is strictly less than the weight on the bottom row.
%H A363936 Alois P. Heinz, <a href="/A363936/b363936.txt">Table of n, a(n) for n = 0..10000</a> (terms n = 1..120 from Mayank Kumar)
%H A363936 Kelsey Blum, <a href="https://arxiv.org/abs/2103.03196">Bounds on the Number of Graphical Partitions</a>, arXiv:2103.03196 [math.CO], 2021.
%F A363936 a(n) <= A000569(n).
%F A363936 a(n) = Sum_{k=1..floor(sqrt(2*n))} Sum_{m=k*(k+1)/2..n-1} A382864(m,k)*A382864(2*n-m+k,k). - _Alois P. Heinz_, Nov 11 2026
%e A363936 a(4) = 6:
%e A363936   [0]  [1]  [2]  [1 0]  [1 0]  [1 0]
%e A363936   [7]  [6]  [5]  [5 0]  [4 1]  [3 2] .
%p A363936 T:= proc(n,k) option remember; `if`(k<=0 or k>n, 0,
%p A363936       T(n-k, k-1) + T(n-k, k))
%p A363936     end: T(0,0) := 1:
%p A363936 a:= proc(n) option remember; add(add(
%p A363936       T(m, k)*T(2*n-m+k, k), m=k*(k+1)/2..n-1), k=1..floor(sqrt(2*n)))
%p A363936     end:
%p A363936 seq(a(n), n=0..40);  # _Alois P. Heinz_, Nov 11 2026
%Y A363936 Cf. A000569, A342208, A382864.
%K A363936 nonn,changed
%O A363936 0,4
