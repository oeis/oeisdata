%N A363037 Expansion of Sum_{k>0} x^k / (1 + x^(4*k)).
%H A363037 Vaclav Kotesovec, <a href="/A363037/b363037.txt">Table of n, a(n) for n = 1..10000</a>
%H A363037 Vaclav Kotesovec, <a href="/A363037/a363037.jpg">Plot of Sum_{k=1..n} a(k)/n for n = 1..10^8</a>
%F A363037 G.f.: Sum_{k>0} (-1)^(k-1) * x^(4*k-3) / (1 - x^(4*k-3)).
%F A363037 a(n) = Sum_{d|n, d==1 (mod 4)} (-1)^((d-1)/4).
%F A363037 Sum_{k=1..n} a(k) ~ A181048 * n = (Pi/2^(5/2) + log(1 + sqrt(2))/2^(3/2)) * n. - _Vaclav Kotesovec_, Aug 20 2026
%t A363037 a[n_] := DivisorSum[n, (-1)^((# - 1)/4) &, Mod[#, 4] == 1 &]; Array[a, 100] (* _Amiram Eldar_, Jul 03 2023 *)
%o A363037 (PARI) a(n) = sumdiv(n, d, (d%4==1)*(-1)^((d-1)/4));
%Y A363037 Cf. A048272, A002654, A364011, A364043, A364047.
%Y A363037 Cf. A364031, A364032.
%Y A363037 Cf. A001826, A181048.
