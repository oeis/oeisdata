%N A363668 a(n) = Sum_{d|n} (n/d)^d * binomial(d+n-1,d).
%H A363668 Robert Israel, <a href="/A363668/b363668.txt">Table of n, a(n) for n = 1..1656</a>
%F A363668 a(n) = [x^n] Sum_{k>0} (1/(1 - k*x^k)^n - 1).
%p A363668 f:= proc(n) local d;
%p A363668    add((n/d)^d * binomial(n+d-1, d), d = NumberTheory:-Divisors(n))
%p A363668 end proc:
%p A363668 map(f, [$1..30]); # _Robert Israel_, Aug 02 2026
%t A363668 a[n_] := DivisorSum[n, (n/#)^# * Binomial[# + n - 1, #] &]; Array[a, 30] (* _Amiram Eldar_, Jul 12 2023 *)
%o A363668 (PARI) a(n) = sumdiv(n, d, (n/d)^d*binomial(d+n-1, d));
