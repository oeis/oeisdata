%I A363997 #15 Oct 26 2026 23:55:38
%S A363997 1,2,3,4,6,7,9,5,10,8,12,15,16,19,14,21,11,22,24,18,27,20,30,31,17,34,
%T A363997 36,37,40,28,42,45,49,51,13,26,52,54,55,38,57,32,64,33,44,66,23,46,69,
%U A363997 35,70,25,50,75,76,79,41,82,56,84,29,58,87,60,90,91,48
%N A363997 Positions in A088732 of the k-th prime, for k = 1, 2, 3, ...
%C A363997 Every positive integer occurs exactly once.
%H A363997 Robert Israel, <a href="/A363997/b363997.txt">Table of n, a(n) for n = 1..10000</a>
%e A363997 a(1) = 1 because A088732(0) = 2, the first prime (note that A088732 has offset 0, so this is the first term of A088732).
%e A363997 a(2) = 2 because A088732(1) = 3.
%e A363997 a(3) = 3 because A088732(2) = 5.
%e A363997 ...
%e A363997 a(7) = 5 and a(8) = 10 because A088732(4) = A088732(9) = 19.
%p A363997 f:= proc(n) local dk,k,p;
%p A363997      if n::even then dk:= 2 else dk:= 1 fi;
%p A363997      for k from 1 by dk do p:= n+k*(n+1); if isprime(p) then return p fi od
%p A363997 end proc:
%p A363997 f(0):= 2:
%p A363997 A:= map(f, [$0..200]):
%p A363997 T:= 'T':
%p A363997 for i from 1 to 201 do
%p A363997   if A[i] > 200 then next fi;
%p A363997   j:= NumberTheory:-pi(A[i]);
%p A363997   if assigned(T[j]) then T[j]:= T[j],i
%p A363997   else T[j]:= i
%p A363997   fi
%p A363997 od:
%p A363997 R:= NULL: for i from 1 while assigned(T[i]) do R:= R, T[i] od:
%p A363997 R; # _Robert Israel_, Oct 25 2026
%t A363997 z= 200; t = Table[k = 1; While[p = n + k*(n + 1); ! PrimeQ[p], k++];
%t A363997   p, {n, 0, z}];   (* A088732, after _Frank M Jackson_ *)
%t A363997 Flatten[Table[Position[t, Prime[n]], {n, 1, z}]]  (* this sequence *)
%Y A363997 Cf. A000040, A088732, A038780, A363998.
%K A363997 nonn,changed
%O A363997 1,2
%A A363997 _Clark Kimberling_, Jul 11 2023
%E A363997 Edited by _Robert Israel_, Oct 25 2026
