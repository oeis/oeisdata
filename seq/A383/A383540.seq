%I A383540 #29 Aug 21 2026 23:50:25
%S A383540 1,8,33,48269,48624,48979,49334,49689,50044,50399,50754,51109,51464,
%T A383540 51819,52174,573204,37362253,42781604,534483448,17969367914,
%U A383540 775889720990,796943064131,817996407272,839049750413,860103093554,881156436695,902209779836,6273361772570
%N A383540 Positive numbers k such that (sin k)^k sets a new record.
%C A383540 From _Jwalin Bhatt_, Aug 14 2026: (Start)
%C A383540 Conjecture: let p/q be a convergent (A096456/A096463) or a semiconvergent to Pi/2 with q odd. Then every term is either: p, when p is even or q == 1 (mod 4); or 3p, when p is odd and q == 3 (mod 4).
%C A383540 Of the first 27 terms, 26 fall under the first case (ten convergents and sixteen semiconvergents) and one under the second: 33 = 3*11, from the convergent 11/7. (End)
%e A383540 The first few values of (sin k)^k, k >= 1, are:
%e A383540   sin(1)^1   =  0.841470984807896
%e A383540   sin(2)^2   =  0.826821810431805
%e A383540   sin(3)^3   =  0.002810384734461
%e A383540   sin(4)^4   =  0.328042581863883
%e A383540   sin(5)^5   = -0.81081460609467
%e A383540   sin(6)^6   =  0.000475886020687
%e A383540   sin(7)^7   =  0.052831820502919
%e A383540   sin(8)^8   =  0.917970288581835
%e A383540   sin(9)^9   =  0.000342924768404
%e A383540   sin(10)^10 =  0.002270688337734
%e A383540   sin(11)^11 = -0.99989227733272
%e A383540 and the record high points are at k = 1, 8, 33, ...
%t A383540 Module[{x, y, runningMax = 0, positions = {}},
%t A383540   x = Range[1, 10^6]; y = Sin[x]^x;
%t A383540   Do[If[y[[i]] > runningMax, runningMax = y[[i]]; AppendTo[positions, i]; ], {i, Length[y]}];
%t A383540   positions
%t A383540 ]
%o A383540 (Python)
%o A383540 from mpmath import iv
%o A383540 running_max, A383540 = 0, []
%o A383540 for i in range(1, 52175):
%o A383540     while True:
%o A383540         x = iv.sin(i)**i
%o A383540         if (comparison:=x>running_max) is None:
%o A383540             iv.dps += 1
%o A383540             running_max = iv.sin(A383540[-1])**A383540[-1]
%o A383540         else: break
%o A383540     if comparison:
%o A383540         A383540.append(i)
%o A383540         running_max = x
%o A383540 print(A383540)  # _Jwalin Bhatt_, Jan 23 2026
%Y A383540 Cf. A096456, A096463, A382815, A383541.
%K A383540 nonn
%O A383540 1,2
%A A383540 _Jwalin Bhatt_, Apr 29 2025
%E A383540 a(19)-a(28) from _Jwalin Bhatt_, Aug 17 2026
