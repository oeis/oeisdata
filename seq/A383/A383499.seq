%T A383499 1435533,3796050,10026015,26422350,69544765,182759750,479731113,
%U A383499 1257750486,3294264627,8619879726,22535782953,58869786162,153671378139,400861115498,1045005290059,2722601576322
%N A383499 Expansion of 1/sqrt( (1-x) * (1-x-4*x^2)^3 ).
%H A383499 Robert Israel, <a href="/A383499/b383499.txt">Table of n, a(n) for n = 0..2431</a>
%F A383499 a(n) = Sum_{k=0..floor(n/2)} (2*k+1) * binomial(2*k,k) * binomial(n-k+1,k+1).
%F A383499 a(n) ~ sqrt(n/Pi) * ((1 + sqrt(17))/2)^(n + 5/2) / 17^(3/4). - _Vaclav Kotesovec_, May 05 2025
%F A383499 D-finite with recurrence: (14 + 4*n)*a(n) + (-13 - 3*n)*a(n + 1) + (-6 - 2*n)*a(n + 2) + (n + 3)*a(n + 3) = 0. - _Robert Israel_, Sep 23 2026
%p A383499 with(gfun):de:= holexprtodiffeq(1/sqrt( (1-x) * (1-x-4*x^2)^3 ), y(x)):rec:= diffeqtorec(de,y(x),a(n)):f:= rectoproc(rec,a(n),remember):map(f, [$0..30]); # _Robert Israel_, Sep 23 2026
%o A383499 (PARI) a(n) = sum(k=0, n\2, (2*k+1)*binomial(2*k, k)*binomial(n-k+1, k+1));
%Y A383499 Cf. A383254, A383503.
%Y A383499 Cf. A026569, A377204.
