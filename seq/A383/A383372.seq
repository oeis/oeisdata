%I A383372 #20 Aug 07 2026 22:18:34
%S A383372 1,1,2,2,6,8,26,38,130,202,712,1152,4144,6904,25202,42926,158442,
%T A383372 274586,1022348,1796636,6736180,11974360,45154320,81040720,307069360,
%U A383372 555620080,2113890560,3851817920,14705955008,26960013552,103245460226
%N A383372 Number of centrally symmetric Baxter permutations of length n.
%C A383372 For all n > 0, a(n) is the number of triples of non-intersecting lattice paths of length n-1.
%C A383372 a(n) is the number of symmetric twin pairs of full binary trees with n internal nodes.
%H A383372 Kevin Dilks, <a href="https://arxiv.org/abs/1402.2961">Involutions on Baxter Objects</a>, arXiv:1402.2961 [math.CO], 2014.
%H A383372 Stefan Felsner, Éric Fusy, Marc Noy, and David Orden, <a href="https://doi.org/10.1016/j.jcta.2010.03.017">Bijections for Baxter families and related objects</a>, J. Combin. Theory Ser. A, 118(3):993-1020, 2011.
%F A383372 For all n>0, a(n) = Sum_{k=0...n-1} Theta_{k,n-k-1}, where Theta_{k,l} is equal to:
%F A383372   - C(a+b+1,a+1)*C(a+b+1,a)*C(a+b,a)/(a+b+1) if k and l are even with k = 2*a and l = 2*b;
%F A383372   - C(a+b+1,a+1)^2*C(a+b+1,a)/(a+b+1) if k is odd and l is even with k = 2*a+1 and l = 2*b;
%F A383372   - Theta(l,k) if k is even and l is odd;
%F A383372   - 0 if k and l are odd.
%F A383372 From _Meghanto Majumder_, Aug 05 2026: (Start)
%F A383372 P-recurrences for even n = 2m: (m+1)^2*(3*m-2)*a(2*m) = (21*m^3 - 14*m^2 - 5*m + 6)*a(2*m-2) + 8*(m-2)*(m-1)*(3*m+1)*a(2*m-4) for m >= 3.
%F A383372 P-recurrences for odd n = 2m+1: (m+1)*(m+2)*(3*m-1)*a(2*m+1) = (21*m^3 + 14*m^2 - 5*m - 6)*a(2*m-1) + 8*(m-1)^2*(3*m+2)*a(2*m-3) for m >= 3. (End)
%e A383372 The Baxter permutations corresponding to a(4) = 6 are 1234, 1324, 2143, 3412, 4231, and 4321.
%t A383372 T[n_] :=
%t A383372   If[EvenQ[n], Module[{e = {2, 6}, m = n/2}, If[m <= 2, Return[e[[m]]]];
%t A383372     Do[num = (21 k^3 - 14 k^2 - 5 k + 6) e[[-1]] +
%t A383372        8 (k - 2) (k - 1) (3 k + 1) e[[-2]];
%t A383372      den = (k + 1)^2 (3 k - 2);
%t A383372      AppendTo[e, num/den], {k, 3, m}];
%t A383372     e[[m]]],
%t A383372    Module[{o = {1, 2, 8}, target = (n - 1)/2 + 1},
%t A383372     If[target <= 3, Return[o[[target]]]];
%t A383372     Do[num = (21 k^3 + 14 k^2 - 5 k - 6) o[[-1]] +
%t A383372        8 (k - 1)^2 (3 k + 2) o[[-2]];
%t A383372      den = (k + 1) (k + 2) (3 k - 1);
%t A383372      AppendTo[o, num/den], {k, 3, (n - 1)/2}];
%t A383372     o[[target]]]];
%t A383372 Table[T[n], {n, 1, 30}] (* _Meghanto Majumder_, Aug 05 2026 *)
%o A383372 (PARI)
%o A383372 a(n) = if(n%2==0, my(e=[2,6]); if(n/2<=2, return(e[n/2])); for(m=3, n/2, my(num=(21*m^3-14*m^2-5*m+6)*e[#e] + 8*(m-2)*(m-1)*(3*m+1)*e[#e-1]); e=concat(e, num/((m+1)^2*(3*m-2)))); e[n/2], my(o=[1,2,8]); my(t=(n-1)/2+1); if(t<=3, return(o[t])); for(m=3, (n-1)/2, my(num=(21*m^3+14*m^2-5*m-6)*o[#o] + 8*(m-1)^2*(3*m+2)*o[#o-1]); o=concat(o, num/((m+1)*(m+2)*(3*m-1)))); o[t]); /* _Meghanto Majumder_, Aug 05 2026 */
%Y A383372 Cf. A001181.
%K A383372 nonn,changed
%O A383372 0,3
%A A383372 _Ludovic Schwob_, Apr 24 2025
