%I A383229 #42 Aug 26 2026 00:23:53
%S A383229 0,1,2,3,6,9,13,16,19,22,44,66,88,110,132,154,176,179,198,201,223,245,
%T A383229 267,289,311,333,355,710,1065,1420,1775,2130,2485,2840,3195,3550,3905,
%U A383229 4260,4615,4970,5325,5680,6035,6390,6745,7100,7455,7810,8165,8520,8875,9230,9585,9940
%N A383229 Indices of record low-water marks of the sequence abs((sin(k))^k).
%C A383229 (sin 0) ^ 0 is interpreted as limit of (sin(x)) ^ x as x -> 0.
%C A383229 From _Jwalin Bhatt_, Aug 21 2026: (Start)
%C A383229 Conjecture: Every forward difference of this sequence is a positive integer multiple of the numerator of either a convergent (A002485/A002486) or a semiconvergent to Pi.
%C A383229 Multipliers above 1 are rare. Among the 631 differences below 10^12 only three distinct values have multiplier greater than 1, each occurring once and each with multiplier 2, namely 2292816=2*1146408, 2137933792=2*1068966896 and 12335900908=2*6167950454.
%C A383229 The differences that recur most often tend to be the numerators p of convergents for which abs(cos p)^p is largest, that is, the terms of A382564. (End)
%H A383229 Jwalin Bhatt, <a href="/A383229/b383229.txt">Table of n, a(n) for n = 1..632</a>
%e A383229 The first few values of abs((sin k)^k) are:
%e A383229   abs(sin(0)^0) = 1
%e A383229   abs(sin(1)^1) = 0.841470984807896
%e A383229   abs(sin(2)^2) = 0.826821810431805
%e A383229   abs(sin(3)^3) = 0.002810384734461
%e A383229   abs(sin(4)^4) = 0.328042581863883
%e A383229   abs(sin(5)^5) = 0.810814606094671
%e A383229   abs(sin(6)^6) = 0.000475886020687
%e A383229   abs(sin(7)^7) = 0.052831820502919
%e A383229 and the record low points are at n = 0, 1, 2, 3, 6, ...
%t A383229 Module[{x, y, runningMin = 1.1, positions = {0}},
%t A383229   x = Range[10^6];y = Abs[Sin[x]^x];
%t A383229   Do[If[y[[i]] < runningMin,runningMin = y[[i]];AppendTo[positions, i];],{i, Length[y]}];
%t A383229   positions
%t A383229 ]
%o A383229 (Python)
%o A383229 from mpmath import iv
%o A383229 running_min, A383229 = 2, []
%o A383229 for i in range(1066):
%o A383229     while True:
%o A383229         x = abs(iv.sin(i)**i)
%o A383229         if (comparison:=x<running_min) is None:
%o A383229             iv.dps += 1
%o A383229             running_min = abs(iv.sin(A383229[-1])**A383229[-1])
%o A383229         else: break
%o A383229     if comparison:
%o A383229         A383229.append(i)
%o A383229         running_min = x
%o A383229 print(A383229)  # _Jwalin Bhatt_, Jan 08 2026
%Y A383229 Cf. A002485, A382564, A382815, A383283.
%K A383229 nonn,changed
%O A383229 1,3
%A A383229 _Jwalin Bhatt_, Apr 28 2025
