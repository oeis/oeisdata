%I A054223 #18 Sep 07 2026 18:27:54
%S A054223 4,4,6,11,9,26,16,25,110,36,49,64,335,81,276,100,649,121,144,169,196,
%T A054223 225,670,2024,256,1166,289,517,324,3522,361,3068,4071,400,2485,441,
%U A054223 484,6137,529,1534,6816,576,625,676,729,784,841,900,961,15851,16199,12099
%N A054223 Consider all integer triples (i,j,k), j,k>0, with binomial(i+2,3)=binomial(j+2,3)+k^3, ordered by increasing i; sequence gives k values.
%C A054223 i values are A054221 and j values are A054222.
%H A054223 Bert Dobbelaere, <a href="/A054223/b054223.txt">Table of n, a(n) for n = 0..271</a>
%e A054223 binomial(7+2,3)=84=binomial(4+2,3)+4^3; binomial(8+2,3)=120=binomial(6+2,3)+4^3;
%t A054223 max = 20000; s = {}; Do[k = ((i*(i+1)*(i+2) - j*(j+1)*(j+2))/6)^(1/3); If[IntegerQ[k], Print[k]; AppendTo[s, {i, k}]], {j, 1, max}, {i, j+1, max}]; Sort[s, #1[[1]] < #2[[1]] &][[All, 2]] (* _Jean-François Alcover_, Oct 12 2011 *)
%o A054223 (C)
%o A054223 #include <stdio.h>
%o A054223 #include <limits.h>
%o A054223 #include <math.h>
%o A054223 unsigned A000578inv(unsigned long long n)
%o A054223 {
%o A054223     unsigned long long n3 = (unsigned long long)cbrt((double)n);
%o A054223     for (unsigned long long k = n3 - 1; k <= n3 + 1; k++)
%o A054223         if (k * k * k == n)
%o A054223             return k;
%o A054223     return 0;
%o A054223 }
%o A054223 int main(int argc, char *argv[])
%o A054223 {
%o A054223     const unsigned long long imax = cbrt((double)ULLONG_MAX) - 2.;
%o A054223     for (unsigned i = 1; i < imax; i++)
%o A054223     {
%o A054223         unsigned long long i3 = i * (unsigned long long)(i + 1)
%o A054223                                   * (unsigned long long)(i + 2);
%o A054223         for (unsigned j = 1; j < i; j++)
%o A054223         {
%o A054223             unsigned long long k3 = i3 - j * (unsigned long long)(j + 1)
%o A054223                                           * (unsigned long long)(j + 2);
%o A054223             if (k3 % 6 == 0)
%o A054223             {
%o A054223                 unsigned k = A000578inv(k3 / 6);
%o A054223                 if (k)
%o A054223                 {
%o A054223                     printf("%d, ", k);
%o A054223                     fflush(stdout);
%o A054223                 }
%o A054223             }
%o A054223         }
%o A054223     }
%o A054223 } /* _R. J. Mathar_, Nov 10 2006 */
