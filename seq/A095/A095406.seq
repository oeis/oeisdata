%I A095406 #22 Jul 28 2026 14:44:55
%S A095406 10,12,14,15,20,21,30,34,35,38,40,42,50,51,57,60,63,70,74,90,91,95,
%T A095406 100,102,104,105,106,110,111,112,114,115,116,118,119,120,122,123,126,
%U A095406 130,132,133,134,140,141,142,145,146,150,152,153,154,158,161,170,171,174
%N A095406 Numbers k such that Sum-of-digits-of-k < Sum-of-digits-of-all-distinct-prime-factors-of-k.
%H A095406 Robert Israel, <a href="/A095406/b095406.txt">Table of n, a(n) for n = 1..10000</a>
%F A095406 Solutions to A007953(k) < A095402(k).
%e A095406 For k = 38: digit sum=11, prime factor-digit sum = 2+1+9 = 12 > 11, so 38 is here;
%e A095406 For k = 10^j:digit sum=1, prime factor-digit sum = 2+5 = 7 > 1. so 10^j is here for all j and so the sequence is infinite.
%p A095406 sod:= n -> convert(convert(n,base,10),`+`):
%p A095406 filter:= proc(n) local k; sod(n) < add(sod(k),k=NumberTheory:-PrimeFactors(n)) end proc:
%p A095406 select(filter, [$1..1000]); # _Robert Israel_, Jul 27 2026
%t A095406 ffi[x_] :=Flatten[FactorInteger[x]]; lf[x_] :=Length[FactorInteger[x]]; ba[x_] :=Table[Part[ffi[x], 2*j-1], {j, 1, lf[x]}]; sd[x_] :=Apply[Plus, IntegerDigits[x]]; tdp[x_] :=Flatten[Table[IntegerDigits[Part[ba[x], j]], {j, 1, lf[x]}], 1]; sdp[x_] :=Apply[Plus, tdp[x]]; a=Table[sd[w], {w, 1, 200}];b=Table[sdp[w], {w, 1, 200}]; Flatten[Position[Sign[b-a], 1]]
%t A095406 (* Alternative: *)
%t A095406 Select[Range[200],Total[IntegerDigits[#]]<Total[Flatten[IntegerDigits/@ Transpose[FactorInteger[#]][[1]]]]&] (* _Harvey P. Dale_, May 06 2012 *)
%Y A095406 Cf. A007953, A051351, A095402, A095403, A095404, A095405.
%K A095406 nonn,easy,base,changed
%O A095406 1,1
%A A095406 _Labos Elemer_, Jun 21 2004
