%N A095935 First prime of length n encountered in the decimal representation of e.
%H A095935 Michael S. Branicky, <a href="/A095935/b095935.txt">Table of n, a(n) for n = 1..1000</a>
%H A095935 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/e-Prime.html">e-Prime</a>.
%t A095935 f[n_] := Select[FromDigits /@ Partition[ First[ RealDigits[E, 10, 1000]], n, 1], PrimeQ, 1][[1]]; Array[f, 20] (* _Robert G. Wilson v_, Nov 14 2011 *)
%o A095935 (Python)
%o A095935 from sympy import E, isprime
%o A095935 e = "2"+str(E.n(10**6))[2:] # or load data from file
%o A095935 def A095935_A272304(n): return next(((p, i+1) for i in range(len(e)-n-10) if e[i]!="0" and isprime(p:=int(e[i:i+n]))), "not enough digits")
%o A095935 print([A095935_A272304(n)[0] for n in range(1, 22)]) # _Michael S. Branicky_, Oct 09 2026
