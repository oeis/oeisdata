%N A095399 Modified juggler modified further: a(n) = (1- (n mod 2)) * floor(n^(3/4)) + (n mod 2) * floor(n^(4/3)); original exponents {1/2,3/2} are replaced with {3/4,4/3}.
%t A095399 e[x_]:=e[x]=(1-Mod[x, 2])*Floor[N[x^(3/4), 50]] +Mod[x, 2]*Floor[N[x^(4/3), 50]];e[1]=1; Table[e[w], {w, 1, 150}]
%o A095399 (Python)
%o A095399 from sympy import integer_nthroot
%o A095399 def A095399(n): return (integer_nthroot(n**4,3) if n&1 else integer_nthroot(n**3,4))[0] # _Chai Wah Wu_, Sep 09 2026
