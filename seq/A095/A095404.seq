%I A095404 #13 Aug 01 2026 17:05:44
%S A095404 1,4,6,8,9,16,18,24,25,26,27,28,32,33,36,39,44,45,46,48,49,52,54,55,
%T A095404 56,62,64,65,66,68,69,72,75,76,77,78,80,81,82,86,87,88,92,93,96,98,99,
%U A095404 108,117,121,124,125,128,129,135,138,143,144,147,148,155,156,159,162,164
%N A095404 Numbers whose sum of digits is greater than the sum of the digits of all of its distinct prime factors.
%C A095404 Numbers k such that A007953(k) > A095402(k).
%H A095404 Robert Israel, <a href="/A095404/b095404.txt">Table of n, a(n) for n = 1..10000</a>
%e A095404 k=24: digit sum=6, prime factor-digit sum=2+3=5, so 24 is here;
%e A095404 k=153: digit sum=9, prime factor-digit sum=3+5+3=11>9, so 153 is here.
%p A095404 sod:= n -> convert(convert(n,base,10),`+`):
%p A095404 filter:= proc(n) local k; sod(n) > add(sod(k),k=NumberTheory:-PrimeFactors(n)) end proc:
%p A095404 select(filter, [$1..1000]); # _Robert Israel_, Jul 27 2026
%t A095404 ffi[x_] :=Flatten[FactorInteger[x]] lf[x_] :=Length[FactorInteger[x]] ba[x_] :=Table[Part[ffi[x], 2*j-1], {j, 1, lf[x]}] sd[x_] :=Apply[Plus, IntegerDigits[x]] tdp[x_] :=Flatten[Table[IntegerDigits[Part[ba[x], j]], {j, 1, lf[x]}], 1] sdp[x_] :=Apply[Plus, tdp[x]] a=Table[sd[w], {w, 1, 256}];b=Table[sdp[w], {w, 1, 150}];b-a; Flatten[Position[Sign[b-a], 1]]
%Y A095404 Cf. A007953, A051351, A095402, A095403, A095405, A095406.
%K A095404 nonn,base,changed
%O A095404 1,2
%A A095404 _Labos Elemer_, Jun 21 2004
