%N A095400 Largest value in trajectory when the following modified juggler map is iterated: n -> (1 - (n mod 2)) * floor(n^(3/4)) + (n mod 2) * floor(n^(4/3)); original exponents {1/2, 3/2} are replaced with {3/4, 4/3}.
%e A095400 n=101: the trajectory is {101, 470, 100, 31, 97, 445, 3397, 51065, 1894513, 234421146, 1894512, 51064, 3396, 444, 96, 30, 12, 6, 3, 4, 2, 1}, peak = a(101) = 234421146.
%t A095400 e[x_] := e[x] = (1-Mod[x, 2])*Floor[x^(3/4)] + Mod[x, 2]*Floor[x^(4/3)]; e[1] = 1; fe[x_] := Delete[FixedPointList[e, x], -1]; Table[Max[fe[w]], {w, 1, 150}]
%Y A095400 Cf. A007320, A094683, A094716, A095396, A095397, A095398, A095399.
