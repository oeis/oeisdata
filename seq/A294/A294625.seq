%T A294625 4027,7307,7309,12211,14243,18911,18913,23557,25439,28729,36683,37831,
%U A294625 46853,50411,53129,55457,57367,60251,67339,70489,74797,89669,98909,98911,111229,120767
%N A294625 Primes of the form prime(k+2)*prime(k+1) - prime(k) +- 1.
%H A294625 Michael S. Branicky, <a href="/A294625/b294625.txt">Table of n, a(n) for n = 1..10000</a>
%e A294625 7*5 - 3 - 1 = 31.
%e A294625 11*7 - 5 - 1 = 71.
%e A294625 11*7 - 5 + 1 = 73.
%e A294625 13*11 - 7 + 1 = 137.
%o A294625 (Python)
%o A294625 from itertools import islice
%o A294625 from sympy import isprime, nextprime
%o A294625 def agen(): # generator of terms
%o A294625     p, q, r = 1, 2, 3
%o A294625     while True:
%o A294625         p, q, r = q, r, nextprime(r)
%o A294625         for offset in [-1, 1]:
%o A294625             if isprime(t:=r*q-p+offset):
%o A294625                 yield t
%o A294625 print(list(islice(agen(), 42))) # _Michael S. Branicky_, Aug 12 2026
%Y A294625 Cf. A000040, A001359, A006512.
