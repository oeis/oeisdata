%N A216278 Number of solutions to the equation x^2 + 2*y^2 = n with x and y > 0.
%H A216278 Seiichi Manyama, <a href="/A216278/b216278.txt">Table of n, a(n) for n = 0..10000</a>
%F A216278 G.f.: (theta_3(q) - 1)*(theta_3(q^2) - 1)/4, where theta_3() is the Jacobi theta function. - _Ilya Gutkovskiy_, Sep 03 2026
%t A216278 r[n_] := Reduce[x > 0 && y > 0 && x^2 + 2 y^2 == n, Integers];
%t A216278 a[n_] := Which[rn = r[n]; rn === False, 0, Head[rn] === And, 1, Head[rn] === Or, Length[rn], True, -1];
%t A216278 Table[a[n], {n, 1, 120}] (* _Jean-François Alcover_, Jun 24 2017 *)
%Y A216278 Cf. A063725, A092573, A216510, A216511, A374017.
%Y A216278 Cf. A119395, A000161, A025426.
%K A216278 nonn,easy,changed
%O A216278 0,28
