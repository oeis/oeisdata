%N A208152 Triangle by rows, generated from the Ruler sequence A001511.
%F A208152 Inverse of:
%F A208152    1;
%F A208152   -1,  1;
%F A208152   -1, -2,  1;
%F A208152   -1, -2, -1,  1;
%F A208152   -1, -2, -1, -3,  1;
%F A208152   -1, -2, -1, -3, -1,  1;
%F A208152   -1, -2, -1, -3, -1, -2,  1;
%F A208152   ..., where the signed terms are negatives of A001511 terms: (1, 2, 1, 3, 1, 2, 1, 4, ...).
%e A208152 First few rows of the triangle =
%e A208152      1;
%e A208152      1,    1;
%e A208152      3,    2,    1;
%e A208152      6,    4,    1,    1;
%e A208152     24,   16,    4,    3,   1;
%e A208152     48,   32,    8,    6,   1,   1;
%e A208152    144,   96,   24,   18,   3,   2,  1;
%e A208152    288,  192,   48,   36,   6,   4,  1,  1;
%e A208152   1440,  960,  240,  180,  30,  20,  5,  4, 1;
%e A208152   2880, 1920,  480,  360,  60,  40, 10,  8, 1, 1;
%e A208152   8640, 5760, 1440, 1080, 180, 120, 30, 24, 3, 2, 1;
%e A208152   ...
%o A208152 (PARI) T(n, k) = (matrix(n, n, i, j, if(j < i, -valuation(2*j, 2), i == j))^-1)[n, k];
%o A208152 for(n=1, 11, for(k=1, n, print1(T(n, k), ", "))) \\ _Alper Ferudun_, Oct 17 2026
