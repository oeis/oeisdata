%N A245778 Numbers m such that m/tau(m) - sigma(m)/m is an integer.
%C A245778 Numbers m such that A245776(m) / A245777(m) = (m / A000005(m) - A000203(m) / m) is an integer, or equivalently A245777(m) = 1.
%C A245778 Correponding integers are A245776(m): 0, 25, 94, 311, 4031, 73652, 118571, ...
%C A245778 Conjecture: subsequence of A216793.
%C A245778 This conjecture does not hold as A009194(a(19)) < A009194(a(18)). - _Max Alekseyev_, Jul 28 2026
%C A245778 Refactorable multiply-perfect numbers (A245782) are members of this sequence.
%C A245778 Some large terms: 143573364313605309726720, 352338107624535891640320, 680489641226538823680000, 34384125938411324962897920, 156036748944739017459105792, 3638193973609385308194865152, 72746008559331545135067955200. - _Max Alekseyev_, Jul 31 2026
%F A245778 A245777(a(n)) = 1.
%e A245778 672 is in sequence because 672 / tau(672) - sigma(672) / 672 = 672 / 24 - 2016 / 672 = 25 (integer).
%p A245778 select(n -> type(n/numtheory:-tau(n) - numtheory:-sigma(n)/n,integer), [$1..10^8]); # _Robert Israel_, Aug 03 2014
%o A245778 (Magma) [n: n in [1..100000] | (Denominator((n/(#[d: d in Divisors(n)])) - (SumOfDivisors(n)/n)) eq 1)];
%o A245778 (PARI)
%o A245778 for(n=1,10^8,s=n/numdiv(n);t=sigma(n)/n;if(floor(s-t)==s-t,print1(n,", "))) \\ _Derek Orr_, Aug 01 2014
