%I A136415 #29 Oct 06 2026 09:07:37
%S A136415 4,6,12,14,20,22,46,52,54,60,70,76,92,94,116,124,126,140,166,174,180,
%T A136415 182,204,206,214,220,230,236,244,252,262,276,284,286,292,294,302,332,
%U A136415 340,350,356,364,372,374,390,404,412,430,460,484,494,510,516,526,532
%N A136415 Numbers k such that a type-3 Gaussian normal basis over GF(2^k) exists.
%C A136415 A type-t Gaussian normal basis exists for GF(2^k) if and only if p = k*t+1 is prime and gcd(k, (p-1)/ord(2 mod p)) = 1.
%C A136415 Type-1 basis correspond to sequence A071642, type-2 basis to A054639.
%C A136415 From _Jianing Song_, Oct 06 2026: (Start)
%C A136415 Note that p = k*t+1 being prime and gcd(k, (p-1)/ord(2 mod p)) = 1 imply that (p-1)/ord(2 mod p) divides t. In particular, k is a term in this sequence if and only if k satisfies one the following conditions:
%C A136415 (i) ord(2 mod p) = p-1 (k = 4, 6, 12, 20, 22, ...);
%C A136415 (ii) k is not divisible by 3, and ord(2 mod p) = (p-1)/3 (k = 14, 52, 76, 92, 94, ...). (End)
%H A136415 Jianing Song, <a href="/A136415/b136415.txt">Table of n, a(n) for n = 1..10000</a> (first 201 terms from Joerg Arndt, Mar 31 2008)
%H A136415 Joerg Arndt, <a href="https://www.jjj.de/fxt/#fxtbook">Matters Computational (The Fxtbook)</a>, section 42.9 "Gaussian normal bases", pp.914-920.
%e A136415 12 is in the list because 3*12+1=37 is prime and the index of 2 mod 37 (==36/ord(2 mod 37)==1, 2 is a generator mod 37) is coprime to 12.
%o A136415 (PARI)
%o A136415 gauss_test(n, t)=
%o A136415 { /* test whether a type-t Gaussian normal basis exists for GF(2^n) */
%o A136415   local( p, r2, g, d );
%o A136415   p = t*n + 1;
%o A136415   if ( !isprime(p), return( 0 ) );
%o A136415   if ( p<=2, return( 0 ) );
%o A136415   r2 = znorder( Mod(2, p) );
%o A136415   d = (p-1)/r2;
%o A136415   g = gcd(d, n);
%o A136415   return ( if ( 1==g, 1, 0) );
%o A136415 }
%o A136415 /* generate this sequence: */
%o A136415 t=3;ct=1;for(n=1,10^7,if(gauss_test(n,t), print1(n,", ");ct+=1;if(ct>200,break())))
%o A136415 (PARI) istypet(n,t=3) = my(p); (isprime(p=n*t+1) && gcd(n, (p-1)/znorder(Mod(2, p))) == 1) \\ _Jianing Song_, Oct 06 2026, following _Michel Marcus_'s program in A101284
%Y A136415 Cf. A071642 (type-1), A054639 (type-2), A136415 (type-3), A137310 (type-4), A137311 (type-5), A137313 (type-6), A137314 (type-7), A101284 (type-8).
%K A136415 nonn,changed
%O A136415 1,1
%A A136415 _Joerg Arndt_, Mar 31 2008
