%T A136768 153,161,169,170,178,186,194,202,210,218,226,227,235,243,251,259,267,
%U A136768 275,283,284,292,300,308,316,324,332,340,341,349,357,365,373,381,389,397
%N A136768 n! never ends in this many 0's in base 7.
%C A136768 Also: n! never ends in this many 0's in base 14, 21, 28 and all other 7-divisible proper factors of 7!
%o A136768 (Python)
%o A136768 from sympy import integer_log
%o A136768 from oeis_sequences.OEISsequences import bisection, bsearch
%o A136768 def A136768(n): return bisection(lambda x: n+bsearch(lambda x: sum(x//7**k for k in range(integer_log(x,7)[0]+1)),x),n,n) # _Chai Wah Wu_, Oct 20 2026
