%N A136771 n! never ends in this many 0's in base 11.
%o A136771 (Python)
%o A136771 from sympy import integer_log
%o A136771 from oeis_sequences.OEISsequences import bisection, bsearch
%o A136771 def A136771(n): return bisection(lambda x: n+bsearch(lambda x: sum(x//11**k for k in range(integer_log(x,11)[0]+1)),x),n,n) # _Chai Wah Wu_, Oct 20 2026
