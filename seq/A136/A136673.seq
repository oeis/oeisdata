%t A136673 p[x, 0] = 2 + x; p[x, 1] = 1 + 2*x; p[x_, n_] := p[x, n] = (x + 1)*p[x, n - 1] - x*p[x, n - 2]; Table[ExpandAll[p[x, n]], {n, 0, 10}]; a = Table[CoefficientList[p[x, n], x], {n, 0, 10}] Flatten[a]
