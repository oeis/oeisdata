%F A017273 From _Amiram Eldar_, Oct 29 2026: (Start)
%F A017273 Sum_{n>=1} 1/a(n) = zeta(5)/100000.
%F A017273 Sum_{n>=1} (-1)^(n+1)/a(n) = 3*zeta(5)/320000. (End)
%t A017273 (10*Range[0,20])^5 (* _Harvey P. Dale_, Sep 18 2013 *)
%t A017273 (* Alternative: *)
%t A017273 LinearRecurrence[{6,-15,20,-15,6,-1},{0,100000,3200000,24300000,102400000,312500000},20] (* _Harvey P. Dale_, Sep 18 2013 *)
