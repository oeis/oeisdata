%I A168469 #9 Aug 11 2026 13:44:45
%S A168469 5,16,21,24,40,45,48,72,72,96,112,117,120,120,120,144,160,165,168,168,
%T A168469 168,192,240,240,240,240,264,280,285,288,312,312,312,336,352,357,360,
%U A168469 360,408,408,408,432,432,480,480,480,504,520,525,528,528,552,552,552
%N A168469 Numbers of the form p^2 - q^2, p, q primes, p > q, with repetitions.
%H A168469 Robert Israel, <a href="/A168469/b168469.txt">Table of n, a(n) for n = 1..10000</a>
%p A168469 N:= 1000: # for terms <= N
%p A168469 Ps:= map(t -> t^2, select(isprime,[2,seq(i,i=3..(N+4)/4,2)])):
%p A168469 A:= NULL:
%p A168469 for i from 1 to nops(Ps) do
%p A168469   if Ps[i] <= N then jmin:= 1 else
%p A168469      jmin:= 1+ListTools:-BinaryPlace(Ps,Ps[i]-N);
%p A168469   fi;
%p A168469   A:= A, seq(Ps[i]-Ps[j],j=jmin .. i-1)
%p A168469 od:
%p A168469 sort([A]); # _Robert Israel_, Aug 11 2026
%t A168469 Take[Sort[Last[#]^2-First[#]^2&/@Subsets[Prime[Range[40]],{2}]],60] (* _Harvey P. Dale_, Jul 22 2012 *)
%Y A168469 Cf. A124865 Numbers of the form p^2 - q^2, p, q primes, p > q.
%K A168469 nonn,changed
%O A168469 1,1
%A A168469 _Zak Seidov_, Nov 26 2009
