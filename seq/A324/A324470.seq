%T A324470 40,42,43,46,47,49,50,51,53,54,57,58,60,61,63,64,67,68,70,71,72,74,75,
%U A324470 78,79,81,82,83,85,86,89,90,92,93,95,96,99,100,102,103
%N A324470 Partial sums of ternary tribonacci word A092782.
%H A324470 Robert Israel, <a href="/A324470/b324470.txt">Table of n, a(n) for n = 1..10000</a>
%p A324470 N:= 100: # for a(1)..a(N)
%p A324470 f(1):= (1, 2): f(2):= (1, 3): f(3):= (1): A:= [1]:
%p A324470 for i from 1 do
%p A324470 Ap:= map(f, A):
%p A324470 if nops(Ap) > N then Ap:= Ap[1..N] fi;
%p A324470 if Ap = A then break fi;
%p A324470 A:= Ap
%p A324470 od:
%p A324470 ListTools:-PartialSums(A); # _Robert Israel_, Nov 07 2026
