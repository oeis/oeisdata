%S A066851 0,0,1,0,3,0,3,3,3,0,9,1,3,6,6,3,9,0,9,9,6,0,15,6,3,12,10,3,15,0,15,
%T A066851 12,6,6,18,9,3,12,18,6,21,0,9,21,9,6,27,7,9,12,18,9,15,12,18,24,6,0,
%U A066851 33,6,15,18,21,12,18,12,9,27,18,0,39,9,9,24,19,21,18,0,27,27,18,6,33,18,6
%N A066851 Number of ordered solutions (x,y,z) to xy + yz + zx = n with x,y,z >= 1.
%H A066851 Andrew Howroyd, <a href="/A066851/b066851.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from T. D. Noe)
%H A066851 L. J. Mordell, <a href="https://doi.org/10.1307/mmj/1028998438">The representation of integers by three positive squares</a>, Michigan Math. J. 7 (3) 289-290, 1960.
%F A066851 a(n) = A067751(n) - 3*A000005(n) = 3*H(4*n) - (3/2)*A000005(n), where H(n) = A058305(n)/A058306(n) is the Hurwitz class number of discriminant -n. - _David Radcliffe_, Aug 21 2026
%e A066851 a(5) = 3 since there are solutions (2,1,1), (1,2,1), (1,1,2).
%o A066851 (PARI) a(n) = sum(x=1, n-2, sum(y=1, (n-2)\x, (n-x*y)%(x+y)==0 )) \\ _Andrew Howroyd_, Oct 31 2025
%Y A066851 a(A025052(n))=0. Cf. A066958, A067751 (nonnegative solutions), A058305, A058306.
%K A066851 easy,nonn,changed
%O A066851 1,5
%A A066851 _Colin Mallows_, Jan 24 2002
%E A066851 More terms from _Vladeta Jovovic_, Jan 25 2002
