%S A066850 1,4,2669,9559,15293,32583,36593,38443,255367,257239,273977,283391,
%T A066850 314101,421553,488363,532975,768699,839973,871757,1960479,2337221,
%U A066850 2374867,3084659,3326653,3735029,4440017,5387373,7930439,8114377,14628761,17093447,17717057,19487159
%N A066850 Numbers k such that phi(phi(k)) + sigma(sigma(k)) = phi(sigma(k)) + sigma(phi(k)), where phi=A000010 is Euler's totient function and sigma=A000203 is the sum of divisors function.
%H A066850 Harry J. Smith, <a href="/A066850/b066850.txt">Table of n, a(n) for n = 1..114</a>
%e A066850 Let k = 2669. Then phi(phi(k)) + sigma(sigma(k)) = phi(2496) + sigma(2844) = 768 + 7280 = 8048 and phi(sigma(k)) + sigma(phi(k)) = phi(2844) + sigma(2496) = 936 + 7112 = 8048. So 2669 is a term.
%t A066850 g[x_] := Module[{a, b, c, d, e, f}, a = EulerPhi[x]; b = DivisorSigma[1, x]; c = EulerPhi[a]; d = DivisorSigma[1, b]; e = EulerPhi[b]; f = DivisorSigma[1, a]; c + d - e - f]; Do[If[g[n] == 0, Print[n]], {n, 1, 10^6}]
%o A066850 (PARI) isok(m) = { my(e=eulerphi(m), s=sigma(m)); eulerphi(e) + sigma(s) == eulerphi(s) + sigma(e) } \\ _Harry J. Smith_, Apr 02 2010
%Y A066850 Cf. A000010, A000203.
