%I A066377 #22 Sep 01 2026 17:57:22
%S A066377 1,3,6,10,16,24,33,45,60,76,96,120,145,175,210,246,288,336,385,441,
%T A066377 504,568,640,720,801,891,990,1090,1200,1320,1441,1573,1716,1860,2016,
%U A066377 2184,2353,2535,2730,2926,3136,3360,3585,3825,4080,4336,4608,4896,5185,5491,5814,6138,6480
%N A066377 Sum of the first n numbers k such that floor(sqrt(k)) divides k.
%H A066377 Harry J. Smith, <a href="/A066377/b066377.txt">Table of n, a(n) for n = 1..1000</a>
%H A066377 <a href="/index/Rec#order_08">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,2,-4,2,-1,2,-1).
%F A066377 G.f.: -x*(x^3-x^2-x-1) / ((x-1)^4*(x^2+x+1)^2). - _Colin Barker_, Jan 12 2013
%t A066377 Accumulate[Select[Range[370], Divisible[#, Floor[Sqrt[#]]] &]] (* _Paolo Xausa_, Sep 01 2026 *)
%t A066377 (* Alternative: *)
%t A066377 LinearRecurrence[{2, -1, 2, -4, 2, -1, 2, -1}, {1, 3, 6, 10, 16, 24, 33, 45}, 55] (* _Paolo Xausa_, Sep 01 2026 *)
%o A066377 (PARI) lista(n) = { my(s=0, k=0); vector(n, n, k++; while(k%sqrtint(k) != 0, k++); s+=k) } \\ _Harry J. Smith_, Feb 12 2010
%Y A066377 Partial sums of A006446.
%K A066377 nonn,changed
%O A066377 1,2
%A A066377 _N. J. A. Sloane_, Dec 23 2001
%E A066377 Name corrected by _Andrew Howroyd_, Aug 30 2026
