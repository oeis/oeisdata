%N A066996 Numbers k such that Sum_{i=2..k} 1/A001221(i) is an integer.
%H A066996 Harry J. Smith, <a href="/A066996/b066996.txt">Table of n, a(n) for n = 1..1000</a>
%t A066996 Select[Range[2, 1000], IntegerQ[Sum[1/PrimeNu[k], {k, 2, #}]] &] (* _G. C. Greubel_, Apr 23 2017 *)
%o A066996 (PARI) lista(n,lim=oo) = { my(L=List(), m=1, s=0); while(#L<n && m<lim, m++; s = frac(s + 1/omega(m)); if(!s,listput(L,m)) ); Vec(L) } \\ _Harry J. Smith_, Apr 24 2010
