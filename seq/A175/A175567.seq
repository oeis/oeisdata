%U A175567 0,1653,0,1770,0,0,0,0,0,2145,0,0,0,2415,0,2556,0,0,0,0,0,3003,0,0,0,3321
%N A175567 a(n) = (n!)^2 modulo n*(n+1)/2.
%C A175567 It appears that if n is one less than an odd prime then (n!)^2 modulo n(n+1)/2 is n(n-1)/2 else 0. This result appears to hold for any even power of n!. See A119690 for similar results related to odd powers of n!.
%C A175567 The conjecture above is true for every even power 2k with k >= 1. Proof: if n+1 is not an odd prime, n(n+1)/2 divides n! (see A069268). If n+1 = p is an odd prime, write n(n+1)/2 = h*p with h = n/2. Then (n!)^(2k) == 0 (mod h), and (n!)^(2k) == 1 (mod p) by Wilson's theorem. Because 2h == -1 (mod p), x = h*(p-2) = n(n-1)/2 satisfies x == 0 (mod h) and x == -2h == 1 (mod p), and 0 <= x < n(n+1)/2, so by the Chinese remainder theorem the residue is n(n-1)/2. - _Scott M. Foltz_, Sep 24 2026
%H A175567 Vincenzo Librandi, <a href="/A175567/b175567.txt">Table of n, a(n) for n = 1..1000</a>
%F A175567 a(n) = A001044(n) mod A000217(n). - _Michel Marcus_, Sep 26 2026
%t A175567 Table[Mod[(n!)^2, (n^2 + n)/2], {n, 100}] (* _Vincenzo Librandi_, Jul 10 2014 *)
%t A175567 (* Alternative: *)
%t A175567 Table[PowerMod[n!,2,(n(n+1))/2],{n,100}] (* _Harvey P. Dale_, Aug 27 2016 *)
%o A175567 (PARI) a(n) = (n!)^2 % (n*(n+1)/2); \\ _Michel Marcus_, Jul 09 2014
%o A175567 (Python)
%o A175567 from sympy import isprime
%o A175567 def A175567(n): return n*(n-1)>>1 if isprime(n+1) else 0 # based on formula in comments _Chai Wah Wu_, Sep 25 2026
%Y A175567 Cf. A001044, A000217, A119690, A169690, A175553, A399704.
