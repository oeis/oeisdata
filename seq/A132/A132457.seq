%S A132457 4,8,12,14,18,22,28,33,38,39,52,64,74,77,78,82,84,108,124,129,138,143,
%T A132457 144,147,148,152,162,169,182,183,203,214,217,218,238,242,248,249,259,
%U A132457 262,264,267,278,298,312,333,334,348,357,368,374,392,399,407,413
%N A132457 Composites of the form ((x+y)/3+2)/(x-y), where x and y are primes with x - y = 4.
%e A132457 If x=23 and y=19, then ((23+19)/3+2)/(23-19)=16/4=4=a(1).
%e A132457 If x=47 and y=43, then ((47+43)/3+2)/(47-43)=32/4=8=a(2).
%e A132457 If x=71 and y=67, then ((71+67)/3+2)/(71-67)=48/4=12=a(3).
%e A132457 If x=83 and y=79, then ((83+79)/3+2)/(83-79)=56/4=14=a(4).
%e A132457 If x=107 and y=103, then ((107+103)/3+2)/(107-103)=72/4=18=a(5).
%e A132457 If x=131 and y=127, then ((131+127)/3+2)/(131-127)=88/4=22=a(6),
%e A132457 etc.
%Y A132457 Cf. A000040, A002808, A141468.
