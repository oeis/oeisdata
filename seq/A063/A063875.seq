%S A063875 831600,1058400,1587600,1663200,1814400,1940400,1965600,2116800,
%T A063875 2328480,2494800,2570400,2646000,2721600,2872800,2910600,2948400,
%U A063875 3024000,3175200,3326400,3528000,3603600,3628800,3704400,3880800,3931200,4158000,4233600,4435200,4536000,4586400
%N A063875 Numbers k such that sigma(k) - usigma(k) > 3k.
%H A063875 Amiram Eldar, <a href="/A063875/b063875.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..400 from Harry J. Smith)
%t A063875 f[p_, e_] := (p^(e+1)-1)/(p-1); q[k_] := Module[{fct = FactorInteger[k]}, Times @@ f @@@ fct - Times @@ (1 + Power @@@ fct) > 3*k]; q[1] = False; Select[Range[2*10^6], q] (* _Amiram Eldar_, Aug 27 2026 *)
%o A063875 (PARI) u(n) = sumdiv(n,d, if(gcd(d,n/d)==1,d));
%o A063875 for(n=1,10^9, if(sigma(n)-u(n)>3*n,print(n)))
%o A063875 (PARI) u(n) = sumdiv(n, d, if(gcd(d, n/d)==1, d))
%o A063875 { n=0; for (m=1, 10^9, if(sigma(m) - u(m) > 3*m, write("b063875.txt", n++, " ", m); if (n==1000, break)) ) } \\ _Harry J. Smith_, Sep 01 2009
%o A063875 (PARI) isok(k) = {my(f = factor(k)); sigma(f) - prod(i = 1, #f~, f[i, 1]^f[i, 2]+1) > 3*k;} \\ _Amiram Eldar_, Aug 27 2026
