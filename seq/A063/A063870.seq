%I A063870 #20 Aug 31 2026 07:24:05
%S A063870 480,2688,2095104,16854816,41055200,1839272960,5905219584,204004720640
%N A063870 Numbers k such that sigma(k) - usigma(k) = 3*k/2.
%C A063870 There are no others less than 1.5*10^13, but here's a larger one: 948990933336933380096. - _Dean Hickerson_, Sep 25 2001
%t A063870 f[p_, e_] := (p^(e+1)-1)/(p-1); q[k_] := Module[{fct = FactorInteger[k]}, Times @@ f @@@ fct - Times @@ (1 + Power @@@ fct) == 3*k/2]; q[1] = False; Select[Range[2.1*10^6], q] (* _Amiram Eldar_, Aug 31 2026 *)
%o A063870 (PARI) u(n) = sumdiv(n,d, if(gcd(d,n/d)==1,d));
%o A063870 isok(n) = sigma(n)-u(n)==3*n/2;
%Y A063870 Cf. A034448, A000203, A048146, A063846, A064591.
%K A063870 nonn,more,changed
%O A063870 1,1
%A A063870 _Jason Earls_, Aug 27 2001
%E A063870 More terms from _Dean Hickerson_, Sep 25 2001
