%I A063794 #26 Aug 31 2026 07:24:05
%S A063794 2,28,1368,1700,342000,2061000,2120832,65834560,89082000
%N A063794 Numbers k such that usigma(k) = k + phi(k).
%C A063794 No other terms < 2700000000. - _Jud McCranie_, Nov 04 2001
%t A063794 f[p_, e_] := (p-1)*p^(e-1); q[k_] := Module[{fct = FactorInteger[k]}, Times @@ (1 + Power @@@ fct) - Times @@ f @@@ fct == k]; q[1] = False; Select[Range[350000], q] (* _Amiram Eldar_, Aug 31 2026 *)
%o A063794 (PARI) us(n) = sumdiv(n,d, if(gcd(d,n/d)==1,d));
%o A063794 isok(n) = us(n)==n+eulerphi(n);
%Y A063794 Cf. A000010, A034448, A121048.
%K A063794 nonn,more,changed
%O A063794 1,1
%A A063794 _Jason Earls_, Aug 18 2001
%E A063794 More terms from _Jud McCranie_, Nov 04 2001
