%I A063885 #14 Aug 31 2026 07:23:58
%S A063885 24,1536,1631,47360,82458
%N A063885 Numbers k such that z(sigma(k)) = 2*k, where z(k) = A048146(k).
%C A063885 a(6) > 10^10, if it exists. - _Amiram Eldar_, Aug 31 2026
%t A063885 f[p_, e_] := (p^(e+1)-1)/(p-1); q[k_] := Module[{fct = FactorInteger[DivisorSigma[1, k]]}, Times @@ f @@@ fct - Times @@ (1 + Power @@@ fct) == 2*k]; q[1] = False; Select[Range[10^5], q] (* _Amiram Eldar_, Aug 31 2026 *)
%o A063885 (PARI) u(n) = sumdiv(n,d, if(gcd(d,n/d)==1,d));
%o A063885 z(n) = sigma(n)-u(n);
%o A063885 isok(n) = z(sigma(n))==2*n;
%Y A063885 Cf. A000203, A034448, A048146, A019284.
%K A063885 nonn,more,changed
%O A063885 1,1
%A A063885 _Jason Earls_, Aug 28 2001
