%T A063795 20026,23374,23560,25714,25844,33915,35074,39585,49196,55154,56134,
%U A063795 66040,86900,99484,104140,105105,110600,116116,124558,141340,157586,194184,200260,205344
%N A063795 Numbers k such that usigma(k) = phi(k)*omega(k), where omega(k) is the number of distinct prime divisors of k.
%H A063795 Amiram Eldar, <a href="/A063795/b063795.txt">Table of n, a(n) for n = 1..4000</a> (terms 1..200 from Harry J. Smith)
%t A063795 f[p_, e_] := (p-1)*p^(e-1); q[k_] := Module[{fct = FactorInteger[k]}, Times @@ (1 + Power @@@ fct) == Length[fct] * Times @@ f @@@ fct]; q[1] = False; Select[Range[10^5], q] (* _Amiram Eldar_, Aug 31 2026 *)
%o A063795 (PARI) us(n) = sumdiv(n,d, if(gcd(d,n/d)==1,d));
%o A063795 for(n=1,10^7, if(us(n)==eulerphi(n)*omega(n),print(n)))
%o A063795 (PARI) us(n) = sumdiv(n, d, if(gcd(d, n/d)==1, d))
%o A063795 { n=0; for (m=1, 10^9, if(us(m)==eulerphi(m)*omega(m), write("b063795.txt", n++, " ", m); if (n==200, break)) ) } \\ _Harry J. Smith_, Aug 31 2009
%o A063795 (PARI) isok(k) = {my(f = factor(k)); prod(i = 1, #f~, f[i, 1]^f[i, 2]+1) == eulerphi(f) * omega(f);} \\ _Amiram Eldar_, Aug 31 2026
