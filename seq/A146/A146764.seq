%I A146764 #13 Oct 07 2026 23:57:53
%S A146764 13,61,73,109,151,181,229,241,257,293,307,313,349,353,373,397,409,487,
%T A146764 509,557,571,577,601,613,643,653,661,709,727,733,739,751,761,773,811,
%U A146764 823,937,941,977
%N A146764 Primes not in A075255.
%C A146764 It has been asked whether A146071 contains all primes. The answer is no: since A075255(n) > n/2-2 for nonprime n, any prime p that did not appear until the rank 2(p+2) is not in A075255.
%H A146764 Robert Israel, <a href="/A146764/b146764.txt">Table of n, a(n) for n = 1..10000</a>
%p A146764 g:= proc(n) local t; n - add(t[1]*t[2],t=ifactors(n)[2]) end proc:
%p A146764 N:= 1000: # for terms <= N
%p A146764 S:= select(isprime,{seq(i,i=3..N,2)}):
%p A146764 R:= S minus map(g, {$2 .. 2*N+4}):
%p A146764 sort(convert(R,list)); # _Robert Israel_, Oct 07 2026
%o A146764 (PARI) A146764( END=999 )=local( n=1, t=0, k); forprime( p=1,END, while( n<2*(p+2), isprime( k=A075255(n++)) || next; t=bitor(1<<primepi(k),t)); bittest(t,primepi(p)) || print1(p","))
%Y A146764 Cf. A075255, A146071, A145834.
%K A146764 easy,nonn,changed
%O A146764 1,1
%A A146764 _M. F. Hasler_, Nov 04 2008
%E A146764 Edited by _Robert Israel_, Oct 07 2026
