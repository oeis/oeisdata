%t A176819 q[n_]:=Last/@FactorInteger[n]=={2,2};lst=Select[Range[3*8! ],q[ # ]&];a=Table[lst[[n+1]]-lst[[n]],{n,1,Length[lst]-1}]
%t A176819 Differences[Select[Range[200],PrimeOmega[#]==2&&SquareFreeQ[#]&]^2] (* _Harvey P. Dale_, Aug 05 2024 *)
%o A176819 (Python)
%o A176819 from math import isqrt
%o A176819 from sympy import primepi, primerange
%o A176819 from oeis_sequences.OEISsequences import bisection
%o A176819 def A176819(n):
%o A176819     def f(x): return int(n+x+(t:=primepi(s:=isqrt(y:=isqrt(x))))+(t*(t-1)>>1)-sum(primepi(y//k) for k in primerange(1, s+1)))
%o A176819     return -(k:=bisection(f,n,n))+bisection(lambda x:f(x)+1,k,k) # _Chai Wah Wu_, Sep 22 2026
