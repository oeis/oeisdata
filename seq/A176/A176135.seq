%U A176135 8323253,9750581,13392343,10233341,30060757,48278539,23380183,22018301
%N A176135 Primes p in the sequence prime(k+1)^3-prime(k)^3-1.
%C A176135 Terms are in order of k, not of the primes.  Thus a(3) > a(4). For the sequence sorted in order of p, see A398468.- _Robert Israel_, Jul 30 2026
%H A176135 Robert Israel, <a href="/A176135/b176135.txt">Table of n, a(n) for n = 1..10000</a>
%e A176135 5^3-3^3-1=97,...
%p A176135 P:= select(isprime, [2,seq(i,i=3..10^4,2)]):
%p A176135 select(isprime, [seq(P[i+1]^3 - P[i]^3-1,i=1..nops(P)-1)]); # _Robert Israel_, Jul 30 2026
%t A176135 Select[Table[Prime[n+1]^3-Prime[n]^3-1,{n,6!}],PrimeQ[ # ]&]
%t A176135 Select[#[[2]]-#[[1]]-1&/@Partition[Prime[Range[200]]^3,2,1],PrimeQ] (* _Harvey P. Dale_, Nov 13 2017 *)
%Y A176135 Cf. A000040, A176134, A398468.
%K A176135 nonn
