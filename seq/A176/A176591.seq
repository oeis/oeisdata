%T A176591 2,6,2,870,2,14322,2,510,2,6,2,1919190,2,6,2,13530,2,1806,2,690,2,282,
%U A176591 2,46410,2,66,2,1590,2,798,2,870,2,354,2,56786730,2,6,2,510,2,64722,2,30,2,4686,2,140100870,2,6,2,30,2
%N A176591 Bernoulli denominators A141056(n), with the exception a(1)=1.
%C A176591 These are also the denominators of a sequence generated by inverse binomial transform of Bernoulli sequence where B(1) is replaced by zero, described in A176328 (which is the sequence of numerators of the transformed sequence).
%H A176591 Antti Karttunen, <a href="/A176591/b176591.txt">Table of n, a(n) for n = 0..4096</a>
%F A176591 a(n) = A141056(n), n <> 1.
%F A176591 a(n) = A027760(n), n>1.
%F A176591 a(2n) = A002445(n), a(2n+1)= A040000(n).
%p A176591 read("transforms") ; evb := [1, 0, seq(bernoulli(n), n=2..50)] ; BINOMIALi(evb) ; apply(denom, %) ; # _R. J. Mathar_, Dec 01 2010
%p A176591 # Alternative:
%p A176591 seq(denom((bernoulli(i,1)+bernoulli(i,2))/2),i=0..50); # _Peter Luschny_, Jun 17 2012
%t A176591 a[n_] := If[OddQ[n], 2, BernoulliB[n] // Denominator]; a[1] = 1; Table[a[n], {n, 0, 50}] (* _Jean-François Alcover_, Dec 29 2012 *)
%t A176591 Join[{1,1},BernoulliB[Range[2,80]]/.(0->1/2)//Denominator] (* _Harvey P. Dale_, Dec 31 2018 *)
%o A176591 (PARI) A176591(n) = { my(p=1); if(n>1, fordiv(n, d, my(r=d+1); if(isprime(r), p = p*r))); return(p); }; \\ _Antti Karttunen_, Dec 20 2018, after code in A141056
%o A176591 (Python)
%o A176591 from functools import cache
%o A176591 from math import gcd
%o A176591 @cache
%o A176591 def T(n: int) -> list[int]:
%o A176591     if n == 0: return [1]
%o A176591     row = [0] + T(n - 1) + [0]
%o A176591     for k in range(n, 0, -1): row[k] += row[k + 1]
%o A176591     for k in range(2, n + 2): row[k] += row[k - 1]
%o A176591     return row[1:]
%o A176591 def a(n: int) -> int:
%o A176591     if n < 2: return 1
%o A176591     if n & 1: return 2
%o A176591     g = T(n // 2 - 1)[-1]
%o A176591     d = (1 << (n + 1)) - 2
%o A176591     return d // gcd(g, d)
%o A176591 print([a(n) for n in range(78)])  # _Peter Luschny_, Nov 04 2026
