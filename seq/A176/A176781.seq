%I A176781 #12 Sep 04 2026 04:14:22
%S A176781 3,11,3,17,3,3,3,11,89,41,257,3,29,131,353,3,3,11,89,521,257,3,17,3,
%T A176781 467,89,149,17,71,47,293,17,191,47,3,41,23,11,401,41,443,41,293,479,
%U A176781 311,23,587,41,1289,1013,29,41,59,293,1031,17,23,17,347,401,599,11,227,827,401
%N A176781 Smallest prime prime(i) such that concatenation 2//0_(n)//prime(i) is prime.
%C A176781 We search for the prime such that the first prime (=2) concatenated with n zeros and concatenated with that prime is again a prime number.
%C A176781 If p = prime(i) is a d(i)-digit prime: q = 2 * 10^(n+d(i)) + p has to be prime.
%C A176781 Necessarily prime(i) is congruent to 0 or 2 (mod 3).
%C A176781 It is conjectured that prime(i) = 3 occurs infinitely often: at n= 0, 2, 4, 5, 6, 11, 15, 16, 21, 23, 34, 114, 119,... (A101951).
%D A176781 E. I. Ignatjew, Mathematische Spielereien, Urania Verlag Leipzig/Jena/ Berlin 1982
%H A176781 Robert Israel, <a href="/A176781/b176781.txt">Table of n, a(n) for n = 0..1000</a>
%e A176781 n = 0: 2//3 = 23 = prime(9), 3 = prime(2) is first term
%e A176781 n = 1: 2//0//11 = 2011 = prime(305), 11 = prime(5) is 2nd term
%e A176781 n = 2: 2//00//3 = 2003 = prime(304), 3 = prime(2) is 3rd term
%p A176781 f:= proc(n) local p,i;
%p A176781      p:= 1;
%p A176781      for i from 1 do
%p A176781        p:= nextprime(i);
%p A176781        if isprime(2*10^(n+1+ilog10(p))+p) then return p fi
%p A176781      od
%p A176781 end proc:
%p A176781 map(f, [$0..100]); # _Robert Israel_, Sep 03 2026
%o A176781 (Python)
%o A176781 from gmpy2 import digits, mpz, is_prime, next_prime
%o A176781 def a(n):
%o A176781     pk, base = mpz(3), mpz(2)*mpz(10)**mpz(n)
%o A176781     while True:
%o A176781         if pk%3 in {0, 2} and is_prime(base*10**len(digits(pk))+pk):
%o A176781             return int(pk)
%o A176781         pk = next_prime(pk)
%o A176781 print([a(n) for n in range(65)]) # _Michael S. Branicky_, Sep 03 2026
%Y A176781 Cf. A101951, A164968, A173291, A176316
%K A176781 base,nonn,changed
