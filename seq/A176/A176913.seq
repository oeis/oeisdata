%I A176913 #22 Oct 04 2026 15:10:17
%S A176913 2022,11149,11373,17574,22381,25037,26701,27949,31210,36123,49974,
%T A176913 61395,65581,67373,70541,75373,75949,88747,97549,103373,108294,110886,
%U A176913 112045,114774,118285,147174,159757,162349,172717,174390,175373,195531,202957
%N A176913 Numbers k with maximum exponent in prime factorization equal to 1, such that k+1 has maximum exponent 2, k+2 has maximum exponent 3, and k+3 has maximum exponent 4.
%C A176913 The asymptotic density of this sequence is d(2, 3, 4, 5) - d(2, 2, 4, 5) - d(2, 3, 3, 5) - d(2, 3, 4, 4) + d(2, 2, 3, 5) + d(2, 2, 4, 4) + d(2, 3, 3, 4) - d(2, 2, 3, 4) = 0.000155199203971334733598..., where d(i, j, k, m) = Product_{p prime} (1 - 1/p^i - 1/p^j - 1/p^k - 1/p^m). - _Amiram Eldar_, Oct 02 2026
%H A176913 Amiram Eldar, <a href="/A176913/b176913.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from Harvey P. Dale)
%e A176913 2022 is a term since 2022 = 2*3*337, 2023 = 7*17^2, 2024 = 2^3*11*23, and 2025 = 3^4*5^2.
%t A176913 f[n_]:=Max[Last/@FactorInteger[n]]; lst={};Do[If[f[n]==1&&f[n+1]==2&&f[n+2]==3&&f[n+3]==4,AppendTo[lst,n]],{n,2,9!}];lst
%t A176913 (* Alternative: *)
%t A176913 SequencePosition[Table[Max[FactorInteger[n][[;;,2]]],{n,250000}],{1,2,3,4}][[;;,1]] (* _Harvey P. Dale_, Aug 21 2024 *)
%o A176913 (PARI) list(kmax) = {my(e1 = 1, e2 = 1, e3 = 1, e4); for(k = 4, kmax, e4 = vecmax(factor(k)[,2]); if(e1 == 1 && e2 == 2 && e3 == 3 && e4 == 4, print1(k-3, ", ")); e1 = e2; e2 = e3; e3 = e4);} \\ _Amiram Eldar_, Oct 02 2026
