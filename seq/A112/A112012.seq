%I A112012 #13 Oct 14 2026 03:36:59
%S A112012 16,17,63,73,132,224,322,342,352,362,619,1017,1117,1196,1516,2163,
%T A112012 2215,3514,3714,5137,11373,12012,12121,13120,17116,21113,25911,51045,
%U A112012 64541,64581,64591,64601,64611,64651,64661,64691,64701,64711,64721,100967,110486,198509
%N A112012 Numbers k such that there exists at least one number j and pi(k) = d(1) d(2) ... d(j)*d(j+1) d(j+2) ... d(t) where d(1) d(2) ... d(t) is the decimal expansion of k.
%C A112012 A112013 is the prime subsequence of this sequence.
%e A112012 pi(16)=1*6 so j=1; pi(342)=34*2 so j=2; pi(12012)=120*12 so j=3;
%e A112012 pi(64541)=6454*1 so j=4, etc.
%t A112012 Select[Range[10, 200000], MemberQ[h=IntegerDigits[ # ]; k=Length[h]; Table[FromDigits[Table[h[[i]], {i, j}]]*FromDigits[Table[h[[i]], {i, j+1, k}]], {j, k}], PrimePi[ # ]] &]
%Y A112012 Cf. A112013.
%K A112012 base,nonn,changed
%O A112012 1,1
%A A112012 _Farideh Firoozbakht_, Sep 04 2005
%E A112012 a(3) inserted and more terms from _Alper Ferudun_, Oct 13 2026
