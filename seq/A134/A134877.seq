%e A134877 Sum_{k>=1} 1/(k!!)^(k!!) = 1.28703709664168181471132029755820425904216955340222081026798765926909...
%t A134877 RealDigits[N[Sum[1/n!!^n!!, {n, 1, 10}], 105]][[1]] (* corrected by _Amiram Eldar_, Nov 15 2026 *)
%o A134877 (PARI) dfact(n) = if(n % 2 == 0, 2^(n/2)*(n/2)!, n!/(2^((n-1)/2)*((n-1)/2)!));
%o A134877 suminf(k = 1, 1/dfact(k)^dfact(k)); \\ _Amiram Eldar_, Nov 15 2026
