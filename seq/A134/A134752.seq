%N A134752 a(n) = 3^(2*n-1) + 2.
%C A134752 Suggested by a posting from _Luis H. Gallardo_ to the Number Theory List, Jan 14 2008.
%H A134752 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (10,-9).
%F A134752 a(n) = 10*a(n-1)-9*a(n-2); a(1)=5, a(2)=29. - _Harvey P. Dale_, Dec 08 2015
%F A134752 From _Elmo R. Oliveira_, Aug 22 2026: (Start)
%F A134752 G.f.: x*(5 - 21*x)/((1 - x)*(1 - 9*x)).
%F A134752 E.g.f.: (-7 + 6*exp(x) + exp(9*x))/3.
%F A134752 a(n) = A013708(n-1) + 2 = A168607(2*n-1). (End)
%t A134752 3^(2*Range[20]-1)+2 (* _Harvey P. Dale_, Dec 08 2015 *)
%t A134752 (* Alternative: *)
%t A134752 LinearRecurrence[{10, -9}, {5, 29}, 20] (* _Harvey P. Dale_, Dec 08 2015 *)
%Y A134752 Odd bisection of A168607.
%Y A134752 Cf. A013708, A134753.
