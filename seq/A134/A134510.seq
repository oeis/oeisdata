%I A134510 #41 Nov 17 2026 22:45:55
%S A134510 1,1,1,3,1,1,4,4,1,1,8,5,5,1,1,12,12,6,6,1,1,21,17,17,7,7,1,1,33,33,
%T A134510 23,23,8,8,1,1,55,50,50,30,30,9,9,1,1,88,88,73,73,38,38,10,10,1,1,144,
%U A134510 138,138,103,103,47,47,11,11,1,1,232,232,211,211,141,141,57,57,12,12,1,1
%N A134510 Triangle read by rows: A112552 * A128174 as infinite lower triangular matrices.
%F A134510 From _Ranjan Kumar Dhani_, Oct 21 2026: (Start)
%F A134510 T(n,k) = A054450(n,k).
%F A134510 T(n,k) = Sum_{j=0..floor((n-k)/2)} binomial(n-j, j).
%F A134510 T(n,k) = T(n-1,k-1) + T(n-2,k), 1 < k < n; T(n,1) = Fibonacci(n+1) - (1+(-1)^n)/2, T(n,n) = 1.
%F A134510 Sum_{k=1..n} (k-1) * T(n,k) = A001628(n-2) for n>1.
%F A134510 Sum_{k=1..n} (-1)^(k+1) * T(n,k) = A147600(n-1). (End)
%e A134510 First few rows of the triangle:
%e A134510    1;
%e A134510    1,  1;
%e A134510    3,  1,  1;
%e A134510    4,  4,  1,  1;
%e A134510    8,  5,  5,  1,  1;
%e A134510   12, 12,  6,  6,  1,  1;
%e A134510   21, 17, 17,  7,  7,  1,  1;
%e A134510   33, 33, 23, 23,  8,  8,  1,  1;
%e A134510   55, 50, 50, 30, 30,  9,  9,  1,  1;
%e A134510   ...
%t A134510 T[n_, k_] := T[n, k] = Piecewise[{{Fibonacci[n + 1] - (1 + (-1)^n)/2, k == 1}, {1, k == n}, {T[n - 1, k - 1] + T[n - 2, k], 1 < k < n}}, 0]; Table[ T[n, k], {n, 1, 10}, {k, 1, n}]//Flatten (* _Ranjan Kumar Dhani_, Oct 21 2026 *)
%t A134510 (* Alternative: *)
%t A134510 T[n_, k_] := Sum[Binomial[n - j, j], {j, 0, Floor[(n - k)/2]}]; Table[T[n, k], {n, 1, 10}, {k, 1, n}] // Flatten (* _Ranjan Kumar Dhani_, Oct 21 2026 *)
%Y A134510 Row sums are A001629(n+1).
%Y A134510 Antidiagonal sums are A005672(n+2).
%Y A134510 Columns 1..4 are A052952(n-1), A054451(n-2), A099571(n-3), A099572(n-4).
%Y A134510 Main diagonal is A000012.
%Y A134510 Essentially the same triangle as A054450 but without column 0.
%Y A134510 Cf. A112552, A128174.
%K A134510 nonn,tabl,changed
%O A134510 1,4
%A A134510 _Gary W. Adamson_, Oct 28 2007
%E A134510 More terms from _Ranjan Kumar Dhani_, Oct 21 2026
