%N A134248 M * A007318, M = a triangle by rows, n-th row = (n-1) zeros followed by T(n), 1.
%C A134248 Row sums = A104270.
%C A134248 Left column = A000124.
%F A134248 M * A007318, where M = an infinite lower triangular matrix with rows: n-th row = (n-1) zeros followed by T(n), 1; T(n) = n-th triangular number. M = an infinite lower triangular matrix with (1,1,1,...) in the main diagonal and the triangular series in the subdiagonal.
%e A134248 First few rows of the triangle:
%e A134248    1;
%e A134248    2,  1;
%e A134248    4,  5,   1;
%e A134248    7, 15,   9,  1;
%e A134248   11, 34,  36, 14,  1;
%e A134248   16, 65, 100, 70, 20, 1;
%e A134248   ...
%o A134248 (PARI) M = matrix(10, 10, i, j, (i==j) + (i==j+1)*i*(i-1)/2); \\ diagonal 1, subdiagonal T(n), rows n = 0..9
%o A134248 A = M*matrix(10, 10, i, j, binomial(i-1, j-1)); \\ M * A007318
%o A134248 for(n=1, 10, for(k=1, n, print1(A[n, k], ", "))) \\ _Alper Ferudun_, Oct 17 2026
