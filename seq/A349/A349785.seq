%N A349785 a(n) = 1 + Product_{k=1..n-1} a(gcd(n,k)).
%C A349785 If n is prime, a(n) = 1 + 2^(n-1). - _Robert Israel_, Aug 04 2026
%H A349785 Robert Israel, <a href="/A349785/b349785.txt">Table of n, a(n) for n = 1..179</a>
%F A349785 a(n) = 1 + Product_{d|n, d < n} a(d)^phi(n/d).
%p A349785 f:= proc(n) option remember; local k;
%p A349785   1 + mul(procname(igcd(n,k)),k=1..n-1)
%p A349785 end proc:
%p A349785 map(f, [$1..30]); # _Robert Israel_, Aug 04 2026
%t A349785 a[n_] := a[n] = 1 + Product[a[GCD[n, k]], {k, 1, n - 1}]; Table[a[n], {n, 1, 27}]
