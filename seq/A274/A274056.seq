%N A274056 Number of unrooted labeled trees on 2n nodes with node degree either one or three.
%C A274056 There are no unrooted labeled trees on 2n+1 nodes with node degree either one or three.
%H A274056 Marko Riedel et al., <a href="http://math.stackexchange.com/questions/1816933/">Number of labeled trees</a>, Mathematics Stack Exchange.
%F A274056 a(n) ~ 2^(3*n)*exp(-2*n)*n^(2*(n-1)). - _Stefano Spezia_, Nov 01 2026
%p A274056 seq(binomial(2*n, (2*n-2)/2)*(2*n-2)!/2^((2*n-2)/2), n=1..16);
%t A274056 a[n_]:=Binomial[2*n, (2*n-2)/2]*(2*n-2)!/2^((2*n-2)/2); Array[a,16] (* _Stefano Spezia_, Nov 01 2026 *)
