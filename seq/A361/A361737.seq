%U A361737 3465901878247744920,90563401722349627920,2376642701449937741580,62607393746503658100360
%N A361737 Diagonal of rational function 1/(1 - (x + y + z + x^2*y*z)).
%C A361737 From _Seiichi Manyama_, Jul 25 2026: (Start)
%C A361737 For integers s >= 1, t >= 0 and e_1, ... ,e_s >= 0 with e_1 + ... + e_s = t, [x_1^n*  ... *x_s^n] 1/(1 - Sum_{i=1..s} x_i * (1 + x_1* ... *x_s)^e_i) = Sum_{k=0..n} (s*k)!/k!^s * binomial(t*k,n-k). For s=3, t=1, (e_1,e_2,e_3)=(1,0,0), and (x_1,x_2,x_3)=(x,y,z), this gives a(n) = [x^n*y^n*z^n] 1/(1 - (x + y + z + x^2*y*z)). (End)
%F A361737 a(n) = Sum_{k=0..n} (3*k)!/k!^3 * binomial(k,n-k).
%F A361737 a(n) ~ sqrt(3) * ((27 + 3*sqrt(93))/2)^n / (2*Pi*n). - _Vaclav Kotesovec_, Mar 23 2023
%t A361737 Table[Sum[(3*k)!/k!^3 * Binomial[k,n-k], {k,0,n}], {n,0,20}] (* _Vaclav Kotesovec_, Mar 23 2023 *)
%o A361737 (PARI) a(n) = sum(k=0, n, (3*k)!/k!^3*binomial(k, n-k));
%Y A361737 Cf. A361738, A361739.
%Y A361737 Cf. A361728, A398291.
%K A361737 nonn
%O A361737 0,2
%A A361737 _Seiichi Manyama_, Mar 22 2023
