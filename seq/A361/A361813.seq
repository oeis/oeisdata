%U A361813 19177245746844,128361805431752,860443079597872,5775392952659170,38811408514848032,261101034656317244
%N A361813 Expansion of 1/sqrt(1 - 4*x*(1+x)^4).
%C A361813 From _Seiichi Manyama_, Jul 25 2026: (Start)
%C A361813 For integers t >= 0 and 0 <= e <= t, [x^n*y^n] 1/(1 - x*(1+x*y)^e - y*(1+x*y)^(t-e)) = Sum_{k=0..n} binomial(2*k,k) * binomial(t*k,n-k). (End)
%F A361813 a(n) = Sum_{k=0..n} binomial(2*k,k) * binomial(4*k,n-k).
%F A361813 n*a(n) = 2 * ( (2*n-1)*a(n-1) + 4*(2*n-2)*a(n-2) + 6*(2*n-3)*a(n-3) + 4*(2*n-4)*a(n-4) + (2*n-5)*a(n-5) ) for n > 4.
%F A361813 a(n) = binomial(2*n,n)*hypergeom([(1-4*n)/5,(2-4*n)/5, (3-4*n)/5, 4*(1-n)/5, -4*n/5], [1/4-n, 1/2-n, 1/2-n, 3/4-n], -5^5/2^10). - _Stefano Spezia_, Jul 26 2026
%t A361813 a[n_]:=Binomial[2n,n]*HypergeometricPFQ[{(1-4*n)/5, (2-4*n)/5, (3-4*n)/5, 4*(1-n)/5, -4*n/5},{1/4-n, 1/2-n, 1/2-n, 3/4-n},-5^5/2^10]; Array[a,23,0] (* _Stefano Spezia_, Jul 26 2026 *)
%o A361813 (PARI) my(N=30, x='x+O('x^N)); Vec(1/sqrt(1-4*x*(1+x)^4))
%Y A361813 Column k=4 of A361830.
%Y A361813 Cf. A006139, A137635, A360133, A361790, A361791, A361792, A361812, A361814.
