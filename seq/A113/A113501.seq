%S A113501 1,2,3,9,14,23,29,81,128,210,468,473,746,950,3344,4043,4839,14376,
%T A113501 39521,64563,72984,82899,84338,85206,86121,139160,276141
%N A113501 Indices of prime NSW numbers A088165.
%C A113501 Very closely related to indices of prime Pell-Lucas numbers (A099088).
%C A113501 a(27) > 221400. - _Robert Price_, Mar 29 2019
%C A113501 The list includes indices of probable primes. For example, the NSW number with index 4839, equal to A001333(9679), is listed as a probable prime by PrimePages. - _Eric W. Weisstein_, Oct 10 2026
%C A113501 The NSW number at index 276141 corresponds to the probable prime A001333(552283), reported by Robert Price in A099088 on Dec 05 2023. - _Eric W. Weisstein_, Oct 13 2026
%H A113501 H. Li and T. MacHenry, <a href="https://cs.uwaterloo.ca/journals/JIS/VOL16/MacHenry/machenry7.html">Permanents and Determinants, Weighted Isobaric Polynomials, and Integer Sequences</a>, J. Int. Seq. 16 (2013) #13.3.5, example 47.
%H A113501 PrimePages, <a href="https://t5k.org/primes/page.php?id=27783">V(2,-1,9679)/2</a> (probable-prime verification).
%H A113501 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/IntegerSequencePrimes.html">Integer Sequence Primes</a>.
%H A113501 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/NSWNumber.html">NSW Number</a>.
%e A113501 NSW(1) = 7, NSW(2) = 41, NSW(3) = 239, NSW(9) = 9369319, ...
%t A113501 nsw = LinearRecurrence[{6, -1}, {7, 41}, 1000]; Position[nsw, _?(PrimeQ[#] &)] // Flatten (* _Amiram Eldar_, Dec 07 2018 *)
%o A113501 (PARI) isok(n) = my(w=3+quadgen(32)); isprime(imag((1+w)*w^n)); \\ _Michel Marcus_, Dec 07 2018
