%I A113553 #27 Jul 31 2026 23:49:36
%S A113553 1,4,8,11,14,17,21,24,26,29,33,36,38,41,45,48,50,53,57,60,62,65,69,72,
%T A113553 74,77,81,84,86,89,93,96,98,101,105,108,110,113,117,120,122,125,129,
%U A113553 132,134,137,141,144,146,149,153,156
%N A113553 Numbers k such that A113552(k) is odd.
%C A113553 As _Antti Karttunen_ pointed out, the old definition was simply wrong. (It was also ungrammatical.) At least the new definition gives a meaningful sequence. - _N. J. A. Sloane_, May 26 2018
%H A113553 Robert Israel, <a href="/A113553/b113553.txt">Table of n, a(n) for n = 1..10000</a>
%p A113553 S:= {1}: A[1]:= 1: K:= 1: count:= 1:
%p A113553 for n from 2 while count < 100 do
%p A113553   d:= min(numtheory:-divisors(A[n-1]) minus S);
%p A113553   if d < infinity then A[n]:= d
%p A113553   else
%p A113553     Q:= numtheory:-factorset(A[n-1]);
%p A113553     for k from 2 do
%p A113553       if not member(k*A[n-1], S) and not (numtheory:-factorset(k) subset Q) then
%p A113553         A[n]:= k*A[n-1];
%p A113553         break
%p A113553       fi
%p A113553     od
%p A113553   fi;
%p A113553   if A[n]::odd then K:= K,n; count:= count+1 fi;
%p A113553   S:= S union {A[n]}
%p A113553 od:
%p A113553 K; # _Robert Israel_, Jul 31 2026
%Y A113553 Cf. A113552.
%K A113553 nonn
%O A113553 1,2
%A A113553 _Amarnath Murthy_, Nov 03 2005
%E A113553 Edited by _Antti Karttunen_, May 26 2018
