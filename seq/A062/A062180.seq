%S A062180 2,22,136,144,163,222,316,361,414,441,613,631,1236,1244,1263,1326,
%T A062180 1333,1362,1424,1442,1623,1632,2136,2144,2163,2222,2316,2361,2414,
%U A062180 2441,2613,2631,3126,3133,3162,3216,3261,3313,3331,3612,3621,4124,4142,4214,4241,4412
%N A062180 Harmonic mean of digits is 2.
%H A062180 Pontus von Brömssen, <a href="/A062180/b062180.txt">Table of n, a(n) for n = 1..10000</a>
%t A062180 Do[ h = IntegerDigits[n]; If[ Sort[h][[1]] != 0 && Length[h]/Apply[Plus, 1/h] == 2, Print[n]], {n, 1, 10^4}]
%o A062180 (Python)
%o A062180 from fractions import Fraction
%o A062180 def ok(k):
%o A062180     digits = list(map(int, str(k)))
%o A062180     return 0 not in digits and Fraction(len(digits), sum(Fraction(1, di) for di in digits)) == 2
%o A062180 print([k for k in range(5000) if ok(k)]) # _Michael S. Branicky_, Oct 16 2026
