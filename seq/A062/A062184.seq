%I A062184 #13 Jul 31 2026 19:57:54
%S A062184 6,66,488,666,848,884,3999,4688,4868,4886,6488,6666,6848,6884,8468,
%T A062184 8486,8648,8684,8846,8864,9399,9939,9993,36999,38888,39699,39969,
%U A062184 39996,44999,46688,46868,46886,48668,48686,48866,49499,49949,49994,63999
%N A062184 Harmonic mean of digits is 6.
%H A062184 Harvey P. Dale, <a href="/A062184/b062184.txt">Table of n, a(n) for n = 1..100</a>
%t A062184 Do[ h = IntegerDigits[n]; If[ Sort[h][[1]] != 0 && Length[h]/Apply[Plus, 1/h] == 6, Print[n]], {n, 1, 10^6}]
%t A062184 (* Alternative: *)
%t A062184 Select[Range[64000],HarmonicMean[IntegerDigits[#]]==6&] (* _Harvey P. Dale_, Jul 31 2026 *)
%Y A062184 Cf. A062179-A062185, A061383-A061388, A061423-A061425.
