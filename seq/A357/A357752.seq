%I A357752 #11 Oct 31 2026 12:48:57
%S A357752 4,9,27,49,125,243,484,1000,2025,3969,8100,16129,32761,65025,131044,
%T A357752 261121,524176,1046529,2096704,4190209,8386816,16769025,33547264,
%U A357752 67092481,134212225,268402689,536848900,1073676289,2147395600,4294836225,8589767761,17179607041,34359441769
%N A357752 a(n) is the largest perfect power < 2^n.
%C A357752 Are all terms > 1000 identical to A357754?
%H A357752 Robert Israel, <a href="/A357752/b357752.txt">Table of n, a(n) for n = 3..3305</a>
%p A357752 f:= proc(n) local t,p,x,v,w;
%p A357752       t:= 2^n;
%p A357752       p:= 1; x:= 0:
%p A357752       do
%p A357752         p:= nextprime(p);
%p A357752         if p >= n then return x fi;
%p A357752         v:= floor(t^(1/p)); w:= v^p;
%p A357752         if w = t then w:= (v-1)^p fi;
%p A357752         if w > x then x:= w fi
%p A357752       od;
%p A357752 end proc:
%p A357752 map(f, [$3..40]); # _Robert Israel_, Oct 30 2026
%o A357752 (PARI) for (n=3, 35, forstep (k=2^n-1, 0, -1, if(ispower(k), print1(k,", "); break)))
%Y A357752 Cf. A000079, A001597, A357751, A357754.
%K A357752 nonn,changed
%O A357752 3,1
%A A357752 _Hugo Pfoertner_, Oct 12 2022
