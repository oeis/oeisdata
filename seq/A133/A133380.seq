%N A133380 A054450 + A030111 - A000012 as infinite lower triangular matrices.
%e A133380 First few rows of the triangle are:
%e A133380   1;
%e A133380   1, 1;
%e A133380   3, 1, 1;
%e A133380   4, 5, 1, 1;
%e A133380   7, 6, 7, 1, 1;
%e A133380   10, 13, 8, 9, 1, 1;
%e A133380   16, 17, 21, 10, 11, 1, 1;
%e A133380   24, 30, 26, 31, 12, 13, 1, 1;
%e A133380   38, 42, 52, 37, 43, 14, 15, 1, 1;
%e A133380   ...
%o A133380 (PARI) T(n, k) = sum(j=k-1, n-1, if((n-1+j)%2, 0, binomial((n-1+j)/2, j))) + binomial((n+k)\2, k) - 1; \\ 1 <= k <= n
%o A133380 for(n=1, 10, for(k=1, n, print1(T(n, k), ", "))) \\ _Alper Ferudun_, Oct 17 2026
%Y A133380 Cf. A054450, A030111.
%Y A133380 Row sums give A134508.
