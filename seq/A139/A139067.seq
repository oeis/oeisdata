%S A139067 2,3,23,223,233,2333,23333,2222333,22222223,223333333,22222222223,
%T A139067 22222223333,22222333333,22223333333,23333333333,222223333333,
%U A139067 23333333333333333,2222222222222233333,2222222222333333333,2222222233333333333,2222222222222222222333,23333333333333333333333
%N A139067 Primes whose decimal expansion consists of a string of 2's followed by a string of 3's.
%H A139067 Robert Israel, <a href="/A139067/b139067.txt">Table of n, a(n) for n = 1..896</a>
%p A139067 R:= NULL: count:= 0:
%p A139067 for n from 1 while count < 20 do
%p A139067   for i from 0 to n do
%p A139067     v:= 2/9 * (10^n-1) + 1/9*(10^i-1);
%p A139067     if isprime(v) then R:= R,v; count:= count+1 fi;
%p A139067 od od:
%p A139067 R; # _Robert Israel_, Nov 02 2026
%t A139067 With[{nn=20},Sort[Select[Flatten[Table[FromDigits[Join[Table[2,{i}],Table[3,{j}]]],{i,0,nn},{j,0,nn}]],PrimeQ]]] (* _Harvey P. Dale_, Jan 30 2013 *)
