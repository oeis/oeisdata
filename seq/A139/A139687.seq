%S A139687 1,1,1,1,2,2,1,3,5,5,1,3,6,9,9,1,4,10,19,28,28,1,4,10,20,34,48,48,1,5,
%T A139687 15,35,69,117,165,165,1,5,15,35,70,125,200,275,275,1,6,21,56,126,251,
%U A139687 451,726,1001,1001,1,6,21,56,126,252,461,780,1209,1638,1638
%N A139687 Triangle T(n,k) read by rows: number of nonnegative lattice paths starting at height floor(n/2), with ceiling(n/2) up-steps and k down-steps.
%C A139687 The triangle shares its first three nontrivial rows with the Catalan triangle A009766 and the corresponding rows of A140344, but differs thereafter. - _Meghanto Majumder_, Oct 14 2026
%F A139687 From _Meghanto Majumder_, Oct 14 2026: (Start)
%F A139687 T(n,k) = binomial(ceiling(n/2)+k,k) - binomial(ceiling(n/2)+k,n+1), 0 <= k <= n.
%F A139687 T(2*m+1,k) = Sum_{j=0..min(k,2*m)} T(2*m,j).
%F A139687 T(n,n) = T(n,n-1) for n >= 1.
%F A139687 T(2*m,k) = [x^k] 1/((1-x)^(m+1) + x^(m+1)). (End)
%e A139687 Triangle begins:
%e A139687   1;
%e A139687   1, 1;
%e A139687   1, 2, 2;
%e A139687   1, 3, 5, 5;
%e A139687   1, 3, 6, 9, 9;
%e A139687   1, 4, 10, 19, 28, 28;
%e A139687   1, 4, 10, 20, 34, 48, 48;
%e A139687   1, 5, 15, 35, 69, 117, 165, 165;
%e A139687   1, 5, 15, 35, 70, 125, 200, 275, 275;
%e A139687   ...
%e A139687 For example, T(6,5) = binomial(8,5) - binomial(8,7) = 56 - 8 = 48. (End)
%o A139687 (PARI)
%o A139687 a(n)={my(r=(sqrtint(8*n+1)-1)\2,k=n-r*(r+1)\2);binomial((r+1)\2+k,k)-binomial((r+1)\2+k,r+1)} \\ _Meghanto Majumder_, Oct 14 2026
%Y A139687 Cf. A009766, A057083, A099087, A135356, A138112, A140343, A140344.
