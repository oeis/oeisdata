%U A071829 7,19,29,59,15,61,31,7,64,13,11,67,17,23,14,71,9,73,37,5,19,11,13,79
%N A071829 Smallest s > 0 such that gpf(n) = gpf(n+s) where gpf = A006530 (greatest prime factor).
%t A071829 ss[n_]:=Module[{s=1,f=FactorInteger[n][[-1,1]]},While[f!=FactorInteger[ s+n][[-1,1]], s++];s]; Array[ss,80,2] (* _Harvey P. Dale_, Aug 18 2015 *)
%o A071829 (PARI) a(n) = my(m=vecmax(factor(n)[,1]), s=1); while(m != vecmax(factor(n+s)[,1]),s++); s
%Y A071829 Cf. A006530.
%K A071829 easy,nonn,changed
