%S A115333 0,0,2,0,5,0,10,0,2,3,17,0,28,8,2,0,41,0,58,3,7,15,77,0,5,26,2,8,100,
%T A115333 0,129,0,14,39,5,0,160,56,25,3,197,5,238,15,2,75,281,0,10,3,38,26,328,
%U A115333 0,12,8,55,98,381,0,440,127,7,0,23,12,501,39,74,3,568,0,639,158,2,56,10
%N A115333 Sum of primes that do not divide n and are less than the largest prime dividing n.
%C A115333 When n is prime, n = largest prime dividing n; hence a(n) is the sum of all primes less than n = A034387(n)-n. a(n) = SUM{p such that p is in A000040 AND NOT(p|n) AND p < A006530(n)}. - _Jonathan Vos Post_, Mar 08 2006
%C A115333 The indices of zeros are in A055932: All prime divisors are consecutive primes starting at 2. - _Robert G. Wilson v_, May 01 2006
%C A115333 Fixed points of a(n) = n correspond to m*p + A008472(m) = A034387(p-1) for p = prime. The only known fixed points, found by a search over primes p < 3*10^7, are 5, 26, 4220. - _Nishant R. Gautam_, Oct 01 2026
%F A115333 a(n) = Sigma(A006530(n)) - Sum_{q|n, q<A006530(n), q prime} q, where Sigma(p) = A034387(p-1). - _Nishant R. Gautam_, Oct 01 2026
%e A115333 The primes < 7 and coprime to 7 are 2, 3 and 5. So a(7) = 2+3+5 = 10.
%p A115333 A115333 := proc(n)
%p A115333     gpf := A006530(n) ;
%p A115333     a :=0 ;
%p A115333     for i from 1 do
%p A115333         p := ithprime(i) ;
%p A115333         if p >= gpf then
%p A115333             return a;
%p A115333         elif modp(n,p) > 0 then
%p A115333             a := a+p ;
%p A115333         end if;
%p A115333     end do:
%p A115333 end proc:
%p A115333 seq(A115333(n),n=1..40) ; # _R. J. Mathar_, Oct 08 2026
%t A115333 f[n_] := Plus @@ Complement[Prime@ Range@ PrimePi[ Max[First /@ FactorInteger@n] - 1], First /@ FactorInteger@n]; Array[f, 77] (* _Hans Havermann_, Mar 06 2006 *)
%o A115333 (Python)
%o A115333 from sympy import primerange, primefactors
%o A115333 def a(n):
%o A115333     if n == 1: return 0
%o A115333     m = n; P = None; d = 2
%o A115333     while d*d <= m:
%o A115333         while m % d == 0:
%o A115333             P = d; m //= d
%o A115333         d += 1
%o A115333     if m > 1: P = m
%o A115333     div = set(primefactors(n))
%o A115333     return sum(q for q in primerange(2, P) if q not in div) # _Nishant R. Gautam_, Oct 01 2026
%Y A115333 Cf. A000040, A006530, A034387, A066911, A083720.
%K A115333 nonn,changed
%O A115333 1,3
%A A115333 _Leroy Quet_, Mar 05 2006
%E A115333 More terms from _Hans Havermann_, Mar 06 2006
