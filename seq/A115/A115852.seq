%U A115852 11145769206784,76394251284780,523613954825156,3588903524021764,24598710473697360,168602070419218800
%N A115852 a(n) = ceiling((F(n)^4-1)^2 / (4*F(n)^4)) where F(n) = A000045(n) are the Fibonacci numbers.
%t A115852 F[0] = 0; F[1] = 1; F[n_] := F[n] = F[n - 1] + F[n - 2] g[x_] = (x^4 - 1)^2/(-4*x^4) a = Table[ -Floor[g[F[n]]], {n, 1, 25}] Table[N[a[[n + 1]]/a[[n]]], {n, 1, Length[a] - 1}]
