%U A020534 1180598376127589781504,151115943624696659976192,19342820031363781631164416,2475880299931694931871039488,316912657140607118659108798464
%N A020534 a(n) = 8th Fibonacci polynomial evaluated at 2^n.
%H A020534 Colin Barker, <a href="/A020534/b020534.txt">Table of n, a(n) for n = 0..474</a>
%H A020534 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (170,-5712,43520,-65536).
%F A020534 G.f.: -3*(75264*x^3-24592*x^2+1054*x-7) / ((2*x-1)*(8*x-1)*(32*x-1)*(128*x-1)). - _Colin Barker_, May 03 2015
%F A020534 From _Elmo R. Oliveira_, Oct 10 2026: (Start)
%F A020534 a(n) = 2^n * (2^(2*n) + 2) * (2^(4*n) + 4*2^(2*n) + 2).
%F A020534 a(n) = 170*a(n-1) - 5712*a(n-2) + 43520*a(n-3) - 65536*a(n-4).
%F A020534 E.g.f.: exp(2*x)*(4 + 10*exp(6*x) + 6*exp(30*x) + exp(126*x)). (End)
%p A020534 with(combinat,fibonacci):seq(fibonacci(8,2^i),i=0..24);
%t A020534 Table[Fibonacci[8,2^i],{i,0,30}] (* _Vladimir Joseph Stephan Orlovsky_, Nov 03 2009 *)
%t A020534 (* Alternative: *)
%t A020534 LinearRecurrence[{170,-5712,43520,-65536},{21,408,23184,2298912},20] (* _Harvey P. Dale_, Oct 18 2026 *)
%o A020534 (PARI) Vec(-3*(75264*x^3-24592*x^2+1054*x-7)/((2*x-1)*(8*x-1)*(32*x-1)*(128*x-1)) + O(x^100)) \\ _Colin Barker_, May 03 2015
