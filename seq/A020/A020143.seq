%S A020143 14,341,742,946,1477,1541,1687,1729,1891,1921,2821,3133,3277,4187,
%T A020143 6541,6601,7471,8701,8911,9073,10279,10649,12871,14041,14701,15409,
%U A020143 15841,16841,19201,20017,24521,25313,25546,28063,29341,30889,31021,38963,41041
%N A020143 Pseudoprimes to base 15.
%C A020143 Composite numbers k such that 15^(k-1) == 1 (mod k).
%H A020143 Amiram Eldar, <a href="/A020143/b020143.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from T. D. Noe)
%H A020143 <a href="/index/Ps#pseudoprimes">Index entries for sequences related to pseudoprimes</a>.
%t A020143 base = 15; t = {}; n = 1; While[Length[t] < 100, n++; If[! PrimeQ[n] && PowerMod[base, n-1, n] == 1, AppendTo[t, n]]]; t (* _T. D. Noe_, Feb 21 2012 *)
%o A020143 (PARI) isok(k) = k > 1 && Mod(15, k)^(k-1) == 1 && !isprime(k); \\ _Amiram Eldar_, Oct 31 2026
%Y A020143 Cf. A001567 (pseudoprimes to base 2).
%K A020143 nonn,changed
%O A020143 1,1
%A A020143 _David W. Wilson_
