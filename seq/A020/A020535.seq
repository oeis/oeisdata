%T A020535 72088384390201345,18448714462971691009,4722492584690006360065,
%U A020535 1208933890081654107537409,309485526330443015424835585,79228195570833939805878878209,20282411719271922303543388667905
%N A020535 a(n) = 9th Fibonacci polynomial evaluated at 2^n.
%H A020535 Colin Barker, <a href="/A020535/b020535.txt">Table of n, a(n) for n = 0..415</a>
%H A020535 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (341,-23188,371008,-1396736,1048576).
%F A020535 G.f.: -(4771840*x^4-4589056*x^3+550716*x^2-10609*x+34) / ((x-1)*(4*x-1)*(16*x-1)*(64*x-1)*(256*x-1)). - _Colin Barker_, May 03 2015
%F A020535 From _Elmo R. Oliveira_, Oct 09 2026: (Start)
%F A020535 a(n) = (2^(2*n) + 1) * (2^(6*n) + 6*2^(4*n) + 9*2^(2*n) + 1).
%F A020535 a(n) = 341*a(n-1) - 23188*a(n-2) + 371008*a(n-3) - 1396736*a(n-4) + 1048576*a(n-5).
%F A020535 E.g.f.: exp(x)*(1 + 10*exp(3*x) + 15*exp(15*x) + 7*exp(63*x) + exp(255*x)). (End)
%p A020535 with(combinat,fibonacci):seq(fibonacci(9,2^i),i=0..24);
%t A020535 Table[Fibonacci[9,2^i],{i,0,30}] (* _Vladimir Joseph Stephan Orlovsky_, Nov 03 2009 *)
%o A020535 (PARI) Vec(-(4771840*x^4-4589056*x^3+550716*x^2-10609*x+34) / ((x-1)*(4*x-1)*(16*x-1)*(64*x-1)*(256*x-1)) + O(x^100)) \\ _Colin Barker_, May 03 2015
