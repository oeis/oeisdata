%T A138310 22,33,24,37,26,39,28,35,32,41,30,43,34,47,36,53,38,45,49,51,40,55,57,
%U A138310 59,44,61,42,65,46,67,50,63,48,71,52,69,73,77,54,79,56,75,58,81,60,83
%N A138310 a(1)=1. a(n) = smallest positive integer not occurring among the first n-1 terms of the sequence that is coprime to n and is coprime to every (nonzero) exponent in the prime factorization of n.
%H A138310 Amiram Eldar, <a href="/A138310/b138310.txt">Table of n, a(n) for n = 1..10000</a>
%e A138310 12 has the prime factorization 2^2 * 3^1. The positive integers that do not occur among the first 11 terms of the sequence are 10,12,14,15,16,17,18,19,... Of these integers, 17 is the smallest that is coprime to the exponents in the prime factorization of 12 (i.e., coprime to 2 and 1) and is coprime to 12. So, a(12) = 17.
%t A138310 a[n_] := a[n] = Module[{s = Array[a, n-1], k = 1}, While[!FreeQ[s, k] || !CoprimeQ[n, k] || !AllTrue[FactorInteger[n][[;;, 2]], CoprimeQ[#, k] &], k++]; k]; Array[a, 100] (* _Amiram Eldar_, Sep 27 2026 *)
