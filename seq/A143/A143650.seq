%N A143650 Lesser of pairs of numbers k <= m such that uphi(k) = uphi(m) = 3*(k*m)^(1/2)/4, where uphi = A047994.
%t A143650 uphi[n_] := Times @@ (Power @@@ FactorInteger[n] - 1); uphi[1] = 1;
%t A143650 seq[kmax_] := Module[{s = {}, u, m}, Do[u = uphi[k]; m = (4*u/3)^2/k; If[IntegerQ[m] && m >= k && uphi[m] == u, AppendTo[s, k]], {k, 1, kmax}]; s]; seq[2500000] (* _Amiram Eldar_, Oct 10 2026 *)
%o A143650 (PARI) uphi(n) = {my(f = factor(n)); prod(i = 1, #f~, f[i, 1]^f[i, 2]-1);}
%o A143650 list(kmax) = {my(u, m); for(k = 1, kmax, u = uphi(k); m = (4*u/3)^2/k; if(denominator(m) == 1 && m >= k && uphi(m) == u, print1(k, ", ")));} \\ _Amiram Eldar_, Oct 10 2026
%Y A143650 Cf. A047994, A143649 (values of m).
