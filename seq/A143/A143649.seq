%I A143649 #21 Oct 10 2026 07:08:35
%S A143649 4,56,80,4032,4960,21760,157248,1024128,2354688,5575680,39940992,
%T A143649 78566400,91832832,729999360,754790400,1431633920,2536314880,
%U A143649 3064089600,4579061760
%N A143649 Greater of pairs of numbers k <= m such that uphi(k) = uphi(m) = 3*(k*m)^(1/2)/4, where uphi = A047994.
%C A143649 a(10) and a(14) are examples where k != m. [corrected by _Amiram Eldar_, Oct 10 2026]
%t A143649 uphi[n_] := Times @@ (Power @@@ FactorInteger[n] - 1); uphi[1] = 1;
%t A143649 seq[kmax_] := Module[{s = {}, u, m}, Do[u = uphi[k]; m = (4*u/3)^2/k; If[IntegerQ[m] && m >= k && uphi[m] == u, AppendTo[s, m]], {k, 1, kmax}]; s]; seq[2500000] (* _Amiram Eldar_, Oct 10 2026 *)
%o A143649 (PARI) uphi(n) = {my(f = factor(n)); prod(i = 1, #f~, f[i, 1]^f[i, 2]-1);}
%o A143649 list(kmax) = {my(u, m); for(k = 1, kmax, u = uphi(k); m = (4*u/3)^2/k; if(denominator(m) == 1 && m >= k && uphi(m) == u, print1(m, ", ")));} \\ _Amiram Eldar_, Oct 10 2026
%Y A143649 Cf. A047994, A143650 (values of k).
%K A143649 nonn,more,changed
%O A143649 1,1
%A A143649 _Yasutoshi Kohmoto_, Nov 04 2008
%E A143649 The pair (k,m) = (4805,5445) was removed by _R. J. Mathar_, Sep 04 2018
%E A143649 Data sorted, missing terms inserted, and more terms added by _Amiram Eldar_, Oct 10 2026
