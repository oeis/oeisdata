%N A143374 G.f.: eta(q)*eta(q^3)*eta(q^9)*eta(q^27)*eta(q^81)*eta(q^243)*..., where eta(q) = Product((1-q^m), m=1..oo).
%C A143374 eta(q) = A(q)/A(q^3), where A(q) is the g.f. for this sequence (cf. A010815).
%H A143374 Seiichi Manyama, <a href="/A143374/b143374.txt">Table of n, a(n) for n = 0..10000</a>
%F A143374 G.f.: A(q) = Product_{n >= 1} (1 - q^n)^(v_3(3*n)), where v_3(n) denotes the 3-adic valuation of n. - _Peter Bala_, Sep 29 2026
%p A143374 with(padic):
%p A143374 seq(coeftayl(series(mul((1 - x^k)^ordp(3*k,3), k = 1..100), x, 101), x = 0, n), n = 0..100); # _Peter Bala_, Sep 29 2026
