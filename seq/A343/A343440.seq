%S A343440 1,1,3,7,15,27,63,127,255,495,1023,2037,4095,8127,16365,32767,65535,
%T A343440 130815,262143,524265,1048509,2096127,4194303,8388477,16777215,
%U A343440 33550335,67108863,134217657,268435455,536854005,1073741823,2147483647,4294966269,8589869055,17179869105
%N A343440 a(n) = Sum_{d|n, gcd(d, n/d) = 1} (-1)^omega(n/d) * 2^(d-1).
%H A343440 Robert Israel, <a href="/A343440/b343440.txt">Table of n, a(n) for n = 1..3306</a>
%F A343440 a(n) = 2^(n-1) - Sum_{d|n, gcd(d, n/d) = 1, d < n} a(d).
%p A343440 f:= proc(n) local S,d; uses NumberTheory;
%p A343440   S:= select(d -> igcd(d,n/d)=1, Divisors(n));
%p A343440   add((-1)^Omega(n/d,distinct) * 2^(d-1), d = S)
%p A343440 end proc:
%p A343440 map(f, [$1..100]); # _Robert Israel_, Aug 24 2026
%t A343440 a[n_] := Sum[If[GCD[d, n/d] == 1, (-1)^PrimeNu[n/d] 2^(d - 1), 0], {d, Divisors[n]}]; Table[a[n], {n, 35}]
%o A343440 (PARI) a(n) = sumdiv(n, d, if (gcd(d, n/d)==1, (-1)^omega(n/d) * 2^(d-1))); \\ _Michel Marcus_, Apr 15 2021
