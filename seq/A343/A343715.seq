%I A343715 #15 Nov 18 2026 10:39:37
%S A343715 353,373,727,757,11311,13331,31013,31513,33533,37273,37573,39293,
%T A343715 71317,71917,73237,77977,79397,97379,97579,1175711,1178711,1317131,
%U A343715 1335331,1338331,1513151,1572751,1737371,1793971,1917191,1993991,1995991,3103013,3106013,3127213
%N A343715 Palindromic primes of the form p//q//reverse(p), where p, q, and reverse(p) are primes.
%C A343715 If reverse(p) were allowed to be nonprime, the result would be sequence A343714, which includes such terms as 19391.
%H A343715 Robert Israel, <a href="/A343715/b343715.txt">Table of n, a(n) for n = 1..10000</a>
%e A343715 353 is a term because it is a palindromic prime (A002385) and is the concatenation of 3 (a prime), 5 (a palindromic prime), and 3 (the reverse of 3, and also a prime).
%e A343715 31513 is a term in two ways: as the concatenation 3//151//3 and as the concatenation 31//5//13.
%e A343715 7392937 is a term in three ways: 7//39293//7, 73//929//37, and 739//2//937.
%p A343715 rev:= proc(n) local L, i;
%p A343715   L:= convert(n, base, 10);
%p A343715   add(L[-i]*10^(i-1), i=1..nops(L))
%p A343715 end proc:
%p A343715 pprimes:= proc(m)
%p A343715   local i, j, k, d;
%p A343715   d:= (m-1)/2;
%p A343715   select(t -> isprime(t) and isprime(rev(t)), {seq(seq(seq(j*10^(d+1)+k*10^d+rev(j), k=0..9), j=i*10^(d-1) .. (i+1)*10^(d-1)-1), i=[1, 3, 7, 9])})
%p A343715 end proc:
%p A343715 PP[1]:= {2, 3, 5, 7}:
%p A343715 for m from 3 to 5 by 2 do PP[m]:= pprimes(m) od:
%p A343715 P[1]:= {3, 5, 7}:
%p A343715 for d from 2 to 3 do P[d]:= select(isprime, {seq(i, i=10^(d-1)+1 .. 10^d-1, 2)}) od:
%p A343715 S:= {};
%p A343715 for d from 3 to 7 by 2 do
%p A343715   for d1 from 1 to (d-1)/2 do
%p A343715     S:= S union select(isprime, {seq(seq(p*10^(d-d1)+q*10^d1+rev(p), p = P[d1]), q=PP[d-2*d1])})
%p A343715 od: od;
%p A343715 sort(convert(S, list)); # _Robert Israel_, Nov 17 2026
%Y A343715 Cf. A002385, A045336, A177678, A343714.
%K A343715 nonn,base,changed
%O A343715 1,1
