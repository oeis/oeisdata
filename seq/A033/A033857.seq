%I A033857 #18 Aug 27 2026 11:02:39
%S A033857 35,44,56,105,198,418,1254
%N A033857 Numbers k such that j(k)*phi(k) = usigma(k), where j(k) = A033831(k), and usigma(k) = sum of unitary divisors of k (A034448).
%C A033857 If it exists, a(8) > 10^9. - _Sean A. Irvine_, Jul 20 2020
%t A033857 f[p_, e_] := (p^e + 1)/(p - 1)/p^(e - 1); q[k_] := Module[{fct = FactorInteger[k]}, Times @@ f @@@ fct == Floor[(Times @@ (fct[[;; , 2]] + 1))/2] - Boole[IntegerQ[Sqrt[4*k + 1]]]]; q[1] = False; Select[Range[1300], q] (* _Amiram Eldar_, Aug 27 2026 *)
%Y A033857 Cf. A000010 (phi), A034448 (usigma), A033831.
%K A033857 nonn,more,changed
%O A033857 1,1
%A A033857 _Naohiro Nomoto_
