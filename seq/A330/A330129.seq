%I A330129 #43 Oct 07 2026 22:17:59
%S A330129 99999945,9999999999999918,36,9999945,999945,9999999999999999936,936,
%T A330129 9999999999972,999999936,999936,999936,99999945,999954,999918,72,
%U A330129 99999918,999999999927,18,999981,999999999999999963,99981,999999999999999963,999936,9999999999999918,9963
%N A330129 a(n) is the last term of the analogous sequence to A121805, but with initial term n, or -1 if that sequence is infinite.
%C A330129 The numbers of terms of the corresponding sequences are in A330128.
%H A330129 Michael S. Branicky, <a href="/A330129/b330129.txt">Table of n, a(n) for n = 1..10000</a>
%H A330129 Eric Angelini, Michael S. Branicky, Giovanni Resta, N. J. A. Sloane, and David W. Wilson, The Comma Sequence: A Simple Sequence With Bizarre Properties, <a href="https://arxiv.org/abs/2401.14346">arXiv:2401.14346</a>, <a href="https://www.youtube.com/watch?v=_EHAdf6izPI">Youtube</a>.
%H A330129 Brady Haran, Pete McPartlan, and N. J. A. Sloane, <a href="https://www.youtube.com/watch?v=A020pGO5MBs">The Immortal Kangaroo Sequence</a>, Numberphile video (2026).
%o A330129 (Python)
%o A330129 def nxt(x):
%o A330129     x, y = x + 10*(x%10), 1
%o A330129     while y < 10:
%o A330129         if str(x+y)[0] == str(y):
%o A330129             return x+y
%o A330129         y += 1
%o A330129     return None
%o A330129 def a(n):
%o A330129     T, k = 1, n
%o A330129     while True:
%o A330129         kprime = nxt(k)
%o A330129         if kprime == None:
%o A330129             return k
%o A330129         k = kprime
%o A330129         T += 1
%o A330129         if k > 999:
%o A330129             ks = str(k)
%o A330129             f, s, w, x = int(ks[0]), int(ks[1:-2]), int(ks[-2]), int(ks[-1])
%o A330129             i = len(ks) - 3
%o A330129             M = (f+1)*(10**(i+2)-100)                          # (6.1)
%o A330129             D = (10*f + 10*sum((x+j*f)%10 for j in range(10))) # (6.3) corrected
%o A330129             m = (M-k)//D                                       # (6.4) subject to (6.1)
%o A330129             if m > 0:                                          # jump ahead using (6.4)
%o A330129                 k += m*D
%o A330129                 T += m*10
%o A330129 print([a(n) for n in range(1, 30)]) # _Michael S. Branicky_, Oct 04 2026 using Angelini et al., Sec. 6
%Y A330129 Cf. A330128, A121805, A139284, A366492.
%K A330129 nonn,base,nice,changed
%O A330129 1,1
