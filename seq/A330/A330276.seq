%I A330276 #23 Aug 05 2026 09:47:08
%S A330276 169,385,961,1105,1121,3827,4901,6265,6441,6601,7107,7801,8119,10945,
%T A330276 11285,13067,15841,18241,19097,20833,24727,27971,29953,31417,34561,
%U A330276 35459,37345,37505,38081,39059,42127,45451,45961,47321,49105,52633,53041,55969,56953,58241
%N A330276 NSW pseudoprimes: odd composite numbers k such that A002315((k-1)/2) == 1 (mod k).
%C A330276 If p is an odd prime, then A002315((p-1)/2) == 1 (mod p). This sequence consists of the odd composite numbers for which this congruence holds.
%C A330276 Equivalently, odd composite numbers k such that A001652((k-1)/2) is divisible by k.
%C A330276 From _Amiram Eldar_, Jan 23 2026: (Start)
%C A330276 Also, odd composite numbers k such that k | A002203(k)-2. A002203 is the sequence of Companion Pell numbers, that are also known as "Pell-Lucas numbers".
%C A330276 These numbers are called "Pell-Lucas pseudoprimes" by Andrica and Bagdasar (2020, 2021, 2022).
%C A330276 They conjectured that this sequence is infinite, and their conjecture was proved by Grantham (2021). (End)
%H A330276 Chai Wah Wu, <a href="/A330276/b330276.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from Amiram Eldar)
%H A330276 Dorin Andrica and Ovidiu Bagdasar, <a href="https://doi.org/10.1007/978-3-030-51502-7_3">Arithmetic and Trigonometric Properties of Some Classical Recurrent Sequences</a>, in: Recurrent Sequences: Key Results, Applications, and Problems, Springer, Cham, 2020. See Chapter 3, Remark 3.6, p. 94.
%H A330276 Dorin Andrica and Ovidiu Bagdasar, <a href="https://doi.org/10.1007/s00009-020-01653-w">On some new arithmetic properties of the generalized Lucas sequences</a>, Mediterranean Journal of Mathematics, Vol. 18, No. 2 (2021), pp. 47. See Definition 5.1, p. 47.
%H A330276 Dorin Andrica and Ovidiu Bagdasar, <a href="https://doi.org/10.1016/j.matcom.2021.03.003">Pseudoprimality related to the generalized Lucas sequences</a>, Mathematics and Computers in Simulation, Vol. 201 (2022), pp. 528-542; <a href="https://derby-repository.worktribe.com/output/791839/pseudoprimality-related-to-the-generalized-lucas-sequences">alternative link</a>. See Remark 3.3.
%H A330276 Dorin Andrica, Ovidiu Bagdasar, and Michael Th. Rassias, <a href="https://doi.org/10.1007/978-3-030-84122-5_4">Weak Pseudoprimality Associated with the Generalized Lucas Sequences</a>, in: N. J. Daras and T. M. Rassias (eds.), Approximation and Computation in Science and Engineering, Springer Optimization and Its Applications, Vol. 180, Springer, Cham, 2022, pp. 53-75. See Section 2.3, p. 59.
%H A330276 Jon Grantham, <a href="https://math.colgate.edu/~integers/v111/v111.mail.html">Proof of Two Conjectures of Andrica and Bagdasar</a>, Integers, Vol. 21 (2021), Article #A111.
%H A330276 Morris Newman, Daniel Shanks, and H. C. Williams, <a href="https://eudml.org/doc/205728">Simple groups of square order and an interesting sequence of primes</a>, Acta Arithmetica, Vol. 38, No. 2 (1980), pp. 129-140.
%H A330276 Wikipedia, <a href="https://en.wikipedia.org/wiki/Silver_ratio#Pell_sequences">Silver ratio: Pell sequences</a>. (Mentions this sequence).
%e A330276 169 = 13^2 is a term since it is composite and A002315((169-1)/2) - 1 = A002315(84) - 1 is divisible by 169.
%t A330276 a0 = 1; a1 = 7; k = 5; seq = {}; Do[a = 6 a1 - a0; a0 = a1; a1 = a; If[CompositeQ[k] && Divisible[a - 1, k], AppendTo[seq, k]]; k += 2, {n, 2, 10^4}]; seq
%o A330276 (Python)
%o A330276 from itertools import islice
%o A330276 from sympy import nextprime
%o A330276 def A330276_gen(): # generator of terms
%o A330276     def A002315_mod(n,m): # n-th NSW number mod m
%o A330276         a, b, c, d, a2, b2, c2, d2 = 6, -1, 1, 0, 1, 0, 0, 1
%o A330276         for x in bin(n)[2:]:
%o A330276             e, f = b2*c2%m, k if (k:=a2+d2)<m else k-m
%o A330276             a2, b2, c2, d2 = (a2*a2+e)%m, b2*f%m, c2*f%m, (d2*d2+e)%m
%o A330276             if x=='1':
%o A330276                 a2, b2, c2, d2 = (a2*a+b2*c)%m, (a2*b+b2*d)%m, (c2*a+d2*c)%m, (c2*b+d2*d)%m
%o A330276         return (7*c2+d2)%m
%o A330276     a, b = 7, 11
%o A330276     while True:
%o A330276         for k in range(a+2,b,2):
%o A330276             if A002315_mod(k-1>>1,k)==1:
%o A330276                 yield k
%o A330276         a, b = b, nextprime(b)
%o A330276 A330276_list = list(islice(A330276_gen(),30)) # _Chai Wah Wu_, Aug 04 2026
%Y A330276 A327652 is a subsequence.
%Y A330276 Cf. A001652, A002203, A002315.
