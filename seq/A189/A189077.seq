%S A189077 1,1,2,4,8,16,31,60,115,218,411,770,1434,2656,4897,8991,16444,29966,
%T A189077 54437,98602,178127,321007,577210,1035784,1855223,3317245,5922101,
%U A189077 10557065,18794491,33418118,59352422,105302007,186642465,330514315,584795704,1033897541,1826558301,3224730620,5689532882
%N A189077 Number of compositions of n that avoid the pattern 13-2.
%H A189077 Pragyaan Gaur, <a href="/A189077/b189077.txt">Table of n, a(n) for n = 0..70</a>
%H A189077 Pragyaan Gaur, <a href="https://github.com/pragyaangaur/Compositions-Avoiding-13-2">Compositions Avoiding 13-2</a>.
%H A189077 S. Heubach, T. Mansour and A. O. Munagi, <a href="https://doi.org/10.61091/ojac-403">Avoiding Permutation Patterns of Type (2,1) in Compositions</a>, Online Journal of Analytic Combinatorics, 4 (2009).
%o A189077 (Python)
%o A189077 from functools import lru_cache
%o A189077 START = -1
%o A189077 def range_mask(lo, hi):
%o A189077     if hi <= lo + 1:
%o A189077         return 0
%o A189077     return ((1 << hi) - 1) & ~((1 << (lo + 1)) - 1)
%o A189077 def low_bits(r):
%o A189077     return (1 << (r + 1)) - 1
%o A189077 @lru_cache(maxsize=None)
%o A189077 def solve(R, L, mask):
%o A189077     if R == 0:
%o A189077         return 1
%o A189077     total = 0
%o A189077     for v in range(1, R + 1):
%o A189077         if (mask >> v) & 1:
%o A189077             continue
%o A189077         m = mask
%o A189077         if L != START and L < v:
%o A189077             m |= range_mask(L, v)
%o A189077         m &= low_bits(R - v)
%o A189077         total += solve(R - v, v, m)
%o A189077     return total
%o A189077 def a(n):
%o A189077     return 1 if n == 0 else solve(n, START, 0)
%o A189077 # _Pragyaan Gaur_, Sep 19 2026
