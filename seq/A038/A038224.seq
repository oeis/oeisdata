%e A038224   ...
%p A038224 A038224 := proc(n,k)
%p A038224         if k < 0 or k > n then
%p A038224                 0;
%p A038224         else
%p A038224                 binomial(n,k)*3^(n-k)*6^k ;
%p A038224         end if;
%p A038224 end proc: # _R. J. Mathar_, Mar 26 2013
