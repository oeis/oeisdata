%N A038210 Triangle whose (i,j)-th entry is binomial(i,j)*2^(i-j)*4^j.
%H A038210 B. N. Cyvin, J. Brunvoll, and S. J. Cyvin, <a href="https://match.pmf.kg.ac.rs/electronic_versions/Match34/match34_109-121.pdf">Isomer enumeration of unbranched catacondensed polygonal systems with pentagons and heptagons</a>, Match, No. 34 (Oct 1996), 109-121.
%F A038210 T(n,k) = 4*T(n-1,k-1) + 2*T(n-1,k) with T(0,0)=1, T(n,k)=0 for k<0 or k>n. - _Ranjan Kumar Dhani_, Oct 01 2026
%e A038210 The triangle begins as:
%e A038210     1;
%e A038210     2,    4;
%e A038210     4,   16,    16;
%e A038210     8,   48,    96,    64;
%e A038210    16,  128,   384,   512,   256;
%e A038210    32,  320,  1280,  2560,  2560,  1024;
%e A038210    64,  768,  3840, 10240, 15360, 12288,  4096;
%e A038210   128, 1792, 10752, 35840, 71680, 86016, 57344, 16384;
%e A038210   ...
%t A038210 Flatten[Table[Binomial[i,j]2^(i-j) 4^j,{i,0,8},{j,0,i}]] (* _Harvey P. Dale_, Nov 22 2011 *)
