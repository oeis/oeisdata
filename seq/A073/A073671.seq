%I A073671 #10 Sep 17 2026 22:21:40
%S A073671 1,3,7,9,13,15,19,25,17,5,21,11,27,23,29,31,37,33,39,35,53,43,41,47,
%T A073671 49,55,45,51,61,67,63,69,59,65,57,71,83,73,77,79,85,75,81,95,87,89,93,
%U A073671 99,91,103,113,97,101,109,107,115,125,119,105,123,121,129,117,127,135,111
%N A073671 Rearrangement of odd numbers such that sum of any three consecutive terms is prime.
%H A073671 Robert Israel, <a href="/A073671/b073671.txt">Table of n, a(n) for n = 1..10000</a>
%p A073671 N:= 200: # for terms before the first term > N
%p A073671 R:= 1,3: r:= 1,3; s:= 4:
%p A073671 Cands:= [seq(i,i=5..N,2)]: nC:= nops(Cands):
%p A073671 found:= true:
%p A073671 while found do
%p A073671   found:= false;
%p A073671   for i from 1 to nC do
%p A073671     v:= s + Cands[i];
%p A073671     if isprime(v) then
%p A073671       found:= true;
%p A073671       R:= R,Cands[i];
%p A073671       s:= r[2] + Cands[i];
%p A073671       r:= r[2],Cands[i];
%p A073671       Cands:= subsop(i=NULL,Cands);
%p A073671       nC:= nC-1;
%p A073671       break;
%p A073671 fi od od:
%p A073671 R; # _Robert Israel_, Sep 17 2026
%K A073671 nonn,changed
%O A073671 1,2
%A A073671 _Amarnath Murthy_, Aug 11 2002
%E A073671 More terms from _Sascha Kurz_, Feb 01 2003
