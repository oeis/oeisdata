%N A073752 Greatest common divisor of n/lpf(n) and n/gpf(n) where lpf(n) is the least and gpf(n) is the greatest prime factor of n (see A020639, A006530).
%C A073752 a(n) = if n=p^k (p prime, k>0) then p^(k-1) else n/(lpf(n)*gpf(n)).
%H A073752 Harvey P. Dale, <a href="/A073752/b073752.txt">Table of n, a(n) for n = 1..1000</a>
%F A073752 a(n) = GCD(A032742(n), A052126(n)).
%F A073752 A073753(n) = a(a(n)).
%t A073752 gc[n_]:=Module[{fi=Transpose[FactorInteger[n]][[1]]},GCD[n/First[fi], n/Last[ fi]]]; Array[gc,110] (* _Harvey P. Dale_, Jun 17 2012 *)
%Y A073752 Cf. A000961, A006530, A020639, A032742, A052126, A066048, A073753.
%K A073752 nonn,changed
%O A073752 1,4
