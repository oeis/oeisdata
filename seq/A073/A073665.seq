%I A073665 #11 Sep 17 2026 22:21:46
%S A073665 2,8,14,32,20,26,62,38,50,56,80,68,110,86,140,98,74,122,104,128,152,
%T A073665 44,92,134,212,176,170,146,116,200,158,224,194,164,218,242,188,272,
%U A073665 284,308,254,314,278,290,230,248,182,206,302,296,260,326,332,350,236,320,266
%N A073665 Lexicographically first sequence of even positive numbers such that a(n) + a(n+1) + 1 and a(n)*a(n+1) + 1 are primes for all n.
%C A073665 All terms == 2 (mod 6). - _Robert Israel_, Sep 17 2026
%H A073665 Robert Israel, <a href="/A073665/b073665.txt">Table of n, a(n) for n = 1..10000</a>
%p A073665 N:= 500: # for terms before the first term > N
%p A073665 Cands:= [seq(i,i=8..N,6)]: nC:= nops(Cands):
%p A073665 R:= 2: r:= 2:
%p A073665 found:= true;
%p A073665 while found do
%p A073665   found:= false;
%p A073665   for i from 1 to nC do
%p A073665     if isprime(r + Cands[i] + 1) and isprime(r*Cands[i] + 1) then
%p A073665       r:= Cands[i];
%p A073665       R:= R,r;
%p A073665       Cands:= subsop(i=NULL, Cands); nC:= nC-1;
%p A073665       found:= true;
%p A073665       break
%p A073665     fi
%p A073665 od od:
%p A073665 R; # _Robert Israel_, Sep 17 2026
%Y A073665 Cf. A073661, A073662, A073664.
%K A073665 nonn,changed
%O A073665 1,1
%A A073665 _Amarnath Murthy_, Aug 10 2002
%E A073665 Corrected and extended by _Sascha Kurz_, Jan 28 2003
%E A073665 Definition corrected by _Robert Israel_, Sep 17 2026
