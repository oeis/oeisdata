%S A228698 7,23,119,839,9239,120119,2042039,38798759,892371479,25878772919,
%T A228698 802241960519,29682952539239,1217001054108839,52331045326680119,
%U A228698 2459559130353965639,130356633908760178919,7691041400616850556279,469153525437627883933079,31433286204321068223516359,2231763320506795843869661559
%N A228698 a(n) = 8*(Product{i=1..n} p(i + 1)) - 1, where p(i) = i-th prime.
%C A228698 From _Jianing Song_, Nov 19 2026: (Start)
%C A228698 For n >= 0, -a(n) is a (negative) pseudo-square in the sense that it is congruent to 1 modulo 8 and a quadratic residue modulo every odd prime p <= prime(n+1).
%C A228698 Let N = A102476(n+2) = 4*A002110(n+1). The minimal element of the coset of (Z/NZ)*^2 in (Z/NZ)* containing a(n), or the least m coprime to N such that a(n)/m is a square modulo N, is m = A045535(n). Here (Z/NZ)* is the multiplicative group of integers modulo N and (Z/NZ)*^2 is the subgroup of squares. (End)
%H A228698 Alois P. Heinz, <a href="/A228698/b228698.txt">Table of n, a(n) for n = 0..150</a>
%H A228698 Andrew J. Hanson, Gerardo Ortiz, Amr Sabry, and Yu-Tsung Tai, <a href="https://arxiv.org/abs/1305.3292">Discrete Quantum Theories</a>, arXiv preprint arXiv:1305.3292 [quant-ph], 2013 [See footnote 25].
%F A228698 a(n) = A102476(n+2) - 1. - _Jianing Song_, Nov 19 2026
%p A228698 a:= n-> 8*mul(ithprime(i+1), i=1..n)-1:
%p A228698 seq(a(n), n=0..20);  # _Alois P. Heinz_, Sep 16 2013
%t A228698 8*FoldList[Times,1,Prime[Range[2,30]]]-1 (* _Harvey P. Dale_, Mar 19 2015 *)
%Y A228698 Cf. A228699, A002110, A045535 (least negative pseudo-squares), A102476.
