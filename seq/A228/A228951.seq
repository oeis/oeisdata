%I A228951 #16 Aug 22 2026 09:58:42
%S A228951 9,11,17,19,21,28,29
%N A228951 Numbers k such that decimal expansion of k^k has only one zero.
%C A228951 19 is the median of this finite set of numbers and the only zero of 19^19 is in the middle of it.
%t A228951 Select[Range[1000],Count[IntegerDigits[#^#],0]==1&]
%Y A228951 Cf. A131495, A229629.
%K A228951 nonn,base,fini,full,changed
