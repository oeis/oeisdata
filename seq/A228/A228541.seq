%I A228541 #23 Sep 16 2026 00:43:55
%S A228541 31,61,62,93,122,124,151,155,181,183,186,211,217,241,244,248,271,279,
%T A228541 302,305,310,331,341,362,366,372,403,421,422,427,434,453,465,482,488,
%U A228541 496,527,541,542,543,549,558,571,589,601,604,610,620,631,633,651,661,662
%N A228541 Numbers having at least one prime factor of the form 30*k + 1.
%C A228541 Together with 2, supersequence of A228556.
%C A228541 Conjecture: Numbers m such that abs(Sum_{k=1..m} [k|m]*A008683(k)*(-1)^(k/15)) = 0. - _Mats Granvik_, Jul 06 2024
%H A228541 Amiram Eldar, <a href="/A228541/b228541.txt">Table of n, a(n) for n = 1..10000</a>
%e A228541 183 = 3*61 is in the sequence because 30*2 + 1 is prime.
%e A228541 211 is in the sequence because it is prime and 211 = 30*7 + 1.
%t A228541 q[n_] := AnyTrue[FactorInteger[n][[;; , 1]], Mod[#, 30] == 1 &]; Select[Range[2, 662], q] (* _Amiram Eldar_, Sep 15 2026 *)
%o A228541 (PARI) for(n=31, 662, if(setsearch(Set(factor(n)[, 1]%30), 1)==1, print1(n, ", ")));
%Y A228541 Supersequence of A132230.
%Y A228541 Cf. A008683, A228556.
%K A228541 nonn,less,changed
%O A228541 1,1
%A A228541 _Arkadiusz Wesolowski_, Aug 25 2013
