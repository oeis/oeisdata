%N A082924 For n prime, a(n) = n+1; for n even and > 2, a(n) = n/2; otherwise a(n) = 3*n.
%H A082924 Harvey P. Dale, <a href="/A082924/b082924.txt">Table of n, a(n) for n = 1..1000</a>
%t A082924 Table[Which[PrimeQ[n],n+1,EvenQ[n]&&n>2,n/2,True,3n],{n,80}] (* _Harvey P. Dale_, Aug 27 2026 *)
%o A082924 (PARI) crazy1(n) = { for(x=1,n, if(x%2==0,y=x/2,y=x*3); if(isprime(x),y=x+1); print1(y" ") ) }
