%S A114877 1,3,125,2100875,2977309629,118890080527911,12677461389063582955701,
%T A114877 7895300107107819831516439618359375,
%U A114877 4725033556599120988065310720798566300246484375
%N A114877 Let d(1)=1 and d(n) = d(n-1)*n^(2n-2)*(2n-1)^(3-2n). Then a(n) = denominator(d(n)).
%C A114877 Empirically coincides with the n-th monic Legendre polynomial discriminant denominator (A114876 is the numerator). - _Amit Lanis_, Sep 01 2026
%F A114877 d(n) = A114876(n)/a(n) ~ A^3 * n^(n - 3/4) / (Pi * 2^(n^2 - 2*n + 1/12)), where A is the Glaisher-Kinkelin constant A074962. - _Vaclav Kotesovec_, Sep 03 2026
%F A114877 d(n) = 2^(n*(n-1)) * BarnesG(2*n+1) / (binomial(2*n,n)^(2*n-2) * BarnesG(n+1)^4). - _Vaclav Kotesovec_, Sep 06 2026
%e A114877 1, 4/3, 108/125, 442368/2100875, 51200000/2977309629, 52428800000/118890080527911, ...
%t A114877 d[1] = 1; d[n_] := d[n] = d[n - 1]*n^(2 n - 2)*(2 n - 1)^(3 - 2 n); a[n_] := Denominator[d[n]]; Array[a, 10] (* _Amiram Eldar_, Mar 04 2023 *)
%t A114877 (* Alternative: *)
%t A114877 Table[2^(n*(n-1)) * BarnesG[2*n+1] / (Binomial[2*n,n]^(2*n-2) * BarnesG[n+1]^4), {n, 1, 10}] // Denominator (* _Vaclav Kotesovec_, Sep 06 2026 *)
%Y A114877 Cf. A114876 (numerators).
%K A114877 easy,frac,nonn,changed
%O A114877 1,2
