%I A061270 #16 Aug 10 2026 18:53:25
%S A061270 0,1,4,9,100,144,400,441,900,10000,10404,14400,40000,40401,44100,
%T A061270 44944,90000,1000000,1004004,1040400,1440000,4000000,4004001,4040100,
%U A061270 4410000,4494400,9000000,9941409,11909401,100000000,100040004,100400400
%N A061270 Squares such that each digit is a square and the sum of the digits is a square.
%C A061270 If k is a term, then so is 100*k. - _Robert Israel_, Aug 10 2026
%D A061270 Amarnath Murthy, Smarandache Additive square sequence is infinite. (To be published in Smarandache Notions Journal.)
%D A061270 Amarnath Murthy, Infinitely many common members of the Smarandache Additive as well as multiplicative square sequence. (To be published in Smarandache Notions Journal.)
%D A061270 Felice Russo, A set of new Smarandache functions, sequences and conjectures in number theory, American Research Press 2000.
%H A061270 Robert Israel, <a href="/A061270/b061270.txt">Table of n, a(n) for n = 1..250</a>
%e A061270 44944 = 212^2, each digit is a square, sum of digits = 4 + 4 + 9 + 4 + 4 = 25 = 5^2.
%p A061270 filter:= proc(n) local L;
%p A061270   L:= convert(n,base,10);
%p A061270   issqr(convert(L,`+`)) and convert(L,set) subset {0,1,4,9}
%p A061270 end proc:
%p A061270 R:= 0: count:= 1: i:= 1: d:= 1:
%p A061270 while count < 100 do
%p A061270   x1:= floor(i^2/10^(d-1));
%p A061270   if x1 = 2 or x1 = 3 then i:= ceil(sqrt(4*10^(d-1)))
%p A061270   elif member(x1,{5,6,7,8}) then i:= ceil(sqrt(9*10^(d-1)))
%p A061270   fi;
%p A061270   if filter(i^2) then
%p A061270     R:= R, i^2; count:= count+1;
%p A061270 fi;
%p A061270   i:= i+1;
%p A061270   if i^2 > 10^d then d:= d+1 fi;
%p A061270 od:
%p A061270 R; # _Robert Israel_, Aug 10 2026
%Y A061270 Cf. A053057, A053059, A061267, A061268, A061269.
%K A061270 nonn,base
%O A061270 1,3
