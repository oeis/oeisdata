%U A366700 1828959159551328,29857735697705720,490633308020085056,8108894353260093213,134705809490320133544
%N A366700 G.f. A(x) satisfies A(x) = (1 + x)^4 + x*A(x)^4.
%H A366700 Robert Israel, <a href="/A366700/b366700.txt">Table of n, a(n) for n = 0..796</a>
%H A366700 Robert Israel, <a href="/A366700/a366700.txt">Recurrence of order 17</a>
%F A366700 a(n) = Sum_{k=0..n} binomial(4*(3*k+1),n-k) * binomial(4*k,k)/(3*k+1).
%F A366700 D-finite with recurrence of order 17 (see link). - _Robert Israel_, Sep 10 2026
%p A366700 with(gfun):
%p A366700 de:= algeqtodiffeq(-y + (1+x)^4+ x*y^4,y(x)):
%p A366700 rec:= diffeqtorec(de,y(x),a(n)):
%p A366700 f:= rectoproc(rec,a(n),remember):
%p A366700 map(f, [$0..30]); # _Robert Israel_, Sep 10 2026
%o A366700 (PARI) a(n) = sum(k=0, n, binomial(4*(3*k+1), n-k)*binomial(4*k, k)/(3*k+1));
%Y A366700 Cf. A366267, A366698, A366699.
