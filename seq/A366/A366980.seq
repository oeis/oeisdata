%T A366980 6309060313,60473691666,584684295383,5695312881404,55839455579659,
%U A366980 550621231581791,5457218248143692,54332533436452743,543148496962279730,5449742750024662824
%N A366980 G.f. satisfies A(x) = 1 + x*A(x)^5 * (1 - x*A(x)).
%H A366980 Robert Israel, <a href="/A366980/b366980.txt">Table of n, a(n) for n = 0..969</a>
%H A366980 Robert Israel, <a href="/A366980/a366980.txt">Recurrence of order 18</a>
%F A366980 a(n) = Sum_{k=0..n} (-1)^(n-k) * binomial(n+4*k+1,k) * binomial(k,n-k)/(n+4*k+1).
%F A366980 D-finite with recurrence of order 18 (see link). - _Robert Israel_, Sep 02 2026
%p A366980 with(gfun):
%p A366980 eq:= -y + 1 + x*y^5*(1-x*y):
%p A366980 de:= algeqtodiffeq(eq,y(x)):
%p A366980 rec:= diffeqtorec(de,y(x),a(n)):
%p A366980 f:= rectoproc(rec,a(n),remember):
%p A366980 map(f, [$0..30]); # _Robert Israel_, Sep 02 2026
%o A366980 (PARI) a(n) = sum(k=0, n, (-1)^(n-k)*binomial(n+4*k+1, k)*binomial(k, n-k)/(n+4*k+1));
%Y A366980 Cf. A000108, A200754.
%Y A366980 Cf. A365185, A367017.
