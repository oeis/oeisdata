%S A366696 1,3,10,57,378,2730,20853,165592,1353297,11307168,96148149,829336122,
%T A366696 7238765532,63816716547,567425771478,5082596905629,45820260590481,
%U A366696 415423374916503,3785371205061825,34647928319586375,318419608552433190,2937021429784279707
%N A366696 G.f. A(x) satisfies A(x) = (1 + x)^2 + x*A(x)^3.
%H A366696 Robert Israel, <a href="/A366696/b366696.txt">Table of n, a(n) for n = 0..1003</a>
%F A366696 a(n) = Sum_{k=0..n} binomial(2*(2*k+1),n-k) * binomial(3*k,k)/(2*k+1).
%F A366696 D-finite with recurrence: (135*n^2 + 135*n - 60)*a(n) + (702*n^2 + 1998*n + 1080)*a(n + 1) + (1485*n^2 + 6993*n + 7740)*a(n + 2) + (1620*n^2 + 10692*n + 17280)*a(n + 3) + (945*n^2 + 8073*n + 17100)*a(n + 4) + (250*n^2 + 2692*n + 7230)*a(n + 5) + (3*n^2 + 75*n + 360)*a(n + 6) + (-4*n^2 - 58*n - 210)*a(n + 7) = 0. - _Robert Israel_, Sep 09 2026
%p A366696 with(gfun):
%p A366696 de:= algeqtodiffeq(-y + (1+x)^2 + x*y^3,y(x)):
%p A366696 rec:= diffeqtorec(de,y(x),a(n)):
%p A366696 f:= rectoproc(rec,a(n),remember):
%p A366696 map(f, [$0..30]); # _Robert Israel_, Sep 09 2026
%o A366696 (PARI) a(n) = sum(k=0, n, binomial(2*(2*k+1), n-k)*binomial(3*k, k)/(2*k+1));
%Y A366696 Cf. A366266, A366697.
%Y A366696 Cf. A364620.
%K A366696 nonn,changed
%O A366696 0,2
