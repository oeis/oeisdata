%N A366239 G.f. A(x) satisfies A(x) = 1 + x + x*(1 + x)^2*A(x)^3.
%F A366239 a(n) = Sum_{k=0..n} binomial(4*k+1,n-k) * binomial(3*k,k)/(2*k+1).
%p A366239 a:= n-> coeff(series(RootOf(1+x+x*(1+x)^2*A^3-A, A), x, n+1), x, n):
%p A366239 seq(a(n), n=0..22);  # _Alois P. Heinz_, Sep 24 2026
%o A366239 (PARI) a(n) = sum(k=0, n, binomial(4*k+1, n-k)*binomial(3*k, k)/(2*k+1));
