%S A366697 1,4,15,94,706,5769,49923,449376,4164228,39459852,380594767,
%T A366697 3724049805,36876008673,368835076813,3720863181033,37815675159285,
%U A366697 386818379566749,3979362306753315,41144521893563511,427335033811660713,4456402044181677264
%N A366697 G.f. A(x) satisfies A(x) = (1 + x)^3 + x*A(x)^3.
%H A366697 Robert Israel, <a href="/A366697/b366697.txt">Table of n, a(n) for n = 0..952</a>
%F A366697 a(n) = Sum_{k=0..n} binomial(3*(2*k+1),n-k) * binomial(3*k,k)/(2*k+1).
%F A366697 D-finite with recurrence: 21*(3*n + 5)*(3*n - 2)*a(n) + 6*(225*n^2 + 648*n + 233)*a(n + 1) + 6*(693*n^2 + 3303*n + 3403)*a(n + 2) + 6*(1197*n^2 + 7974*n + 12620)*a(n + 3) + 120*(21*n + 103)*(3*n + 11)*a(n + 4) + 6*(21*n + 121)*(39*n + 185)*a(n + 5) + 6*(315*n^2 + 3933*n + 12223)*a(n + 6) + 2*(175*n^2 + 2593*n + 9594)*a(n + 7) - (5*n^2 + 33*n - 80)*a(n + 8) - 2*(2*n + 19)*(n + 9)*a(n + 9) = 0. - _Robert Israel_, Sep 09 2026
%p A366697 with(gfun):
%p A366697 de:= algeqtodiffeq(-y + (1+x)^3 + x*y^3,y(x)):
%p A366697 rec:= diffeqtorec(de,y(x),a(n)):
%p A366697 f:= rectoproc(rec,a(n),remember):
%p A366697 map(f, [$0..20]); # _Robert Israel_, Sep 09 2026
%o A366697 (PARI) a(n) = sum(k=0, n, binomial(3*(2*k+1), n-k)*binomial(3*k, k)/(2*k+1));
%Y A366697 Cf. A366266, A366696.
%Y A366697 Cf. A364623.
%K A366697 nonn,changed
%O A366697 0,2
