%N A366698 G.f. A(x) satisfies A(x) = (1 + x)^2 + x*A(x)^4.
%H A366698 Robert Israel, <a href="/A366698/b366698.txt">Table of n, a(n) for n = 0..867</a>
%H A366698 Robert Israel, <a href="/A366698/a366698.txt">Recurrence of order 11</a>
%F A366698 a(n) = Sum_{k=0..n} binomial(2*(3*k+1),n-k) * binomial(4*k,k)/(3*k+1).
%F A366698 D-finite with recurrence of order 11 (see link). - _Robert Israel_, Sep 09 2026
%p A366698 with(gfun):
%p A366698 de:= algeqtodiffeq(-y + (1+x)^2 + x*y^4,y(x)):
%p A366698 rec:= diffeqtorec(de,y(x),a(n)):
%p A366698 f:= rectoproc(rec,a(n),remember):
%p A366698 map(f, [$0..30]); # _Robert Israel_, Sep 09 2026
%o A366698 (PARI) a(n) = sum(k=0, n, binomial(2*(3*k+1), n-k)*binomial(4*k, k)/(3*k+1));
