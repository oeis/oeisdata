%N A366699 G.f. A(x) satisfies A(x) = (1 + x)^3 + x*A(x)^4.
%H A366699 Robert Israel, <a href="/A366699/b366699.txt">Table of n, a(n) for n = 0..826</a>
%H A366699 Robert Israel, <a href="/A366699/a366699.txt">Recurrence of order 14</a>
%F A366699 a(n) = Sum_{k=0..n} binomial(3*(3*k+1),n-k) * binomial(4*k,k)/(3*k+1).
%F A366699 D-finite with recurrence of order 14 (see link). - _Robert Israel_, Sep 10 2026
%p A366699 with(gfun):
%p A366699 de:= algeqtodiffeq(-y + (1+x)^3 + x*y^4,y(x)):
%p A366699 rec:= diffeqtorec(de,y(x),a(n)):
%p A366699 f:= rectoproc(rec,a(n),remember):
%p A366699 map(f, [$0..30]); # _Robert Israel_, Sep 10 2026
%o A366699 (PARI) a(n) = sum(k=0, n, binomial(3*(3*k+1), n-k)*binomial(4*k, k)/(3*k+1));
