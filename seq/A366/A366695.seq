%S A366695 1,4,11,39,166,765,3716,18725,96956,512690,2756806,15027651,82853678,
%T A366695 461215414,2588619402,14632777719,83232244238,476040155118,
%U A366695 2736005962314,15793863291792,91530881427964,532343678619778,3106141476531628,18177446846299299
%N A366695 G.f. A(x) satisfies A(x) = (1 + x)^3 + x*A(x)^2.
%H A366695 Robert Israel, <a href="/A366695/b366695.txt">Table of n, a(n) for n = 0..1256</a>
%F A366695 G.f.: A(x) = 2*(1+x)^3 / (1+sqrt(1-4*x*(1+x)^3)).
%F A366695 a(n) = Sum_{k=0..n} binomial(3*(k+1),n-k) * binomial(2*k,k)/(k+1).
%F A366695 D-finite with recurrence: (4*n - 4)*a(n) + (6 + 12*n)*a(1 + n) + (12*n + 24)*a(n + 2) + (14 + 4*n)*a(n + 3) + (-5 - n)*a(n + 4) = 0. - _Robert Israel_, Sep 09 2026
%p A366695 with(gfun):
%p A366695 de:= algeqtodiffeq(-y + (1+x)^3 + x*y^2, y(x)):
%p A366695 rec:= diffeqtorec(de,y(x),a(n)):
%p A366695 f:= rectoproc(rec,a(n),remember):
%p A366695 map(f,[$0..30]); # _Robert Israel_, Sep 09 2026
%o A366695 (PARI) a(n) = sum(k=0, n, binomial(3*(k+1), n-k)*binomial(2*k, k)/(k+1));
%Y A366695 Cf. A025227, A366694.
%Y A366695 Cf. A162481.
