%N A366434 G.f. A(x) satisfies A(x) = 1 + x * ((1 - x) / A(x))^2.
%F A366434 a(n) = (-1)^(n-1) * Sum_{k=0..n} binomial(3*k-1,k) * binomial(2*k,n-k) / (3*k-1).
%t A366434 terms = 24; A[_] = 1; Do[A[x_] = 1 + x*((1-x)/A[x])^2 + O[x]^terms // Normal, terms]; CoefficientList[A[x], x] (* _Stefano Spezia_, Sep 19 2026 *)
