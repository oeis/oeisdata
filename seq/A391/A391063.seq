%S A391063 1,1,3,13,61,306,1611,8783,49165,280952,1632306,9613223,57260961,
%T A391063 344363782,2088106237,12752309967,78368177095,484268940212,
%U A391063 3007209949548,18756303411703,117448294020218,738072249640971,4653317643336593,29424934498838280,186573488258599197,1185963942575337717
%N A391063 Expansion of g/(1 - x^3*g^5), where g = 1+x*g^3 is the g.f. of A001764.
%H A391063 Vincenzo Librandi, <a href="/A391063/b391063.txt">Table of n, a(n) for n = 0..1000</a>
%F A391063 a(n) = Sum_{k=0..floor(n/3)} (5*k+1) * binomial(3*n-4*k+1,n-3*k)/(3*n-4*k+1).
%F A391063 D-finite with recurrence: 60*(3*n + 7)*(3*n + 5)*a(n) + 5*(713*n^2 + 5015*n + 8328)*a(n + 1) + 18*(141*n^2 + 555*n + 446)*a(n + 2) + 6*(3065*n^2 + 18894*n + 25327)*a(n + 3) + 4*(3325*n^2 + 21757*n + 27399)*a(n + 4) - (4949*n^2 + 79553*n + 283542)*a(n + 5) - 2*(4994*n^2 + 70121*n + 247062)*a(n + 6) - 6*(635*n^2 + 9474*n + 35329)*a(n + 7) - 6*(39*n^2 + 584*n + 2170)*a(n + 8) + (125*n^2 + 2195*n + 9576)*a(n + 9) + 2*(2*n + 21)*(n + 10)*a(n + 10) = 0. - _Robert Israel_, Aug 05 2026
%p A391063 with(gfun):
%p A391063 e1:= y*(1-x^3*g^5)-g: e2:= -g+1+x*g^3:
%p A391063 eq:= resultant(e1, e2, g):
%p A391063 de:= algeqtodiffeq(eq, y(x)):
%p A391063 rec:= diffeqtorec(de, y(x), a(n)):
%p A391063 f:= rectoproc(rec, a(n), remember):
%p A391063 map(f, [$0..40]); # _Robert Israel_, Aug 05 2026
%t A391063 Table[Sum[ (5*k+1)*Binomial[3*n -4*k+1,n-3*k]/(3*n-4*k+1),{k,0,Floor[n/3]}],{n,0,26}] (* _Vincenzo Librandi_, Dec 01 2025 *)
%o A391063 (PARI) a(n) = sum(k=0, n\3, (5*k+1)*binomial(3*n-4*k+1, n-3*k)/(3*n-4*k+1));
%o A391063 (Magma) [&+[(5*k+1)*Binomial(3*n-4*k+1, n-3*k)/(3*n-4*k+1): k in [0..Floor(n/3)]] : n in [0..40] ]; // _Vincenzo Librandi_, Dec 01 2025
%Y A391063 Cf. A000305, A390486, A390520.
%Y A391063 Cf. A390485, A391059, A391061, A391062, A391064, A391065.
