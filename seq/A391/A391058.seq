%I A391058 #16 Aug 06 2026 01:02:54
%S A391058 1,1,4,14,63,306,1584,8539,47431,269514,1559123,9151177,54360098,
%T A391058 326183744,1974146875,12037072559,73871051550,455934004646,
%U A391058 2828289519303,17624018548165,110267149321707,692432344327368,4362666104952134,27570387913567524,174718546090666583,1110050726360380055
%N A391058 Expansion of g/(1 - x^2*g), where g = 1+x*g^3 is the g.f. of A001764.
%H A391058 Vincenzo Librandi, <a href="/A391058/b391058.txt">Table of n, a(n) for n = 0..1000</a>
%F A391058 a(n) = Sum_{k=0..floor(n/2)} (k+1) * binomial(3*n-5*k+1,n-2*k)/(3*n-5*k+1).
%F A391058 D-finite with recurrence: -6*(3*n + 13)*(3*n + 11)*a(n) + (1223*n^2 + 13441*n + 36090)*a(n + 1) - 6*(48*n^2 + 681*n + 2305)*a(n + 2) - 2*(559*n^2 + 5846*n + 14406)*a(n + 3) + 6*(55*n^2 + 716*n + 2277)*a(n + 4) - 3*(53*n^2 + 727*n + 2712)*a(n + 5) + (1235*n^2 + 13663*n + 37116)*a(n + 6) - 18*(19*n^2 + 251*n + 816)*a(n + 7) + 3*(35*n^2 + 583*n + 2426)*a(n + 8) - 6*(2*n + 19)*(n + 9)*a(n + 9) = 0. - _Robert Israel_, Aug 05 2026
%p A391058 with(gfun):
%p A391058 e1:= y*(1-x^2*g)-g: e2:= -g+1+x*g^3:
%p A391058 eq:= resultant(e1,e2,g):
%p A391058 de:= algeqtodiffeq(eq,y(x)):
%p A391058 rec:= diffeqtorec(de,y(x),a(n)):
%p A391058 f:= rectoproc(rec,a(n),remember):
%p A391058 map(f, [$0..40]); # _Robert Israel_, Aug 05 2026
%t A391058 Table[Sum[(k+1)*Binomial[3*n-5*k+1,n-2*k]/(3*n-5*k+1),{k,0,Floor[n/2]}],{n,0,25}] (* _Vincenzo Librandi_, Dec 01 2025 *)
%o A391058 (PARI) a(n) = sum(k=0, n\2, (k+1)*binomial(3*n-5*k+1, n-2*k)/(3*n-5*k+1));
%o A391058 (Magma) [&+[(k+1)*Binomial(3*n-5*k+1, n-2*k)/(3*n-5*k+1): k in [0..Floor(n/2)]] : n in [0..40] ]; // _Vincenzo Librandi_, Dec 01 2025
