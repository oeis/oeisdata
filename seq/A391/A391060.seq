%I A391060 #16 Aug 06 2026 01:02:47
%S A391060 1,1,4,15,68,333,1727,9317,51758,294068,1700827,9980653,59274015,
%T A391060 355592894,2151707068,13117292347,80486635016,496688096931,
%U A391060 3080658090710,19194089036648,120075994871807,753943787632022,4749729156662452,30013614335452595,190184864457166325,1208214303761406925
%N A391060 Expansion of g/(1 - x^2*g^2), where g = 1+x*g^3 is the g.f. of A001764.
%H A391060 Vincenzo Librandi, <a href="/A391060/b391060.txt">Table of n, a(n) for n = 0..1000</a>
%F A391060 a(n) = Sum_{k=0..floor(n/2)} (2*k+1) * binomial(3*n-4*k+1,n-2*k)/(3*n-4*k+1).
%F A391060 D-finite with recurrence: -6*(3*n + 7)*(3*n + 5)*a(n) + (1223*n^2 + 8549*n + 14100)*a(n + 1) - 6*(372*n^2 + 3729*n + 8659)*a(n + 2) - 2*(334*n^2 + 415*n - 4785)*a(n + 3) + 18*(254*n^2 + 2031*n + 3759)*a(n + 4) - (6353*n^2 + 59921*n + 133392)*a(n + 5) + 2*(1907*n^2 + 20996*n + 55998)*a(n + 6) - 2*(598*n^2 + 8401*n + 29520)*a(n + 7) + 2*(218*n^2 + 3755*n + 16212)*a(n + 8) - 3*(43*n^2 + 817*n + 3882)*a(n + 9) + 6*(2*n + 21)*(n + 10)*a(n + 10) = 0. - _Robert Israel_, Aug 05 2026
%p A391060 with(gfun):
%p A391060 e1:= y*(1-x^2*g^2)-g: e2:= -g+1+x*g^3:
%p A391060 eq:= resultant(e1, e2, g):
%p A391060 de:= algeqtodiffeq(eq, y(x)):
%p A391060 rec:= diffeqtorec(de, y(x), a(n)):
%p A391060 f:= rectoproc(rec, a(n), remember):
%p A391060 map(f, [$0..40]); # _Robert Israel_, Aug 05 2026
%t A391060 Table[Sum[(2*k+1)*Binomial[3*n-4*k+1,n-2*k]/(3*n-4*k+1),{k,0,Floor[n/2]}],{n,0,25}] (* _Vincenzo Librandi_, Dec 01 2025 *)
%o A391060 (PARI) a(n) = sum(k=0, n\2, (2*k+1)*binomial(3*n-4*k+1, n-2*k)/(3*n-4*k+1));
%o A391060 (Magma) [&+[(2*k+1)*Binomial(3*n-4*k+1, n-2*k)/(3*n-4*k+1): k in [0..Floor(n/2)]] : n in [0..40] ]; // _Vincenzo Librandi_, Dec 01 2025
%Y A391060 Cf. A000305, A047099, A109957, A121545, A391058.
%Y A391060 Cf. A001764.
