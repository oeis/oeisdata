%I A391064 #19 Aug 06 2026 01:02:33
%S A391064 1,1,3,13,62,315,1674,9193,51759,297174,1733322,10241823,61176883,
%T A391064 368807090,2241052623,13711815645,84403480214,522329376663,
%U A391064 3247830666870,20281159710438,127133515076886,799720690493010,5046518811249591,31937618370152547,202659338107723146
%N A391064 Expansion of g/(1 - x^3*g^6), where g = 1+x*g^3 is the g.f. of A001764.
%H A391064 Vincenzo Librandi, <a href="/A391064/b391064.txt">Table of n, a(n) for n = 0..1000</a>
%F A391064 a(n) = Sum_{k=0..floor(n/3)} (6*k+1) * binomial(3*n-3*k+1,n-3*k)/(3*n-3*k+1).
%F A391064 a(n) = (1/(2*n+1)) * Sum_{k=0..floor(n/3)} (6*k+1) * binomial(3*n-3*k,n-3*k).
%F A391064 D-finite with recurrence: 45*(3*n + 5)*(3*n + 4)*a(n) - 3*(227*n^2 + 117*n - 984)*a(n + 1) + (2927*n^2 + 9141*n + 9748)*a(n + 2) + 6*(335*n^2 + 645*n - 1472)*a(n + 3) + 36*(233*n^2 + 2148*n + 4975)*a(n + 4) - 648*(n + 6)*(2*n + 9)*a(n + 5) = 0. - _Robert Israel_, Aug 05 2026
%p A391064 with(gfun):
%p A391064 e1:= y*(1-x^3*g^6)-g: e2:= -g+1+x*g^3:
%p A391064 eq:= resultant(e1, e2, g):
%p A391064 de:= algeqtodiffeq(eq, y(x)):
%p A391064 rec:= diffeqtorec(de, y(x), a(n)):
%p A391064 f:= rectoproc(rec, a(n), remember):
%p A391064 map(f, [$0..40]); # _Robert Israel_, Aug 05 2026
%t A391064 Table[Sum[ (6*k+1)*Binomial[3*n -3*k+1,n-3*k]/(3*n-3*k+1),{k,0,Floor[n/3]}],{n,0,26}] (* _Vincenzo Librandi_, Dec 01 2025 *)
%o A391064 (PARI) a(n) = sum(k=0, n\3, (6*k+1)*binomial(3*n-3*k+1, n-3*k)/(3*n-3*k+1));
%o A391064 (Magma) [&+[(6*k+1)*Binomial(3*n-3*k+1, n-3*k)/(3*n-3*k+1): k in [0..Floor(n/3)]] : n in [0..40] ]; // _Vincenzo Librandi_, Dec 01 2025
