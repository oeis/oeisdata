%I A391636 #22 Jul 29 2026 02:17:08
%S A391636 36,360,1314,3600,13140,36000,131400,360000,1314000,3600000,13140000,
%T A391636 36000000,131400000,360000000,1314000000,3600000000,13140000000,
%U A391636 36000000000,131400000000,360000000000,1314000000000,3600000000000,13140000000000,36000000000000,131400000000000,360000000000000
%N A391636 Integers k such that the sum of the products of each digit of k and the number obtained by removing that digit is equal to k.
%C A391636 In other words, integers k such that A088116(k) = k.
%C A391636 36*10^j and 1314*10^j are terms for all j >= 0, since:
%C A391636 A088116(36*10^j) = 3*6*10^j + 6*3*10^j = 36*10^j and
%C A391636 A088116(1314*10^j) = 1*314*10^j + 3*114*10^j + 1*134^j + 4*131*10^j = 1314*10^j.
%C A391636 Are there any terms that are not of the form 36*10^j or 1314*10^j, with j >= 0?
%C A391636 There are no terms of other form below 10^25. - _Max Alekseyev_, Jul 27 2026
%e A391636 1314 is a term since 1314 = 1*314 + 3*114 + 1*134 + 4*131.
%t A391636 fsm[k_]:=Module[{kd=IntegerDigits[k],l=IntegerLength[k],sum=0},Do[sum=sum+kd[[i]]*FromDigits[Drop[kd,{i}]],{i,l}];sum];Select[Range[1314000],#==fsm[#]&] (* _James C. McMahon_, Feb 02 2026 *)
%Y A391636 Cf. A088116, A065759.
%K A391636 nonn,base,changed
%O A391636 1,1
%A A391636 _Gonzalo Martínez_, Jan 25 2026
%E A391636 a(13)-a(16) from _Sean A. Irvine_, Feb 01 2026
%E A391636 Terms a(17) onward from _Max Alekseyev_, Jul 27 2026
