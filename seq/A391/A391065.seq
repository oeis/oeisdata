%I A391065 #16 Aug 06 2026 01:02:02
%S A391065 1,1,3,13,65,348,1939,11096,64743,383449,2298278,13910658,84889397,
%T A391065 521665405,3225143064,20044356087,125155684017,784694037348,
%U A391065 4938030668623,31178267939672,197450911430610,1253886347655206,7982655364255420,50937523135245471,325725115261624207
%N A391065 Expansion of g/(1 - x^3*g^9), where g = 1+x*g^3 is the g.f. of A001764.
%H A391065 Vincenzo Librandi, <a href="/A391065/b391065.txt">Table of n, a(n) for n = 0..1000</a>
%F A391065 a(n) = (1/(3*n+1)) * Sum_{k=0..floor(n/3)} (9*k+1) * binomial(3*n+1,n-3*k).
%F A391065 D-finite with recurrence: -1344*(3*n + 2)*(3*n + 1)*a(n) + 8*(8081*n^2 + 26885*n + 22686)*a(n + 1) - 12*(6113*n^2 + 20468*n + 15699)*a(n + 2) + (49151*n^2 + 111293*n - 117538)*a(n + 3) + (8407*n^2 + 149389*n + 461906)*a(n + 4) - (17803*n^2 + 188929*n + 498106)*a(n + 5) + 2*(2863*n^2 + 33583*n + 98266)*a(n + 6) - 4*(180*n^2 + 2367*n + 7741)*a(n + 7) + 16*(n + 8)*(2*n + 13)*a(n + 8) = 0. - _Robert Israel_, Aug 05 2026
%p A391065 with(gfun):
%p A391065 e1:= y*(1-x^3*g^9)-g: e2:= -g+1+x*g^3:
%p A391065 eq:= resultant(e1, e2, g):
%p A391065 de:= algeqtodiffeq(eq, y(x)):
%p A391065 rec:= subs(RootOf(_Z^2-_Z) = 1, diffeqtorec(de,y(x),a(n)));:
%p A391065 f:= rectoproc(rec, a(n), remember):
%p A391065 map(f, [$0..40]); # _Robert Israel_, Aug 05 2026
%t A391065 Table[Sum[ (9*k+1)*Binomial[3* n+1,n-3*k]/(3*n+1),{k,0,Floor[n/3]}],{n,0,26}] (* _Vincenzo Librandi_, Nov 30 2025 *)
%o A391065 (PARI) a(n) = sum(k=0, n\3, (9*k+1)*binomial(3*n+1, n-3*k))/(3*n+1);
%o A391065 (Magma) [&+[(9*k+1)*Binomial(3*n+1, n-3*k)/(3*n+1): k in [0..Floor(n/3)]] : n in [0..40] ]; // _Vincenzo Librandi_, Nov 30 2025
%Y A391065 Cf. A390485, A391059, A391061, A391062, A391063, A391064.
%Y A391065 Cf. A001764.
%K A391065 nonn
%O A391065 0,3
