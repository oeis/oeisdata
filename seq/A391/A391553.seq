%I A391553 #23 Aug 22 2026 00:58:04
%S A391553 1,1,6,58,778,13386,281476,7000876,201163068,6559979068,239428935496,
%T A391553 9672134739576,428510225570296,20661898792071928,1077289606360647408,
%U A391553 60398988138132738256,3623792843060787912976,231683722216692321900816,15725444708263745576296288
%N A391553 Expansion of e.g.f. exp((g^2 - 1)/2), where g = 1+x*g^2 is the g.f. of A000108.
%H A391553 Vincenzo Librandi, <a href="/A391553/b391553.txt">Table of n, a(n) for n = 0..300</a>
%F A391553 a(n) = n! * exp(-1/2) * Sum_{k>=0} binomial(2*n+2*k+2,n)/((2*n+2*k+2) * 2^k * k!) for n > 0.
%F A391553 From _Peter Bala_, Aug 11 2026: (Start)
%F A391553 a(n) = Sum_{k = 1..n} (n-1)!/(n-k)! * binomial(2*k+1, k-1) * a(n-k).
%F A391553 a(n) = Sum_{k = 0..n} A000085(n-1-k)*(n-1)!/(n-1-k)!*binomial(2*n+1,k).
%F A391553 n^2*a(n) = (5*n^2 - n - 3)*n*a(n-1) - (n^3 + 2*n^2 - 2*n - 9)*n*(n - 1)*a(n-2) + 2*(2*n^2 - n - 3)*n*(n - 1)*(n - 2)*(n - 3)*a(n-3) with a(0) = a(1) and a(2) = 6.
%F A391553 For n >= 0, k >= 1, a(n+k) == a(n)*a(k) (mod k).
%F A391553 Reducing the sequence modulo k, k >= 1, gives an eventually periodic sequence. For example, modulo 6 the sequence becomes [1,  0, 4, 4,  0, 4, 4,  0, 4, 4, ...], with a period of 3 starting at n = 1.
%F A391553 E.g.f.: A(x) = exp( Sum_{n >= 1} binomial(2*n+1, n-1)*x^n/n ).
%F A391553 The e.g.f. A(x) satisfies the second-order differential equation
%F A391553 x^3*(1 - 3*x)(1 - 4*x) A''(x) + (1 - 8*x + 22*x^2 - 32*x^3 + 30*x^4)*A'(x) - (1 - 3*x + 3*x^2)*A(x) = 0 with A(0) = A'(0) = 1. (End)
%p A391553 a := proc(n) option remember; if n < 2  then 1 elif n = 2 then 6 else ( (5*n^2 - n - 3)*n*a(n-1) - (n^3 + 2*n^2 - 2*n - 9)*n*(n - 1)*a(n-2) + 2*(2*n^2 - n - 3)*n*(n - 1)*(n - 2)*(n - 3)*a(n-3))/n^2 fi; end:
%p A391553 seq(a(n), n = 1..20); # _Peter Bala_, Aug 20 2026
%t A391553 nmax=20; g[x_]:=Sum[Binomial[2*k,k]/(k+1) x^k,{k,0,nmax}];Table[n!  SeriesCoefficient[Exp[(g[x]^2-1)/2],{x,0,n}],{n,0,nmax}] (* _Vincenzo Librandi_, Dec 21 2025 *)
%o A391553 (PARI) my(N=20, x='x+O('x^N), g=sum(k=0, N, binomial(2*k, k)/(k+1)*x^k)); Vec(serlaplace(exp((g^2-1)/2)))
%o A391553 (Magma) N:=20; R<x>:=PowerSeriesRing(Rationals(),2*N+1); [Factorial(n)*Coefficient(Exp(((&+[Binomial(2*k,k)/(k+1)*x^k:k in [0..N]])^2-1)/2),n):n in [0..N]]; // _Vincenzo Librandi_, Dec 21 2025
%Y A391553 Cf. A000085, A000108, A250916.
%K A391553 nonn,easy,changed
%O A391553 0,3
%A A391553 _Seiichi Manyama_, Dec 13 2025
