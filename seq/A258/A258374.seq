%I A258374 #38 Nov 08 2026 23:16:37
%S A258374 70,4030,4199030,1550860550
%N A258374 Least primitive weird number (PWN) with n prime divisors, not counting multiplicity.
%C A258374 A proper subset of A002975.
%C A258374 So far all terms are == 2 (mod 4).
%C A258374 a(7) <= 4 * 13 * 17 * 449 * 24809 * 228259243 * 11449243661 ≈ 2.6e28, a(8) <= 4 * 13 * 17 * 449 * 24809 * 223842061 * 1123622795959 * 16039588627050434791 ≈ 3.97 e49. - _M. F. Hasler_, Aug 02 2016
%C A258374 a(7) <= 2 * 5 * 11 * 89 * 167 * 829 * 7972687 ≈ 1.1e16. - _M. F. Hasler_, Feb 18 2018
%H A258374 Gianluca Amato, Maximilian F. Hasler, Giuseppe Melfi and Maurizio Parton, <a href="https://doi.org/10.1016/j.jnt.2019.02.027">Primitive abundant and weird numbers with many prime factors</a>, Journal of Number Theory vol. 201 (2019) pp. 436-459. DOI: 10.1016/j.jnt.2019.02.027; see also <a href="https://arxiv.org/abs/1802.07178">arXiv preprint</a>, arXiv:1802.07178 [math.NT], 2018.
%e A258374 From _M. F. Hasler_, Jul 18 2016: (Start)
%e A258374 a(3) = 2 * 5 * 7 = A002975(1) = A258882(1).
%e A258374 a(4) = 2 * 5 * 13 * 31 = A258401(1) = A258883(1).
%e A258374 a(5) = 2 * 5 * 11 * 59 * 647 = A258884(1).
%e A258374 a(6) = 2 * 5^2 * 29 * 37 * 137 * 211 = A258885(1) = A273815(1). (End)
%t A258374 (* copy the terms from A002975, assign them equal to 'lst' and then *) Table[ Min@ Select[ lst, PrimeNu@# == n &], {n, 3, 6}]
%Y A258374 Cf. A002975 (primitive weird numbers), A258375 (least PWN with bigomega = n), A258882 (PWN of the form 2^k p q), A258401 (PWN not of this form), A258883 - A258884 (PWN with 3 and 4 odd prime factors, all distinct), A258885 (PWN with 6 distinct prime factors), A273815 (PWN with odd square factors).
%K A258374 nonn,hard,more,changed
%O A258374 3,1
%A A258374 _Robert G. Wilson v_, May 28 2015
