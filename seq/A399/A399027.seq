%N A399027 Expansion of e.g.f. exp(sinh(x) + sinh(x)^2).
%F A399027 a(n) = Sum_{k=0..floor(n/2)} A047974(n-2*k) * A136630(n,n-2*k).
%F A399027 E.g.f.: exp(B(x)), where B(x) is the e.g.f. of A066532.
%F A399027 a(0) = 1; a(n) = Sum_{k=0..n-1} binomial(n-1,k) * a(k) * A066532(n-k).
%o A399027 (PARI) my(N=30, x='x+O('x^N)); Vec(serlaplace(exp(sinh(x)+sinh(x)^2)))
