%I A399954 #5 Sep 24 2026 18:20:19
%S A399954 65065,111265,131495,138985,164255,203665,206635,214795,240695,258115,
%T A399954 289289,314755,337535,351785,361361,378235,398905,472549,494615,
%U A399954 529529,552805,558467,584545,653315,692461,773927,818363,841841,854335,877591,914641,961961,1100869
%N A399954 Numbers k = rad(k) * q(k) such that A008479(k) = 5, where rad = A007947 and q(k) the 4th smallest distinct prime factor of k.
%C A399954 Numbers k in A398864 such that A008479(k) is minimum.
%C A399954 Terms are odd.
%H A399954 Michael De Vlieger, <a href="/A399954/b399954.txt">Table of n, a(n) for n = 1..10000</a>
%e A399954 Let P(i..j) = Product_{h=i..j} prime(h).
%e A399954 Let S = {m < n : rad(m) = rad(n)}.
%e A399954 Table of n, a(n) for select n:
%e A399954       n         a(n)                       S(n)
%e A399954   ---------------------------------------------------------------------
%e A399954       1       65065 = 5 * 7 * 11 * 13^2    {5005, 25025, 35035, 55055}
%e A399954       2      111265 = 5 * 7 * 11 * 17^2    {6545, 32725, 45815, 71995}
%e A399954       3      131495 = 5 * 7 * 13 * 17^2    {7735, 38675, 54145, 100555}
%e A399954       4      138985 = 5 * 7 * 11 * 19^2    {7315, 36575, 51205, 80465}
%e A399954       5      164255 = 5 * 7 * 13 * 19^2    {8645, 43225, 60515, 112385}
%e A399954      11      289289 = 17 * P(4..7)   {17017, 119119, 187187, 221221}
%e A399954      30      877591 = 19 * P(5..8)   {46189, 508079, 600457, 785213}
%e A399954      34     1106105 = 13 * P(3..7)   {85085, 425425, 595595, 935935}
%e A399954      67     2221271 = 23 * P(6..9)   {96577, 1255501, 1641809, 1834963}
%e A399954     791    21015995 = 13 * P(3..8)   {1616615, 8083075, 11316305, 17782765}
%e A399954   20118   483367885 = 13 * P(3..9)   {37182145, 185910725, 260275015, 409003595}
%t A399954 facs[x_] := facs[x] = FactorInteger[x][[All, 1]]; nn = 250000;
%t A399954 Table[Set[r[n], Times @@ facs[n]], {n, nn}];
%t A399954 s = Select[Range[2, nn], PrimeNu[#] == 4 &];
%t A399954 t = Select[s, #1/Apply[Times, #2] == #2[[4]] & @@ {#, facs[#]} &];
%t A399954 Select[t, Function[m, Count[Range[m], _?(r[#] == r[m] &)] == 5] ]
%Y A399954 Cf. A005408, A007947, A008479, A398864, A399320.
%K A399954 nonn,new
%O A399954 1,1
