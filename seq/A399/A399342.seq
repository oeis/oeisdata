%p A399342 A1 := proc(m) option remember; local i; if m = 0 then 1 else add(i! * A(m-i, i), i = 1..m) fi end:
%p A399342 A := proc(n, k) option remember; local i; if n < 0 or k < 0 then 0 elif n = 0 then 1 elif k = 0 then 0 elif k = 1 then A1(n) else add(A(n-i, k-1) * A1(i) * binomial(n+k, i+1) * binomial(n, i), i = 0..n) / k fi end: seq(lprint(seq(A(n, k), k = 0..5)), n = 0..6);
%o A399342 (Python)
%o A399342 from math import comb, factorial
%o A399342 from functools import cache
%o A399342 @cache
%o A399342 def A1(m: int) -> int:
%o A399342     if m == 0: return 1
%o A399342     return sum(factorial(i) * A(m - i, i) for i in range(1, m + 1))
%o A399342 @cache
%o A399342 def A(n: int, k: int) -> int:
%o A399342     if n < 0 or k < 0: return 0
%o A399342     elif n == 0: return 1
%o A399342     elif k == 0: return 0
%o A399342     elif k == 1: return A1(n)
%o A399342     total = sum(A(n - i, k - 1) * A1(i) * comb(n + k, i + 1) * comb(n, i)
%o A399342             for i in range(0, n + 1))
%o A399342     return total // k
%o A399342 for n in range(7):
%o A399342     row = [A(n, k) for k in range(10)]; print(row)
