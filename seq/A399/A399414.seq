%t A399414 x = 2E; u[n_, k_] := Sum[Floor[k (n + x)/h - x], {h, 1, Floor[k (n + x)/(1 + x)]}]
%t A399414 t = Table[u[n, k], {n, 1, 12}, {k, 1, 12}]; Grid[t]  (*array*)
%t A399414 Table[u[n - k + 1, k], {n, 1, 12}, {k, n, 1, -1}] // Flatten (*sequence*)
%Y A399414 Cf.  A399406.
