%I A399582 #31 Sep 16 2026 12:49:20
%S A399582 8,11,13,16,22,23,26,28,29,31,35,37,38,41,43,44,46,50,53,56,58,59,61,
%T A399582 64,65,68,70,71,73,74,76,79,80,83,85,86,88,91,92,97,98,100,101,103,
%U A399582 106,107,109,112,113,116,118,121,122,125,127,128,131,133,134
%N A399582 Numbers k not divisible by 3 such that at least one of 3+2k and 3+4k is composite.
%C A399582 Numbers k not divisible by 3 that are missing from the sequence of k for which 3+2k and 3+4k are both prime.
%H A399582 Paolo Xausa, <a href="/A399582/b399582.txt">Table of n, a(n) for n = 1..10000</a>
%F A399582 a(n) = A360735(n) / 2.
%e A399582 For a(1) = 8, 8 is not divisible by 3 and 3+2.8 = 19 is prime, but 3+4.8 = 35 is composite so 8 is a term.
%p A399582 remove(k -> isprime(3+2*k) and isprime(3+4*k), [seq(seq(3*k+i,i=1..2),k=0..100)]); # _Robert Israel_, Sep 16 2026
%t A399582 A399582Q[k_] := !Divisible[k, 3] && AnyTrue[3 + {2, 4}*k, CompositeQ];
%t A399582 Select[Range[150], A399582Q] (* _Paolo Xausa_, Sep 16 2026 *)
%Y A399582 Cf. A360735.
%K A399582 nonn,new
%O A399582 1,1
%A A399582 _Emre Yılmaz_, Sep 03 2026
