%I A399441 #13 Aug 29 2026 17:15:31
%S A399441 0,1,4,9,3798749956,426627129889,1778419613476,62911997238214881,
%T A399441 189595954745982976,13379723125429248225
%N A399441 Squares k such that k - A062329(k) is also a square.
%C A399441 Squares k such that k + (product of digits of k) - (sum of digits of k) is a square (possibly the same as k).
%C A399441 a(8) > 4*10^14 if it exists.
%e A399441 a(5) = 3798749956 is a term because 3798749956 = 61634^2, the product of digits of 3798749956 is 102876480, the sum of digits of 3798749956 is 67, and 3798749956 + 102876480 - 67 = 3901626369 = 62463^2.
%p A399441 f:= proc(n) local L; L:= convert(n,base,10); n + convert(L,`*`)-convert(L,`+`) end proc:
%p A399441 select(t -> issqr(f(t)), [seq(i^2,i=0..2*10^6)]);
%Y A399441 Cf. A062329, A399442.
%K A399441 nonn,base,more,new
%O A399441 1,3
