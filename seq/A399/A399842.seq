%U A399842 192276351542126397,117288381359469798327,78583215518267558799,55794831266989696741539,472968599249241562132347
%N A399842 Omit zero digits from the product of first n primes (cf. A002110).
%H A399842 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A399842 a(n) = A004719(A002110(n)).
%e A399842 a(6) = 33 since prime(6)# = 13# = 30030.
%t A399842 primorial[n_] := Product[Prime[i], {i, n}]; (* A002110 *)
%t A399842 a[n_]:=FromDigits[Select[IntegerDigits[primorial[n]], Positive]]; Array[a,22,0]
%Y A399842 Cf. A002110, A004719, A079099 (number of omitted zero digits), A356757, A399843 (number of nonzero digits).
