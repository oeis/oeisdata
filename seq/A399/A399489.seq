%S A399489 17,29,47,89,97,179,349,383,419,449,653,691,1291,1301,1303,1307,1559,
%T A399489 2039,4229,4349,5653,5791,7079,12263,12757,12763,12941,13001,13003,
%U A399489 13007,13009,13709,15541,18397,18749,19069,19937,20753,20759,21727,23159,24439,26849,29581,29587,29989,30293,31253
%N A399489 Primes p such that p - A062329(p) is a square.
%C A399489 Primes p such that p + (product of digits of p) - (sum of digits of p) is a square.
%H A399489 Robert Israel, <a href="/A399489/b399489.txt">Table of n, a(n) for n = 1..10000</a>
%e A399489 a(3) = 47 is a term because 47 is prime and 47 + 4*7 - (4+7) = 64 = 8^2.
%p A399489 filter:= proc(p) local L;
%p A399489  if not isprime(p) then return false fi;
%p A399489  L:= convert(p, base, 10);
%p A399489  issqr(p + convert(L, `*`)-convert(L, `+`))
%p A399489 end proc:
%p A399489 A:=select(filter, [2, seq(i, i=3..10^5, 2)]);
%Y A399489 Cf. A062329, A399441, A399442, A399496.
%K A399489 nonn,base,new
%O A399489 1,1
