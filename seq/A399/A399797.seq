%I A399797 #18 Sep 29 2026 16:09:25
%S A399797 0,2,1,5,4,3,3,7,2,21,6,6,20,10,5,5,19,4,9,4,4,23,18,8,8,8,3,27,22,22,
%T A399797 17,12,7,7,7,7,26,21,21,16,16,11,11,11,6,6,6,6,25,20,20,20,15,5,15,10,
%U A399797 10,10,10,5,5,29,5,24,24,24,19,19,19,19,14,9,14,9,9,9,9,9,9,28
%N A399797 Number of iterations of T needed to reach 1, starting with n, where T(k) = k/3 if k == 0 (mod 3), T(k) = (4*k-1)/3 if k == 1 (mod 3), and T(k) = (4*k+1)/3 if k == 2 (mod 3), or -1 if the trajectory never reaches 1.
%C A399797 Conjecture: Every positive integer reaches 1 (verified up to 10^11).
%H A399797 Farhad Banazadeh, <a href="https://doi.org/10.5281/zenodo.22685074">Extended Computational Verification of the Ternary (4k +/- 1)/3 Collatz-Type Map up to 10^11: A 128-Bit Exhaustive Certification</a>.
%F A399797 a(1) = 0.
%F A399797 a(3*n) = a(n) + 1 if a(n) >= 0, and -1 otherwise, for n >= 1.
%F A399797 a(3*n+1) = a(4*n+1) + 1 if a(4*n+1) >= 0, and -1 otherwise, for n >= 1.
%F A399797 a(3*n+2) = a(4*n+3) + 1 if a(4*n+3) >= 0, and -1 otherwise, for n >= 0.
%e A399797 For n = 2, the orbit is 2, 3, 1. So a(2) = 2.
%e A399797 For n = 4, the orbit is 4, 5, 7, 9, 3, 1. So a(4) = 5.
%o A399797 (C)
%o A399797 #include <stdio.h>
%o A399797 int main() {
%o A399797 long long n, k, s;
%o A399797 for (n = 1; n <= 100; n++) {
%o A399797     k = n;
%o A399797     s = 0;
%o A399797     while (k != 1) {
%o A399797         if (k % 3 == 0)
%o A399797             k = k/3;
%o A399797         else if (k % 3 == 1)
%o A399797             k = (4*k - 1)/3;
%o A399797         else
%o A399797             k = (4*k + 1)/3;
%o A399797         s++;
%o A399797     }
%o A399797     printf("%lld, ", s);
%o A399797 }
%o A399797 return 0;
%o A399797 }
