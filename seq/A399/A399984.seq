%I A399984 #13 Nov 22 2026 19:50:12
%S A399984 1,2,3,3,4,5,4,6,7,7,9,5,9,10,9,10,10,14,6,12,13,16,11,16,14,19,7,15,
%T A399984 19,16,15,23,13,22,18,24,20,8,25,18,28,19,20,30,15,28,22,31,29,21,30,
%U A399984 9,34,21,37,22,25,37,34,17,34,36,26,43,34,27,40,10,43,24
%N A399984 a(n) = A238690(A051037(n)).
%H A399984 Michael De Vlieger, <a href="/A399984/b399984.txt">Table of n, a(n) for n = 1..10000</a>
%H A399984 Michael De Vlieger, <a href="/A399984/a399984.png">Log log scatterplot of a(n)</a>, n = 1..349112.
%H A399984 Michael De Vlieger, <a href="/A399984/a399984_1.png">Diagram of a(n)</a>, n = 1..48.
%F A399984 Let s(n) = A143207(n) = 30*A051037(n), numbers of the form 2^i * 3^j * 5^k, i >= 0, j >= 0, k >= 0. To simplify the following, we use A143207 instead of A051037 so as to avoid offsetting i, j, and k.
%F A399984 Subtractive approach:
%F A399984 a(n) = binomial(i+j+k,3) - binomial(i+j,3) - k * binomial(i,2).
%F A399984 a(n) = A000292(i+j+k-2) - A000292(i+j-2) - k * A000217(i-1).
%F A399984 Additive approach:
%F A399984 a(n) = i*j*k + i * binomial(k,2) + binomial(j+k,3) - binomial(j,3).
%F A399984 a(n) = i*j*k + i * A000217(k-1) + A000292(j+k-2) - A000292(j-2).
%F A399984 Alternate additive approach:
%F A399984 a(n) = i*j*k + k * binomial(j,2) + (i+j-1) * binomial(k,2) + binomial(k+1,3).
%F A399984 a(n) = i*j*k + k * A000217(j-1) + (i+j-1) * A000217(k-1) + A000292(k-1).
%e A399984 Table of n, s(n), and a(n) for n = 1..12:
%e A399984    n   s(n)  {i, j, k}   Sub.         Add.      Alt. Add. a(n)
%e A399984   ------------------------------------------------------------
%e A399984    1    30   {1, 1, 1}   1-0-1*0    = 1+0+0-0 = 1+0+1*0+0 = 1
%e A399984    2    60   {2, 1, 1}   4-1-1*1    = 2+0+0-0 = 2+0+2*0+0 = 2
%e A399984    3    90   {1, 2, 1}   4-1-1*0    = 2+0+1-0 = 2+1+2*0+0 = 3
%e A399984    4   120   {3, 1, 1}   10-4-1*3   = 3+0+0-0 = 3+0+3*0+0 = 3
%e A399984    5   150   {1, 1, 2}   4-0-2*0    = 2+1+1-0 = 2+0+1*1+0 = 4
%e A399984    6   180   {2, 2, 1}   10-4-1*1   = 4+0+1-0 = 4+1+3*0+0 = 5
%e A399984    7   240   {4, 1, 1}   20-10-1*6  = 4+0+0-0 = 4+0+4*0+0 = 4
%e A399984    8   270   {1, 3, 1}   10-4-1*0   = 3+0+4-1 = 3+3+3*0+0 = 6
%e A399984    9   300   {2, 1, 2}   10-1-2*1   = 4+2+1-0 = 4+0+2*1+0 = 7
%e A399984   10   360   {3, 2, 1}   20-10-1*3  = 6+0+1-0 = 6+1+4*0+0 = 7
%e A399984   11   450   {1, 2, 2}   10-1-2*0   = 4+1+4-0 = 4+2+2*1+0 = 9
%e A399984   12   480   {5, 1, 1}   35-20-1*10 = 5+0+0-0 = 5+0+5*0+0 = 5
%t A399984 (* First, load the function regs from the Mathematica link at A369609, then: *)
%t A399984 Map[Function[{i, j, k}, Binomial[i + j + k + 3, 3] - Binomial[i + j + 2, 3] - (k + 1)*Binomial[i + 1, 2]] @@ (FactorInteger[#][[;; , -1]] - 1) &, regs[-30, 2^15] ]
%t A399984 (* Alternative: *)
%t A399984 f[n_] := Count[Tuples@ Map[Range[0, #] &, If[n == 1, {}, Flatten[ConstantArray[PrimePi[#1], #2] & @@@ FactorInteger[n]]]], _?(OrderedQ[#, LessEqual] &)]; Map[f, Select[Range[576], FactorInteger[#][[-1, 1]] <= 5 &] ]
%Y A399984 Cf. A000217, A000292, A051037, A143207, A238690.
%K A399984 nonn,easy,new
%O A399984 1,2
%A A399984 _Michael De Vlieger_, Oct 19 2026
