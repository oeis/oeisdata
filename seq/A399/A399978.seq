%I A399978 #16 Sep 26 2026 09:05:51
%S A399978 0,3,4,3,6,7,8,3,4,9,12,7,14,11,10,3,18,7,20,9,12,15,24,7,6,17,4,11,
%T A399978 30,13,32,3,16,21,14,7,38,23,18,9,42,15,44,15,10,27,48,7,8,9,22,17,54,
%U A399978 7,18,11,24,33,60,13,62,35,12,3,20,19,68,21,28,17,72,7,74,41,10,23,20,21,80
%N A399978 a(n) = omega(n) + sopf(n), where omega(n) is the number of distinct prime factors of n (A001221) and sopf(n) is the sum of the distinct primes dividing n (A008472).
%C A399978 a(n) depends only on the squarefree kernel (radical) of n: a(n) = a(rad(n)) = a(A007947(n)), since both omega and sopf ignore multiplicity of prime factors.
%C A399978 a(n) <= n+1 for all n, with equality if and only if n is prime or n = 6. [For n with k >= 2 distinct prime factors p_1 < ... < p_k, one has n - a(n) = n - k - sopf(n), which is >= 1 for all such n except n = 6 = 2*3, where it equals 0.]
%C A399978 a(n) is even if and only if n is odd. Consequently a(n) and a(n+1) always have opposite parity, so a(n) = a(n+1) never holds.
%F A399978 a(n) = A001221(n) + A008472(n).
%F A399978 a(n) = Sum_{p|n} (p+1), with a(1) = 0 (empty sum).
%F A399978 a(A002110(k)) = k + A007504(k) for the k-th primorial.
%F A399978 Additive with a(p^k) = p+1, for p prime and k >= 1.
%e A399978 a(1) = 0, since 1 has no prime factors.
%e A399978 a(12) = 7: since 12 = 2^2 * 3, omega(12) = 2 and sopf(12) = 2+3 = 5, so a(12) = 2+5 = 7.
%e A399978 a(30) = 13: since 30 = 2*3*5, omega(30) = 3 and sopf(30) = 2+3+5 = 10, so a(30) = 3+10 = 13.
%t A399978 f[p_, e_] := p + 1; a[1] = 0; a[n_] := Plus @@ f @@@ FactorInteger[n]; Array[a, 100] (* _Amiram Eldar_, Sep 26 2026 *)
%o A399978 (PARI) a(n) = if(n==1, 0, my(f=factor(n)[,1]); #f + vecsum(f))
%Y A399978 Cf. A001221, A008472, A007947, A002110, A007504.
%K A399978 nonn,easy,changed
%O A399978 1,2
