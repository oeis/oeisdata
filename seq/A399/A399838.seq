%I A399838 #6 Sep 16 2026 22:59:15
%S A399838 1,3,4,5,6,12,8,15,13,18,12,20,14,24,24,27,18,39,20,30,32,36,24,60,31,
%T A399838 42,40,40,30,72,32,63,48,54,48,65,38,60,56,90,42,96,44,60,78,72,48,
%U A399838 108,57,93,72,70,54,120,72,120,80,90,60,120,62,96,104,119,84,144,68,90
%N A399838 The sum of divisors d of n such that gcud(d, n/d) is odd, where gcud is the greatest common unitary divisor.
%C A399838 The number of these divisors is A399832(n).
%H A399838 Amiram Eldar, <a href="/A399838/b399838.txt">Table of n, a(n) for n = 1..10000</a>
%F A399838 Multiplicative with a(2^e) = 2^(e+1)-1 if e is odd, and 2^(e+1)-1-2^(e/2) if e is even, and a(p^e) = (p^(e+1)-1)/(p-1) for an odd prime p.
%F A399838 Dirichlet g.f.: ((1 - 1/2^(2*s-2) + 3/2^(3*s-1) - 1/2^(4*s-2))/(1 - 1/2^(2*s-1))) * zeta(s-1) * zeta(s).
%F A399838 Sum_{k=1..n} a(k) ~ c * n^2, where c = 53*Pi^2/672 = 0.77840629949067858154... .
%t A399838 f[p_, e_] :=(p^(e+1)-1)/(p-1); f[2, e_] := 2^(e+1)-1 - If[OddQ[e], 0, 2^(e/2)]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A399838 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, (f[i,1]^(f[i,2]+1)-1)/(f[i,1]-1) - if(f[i,1] == 2 && !(f[i,2] % 2), 2^(f[i,2]/2)));}
%Y A399838 Cf. A077610, A165430, A225174, A384244.
%Y A399838 Cf. A069184 (analogous with gcd), A399832.
%Y A399838 The sum of divisors d of n such that gcud(d, n/d) is: A188999 (1), A399834 (squarefree), A399835 (powerful), A399836 (square), A399837 (exponentially odd), this sequence (odd), A399839 (power of 2).
%K A399838 nonn,mult,easy,new
%O A399838 1,2
%A A399838 _Amiram Eldar_, Sep 13 2026
