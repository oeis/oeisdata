%U A399034 4137,147,1,65536,589824,1433600,1347584,553280,101136,7700,200,1,262144,2949120,9191424,11483136,6596352,1822464,237900,13428,264,1
%N A399034 Triangle read by rows: T(n,m) = (binomial(n-1,m)/(n-1))*Sum_{j=0..m} binomial(m,j)*binomial(2*(n-m-1),m-j-1)*2^(2*n-3*m+j-1), with 1 <= m <= n - 1.
%C A399034 T(n,m) is the number of marked noncrossing trees on n >= 2 vertices with m >= 1 leaves (see Nyariaro et al. on page 82).
%H A399034 Albert Oloo Nyariaro, Isaac Owino Okoth, and Fredrick Oluoch Nyamwala, <a href="https://doi.org/10.61091/jcmcc131-05">Marked noncrossing trees</a>, Journal of Combinatorial Mathematics and Combinatorial Computing, Volume 131. 67-86 (2026).
%e A399034 The triangle begins as:
%e A399034      1;
%e A399034      4,    1;
%e A399034     16,   12,    1;
%e A399034     64,   96,   25,   1;
%e A399034    256,  640,  336,  44,  1;
%e A399034   1024, 3840, 3360, 900, 70, 1;
%e A399034   ...
%t A399034 T[n_,m_]:=Binomial[n-1,m]/(n-1)*Sum[Binomial[m,j]*Binomial[2*(n-m-1),m-j-1]*2^(2*n-3m+j-1),{j,0,m}]; Table[T[n,m],{n,2,11},{m,1,n-1}]//Flatten
%Y A399034 1st column gives A000302.
%Y A399034 Oblique side gives A000012.
%Y A399034 Row sums give A399033.
%K A399034 nonn,tabl,new
%O A399034 2,2
%A A399034 _Stefano Spezia_, Aug 17 2026
