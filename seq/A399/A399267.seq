%T A399267 152361,166617,207009,7144929,543609,6586148313,287793,1499553,
%U A399267 12341241,2832489,1055241,20160657,111071169,6683193,2590137,46877879169
%N A399267 a(n) is the smallest nonnegative integer k where there are exactly n nonnegative integer solutions to x^2 + 8*y^2 = k.
%C A399267 a(n) is the smallest nonnegative k such that A399266(k) = n.
%H A399267 Seiichi Manyama, <a href="/A399267/b399267.txt">Table of n, a(n) for n = 0..1000</a>
%F A399267 9|a(n) for n > 0.
%o A399267 (PARI) b(n, k) = sum(i=0, sqrtint(n), sum(j=0, sqrtint(n\k), i^2+k*j^2==n));
%o A399267 a(n, k=8) = my(cnt=0); while(b(cnt, k)!=n, cnt++); cnt;
%Y A399267 Cf. A399202, A374285, A374286, A399198, A374288.
