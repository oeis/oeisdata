%U A399405 36980725604608,272137422582528,2002631791541248,14737164975072768,108449307765849088,798067496345822208,5872898055733424128,43218063297858766848
%N A399405 a(n) = 6*a(n-1) + 10*a(n-2), with a(0)=1 and a(1)=3.
%H A399405 Chetansing Rajput, <a href="https://doi.org/10.51846/jnhm.v2i2.5488">Deca-metallic ratios: a base-10 analogue of metallic means with their geometric origin in primitive Pythagorean triples</a>, J. New Horiz. Math., 2026.
%H A399405 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (6,10).
%F A399405 a(n) = 6*a(n-1) + 10*a(n-2) for n > 1, with a(0)=1 and a(1)=3.
%F A399405 a(n) = ((3+sqrt(19))^n + (3-sqrt(19))^n)/2.
%F A399405 G.f.: (1 - 3*x)/(1 - 6*x - 10*x^2).
%F A399405 E.g.f.: exp(3*x)*cosh(sqrt(19)*x).
%o A399405 (Python)
%o A399405 a, b = 1, 3
%o A399405 for n in range(25):
%o A399405     print(a, end=", ")
%o A399405     a, b = b, 6*b + 10*a
%Y A399405 Cf. A190005, A400851, A399776.
%K A399405 nonn,easy,new
%O A399405 0,2
