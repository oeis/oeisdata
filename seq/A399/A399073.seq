%U A399073 296354,465658,732564,1153275,1817272,2865564,4521990,7140331,11282144,17836506,28214576
%N A399073 Number of aperiodic binary bracelets of length n having no three consecutive equal beads.
%C A399073 A binary bracelet is an equivalence class of binary words under rotations and reversal. A bracelet counted here has least rotational period n. The forbidden triples are cyclic, so positions n - 1, n, 1 and n, 1, 2 are included.
%e A399073 For n = 4, the only bracelet is represented by 0011, so a(4) = 1.
%e A399073 For n = 7, representatives are 0010011, 0010101, 0011011, and 0101011, so a(7) = 4.
%o A399073 (Python)
%o A399073 from itertools import product
%o A399073 def valid(w):
%o A399073     n = len(w)
%o A399073     return all(
%o A399073         not (w[i] == w[(i + 1) % n] == w[(i + 2) % n]) for i in range(n)
%o A399073     )
%o A399073 def least_period(w):
%o A399073     n = len(w)
%o A399073     for d in range(1, n + 1):
%o A399073         if n % d == 0 and all(w[i] == w[i % d] for i in range(n)):
%o A399073             return d
%o A399073 def canonical(w):
%o A399073     n = len(w)
%o A399073     r = w[::-1]
%o A399073     return min(
%o A399073         [w[i:] + w[:i] for i in range(n)] + [r[i:] + r[:i] for i in range(n)]
%o A399073     )
%o A399073 def a(n):
%o A399073     reps = set()
%o A399073     for w in product((0, 1), repeat=n):
%o A399073         if valid(w) and least_period(w) == n:
%o A399073             reps.add(canonical(w))
%o A399073     return len(reps)
%o A399073 print([a(n) for n in range(1, 21)])
