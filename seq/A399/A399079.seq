%N A399079 G.f.: (Sum_{k>=1} k*x^(2*k)/(1 - x^(2*k))) * Product_{k>=1} (1 + x^k).
%H A399079 Vaclav Kotesovec, <a href="/A399079/b399079.txt">Table of n, a(n) for n = 0..10000</a>
%F A399079 a(n) ~ exp(Pi*sqrt(n/3)) * n^(1/4) / (8*3^(1/4)).
%F A399079 a(n) = Sum_{k=1..n/2} A000203(k)*A000009(n-2*k).
%t A399079 nmax = 60; CoefficientList[Series[Sum[k*x^(2*k)/(1-x^(2*k)), {k, 1, nmax}] * Product[1 + x^k, {k, 1, nmax}], {x, 0, nmax}], x]
%t A399079 (* Alternative: *)
%t A399079 Table[Sum[DivisorSigma[1, k] * PartitionsQ[n-2*k], {k, 1, n/2}], {n, 0, 60}]
%Y A399079 Cf. A277029, A399078, A399080.
