%I A399378 #13 Sep 21 2026 09:29:19
%S A399378 0,1,2,6,10,14,15,18,22,24,26,30,33,34,38,42,46,50,51,54,58,60,62,66,
%T A399378 69,70,74,78,82,86,87,90,94,96,98,102,106,110,112,114,118,122,123,126,
%U A399378 130,132,134,138,141,142,146,150,154,155,158,159,161,162,166,168,170,174,177,178,180,182,186,190,194,198,202
%N A399378 Numbers k that are multiples of A399376(k), where A399376(k) = {Smallest prime not dividing k'}^{the least significant nonzero digit in primorial base representation of k'}, and k' stands for A003415(k), the arithmetic derivative of k.
%H A399378 Antti Karttunen, <a href="/A399378/b399378.txt">Table of n, a(n) for n = 1..10000</a>
%H A399378 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A399378 {k such that k == 0 mod A399376(k)}.
%o A399378 (PARI)
%o A399378 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A399378 A028233(n) = if(n>1, f=factor(n); f[1, 1]^f[1, 2], 1);
%o A399378 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A399378 A327859(n) = A276086(A003415(n));
%o A399378 A399376(n) = A028233(A327859(n));
%o A399378 is_A399378(k) = !(k%A399376(k));
%Y A399378 Cf. A003415, A053669, A276088, A399376.
%Y A399378 Subsequences: A016825, A370115.
%Y A399378 Cf. also A399379, A400154.
%K A399378 nonn,new
%O A399378 1,3
