%N A399390 G.f. A(x) satisfies: A(x) = x + (3/2) * ( A(x)^2 + A(x^2) ).
%t A399390 terms = 25; A[_] = 0; Do[A[x_] = x + (3/2) (A[x]^2 + A[x^2]) + O[x]^terms // Normal, terms]; CoefficientList[A[x], x]
%t A399390 (* Alternative: *)
%t A399390 a[n_?OddQ] := a[n] = 3 Sum[a[k] a[n - k], {k, 1, (n - 1)/2}]; a[n_?EvenQ] := a[n] = 3 (Sum[a[k]*a[n - k], {k, 1, n/2 - 1}] + (1/2) a[n/2] (1 + a[n/2])); a[0] = 0; a[1] = 1; Table[a[n], {n, 0, 24}]
