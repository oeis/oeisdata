%S A399754 121,166,202,355,454,535,588,636,663,778,922,2227,2722,2888,4414,4464,
%T A399754 8883,22522,25222,33633,52222,55055,55955,66636,223222,255555,333339,
%U A399754 333733,555558,888288,1222222,2221222,3444444,6666646,33353333,55555755,66666066,66666668
%N A399754 Near-repdigit Smith numbers.
%C A399754 Near-repdigit numbers (A210666) that are also Smith numbers (A006753).
%H A399754 Michael S. Branicky, <a href="/A399754/b399754.txt">Table of n, a(n) for n = 1..456</a> (all terms with <= 60 digits)
%e A399754 The near-repdigit 55055 is a term since 55055 = 5*7*11^2*13 and 5+5+0+5+5 = 5+7+2*(1+1)+(1+3) = 20.
%t A399754 smithQ[n_] := CompositeQ[n] && Plus @@ (Last[#] * DigitSum[First@ #] & /@ FactorInteger[n]) == DigitSum[n];
%t A399754 seq[lim_] := Select[Sort@ Flatten@ Table[FromDigits /@ Select[Permutations@ PadLeft[{j}, n, i], First[#] != 0 &], {n, 3, IntegerLength[lim]}, {i, 0, 9}, {j, DeleteCases[Range[0, 9], i]}], # <= lim && smithQ[#] &]; seq[66666668] (* _Amiram Eldar_, Sep 16 2026 *)
%o A399754 (Python)
%o A399754 from sympy import factorint
%o A399754 def sd(n):
%o A399754     return sum(map(int, str(n)))
%o A399754 def is_smith(n):
%o A399754     f = factorint(n)
%o A399754     return sum(f.values()) > 1 and sd(n) == sum(e*sd(p) for p, e in f.items())
%o A399754 def near_repdigits(m):
%o A399754     A = set()
%o A399754     for a in range(10):
%o A399754         for b in range(10):
%o A399754             if a == b:
%o A399754                 continue
%o A399754             for j in range(m):
%o A399754                 d = [str(a)]*m
%o A399754                 d[m-1-j] = str(b)
%o A399754                 if d[0] != '0':
%o A399754                     A.add(int(''.join(d)))
%o A399754     return sorted(A)
%o A399754 print([t for m in range(3, 9) for t in near_repdigits(m) if is_smith(t)])
%Y A399754 Intersection of A210666 and A006753.
%Y A399754 Cf. A104166, A164937.
%K A399754 nonn,base,new
