%I A399603 #14 Sep 11 2026 23:55:11
%S A399603 0,144,1444,8649,299825238969
%N A399603 Squares k such that A161351(k) is a square.
%C A399603 Squares k such that k + (product of digits of k) + (sum of digits of k) is a square.
%C A399603 a(6) > 10^15 if it exists.
%e A399603 0 = 0^2, 0 + 0 + 0 = 0 = 0^2.
%e A399603 144 = 12^2, 144 + (1+4+4) + (1*4*4) = 169 = 13^2.
%e A399603 1444 = 38^2, 1444 + (1+4+4+4) + (1*4*4*4) = 1521 = 39^2.
%e A399603 8649 = 93^2, 8649 + (8+6+4+9) + (8*6*4*9) = 10404 = 102^2.
%e A399603 299825238969 = 547563^2, 299825238969 + (2+9+9+8+2+5+2+3+8+9+6+9) + (2*9*9*8*2*5*2*3*8*9*6*9) = 300127569921 = 547839^2.
%p A399603 f:= proc(n) local L;
%p A399603       L:= convert(n,base,10);
%p A399603       n + convert(L,`+`) + convert(L,`*`)
%p A399603 end proc:
%p A399603 select(t -> issqr(f(t)), [seq(i^2,i=0..10^7)]);
%o A399603 (Python)
%o A399603 from math import isqrt, prod
%o A399603 def issquare(n): return isqrt(n)**2 == n
%o A399603 def A161351(n): return n + sum(d:=list(map(int, str(n)))) + prod(d)
%o A399603 def ok(n): return issquare(n) and issquare(A161351(n))
%o A399603 print([k for r in range(10**6) if ok(k:=r**2)]) # _Michael S. Branicky_, Sep 06 2026
%Y A399603 Cf. A161351, A399441, A399604, A399606, A399608.
%K A399603 nonn,base,more,new
%O A399603 1,2
%A A399603 _Robert Israel_, Sep 04 2026
