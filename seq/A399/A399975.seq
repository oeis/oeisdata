%S A399975 1,70,140,280,350,490,560,646,700,980,1120,1292,1400,1750,1798,1960,
%T A399975 2145,2240,2450,2584,2800,3430,3500,3526,3596,3920,4480,4900,5168,
%U A399975 5600,5865,6006,6435,6860,7000,7052,7192,7840,8750,8960,9177,9800,10336,10725,10982
%N A399975 Numbers k whose binary XOR of their distinct prime divisors is 0.
%C A399975 Numbers k such that A293212(k) = 0, along with 1 for which A293212 is undefined.
%H A399975 Žiga Pirc, <a href="/A399975/b399975.txt">Table of n, a(n) for n = 1..10000</a>
%e A399975 70 is a term since its prime factors are 2, 5 and 7. Written in binary 10, 101 and 111. XOR of them is 0.
%p A399975 q:= proc(n) local d, r; r:=0; for d in numtheory
%p A399975       [factorset](n) do r:= Bits[Xor](r, d) od; is(r=0)
%p A399975     end:
%p A399975 select(q, [$2..11000])[];  # _Alois P. Heinz_, Sep 22 2026
%o A399975 (PARI)
%o A399975 isok(n) = my(vp = factor(n)[, 1]~, k=0); for (i=1, #vp, k = bitxor(k, vp[i])); k==0
%Y A399975 Cf. A072595, A293212.
%K A399975 nonn,base,new
%O A399975 1,2
