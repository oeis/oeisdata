%I A399963 #9 Sep 17 2026 08:49:53
%S A399963 42,903,18205,494711,256289,5697341,24529759,105360757,14023813,
%T A399963 17566837,557702927,60791851,46325039,110684881,5307511331,321608081,
%U A399963 3499706953,7997054189,1948989197,16492639771,4108072883,1254328741,3458305639,2537983541,17085389201,142824894769
%N A399963 Smallest number of the form p*q*r with primes p,q,r, where p = prime(n), q == 1 (mod p), and r == 1 (mod p*q).
%C A399963 a(n) exists for all n by Dirichlet's theorem on arithmetic progressions.
%C A399963 There are prime(n) + 4 groups of order a(n); see A000001.
%C A399963 The second prime factor of a(n) first differs from A035095(n) (the smallest prime congruent to 1 modulo prime(n)) at n = 32: we have prime(32) = 131 and A035095(32) = 263, but a(32) = 85032034369 = 131*787*824777. Indeed, if a(32) were divisible by 131*263 then we would have a(32) = 131*263*2480617 = 85464697501 > 85032034369.
%H A399963 Jianing Song, <a href="/A399963/b399963.txt">Table of n, a(n) for n = 1..10000</a>
%H A399963 Jianing Song, <a href="/A399963/a399963.txt">Factorization of a(n) for n = 1..10000</a>.
%o A399963 (PARI) a(n) = {
%o A399963 if(n==1, return(42));
%o A399963 \\ find a candidate
%o A399963 my(p=prime(n), q0=1, r0=1, can);
%o A399963 while(!isprime(q0), q0+=2*p);
%o A399963 while(!isprime(r0), r0+=2*p*q0);
%o A399963 can=p*q0*r0;
%o A399963 \\ If p and q are the two smallest prime factors of a(n), then p*q*(2*p*q+1) <= can
%o A399963 my(v=[], bound_pq=(-1+sqrtint(8*can+1))\4);
%o A399963 forstep(q=1, bound_pq\p, 2*p, if(isprime(q), v=concat(v,p*q)));
%o A399963 \\ For every possible p*q find the smallest r
%o A399963 for(i=1, #v, r0=1; while(!isprime(r0), r0+=2*v[i]); v[i]*=r0);
%o A399963 return(vecmin(v));
%o A399963 }
%Y A399963 Cf. A000001, A035095.
%K A399963 nonn,new
%O A399963 1,1
%A A399963 _Jianing Song_, Sep 17 2026
