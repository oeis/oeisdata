%S A399608 101,103,127,131,139,149,151,163,167,181,191,193,197,239,251,307,317,
%T A399608 331,353,367,373,379,433,439,457,479,491,509,523,541,569,571,587,613,
%U A399608 617,631,653,677,691,701,733,739,757,773,787,811,877,919,941,967,971,991,1009,1049,1061,1087,1229,1289
%N A399608 Primes p such that A161351(p) is a prime.
%C A399608 Primes p such that p + (sum of digits of p) + (product of digits of p) is a prime.
%C A399608 p has either an even number of odd digits and at least one even digit, or an odd number of odd digits and no even digits.
%H A399608 Robert Israel, <a href="/A399608/b399608.txt">Table of n, a(n) for n = 1..10000</a>
%e A399608 a(3) = 127 a term because 127 is prime and 127 + (1+2+7) + (1*2*7) = 151 is prime.
%p A399608 f:= proc(n) local L;
%p A399608       L:= convert(n, base, 10);
%p A399608       n + convert(L, `+`) + convert(L, `*`)
%p A399608 end proc:
%p A399608 select(t -> isprime(t) and isprime(f(t)), [2,seq(i,i=3..2000,2)]);
%o A399608 (Python)
%o A399608 from math import prod
%o A399608 from sympy import isprime
%o A399608 def A161351(n): return n + sum(d:=list(map(int, str(n)))) + prod(d)
%o A399608 def ok(n): return isprime(n) and isprime(A161351(n))
%o A399608 print([k for k in range(1300) if ok(k)]) # _Michael S. Branicky_, Sep 06 2026
%Y A399608 Cf.  A161351, A267277, A399442, A399603, A399604, A399606.
%K A399608 nonn,base,new
%O A399608 1,1
%A A399608 _Robert Israel_, Sep 04 2026
