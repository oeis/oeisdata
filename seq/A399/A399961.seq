%I A399961 #13 Sep 30 2026 17:27:07
%S A399961 2,6,42,90,171,234,450,630,792,3060,3222,3438,8622,12078,14094,16686,
%T A399961 63342,71118,72126,75150,78300,81324,84780,133164,137052,140832,
%U A399961 144288,199584,666144,759456,2120256,2124576,2215296,2273616,2355264,2549664,4415904,4493664
%N A399961 Trajectory of 2 under the map x -> x + (sum of decimal digits of x)*(product of nonzero decimal digits of x).
%C A399961 Let s(x) be the sum of the decimal digits of x and p(x) the product of its nonzero decimal digits. Then s(x)*p(x) = A062331(x).
%C A399961 Distinct starting values can coalesce with this trajectory. For example, 1 -> 2, 3 -> 12 -> 18 -> 90, and 9 -> 90. Once two trajectories meet, they remain identical thereafter because the map is deterministic.
%F A399961 a(1) = 2; a(n+1) = a(n) + A062331(a(n)) for n >= 1.
%e A399961 The digits of a(3) = 42 have sum 4+2 = 6 and nonzero digit product 4*2 = 8. Therefore a(4) = 42 + 6*8 = 90.
%e A399961 For a(4) = 90, the digit sum is 9 and the nonzero digit product is 9, since zero is ignored. Therefore a(5) = 90 + 9*9 = 171.
%t A399961 f[n_] := Module[{d = IntegerDigits[n]}, n + Total[d]*Times @@ Select[d, # > 0 &]]; NestList[f, 2, 37] (* _Amiram Eldar_, Sep 17 2026 *)
%o A399961 (Python)
%o A399961 from math import prod
%o A399961 def a(n):
%o A399961     x = 2
%o A399961     for _ in range(n-1):
%o A399961         d = list(map(int, str(x)))
%o A399961         x += sum(d)*prod(y for y in d if y != 0)
%o A399961     return x
%o A399961 print([a(n) for n in range(1, 40)])
%Y A399961 Cf. A007953, A051801, A062331.
%K A399961 base,nonn,new
%O A399961 1,1
