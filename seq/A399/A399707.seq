%I A399707 #20 Oct 19 2026 00:26:11
%S A399707 2,11,23,59,431,239,5279,2879,1439,7559,22679,37799,126719,100799,
%T A399707 55439,453599,191519,166319,514079,665279,1542239,2827439,907199,
%U A399707 3326399,831599,7197119,4989599,6320159,7900199,5266799,6486479,11531519,8315999,21288959,17463599
%N A399707 a(n) is the least prime p such that there are exactly n numbers k such that A075254(k) = p.
%C A399707 a(n) is the least prime p such that there are exactly n numbers k such that k + the sum of its prime factors, counted by multiplicity, is p.
%e A399707 a(3) = 59 because there are 3 numbers k such that k + (sum of the prime factors of k) = 59, namely 38, 44, 48: 38 + 2 + 19 = 44 + 2 + 2 + 11 = 48 + 2 + 2 + 2 + 2 + 3 = 59, and no prime < 59 works.
%p A399707 R:= Array(0..30): R[0]:= 2:
%p A399707 P:= select(isprime,[seq(i, i=3..10^7,2)]):
%p A399707 for x from 1 to 10^7 do
%p A399707  v:= x + add(t[1]*t[2], t = ifactors(x)[2]);
%p A399707  if ListTools:-BinarySearch(P,v) <> 0 then
%p A399707    if assigned(V[v]) then V[v]:= V[v]+1 else V[v]:= 1 fi;
%p A399707  fi;
%p A399707 od:
%p A399707 for p in P do
%p A399707 if assigned(V[p]) and V[p] <= 30 and R[V[p]] = 0 then R[V[p]]:= p fi
%p A399707 od:
%p A399707 convert(R,list);
%Y A399707 Cf. A050703, A050778, A075254, A400780.
%K A399707 nonn,changed
%O A399707 0,1
%A A399707 _Will Gosnell_ and _Robert Israel_, Oct 06 2026
