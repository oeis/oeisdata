%S A399622 721,5327,11089,12059,13081,14111,14579,16081,17879,18599,20401,21421,
%T A399622 27433,46921,52199,56759,78719,78863,79343,86567,87457,89881,90541,
%U A399622 92281,97201,98471,104279,115033,135889,147599,219479,221761,235619,289223,311809,313489,323423
%N A399622 Semiprimes N = p*q with 5 < p < q such that N is the largest vertex of a directed cycle of length >= 3 in the digraph on all such semiprimes, with an arc N -> M iff M is also such a semiprime and M is one of N-(p+q), N-(q-p), N+(q-p), N+(p+q).
%C A399622 The vertices of the digraph are the semiprimes p*q with 5 < p < q. It is not required that all four values N-(p+q), N-(q-p), N+(q-p), N+(p+q) be semiprimes; a value that is not a vertex gives no arc. Terms are the semiprimes that are the largest vertex of at least one directed cycle of length >= 3.
%H A399622 Bruno Paiva Viana, <a href="/A399622/b399622.txt">Table of n, a(n) for n = 1..391</a>
%e A399622 a(1) = 721 = 7*103 is the largest vertex of the cycle 671 -> 721 -> 611 -> 671, where 671 = 11*61 and 611 = 13*47: 671+(61-11) = 721, 721-(7+103) = 611, 611+(13+47) = 671.
%o A399622 (Python)
%o A399622 from sympy import factorint
%o A399622 import networkx as nx
%o A399622 def A(limit):
%o A399622     f = {}
%o A399622     for n in range(77, limit+1):
%o A399622         d = factorint(n)
%o A399622         if len(d) == 2 and all(e == 1 for e in d.values()) and min(d) > 5:
%o A399622             f[n] = sorted(d)
%o A399622     G = nx.DiGraph(); G.add_nodes_from(f)
%o A399622     for n, (p, q) in f.items():
%o A399622         for m in (n-p-q, n-q+p, n+q-p, n+p+q):
%o A399622             if m in f: G.add_edge(n, m)
%o A399622     top = set()
%o A399622     for c in nx.simple_cycles(G):
%o A399622         if len(c) >= 3: top.add(max(c))
%o A399622     return sorted(top)
%o A399622 print(A(330000))
%K A399622 nonn,new
%O A399622 1,1
%A A399622 _Bruno Paiva Viana_, Oct 03 2026
