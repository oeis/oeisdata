%p A399332 # Using function 'binomial_matrix' from A399000.
%p A399332 a := n-> ifelse(n=0, 1, abs(2^n*(euler(n,1/2) + euler(n,1)))):
%p A399332 BM := binomial_matrix(a):
%p A399332 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A399332 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%t A399332 (* Uses the function 'binomialMatrix' from A399000. *)
%t A399332 bM = binomialMatrix[If[# == 0, 1, 2^#*Abs[EulerE[#, 1/2] + EulerE[#, 1]]] &];
%t A399332 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A399332 (Python)  # Using function 'binomial_matrix' from A399000.
%o A399332 from sympy import euler
%o A399332 M = binomial_matrix(lambda n: 1 if n == 0 else abs(int(2**n * (euler(n, 1/2) + euler(n, 1)))))
%o A399332 for n in range(9): print([M(n, k) for k in range(9)])
