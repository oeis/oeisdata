%I A399090 #10 Aug 21 2026 06:19:02
%S A399090 0,1,1,2,1,1,1,2,1,1,2,1,1,1,4,1,2,1,2,1,1,1,2,1,2,1,1,1,1,1,1,2,1,1,
%T A399090 1,1,1,1,2,2,1,1,4,2,2,1,2,1,1,1,1,1,2,1,1,2,6,1,1,1,2,1,1,1,1,1,2,2,
%U A399090 1,1,1,4,4,1,1,2,1,1,1,1,2,1,2,1,1,1,1,2
%N A399090 The maximum exponent in the prime factorization of the numbers whose powerful part is a square (A335275).
%C A399090 First differs from A369933 at n = 57.
%C A399090 a(n) = A374327(n-1) for 2 <= n <= 56.
%C A399090 All the terms are either 1 or even.
%H A399090 Amiram Eldar, <a href="/A399090/b399090.txt">Table of n, a(n) for n = 1..10000</a>
%F A399090 a(n) = A051903(A335275(n)).
%F A399090 Asymptotic mean: Limit_{m->oo} (1/m) * Sum_{k=1..m} a(k) = 2 - 1/A335762 + 2 * Sum_{k>=1} (1 - c(k)) = 1.4556948182558102783009..., where c(k) = Product_{p prime} (1 + 1/((p^3+p^2-1)*(-p)^(2*k-1))).
%t A399090 f[n_] := Module[{e = FactorInteger[n][[;; , 2]]}, If[AllTrue[e, # == 1 || EvenQ[#] &], Max @@ e, Nothing]]; f[1] = 0; Array[f, 100]
%o A399090 (PARI) list(kmax) = {my(e); print1(0, ", "); for(k = 2, kmax, e = factor(k)[, 2]; if(#select(x -> x > 1 && x%2, e) == 0, print1(vecmax(e), ", ")));}
%Y A399090 Cf. A051903, A057521, A335275, A335762, A368711, A369933, A374327.
%K A399090 nonn,easy,new
%O A399090 1,4
%A A399090 _Amiram Eldar_, Aug 18 2026
