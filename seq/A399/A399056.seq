%T A399056 300,331,366,397,432,471,510,549,592,637,680,727,774,825,876,931,988,
%U A399056 1041,1098,1155,1216,1283,1346,1413,1478,1551,1620,1687,1766,1845,1918,1991
%N A399056 a(n) = (number of nonprimes <= n^2) - (number of primes <= n^2).
%H A399056 Paolo Xausa, <a href="/A399056/b399056.txt">Table of n, a(n) for n = 1..10000</a>
%H A399056 Nicolay Avilov, <a href="/A399056/a399056.jpg">Illustration of the first terms of the sequence</a>
%F A399056 a(n) = A078435(n) - A038107(n).
%F A399056 a(n) = A097454(n^2) = n^2 - 2*A000720(n^2).
%e A399056 a(5) = 16 - 9 = 7, because the first 25 numbers contain 16 nonprimes and 9 primes.
%p A399056 a:= n-> n^2-2*numtheory[pi](n^2):
%p A399056 seq(a(n), n=1..53);  # _Alois P. Heinz_, Aug 17 2026
%t A399056 A399056[n_] := n^2 - 2*PrimePi[n^2]; Array[A399056, 60] (* _Paolo Xausa_, Aug 20 2026 *)
