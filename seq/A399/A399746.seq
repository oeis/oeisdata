%T A399746 9867735,32230466,95035131,313085301,1013493516,3007596598,9934910599,
%U A399746 31872998957,95195353237,315297794421,1002473668362,3013509494324,10007674898304,31533460566532,95409122278854
%N A399746 Number of n-digit Proth numbers.
%H A399746 Chai Wah Wu, <a href="/A399746/b399746.txt">Table of n, a(n) for n = 1..1999</a>
%e A399746 3, 5, 9, are 3 Proth numbers with 1 digit. Therefore a(1) = 3.
%o A399746 (PARI) a(n)=my(A=10^(n-1), B=10*A-1, s=0);for(k=1, logint(B,2)+1,my(lo = ceil((A-1)/2^k),hi = floor((B-1)/2^k));hi = min(hi, 2^k - 1);if(lo <= hi,s += ((hi+1)\2 - lo\2)));s
%o A399746 (Python)
%o A399746 def A399746(n):
%o A399746     def f(x): return sum(min((x-1>>i)+1,1<<i)>>1 for i in range(1,(x-1).bit_length()))
%o A399746     return f(10**n-1)-f(10**(n-1)-1)
%Y A399746 Cf. A080075, A080076, A398340.
