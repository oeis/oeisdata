%I A399075 #12 Aug 18 2026 10:14:26
%S A399075 0,0,0,1,1,1,4,4,5,10,11,14,23,27,33,47,56,69,93,111,134,172,204,246,
%T A399075 307,363,432,528,621,734,882,1032,1211,1436,1672,1948,2290,2652,3072,
%U A399075 3579,4124,4754,5499,6309,7236,8322,9508,10857,12421,14134,16077,18306,20757
%N A399075 G.f.: (Sum_{k>=1} x^(3*k)/(1 - x^(3*k))) * Product_{k>=1} (1 + x^k).
%H A399075 Vaclav Kotesovec, <a href="/A399075/b399075.txt">Table of n, a(n) for n = 0..10000</a>
%F A399075 a(n) = Sum_{k=1..n/3} A000005(k)*A000009(n-3*k).
%F A399075 a(n) ~ 3^(1/4) * (2*gamma + log(4*n/(3*Pi^2))) * exp(Pi*sqrt(n/3)) / (12*Pi*n^(1/4)), where gamma is the Euler-Mascheroni constant A001620.
%t A399075 nmax = 60; CoefficientList[Series[Sum[x^(3*k)/(1-x^(3*k)), {k, 1, nmax}] * Product[1 + x^k, {k, 1, nmax}], {x, 0, nmax}], x]
%t A399075 (* Alternative: *)
%t A399075 Table[Sum[DivisorSigma[0, k]*PartitionsQ[n-3*k], {k, 1, n/3}], {n, 0, 60}]
%Y A399075 Cf. A305082, A090867, A341496.
%Y A399075 Cf. A006128, A066898, A116635, A399074.
