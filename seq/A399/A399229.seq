%I A399229 #14 Sep 10 2026 23:59:55
%S A399229 4,8,8,13,5,21,10,13,16,18,4,23,10,10,18,17,8,34,14,11,16,24,14,43,19,
%T A399229 14,27,18,12,25,13,17,16,31,7,35,21,13,19,46,8,32,15,18,27,28,11,29,
%U A399229 24,11,30,23,8,38,24,18,27,29,12,47,22,23,15,39,13,44
%N A399229 a(n) is the number of periodic points under iteration of x -> s(x^n) on the positive integers, where s is the decimal digit sum.
%C A399229 a(n) is equal to the sum of the lengths of all cycles and where fixed points are considered periodic points of period 1.
%C A399229 For each n, all cycles of the map are contained in the finite interval {1, ..., 9*n*D(n)}, where D(n) is the largest positive integer k such that 10^(k-1) <= 9*n*k.
%H A399229 Helmuth Haslacher, <a href="/A399229/b399229.txt">Table of n, a(n) for n = 2..500</a>
%F A399229 a(n) >= A398119(n) + A398120(n).
%F A399229 a(n) >= A398121(n).
%e A399229 a(2) = 4 because the periodic points are the fixed points (1) and (9), together with the 2-cycle (13, 16), giving 1 + 1 + 2 = 4.
%o A399229 (Python)
%o A399229 def cycles(n):
%o A399229     # bound: largest D with 10^(D-1) <= 9*n*D (see Comments)
%o A399229     D = 1
%o A399229     while 10**D <= 9*n*(D+1):
%o A399229         D += 1
%o A399229     M = 9*n*D
%o A399229     f = [0] + [sum(map(int, str(x**n))) for x in range(1, M+1)]
%o A399229     color, cyc = [0]*(M+1), []
%o A399229     for start in range(1, M+1):
%o A399229         path, x = [], start
%o A399229         while color[x] == 0:
%o A399229             color[x] = 1; path.append(x); x = f[x]
%o A399229         if color[x] == 1:
%o A399229             cyc.append(path[path.index(x):])
%o A399229         for y in path: color[y] = 2
%o A399229     return cyc
%o A399229 def a(n): return sum(len(c) for c in cycles(n))
%Y A399229 Cf. A007953, A398119, A398120, A398121.
%K A399229 nonn,base,new
%O A399229 2,1
%A A399229 _Helmuth Haslacher_, Aug 23 2026
