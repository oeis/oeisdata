%I A399227 #33 Sep 01 2026 21:50:55
%S A399227 6,5,28,9,22,13,60,17,38,336,92,25,54,29,496,264,280,37,156,41,86,90,
%T A399227 376,49,204,53,220,456,118,61,504,130,134,1104,284,73,300,1232,632,81,
%U A399227 166,170,348,89,728,5952,380,97,396,101,412,3360,214,109,444,113,920
%N A399227 a(n) = (2*n-1)*2^(w(2*n-1)-1) where w(m) = v_2(usigma(m)) = A007814(A034448(m)) for odd m.
%C A399227 Contains all even perfect numbers (A000396), all unitary perfect numbers (A002827) and all prime powers congruent to 1 modulo 4 (A016813). The entry a(n) coincides with A219931(n) if and only if 2*n-1 is a prime power and n is not contained in A385054.
%C A399227 Offset is 2 because a(1) = 1/2 is not an integer.
%C A399227 If a(n) and a(n') are coprime away from 2 then 2*a(n)*a(n') = a(n*n'+(n-1)*(n'-1)).
%H A399227 Paolo Xausa, <a href="/A399227/b399227.txt">Table of n, a(n) for n = 2..10000</a>
%F A399227 a(n) = (2*n-1)*2^(v_2(usigma(2*n-1))-1).
%e A399227 a(2) = 3*2 = 6 since w(3) = 2;
%e A399227 a(4) = 7*4 = 28 since w(7) = 3;
%e A399227 a(16) = 31*16 = 496 since w(31) = 5;
%e A399227 a(8) = 15*4 = 60 since w(3)+w(5) = 3;
%e A399227 a(23) = 45*2 = 90 since w(5)+w(9) = 2.
%t A399227 A399227[n_] := #*2^(IntegerExponent[Times @@ (Power @@@ FactorInteger[#] + 1), 2] - 1) & [2*n - 1];
%t A399227 Array[A399227, 100, 2] (* _Paolo Xausa_, Sep 01 2026 *)
%o A399227 (Python)
%o A399227 from sympy import factorint, multiplicity
%o A399227 def a(n): return (2*n-1)*2**(sum(multiplicity(2,p**k+1) for p,k in factorint(2*n-1).items())-1)
%o A399227 print([a(n) for n in range(2,59)])
%o A399227 (PARI) usigma(n) = sumdivmult(n,d,if(gcd(d,n/d)==1,d));
%o A399227 a(n) = (2*n-1)*2^(valuation(usigma(2*n-1), 2)-1); \\ _Michel Marcus_, Aug 24 2026
%Y A399227 Cf. A000396, A002827, A016813, A219931, A385054.
%Y A399227 Cf. A034448, A000265, A007814.
%K A399227 nonn,easy,new
%O A399227 2,1
