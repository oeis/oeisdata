%S A399195 2,2,0,0,240,5587240,3658874167836272,
%T A399195 8439542775354564574005569874384384,
%U A399195 319091956672498333326706685356890596380731873488984606070796247387891712
%N A399195 Number of inequivalent self-dual Boolean functions of n variables with trivial automorphism group under permutations of the variables.
%C A399195 A self-dual Boolean function satisfies f(x) = 1 - f(\bar{x}), where \bar{x} is the coordinatewise complement of x. The automorphism group is the stabilizer under permutations of the variables. Values are obtained by Mobius inversion over subgroups of S_n. For H <= S_n, if n is odd the number of H-fixed self-dual functions is 2^(o(H)/2), where o(H) is the number of H-orbits on {0,1}^n. For even n this number is 0 if some H-orbit contains both x and \bar{x}; otherwise it is 2^(o(H)/2).
%D A399195 Vladeta Jovovic, Boolean functions with prescribed automorphism groups, unpublished manuscript, 1986.
%H A399195 Vladeta Jovovic, <a href="/A399195/b399195.txt">Table of n, a(n) for n = 1..13</a>
%H A399195 Vladeta Jovovic, <a href="/A399195/a399195.pdf">Asymmetric self-dual Boolean functions</a>
%F A399195 a(n) = (1/n!)*Sum_{H <= S_n} mu({1},H)*F_n(H), where F_n(H) be the number of self-dual Boolean functions fixed by H <= S_n and mu is the Mobius function of the subgroup lattice of S_n.
%F A399195 If n is odd, F_n(H) = 2^(o(H)/2), where o(H) is the number of H-orbits on {0,1}^n.
%F A399195 If n is even, F_n(H) = 0 when an H-orbit contains both x and \bar{x}; otherwise F_n(H) = 2^(o(H)/2).
%o A399195 (Python)
%o A399195 from itertools import permutations
%o A399195 from math import factorial
%o A399195 def a(n):
%o A399195     N=1<<n; M=N-1
%o A399195     P=[x for x in range(N) if x<(M^x)]
%o A399195     A=[]
%o A399195     for p in permutations(range(n)):
%o A399195         q=[]
%o A399195         for x in range(N):
%o A399195             y=0
%o A399195             for i in range(n):
%o A399195                 if (x>>i)&1: y|=1<<p[i]
%o A399195             q.append(y)
%o A399195         A.append(q)
%o A399195     c=0
%o A399195     for s in range(1<<len(P)):
%o A399195         f=[0]*N
%o A399195         for j,x in enumerate(P):
%o A399195             b=(s>>j)&1
%o A399195             f[x]=b; f[M^x]=1-b
%o A399195         if all(not all(f[q[x]]==f[x] for x in range(N)) for q in A[1:]): c+=1
%o A399195     return c//factorial(n)
%o A399195 print([a(n) for n in range(1,6)])
%o A399195 # [2, 2, 0, 0, 240]
%Y A399195 Cf. A001531.
