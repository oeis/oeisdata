%N A399149 G.f.: (Sum_{k>=1} x^(k^2)/(1 - x^(k^2))) * Product_{k>=1} (1 + x^k).
%H A399149 Vaclav Kotesovec, <a href="/A399149/b399149.txt">Table of n, a(n) for n = 0..10000</a>
%F A399149 a(n) = Sum_{k=1..n} A046951(k)*A000009(n-k).
%F A399149 a(n) ~ exp(Pi*sqrt(n/3)) * (Pi/(4*3^(3/4)*n^(1/4)) + zeta(1/2)/(2^(5/2)*sqrt(n))).
%t A399149 nmax = 60; CoefficientList[Series[Sum[x^(k^2)/(1-x^(k^2)), {k, 1, Floor[nmax^(1/2)]+1}] * Product[1+x^k, {k, 1, nmax}], {x, 0, nmax}], x]
