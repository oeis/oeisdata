%e A399000 Illustrating the algorithm: Assume the given 3 X 3 matrix. First, compute a(3) = 5 and place it at the lower end of the diagonal. Add a new row starting from there, adding the entry on the left in the row above and repeat this until reaching the first column: 5 + 2 -> 7 + 3 -> 10 + 5 -> 15. Next, add a new column, starting again at the new diagonal term, and subtract the term in the previous row to its left; repeat this up to the first row: 5 - 2 -> 3 - 1 -> 2 - 1 = 1.
%e A399000    1   0   1  |  1
%e A399000    2   1   1  |  2
%e A399000    5   3   2  |  3
%e A399000    - - - - - - - -
%e A399000   15  10   7  |  5
%p A399000 binomial_matrix := proc(f::procedure) :: procedure;
%p A399000     proc(n::integer, k::integer) :: rational;
%p A399000         local s, d, p, m;
%p A399000         s := `if`(k <= n, 1, -1);
%p A399000         d := abs(n - k);
%p A399000         p := min(n, k);
%p A399000         add(binomial(d, m) * s^(d - m) * f(p + m), m = 0..d);
%p A399000     end proc;
%p A399000 end proc:
%p A399000 BM := binomial_matrix(n -> binomial(2*n, n) / (n + 1)):
%p A399000 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%t A399000 binomialMatrix[seq_][n_Integer, k_Integer] := Module[{s, d, p},
%t A399000     s = If[k <= n, 1, -1];
%t A399000     d = Abs[n - k];
%t A399000     p = Min[n, k];
%t A399000     Sum[Binomial[d, m] s^(d - m) seq[p + m], {m, 0, d}] ]
%t A399000 bM = binomialMatrix[CatalanNumber];
%t A399000 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A399000 (Python)
%o A399000 from math import comb as binomial
%o A399000 from collections.abc import Callable
%o A399000 def binomial_matrix(seq: Callable[[int], int]) -> Callable[[int, int], int]:
%o A399000     def term(n: int, k: int) -> int:
%o A399000         s = 1 if k <= n else -1
%o A399000         d = abs(n - k)
%o A399000         p = min(n, k)
%o A399000         S = sum(binomial(d, m) * s ** (d - m) * seq(p + m)
%o A399000             for m in range(d + 1))
%o A399000         return S
%o A399000     return term
%o A399000 M = binomial_matrix(lambda n: binomial(2 * n, n) // (n + 1))
%o A399000 for n in range(9): print([M(n, k) for k in range(9)])
