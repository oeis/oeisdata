%I A399636 #61 Oct 26 2026 18:26:47
%S A399636 1,1,2,5,16,62,286,1542,9584,67832,540824,4810720,47330152,511071992,
%T A399636 6015222448,76698420008,1053709151616,15522061626304,244115332925248,
%U A399636 4082998535885248,72376305956072576,1355475359463305984,26744895746076862336,554542255876176765824
%N A399636 Number of weighted permutations of [n], where cycles are given weights 1, 1, 1/2, 1/3, 1/4, 1/5 ... .
%H A399636 Alois P. Heinz, <a href="/A399636/b399636.txt">Table of n, a(n) for n = 0..451</a>
%F A399636 a(n) = n! * Z(S_n; 1, 1, 1/2, 1/3, 1/4, ...), where Z(S_n) is the cycle index of S_n.
%F A399636 E.g.f.: exp(2*x)/(1-x)^(x-1).
%F A399636 From _Natalia L. Skirrow_, Oct 16 2026: (Start)
%F A399636 a(n) = Sum_{k=0..n} C(n,k)*2^k*(-1)^(n-k)*A005727(n-k).
%F A399636 a(n) = Sum_{0<=k<=j<=n} C(n,j)*(-1)^j*A008296(j,k)*2^(n-j).
%F A399636 a(n) = (n-2)! * e^2 * (1 + (2*H(n-3)+1)/(n-2) + O(log(n)^2/n^2)), where H(n) = A001008(n)/A002805(n).
%F A399636 (End)
%e A399636 a(3) = 5: There are 3! = 6 permutations of [3], four with weight 1: (1)(2)(3), (1)(23), (13)(2), (12)(3) and two with weight 1/2: (123), (132). The total sum of weights is 5.
%p A399636 a:= proc(n) option remember; `if`(n=0, 1, a(n-1)+
%p A399636       add(a(n-j)*binomial(n-1, j-1)*(j-2)!, j=2..n))
%p A399636     end:
%p A399636 seq(a(n), n=0..23);  # _Alois P. Heinz_, Oct 12 2026
%o A399636 (PARI) {a(n)=my(x='x+O('x^(n+1))); Vec(serlaplace(exp(2*x)*(1-x)^(1-x)))}
%o A399636 (PARI) {a(n)=my(z='z+O('z^(n+1))); n!*polcoeff(exp(2*z)*(1-z)^(1-z), n)}
%o A399636 (Python)
%o A399636 from functools import cache
%o A399636 a=cache(lambda n: int(n<2) or a(n-1)+(c:=n-1)*a(n-2)+sum((c:=c*(n-j+1))//(j-1)*a(n-j) for j in range(3,n+1)))
%o A399636 print([a(n) for n in range(24)]) # _Natalia L. Skirrow_, Oct 16 2026, after _Alois P. Heinz_
%Y A399636 Binomial transform of A203852.
%Y A399636 Cf. A001008/A002805, A005727, A008296.
%K A399636 nonn,new
%O A399636 0,3
%A A399636 _Nicolae Boicu_, Oct 10 2026
