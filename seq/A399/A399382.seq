%N A399382 a(n) is the minimum positive integer k such that k*n+1 is squarefree.
%C A399382 a(n) >= A007424(n+1). In fact, a(n) = A007424(n+1) = 1 if n+1 is squarefree.
%C A399382 It appears that a(n-1) = A399381(n+1) for many values of n > 1. a(n-1) <= A399381(n+1) until a(24) = 3 > 2 = A399381(26).
%C A399382 Here are the first occurrences of values in this sequence, according to the Java program: a(1) = 1, a(3) = 2, a(24) = 3, a(49) = 4, a(6137) = 5, a(887) = 6, a(60923) = 7, a(142549) = 8. 8 is the maximum value of a(n) for n <= 1000000.
%C A399382 a(n) exists for all n. For all k > 0, there is some n such that a(n) = k. - _Charles R Greathouse IV_, Aug 28 2026
%H A399382 Aidan Markey, <a href="/A399382/b399382.txt">Table of n, a(n) for n = 1..10000</a>
%e A399382 a(7) = 2 because 1*7+1 = 8 is not squarefree, but 2*7+1 = 15 is squarefree.
%o A399382 (Java)
%o A399382 public class Program {
%o A399382     public static void main(String[] args) {
%o A399382         for (int n = 1; n <= 100; n++) {
%o A399382             int a = 1;
%o A399382             while (true) {
%o A399382                 if (squarefree(n * a + 1)) {
%o A399382                     System.out.println(a);
%o A399382                     break;
%o A399382                 }
%o A399382                 a++;
%o A399382             }
%o A399382         }
%o A399382     }
%o A399382     public static boolean squarefree(int n) {
%o A399382         if (n <= 0) return false;
%o A399382         for (int d = 2; d * d <= n; d++) {
%o A399382             if (n % (d * d) == 0) return false;
%o A399382         }
%o A399382         return true;
%o A399382     }
%o A399382 }
%o A399382 (PARI) a(n) = my(k=1); while (!issquarefree(k*n+1), k++); k; \\ _Michel Marcus_, Aug 28 2026
