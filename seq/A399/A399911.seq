%S A399911 1,2,2,4,2,8,4,8,4,12,6,32,4,16,8,32,2,32,4,48,32,24,4,128,8,32,8,64,
%T A399911 2,384,2,128,48,16,32,1024,4,32,16,768,16,768,8,96,32,64,8,1024,16,
%U A399911 256,32,384,2,128,48,512,48,32,2,12288,8,32,512,512,64,1536
%N A399911 Number of divisors of 3^n - 2^n.
%C A399911 Let I[x] denote the set of polynomials p = p(x) all of whose coefficients are integers. For p(x) in I[x], denote by f(x,i), for i=1..m, the irreducible divisors in I[x] of p(x). Let c be an integer.  The numbers f(c,i), together with 1, are here called type 1 (p,c)-divisors of p(c).  The products of two or more of the numbers f(c,i) that are divisors of p(c) are type 2 (p,c)-divisors of p(c); and all other divisors of p(c) are type 3 (p,c)-divisors. These definitions generalize naturally to polynomials in more than 1 variable. (See A398834 for examples.)
%C A399911 For this sequence, the a(n) divisors of 3^n - 2^n, for selected values of n are partitioned into the 3 types as shown below. Note that primes can occur in both types 1 or 3, or both, depending on n.
%C A399911 n   type 1          type 2                type 3
%C A399911 1   1               none                  none
%C A399911 2   1,5             none                  none
%C A399911 3   1,19            none                  none
%C A399911 4   1,5,13          65                    none
%C A399911 5   1,211           none                  none
%C A399911 6   1,5,7,19        35,95,133,665         none
%C A399911 10  1,5,55,211      275,1055,11605,58025  11,25,2321,5275
%C A399911 See A398834 for a guide to related sequences.
%F A399911 a(n) = A000005(A001047(n)).
%t A399911 {x, y} = {3,2}; p[n_] := p[n] = (x^n - y^n)/(x - y);
%t A399911 Table[DivisorSigma[0, p[n]], {n, 1, 100}]
%Y A399911 Cf. A001047, A398834.
%K A399911 nonn,new
%O A399911 1,2
%A A399911 _Clark Kimberling_, Oct 22 2026
