%I A399375 #10 Sep 11 2026 15:33:35
%S A399375 3,7,15,27,31,39,51,55,57,63,87,95,99,111,115,117,119,123,127,159,183,
%T A399375 195,207,215,219,231,235,237,243,249,255,287,303,319,327,335,351,387,
%U A399375 399,415,417,423,447,455,465,471,477,483,489,495,497,501,505,507,511,519,543,575,591,639,655,671,687,703,711,735
%N A399375 Odd numbers k for which A348717(A163511(k)) <= A348717(k).
%C A399375 It is conjectured that the equivalence is attained only with Mersenne primes (A000668). This is equivalent to the conjecture given in A364297.
%H A399375 Antti Karttunen, <a href="/A399375/b399375.txt">Table of n, a(n) for n = 1..10000</a>
%H A399375 <a href="/index/Bi#binary">Index entries for sequences related to binary expansion of n</a>.
%H A399375 <a href="/index/Pri#prime_indices">Index entries for sequences related to prime indices in the factorization of n</a>.
%o A399375 (PARI)
%o A399375 A163511(n) = if(!n, 1, my(p=2, t=1); while(n>1, if(!(n%2), (t*=p), p=nextprime(1+p)); n >>= 1); (t*p));
%o A399375 A348717(n) = if(1==n, 1, my(f = factor(n), k = primepi(f[1, 1])-1); for (i=1, #f~, f[i, 1] = prime(primepi(f[i, 1])-k)); factorback(f));
%o A399375 A364297(n) = A348717(A163511(n));
%o A399375 is_A399375(k) = ((k%2) && (A348717(A163511(k)) <= A348717(k)));
%Y A399375 Cf. A000668, A163511, A348717, A364293, A364297.
%K A399375 nonn,base,easy,new
%O A399375 1,1
%A A399375 _Antti Karttunen_, Sep 11 2026
