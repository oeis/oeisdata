%I A399204 #21 Aug 28 2026 19:01:38
%S A399204 1,1,2,2,8,24,48,48,384,2688,16128,80640,322560,967680,1935360,
%T A399204 1935360,30965760,464486400,6502809600,84536524800,1014438297600,
%U A399204 11158821273600,111588212736000,1004293914624000,8034351316992000,56240459218944000,337442755313664000
%N A399204 Number of permutations that give the minimum number of comparisons for sorting n elements by binary insertion.
%C A399204 The minimum number of comparisons for sorting n elements by binary insertion is A061168(n).
%H A399204 Alois P. Heinz, <a href="/A399204/b399204.txt">Table of n, a(n) for n = 0..560</a> (first 101 terms from Ekaterina Gavrichenko)
%H A399204 A. V. Krivilev and E. O. Gavrichenko, <a href="https://journals.rcsi.science/0132-3474/article/view/437980">Analysis of the Binary Insertion Sort Algorithm and Its Modification Based on Comparison Forests</a>, Programming / Programming and computer software. 2026;1:40-59. (In Russian)
%F A399204 a(n) = a(n-1)*([A035327(n-1)==0]*A152423(n) + [A035327(n-1)!=0]*A035327(n-1)) for n >= 1, a(0) = 1.
%F A399204 a(n) = A395685(n,n-ceiling(log_2(n+1))).
%F A399204 a(n) = a(n-1) * A080079(n), a(0) = 1. - _Alexander Krivilev_, Aug 29 2026
%e A399204 For n = 3, there are 6 permutations in total. Among them, a(3) = 2 permutations require the minimum number of comparisons, namely 2, when sorted using binary search: <2,3,1> and <3,2,1>. The remaining permutations, <1,2,3>, <1,3,2>, <2,1,3>, and <3,1,2>, require 3 comparisons. This is the row n = 3 of the triangle in A395685.
%p A399204 T:= proc(n, k) option remember; `if`(n=0, `if`(k=0, 1, 0),
%p A399204       (b-> T(n-1, k-1)*b+T(n-1, k)*(n-b))(2^ceil(log[2](n))-n))
%p A399204     end:
%p A399204 a:= n-> T(n, n-ceil(log[2](n+1))):
%p A399204 seq(a(n), n=0..26);  # _Alois P. Heinz_, Aug 22 2026
%t A399204 A035327[0] := 1; A035327[n_] := 2^Ceiling@Log2@(n + 1) - (n + 1);
%t A399204 A152423[n_] := 2n - 2^Ceiling@Log2@n;
%t A399204 a[0] = 1; a[n_] := a[n] = a[n - 1]*(If[# == 0, A152423[n], #] &)[A035327[n - 1]];
%t A399204 Table[a[n], {n, 0, 26}]
%t A399204 (* Alternative: *)
%t A399204 A080079[n_] := 2^Ceiling@Log2@(n + 1) - n;
%t A399204 a[0] = 1; a[n_] := a[n] = a[n - 1]*A080079[n]; Table[a[n], {n, 0, 26}] (* _Alexander Krivilev_, Aug 29 2026 *)
%Y A399204 Right elements of the triangle in A395685.
%Y A399204 Cf. A398374, A035327, A152423, A080079.
%K A399204 nonn,new
%O A399204 0,3
%A A399204 _Ekaterina Gavrichenko_, Aug 22 2026
