%T A399165 1011013386240,28400281111436,808033168916480,23236914496322700,
%U A399165 674333106446008320,19722726535343875560,580782097618886983680,17204890435311056123110,512370561721235511705600
%N A399165 Expansion of (1/x) * Series_Reversion( x * (1-4*x)^(5/2) ).
%H A399165 Wikipedia, <a href="https://en.wikipedia.org/wiki/Fuss-Catalan_number">Fuss-Catalan number</a>.
%F A399165 G.f. A(x) satisfies A(x) = 1/(1 - 4*x*A(x))^(5/2).
%F A399165 G.f. A(x) satisfies A(x) = (1 + 4*x*A(x)^(7/5))^(5/2).
%F A399165 G.f. A(x) satisfies A(x) = 1/A(-x*A(x)^(12/5)).
%F A399165 G.f.: B(x)^5 where B(x) is the g.f. of A399168.
%F A399165 a(n) = 4^n * binomial(7*n/2 + 3/2,n)/(n+1).
%o A399165 (PARI) my(N=20, x='x+O('x^N)); Vec(serreverse(x*(1-4*x)^(5/2))/x)
%o A399165 (PARI) apr(n, p, r) = r*binomial(n*p+r, n)/(n*p+r);
%o A399165 a(n) = 4^n*apr(n, 7/2, 5/2);
%Y A399165 Cf. A078531, A398427.
%Y A399165 Cf. A399168, A400356.
%K A399165 nonn,easy,new
%O A399165 0,2
