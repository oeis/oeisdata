%I A399711 #31 Sep 09 2026 11:01:37
%S A399711 1,2,4,7,10,13,18,22,29,32,40,46,56,61,66,75,88,93,107,116,123,131
%N A399711 Maximum, over all subsets S,T of {1,...,n}, of the number of positive integers m for which m = s*t has exactly one solution (s,t) in S X T.
%C A399711 For subsets S,T of {1,...,n}, let r(m) = #{(s,t) in S X T : s*t = m}. Then a(n) = max_{S,T} #{m : r(m) = 1}. Representations are counted as ordered pairs, with the first coordinate in S and the second in T. No disjointness condition is imposed; S and T may overlap.
%H A399711 T. F. Bloom, <a href="https://www.erdosproblems.com/896">Erdős Problem 896</a>.
%H A399711 Kevin Ford, <a href="https://arxiv.org/abs/math/0401223">The distribution of integers with a divisor in a given interval</a>, arXiv:math/0401223 [math.NT], 2004.
%F A399711 A397205(n) <= a(n) <= A027424(n).
%e A399711 a(4) = 7: for S = {1,2,3} and T = {1,3,4} the 9 products are 1, 3, 4, 2, 6, 8, 3, 9, 12; the value 3 occurs twice and the remaining seven values 1, 2, 4, 6, 8, 9, 12 occur exactly once.
%o A399711 (Ruby)
%o A399711 def max_f(n)
%o A399711   subs = (1..(1 << n) - 1).map{|m| (1..n).select{|v| m[v - 1] == 1}}
%o A399711   best = [0, [], []]
%o A399711   subs.each_with_index{|s, i|
%o A399711     subs[i..-1].each{|t|
%o A399711       u = Hash.new(0)
%o A399711       s.each{|x| t.each{|y| u[x * y] += 1}}
%o A399711       f = u.values.count(1)
%o A399711       best = [f, s, t] if f > best[0]
%o A399711     }
%o A399711   }
%o A399711   best
%o A399711 end
%o A399711 def A399711(n)
%o A399711   (1..n).map{|k| max_f(k)[0]}
%o A399711 end
%o A399711 p A399711(10)
%Y A399711 Cf. A027424, A397205.
%K A399711 nonn,hard,more,new
%O A399711 1,2
%A A399711 _Seiichi Manyama_, Sep 08 2026
