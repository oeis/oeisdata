%U A399742 2815,2561,1471,545,127,17,1,0,1023,4097,7423,7937,5503,2561,799,161,19,1,0
%N A399742 Table of B(n, m) read by antidiagonals: B(n, m) = Sum_{k=0..m-1} binomial(k+n, n) * 2^k and B(n, 0) = 0, for n >= 0, m >= 0.
%C A399742 In the (n+3)-peg Tower of Hanoi (A137695), the Frame-Stewart difference sequence of the total moves consists of blocks where the value 2^k appears exactly binomial(k+n, n) times for k >= 0. Thus, B(n, m) is the exact cumulative sum of these difference blocks from k = 0 up to k = m - 1: B(n, m) = Sum_{k=0..m-1} binomial(k+n, n) * 2^k.
%C A399742 The recurrence B(n, m) = 2*B(n, m-1) + B(n-1, m) exactly mirrors the Frame-Stewart algorithm's optimal partitioning at these boundaries: moving the capacity of block m-1 twice using all pegs (2*B(n, m-1)), and moving the remaining disks using one fewer peg (B(n-1, m)).
%D A399742 Sandi Klavžar and Uroš Milutinović. "Simple explicit formulas for the Frame-Stewart numbers." Annals of Combinatorics 6.2 (2002): 157-167.
%H A399742 Yoshio Okita, <a href="/A399742/b399742.txt">Table of n, a(n) for n = 0..10010</a>
%H A399742 Abhiram Menon, <a href="https://arxiv.org/abs/2505.12941">On The Optimal General Solution To The Multi-Peg Tower of Hanoi</a>, arXiv:2505.12941 [math.CO], 2025.
%H A399742 Yoshio Okita, <a href="https://drive.google.com/file/d/1p0styfu9paFTqkPKMkE59VpTD_tibd0p/view?usp=sharing">Report1982.pdf</a>, (Unpublished manuscript, 1982).
%H A399742 Yoshio Okita, <a href="https://drive.google.com/file/d/1Qiu9FlsxiMKoc5ko3kblEPKIiakVd20L/view?usp=sharing">Explicit Formulas for the Frame-Stewart Numbers of the Generalized Tower of Hanoi: A Finite Difference Approach, 2026</a>.
%H A399742 <a href="/index/To#Hanoi">Index entries for sequences related to Towers of Hanoi</a>
%F A399742 B(n, m) = A137695(n+3, binomial(m+n, n+1)).
%F A399742 B(n, m) = B(n, m-1) + binomial(m+n-1, n) * 2^(m-1) for m >= 1, with B(n, 0) = 0.
%F A399742 B(n, m) = 2^m * Sum_{r=0..n} (-2)^r * binomial(m+n, n-r) + (-1)^(n+1).
%F A399742 B(n, m) = 2*B(n, m-1) + B(n-1, m) for n >= 1, m >= 1.
%F A399742 G.f. for row n: x / ((1-x)*(1-2*x)^(n+1)).
%e A399742 Rows represent the dimension n >= 0, and columns represent the block index m >= 0.
%e A399742 The array B(n, m) begins:
%e A399742  n \ m|  0   1   2    3    4    5    6
%e A399742  -------------------------------------
%e A399742   0   |  0   1   3    7   15   31   63   (3-peg: A000225)
%e A399742   1   |  0   1   5   17   49  129  321   (4-peg: A000337)
%e A399742   2   |  0   1   7   31  111  351 1023   (5-peg: A055580 shifted)
%e A399742   3   |  0   1   9   49  209  769 2561   (6-peg: A027608 shifted)
%e A399742   4   |  0   1  11   71  351 1471 5503   (7-peg: A211386 shifted)
%e A399742   5   |  0   1  13   97  545 2561 10625  (8-peg: A211388 shifted)
%t A399742 A399742[n_, m_] := A399742[n, m] = Which[m == 0, 0, n == 0, 2^m - 1, True, 2*A399742[n,  m - 1] + A399742[n - 1, m]];
%t A399742 Table[A399742[m, n - m], {n, 0, 10}, {m, 0, n}] (* _Paolo Xausa_, Sep 29 2026 *)
