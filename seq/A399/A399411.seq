%T A399411 28,12,26,44,55,61,58,50,34,15,31,53,67,77,79,73,60,40,18,37,63,83,95,
%U A399411 101,98,88,71,48,20,41,72,96,114,123,127,119,104,84,54,24,47,80,110,133,147,153,149,139,120,94,62,25
%N A399411 Order array, U, of the array W given by w(n, k) = k*(n + sqrt(1/3)), for n >= 1, k >= 1, a rectangular array, read by descending antidiagonals; see Comments.
%C A399411 Suppose that (w(n, k)), for n >= 1 and k >= 1 is an array of distinct real numbers. Replace each w(n, k) by its position when all the numbers w(n, k) are ordered by < . The resulting array, U = (u(n, k)), is the order array of (w(n, k)). Every positive integer occurs exactly once in U, so that as a sequence, U is a permutation of the positive integers. Successive row terms, and column terms, have limiting ratio 1. See A399406 for a guide to related sequences.
%H A399411 <a href="/index/Per#IntegerPermutation">Index entries for sequences that are permutations of the natural numbers</a>
%F A399411 u(n,k) = Sum_{h=1..floor(k*(n+x)/(1+x))} floor(k*(n+x)/h-x), where x = sqrt(1/3).
%F A399411 u(n,k) = Sum_{m=1..floor(k*(n+x)-x)} floor(k*(n+x)/(m+x)), where x = sqrt(1/3).
%e A399411 Corner:
%e A399411   1    3    6    9    14   17    22   26   31
%e A399411   2    7   13   19    27   35    44   53   63
%e A399411   4   11   21   32    43   55    67   83   96
%e A399411   5   16   30   45    61   77    95  114  133
%e A399411   8   23   39   58    79   101  123  147  170
%e A399411  10   28   50   73    98   127  153  181  211
%e A399411  12   34   60   88   119   149  184  218  254
%e A399411  15   40   71   104  139   176  216  256  295
%e A399411  18   48   84   120  162   203  247  292  340
%e A399411  20   54   94   136  183   231  280  331  386
%t A399411 x = Sqrt[1/3]; u[n_, k_] := Sum[Floor[k (n + x)/h - x], {h, 1, Floor[k (n + x)/(1 + x)]}]
%t A399411 t = Table[u[n, k], {n, 1, 12}, {k, 1, 12}]; Grid[t]  (* array *)
%t A399411 Table[u[n - k + 1, k], {n, 1, 12}, {k, n, 1, -1}] // Flatten (* sequence *)
%Y A399411 Cf. A399406.
%K A399411 nonn,tabl,new
