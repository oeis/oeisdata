%S A399129 19,31,59,89,109,139,151,181,199,229,241,269,389,409,421,439,461,491,
%T A399129 541,571,601,631,659,739,809,839,881,919,941,1019,1049,1129,1289,1439,
%U A399129 1459,1499,1559,1579,1609,1621,1831,1889,1999,2029,2161,2221,2251,2281,2311,2341
%N A399129 Primes of the forms 10*k+1 and 10*k+9 for which the number of primes of the forms 10*k+1 and 10*k+9 are equal.
%H A399129 G. L. Honaker, Jr., <a href="https://t5k.org/curios/page.php?curio_id=50282">Prime curio for 19</a>.
%e A399129 a(4) = 89 because the different forms are tied at five each: {11, 31, 41, 61, 71} and {19, 29, 59, 79, 89}.
%t A399129 seq[max_] := With[{ps = Prime[Range[max]]}, ps[[SequencePosition[Abs[Accumulate[Table[r = Mod[p, 10, -5]; If[Abs[r] == 1, r, 0], {p, ps}]]], {1, 0}][[;; , 2]]]]]; seq[400] (* _Amiram Eldar_, Aug 22 2026 *)
