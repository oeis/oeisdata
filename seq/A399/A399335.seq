%p A399335 # Using function 'binomial_matrix' from A399000.
%p A399335 BM := binomial_matrix(n -> n!/iquo(n,2)!^2):
%p A399335 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A399335 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%t A399335 (* Uses the function 'binomialMatrix' from A399000. *)
%t A399335 bM = binomialMatrix[#! / Quotient[#, 2]!^2 &];
%t A399335 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A399335 (Python)  # Using function 'binomial_matrix' from A399000.
%o A399335 from math import factorial
%o A399335 M = binomial_matrix(lambda n: factorial(n) // factorial(n//2)**2)
%o A399335 for n in range(9): print([M(n, k) for k in range(9)])
