%I A399551 #9 Sep 11 2026 21:43:23
%S A399551 1,6,18,20,48,54,56,63,84,90,100,105,130,135,144,162,238,275,352,364,
%T A399551 378,384,392,429,432,441,450,456,486,495,500,588,640,660,675,700,735,
%U A399551 754,828,832,836,870,969,1050,1053,1150,1152,1232,1258,1296,1360,1458
%N A399551 Numbers k, such that Sum_{d|k} gpf(d) is a multiple of gpf(k), where gpf = A006530.
%H A399551 Žiga Pirc, <a href="/A399551/b399551.txt">Table of n, a(n) for n = 1..10000</a>
%e A399551 18 = 2*3^2 is a term, since gpf(18) = 3, and sum of greatest prime factors of its divisors is gpf(1)+gpf(2)+gpf(3)+gpf(6)+gpf(9)+gpf(18) = 1+2+3+3+3+3 = 5*3.
%o A399551 (PARI)
%o A399551 gpf(n) = if(n>1, vecmax(factor(n)[, 1]), 1);
%o A399551 isok(n) = sumdiv(n, d, gpf(d)) % gpf(n) == 0
%Y A399551 Cf. A006530, A387279, A399552.
%K A399551 nonn,new
%O A399551 1,2
%A A399551 _Žiga Pirc_, Sep 06 2026
