%I A399140 #8 Aug 31 2026 17:33:58
%S A399140 56,60,72,88,102,104,108,112,138,144,150,162,176,200,220,228,234,264,
%T A399140 270,280,308,364,368,390,392,396,400,402,416,438,448,450,462,468,486,
%U A399140 490,500,522,540,552,570,580,588,600,608,612,620,630,644,648,654,666,702
%N A399140 Integers that are both pseudoperfect and pseudo-antiperfect.
%e A399140 56 -> proper divisors are 1, 2, 4, 7, 8, 14, 28 and 2 + 4 + 8 + 14 + 28 = 56; anti-divisors are 3, 16, 37 and 3 + 16 + 37 = 56.
%e A399140 60 -> proper divisors are 1, 2, 3, 4, 5, 6, 10, 12, 15, 20, 30 and, for example, 10 + 20 + 30 = 60; anti-divisors are 7, 8, 11, 17, 24, 40 and 8 + 11 + 17 + 24 = 60.
%p A399140 with(numtheory): with(combinat): P:=proc(q) global a,k,n,ok,S,T,v; v:=[];
%p A399140 for n from 1 to q do T:=subsets(divisors(n) minus {n}); ok:=1;
%p A399140 while not T[finished] and ok=1 do if convert(T[nextvalue](),`+`)=n then a:=[];
%p A399140 for k from 2 to n-1 do if abs((n mod k)-k/2) < 1 then a:=[op(a),k]; fi; od;
%p A399140 S:=subsets(a); while not S[finished] do if convert(S[nextvalue](),`+`)=n then print(n);
%p A399140 v:=[op(v),n]; ok:=0; break; fi; od; fi; od; op(v); od; end: P(800);
%Y A399140 Intersection of A005835 and A192270.
%K A399140 nonn,new
%O A399140 1,1
%A A399140 _Paolo P. Lava_, Aug 20 2026
