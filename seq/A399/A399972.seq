%I A399972 #4 Sep 18 2026 00:01:50
%S A399972 1,3,13,111,1171,30451,1307363,198424063,151882464031,1195978901157391
%N A399972 Number of nonempty sets of pairwise commuting permutations of [n].
%F A399972 Let B_k(n) be the number of k-element sets of pairwise commuting permutations of [n]. Then a(n) = Sum_{k=1..A000792(n)} B_k(n).
%F A399972 B_k(n) = (n!/k!) * Sum_{r=1..k} A008275(k,r)*[x^n]F_r(x),
%F A399972 F_r(x) = Product_{m>=1} (1-x^m)^(-A160870(m,r-1)).
%F A399972 Here A160870(m,r) is the number of subgroups of index m in Z^r, the free Abelian group of rank r, and A008275(k,r) is the signed Stirling number of the first kind and A000792(n) = max{|A| : A is an Abelian subgroup of S_n}.
%e A399972 For n=3, the 13 sets are the 6 singletons; {e,(12)}, {e,(13)}, {e,(23)}, {e,(123)}, {e,(132)}, {(123),(132)}; and {e,(123),(132)}.
%Y A399972 Cf. A000792 (maximum order of an Abelian subgroup of S_n), A160870 (subgroups of finite index in free Abelian groups), A362826 (ordered tuples of pairwise commuting permutations).
%K A399972 nonn,more,new
%O A399972 1,2
%A A399972 _Vladeta Jovovic_, Sep 17 2026
