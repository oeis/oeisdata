%S A399642 1,18,249,3092,36180,407658,4474638,48180456,511195500,5360966440,
%T A399642 55692307737,574051833444,5878268662396,59856285363084,
%U A399642 606548239473420,6120477526824144,61530454922653116,616542070686375960,6159656819349174004,61376413129164614160,610110864219288461904
%N A399642 Expansion of g^6/(4-3*g)^4, where g = 1+x*g^4 is the g.f. of A002293.
%H A399642 Seiichi Manyama, <a href="/A399642/b399642.txt">Table of n, a(n) for n = 0..1000</a>
%F A399642 G.f.: (Sum_{k>=0} binomial(4*k+2,k) * x^k) * (Sum_{k>=0} binomial(4*k,k) * x^k)^3.
%F A399642 Sum_{k>=1} a(k-1) * x^k/k^2 = (1/6) * log( Sum_{k>=0} binomial(4*k+2,k) * x^k ).
%F A399642 a(n) = ((n+1)/2) * (binomial(4*n+3,n) + Sum_{k=0..n} 3^(n-k) * binomial(4*n+4,k)).
%F A399642 a(n) = ((n+1)/8) * A078995(n+1) = ((n+1)/8) * Sum_{k=0..n+1} 3^(n+1-k) * binomial(4*n+5,k).
%F A399642 a(n) = Sum_{k=0..n} 3^k * binomial(k+2,2) * binomial(4*n+5,n-k).
%F A399642 D-finite with recurrence: -3355443200*(2*n + 3)*(4*n + 7)*(4*n + 9)*a(n) + 1572864*(21568*n^3 + 143696*n^2 + 337166*n + 279865)*a(n + 1) - 18432*(204800*n^3 + 1665648*n^2 + 4746482*n + 4656115)*a(n + 2) + 1512*(111168*n^3 + 1120464*n^2 + 3815230*n + 4420505)*a(n + 3) - 250047*(n + 4)*(3*n + 14)*(3*n + 13)*a(n + 4) = 0. - _Robert Israel_, Oct 15 2026
%p A399642 with(gfun):
%p A399642 e1:= y*(4-3*g)^4-g^6:
%p A399642 e2:= -g + 1 + x*g^4:
%p A399642 eq:= resultant(e1,e2,g):
%p A399642 de:= algeqtodiffeq(eq,y(x)):
%p A399642 rec:= diffeqtorec(de,y(x),a(n)):
%p A399642 f:= rectoproc(rec,a(n),remember):
%p A399642 map(f, [$0..30]); # _Robert Israel_, Oct 15 2026
%o A399642 (PARI) a(n) = (n+1)*(binomial(4*n+3, n)+sum(k=0, n, 3^(n-k)*binomial(4*n+4, k)))/2;
%Y A399642 Cf. A399641, A399643, A399644, A399645.
%Y A399642 Cf. A002293, A078995, A395664.
%K A399642 nonn,changed
%O A399642 0,2
%A A399642 _Seiichi Manyama_, Sep 05 2026
