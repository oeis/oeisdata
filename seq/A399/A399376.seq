%N A399376 a(n) = A028233(A327859(n)).
%H A399376 Antti Karttunen, <a href="/A399376/b399376.txt">Table of n, a(n) for n = 0..10000</a>
%H A399376 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A399376 a(n) = A399372(n)^A399374(n).
%o A399376 (PARI)
%o A399376 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A399376 A028233(n) = if(n>1, f=factor(n); f[1, 1]^f[1, 2], 1);
%o A399376 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A399376 A327859(n) = A276086(A003415(n));
%o A399376 A399376(n) = A028233(A327859(n));
