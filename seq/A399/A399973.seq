%I A399973 #14 Sep 24 2026 19:37:19
%S A399973 0,3,4,10,6,26,8,37,29,61,12,100,14,115,105,138,18,218,20,249,184,267,
%T A399973 24,388,121,371,252,453,30,635,32,548,420,620,361,854,38,773,575,952,
%U A399973 42,1212,44,1083,928,1119,48,1514,321,1499,961,1480,54,1897,754,1795
%N A399973 a(n) is the sum of sigma (A000203), over the integers smaller or equal to n, that are not coprime to n.
%H A399973 Žiga Pirc, <a href="/A399973/b399973.txt">Table of n, a(n) for n = 1..10000</a>
%F A399973 a(n) = Sum_{1<=k<=n; gcd(k,n)>1} A000203(k)
%F A399973 a(p) = p+1, for a prime p.
%F A399973 a(n) = A024916(n) - A308095(n)
%e A399973 a(4) = 10 = sigma(2) + sigma(4).
%t A399973 a[n_]:=Sum[DivisorSigma[1,k]*Boole[GCD[k,n]>1],{k,n}]; Array[a,56] (* _Stefano Spezia_, Sep 17 2026 *)
%o A399973 (PARI)
%o A399973 a(n) = sum(k=1, n, if (gcd(n, k)>1, sigma(k)));
%Y A399973 Cf. A000203, A308095.
%K A399973 nonn,new
%O A399973 1,2
%A A399973 _Žiga Pirc_, Sep 17 2026
