%I A399927 #22 Oct 08 2026 16:00:07
%S A399927 1,2,1,3,1,1,4,1,2,1,5,1,1,2,1,6,1,1,3,1,1,7,1,1,3,1,2,1,8,1,1,2,1,3,
%T A399927 1,1,9,1,1,2,1,4,1,2,1,10,1,1,2,1,5,1,1,2,1,11,1,1,2,1,5,1,1,3,1,1,12,
%U A399927 1,1,2,1,3,1,1,4,1,2,1,13
%N A399927 Lexicographically earliest sequence such that each term specifies how many positions away the nearest larger term occurs.
%C A399927 Fixed point of the transform mapping each term to the distance to its nearest higher neighbor (inspired by topographic isolation).
%C A399927 The first occurrence of n is at A000124(n-1). Every number occurs infinitely often. The asymptotic frequency of 1 seems to approach a value around 0.6.
%H A399927 Hendrik Untch, <a href="/A399927/b399927.txt">Table of n, a(n) for n = 1..10000</a>
%e A399927 For n=4, a(n)=3 and a(n+3)>3 is the nearest larger term.
%e A399927 For n=5, a(n)=1 since a(n-1)>1, so a(6) can also be 1.
%e A399927 a(9) can't be 1 because a(7)=4 forces a(11)=5 and further a(10)=1, so a(9) is surrounded by 1's.
%o A399927 (Python)
%o A399927 n = 142 # Calculate up to the first occurrence of n, i.e. n*(n-1)/2 terms
%o A399927 parts = [[1,1],[1],[1,1]]
%o A399927 for i in range(4,n):
%o A399927     k = int(((8*(i-1))**0.5-1)/2)
%o A399927     piece_lengths = [2+int(k*(k-1)/2), k+i-2-int(k*(k+1)/2)]
%o A399927     middle = min(piece_lengths)
%o A399927     part = parts[piece_lengths[0]-1] + [middle] + parts[piece_lengths[1]-1]
%o A399927     parts.append(part)
%o A399927 seq = [1]
%o A399927 for i in range(2,n):
%o A399927     seq += [i] + parts[i-1]
%o A399927 seq += [n]
%o A399927 print(seq)
%K A399927 nonn,easy,eigen,new
%O A399927 1,2
%A A399927 _Hendrik Untch_, Sep 16 2026
