%I A399610 #25 Sep 09 2026 11:46:20
%S A399610 6,30,198,240,966,2310,3360,4230,4800,6270,6960,11550,14448,18048,
%T A399610 31248,51198,65520,68448,76830,79998,84870,96798,120048,141510,156798,
%U A399610 174048,181200,184830,239430,266448,287280,297990,305760,387198,441798,451248
%N A399610 Sequence of integers k such that d(k-1)+d(k) and d(k)+d(k+1) are perfect squares, where d(k) = A032742(k) is the largest divisor of k strictly smaller than k.
%C A399610 For all terms in data, a(n)-1 and a(n)+1 are twin prime numbers except for a(5) = 966 and a(36) = 451248; for those terms, a(n)+1 is prime: 967 and 451249.
%C A399610 Is there an infinity of terms in the sequence? Are there other exceptions to the twin prime number rule? Are there examples where a(n)+1 is not a prime number?
%C A399610 _Hugo Pfoertner_ gives a partial answer to the last question : k = 29057286 is the only known occurrence up to 10^9 where k+1 is not prime. Are there any others?
%e A399610 30 is a term since d(29) = 1, d(30) = 15, d(31) = 1 and 1 + 15 = 15 + 1 = 16 = 4^2.
%e A399610 966 is a term since d(965) = 193, d(966) = 483, d(967) = 1, and 193 + 483 = 676 = 26^2 and 483 + 1 = 484 = 22^2.
%o A399610 (PARI) lpd(n)= n/factor(n)[1, 1];
%o A399610 is_a399610(n) = if(n<4, 0, my(dn=lpd(n)); if(issquare(lpd(n-1)+dn), issquare(dn+lpd(n+1)))) \\ _Hugo Pfoertner_, Sep 06 2026
%o A399610 (Python)
%o A399610 from math import isqrt
%o A399610 from sympy import factorint
%o A399610 from itertools import count, islice
%o A399610 def d(k): return k//min(factorint(k))
%o A399610 def issquare(k): return isqrt(k)**2 == k
%o A399610 def agen(): # generator of terms
%o A399610     dkm1, dk, dk1 = 1, 1, 1
%o A399610     for k in count(3):
%o A399610         dkm1, dk, dk1 = dk, dk1, d(k+1)
%o A399610         if issquare(dkm1+dk) and issquare(dk+dk1):
%o A399610             yield k
%o A399610 print(list(islice(agen(), 36))) # _Michael S. Branicky_, Sep 06 2026
%Y A399610 Cf. A032742.
%K A399610 nonn,new
%O A399610 1,1
%A A399610 _Patrick Kitabgi_, Sep 04 2026
