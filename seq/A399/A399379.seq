%T A399379 2695,2805,3135,4499,5005,6006,6809,7917,9119,10010,10660,11429,12870,
%U A399379 13739,15210,16049,17589,18359,20669,21385,22979,26026,26845,27030,27170,29029,29861,32305,34814,35607,37765,48685,49855,59059
%N A399379 Numbers k such that all radix primes corresponding to the nonzero digits in the primorial base expansion of the arithmetic derivative of k are also prime factors of k.
%C A399379 Numbers k such that every prime factor of A327859(k) [= A276086(A003415(k))] divides k.
%H A399379 Antti Karttunen, <a href="/A399379/b399379.txt">Table of n, a(n) for n = 1..502</a>
%H A399379 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A399379 {k such that k == 0 mod A400151(k)}.
%e A399379 660' = A003415(660) = 1072, with A049345(1072) = 50320, as 1072 = 5*A002110(4) + 3*A002110(2) + 2*A002110(1), so the radix primes for nonzero digits are 3, 5 and 11, which are all present in the factorization of 660 = 2^2 * 3 * 5 * 11, therefore 660 is included in this sequence.
%o A399379 (PARI) is_A399379(n) = if(n<=1, 1, my(f=factor(n), ad = n*sum(i=1, #f~, f[i, 2]/f[i, 1]), p=2); while(ad, if(ad%p && n%p, return(0)); ad \= p; p = nextprime(1+p)); (1));
%Y A399379 Cf. A003415, A007947, A049345, A327859, A328571, A400151.
%Y A399379 Subsequences: A370115, A400156.
%Y A399379 Cf. also A399378, A399380 (a dual condition), A400154, A400155.
%K A399379 nonn,new
%O A399379 1,3
