%U A399024 5,6,6,9,2,6,7,9,3,3,6,9,4,7,0,3,2,9,8,8,0,8,1,1,6
%N A399024 Decimal expansion of the exponential growth rate of A396406.
%H A399024 Vico Bonfioli, <a href="https://doi.org/10.5281/zenodo.20370090">The Universal Right-Triangle Reflection Sequence (Unequal Legs)</a>, Zenodo, 2026.
%F A399024 Equals 1/sqrt(q_1), where q_1 is the least positive zero of B(q) = Sum_{k>=0} 2^k*(q-1)^k*q^(k^2) / Product_{i=1..2*k} (1-q^i).
%e A399024 1.491617787114374226836712746983...
%o A399024 (PARI)
%o A399024 B(q) = suminf(k=0, 2^k*(q-1)^k*q^(k^2) / prod(i=1, 2*k, 1-q^i));
%o A399024 1/sqrt(solve(q=0.1, 0.9, B(q)))
%o A399024 (Python)
%o A399024 from mpmath import mp, mpf, sqrt, findroot, fprod
%o A399024 mp.dps = 50
%o A399024 def B(q):
%o A399024     s, k = mpf(0), 0
%o A399024     while True:
%o A399024         t = mpf(2)**k * (q-1)**k * q**(k*k)
%o A399024         if k > 0:
%o A399024             t /= fprod(1 - q**i for i in range(1, 2*k+1))
%o A399024         s += t
%o A399024         if k > 2 and abs(t) < mpf(10)**(-mp.dps-10):
%o A399024             return s
%o A399024         k += 1
%o A399024 q1 = findroot(B, mpf('0.45'))
%o A399024 print(1/sqrt(q1))
%Y A399024 Cf. A396406.
%K A399024 nonn,cons,new
%O A399024 1,2
