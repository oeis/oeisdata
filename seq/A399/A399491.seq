%I A399491 #25 Sep 12 2026 06:07:18
%S A399491 7,38,117,268,515,882,41,2072,2943,4030,5357,6948,8827,11018,13545,
%T A399491 16432,19703,23382,27493,32060,37107,42658,48737,55368,62575,70382,
%U A399491 78813,87892,97643,108090,119257,131168,143847,157318,171605,186732,202723,682,237393,256120,239
%N A399491 The smallest integer m > n such that (n^2+1)*(m^2+1) is a perfect square.
%C A399491 a(n) <= 4*n^3+3*n.
%C A399491 a(n) < 4*n^3+3*n when n is in {7, 38, 41, 117, 268, 515, 682, 882, ...}.
%C A399491 If the generalized Pell equation x^2-(n^2+1)*(y^2+1) = 0 has one fundamental solution in (x, y), then a(n) = 4*n^3+3*n. Conjecture: the converse of this statement is true. - _Chai Wah Wu_, Sep 10 2026
%H A399491 Chai Wah Wu, <a href="/A399491/b399491.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from Zhining Yang)
%t A399491 a[n_]:=Do[If[IntegerQ@Sqrt[(n^2+1) (m^2+1)],Return[m]],{m,n+1,Infinity}];Table[a[n],{n,40}]
%o A399491 (Python)
%o A399491 from itertools import count
%o A399491 from sympy.solvers.diophantine.diophantine import diop_DN
%o A399491 from sympy.ntheory.primetest import is_square
%o A399491 def A399491(n):
%o A399491     k = n**2+1
%o A399491     d = diop_DN(k,k)
%o A399491     if len(d) > 1:
%o A399491         for m in count(n+1):
%o A399491             if is_square(k*(m**2+1)):
%o A399491                 return m
%o A399491     else:
%o A399491         return n*((n*n<<2)+3) # _Chai Wah Wu_, Sep 10 2026
%o A399491 (PARI) a(n) = my(m=n+1); while (!issquare((n^2+1)*(m^2+1)), m++); m; \\ _Michel Marcus_, Sep 11 2026
%Y A399491 Cf. A002315, A173962, A271636.
%K A399491 nonn,new
%O A399491 1,1
%A A399491 _Zhining Yang_, Aug 30 2026
