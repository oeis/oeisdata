%S A399776 1,4,42,376,3428,31184,283752,2581856,23492368,213757504,1944983712,
%T A399776 17697444736,161029395008,1465209607424,13331970809472,
%U A399776 121307862550016,1103782608494848,10043339493458944,91384542032620032,831509731195549696,7565923269890597888,68842483471080280064
%N A399776 a(n) = 8*a(n-1) + 10*a(n-2), with a(0)=1 and a(1)=4.
%C A399776 Lucas-type companion to A190953, halved to remove the common factor 2. The case n = 4 of the Deca-Lucas family in Rajput (2026).
%H A399776 Paolo Xausa, <a href="/A399776/b399776.txt">Table of n, a(n) for n = 0..1000</a>
%H A399776 Chetansing Rajput, <a href="https://doi.org/10.51846/jnhm.v2i2.5488">Deca-metallic ratios: a base-10 analogue of metallic means with their geometric origin in primitive Pythagorean triples</a>, J. New Horiz. Math., 2026.
%H A399776 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (8,10).
%F A399776 a(n) = 8*a(n-1) + 10*a(n-2) for n > 1, with a(0)=1 and a(1)=4.
%F A399776 a(n) = ((4+sqrt(26))^n + (4-sqrt(26))^n)/2.
%F A399776 From _Stefano Spezia_, Oct 11 2026: (Start)
%F A399776 G.f.: (1 - 4*x)/(1 - 8*x - 10*x^2).
%F A399776 E.g.f.: exp(4*x)*cosh(sqrt(26)*x). (End)
%t A399776 LinearRecurrence[{8, 10}, {1, 4}, 25] (* _Paolo Xausa_, Oct 22 2026 *)
%o A399776 (Python)
%o A399776 a, b = 1, 4
%o A399776 for n in range(25):
%o A399776     print(a, end=", ")
%o A399776     a, b = b, 8*b + 10*a
%Y A399776 Cf. A190953, A400851, A399405.
%K A399776 nonn,easy,new
%O A399776 0,2
%A A399776 _Chetansing Rajput_, Oct 08 2026
