%S A399604 1,16,100,121,169,361,676,961,1024,1600,3136,3481,5041,6724,9025,9409,
%T A399604 9604,13924,14641,19321,20164,24964,26569,28561,32041,35344,37636,
%U A399604 43681,65536,67081,67600,70225,80656,90601,94864,100489,102400,107584,109561,115600,123904,126025,126736,144400,153664
%N A399604 Squares k such that A161351(k) is a prime.
%C A399604 Squares k such that k + (sum of digits of k) + (product of digits of k) is a prime.
%H A399604 Robert Israel, <a href="/A399604/b399604.txt">Table of n, a(n) for n = 1..10000</a>
%e A399604 a(4) = 121 is a term because 121 = 11^2 and 121 + (1+2+1) + (1*2*1) = 127 is prime.
%p A399604 f:= proc(n) local L;
%p A399604       L:= convert(n,base,10);
%p A399604       n + convert(L,`+`) + convert(L,`*`)
%p A399604 end proc:
%p A399604 select(isprime, map(f, [$1..1000]));
%o A399604 (Python)
%o A399604 from math import isqrt, prod
%o A399604 from sympy import isprime
%o A399604 def issquare(n): return isqrt(n)**2 == n
%o A399604 def A161351(n): return n + sum(d:=list(map(int, str(n)))) + prod(d)
%o A399604 def ok(n): return issquare(n) and isprime(A161351(n))
%o A399604 print([k for r in range(400) if ok(k:=r**2)]) # _Michael S. Branicky_, Sep 06 2026
%Y A399604 Cf. A161351, A399496, A399603, A399606, A399608.
%K A399604 nonn,base,new
%O A399604 1,2
%A A399604 _Robert Israel_, Sep 04 2026
