%N A399237 Expansion of e.g.f. 1 / (1 + x)^tanh(x).
%F A399237 a(n) ~ (-1)^n * n! / ( Gamma(-tanh(1)) * n^(1+tanh(1)) ).
%t A399237 nmax = 24; CoefficientList[Series[1/(1 + x)^Tanh[x], {x, 0, nmax}], x] Range[0, nmax]!
%t A399237 (* Alternative: *)
%t A399237 a[0] = 1; a[n_] := a[n] = Sum[Sum[(-1)^(k + 1) Binomial[n - 1, k - 1] Binomial[k, 2 j - 1] (k - 2 j)! 2^(2 j) (2^(2 j) - 1) BernoulliB[2 j] a[n - k]/(2 j), {j, 1, Floor[k/2]}], {k, 1, n}]; Table[a[n], {n, 0, 24}]
%Y A399237 Cf. A003723, A009249, A009269, A400342.
%K A399237 sign,new
