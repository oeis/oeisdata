%N A399708 Lexicographically earliest sequence of integers >= 2 where a(1) = 2 and each term a(n) is banned for the next a(n) terms.
%C A399708 This sequence has a period length of 36.
%o A399708 (Python)
%o A399708 def generate(terms):
%o A399708     sequence = []
%o A399708     banned_until = {}
%o A399708     for n in range(1, terms + 1):
%o A399708         x = 2
%o A399708         # Find the smallest allowed integer >= 2
%o A399708         while banned_until.get(x, 0) >= n:
%o A399708             x += 1
%o A399708         sequence.append(x)
%o A399708         # Ban x for the next x terms
%o A399708         banned_until[x] = n + x
%o A399708     return sequence
%o A399708 print(generate(106))
%Y A399708 Cf. A364447, A372704, A399709, A398589.
%K A399708 nonn,easy,new
