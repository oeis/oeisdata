%S A399269 8,1,120,157,2,7,60,0,218,151,2,201,4,17,224,15,0,461,112,283,96,625,
%T A399269 96,5,1494,0,112,11,122,849,118,29,314,65,0,1373,14,79,114,643,999998,
%U A399269 139,31616,0,1244,67,252,1221,250,161,290,531,0,175,1406,107,1140,499
%N A399269 The smallest number k such that the concatenation of the squares of the numbers from k to k + n is a prime number, or zero if such a k does not exist.
%C A399269 No solution for n == 8 (mod 9).
%C A399269 Within the first 100 values, no terms found for a(77) and a(87) up to 7.5*10^9.
%C A399269 From a(78) to a(86): 269, 1254, 0, 2380, 285, 14, 6285, 2476, 1581.
%C A399269 From a(88) to a(100): 443, 0, 4211, 888, 2437, 9738, 5689, 86, 2273, 236, 0, 74, 1071.
%H A399269 Paolo P. Lava, <a href="/A399269/b399269.txt">Table of n, a(n) for n = 1..76</a>
%e A399269 a(1) = 8 because the concatenation of 8^2 and 9^2 is the prime 6481;
%e A399269 a(2) = 1 because the concatenation of 1^2, 2^2 and 3^2 is the prime 149; etc.
%o A399269 (PARI) conc(k, n) = my(v=vector(n+1, i, (k+i-1)^2), s=Str(v[1])); for (i=2, #v, s = concat(s, Str(v[i]))); eval(s);
%o A399269 a(n) = if (n % 9 == 8, return(0)); my(k=1); while( !isprime(conc(k, n)), k++); k; \\ _Michel Marcus_, Oct 04 2026
