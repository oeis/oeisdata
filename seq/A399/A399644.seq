%S A399644 1,28,606,11800,216765,3837072,66198174,1120685424,18699400350,
%T A399644 308453686980,5040917371798,81748907485248,1317154429535555,
%U A399644 21105056032250400,336557547013535820,5344660312883695584,84564087983300104170,1333635413572169608680
%N A399644 Expansion of g^8/(6-5*g)^4, where g = 1+x*g^6 is the g.f. of A002295.
%H A399644 Seiichi Manyama, <a href="/A399644/b399644.txt">Table of n, a(n) for n = 0..849</a>
%F A399644 G.f.: (Sum_{k>=0} binomial(6*k+4,k) * x^k) * (Sum_{k>=0} binomial(6*k,k) * x^k)^3.
%F A399644 Sum_{k>=1} a(k-1) * x^k/k^2 = (1/10) * log( Sum_{k>=0} binomial(6*k+4,k) * x^k ).
%F A399644 a(n) = ((n+1)/2) * (binomial(6*n+5,n) + Sum_{k=0..n} 5^(n-k) * binomial(6*n+6,k)).
%F A399644 a(n) = ((n+1)/12) * A079679(n+1) = ((n+1)/12) * Sum_{k=0..n+1} 5^(n+1-k) * binomial(6*n+7,k).
%F A399644 a(n) = Sum_{k=0..n} 5^k * binomial(k+2,2) * binomial(6*n+7,n-k).
%F A399644 a(n) = Sum_{i,j,k,l >= 0 and i+j+k+l=n} binomial(6*i+1,i) * binomial(6*j+1,j) * binomial(6*k+1,k) * binomial(6*l+1,l).
%F A399644 G.f.: B(x)^4 where B(x) is the g.f. of A079590.
%F A399644 a(n) = Sum_{k=0..n} 6^k * binomial(k+2,2) * binomial(6*n+4-k,n-k).
%F A399644 a(0) = 1; a(n) = (1/n) * Sum_{k=0..n-1} (6*k+28) * 5^k * binomial(k+3,3) * binomial(6*n+7,n-1-k).
%F A399644 a(0) = 1; a(n) = (1/n) * Sum_{k=0..n-1} (5*k+28) * 6^k * binomial(k+3,3) * binomial(6*n+3-k,n-1-k).
%o A399644 (PARI) a(n) = (n+1)*(binomial(6*n+5, n)+sum(k=0, n, 5^(n-k)*binomial(6*n+6, k)))/2;
%o A399644 (PARI) my(N=20, x='x+O('x^N)); Vec(sum(k=0, N, binomial(6*k+1, k)*x^k)^4)
