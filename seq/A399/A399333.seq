%p A399333 # Using function 'binomial_matrix' from A399000.
%p A399333 BM := binomial_matrix(n -> ifelse(n=0, 1, ithprime(n))):
%p A399333 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A399333 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%t A399333 (* Uses the function 'binomialMatrix' from A399000. *)
%t A399333 bM = binomialMatrix[If[# == 0, 1, Prime[#]] &];
%t A399333 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A399333 (Python)  # Using function binomial_matrix from A399000.
%o A399333 from sympy import prime
%o A399333 M = binomial_matrix(lambda n: 1 if n == 0 else prime(n))
%o A399333 for n in range(9): print([M(n, k) for k in range(9)])
