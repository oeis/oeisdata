%S A399314 375,1715,6655,9317,10875,11625,13875,15375,15379,16125,17625,19875,
%T A399314 22125,22875,24167,25125,26625,27375,29625,31125,33375,34391,36375,
%U A399314 37875,38625,40125,40875,42375,47625,49125,51375,52125,54043,55875,56625,58875,61125,62625
%N A399314 Numbers k = rad(k) * q(k)^2 such that A008479(k) = 6, where rad = A007947 and q(k) = second smallest distinct prime factor of k.
%C A399314 Numbers k in A398802 such that A008479(k) is minimum.
%C A399314 Terms are odd.
%C A399314 Let P(i..j) = Product_{h=i..j} prime(h).
%H A399314 Michael De Vlieger, <a href="/A399314/b399314.txt">Table of n, a(n) for n = 1..10000</a>
%e A399314 Let S = {m < n : rad(m) = rad(n)}.
%e A399314 Table of n, a(n) for select n:
%e A399314        n        a(n)                        S(n)
%e A399314   -----------------------------------------------------------------------------
%e A399314        1         375 = 3 * 5^3              {15, 45, 75, 135, 225}
%e A399314        2        1715 = 5 * 7^3              {35, 175, 245, 875, 1225}
%e A399314        3        6655 = 5 * 11^3             {55, 275, 605, 1375, 3025}
%e A399314        4        9317 = 7 * 11^3             {77, 539, 847, 3773, 5929}
%e A399314        5       10875 = 3 * 5^3 * 29         {435, 1305, 2175, 3915, 6525}
%e A399314       15       24167 = 11 * 13^3            {143, 1573, 1859, 17303, 20449}
%e A399314       39       63869 = 13 * 17^3            {221, 2873, 3757, 37349, 48841}
%e A399314       70      116603 = 17 * 19^3            {323, 5491, 6137, 93347, 104329}
%e A399314      136      231173 = 19 * 23^3            {437, 8303, 10051, 157757, 190969}
%e A399314      194      337125 = 3 * 5^3 * P(10..11)  {13485, 40455, 67425, 121365, 202275}
%e A399314     7101    12473625 = 3 * 5^3 * P(10..12)  {498945, 1496835, 2494725, 4490505, 7484175}
%e A399314   291027   511418625 = 3 * 5^3 * P(10..13)  {20456745, 61370235, 102283725, 184110705, 306851175}
%t A399314 facs[x_] := facs[x] = FactorInteger[x][[All, 1]]; nn = 50000;
%t A399314 Table[Set[r[n], Times @@ facs[n]], {n, nn}];
%t A399314 s = Select[Range[2, nn], Not @* PrimePowerQ];
%t A399314 t = Select[s, #1/Apply[Times, #2] == #2[[2]]^2 & @@ {#, facs[#]} &];
%t A399314 Select[t, Function[m, Count[Range[m], _?(r[#] == r[m] &)] == 6] ]
%Y A399314 Cf. A007947, A008479, A119288, A398802.
%K A399314 nonn,new
%O A399314 1,1
%A A399314 _Michael De Vlieger_, Sep 03 2026
