%I A399202 #22 Aug 22 2026 09:56:42
%S A399202 3,0,1,50,25,1250,325,31250,1105,8450,4225,19531250,5525,488281250,
%T A399202 203125,211250,27625,305175781250,71825,7629394531250,138125,5281250,
%U A399202 2640625,4768371582031250,160225,35701250,17850625,2442050,1221025,74505805969238281250,1795625,1862645149230957031250
%N A399202 a(n) is the smallest nonnegative integer k where there are exactly n nonnegative integer solutions to x^2 + y^2 = k.
%C A399202 a(n) is the smallest nonnegative k such that A000925(k) = n.
%H A399202 Seiichi Manyama, <a href="/A399202/b399202.txt">Table of n, a(n) for n = 0..100</a>
%F A399202 For n >= 2, a(n) = min(A018782(n), A018782(n-1)) if n is even, and a(n) = 2*A018782(n) if n is odd.
%e A399202    n | A018782 |    a(n)
%e A399202   ---+---------+-----------
%e A399202    1 |       1 |        (0)
%e A399202    2 |       5 |         1
%e A399202    3 |      25 |      2*25
%e A399202    4 |      65 |        25
%e A399202    5 |     625 |     2*625
%e A399202    6 |     325 |       325
%e A399202    7 |   15625 |   2*15625
%e A399202    8 |    1105 |      1105
%e A399202    9 |    4225 |    2*4225
%e A399202   10 |    8125 |      4225
%e A399202   11 | 9765625 | 2*9765625
%e A399202   12 |    5525 |      5525
%o A399202 (PARI) b(n, k) = sum(i=0, sqrtint(n), sum(j=0, sqrtint(n\k), i^2+k*j^2==n));
%o A399202 a(n, k=1) = my(cnt=0); while(b(cnt, k)!=n, cnt++); cnt;
%Y A399202 Cf. A374285, A374286, A399198, A374288.
%Y A399202 Cf. A000925, A006339, A018782, A328151.
%K A399202 nonn,new
%O A399202 0,1
