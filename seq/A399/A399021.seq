%I A399021 #11 Aug 24 2026 17:07:27
%S A399021 1,7,7,1,23,17,7,7,31,17,1,23,31,79,17,47,23,7,41,41,7,31,73,119,17,
%T A399021 89,47,1,49,73,23,31,89,151,191,71,79,17,49,113,47,23,97,329,7,71,119,
%U A399021 41,41,127,79,7,97,191,31,257,161,73,311,127,119,17,89,199,313
%N A399021 a(n) is the minimum absolute difference between the legs of a primitive Pythagorean triangle with larger Euclid parameter n.
%C A399021 Equivalently, a(n) is the smallest positive entry in row n of A258149.
%C A399021 With x = n - k and y = k, a(n) is the minimum of |x^2 - 2*y^2| over positive x, y such that x + y = n, gcd(x, y) = 1, and x is odd.
%C A399021 With m = n + k, equivalently a(n) is the minimum of |m^2 - 2*n^2| over n < m < 2*n such that m is odd and gcd(m, n) = 1.
%C A399021 The set of distinct values of this sequence is exactly A058529. Moreover, every term of A058529 occurs infinitely often in this sequence.
%C A399021 For d in A058529, let T(d) be the set of n for which there is an odd m, n < m < 2*n, gcd(m, n) = 1, and |m^2 - 2*n^2| = d. Then T(d) is the disjoint union of exactly 2^omega(d) Pell orbits. Each orbit, written as u(0), u(1), ..., satisfies u(j + 2) = 2*u(j + 1) + u(j).
%C A399021 If n is in T(d) and 2*n > d, then a(n) = d. Thus only finitely many initial terms of the Pell orbits for d can be suppressed by smaller admissible norms.
%C A399021 For fixed d in A058529, #{n <= X : a(n) = d} = 2^omega(d)*log(X)/log(1 + sqrt(2)) + O_d(1).
%C A399021 The indices n for which a(n) = 1 are the Pell numbers A000129(j), j >= 2.
%C A399021 The indices n for which a(n) = 7 are A266504(j), j >= 3.
%H A399021 Felix Huber, <a href="/A399021/b399021.txt">Table of n, a(n) for n = 2..10000</a>.
%H A399021 Felix Huber, <a href="/A399021/a399021.pdf">Minimal Leg Differences at Fixed Euclid Parameter: Pell Orbits and Finite Competition</a>.
%H A399021 D. P. Wegener, <a href="https://www.fq.math.ca/Scanned/13-3/wegener.pdf">Primitive Pythagorean Triples with Sum or Difference of Legs Equal to a Prime</a>, Fibonacci Quarterly 13 (1975), 263-277.
%H A399021 D. P. Wegener, <a href="https://www.fq.math.ca/Scanned/15-3/wegener.pdf">Semi-Associates in Z[sqrt(2)] and Primitive Pythagorean Triples</a>, Fibonacci Quarterly 15 (1977), 258-264.
%F A399021 a(n) = min({abs(n^2 - k^2 - 2*n*k) : 1 <= k < n, gcd(n, k) = 1, n - k odd}).
%F A399021 a(n) = min({abs(x^2 - 2*y^2) : x + y = n, x > 0, y > 0, gcd(x, y) = 1, x odd}).
%F A399021 a(n) = min({abs(m^2 - 2*n^2) : n < m < 2*n, gcd(m, n) = 1, m odd}).
%e A399021 For n = 6 the admissible values of k are 1 and 5. They give the primitive Pythagorean triples (12, 35, 37) and (11, 60, 61), whose leg differences are 23 and 49, respectively. Hence a(6) = 23.
%e A399021 For n = 12 and k = 5, the primitive Pythagorean triple is (119, 120, 169), so a(12) = 1.
%p A399021 A399021 := proc(n) option remember;
%p A399021     local a, m, r, v;
%p A399021     r := floor(sqrt(2)*n);
%p A399021     a := 2*n^2;
%p A399021     m := r;
%p A399021     while m > n do
%p A399021         if irem(m, 2) = 1 and igcd(m, n) = 1 then
%p A399021             a := abs(m^2 - 2*n^2);
%p A399021             break;
%p A399021         end if;
%p A399021         m := m - 1;
%p A399021     end do;
%p A399021     m := r + 1;
%p A399021     while m < 2*n do
%p A399021         if irem(m, 2) = 1 and igcd(m, n) = 1 then
%p A399021             v := abs(m^2 - 2*n^2);
%p A399021             if v < a then
%p A399021                 a := v;
%p A399021             end if;
%p A399021             break;
%p A399021         end if;
%p A399021         m := m + 1;
%p A399021     end do;
%p A399021     a;
%p A399021 end proc:
%p A399021 seq(A399021(n), n = 2 .. 66);
%Y A399021 Cf. A000129, A058529, A087056, A087059, A258149, A266504.
%K A399021 nonn,new
%O A399021 2,2
%A A399021 _Felix Huber_, Aug 16 2026
