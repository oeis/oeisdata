%e A399010   ...
%o A399010 (PARI)
%o A399010 B(n,k) = binomial(n,k)^2*k!
%o A399010 R2(n,k) = if(k%2>n%2, 0, my(t=k\2); binomial(n\2,t)^2*2^t*t!)
%o A399010 R4(n,k) = if(k%4>n%2, 0, my(t=k\4); binomial(n\2,2*t)*(2*t)!/t!)
%o A399010 T(n,k) = (B(n,k) + R2(n,k) + 2*R4(n,k))/4
