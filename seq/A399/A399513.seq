%I A399513 #15 Sep 23 2026 08:50:48
%S A399513 3,267,1551,27489,768075,62475,1745625,2725625,15833125,5996375,
%T A399513 34832875,13192025,76632325,29022455,168591115,63849401,370900453,
%U A399513 6573618667,183674639225,14940042425,417442361875,33954641875,948732640625,77169640625,2156210546875,175385546875
%N A399513 Trajectory of 3 under Conway's PIGAME function.
%C A399513 See A395539 for the definition of the PIGAME successor function and many related references.
%H A399513 M. F. Hasler, <a href="/A399513/b399513.txt">Table of n, a(n) for n = 0..1000</a>
%F A399513 a(n+1) = A395539(a(n)) for all n >= 0.
%e A399513 a(0) = 3 is the initial value. To get the next value, we must apply an iteration of Conway's FRACTRAN program PIGAME to this initial value. The first fraction that yields an integer is the last one in the list, A350555(40)/A350556(40) = 89/1, so a(1) = 3 * 89 = 267.
%e A399513 Then, for the next iteration, we find that A350555(15)/A350556(15) = 11*47/89 is the first fraction to yield an integer, a(2) = A395539(267) = 3 * 11 * 47 = 1551.
%e A399513 The next values are:
%e A399513 a(3) = 3 * 7^2 * 11 * 17 = 27489
%e A399513 a(4) = 3 * 5^2 * 7^2 * 11 * 19 = 768075,
%e A399513 a(5) = 3 * 5^2 * 7^2 * 17 = 62475,
%e A399513 a(6) = 3 * 5^4 * 7^2 * 19 = 1745625,
%e A399513 a(7) = 5^4 * 7^2 * 89 = 2725625,
%e A399513 a(8) = 5^4 * 7^2 * 11 * 47 = 15833125,
%e A399513 a(9) = 5^3 * 7^2 * 11 * 89 = 5996375,
%e A399513 a(10) = 5^3 * 7^2 * 11^2 * 47 = 34832875.
%e A399513 Later values are:
%e A399513 a(100) = 2^8 * 3 * 5^4 * 7^2 * 11^20 * 29 = 4.5886931654360053107581808 * 10^29,
%e A399513 a(1000) = 2 * 3^46 * 5^9 * 7^20 * 11^121 * 61 ~ 1.71847528781197932522 * 10^173,
%e A399513 a(10^4) = 3^121 * 5^10 * 7^326 * 11^1540 * 23 ~ 2.1369575187392492939 * 10^1945,
%e A399513 a(10^5) = 2^4 * 3^4292 * 5^3 * 7^4064 * 11^9801 * 79 ~ 1.48328360852 * 10^15694,
%e A399513 a(10^6) = 2^7 * 3^9801 * 5 * 7^18117 * 11^162263 * 29 ~ 4.7474 * 10^188970, etc.
%t A399513 pigame = {365/46, 29/161, 79/575, 679/451, 3159/413, 83/407, 473/371, 638/355, 434/335, 89/235, 17/209, 79/122, 31/183, 41/115, 517/89, 111/83, 305/79, 23/73, 73/71, 61/67, 37/61, 19/59, 89/57, 41/53, 833/47, 53/43, 86/41, 13/38, 23/37, 67/31, 71/29, 83/19, 475/17, 59/13, 41/291, 1/7, 1/11, 1/1024, 1/97, 89};
%t A399513 NestList[SelectFirst[#*pigame, IntegerQ] &, 3, 50] (* _Paolo Xausa_, Sep 23 2026 *)
%o A399513 (PARI) A399513_upto(N,a=3)=vector(N+1,i,a=if(i>1,A395539(a),a)) \\ Use optional arg a to compute the trajectory of a different initial value.
%o A399513 (Python)
%o A399513 A399513=lambda upto=99:[(t:=A395539(t)if i else 3)for i in range(upto)]
%Y A399513 Cf. A395539 (definition of the PIGAME successor function); A399511, A399512 and A399514 (trajectory of 1, 2 and 4).
%K A399513 nonn,easy,new
%O A399513 0,1
%A A399513 _M. F. Hasler_, Sep 11 2026
