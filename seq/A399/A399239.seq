%U A399239 136920994,-349184830,894520014,-2297241424,5915819282,-15257360926,39416906655,-101957837545
%N A399239 a(n) = Sum_{k=0..n} (-1)^(n-k) * binomial(n, k) * T(k), where T(n) = A000081(n) for n >= 1, T(0) = 1.
%p A399239 p := proc(n) option remember; local m, k; ifelse(n < 2, 1, add(m*add(p(m)*p(n-k*m), k=1..(n-1)/m), m=1..n-1) /(n-1)) end:
%p A399239 a := n -> local k; add((-1)^(n-k)*binomial(n, k)*p(k), k=0..n): seq(a(n), n=0..32);
%Y A399239 Cf. A000081, A399238.
%K A399239 sign,new
%O A399239 0,6
