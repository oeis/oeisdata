%I A399804 #60 Nov 21 2026 23:11:14
%S A399804 1,3,13,106,941,9027,92200,987326,10944949,124438677,1441810737,
%T A399804 16951231550,201635290308,2421718628214,29325043043620,
%U A399804 357631425346934,4388771465250245,54157629300792633,671637901852327987,8366745657193218250,104650129122399484773
%N A399804 Total number of levels in all Dyck paths of semilength 2n containing exactly n+1 path nodes.
%H A399804 Alois P. Heinz, <a href="/A399804/b399804.txt">Table of n, a(n) for n = 0..300</a>
%F A399804 a(n) = A371928(2*n,n+1).
%e A399804 a(1) = 2 + 1 = 3:
%e A399804    1
%e A399804   _2  /\     _2
%e A399804   _2 /  \     3 /\/\   .
%p A399804 f:= proc(h, n) option remember; `if`(h<0, 0, `if`(n=0, 1,
%p A399804      `if`(h=0, 0, add(f(h-1, i-1)*f(h, n-i), i=1..n))))
%p A399804     end:
%p A399804 u:= proc(h, n) option remember; `if`(h=0, `if`(n=0, 1, 0), add(
%p A399804       u(h-1, i)*add(f(h-1, j)*f(h-1, n-i-j), j=0..n-i), i=0..n))
%p A399804     end:
%p A399804 b:= proc(h, r, n) option remember; `if`(r=0, `if`(n=0, 1, 0), add(
%p A399804       b(h, r-1, i)*(f(h-1, n-i)+binomial(2*(n-i), n-i)/(n-i+1)), i=0..n))
%p A399804     end:
%p A399804 g:= proc(n, k) option remember; `if`(k<1 or k>n+1, 0, b(0, k-1, n-k+1)+
%p A399804       add(add(u(h, m)*b(h, k-1, n-h-k+1-m), m=0..n-h-k+1), h=1..n-k+1))
%p A399804     end:
%p A399804 a:= n-> g(2*n, n+1):
%p A399804 seq(a(n), n=0..20);
%Y A399804 Cf. A371928.
%K A399804 nonn,new
%O A399804 0,2
%A A399804 _Alois P. Heinz_, Nov 16 2026
