%N A399536 G.f. A(x) satisfies: A(x) = (1 + x + x^3 * A(2*x)) / (1 - x^2).
%F A399536 a(n) = 1 for n < 3; a(n) = a(n-2) + 2^(n-3) * a(n-3).
%t A399536 nmax = 24; A[_] = 1; Do[A[x_] = (1 + x + x^3 A[2 x])/(1 - x^2) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A399536 (* Alternative: *)
%t A399536 a[0] = a[1] = a[2] = 1; a[n_] := a[n] = a[n - 2] + 2^(n - 3) a[n - 3]; Table[a[n], {n, 0, 24}]
