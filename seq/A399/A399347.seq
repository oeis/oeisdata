%I A399347 #8 Oct 11 2026 16:55:30
%S A399347 1,2,3,3,4,3,4,4,4,4,5,5,6,6,5,5,6,6,7,7,7,7,8,8,8,8,8,8,9,9,10,10,10,
%T A399347 10,9,9,10,10,10,10,11,11,12,12,12,12,13,13,13,13,13,13,14,14,14,14,
%U A399347 14,14,15,15,16,16,16,16,16,16,17,17,17,17,18,18,19,19
%N A399347 a(n) is the smallest size of a pairwise coprime subset of {1, ..., n} to which no further element can be added.
%C A399347 Every such subset contains 1, and each prime p <= n divides exactly one of its elements. Thus a(n) - 1 is the minimum number of parts in a partition of the primes <= n such that the product of the primes in each part is <= n.
%C A399347 A minimum partition can always be chosen with parts of size at most 2. Hence a(n) - 1 = pi(n) - m(n), where m(n) is the maximum number of pairwise disjoint pairs of distinct primes p, q with p*q <= n.
%C A399347 If p_j is the j-th prime, let B(k) = max_{1 <= j <= k} p_j*p_{2*k + 1 - j} = A339115(2*k + 1). Then B(k) is strictly increasing, m(n) = #{k >= 1: B(k) <= n}, and m(n) ~ pi(sqrt(n)).
%C A399347 For n <= 10^6, computation gives 0 <= pi(sqrt(n)) - m(n) <= 3, so m(n) stays within 3 of its upper bound pi(sqrt(n)).
%C A399347 A343659 counts all pairwise coprime subsets of {1, ..., n} to which no further element can be added; their maximum size is pi(n) + 1 = A036234(n), while this sequence gives their minimum size.
%H A399347 Felix Huber, <a href="/A399347/b399347.txt">Table of n, a(n) for n = 1..10000</a>.
%H A399347 Felix Huber, <a href="/A399347/a399347.pdf">Proof of the exact formula and asymptotics</a>.
%H A399347 J. Barkley Rosser and Lowell Schoenfeld, <a href="https://doi.org/10.1215/ijm/1255631807">Approximate formulas for some functions of prime numbers</a>, Illinois J. Math. 6 (1962), 64-94.
%F A399347 a(n) = pi(n) + 1 - #{k >= 1: A339115(2*k + 1) <= n}, where pi = A000720.
%F A399347 a(n) - a(n - 1) = [n is prime] - [n = A339115(2*k + 1) for some k >= 1], for n >= 2, where [P] is 1 if P is true and 0 otherwise.
%F A399347 a(n) = pi(n) - pi(sqrt(n)) + o(pi(sqrt(n))) = pi(n) - (2 + o(1))*sqrt(n)/log(n).
%e A399347 For n = 6, {1, 5, 6} is such a subset of minimum size, so a(6) = 3.
%e A399347 At n = 35 a third disjoint prime pair becomes possible: 2*13, 3*11, and 5*7 are all <= 35. Since pi(35) = 11, a(35) = pi(35) + 1 - 3 = 9; one optimal set is {1, 17, 19, 23, 26, 29, 31, 33, 35}.
%p A399347 f := proc(k)
%p A399347     option remember;
%p A399347     local i;
%p A399347     max(seq(ithprime(i)*ithprime(2*k + 1 - i), i = 1 .. k))
%p A399347 end proc:
%p A399347 A399347 := proc(n)
%p A399347     local k;
%p A399347     k := 0;
%p A399347     while f(k + 1) <= n do
%p A399347         k := k + 1
%p A399347     end do;
%p A399347     NumberTheory:-pi(n) + 1 - k
%p A399347 end proc:
%p A399347 seq(A399347(n), n = 1 .. 74);
%Y A399347 Cf. A000720, A036234, A084422, A319187, A339115, A343659.
%K A399347 nonn
