%S A399682 1,1,2,3,14,5,6,7,17,19,10,11,38,13,14,15,33,17,37,19,41,21,22,23,74,
%T A399682 51,26,55,57,29,30,31,65,33,34,35,73,37,38,39,122,41,42,43,89,91,46,
%U A399682 47,97,149,101,51,105,53,109,55,113,57,58,59,182,61,62,127,129
%N A399682 a(n) = smallest squarefree number of the form n*k-1.
%C A399682 Corresponding k are given by A399381.
%H A399682 Aidan Markey, <a href="/A399682/b399682.txt">Table of n, a(n) for n = 1..10000</a>
%H A399682 Aidan Markey, <a href="/A399682/a399682.txt">Java program</a>
%e A399682 a(13) = 38 because 13*1-1 = 12 and 13*2-1 = 25 are not squarefree, but 13*3-1 = 38 is squarefree.
%t A399682 A399682[n_] := n*NestWhile[# + 1 &, 1, !SquareFreeQ[#*n - 1] &] - 1;
%t A399682 Array[A399682, 100] (* _Paolo Xausa_, Sep 12 2026 *)
%o A399682 (Java) // see links section.
%o A399682 (Python)
%o A399682 from itertools import count
%o A399682 from sympy import factorint
%o A399682 def a(n): return next(m for k in count(1) if max(factorint(m:=k*n-1).values())<2) if n > 2 else 1
%o A399682 print([a(n) for n in range(1, 66)]) # _Michael S. Branicky_, Sep 07 2026
%o A399682 (PARI) a(n) = my(k=1); while (!issquarefree(n*k-1), k++); n*k-1; \\ _Michel Marcus_, Sep 07 2026
