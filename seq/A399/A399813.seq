%N A399813 Palindromic numbers with exactly one non-palindromic divisor.
%H A399813 Michael S. Branicky, <a href="/A399813/b399813.txt">Table of n, a(n) for n = 1..10000</a>
%e A399813 35453 is a term since it is a palindrome; its divisors are 1, 11, 121, 293, 3223 and 35453; and exactly one of its divisors is non-palindromic: 293.
%o A399813 (PARI) rev(n)=fromdigits(Vecrev(digits(n)))
%o A399813 isok(n) = if(n==rev(n), my(c=sumdiv(n,d,rev(d)!=d));c==1, 0) \\ _Andrew Howroyd_, Sep 12 2026
%o A399813 (Python)
%o A399813 from sympy.ntheory import divisors, is_palindromic
%o A399813 def ok(n): return is_palindromic(n) and sum(not is_palindromic(d) for d in divisors(n)) == 1
%o A399813 print([k for k in range(40000) if ok(k)]) # _Michael S. Branicky_, Sep 12 2026
%o A399813 (Python) # faster for initial segment of sequence
%o A399813 from itertools import count, islice, product
%o A399813 def ispal(n): return (s:=str(n)) == s[::-1]
%o A399813 def pals(base=10): # all base-base palindromes
%o A399813     digits = "".join(str(i) for i in range(base))
%o A399813     for d in count(1):
%o A399813         for p in product(digits, repeat=d//2):
%o A399813             if d > 1 and p[0] == "0": continue
%o A399813             left = "".join(p); right = left[::-1]
%o A399813             for mid in [[""], digits][d%2]: yield int(left + mid + right)
%o A399813 def okpal(p):
%o A399813     c = 0
%o A399813     for d in divisors(p, generator=True):
%o A399813         if not ispal(d): c += 1
%o A399813         if c > 1: return False
%o A399813     return c == 1
%o A399813 def agen(): yield from filter(okpal, pals())
%o A399813 print(list(islice(agen(), 50))) # _Michael S. Branicky_, Sep 12 2026
