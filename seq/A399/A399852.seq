%I A399852 #13 Sep 20 2026 23:23:28
%S A399852 2,5,6,8,9,14,18,20,21,23,26,29,30,33,35,36,39,41,44,48,50,51,53,56,
%T A399852 63,65,68,69,74,75,78,81,83,86,89,95,96,98,99,105,111,113,116,119,120,
%U A399852 125,128,131,134,135,138,140,146,153,155,156,158,165,168,173,174,176,179,183,186,189,191,194,198,200,204,209,210,215,219,224
%N A399852 Numbers k >= 2 for which 2k is missing in A399704.
%C A399852 Each t >= 3 for which t+1 is composite is a term of A399704, which includes in particular all odd t >= 3. Hence, only even numbers are missing in A399704.
%C A399852 Because m <= A399704(m) <= 3m/2, to check if 2k is a term of A399704 it is sufficient to compare 2k to A399704(m) for m in ceiling(4k/3), ..., 2k.
%H A399852 Markus Sigg, <a href="/A399852/b399852.txt">Table of n, a(n) for n = 1..10000</a>
%o A399852 (PARI) k = 224; [ d/2 | d <- setminus(vector(k, i, 2*i), Set(vector(2*k-2, i, a399704(2 + i)))), d >= 4 ]
%Y A399852 Cf. A000142, A000217, A057568, A063520, A065015, A104173, A399704.
%K A399852 nonn,easy,new
%O A399852 1,1
%A A399852 _Markus Sigg_, Sep 13 2026
