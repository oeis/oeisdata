%U A399995 30,40,36,35,38,31,33,44,43,37,47,33,46,44,48,46,48,50,51,43,45,38,35,46,55,45,43,49,61,49,63,52
%N A399995 a(1) = 0. For n > 1, a(n) is the number of ways to write a(n-1) as the sum of two earlier terms with distinct positions in the sequence.
%C A399995 Conjecture: Many numbers, beginning with 5 and 9, never occur in this sequence (see A397471).
%C A399995 It follows from the Erdős-Fuchs theorem that the average behavior of a representation function cannot be too close to a linear function, but it is still possible to give an estimate for the growth of this sequence as n/sqrt(2) because if we write g(x) = Sum_{k>=0} x^floor(k/sqrt(2)), then we know that [x^m] (1/2)*(g(x)^2-g(x^2)) will be relatively close to m or even exactly m in many cases. - _Thomas Scheuerle_, Jun 29 2026
%H A399995 Sean A. Irvine, <a href="/A399995/b399995.txt">Table of n, a(n) for n = 1..10000</a>
%H A399995 Sean A. Irvine, <a href="/A399995/a399995_1.txt.gz">Table of n, a(n) for n = 1..1000000</a> [4.3M, gzip]
%H A399995 OEIS Wiki, <a href="https://oeis.org/wiki/A400K_Winners">A400K Winners</a>, 2026.
%F A399995 a(n) = [x^a(n-1)] (1/2)*(g(x)^2-g(x^2)), where g(x) = Sum_{k=1..n-1} x^a(k). - _Thomas Scheuerle_, Jun 29 2026
%e A399995 a(2) = 0, since we only have one previous term.
%e A399995 a(3) = 1, since a(1) + a(2) = a(2).
%e A399995 a(4) = 2, since a(1) + a(3) = a(3) and a(2) + a(3) = a(3).
%p A399995 P:=proc(q) local a,b,j,k,n,v; v:=[0]; for n from 1 to q do a:=v[nops(v)]; b:=0;
%p A399995 for k from 1 to nops(v)-1 do for j from k+1 to nops(v) do if v[k]+v[j]=a then b:=b+1;
%p A399995 fi; od; od; v:=[op(v),b]; od; op(v); end: P(100); # _Paolo P. Lava_, Jul 02 2026
%o A399995 (Python)
%o A399995 def sequence(N=100):
%o A399995     a = [0]  # a(1) = 0
%o A399995     for n in range(1, N):
%o A399995         target = a[n - 1]  # a(n)
%o A399995         count = 0
%o A399995         # count pairs (i < j) with i,j in [0..n-1]
%o A399995         for i in range(n):
%o A399995             for j in range(i + 1, n):
%o A399995                 if a[i] + a[j] == target:
%o A399995                     count += 1
%o A399995         a.append(count)
%o A399995     return a
%o A399995 seq = sequence(100)
%o A399995 print(seq)
%o A399995 (Python)
%o A399995 from collections import Counter
%o A399995 from itertools import islice
%o A399995 def A399995_gen(): # generator of terms
%o A399995     alst, an, c = [], 0, Counter()
%o A399995     while True:
%o A399995         an = c[an]
%o A399995         yield an
%o A399995         c.update(an+ai for ai in alst)
%o A399995         alst.append(an)
%o A399995 print(list(islice(A399995_gen(), 83))) # _Michael S. Branicky_, Jun 26 2026
%o A399995 (PARI)
%o A399995 ListA(max_n) = {my(M=Map(), v=[0], c=0, p=0);  while(#v<max_n, c=0; mapisdefined(M, v[#v], &c); v=concat(v, c); for(k=1, #v-1, c=0; p=v[#v]+v[k]; mapisdefined(M, p, &c); mapput(~M, p, c+1))); v} \\ _Thomas Scheuerle_, Jun 29 2026
