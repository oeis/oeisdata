%I A399469 #8 Sep 07 2026 19:56:50
%S A399469 1,2,2,3,2,3,2,4,3,4,2,4,2,4,3,5,2,4,2,5,4,4,2,5,3,4,4,5,2,5,2,6,4,4,
%T A399469 4,5,2,4,4,6,2,5,2,6,4,4,2,6,3,6,4,6,2,5,4,5,4,4,2,6,2,4,5,7,4,5,2,6,
%U A399469 4,6,2,6,2,4,4,6,4,6,2,6,5,4,2,6,4,4,4,7
%N A399469 a(n) is the minimum cardinality of an inclusion-maximal Sidon subset of the set of positive divisors of n.
%C A399469 Let D(n) be the set of positive divisors of n. A Sidon subset of D(n) is a subset for which all positive differences between distinct elements are different; equivalently, all unordered sums of two not necessarily distinct elements are different.
%C A399469 "Inclusion-maximal" means that no further element of D(n) can be adjoined while preserving the Sidon property; this is different from having maximum possible cardinality.
%C A399469 The maximum cardinality of an inclusion-maximal Sidon subset of D(n) is A398434(n).
%C A399469 This is the divisor-set analog of A382397.
%H A399469 Felix Huber, <a href="/A399469/b399469.txt">Table of n, a(n) for n = 1..1679</a>.
%H A399469 Wikipedia, <a href="https://en.wikipedia.org/wiki/Sidon_sequence">Sidon sequence</a>.
%H A399469 <a href="/index/Go#Golomb">Index entries for sequences related to Golomb rulers</a>.
%F A399469 a(n) = min{k : A399471(n, k) > 0}.
%F A399469 a(n) <= A398434(n) <= A000005(n).
%F A399469 a(n) = A000005(n) iff D(n) itself is a Sidon set, equivalently iff A398435(n) = 0.
%F A399469 For prime p and e >= 1, a(p^e) = e + 1.
%F A399469 For primes p < q, a(p*q) = 3 if q = 2*p - 1, and a(p*q) = 4 otherwise.
%e A399469 a(18) = 4 since D(18) = {1, 2, 3, 6, 9, 18} has the four inclusion-maximal Sidon subsets {1, 3, 6, 18}, {1, 3, 9, 18}, {2, 3, 6, 18}, and {2, 3, 9, 18} of cardinality 4, while the remaining inclusion-maximal Sidon subset {1, 2, 6, 9, 18} has cardinality 5.
%p A399469 A399469 := proc(n)
%p A399469     option remember;
%p A399469     local a, d, f, g, m;
%p A399469     d := sort([op(NumberTheory:-Divisors(n))]); m := nops(d); a := m;
%p A399469     f := proc(j, u, v)
%p A399469         local k;
%p A399469         if member(2*j, v) then return false end if;
%p A399469         for k in u do
%p A399469             if member(j + k, v) then return false end if
%p A399469         end do;
%p A399469         true
%p A399469     end proc;
%p A399469     g := proc(i, u, v)
%p A399469         local j, k;
%p A399469         if nops(u) >= a then return NULL end if;
%p A399469         if i > m then
%p A399469             for j in d do
%p A399469                 if not member(j, u) and f(j, u, v) then return NULL end if
%p A399469             end do;
%p A399469             a := nops(u);
%p A399469             return NULL
%p A399469         end if;
%p A399469         j := d[i];
%p A399469         if f(j, u, v) then
%p A399469             g(i + 1, [op(u), j], v union {2*j, seq(j + k, k in u)})
%p A399469         end if;
%p A399469         g(i + 1, u, v)
%p A399469     end proc;
%p A399469     g(1, [], {});
%p A399469     a
%p A399469 end proc:
%p A399469 seq(A399469(n), n = 1 .. 88);
%Y A399469 Cf. A000005, A325879, A382397, A398434, A398435, A398577, A399118, A399119, A399470, A399471.
%K A399469 nonn,new
%O A399469 1,2
%A A399469 _Felix Huber_, Sep 01 2026
