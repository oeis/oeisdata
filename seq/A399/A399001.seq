%p A399001 # Using function 'binomial_matrix' from A399000. *)
%p A399001 BM := binomial_matrix(n -> combinat:-fibonacci(n)):
%p A399001 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%t A399001 (* Using function 'binomialMatrix' from A399000. *)
%t A399001 bM = binomialMatrix[Fibonacci];
%t A399001 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A399001 (Python)  # Using function 'binomial_matrix' from A399000.
%o A399001 F = lambda n: (1<<((n+1)*(n+1)))//((4<<(2*n))-(2<<n)-1)&((2<<n)-1)
%o A399001 M = binomial_matrix(F)
%o A399001 for n in range(9): print([M(n, k) for k in range(9)])
