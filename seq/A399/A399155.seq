%S A399155 0,0,0,0,1,0,1,1,3,0,2,0,5,4,5,0,5,0,6,7,9,0,8,6,11,8,10,0,9,0,9,13,
%T A399155 15,11,14,0,17,16,14,0,15,0,18,15,21,0,16,15,17,22,22,0,23,21,20,25,
%U A399155 27,0,24,0,29,22,29,26,27,0,30,31,25,0,32,0,35,26,34
%N A399155 a(n) = f(n) - g(n), where f(n) is the number of steps to reach 0 by repeatedly subtracting the smallest prime factor of the current value, and g(n) is the number of steps to reach 0 by repeatedly subtracting the largest prime factor.
%C A399155 a(n) = 0 if and only if n = 4 or n is prime.
%C A399155 a(2*p) = p - 2 for odd primes p.
%C A399155 Conjecture: a(n) >= 0 for all n >= 2; equivalently, subtracting the largest prime factor never takes more steps than subtracting the smallest.
%C A399155 Empirical observation: each positive value appears to be attained only finitely often. For example, for n <= 20000 the only solutions are a(n) = 2 at n = 12, a(n) = 3 at n = 10, and a(n) = 4 at n = 15.
%F A399155 a(2*p) = p - 2 for odd primes p.
%e A399155 n=6: subtracting the smallest prime factor gives 6 -> 4 -> 2 -> 0 (3 steps); subtracting the largest gives 6 -> 3 -> 0 (2 steps); so a(6) = 3 - 2 = 1.
%e A399155 n=10: smallest-factor path 10 -> 8 -> 6 -> 4 -> 2 -> 0 (5 steps); largest-factor path 10 -> 5 -> 0 (2 steps); so a(10) = 5 - 2 = 3.
%t A399155 f[n_]:=Length[NestWhileList[#-FactorInteger[#][[1,1]]&,n,#>0&]]-1;
%t A399155 g[n_]:=Length[NestWhileList[#-FactorInteger[#][[-1,1]]&,n,#>0&]]-1;
%t A399155 Table[f[n]-g[n],{n,2,76}]
%o A399155 (Python)
%o A399155 from sympy import primefactors
%o A399155 def steps(n, largest):
%o A399155     c = 0
%o A399155     while n > 0:
%o A399155         p = max(primefactors(n)) if largest else min(primefactors(n))
%o A399155         n -= p; c += 1
%o A399155     return c
%o A399155 def a(n): return steps(n, False) - steps(n, True)
%o A399155 print([a(n) for n in range(2, 77)])
