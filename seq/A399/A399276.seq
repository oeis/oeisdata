%T A399276 6,1,1,6,0,0,4,0,1,1,6,1,8,0,0,6,0,5,1,0,6,1,0,7,1,0,0,7,1,9,0,0,7,0,
%U A399276 1,8,0,0,7,0,0,7,1,0,0,0,1,9,1,9,1,0,11
%N A399276 Number of ways writing the n-th semiprime as a sum of two primes.
%H A399276 Alois P. Heinz, <a href="/A399276/b399276.txt">Table of n, a(n) for n = 1..10000</a>
%F A399276 a(n) = A061358(A001358(n)).
%e A399276 a(4) = 2 since A001358(4) = 10 = 2*5 = 3 + 7 = 5 + 5.
%p A399276 sp:= proc(n) option remember; local k; if n=1 then 4 else for k
%p A399276        from 1+sp(n-1) while not 2=add(i[2], i=ifactors(k)[2]) do od; k fi
%p A399276      end:
%p A399276 b:= proc(n) option remember; `if`(irem(n, 2, 'h')=1, `if`(isprime(n-2), 1, 0),
%p A399276        add(`if`(andmap(isprime, [h-i, h+i]), 1, 0), i=0..h-2))
%p A399276     end:
%p A399276 a:= n-> b(sp(n)):
%p A399276 seq(a(n), n=1..87);  # _Alois P. Heinz_, Sep 28 2026
%Y A399276 Cf. A001358, A002375, A062721, A089268, A157931.
%Y A399276 Subsequence of A061358.
