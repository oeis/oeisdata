%N A399843 a(n) is the number of nonzero digits in the product of first n primes (cf. A002110).
%H A399843 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A399843 a(n) = A034886(A002110(n)) - A079099(A002110(n)).
%t A399843 primorial[n_] := Product[Prime[i], {i, n}]; (* A002110 *)
%t A399843 a[n_]:=Length[Select[IntegerDigits[primorial[n]], Positive]]; Array[a,70,0]
%Y A399843 Cf. A002110, A034886, A079099, A399842.
