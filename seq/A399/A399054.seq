%I A399054 #55 Oct 09 2026 16:03:18
%S A399054 2,6,18,52,160,520,1752,5942,20458,71492,252322,895248,3196698,
%T A399054 11457038,41226568
%N A399054 Number of distinct resistances that can be produced from a circuit of exactly n resistors, each of which is 1 ohm or 2 ohms, using only series and parallel combinations.
%e A399054 a(1) = 2 because a single resistor gives 1 or 2 ohms.
%e A399054 a(2) = 6: in series the possibilities are 2, 3, 4 ohms, and in parallel 1/2, 2/3, 1 ohms.
%o A399054 (Python)
%o A399054 from fractions import Fraction
%o A399054 def A(N):
%o A399054     S = {1: {Fraction(1), Fraction(2)}}
%o A399054     for n in range(2, N+1):
%o A399054         T = set()
%o A399054         for k in range(1, n//2 + 1):
%o A399054             for x in S[k]:
%o A399054                 for y in S[n-k]:
%o A399054                     T.add(x+y); T.add(x*y/(x+y))
%o A399054         S[n] = T
%o A399054     return [len(S[n]) for n in range(1, N+1)]
%o A399054 print(A(11))
%Y A399054 Cf. A048211 (with 1-ohm resistors only).
%K A399054 nonn,more,new
%O A399054 1,1
%A A399054 _Avdhoot Pande_, Oct 04 2026
%E A399054 a(14)-a(15) from _Sean A. Irvine_, Oct 09 2026
