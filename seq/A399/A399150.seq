%N A399150 G.f.: (Sum_{k>=1} x^(k^3)/(1 - x^(k^3))) * Product_{k>=1} (1 + x^k).
%H A399150 Vaclav Kotesovec, <a href="/A399150/b399150.txt">Table of n, a(n) for n = 0..10000</a>
%F A399150 a(n) = Sum_{k=1..n} A061704(k)*A000009(n-k).
%F A399150 a(n) ~ exp(Pi*sqrt(n/3)) * (3^(1/4)*zeta(3)/(2*Pi*n^(1/4)) + Gamma(1/3)*zeta(1/3) / (2^(5/3) * 3^(13/12) * Pi^(1/3) * n^(7/12))).
%t A399150 nmax = 60; CoefficientList[Series[Sum[x^(k^3)/(1-x^(k^3)), {k, 1, Floor[nmax^(1/3)]+1}] * Product[1+x^k, {k, 1, nmax}], {x, 0, nmax}], x]
