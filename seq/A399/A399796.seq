%I A399796 #11 Sep 17 2026 16:44:47
%S A399796 1,1,3,5,8,11,15,19,23,29,35,41,48,55,63,69,80,89,99,109,119,131,143,
%T A399796 155,167,181,195,209,224,239,255,271,288,305,323,340,360,379,399,419,
%U A399796 440,461,483,505,528,551,575,599,623,649,675,701,728,755,783,809,840
%N A399796 Number of distinct nonzero coefficients of (1+x+x^(-1)+y+y^(-1))^n.
%C A399796 Start with an infinite square grid of zeros, except for a single 1 at the origin. At each iteration, replace every entry by the sum of itself and its four horizontal and vertical neighbors. Then a(n) is the number of distinct nonzero values on the grid after n iterations. Equivalently, the coefficient of x^i*y^j in (1+x+x^(-1)+y+y^(-1))^n is the value at the lattice point (i,j), or the number of n-step walks from the origin to (i,j), where each step may stay in place or move one unit left, right, up, or down.
%D A399796 M. Bousquet-Mélou, Counting Walks in the Quarter Plane, Mathematics and Computer Science II, Trends in Mathematics, Birkhäuser, 2002, pp. 49-67.
%H A399796 Mireille Bousquet-Mélou, <a href="https://arxiv.org/abs/1708.06192">Counting Walks in the Quarter Plane</a>, arXiv:1708.06192 [math.CO], 2017.
%F A399796 a(n) = #{c_n(i,j) : 0 <= j <= i, i+j <= n} where P_n(x,y) = (1+x+x^(-1)+y+y^(-1))^n, and c_n(i,j) = [x^i*y^j] P_n(x,y).
%e A399796 For n=0:
%e A399796   1
%e A399796 Distinct entries = {1}, so a(0) = 1.
%e A399796 For n=1:
%e A399796     1
%e A399796   1 1 1
%e A399796     1
%e A399796 Distinct entries = {1}, so a(1) = 1.
%e A399796 For n=2:
%e A399796       1
%e A399796     2 2 2
%e A399796   1 2 5 2 1
%e A399796     2 2 2
%e A399796       1
%e A399796 Distinct entries = {1,2,5}, so a(2) = 3.
%o A399796 (Python)
%o A399796 v = {(0, 0): 1}
%o A399796 for _ in range(57):
%o A399796     print(len(set(v.values())), end=", ")
%o A399796     w = {}
%o A399796     for (x, y), c in v.items():
%o A399796         for dx, dy in ((0, 0), (1, 0), (-1, 0), (0, 1), (0, -1)):
%o A399796             p = (x + dx, y + dy)
%o A399796             w[p] = w.get(p, 0) + c
%o A399796     v = w
%Y A399796 Cf. A201805 (center entry of the same coefficient array, i.e. the constant term of the same Laurent polynomial).
%K A399796 nonn,walk,new
%O A399796 0,3
%A A399796 _Eddie Lin Rui_, Sep 11 2026
