%I A399540 #8 Sep 07 2026 21:34:47
%S A399540 1527,6487,23390,32047,34207,42127,51847,56887,59911,62287,64807,
%T A399540 65311,102529,149274,226081,339543,362223,4776894,6094844,7885792,
%U A399540 8146971,10080621,36133308,73135000,85732587,139287732,141248376,148634080,152370612,152880768,185341684,219328492,240877792,251459584,251883387
%N A399540 Numbers k such that psi(k) = phi(k) + tau(k)^5.
%e A399540 1527 is a term since psi(1527) = 2040 = 1016 + 4^5 = phi(1527) + tau(1527)^5.
%o A399540 (Python)
%o A399540 from math import prod
%o A399540 from sympy import factorint
%o A399540 def ok(n):
%o A399540     f = factorint(n)
%o A399540     phi = prod((p-1)*p**(e-1) for p, e in f.items())
%o A399540     psi = prod((p+1)*p**(e-1) for p, e in f.items())
%o A399540     tau = prod(e+1 for e in f.values())
%o A399540     return psi == phi + tau**5
%o A399540 print([k for k in range(10**6) if ok(k)])
%o A399540 (PARI) isok(k) = {my(f = factor(k)); prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) - eulerphi(f) == numdiv(f)^5;} \\ _Amiram Eldar_, Sep 01 2026
