%U A399535 357605267001883132416231931904,126626508911739033549660720151298048,134558632250369006864502913403449996804096,429021353633156244000472277392722927217107533824
%N A399535 Number of labeled semitransitive binary relations on an n-element set.
%C A399535 Let R be a binary relation, with symmetric part I = R intersection R^(-1) and asymmetric part P = R \ R^(-1). The relation R is semitransitive if I o P is contained in P and P o I is contained in P, where o denotes relational composition.
%H A399535 M. Ali Khan and Metin Uyanık, <a href="https://arxiv.org/abs/1810.02004">Topological connectedness and behavioral assumptions on preferences: a two-way relationship</a>, arXiv:1810.02004 [econ.TH], 2018.
%F A399535 E.g.f.: Sum_{n>=0} a(n)*x^n/n! = F_3(log(F_2(2*x))), where F_q(x) = Sum_{n>=0} q^binomial(n,2)*x^n/n!.
%e A399535 For n = 3, exactly 320 of the 2^9 binary relations are semitransitive, so a(3) = 320.
%o A399535 (Python)
%o A399535 from math import comb
%o A399535 def semitransitive(N):
%o A399535     s = [[0]*(N+1) for _ in range(N+1)]
%o A399535     s[0][0] = 1
%o A399535     for n in range(1, N+1):
%o A399535         for k in range(1, n+1):
%o A399535             s[n][k] = s[n-1][k-1] - (n-1)*s[n-1][k]
%o A399535     t = [sum(s[n][k]*3**comb(k,2) for k in range(n+1))
%o A399535          for n in range(N+1)]
%o A399535     B = [[0]*(N+1) for _ in range(N+1)]
%o A399535     B[0][0] = 1
%o A399535     for n in range(1, N+1):
%o A399535         for k in range(1, n+1):
%o A399535             B[n][k] = sum(comb(n-1,m-1)*2**comb(m,2)*B[n-m][k-1]
%o A399535                           for m in range(1,n+1))
%o A399535     return [1] + [2**n*sum(B[n][k]*t[k] for k in range(1,n+1))
%o A399535                   for n in range(1,N+1)]
%o A399535 print(semitransitive(14))
%Y A399535 Cf. A047656, A006905.
