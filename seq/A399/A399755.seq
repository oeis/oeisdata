%I A399755 #16 Sep 15 2026 09:08:14
%S A399755 7,38,41,117,239,268,515,682,882,1393,2072,2943,4030,4443,5357,6948,
%T A399755 8119,8827,11018,12238,13545,16432,17684,19703,23382,27493,32060,
%U A399755 37107,42658,47321,48737,52525,55368,62575,70382,78813,87892,97643,108090,119257,128766
%N A399755 Numbers k such that the generalized Pell equation x^2-(k^2+1)*(y^2+1) = 0 has more than one fundamental solution in (x, y).
%C A399755 The generalized Pell equation x^2-(k^2+1)*(y^2+1) = 0 has at least one solution (k^2+1, k).
%C A399755 If k is not a term of this sequence, then A399491(k) = 4*k^3+3*k.
%C A399755 Conjecture: A399491(k) < 4*k^3+3*k if and only if k is a term of this sequence.
%H A399755 Chai Wah Wu, <a href="/A399755/b399755.txt">Table of n, a(n) for n = 1..64</a>
%e A399755 For k = 7, x^2-(k^2+1)*(y^2+1) = 0 has 3 fundamental solutions (x,y): (50, 7), (-10, 1) and (10, 1), thus 7 is a term.
%e A399755 For k = 38, x^2-(k^2+1)*(y^2+1) = 0 has 3 fundamental solutions (x,y): (1445, 38), (85, 2) and (-85, 2), thus 38 is a term.
%o A399755 (Python)
%o A399755 from itertools import count, islice
%o A399755 from sympy.solvers.diophantine.diophantine import diop_DN
%o A399755 def A399755_gen(startvalue=1): # generator of terms >= startvalue
%o A399755     return filter(lambda k: len(diop_DN(x:=k**2+1,x))>1, count(max(startvalue,1)))
%o A399755 A399755_list = list(islice(A399755_gen(),10))
%Y A399755 Cf. A399491.
%K A399755 nonn,new
%O A399755 1,1
%A A399755 _Chai Wah Wu_, Sep 10 2026
