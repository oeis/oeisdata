%e A399406    14   43   80   120   166   211   260   311
%e A399406    16   49   90   135   182   234   288   344
%t A399406 x = E; z = 40; zz = Ceiling[x*z]; w[n_, k_] := w[n, k] = k*(n + x);
%t A399406 s = Flatten[Table[w[h, k], {h, 1, zz}, {k, 1, z}]];
%t A399406 r[h_, k_] := Length[Select[s, # <= w[h, k] &]]
%t A399406 TableForm[Table[r[h, k], {h, 1, 20}, {k, 1, 12}]]   (* array  *)
%t A399406 Table[r[n - k + 1, k], {n, 12}, {k, n, 1, -1}] // Flatten  (* sequence *)
