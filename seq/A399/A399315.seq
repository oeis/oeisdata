%S A399315 1,10,3,5,2,6,9,4,7,18,8,11,13,15,12,27,24,22,19,16,14,28,25,23,20,39,
%T A399315 35,33,29,31,54,32,34,17,40,21,46,44,41,43,45,42,69,38,62,37,68,36,61,
%U A399315 59,30,53,26,47,49,52,48,50,79,51,80,78,76,74,71,73,75,72,70,105,66,63,65,67,64,97,60
%N A399315 Squares visited by a "Squirrel" (Knight + Dabbaba + Alfil) moving on a spirally numbered board always to the lowest available unvisited square.
%C A399315 Board is numbered with the square spiral, with initial square labeled 1:
%C A399315 .
%C A399315   17--16--15--14--13
%C A399315    |               |
%C A399315   18   5---4---3  12
%C A399315    |   |       |   |
%C A399315   19   6   1---2  11
%C A399315    |   |           |
%C A399315   20   7---8---9--10
%C A399315    |
%C A399315   21--22--23--24--25--
%C A399315 .
%H A399315 Jens Ahlström, <a href="/A399315/b399315.txt">Table of n, a(n) for n = 1..10000</a>
%H A399315 Stephen Emmerson and Geoff Foster, <a href="https://www.theproblemist.org/dloads/Glossary.pdf">A glossary of fairy chess definitions</a>, British Chess Problem Society, 2018.
%H A399315 Wikipedia, <a href="https://en.wikipedia.org/wiki/List_of_fairy_chess_pieces">List of fairy chess pieces</a>
%e A399315 At step 4 square 5 is visited after which square 2 is the lowest available unvisited square, so a(5) = 2.
%o A399315 (Python)
%o A399315 def to_n(x, y):
%o A399315     if x == 0 and y == 0:
%o A399315         return 1
%o A399315     m = max(abs(x), abs(y))
%o A399315     inner = (2 * m - 1) ** 2
%o A399315     if x == m and y != -m:
%o A399315         return inner + (m + y)
%o A399315     elif y == m:
%o A399315         return inner + 2 * m + (m - x)
%o A399315     elif x == -m:
%o A399315         return inner + 4 * m + (m - y)
%o A399315     elif y == -m:
%o A399315         return inner + 6 * m + (x + m)
%o A399315     return 1
%o A399315 A = [(2,2), (-2,2), (2,-2), (-2,-2)]
%o A399315 D = [(2,0), (-2,0), (0,2), (0,-2)]
%o A399315 N = [(1,2), (2,1), (-1,2), (-2,1), (1,-2), (2,-1), (-1,-2), (-2,-1)]
%o A399315 moves = N + D + A
%o A399315 visited = set([1])
%o A399315 seq = [1]
%o A399315 current_x, current_y = 0, 0
%o A399315 for _ in range(76):
%o A399315     best_n = float('inf')
%o A399315     next_x, next_y = None, None
%o A399315     for dx, dy in moves:
%o A399315         tx, ty = current_x + dx, current_y + dy
%o A399315         tn = to_n(tx, ty)
%o A399315         if tn not in visited and tn < best_n:
%o A399315             best_n, next_x, next_y = tn, tx, ty
%o A399315     if next_x is None: break
%o A399315     visited.add(best_n)
%o A399315     seq.append(best_n)
%o A399315     current_x, current_y = next_x, next_y
%o A399315 print(seq)
%Y A399315 Cf. A316667 (Knight), A316884 (Fers), A317467 (Alfil), A399158 (Dabbaba), A000027 (Wazir), A396103 (Spider), A398779 (Alfil + Knight), A398717 (Priest), A398965 (Carpenter), A399160 (Fers + Alfil), A399167 (Leopard), A398194 (Civet), A005408 (Kirin).
