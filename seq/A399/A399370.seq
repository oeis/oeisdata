%I A399370 #11 Aug 31 2026 11:18:48
%S A399370 16,32,27,36,80,48,112,64,72,81,160,176,96,189,208,108,224,135,128,
%T A399370 272,252,144,304,352,180,368,336,400,192,416,216,464,792,240,496,448,
%U A399370 544,256,297,560,504,288,592,608,351,656,1056,320,688,360,736,752,405,396,784,672,800,384,1296,848,459,880,1488,1408
%N A399370 a(n) is the maximal j for k such that p^p divides k for some prime p and there exists j < k such that A376418(j) = A376418(k).
%C A399370 A required condition that k is in A100716 implies that also j is in A100716.
%H A399370 Antti Karttunen, <a href="/A399370/b399370.txt">Table of n, a(n) for n = 1..10000</a>
%e A399370 See examples in A399369.
%o A399370 (PARI)
%o A399370 A129252(n) = { my(pp); forprime(p=2, , pp = p^p; if(!(n%pp), return(p)); if(pp > n, return(1))); };
%o A399370 A392879(n) = { my(p=A129252(n), e); if(1==p, return(n), e = valuation(n, p); (n * p^((e%p)-e) * nextprime(1+p)^(e\p))); };
%o A399370 A392878(n) = { my(u); while((u=A392879(n))!=n, n = u); (n); };
%o A399370 A376418(n) = (n - A392878(n));
%o A399370 if_k_is_A399369_return_A399370(k) = if(1==A129252(k), 0, my(x=A376418(k)); forstep(j=k-1,1,-1,if(A376418(j)==x, return(j))); 0);
%Y A399370 Cf. A100716, A376418.
%Y A399370 Cf. A399369 for the corresponding numbers k, the minimal larger elements of such pairs.
%K A399370 nonn,new
%O A399370 1,1
%A A399370 _Antti Karttunen_, Aug 27 2026
