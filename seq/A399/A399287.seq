%T A399287 79843,81401,83101,108107,121067,128467,131071,135979,151523,157513,
%U A399287 159349,168887,170843,192539,193367,200329,228923,239287,241363,264169,285673,285979,288247,293717
%N A399287 Primes p such that if p < q < r are consecutive primes, p + 2*q*r, q + 2*p*r, and r + 2*p*q are all primes.
%e A399287 3 is a term: p = 3, q = 5, r = 7.
%e A399287   3 + 2*5*7 = 73,
%e A399287   5 + 2*3*7 = 47,
%e A399287   7 + 2*3*5 = 37.
%e A399287 7 is a term: p = 7, q = 11, r = 13.
%e A399287   7 + 2*11*13 = 293,
%e A399287   11 + 2*7*13 = 193,
%e A399287   13 + 2*7*11 = 167.
%e A399287 73 is a term: p = 73, q = 79, r = 83.
%e A399287   73 + 2*79*83 = 13187,
%e A399287   79 + 2*73*83 = 12197,
%e A399287   83 + 2*73*79 = 11617.
%p A399287 R:= NULL: count:= 0:
%p A399287 q:= 2: r:= 3:
%p A399287 while count < 100 do
%p A399287   p:= q; q:= r; r:= nextprime(r);
%p A399287   if andmap(isprime,[p+2*q*r, q+2*p*r, r+2*p*q]) then R:= R,p; count:= count+1 fi
%p A399287 od:
%p A399287 R; # _Robert Israel_, Sep 23 2026
