%T A399194 109,118,127,136,145,154,163,172,181,190,199,208,217,226,235,244,253,
%U A399194 262,271,280,289,298,307,316,325,334,343,352,361,370,379,388,397
%N A399194 a(n) is the least integer h >= 0 such that a building of height h at position n sees the buildings of height A399633(k) at position k for k = 1..n-1.
%H A399194 Rémy Sigrist, <a href="/A399194/b399194.txt">Table of n, a(n) for n = 1..10000</a>
%H A399194 Rémy Sigrist, <a href="/A399194/a399194.png">Illustration for a(18) = 28</a>
%H A399194 Rémy Sigrist, <a href="/A399194/a399194.gp.txt">PARI program</a>
%F A399194 a(n) = ceiling(max(0, max_{0 < i < j < n} A399633(i) + (A399633(j)-A399633(i))/(j-i) * (n-i))).
