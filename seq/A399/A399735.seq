%S A399735 1,2,3,5,5,6,7,8,10,10,11,15,13,14,15,17,17,20,19,25,21,22,23,24,26,
%T A399735 26,27,35,29,30,31,32,33,34,35,50,37,38,39,40,41,42,43,55,50,46,47,51,
%U A399735 50,52,51,65,53,54,55,56,57,58,59,75,61,62,70,65,65,66,67,85,69,70
%N A399735 The sum of the unitary divisors d of n such that n/d is a square.
%C A399735 The number of these divisors is A056624(n).
%C A399735 The sum of the complementary divisors is A358347(n).
%H A399735 Amiram Eldar, <a href="/A399735/b399735.txt">Table of n, a(n) for n = 1..10000</a>
%F A399735 a(n) = Sum_{d | n, gcd(d, n/d) = 1, A010052(n/d) = 1} d.
%F A399735 a(n) = n * A034448(n) / A399736(n).
%F A399735 Multiplicative with a(p^e) = p^e for e odd, and a(p^e) = p^e + 1 for e even.
%F A399735 Dirichlet g.f.: zeta(s-1) * zeta(2*s) / zeta(3*s-1).
%F A399735 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = zeta(4) / zeta(5) = 1.043778824843483621761... .
%t A399735 f[p_, e_] := p^e + Boole[EvenQ[e]]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A399735 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, f[i,1]^f[i,2] + (f[i,2] % 2 == 0));}
%Y A399735 Cf. A000290, A010052, A034448, A056624, A076752 (analogous with all divisors), A077610, A358347.
%Y A399735 Cf. A013662, A013663.
%Y A399735 The sum of the unitary divisors d of n such that n/d is: A363289 (squarefree), A399732 (cubefree), A399733 (powerful), A399734 (cubefull), this sequence (square), A399736 (exponentially odd), A399737 (cube), A399738 (odd), A399739 (power of 2), A399740 (perfect power).
%K A399735 nonn,mult,easy,new
%O A399735 1,2
