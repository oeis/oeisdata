%I A399144 #17 Aug 25 2026 17:33:57
%S A399144 3,5,8,9,13,15,16,21,22,25,26,29,34,36,37,41,42,43,47,50,55,56,59,60,
%T A399144 63,67,68,70,71,76,77,81,84,89,91,92,96,97,98,102,105,109,110,111,114,
%U A399144 115,118,123,125,126,131,132,136,139,144,145,148,149,152,156,157,159,160,165,166,170,173,177,178,180
%N A399144 Complement of A395718.
%C A399144 See A395718.
%D A399144 J.-P. Allouche and J. Shallit, Automatic Sequences: Theory, Applications, Generalizations, Cambridge University Press, 2003.
%D A399144 J. Berstel, Fibonacci words—a survey, in The Book of L, Springer, 1986, pp. 13-27.
%H A399144 Jake Foth, <a href="/A399144/b399144.txt">Table of n, a(n) for n = 1..10000</a>
%H A399144 Jake Foth, <a href="https://doi.org/10.5281/zenodo.21980542">The Golden Assay Sieve: Complementary Threshold Duality for the Golden Exclusion Sieve</a>, Zenodo, 2026.
%e A399144 For v=3, m=floor(3/phi)=1 and L=1. The interval {2} contains no earlier terms, so r=0. Since 0<1, 3 is a term.
%e A399144 For v=4, m=floor(4/phi)=2 and L=1. The interval {3} contains the earlier term 3, so r=1. Since phi^2>1, 4 is not a term.
%o A399144 (Python)
%o A399144 from functools import cache
%o A399144 from math import isqrt
%o A399144 def g(n):
%o A399144     return (isqrt(5*n*n) - n)//2
%o A399144 @cache
%o A399144 def B(n):
%o A399144     if n <= 0:
%o A399144         return 0
%o A399144     m = g(n)
%o A399144     L = n - m - 1
%o A399144     return B(m) + L - g(L)
%o A399144 print(*(n for n in range(1, 201) if B(n) - B(n-1) == 1), sep=", ")
%Y A399144 Complement of A395718.
%K A399144 nonn,easy,new
%O A399144 1,1
%A A399144 _Jake Foth_, Aug 20 2026
