%t A399407 x = Sqrt[2]; u[n_, k_] := Sum[Floor[k (n + x)/h - x], {h, 1, Floor[k (n + x)/(1 + x)]}]
%t A399407 t = Table[u[n, k], {n, 1, 12}, {k, 1, 12}]; Grid[t]  (* array *)
%t A399407 Table[u[n - k + 1, k], {n, 1, 12}, {k, n, 1, -1}] // Flatten (* sequence *)
