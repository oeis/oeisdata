%I A399125 #10 Sep 03 2026 12:12:29
%S A399125 8,27,40,56,88,104,125,136,152,184,232,248,280,296,297,328,343,344,
%T A399125 351,376,424,440,459,472,488,513,520,536,568,584,616,621,632,664,680,
%U A399125 712,728,760,776,783,808,824,837,856,872,904,920,952,999,1016,1048,1064,1096
%N A399125 Numbers k = rad(k) * lpf(k)^2 such that A008479(k) = 3, where rad = A007947 and lpf(k) is the least prime factor of k.
%C A399125 Numbers k in A397458 such that A008479(k) is minimum.
%C A399125 Superset of A030078 (prime cubes).
%C A399125 Smallest k with j > 0 distinct prime factors is 4 * A002110(j).
%C A399125 Intersection of A397458 and A397962.
%C A399125 A397742 is the union of this sequence and A399127. This sequence is "block A" in the comments at A397742.
%H A399125 Michael De Vlieger, <a href="/A399125/b399125.txt">Table of n, a(n) for n = 1..10000</a>
%e A399125 Let S = {m < n : rad(m) = rad(n)}.
%e A399125 Table of n, a(n) for select n:
%e A399125      n      a(n)                          S(n)
%e A399125   ------------------------------------------------------
%e A399125      1        8 = 2^3                     {2, 4}
%e A399125      2       27 = 3^3                     {3, 9}
%e A399125      3       40 = 2^3 * 5                 {10, 20}
%e A399125      4       56 = 2^3 * 7                 {14, 28}
%e A399125      7      125 = 5^3                     {5, 25}
%e A399125     13      280 = 2^3 * 5 * 7             {70, 140}
%e A399125     15      297 = 3^3 * 11                {33, 99}
%e A399125    148     3080 = 2^3 * 5 * 7 * 11        {770, 1540}
%e A399125    172     3625 = 5^3 * 29                {145, 725}
%e A399125    873    18179 = 7^3 * 53                {371, 2597}
%e A399125   1931    40040 = 2^3 * 5 * 7 * 11 * 13   {10010, 20020}
%e A399125   8119   169037 = 11^3 * 127              {1397, 15367}
%e A399125 .
%e A399125 24 = 2^3 * 3 is not a term, since S(24) = {6, 12, 18}.
%e A399125 135 = 3^3 * 5 is not a term, since S(135) = {15, 45, 75}.
%t A399125 facs[x_] := facs[x] = FactorInteger[x][[All, 1]]; s = Select[Range[2, 1200], #1/Apply[Times, #2] == #2[[1]]^2 & @@ {#, facs[#]} &]; Select[s, Function[{m, r}, Count[Range[m], _?(Times @@ facs[#] == r &)] == 3] @@ {#, Times @@ facs[#]} &]
%Y A399125 Cf. A007947, A008479, A020736, A030078, A397458, A397742, A397962.
%K A399125 nonn,new
%O A399125 1,1
%A A399125 _Michael De Vlieger_, Aug 21 2026
