%T A399240 39,45,47,48,48,0,1,46,89,106,112,114,115,115,0,1,98,211,260,277,283,
%U A399240 285,286,286,0,1,207,507,643,693,710,716,718,719,719
%N A399240 Triangle read by rows. T(n, k) is the number of rooted trees on n nodes where every node has at most k children.
%C A399240 This is the lower triangle of A299038.
%H A399240 Marko Riedel, <a href="https://math.stackexchange.com/questions/2434908/">Trees with bounded degree</a>.
%e A399240 Triangle starts:
%e A399240   [0] 1;
%e A399240   [1] 1, 1;
%e A399240   [2] 0, 1,  1;
%e A399240   [3] 0, 1,  2,   2;
%e A399240   [4] 0, 1,  3,   4,   4;
%e A399240   [5] 0, 1,  6,   8,   9,   9;
%e A399240   [6] 0, 1, 11,  17,  19,  20,  20;
%e A399240   [7] 0, 1, 23,  39,  45,  47,  48,  48;
%e A399240   [8] 0, 1, 46,  89, 106, 112, 114, 115, 115;
%e A399240   [9] 0, 1, 98, 211, 260, 277, 283, 285, 286, 286;
%o A399240 (Python)  # after _Alois P. Heinz_ in A299038.
%o A399240 from math import comb
%o A399240 from functools import cache
%o A399240 def A399240_triangle(N: int) -> list[list[int]]:
%o A399240     @cache
%o A399240     def b(n: int, i: int, t: int, k: int) -> int:
%o A399240         if n == 0: return 1
%o A399240         if i < 1:  return 0
%o A399240         ans = 0
%o A399240         base_val = b(i - 1, i - 1, k, k)
%o A399240         for j in range(min(t, n // i) + 1):
%o A399240             binom = 1 if j == 0 else comb(base_val + j - 1, j)
%o A399240             ans += binom * b(n - i * j, i - 1, t - j, k)
%o A399240         return ans
%o A399240     def T(n: int, k: int) -> int:
%o A399240         if n == 0: return 1
%o A399240         return b(n - 1, n - 1, k, k)
%o A399240     return [ [T(n, k) for k in range(n + 1)] for n in range(N) ]
%o A399240 for row in A399240_triangle(10): print(row)
%Y A399240 Cf. A000081 (main diagonal), A299038 (lower triangle), A292553, A299039 (central terms).
