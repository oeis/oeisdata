%I A399677 #13 Oct 21 2026 21:08:52
%S A399677 1,3,3,5,6,9,10,13,15,19,21,21,28,33,36,41,45,51,55,61,66,73,78,75,91,
%T A399677 99,105,113,120,111,136,145,153,163,171,165,190,201,210,221,231,237,
%U A399677 253,265,276,289,300,291,325,339,351,365,378,393,406,421,435,451
%N A399677 Number of distinct Laplacian eigenvalues of the torus grid graph C_n X C_n.
%C A399677 For n >= 3 the Laplacian eigenvalues of C_n X C_n are 4 - 2*cos(2*Pi*i/n) - 2*cos(2*Pi*j/n), 0 <= i,j <= n-1, so a(n) is the number of distinct values of cos(2*Pi*i/n) + cos(2*Pi*j/n) with 0 <= i <= j <= n-1.
%C A399677 For n = 1 and 2, C_1 is a single vertex and C_2 is a single edge (so C_2 X C_2 = C_4), and the same count of cosine sums still gives a(n).
%C A399677 This is also the number of distinct adjacency eigenvalues of C_n X C_n, since the graph is 4-regular for n >= 3.
%D A399677 J. H. Conway and A. J. Jones, Trigonometric diophantine equations (On vanishing sums of roots of unity), Acta Arithmetica 30 (1976), 229-240.
%e A399677 For n=4 the values cos(Pi*i/2) are 1, 0, -1, 0, and the sums of two of them are 2, 1, 0, -1, -2, so a(4) = 5.
%o A399677 (Python)
%o A399677 from sympy import cyclotomic_poly, Poly, symbols
%o A399677 def a(n):
%o A399677     x = symbols('x'); P = Poly(cyclotomic_poly(n, x), x)
%o A399677     def v(k): return Poly(x**(k % n), x).rem(P)
%o A399677     return len({(v(i) + v(-i) + v(j) + v(-j)).as_expr() for i in range(n) for j in range(i, n)})
%Y A399677 Cf. A395911.
%K A399677 nonn,new
%O A399677 1,2
%A A399677 _Scott M. Foltz_, Oct 13 2026
