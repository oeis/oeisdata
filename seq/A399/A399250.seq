%I A399250 #41 Oct 22 2026 00:11:37
%S A399250 0,0,1,0,-1,0,1,0,-1,-2,0,2,4,2,0,-2,-4,-2,0,2,4,2,0,-2,-4,-6,-3,0,3,
%T A399250 6,9,6,3,0,-3,-6,-9,-6,-3,0,3,6,9,6,3,0,-3,-6,-9,-12,-8,-4,0,4,8,12,
%U A399250 16,12,8,4,0,-4,-8,-12,-16,-12,-8,-4,0,4,8,12,16,12,8,4,0,-4,-8,-12,-16,-20,-15
%N A399250 Product of the x- and y-coordinates of a point moving in a square spiral.
%C A399250 Spiral begins:
%C A399250   17--16--15--14--13
%C A399250    |               |
%C A399250   18   5---4---3  12
%C A399250    |   |       |   |
%C A399250   19   6   1---2  11
%C A399250    |   |           |
%C A399250   20   7---8---9--10
%C A399250    |
%C A399250   21--22--23--24--25--...
%H A399250 Jens Ahlström, <a href="/A399250/b399250.txt">Table of n, a(n) for n = 1..10000</a>
%F A399250 a(n) = A174344(n) * A274923(n).
%e A399250 a(2) = 0, since the 2nd point is (1, 0) and x times y is 0.
%e A399250 a(18) = -2, since the 18th point is (-2, 1) and that product is -2.
%o A399250 (Python)
%o A399250 import math
%o A399250 def y(n):
%o A399250     n -= 1
%o A399250     m = math.isqrt(n)
%o A399250     k = math.ceil(m/2)
%o A399250     n -= 4*k*k
%o A399250     if n < 0: return 3*k+n if n < -m else k
%o A399250     return k-n if n < m else -k
%o A399250 def x(n):
%o A399250     n -= 1
%o A399250     m = math.isqrt(n)
%o A399250     k = math.ceil(m/2)
%o A399250     n -= 4*k*k
%o A399250     if n < 0: return k if n < -m else -k-n
%o A399250     return -k if n < m else n-3*k
%o A399250 def a(n):
%o A399250     return x(n)*y(n)
%Y A399250 Cf. A174344, A180714, A214526, A274923, A391618, A336336.
%K A399250 sign,easy,new
%O A399250 1,10
%A A399250 _Jens Ahlström_, Oct 13 2026
