%N A399250 Rectangular array read by descending antidiagonals: r(n, k) = floor(k*x^n), where x = 1+sqrt(5).
%C A399250 Every row is a Beatty sequence. See A399245 for a guide of related arrays.
%H A399250 <a href="/index/Be#Beatty">Index entries for sequences related to Beatty sequences</a>.
%e A399250 Corner:
%e A399250       3      6      9     12     16     19
%e A399250      10     20     31     41     52     62
%e A399250      33     67    101    135    169    203
%e A399250     109    219    328    438    548    657
%e A399250     354    709   1064   1419   1774   2129
%e A399250    1148   2296   3445   4593   5742   6890
%t A399250 x = 1 + Sqrt[5]; n1 = 15; k1 = 12;
%t A399250 r[n_, k_] := Floor[k*x^n]; t = Table[r[n, k], {n, 1, n1}, {k, 1, k1}];
%t A399250 TableForm[t]
%t A399250 Table[r[n - k + 1, k], {n, 12}, {k, n, 1, -1}] // Flatten
