%o A399450 (PARI) \\ after _Zoltan Reti_ in column sequences A007789, A007790, etc.
%o A399450 T(n,k) = {my(h=vector(n)); forvec(x=vector(k, i, [0, n-1]), h[matdet(matrix(k, k, i, j, x[(j-i)%k+1]))%n+1]++); sumdiv(n, e, moebius(n/e)*h[e%n+1])/n}
%Y A399450 Columns 1..6 are A000007(n-1), A098178, A007789, A007790, A007791, A007792.
%Y A399450 Row 1 is A000012.
