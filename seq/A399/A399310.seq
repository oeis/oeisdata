%I A399310 #14 Sep 01 2026 19:59:09
%S A399310 1,1,3,3,6,6,10,10,15,15,21,21,27,27,36,36,45,45,55,55,66,65,77,78,91,
%T A399310 91,105,105,120,120,135,135,153,153,171,171,190,190,210,209,230,231,
%U A399310 253,253,275,276,300,300,324,324,351,351,378,378,406,405,435,434,464
%N A399310 Number of distinct entries in a slice of Pascal's square pyramid (A086754).
%H A399310 Eddie Lin Rui, <a href="/A399310/b399310.txt">Table of n, a(n) for n = 0..1999</a>
%H A399310 The Lost Math Lessons, <a href="https://lostmathlessons.blogspot.com/2015/03/pascals-pyramids.html">Pascal's Pyramids</a>, Mar 06 2015.
%F A399310 a(n) = #{binomial(n,i)*binomial(n,j) : 0 <= i <= j <= floor(n/2)}.
%e A399310 For n = 0, Pascal's square pyramid slice:
%e A399310   1
%e A399310 Distinct entries = {1}, so a(0) = 1.
%e A399310 For n = 1, Pascal's square pyramid slice:
%e A399310   1 1
%e A399310   1 1
%e A399310 Distinct entries = {1}, so a(1) = 1.
%e A399310 For n = 2, Pascal's square pyramid slice:
%e A399310   1 2 1
%e A399310   2 4 2
%e A399310   1 2 1
%e A399310 Distinct entries = {1,2,4}, so a(2) = 3.
%e A399310 For n = 3, Pascal's square pyramid slice:
%e A399310   1 3 3 1
%e A399310   3 9 9 3
%e A399310   3 9 9 3
%e A399310   1 3 3 1
%e A399310 Distinct entries = {1,3,9}, so a(3) = 3.
%o A399310 (Python)
%o A399310 from math import comb
%o A399310 def a(n):
%o A399310     b = [comb(n, k) for k in range(n//2 + 1)]
%o A399310     products = {x*y for i, x in enumerate(b) for y in b[i:]}
%o A399310     return len(products)
%o A399310 print([a(n) for n in range(59)])
%Y A399310 Cf. A086754, A008805, A046816, A086753.
%K A399310 nonn,easy,new
%O A399310 0,3
