%S A399004 1,2,12,86,742,7692,90904,1202924,17640732,282830264,4917996304,
%T A399004 92078270088,1845292766728,39383534583824,891368973367968,
%U A399004 21313866675925328,536682301319623696,14189450625527993376,392910255383561530048,11368383450553184046176,342989077247255941820256
%N A399004 Number of transitive relations R on an n-set such that each element is involved in at most 2 ordered pairs of R, where a loop (x,x) counts once.
%C A399004 Involvement of v means |{(x,y) in R : x=v or y=v}|; in particular, a loop contributes one.
%F A399004 E.g.f.: exp(4*x/(1-x) - 2*x - x^2/2 + x^3)/sqrt(1 - x^2). - _Andrew Howroyd_, Sep 03 2026, after Python program.
%e A399004 a(1)=2 because the only such relations on a singleton are the null relation and the universal relation.
%o A399004 (Python)
%o A399004 import math
%o A399004 def c(k):
%o A399004     """Calculates the number of connected admissible relations on k vertices."""
%o A399004     if k == 1: return 2
%o A399004     if k == 2: return 8
%o A399004     if k == 3: return 30
%o A399004     # For k >= 4
%o A399004     ans = 4 * math.factorial(k)
%o A399004     if k % 2 == 0:  # If k is even, add (k-1)! for the alternating cycle
%o A399004         ans += math.factorial(k - 1)
%o A399004     return ans
%o A399004 def lista(n):
%o A399004     """Calculates a(0)-a(n) using the exponential formula recurrence."""
%o A399004     a = [0] * (n + 1)
%o A399004     a[0] = 1
%o A399004     for i in range(1, n + 1):
%o A399004         total = 0
%o A399004         for k in range(1, i + 1):
%o A399004             total += math.comb(i - 1, k - 1) * c(k) * a[i - k]
%o A399004         a[i] = total
%o A399004     return a
%o A399004 print(lista(20))
%Y A399004 Cf. A006905.
%K A399004 nonn,easy,new
%O A399004 0,2
%A A399004 _Firdous Ahmad Mala_, Aug 16 2026
