%N A399235 G.f. A(x) satisfies: A(x) = 1 + x * A(x/(1 - 2*x)^2) / (1 - x)^2.
%F A399235 a(0) = 1; a(n) = Sum_{k=0..n-1} Sum_{j=0..n-k-1} binomial(2*k+j-1,j) * (n-k-j) * 2^j * a(k) for n >= 1.
%t A399235 nmax = 21; A[_] = 0; Do[A[x_] = 1 + x A[x/(1 - 2 x)^2]/(1 - x)^2 + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A399235 (* Alternative: *)
%t A399235 a[0] = 1; a[n_] := a[n] = Sum[Sum[Binomial[2 k + j - 1, j] (n - k - j) 2^j a[k], {j, 0, n - k - 1}], {k, 0, n - 1}]; Table[a[n], {n, 0, 21}]
%Y A399235 Cf. A007405, A040027, A125273, A125274.
%K A399235 nonn,new
