%S A399764 1,5,14,26,44,64,93,122,157,188,235,273,338,381,441,493,573,638,731,
%T A399764 803,891,964,1061,1144,1281,1382,1472,1589,1717,1839,1977,2093,2228,
%U A399764 2365,2474,2642,2816,2953,3126,3269,3448,3606,3809,3981,4124,4329,4555,4701,4971,5133,5391,5603,5774,6004,6308,6503,6746,6962
%N A399764 The main diagonal of the infinite Tchoukaillon array.
%C A399764 A344009 is the complete Tchoukaillon array listed by antidiagonals.
%C A399764 a(n) is asymptotically c*n^2 + O(n^(4/3)), where c=(Pi+2)^2/(4*Pi) \approx 2.1037 ... conjectured by Nikolai Beluhov in 2022, proved by Shisheng Li in 2026.
%H A399764 Hugo Pfoertner, <a href="/A399764/b399764.txt">Table of n, a(n) for n = 0..700</a> (terms 0..63 from Don Knuth)
%H A399764 Don E. Knuth, <a href="http://cs.stanford.edu/~knuth/fasc14a.ps.gz">Bipartite Matching</a>, The Art of Computer Programming, Vol. 4, Pre-fascicle 14A, June 8, 2021. See Sect. 7.5.1, Exercise 13.
%H A399764 Don E. Knuth, <a href="https://www.youtube.com/watch?v=237DQNzDUM8">Tchoukaillon numbers</a>, (Rutgers Univ.) Experimental Math. Seminar, YouTube video, 2022.
%H A399764 Shisheng Li, <a href="https://arxiv.org/abs/2608.17517">Asymptotics of the Tchoukaillon array and a conjecture of Beluhov</a>, arXiv:2608.17517 [math.CO], 2026.
%o A399764 (PARI) \\ Uses Shisheng Li's recurrence, see Exercise 14 from Knuth's Pre-fascicle.
%o A399764 Che(m) = {my(x=m-1, y=m, xp=0, yp=0, n=1); while((x-xp)^2+(y-yp)^2>0, xp=x; yp=y; n++; x-=yp\n; y-=xp\n); [x,y]};
%o A399764 a399764(nterms) = my(w=vector(nterms+1), wmax); for(m=1, oo, my(R=Che(m)); if(R[1]==(R[2]-R[1]-1), wmax=R[1]; if(wmax<=nterms, w[wmax+1]=m, break))); w; \\ _Hugo Pfoertner_, Sep 11 2026
%Y A399764 Main diagonal of A344009.
%K A399764 nonn,new
%O A399764 0,2
%A A399764 _Don Knuth_, Sep 10 2026
