%I A399277 #34 Oct 27 2026 20:46:51
%S A399277 1,1,2,5,16,59,234,979,4258,18119,75050,301666,1206768,4737671,
%T A399277 18543188
%N A399277 Number of distinct multisets of (p(j+1) - p(j)) mod n for permutations p in S_n.
%H A399277 Brendan D. McKay and Tim Peters, <a href="https://arxiv.org/abs/2205.06004">Paths through equally spaced points on a circle</a>, arXiv:2205.06004 [math.CO], 2022.
%H A399277 Madjid Mirzavaziri and Daniel Yaqubi, <a href="https://arxiv.org/abs/2609.25100">Latin Eulerian Numbers</a>, arXiv:2609.25100 [math.CO], 2026.
%H A399277 Madjid Mirzavaziri and Daniel Yaqubi, <a href="https://arxiv.org/abs/2609.28808">Cyclic Latin Eulerian Numbers</a>, arXiv:2609.28808 [math.CO], 2026.
%F A399277 a(n) = |{ (M_pi(1), ..., M_pi(n-1)) : pi in S_n }|, where M_pi(i) = #{j : (pi(j+1) - pi(j)) mod n = i}.
%e A399277 For n = 4 the five realizable directed profiles are (0,0,3), (0,2,1), (1,1,1), (1,2,0), (3,0,0), giving a(4) = 5.
%e A399277 For n = 5 the 16 realizable directed profiles are (0,0,0,4), (0,0,2,2), (0,0,4,0), (0,1,1,2), (0,2,0,2), (0,2,1,1), (0,4,0,0), (1,0,1,2), (1,0,2,1), (1,1,2,0), (1,2,0,1), (2,0,2,0), (2,1,0,1), (2,1,1,0), (2,2,0,0), (4,0,0,0), giving a(5) = 16.
%t A399277 r[n_] := Length@DeleteDuplicates[Map[Table[Count[Mod[Differences[Prepend[#, 0]], n], d], {d, 1, n - 1}] &, Permutations[Range[n - 1]]]];
%t A399277 Table[r[n], {n, 1, 10}]
%Y A399277 Cf. A352568, A141598, A141599.
%K A399277 nonn,hard,more,new
%O A399277 1,3
