%S A399198 2,0,4,200,100,4225,1300,125000,4420,33800,16900,2640625,22100,
%T A399198 17850625,812500,845000,110500,1650390625,287300,30517578125000,
%U A399198 552500,21125000,10562500,30525625,640900,142805000,71402500,9768200,4884100,644683837890625,7182500,7450580596923828125000
%N A399198 a(n) is the smallest nonnegative integer k where there are exactly n nonnegative integer solutions to x^2 + 4*y^2 = k.
%C A399198 a(n) is the smallest nonnegative k such that A399197(k) = n.
%H A399198 Seiichi Manyama, <a href="/A399198/b399198.txt">Table of n, a(n) for n = 0..100</a>
%o A399198 (PARI) b(n, k) = sum(i=0, sqrtint(n), sum(j=0, sqrtint(n\k), i^2+k*j^2==n));
%o A399198 a(n, k=4) = my(cnt=0); while(b(cnt, k)!=n, cnt++); cnt;
%Y A399198 Cf. A399202, A374285, A374286, A374288.
%Y A399198 Cf. A399191, A399197.
%K A399198 nonn,new
%O A399198 0,1
%A A399198 _Seiichi Manyama_, Aug 22 2026
