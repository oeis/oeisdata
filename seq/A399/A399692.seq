%t A399692 t[n_, k_] := Floor[(n + 2^(k - 1))/2^k]; Table[t[n, k], {n, 1, 20}, {k, 1, Floor[Log2[n]] + 2}] // Flatten
%o A399692 (Octave)
%o A399692 function delta = formingSequence(n)
%o A399692   delta = zeros(1,floor(log2(n)) + 2);
%o A399692   [d, k] = {n, 0}{:};
%o A399692   do
%o A399692     [delta(++k),d] = {ceil(d/2),floor(d/2)}{:};
%o A399692   until d == 0;
%o A399692 endfunction
%o A399692 a = []; for k = 1:10, a = [a formingSequence(k)]; endfor, a
