%S A399539 2071,3007,4087,14780,17468,18428,19388,39288,114160,193340,263252,
%T A399539 628608,755325,976284,2823876,3133344,3182328,3392260,3549105,3556196,
%U A399539 4488544,5065092,5277051,7176924,8791600,9928704,10794375,12330540,20254976,21778944,35991872,38026716,38637144,39080960,40434636
%N A399539 Numbers k such that psi(k) = phi(k) + tau(k)^4.
%e A399539 2071 is a term since psi(2071) = 2200 = 1944 + 4^4 = phi(2071) + tau(2071)^4.
%o A399539 (Python)
%o A399539 from math import prod
%o A399539 from sympy import factorint
%o A399539 def ok(n):
%o A399539     f = factorint(n)
%o A399539     phi = prod((p-1)*p**(e-1) for p, e in f.items())
%o A399539     psi = prod((p+1)*p**(e-1) for p, e in f.items())
%o A399539     tau = prod(e+1 for e in f.values())
%o A399539     return psi == phi + tau**4
%o A399539 print([k for k in range(10**6) if ok(k)])
%o A399539 (PARI) isok(k) = {my(f = factor(k)); prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) - eulerphi(f) == numdiv(f)^4;} \\ _Amiram Eldar_, Sep 01 2026
