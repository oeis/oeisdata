%S A399158 1,11,13,15,17,19,21,23,25,51,53,55,57,59,61,63,65,67,69,71,73,75,77,
%T A399158 79,81,123,125,127,129,131,133,135,137,139,141,143,145,147,149,151,
%U A399158 153,155,157,159,161,163,165,167,169,227,229,231,233,235,237,239,241,243,245,247,249,251,253,255,257,259,261,263,265,267,269,271,273,275,277,279,281,283,285,287,289,363,365
%N A399158 Squares visited by a Dabbaba moving on a spirally numbered board always to the lowest available unvisited square.
%C A399158 Dabbaba is a leaper [0,2].
%C A399158 Board is numbered with the square spiral, with initial square labeled 1:
%C A399158 .
%C A399158   17--16--15--14--13
%C A399158    |               |
%C A399158   18   5---4---3  12
%C A399158    |   |       |   |
%C A399158   19   6   1---2  11
%C A399158    |   |           |
%C A399158   20   7---8---9--10
%C A399158    |
%C A399158   21--22--23--24--25--
%C A399158 .
%C A399158 The first 82 terms are identical to A337254. But A337254(83) = 288, while a(83) = 365.
%H A399158 Jens Ahlström, <a href="/A399158/b399158.txt">Table of n, a(n) for n = 1..10000</a>
%H A399158 Stephen Emmerson and Geoff Foster, <a href="https://www.theproblemist.org/dloads/Glossary.pdf">A glossary of fairy chess definitions</a>, British Chess Problem Society, 2018.
%e A399158 At step 2 square 11 is visited after which square 13 is the lowest available unvisited square, so a(3) = 13.
%o A399158 (Python)
%o A399158 def to_n(x, y):
%o A399158     if x == 0 and y == 0:
%o A399158         return 1
%o A399158     m = max(abs(x), abs(y))
%o A399158     inner = (2 * m - 1) ** 2
%o A399158     if x == m and y != -m:
%o A399158         return inner + (m + y)
%o A399158     elif y == m:
%o A399158         return inner + 2 * m + (m - x)
%o A399158     elif x == -m:
%o A399158         return inner + 4 * m + (m - y)
%o A399158     elif y == -m:
%o A399158         return inner + 6 * m + (x + m)
%o A399158     return 1
%o A399158 moves = [(2, 0), (-2, 0), (0, -2), (0, 2)]
%o A399158 visited = set([1])
%o A399158 seq = [1]
%o A399158 current_x, current_y = 0, 0
%o A399158 for _ in range(82):
%o A399158     best_n = float('inf')
%o A399158     next_x, next_y = None, None
%o A399158     for dx, dy in moves:
%o A399158         tx, ty = current_x + dx, current_y + dy
%o A399158         tn = to_n(tx, ty)
%o A399158         if tn not in visited and tn < best_n:
%o A399158             best_n, next_x, next_y = tn, tx, ty
%o A399158     if next_x is None: break
%o A399158     visited.add(best_n)
%o A399158     seq.append(best_n)
%o A399158     current_x, current_y = next_x, next_y
%o A399158 print(seq)
%Y A399158 Cf. A337254 (Differs first at index 83), A316667 (Knight), A316884 (Fers), A317467 (Alfil).
%K A399158 nonn,new
%O A399158 1,2
