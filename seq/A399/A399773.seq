%I A399773 #45 Oct 13 2026 19:26:57
%S A399773 1,1,1,3,1,3,3,3,3,5,3,5,3,5,5,5,5,5,5,7,7,9,7,9,7,9,7,11,7,11,9,11,
%T A399773 11,11,11,11,11,11,13,11,13,11,13,13,13,15,15,17,15,17,15,17,15,19,15,
%U A399773 19,15,19,15,19,15,21,17,21,19,21,21,23,21,23,23,23
%N A399773 a(1) = a(2) = 1; for n > 2, a(n) = a(a(n-1)) + a(n-a(n-1)) + (-1)^n.
%C A399773 The recurrence of A004001 perturbed by (-1)^n, as A394051 is for A005185.
%C A399773 All terms are odd and a(n+2) - a(n) is 0 or 2 (see link "Note on the perturbed Conway sequence").
%H A399773 Benoit Cloitre, <a href="/A399773/b399773.txt">Table of n, a(n) for n = 1..10000</a>
%H A399773 Benoit Cloitre, <a href="/A399773/a399773.pdf">Note on the perturbed Conway sequence</a>, 2026.
%H A399773 Benoit Cloitre, <a href="/A399773/a399773.png">Scatterplot of a(n)/n for 469632 <= n <= 1008716</a> (logarithmic scale for n).
%F A399773 Conjecture: lim_{n->oo} a(n)/n = 1/psi^3 = 0.3176721962..., where psi = A092526.
%t A399773 A399773[n_] := A399773[n] = If[n <= 2, 1, A399773[A399773[n - 1]] + A399773[n - A399773[n - 1]] + (-1)^n];
%t A399773 Array[A399773, 100] (* _Paolo Xausa_, Oct 13 2026 *)
%t A399773 (* Alternative, with no recursion: *)
%t A399773 Module[{a = ConstantArray[1, #]}, Do[a[[n]] = a[[a[[n - 1]]]] + a[[n - a[[n - 1]]]] + (-1)^n, {n, 3, #}]; a] & [100] (* _Paolo Xausa_, Oct 13 2026 *)
%o A399773 (PARI) lista(nn) = my(a=vector(nn, n, 1)); for(n=3, nn, a[n] = a[a[n-1]] + a[n-a[n-1]] + (-1)^n); a;
%Y A399773 Cf. A004001, A005185, A005229, A092526, A394051.
%K A399773 nonn,new
%O A399773 1,4
%A A399773 _Benoit Cloitre_, Oct 13 2026
