%t A399259 n1 = 12; k1 = 40;
%t A399259 x = N[Pi, 200]; t = 1 - 1/x;
%t A399259 r[n_, k_] := Floor[k*x^n];
%t A399259 c[n_, k_] := If[FractionalPart[r[n, k]/x] > t, 1, 0];
%t A399259 Grid[Table[c[n, k], {n, 1, n1}, {k, 1, k1}]]    (* array *)
%t A399259 Table[c[n - k + 1, k], {n, 12}, {k, n, 1, -1}] // Flatten  (* sequence *)
