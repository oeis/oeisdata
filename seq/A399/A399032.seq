%T A399032 32,7752,20196,22155,13125,4440,816,64,43263,128877,165648,119175,
%U A399032 51870,13664,2016,128,246675,826804,1217748,1029588,546574,186480,39872,4864,256
%N A399032 Triangle read by rows: T(n,m) = (binomial(n-1,m)/(n - 1))*Sum_{k=0..m} binomial(3*(n-m-1),n-m-k-2)*binomial(m,k)*2^(m-k), with 0 <= k <= n - 2.
%C A399032 T(n,m) is the number of marked noncrossing trees on n >= 2 vertices with m >= 0 marked edges (see Nyariaro et al. on pages 74-75).
%H A399032 Albert Oloo Nyariaro, Isaac Owino Okoth, and Fredrick Oluoch Nyamwala, <a href="https://doi.org/10.61091/jcmcc131-05">Marked noncrossing trees</a>, Journal of Combinatorial Mathematics and Combinatorial Computing, Volume 131. 67-86 (2026).
%e A399032 The triangle begins as:
%e A399032      1;
%e A399032      3,    2;
%e A399032     12,   13,    4;
%e A399032     55,   81,   42,    8;
%e A399032    273,  506,  362,  120,  16;
%e A399032   1428, 3185, 2890, 1340, 320, 32;
%e A399032 ...
%t A399032 T[n_,m_]:=Binomial[n-1,m]*Sum[Binomial[3(n-m-1),n-m-k-2]Binomial[m,k]2^(m-k),{k,0,m}]/(n-1); Table[T[n,k],{n,2,10},{k,0,n-2}]//Flatten
%o A399032 (PARI) T(n,m) = (binomial(n-1,m)/(n - 1))*sum(k=0, m, binomial(3*(n-m-1),n-m-k-2)*binomial(m,k)*2^(m-k))
%o A399032 for(n=2, 10, for(k=0, n-2, print1(T(n,k), ", ")); print) \\ _Andrew Howroyd_, Aug 17 2026
%Y A399032 1st column gives A001764.
%Y A399032 Oblique side gives A000079.
%Y A399032 Row sums give A399033.
%K A399032 nonn,tabl,new
%O A399032 2,2
