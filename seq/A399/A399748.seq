%S A399748 1,1,2,3,4,2,6,6,7,4,10,6,12,6,8,12,16,7,18,12,12,10,22,12,21,12,21,
%T A399748 18,28,8,30,24,20,16,24,21,36,18,24,24,40,12,42,30,28,22,46,24,43,21,
%U A399748 32,36,52,21,40,36,36,28,58,24,60,30,42,48,48,20,66,48,44,24,70,41
%N A399748 The number of integers k from 1 to n such that gcd(n,k) is a perfect power (A001597).
%C A399748 First differs from A384039 at n = 72.
%H A399748 Amiram Eldar, <a href="/A399748/b399748.txt">Table of n, a(n) for n = 1..10000</a>
%F A399748 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = (1 - Sum_{k>=2} mu(k)*(zeta(2*k)-1))/zeta(2) = 0.6690087763... (A393652), and mu is the Moebius function (A008683).
%t A399748 ppowQ[n_] := n == 1 || GCD @@ FactorInteger[n][[;; , 2]] > 1; a[n_] := Count[Range[n], _?(ppowQ[GCD[n, #]] &)]; Array[a, 100]
%o A399748 (PARI) isPower(n) = n == 1 || ispower(n);
%o A399748 a(n) = sum(k = 1, n, isPower(gcd(n,k)));
%Y A399748 Cf. A001597, A008683, A013661, A059956, A393652.
%Y A399748 The number of integers k from 1 to n such that gcd(n,k) is: A026741 (odd), A062570 (power of 2), A063659 (squarefree), A078429 (cube), A116512 (power of a prime), A117494 (prime), A126246 (1 or 2), A206369 (square), A254926 (cubefree), A372671 (3-smooth), A384039 (powerful), A384040 (cubefull), A384041 (exponentially odd), A384042 (5-rough), this sequence (perfect power).
%K A399748 nonn,new
%O A399748 1,3
