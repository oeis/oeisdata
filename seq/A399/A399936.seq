%N A399936 G.f.: 1 = Sum_{n>=0} a(n) * x^n / (1 + x)^(4^n).
%F A399936 a(n) = (-1)^n * binomial(4^n+n-1,n) - Sum_{k=0..n-1} (-1)^(n-k) * binomial(4^n+4^k+n-k-1,n-k) * a(k).
%t A399936 a[n_] := a[n] = (-1)^n Binomial[4^n + n - 1, n] - Sum[(-1)^(n - k) Binomial[4^n + 4^k + n - k - 1, n - k] a[k], {k, 0, n - 1}]; Table[a[n], {n, 0, 14}]
