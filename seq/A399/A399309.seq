%S A399309 0,1,1,0,1,1,2,1,3,4,7,11,18,7,25,32,57,89,32,121,153,32,-121,-153,
%T A399309 -274,-427,-153,274,121,395,516,121,637,758,1395,2153,3548,5701,2153,
%U A399309 7854,10007,17861,27868,45729,73597,119326,45729,-73597,-27868,45729,17861
%N A399309 Deterministic version of the random Fibonacci sequence, with signs from A191232 and the seed as (0,1).
%C A399309 Viswanath's random Fibonacci sequence flips a fair coin for each sign. Reading the signs off one fixed word instead gives a single integer sequence, and A191232 is normal in base 2, so every finite sign pattern still occurs with the frequency a coin would give it. Digit A191232(n-1) drives step n, with "1" adding and "0" subtracting.
%H A399309 Jwalin Bhatt, <a href="/A399309/b399309.txt">Table of n, a(n) for n = 0..10000</a>
%H A399309 A. H. Copeland and P. Erdős, <a href="https://www.renyi.hu/~p_erdos/1946-01.pdf">Note on normal numbers</a>, Bull. Amer. Math. Soc. 52 (1946), pp. 857-860.
%H A399309 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/RandomFibonacciSequence.html">Random Fibonacci Sequence</a>.
%H A399309 Wikipedia, <a href="https://en.wikipedia.org/wiki/Random_Fibonacci_sequence">Random Fibonacci sequence</a>.
%F A399309 For n>=2: a(n) = a(n-1) + a(n-2) if A191232(n-1) = 1, otherwise a(n-1) - a(n-2).
%F A399309 Conjecture: lim_{n->oo} |a(n)|^(1/n) = 1.1319882487943... (A078416), Viswanath's constant.
%e A399309 A191232 begins 1, 0, 1, 1, 1, 0, 1, 1, 1, 1, ..., so the signs applied at steps n = 2, 3, 4, ... are +, -, +, +, +, -, +, +, +, +, ...
%e A399309 a(2) = a(1) + a(0) = 1 + 0 = 1, since A191232(1) = 1.
%e A399309 a(3) = a(2) - a(1) = 1 - 1 = 0, since A191232(2) = 0.
%e A399309 a(4) = a(3) + a(2) = 0 + 1 = 1, since A191232(3) = 1.
%e A399309 a(5) = a(4) + a(3) = 1 + 0 = 1, since A191232(4) = 1.
%t A399309 Module[{c = Flatten[IntegerDigits[#, 2] & /@ Prime[Range[25]]], a}, a[n_] := a[n] = If[n <= 1, n, a[n-1] + (2*c[[n-1]] - 1)*a[n-2]]; Array[a, 51, 0]]
%o A399309 (Python)
%o A399309 from itertools import islice
%o A399309 from sympy import nextprime
%o A399309 def digits(p=2):
%o A399309     while True: yield from (int(b) for b in bin(p)[2:]); p = nextprime(p)
%o A399309 def A399309(n_terms):
%o A399309     a, d = [0, 1], list(islice(digits(), n_terms))
%o A399309     for n in range(2, n_terms):
%o A399309         a.append(a[n-1] + a[n-2] if d[n-2] else a[n-1] - a[n-2])
%o A399309     return a
%o A399309 print(A399309(51))
%Y A399309 Cf. A000045, A078416, A191232, A399952, A399861, A400405.
%K A399309 sign,new
