%U A399228 596585116387842785280000,-388888175269904269639680000,294725403591350626760785920000,-256963707088053961691824128000000
%N A399228 a(n) = Sum_{k=0..n} (-1)^k*(n - k)!*(n + k)!.
%D A399228 Răzvan Gelca and Titu Andreescu, Putnam and Beyond, Springer 2007, pp. 123, 500-501.
%F A399228 a(n) = ((n!)^2 + (-1)^n*(2*n + 1)!/(n + 1))/2 (see Gelca and Andreescu).
%F A399228 a(n) = (A001044(n) + (-1)^n*A110468(n))/2.
%F A399228 a(n) ~ (-1)^n*2^(2*n+1)*exp(-2*n)*n^(2*n+1/2)*sqrt(Pi).
%t A399228 a[n_]:=((n!)^2+(-1)^n*(2n+1)!/(n+1))/2; Array[a,16,0]
