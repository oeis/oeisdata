%I A399683 #31 Sep 07 2026 19:27:59
%S A399683 1,1,3,1,2,5,1,2,6,7,1,2,7,8,12,1,2,8,9,14,16,1,2,9,10,16,17,22,1,2,
%T A399683 10,11,18,19,25,29,1,2,11,12,20,21,28,29,37,1,2,12,13,22,23,31,32,39,
%U A399683 46,1,2,13,14,24,25,34,35,43,46,56,1,2,14,15,26,27,37,38,47,48,56,67
%N A399683 Triangle read by rows: T(n,k) is the maximum number of colors that can be used in an edge-coloring of K_n containing no rainbow copy of the k-vertex path P_k, for 3 <= k <= n.
%C A399683 Equivalently, T(n,k) is the anti-Ramsey number AR(n,P_k), where P_k denotes the path on k vertices.
%H A399683 Paolo Xausa, <a href="/A399683/b399683.txt">Table of n, a(n) for n = 3..11028</a> (rows 3..150 of triangle, flattened).
%H A399683 T. F. Bloom, <a href="https://www.erdosproblems.com/1105">Erdős Problem 1105</a>.
%H A399683 Long-Tu Yuan, <a href="https://arxiv.org/abs/2102.00807">Anti-Ramsey numbers for paths</a>, arXiv:2102.00807 [math.CO] (2021).
%F A399683 T(n,3) = 1 for n >= 3.
%F A399683 T(4,4) = 3, and T(n,4) = 2 for n >= 5.
%F A399683 Let m = floor((k-1)/2). For n >= k >= 5, T(n,k) = max(binomial(k-2,2) + 1, binomial(m-1,2) + (m-1)*(n-m+1) + e), where e = 1 if k is odd and e = 2 if k is even.
%e A399683 Triangle begins:
%e A399683   n\k| 3  4  5  6   7
%e A399683   ---+----------------
%e A399683    3 | 1;
%e A399683    4 | 1, 3;
%e A399683    5 | 1, 2, 5;
%e A399683    6 | 1, 2, 6, 7;
%e A399683    7 | 1, 2, 7, 8, 12;
%t A399683 A399683[n_, k_] := Switch[k, 3, 1, 4, Boole[n == 4] + 2, _, Max[Binomial[k-2, 2] + 1, Binomial[#, 2] + #*(n - #) + Boole[EvenQ[k]] + 1] & [Quotient[k-3, 2]]];
%t A399683 Table[A399683[n, k], {n, 3, 15}, {k, 3, n}] (* _Paolo Xausa_, Sep 07 2026 *)
%o A399683 (PARI)
%o A399683 T(n, k) = {
%o A399683   if(k==3, return(1));
%o A399683   if(k==4, return(if(n==4, 3, 2)));
%o A399683   my(m=(k-1)\2, e=if(k%2, 1, 2));
%o A399683   max(binomial(k-2, 2)+1, binomial(m-1, 2)+(m-1)*(n-m+1)+e);
%o A399683 };
%Y A399683 Cf. A399687.
%K A399683 nonn,tabl,new
%O A399683 3,3
%A A399683 _Seiichi Manyama_, Sep 07 2026
