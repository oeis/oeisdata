%I A399696 #12 Sep 09 2026 10:59:18
%S A399696 1,1,3,25,2427,22915921,6641112789920951523,
%T A399696 56226578048633499100813508152484103785065
%N A399696 Number of ordered antichain covers of a labeled n-element set.
%C A399696 This is the covering version of A037843: every element of the underlying n-set must belong to at least one member of the ordered antichain.
%F A399696 a(n) = Sum_{j=0..n} (-1)^(n-j) * binomial(n,j) * A037843(j).
%F A399696 a(n) = Sum_{k=1..n} (-1)^(n-k) * Stirling2(n,k) * k! * A056164(k), n >= 1.
%e A399696 a(3) = A037843(3) - 3*A037843(2) + 3*A037843(1) - A037843(0) = 39 - 3*7 + 3*3 - 2 = 25.
%Y A399696 Cf. A037843, A056164, A006126, A008277.
%K A399696 nonn,more,new
%O A399696 0,3
%A A399696 _Vladeta Jovovic_, Sep 08 2026
