%t A399344 (* First, load function f055932 from the link at A397499, then: *)
%t A399344 a238690[w_List] := If[Length[w] == 0, 1, Count[Tuples@ Map[Range[0, #] &, Flatten@ MapIndexed[ConstantArray[First[#2], #1] &, w]], _?(OrderedQ[#, LessEqual] &) ] ]; s = DeleteDuplicates@ Map[#[[;; -LengthWhile[Reverse[#], # == 0 &] - 1]] &, SortBy[Join @@ f055932[6, 1], f] - 1 /. {-1 -> Nothing}]; f[x_] := Times @@ Flatten@ MapIndexed[Prime[#2]^#1 &, x]; Map[a238690, s]
