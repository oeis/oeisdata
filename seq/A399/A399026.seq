%S A399026 0,1,3,7,14,24,41,62,96,135,195,261,358,462,609,764,976,1197,1491,
%T A399026 1795,2190,2596,3113,3642,4304,4979,5811,6657,7686,8730,9985,11256,
%U A399026 12768,14297,16099,17919,20046,22192,24681,27190,30080,32991,36323,39677,43494,47334,51681,56052,60976,65925,71475,77051
%N A399026 a(n) is the number of inequivalent ways of choosing 4 points on an n X n grid that form a square up to rotations and reflections.
%H A399026 Janaka Rodrigo, <a href="/A399026/b399026.txt">Table of n, a(n) for n = 1..1000</a>
%H A399026 Janaka Rodrigo, <a href="/A399026/a399026.txt">Python Code for A399026</a>.
%F A399026 a(n) = (1/96)*(n-1)*(n^3+n^2+39*n-9) for odd n,
%F A399026 a(n) = (1/96)*n*(n^3+32*n-24) for even n.
%e A399026 n = 4 has 7 different configurations as follows:
%e A399026   - - - -   - - - -   X - - X   - - - -   - - - -   - X - -   - - - -
%e A399026   - - - -   X - X -   - - - -   X X - -   - X - -   - - - X   - X X -
%e A399026   X X - -   - - - -   - - - -   X X - -   X - X -   X - - -   - X X -
%e A399026   X X - -   X - X -   X - - X   - - - -   - X - -   - - X -   - - - -
%e A399026 Therefore a(4) = 7.
%Y A399026 Cf. A002415 (rotations and reflections counted separately), A399025 (up to rotations).
%K A399026 nonn,easy,new
%O A399026 1,3
