%I A399070 #36 Aug 24 2026 23:22:03
%S A399070 2,3,5,7,17,11,13,43,257,19,41,683,241,2731,113,331,65537,43691,109,
%T A399070 174763,61681,5419,6337,2796203,5377,20251,4837,87211,15790321,
%U A399070 3033169,1321,715827883,33502081,646537,368425,1034041,581041,206248657,525313,22366891,4278255361
%N A399070 a(n) = lambda(2^n + 1) + 1, where lambda is the Carmichael function A002322.
%C A399070 All the terms a(n) are prime up to n = 23, as well as for numerous further n.
%C A399070 This sequence contains, among others, all Fermat primes and all Wagstaff primes.
%C A399070 However, it is not known how to prove that a(n) is prime for infinitely many n.
%C A399070 The problem also remains open: are all values of a(n) pairwise different?
%C A399070 Note that the values of lambda(2^n - 1) + 1 repeat in pairs many times.
%C A399070 The values of a(n) for n = 0..1128 are distinct. - _Amiram Eldar_, Aug 18 2026
%H A399070 Amiram Eldar, <a href="/A399070/b399070.txt">Table of n, a(n) for n = 0..1128</a>
%F A399070 a(n) == 1 (mod n) for n >= 1.
%F A399070 a(2n) <= A052539(n) for n >= 0.
%F A399070 a(2n+1) <= A007583(n) for n >= 0.
%F A399070 a(n) >= A002587(n) for n >= 0.
%F A399070 a(n) >= A112092(n) for n >= 1.
%t A399070 a[n_] := CarmichaelLambda[2^n + 1] + 1; Array[a, 41, 0] (* _Amiram Eldar_, Aug 18 2026 *)
%o A399070 (PARI) a(n) = lcm(znstar(2^n + 1)[2]) + 1; \\ _Michel Marcus_, Aug 18 2026
%Y A399070 Cf. A000051, A000978, A000979 (subsequence), A002322 (lambda), A002587, A007583, A019434 (subsequence), A052539, A092506 (subsequence), A112092, A387107 (lambda(2^n-1)).
%K A399070 nonn,new
%O A399070 0,1
%A A399070 _Thomas Ordowski_, Aug 18 2026
%E A399070 More terms from _Amiram Eldar_, Aug 18 2026
