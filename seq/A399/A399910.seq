%I A399910 #7 Sep 20 2026 00:57:12
%S A399910 9961111,16251967,35122807,72856711,126295327,220548007,255091087,
%T A399910 286486327,299042407,317874367,324151111,330427567,361805527,
%U A399910 402586111,433947511,490379887,518587327,559321111,693969247,762807511,800340967,840990511,850369447,912879127,981606511
%N A399910 Numbers k such that psi(k) = phi(k) + tau(k)^10.
%C A399910 Contains all numbers of the form p(2^19-p), where p and 2^19-p are both prime. Are there any other terms that are not of this form?
%H A399910 S. I. Dimitrov, <a href="https://github.com/Stoyan16/Numbers-k-such-that-psi-k-phi-k-tau-k-10/blob/main/A399910">Python program</a> (GitHub)
%e A399910 9961111 is a term since psi(9961111) = 10485400 = 9436824 + 4^10 = phi(9961111) + tau(9961111)^10.
%o A399910 (PARI) isok(k) = {my(f = factor(k)); prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) - eulerphi(f) == numdiv(f)^10; } \\ _Amiram Eldar_, Sep 15 2026
%Y A399910 Cf. A000005, A000010, A001615, A398971, A399539, A399540, A399541, A398648, A398797, A398806.
%K A399910 nonn,new
%O A399910 1,1
%A A399910 _S. I. Dimitrov_, Sep 15 2026
