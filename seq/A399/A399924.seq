%I A399924 #17 Sep 18 2026 23:54:21
%S A399924 1,3,4,5,7,11,12,13,15,16,17,19,20,21,23,28,29,31,33,35,37,39,41,43,
%T A399924 44,47,48,51,52,53,55,57,59,60,61,64,65,67,68,69,71,73,76,77,79,80,81,
%U A399924 83,84,85,87,89,91,92,93,95,97,101,103,105,107,109,111,112,113
%N A399924 Numbers k such that A007429(k) is odd.
%C A399924 Numbers k such that v(k,2) is even and that v(k,p) == 0, 1 (mod 4) for every odd prime p, where v(k,p) is the p-adic valuation of k.
%C A399924 In general, for m >= 2, let f(m,.) be the m-th inverse Moebius transform of natural numbers (so that f(m,.) has Dirichlet g.f. zeta(s-1)*zeta^m(s)), then f(m,k) is odd if and only if v(k,2) mod 2^(m-1) < 2^(m-2) and v(k,p) mod 2^m < 2^(m-1) for every odd prime p.
%C A399924 Has natural density Pi^2/18. For general m >= 2, the set of k such that f(m,k) is odd has natural density
%C A399924   ((1/2) * Sum_{e mod 2^(m-1)<2^(m-2)} 1/2^e) * Product_{p>2 prime} ((p-1)/p) * (Sum_{e mod 2^m<2^(m-1)} 1/p^e) = (1+1/2^2^(m-2))^(-1) * Product_{p>2 prime} (1+1/p^2^(m-1))^(-1) = ((1+1/2^2^(m-1))/(1+1/2^2^(m-2))) * zeta(2^m)/zeta(2^(m-1)).
%H A399924 Jianing Song, <a href="/A399924/b399924.txt">Table of n, a(n) for n = 1..10000</a>
%p A399924 filter:= proc(k) local v2;
%p A399924   v2:= padic:-ordp(k,2);
%p A399924   if v2::odd then return false fi;
%p A399924   andmap(t -> t[2] mod 4 <= 1, ifactors(k/2^v2)[2]);
%p A399924 end proc:
%p A399924 select(filter, [$1..200]); # _Robert Israel_, Sep 16 2026
%t A399924 A399924Q[k_] := OddQ[DivisorSum[k, DivisorSigma[1, #] &]];
%t A399924 Select[Range[150], A399924Q] (* _Paolo Xausa_, Sep 16 2026 *)
%o A399924 (PARI) isodd(n,{m=2}) = {
%o A399924 if(valuation(n,2) % 2^(m-1) >= 2^(m-2), return(0));
%o A399924 my(f=factor(n)); for(j=1, #f[, 1], my(p=f[j, 1], e=f[j, 2]); if(p>2 && valuation(n,p) % 2^m >= 2^(m-1), return(0)));
%o A399924 return(1);
%o A399924 }
%Y A399924 Cf. A007429, A028982 (k such that f(1,k) = sigma(k) is odd), A399925 (complement).
%K A399924 nonn,new
%O A399924 1,2
%A A399924 _Jianing Song_, Sep 16 2026
