%H A399521 Alper Ferudun, <a href="/A399521/a399521_2.png">Rows 40..100 of T for 0 <= x < 8192, showing preperiods and periods</a>
%H A399521 R. Rado, <a href="https://doi.org/10.1112/plms/s2-48.1.122">Note on combinatorial analysis</a>, Proc. London Math. Soc. (2) 48 (1943), 122-160.
%H A399521 E. Witt, <a href="https://doi.org/10.1002/mana.19520060502">Ein kombinatorischer Satz der Elementargeometrie</a>, Math. Nachr. 6 (1952), 261-262.
%F A399521 A062383(n) | a(n).
%F A399521 lcm(a(0),...,a(n))/lcm(a(0),...,a(n-1)) <= (n+1)^n for n >= 1; hence a(n) <= Product_{i=1..n} (i+1)^i.
%e A399521 The corner of the array T, with y indexing rows and x indexing columns, begins:
%e A399521   0 0 0 0 0 0 0 0
%e A399521   0 1 0 1 0 1 0 1
%e A399521   0 0 1 1 0 0 1 1
%e A399521   0 1 1 2 0 1 1 2
%e A399521   0 0 0 0 1 1 2 1
%e A399521   0 1 0 1 1 2 2 2
%e A399521   0 0 1 1 2 2 3 2
%e A399521   0 1 1 2 1 2 2 3
%e A399521 Rows 0, 1, 2 and 3 repeat the blocks (0), (0,1), (0,0,1,1) and (0,1,1,2), respectively, so a(0..3) = 1,2,4,4.
%o A399521 (Python)
%o A399521 from math import lcm
%o A399521 def periods(N):  # P(0..N) = least eventual periods, U(0..N) = least preperiods of the rows x -> T(x,y)
%o A399521     R, P, U, Q, S = [], [], [], 1, 0  # stored rows; rows < y are Q-periodic from column S
%o A399521     def grow(y, L):  # row y on [0,L) by the definition, rows < y extended by periodicity
%o A399521         r = R[y]
%o A399521         for x in range(len(r), L):
%o A399521             for z in range(y):
%o A399521                 while len(R[z]) <= x: R[z].append(R[z][-P[z]])
%o A399521             s = {r[x-d] for d in range(1, min(x, y)+1) if r[x-d] == R[y-d][x] == R[y-d][x-d]}
%o A399521             r.append(min(set(range(len(s)+1)) - s))
%o A399521     for y in range(N+1):
%o A399521         R.append([]); r = R[y]; x = S+y; M = 0
%o A399521         while not M:  # least M = j*Q with row y equal on [u,u+y) and [u+M,u+M+y) for some u >= S
%o A399521             x += 1; grow(y, x)
%o A399521             M = next((m for m in range(Q, x-y-S+1, Q) if r[x-y-m:x-m] == r[x-y:x]), 0)
%o A399521         u = x-y-M; grow(y, u+2*M)  # so row y is M-periodic from u
%o A399521         p = min(q for q in range(1, M+1) if M % q == 0 and r[u+q:u+q+M] == r[u:u+M])
%o A399521         P.append(p); U.append(max([i+1 for i in range(u) if r[i] != r[i+p]], default=0))
%o A399521         Q, S = lcm(Q, p), max(S, U[y])
%o A399521     return P, U, R
%o A399521 print(periods(75)[0])
%Y A399521 Cf. A401735, A401738, A401736, A401737, A401739.
