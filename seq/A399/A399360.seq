%S A399360 1,41860,1419874,3415095,3984036,47148036,61981080,1174227236,
%T A399360 4662528036,102123854475
%N A399360 Positive numbers equal to the sum of the fourth powers of their first k divisors for some k.
%C A399360 Numbers which are also members of this sequence: 24392202216760, 1080723741650040, 87619325968517283704, 209081192537340662340, 777324834257170956708, 48929879780773662908916 respectively. - _David A. Corneth_, Sep 28 2026
%e A399360 41860 --> (1, 2, 4, 5, 7, 10, 13): 1^4 + 2^4 + 4^4 + 5^4 + 7^4 + 10^4 + 13^4 = 41860.
%e A399360 1419874 --> (1, 2, 17, 34): 1^4 + 2^4 + 17^4 + 34^4 = 1419874.
%e A399360 3415095 --> (1, 3, 5, 9, 15, 27, 41): 1^4 + 3^4 + 5^4 + 9^4 + 15^4 + 27^4 + 41^4 = 3415095.
%t A399360 Do[
%t A399360   divs = Divisors[n];
%t A399360   total = 0;
%t A399360   k = 0;
%t A399360   found = False;
%t A399360   Do[
%t A399360     total += divs[[i]]^4;
%t A399360     k = i;
%t A399360     If[total == n, found = True; Break[]];
%t A399360     If[total > n, Break[]],
%t A399360     {i, Length[divs]}
%t A399360   ];
%t A399360   If[found, Print[{n, k, Take[divs, k]}]],
%t A399360   {n, 1, 2000000000}
%t A399360 ]
%Y A399360 Cf. A000583, A064510, A185584, A185960.
%K A399360 nonn,more,new
%O A399360 1,2
