%I A399988 #24 Oct 01 2026 20:25:48
%S A399988 3,-4,-11,16,81,-96,-12,-559,640,96,4033,-4480,-720,-60,-29567,32256,
%T A399988 5376,720,219649,-236544,-40320,-6720,-252,-1647359,1757184,304128,
%U A399988 57600,4032,12446721,-13178880,-2306304,-475200,-45360,-1020,-94595071,99573760,17571840,3843840,443520,20400
%N A399988 Irregular triangle read by rows: Sum_{m>=2} (-1)^m/A000217(m)^n = T(n,0) + T(n,1)*log(2) + Sum_{k=2..ceiling(n/2)} T(n,k)*zeta(2*k-1).
%C A399988 The alternating sum of the inverse n-th powers of the triangular numbers is always a rational combination of 1, log(2) and the odd zeta values zeta(3), zeta(5), ...; row n lists the coefficients.
%C A399988 Reason: expand 1/(m*(m+1))^n in partial fractions. The symmetry m -> -1-m fixes m*(m+1) and changes the sign of (-1)^m, so the even powers contribute only rational numbers, the power 1 gives log(2), and each odd power 2*k-1 >= 3 gives a multiple of (1 - 4^(1-k))*zeta(2*k-1).
%C A399988 Without the sign (-1)^m, the same argument gives rational combinations of 1 and zeta(2), zeta(4), ..., i.e., of powers of Pi^2.
%H A399988 Gnouma Jerome Kadouno, <a href="/A399988/b399988.txt">Table of n, a(n) for n = 1..1022</a>
%H A399988 Wikipedia, <a href="https://en.wikipedia.org/wiki/Partial_fraction_decomposition">Partial fraction decomposition</a>.
%H A399988 Wikipedia, <a href="https://en.wikipedia.org/wiki/Riemann_zeta_function">Riemann zeta function</a>.
%F A399988 T(n,0) = (-1)^(n-1)*(2^(n+1)*Sum_{j odd, 1<=j<=n} binomial(2*n-j-1, n-1) - Sum_{i=0..n-1} binomial(n-1+i, n-1)*2^i).
%F A399988 T(n,1) = (-1)^n*2^(n+1)*binomial(2*n-2, n-1) = (-1)^(n+1)*A098580(n).
%F A399988 T(n,k) = (-1)^n*(2^(n+1) - 2^(n+3-2*k))*binomial(2*n-2*k, n-1) for 2 <= k <= ceiling(n/2).
%F A399988 Integral_{t=0..oo} (Sum_{m>=2} (-1)^m/A000217(m)^t) dt = A400105.
%e A399988 Here A(n) = Sum_{m>=2} (-1)^m/A000217(m)^n.
%e A399988 Row 1:  3, -4                     A(1) = 3 - 4*log(2)
%e A399988 Row 2:  -11, 16                   A(2) = -11 + 16*log(2)
%e A399988 Row 3:  81, -96, -12              A(3) = 81 - 96*log(2) - 12*zeta(3)
%e A399988 Row 4:  -559, 640, 96             A(4) = -559 + 640*log(2) + 96*zeta(3)
%e A399988 Row 5:  4033, -4480, -720, -60    A(5) = 4033 - 4480*log(2) - 720*zeta(3) - 60*zeta(5)
%e A399988 Row 6:  -29567, 32256, 5376, 720  A(6) = -29567 + 32256*log(2) + 5376*zeta(3) + 720*zeta(5)
%o A399988 (PARI)
%o A399988 t(n,j)=(-1)^(n-j)*binomial(2*n-j-1,n-1);
%o A399988 row(n)=concat([2^n*sum(j=1,n,t(n,j)*(1-(-1)^j+(-1)^j/2^j))], vector((n+1)\2,i,-2^(n+1)*t(n,2*i-1)*if(i==1,1,1-2^(2-2*i))));
%o A399988 for(n=1,12,print(row(n)))
%Y A399988 Cf. A000217, A098580, A400105.
%K A399988 sign,tabf,easy,new
%O A399988 1,1
%A A399988 _Gnouma Jerome Kadouno_, Sep 18 2026
