%I A399613 #15 Sep 11 2026 17:05:29
%S A399613 2,103,199,26203,2518357,5832066517
%N A399613 a(n) is the least prime p such that there are exactly n primes q with A161351(q) = p.
%C A399613 a(n) is the least prime p such that there are exactly n primes q with q + (sum of digits of q) + (product of digits of q) = p.
%C A399613 From _David A. Corneth_, Sep 05 2026: (Start)
%C A399613 a(6) > 10^11 if it exists.
%C A399613 For n > 1 are primes q without digit 0 (cf. A038618.) making the product of digits nonzero? This holds for n = 2 through 5. (End)
%H A399613 David A. Corneth, <a href="/A399613/a399613.gp.txt">PARI program</a>
%e A399613 103 = 101 + (1+0+1) + (1*0*1).
%e A399613 199 = 149 + (1+4+9) + (1*4*9) = 181 + (1+8+1) + (1*8*1).
%e A399613 26203 = 25463 + (2+5+4+6+3) + (2*5*4*6*3)
%e A399613       = 25913 + (2+5+9+1+3) + (2*5*9*1*3)
%e A399613       = 26141 + (2+6+1+4+1) + (2*6*1*4*1).
%e A399613 2518357 = 2447759 + (2+4+4+7+7+5+9) + (2*4*4*7*7*5*9)
%e A399613         = 2457839 + (2+4+5+7+8+3+9) + (2*4*5*7*8*3*9)
%e A399613         = 2472959 + (2+4+7+2+9+5+9) + (2*4*7*2*9*5*9)
%e A399613         = 2494991 + (2+4+9+4+9+9+1) + (2*4*9*4*9*9*1).
%e A399613 From _David A. Corneth_, Sep 05 2026: (Start)
%e A399613 5832066517 = 5831366633 + (5+8+3+1+3+6+6+6+3+3) + (5*8*3*1*3*6*6*6*3*3)
%e A399613            = 5831444393 + (5+8+3+1+4+4+4+3+9+3) + (5*8*3*1*4*4*4*3*9*3)
%e A399613            = 5831537273 + (5+8+3+1+5+3+7+2+7+3) + (5*8*3*1*5*3*7*2*7*3)
%e A399613            = 5831794313 + (5+8+3+1+7+9+4+3+1+3) + (5*8*3*1*7*9*4*3*1*3)
%e A399613            = 5831833193 + (5+8+3+1+8+3+3+1+9+3) + (5*8*3*1*8*3*3*1*9*3). (End)
%p A399613 f:= proc(n) local L; L:= convert(n,base,10); n + convert(L,`*`) + convert(L,`+`) end proc:
%p A399613 N:= 3*10^7: # for terms <= N
%p A399613 p:= 2: m:= 0: V[2]:= 0:
%p A399613 do
%p A399613   p:= nextprime(p);
%p A399613   if p > N then break fi;
%p A399613   v:= f(p);
%p A399613   if v < N and isprime(v) then
%p A399613     if assigned(V[v]) then
%p A399613        V[v]:= V[v]+1; m:= max(m, V[v])
%p A399613     else V[v]:= 1
%p A399613     fi
%p A399613   fi
%p A399613 od:
%p A399613 J:= sort(map(op, [indices(V)])):
%p A399613 seq(min(select(t -> V[t]=k, J)), k=0..m);
%o A399613 (PARI) \\ See Corneth link
%Y A399613 Cf. A038618, A161351, A399608.
%K A399613 nonn,base,more,new
%O A399613 0,1
%A A399613 _Robert Israel_, Sep 04 2026
%E A399613 a(5) from _David A. Corneth_, Sep 05 2026
