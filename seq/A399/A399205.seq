%I A399205 #19 Sep 29 2026 08:00:05
%S A399205 0,0,0,0,2,4,9,17,40,84,153,282,508,976,1825,3450,6445,12096,22931,
%T A399205 43338,82164,155892
%N A399205 Number of Pillai primes (A063980) less than 2^n.
%e A399205 a(5) = 2 since there are two Pillai primes, {23, 29}, less than 2^5 = 32.
%e A399205 a(6) = 4 since there are four Pillai primes, {23, 29, 59, 61}, less than 2^6 = 64.
%t A399205 fQ = Compile[{{p, _Integer}}, Block[{mm = 1, m = 2}, While[mm = Mod[mm*m, p]; m < p && mm + 1 != p || Mod[p, m] == 1, m++]; m < p]]; cnt = 0; p = 2; lst = {}; Do[ While[ p < 2^n, cnt += Boole[ fQ[ p]]; p = NextPrime[p]]; AppendTo[lst, cnt], {n, 22}]; lst
%Y A399205 Cf. A063980, A000079.
%K A399205 nonn,more,new
%O A399205 1,5
%A A399205 _Robert G. Wilson v_, Sep 21 2026
