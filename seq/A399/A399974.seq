%I A399974 #4 Sep 18 2026 00:02:03
%S A399974 1,3,7,51,211,6991,46103,22734367,203516191,24351316021951
%N A399974 Number of nonempty sets of pairwise commuting involutions on [n].
%F A399974 Let B_k(n) be the number of k-element sets of pairwise commuting involutions on [n]. Then a(n) = Sum_{k=1..2^floor(n/2)} B_k(n).
%F A399974 B_k(n) = (1/k!) * Sum_{r=1..k} A008275(k,r)*A362824(n,r).
%F A399974 Sum_{n>=0} A362824(n,r)*x^n/n! = exp(Sum_{j=0..r} A022166(r,j)*x^(2^j)/2^j).
%F A399974 Here A022166(r,j) is the number of subgroups of index 2^j in the elementary Abelian group (C_2)^r.
%e A399974 For n=3, the 7 sets are {e}, {(12)}, {(13)}, {(23)}, {e,(12)}, {e,(13)}, and {e,(23)}, so a(3)=7.
%Y A399974 Cf. A022166 (subgroups of elementary Abelian 2-groups), A362824 (ordered tuples of pairwise commuting involutions), A362825 (case of three commuting involutions), A399972 (nonempty sets of pairwise commuting permutations).
%K A399974 nonn,more,new
%O A399974 1,2
%A A399974 _Vladeta Jovovic_, Sep 17 2026
