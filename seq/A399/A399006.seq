%S A399006 1,1,1,1,1,1,1,3,4,2,1,3,13,16,7,1,6,31,86,89,23,1,6,66,320,723,579,
%T A399006 115,1,10,123,956,3773,6762,4549,694,1,10,214,2408,14914,47404,71188,
%U A399006 40784,5282,1,15,346,5380,47982,238998,636732,818664,410010,46066
%N A399006 Triangle read by rows: T(n,k) is the number of inequivalent ways to place k non-attacking rooks on an n X n board up to rotations and reflections of the board.
%H A399006 Andrew Howroyd, <a href="/A399006/b399006.txt">Table of n, a(n) for n = 0..1325</a> (rows 0..50)
%e A399006 Triangle begins:
%e A399006   1;
%e A399006   1,  1;
%e A399006   1,  1,   1;
%e A399006   1,  3,   4,    2;
%e A399006   1,  3,  13,   16,     7;
%e A399006   1,  6,  31,   86,    89,    23;
%e A399006   1,  6,  66,  320,   723,   579,   115;
%e A399006   1, 10, 123,  956,  3773,  6762,  4549,   694;
%e A399006   1, 10, 214, 2408, 14914, 47404, 71188, 40784, 5282;
%e A399006   ...
%o A399006 (PARI)
%o A399006 B(n,k) = binomial(n,k)^2*k!
%o A399006 R2(n,k) = if(k%2>n%2, 0, my(t=k\2); binomial(n\2,t)^2*2^t*t!)
%o A399006 R4(n,k) = if(k%4>n%2, 0, my(t=k\4); binomial(n\2,2*t)*(2*t)!/t!)
%o A399006 V(n,k) = if(k==1 && n%2==1, n, k==0)
%o A399006 D(n,k) = sum(i=0, k\2, binomial(n,2*i)*binomial(n-2*i,k-2*i)*(2*i)!/(i!*2^i))
%o A399006 T(n,k) = (B(n,k) + R2(n,k) + 2*R4(n,k) + 2*D(n,k) + 2*V(n,k))/8
%Y A399006 Row sums are A399007.
%Y A399006 Main diagonal is A000903.
%Y A399006 Columns k=0..2 are A000012, A008805(n-1), A307304; column 4 is A398393.
%Y A399006 Cf. A144084 (not reduced for symmetry), A399008 (up to rectangular symmetries), A399010 (up to rotations).
%K A399006 nonn,tabl,new
%O A399006 0,8
