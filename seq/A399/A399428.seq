%S A399428 1,3,12,44,165,615,2297,8577,32037,119677,447114,1670538,6241919,
%T A399428 23323665,87154128,325677900,1217013471,4547864241,16995084252,
%U A399428 63509972796,237335446647,886920801069,3314425366737,12386041437585,46286834231519,172974837718755,646411043171598,2415654909953998,9027369929986185
%N A399428 The number of chains in "0,1,2" Motzkin trees.
%H A399428 Drew Dickenson, <a href="https://search.proquest.com/openview/1b6e631ca9d238111da3e481b1b45362/1.pdf">Analysis of Ordered Trees Using Riordan Group Techniques</a>, Ph.D. thesis, Howard University, 2024.
%F A399428 G.f.: M(z)*T(z)/(2-T(z)), where M(z) = (1-z-sqrt(1-2z-3z^2))/(2*z^2) is the g.f. of the Motzkin numbers A001006, and T(z) = 1/sqrt(1-2z-3z^2) is the g.f. of the central trinomial coefficients A002426.
%F A399428 More generally, the g.f. for k-element chains is M(z)*T(z)*(T(z)-1)^(k-1), k >= 1.
%F A399428 Thus, if c(n,k) is the total number of k-element chains in all "0,1,2" Motzkin trees with n edges, then Sum_{n>=0} Sum_{k>=1} c(n,k)*y^k*z^n = y*M(z)*T(z)/(1-y(T(z)-1)).
%F A399428 a(n) ~ (13 + 35/sqrt(13)) * 2^n * (2 + sqrt(13))^n / 3^(n+3). - _Vaclav Kotesovec_, Aug 29 2026
%e A399428 For n = 2 there are two "0,1,2" Motzkin trees. The 3-vertex path has 7 nonempty chains, and the tree consisting of a root with two leaf children has 5 nonempty chains. Hence a(2) = 7 + 5 = 12.
%p A399428 M := (1-z-sqrt(1-2*z-3*z^2))/(2*z^2):
%p A399428 T := 1/sqrt(1-2*z-3*z^2):
%p A399428 G := M*T/(2-T):
%p A399428 seq(coeff(series(G, z=0, 33), z, n), n=0..28);
%t A399428 m = (1-z-Sqrt[1-2z-3z^2])/(2z^2);
%t A399428 t = 1/Sqrt[1-2z-3z^2];
%t A399428 CoefficientList[Normal[Series[m*t/(2-t), {z,0,29}]], z]
%Y A399428 Cf. A001006, A002426, A005717, A007854, A126191, A178834, A335349.
%K A399428 easy,nonn,new
%O A399428 0,2
%A A399428 _Drew Dickenson_, Aug 28 2026
