%N A399588 a(0) = 1; a(n) = Sum_{k=1..n} (-1)^(k+1) * binomial(3*n-2*k,k) * 2^(k*(n-k)) * a(n-k).
%F A399588 1 = Sum_{n>=0} a(n) * x^n / (1 + 2^n * x)^(3*n+1).
%F A399588 From _Vaclav Kotesovec_, Oct 03 2026: (Start)
%F A399588 a(n) ~ c * d^n * n^(n + f) * 2^(n^2/2), where
%F A399588 d = 0.5244280584798220036565956845148311392903671416545...
%F A399588 f = 0.2584002599693591561083681356667139732381477126251...
%F A399588 c = 1.3825158807604243128105589350163302840281696216423... (End)
%t A399588 a[0] = 1; a[n_] := a[n] = Sum[(-1)^(k + 1) Binomial[3 n - 2 k, k] 2^(k (n - k)) a[n - k], {k, 1, n}]; Table[a[n], {n, 0, 14}]
