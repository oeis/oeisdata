%S A399324 1,3,10,37,146,599,2521,10805,46960,206395,915641,4094633,18438200,
%T A399324 83537445,380553210,1742137965,8010895160,36986051075,171396969775,
%U A399324 796975353925,3717464256720,17390227144185,81569447163550,383557269691177,1807748858015246,8538527726570769
%N A399324 a(n) = (1/(n + 2)) * Sum_{k=0..n} binomial(2*k, k) * binomial(n+2, k+1). Row sums of A106534.
%F A399324 a(n) ~ 5^(n + 5/2) / (8*sqrt(Pi)*n^(3/2)). - _Vaclav Kotesovec_, Aug 28 2026
%p A399324 a := n -> local k; (1/(n + 2)) * add(binomial(2*k, k) * binomial(n+2, k+1), k = 0..n): seq(a(n), n = 0..25);
%t A399324 Table[Sum[Binomial[2*k, k]*Binomial[n+2, k+1], {k, 0, n}]/(n+2), {n, 0, 30}] (* _Vaclav Kotesovec_, Aug 28 2026 *)
%o A399324 (Python)
%o A399324 def a_iter():
%o A399324     row = [1]
%o A399324     cat, n = 1, 1
%o A399324     while True:
%o A399324         yield sum(row)
%o A399324         cat = cat * (4 * n - 2) // (n + 1)
%o A399324         row.append(cat)
%o A399324         for k in range(n - 1, -1, -1):
%o A399324             row[k] += row[k + 1]
%o A399324         n += 1
%o A399324 a = a_iter()
%o A399324 print([next(a) for _ in range(27)])
%Y A399324 C. A106534, A000108.
%K A399324 nonn,easy,new
%O A399324 0,2
%A A399324 _Peter Luschny_, Aug 28 2026
