%I A399478 #28 Oct 06 2026 16:28:41
%S A399478 -1,1,7,38,226,1524,11628,99504,945936,9902880,113286240,1406609280,
%T A399478 18844755840,271011605760,4164806419200,68118933657600,
%U A399478 1181560010803200,21665613202329600,418760399406182400,8509657835943936000,181379006763816960000,4046294894992035840000
%N A399478 a(n) = n! * (H_{n-1} - 1/n), where H_n is the n-th harmonic number.
%C A399478 Found in the closed-form evaluation of the integral (-1)^n * Integral_{x=0..1} li(x) * ln(1/x)^(n-1) * ln(-ln(x)) / x dx, which evaluates to (a(n) - n!*gamma) / n^2, where gamma is the Euler-Mascheroni constant (A001620).
%C A399478 The absolute values of the terms appear in Olivier Gérard's permutations table.
%C A399478 From _Natalia L. Skirrow_, Sep 19 2026: (Start)
%C A399478 By substituting t = log(1/x), the integral becomes: Integral_{t=0..oo} -Ei(-t) * t^(n-1) * log(t) dt.
%C A399478 Integration by parts produces: Integral_{t=0..oo} exp(-t) * t^(n-1) * (log(t)/n - 1/n^2) dt.
%C A399478 This can be recognized as differentiation under the integral sign: [d/dx (Gamma(x)/x)] evaluated at x=n.
%C A399478 So it is (a(n) - n!*gamma) / n^2. (End)
%H A399478 Olivier Gérard, <a href="https://oeis.org/wiki/User:Olivier_G%C3%A9rard/Permutations">Permutations</a>
%F A399478 D-finite with n*a(n) = (2*n^2 - n - 2)*a(n-1) - (n+1)*(n-1)*(n-2)*a(n-2), n >= 3; a(1) = -1, a(2) = 1.
%F A399478 a(n) = n! * ((Sum_{k=1..n-1} 1/k) - 1/n).
%F A399478 a(n) = n * Stirling1(n, 2) - Stirling1(n, 1).
%F A399478 a(n) = n*a(n-1) + (n+1)*(n-2)! for n >= 2, with a(1) = -1.
%F A399478 a(n) = [x] (n - x) * Product_{k=1..n-1} (x + k).
%F A399478 a(n) = Sum_{k=1..n} A199221(n, k).
%F A399478 E.g.f.: log(1-x) * (1-2*x) / (1-x). - _Natalia L. Skirrow_, Sep 19 2026
%e A399478 For n=4, a(4) = 4! * (1 + 1/2 + 1/3 - 1/4) = 38.
%p A399478 seq(simplify(n! * (harmonic(n-1) - 1/n)), n=1..22);
%t A399478 Table[n! (HarmonicNumber[n-1] - 1/n), {n, 1, 22}]
%t A399478 (* Alternative: *)
%t A399478 Table[Simplify[n!*EulerGamma + n^2*D[Gamma[x]/x,x]/.x->n],{n,1,22}] (* _Natalia L. Skirrow_, Sep 19 2026 *)
%o A399478 (Python)
%o A399478 from math import factorial as fact
%o A399478 from sympy import harmonic as harm
%o A399478 A399478 = lambda n: int(fact(n-1) * (n*harm(n-1) - 1))
%o A399478 print([A399478(n) for n in range(1, 23)])
%o A399478 (PARI) a(n) = n!*(sum(k=1, n-1, 1/k) - 1/n); \\ _Michel Marcus_, Sep 27 2026
%Y A399478 Cf. A199221, A001008, A002805.
%K A399478 sign,easy,new
%O A399478 1,3
%A A399478 _Param Srivastava_, Aug 29 2026
