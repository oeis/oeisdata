%I A399060 #20 Oct 02 2026 15:38:15
%S A399060 1,1,1,1,2,1,3,2,3,3,4,2,4,4,4,4,7,5,6,5,5,7,8,6,8,8,8,9,10,8,11,8,10,
%T A399060 11,10,9,13,14,13,12,14,12,15,13,14,16,18,15,16,16,17,19,19,16,17,16,
%U A399060 20,22,24,20,24,23,22,21,21,20,23,24,22,23,28,22,28,26
%N A399060 a(n) is the maximum size of a subset of the distinct entries in row n of Pascal's triangle such that no selected entry divides another.
%C A399060 Let P_n = {binomial(n, k) : 0 <= k <= floor(n/2)}, ordered by divisibility. Then a(n) is the width of this poset.
%C A399060 For 0 <= k < n/2, binomial(n, k) divides binomial(n, k + 1) if and only if k + 1 divides n + 1.
%C A399060 By Dilworth's theorem, a(n) can be computed from a maximum matching in the bipartite graph associated with the divisibility poset P_n.
%H A399060 Felix Huber, <a href="/A399060/b399060.txt">Table of n, a(n) for n = 0..6068</a>
%H A399060 D. Bazzanella, A. Languasco, and A. Zaccagnini, <a href="https://doi.org/10.1090/S0002-9947-09-05009-0">Prime numbers in logarithmic intervals</a>, Trans. Amer. Math. Soc. 362 (2010), no. 5, 2667-2684.
%H A399060 R. P. Dilworth, <a href="https://doi.org/10.2307/1969503">A decomposition theorem for partially ordered sets</a>, Ann. of Math. (2) 51 (1950), 161-166.
%H A399060 P. Erdős and E. G. Straus, <a href="https://static.renyi.hu/~p_erdos/1977-18.pdf">On products of consecutive integers</a>, Number Theory and Algebra, Academic Press, New York, 1977, pp. 63-70.
%H A399060 Felix Huber, <a href="https://felixhuber-math.github.io/papers/Huber_A399060_preprint.pdf">Maximum Cardinality of Divisibility-Free Subsets in Rows of Pascal's Triangle: OEIS A399060</a>, preprint, 2026.
%H A399060 H. Joris, C. Oestreicher, and J. Steinig, <a href="https://doi.org/10.1016/0022-314X(85)90013-7">The greatest common divisor of certain sets of binomial coefficients</a>, J. Number Theory 21 (1985), no. 1, 101-119.
%H A399060 D. Singmaster, <a href="https://www.fq.math.ca/Books/Collection/singmaster.pdf">Divisibility of binomial and multinomial coefficients by primes and prime powers</a>, A Collection of Manuscripts Related to the Fibonacci Sequence, Fibonacci Association, Santa Clara, CA, 1980, pp. 98-113.
%F A399060 a(n) = 1 if and only if n is in {0, 1, 2, 3, 5}.
%F A399060 a(2*m) <= m + 2 - A000005(2*m + 1).
%F A399060 a(2*m + 1) <= m + 3 - A000005(2*m + 2).
%F A399060 liminf_{n -> infinity} a(n)*log(n)/n >= 1.
%F A399060 liminf_{p -> infinity, p prime} a(p - 1)/p >= 1/(8*3.454) = 0.03618992...
%e A399060 For n = 6, the distinct entries are 1, 6, 15, 20. Since 1 divides every other entry, a divisibility-free subset has at most three elements, and {6, 15, 20} has three. Hence a(6) = 3.
%e A399060 For n = 11, the distinct entries are 1, 11, 55, 165, 330, 462. They can be partitioned into the two divisibility chains 1 | 11 | 55 | 165 | 330 and {462}, while 330 and 462 are incomparable. Hence a(11) = 2.
%p A399060 f := proc(u, a, m, s)
%p A399060     local v;
%p A399060     for v in a[u] do
%p A399060         if not s[v] then
%p A399060             s[v] := true;
%p A399060             if m[v] = 0 or f(m[v], a, m, s) then
%p A399060                 m[v] := u;
%p A399060                 return true
%p A399060             end if
%p A399060         end if
%p A399060     end do;
%p A399060     false
%p A399060 end proc:
%p A399060 A399060 := proc(n) option remember;
%p A399060     local a, b, i, j, m, q, s, v;
%p A399060     m := iquo(n, 2) + 1; b := [seq(binomial(n, i), i = 0 .. m - 1)]; a := Array(1 .. m);
%p A399060     for i to m do a[i] := [] end do;
%p A399060     for i to m do
%p A399060         for j from i + 1 to m do
%p A399060             if irem(b[j], b[i]) = 0 then a[i] := [op(a[i]), j] end if
%p A399060         end do
%p A399060     end do;
%p A399060     q := Array(1 .. m, 'fill' = 0); v := 0;
%p A399060     for i to m do
%p A399060         s := Array(1 .. m, 'fill' = false);
%p A399060         if f(i, a, q, s) then v := v + 1 end if
%p A399060     end do;
%p A399060     m - v;
%p A399060 end proc:
%p A399060 seq(A399060(n), n = 0 .. 73);
%Y A399060 Cf. A000005, A007318, A020475, A217607.
%K A399060 nonn,new
%O A399060 0,5
