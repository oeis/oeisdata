%I A399391 #13 Sep 08 2026 19:11:13
%S A399391 1,4,7,8,10,13,14,15,17,19,22,23,24,26,27,29,33,36,37,39,42,44,46,49,
%T A399391 51,54,56,59,60,64,66,67,68,69,71,74,76,78,80,81,83,85,87,91,93,95,97,
%U A399391 98,99,101,103,105,107,109,110,111,114,115,116,118,123,125,126
%N A399391 Indices of record high-water marks of the sequence abs((sin(p))^p) where p is the numerator of the k-th convergent to Pi/2, starting from k = 1.
%H A399391 Jwalin Bhatt, <a href="/A399391/b399391.txt">Table of n, a(n) for n = 1..939</a>
%e A399391 The first few values of abs((sin(p))^p), where p is the numerator of the k-th convergent to Pi/2, are:
%e A399391   | k  | p       | abs((sin(p))^p)     |
%e A399391   |----|---------|---------------------|
%e A399391   | 1  | 1       | 0.841470984807897   |
%e A399391   | 2  | 2       | 0.826821810431806   |
%e A399391   | 3  | 3       | 0.002810384734461   |
%e A399391   | 4  | 11      | 0.999892277332724   |
%e A399391   | 5  | 344     | 0.996682289874272   |
%e A399391   | 6  | 355     | 1.3*10^-1605        |
%e A399391   | 7  | 51819   | 0.999984273727943   |
%e A399391   | 8  | 52174   | 0.999999208712392   |
%e A399391   | 9  | 260515  | 0.999999114841378   |
%e A399391   | 10 | 573204  | 0.999999975245806   |
%e A399391 and the record high points are at k = 1, 4, 7, 8, 10, ...
%t A399391 Module[{x, y, runningMax = 0, positions = {}},
%t A399391   x = Numerator @ Convergents[Pi/2, 60]; y = Abs[Sin[x]^x];
%t A399391   Do[If[y[[i]] > runningMax, runningMax = y[[i]]; AppendTo[positions, i]; ], {i, Length[y]}];
%t A399391   positions
%t A399391 ]
%o A399391 (Python)
%o A399391 from sympy import pi, continued_fraction_iterator, continued_fraction_convergents
%o A399391 from itertools import islice
%o A399391 from mpmath import iv
%o A399391 cf_iter = continued_fraction_convergents(continued_fraction_iterator(pi/2))
%o A399391 cf_nums = [f.numerator for f in islice(cf_iter, 130)]
%o A399391 running_max, A399391 = 0, []
%o A399391 for i, p in enumerate(cf_nums, start=1):
%o A399391     while True:
%o A399391         x = abs(iv.sin(p)**p)
%o A399391         if (comparison:=x>running_max) is None:
%o A399391             iv.dps += 1
%o A399391             prev = cf_nums[A399391[-1]-1]
%o A399391             running_max = abs(iv.sin(prev)**prev)
%o A399391         else: break
%o A399391     if comparison:
%o A399391         A399391.append(i)
%o A399391         running_max = x
%o A399391 print(A399391)
%Y A399391 Cf. A096456, A096463, A382815, A383117.
%K A399391 nonn,new
%O A399391 1,2
%A A399391 _Jwalin Bhatt_, Aug 27 2026
