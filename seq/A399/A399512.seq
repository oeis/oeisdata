%I A399512 #21 Sep 21 2026 01:06:29
%S A399512 2,178,1034,18326,512050,41650,1163750,398125,1806875,13820625,
%T A399512 62724375,479773125,2177431875,701206875,1094866875,6360069375,
%U A399512 2408707125,13992152625,5299155675,30782735775,11658142485,67722018705,25647913467,148988441151,2640582371889,73780978038075,6001323572475,167684040995625,13639371755625,381100093171875
%N A399512 Trajectory of 2 under Conway's PIGAME.
%C A399512 See A395539 for the definition of the PIGAME successor function and many related references.
%C A399512 Since a(1) = 89*2^k with k = 1, the next power of two in the sequence is expected to be 2^pi(1) where pi(1) = 1 is the first decimal of Pi. (Similarly, in A399511 with A399511(1) = 89*2^0, the next power of two is A399511(776) = 8 = 2^3, corresponding to the Oth decimal, i.e., the integer part of Pi.) However, at iteration n = 10^8, the exponent of 11 is 24737007 and still increasing, so the number 2 is still far from appearing.
%H A399512 M. F. Hasler, <a href="/A399512/b399512.txt">Table of n, a(n) for n = 0..1000</a>
%F A399512 a(n+1) = A395539(a(n)) for all n >= 0.
%e A399512 a(0) = 2 is the initial value, then a(1) = A395539(2) = 178 is the result from applying Conway's PIGAME function to this initial value.
%e A399512 The next value is obtained as a(2) = A395539(a(1)) = A395539(178) = 1034 = 2 * 11 * 47.
%e A399512 a(10) = 62724375 = 3^5 * 5^4 * 7 * 59,
%e A399512 a(100) = 897231423294460773468017578125 = 3^7 * 5^23 * 7^4 * 11^5 * 89,
%e A399512 a(1000) = 3^4 * 5^230 * 7^10 * 11^22 * 89,
%e A399512 a(10^4) = 3 * 5^1091 * 7^16 * 11^953 * 89,
%e A399512 a(10^5) = 2^917 * 3 * 5^7271 * 7^17 * 11^17293 * 71,
%e A399512 a(10^6) = 3^139737 * 5^8187 * 7^8187 * 11^24023 * 37,
%e A399512 a(10^7) = 2^5328 * 3^163760 * 5^2859 * 7^7913 * 11^2240379 * 29,
%e A399512 a(10^8+1) = 2^4080 * 3^163760 * 5^4107 * 7^5165 * 11^24737007 * 71.
%t A399512 pigame = {365/46, 29/161, 79/575, 679/451, 3159/413, 83/407, 473/371, 638/355, 434/335, 89/235, 17/209, 79/122, 31/183, 41/115, 517/89, 111/83, 305/79, 23/73, 73/71, 61/67, 37/61, 19/59, 89/57, 41/53, 833/47, 53/43, 86/41, 13/38, 23/37, 67/31, 71/29, 83/19, 475/17, 59/13, 41/291, 1/7, 1/11, 1/1024, 1/97, 89};
%t A399512 NestList[SelectFirst[#*pigame, IntegerQ] &, 2, 50] (* _Paolo Xausa_, Sep 20 2026 *)
%o A399512 (PARI) A399512_upto(N, a=2)=vector(N+1, i, a=if(i>1, A395539(a), a)) \\ Use optional arg 'a' to compute the trajectory of a different initial value.
%o A399512 (Python)
%o A399512 A399512=lambda upto=99:[(t:=A395539(t)if i else 2)for i in range(upto)]
%Y A399512 Cf. A395539 (definition of the PIGAME successor function), A399511 - A399514 (trajectory of 1, 2 (this), 3 and 4).
%K A399512 nonn,easy,new
%O A399512 0,1
%A A399512 _M. F. Hasler_, Sep 11 2026
