%I A399028 #23 Sep 21 2026 00:58:20
%S A399028 2,3,7,13,19,31,37,73,109,139,157,163,307,331,337,349,367,547,727,733,
%T A399028 751,1009,1021,1051,1063,1087,1093,1153,1201,1231,1321,1399,1423,1447,
%U A399028 1453,1483,1489,1543,1579,1597,1627,1663,1669,1693,1723,1753
%N A399028 Primes p such that (p + reversal of p) - 1 is prime.
%C A399028 If p > 3, then p == 1 (mod 3).
%H A399028 Vincenzo Librandi, <a href="/A399028/b399028.txt">Table of n, a(n) for n = 1..10000</a>
%e A399028 13 is in the sequence because 13+31-1 = 43 is prime.
%e A399028 37 is in the sequence because 37+73-1 = 109 is prime.
%p A399028 R:= n-> (s-> parse(cat(s[-i]$i=1..length(s))))(""||n):
%p A399028 q:= p-> andmap(isprime, [p, p+R(p)-1]):
%p A399028 select(q, [$2..2000])[];  # _Alois P. Heinz_, Sep 17 2026
%t A399028 Select[Prime[Range[10^3]],PrimeQ[#+IntegerReverse[#]-1]&]
%o A399028 (Magma) [NthPrime(n): n in [1..400]|IsPrime(NthPrime(n)+Seqint(Reverse(Intseq(NthPrime(n))))-1) ];
%o A399028 (PARI) isok(p) = isprime(p) && isprime(p + fromdigits(Vecrev(digits(p))) - 1); \\ _Amiram Eldar_, Sep 18 2026
%o A399028 (Python)
%o A399028 from sympy import isprime
%o A399028 def ok(n): return isprime(n) and isprime(n + int(str(n)[::-1]) - 1)
%o A399028 print([k for k in range(2000) if ok(k)]) # _Michael S. Branicky_, Sep 18 2026
