%I A399188 #24 Sep 09 2026 01:04:43
%S A399188 4,9,24,25,30,40,42,49,54,56,66,70,78,88,102,104,105,110,114,121,128,
%T A399188 130,135,136,138,152,154,165,169,170,174,182,184,186,189,190,195,222,
%U A399188 230,231,232,238,246,248,250,255,258,266,273,282,285,286,289,290,296,297,310,318
%N A399188 Numbers x such that recursion {x -> A000005(x)+1} reaches a fixed-point of 4 rather than 3.
%C A399188 A001248 (squares of primes) is a subsequence: for n in A001248, tau(n)=3, that is, n has 3 divisors, namely 1, p, n, and the recursion is n->4->4->4...
%H A399188 Robert Israel, <a href="/A399188/b399188.txt">Table of n, a(n) for n = 1..10000</a>
%e A399188 22 has 4 divisors, namely 1, 2, 11, 22, so the recursion is 22->5->3->3->3... and therefore 22 is not a term.
%e A399188 24 has 8 divisors, namely 1, 2, 3, 4, 6, 8, 12, 24, the recursion is 24->9->4->4->4... and therefore 24 is a term.
%p A399188 f:= proc(x) option remember;
%p A399188   procname(NumberTheory:-tau(x)+1)
%p A399188 end proc:
%p A399188 f(4):= true:
%p A399188 f(3):= false:
%p A399188 select(f, [$4..100]); # _Robert Israel_, Sep 08 2026
%t A399188 q[k_] := FixedPoint[DivisorSigma[0, #] + 1 &, k] == 4; Select[Range[320], q] (* _Amiram Eldar_, Aug 31 2026 *)
%Y A399188 Cf. A000005, A001248, A139588, A060937.
%K A399188 nonn,new
%O A399188 1,1
