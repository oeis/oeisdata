%N A399584 Number of unordered pairs of distinct nonzero integer vectors u,v in R^3 with components bounded by [-n,n] such that u and v are orthogonal.
%F A399584 a(n) = (m + 1)/2 - (2*n+1)^3, where m = [x^0] (Sum_{i=-n..n} Sum_{j=-n..n} x^(i*j))^3. - _Andrew Howroyd_, Sep 07 2026
%o A399584 (Python)
%o A399584 def a(n):
%o A399584   vectors = []
%o A399584   for x in range(-n, n+1):
%o A399584     for y in range(-n, n+1):
%o A399584       for z in range(-n, n+1):
%o A399584         if x != 0 or y != 0 or z != 0:
%o A399584           vectors.append((x, y, z))
%o A399584   pairs = 0
%o A399584   for i in range(len(vectors)):
%o A399584     u = vectors[i]
%o A399584     for j in range(i+1, len(vectors)):
%o A399584       v = vectors[j]
%o A399584       if u[0] * v[0] + u[1] * v[1] + u[2] * v[2] == 0:
%o A399584         pairs += 1
%o A399584   return pairs
%o A399584 (PARI) a(n) = my(p=sum(i=-n, n, sum(j=-n, n, x^(i*j)))); (polcoef(p^3,0) + 1)/2 - (2*n+1)^3 \\ _Andrew Howroyd_, Sep 07 2026
