%U A399645 184327560283768776,3474680321545684440,65227923656630212968,1220007886855452283725,22744772724259404484353
%N A399645 Expansion of g^9/(7-6*g)^4, where g = 1+x*g^7 is the g.f. of A002296.
%H A399645 Seiichi Manyama, <a href="/A399645/b399645.txt">Table of n, a(n) for n = 0..799</a>
%F A399645 G.f.: (Sum_{k>=0} binomial(7*k+5,k) * x^k) * (Sum_{k>=0} binomial(7*k,k) * x^k)^3.
%F A399645 Sum_{k>=1} a(k-1) * x^k/k^2 = (1/12) * log( Sum_{k>=0} binomial(7*k+5,k) * x^k ).
%F A399645 a(n) = ((n+1)/2) * (binomial(7*n+6,n) + Sum_{k=0..n} 6^(n-k) * binomial(7*n+7,k)).
%F A399645 a(n) = ((n+1)/14) * Sum_{k=0..n+1} 6^(n+1-k) * binomial(7*n+8,k).
%F A399645 a(n) = Sum_{k=0..n} 6^k * binomial(k+2,2) * binomial(7*n+8,n-k).
%o A399645 (PARI) a(n) = (n+1)*(binomial(7*n+6, n)+sum(k=0, n, 6^(n-k)*binomial(7*n+7, k)))/2;
%Y A399645 Cf. A399641, A399642, A399643, A399644.
%Y A399645 Cf. A002296, A395667.
