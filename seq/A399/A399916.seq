%S A399916 0,1,4,5,20,21,108,109,112,113,680,681,4848,4849,4852,4853,4868,4869,
%T A399916 39276,39277,39280,39281,355928,355929,356016,356017,356020,356021,
%U A399916 356036,356037,3575724,3575725,3575728,3575729,39454616,39454617,39455184,39455185
%N A399916 The factorial base expansion of a(n) corresponds to the winning position in Tchoukaillon (or Mancala) solitaire for n stones.
%H A399916 Rémy Sigrist, <a href="/A399916/b399916.txt">Table of n, a(n) for n = 0..10000</a>
%F A399916 A034968(a(n)) = n.
%F A399916 A084558(a(n)) = A082447(n) for n > 0.
%e A399916 The first terms, alongside their factorial base expansion, are:
%e A399916   n   a(n)   fact(a(n))
%e A399916   --  -----  ----------
%e A399916    0      0           0
%e A399916    1      1           1
%e A399916    2      4          20
%e A399916    3      5          21
%e A399916    4     20         310
%e A399916    5     21         311
%e A399916    6    108        4200
%e A399916    7    109        4201
%e A399916    8    112        4220
%e A399916    9    113        4221
%e A399916   10    680       53110
%e A399916   11    681       53111
%e A399916   12   4848      642000
%e A399916   13   4849      642001
%e A399916   14   4852      642020
%e A399916   15   4853      642021
%e A399916   16   4868      642310
%e A399916   17   4869      642311
%e A399916   18  39276     7531200
%o A399916 (PARI) a(n) = { my (v = 0, d); for (k = 1, oo, if (n, n -= d = n % (k+1); v += d * k!, return (v););); }
%Y A399916 Cf. A028931, A028932, A028933, A034968, A082447, A084558.
%K A399916 nonn,base,new
