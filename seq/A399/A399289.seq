%F A399289 a(n) mod 2 = A011656(n-1) for n>=3.
%e A399289 a(3) = 5: 123, 132, 213, 231, 312.
%e A399289 a(4) = 16: 1243, 1324, 1342, 1423, 2134, 2143, 2314, 2341, 2413, 3124, 3142, 3241, 3412, 4123, 4132, 4231.
%e A399289 a(5) = 61: 12435, 12534, 13245, 13254, 13425, ..., 51423, 52314, 52341, 52413, 53412.
%p A399289 b:= proc(u, o, l, h) option remember; `if`(u+o=0, 1,
%p A399289      `if`(l=2, 0, add(b(u-j, o+j-1, l+1, 1), j=1..u))+
%p A399289      `if`(h=3, 0, add(b(u+j-1, o-j, 1, h+1), j=1..o)))
%p A399289     end:
%p A399289 a:= n-> `if`(n=0, 1, add(b(j-1, n-j, 1$2), j=1..n)):
%p A399289 seq(a(n), n=0..23);
