%S A399132 1,0,1,0,1,2,0,1,3,5,0,1,4,10,15,0,1,5,16,37,52,0,1,6,23,68,151,203,0,
%T A399132 1,7,31,109,311,674,877,0,1,8,40,161,546,1530,3263,4140,0,1,9,50,225,
%U A399132 871,2906,8065,17007,21147,0,1,10,61,302,1302,4957,16423,45344,94828,115975
%N A399132 Square array T(n,k), n >= 0, k >= 0, read by antidiagonals: T(n,k) = Sum_{j=0..n} Stirling2(n,j) * binomial(k+j-1, j-1), where Stirling2 are the Stirling numbers of the second kind (A008277).
%C A399132 This array provides the weights for the finite convolution that decomposes multiplicative partitions of numbers of the form 2^k * p_1 * ... * p_n (where p_i are distinct odd primes) into additive partitions.
%C A399132 The row generating function F_n(y) = Sum_{k>=0} T(n,k)*y^k is given by the n-th Bell (or Touchard) polynomial B_n(u) evaluated at u = 1/(1-y): F_n(y) = Sum_{j=0..n} Stirling2(n,j) * (1-y)^(-j).
%C A399132 Row n = 1 gives A000012.
%C A399132 Row n = 2 gives A000027(k+2).
%C A399132 Row n = 3 gives (k^2 + 9*k + 10)/2.
%C A399132 Column k = 0 gives the Bell numbers A000110(n).
%C A399132 Column k = 1 gives A005493(n).
%C A399132 Column k = 2 gives A059606(n).
%D A399132 L. Comtet, Advanced Combinatorics, Reidel, 1974, p. 37 and p. 206.
%H A399132 Jishnu Babu Ranitha, <a href="/A399132/b399132.txt">Table of n, a(n) for n = 0..10010</a>
%F A399132 T(n,k) = Sum_{j=0..n} A008277(n,j) * binomial(k+j-1, j-1).
%F A399132 E.g.f.: Sum_{n>=0, k>=0} T(n,k) * (x^n/n!) * y^k = exp((exp(x) - 1)/(1 - y)).
%e A399132 Square array T(n,k) begins:
%e A399132   n\k |   0    1    2    3    4    5     6
%e A399132   ----+-----------------------------------
%e A399132     0 |   1    0    0    0    0    0     0
%e A399132     1 |   1    1    1    1    1    1     1
%e A399132     2 |   2    3    4    5    6    7     8
%e A399132     3 |   5   10   16   23   31   40    50
%e A399132     4 |  15   37   68  109  161  225   302
%e A399132     5 |  52  151  311  546  871 1302  1856
%e A399132     6 | 203  674 1530 2906 4957 7859 11810
%e A399132     ...
%t A399132 T[n_, k_] := If[n == 0 && k == 0, 1, Sum[StirlingS2[n, j] * Binomial[k + j - 1, j - 1], {j, 1, n}]];
%t A399132 Flatten[Table[T[n, s - n], {s, 0, 10}, {n, 0, s}]]
%o A399132 (Python)
%o A399132 from math import comb
%o A399132 from sympy.functions.combinatorial.numbers import stirling
%o A399132 def T(n, k):
%o A399132     if n == 0: return 1 if k == 0 else 0
%o A399132     return sum(stirling(n, j) * comb(k + j - 1, j - 1) for j in range(1, n + 1))
%o A399132 print([T(n, s - n) for s in range(11) for n in range(s + 1)])
%Y A399132 Cf. A000007 (row 0), A000012 (row 1), A000027 (row 2), A000110 (col 0), A005493 (col 1), A059606 (col 2), A008277.
%Y A399132 Main diagonal gives A245110.
%Y A399132 Cf. A000041, A001055, A059604, A059605.
