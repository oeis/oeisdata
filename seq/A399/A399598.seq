%t A399598 f[i_Integer, m_Integer : 1] :=
%t A399598   If[i == 0, 1,
%t A399598     Module[{j}, j = 1;
%t A399598       While[Log[Prime[j], Prime[i + j - 1]] > (m + 1)/(m), j++];
%t A399598       Times @@ #*Last[#]^m &@ Prime@ Range[j, i + j - 1] ] ];
%t A399598 nn = 7; Table[f[#, m] &[n - m + 1], {n, nn}, {m, n}]
