%I A399925 #10 Sep 16 2026 12:49:32
%S A399925 2,6,8,9,10,14,18,22,24,25,26,27,30,32,34,36,38,40,42,45,46,49,50,54,
%T A399925 56,58,62,63,66,70,72,74,75,78,82,86,88,90,94,96,98,99,100,102,104,
%U A399925 106,108,110,114,117,118,120,121,122,125,126,128,130,134,135,136,138
%N A399925 Numbers k such that A007429(k) is even.
%C A399925 Numbers k such that either v(k,2) is odd or v(k,p) == 2, 3 (mod 4) for some odd prime p, where v(k,p) is the p-adic valuation of k.
%C A399925 In general, for m >= 2, let f(m,.) be the m-th inverse Moebius transform of natural numbers (so that f(m,.) has Dirichlet g.f. zeta(s-1)*zeta^m(s)), then f(m,k) is even if and only if either v(k,2) mod 2^(m-1) >= 2^(m-2) or v(k,p) mod 2^m >= 2^(m-1) for some odd prime p.
%H A399925 Jianing Song, <a href="/A399925/b399925.txt">Table of n, a(n) for n = 1..10000</a>
%t A399925 A399925Q[k_] := EvenQ[DivisorSum[k, DivisorSigma[1, #] &]];
%t A399925 Select[Range[150], A399925Q] (* _Paolo Xausa_, Sep 16 2026 *)
%o A399925 (PARI) iseven(n,{m=2}) = {
%o A399925 if(valuation(n,2) % 2^(m-1) >= 2^(m-2), return(1));
%o A399925 my(f=factor(n)); for(j=1, #f[, 1], my(p=f[j, 1], e=f[j, 2]); if(p>2 && valuation(n,p) % 2^m >= 2^(m-1), return(1)));
%o A399925 return(0);
%o A399925 }
%Y A399925 Cf. A007429, A399924 (complement).
%K A399925 nonn,new
%O A399925 1,1
%A A399925 _Jianing Song_, Sep 16 2026
