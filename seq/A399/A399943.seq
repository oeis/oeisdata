%N A399943 Number of endofunctions on [n] having at least two isolated fixed points.
%F A399943 a(n) = A350134(n) - A348590(n).
%F A399943 E.g.f.: (1-(1+x)*exp(-x))/(1+LambertW(-x)).
%F A399943 a(n) = n^n - abs(A069856(n)) - n*abs(A069856(n-1)), for n > 0.
%F A399943 a(n) = Sum_{j=2..n} (-1)^j*(j-1)*binomial(n,j)*(n-j)^(n-j).
%F A399943 a(n) = Sum_{k=2..n} A350212(n,k).
%F A399943 Limit_{n->oo} a(n) / n^n = 1-(1+1/e)*exp(-1/e).
%p A399943 a := (1-(1+x)*exp(-x))/(1+LambertW(-x)):
%p A399943 ser := series(a, x = 0, 21): seq(n!*coeff(ser, x, n), n = 0 .. 20);
%o A399943 (Python)
%o A399943 from math import comb
%o A399943 def a(n):
%o A399943     return sum((-1)**j*(j-1)*comb(n,j)*(n-j)**(n-j) for j in range(2, n+1))
%o A399943 print([a(n) for n in range(21)])
%Y A399943 Column k=1 of triangle A350079.
