%e A399008   1, 16, 400, 4704, 29472, 94080, 141312, 80640, 10176;
%e A399008   ...
%o A399008 (PARI)
%o A399008 B(n,k) = binomial(n,k)^2*k!
%o A399008 R2(n,k) = if(k%2>n%2, 0, my(t=k\2); binomial(n\2,t)^2*2^t*t!)
%o A399008 V(n,k) = if(k==1 && n%2==1, n, k==0)
%o A399008 T(n,k) = (B(n,k) + R2(n,k) + 2*V(n,k))/4
