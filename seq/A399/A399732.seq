%S A399732 1,3,4,5,6,12,8,8,10,18,12,20,14,24,24,16,18,30,20,30,32,36,24,32,26,
%T A399732 42,27,40,30,72,32,32,48,54,48,50,38,60,56,48,42,96,44,60,60,72,48,64,
%U A399732 50,78,72,70,54,81,72,64,80,90,60,120,62,96,80,64,84,144,68,90,96
%N A399732 The sum of the unitary divisors d of n such that n/d is cubefree.
%C A399732 The number of these divisors is A365498(n).
%C A399732 The sum of the complementary divisors is A371242(n).
%H A399732 Amiram Eldar, <a href="/A399732/b399732.txt">Table of n, a(n) for n = 1..10000</a>
%F A399732 a(n) = Sum_{d | n, gcd(d, n/d) = 1, A212793(n/d) = 1} d.
%F A399732 a(n) = n * A034448(n) / A399734(n).
%F A399732 Multiplicative with a(p^e) = p^e + 1 for e <= 2, and a(p^e) = p^e for e >= 3.
%F A399732 Dirichlet g.f.: zeta(s-1) * Product_{p prime} (1 + 1/p^s - 1/p^(2*s-1) + 1/p^(2*s) - 1/p^(3*s-1)).
%F A399732 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = Product_{p prime} (1 + 1/p^2 - 1/p^3 + 1/p^4 - 1/p^5) = 1.35484579436391186184... .
%t A399732 f[p_, e_] := p^e + If[e < 3, 1, 0]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A399732 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, f[i,1]^f[i,2] + (f[i,2] < 3));}
%Y A399732 Cf. A004709, A034448, A212793, A254981 (analogous with all divisors), A365498, A371242.
%Y A399732 The sum of the unitary divisors d of n such that n/d is: A363289 (squarefree), this sequence (cubefree), A399733 (powerful), A399734 (cubefull), A399735 (square), A399736 (exponentially odd), A399737 (cube), A399738 (odd), A399739 (power of 2), A399740 (perfect power).
%K A399732 nonn,mult,easy,new
%O A399732 1,2
