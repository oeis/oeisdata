%S A399163 0,1,0,1,1,0,0,1,1,2,1,0,0,0,1,0,0,1,1,3,1,2,3,0,0,1,1,2,1,2,1,2,2,0,
%T A399163 2,1,0,0,0,2,0,4,1,2,0,0,1,2,0,0,1,1,1,1,1,1,3,0,1,0,1,0,2,2,0,2,0,1,
%U A399163 0,0,2,0,1,1,1,1,1,2,0,0,1,0,0,1,0,0,1,2
%N A399163 Number of roots modulo the n-th prime of x^6+2*x^5+2*x^4+2*x^3+x^2+1.
%C A399163 The polynomial is not chosen arbitrarily. Let f_c(x)=x^2+c and let a_0(c)=0, a_{k+1}(c)=a_k(c)^2+c. The condition that the critical point 0 has preperiod 2 and period 3 is a_5(c)=a_2(c), with the lower preperiod/period cases removed. The exact factorization is
%C A399163 a_5(c)-a_2(c)=c^3*(c+2)*(c^3+2*c^2+c+1)^2*(c^6+2*c^5+2*c^4+2*c^3+c^2+1).
%C A399163 Thus H(c)=c^6+2*c^5+2*c^4+2*c^3+c^2+1 is the natural (2,3)-Misiurewicz polynomial for the quadratic family. The sequence counts the roots of this canonical polynomial modulo the n-th prime.
%F A399163 a(n) = #{x mod p_n : x^6+2*x^5+2*x^4+2*x^3+x^2+1 == 0 mod p_n}, where p_n is the n-th prime.
%e A399163 For n=10, p_n=29. Modulo 29, the polynomial has 2 roots, so a(10)=2.
%e A399163 For n=20, p_n=71. Modulo 71, the polynomial has 3 roots, so a(20)=3.
%t A399163 H[x_] := x^6 + 2*x^5 + 2*x^4 + 2*x^3 + x^2 + 1;
%t A399163 a[n_] := Length[x /. Solve[H[x] == 0, x, Modulus -> Prime[n]]];
%t A399163 Table[a[n], {n, 1, 88}]
%o A399163 (PARI) H = x^6 + 2*x^5 + 2*x^4 + 2*x^3 + x^2 + 1;
%o A399163 a(n) = {
%o A399163   my(p = prime(n), F = factor(Mod(H, p)));
%o A399163   sum(i = 1, matsize(F)[1], if(poldegree(F[i, 1]) == 1, 1, 0))
%o A399163 }
%K A399163 nonn,new
%O A399163 1,10
%A A399163 _Göktuğ Omay_, Aug 20 2026
