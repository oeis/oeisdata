%I A399864 #5 Oct 03 2026 00:01:55
%S A399864 6,12,15,21,24,35,45,48,55,63,65,75,77,85,91,95,96,115,119,133,135,
%T A399864 143,161,175,187,189,192,203,209,217,221,225,245,247,253,259,275,287,
%U A399864 299,301,319,323,325,329,341,377,384,385,391,403,405,407,425,437,451,455
%N A399864 Numbers k in A024619 such that A376846(k) = 0.
%C A399864 Numbers k in A024619 such that there exist no m <= k such that rad(m) | k and Omega(m) > Omega(k), where rad = A007947 and Omega = A001222.
%C A399864 Union of A377713, A377590, and A377591.
%H A399864 Michael De Vlieger, <a href="/A399864/b399864.txt">Table of n, a(n) for n = 1..10000</a>
%e A399864 6 is in the sequence since all m in row 6 of A162306 are such that Omega(m) <= Omega(6).
%e A399864 10 is not in the sequence because 8 is such that rad(8) | 10, 8 < 10, yet Omega(8) > Omega(10).
%e A399864 a(2) = 12 because all m in row 12 of A162306 are such that Omega(m) <= Omega(12).
%e A399864 18 is not in the sequence because 16 is such that rad(16) | 18, 16 < 18, yet Omega(16) > Omega(18).
%e A399864 20 is not a term because Omega(16) > Omega(20).
%e A399864 36 is not a term because Omega(32) > Omega(30).
%e A399864 225 is a term since all m in row 225 of A162306 have fewer prime divisors with multiplicity than does 225, etc.
%t A399864 Select[Select[Range[2, 500], Not @* PrimePowerQ], Function[{n, k}, NoneTrue[FactorInteger[n][[All, 1]], Floor@ Log[#, n] > k &]] @@ {#, PrimeOmega[#] } &]
%Y A399864 Cf. A162306, A376846, A377590, A377591, A377713.
%K A399864 nonn,easy,new
%O A399864 1,1
%A A399864 _Michael De Vlieger_, Sep 27 2026
