%t A399252 x = -1 + Sqrt[5]; n1 = 15; k1 = 12;
%t A399252 r[n_, k_] := Floor[k*x^n]; t = Table[r[n, k], {n, 1, n1}, {k, 1, k1}];
%t A399252 TableForm[t]
%t A399252 Table[r[n - k + 1, k], {n, 12}, {k, n, 1, -1}] // Flatten
