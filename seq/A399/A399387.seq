%I A399387 #4 Sep 02 2026 17:29:25
%S A399387 1,2,2,4,16,120,1624,36208,1334784,83384360,9058939456,1749514680352,
%T A399387 610669589659144,390041378500599456
%N A399387 Number of nonisomorphic undirected graphs with loops allowed on n vertices having trivial automorphism group.
%C A399387 Equivalently, a(n) is the number of nonisomorphic symmetric binary relations on an n-element set having trivial automorphism group.
%F A399387 a(n) = (1/n!)*Sum_{H <= S_n} mu({1},H)*2^(o_1(H)+o_2(H)), where mu is the Möbius function of the subgroup lattice of S_n, o_1(H) is the number of H-orbits on [n], and o_2(H) is the number of H-orbits on the 2-element subsets of [n].
%e A399387 For n=2, the two vertices must have different loop status in order to destroy the transposition symmetry. The edge between them may be absent or present, giving a(2)=2.
%o A399387 (GAP)
%o A399387 LoadPackage("tomlib");
%o A399387 a := function(n)
%o A399387 local tom, pairs, fix, i, H, o1, o2, dec, triv;
%o A399387   tom := TableOfMarks(Concatenation("S", String(n)));
%o A399387   pairs := Combinations([1..n], 2);
%o A399387   fix := [];
%o A399387   for i in [1..Length(OrdersTom(tom))] do
%o A399387     H := RepresentativeTom(tom, i);
%o A399387     o1 := Length(OrbitsDomain(H, [1..n], OnPoints));
%o A399387     o2 := Length(OrbitsDomain(H, pairs, OnSets));
%o A399387     Add(fix, 2^(o1 + o2));
%o A399387   od;
%o A399387   dec := DecomposedFixedPointVector(tom, fix);
%o A399387   triv := Position(OrdersTom(tom), 1);
%o A399387   return dec[triv];
%o A399387 end;
%o A399387 List([4..13], a);
%Y A399387 Cf. A003400 (asymmetric simple graphs), A030242 (asymmetric binary relations), and A051504 (asymmetric loopless digraphs).
%K A399387 nonn,hard,more,new
%O A399387 0,2
%A A399387 _Vladeta Jovovic_, Aug 27 2026
