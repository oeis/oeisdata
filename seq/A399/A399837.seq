%I A399837 #9 Sep 17 2026 08:55:59
%S A399837 1,3,4,7,6,12,8,15,13,18,12,28,14,24,24,27,18,39,20,42,32,36,24,60,31,
%T A399837 42,40,56,30,72,32,63,48,54,48,91,38,60,56,90,42,96,44,84,78,72,48,
%U A399837 108,57,93,72,98,54,120,72,120,80,90,60,168,62,96,104,127,84,144,68,126
%N A399837 The sum of divisors d of n such that gcud(d, n/d) is an exponentially odd number (A268335), where gcud is the greatest common unitary divisor.
%C A399837 First differs from A365170 and A365174 at n = 32, and from A399834 at n = 64.
%C A399837 The number of these divisors is A399831(n).
%H A399837 Amiram Eldar, <a href="/A399837/b399837.txt">Table of n, a(n) for n = 1..10000</a>
%F A399837 Multiplicative with a(p^e) = (p^(e+1) - 1)/(p - 1) - p^(e/2) if e is a multiple of 4, and (p^(e+1) - 1)/(p - 1) otherwise.
%F A399837 Dirichlet g.f.: zeta(s-1) * zeta(s) * zeta(4*s-2) * Product_{p prime} (1 - 2/p^(4*s-2) + 1/p^(5*s-3) + 1/p^(5*s-2) - 1/p^(6*s-3)).
%F A399837 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = zeta(6) * Product_{p prime} (1 + 1/p^2 + 1/p^4 - 1/p^6 + 1/p^7) = 1.63371856010147615175... .
%t A399837 f[p_, e_] := (p^(e+1) - 1)/(p - 1) - If[Mod[e, 4] == 0, p^(e/2), 0]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A399837 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, (f[i,1]^(f[i,2]+1)-1)/(f[i,1]-1) - if(!(f[i,2] % 4), f[i,1]^(f[i,2]/2)));}
%Y A399837 Cf. A268335, A013664, A077610, A165430, A225174, A384244.
%Y A399837 Cf. A365174 (analogous with gcd), A365170, A399831.
%Y A399837 The sum of divisors d of n such that gcud(d, n/d) is: A188999 (1), A399834 (squarefree), A399835 (powerful), A399836 (square), this sequence (exponentially odd), A399838 (odd), A399839 (power of 2).
%K A399837 nonn,mult,easy,new
%O A399837 1,2
