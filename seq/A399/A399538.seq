%N A399538 G.f. A(x) satisfies: A(x) = x * (1 + A(2*x)) / (1 - x^3).
%F A399538 a(n) = n for n < 3; a(n) = 2^(n-1) * a(n-1) + a(n-3).
%t A399538 nmax = 17; A[_] = 1; Do[A[x_] = x (1 + A[2 x])/(1 - x^3) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A399538 (* Alternative: *)
%t A399538 a[0] = 0; a[1] = 1; a[2] = 2; a[n_] := a[n] = 2^(n - 1) a[n - 1] + a[n - 3]; Table[a[n], {n, 0, 17}]
