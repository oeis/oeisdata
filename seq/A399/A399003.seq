%I A399003 #11 Aug 21 2026 22:01:53
%S A399003 2,5,173,1549,176327,19578107,42385331077
%N A399003 a(n) is the least prime p such that p^2 is the concatenation of two primes in exactly n different ways.
%H A399003 Carlos Rivera, <a href="https://t5k.org/curios/page.php?short=54218443">Prime Curios! 54218443</a>.
%e A399003 Let | denote concatenation.
%e A399003 a(0) = 2 since 2^2 = 4 is not the concatenation of two primes.
%e A399003 a(1) = 5 since 5^2 = 25 = 2|5, with 2 and 5 prime.
%e A399003 a(2) = 173 since 173^2 = 29929 = 2|9929 = 29|929.
%e A399003 a(3) = 1549 since 1549^2 = 2399401 = 2|399401 = 23|99401 = 2399|401.
%e A399003 a(4) = 176327 since 176327^2 = 31091210929 = 3|1091210929 = 31091|210929 = 3109121|929 = 310912109|29.
%t A399003 f[n_]:=Block[{c=0,id=IntegerDigits@(n^2),k=0},While[k<Length@id,If[Union@PrimeQ[FromDigits@#&/@{id[[;;k+1]],id[[k+2;;]]}]=={True},c++];k++];c];t=Table[0,{10}];Do[a=f@p;If[t[[a]]==0,t[[a]]=p;Print[{a,p}]],{p,Prime@Range@(10^8)}]
%o A399003 (Python)
%o A399003 from gmpy2 import is_prime, next_prime
%o A399003 from itertools import islice
%o A399003 def f(n):
%o A399003     c, pow10 = 0, 10
%o A399003     while True:
%o A399003         (q, r), pow10 = divmod(n, pow10), pow10*10
%o A399003         if q == 0: return c
%o A399003         if is_prime(q) and is_prime(r): c += 1
%o A399003 def agen(): # generator of terms
%o A399003     adict, pm, n = dict(), 1, 0
%o A399003     while True:
%o A399003         pm = next_prime(pm)
%o A399003         v = f(pm*pm)
%o A399003         if v not in adict:
%o A399003             adict[v] = int(pm)
%o A399003             while n in adict: yield adict[n]; n += 1
%o A399003 print(list(islice(agen(), 6))) # _Michael S. Branicky_, Aug 16 2026
%Y A399003 Cf. A106582, A173935, A213072.
%K A399003 nonn,base,more,new
%O A399003 0,1
%A A399003 _Zhining Yang_, Aug 16 2026
%E A399003 a(6) from _Michael S. Branicky_, Aug 16 2026
