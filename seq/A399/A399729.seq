%I A399729 #10 Sep 15 2026 19:35:32
%S A399729 1,2,6,29,134,1115,7446,81649,794832,10359982,112018791,2135510581
%N A399729 Number of 2-closed subgroups of the symmetric group S_n, counting conjugates as distinct.
%C A399729 Two subgroups of S_n have the same 2-closure iff they have the same orbitals on [n]^2. Thus a(n) is also the number of distinct orbital partitions of [n]^2 induced by subgroups of S_n, or equivalently the number of Galois-closed subalgebras of Re(n), the relation algebra of all binary relations over [n].
%o A399729 (SageMath)
%o A399729 def orbitals(H, n):
%o A399729     X = [(i, j) for i in range(1, n + 1) for j in range(1, n + 1)]
%o A399729     unseen = set(X)
%o A399729     orbs = []
%o A399729     while unseen:
%o A399729         x = next(iter(unseen))
%o A399729         orb = {(g(x[0]), g(x[1])) for g in H}
%o A399729         orbs.append(frozenset(orb))
%o A399729         unseen -= orb
%o A399729     return frozenset(orbs)
%o A399729 def number_of_2_closed_subgroups(n):
%o A399729     G = SymmetricGroup(n)
%o A399729     return len({orbitals(H, n) for H in G.subgroups()})
%Y A399729 Cf. A005432.
%K A399729 nonn,hard,more,new
%O A399729 1,2
