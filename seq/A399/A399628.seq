%S A399628 0,1,10,305,23716,4486037,1994453154,2034446228033,4678268746648936,
%T A399628 23929420811208066245,269409598455817372214806,
%U A399628 6619395149663001721158805169,352426544368984810524247374025932,40416629036701314158262394995972638549
%N A399628 Number of finite ordered sequences of nonsingleton subsets of an n-set such that the successive unions strictly increase and the final union is the full set.
%C A399628 Let [n] = {1,...,n}. The objects counted are finite ordered sequences (S_1,...,S_m), with |S_i| >= 2, such that each successive union is a proper subset of the next one and S_1 union ... union S_m = [n]. Equivalently, each successive subset must introduce at least one element not contained in the union of the preceding subsets, and after the last step every element of [n] has appeared. The recurrence in the Formula section follows by conditioning on the number d of previously unseen elements introduced at the next step.
%F A399628 a(n) = F_n(0) where F_n(n) = 1 and, for 0 <= r < n, F_n(r) = Sum_{d=1..n-r} binomial(n-r,d)*b(r,d)*F_n(r+d) with b(r,1) = 2^r - 1 and b(r,d) = 2^r for d >= 2.
%e A399628 For n = 1, a(1) = 0, since an ordered sequence of nonsingleton subsets cannot cover a 1-set.
%e A399628 For n = 2, a(2) = 1: the only sequence is ({1,2}).
%e A399628 For n = 3, a(3) = 10. There is one sequence of length 1, namely ({1,2,3}). The other nine sequences have length 2: the first subset is one of the three 2-subsets, and the second subset contains the remaining element together with either one or both elements already seen, giving 3*3 = 9 possibilities.
%t A399628 a[n_Integer?Positive] := f[n, 0];
%t A399628 f[n_, n_] := 1;
%t A399628 f[n_, r_] := f[n, r] = Sum[Binomial[n - r, d]*If[d == 1, 2^r - 1, 2^r]*f[n, r + d], {d, 1, n - r}];
%t A399628 Table[a[n], {n, 1, 15}]
%o A399628 (Python)
%o A399628 from functools import lru_cache
%o A399628 from math import comb
%o A399628 def a(n):
%o A399628     @lru_cache(None)
%o A399628     def F(r):
%o A399628         if r == n:
%o A399628             return 1
%o A399628         return sum(
%o A399628             comb(n-r, d) *
%o A399628             ((2**r - 1) if d == 1 else 2**r) *
%o A399628             F(r+d)
%o A399628             for d in range(1, n-r+1)
%o A399628         )
%o A399628     return F(0)
%o A399628 print([a(n) for n in range(1, 16)])
%K A399628 nonn,new
%O A399628 1,3
