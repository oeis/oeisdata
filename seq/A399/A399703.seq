%N A399703 a(0) = 1; a(n) = Sum_{k=0..n-1} (-1)^(n-k-1) * binomial(n,k) * k^(k*(n-k)) * a(k).
%F A399703 1 = Sum_{n>=0} a(n) * x^n / (1 + n^n * x)^(n+1).
%F A399703 1 = Sum_{n>=0} a(n) * exp(-n^n*x) * x^n / n!.
%t A399703 Unprotect[Power]; Power[0, 0] = 1; a[0] = 1; a[n_] := a[n] = Sum[(-1)^(n - k - 1) Binomial[n, k] k^(k (n - k)) a[k], {k, 0, n - 1}]; Table[a[n], {n, 0, 12}]
