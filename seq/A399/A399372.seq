%N A399372 a(n) is the smallest prime not dividing A003415(n) [the arithmetic derivative of n], with a(0) = a(1) = 1 by convention.
%H A399372 Antti Karttunen, <a href="/A399372/b399372.txt">Table of n, a(n) for n = 0..10000</a>
%F A399372 a(n) = A020639(A327859(n)).
%F A399372 For n >= 2, a(n) = A053669(A003415(n)).
%F A399372 For n >= 2, a(n) = A000040(1+A393041(n)).
%o A399372 (PARI)
%o A399372 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A399372 A020639(n) = if(1==n,n,vecmin(factor(n)[, 1]));
%o A399372 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A399372 A327859(n) = A276086(A003415(n));
%o A399372 A399372(n) = A020639(A327859(n));
%Y A399372 Cf. A000040, A003415, A020639, A053669, A327859, A393041.
%Y A399372 Cf. A391845 [where a(n) is equal to A020639(n)].
%Y A399372 Cf. A235991 (positions of 2's), A393043 (of 3's), A393045 (of 5's), A393047 (of 7's), A393044, A393046.
%Y A399372 Cf. also A086134, A399374, A399376, A399377.
%K A399372 nonn,easy,new
%O A399372 0,3
