%I A399733 #10 Sep 13 2026 00:36:36
%S A399733 1,2,3,5,5,6,7,9,10,10,11,15,13,14,15,17,17,20,19,25,21,22,23,27,26,
%T A399733 26,28,35,29,30,31,33,33,34,35,50,37,38,39,45,41,42,43,55,50,46,47,51,
%U A399733 50,52,51,65,53,56,55,63,57,58,59,75,61,62,70,65,65,66,67,85,69,70,71,90
%N A399733 The sum of the unitary divisors d of n such that n/d is a powerful number (A001694).
%C A399733 First differs from A399740 at n = 72.
%C A399733 The number of these divisors is A323308(n).
%C A399733 The sum of the complementary divisors is A360720(n).
%H A399733 Amiram Eldar, <a href="/A399733/b399733.txt">Table of n, a(n) for n = 1..10000</a>
%F A399733 a(n) = Sum_{d | n, gcd(d, n/d) = 1, A112526(n/d) = 1} d.
%F A399733 a(n) = n * A034448(n) / A363289(n).
%F A399733 Multiplicative with a(p) = p, and a(p^e) = p^e + 1 for e >= 2.
%F A399733 Dirichlet g.f.: zeta(s-1) * zeta(s) * Product_{p prime} (1 - 1/p^s + 1/p^(2*s) - 1/p^(3*s-1)).
%F A399733 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = zeta(2) * Product_{p prime} (1 - 1/p^2 + 1/p^4 - 1/p^5) = 1.05322502802265001269... .
%t A399733 f[p_, e_] := p^e + If[e == 1, 0, 1]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A399733 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, f[i,1]^f[i,2] + (f[i,2] > 1));}
%Y A399733 Cf. A001694, A013661, A069208 (analogous with all divisors), A077610, A112526, A183097, A323308, A360720.
%Y A399733 The sum of the unitary divisors d of n such that n/d is: A363289 (squarefree), A399732 (cubefree), this sequence (powerful), A399734 (cubefull), A399735 (square), A399736 (exponentially odd), A399737 (cube), A399738 (odd), A399739 (power of 2), A399740 (perfect power).
%K A399733 nonn,mult,easy,new
%O A399733 1,2
%A A399733 _Amiram Eldar_, Sep 10 2026
