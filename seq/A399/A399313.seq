%N A399313 Numbers k = rad(k) * p(k) * q(k) such that A008479(k) = 5, where rad = A007947, p = least prime factor of k, q = second smallest distinct prime factor of k.
%C A399313 Numbers k in A398444 such that A008479(k) is minimum.
%H A399313 Michael De Vlieger, <a href="/A399313/b399313.txt">Table of n, a(n) for n = 1..10000</a>
%e A399313 Let S = {m < n : rad(m) = rad(n)}. Let P(i..j) = Product_{h=i..j} prime(h).
%e A399313 Table of n, a(n) for select n:
%e A399313        n        a(n)                       S(n)
%e A399313   -----------------------------------------------------------------------------
%e A399313        1         36 = 2^2 * 3^2            {6, 12, 18, 24}
%e A399313        2        225 = 3^2 * 5^2            {15, 45, 75, 135}
%e A399313        3        252 = 2^2 * 3^2 * 7        {42, 84, 126, 168}
%e A399313        4        396 = 2^2 * 3^2 * 11       {66, 132, 198, 264}
%e A399313       12       1225 = 5^2 * 7^2            {35, 175, 245, 875}
%e A399313       23       2772 = 2^2 * 3^2 * P(4..5)  {462, 924, 1386, 1848}
%e A399313       51       5929 = 7^2 * 11^2           {77, 539, 847, 3773}
%e A399313      180      20449 = 11^2 * 13^2          {143, 1573, 1859, 17303}
%e A399313      313      36036 = 2^2 * 3^2 * P(4..6)  {6006, 12012, 18018, 24024}
%e A399313      426      48841 = 13^2 * 17^2          {221, 2873, 3757, 37349}
%e A399313      902     104329 = 17^2 * 19^2          {323, 5491, 6137, 93347}
%e A399313     5248     612612 = 2^2 * 3^2 * P(4..7)  {102102, 204204, 306306, 408408}
%e A399313   100102   11639628 = 2^2 * 3^2 * P(4..8)  {1939938, 3879876, 5819814, 7759752}
%t A399313 facs[x_] := facs[x] = FactorInteger[x][[All, 1]]; nn = 5400; Do[Set[r[n], Times @@ facs[n]], {n, nn}]; s = Select[Range[2, nn], Not @* PrimePowerQ]; t = Select[s, #1/Apply[Times, #2] == Times @@ #2[[1 ;; 2]] & @@ {#, facs[#]} &]; Select[t, Function[m, Count[Range[m], _?(r[#] == r[m] &)] == 5]]
%Y A399313 Cf. A007947, A008479, A020639, A119288, A398444.
