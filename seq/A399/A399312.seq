%S A399312 1,1,0,0,1,0,2,1,2,1,8,1,14,3,3,2,41,2,66,3,12,16,165,2,73,34,39,11,
%T A399312 574,5,847,21,115,140,161,7,2573,269,311,21,5170,27,7245,126,143,928,
%U A399312 13959,21,4510,288,1914,376,35717,126,3370,162,4443,5113,87331,34,116600
%N A399312 Number of partitions of n where the smallest part is equal to the number of divisors of n, d(n) = A000005(n).
%C A399312 A000005(n) = n only for n = 1 and n = 2, in which cases a(n) = 1.
%F A399312 a(n) is the number of partitions of n - A000005(n) into parts >= A000005(n).
%F A399312 a(n) = A026807(n-A000005(n),A000005(n)). - _Alois P. Heinz_, Aug 30 2026
%e A399312 a(1) = 1; the only partition of 1 is (1), and its smallest part is 1, which equals numdiv(1).
%e A399312 a(3) = 0; 3 has 2 divisors, and its partitions are (3) and (2,1). Neither has a smallest part equal to 2.
%e A399312 a(7) = 2; 7 has 2 divisors. The partitions of 7 with smallest part 2 are (5,2) and (3,2,2).
%e A399312 a(8) = 1; 8 has 4 divisors. The only partition of 8 with smallest part 4 is (4,4).
%p A399312 b:= proc(n, i) option remember; `if`(n=0, 1,
%p A399312       `if`(n<0 or i>n, 0, b(n, i+1)+b(n-i, i)))
%p A399312     end:
%p A399312 a:= n-> (t-> b(n-t, t))(numtheory[tau](n)):
%p A399312 seq(a(n), n=1..61);  # _Alois P. Heinz_, Aug 30 2026
%o A399312 (PARI) a(n) = my(d=numdiv(n)); if(n<d, 0, my(x='x+O('x^(n-d+1))); polcoeff(1 / prod(k=d, n, 1 - x^k), n-d))
%o A399312 (PARI) a(n) = my(d=numdiv(n), nb=0); forpart(p=n, if (vecmin(p) == d, nb++)); nb; \\ _Michel Marcus_, Aug 30 2026
%Y A399312 Cf. A000005, A000041, A008284, A026807, A398826.
%K A399312 nonn,easy,new
%O A399312 1,7
%A A399312 _Konstantin Mullahmetov_, Aug 26 2026
