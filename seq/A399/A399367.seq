%S A399367 1,2,3,5,8,13,21,30,44,58,79,103,127,157,187,219,251,266,347,419,470,
%T A399367 537,581,607,696,776,861,971,1032,1135,1173,1331,1364,1498,1619,1850,
%U A399367 1985,2226,2368,2473,2697,2801,3011,3293,3508,3689,3894,4117,4440,4552,4749,4887,5096,5604,5798
%N A399367 Greedy sequence of positive integers such that all pairwise sums and all pairwise products of distinct terms are distinct.
%C A399367 a(1) = 1. For n > 1, a(n) is the smallest integer m > a(n-1) such that m + a(i) is distinct from every pairwise sum a(j)+a(k) (1 <= j < k < n), and m * a(i) is distinct from every pairwise product a(j)*a(k) (1 <= j < k < n), for all i < n.
%C A399367 Keeping all pairwise sums distinct is the classical Sidon/B2 condition (cf. A005282); here, all pairwise products are also distinct (the multiplicative Sidon condition of Erdos, 1938). This interaction between additive and multiplicative Sidon structure is an active topic in current research; see the Klurman-Pohoata problem cited in Green's link below, asking whether every large set of integers must contain either a large additive or a large multiplicative Sidon subset.
%H A399367 Paul Erdős, <a href="https://www.renyi.hu/~p_erdos/1938-07.pdf">On sequences of integers no one of which divides the product of two others and on some related problems</a>, Izv. Naut.-Issl. Inst. Mat. Meh. Tomsk 2 (1938), 74-82.
%H A399367 B. Green, <a href="https://people.maths.ox.ac.uk/greenbj/papers/open-problems.pdf">100 Open Problems</a>, p. 19 (Klurman-Pohoata bonus problem).
%e A399367 a(1) through a(7) = 1, 2, 3, 5, 8, 13, 21.
%e A399367 a(8) = 30 because, inspecting candidates starting from 22, we have:
%e A399367   22 is rejected since 22+1=23 duplicates the existing sum 2+21=23;
%e A399367   23 is rejected since 23+1=24 duplicates the existing sum 3+21=24;
%e A399367   24 is rejected since 24*1=24 duplicates the existing product 3*8=24;
%e A399367   25 is rejected since 25+1=26 duplicates the existing sum 5+21=26;
%e A399367   26 is rejected since 26*1=26 duplicates the existing product 2*13=26;
%e A399367   27 is rejected since 27+2=29 duplicates the existing sum 8+21=29;
%e A399367   28 is rejected since 28+1=29 duplicates the existing sum 8+21=29;
%e A399367   29 is rejected since 29+5=34 duplicates the existing sum 13+21=34;
%e A399367   30 is accepted since none of 30+x or 30*x for x in [a(1]..a(7)] matches any existing pairwise sum or product.
%o A399367 (Python)
%o A399367 def is_valid(cand, seq, sums, prods):
%o A399367     for x in seq:
%o A399367         if cand + x in sums or cand * x in prods:
%o A399367             return False
%o A399367     return True
%o A399367 def aupto(n_terms):
%o A399367     seq = [1]
%o A399367     sums = set()
%o A399367     prods = set()
%o A399367     cand = 2
%o A399367     while len(seq) < n_terms:
%o A399367         if is_valid(cand, seq, sums, prods):
%o A399367             for x in seq:
%o A399367                 sums.add(cand + x)
%o A399367                 prods.add(cand * x)
%o A399367             seq.append(cand)
%o A399367         cand += 1
%o A399367     return seq
%o A399367 print(aupto(60))
%Y A399367 Cf. A005282, A066724, A011185.
