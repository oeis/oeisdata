%I A399805 #17 Sep 21 2026 18:42:55
%S A399805 0,1,2,4,5,8,10,15,16,23,30,37,43,46,50,61,64,72,82,85,92,94,124,137,
%T A399805 139,160,161,187,196,200,211,214,236,241,245,263,265,276,282,302,310,
%U A399805 312,334,337,341,350,354,370,376,378,395,402,405,414,456,467,486,490
%N A399805 Starting with a(0)=0, the sequence continues with the smallest integer that cannot be formed by the sum of any tuple of consecutive digits taken from the terms already present.
%C A399805 When referring to a tuple of consecutive digits, one might consider only some of the digits from a single number; for instance, given the sequences 2134, 4562, and 5639, a set of digits could be [3, 4, 4, 5, 6, 2, 5].
%H A399805 Paolo P. Lava, <a href="/A399805/b399805.txt">Table of n, a(n) for n = 0..2000</a>
%e A399805 a(1) = 1 because 1 cannot be formed starting from the initial zero. Numbers to be excluded in the next steps: [0, 1];
%e A399805 a(2) = 2 by the same reason that a(1) = 1. Now, we must exclude 3 (1+2). Numbers to be excluded in the next steps: [0, 1, 2, 3];
%e A399805 a(3) = 4 because 3 is a number to be excluded. Other numbers to be excluded: 6 (2+4), 7 (1+2+4). Numbers to be excluded in the next steps: [0, 1, 2, 3, 4, 6, 7];
%e A399805 a(4) = 5, which is the smallest number we can insert. Numbers to be excluded in the next steps: [0, 1, 2, 3, 4, 5, 6, 7, 9, 11, 12]; etc.
%p A399805 with(numtheory): P:=proc(q) local a,b,c,f,j,k,n,p,v,x; v:=[0]; p:={0}; x:=[0]; a:=0;
%p A399805 for n from 1 to q do a:=a+1; while numboccur(a,p)>0 do a:=a+1; od; x:=[op(x), a];
%p A399805 b:=convert(a, base, 10); for k from 1 to nops(b) do v:=[op(v), b[-k]]; od; c:={};
%p A399805 for k from 1 to nops(b) do f:=v[-k]; for j from nops(v)-k to 1 by -1 do
%p A399805 f:=f+v[j]; c:=c union {f}; od; od; p:=p union c; od; op(x); end: P(100);
%Y A399805 Cf. A033627, A398424.
%K A399805 nonn,base,new
%O A399805 0,3
%A A399805 _Paolo P. Lava_, Sep 12 2026
