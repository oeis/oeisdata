%I A399736 #9 Sep 13 2026 00:36:31
%S A399736 1,3,4,4,6,12,8,9,9,18,12,16,14,24,24,16,18,27,20,24,32,36,24,36,25,
%T A399736 42,28,32,30,72,32,33,48,54,48,36,38,60,56,54,42,96,44,48,54,72,48,64,
%U A399736 49,75,72,56,54,84,72,72,80,90,60,96,62,96,72,64,84,144,68,72,96
%N A399736 The sum of the unitary divisors d of n such that n/d is an exponentially odd number (A268335).
%C A399736 The number of these divisors is A055076(n).
%C A399736 The sum of the complementary divisors is A358346(n).
%H A399736 Amiram Eldar, <a href="/A399736/b399736.txt">Table of n, a(n) for n = 1..10000</a>
%F A399736 a(n) = Sum_{d | n, gcd(d, n/d) = 1, A295316(n/d) = 1} d.
%F A399736 a(n) = n * A034448(n) / A399735(n).
%F A399736 Multiplicative with a(p^e) = p^e + 1 for e odd, and a(p^e) = p^e for e even.
%F A399736 Dirichlet g.f.: zeta(s-1) * zeta(2*s) * Product_{p prime} (1 + 1/p^s - 1/p^(2*s-1) - 1/p^(2*s)).
%F A399736 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = zeta(4) * Product_{p prime} (1 + 1/p^2 - 1/p^3 - 1/p^4) = 1.31685216574939259467... .
%t A399736 f[p_, e_] := p^e + Boole[OddQ[e]]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A399736 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, f[i,1]^f[i,2] + (f[i,2] % 2 == 1));}
%Y A399736 Cf. A013662, A033634, A034448, A055076, A077610, A268335, A295316, A322483, A358346, A385135 (analogous with all divisors).
%Y A399736 The sum of the unitary divisors d of n such that n/d is: A363289 (squarefree), A399732 (cubefree), A399733 (powerful), A399734 (cubefull), A399735 (square), this sequence (exponentially odd), A399737 (cube), A399738 (odd), A399739 (power of 2), A399740 (perfect power).
