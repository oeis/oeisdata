%I A399868 #28 Nov 23 2026 19:23:06
%S A399868 1,3,1,15,12,1,90,204,39,1,594,3978,2067,120,1,4158,83538,124020,
%T A399868 19320,363,1,30294,1837836,7962084,3506580,176055,1092,1,227205,
%U A399868 41745132,533459628,679575204,96126030,1591044,3279
%N A399868 Array read by upwards antidiagonals: T(n,k) is the coefficient of x^n in (1 - (1 - 9*3^k*x)^(3^(-k - 1)))/(3*x) for n >= 0, k >= 0.
%C A399868 Case p = 3, mu = zeta = 9*3^k of Corollary 4 in Dmytryshyn and Stokolos (2026).
%H A399868 D. Dmytryshyn and A. Stokolos, <a href="https://doi.org/10.13140/RG.2.2.14113.98405">Some Generalizations of Riordan-Type Sequences</a>, Preprint, November 2026.
%F A399868 G.f. for column k: (1 - (1 - 9*3^k*x)^(3^(-k - 1)))/(3*x).
%F A399868 T(n,k) = (-1)^n * binomial(3^(-k - 1), n + 1) * 3^((k + 2)*(n + 1) - 1).
%F A399868 (n + 1)*T(n,k) = (9*3^k*n - 3)*T(n - 1,k) for n >= 1 with T(0,k) = 1.
%e A399868 The array T(n,k) (with n >= 0, k >= 0) begins:
%e A399868         k = 0    k = 1      k = 2         k = 3           k = 4             k = 5
%e A399868   ===============================================================================
%e A399868   n = 0:    1,       1,         1,            1,              1,                1
%e A399868   n = 1:    3,      12,        39,          120,            363,             1092
%e A399868   n = 2:   15,     204,      2067,        19320,         176055,          1591044
%e A399868   n = 3:   90,    3978,    124020,      3506580,       96126030,       2608516638
%e A399868   n = 4:  594,   83538,   7962084,    679575204,    56003025078,    4562295599862
%e A399868   n = 5: 4158, 1837836, 533459628, 137274191208, 33993836222346, 8312502582948564
%p A399868 T := proc(n, k) local G: G := (1 - (1 - 9*3^k*z)^(3^(-k - 1)))/(3*z): coeff(series(G, z, n + 2), z, n) end proc: seq(seq(T(d - k, k), k = 0..d), d = 0..10);
%Y A399868 Cf. A025748 (column k=0), A097193 (column k=1), A029858 (row n=1), main diagonal is unsigned (1/3)*A158093(n+1).
%K A399868 nonn,easy,tabl,new
%O A399868 0,2
%A A399868 _Dmytro Dmytryshyn_, Nov 15 2026
