%N A399389 G.f. A(x) satisfies: A(x) = x * ( 1 + x + ( A(x)^2 + A(x^2) ) / 2 ).
%t A399389 terms = 43; A[_] = 0; Do[A[x_] = x (1 + x + (A[x]^2 + A[x^2])/2) + O[x]^terms // Normal, terms]; CoefficientList[A[x], x]
%t A399389 (* Alternative: *)
%t A399389 a[n_?OddQ] := a[n] = Sum[a[k] a[n - k - 1], {k, 1, (n - 1)/2 - 1}] + (1/2) a[(n - 1)/2] (1 + a[(n - 1)/2]); a[n_?EvenQ] := a[n] = Sum[a[k] a[n - k - 1], {k, 1, n/2 - 1}]; a[0] = 0; a[1] = a[2] = 1; Table[a[n], {n, 0, 42}]
