%T A399097 4,1,1,0,126,82,39,22,10,5,1,1,0,318,204,99,54,24,13,5,1,1,0,814,520,
%U A399097 252,140,62,32,14,6,1,1,0,2111,1337,651,361,164,82,35,17,6,1,1,0
%N A399097 Triangle read by rows: T(n,k) is the number of unlabeled rooted trees with n nodes of which k are furthest from the root.
%H A399097 Andrew Howroyd, <a href="/A399097/b399097.txt">Table of n, a(n) for n = 1..1275</a> (rows 1..50).
%F A399097 G.f.: x*y + Sum_{k>=1} p(k,x,y) - p(k-1,x,1), where p(k,x,y) = x*exp(Sum_{i>=1} p(k-1,x^i,y^i)/i) with p(0,x,y)=x*y.
%e A399097 Triangle begins:
%e A399097     1;
%e A399097     1,   0;
%e A399097     1,   1,  0;
%e A399097     2,   1,  1,  0;
%e A399097     4,   3,  1,  1,  0;
%e A399097     9,   6,  3,  1,  1,  0;
%e A399097    21,  14,  7,  4,  1,  1, 0;
%e A399097    51,  33, 16,  9,  4,  1, 1, 0;
%e A399097   126,  82, 39, 22, 10,  5, 1, 1, 0;
%e A399097   318, 204, 99, 54, 24, 13, 5, 1, 1, 0;
%e A399097   ...
%o A399097 (PARI)
%o A399097 EulerMTS(p)={my(n=serprec(p,x)-1,vars=variables(p)); exp(sum(i=1, n, substvec(p + O(x*x^(n\i)), vars, apply(v->v^i,vars))/i))}
%o A399097 T(n) = {my(A=O(x*x^n), p=A, q=p+x*y, s=q); for(i=1, n, p=x*EulerMTS(p) + A; q=x*EulerMTS(q) + A; s += q-p ); my(v=Vec(s)); vector(#v, i, Vecrev(v[i]/y,i)) }
%o A399097 { foreach(T(10), row, print(row)) }
