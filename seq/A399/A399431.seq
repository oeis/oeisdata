%T A399431 53634713552,204560302844,2994414645860,169947155749832,
%U A399431 9770521225481756,37800705069076952,2202596307308603180,33256101992039755028,129379903640264252432,7651429238067273257636,116522970565265462622284
%N A399431 a(n) = (2^prime(n) - 2)/prime(n) + 2.
%C A399431 For n > 1, a(n) is the number of subsets of [prime(n)] with the sum of elements divisible by prime(n) (see Gelca Andreescu).
%D A399431 Răzvan Gelca and Titu Andreescu, Putnam and Beyond, Springer 2007, pp. 301, 756.
%e A399431 a(4) = 20 since prime(4) = 7 and the subsets of [7] with the sum of elements divisible by 7 are: {}, {7}, {1,6}, {2,5}, {3,4}, {1,2,4}, {1,6,7}, {2,5,7}, {3,4,7}, {3,5,6}, {1,2,4,7}, {1,2,5,6}, {1,3,4,6}, {2,3,4,5}, {3,5,6,7}, {1,2,5,6,7}, {1,3,4,6,7}, {2,3,4,5,7}, {1,2,3,4,5,6}, and {1,2,3,4,5,6,7}.
%t A399431 a[n_]:=(2^Prime[n]-2)/Prime[n]+2; Array[a,23]
%Y A399431 Cf. A000040, A034785, A064535.
