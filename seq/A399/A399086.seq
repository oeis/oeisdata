%S A399086 1,3,1,5,1,2,0,1,7,1,2,2,1,0,2,0,0,1,9,1,2,2,3,0,2,0,2,1,0,0,2,0,0,0,
%T A399086 1,11,1,2,2,3,2,2,0,2,1,2,0,2,0,0,2,1,0,0,0,2,0,0,0,0,1,13,1,2,2,3,2,
%U A399086 4,0,2,1,2,0,4,0,0,2,1,0,2,0,2,0,0,0,2,1,0,0,0,0,2,0,0,0,0,0,1
%N A399086 Triangle read by rows: T(n,k) is the number of ordered outcomes with product k when two independent fair n-sided dice, each with faces 0,...,n-1, are rolled, for 0 <= k <= (n-1)^2.
%C A399086 Row n of T(n, k)/n^2 is the probability distribution of the product of two independent uniform random variables on {0,...,n-1}.
%C A399086 A395373 gives the corresponding positive-indexed product multiplicities for factors in {1,...,n}.
%C A399086 This is the trailing-zero-omitted flattening, under k = q*n + r, of the quotient-remainder distribution A(n, q, r) = #{(i,j) : 0 <= i,j < n and i*j = q*n + r}, 0 <= q,r < n, where Sum_{r = 0..n-1} A(n, q, r) = A393470(n, q) for n >= 2 and Sum_{q=0..n-1} A(n, q, r) = A095026(n, r). Equivalently, A(n, q, r)/n^2 is the joint probability distribution of floor(i*j/n) and i*j mod n for two independent uniform i,j in {0,...,n-1}.
%H A399086 Frédéric D. W. Heidenthal-König, <a href="https://doi.org/10.5281/zenodo.18960358">Euclidean Decomposition of the Multiplication Table</a>, Zenodo, 2026.
%F A399086 T(n, k) = #{(i,j) : 0 <= i,j < n and i*j = k}, for 0 <= k <= (n-1)^2.
%F A399086 Sum_{k = 0..(n-1)^2} T(n, k) = n^2.
%F A399086 T(n, 0) = 2*n - 1 = A005408(n-1).
%F A399086 For k > 0, T(n, k) = #{d | k : floor(k/n) < d < n}.
%F A399086 For 1 <= k <= (n-1)^2, T(n, k) = A395373(n-1,k).
%F A399086 The number of nonzero entries in row n is 1 + A027424(n-1).
%F A399086 For n >= 2, the support of row n is 1 followed by row n-1 of A394016.
%e A399086 Rows for n = 1 to 6:
%e A399086   n=1: 1;
%e A399086   n=2: 3, 1;
%e A399086   n=3: 5, 1, 2, 0, 1;
%e A399086   n=4: 7, 1, 2, 2, 1, 0, 2, 0, 0, 1;
%e A399086   n=5: 9, 1, 2, 2, 3, 0, 2, 0, 2, 1, 0, 0, 2, 0, 0, 0, 1;
%e A399086   n=6: 11, 1, 2, 2, 3, 2, 2, 0, 2, 1, 2, 0, 2, 0, 0, 2, 1, 0, 0, 0, 2, 0, 0, 0, 0, 1;
%e A399086   ...
%o A399086 (Python)
%o A399086 def row(n):
%o A399086     a = [0] * ((n - 1)**2 + 1)
%o A399086     for i in range(n):
%o A399086         for j in range(n):
%o A399086             a[i*j] += 1
%o A399086     return a
%o A399086 a = []
%o A399086 for n in range(1, 8):
%o A399086     a.extend(row(n))
%o A399086 print(a)
%Y A399086 Cf. A395373, A027424, A393470, A095026, A394016.
%Y A399086 Cf. A002522(n-1) (row lengths).
%Y A399086 Cf. A005408 (first column).
%K A399086 nonn,tabf,new
%O A399086 1,2
%A A399086 _Frédéric D. W. Heidenthal-König_, Aug 18 2026
