%U A399233 29498560,53757378,97831608,177814022,322801920,585360476,1060372672,1918975080,3469613980
%N A399233 Number of minimal connected dominating sets in the n-antiprism graph.
%C A399233 The n-antiprism graph is the square of C_(2n), where C_m denotes the cycle graph on m vertices.
%C A399233 For n >= 4, minimal connected dominating sets correspond to cyclic binary words whose zero runs have length at most 2 and whose one runs have length 1, with the complete alternating word excluded.
%H A399233 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/AntiprismGraph.html">Antiprism Graph</a>.
%H A399233 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/MinimalConnectedDominatingSet.html">Minimal Connected Dominating Set</a>.
%F A399233 a(n) = 2*n*(n-1)*hypergeom([1-n/3, (4-n)/3, (5-n)/3, n], [3-n, n-1, 3/2], 27/4) for n >= 3.
%F A399233 a(n) = 2*n*(Sum_{s=0..n-3} binomial(s+1,2*n-5-2*s) + Sum_{s=0..n-4} binomial(s+1,2*n-8-2*s)) for n >= 4.
%F A399233 a(n) = 4*a(n-1) - 6*a(n-2) + 6*a(n-3) - 5*a(n-4) + 2*a(n-5) - a(n-6) for n >= 9.
%F A399233 G.f.: 2*x^3*(6-12*x+8*x^2-2*x^3+x^4)/(1-2*x+x^2-x^3)^2.
%F A399233 a(n) = 2*n*A137495(n-3) for n >= 3.
%t A399233 Table[2 n (n - 1) HypergeometricPFQ[{1 - n/3, (4 - n)/3, (5 - n)/3, n}, {3 - n, n - 1, 3/2}, 27/4], {n, 3, 20}]
%t A399233 (* Alternative: *)
%t A399233 CoefficientList[Series[2 (6 - 12 x + 8 x^2 - 2 x^3 + x^4)/(1 - 2 x + x^2 - x^3)^2, {x, 0, 20}], x]
%t A399233 (* Alternative: *)
%t A399233 LinearRecurrence[{4, -6, 6, -5, 2, -1}, {12, 24, 40, 84, 182, 368}, 20]
%Y A399233 Cf. A137495.
%K A399233 nonn,new
