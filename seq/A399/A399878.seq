%T A399878 8,12,0,29,0,14,4,20,0,26,0,16,14,22,0,26,6,20,10,24,0,28,8,34,16,24,
%U A399878 0,42,0,20,8,33,4,40,0,32,16,34,0,54,0,22,12,36
%N A399878 a(n) = Sum_{k = 1..n, k does not divide n} (gcd(n, floor(n/k) + 1) - gcd(n, floor(n/k))).
%C A399878 If n is an even square (A016742) then a(n) is an odd number.
%F A399878 a(A385402(n)) = 0.
%e A399878 For n = 10: the nondivisors of 10 are k = 3,4,6,7,8,9. For k = 3, floor(10/3) = 3 and gcd(10,3) - gcd(10,4) = -1. For k = 4, floor(10/4) = 2 and gcd(10,2) - gcd(10,3) = 1. For k = 6, floor(10/6) = 1 and gcd(10,1) - gcd(10,2) = -1. For k = 7, floor(10/7) = 1 and gcd(10,1) - gcd(10,2) = -1. For k = 8, floor(10/8) = 1 and gcd(10,1) - gcd(10,2) = -1. For k = 9, floor(10/9) = 1 and gcd(10,1) - gcd(10,2) = -1. Thus we have a(10) = -((-1)+1+(-1)+(-1)+(-1)+(-1)) = 4.
%t A399878 a[n_] := Sum[If[Divisible[n, k], 0, GCD[n, Floor[n/k] + 1] - GCD[n, Floor[n/k]]], {k, 1, n}]; Array[a, 76] (* _Amiram Eldar_, Sep 14 2026 *)
