%S A399058 0,1,2,5,16,60,248,1111,5388,28223,158678,950372,6025600,40262921,
%T A399058 282634254,2078753761,15978707292,128049315368,1067388338448,
%U A399058 9236314084831,82820447866112,768350825177387,7364592205077650,72834168988684880,742313933713969504,7787741039383229857
%N A399058 Sum of the sizes of the odd indexed blocks minus sum of the sizes of the even indexed blocks in all set partitions of [n].
%H A399058 Alois P. Heinz, <a href="/A399058/b399058.txt">Table of n, a(n) for n = 0..576</a>
%H A399058 Wikipedia, <a href="https://en.wikipedia.org/wiki/Partition_of_a_set">Partition of a set</a>
%F A399058 a(n) = Sum_{k=1..n} (-1)^(k+1) * A270236(n,k).
%F A399058 a(n) mod 2 = A120325(n+1).
%e A399058 a(3) = 5 = 9 - 5 + 1 = 3 + (2-1) + (2-1) + (1-2) + (1-1+1) for the 5 partitions of [3]: 123, 12|3, 13|2, 1|23, 1|2|3.
%p A399058 b:= proc(n, m) option remember; `if`(n=0, [1, 0], add(
%p A399058      (p-> p+[0, -p[1]*(-1)^j])(b(n-1, max(m, j))), j=1..m+1))
%p A399058     end:
%p A399058 a:= n-> b(n, 0)[2]:
%p A399058 seq(a(n), n=0..25);
%Y A399058 Cf. A000110, A120325, A270236, A346772.
%K A399058 nonn,new
%O A399058 0,3
