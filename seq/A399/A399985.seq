%U A399985 174842253,440020407,1111322056,2816105667,7157987430,18246561975,46637441335,119503484804,306938007900,790105587977
%N A399985 Number of trees with total node weight n where nodes have positive integer weights and no adjacent nodes have the same weight.
%F A399985 G.f.: C(x) = A(x) - (A(x)^2 - Sum_{i>0} B_i(x)^2)/2 where A(x) = Sum_{i>0} B_i(x) and B_i(x) = x^i * exp( Sum_{k>0} (A(x^k) - B_i(x^k))/k ).
%e A399985 a(6) = 10: (6)   (5)   (4)   (1)    (1)    (1)   (2)   (1)   (2)    (1)
%e A399985                   |     |     |      |      |     |     |     |      |
%e A399985                  (1)   (2)   (4)    (3)    (2)   (1)   (2)   (3)    (2)-(1).
%e A399985                               |     / \     |     |     |     |     / \
%e A399985                              (1)  (1) (1)  (1)   (3)   (3)   (1)  (1) (1)
%e A399985                                             |
%e A399985                                            (2)
%o A399985 (PARI)
%o A399985 A_x(N) = { my(B=vector(N,i,x^i)); for(i=1,N, my(R=vecsum(B)); for(j=1,N, my(S= sum(k=1,N, ( subst(R, x, x^k ) - subst(B[j], x, x^k )+ 'x*O(x^(N+1)))/k )); B[j] = x^j * exp(S) + O(x^(N+1)))); B }
%o A399985 C_x(N) = {my(B = A_x(N), A = vecsum(B)); concat([0],Vec(A - (A^2 - sum(i=1,#B, B[i]^2))/2))}
%Y A399985 Cf. A000055, A036250, A384747, A384748, A396080.
