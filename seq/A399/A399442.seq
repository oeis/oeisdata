%I A399442 #17 Sep 01 2026 11:39:23
%S A399442 2,3,5,7,127,151,157,181,257,277,521,571,727,751,757,811,857,1447,
%T A399442 1481,2141,2411,2417,2521,4211,4217,4451,4547,4787,4817,5227,5441,
%U A399442 7487,8747,11117,11251,11257,11777,12157,12227,12511,12841,14771,14821,14887,15121,15217,15581,17551,17581,18287,21157
%N A399442 Primes p such that p - A062329(p) is also a prime.
%C A399442 Primes p such that p + (product of digits of p) - (sum of digits of p) is a prime (possibly the same as p).
%C A399442 No terms except 3 can contain digit 0, 3, 6 or 9, otherwise p - A062329(p) would be divisible by 3.
%H A399442 Robert Israel, <a href="/A399442/b399442.txt">Table of n, a(n) for n = 1..10000</a>
%e A399442 a(5) = 127 is a term because 127 is prime and 127 + (1*2*7) - (1+2+7) = 131 is prime.
%p A399442 filter:= proc(p) local L;
%p A399442  if not isprime(p) then return false fi;
%p A399442  L:= convert(p,base,10);
%p A399442  isprime(p + convert(L,`*`)-convert(L,`+`))
%p A399442 end proc:
%p A399442 select(filter, [2, seq(i,i=3..30000,2)]);
%t A399442 a062329[n_] := (t = IntegerDigits[n]; Plus @@ t - Times @@ t) ;Select[Prime[Range[2378]],PrimeQ[#-a062329[#]]&] (* _James C. McMahon_, Sep 01 2026 *)
%o A399442 (Python)
%o A399442 from math import prod
%o A399442 from sympy import isprime
%o A399442 def A062329(n): return sum(d:=list(map(int, str(n)))) - prod(d)
%o A399442 def ok(n): return isprime(n) and isprime(n-A062329(n))
%o A399442 print([k for k in range(22000) if ok(k)]) # _Michael S. Branicky_, Aug 28 2026
%Y A399442 Cf. A062329, A399441, A399489, A399496. Subset of A038611 (except for 3), A038614, A038617 and A038618.
%K A399442 nonn,base,new
%O A399442 1,1
