%T A399447 765198,2085181,5705949,15672862,43196878,119428387,331130129,
%U A399447 920501964,2565054648,7163668664,20047998996,56213461592,157901715794,444282900749,1252023368288
%N A399447 Number of rooted trees on n unlabeled nodes with exactly 1 node of maximum height.
%C A399447 In other words, there is exactly one node that is furthest from the root node.
%H A399447 Andrew Howroyd, <a href="/A399447/b399447.txt">Table of n, a(n) for n = 1..1000</a>
%F A399447 G.f.: x*Sum_{i>=0} Product_{k=1..i} p(k,x), where p(k,x) = x*exp(Sum_{i>=1} p(k-1,x^i)/i) with p(0,x)=0.
%e A399447 The a(5) = 4 trees are:
%e A399447       |      |        /\     /|\
%e A399447       |     / \      |        |
%e A399447       |    |         |
%e A399447       |
%o A399447 (PARI)
%o A399447 EulerTS(p)={my(n=serprec(p, x)-1); exp(x*Ser(dirmul(Vec(serchop(p, 1), -n), vector(n, k, 1/k)))) }
%o A399447 seq(n) = my(p=O(x*x^n), g=x+p, s=g); for(k=1, n, p = x*EulerTS(p) + O(x^(n-k+1)); g*=p; s+=g); Vec(s, -n)
%Y A399447 Column 1 of A399097.
%Y A399447 Cf. A000081, A399148.
%K A399447 nonn,new
%O A399447 1,4
