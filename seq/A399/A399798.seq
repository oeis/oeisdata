%I A399798 #24 Oct 29 2026 15:00:06
%S A399798 3,5,11,17,257,65537,16777259
%N A399798 Primes p such that nextprime(2^tau(p - 2)) == 1 (mod (p-1)), where tau = A000005.
%C A399798 No more up to 10^11. - _Alper Ferudun_, Oct 20 2026
%e A399798 a(3) = 11 because if nextprime(2^tau(11-2)) = nextprime(2^3) = 11, then 11 == 1 (mod (11 - 1));
%e A399798 a(4) = 17 because if nextprime(2^tau(17-2)) = nextprime(2^4) = 17, then 17 == 1 (mod (17 - 1)).
%o A399798 (Magma) [p: p in PrimesInInterval(3, 10^6) | NextPrime(2^#Divisors(p - 2)) mod (p - 1) eq 1];
%Y A399798 Cf. A014210, A019434, A151800, A203074.
%K A399798 nonn,more,hard,new
%O A399798 1,1
%A A399798 _Juri-Stepan Gerasimov_, Oct 18 2026
