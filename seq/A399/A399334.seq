%p A399334 # Using function 'binomial_matrix' from A399000.
%p A399334 BM := binomial_matrix(n -> binomial(n, iquo(n,2))):
%p A399334 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A399334 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%t A399334 (* Uses the function 'binomialMatrix' from A399000. *)
%t A399334 bM = binomialMatrix[Binomial[#, Quotient[#, 2]] &];
%t A399334 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A399334 (Python)  # Using function 'binomial_matrix' from A399000.
%o A399334 from math import comb as binomial
%o A399334 M = binomial_matrix(lambda n: binomial(n, n // 2))
%o A399334 for n in range(9): print([M(n, k) for k in range(9)])
