%S A399092 3,3,3,2,4,2,2,2,4,2,2,2,3,2,3,3,2,3,3,2,2,2,2,5,2,5,2,2,2,2,5,3,2,4,
%T A399092 2,2,3,2,3,3,2,4,3,2,2,2,3,3,3,2,2,2,2,9,2,4,2,2,2,2,4,2,3,2,2,2,4,2,
%U A399092 2,4,3,2,2,2,2,3,2,2,2,2,2,3,5,2,3,6,2,3
%N A399092 The maximum exponent in the prime factorization of the nonsquarefree numbers k such that k+1 is also nonsquarefree.
%H A399092 Amiram Eldar, <a href="/A399092/b399092.txt">Table of n, a(n) for n = 1..10000</a>
%F A399092 a(n) = A051903(A068781(n)).
%F A399092 a(n) >= 2.
%F A399092 Asymptotic mean: Limit_{m->oo} (1/m) * Sum_{k=1..m} a(k) = (1/(1-1/zeta(2)-d(2))) * Sum_{k=2} k * (d(k+1)-d(k)) = 2.65276639490373674807... , where d(k) = Product_{p prime} (1 - 1/p^k) - Product_{p prime} (1 - 1/p^2 - 1/p^k).
%t A399092 emax[k_] := emax[k] = If[k == 1, 0, Max[FactorInteger[k][[;; , 2]]]];
%t A399092 f[k_] := If[emax[k] > 1 && emax[k + 1] > 1, emax[k], Nothing];
%t A399092 Array[f, 840]
%o A399092 (PARI) emax(k) = if(k == 1, 0, vecmax(factor(k)[,2]));
%o A399092 list(kmax) = for(k = 1, kmax, if(!issquarefree(k) && !issquarefree(k+1), print1(emax(k), ", ")));
