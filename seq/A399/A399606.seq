%S A399606 3,113,137,241,293,389,577,641,727,743,863,8933,10601,12713,13421,
%T A399606 13763,15791,22349,22937,29717,31727,32027,34499,41201,51239,53591,
%U A399606 57791,58061,59447,61001,63377,67061,70199,73127,74381,76289,99923,100469,109541,119627,120401,130307,132263,142111,156011
%N A399606 Primes p such that A161351(p) is a square.
%C A399606 Primes p such that p + (sum of digits of p) + (product of digits of p) is a square.
%H A399606 Robert Israel, <a href="/A399606/b399606.txt">Table of n, a(n) for n = 1..1000</a>
%e A399606 a(3) = 137 is a term because 137 is prime and 137 + (1+3+7) + (1*3*7) = 169 = 13^2.
%p A399606 f:= proc(n) local L;
%p A399606       L:= convert(n,base,10);
%p A399606       n + convert(L,`+`) + convert(L,`*`)
%p A399606 end proc:
%p A399606 select(t -> isprime(t) and issqr(f(t)), [2,seq(i,i=3..10^6,2)]);
%o A399606 (Python)
%o A399606 from math import isqrt, prod
%o A399606 from sympy import isprime
%o A399606 def issquare(n): return isqrt(n)**2 == n
%o A399606 def A161351(n): return n + sum(d:=list(map(int, str(n)))) + prod(d)
%o A399606 def ok(n): return isprime(n) and issquare(A161351(n))
%o A399606 print([k for k in range(160000) if ok(k)]) # _Michael S. Branicky_, Sep 06 2026
%Y A399606 Cf. A161351, A399489, A399603, A399604, A399608.
%K A399606 nonn,base,new
%O A399606 1,1
%A A399606 _Robert Israel_, Sep 04 2026
