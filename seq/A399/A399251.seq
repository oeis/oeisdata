%T A399251 0,-5,-8,-9,-8,-5,0,5,8,9,8,5,0,-5,-8,-9,-8,-5,0,7,12,15,16,15,12,7,0,
%U A399251 -7,-12,-15,-16,-15,-12,-7,0,7,12,15,16,15,12,7,0,-7,-12,-15,-16,-15,-12,-7,0,9
%N A399251 a(n) = x^2 - y^2, where (x, y) are the coordinates of the n-th point of the square counterclockwise spiral with n=1 at the origin.
%C A399251 The spiral begins:
%C A399251   17--16--15--14--13
%C A399251    |               |
%C A399251   18   5---4---3  12
%C A399251    |   |       |   |
%C A399251   19   6   1---2  11
%C A399251    |   |           |
%C A399251   20   7---8---9--10
%C A399251    |
%C A399251   21--22--23--24--25--...
%F A399251 a(n) = A174344(n)^2 - A274923(n)^2.
%e A399251 a(17) = 0 = (-2)^2 - 2^2, since the 17th point of the spiral is the point (-2, 2).
%o A399251 (Python)
%o A399251 import math
%o A399251 def y(n):
%o A399251     n -= 1
%o A399251     m = math.isqrt(n)
%o A399251     k = math.ceil(m/2)
%o A399251     n -= 4*k*k
%o A399251     if n < 0: return 3*k+n if n < -m else k
%o A399251     return k-n if n < m else -k
%o A399251 def x(n):
%o A399251     n -= 1
%o A399251     m = math.isqrt(n)
%o A399251     k = math.ceil(m/2)
%o A399251     n -= 4*k*k
%o A399251     if n < 0: return k if n < -m else -k-n
%o A399251     return -k if n < m else n-3*k
%o A399251 def a(n):
%o A399251     return x(n)**2 - y(n)**2
