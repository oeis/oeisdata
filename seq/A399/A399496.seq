%U A399496 48177481,48511225,71757841,72454144,84125584,114725521,114875524,117527281,142444225,147258225,154455184,212547241,242175844,271755225
%N A399496 Squares k such that k - A062329(k) is a prime.
%C A399496 Squares k such that k + (product of digits of k) - (sum of digits of k) is a prime.
%C A399496 No terms can contain digit 0, 3, 6 or 9, otherwise k - A062329(k) would be divisible by 3.
%H A399496 Robert Israel, <a href="/A399496/b399496.txt">Table of n, a(n) for n = 1..5000</a>
%e A399496 a(3) = 18225 is a term because 18225 = 135^2 and 18225 + (1*8*2*2*5) - (1+8+2+2+5) = 18367 is prime.
%p A399496 f:= proc(n) local L; L:= convert(n, base, 10); n + convert(L, `*`)-convert(L, `+`) end proc:
%p A399496 select(t -> isprime(f(t)), [seq(i^2, i=0..10^5)]);
%t A399496 a062329[n_] := (t = IntegerDigits[n]; Plus @@ t - Times @@ t) ;Select[Range[16485]^2,PrimeQ[#-a062329[#]]&] (* _James C. McMahon_, Sep 01 2026 *)
%Y A399496 Cf. A062329, A399441, A399442, A399489. Subset of A000290, A007095, A052041, A052405, A052414.
%K A399496 nonn,base,new
%O A399496 1,1
%A A399496 _Robert Israel_, Aug 30 2026
