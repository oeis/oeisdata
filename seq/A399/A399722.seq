%I A399722 #14 Sep 28 2026 14:54:02
%S A399722 5,1,73,1,23,1,65,1,5,1,19,1,1100931843921811423,1,106346764803351611,
%T A399722 1,5,1,251,1,23,1,44834791551842521,1,5,1,19,1,85,1,48215861999407177,
%U A399722 1,5,1,5795355226319417,1,23,1,259,1,5,1,19,1,64458584017301,1,211,1,5,1
%N A399722 a(n) = 3^(m-1) + Sum_{i=2..m} 3^(m-i)*2^(d(1)+...d(i-1)) where m=A122458(n) and d(i)=A351122(n,i-1) for 1<=i<m.
%C A399722 An alternative to the parity vector A260592 to represent the trajectory in the Collatz sequence until the first smaller number is reached.
%C A399722 If we denote the total number of digits equal to 1 in A260592(n) by m, a(n) = 3^(m-1) + Sum_{i=2..m} 3^(m-i)*2^(d(1)+...d(i-1)) where d(i) is 1 plus the number of consecutive 0 digits immediately following the i-th 1 digit starting from the left. In an alternative way m=A122458(n) and d(i)=A351122(n,i-1) for 1<=i<m.
%F A399722 a(n) = A060565(n)*2^A260590(n) - (2*n+1)*3^A122458(n).
%e A399722 A260592(2)=10 and m=1 then a(2)=3^0=1;
%e A399722 A260592(3)=1110100 and m=4 and d1=1,d2=1,d3=2 then a(3)=3^3+3^2*2^1+3^1*2^(1+1)+2^(1+1+2)=73.
%o A399722 (PARI) collatz_dropping(n) = {my(t=2*n+1, m=0, k=0); if(t>1, while(t>=2*n+1, if(t%2, t*=3; t++; m++); t>>=1; k++)); [t,m,k]}
%o A399722 a(n) = {my([A060565,A122458,A260590]= collatz_dropping(n)); A060565*2^A260590-(2*n+1)*3^A122458;}
%o A399722 (PARI) a(n) = {my(t=A260592(n), ans=0, d=List([])); while(t%2==0,t\=10); t\=10; while(t>0, dt=1; while(t%2==0, t\=10; dt++); listput(d,dt); t\=10); m=#d+1; ans+=3^(m-1); if(m>1, e=d[m-1]; for(j=2, m-1, ans+=3^(m-j)*2^e; e+=d[m-j]); ans+=2^e); ans;}
%Y A399722 Cf. A060565, A122458, A260590, A260592, A351122.
%K A399722 nonn,new
%O A399722 1,1
%A A399722 _V. Barbera_, Sep 09 2026
