%I A399680 #20 Sep 16 2026 00:25:20
%S A399680 1,1,1,2,1,2,1,4,3,2,1,2,1,2,3,8,1,6,1,4,3,2,1,2,5,2,9,4,1,2,1,16,3,2,
%T A399680 5,2,1,2,3,4,1,6,1,4,3,2,1,2,7,10,3,4,1,18,5,4,3,2,1,2,1,2,3,32,5,6,1,
%U A399680 4,3,2,1,2,1,2,15,4,7,6,1,4,27,2,1,2,5
%N A399680 a(1) = 1, for n >= 2; a(n) = the greatest integer k < n such that all divisors of k are exactly the first divisors of n in increasing order.
%C A399680 a(n) is alternatively odd and even for n>=3.
%C A399680 Sequence is surjective.
%C A399680 a(n) is a divisor of n. - _David A. Corneth_, Sep 11 2026
%F A399680 a(p) = 1 for prime p.
%F A399680 a(p^k) = p^(k-1) for prime p and k>=2.
%F A399680 a(p*q) = p for distinct primes p<q.
%F A399680 a(A256017(n)) = n.
%e A399680 a(18) = 6 because the divisors of 6 = {1, 2, 3, 6} are the first divisors of 18 = {1, 2, 3, 6, 9, 18}.
%p A399680 f:= proc(n) local D,k;
%p A399680   D:= sort(convert(NumberTheory:-Divisors(n),list));
%p A399680   for k from nops(D)-1 to 1 by -1 do
%p A399680     if D[k]-n mod 2 <> 0 then next fi;
%p A399680     if NumberTheory:-Divisors(D[k]) = convert(D[1..k],set) then return D[k] fi
%p A399680   od
%p A399680 end proc:
%p A399680 f(1):= 1: f(2):= 1:
%p A399680 map(f, [$1..100]); # _Robert Israel_, Sep 08 2026
%o A399680 (Magma) K := []; for n in [2..100] do Dn := Divisors(n); k_found := 0; for k in [n-1..1 by -1] do Dk := Divisors(k); if #Dk le #Dn and Dk eq Dn[1..#Dk] then k_found := k; break; end if; end for; Append(~K, k_found); end for; K;
%o A399680 (PARI) a(n) = if (n==1, return(1)); my(d=divisors(n)); forstep(k=n-1, 1, -1, my(dk = divisors(k)); if (dk == Vec(d, #dk), return(k));); \\ _Michel Marcus_, Sep 10 2026
%Y A399680 Cf. A235875, A256017.
%K A399680 nonn,new
%O A399680 1,4
%A A399680 _Jaroslav Krizek_, Sep 08 2026
