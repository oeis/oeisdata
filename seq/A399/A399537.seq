%I A399537 #7 Sep 09 2026 21:38:13
%S A399537 1,1,1,1,2,4,6,8,12,18,28,44,68,106,166,264,426,690,1120,1825,2981,
%T A399537 4885,8031,13235,21851,36151,59909,99439,165309,275187,458669,765397,
%U A399537 1278645,2138261,3579259,5996795,10055767,16875695,28342525,47635197,80115061,134828511
%N A399537 Number of nonempty subsets S of {1,...,n} such that Sum_{k in S} k = min(S)*max(S).
%C A399537 It can be proven that a(n)-a(n-1) is odd iff 12*n*(n+1)+1 is a square. Hence the parity of a(n) changes at n = 1, 5, 20, 76, 285, 1065, 3976, ..., the positive terms of A061278. Equivalently, these n arise from solutions of y^2 - 3*(2*n+1)^2 = -2.
%F A399537 a(n) = 1 + Sum_{M=2..n} Sum_{m=2..M-1} N(m,M,m*M-m-M), where N(m,M,r) is the number of subsets of {m+1,...,M-1} whose elements sum to r.
%F A399537 Equivalently, a(n)-a(n-1) = Sum_{m=2..n-1} N(m,n,m*n-m-n).
%e A399537 For n=5 the qualifying subsets are {1} and {2,3,5}, since 2+3+5 = 2*5. Hence a(5)=2.
%e A399537 For n=6 the qualifying subsets are {1}, {2,3,5}, {2,4,6}, and {3,4,5,6}. Hence a(6)=4.
%t A399537 a[n_] := 1 + Sum[Coefficient[Product[1 + x^j, {j, m + 1, M - 1}], x, m*M - m - M], {M, 2, n}, {m, 2, M - 1}];
%t A399537 Table[a[n], {n, 1, 20}]
%o A399537 (Java)
%o A399537 import java.math.BigInteger;
%o A399537 import java.util.Arrays;
%o A399537 public class A {
%o A399537     static BigInteger T(int m, int n) {
%o A399537         int t = m * n - m - n;
%o A399537         if (t < 0) {
%o A399537             return BigInteger.ZERO;
%o A399537         }
%o A399537         BigInteger[] d = new BigInteger[t + 1];
%o A399537         Arrays.fill(d, BigInteger.ZERO);
%o A399537         d[0] = BigInteger.ONE;
%o A399537         for (int j = m + 1; j < n; ++j) {
%o A399537             for (int s = t; s >= j; --s) {
%o A399537                 d[s] = d[s].add(d[s - j]);
%o A399537             }
%o A399537         }
%o A399537         return d[t];
%o A399537     }
%o A399537     public static void main(String[] args) {
%o A399537         int N = 42;
%o A399537         BigInteger a = BigInteger.ONE;
%o A399537         System.out.print(a);
%o A399537         for (int n = 2; n <= N; ++n) {
%o A399537             for (int m=2; m<n; ++m)
%o A399537                 a = a.add(T(m,n));
%o A399537             System.out.print(", " + a);
%o A399537         }
%o A399537     }
%o A399537 }
%Y A399537 Indices at which the parity of a(n) changes: A061278.
%K A399537 nonn,new
%O A399537 1,5
