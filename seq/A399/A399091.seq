%I A399091 #7 Aug 20 2026 09:17:19
%S A399091 0,1,1,2,1,1,2,1,1,2,1,1,1,2,1,2,1,1,2,2,1,1,1,1,1,2,1,1,1,1,1,2,2,1,
%T A399091 2,2,1,2,1,1,1,2,1,1,1,1,1,2,1,1,1,1,2,2,1,1,1,1,2,1,1,1,2,1,2,1,1,1,
%U A399091 2,2,2
%N A399091 The maximum exponent in the prime factorization of the cubefree numbers k such that k+1 is also cubefree.
%C A399091 The asymptotic density of occurrences of 1 is c = Product_{p prime} (1 - (p-1)/(p^3-2)) = 0.70786007625075341424..., and the asymptotic density of occurrences of 2 is 1 - c = 0.29213992374924658575... .
%H A399091 Amiram Eldar, <a href="/A399091/b399091.txt">Table of n, a(n) for n = 1..10000</a>
%F A399091 a(n) = A051903(A340152(n)).
%F A399091 a(n) = 1 or 2 for n >= 2.
%F A399091 Asymptotic mean: Limit_{m->oo} (1/m) * Sum_{k=1..m} a(k) = 2 - c = 1.29213992374924658575..., where c is defined in the Comments section.
%t A399091 emax[k_] := emax[k] = If[k == 1, 0, Max[FactorInteger[k][[;;, 2]]]];
%t A399091 f[k_] := If[emax[k] < 3 && emax[k+1] < 3, emax[k], Nothing];
%t A399091 Array[f, 100]
%o A399091 (PARI) iscubefree(k) = if(k == 1, 1, vecmax(factor(k)[, 2]) < 3);
%o A399091 emax(k) = if(k == 1, 0, vecmax(factor(k)[,2]));
%o A399091 list(kmax) = for(k = 1, kmax, if(iscubefree(k) && iscubefree(k+1), print1(emax(k), ", ")));
%Y A399091 Cf. A004709, A051903, A340152, A368712.
%K A399091 nonn,easy
%O A399091 1,4
%A A399091 _Amiram Eldar_, Aug 18 2026
