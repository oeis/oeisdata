%t A399479 nn = 8; B[n_] := n!;ggf[egf_] :=Normal[Series[egf, {z, 0, nn}]] /.Table[z^i -> z^i/2^Binomial[i, 2], {i, 1, nn + 1}]; egf[ggf_] :=Normal[Series[ggf, {z, 0, nn}]] /. Table[z^i -> z^i*2^Binomial[i, 2], {i, 1, nn + 1}]; Table[Take[(Table[B[n], {n, 0, nn}] CoefficientList[Series[Exp[(y - 1) z]*egf[1/ggf[Exp[-z]]], {z, 0, nn}], {z,y}])[[i]], i], {i, 1, nn + 1}] // Grid
