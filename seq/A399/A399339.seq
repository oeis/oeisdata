%e A399339 Seen as a triangle:
%e A399339   [0]    1;
%e A399339   [1]    2,   0;
%e A399339   [2]    4,   1,  0;
%e A399339   [3]    9,   2,  0,  1;
%e A399339   [4]   23,   5,  1,  1, -1;
%e A399339   [5]   65,  14,  3,  1,  0, 3;
%e A399339   [6]  196,  42,  9,  2,  1, 2, -4;
%e A399339   [7]  616, 131, 28,  6,  2, 2, -1, 12;
%e A399339   [8] 1992, 420, 89, 19,  4, 3,  1,  8, -24;
%p A399339 # Using function 'binomial_matrix' from A399000.
%p A399339 a:= proc(n) option remember; ifelse(n<3, 1, add(add(d*a(d), d=numtheory:-divisors(j))*a(n-j),j=1..n-1)/(n-1)) end:
%p A399339 BM := binomial_matrix(a):
%p A399339 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A399339 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%t A399339 (* Uses the function 'binomialMatrix' from A399000. *)
%t A399339 b[n_] := b[n] = If[n < 3, 1, Sum[m b[m] b[n-k*m], {m, n-1}, {k, (n-1)/m}]/(n-1)];
%t A399339 bM = binomialMatrix[b[#] &];
%t A399339 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A399339 (Python)  # Using function binomial_matrix from A399000.
%o A399339 def b(n): return 1 if n < 3 else sum(m * b(m) * b(n - k * m)
%o A399339 for m in range(1, n) for k in range(1, (n-1)//m + 1))//(n-1)
%o A399339 M = binomial_matrix(b)
%o A399339 for n in range(9): print([M(n, k) for k in range(9)])
