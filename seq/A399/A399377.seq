%T A399377 5,5,7,2,3,3,3,2,3,2,5,2,5,2,3,3,3,5,3,2,5,3,3,3,7,2,7,2,3,2,5,5,7,2,
%U A399377 5,5,3,2,5,2,3,2,3,5,3,2,3,5,5,2,3,3,3,7,3,2,7,3,5,3,5,5,7,2,3,2,3,2,7,2,3,2
%N A399377 a(n) is the least prime p such that p^valuation(A327859(n),p) does not divide n, or 1 if no such p exists.
%H A399377 Antti Karttunen, <a href="/A399377/b399377.txt">Table of n, a(n) for n = 0..10000</a>
%H A399377 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A399377 a(n) = A020639(A370117(n)).
%o A399377 (PARI)
%o A399377 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A399377 A006530(n) = if(n>1, vecmax(factor(n)[, 1]), 1);
%o A399377 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A399377 A327859(n) = A276086(A003415(n));
%o A399377 A399377(n) = { my(x=A327859(n), u = A006530(x)); forprime(p=2, u, if((n%(p^valuation(x,p))), return(p))); (1); };
%Y A399377 Cf. A003415, A020639, A370117, A327859.
%Y A399377 Cf. A370115 (positions of 1's), A067019 (of 2's).
%Y A399377 Cf. also A399372.
%K A399377 nonn,easy,new
%O A399377 0,4
%A A399377 _Antti Karttunen_, Sep 19 2026
