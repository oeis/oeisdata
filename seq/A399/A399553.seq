%I A399553 #56 Sep 23 2026 17:16:39
%S A399553 1,5,11,13,17,23,27,29,35,37,41,47,49,55,59,61,65,71,75,77,83,85,89,
%T A399553 95,99,101,105,111,113,119,123,125,131,133,137,143,145,151,155,157,
%U A399553 161,167,171,173,179,181,185,191,193,199,203,205,211,213,217,223,227
%N A399553 a(n) is the least odd k such that the odd part of k + 1 is not yet in the sequence.
%C A399553 Every odd positive integer can be written in the form a(k)*2^e - 1, for some k>=0, e>0.
%C A399553 Alternatively, the sequence can be generated using a sieve. Initially, all even numbers are excluded. Then as each term k is added, all numbers of the form k*2^e-1 are excluded.
%F A399553 a(n) = 2*A059009(n) + 1.
%e A399553 a(0) = 1 because 1 is the least odd number.
%e A399553 a(1) = 5 because 3 = 1 * 2^2 - 1.
%e A399553 a(2) = 11 because 7 = 1 * 2^3 - 1 and 9 = 5*2^1 - 1.
%o A399553 (Python)
%o A399553 def upto(LIM):
%o A399553     seeds=[1]
%o A399553     for x in range(3,LIM,2):
%o A399553         new=True
%o A399553         for b in seeds:
%o A399553             k=1
%o A399553             while True:
%o A399553                 X=b*2**k-1
%o A399553                 if X==x:
%o A399553                     new=False
%o A399553                     break
%o A399553                 if X>x:
%o A399553                     break
%o A399553                 k+=1
%o A399553             if not new:
%o A399553                 break
%o A399553         if new:
%o A399553             seeds.append(x)
%o A399553     return seeds
%o A399553 print(upto(230))
%Y A399553 Cf. A059009.
%K A399553 nonn,easy,new
%O A399553 0,2
