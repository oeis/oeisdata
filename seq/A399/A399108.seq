%T A399108 455,1365,3003,4990,6300,5895,3805,1437,240,15,1,21,210,1330,5985,
%U A399108 20349,54229,115755,199815,278215,307335,260400,159845,65205,15795,2002,105,1,28,378,3276,20475,98280,376670,1182500,3091935
%N A399108 Irregular triangle read by rows: T(n,k) is the number of labeled K_4-free graphs on n nodes with exactly k edges, 0 <= k <= ex(n,K_4), where ex(n,K_4) = floor(n^2/3) is the Turan number.
%C A399108 Row n has ex(n,K_4) + 1 entries, where ex(n,K_4) is the number of edges of the Turan graph T(n,3) (the complete 3-partite graph with parts as equal as possible); T(n,k) = 0 beyond it.
%C A399108 T(n,k) counts labeled graphs on the vertex set {1..n}.
%C A399108 Computed for n <= 8 by exhaustive enumeration of the K_4-free graphs themselves, via a vertex-by-vertex search that never extends a partial graph into one containing a K_4; cross-checked against an independent complementary count.
%H A399108 Sean A. Irvine, <a href="/A399108/b399108.txt">Table of n, a(n) for n = 1..226</a> (rows 1..12 flattened, rows 1..8 from Brian Klemm)
%H A399108 Brian Klemm, <a href="/A399108/b399108_1.txt">Rows n = 1..8 of triangle, flattened</a>
%H A399108 Brian Klemm, <a href="https://brianklemm.com/publications/CliqueBlockWeighting.pdf">Counting Clique-Containing Graphs by Transitive Block Weighting</a>, 2026.
%F A399108 T(n,k) = A084546(n,k) = C(C(n,2),k) for k <= 5, since 6 edges are needed for a K_4.
%F A399108 T(n,k) = Sum_{v} C(n,v) * h(v,k), where h(v,k) is the number of K_4-free labeled graphs with k edges and no isolated vertex on v nodes; h is supported on v <= 2k, so for fixed k the row entry is a polynomial in n of degree 2k.
%e A399108 Triangle begins:
%e A399108   n=1:  1
%e A399108   n=2:  1, 1
%e A399108   n=3:  1, 3, 3, 1
%e A399108   n=4:  1, 6, 15, 20, 15, 6
%e A399108   n=5:  1, 10, 45, 120, 210, 252, 205, 100, 15
%o A399108 (Python)
%o A399108 from itertools import combinations
%o A399108 def row(n):
%o A399108     E = list(combinations(range(n), 2)); N = len(E)
%o A399108     cnt = [0]*(N+1); adj = [0]*n
%o A399108     def dfs(i, k):
%o A399108         cnt[k] += 1
%o A399108         for e in range(i, N):
%o A399108             u, v = E[e]
%o A399108             c = adj[u] & adj[v]
%o A399108             if any(c >> w & 1 and c & adj[w] for w in range(n)): continue   # would close a K_4
%o A399108             adj[u] |= 1<<v; adj[v] |= 1<<u
%o A399108             dfs(e+1, k+1)
%o A399108             adj[u] &= ~(1<<v); adj[v] &= ~(1<<u)
%o A399108     dfs(0, 0)
%o A399108     return cnt[:n*n//3 + 1]
%o A399108 print([x for n in range(1, 7) for x in row(n)])
%Y A399108 Cf. A084546 (labeled graphs by nodes and edges, of which this is the K_4-free part), A396974 (triangle-free analog), A213434 (labeled triangle-free graphs, aggregated over edge counts), A008406 (unlabeled graphs by nodes and edges).
