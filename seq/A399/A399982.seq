%T A399982 3961,48046,48046,48046,48046,48046,48046,48046,679820,679806,679816,
%U A399982 679806,679820,679806,679816,679806,10992918,10992916,10992916,10992918,10992916,10992916,10992918,10992916,10992916
%N A399982 Triangle read by rows: T(n, k) is the total number of standard Young tableaux over all basic skew shapes with n boxes whose major index is congruent to k modulo n. (n >= 1, 0 <= k <= n-1).
%C A399982 The row sums count all standard Young tableaux over all basic skew shapes with n cells, where a basic skew shape is a skew Young diagram with no empty rows or columns. This triangle is the skew shape analog of A370666, which performs the same major-index residue enumeration over ordinary partition shapes.
%D A399982 R. P. Stanley, Enumerative Combinatorics, Vol. 2, Cambridge University Press, 2001, Proposition 7.19.11.
%e A399982 The triangle begins:
%e A399982   n\k       0         1         2         3         4         5         6        7          8
%e A399982   1:        1;
%e A399982   2:        2,        2;
%e A399982   3:        8,        8,        8;
%e A399982   4:       49,       48,       49,       48;
%e A399982   5:      392,      392,      392,      392,      392;
%e A399982   6:     3963,     3961,     3961,     3963,     3961,     3961;
%e A399982   7:    48046,    48046,    48046,    48046,    48046,    48046,    48046;
%e A399982   8:   679820,   679806,   679816,   679806,   679820,   679806,   679816,   679806;
%e A399982   9: 10992918, 10992916, 10992916, 10992918, 10992916, 10992916, 10992918, 10992916, 10992916;
%e A399982 .
%e A399982 T(6, 3) = 3963 because, when all basic skew shapes D with 6 cells are considered, there are 3963 standard Young tableaux Q whose major index satisfies maj(Q) == 3 (mod 6).
%o A399982 (SageMath)
%o A399982 def maj(Q):
%o A399982     row = {}
%o A399982     for r, R in enumerate(Q):
%o A399982         for x in R:
%o A399982             if x is not None:
%o A399982                 row[ZZ(x)] = r
%o A399982     n = len(row)
%o A399982     return sum(i for i in range(1, n) if row[i + 1] > row[i])
%o A399982 def Trow(n):
%o A399982     a = [0] * n
%o A399982     for Q in StandardSkewTableaux(n):
%o A399982         a[maj(Q) % n] += 1
%o A399982     return a
%o A399982 for n in range(1, 10):
%o A399982     print(Trow(n))
%Y A399982 Cf. A225114, A399981 (row sums), A370666, A400280 (max term in row).
