%I A399369 #18 Aug 31 2026 11:18:44
%S A399369 28,56,88,124,140,172,196,236,248,264,280,308,344,352,364,372,392,440,
%T A399369 472,476,496,516,532,616,620,644,688,700,708,728,744,812,837,860,868,
%U A399369 944,952,964,968,980,992,1032,1036,1064,1144,1148,1161,1180,1204,1240,1288,1316,1320,1364,1372,1376,1400,1416,1476,1484
%N A399369 Numbers k such that p^p divides k for some prime p and there exists j < k such that A376418(j) = A376418(k).
%C A399369 Conjecture 1: k = A399369(1) = 28, j = A399370(1) = 16 is the only such pair that A003415(A399369(n)) = A003415(A399370(n)).
%C A399369 Conjecture 2: k = 28, j = 16 is the only such pair that A376418(k) = A376418(j) and A003415(k) = A003415(j).  If this holds, then the conjecture in A379240 also holds, as well as the weaker version of this conjecture given above.
%H A399369 Antti Karttunen, <a href="/A399369/b399369.txt">Table of n, a(n) for n = 1..10000</a>
%e A399369 Numbers k = 28 = a(1) and j = 16 = A399370(1) are such pair, as A376418(28) = A376418(16) = 7, therefore 28 is included in this sequence, and 16 is included in A399370.
%e A399369 Numbers k = 352 = a(14) and j = 189 = A399370(14) are such pair, as A376418(352) = A376418(189) = 154, therefore 352 is included in this sequence, and 189 is included in A399370.
%e A399369 Numbers k = 616 = a(24) and j = 352 = A399370(24) are such pair, as A376418(616) = A376418(352) = 154, therefore 616 is included in this sequence, and 352 is included in A399370.
%e A399369 Number pairs [19096, 10912], [10912, 5859] and [5859, 5544] are such pairs as A376418(19096) = A376418(10912) = A376418(5859) = A376418(5544) = 4774.
%o A399369 (PARI)
%o A399369 A129252(n) = { my(pp); forprime(p=2, , pp = p^p; if(!(n%pp), return(p)); if(pp > n, return(1))); };
%o A399369 A392879(n) = { my(p=A129252(n), e); if(1==p, return(n), e = valuation(n, p); (n * p^((e%p)-e) * nextprime(1+p)^(e\p))); };
%o A399369 A392878(n) = { my(u); while((u=A392879(n))!=n, n = u); (n); };
%o A399369 A376418(n) = (n - A392878(n));
%o A399369 is_A399369(k) = if(1==A129252(k), 0, my(x=A376418(k)); forstep(j=k-1,1,-1,if(A376418(j)==x, return(1))); 0);
%Y A399369 Subsequence of A100716.
%Y A399369 Cf. A003415, A376418, A379240.
%Y A399369 Cf. A399370 for the corresponding maximal j, the lesser elements of such pairs.
%K A399369 nonn,new
%O A399369 1,1
%A A399369 _Antti Karttunen_, Aug 27 2026
