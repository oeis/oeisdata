%N A399327 Triangle read by rows: T(n, k) = Sum_{i=1..n-k+1} binomial(n, i) * binomial(n, i-1) * T(n-i, k-1) * Sum_{j=0..i-1} T(i-1, j) for k > 0, T(n, 0) = 0^n.
%F A399327 T(n, 1) = n * A002190(n).
%F A399327 Sum_{k=0..n-1} T(n-1, k) = A002190(n).
%e A399327 Triangle starts:
%e A399327   [0] [1]
%e A399327   [1] [0,       1]
%e A399327   [2] [0,       2,       2]
%e A399327   [3] [0,      12,      15,       6]
%e A399327   [4] [0,     132,     192,     108,      24]
%e A399327   [5] [0,    2280,    3710,    2510,     840,    120]
%e A399327   [6] [0,   56760,  100800,   77340,   31980,   7200,   720]
%e A399327   [7] [0, 1923600, 3666600, 3092145, 1470420, 417900, 68040, 5040]
%p A399327 T := proc(n, k) option remember; local i; if n = 0 then n^k elif k = 0 then 0 else add(T(n-i, k-1)*add(T(i-1, j), j = 0..i-1)*binomial(n, i)*binomial(n, i-1), i = 1..n-k+1) fi end:
%p A399327 for n from 0 to 7 do print(seq(T(n, k), k = 0 .. n)) od;
%o A399327 (Python)
%o A399327 from math import comb as C
%o A399327 def A399327triangle(num_rows: int) -> list[list[int]]:
%o A399327     if num_rows <= 0 : return [[]]
%o A399327     T = [[0] * (m + 1) for m in range(num_rows)]
%o A399327     S = [0] * (num_rows + 1)
%o A399327     T[0][0] = 1; S[1] = 1
%o A399327     if num_rows > 1: T[1][1] = 1; S[2] = 1
%o A399327     for m in range(2, num_rows):
%o A399327         T[m][1] = m * S[m]
%o A399327         for j in range(2, m + 1):
%o A399327             T[m][j] = sum(T[m-i][j-1]*S[i]*C(m, i)*C(m, i-1)
%o A399327                       for i in range(1, m - j + 2))
%o A399327         S[m+1] = sum(T[m])
%o A399327     # print(S) # shows A002190
%o A399327     return T
%o A399327 triangle = A399327triangle(8)
%o A399327 for row in triangle: print(row)
