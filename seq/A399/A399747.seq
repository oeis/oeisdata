%S A399747 1,2,3,5,5,6,7,11,10,10,11,15,13,14,15,23,17,20,19,25,21,22,23,33,26,
%T A399747 26,31,35,29,30,31,47,33,34,35,50,37,38,39,55,41,42,43,55,50,46,47,69,
%U A399747 50,52,51,65,53,62,55,77,57,58,59,75,61,62,70,95,65,66,67,85,69,70,71,109
%N A399747 The sum of divisors d of n such that n/d is a perfect power (A001597).
%C A399747 First differs from A069208 at n = 72.
%C A399747 The number of these divisors is A091050(n).
%C A399747 The sum of the complementary divisors is A091051(n).
%H A399747 Amiram Eldar, <a href="/A399747/b399747.txt">Table of n, a(n) for n = 1..10000</a>
%F A399747 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = 1 - Sum_{k>=2} mu(k) * (zeta(2*k) - 1) = 1.10047532720009377586..., and mu is the Moebius function (A008683).
%t A399747 ppowQ[n_] := n == 1 || GCD @@ FactorInteger[n][[;; , 2]] > 1; a[n_] := DivisorSum[n, # &, ppowQ[n/#] &]; Array[a, 100]
%o A399747 (PARI) a(n) = sumdiv(n, d, d*(d == n || ispower(n/d)));
%Y A399747 Cf. A001597, A008683, A069208, A076752, A091050, A091051, A327626, A380398, A399740.
%K A399747 nonn,easy,new
