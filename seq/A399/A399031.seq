%T A399031 1,4,0,1,1,2,0,2,0,1,3,2,0,1,7,1,1,2,0,2,5,1,3,2,0,3,0,1,1,1,1,2,0,1,
%U A399031 3,2,0,3,0,1,1,2,3,2,0,1,3,2,0,1,3,1,1
%N A399031 Least positive k such that some nontrivial proper divisor d of n satisfies d+k | n+k; 0 if no such k exists.
%C A399031 For every composite n > 4, a(n) <= sqrt(n). Equality holds if and only if n = p^2 for an odd prime p.
%C A399031 For every k >= 1, the set {n : a(n) = k} has a natural density, and these densities have total mass 1. For every odd prime p, the set of odd integers n such that a(n) = p has natural density of order 1/(p log p).
%D A399031 H. Davenport and P. Erdos, "On sequences of positive integers", Acta Arithmetica 2 (1936), 147-151.
%D A399031 P. Erdos and G. Tenenbaum, "Sur les diviseurs consécutifs d'un entier", Bulletin de la Société Mathématique de France 111 (1983), 125-145.
%D A399031 K. Ford, "The distribution of integers with a divisor in a given interval", Annals of Mathematics 168 (2008), 367-433.
%D A399031 G. Tenenbaum, "Sur la probabilité qu'un entier possède un diviseur dans un intervalle donné", Compositio Mathematica 51 (1984), 243-263.
%H A399031 Sylvain Geffroy, <a href="https://doi.org/10.5281/zenodo.21970051">A New OEIS Candidate Extending A082772: A Full First-Return Divisor Sequence</a>.
%H A399031 Sylvain Geffroy, <a href="https://doi.org/10.5281/zenodo.21992774">Diagonal Divisor Transport and a First-Return Cost on the Multiplicative Incidence Space, Rev. 2.6</a>.
%F A399031 For n >= 1, a(n) = min {k >= 1 : there exists d with 1 < d < n, d | n, and d+k | n+k}, with a(n) = 0 if the set is empty.
%F A399031 Equivalently, since d | n, d+k | n+k if and only if d+k | n-d.
%F A399031 Hence a(n) = min_{d|n, 1<d<n} (lambda_d(n-d) - d), where lambda_d(m) is the least divisor of m strictly greater than d; a(n) = 0 when no finite value exists.
%F A399031 For every odd prime p, a(p^2) = p.
%F A399031 For fixed witness pair (d,k), the corresponding integers are n = d + t*d*(d+k)/gcd(d,k), t >= 1.
%e A399031 a(6) = 2: for k = 1 neither d = 2 nor d = 3 works; for k = 2, d = 2 gives 4 | 8.
%e A399031 a(8) = 1 since 2 | 8 and 3 | 9.
%e A399031 a(9) = 3 since 3 | 9 and 6 | 12, and no smaller positive shift works.
%e A399031 a(25) = 5 and a(49) = 7.
%o A399031 (Python)
%o A399031 from sympy import divisors
%o A399031 def a(n):
%o A399031     v = []
%o A399031     for d in divisors(n):
%o A399031         if 1 < d < n:
%o A399031             e = [q for q in divisors(n-d) if q > d]
%o A399031             if e:
%o A399031                 v.append(e[0] - d)
%o A399031     return min(v, default=0)
%o A399031 print([a(n) for n in range(1, 88)])
%o A399031 (PARI) a(n) = my(d=divisors(n), list = List()); for (i=2, #d-1, for (k=1, n-2*d[i], if (((n+k) % (d[i]+k)) == 0, listput(list, k)); );); if (#list, vecmin(list)); \\ _Michel Marcus_, Aug 28 2026
%Y A399031 Cf. A082772 (a(n) = 1), A082773.
