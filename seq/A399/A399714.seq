%I A399714 #27 Sep 15 2026 00:39:08
%S A399714 1,2,5,10,22,44,90,181,363,727,1456,2912,5825,11652,23304,46609,93219,
%T A399714 186439,372879,745759,1491518,2983038,5966077,11932155,23864310,
%U A399714 47728622,95457245,190914491,381828983,763657967,1527315935,3054631871,6109263743,12218527488,24437054976
%N A399714 a(n) = -1 - A010815(n-1) - Sum_{k=1..n-2} A010815(k)*2^(n-2-k) for n >= 3.
%C A399714 Conjecture: For n >= 3, a(n) is the number of linearly independent relations of weight n arising from the Ihara-Kaneko-Zagier derivation relation. See the Szűcs (2026) for details.
%C A399714 For n <= 15, the values of a(n) agree with the computer-generated results in Table 2 on page 6 of the Murahara link.
%H A399714 H. Murahara, <a href="https://arxiv.org/abs/1512.08696">Derivation relations for finite multiple zeta values</a>, arXiv:1512.08696 [math.NT], 2015-2016.
%H A399714 Tamás Szűcs, <a href="https://doi.org/10.5281/zenodo.22542076">Conjecture on the Number of Linearly Independent Relations of Ihara-Kaneko-Zagier Derivation Relation: An Euler-type pentagonal formula</a>, Zenodo, 2026.
%H A399714 T. Tanaka, <a href="https://arxiv.org/abs/0710.4920">On the quasi-derivation relation for multiple zeta values</a>, arXiv:0710.4920 [math.NT], 2007-2008.
%F A399714 a(n) = -1 - A010815(n-1) - Sum_{k=1..n-2} A010815(k) * 2^(n-2-k) for n>=3.
%F A399714 a(n) = A000225(n-2) - A178841(n-1) for n>=3.
%F A399714 a(n) = 2*a(n-1) + 1 + A010815(n-1) - A010815(n-2) for n>=4.
%F A399714 a(n) = -1 - A010815(n-1) + 2^(n-2-P_1) + 2^(n-2-P_2) - 2^(n-2-P_3) - 2^(n-2-P_4) + ..., where P_k = A001318(k) are the generalized pentagonal numbers and the sum extends over all P_k <= n.
%F A399714 a(n) = A000225(n-3) - A010815(n-1) - Sum_{k=1..n-3} (A000740(k) * Sum_{j=1..floor((n-3)/k)} A010815(n-1-j*k)) for n>=4.
%F A399714 G.f.: x^2/(x-1) + x*(x-1)/(2*x-1) * Product_{k>=1}(1-x^k)
%F A399714 a(n) ~ (1-c) * 2^n, where c = A048651 = 0.2887880950866024...
%p A399714 A010815 := proc (m) local v, r; v := 24*m+1; if issqr(v) then r := sqrt(v); (-1)^irem(iquo(r+irem(r, 6), 6), 2) else 0 end if end proc:
%p A399714 # Alternative: Using the pentagonal formula:
%p A399714 a := proc(n)
%p A399714 return -add(A010815(k)*2^(n-2-k), k=1..n-2) - A010815(n-1) - 1;
%p A399714 end proc:
%p A399714 seq(a(n), n = 3 .. 40);
%p A399714 # Alternative: Using the recurrence relation:
%p A399714 a := proc(n)
%p A399714   option remember;
%p A399714   if n = 3 then return 1; fi;
%p A399714  return 2*a(n-1) + 1 - A010815(n-1) + A010815(n-2);
%p A399714 end proc:
%o A399714 (PARI)
%o A399714 A010815(m) = {my(s);if(issquare(24 * m + 1, &s),(-1)^(((s + s % 6) \ 6) % 2),0);};
%o A399714 a(n) = {-sum(k=1, n-2, A010815(k) * 2^(n-2-k)) - A010815(n-1) - 1;};
%o A399714 vector(35, n, a(n+2))
%Y A399714 Cf. A000225, A000740, A010815, A152537, A178841.
%K A399714 nonn,new
%O A399714 3,2
%A A399714 _Tamás Szűcs_, Sep 09 2026
