%I A399105 #15 Aug 20 2026 21:23:34
%S A399105 29,31,59,71,79,131,139,179,191,199,239,281,311,349,379,419,431,439,
%T A399105 479,599,619,719,739,839,971,1019,1031,1039,1091,1181,1279,1319,1381,
%U A399105 1399,1499,1511,1571,1579,1811,1931,1949,1979,1999,2111,2239,2339,2381,2399,2411,2441,2579,2699,2711,2719
%N A399105 Primes that are the concatenation of a prime and a square.
%H A399105 Robert Israel, <a href="/A399105/b399105.txt">Table of n, a(n) for n = 1..10000</a>
%e A399105 a(3) = 59 is a term because it is prime and is the concatenation of the prime 5 and the square 9 = 3^2.
%e A399105 The first term that is a concatenation of a prime and a square in two ways is a(1784) = 271289, which is the concatenation of prime 271 and square 289 = 17^2 and of prime 2 and square 71289 = 267^2.
%p A399105 filter:= proc(n) local k;
%p A399105   if not isprime(n) then return false fi;
%p A399105   for k from 1 to ilog10(n) do
%p A399105     if isprime(floor(n/10^k)) and n mod 10^k >= 10^(k-1) and issqr(n mod 10^k) then return true fi;
%p A399105   od;
%p A399105   false
%p A399105 end proc:
%p A399105 select(filter, [seq(seq(10*i+j, j=[1,9]),i=1..1000)]);
%Y A399105 Includes A055781 and A055784.
%Y A399105 Cf. A105184, A399123.
%K A399105 nonn,base
%O A399105 1,1
%A A399105 _Robert Israel_, Aug 18 2026
