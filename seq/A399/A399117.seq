%N A399117 Expansion of e.g.f. 1/(cosh(x) - x*cosh(x)^4).
%F A399117 a(0) = 1; a(n) = Sum_{k=0..n-1} binomial(n,k) * a(k) * b(n-k), where b(n) = n*A092812((n-1)/2) for odd n and b(n) = -1 for even n.
%o A399117 (PARI) my(N=30, x='x+O('x^N)); Vec(serlaplace(1/(cosh(x)-x*cosh(x)^4)))
