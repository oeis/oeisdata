%T A399291 752,999,336,70,0,1,0,70,4893,10588,5055,924,126,0,1,0,169,32340,
%U A399291 121063,79128,19065,2184,210,0,1,0,408,215233,1450022,1347807,408188,58905,4620,330,0,1
%N A399291 Number T(n,k) of n X n upper triangular binary matrices with row sums and column sums in {0, 2} and exactly k zero rows; triangle T(n,k), n>=0, 0<=k<=n, read by rows.
%C A399291 T(n,k) is also the number of bipartite graphs on vertices {L_1,...,L_n} U {R_1,...,R_n}, where (L_i,R_j) can be an edge only if i <= j, all vertex degrees are in {0,2} and exactly k vertices L_i are isolated.
%H A399291 Alois P. Heinz, <a href="/A399291/b399291.txt">Rows n = 0..150, flattened</a>
%e A399291 T(4,2) = 5:
%e A399291   [ 0 0 1 1 ]  [ 0 1 0 1 ]  [ 0 0 1 1 ]  [ 0 1 1 0 ]  [ 0 0 0 0 ]
%e A399291   [ . 0 1 1 ]  [ . 1 0 1 ]  [ . 0 0 0 ]  [ . 1 1 0 ]  [ . 0 1 1 ]
%e A399291   [ . . 0 0 ]  [ . . 0 0 ]  [ . . 1 1 ]  [ . . 0 0 ]  [ . . 1 1 ]
%e A399291   [ . . . 0 ]  [ . . . 0 ]  [ . . . 0 ]  [ . . . 0 ]  [ . . . 0 ] .
%e A399291 Triangle T(n,k) begins:
%e A399291   1;
%e A399291   0,   1;
%e A399291   0,   0,     1;
%e A399291   0,   1,     0,      1;
%e A399291   0,   2,     5,      0,     1;
%e A399291   0,   5,    20,     15,     0,     1;
%e A399291   0,  12,   121,     98,    35,     0,    1;
%e A399291   0,  29,   752,    999,   336,    70,    0,   1;
%e A399291   0,  70,  4893,  10588,  5055,   924,  126,   0, 1;
%e A399291   0, 169, 32340, 121063, 79128, 19065, 2184, 210, 0, 1;
%e A399291   ...
%p A399291 b:= f-> v*(f+diff(f, u)/2+u*((g-> diff(g, u)+diff(g, v))@@2)(f)):
%p A399291 p:= proc(n) option remember; `if`(n=0, v, expand(b(p(n-1)))) end:
%p A399291 T:= (n, k)-> coeff(subs(u=0, p(n)), v, k+1):
%p A399291 seq(seq(T(n, k), k=0..n), n=0..10);
%Y A399291 Columns k=0-1 give: A000007, A000129(n-2) for n>=2.
%Y A399291 Row sums give A396698.
%Y A399291 Cf. A400302.
%K A399291 nonn,tabl,new
%O A399291 0,12
