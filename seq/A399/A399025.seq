%I A399025 #26 Aug 23 2026 22:47:03
%S A399025 0,1,3,8,17,33,58,96,150,225,325,456,623,833,1092,1408,1788,2241,2775,
%T A399025 3400,4125,4961,5918,7008,8242,9633,11193,12936,14875,17025,19400,
%U A399025 22016,24888,28033,31467,35208,39273,43681,48450,53600,59150,65121,71533,78408,85767,93633,102028,110976,120500
%N A399025 a(n) is the number of inequivalent ways of choosing 4 points on an n X n grid that form a square up to rotations.
%H A399025 Janaka Rodrigo, <a href="/A399025/b399025.txt">Table of n, a(n) for n = 1..1000</a>
%H A399025 Janaka Rodrigo, <a href="/A399025/a399025.txt">Python Code of A399025</a>.
%H A399025 Janaka Rodrigo, <a href="/A399025/a399025.pdf">Illustration for n = 5 of A399025</a>.
%F A399025 a(2*n+2) = (1/3)*(n^2+2*n+3)*(n+1)^2.
%F A399025 a(2*n+1) = (1/6)*n*(n+1)*(2*n^2+2*n+5).
%e A399025 n = 4 has 8 different configurations as follows:
%e A399025   - - - -   - - - -   X - - X   - - - -   - - - -   - X - -   - - X -   - - - -
%e A399025   - - - -   X - X -   - - - -   X X - -   - X - -   - - - X   X - - -   - X X -
%e A399025   X X - -   - - - -   - - - -   X X - -   X - X -   X - - -   - - - X   - X X -
%e A399025   X X - -   X - X -   X - - X   - - - -   - X - -   - - X -   - X - -   - - - -
%e A399025 Therefore a(4) = 8.
%Y A399025 Cf. A014820, A002415 (rotations and reflections counted separately), A399026 (up to rotations and reflections).
%K A399025 nonn,easy,new
%O A399025 1,3
%A A399025 _Janaka Rodrigo_, Aug 16 2026
