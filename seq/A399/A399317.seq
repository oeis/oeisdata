%H A399317 Vaclav Kotesovec, <a href="/A399317/b399317.txt">Table of n, a(n) for n = 0..10000</a>
%t A399317 A225543[n_] := SeriesCoefficient[QPochhammer[x]^4 * QPochhammer[-x]^8, {x, 0, n}];
%t A399317 A400338[n_] := SeriesCoefficient[1/(QPochhammer[x]^4*QPochhammer[-x]^8), {x, 0, n}];
