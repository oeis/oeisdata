%I A399671 #6 Sep 22 2026 16:53:03
%S A399671 36,72,144,800,3136,15488,43264,147968,541696,2803712,9048064,
%T A399671 36773888,154157056,562331648,2390818816,8657174528,35307913216,
%U A399671 142313259008,554202824704,2229190787072,8830691835904,35356380495872,140804613996544,563774889132032,2258320714891264
%N A399671 Smallest number k of the form lpf(k)^n * q(k) * rad(k) such that A008479(k) = 3*n+2, where q(k) is the second smallest distinct prime factor of k and rad = A007947.
%C A399671 a(n) = k is the smallest number of the form lpf(k)^n * q(k) * rad(k) such that A008479(a(n)) = 3*n+2 = A016789(n), the minimum number of j <= k such that rad(j) = rad(k).
%C A399671 2^(n+1) | a(n); a(n)/2^(n-1) = prime(i)^2 for some i >= 2.
%H A399671 Michael De Vlieger, <a href="/A399671/b399671.txt">Table of n, a(n) for n = 1..112</a>
%F A399671 a(n) = 2^(n+1) * 9 for n <= 3;
%F A399671 a(n) = 2^(n+1) * prime(pi(1 + 2^(n/2)))^2 for n > 3, where pi = A000720.
%e A399671 Let m = A008479(a(n)) and let g = log_2 gpf(a(n))
%e A399671    n        a(n)                 m         g
%e A399671   -----------------------------------------------
%e A399671    1         36 = 2^2 * 3^2      5   3/2 < g <  2
%e A399671    2         72 = 2^3 * 3^2      8   3/2 < g <  2
%e A399671    3        144 = 2^4 * 3^2     11   3/2 < g <  2
%e A399671    4        800 = 2^5 * 5^2     14    2  < g < 5/2
%e A399671    5       3136 = 2^6 * 7^2     17   5/2 < g <  3
%e A399671    6      15488 = 2^7 * 11^2    20    3  < g < 7/2
%e A399671    7      43264 = 2^8 * 13^2    23   7/2 < g <  4
%e A399671    8     147968 = 2^9 * 17^2    26    4  < g < 9/2
%e A399671    9     541696 = 2^10 * 23^2   29   9/2 < g <  5
%e A399671   10    2803712 = 2^11 * 37^2   32    5  < g < 11/2
%e A399671   11    9048064 = 2^12 * 47^2   35  11/2 < g <  6
%e A399671   12   36773888 = 2^13 * 67^2   38    6  < g < 13/2
%t A399671 Table[If[n < 4, 2^(n + 1)*9, 2^(n + 1)*Prime[1 + PrimePi[2^(n/2)] ]^2], {n, 30}]
