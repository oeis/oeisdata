%I A399048 #12 Aug 29 2026 21:59:07
%S A399048 1,1,1,1,13,2,1,397,108,6,1,55933,8690,888,24,1,31450861,1950300,
%T A399048 145350,7800,120,1,67253507293,1414836002,48780600,2277600,74520,720,
%U A399048 1,559182556492477,3722299038108,43963422006,1098031200,35656320,776160,5040
%N A399048 Triangle read by rows: T(n,k) is the number of induced subgraphs of the n X n rook graph with k connected components.
%H A399048 Andrew Howroyd, <a href="/A399048/b399048.txt">Table of n, a(n) for n = 0..1325</a> (rows 0..50)
%H A399048 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/RookGraph.html">Rook Graph</a>.
%F A399048 A399044(n) = Sum_{k=0..n} k*T(n,k).
%e A399048 Triangle begins:
%e A399048   1;
%e A399048   1,        1;
%e A399048   1,       13,       2;
%e A399048   1,      397,     108,      6;
%e A399048   1,    55933,    8690,    888,   24;
%e A399048   1, 31450861, 1950300, 145350, 7800, 120;
%e A399048   ...
%o A399048 (PARI) \\ In G: S is A183109, T is A262307 (compare A360873).
%o A399048 G(M, N=M)={ my(S=matrix(M, N), T=matrix(M, N), U=matrix(M, N), V=matrix(M,N));
%o A399048 for(m=1, M, for(n=1, N,
%o A399048   S[m, n]=sum(j=0, m, (-1)^j*binomial(m, j)*(2^(m - j) - 1)^n);
%o A399048   T[m, n]=S[m, n]-sum(i=1, m-1, sum(j=1, n-1, T[i, j]*S[m-i, n-j]*binomial(m-1, i-1)*binomial(n, j)));
%o A399048   U[m, n]=y*(T[m,n] + sum(i=1, m-1, sum(j=1, n-1, T[i, j]*U[m-i, n-j]*binomial(m-1,i-1)*binomial(n, j))));
%o A399048   V[m, n]=1+sum(i=1, m, sum(j=1, n, binomial(m, i)*binomial(n, j)*U[i, j]))  ));
%o A399048   V
%o A399048 }
%o A399048 T(n)={my(A=G(n,n)); [Vecrev(p) | p<-concat([1],vector(n,i,A[i,i]))]}
%o A399048 { my(A=T(7)); for(i=1, #A, print(A[i])) }
%Y A399048 Main diagonal is A000142.
%Y A399048 Row sums are A002416.
%Y A399048 Columns k=0..1 are A000012, A286189.
%Y A399048 Cf. A086266, A183109, A262307, A360873, A399043.
%K A399048 nonn,tabl,new
%O A399048 0,5
