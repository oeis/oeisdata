%N A399928 Least integer with exactly n divisors such that the concatenation of its divisors in increasing order is prime.
%C A399928 Since the divisor-count function satisfies d(p^k) = k+1, an integer with exactly n divisors, where n is prime, must be of the form p^(n-1).
%C A399928 a(n) not divisible by 2 and not by 5. - _David A. Corneth_, Sep 16 2026
%e A399928 a(2) = 3, because the concatenation of its 2 divisors [1, 3], namely 13 is a prime.
%e A399928 a(3) = 9, because the concatenation of its 3 divisors [1, 3, 9], namely 139 is a prime.
%e A399928 a(4) = 21, because the concatenation of its 4 divisors [1, 3, 7, 21], namely 13721 is a prime.
%e A399928 a(5) = 279841, because the concatenation of its 5 divisors [1, 23, 529, 12167, 279841], namely 12352912167279841 is a prime.
%e A399928 And no lesser numbers have this property.
%p A399928 facs:= proc(n,m) option remember; # sorted lists L s.t. product(L) = n and all terms >= m.
%p A399928    local R,d;
%p A399928    if n = 1 then return {[]} elif m > n then return {} fi;
%p A399928    R:= {};
%p A399928    for d in select(`>=`,NumberTheory:-Divisors(n), m) do
%p A399928      R:= R union map(t -> [d,op(t)], procname(n/d, d))
%p A399928    od;
%p A399928    R
%p A399928 end proc:
%p A399928 lcat:= proc(L) local t,r,i;
%p A399928   r:= L[1];
%p A399928   for i from 2 to nops(L) do
%p A399928     r:= r * 10^(1+ilog10(L[i])) + L[i]
%p A399928   od;
%p A399928   r
%p A399928 end proc:
%p A399928 f:= proc(n)
%p A399928   uses priqueue;
%p A399928   local F, pq, t, nt, pt, i, r, s, v, w, q, j;
%p A399928   F:= facs(n,2);
%p A399928   initialize(pq);
%p A399928   for t in F do
%p A399928    nt:= nops(t);
%p A399928    pt:= [1$nt];
%p A399928    r:= 1;
%p A399928    insert([-r,pt,t],pq);
%p A399928   od;
%p A399928   do
%p A399928     s:= extract(pq);
%p A399928     v:= -s[1];
%p A399928     w:= lcat(sort(convert(NumberTheory:-Divisors(v),list)));
%p A399928     t:= s[2];
%p A399928     nt:= nops(t);
%p A399928     if nops(convert(t,set))=nt and isprime(w) then return v fi;
%p A399928     for i from 1 to nt do
%p A399928        pt:= subsop(i=t[i]+1,t);
%p A399928        r:= mul(ithprime(pt[j])^(s[3][j]-1),j=1..nt);
%p A399928        insert([-r,pt,s[3]],pq);
%p A399928        if t[i] > 1 then break fi;
%p A399928     od;
%p A399928   od;
%p A399928 end proc:
%p A399928 map(f, [$2..25]); # _Robert Israel_, Sep 17 2026
%o A399928 (PARI) isn(k, n) = my(u = divisors(k));if(#u !=n, return(0)); my(x = eval(strjoin(u))); ispseudoprime(x)
%o A399928 testp(n) = forprime(p = 2, +oo, my(k=p^(n-1)); if(ispseudoprime(eval(strjoin((divisors(k))))), printf("a(%d) = %d\n",n,k); return(k)))
%o A399928 a(n)=if(isprime(n),testp(n),forstep(k=1,+oo,2,if(k%5==0,continue,if(isn(k,n),printf("a(%d) = %d\n",n,k);return(k)))))
%Y A399928 Cf. A000005, A000040, A176553.
%K A399928 nonn,base,new
%O A399928 2,1
%A A399928 _Jean-Marc Rebert_, Sep 16 2026
