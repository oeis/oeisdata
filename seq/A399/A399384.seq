%I A399384 #17 Sep 02 2026 23:02:13
%S A399384 1,3,20,252,5184,158400,6739200,381024000,27636940800,2501955993600,
%T A399384 276531978240000,36647071211520000,5736063320064000000,
%U A399384 1046946277178081280000,220401579240007925760000,53010379834450182144000000,14446183511014036733952000000,4427974127694150956482560000000
%N A399384 a(n) = (2*n + 1)*(n!)^2.
%C A399384 a(n) is the number of permutations s of the set [2*n+1] for which Sum_{i=1..2*n+1} abs(s(i) - i) = ((2*n + 1)^2 - 1)/2 = 2*n*(n + 1) (see Gelca and Andreescu).
%D A399384 Răzvan Gelca and Titu Andreescu, Putnam and Beyond, Springer 2007, pp. 286, 733-734.
%F A399384 a(n) = A007680(n)*n!.
%F A399384 a(n) ~ 4*Pi*exp(-2*n)*n^(2*n+2).
%F A399384 From _Amiram Eldar_, Aug 28 2026: (Start)
%F A399384 Sum_{n>=0} 1/a(n) = (BesselI(0,2)*(2 + Pi*StruveL(1,2)) - Pi*BesselI(1,2)*StruveL(0,2))/2.
%F A399384 Sum_{n>=0} (-1)^n/a(n) = (BesselJ(0,2)*(2 - Pi*StruveH(1,2)) + Pi*BesselJ(1,2)*StruveH(0,2))/2. (End)
%F A399384 D-finite with recurrence: (2*n - 1)*a(n) = (2*n^3 + n^2)*a(n - 1) with a(0) = 1. - _Georg Fischer_, Sep 02 2026
%e A399384 For n = 2 the set is [5], 2*n*(n + 1) = 12, and the 20 permutations s for which Sum_{i=1..2*n+1} abs(s(i) - i) = 12 are: (3, 4, 5, 1, 2), (3, 4, 5, 2, 1), (3, 5, 4, 1, 2), (3, 5, 4, 2, 1), (4, 3, 5, 1, 2), (4, 3, 5, 2, 1), (4, 5, 1, 2, 3), (4, 5, 1, 3, 2), (4, 5, 2, 1, 3), (4, 5, 2, 3, 1), (4, 5, 3, 1, 2), (4, 5, 3, 2, 1), (5, 3, 4, 1, 2), (5, 3, 4, 2, 1), (5, 4, 1, 2, 3), (5, 4, 1, 3, 2), (5, 4, 2, 1, 3), (5, 4, 2, 3, 1), (5, 4, 3, 1, 2), and (5, 4, 3, 2, 1).
%t A399384 a[n_]:=(2n+1)*n!^2; Array[a,18,0]
%Y A399384 Cf. A000142, A001044, A005408, A007680.
%K A399384 nonn,easy,new
%O A399384 0,2
