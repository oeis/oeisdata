%p A399329 # Using function 'binomial_matrix' from A399000.
%p A399329 BM := binomial_matrix(n -> ilcm(seq(i, i=1..n))):
%p A399329 M := Matrix(8, 8, (n, k) -> BM(n-1, k-1));
%p A399329 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%o A399329 (Python)  # Using function binomial_matrix from A399000.
%o A399329 from math import lcm
%o A399329 M = binomial_matrix(lambda n: lcm(*range(1, n + 1)))
%o A399329 for n in range(9): print([M(n, k) for k in range(9)])
