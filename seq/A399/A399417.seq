%e A399417    23    60    105   151   201   256   311   366   425
%t A399417 x = Log[2]; u[n_, k_] := Sum[Floor[k (n + x)/h - x], {h, 1, Floor[k (n + x)/(1 + x)]}]
%t A399417 t = Table[u[n, k], {n, 1, 12}, {k, 1, 12}]; Grid[t]  (*array*)
%t A399417 Table[u[n - k + 1, k], {n, 1, 12}, {k, n, 1, -1}] // Flatten (*sequence*)
%Y A399417 Cf. A399406.
