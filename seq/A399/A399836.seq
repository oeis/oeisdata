%I A399836 #8 Sep 19 2026 17:16:20
%S A399836 1,3,4,5,6,12,8,15,10,18,12,20,14,24,24,31,18,30,20,30,32,36,24,60,26,
%T A399836 42,40,40,30,72,32,63,48,54,48,50,38,60,56,90,42,96,44,60,60,72,48,
%U A399836 124,50,78,72,70,54,120,72,120,80,90,60,120,62,96,80,119,84,144,68,90,96
%N A399836 The sum of divisors d of n such that gcud(d, n/d) is a square, where gcud is the greatest common unitary divisor.
%C A399836 First differs from A399835 at n = 64.
%C A399836 The number of these divisors is A399830(n).
%H A399836 Amiram Eldar, <a href="/A399836/b399836.txt">Table of n, a(n) for n = 1..10000</a>
%F A399836 Multiplicative with a(p^e) = (p^(e+1) - 1)/(p - 1) - p^(e/2) if e == 2 (mod 4), and (p^(e+1) - 1)/(p - 1) otherwise.
%F A399836 Dirichlet g.f.: zeta(s-1) * zeta(s) * zeta(4*s-2) * Product_{p prime} (1 - 1/p^(2*s-1) + 1/p^(3*s-2) + 1/p^(3*s-1) - 2/p^(4*s-2)).
%F A399836 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = zeta(6) * Product_{p prime} (1 + 1/p^2 - 1/p^3 + 2/p^4) = 1.51649626750231458949... .
%t A399836 f[p_, e_] := (p^(e+1) - 1)/(p - 1) - If[Mod[e, 4] == 2, p^(e/2), 0]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A399836 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, (f[i,1]^(f[i,2]+1)-1)/(f[i,1]-1) - if(f[i,2] % 4 == 2, f[i,1]^(f[i,2]/2)));}
%Y A399836 Cf. A000290, A013664, A077610, A165430, A225174, A384244.
%Y A399836 Cf. A365172 (analogous with gcd), A399830.
%Y A399836 The sum of divisors d of n such that gcud(d, n/d) is: A188999 (1), A399834 (squarefree), A399835 (powerful), this sequence (square), A399837 (exponentially odd), A399838 (odd), A399839 (power of 2).
%K A399836 nonn,mult,easy,new
%O A399836 1,2
%A A399836 _Amiram Eldar_, Sep 13 2026
