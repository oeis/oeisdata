%N A399624 Number of antichains of nonempty subsets of [n] whose elements have size at most 3.
%F A399624 a(n) = Sum_{m=0..n} binomial(n,m)*A039718(m), where A039718(0) = 1.
%e A399624 a(3) = 19. The antichains of nonempty subsets of {1,2,3} are:
%e A399624   {}, {{1}}, {{2}}, {{3}}, {{1,2}}, {{1,3}}, {{2,3}}, {{1,2,3}},
%e A399624   {{1},{2}}, {{1},{3}}, {{2},{3}},
%e A399624   {{1},{2,3}}, {{2},{1,3}}, {{3},{1,2}},
%e A399624   {{1,2},{1,3}}, {{1,2},{2,3}}, {{1,3},{2,3}},
%e A399624   {{1},{2},{3}}, {{1,2},{1,3},{2,3}}.
