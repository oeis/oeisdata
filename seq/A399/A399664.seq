%U A399664 692,1049,1424,1753,2615,0,1,21,141,564,1314,2283,3158,4145,5007,7318
%N A399664 Triangle read by rows: T(n, k) is the number of mapping patterns of order n with largest component size <= k.
%F A399664 T(n, k) = (1/n) * Sum_{q=1..n} T(n-q, k) * Sum_{d|q, d <= k} d * A002861(d) for n > 0 and k > 0, otherwise 1 if n = 0 and 0 if n > 0 and k = 0.
%F A399664 Sum_{k=0..n} T(n, k) = (n + 1) * A001372(n) - A399951(n).
%e A399664 Triangle starts:
%e A399664   [0] [1]
%e A399664   [1] [0, 1]
%e A399664   [2] [0, 1,  3]
%e A399664   [3] [0, 1,  3,   7]
%e A399664   [4] [0, 1,  6,  10,  19]
%e A399664   [5] [0, 1,  6,  18,  27,  47]
%e A399664   [6] [0, 1, 10,  32,  59,  79,  130]
%e A399664   [7] [0, 1, 10,  44, 107, 167,  218,  343]
%e A399664   [8] [0, 1, 15,  69, 204, 344,  497,  622,  951]
%e A399664   [9] [0, 1, 15, 105, 312, 692, 1049, 1424, 1753, 2615]
%e A399664 Triangle gives six for maps on four nodes with component size at most two. These digraphs are: four singleton loops, two loops and a two-cycle, two loops and an arrow, two two-cycles, a two-cycle and an arrow, and last, two arrows, for a total of six.
%o A399664 (SageMath)
%o A399664 @cached_function
%o A399664 def A399664(n, k):
%o A399664     if n == 0: return 1
%o A399664     if k == 0: return 0
%o A399664     return (QQ(1)/n) * sum(A399664(n-q, k) * sum((d*A002861(d) if d <= k else 0)
%o A399664             for d in divisors(q)) for q in range(1, n+1) )
%o A399664 for n in range(10): print([n], [A399664(n, k) for k in range(n+1)])
%Y A399664 Cf. A001372 (main diagonal), A001372, A002861, A399665 (row sums), A399951.
%K A399664 nonn,tabl,new
%O A399664 0,6
