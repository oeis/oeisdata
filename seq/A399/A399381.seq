%U A399381 2,1,1,1,2,1,1,2,3,1,1,1,2,2,1,1,3,1,1,1,2,1,2,1,2,1,1,1,2,1,2,2
%N A399381 a(n) is the minimum positive integer k such that k*n-1 is squarefree.
%C A399381 For n > 1, a(n) >= A007424(n-1). In fact, a(n) = A007424(n-1) = 1 if n-1 is squarefree.
%C A399381 It appears that a(n+1) = A399382(n-1) for many values of n > 1. a(n+1) >= A399382(n-1) until a(26) = 2 < 3 = A399382(24).
%C A399381 Here are the first occurrences of values in this sequence, according to the Java program: a(2) = 1, a(1) = 2, a(5) = 3, a(113) = 4, a(723) = 5, a(3553) = 6, a(62305) = 7, a(256271) = 8. 8 is the maximum value of a(n) for n <= 1000000.
%H A399381 Aidan Markey, <a href="/A399381/b399381.txt">Table of n, a(n) for n = 1..10000</a>
%e A399381 a(13) = 3 because 1*13-1 = 12 and 2*13-1 = 25 are not squarefree, but 3*13-1 = 38 is squarefree.
%o A399381 (Java)
%o A399381 public class Program {
%o A399381     public static void main(String[] args) {
%o A399381         for (int n = 1; n <= 100; n++) {
%o A399381             int a = 1;
%o A399381             while (true) {
%o A399381                 if (squarefree(n*a-1)) {
%o A399381                     System.out.println(a);
%o A399381                     break;
%o A399381                 }
%o A399381                 a++;
%o A399381             }
%o A399381         }
%o A399381     }
%o A399381     public static boolean squarefree(int n) {
%o A399381         if (n <= 0) return false;
%o A399381         for (int d = 2; d * d <= n; d++) {
%o A399381             if (n % (d * d) == 0) return false;
%o A399381         }
%o A399381         return true;
%o A399381     }
%o A399381 }
%o A399381 (PARI) a(n) = my(k=1); while (!issquarefree(k*n-1), k++); k; \\ _Michel Marcus_, Aug 28 2026
