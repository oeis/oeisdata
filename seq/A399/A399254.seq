%t A399254 x = 2 + Sqrt[2]; n1 = 15; k1 = 12;
%t A399254 r[n_, k_] := Floor[k*x^n]; t = Table[r[n,k], {n, 1, n1}, {k, 1, k1}];
%t A399254 TableForm[t]
