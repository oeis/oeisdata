%S A399410 1,3,2,6,7,4,10,13,11,5,14,20,21,16,8,18,27,32,30,22,9,24,36,42,45,39,
%T A399410 26,12,28,46,56,61,58,49,34,15,33,53,69,77,78,72,59,40,17,38,64,83,95,
%U A399410 101,98,88,70,47,19,44,73,96,113,123,124,117,103,81,52,23,50,85,110,132,145,152,149,138,119,91,60,25
%N A399410 Order array, U, of the array W given by w(n, k) = k*(n + sqrt(1/2)), for n >= 1, k >= 1, a rectangular array, read by descending antidiagonals; see Comments.
%C A399410 Suppose that (w(n, k)), for n >= 1 and k >= 1 is an array of distinct real numbers. Replace each w(n, k) by its position when all the numbers w(n, k) are ordered by < . The resulting array, U = (u(n, k)), is the order array of (w(n, k)). Every positive integer occurs exactly once in U, so that as a sequence, U is a permutation of the positive integers. Successive row terms, and column terms, have limiting ratio 1. See A399406 for a guide to related sequences.
%H A399410 <a href="/index/Per#IntegerPermutation">Index entries for sequences that are permutations of the natural numbers</a>
%F A399410 u(n,k) = Sum_{h=1..floor(k*(n+x)/(1+x))} floor(k*(n+x)/h-x), where x = sqrt(1/2).
%F A399410 u(n,k) = Sum_{m=1..floor(k*(n+x)-x)} floor(k*(n+x)/(m+x)), where x = sqrt(1/2).
%e A399410 Corner:
%e A399410      1    3    6   10    14   18   24   28   33
%e A399410      2    7   13   20    27   36   46   53   64
%e A399410      4   11   21   32    42   56   69   83   96
%e A399410      5   16   30   45    61   77   95  113  132
%e A399410      8   22   39   58    78  101  123  145  169
%e A399410      9   26   49   72    98  124  152  181  210
%e A399410     12   34   59   88   117  149  183  216  250
%e A399410     15   40   70   103  138  175  212  252  292
%e A399410     17   47   81   119  159  200  244  289  337
%e A399410     19   52   91   135  180  228  277  328  380
%e A399410     23   60   104  151  201  255  311  365  423
%t A399410 x = Sqrt[1/2]; u[n_, k_] := Sum[Floor[k (n + x)/h - x], {h, 1, Floor[k (n + x)/(1 + x)]}]
%t A399410 t = Table[u[n, k], {n, 1, 12}, {k, 1, 12}]; Grid[t]  (* array *)
%t A399410 Table[u[n - k + 1, k], {n, 1, 12}, {k, n, 1, -1}] // Flatten (* sequence *)
%Y A399410 Cf. A399406.
