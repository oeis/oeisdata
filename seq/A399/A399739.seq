%S A399739 1,3,3,5,5,9,7,9,9,15,11,15,13,21,15,17,17,27,19,25,21,33,23,27,25,39,
%T A399739 27,35,29,45,31,33,33,51,35,45,37,57,39,45,41,63,43,55,45,69,47,51,49,
%U A399739 75,51,65,53,81,55,63,57,87,59,75,61,93,63,65,65,99,67,85,69,105
%N A399739 The sum of the unitary divisors d of n such that n/d is a power of 2.
%C A399739 The number of these divisors is A040001(n).
%C A399739 The sum of the complementary divisors is A385047(n).
%H A399739 Amiram Eldar, <a href="/A399739/b399739.txt">Table of n, a(n) for n = 1..10000</a>
%F A399739 a(n) = Sum_{d | n, gcd(d, n/d) = 1, A209229(n/d) = 1} d.
%F A399739 a(n) = n * A034448(n) / A399738(n).
%F A399739 Multiplicative with a(2^e) = 2^e + 1, and a(p^e) = p^e for an odd prime p.
%F A399739 Dirichlet g.f.: ((1-1/2^(2*s-1))/(1-1/2^s)) * zeta(s-1).
%F A399739 Sum_{k=1..n} a(k) ~ 7 * n^2 / 12.
%t A399739 f[p_, e_] := p^e; f[2, e_] := 2^e + 1; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A399739 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, f[i,1]^f[i,2] + (f[i,1] % 2 == 0));}
%Y A399739 Cf. A034448, A038712, A040001, A129527 (analogous with all divisors), A209229, A385047.
%Y A399739 The sum of the unitary divisors d of n such that n/d is: A363289 (squarefree), A399732 (cubefree), A399733 (powerful), A399734 (cubefull), A399735 (square), A399736 (exponentially odd), A399737 (cube), A399738 (odd), this sequence (power of 2), A399740 (perfect power).
%K A399739 nonn,mult,easy,new
%O A399739 1,2
