%p A399337 # Using function 'binomial_matrix' from A399000.
%p A399337 BM := binomial_matrix(n -> simplify(hypergeom([-n,-n],[1],2))):
%p A399337 M := Matrix(8, 8, (n, k) -> BM(n-1, k-1));
%p A399337 seq(seq(BM(n-k, k), k = 0..n), n = 0..9);
%t A399337 (* Uses the function 'binomialMatrix' from A399000. *)
%t A399337 bM = binomialMatrix[Hypergeometric2F1[-#, -#, 1, 2] &];
%t A399337 Table[bM[n, k], {n, 0, 7}, {k, 0, 7}] // MatrixForm
%o A399337 (Python)  # Using function binomial_matrix from A399000.
%o A399337 from mpmath import hyp2f1
%o A399337 M = binomial_matrix(lambda n: int(hyp2f1(-n, -n, 1, 2)))
%o A399337 for n in range(8): print([M(n, k) for k in range(9)])
