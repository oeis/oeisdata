%S A399599 1,4,18,8,735,65065,16,375,1446445,30715685,32,855189335,207245839801,
%T A399599 9152243699599,46585,12005,415808693487187,18751957908727043,64,
%U A399599 963327326055303209,540204098376659741453,34069482204399167761807,2507178780582751870209043,4917913,188637137804741077279459489
%N A399599 a(1) = 1, a(n) is the smallest number k of the form p_i^m * rad(k) such that A008479(k) = binomial(i+m, m) corresponding to prime power prime(i)^m = A000961(n), where p_i is the i-th smallest distinct prime factor of k.
%C A399599 Let s = A000961 and let p_i denote the i-th smallest distinct prime factor of k.
%C A399599 For n > 1, a(n) is the smallest number k of the form p_i^m * rad(k), writing p_i^m instead of s(n) = prime(i)^m, such that k minimizes A008479(k). The minimum A008479(k) = A399600(k) = binomial(i+m,m).
%H A399599 Michael De Vlieger, <a href="/A399599/b399599.txt">Table of n, a(n) for n = 1..374</a>
%e A399599 Let w(k) = row k of A369609 be the list of j <= k such that rad(j) = rad(k).
%e A399599 Let t(n) = A399598(n).
%e A399599 Let R be the range of indices of prime factors of rad(a(n)).
%e A399599 Table of n, s(n), p_i^m, t(n), and a(n) for n = 1..12:
%e A399599    n  s(n)   p_i^m  t(n)       a(n)  R      w(a(n))
%e A399599   --------------------------------------------------------------------
%e A399599    1   1     1       1           1          {1}
%e A399599    2   2^1   p_1^1   2           4   1      {2, 4}
%e A399599    3   3^1   p_2^1   3          18   1..2   {6, 12, 18}
%e A399599    4   2^2   p_1^2   3           8   1      {2, 4, 8}
%e A399599    5   5^1   p_3^1   4         735   2..4   {105, 315, 525, 735}
%e A399599    6   7^1   p_4^1   5       65065   3..6   {5005, 25025, 35035, 55055, 65065}
%e A399599    7   2^3   p_1^3   4          16   1      {2, 4, 8, 16}
%e A399599    8   3^2   p_2^2   6         375   2..3   {15, 45, 75, 135, 225, 375}
%e A399599    9  11^1   p_5^1   6     1446445   3..7   {85085, 425425, ..., 1446445}
%e A399599   10  13^1   p_6^1   7    30715685   3..8   {1616615, 8083075, ..., 30715685}
%e A399599   11   2^4   p_1^4   5          32   1      {2, 4, 8, 16, 32}
%e A399599   12  17^1   p_7^1   8   855189335   3..10  {37182145, 185910725, ..., 855189335}
%t A399599 lim = 60;
%t A399599 f[i_Integer, m_Integer : 1] :=
%t A399599   If[i == 0, 1,
%t A399599     Module[{j}, j = 1;
%t A399599       While[Log[Prime[j], Prime[i + j - 1]] > (m + 1)/(m), j++];
%t A399599       Times @@ #*Last[#]^m &@ Prime@ Range[j, i + j - 1] ] ];
%t A399599 s = SortBy[Apply[Join,
%t A399599   Table[{p, m}, {m, Log2[lim]}, {p, Prime@ Range@ PrimePi@ Surd[lim, m] } ] ],
%t A399599   Power[#1, #2] & @@ # &];
%t A399599 {1}~Join~MapApply[f[PrimePi[#1], #2] &, s]
%Y A399599 Cf. A000961, A007947, A008479, A369609, A399598, A399600.
%K A399599 nonn,easy,new
%O A399599 1,2
%A A399599 _Michael De Vlieger_, Sep 23 2026
