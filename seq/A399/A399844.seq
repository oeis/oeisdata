%N A399844 Number of compositions (ordered partitions) of n such that (greatest part) - (least part) <= number of parts.
%F A399844 G.f.: Sum_{j>=1} x^j * ( (1 - x^(j+1))^j - x^j*(1 - x^j)^j ) / ( (1 - x)^j * (1 - x^j) ).
%e A399844 a(5) = 14 because we have [5], [3,2], [2,3], [3,1,1], [1,3,1], [1,1,3], [2,2,1], [2,1,2], [1,2,2], [2,1,1,1], [1,2,1,1], [1,1,2,1], [1,1,1,2] and [1,1,1,1,1].
%t A399844 nmax = 36; CoefficientList[Series[Sum[x^j ((1 - x^(j + 1))^j - x^j (1 - x^j)^j)/((1 - x)^j (1 - x^j)), {j, 1, nmax}], {x, 0, nmax}], x] // Rest
%o A399844 (PARI) A399844_first(N)=my(x='x+O('x^N++)); Vec(sum(j=1,N, x^j*((1-x^(j+1))^j-x^j*(1-x^j)^j)/((1-x)^j*(1-x^j)))) \\ _M. F. Hasler_, Nov 23 2026
