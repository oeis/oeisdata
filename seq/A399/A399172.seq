%N A399172 a(n) = 2^((2^n-(-1)^n)/3).
%C A399172 a(11) has 206 digits.
%D A399172 Răzvan Gelca and Titu Andreescu, Putnam and Beyond, Springer 2007, pp. 99, 462.
%H A399172 Stefano Spezia, <a href="/A399172/b399172.txt">Table of n, a(n) for n = 0..13</a>
%F A399172 a(n) = 2^A001045(n).
%F A399172 a(n) = floor(u(n)), where u is defined by u(0) = 2, u(1) = 5/2, and u(n) = u(n-1)*(u(n-2)^2 - 2) - u(1) for n > 0 (see Gelca and Andreescu).
%F A399172 a(2*n-1) = A174736(n).
%p A399172 a:= n-> 2^round(2^n/3):
%p A399172 seq(a(n), n=0..10);  # _Alois P. Heinz_, Aug 21 2026
%t A399172 a[n_]:=2^((2^n-(-1)^n)/3); Array[a,11,0]
%t A399172 (* Alternative: *)
%t A399172 u[0]=2; u[1]=5/2; u[n_]:=u[n]=u[n-1]*(u[n-2]^2-2)-u[1]; a[0]=1; a[n_]:=Floor[u[n]]; Array[a,11,0]
