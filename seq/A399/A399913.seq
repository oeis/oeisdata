%I A399913 #4 Sep 21 2026 21:32:36
%S A399913 1,1,2,1,1,0,2,5,7,5,3,2,0,1,0,0,3,11,23,33,31,24,14,9,3,3,2,0,0,1,0,
%T A399913 0,0,6,25,72,138,199,221,206,165,116,75,44,25,12,11,3,2,2,2,0,0,0,1,0,
%U A399913 0,0,0,10,60,210,524,982,1473,1832,1986,1885,1618,1258
%N A399913 Irregular triangle read by rows: T(n,k) is the number of connected transitive relations on n unlabeled points with no isolated point and exactly k related pairs, 1 <= k <= n^2.
%C A399913 "Connected" means that the undirected graph obtained by ignoring loops and directions is connected. For n >= 2 a connected relation automatically has no isolated point; the condition only matters for n = 1, where it excludes the empty relation.
%C A399913 T(n,k) = 0 for k < n-1, since a connected relation on n points needs at least n-1 related pairs. T(n,k) = A399030(n,k) for k > (n-1)^2 + 1, since a disconnected relation on n points has at most (n-1)^2 + 1 related pairs.
%C A399913 Column k = n-1 counts the connected relations whose underlying graph is a tree. Transitivity then forbids any directed path of length 2, so every point is a source or a sink, and T(n,n-1) = A122086(n) = A125702(n) for n >= 2.
%C A399913 The terms were obtained by inverting the bivariate Euler transform in the Formula section on rows 1-10 of A399030. Rows 1-4 agree with a direct enumeration, as do all entries with k <= 6, and column k = n-1 agrees with A122086 for 2 <= n <= 10.
%F A399913 1 + Sum_{n>=1, k>=1} A399030(n,k)*x^k*y^n = Product_{n>=1, k>=1} 1/(1 - x^k*y^n)^T(n,k).
%F A399913 Sum_{k=1..n^2} T(n,k) = A296105(n) for n >= 2.
%F A399913 T(n,n-1) = A122086(n) for n >= 2.
%F A399913 A399771(d) = Sum_{k=ceiling((d+1)/2)..d+1} T(2*k-d, k).
%e A399913 Triangle begins (row n, k = 1..n^2):
%e A399913 n=1: 1;
%e A399913 n=2: 1, 2, 1, 1;
%e A399913 n=3: 0, 2, 5, 7, 5, 3, 2, 0, 1;
%e A399913 n=4: 0, 0, 3, 11, 23, 33, 31, 24, 14, 9, 3, 3, 2, 0, 0, 1;
%e A399913 n=5: 0, 0, 0, 6, 25, 72, 138, 199, 221, 206, 165, 116, 75, 44, 25, 12, 11, 3, 2, 2, 2, 0, 0, 0, 1;
%e A399913 T(2,2) = 2: {(a,a),(a,b)} and {(a,b),(b,b)}. The third relation with two related pairs on two points, {(a,a),(b,b)}, is counted by A399030(2,2) = 3 but is not connected.
%o A399913 (Python)
%o A399913 from math import comb
%o A399913 def connected_triangle(bfile='b399030.txt'):  # needs the b-file of A399030 (rows 1..10)
%o A399913     t = [int(l.split()[1]) for l in open(bfile) if l.strip() and l[0] != '#']
%o A399913     V, K, i, T = 10, 100, 0, {}
%o A399913     for n in range(1, V + 1):
%o A399913         for k in range(1, n * n + 1): T[n, k] = t[i]; i += 1
%o A399913     P = [[0] * (K + 1) for _ in range(V + 1)]; P[0][0] = 1; D = {}
%o A399913     for v in range(1, V + 1):
%o A399913         lev = {(e, v): T[v, e] - P[v][e] for e in range(1, v * v + 1) if T[v, e] != P[v][e]}
%o A399913         for (e, _), m in lev.items():
%o A399913             Q = [r[:] for r in P]
%o A399913             for n in range(V + 1):
%o A399913                 for k in range(K + 1):
%o A399913                     j = 1
%o A399913                     while P[n][k] and n + j * v <= V and k + j * e <= K:
%o A399913                         Q[n + j * v][k + j * e] += P[n][k] * comb(m + j - 1, j); j += 1
%o A399913             P = Q
%o A399913         D.update(lev)
%o A399913     return [[D.get((k, n), 0) for k in range(1, n * n + 1)] for n in range(1, V + 1)]
%o A399913 for row in connected_triangle(): print(row)
%Y A399913 Row sums: A296105 (n >= 2). Column k = n-1: A122086, A125702.
%Y A399913 Cf. A399030 (bivariate Euler transform of this triangle), A399304, A091073, A399771 (sums along lines of constant defect), A399767.
%K A399913 nonn,tabf,new
