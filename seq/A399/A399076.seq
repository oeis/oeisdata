%N A399076 G.f.: (Sum_{k>=1} x^(3*k)/(1 - x^(3*k))) * Product_{k>=1} (1 + x^k)/(1 - x^k).
%H A399076 Vaclav Kotesovec, <a href="/A399076/b399076.txt">Table of n, a(n) for n = 0..10000</a>
%F A399076 a(n) ~ exp(Pi*sqrt(n)) * (2*gamma + log(4*n/(9*Pi^2))) / (24*Pi*sqrt(n)), where gamma is the Euler-Mascheroni constant A001620.
%F A399076 a(n) = Sum_{k=1..n/3} A000005(k)*A015128(n-3*k).
%t A399076 nmax = 50; CoefficientList[Series[Sum[x^(3*k)/(1-x^(3*k)), {k, 1, nmax}] * Product[(1+x^k)/(1-x^k), {k, 1, nmax}], {x, 0, nmax}], x]
