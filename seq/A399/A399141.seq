%I A399141 #19 Sep 28 2026 23:04:03
%S A399141 11,101,73,17,353,19841,76801,257,10753,1514497,307201,16384001,
%T A399141 163841,1146881,119603201,65537,8257537,104857601,639631361,70254593,
%U A399141 167772161,8519680000001,4194304001,104857600000001,1677721600001,1134139801601,2281701377
%N A399141 Smallest prime factor of F(n) = 10^(10^n)+1.
%C A399141 All a(n) must be of the form k * 2^(n+1) + 1.
%C A399141 a(75) > 377789318629571617095680000000000001.
%C A399141 a(75) <= 86469112845513523200000000000000000001.
%H A399141 Zhining Yang, <a href="/A399141/b399141.txt">Table of n, a(n) for n = 0..74</a>
%H A399141 Mathematics Stack Exchange, <a href="https://math.stackexchange.com/questions/5147612/the-least-prime-factor-q-n-of-the-n-th-generalized-fermat-numbers-g-n-1010">The least prime factor q_n of the n-th generalized Fermat numbers G_n = 10^10^n+1</a>.
%H A399141 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/FermatNumber.html">Fermat Number</a>.
%e A399141 F(0) = 10^(10^0) + 1 = 11, prime.
%e A399141 F(2) = 10^(10^2) + 1 = 10^100 + 1 = 73 * 137 * 401 * 1201 * 1601 * 1676321 * 5964848081 * 129694419029057750551385771184564274499075700947656757821537291527196801.
%e A399141 So a(0) = 11 and a(2) = 73.
%t A399141 a[n_]:=For[k=2,k<=10^7,k++,p=Prime@k;If[PowerMod[10,10^n,p]==p-1,Return[p]]];Table[a[n],{n,0,10}]
