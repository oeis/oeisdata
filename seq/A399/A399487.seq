%I A399487 #11 Sep 05 2026 22:58:50
%S A399487 1,3,6,5,7,5,5,6,3,1,2,1,4
%N A399487 Initial digit of the decimal expansion of n^(n^(n^8)).
%H A399487 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/BenfordsLaw.html">Benford's Law</a>.
%H A399487 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/PowerTower.html">Power Tower</a>.
%e A399487 a(1) = 1 because 1^(1^(1^8)) = 1.
%e A399487 a(2) = 3 because 2^(2^(2^8)) = 3792582...
%e A399487 a(3) = 6 because 3^(3^(3^8)) = 6125595... (can be confirmed with any tool that can evaluate log_10(3)*3^6561 to at least 3130 digits of precision)
%t A399487 f[base_, exp_] := IntegerPart[10^FractionalPart[N[exp*Log10[base], Floor[Log10[exp]] + 3]]];
%t A399487 Table[f[n, n^(n^8)], {n, 1, 13}]
%o A399487 (Python)
%o A399487 import mpmath as mp
%o A399487 def a(n):
%o A399487     if n==1:return 1
%o A399487     e=n**8
%o A399487     E=n**e
%o A399487     mp.mp.dps=int(e*mp.log10(n))+40
%o A399487     x=mp.mpf(E)*mp.log10(n)
%o A399487     f=x-mp.floor(x)
%o A399487     return int(mp.floor(mp.power(10, f)))
%o A399487 n=1
%o A399487 while True:
%o A399487     print(f"a({n}) = {a(n)}")
%o A399487     n+=1
%Y A399487 Cf. A395745, A395747, A398667.
%K A399487 nonn,base,more,hard,new
%O A399487 1,2
%A A399487 _Allam Assal_, Aug 29 2026
