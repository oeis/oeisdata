%I A399388 #4 Sep 02 2026 17:40:29
%S A399388 1,2,5,30,430,14744,1235254,261789634,144314545796,211191290473716,
%T A399388 832714471445947418,8946246205635264190386,
%U A399388 264207334362733198954861443,21604072242551150686709736003432
%N A399388 Number of nonisomorphic asymmetric antisymmetric binary relations on an n-element set.
%C A399388 Here, antisymmetric means that xRy and yRx imply x=y, while asymmetric means that the automorphism group of the relation is trivial. Diagonal pairs are allowed.
%F A399388 a(n) = (1/n!)*Sum_{H <= S_n} mu({1},H)*2^o_1(H)*3^s(H), where mu is the Möbius function of the subgroup lattice of S_n, o_1(H) is the number of H-orbits on [n], and s(H)=d(H)-u(H), with d(H) the number of H-orbits on ordered pairs (i,j), i != j, and u(H) the number of H-orbits on 2-element subsets of [n].
%e A399388 For n=2, if exactly one vertex has a loop, there are three possibilities according as the off-diagonal pair is absent or is oriented in either direction. If both vertices have the same loop status, an oriented pair is required to destroy the transposition symmetry, giving one class for each of the two common loop statuses. Hence a(2)=3+2=5.
%o A399388 (GAP)
%o A399388 LoadPackage("tomlib");
%o A399388 a := function(n)
%o A399388 local tom, pairs, ordered, fix, i, H, o1, o2, odir, s, dec, triv;
%o A399388   tom := TableOfMarks(Concatenation("S", String(n)));
%o A399388   pairs := Combinations([1..n], 2);
%o A399388   ordered := Filtered(Cartesian([1..n], [1..n]),
%o A399388                       p -> p[1] <> p[2]);
%o A399388   fix := [];
%o A399388   for i in [1..Length(OrdersTom(tom))] do
%o A399388     H := RepresentativeTom(tom, i);
%o A399388     o1 := Length(OrbitsDomain(H, [1..n], OnPoints));
%o A399388     o2 := Length(OrbitsDomain(H, pairs, OnSets));
%o A399388     odir := Length(OrbitsDomain(H, ordered, OnPairs));
%o A399388     s := odir - o2;
%o A399388     Add(fix, 2^o1 * 3^s);
%o A399388   od;
%o A399388   dec := DecomposedFixedPointVector(tom, fix);
%o A399388   triv := Position(OrdersTom(tom), 1);
%o A399388   return dec[triv];
%o A399388 end;
%o A399388 List([4..13], a);
%K A399388 nonn,hard,more,new
%O A399388 0,2
%A A399388 _Vladeta Jovovic_, Aug 27 2026
