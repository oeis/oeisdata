%I A399672 #11 Sep 17 2026 09:47:57
%S A399672 36,1125,60025,420175,584043889,7592570557,98703417241,1283144424133,
%T A399672 16680877513729,216851407678477,2819068299820201,36647887897662613,
%U A399672 476422542669613969,6193493054704981597,83359568521042517459809,1583831801899807831736371,30092804236096348802991049
%N A399672 Smallest number k of the form lpf(k) * q(k)^n * rad(k) such that A008479(k) is minimized, where q(k) is the second smallest distinct prime factor of k and rad = A007947.
%C A399672 a(n) = k is the smallest number of the form lpf(k) * q(k)^n * rad(k) such that A008479(a(n)) = binomial(n+2,n+4) = (n + 2)*(n + 5)/2 = A000096(n-3).
%C A399672 Let m(i) = log prime(i+1)/log prime(i).
%C A399672 a(n) = prime(i)^2 * prime(i+1)^(2+n) with i such that (2+n)/(1+n) < m(i).
%H A399672 Michael De Vlieger, <a href="/A399672/b399672.txt">Table of n, a(n) for n = 0..438</a>
%e A399672 Let f = A008479(a(n)) = binomial(4+n, 2+n) and let m = (2+n)/(1+n), with q(pi(lpf(a(n))) > m.
%e A399672    n                  a(n)               f(a(n))   m
%e A399672   ----------------------------------------------------
%e A399672    0                   36 =  2^2 * 3^2       5     2
%e A399672    1                 1125 =  3^2 * 5^3       9    3/2
%e A399672    2                60025 =  5^2 * 7^4      14    4/3
%e A399672    3               420175 =  5^2 * 7^5      20    5/4
%e A399672    4            584043889 = 11^2 * 13^6     27    6/5
%e A399672    5           7592570557 = 11^2 * 13^7     35    7/6
%e A399672    6          98703417241 = 11^2 * 13^8     44    8/7
%e A399672    7        1283144424133 = 11^2 * 13^9     54    9/8
%e A399672    8       16680877513729 = 11^2 * 13^10    65   10/9
%e A399672    9      216851407678477 = 11^2 * 13^11    77   11/10
%e A399672   10     2819068299820201 = 11^2 * 13^12    90   12/11
%e A399672   11    36647887897662613 = 11^2 * 13^13   104   13/12
%e A399672   12   476422542669613969 = 11^2 * 13^14   119   14/13
%t A399672 Table[Module[{i}, i = 1; While[(2 + n)/(1 + n) < # &@ Log[Prime[i], Prime[i + 1] ], i++]; Prime[i]^2*Prime[i + 1]^(n + 2)], {n, 0, 20}]
%Y A399672 Cf. A000096, A007947, A008479, A020639, A119288.
%K A399672 nonn,easy,new
%O A399672 0,1
%A A399672 _Michael De Vlieger_, Sep 10 2026
