%T A399687 29,9,12,15,21,22,25,30,37,10,13,17,22,26,28,32,38,46,11,15,20,23,31,
%U A399687 32,35,40,47,56,12,16,21,25,32,37,39,43,49,57,67,13,17,22,28,33,43,44,47,52,59,68,79
%N A399687 Triangle read by rows: T(n,k) is the maximum number of colors that can be used in an edge-coloring of K_n containing no rainbow copy of the k-vertex cycle C_k, for 3 <= k <= n.
%C A399687 Equivalently, T(n,k) is the anti-Ramsey number AR(n,C_k), where C_k denotes the cycle on k vertices.
%C A399687 Montellano-Ballesteros and Neumann-Lara use h(n,p) for the minimum number of colors that forces a rainbow copy of C_p. Thus, replacing p by k, T(n,k) = h(n,k) - 1.
%H A399687 Paolo Xausa, <a href="/A399687/b399687.txt">Table of n, a(n) for n = 3..11028</a> (rows 3..150 of triangle, flattened).
%H A399687 T. F. Bloom, <a href="https://www.erdosproblems.com/1105">Erdős Problem 1105</a>.
%H A399687 J. J. Montellano-Ballesteros and V. Neumann-Lara, <a href="https://doi.org/10.1007/s00373-005-0619-y">An Anti-Ramsey Theorem on Cycles</a>, Graphs and Combinatorics, 21 (2005), 343-354.
%F A399687 T(n,k) = binomial(k-1,2)*floor(n/(k-1)) + binomial(n mod (k-1),2) + ceiling(n/(k-1)) - 1.
%e A399687 Triangle begins:
%e A399687   n\k| 3  4   5   6   7
%e A399687   ---+------------------
%e A399687    3 | 2;
%e A399687    4 | 3, 4;
%e A399687    5 | 4, 5,  7;
%e A399687    6 | 5, 7,  8, 11;
%e A399687    7 | 6, 8, 10, 12, 16;
%t A399687 A399687[n_, k_] := Binomial[k-1, 2]*Floor[#] + Binomial[Mod[n, k-1], 2] + Ceiling[#] - 1 & [n/(k-1)];
%t A399687 Table[A399687[n, k], {n, 3, 15}, {k, 3, n}] (* _Paolo Xausa_, Sep 07 2026 *)
%o A399687 (PARI) T(n, k) = binomial(k-1, 2)*(n\(k-1))+binomial(n%(k-1), 2)+ceil(n/(k-1))-1;
%Y A399687 Cf. A399683.
%K A399687 nonn,tabl,new
%O A399687 3,1
%A A399687 _Seiichi Manyama_, Sep 07 2026
