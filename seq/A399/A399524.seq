%I A399524 #8 Sep 01 2026 18:00:37
%S A399524 648,968,1125,1944,3872,4500,4563,5292,5400,8712,8748,9747,10952,
%T A399524 11907,12348,15488,18252,21125,21168,24200,25000,25947,25992,27648,
%U A399524 27783,31104,31752,34992,36963,36992,38988,41472,42592,43808,45000,47628,48600,48668,49923,49928,54925,55112,57800
%N A399524 Smaller of two successive powerful numbers (A001694) that are both Achilles numbers (A052486).
%C A399524 A001694(k) is a term if and only if A399522(k+1) = A399522(k) + 1.
%C A399524 This sequence is infinite since the asymptotic density of the Achilles numbers within the powerful numbers is larger than 1/2 (see A399522).
%H A399524 Amiram Eldar, <a href="/A399524/b399524.txt">Table of n, a(n) for n = 1..10000</a>
%H A399524 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%e A399524 648 = 2^3 * 3^4 = A001694(42) is a term since it is an Achilles number, and A001694(43) = 675 = 3^3 * 5^2 is also an Achilles number.
%t A399524 achillesQ[n_] := Module[{e = FactorInteger[n][[;; , 2]]}, AllTrue[e, # > 1 &] && GCD @@ e == 1];
%t A399524 seq[lim_] := Module[{pow = Union[Table[i^2*j^3, {j, 1, Surd[lim, 3]}, {i, 1, Sqrt[lim/j^3]}] // Flatten], ind, ind2}, ind = Position[pow, _Integer?achillesQ] // Flatten; ind2 = Position[Differences[ind], 1] // Flatten; pow[[ind[[ind2]]]]];
%t A399524 seq[60000]
%o A399524 (PARI) isAchilles(n) = if(n == 1, 0, my(e = factor(n)[, 2]); vecmin(e) > 1 && gcd(e) == 1);
%o A399524 list(lim) = {my(pow = List(), ind , ind2, ind3); for(j = 1, sqrtnint(lim\1, 3), for(i = 1, sqrtint(lim\j^3), listput(pow, i^2*j^3))); pow = Set(pow); ind = Vec(select(x -> isAchilles(x), pow, 1)); ind2 = select(i -> ind[i+1] == ind[i] + 1, vector(#ind - 1, i, i)); ind3 = apply(x -> ind[x], ind2); apply(x -> pow[x], ind3);}
%Y A399524 Subsequence of A001694 and A052486.
%Y A399524 A272714 is a subsequence.
%Y A399524 Cf. A399522, A399525.
%K A399524 nonn,easy,new
%O A399524 1,1
%A A399524 _Amiram Eldar_, Sep 01 2026
