%N A399074 G.f.: (Sum_{k>=1} x^(4*k)/(1 - x^(4*k))) / Product_{k>=1} (1 - x^k).
%H A399074 Vaclav Kotesovec, <a href="/A399074/b399074.txt">Table of n, a(n) for n = 0..10000</a>
%F A399074 a(n) ~ exp(Pi*sqrt(2*n/3)) * (log(3*n/(8*Pi^2)) + 2*gamma) / (16*Pi*sqrt(2*n)), where gamma is the Euler-Mascheroni constant A001620.
%F A399074 a(n) = Sum_{k=1..n/4} A000005(k)*A000041(n-4*k).
%t A399074 nmax = 60; CoefficientList[Series[Sum[x^(4*k)/(1-x^(4*k)), {k, 1, nmax}] / Product[1 - x^k, {k, 1, nmax}], {x, 0, nmax}], x]
%t A399074 (* Alternative: *)
%t A399074 Table[Sum[DivisorSigma[0, k]*PartitionsP[n-4*k], {k, 1, n/4}], {n, 0, 60}]
