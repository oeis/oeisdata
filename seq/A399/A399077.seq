%N A399077 G.f.: (Sum_{k>=1} x^(4*k)/(1 - x^(4*k))) * Product_{k>=1} (1 + x^k)/(1 - x^k).
%H A399077 Vaclav Kotesovec, <a href="/A399077/b399077.txt">Table of n, a(n) for n = 0..10000</a>
%F A399077 a(n) ~ exp(Pi*sqrt(n)) * (2*gamma + log(n/(4*Pi^2))) / (32*Pi*sqrt(n)), where gamma is the Euler-Mascheroni constant A001620.
%F A399077 a(n) = Sum_{k=1..n/4} A000005(k)*A015128(n-4*k).
%t A399077 nmax = 50; CoefficientList[Series[Sum[x^(4*k)/(1-x^(4*k)), {k, 1, nmax}] * Product[(1+x^k)/(1-x^k), {k, 1, nmax}], {x, 0, nmax}], x]
%Y A399077 Cf. A305102, A305104, A399076.
%Y A399077 Cf. A000005, A015128.
