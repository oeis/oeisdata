%e A399666 The first four rows are identical to those of the array of unsigned Stirling_1 numbers A132393.
%p A399666 # Using the function BellMatrix from A264428:
%p A399666 LCM := proc(n) option remember; ifelse(n=0, 1, ilcm(n, LCM(n-1))) end:
%p A399666 BellMatrix(LCM, 9);
%t A399666 Trow[n_] := With[{lcmSeq = Table[If[j <= 2, 1, LCM @@ Range[1, j - 1]], {j, 1, Max[1, n]}]}, Table[BellY[n, k, lcmSeq], {k, 0, n}]]; Table[Trow[n], {n,0,7}]
%o A399666 (Python)
%o A399666 from functools import cache
%o A399666 from math import lcm
%o A399666 @cache
%o A399666 def LCM(n: int) -> int:
%o A399666     if n <= 0: return 1 if n == 0 else 0
%o A399666     return lcm(n, LCM(n - 1))
%o A399666 @cache
%o A399666 def T(n: int, k: int) -> int:
%o A399666     if n == k: return 1
%o A399666     if k <= 0 or k > n: return 0
%o A399666     total = 0; binom = 1
%o A399666     for j in range(n - k + 1):
%o A399666         total += binom * T(n - j - 1, k - 1) * LCM(j)
%o A399666         binom = binom * (n - 1 - j) // (j + 1)
%o A399666     return total
%o A399666 for n in range(9): print([T(n, k) for k in range(n + 1)])
%o A399666 for n in range(7): print([T(n + k, k) for k in range(7)])
