%I A399200 #17 Aug 27 2026 22:32:28
%S A399200 0,1,2,3,355,5419351,1480524883,3618458675,8717442233,21053343141,
%T A399200 139755218526789,5278450338718437,6134899525417045,66627445592888887,
%U A399200 2646693125139304345,37535589513263342053361,436681609736090076010871,23294267674065827396789607
%N A399200 Numbers k such that (cos(k))^k sets a new record low.
%C A399200 Every term greater than 2 is the numerator of a convergent (A002485/A002486) or of a semiconvergent to Pi having both numerator and denominator odd.
%H A399200 Jwalin Bhatt, <a href="/A399200/b399200.txt">Table of n, a(n) for n = 1..1207</a>
%H A399200 Dong Han Kim, Seul Bee Lee, and Lingmin Liao, <a href="https://arxiv.org/abs/2403.12341">Diophantine approximation by rational numbers of certain parity types</a>, arXiv:2403.12341 [math.NT], 2024.
%e A399200 The first few values of (cos(k))^k are:
%e A399200   cos(0)^0 =  1
%e A399200   cos(1)^1 =  0.540302305868139
%e A399200   cos(2)^2 =  0.173178189568194
%e A399200   cos(3)^3 = -0.97027693792150
%e A399200   cos(4)^4 =  0.182542548055270
%e A399200   cos(5)^5 =  0.001836568887601
%e A399200   cos(6)^6 =  0.783591241730686
%e A399200   cos(7)^7 =  0.138422055397017
%e A399200   cos(8)^8 =  0.000000200865224
%e A399200   cos(9)^9 = -0.43273721139612
%e A399200 and the record low points are at k = 0, 1, 2, 3, ...
%t A399200 Module[{x, y, runningMin = 2, positions = {}},
%t A399200   x = Range[0, 10^6]; y = Cos[x]^x;
%t A399200   Do[If[y[[i]] < runningMin, runningMin = y[[i]]; AppendTo[positions, x[[i]]]; ], {i, Length[y]}];
%t A399200   positions
%t A399200 ]
%o A399200 (Python)
%o A399200 from sympy import pi, continued_fraction_iterator
%o A399200 from itertools import islice
%o A399200 from mpmath import iv
%o A399200 cf = [int(a) for a in islice(continued_fraction_iterator(pi), 30)]
%o A399200 P, Q = [0, 1], [1, 0]
%o A399200 for a in cf:
%o A399200     P.append(a*P[-1] + P[-2]); Q.append(a*Q[-1] + Q[-2])
%o A399200 cands = [0, 1, 2]
%o A399200 for j, a in enumerate(cf):
%o A399200     for i in range(1, a+1):
%o A399200         p, q = P[j] + i*P[j+1], Q[j] + i*Q[j+1]
%o A399200         if p > 2 and p % 2 and q % 2: cands.append(p)
%o A399200 running_min, A399200 = iv.mpf(2), []
%o A399200 for k in cands:
%o A399200     while True:
%o A399200         x = iv.cos(k)**k
%o A399200         if (comparison:=x<running_min) is None:
%o A399200             iv.dps += 1
%o A399200             running_min = iv.cos(A399200[-1])**A399200[-1]
%o A399200         else: break
%o A399200     if comparison:
%o A399200         A399200.append(k)
%o A399200         running_min = x
%o A399200 print(A399200)
%Y A399200 Cf. A002485, A002486, A382564, A383283, A383541.
%K A399200 nonn,new
%O A399200 1,3
%A A399200 _Jwalin Bhatt_, Aug 22 2026
