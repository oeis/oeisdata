%S A399738 1,2,4,4,6,8,8,8,10,12,12,16,14,16,24,16,18,20,20,24,32,24,24,32,26,
%T A399738 28,28,32,30,48,32,32,48,36,48,40,38,40,56,48,42,64,44,48,60,48,48,64,
%U A399738 50,52,72,56,54,56,72,64,80,60,60,96,62,64,80,64,84,96,68,72,96,96,72
%N A399738 The sum of the unitary divisors d of n such that n/d is odd.
%C A399738 First differs from A246601 at n = 21.
%C A399738 The number of these divisors is A068068(n).
%C A399738 The sum of the complementary divisors is A192066(n).
%H A399738 Amiram Eldar, <a href="/A399738/b399738.txt">Table of n, a(n) for n = 1..10000</a>
%F A399738 a(n) = Sum_{d | n, gcd(d, n/d) = 1, A000035(n/d) = 1} d.
%F A399738 a(n) = n * A034448(n) / A399739(n).
%F A399738 Multiplicative with a(2^e) = 2^e, and a(p^e) = p^e + 1 for an odd prime p.
%F A399738 Dirichlet g.f.: ((1-1/2^s)/(1-1/2^(2*s-1))) * zeta(s-1) * zeta(s) / zeta(2*s-1).
%F A399738 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = (6/7)*zeta(2)/zeta(3) = 1.17294238081731932206... .
%t A399738 f[p_, e_] := p^e + 1; f[2, e_] := 2^e; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A399738 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, f[i,1]^f[i,2] + (f[i,1] % 2 == 1));}
%Y A399738 Cf. A000035, A002131 (analogous with all divisors), A034448, A068068, A192066, A246601, A306633.
%Y A399738 Cf. A002117, A013661, A306633.
%Y A399738 The sum of the unitary divisors d of n such that n/d is: A363289 (squarefree), A399732 (cubefree), A399733 (powerful), A399734 (cubefull), A399735 (square), A399736 (exponentially odd), A399737 (cube), this sequence (odd), A399739 (power of 2), A399740 (perfect power).
