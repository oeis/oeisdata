%I A399127 #8 Sep 05 2026 17:18:12
%S A399127 18,75,90,126,147,198,234,245,306,342,414,522,525,558,605,630,666,738,
%T A399127 774,825,845,846,847,954,975,990,1062,1098,1170,1183,1206,1275,1278,
%U A399127 1314,1386,1422,1425,1445,1494,1530,1602,1617,1638,1710,1725,1746,1805,1818,1854
%N A399127 Numbers k = rad(k) * q(k) such that A008479(k) = 3, where rad = A007947 and q(k) = second smallest distinct prime factor of k.
%C A399127 Numbers k in A398442 such that A008479(k) is minimum.
%C A399127 Proper subset of A332785 (neither squarefree nor powerful).
%C A399127 Smallest k such that prime(i) | k for i >= 1 is prime(i) * prime(i+1)^2.
%C A399127 Smallest k with j > 1 distinct prime factors is 3 * A002110(j).
%C A399127 A397742 is the union of this sequence and A399125. This sequence is "block B" in the comments at A397742.
%H A399127 Michael De Vlieger, <a href="/A399127/b399127.txt">Table of n, a(n) for n = 1..10000</a>
%e A399127 Let S = {m < n : rad(m) = rad(n)}.
%e A399127 Table of n, a(n) for select n:
%e A399127       n       a(n)                                   S(n)
%e A399127   --------------------------------------------------------------------
%e A399127       1        18 = 2 * 3^2                          {6, 12}
%e A399127       2        75 = 3 * 5^2                          {15, 45}
%e A399127       3        90 = 2 * 3^2 * 5                      {30, 60}
%e A399127       4       126 = 2 * 3^2 * 7                      {42, 84}
%e A399127       8       245 = 5 * 7^2                          {35, 175}
%e A399127      16       630 = 2 * 3^2 * 5 * 7                  {210, 420}
%e A399127      23       847 = 7 * 11^2                         {77, 539}
%e A399127      50      1859 = 11 * 13^2                        {143, 1573}
%e A399127      98      3757 = 13 * 17^2                        {221, 2873}
%e A399127     179      6930 = 2 * 3^2 * 5 * 7 * 11             {2310, 4620}
%e A399127    2271     90090 = 2 * 3^2 * 5 * 7 * 11 * 13        {30030, 60060}
%e A399127   38514   1531530 = 2 * 3^2 * 5 * 7 * 11 * 13 * 17   {510510, 1021020}
%t A399127 facs[x_] := facs[x] = FactorInteger[x][[All, 1]];
%t A399127 s = Select[Range[2, 2000], Not @* PrimePowerQ];
%t A399127 t = Select[s, #1/Apply[Times, #2] == #2[[2]] & @@
%t A399127   {#, facs[#]} &];
%t A399127 Select[t,
%t A399127   Function[{m, r},
%t A399127     Count[Range[m], _?(Times @@ facs[#] == r &)] == 3] @@
%t A399127     {#, Times @@ facs[#]} &]
%Y A399127 Cf. A007947, A008479, A119288, A332785, A397742, A398442.
%K A399127 nonn,new
%O A399127 1,1
%A A399127 _Michael De Vlieger_, Aug 23 2026
