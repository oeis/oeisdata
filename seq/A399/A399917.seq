%T A399917 14,21,20,18,11,5,1,1,1,1,2,4,9,17,34,53,69,76,66,41,22,9,3,2,1,1,1,2,
%U A399917 4,9,18,40,79,145,223,308,341,308,207,118,53,25,9,4,1
%N A399917 Irregular triangle read by rows: T(n,k) is the number of triangle-free graphs on n unlabeled nodes with exactly k edges, 0 <= k <= floor(n^2/4).
%C A399917 By Mantel's theorem a triangle-free graph on n nodes has at most floor(n^2/4) edges.
%H A399917 Brian Klemm, <a href="/A399917/b399917.txt">Table of n, a(n) for n = 0..388</a> (rows 0..16).
%F A399917 T(n,k) = A008406(n,k) for k <= 2, since a triangle needs three edges.
%e A399917 Triangle begins:
%e A399917   n=0: 1;
%e A399917   n=1: 1;
%e A399917   n=2: 1, 1;
%e A399917   n=3: 1, 1, 1;
%e A399917   n=4: 1, 1, 2, 2, 1;
%e A399917   n=5: 1, 1, 2, 3, 4, 2, 1;
%e A399917   n=6: 1, 1, 2, 4, 7, 9, 7, 4, 2, 1;
%e A399917   ...
%e A399917 Row n=4 has T(4,2) = 2: the two graphs with two edges on four nodes are two disjoint edges, and a path on three nodes plus an isolated node.
%o A399917 (nauty) geng -t -u -v n
%Y A399917 Cf. A006785 (row sums), A002620 (row lengths).
%Y A399917 Cf. A396974 (labeled analog), A008406 (all graphs by nodes and edges), A084546 (all labeled graphs), A283417 (triangle-free graphs by number of components).
%K A399917 nonn,tabf,new
%O A399917 0,10
