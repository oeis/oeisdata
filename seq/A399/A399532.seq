%U A399532 1588961646189402153398795025,26033547611214519628521075387173,853067288124471344232076630479053673,55906617794526942977239563457228660308753
%N A399532 G.f. A(x) satisfies: A(x) = (1 - x^2 + x * A(2*x)) / (1 - x^3).
%F A399532 a(n) = 1 for n < 3; a(n) = 2^(n-1) * a(n-1) + a(n-3).
%t A399532 nmax = 17; A[_] = 1; Do[A[x_] = (1 - x^2 + x A[2 x])/(1 - x^3) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A399532 (* Alternative: *)
%t A399532 a[0] = a[1] = a[2] = 1; a[n_] := a[n] = 2^(n - 1) a[n - 1] + a[n - 3]; Table[a[n], {n, 0, 17}]
