%S A399471 1,1,1,1,1,3,1,1,1,1,1,7,1,1,3,1,1,4,1,1,4,1,1,1,16,1,1,1,3,1,16,1,1,
%T A399471 1,1,1,15,7,1,1,1,9,1,6,5,1,1,7,1,1,31,1,1,1,1,1,1,4,5,1,1,7,1,1,1,68,
%U A399471 18,1,1,4,1,1,4,5,1,1,1,4,2,1,46,28,3,1,1
%N A399471 Irregular array read by rows: T(n, k) is the number of inclusion-maximal Sidon subsets of the set of positive divisors of n having cardinality k, for A399469(n) <= k <= A398434(n).
%C A399471 Let D(n) be the set of positive divisors of n. A Sidon subset of D(n) is a subset for which all positive differences between distinct elements are different; equivalently, all unordered sums of two not necessarily distinct elements are different.
%C A399471 "Inclusion-maximal" means that no further element of D(n) can be adjoined while preserving the Sidon property.
%C A399471 The support of row n is the maximal Sidon spectrum of D(n), namely {k : T(n, k) > 0}.
%C A399471 The row sum is A399470(n).
%C A399471 This is the divisor-set analog of A399118.
%H A399471 Felix Huber, <a href="/A399471/b399471.txt">Rows n = 1..1259, flattened</a>
%H A399471 Wikipedia, <a href="https://en.wikipedia.org/wiki/Sidon_sequence">Sidon sequence</a>.
%H A399471 <a href="/index/Go#Golomb">Index entries for sequences related to Golomb rulers</a>.
%F A399471 Sum_{k=A399469(n)..A398434(n)} T(n, k) = A399470(n).
%F A399471 min{k : T(n, k) > 0} = A399469(n).
%F A399471 max{k : T(n, k) > 0} = A398434(n).
%F A399471 If A398435(n) = 0, then T(n, A000005(n)) = 1 and this is the only entry in row n.
%F A399471 For prime p and e >= 1, T(p^e, e + 1) = 1.
%F A399471 For primes p < q, T(p*q, 3) = 3 if q = 2*p - 1; otherwise T(p*q, 4) = 1.
%e A399471 The array begins:
%e A399471   n\k |  1  2  3  4  5
%e A399471   ----+----------------
%e A399471     1 |  1
%e A399471     2 |     1
%e A399471     3 |     1
%e A399471     4 |        1
%e A399471     5 |     1
%e A399471     6 |        3
%e A399471     7 |     1
%e A399471     8 |           1
%e A399471     9 |        1
%e A399471    10 |           1
%e A399471    11 |     1
%e A399471    12 |           7
%e A399471    13 |     1
%e A399471    14 |           1
%e A399471    15 |        3
%e A399471    16 |              1
%e A399471    17 |     1
%e A399471    18 |           4  1
%e A399471 For n = 18, D(18) = {1, 2, 3, 6, 9, 18}. The four inclusion-maximal Sidon subsets of cardinality 4 are {1, 3, 6, 18}, {1, 3, 9, 18}, {2, 3, 6, 18}, and {2, 3, 9, 18}, and the unique inclusion-maximal Sidon subset of cardinality 5 is {1, 2, 6, 9, 18}. Hence T(18, 4) = 4 and T(18, 5) = 1, so row 18 is [4, 1].
%e A399471 For n = 17255, the values T(17255, k) for k = 10, 11, 12, 13, 14 are [6, 27, 45, 0, 1], so the maximal Sidon spectrum of D(17255) is {10, 11, 12, 14} and has a gap at 13.
%p A399471 row := proc(n) option remember; local a, d, f, g, h, k, l, m;
%p A399471     d := sort([op(NumberTheory:-Divisors(n))]); m := nops(d); a := Array(0 .. m, 'fill' = 0);
%p A399471     f := proc(j, u, v) local l;
%p A399471         if member(2*j, v) then return false end if;
%p A399471         for l in u do if member(j + l, v) then return false end if end do;
%p A399471         true
%p A399471     end proc;
%p A399471     g := proc(i, u, v) local j, l;
%p A399471         if i > m then
%p A399471             for j in d do if not member(j, u) and f(j, u, v) then return NULL end if end do;
%p A399471             a[nops(u)] := a[nops(u)] + 1;
%p A399471             return NULL
%p A399471         end if;
%p A399471         j := d[i];
%p A399471         if f(j, u, v) then g(i + 1, [op(u), j], v union {2*j, seq(j + l, l in u)}) end if;
%p A399471         g(i + 1, u, v)
%p A399471     end proc;
%p A399471     g(1, [], {});
%p A399471     l := 0;
%p A399471     while l <= m and a[l] = 0 do l := l + 1 end do;
%p A399471     h := m;
%p A399471     while h >= 0 and a[h] = 0 do h := h - 1 end do;
%p A399471     [l, h, [seq(a[k], k = l .. h)]]
%p A399471 end proc:
%p A399471 T := proc(n, k) option remember; local r;
%p A399471     r := row(n);
%p A399471     if k < r[1] or k > r[2] then return 0 end if;
%p A399471     r[3][k - r[1] + 1]
%p A399471 end proc:
%p A399471 seq(seq(T(n, k), k = row(n)[1] .. row(n)[2]), n = 1 .. 74);
