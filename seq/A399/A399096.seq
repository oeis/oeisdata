%U A399096 4,4,1,0,0,118,136,114,79,53,28,13,4,5,1,0,0,271,326,266,183,121,71,37,15,5,5,1,0,0,651,791,646,443,285,170,98,45,18,5,6,1,0
%N A399096 Triangle read by rows: T(n,k) is the number of trees on n unlabeled nodes with exactly k peripheral nodes.
%C A399096 The peripheral nodes of a graph are those with eccentricity equal to the diameter.
%H A399096 Andrew Howroyd, <a href="/A399096/b399096.txt">Table of n, a(n) for n = 1..1275</a> (rows 1..50)
%H A399096 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/GraphPeriphery.html">Graph Periphery</a>.
%e A399096 Triangle read by rows:
%e A399096   1;
%e A399096   0,  1;
%e A399096   0,  1,  0;
%e A399096   0,  1,  1,  0;
%e A399096   0,  1,  1,  1,  0;
%e A399096   0,  2,  1,  2,  1, 0;
%e A399096   0,  3,  3,  2,  2, 1, 0;
%e A399096   0,  6,  6,  5,  2, 3, 1, 0;
%e A399096   0, 11, 12, 11,  6, 3, 3, 1, 0;
%e A399096   0, 24, 26, 24, 15, 9, 3, 4, 1, 0;
%e A399096   ...
%o A399096 (PARI)
%o A399096 EulerMTS(p)={my(n=serprec(p,x)-1,vars=variables(p)); exp(sum(i=1, n, substvec(p + O(x*x^(n\i)), vars, apply(v->v^i,vars))/i))}
%o A399096 T(n) = {my(A=O(x*x^n), p=A, q=p+x*y, s=x*y+q^2); for(i=0, n\2, my(t=q-p); p=x*EulerMTS(p) + A; q=x*EulerMTS(q) + A; my(r=q-p); s += r-p*t + (r^2 + substvec(r,[x,y],[x^2,y^2]))/2  ); my(v=Vec(s)); vector(#v, i, Vecrev(v[i]/y,i)) }
%o A399096 { foreach(T(10), row, print(row)) }
%Y A399096 Row sums are A000055.
%Y A399096 Column 2 is A399148 for n > 1.
%Y A399096 Cf. A034853, A324244, A399097.
