%I A399490 #29 Sep 12 2026 12:14:47
%S A399490 1,10,29,74,135,244,371,572,789,1110,1441,1910,2379,3024,3655,4504,
%T A399490 5321,6402,7429,8770,10031,11660,13179,15124,16925,19214,21321,23982,
%U A399490 26419,29480,32271,35760,38929,42874,46445,50874,54871,59812,64259,69740,74661,80710,86129
%N A399490 Sum of squares of the elements of R(n), where R(n) is the set of n consecutive integers centered at n, with the center n omitted when n is even.
%C A399490 For each positive integer n, define the set S(n) as follows:
%C A399490 - If n is odd, n = 2m+1, then S(n) = {m+1, m+2, ..., 3m+1}.
%C A399490 - If n is even, n = 2m, then S(n) = {m, m+1, ..., 2m-1} U {2m+1, 2m+2, ..., 3m}.
%C A399490 In the even case, the central element n is omitted. This sequence gives the sum of the squares of the elements of S(n). The asymptotic behavior is a(n) ~ (13/12) n^3.
%H A399490 Paolo Xausa, <a href="/A399490/b399490.txt">Table of n, a(n) for n = 1..10000</a>
%F A399490 For n odd: a(n) = n*(13*n^2 - 1)/12.
%F A399490 For n even: a(n) = n*(13*n^2 + 3*n + 2)/12.
%e A399490 For n=1 (odd) : S(1) = {1}, so a(1) = 1^2 = 1.
%e A399490 For n=2 (even): S(2) = {1,3}, so a(2) = 1^2 + 3^2 = 1 + 9 = 10.
%e A399490 For n=3 (odd) : S(3) = {2,3,4}, so a(3) = 2^2 + 3^2 + 4^2 = 4 + 9 + 16 = 29.
%e A399490 For n=4 (even): S(4) = {2,3,5,6}, so a(4) = 4 + 9 + 25 + 36 = 74.
%t A399490 A399490[n_] := n*(13*n^2 + If[OddQ[n], -1, 3*n + 2])/12;
%t A399490 Array[A399490, 50] (* _Paolo Xausa_, Sep 11 2026 *)
%o A399490 (Python)
%o A399490 def a(n):
%o A399490     if n % 2 == 1:
%o A399490         return n * (13 * n * n - 1) // 12
%o A399490     else:
%o A399490         return n * (13 * n * n + 3 * n + 2) // 12
%o A399490 # First 50 terms
%o A399490 print([a(n) for n in range(1, 51)])
%o A399490 (PARI) row(n) = if (n%2, vector(n, k, n\2+k), setminus(vector(n+1, k, n\2+k-1), [n])); \\ A399500
%o A399490 a(n) = norml2(row(n)); \\ _Michel Marcus_, Sep 12 2026
