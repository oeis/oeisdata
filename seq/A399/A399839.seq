%I A399839 #8 Sep 19 2026 17:24:48
%S A399839 1,3,4,7,6,12,8,15,10,18,12,28,14,24,24,31,18,30,20,42,32,36,24,60,26,
%T A399839 42,40,56,30,72,32,63,48,54,48,70,38,60,56,90,42,96,44,84,60,72,48,
%U A399839 124,50,78,72,98,54,120,72,120,80,90,60,168,62,96,80,127,84,144,68,126
%N A399839 The sum of divisors d of n such that gcud(d, n/d) is a power of 2, where gcud is the greatest common unitary divisor.
%C A399839 First differs from A107749 at n = 27.
%C A399839 The number of these divisors is A399833(n).
%H A399839 Amiram Eldar, <a href="/A399839/b399839.txt">Table of n, a(n) for n = 1..10000</a>
%F A399839 Multiplicative with a(2^e) = 2^(e+1)-1, and if p is an odd prime a(p^e) = (p^(e+1)-1)/(p-1) for e odd, and (p^(e+1)-1)/(p-1) - p^(e/2) for e even.
%F A399839 Dirichlet g.f.: ((1 - 1/2^(2*s-1))/(1 - 1/2^(2*s-2) + 3/2^(3*s-1) - 1/2^(4*s-2))) * zeta(s-1) * zeta(s) * zeta(2*s-1) * Product_{p prime} (1 - 2/p^(2*s-1) + 1/p^(3*s-2) + 1/p^(3*s-1) - 1/p^(4*s-2)).
%F A399839 Sum_{k=1..n} a(k) ~ c * n^2, where c = (28/53) * zeta(2) * zeta(3) * Product_{p prime} (1 - 2/p^3 + 1/p^4 + 1/p^5 - 1/p^6) = 0.79545225464393361219... .
%t A399839 f[p_, e_] := (p^(e+1)-1)/(p-1) - If[OddQ[e], 0, p^(e/2)]; f[2, e_] := 2^(e+1)-1; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A399839 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, (f[i,1]^(f[i,2]+1)-1)/(f[i,1]-1) - if(f[i,1] > 2 && !(f[i,2] % 2), f[i,1]^(f[i,2]/2)));}
%Y A399839 Cf. A000079, A002117, A013661.
%Y A399839 Cf. A077610, A165430, A225174, A384244.
%Y A399839 Cf. A107749 (analogous with gcd), A399833.
%Y A399839 The sum of divisors d of n such that gcud(d, n/d) is: A188999 (1), A399834 (squarefree), A399835 (powerful), A399836 (square), A399837 (exponentially odd), A399838 (odd), this sequence (power of 2).
%K A399839 nonn,mult,easy,new
%O A399839 1,2
