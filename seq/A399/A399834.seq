%I A399834 #8 Sep 16 2026 22:47:21
%S A399834 1,3,4,7,6,12,8,15,13,18,12,28,14,24,24,27,18,39,20,42,32,36,24,60,31,
%T A399834 42,40,56,30,72,32,63,48,54,48,91,38,60,56,90,42,96,44,84,78,72,48,
%U A399834 108,57,93,72,98,54,120,72,120,80,90,60,168,62,96,104,119,84,144,68,126
%N A399834 The sum of divisors d of n such that gcud(d, n/d) is squarefree, where gcud is the greatest common unitary divisor.
%C A399834 First differs from A365170 and A365174 at n = 32, and from A399837 at n = 64.
%C A399834 The number of these divisors is A399828(n).
%H A399834 Amiram Eldar, <a href="/A399834/b399834.txt">Table of n, a(n) for n = 1..10000</a>
%F A399834 Multiplicative with a(p^e) = (p^(e+1)-1)/(p-1) if e is either 2 or odd, and (p^(e+1)-1)/(p-1) - p^(e/2) otherwise.
%F A399834 Dirichlet g.f.: zeta(s-1) * zeta(s) * zeta(2*s-1) * Product_{p prime} (1 - 1/p^(2*s-1) - 1/p^(4*s-2) + 1/p^(5*s-3) + 1/p^(5*s-2) - 1/p^(6*s-3)).
%F A399834 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = zeta(2) * zeta(3) * Product_{p prime} (1 - 1/p^3 - 1/p^6 + 1/p^7 + 1/p^8 - 1/p^9) = 1.63244578327256517874... .
%t A399834 f[p_, e_] := (p^(e+1)-1)/(p-1) - If[e == 2 || OddQ[e], 0, p^(e/2)]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100]
%o A399834 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, (f[i,1]^(f[i,2]+1)-1)/(f[i,1]-1) - if(f[i,2] > 3 && !(f[i,2] % 2), f[i,1]^(f[i,2]/2)));}
%Y A399834 Cf. A005117, A002117, A013661, A077610, A165430, A225174, A384244.
%Y A399834 Cf. A365170 (analogous with gcd), A365174, A399828.
%Y A399834 The sum of divisors d of n such that gcud(d, n/d) is: A188999 (1), this sequence (squarefree), A399835 (powerful), A399836 (square), A399837 (exponentially odd), A399838 (odd), A399839 (power of 2).
%K A399834 nonn,mult,easy,new
%O A399834 1,2
