%I A399130 #37 Sep 24 2026 22:12:13
%S A399130 1,1,5,3,4,1,1,2,5,94,14,5,4,1,3,124,2,209,1,10,5,130,15,2,42,4,339,
%T A399130 114,2,9,1,58,1,23,2,2,4,19,1,11,26,26,30,1,8,4,154,1,41,20,3,49,10,4,
%U A399130 27,41,10,12,4,6,1,3,18,260,15,2,2,3,80,47,89,2,36,5
%N A399130 a(n) is the least integer k such that 2^k * prime(n) is the average of two consecutive primes (or -1 if no such k exists).
%C A399130 Question: Is a(n) > 0 for all n >= 1?
%H A399130 Alois P. Heinz, <a href="/A399130/b399130.txt">Table of n, a(n) for n = 1..119</a>
%e A399130 a(9) = 5: prime(9) = 23 and (733 + 739)/2 = 736 = 2^5 * 23.
%p A399130 f:= proc(n) local k,r;
%p A399130    r:= ithprime(n);
%p A399130    for k from 1 do
%p A399130      r:= 2*r;
%p A399130      if nextprime(r) + prevprime(r) = 2*r then return k fi
%p A399130    od
%p A399130 end proc:
%p A399130 map(f, [$1..80]); # _Robert Israel_, Sep 24 2026
%Y A399130 Cf. A000040, A000079, A024675.
%K A399130 nonn,new
%O A399130 1,3
%A A399130 _Alois P. Heinz_ and _Martin Michael Musatov_, Sep 24 2026
