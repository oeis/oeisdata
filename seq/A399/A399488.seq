%N A399488 Number of permutations p of [n] such that lcm(i, p(i)) >= n for all i in [n].
%H A399488 Seiichi Manyama, <a href="/A399488/b399488.txt">Table of n, a(n) for n = 0..60</a>
%p A399488 a:= n-> `if`(n=0, 1, LinearAlgebra[Permanent](
%p A399488          Matrix(n, (i, j)-> `if`(ilcm(i, j)>=n, 1, 0)))):
%p A399488 seq(a(n), n=0..20);  # _Alois P. Heinz_, Aug 30 2026
%o A399488 (PARI) a(n) = matpermanent(matrix(n, n, i, j, lcm(i, j)>=n));
