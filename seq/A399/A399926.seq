%S A399926 1,1,2,3,1,1,4,5,5,5,2,3,6,7,7,7,7,7,1,1,1,1,2,3,2,3,2,3,4,5,5,5,10,
%T A399926 11,11,11,11,11,11,11,11,11,2,3,2,3,12,13,13,13,13,13,13,13,13,13,13,
%U A399926 13,6,7,7,7,7,7,8,15,10,10,15,12,10,15,1,1,1,1,1,1,1,1
%N A399926 Irregular triangle read by rows: T(n,k) = Product_{primes p divides n} (p - [m == 1 (mod p)]), where m = A038566(n,k) is the k-th number coprime to n, and [] is an Iverson branket.
%C A399926 Row n has length EulerPhi(n) and sum A306198(n).
%C A399926 Let R(n,m) = Product_{primes p divides n} (p - [m == 1 (mod p)]) (then T(n,k) = R(n,A038566(n,k))). As described in A306198, we have the following conjecture: Let c != 1 be a squarefree number, b be any positive integer such that b^2*c != -1 is not a perfect power, and n be a positive integer divisible by c if c == 1 (mod 4) or by 4*c otherwise. Then for gcd(m,n) = 1, the relative density among the primes of primes congruent to m modulo n that have b^2*c as a primitive root is (2*R(n,m)/A306198(n))*C if kronecker(c/m) = -1 and 0 if kronecker(c/m) = +1, where C is Artin's constant = A005596.
%H A399926 Jianing Song, <a href="/A399926/b399926.txt">Table of n, a(n) for n = 1..10060</a> (Rows n = 1..181)
%H A399926 Heath-Brown, <a href="https://surya-teja.com/2010/10/06/heath-brown-artin-primitive-roots-conjecture/">Artin Primitive Roots Conjecture</a>.
%H A399926 Oleksiy Klurman, Igor E. Shparlinski, and Joni Teräväinen, <a href="https://doi.org/10.1112/blms.70103">On Artin's conjecture on average and short character sums</a>. Bull. London Math. Soc., 57 (2025): 2429-2443.
%H A399926 Jianing Song, <a href="/A399926/a399926.txt">Table of R(n,m) for n = 1..1000</a>.
%H A399926 Wikipedia, <a href="https://en.wikipedia.org/wiki/Artin%27s_conjecture_on_primitive_roots">Artin's conjecture on primitive roots</a>.
%e A399926 Table begins
%e A399926   1,
%e A399926   1,
%e A399926   2, 3,
%e A399926   1, 1,
%e A399926   4, 5, 5, 5,
%e A399926   2, 3,
%e A399926   6, 7, 7, 7, 7, 7,
%e A399926   1, 1, 1, 1,
%e A399926   2, 3, 2, 3, 2, 3,
%e A399926   4, 5, 5, 5,
%e A399926   10, 11, 11, 11, 11, 11, 11, 11, 11, 11,
%e A399926   2, 3, 2, 3,
%e A399926   ...
%t A399926 Table[w = Select[Range[n], CoprimeQ[#, n] &]; Times @@ Map[Function[p, Map[p - Boole[Mod[#, p] == 1] &, w]], FactorInteger[n][[All, 1]]], {n, 16}] // Flatten (* _Michael De Vlieger_, Sep 16 2026 *)
%o A399926 (PARI) R(n,m) = my(v=factor(n)[,1]~, w=#v); prod(i=1, w, v[i]-(m%v[i]==1));
%o A399926 Row(n) = [R(n,m) | m <- [1..n], gcd(m, n) == 1];
%Y A399926 Cf. A306198, A005596, A038566.
%K A399926 nonn,tabf,new
%O A399926 1,3
