%S A399727 1,2,2,2,2,0,6,2,0,0,8,6,2,0,0,0,10,0,20,2,0,0,0,0,12,0,0,30,20,2,0,0,
%T A399727 0,0,0,14,0,0,0,42,0,70,2,0,0,0,0,0,0,16,0,0,0,0,56,0,0,112,70,2,0,0,
%U A399727 0,0,0,0,0,18,0,0,0,0,0,72,0,0,0,168,0,252
%N A399727 Irregular triangular array read by rows. T(n,k) is the number of subsets S of [n] such that |S|*(n-|S|) = k, 0<=k<=A002620(n), n>=0.
%C A399727 T(n,k)*2^k is the number of 2-colored graphs (A047863) such that the number of white nodes times the number of black nodes = k.
%H A399727 Alois P. Heinz, <a href="/A399727/b399727.txt">Rows n = 0..100, flatened</a>
%F A399727 Sum_{k>=0} Sum_{n>=0} T(n,k) * q^k*z^n/(n!*q^binomial(n,2)) = e(z)^2 where e(z) = Sum_{n>=0} z^n/(n!*q^binomial(n,2)).
%F A399727 Sum_{k=0..floor(n^2/4)} 2^k * T(n,k) = A047863(n).
%F A399727 From _Alois P. Heinz_, Oct 07 2026: (Start)
%F A399727 Sum_{k=0..floor(n^2/4)} k * T(n,k) = A001815(n).
%F A399727 Sum_{k=0..floor(n^2/4)} (floor(n^2/4) - k) * T(n,k) = A274497(n).
%F A399727 Sum_{k=0..floor(n^2/4)} (-1)^k * T(n,k) = A103424(n).
%F A399727 T(n,A002620(n)) = A128014(n+1). (End)
%e A399727 Triangle begins:
%e A399727   1;
%e A399727   2;
%e A399727   2, 2;
%e A399727   2, 0, 6;
%e A399727   2, 0, 0, 8, 6;
%e A399727   2, 0, 0, 0, 10, 0, 20;
%e A399727   2, 0, 0, 0, 0, 12,  0,  0, 30, 20;
%e A399727   2, 0, 0, 0, 0,  0, 14,  0,  0,  0, 42, 0, 70;
%e A399727   2, 0, 0, 0, 0,  0,  0, 16,  0,  0,  0, 0, 56, 0, 0, 112, 70;
%e A399727   ...
%p A399727 b:= proc(n) b(n):= add(binomial(n, k)*x^(k*(n-k)), k=0..n) end:
%p A399727 T:= (n, k)-> coeff(b(n), x, k):
%p A399727 seq(seq(T(n,k), k=0..floor(n^2/4)), n=0..9);  # _Alois P. Heinz_, Oct 07 2026
%t A399727 nn = 9; B[n_] := n! q^Binomial[n, 2];e[z_] := Sum[z^n/B[n], {n, 0, nn}];
%t A399727 Map[CoefficientList[#, q] &,Table[B[n], {n, 0, nn}] CoefficientList[Series[e[z]^2, {z, 0, nn}],z]] // Grid
%Y A399727 Row sums give A000079.
%Y A399727 Column k=0 gives A040000.
%Y A399727 Cf. A001815, A002620, A103424, A128014, A047863, A274497.
%K A399727 nonn,tabf,new
%O A399727 0,2
%A A399727 _Geoffrey Critzer_, Oct 07 2026
