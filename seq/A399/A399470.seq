%I A399470 #7 Sep 07 2026 21:19:33
%S A399470 1,1,1,1,1,3,1,1,1,1,1,7,1,1,3,1,1,5,1,4,1,1,1,16,1,1,1,3,1,16,1,1,1,
%T A399470 1,1,22,1,1,1,9,1,11,1,1,7,1,1,32,1,1,1,1,1,9,1,8,1,1,1,86,1,1,4,1,1,
%U A399470 9,1,1,1,6,1,77,1,1,5,1,1,9,1,21,1,1,1,70,1,1,1,4
%N A399470 a(n) is the number of inclusion-maximal Sidon subsets of the set of positive divisors of n.
%C A399470 Let D(n) be the set of positive divisors of n. A Sidon subset of D(n) is a subset for which all positive differences between distinct elements are different; equivalently, all unordered sums of two not necessarily distinct elements are different.
%C A399470 "Inclusion-maximal" means that no further element of D(n) can be adjoined while preserving the Sidon property.
%C A399470 A399471 refines this sequence by cardinality: A399471(n, k) counts the inclusion-maximal Sidon subsets of D(n) having cardinality k.
%C A399470 This is the divisor-set analog of A325879.
%H A399470 Felix Huber, <a href="/A399470/b399470.txt">Table of n, a(n) for n = 1..1259</a>
%H A399470 Wikipedia, <a href="https://en.wikipedia.org/wiki/Sidon_sequence">Sidon sequence</a>.
%H A399470 <a href="/index/Go#Golomb">Index entries for sequences related to Golomb rulers</a>.
%F A399470 a(n) = Sum_{k=A399469(n)..A398434(n)} A399471(n, k).
%F A399470 a(n) = 1 if D(n) itself is a Sidon set, equivalently if A398435(n) = 0.
%F A399470 For prime p and e >= 1, a(p^e) = 1.
%F A399470 For primes p < q, a(p*q) = 3 if q = 2*p - 1, and a(p*q) = 1 otherwise.
%e A399470 a(18) = 5 since D(18) = {1, 2, 3, 6, 9, 18} has exactly the five inclusion-maximal Sidon subsets {1, 3, 6, 18}, {1, 3, 9, 18}, {2, 3, 6, 18}, {2, 3, 9, 18}, and {1, 2, 6, 9, 18}.
%p A399470 A399470 := proc(n)
%p A399470     option remember;
%p A399470     local a, d, f, g, m;
%p A399470     d := sort([op(NumberTheory:-Divisors(n))]); m := nops(d); a := 0;
%p A399470     f := proc(j, u, v)
%p A399470         local k;
%p A399470         if member(2*j, v) then return false end if;
%p A399470         for k in u do
%p A399470             if member(j + k, v) then return false end if
%p A399470         end do;
%p A399470         true
%p A399470     end proc;
%p A399470     g := proc(i, u, v)
%p A399470         local j, k;
%p A399470         if i > m then
%p A399470             for j in d do
%p A399470                 if not member(j, u) and f(j, u, v) then return NULL end if
%p A399470             end do;
%p A399470             a := a + 1;
%p A399470             return NULL
%p A399470         end if;
%p A399470         j := d[i];
%p A399470         if f(j, u, v) then
%p A399470             g(i + 1, [op(u), j], v union {2*j, seq(j + k, k in u)})
%p A399470         end if;
%p A399470         g(i + 1, u, v)
%p A399470     end proc;
%p A399470     g(1, [], {});
%p A399470     a
%p A399470 end proc:
%p A399470 seq(A399470(n), n = 1 .. 88);
%Y A399470 Cf. A325879, A382397, A398433, A398434, A398435, A398577, A399118, A399119, A399469, A399471.
%K A399470 nonn,new
%O A399470 1,6
%A A399470 _Felix Huber_, Sep 01 2026
