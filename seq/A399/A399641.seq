%I A399641 #23 Oct 16 2026 09:20:33
%S A399641 1,13,129,1146,9580,77052,603393,4633428,35049897,262010865,
%T A399641 1939886652,14248857672,103963211352,754228421968,5444890324545,
%U A399641 39139242991656,280283244706659,2000457638623503,14235250711774137,101026788739158930,715247784350818992
%N A399641 Expansion of g^5/(3-2*g)^4, where g = 1+x*g^3 is the g.f. of A001764.
%H A399641 Seiichi Manyama, <a href="/A399641/b399641.txt">Table of n, a(n) for n = 0..1000</a>
%F A399641 G.f.: (Sum_{k>=0} binomial(3*k+1,k) * x^k) * (Sum_{k>=0} binomial(3*k,k) * x^k)^3.
%F A399641 Sum_{k>=1} a(k-1) * x^k/k^2 = (1/4) * log( Sum_{k>=0} binomial(3*k+1,k) * x^k ).
%F A399641 a(n) = ((n+1)/2) * (binomial(3*n+2,n) + Sum_{k=0..n} 2^(n-k) * binomial(3*n+3,k)).
%F A399641 a(n) = ((n+1)/6) * A006256(n+1) = ((n+1)/6) * Sum_{k=0..n+1} 2^(n+1-k) * binomial(3*n+4,k).
%F A399641 a(n) = Sum_{k=0..n} 2^k * binomial(k+2,2) * binomial(3*n+4,n-k).
%F A399641 D-finite with recurrence: 8748*(3*n + 7)*(3*n + 5)*a(n) - 81*(351*n^2 + 1521*n + 1660)*a(n + 1) + 6*(540*n^2 + 2709*n + 3604)*a(n + 2) - 56*(2*n + 7)*(n + 3)*a(n + 3) = 0. - _Robert Israel_, Oct 15 2026
%p A399641 with(gfun):
%p A399641 e1:= y*(3-2*g)^4-g^5:
%p A399641 e2:= -g + 1 + x*g^3:
%p A399641 eq:= resultant(e1,e2,g):
%p A399641 de:= algeqtodiffeq(eq,y(x)):
%p A399641 rec:= diffeqtorec(de,y(x),a(n)):
%p A399641 f:= rectoproc(rec,a(n),remember):
%p A399641 map(f, [$0..30]); # _Robert Israel_, Oct 15 2026
%o A399641 (PARI) a(n) = (n+1)*(binomial(3*n+2, n)+sum(k=0, n, 2^(n-k)*binomial(3*n+3, k)))/2;
%Y A399641 Cf. A399642, A399643, A399644, A399645.
%Y A399641 Cf. A001764, A006256, A378504.
%K A399641 nonn
%O A399641 0,2
%A A399641 _Seiichi Manyama_, Sep 05 2026
