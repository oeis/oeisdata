%I A399740 #13 Sep 12 2026 08:53:27
%S A399740 1,2,3,5,5,6,7,9,10,10,11,15,13,14,15,17,17,20,19,25,21,22,23,27,26,
%T A399740 26,28,35,29,30,31,33,33,34,35,50,37,38,39,45,41,42,43,55,50,46,47,51,
%U A399740 50,52,51,65,53,56,55,63,57,58,59,75,61,62,70,65,65,66,67,85,69,70,71,89
%N A399740 The sum of the unitary divisors d of n such that n/d is a perfect power (A001597).
%C A399740 First differs from A399733 at n = 72.
%C A399740 The number of these divisors is A380398(n).
%C A399740 The sum of the complementary divisors is A380400(n).
%H A399740 Amiram Eldar, <a href="/A399740/b399740.txt">Table of n, a(n) for n = 1..10000</a>
%F A399740 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = 1 - Sum_{k>=2} mu(k) * (zeta(2*k)/zeta(2*k+1) - 1) = 1.05310522722140415935..., and mu is the Moebius function (A008683).
%t A399740 ppowQ[n_] := n == 1 || GCD @@ FactorInteger[n][[;; , 2]] > 1;
%t A399740 a[n_] := DivisorSum[n, # &, CoprimeQ[#, n/#] && ppowQ[n/#] &]; Array[a, 100]
%o A399740 (PARI) a(n) = sumdiv(n, d, d*(gcd(d, n/d) == 1 && (d == n || ispower(n/d))));
%Y A399740 Cf. A001597, A008683, A034448, A380398, A380400, A399747 (analogous with all divisors).
%Y A399740 The sum of the unitary divisors d of n such that n/d is: A363289 (squarefree), A399732 (cubefree), A399733 (powerful), A399734 (cubefull), A399735 (square), A399736 (exponentially odd), A399737 (cube), A399738 (odd), A399739 (power of 2), this sequence (perfect power).
%K A399740 nonn,easy,new
%O A399740 1,2
%A A399740 _Amiram Eldar_, Sep 10 2026
