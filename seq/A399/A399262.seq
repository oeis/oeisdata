%I A399262 #34 Sep 08 2026 17:23:27
%S A399262 1,3,5,8,9,10,14,15,17,18,23,24,25,26,27,33,34,35,37,38,39,46,47,48,
%T A399262 49,50,51,52,60,61,62,63,65,66,67,68,77,78,79,80,81,82,83,84,85,95,96,
%U A399262 97,98,99,101,102,103,104,105
%N A399262 Triangle read by rows: row n gives the n consecutive integers centered at n^2, excluding n^2 if n is even.
%C A399262 The asymptotic density of the union is 1/2.
%C A399262 If n is odd, n = 2m+1: row n = {n^2 - m, ..., n^2 + m}.
%C A399262 If n is even, n = 2m: row n = {n^2 - m, ..., n^2 - 1} U {n^2 + 1, ..., n^2 + m}.
%H A399262 Paolo Xausa, <a href="/A399262/b399262.txt">Table of n, a(n) for n = 1..11325</a> (rows 1..150 of triangle, flattened).
%e A399262 Triangle begins:
%e A399262   1;
%e A399262   3, 5;
%e A399262   8, 9, 10;
%e A399262   14, 15, 17, 18;
%e A399262   23, 24, 25, 26, 27;
%e A399262   33, 34, 35, 37, 38, 39;
%e A399262   ...
%t A399262 A399262row[n_] := If[OddQ[n], Range[n^2 - (n-1)/2, n^2 + (n-1)/2], Drop[Range[n^2 - n/2, n^2 + n/2], {n/2 + 1}]];
%t A399262 Array[A399262row, 15] (* _Paolo Xausa_, Sep 08 2026 *)
%o A399262 (Python)
%o A399262 def R3(n):
%o A399262     c = n*n
%o A399262     m = n//2
%o A399262     if n % 2 == 1:
%o A399262         return list(range(c - m, c + m + 1))
%o A399262     else:
%o A399262         return list(range(c - m, c)) + list(range(c + 1, c + m + 1))
%o A399262 # Print first 10 rows
%o A399262 for n in range(1, 11):
%o A399262     print(R3(n))
%Y A399262 Cf. A000290, A398929, A398933.
%K A399262 tabl,nonn,easy,new
%O A399262 1,2
%A A399262 _Rafael Andres Pastrana Tordecilla_, Aug 30 2026
