%T A399709 6,5,3,9,4,7,3,5,6,4,3,8,10,5,3,4,6,7,3,5,4,8,3,6,9,4,3,5,7,10,3,4,6,
%U A399709 5,3,8,4,7,3,5,6,4,3,9,8
%N A399709 Lexicographically earliest sequence where a(1) = 3, allowed integers are >= 3, and each term a(n) is banned for the next a(n) terms.
%C A399709 This sequence has a pre-periodic block of 47 terms and a period length of 32 terms afterwards.
%o A399709 (Python)
%o A399709 def generate(terms):
%o A399709     sequence = []
%o A399709     banned_until = {}
%o A399709     for n in range(1, terms + 1):
%o A399709         x = 3
%o A399709         while banned_until.get(x, 0) >= n:
%o A399709             x += 1
%o A399709         sequence.append(x)
%o A399709         banned_until[x] = n + x
%o A399709     return sequence
%o A399709 print(generate(79))
%Y A399709 Cf. A364447, A372704, A399708, A398589.
