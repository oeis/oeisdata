%p A399331 # Using function 'binomial_matrix' from A399000.
%p A399331 a := n -> ifelse(n::even, 0, 2^n*euler(n, 1)):
%p A399331 BM := binomial_matrix(a):
%p A399331 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A399331 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%t A399331 (* Uses the function 'binomialMatrix' from A399000. *)
%t A399331 bM = binomialMatrix[If[EvenQ[#], 0, 2^#*EulerE[#, 1]] &];
%t A399331 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A399331 (Python)  # Using function 'binomial_matrix' from A399000.
%o A399331 from sympy import euler
%o A399331 M = binomial_matrix(lambda n: 0 if n % 2 == 0 else 2**n * euler(n, 1))
%o A399331 for n in range(9): print([M(n, k) for k in range(9)])
