%I A399126 #8 Sep 05 2026 17:08:05
%S A399126 16,81,176,208,272,304,368,464,496,592,625,656,688,752,848,944,976,
%T A399126 1072,1136,1168,1264,1328,1424,1552,1616,1648,1712,1744,1808,2032,
%U A399126 2096,2192,2224,2288,2349,2384,2401,2416,2511,2512,2608,2672,2768,2864,2896,2992,2997
%N A399126 Numbers k = rad(k) * lpf(k)^3 such that A008479(k) = 4, where rad = A007947 and lpf = least prime factor.
%C A399126 Numbers k in A397459 such that A008479(k) is minimum.
%C A399126 Superset of A030514 (4th powers of primes).
%C A399126 Smallest k with j > 1 distinct prime factors is 8 * A002110(j)/105.
%C A399126 This sequence is "block A" as defined in comments at A398804.
%H A399126 Michael De Vlieger, <a href="/A399126/b399126.txt">Table of n, a(n) for n = 1..10000</a>
%e A399126 Let S = {m < n : rad(m) = rad(n)}.
%e A399126 Table of n, a(n) for select n:
%e A399126        n        a(n)                                 S(n)
%e A399126   ------------------------------------------------------------------------------
%e A399126        1         16 = 2^4                            {2, 4, 8}
%e A399126        2         81 = 3^4                            {3, 9, 27}
%e A399126        3        176 = 2^4 * 11                       {22, 44, 88}
%e A399126        4        208 = 2^4 * 13                       {26, 52, 104}
%e A399126       34       2288 = 2^4 * 11 * 13                  {286, 572, 1144}
%e A399126       35       2349 = 3^4 * 29                       {87, 261, 783}
%e A399126      627      38896 = 2^4 * 11 * 13 * 17             {4862, 9724, 19448}
%e A399126     1262      79375 = 5^4 * 127                      {635, 3175, 15875}
%e A399126    11885     739024 = 2^4 * 11 * 13 * 17 * 19        {92378, 184756, 369512}
%e A399126    13409     833147 = 7^4 * 347                      {2429, 17003, 119021}
%e A399126   273371   16997552 = 2^4 * 11 * 13 * 17 * 19 * 23   {2124694, 4249388, 8498776}
%e A399126   320426   19926401 = 11^4 * 1361                    {14971, 164681, 1811491}
%t A399126 facs[x_] := facs[x] = FactorInteger[x][[All, 1]]; s = Select[Range[2, 3000], #1/Apply[Times, #2] == #2[[1]]^3 & @@ {#, facs[#]} &]; Select[s, Function[{m, r}, Count[Range[m], _?(Times @@ facs[#] == r &)] == 4] @@ {#, Times @@ facs[#]} &]
%Y A399126 Cf. A007947, A008479, A020736, A030514, A397459, A398804.
%K A399126 nonn,new
%O A399126 1,1
%A A399126 _Michael De Vlieger_, Aug 22 2026
