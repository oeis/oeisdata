%U A399238 25726034077,94691620939,349697952883,1295360706397,4811642634556,17918565707982,66885795242138,250212233805120
%N A399238 a(n) = Sum_{k=0..n} binomial(n, k) * T(k), where T(n) = A000081(n) for n >= 1, T(0) = 1.
%p A399238 p := proc(n) option remember; local m, k; ifelse(n < 2, 1, add(m*add(p(m)*p(n-k*m), k=1..(n-1)/m), m=1..n-1) /(n-1)) end:
%p A399238 a := n -> local k; add(binomial(n, k)*p(k), k=0..n): seq(a(n), n=0..28);
