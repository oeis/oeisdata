%p A399336 # Using function 'binomial_matrix' from A399000.
%p A399336 BM := binomial_matrix(n -> iquo(2^n - (-1)^n, 3)):
%p A399336 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A399336 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%t A399336 (* Uses the function 'binomialMatrix' from A399000. *)
%t A399336 bM = binomialMatrix[Quotient[2^# - (-1)^#, 3] &];
%t A399336 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A399336 (Python)  # Using function 'binomial_matrix' from A399000.
%o A399336 M = binomial_matrix(lambda n: ((1<<n)+1)//3)
%o A399336 for n in range(9): print([M(n, k) for k in range(9)])
