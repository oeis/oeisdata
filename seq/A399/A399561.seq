%N A399561 G.f. A(x) satisfies: A(x) = (1 - x^2 + x^2 * A(2*x)) / (1 - x - x^3).
%F A399561 a(n) = 1 for n < 3; a(n) = a(n-1) + 2^(n-2) * a(n-2) + a(n-3).
%t A399561 nmax = 21; A[_] = 1; Do[A[x_] = (1 - x^2 + x^2 A[2 x])/(1 - x - x^3) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A399561 (* Alternative: *)
%t A399561 a[0] = a[1] = a[2] = 1; a[n_] := a[n] = a[n - 1] + 2^(n - 2) a[n - 2] + a[n - 3]; Table[a[n], {n, 0, 21}]
