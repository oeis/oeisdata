%S A399122 17,3,7,4,16,2,5,1,9,2,54,1,14,2,4,1,113,1,8,1,3,2,24,1,2,2,1,1,33,1,
%T A399122 32,1,4,2,10,1,11,2,3,1,421,1,2,1,1,2,48,1,8,1,4,1,9,1,5,1,3,2,63,1,2,
%U A399122 2,1,1,11,1,68,1,3,1,17,1,2,2,1,1,22,1,2,1,1,2,7,1,5
%N A399122 a(n) is the smallest positive index k such that k^2 - k + n has at least three prime factors counted with multiplicity.
%H A399122 Charles Kusniec, <a href="https://doi.org/10.5281/zenodo.22734657">A399122 and Record Positions in the Prime-Factor Threshold Family k^2-k+n</a>, Zenodo, 2026.
%F A399122 a(n) = min{k >= 1 : A001222(k^2 - k + n) >= 3}.
%e A399122 a(2) = 3: 1^2-1+2 = 2 and 2^2-2+2 = 4 = 2^2 have at most two prime factors, while 3^2-3+2 = 8 = 2^3 has three.
%e A399122 a(41) = 421: for 1 <= k <= 420 the value k^2 - k + 41 is prime or a product of two primes, while 421^2 - 421 + 41 = 176861 = 47*53*71.
%t A399122 a[n_] := Module[{k = 1}, While[PrimeOmega[k^2 - k + n] < 3, k++]; k]; Array[a, 85] (* _Amiram Eldar_, Sep 13 2026 *)
%Y A399122 Cf. A001222, A014556, A020639, A331940.
%K A399122 nonn,new
%O A399122 1,1
