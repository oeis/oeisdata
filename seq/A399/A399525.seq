%I A399525 #7 Sep 01 2026 18:00:28
%S A399525 72,648,4500,107648,3319756,13041125,300295863,2283323796675,
%T A399525 275443408188,32569213011122000,223287071342645376
%N A399525 The least number that starts a run of exactly n successive powerful numbers that are all Achilles numbers.
%H A399525 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%e A399525   n | least run               | previous powerful number | next powerful number
%e A399525   --+-------------------------+--------------------------+---------------------
%e A399525   1 | 72 = 2^3 ^ 3^2          | 64 = 2^6                 | 81 = 3^4
%e A399525   2 | 648 = 2^3 * 3^4         | 625 = 5^4                | 676 = 26^2
%e A399525     | 675 = 3^3 * 5^2         |                          |
%e A399525   3 | 4500 = 2^2 * 3^2 * 5^3  | 4489 = 67^2              | 4624 = 68^2
%e A399525     | 4563 = 3^3 * 13^2       |                          |
%e A399525     | 4608 = 2^9 * 3^2        |                          |
%t A399525 achillesQ[n_] := Module[{e = FactorInteger[n][[;; , 2]]}, AllTrue[e, # > 1 &] && GCD @@ e == 1];
%t A399525 seq[lim_] := Module[{pow = Union[Table[i^2*j^3, {j, 1, Surd[lim, 3]}, {i, 1, Sqrt[lim/j^3]}] // Flatten], c = 0, ac = 0, v = {}}, Do[If[achillesQ[pow[[i]]], If[c == 0, ac = pow[[i]]]; c++, If[c > 0, v = PadRight[v, Max[Length[v], c]]]; If[v[[c]] == 0, v[[c]] = ac]; c = 0], {i, 1, Length[pow]}]; TakeWhile[v, # > 0 &]];
%t A399525 seq[3*10^12]
%o A399525 (PARI) isAchilles(n) = if(n == 1, 0, my(e = factor(n)[, 2]); vecmin(e) > 1 && gcd(e) == 1);
%o A399525 list(lim) = {my(pow = List(), c = 0, ac = 0, v = [], i); for(j = 1, sqrtnint(lim\1, 3), for(i = 1, sqrtint(lim\j^3), listput(pow, i^2*j^3))); pow = Set(pow); for(i = 1, #pow, if(isAchilles(pow[i]), if(c == 0, ac = pow[i]); c++, if(c > 0, v = vector(max(#v, c), i, if(i <= #v, v[i], 0)); if(v[c] == 0, v[c] = ac)); c = 0)); i = 1; while(i <= #v && v[i] > 0, i++); v[1 .. i-1];}
%Y A399525 Subsequence of A001694 and A052486.
%Y A399525 Cf. A399522, A399524.
%K A399525 nonn,more,new
%O A399525 1,1
