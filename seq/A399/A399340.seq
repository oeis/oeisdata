%N A399340 a(n) = Product_{j=0..n-1} binomial(n + j, n).
%F A399340 a(n) * n!^n = a(n) * A036740(n) = A107254(n).
%F A399340 For n > 0, a(n) = BarnesG(2*n) * Gamma(2*n) / (BarnesG(n)^2 * Gamma(n)^(n+2) * n^n). - _Vaclav Kotesovec_, Sep 03 2026
%p A399340 a := n -> mul(binomial(n + j, n), j = 0..n-1): seq(a(n), n = 0..13);
%t A399340 Join[{1}, Table[BarnesG[2*n] * Gamma[2*n] / (BarnesG[n]^2 * Gamma[n]^(n+2) * n^n), {n, 1, 13}]] (* _Vaclav Kotesovec_, Sep 03 2026 *)
%Y A399340 Cf. A036740, A107254.
