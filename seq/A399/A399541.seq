%S A399541 38551,62527,74407,121207,189247,334101,337927,386013,481567,534487,
%T A399541 592951,632551,684967,706351,772951,848767,869647,884551,960367,
%U A399541 974047,977287,983551,1003207,1026967,1037551,1047847,1048351,2832572,10066296,151595235,187882132,198880101,242276571
%N A399541 Numbers k such that psi(k) = phi(k) + tau(k)^6.
%e A399541 38551 is a term since psi(38551) = 40600 = 36504 + 4^6 = phi(38551) + tau(38551)^6.
%o A399541 (Python)
%o A399541 from math import prod
%o A399541 from sympy import factorint
%o A399541 def ok(n):
%o A399541     f = factorint(n)
%o A399541     phi = prod((p-1)*p**(e-1) for p, e in f.items())
%o A399541     psi = prod((p+1)*p**(e-1) for p, e in f.items())
%o A399541     tau = prod(e+1 for e in f.values())
%o A399541     return psi == phi + tau**6
%o A399541 print([k for k in range(10**6) if ok(k)])
%o A399541 (PARI) isok(k) = {my(f = factor(k)); prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) - eulerphi(f) == numdiv(f)^6;} \\ _Amiram Eldar_, Sep 01 2026
