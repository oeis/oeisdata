%S A399156 1,1,1,1,-1,1,1,-7,-8,1,1,-37,-756,1296,1,1,-175,-42800,2462976,
%T A399156 7962624,1,1,-781,-1912860,2316128400,404870400000,-2985984000000,1,1,
%U A399156 -3367,-74601128,1524603608640,8664718293504000,-5072983171891200000,-100306130042880000000
%N A399156 Irregular triangle read by rows: T(n,k) is the determinant of the k X k Hankel matrix whose generic entry is M(i,j,n) = (i + j - 1)^n, with 0 <= k <= n + 1.
%D A399156 Răzvan Gelca and Titu Andreescu, Putnam and Beyond, Springer 2007, pp. 79, 435.
%H A399156 Wikipedia, <a href="https://en.wikipedia.org/wiki/Hankel_matrix">Hankel matrix</a>.
%H A399156 <a href="/index/Ha#Hankel">Index entries for sequences related to Hankel matrices</a>.
%F A399156 T(n,k) = 0 for k > n + 1 (see Gelca and Andreescu).
%e A399156 The irregular triangle begins as:
%e A399156   1, 1;
%e A399156   1, 1,   -1;
%e A399156   1, 1,   -7,     -8;
%e A399156   1, 1,  -37,   -756,    1296;
%e A399156   1, 1, -175, -42800, 2462976, 7962624;
%e A399156   ...
%t A399156 T[n_,0]=1; T[n_, k_]:=Det[Table[(i+j-1)^n, {i, k}, {j, k}]]; Table[T[n, k],{n, 0, 6},{k,0,n+1}]//Flatten
%Y A399156 Cf. A002024, A003992, A399157 (permanents as an array).
%Y A399156 Cf. A000012 (k = 0 or k = 1), A005061 (k = 2, negated).
%K A399156 sign,tabf,new
%O A399156 0,8
%A A399156 _Stefano Spezia_, Aug 20 2026
