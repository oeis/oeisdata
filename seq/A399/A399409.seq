%S A399409 1,5,2,10,8,3,17,16,12,4,23,26,22,15,6,32,36,35,30,20,7,41,48,50,46,
%T A399409 38,25,9,49,60,66,64,57,45,29,11,58,73,81,85,78,70,54,34,13,68,86,97,
%U A399409 105,104,95,83,63,40,14,77,100,116,125,128,124,112,94,72,44,18,89,115,135,146,155,153,145,130,108,82,52,19
%N A399409 Order array of the array W given by w(n, k) = k*(n + sqrt(5)), for n >= 1, k >= 1, a rectangular array, read by descending antidiagonals; see Comments.
%C A399409 Suppose that ((n, k)), for n >= 1 and k >= 1 is an array of distinct real numbers. Replace each w(n, k) by its position when all the numbers w(n, k) are ordered by < . The resulting array is the order array of (w(n, k)). Every positive integer occurs exactly once, so that as a sequence this is a permutation of the positive integers. Successive row terms, and column terms, have limiting ratio 1. See A399406 for a guide to related arrays.
%H A399409 <a href="/index/Per#IntegerPermutation">Index entries for sequences that are permutations of the natural numbers</a>
%e A399409 Corner:
%e A399409    1    5   10   17   23   32   41   49
%e A399409    2    8   16   26   36   48   60   73
%e A399409    3   12   22   35   50   66   81   97
%e A399409    4   15   30   46   64   85  105  125
%e A399409    6   20   38   57   78  104  128  155
%e A399409    7   25   45   70   95  124  153  183
%e A399409    9   29   54   83  112  145  178  214
%e A399409   11   34   63   94  130  167  204  246
%e A399409   13   40   72  108  147  189  232  276
%e A399409   14   44   82  122  165  213  261  305
%e A399409   18   52   91  137  184  235  289  329
%e A399409   19   56  102  150  201  260  309  357
%t A399409 zz = 20; z = 20; x = Sqrt[5];
%t A399409 w[n_, k_] := w[n, k] = k*(n + x);
%t A399409 s = Flatten[Table[w[h, k], {h, 1, zz}, {k, 1, z}]];
%t A399409 r[h_, k_] := Length[Select[s, # <= w[h, k] &]]
%t A399409 TableForm[Table[r[h, k], {h, 1, 20}, {k, 1, 12}]]    (* sequence *)
%t A399409 Table[r[n - k + 1, k], {n, 12}, {k, n, 1, -1}] // Flatten   (* array *)
%Y A399409 Cf. A399406.
%K A399409 nonn,tabl,new
%O A399409 1,2
