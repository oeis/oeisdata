%U A399463 2699642,4525400,7577068,12672510,21172080,35336738,58921300,98157025,163377609,271708883
%N A399463 Number of compositions (ordered partitions) of n such that (greatest part) - (least part) = number of parts.
%F A399463 G.f.: Sum_{j>=1} x^j * ( (1 - x^(j+1))^j - (1 + x^j)*(1 - x^j)^j + x^j*(1 - x^(j-1))^j ) / ( (1 - x)^j * (1 - x^j) ).
%e A399463 a(6) = 5 because we have [4,1,1], [1,4,1], [1,1,4], [4,2] and [2,4].
%t A399463 nmax = 40; CoefficientList[Series[Sum[x^j ((1 - x^(j + 1))^j - (1 + x^j) (1 - x^j)^j + x^j (1 - x^(j - 1))^j)/((1 - x)^j (1 - x^j)), {j, 1, nmax}], {x, 0, nmax}], x] // Rest
%o A399463 (PARI) A399463_first(N)=my(x='x+O(x^N));Vec(sum(j=1,N-1, x^j*((1-x^(j+1))^j-(1+x^j)*(1-x^j)^j+x^j*(1-x^(j-1))^j)/((1-x)^j*(1-x^j))),-N) \\ _M. F. Hasler_, Nov 22 2026
