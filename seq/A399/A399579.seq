%N A399579 Irregular triangle read by rows: row n lists numbers in A055932 with n divisors.
%C A399579 The n-th row contains A074206(n) terms. Taking the first term of each row gives A005179.
%H A399579 Zhicheng Wei, <a href="/A399579/b399579.txt">Table of n, a(n) for n = 1..10008</a> (first 396 rows)
%e A399579 The row for n = 10 contains 48, 162 and 512, each having 10 divisors, and are all in A055932.
%e A399579 The triangle begins:
%e A399579   1;
%e A399579   2;
%e A399579   4;
%e A399579   6, 8;
%e A399579   16;
%e A399579   12, 18, 32;
%e A399579   64;
%e A399579   24, 30, 54, 128;
%e A399579   36, 256;
%e A399579   48, 162, 512;
%e A399579   1024;
%e A399579   60, 72, 90, 96, 108, 150, 486, 2048;
%e A399579   4096;
%e A399579   192, 1458, 8192;
%e A399579   144, 324, 16384;
%o A399579 isA055932(n)=my(f=factor(n)[, 1]~); f==primes(#f)
%o A399579 (prodR(n, maxf)=my(dfs=divisors(n), a=[], r); for(i=2, #dfs, if( dfs[i]<=maxf, if(dfs[i]==n, a=concat(a, [[n]]), r=prodR(n/dfs[i], min(dfs[i], maxf)); for(j=1, #r, a=concat(a, [concat(dfs[i], r[j])]))))); a); A005179(n)=my(pf=prodR(n, n), a=1, b); for(i=1, #pf, b=prod(j=1, length(pf[i]), prime(j)^(pf[i][j]-1)); if(b<a || i==1, a=b)); a
%o A399579 row(t)=for(n=A005179(t), 2^(t-1), isA055932(n)&numdiv(n)==t&print1(n", "))
