%S A399293 1,2,44,2268,172406,16525364,1851515316,232214524168,31724349246450,
%T A399293 4635070899885820,714882516843189032,115287453948200666728,
%U A399293 19300240796032709430516,3335388836912282335432488,592394815574668327185916264,107748336461115133794669942768,20011587741833359548353817850106
%N A399293 Number of words of length 4*n over the alphabet [4] such that c(2) = c(3) = c(4), any prefix satisfies c(1) >= c(2), c(1) >= c(3), c(2) >= c(4), c(3) >= c(4), and no proper prefix satisfies c(1) = c(2) = c(3) = c(4). Here c(i) is the number of occurrences of the letter i.
%H A399293 Alois P. Heinz, <a href="/A399293/b399293.txt">Table of n, a(n) for n = 0..180</a>
%F A399293 a(n) = A114714(n) - Sum_{i=1..n-1} A114714(i)*a(n-i). - _Alois P. Heinz_, Nov 04 2026
%e A399293 The word (1,2,1,3,4,2,3,4) satisfies the required constraints so is counted under a(2) = 44.
%e A399293 a(1) = 2: (1,2,3,4), (1,3,2,4).
%p A399293 b:= proc(x, y, u, w) option remember;
%p A399293       `if`(x=0 and y=0 and u=0 and w=0, 1, `if`(x>y and x>u,
%p A399293        b(x-1, y, u, w), 0)+ `if`(y>w, b(x, y-1, u, w), 0)+
%p A399293       `if`(u>w, b(x, y, u-1, w), 0)+ `if`(w>0, b(x, y, u, w-1), 0))
%p A399293     end:
%p A399293 a:= proc(n) option remember: b(n$4)-add(b(i$4)*a(n-i), i=1..n-1) end:
%p A399293 seq(a(n), n=0..16);  # _Alois P. Heinz_, Nov 04 2026
%o A399293 (Python)
%o A399293 def A399293_list(n_max):
%o A399293     A = {(0, 0, 0, 0): 1}
%o A399293     C = [1]
%o A399293     for i in range(4*n_max):
%o A399293         B = {}
%o A399293         for (bs, cs, db, dc), z in A.items():
%o A399293             states = [(bs+1, cs+1, db, dc)]
%o A399293             if bs > 0:
%o A399293                 states.append((bs-1, cs, db+1, dc))
%o A399293             if cs > 0:
%o A399293                 states.append((bs, cs-1, db, dc+1))
%o A399293             if db > 0 and dc > 0:
%o A399293                 states.append((bs, cs, db-1, dc-1))
%o A399293             for s in states:
%o A399293                 B[s] = B.get(s, 0) + z
%o A399293         C.append(B.pop((0, 0, 0, 0), 0))
%o A399293         A = B
%o A399293     return C[::4]
%Y A399293 Cf. A114714, A384725.
%K A399293 nonn,new
%O A399293 0,2
