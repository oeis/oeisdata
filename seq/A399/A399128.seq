%I A399128 #5 Sep 05 2026 17:29:18
%S A399128 32,243,544,608,736,928,992,1184,1312,1376,1504,1696,1888,1952,2144,
%T A399128 2272,2336,2528,2656,2848,3104,3125,3232,3296,3424,3488,3616,4064,
%U A399128 4192,4384,4448,4768,4832,5024,5216,5344,5536,5728,5792,6112,6176,6304,6368,6752,7136
%N A399128 Numbers k = rad(k) * lpf(k)^4 such that A008479(k) = 5, where rad = A007947 and lpf = least prime factor of k.
%C A399128 Numbers k in A398443 such that A008479(k) is minimum.
%C A399128 Superset of A050997.
%C A399128 Let P(i..j) = Product_{h=i..j} prime(h).
%C A399128 Smallest k with j > 1 distinct prime factors is 32 * P(7..j+5).
%H A399128 Michael De Vlieger, <a href="/A399128/b399128.txt">Table of n, a(n) for n = 1..10000</a>
%e A399128 Let S = {m < n : rad(m) = rad(n)}.
%e A399128 Table of n, a(n) for select n:
%e A399128         n         a(n)                   S(n)
%e A399128   --------------------------------------------------------------------------------
%e A399128         1          32 = 2^5              {2, 4, 8, 16}
%e A399128         2         243 = 3^5              {3, 9, 27, 81}
%e A399128         3         544 = 2^5 * 17         {34, 68, 136, 272}
%e A399128         4         608 = 2^5 * 19         {38, 76, 152, 304}
%e A399128        64       10336 = 2^5 * P(7..8)    {646, 1292, 2584, 5168}
%e A399128       121       20169 = 3^5 * 83         {249, 747, 2241, 6723}
%e A399128      1550      237728 = 2^5 * P(7..9)    {14858, 29716, 59432, 118864}
%e A399128     12630     1971875 = 5^5 * 631        {3155, 15775, 78875, 394375}
%e A399128     44270     6894112 = 2^5 * P(7..10)   {430882, 861764, 1723528, 3447056}
%e A399128    260952    40521677 = 7^5 * 2411       {16877, 118139, 826973, 5788811}
%e A399128   1377494   213717472 = 2^5 * P(7..11)   {13357342, 26714684, 53429368, 106858736}
%t A399128 facs[x_] := facs[x] = FactorInteger[x][[All, 1]]; s = Select[Range[2, 7500], #1/Apply[Times, #2] == #2[[1]]^4 & @@ {#, facs[#]} &]; Select[s, Function[{m, r}, Count[Range[m], _?(Times @@ facs[#] == r &)] == 5] @@ {#, Times @@ facs[#]} &]
%Y A399128 Cf. A007947, A008479, A020639, A050997, A398443.
%K A399128 nonn,new
%O A399128 1,1
