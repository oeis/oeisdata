%o A399486 (PARI)
%o A399486 B_q(N) = {my(q='q+O('q^(N+1))); Vec(sum(i=0,floor(1/2+sqrt(2*N)), (i*(i+1)/2)! * q^(i*(1+i)*(2+i+i^2)/8) / (prod(j=1,i-1, (2*j+1)^(i-j)) * prod(k=1,i*(i+1)/2, 1 - q^k))))}
