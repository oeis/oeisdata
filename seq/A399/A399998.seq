%I A399998 #6 Oct 25 2026 20:59:47
%S A399998 0,1,1,2,2,3,2,4,3,3,4,3,5,3,4,5,3,6,4,5,5,4,7,3,6,6,5,7,4,7,4,6,8,4,
%T A399998 8,7,6,9,5,8,5,7,7,6,9,8,7,5,6,10,5,8,8,7,10,6,9,6,8,11,6,10,9,8,11,7,
%U A399998 11,7,9,12,10,11,10,10,7,9,12,9,10,10,9,12,10
%N A399998 a(n+1) = a(n-a(a(n))^2) + 1, a(0) = 0.
%C A399998 Each term a(n+1) is obtained by adding 1 to an earlier term a(n-a(a(n))^2). These self-references to earlier terms define a tree with a(0) at its root, where a(n) equals the depth of node n (see the term-referencing trees visualized in the Links section).
%C A399998 The sequence appears to grow proportionally to sqrt(n). This is also suggested by the continuum approximation f(x+1) - f(x - f(f(x))^2) ~ 1, for which f(x) = 2^(1/4)*sqrt(x) gives an asymptotic balance.
%H A399998 Paolo Xausa, <a href="/A399998/b399998.txt">Table of n, a(n) for n = 0..10000</a>
%H A399998 Rok Cestnik, <a href="/A399998/a399998.pdf">Term-referencing tree for 100 terms</a>.
%H A399998 Rok Cestnik, <a href="/A399998/a399998_1.pdf">Term-referencing tree for 1000 terms</a>.
%H A399998 OEIS Wiki, <a href="https://oeis.org/wiki/A400K_Winners">A400K Winners</a>, 2026.
%F A399998 a(n) ~ 2^(1/4)*n^(1/2) (conjectured).
%e A399998 a(1) = a(0-a(a(0))^2)+1 = a(0-0)+1 = 1.
%e A399998 a(2) = a(1-a(a(1))^2)+1 = a(1-1)+1 = 1.
%e A399998 a(3) = a(2-a(a(2))^2)+1 = a(2-1)+1 = 2.
%p A399998 a:= proc(n) option remember;
%p A399998      `if`(n=0, 0, a(n-1-a(a(n-1))^2)+1)
%p A399998     end:
%p A399998 seq(a(n), n=0..82);  # _Alois P. Heinz_, Oct 25 2026
%t A399998 A399998[n_] := A399998[n] = If[n == 0, 0, A399998[n - 1 - A399998[A399998[n - 1]]^2] + 1];
%t A399998 Array[A399998, 100,0] (* _Paolo Xausa_, Oct 15 2026 *)
%t A399998 (* Alternative: with no recursion: *)
%t A399998 Module[{a = ConstantArray[0, #]}, Do[a[[k + 1]] = a[[k - a[[a[[k]] + 1]]^2]] + 1, {k, # - 1}]; a] & [100] (* _Paolo Xausa_, Oct 15 2026 *)
%o A399998 (Python)
%o A399998 a = [0]
%o A399998 for n in range(82):
%o A399998     a.append(a[n-a[a[n]]**2]+1)
%Y A399998 Cf. A364197, A340224, A339929.
%K A399998 nonn,easy,nice,new
%O A399998 0,4
%A A399998 _Rok Cestnik_, Oct 08 2026
