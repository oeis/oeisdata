%I A399869 #20 Sep 24 2026 22:45:44
%S A399869 0,1,2,2,3,3,4,3,3,4,4,3,5,4,4,3,5,4,6,4,5,6,5,4,4,6,4,5,5,5,6,4,5,6,
%T A399869 4,4,6
%N A399869 Number of steps required for n to reach 1 under repeated application of A048675, which encodes the exponents in the prime factorization of n as a binary integer; or -1 if 1 is never reached.
%C A399869 Computation becomes substantially more difficult at n = 38: the iteration begins 38 -> 129 -> 8194 -> 4503599627370561, after which further iteration requires factorization of very large integers. Thus a(38) and subsequent terms have not been computed here. This computational difficulty is also documented in A285331.
%F A399869 a(1) = 0; a(n) = 1 + a(A048675(n)) for n >= 2 if the iteration reaches 1; otherwise a(n) = -1.
%e A399869 For n = 10 = 2*5, A048675(10) = 5, so 10 -> 5 -> 4 -> 2 -> 1 and a(10) = 4.
%e A399869 For n = 13, A048675(13) = 32, so 13 -> 32 -> 5 -> 4 -> 2 -> 1 and a(13) = 5.
%o A399869 (Python)
%o A399869 import sympy as sp
%o A399869 def A048675(n):
%o A399869     f = sp.factorint(n)
%o A399869     return sum(
%o A399869         e * 2**(int(sp.primepi(p)) - 1)
%o A399869         for p, e in f.items()
%o A399869     )
%o A399869 def a(n):
%o A399869     s = 0
%o A399869     while n != 1:
%o A399869         n = A048675(n)
%o A399869         s += 1
%o A399869     return s
%o A399869 print([a(n) for n in range(1, 38)])
%Y A399869 Cf. A048675, A019565, A087207, A285331, A288569.
%K A399869 nonn,hard,more,new
%O A399869 1,3
