%I A399319 #7 Sep 11 2026 18:28:31
%S A399319 735,4235,5915,8085,9295,9555,10115,12495,12635,13013,13965,15895,
%T A399319 16905,18515,18785,19855,21315,22253,22785,23465,26299,27195,27797,
%U A399319 29095,30135,30685,31605,32851,34385,34545,38955,40733,41327,42959,43365,44835,44965,48139,49245
%N A399319 Numbers k = rad(k) * q(k) such that A008479(k) = 4, where rad = A007947 and q(k) the third smallest distinct prime factor of k.
%C A399319 Numbers k in A398864 such that A008479(k) is minimum.
%C A399319 This sequence is "block D" as defined in comments at A398804.
%H A399319 Michael De Vlieger, <a href="/A399319/b399319.txt">Table of n, a(n) for n = 1..10000</a>
%e A399319 Let P(i..j) = Product_{h=i..j} prime(h).
%e A399319 Let S = {m < n : rad(m) = rad(n)}.
%e A399319 Table of n, a(n) for select n:
%e A399319        n         a(n)                     S(n)
%e A399319   -------------------------------------------------------------------------
%e A399319        1         735 = 3 * 5 * 7^2        {105, 315, 525}
%e A399319        2        4235 = 5 * 7 * 11^2       {385, 1925, 2695}
%e A399319        3        5915 = 5 * 7 * 13^2       {455, 2275, 3185}
%e A399319        4        8085 = 3 * 5 * 7^2 * 11   {1155, 3465, 5775}
%e A399319        5        9295 = 5 * 11 * 13^2      {715, 3575, 7865}
%e A399319        6        9555 = 3 * 5 * 7^2 * 13   {1365, 4095, 6825}
%e A399319        7       10115 = 5 * 7 * 17^2       {595, 2975, 4165}
%e A399319        8       12495 = 3 * 5 * 7^2 * 17   {1785, 5355, 8925}
%e A399319       73      105105 = 7 * P(2..6)        {15015, 45045, 75075}
%e A399319     1312     1786785 = 7 * P(2..7)        {255255, 765765, 1276275}
%e A399319    24903    33948915 = 7 * P(2..8)        {4849845, 14549535, 24249225}
%e A399319   567773   780825045 = 7 * P(2..9)        {111546435, 334639305, 557732175}
%t A399319 facs[x_] := facs[x] = FactorInteger[x][[All, 1]]; nn = 50000; Table[Set[r[n], Times @@ facs[n]], {n, nn}]; s = Select[Range[2, nn], PrimeNu[#] >= 3 &]; t = Select[s, #1/Apply[Times, #2] == #2[[3]] & @@ {#, facs[#]} &]; Select[t, Function[m, Count[Range[m], _?(r[#] == r[m] &)] == 4] ]
%Y A399319 Cf. A007947, A008479, A398804, A398864.
%K A399319 nonn,new
%O A399319 1,1
%A A399319 _Michael De Vlieger_, Aug 30 2026
