%I A399190 #17 Sep 13 2026 17:54:10
%S A399190 2,2,3,2,4,2,4,4,3,4,2,3,2,4,2,4,6,3,4,4,4,4,3,6,4,4,2,3,3,5,2,2,4
%N A399190 Number of numbers equal to the sum of the swinging factorials (A056040) of their base-n digits.
%C A399190 For every base n >= 2, the numbers 1 and 2 are always fixed points since swing(1) = 1 and swing(2) = 2, so a(n) >= 2 for all n >= 2.
%C A399190 For any base n, the maximum swinging factorial of a single digit is swing(n-1). Any k-digit base-n candidate m satisfies n^(k-1) <= m <= k * swing(n-1), which yields a finite upper bound for exhaustive search for any fixed base.
%e A399190 a(2) = 2: 1, 2.
%e A399190 a(4) = 3: 1, 2, 7 (since in base 4, 7 = 13_4 and swing(1) + swing(3) = 1 + 6 = 7).
%e A399190 a(10) = 3: 1, 2, 147 (since 147 = swing(1) + swing(4) + swing(7) = 1 + 6 + 140).
%o A399190 (Python)
%o A399190 import math
%o A399190 from itertools import combinations_with_replacement
%o A399190 def swing(d):
%o A399190     return math.factorial(d) // (math.factorial(d // 2) ** 2)
%o A399190 def to_base(val, b):
%o A399190     digits = []
%o A399190     while val > 0:
%o A399190         digits.append(val % b)
%o A399190         val //= b
%o A399190     return digits
%o A399190 def a(n):
%o A399190     sw = [swing(d) for d in range(n)]
%o A399190     k_max = 1
%o A399190     while n ** (k_max - 1) <= k_max * sw[-1]:
%o A399190         k_max += 1
%o A399190     k_max -= 1
%o A399190     sols = {d for d in range(1, n) if d == sw[d]}
%o A399190     for k in range(2, k_max + 1):
%o A399190         for combo in combinations_with_replacement(range(n), k):
%o A399190             s = sum(sw[d] for d in combo)
%o A399190             if s > 0:
%o A399190                 digits = to_base(s, n)
%o A399190                 if len(digits) == k and tuple(sorted(digits)) == combo:
%o A399190                     sols.add(s)
%o A399190     return len(sols)
%o A399190 print([a(n) for n in range(2, 20)])
%Y A399190 Cf. A056040, A260651, A014080.
%K A399190 nonn,base,more,new
