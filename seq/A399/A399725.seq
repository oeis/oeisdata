%I A399725 #17 Oct 09 2026 10:57:16
%S A399725 1,5,13,17,19,25,29,37,41,50,53,55,61,65,73,85,89,97,101,109,113,125,
%T A399725 127,137,145,149,151,157,163,169,173,181,185,193,197,199,205,221,229,
%U A399725 233,241,243,251,257,265,269,271,277,281,289,293,305,307,313,317,325,337,343,349,351,353,361,365
%N A399725 Numbers k that have no proper divisors d such that k - d is squarefree.
%C A399725 Numbers k such that A330868(k) = 0.
%C A399725 Primes in the sequence are A049092.
%H A399725 Robert Israel, <a href="/A399725/b399725.txt">Table of n, a(n) for n = 1..10000</a>
%e A399725 a(6) = 25 is a term because its proper divisors are 1 and 5, and neither 25 - 1 = 24 nor 25 - 5 = 20 is squarefree.
%p A399725 filter:= n -> not ormap(t -> NumberTheory:-IsSquareFree(n-t), NumberTheory:-Divisors(n) minus {n}):
%p A399725 select(filter, [$1..400]);
%t A399725 A399725Q[k_] := NoneTrue[Most[Divisors[k]], SquareFreeQ[k - #] &];
%t A399725 Select[Range[500], A399725Q] (* _Paolo Xausa_, Oct 09 2026 *)
%Y A399725 Cf. A049092, A330868.
%K A399725 nonn,new
%O A399725 1,2
%A A399725 _Robert Israel_, Oct 07 2026
