%e A399413   25     66    111     161     213     269     325     383     444
%e A399413   28     72    124     179     238     299     361     425     492
%t A399413 x = Sqrt[3] - Sqrt[2];
%t A399413 u[n_, k_] := Sum[Floor[k (n + x)/h - x], {h, 1, Floor[k (n + x)/(1 + x)]}]
%t A399413 t = Table[u[n, k], {n, 1, 12}, {k, 1, 12}]; Grid[t]  (*array*)
%t A399413 Table[u[n - k + 1, k], {n, 1, 12}, {k, n, 1, -1}] // Flatten (*sequence*)
%Y A399413 Cf. A399406.
