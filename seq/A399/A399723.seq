%I A399723 #13 Sep 10 2026 01:32:21
%S A399723 1,1,2,1,3,6,4,5,1,9,6,7,7,12,12,1,9,13,10,14,16,18,12,20,1,21,20,28,
%T A399723 15,24,16,21,24,27,24,13,19,30,28,30,21,32,22,42,39,36,24,31,19,31,36,
%U A399723 49,27,40,36,40,40,45,30,56,31,48,52,1,42,48,34,63,48,48,36,65,37,57,62,70,48,56,40
%N A399723 a(n) is the greatest k <= n such that k divides sigma(n), where sigma = A000203.
%C A399723 n is multiply-perfect (A007691) iff a(n) = n.
%C A399723 If n is an odd prime, a(n) = (n+1)/2.
%C A399723 If n = p*q with p and q distinct primes, a(n) = (p+1)*(q+1)/2.
%C A399723 If n = p^2 with p in A002476, a(n) = (1 + p + p^2)/3.
%C A399723 If n is in A023194, a(n) = 1.
%H A399723 Robert Israel, <a href="/A399723/b399723.txt">Table of n, a(n) for n = 1..10000</a>
%e A399723 a(8) = 5 because sigma(8) = 15 whose greatest divisor <= 8 is 5.
%p A399723 f:= n -> max(select(`<=`, NumberTheory:-Divisors(NumberTheory:-sigma(n)), n)):
%p A399723 map(f, [$1..100]);
%t A399723 A399723[n_] := If[n == 1, 1, Module[{s = DivisorSigma[1, n], k}, k = Min[n, Quotient[s, 2]]; While[!Divisible[s, k], k--]; k]];
%t A399723 Array[A399723, 100] (* _Paolo Xausa_, Sep 09 2026 *)
%Y A399723 Cf. A000203,  A002476, A007691, A023194.
%K A399723 nonn,look,new
%O A399723 1,3
%A A399723 _Robert Israel_, Sep 09 2026
