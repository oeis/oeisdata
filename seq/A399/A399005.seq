%I A399005 #14 Aug 24 2026 17:51:32
%S A399005 1,2,13,158,2339,41422,903639,23584066,711692041,24475565378,
%T A399005 951303541189,41325611683358
%N A399005 Number of transitive relations R on an n-set such that each element is involved in at most 3 ordered pairs of R, where a loop (x,x) counts once.
%C A399005 Involvement of v means |{(x,y) in R : x=v or y=v}|; in particular, a loop contributes one.
%e A399005 a(1)=2 because all relations on a 1-set are such.
%o A399005 (Python)
%o A399005 def transitive(R):
%o A399005     return all((x, z) in R for (x, y) in R for (u, z) in R if y == u)
%o A399005 def a(n, r):
%o A399005     P = [(i, j) for i in range(n) for j in range(n)]
%o A399005     ans = 0
%o A399005     for mask in range(1 << (n*n)):
%o A399005         R = {P[k] for k in range(n*n) if (mask >> k) & 1}
%o A399005         d = [sum(x == v or y == v for x, y in R) for v in range(n)]
%o A399005         if max(d, default=0) <= r and transitive(R):
%o A399005             ans += 1
%o A399005     return ans
%o A399005 print([a(n, 3) for n in range(5)])
%Y A399005 Cf. A006905, A399004.
%K A399005 nonn,more,new
%O A399005 0,2
