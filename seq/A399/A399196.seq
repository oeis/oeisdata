%S A399196 1,10,101,1010,10101,101011,1010110,10101101,101011010,1010110101,
%T A399196 10101101011,101011010110,1010110101101,10101101011010,
%U A399196 101011010110101,1010110101101011,10101101011010110,101011010110101101,1010110101101011010,10101101011010110101
%N A399196 a(n) is obtained by appending the smallest decimal digit to a(n-1) such that the resulting number is deficient, with a(1) = 1.
%C A399196 Potentially finite. Runs of consecutive abundant numbers can be arbitrarily long (as proved by Erdős), so a run of at least 10 consecutive abundant numbers (5 even and 5 odd) starting at 10*a(n) will end the sequence at n terms long.
%C A399196 The terms are not restricted to digits 0 and 1. The first exception is a(30), ending in 2.
%C A399196 If a(n) ends in 0, then a(n+1) cannot end in 0, since 10*a(n) is a multiple of 100. Because 100 is abundant, 10*a(n) is also abundant. More generally, if an abundant number divides 10*a(n)+d, then 10*a(n)+d is abundant and therefore cannot be a term.
%C A399196 If the factorization of a(n) is known, the divisor sum of 10*a(n) is easily computed, since 10*a(n) has one additional factor of 2 and one of 5.
%C A399196 Approximately 35% of the digits are 0 and 65% are 1. This can be estimated from the observed transitions between 2-digit suffixes:
%C A399196 01 -> 010: ~54%, 011: ~46%
%C A399196 10 -> 100:   0%, 101: ~100%
%C A399196 11 -> 110: ~54%, 111: ~46%
%C A399196 These probabilities were estimated by counting deficient numbers of the forms (1000x+10), (1000x+11), (1000x+110), and (1000x+111). Digits other than 0 and 1 were ignored in this approximation because they occur rarely.
%C A399196 Base 10 is the smallest base for which this sequence is interesting. - _Sean A. Irvine_, Oct 03 2026
%H A399196 Sean A. Irvine, <a href="/A399196/b399196.txt">Table of n, a(n) for n = 1..164</a> (terms 1..130 from Jakub Buczak)
%e A399196 a(2) = 10, appending 0 gives 100, which is not deficient, appending 1 gives 101, which is deficient, thus a(3) = 101.
%o A399196 (Python)
%o A399196 from sympy import divisor_sigma
%o A399196 def a(n):
%o A399196     x = 1
%o A399196     for _ in range(n - 1):
%o A399196         for d in range(1 if x % 10 == 0 else 0, 10):
%o A399196             y = 10 * x + d
%o A399196             if divisor_sigma(y) < 2 * y:
%o A399196                 x = y
%o A399196                 break
%o A399196     return x
%o A399196 (PARI) lista(nn) = my(va=vector(nn)); va[1] = 1; for (n=2, nn, my(k=10*va[n-1]); while(sigma(k) >= 2*k, k++); if (k-10*va[n-1] > 10, error("failed at index", n)); va[n] = k;); va; \\ _Michel Marcus_, Sep 24 2026
%Y A399196 Cf. A005100, A005101.
