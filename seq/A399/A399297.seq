%N A399297 Numbers containing at least one prime substring without leading zero of every possible length.
%H A399297 Michael S. Branicky, <a href="/A399297/b399297.txt">Table of n, a(n) for n = 1..10000</a>
%e A399297 167 is a term because its substrings [7, 67, 167] are primes, providing a prime substring of every possible length from 1 to 3.
%o A399297 (Python)
%o A399297 from sympy import isprime
%o A399297 def ok(n):
%o A399297     if not isprime(n): return False
%o A399297     s = str(n)
%o A399297     return all(any(s[i]!='0' and isprime(int(s[i:i+L])) for i in range(len(s)-L+1)) for L in range(1, len(s)))
%o A399297 print([k for k in range(500) if ok(k)]) # _Michael S. Branicky_, Oct 01 2026
