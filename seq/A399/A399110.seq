%N A399110 Number of endofunctions on [2n] with exactly n isolated fixed points.
%H A399110 Alois P. Heinz, <a href="/A399110/b399110.txt">Table of n, a(n) for n = 0..322</a>
%F A399110 a(n) = A350212(2n,n).
%F A399110 a(n) = Sum_{j=0..n} (-1)^(n-j)*j^j*(2*n)!/((n-j)!*j!*n!).
%p A399110 a:= n-> add((-1)^(n-j)*j^j*(2*n)!/((n-j)!*j!*n!), j=0..n):
%p A399110 seq(a(n), n=0..16);
%p A399110 # Alternative:
%p A399110 a:= n-> add((-1)^(n-j)*j^j*combinat[multinomial](2*n, j, n-j, n), j=0..n):
