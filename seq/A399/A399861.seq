%S A399861 1,0,1,1,2,3,5,2,7,9,16,25,41,16,57,73,130,203,73,276,349,73,-276,
%T A399861 -349,-625,-974,-349,625,276,901,1177,276,1453,1729,3182,4911,8093,
%U A399861 13004,4911,17915,22826,40741,63567,104308,167875,272183,104308,-167875,-63567
%N A399861 Deterministic version of the random Fibonacci sequence, with signs from A191232 and the seed as (1,0).
%C A399861 Viswanath's random Fibonacci sequence flips a fair coin for each sign. Reading the signs off one fixed word instead gives a single integer sequence, and A191232 is normal in base 2, so every finite sign pattern still occurs with the frequency a coin would give it. Digit A191232(n-1) drives step n, with "1" adding and "0" subtracting.
%H A399861 Jwalin Bhatt, <a href="/A399861/b399861.txt">Table of n, a(n) for n = 0..10000</a>
%H A399861 A. H. Copeland and P. Erdős, <a href="https://www.renyi.hu/~p_erdos/1946-01.pdf">Note on normal numbers</a>, Bull. Amer. Math. Soc. 52 (1946), pp. 857-860.
%H A399861 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/RandomFibonacciSequence.html">Random Fibonacci Sequence</a>.
%H A399861 Wikipedia, <a href="https://en.wikipedia.org/wiki/Random_Fibonacci_sequence">Random Fibonacci sequence</a>.
%F A399861 For n>=2: a(n) = a(n-1) + a(n-2) if A191232(n-1) = 1, otherwise a(n-1) - a(n-2).
%F A399861 Conjecture: lim_{n->oo} |a(n)|^(1/n) = 1.1319882487943... (A078416), Viswanath's constant.
%e A399861 A191232 begins 1, 0, 1, 1, 1, 0, 1, 1, 1, 1, ..., so the signs applied at steps n = 2, 3, 4, ... are +, -, +, +, +, -, +, +, +, +, ...
%e A399861 a(2) = a(1) + a(0) = 0 + 1 = 1, since A191232(1) = 1.
%e A399861 a(3) = a(2) - a(1) = 1 - 0 = 1, since A191232(2) = 0.
%e A399861 a(4) = a(3) + a(2) = 1 + 1 = 2, since A191232(3) = 1.
%e A399861 a(5) = a(4) + a(3) = 2 + 1 = 3, since A191232(4) = 1.
%t A399861 Module[{c = Flatten[IntegerDigits[#, 2] & /@ Prime[Range[25]]], a}, a[n_] := a[n] = If[n <= 1, 1-n, a[n-1] + (2*c[[n-1]] - 1)*a[n-2]]; Array[a, 49, 0]]
%o A399861 (Python)
%o A399861 from itertools import islice
%o A399861 from sympy import nextprime
%o A399861 def digits(p=2):
%o A399861     while True: yield from (int(b) for b in bin(p)[2:]); p = nextprime(p)
%o A399861 def A399861(n_terms):
%o A399861     a, d = [1, 0], list(islice(digits(), n_terms))
%o A399861     for n in range(2, n_terms):
%o A399861         a.append(a[n-1] + a[n-2] if d[n-2] else a[n-1] - a[n-2])
%o A399861     return a
%o A399861 print(A399861(49))
%Y A399861 Cf. A000045, A078416, A191232, A399309, A400370.
%K A399861 sign,new
