%N A399078 G.f.: (Sum_{k>=1} k*x^(2*k)/(1 - x^(2*k))) / Product_{k>=1} (1 - x^k).
%H A399078 Vaclav Kotesovec, <a href="/A399078/b399078.txt">Table of n, a(n) for n = 0..10000</a>
%F A399078 a(n) ~ exp(Pi*sqrt(2*n/3)) / (16*sqrt(3)).
%F A399078 a(n) = Sum_{k=1..n/2} A000203(k)*A000041(n-2*k).
%F A399078 a(n) = A066966(n)/2.
%t A399078 nmax = 60; CoefficientList[Series[Sum[k*x^(2*k)/(1-x^(2*k)), {k, 1, nmax}] / Product[1 - x^k, {k, 1, nmax}], {x, 0, nmax}], x]
%t A399078 (* Alternative: *)
%t A399078 Table[Sum[DivisorSigma[1, k] * PartitionsP[n-2*k], {k, 1, n/2}], {n, 0, 60}]
