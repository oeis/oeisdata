%S A399581 1,1,1,1,1,7,4,3,2,2,19,7,5,4,3,40,12,7,5,4,95,19,11,7,6,610,27,14,10,
%T A399581 7,6,40,19,12,9,7,59,24,15,11,9,95,31,19,13,11,178,40,22,16,12,610,51,
%U A399581 27,19,14,11,68,33,22,16,13,95,40,25,19,15,140,48,29
%N A399581 Upper bound for the smallest term of a cycle of the 7x+1 map with n odd terms: a(n) = floor(n/(7*log(2)*(ceiling(n*log_2(7)) - n*log_2(7)))).
%C A399581 The 7x+1 map sends x to x/2 if x is even and to 7x+1 if x is odd. If it has a cycle with n odd terms, the smallest term of that cycle is at most a(n). This follows from 2^j = 7^n * Product_{i=1..n} (1 + 1/(7*x_i)), where x_1, ..., x_n are the odd terms and j is the number of halvings.
%C A399581 The only known cycle is (1, 8, 4, 2).
%C A399581 A search of all odd m <= 346630 with m == 1, 2 or 4 (mod 7) finds no other cycle, so none exists with at most 2963 odd terms.
%D A399581 R. P. Steiner, A theorem on the Syracuse problem, Proc. 7th Manitoba Conf. Numerical Math., 1977, 553-559.
%H A399581 Karan Sharma, <a href="/A399581/b399581.txt">Table of n, a(n) for n = 1..10000</a>
%H A399581 R. E. Crandall, <a href="https://doi.org/10.1090/S0025-5718-1978-0480321-3">On the "3x+1" problem</a>, Math. Comp. 32 (1978), 1281-1292.
%e A399581 a(6) = 7: the smallest power of 2 above 7^6 = 117649 is 2^17 = 131072. Then 17*log(2) - 6*log(7) = 0.10804..., and 6/(7*0.10804...) = 7.93..., so a(6) = 7.
%t A399581 A399581[n_] := Quotient[n, 7*Log[2]*(Ceiling[#] - #)] & [n*Log2[7]];
%t A399581 Array[A399581, 100] (* _Paolo Xausa_, Oct 21 2026 *)
%o A399581 (Python)
%o A399581 from mpmath import mp, log, ceil, floor
%o A399581 mp.dps = 80
%o A399581 L = log(7)/log(2)
%o A399581 def a(n): return int(floor(n/(7*log(2)*(ceil(n*L) - n*L))))
%o A399581 print([a(n) for n in range(1, 71)])
