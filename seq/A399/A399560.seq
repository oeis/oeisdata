%N A399560 G.f. A(x) satisfies: A(x) = (1 - 2*x^2 + x*A(2*x)) / (1 - x^2 - x^3).
%F A399560 a(n) = 1 for n < 3; a(n) = 2^(n-1) * a(n-1) + a(n-2) + a(n-3).
%t A399560 nmax = 17; A[_] = 1; Do[A[x_] = (1 - 2 x^2 + x A[2 x])/(1 - x^2 - x^3) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A399560 (* Alternative: *)
%t A399560 a[0] = a[1] = a[2] = 1; a[n_] := a[n] = 2^(n - 1) a[n - 1] + a[n - 2] + a[n - 3]; Table[a[n], {n, 0, 17}]
