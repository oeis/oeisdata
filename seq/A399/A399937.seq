%S A399937 1,1,1,1,2,2,4,3,5,3,2,4,4,7,7,4,2,6,4,11,8,4,2,7,4,3,2,2,2,3,4,6,7,4,
%T A399937 2,2,2,3,4,3,2,4,4,8,7,4,2,7,4,3,2,2,2,3,4,3,2,2,2,3,4,6,7,4,2,2,2,3,
%U A399937 4,3,2,4,4,8,7,4,2,2,2,3,4,3,2,4,4,3,2
%N A399937 a(n) is the number of partitions of n into distinct parts such that the sum of primepi(k) over the parts k equals primepi(n).
%H A399937 Pontus von Brömssen, <a href="/A399937/b399937.txt">Table of n, a(n) for n = 0..3325</a>
%F A399937 a(n) >= 2 for n >= 4. The partition (n) works for any n > 0. If n > 0 is composite the partition (n-1,1) works (because primepi(n-1) = primepi(n) and primepi(1) = 0) and if n > 3 is prime the partition (n-2,2) works (because primepi(n-2) = primepi(n)-1 and primepi(2) = 1).
%e A399937 a(6) = 4 due to the partitions (6), (5,1), (4,2), and (3,2,1).
%o A399937 (Python)
%o A399937 from functools import cache
%o A399937 from sympy import primepi
%o A399937 @cache
%o A399937 def A399937(n,m=None,s=None):
%o A399937     if m is None: m = n
%o A399937     if s is None: s = primepi(n)
%o A399937     if m <= 0: return int(n == 0 and s == 0)
%o A399937     return A399937(n,m-1,s)+A399937(n-m,min(m-1,n-m),s-primepi(m))
%o A399937 (PARI) a(n) = my(nb=0, ppn=primepi(n)); forpart(p=n, if (setisset(Vec(p)) && vecsum(apply(primepi, Vec(p))) == ppn, nb++)); nb; \\ _Michel Marcus_, Sep 26 2026
