%S A399043 1,3,3,7,17,7,15,75,75,15,31,305,631,305,31,63,1203,4947,4947,1203,63,
%T A399043 127,4697,38047,76073,38047,4697,127,255,18315,292635,1163715,1163715,
%U A399043 292635,18315,255,511,71585,2265991,17958665,35819311,17958665,2265991,71585,511
%N A399043 Array read by antidiagonals: T(n,m) is the total number of connected components in all induced subgraphs of the rook graph K_n X K_m.
%H A399043 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/RookGraph.html">Rook Graph</a>.
%F A399043 T(n,m) = T(m,n).
%e A399043 Array begins:
%e A399043 ========================================================
%e A399043 n\m |  1    2      3        4          5           6 ...
%e A399043 ----+---------------------------------------------------
%e A399043   1 |  1    3      7       15         31          63 ...
%e A399043   2 |  3   17     75      305       1203        4697 ...
%e A399043   3 |  7   75    631     4947      38047      292635 ...
%e A399043   4 | 15  305   4947    76073    1163715    17958665 ...
%e A399043   5 | 31 1203  38047  1163715   35819311  1116400083 ...
%e A399043   6 | 63 4697 292635 17958665 1116400083 70239008417 ...
%e A399043   ...
%o A399043 (PARI) \\ In G: S is A183109, T is A262307 (compare A360873).
%o A399043 G(M, N=M)={ my(S=matrix(M, N), T=matrix(M, N), U=matrix(M, N), V=matrix(M,N));
%o A399043 for(m=1, M, for(n=1, N,
%o A399043   S[m, n]=sum(j=0, m, (-1)^j*binomial(m, j)*(2^(m - j) - 1)^n);
%o A399043   T[m, n]=S[m, n]-sum(i=1, m-1, sum(j=1, n-1, T[i, j]*S[m-i, n-j]*binomial(m-1, i-1)*binomial(n, j)));
%o A399043   U[m, n]=T[m,n] + sum(i=1, m-1, sum(j=1, n-1, T[i,j]*(S[m-i,n-j]+U[m-i, n-j])*binomial(m-1,i-1)*binomial(n, j)));
%o A399043   V[m, n]=sum(i=1, m, sum(j=1, n, binomial(m, i)*binomial(n, j)*U[i, j]))  ));
%o A399043   V
%o A399043 }
%o A399043 { my(A=G(6)); for(i=1, #A, print(A[i,])) }
%Y A399043 Main diagonal is A399044.
%Y A399043 Columns 1..4 are A000225, A399045, A399046, A399047.
%Y A399043 Cf. A183109, A262307, A286189, A360873, A399039 (grid graph), A399048.
