%T A399440 1,6,0,0,0,3,0,3,0,0,3,0,0,7,0,0,0,0,0,3,0,3,0,0,0,13,0,0,1,0,0,3,0,0,
%U A399440 0,3,0,11,0,0,2,0,1,2,0,5,0,0,0,11,0,0,0,1,0,13,1,0,0,0,0,9,0,0,1,2
%N A399440 Number of pairs (d, e) of divisors of n with d < e < 2*d.
%C A399440 a(n) is the number of pairs of divisors of n whose ratio lies strictly between 1 and 2.
%C A399440 This is the function r(n) of Erdős Problem 449: Erdős asked whether r(n) < eps*tau(n) for almost all n (for every fixed eps > 0), where tau(n) = A000005(n). This is false; Kevin Ford showed that for every K > 0 one has r(n) > K*tau(n) on a set of positive density, deducing it from the negative solution of Erdős Problem 448 (the function tau^+(n) = A397433).
%C A399440 a(n) = 0 if and only if no two divisors of n have ratio less than 2. In particular a(1) = 0, a(p) = 0 for every prime p, and a(2^k) = 0.
%C A399440 a(n) >= A174903(n), the number of divisors d of n that admit another divisor e with d < e < 2*d; equality holds if and only if no divisor d has two divisors in the interval (d, 2*d). The two sequences first differ at n = 60, where a(60) = 13 but A174903(60) = 9.
%D A399440 K. Ford, The distribution of integers with a divisor in a given interval, Ann. of Math. (2) 168 (2008), no. 2, 367-433.
%D A399440 R. R. Hall and G. Tenenbaum, Divisors, Cambridge Tracts in Mathematics 90, Cambridge University Press, 1988.
%H A399440 Hassane Bakkaoui, <a href="/A399440/b399440.txt">Table of n, a(n) for n = 1..10000</a>
%H A399440 T. F. Bloom, <a href="https://www.erdosproblems.com/449">Erdős Problem 449</a>
%H A399440 T. F. Bloom, <a href="https://www.erdosproblems.com/448">Erdős Problem 448</a>
%H A399440 K. Ford, <a href="https://arxiv.org/abs/math/0401223">The distribution of integers with a divisor in a given interval</a>, arXiv:math/0401223 [math.NT], 2004-2008.
%F A399440 a(n) = Sum_{d | n} #{e : e | n and d < e < 2*d}.
%F A399440 a(n) >= A174903(n).
%F A399440 a(p) = 0 for p prime; a(2^k) = 0; a(1) = 0.
%e A399440 a(6) = 1: the divisors of 6 are 1, 2, 3, 6; the only pair (d, e) with d < e < 2*d is (2, 3), since 2 < 3 < 4.
%e A399440 a(12) = 3: the divisors of 12 are 1, 2, 3, 4, 6, 12; the pairs are (2, 3), (3, 4), (4, 6).
%p A399440 a := proc(n) local d, i, j, c;
%p A399440   d := sort(convert(numtheory:-divisors(n), list));
%p A399440   c := 0;
%p A399440   for i to nops(d) do
%p A399440     for j from i + 1 to nops(d) do
%p A399440       if d[j] < 2*d[i] then c := c + 1 end if
%p A399440     end do
%p A399440   end do;
%p A399440   c
%p A399440 end proc:
%p A399440 seq(a(n), n = 1 .. 100);
%t A399440 a[n_] := Module[{d = Divisors[n]}, Sum[Boole[d[[j]] < 2 d[[i]]], {i, Length[d]}, {j, i + 1, Length[d]}]]; Array[a, 100]
%o A399440 (PARI) a(n) = my(d=divisors(n)); sum(i=1, #d, sum(j=i+1, #d, d[j] < 2*d[i]));
%o A399440 (Python)
%o A399440 from sympy import divisors
%o A399440 def a(n):
%o A399440     d = divisors(n)
%o A399440     return sum(1 for i in range(len(d)) for j in range(i + 1, len(d)) if d[j] < 2*d[i])
%Y A399440 Cf. A000005 (number of divisors), A397433 (tau^+(n), Erdős Problem 448), A174903.
%Y A399440 Differs from A174903 first at n = 60.
%K A399440 nonn,easy,new
%O A399440 1,12
%A A399440 _Hassane Bakkaoui_, Aug 28 2026
