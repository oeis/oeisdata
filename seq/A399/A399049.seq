%I A399049 #29 Sep 25 2026 17:00:21
%S A399049 1,2,3,4,5,7,8,10,12,13,15,16,18,19,21,22,24,25,27,28,29,31,33,34,35,
%T A399049 37,39,40,41,43,45,46,47,49,51,52,54,55,57,58,59,61,63,65,66,67,69,70,
%U A399049 71,73,75,77,78,79,81,82,83,85,87,89,90,91,93,94,95,97,99,100,102,103
%N A399049 a(1) = 1; a(n+1) is the smallest integer greater than a(n) such that: a(k) + a(k+4) is not a term for any k.
%C A399049 Let B(n) = floor((3n-1)/2) be the upper bound of the sequence. The deviation Delta(n) = B(n) - a(n) is strictly bounded in {0, 1, 2}. Due to the even jump constraint, the sequence exhibits a modulo 8 structure. For n == 0, 2, 6, 7 (mod 8) (with n > 2), the deviation is fixed at Delta(n) = 1. The remaining variable classes form 2-regular sequences, allowing direct computation of a(n) in O(log n) time via a deterministic finite automaton (see link).
%H A399049 Hoang Xuan Thanh, <a href="/A399049/a399049.py.txt">Deterministic Finite Automaton for the (a(k) + a(k+4))-Avoiding Greedy Sequence</a>
%o A399049 (PARI) greedy_A399049(N) = {my(a = vector(N)); my(max_val = 3 * N); my(forbidden = vector(max_val, i, 0)); my(used = vector(max_val, i, 0)); my(curr = 1); for(n = 1, N, while(curr <= max_val && (used[curr] || forbidden[curr]), curr++); a[n] = curr; used[curr] = 1; if(n > 4,  my(f_sum = a[n-4] + a[n]);  if(f_sum <= max_val, forbidden[f_sum] = 1); ); curr++; ); return(a); }
%o A399049 print(greedy_A399049(70))
%Y A399049 Cf. Sequences avoiding a forbidden sum for any pair at distance k: A001651 (k=1) (upper bound), A399801 (k=2), A399866 (k=3), this sequence (k=4).
%Y A399049 Cf. Sequences avoiding a forbidden sum for any m consecutive terms: A001651 (m=2), A394576 (m=3), A394676 (m=4).
%K A399049 nonn,new
%O A399049 1,2
