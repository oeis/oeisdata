%e A399330   [8] 1430, 297, 62, 13, 3,   1,  6, -15, 70;
%p A399330 # Using function 'binomial_matrix' from A399000.
%p A399330 a := n -> simplify((-1)^n*hypergeom([-n,1/2],[2],4)):
%p A399330 BM := binomial_matrix(a):
%p A399330 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A399330 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%t A399330 (* Uses the function 'binomialMatrix' from A399000. *)
%t A399330 bM = binomialMatrix[(-1)^# * Hypergeometric2F1[-#, 1/2, 2, 4] &];
%t A399330 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A399330 (Python)  # Using function 'binomial_matrix' from A399000.
%o A399330 a = lambda n: 1-n if n < 2 else ((n-1)*(2*a(n-1)+3*a(n-2)))//(n+1)
%o A399330 M = binomial_matrix(a)
%o A399330 for n in range(9): print([M(n, k) for k in range(9)])
