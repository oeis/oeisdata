%S A399053 1,3,6,10,15,21,28,28,37,47,58,70,83,97,112,112,129,147,166,186,207,
%T A399053 229,252,252,277,303,303,331,360,390,421,421,454,488,523,559,596,634,
%U A399053 673,673,714,756,799,843,888,934,981,981,1030,1080,1131,1183,1236,1236,1291
%N A399053 Sum of cubefree numbers <= n.
%C A399053 The distinct terms of this sequence form sequence A358038.
%H A399053 Chai Wah Wu, <a href="/A399053/b399053.txt">Table of n, a(n) for n = 1..10000</a>
%F A399053 a(n) = Sum_{i=1..n} i*A212793(i).
%F A399053 a(n) = Sum_{d=1..floor(n^(1/3))} mu(d)*d^3*binomial(floor(n/d^3)+1,2).
%F A399053 a(10^n) = A389950(n).
%p A399053 a:= proc(n) option remember; `if`(n<1, 0, a(n-1)+
%p A399053       `if`(max(ifactors(n)[2][.., 2])<3, n, 0))
%p A399053     end:
%p A399053 seq(a(n), n=1..55);  # _Alois P. Heinz_, Aug 18 2026
%t A399053 SumCubeFree[n_Integer?Positive] := Total@Select[Range[n], FreeQ[FactorInteger[#], {_, k_ /; k > 2}] &]; Table[SumCubeFree[n], {n, 55}] (* _Stefano Spezia_, Aug 18 2026 after _Henri Lifchitz_ in A389950 *)
%o A399053 (Python)
%o A399053 # uses Python code from A336277
%o A399053 from math import comb
%o A399053 from sympy import integer_nthroot
%o A399053 def A399053(n):
%o A399053     c, j, w = 0, 1, 0
%o A399053     while (j3:=j**3) <= n:
%o A399053         k = n//j3
%o A399053         m = integer_nthroot(n//k,3)[0]
%o A399053         c += (-w+(w:=A336277(m)))*comb(k+1,2)
%o A399053         j = m+1
%o A399053     return c
%Y A399053 Cf. A060431, A066779, A212793, A336277, A358038, A389950.
%K A399053 nonn
%O A399053 1,2
%A A399053 _Chai Wah Wu_, Aug 17 2026
