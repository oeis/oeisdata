%N A399935 G.f.: 1 = Sum_{n>=0} a(n) * x^n / (1 + x)^(3^n).
%F A399935 a(n) = (-1)^n * binomial(3^n+n-1,n) - Sum_{k=0..n-1} (-1)^(n-k) * binomial(3^n+3^k+n-k-1,n-k) * a(k).
%t A399935 a[n_] := a[n] = (-1)^n Binomial[3^n + n - 1, n] - Sum[(-1)^(n - k) Binomial[3^n + 3^k + n - k - 1, n - k] a[k], {k, 0, n - 1}]; Table[a[n], {n, 0, 14}]
