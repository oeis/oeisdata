%p A399338 # Using function 'binomial_matrix' from A399000.
%p A399338 BM := binomial_matrix(doublefactorial):
%p A399338 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A399338 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%t A399338 (* Uses the function 'binomialMatrix' from A399000. *)
%t A399338 bM = binomialMatrix[#!! &];
%t A399338 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A399338 (Python)  # Using function binomial_matrix from A399000.
%o A399338 from sympy import factorial2
%o A399338 M = binomial_matrix(factorial2)
%o A399338 for n in range(9): print([M(n, k) for k in range(9)])
