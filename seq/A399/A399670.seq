%t A399670 Select[Range[200], DivisorSigma[0, #] >= 6 &] (* _Paolo Xausa_, Oct 16 2026 *)
%o A399670 (Python)
%o A399670 from sympy import divisor_count
%o A399670 def ok(n): return divisor_count(n) > 5
%o A399670 print([k for k in range(151) if ok(k)])
