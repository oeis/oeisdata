%I A399863 #13 Sep 28 2026 14:32:39
%S A399863 1,2,3,3,5,6,4,8,9,10,5,11,13,14,15,6,14,18,19,20,21,7,17,23,25,26,27,
%T A399863 28,8,20,28,32,33,34,35,36,9,23,33,39,41,42,43,44,45,10,26,38,46,50,
%U A399863 51,52,53,54,55,11,29,43,53,59,61,62,63,64,65,66
%N A399863 Triangle read by rows: T(n,k) = binomial(n+1,2) - binomial(n-k+1,2) + binomial(n-k,2) - [n-k+1 > k]*binomial(n-2*k+1,2), k = 1..n, with Iverson brackets.
%C A399863 A number k of the form p^i * q^j * rad(k) is such that the smallest possible value of A008479(k) = T(i-1, j-1), where p is the smallest prime factor and q the second smallest distinct prime factor of k, and rad = A007947.
%H A399863 Michael De Vlieger, <a href="/A399863/b399863.txt">Table of n, a(n) for n = 1..11325</a> (rows n = 1..150, flattened.)
%F A399863 T(n,k) = S(n+1,k+1) + R(n+1,k+1), where S(n,k) is the triangle described by A141419, and R(n,k) is the triangle described by A399862.
%e A399863 As a triangle:
%e A399863    1,
%e A399863    2,  3
%e A399863    3,  5,  6
%e A399863    4,  8,  9, 10
%e A399863    5, 11, 13, 14, 15
%e A399863    6, 14, 18, 19, 20, 21
%e A399863    7, 17, 23, 25, 26, 27, 28
%e A399863    8, 20, 28, 32, 33, 34, 35, 36
%e A399863    9, 23, 33, 39, 41, 42, 43, 44, 45
%e A399863    ...
%e A399863 As a rectangle:
%e A399863    1,  2,  3,  4,  5,   6,   7,   8,   9, ...
%e A399863    3,  5,  8, 11, 14,  17,  20,  23,  26, ...
%e A399863    6,  9, 13, 18, 23,  28,  33,  38,  43, ...
%e A399863   10, 14, 19, 25, 32,  39,  46,  53,  60, ...
%e A399863   15, 20, 26, 33, 41,  50,  59,  68,  77, ...
%e A399863   21, 27, 34, 42, 51,  61,  72,  83,  94, ...
%e A399863   28, 35, 43, 52, 62,  73,  85,  98, 111, ...
%e A399863   36, 44, 53, 63, 74,  86,  99, 113, 128, ...
%e A399863   45, 54, 64, 75, 87, 100, 114, 129, 145, ...
%e A399863   ...
%t A399863 f[i_, j_] := Binomial[i + j, 2] - Binomial[i, 2];
%t A399863 g[i_, j_] := Binomial[i - 1, 2] - If[i > j, Binomial[i - j, 2], 0];
%t A399863 Table[f[#, k] + g[#, k] &[n - k + 1], {n, 11}, {k, n}]
%Y A399863 Cf. A007947, A008479, A049777, A141419, A399862.
