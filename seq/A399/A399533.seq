%N A399533 G.f. A(x) satisfies: A(x) = (1 + x^3 * A(2*x)) / (1 - x).
%F A399533 a(n) = 1 for n < 3; a(n) = a(n-1) + 2^(n-3) * a(n-3).
%t A399533 nmax = 24; A[_] = 1; Do[A[x_] = (1 + x^3 A[2 x])/(1 - x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A399533 (* Alternative: *)
%t A399533 a[0] = a[1] = a[2] = 1; a[n_] := a[n] = a[n - 1] + 2^(n - 3) a[n - 3]; Table[a[n], {n, 0, 24}]
