%I A296625 #41 Oct 15 2026 18:09:05
%S A296625 1,2,6,16,42,106,268,660,1618,3922,9438,22540,53528,126358,296836,
%T A296625 694064,1616082,3748262,8662554,19952960,45816586,104899950,239522372,
%U A296625 545512604,1239413976,2809559786,6355120266,14345673452,32320208248,72681519446,163157862988,365645952528,818115036210,1827673345950,4077003501202,9081711646784
%N A296625 a(n) is the total multiplicity of all products of Schur functions s(lambda)*s(lambda) with lambda a partition of n.
%C A296625 Diagonal of the matrix formed by products of all pairs of partitions.
%C A296625 Conjecture: a(n) is the number of domino tilings of diagrams of integer partitions of 2n. - _Gus Wiseman_, Feb 25 2018
%C A296625 The above conjecture is not true, see A304662. - _Alois P. Heinz_, May 22 2018
%H A296625 Alois P. Heinz, <a href="/A296625/b296625.txt">Table of n, a(n) for n = 0..3213</a>
%F A296625 a(n) = A304662(n) for n < 7. - _Alois P. Heinz_, May 22 2018
%F A296625 a(0) = 1; a(n) = (1/n) * Sum_{m=1..n} c(m)*a(n-m) for n >= 1, where c(m) = Sum_{d|m} d*2^(m/d-1) + Sum_{d|m, d odd} (m/d)*2^(m/d-1). - _Vladeta Jovovic_, Oct 13 2026
%e A296625 for n=2,
%e A296625 s(2)*s(2) = s(4) + s(3,1) + s(2,2) and
%e A296625 s(1,1) * s(1,1) = s(2,2) + s(2,1,1) + s(1,1,1,1)
%e A296625 for 6 terms in total.
%p A296625 a:= proc(n) option remember;
%p A296625        add(c(m)*a(n-m), m=1..n)/n
%p A296625     end: a(0):=1:
%p A296625 c:= proc(m) option remember; uses numtheory;
%p A296625        add(d*2^(m/d-1), d=divisors(m)) +
%p A296625        add(`if`(irem(d, 2)=0, 0, (m/d)*2^(m/d-1)), d=divisors(m))
%p A296625     end:
%p A296625 seq(a(n), n=0..35);  # _Alois P. Heinz_, Oct 15 2026
%t A296625 Table[Sum[Length[LRRule[\[Lambda], \[Lambda]]], {\[Lambda], Partitions[n]}], {n, 0, 7}];
%t A296625 (* Uses the Mathematica toolbox for Symmetric Functions from A296624. *)
%Y A296625 Cf. A296624, A296626, A304662.
%K A296625 nonn,changed
%O A296625 0,2
%A A296625 _Wouter Meeussen_, Dec 17 2017
%E A296625 a(13)-a(14) from _Wouter Meeussen_, Nov 22 2018
%E A296625 a(14)-a(35) from _Vladeta Jovovic_, Oct 13 2026
