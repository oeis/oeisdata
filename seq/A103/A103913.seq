%T A103913 4118273,4952356,6433023,7021711,7334323,7621326,7766898,8526056,
%U A103913 8954105,9620344,9637427,9919825,10229406,10558597,10734024,11190685,11364364,11797917,11887245,12424922,15030926
%N A103913 Numbers k such that 2*P(k)+1, 2*P(k+1)+1, 2*P(k+2)-3, 2*P(k+3)+3 are also consecutive primes with P(i)=i-th prime.
%H A103913 Michael S. Branicky, <a href="/A103913/b103913.txt">Table of n, a(n) for n = 1..1000</a>
%o A103913 (PARI) isok(n) = {my(p=2*prime(n)+1, q=2*prime(n+1)+1, r=2*prime(n+2)-3, s=2*prime(n+3)+3); isprime(p) && (nextprime(p+1) == q) && (nextprime(q+1) == r) && (nextprime(r+1) == s);} \\ _Michel Marcus_, Sep 24 2019
%o A103913 (Python)
%o A103913 from sympy import isprime, nextprime, sieve as P
%o A103913 def ok(k):
%o A103913     q, r, s, t = 2*P[k]+1, 2*P[k+1]+1, 2*P[k+2]-3, 2*P[k+3]+3
%o A103913     return isprime(q) and r == nextprime(q+1) and s == nextprime(r+1) and t == nextprime(s+1)
%o A103913 # _Michael S. Branicky_, Aug 12 2026
%Y A103913 Cf. A103911, A103912.
