%S A103911 34771,219423,507698,776248,920369,1655143,1820948,1847083,1883839,
%T A103911 2179339,2747429,2979743,3075306,3516977,3579987,3905386,3991750,
%U A103911 4167882,5183712,5288393,5573155,7113614,7118715,7419943,7456133,7613264,7727191,7778626,9043920,10117644
%N A103911 Numbers k such that 2*P(k)+1, 2*P(k+1)+1, 2*P(k+2)+3, 2*P(k+3)+3 are also consecutive primes with P(i)=i-th prime.
%H A103911 Michael S. Branicky, <a href="/A103911/b103911.txt">Table of n, a(n) for n = 1..1000</a>
%t A103911 cpQ[n_]:=Module[{a=2Prime[n]+1,b=2Prime[n+1]+1,c=2Prime[n+2]+3,d= 2Prime[ n+3]+3}, PrimeQ[ a]&&NextPrime[a]==b&&NextPrime[b]==c&&NextPrime[c]==d]; Select[Range[5200000],cpQ] (* _Harvey P. Dale_, Mar 08 2014 *)
%o A103911 (Python)
%o A103911 from sympy import isprime, nextprime, sieve as P
%o A103911 def ok(k):
%o A103911     q, r, s, t = 2*P[k]+1, 2*P[k+1]+1, 2*P[k+2]+3, 2*P[k+3]+3
%o A103911     return isprime(q) and r == nextprime(q+1) and s == nextprime(r+1) and t == nextprime(s+1)
%o A103911 # _Michael S. Branicky_, Aug 12 2026
%Y A103911 Cf. A103912, A103913.
