%I A123181 #18 Aug 24 2026 01:08:54
%S A123181 1,6,312,495,990,20520,23664,64416,13063050,1131028275,2262056550,
%T A123181 28055889576,47519653632
%N A123181 Numbers m such that (-1)Sigma(m)*UnitarySigma(m) = k*UnitaryPhi(m)*m for some integer k.
%C A123181 _R. J. Mathar_ did an exhaustive search up to 74000000. Kohmoto found one more term, 2^8*3*11*43*257*509 with k=3, but between 7.4*10^7 and this term, many terms may be missing.
%p A123181 isA123181 := proc(m)
%p A123181     A047994(m) ;
%p A123181     modp(A049060(m)*A034448(m),%*m) = 0 ;
%p A123181 end proc:
%p A123181 for m from 1 do
%p A123181     if isA123181(m) then
%p A123181         printf("%a,\n", m) ;
%p A123181     end if;
%p A123181 end do: # _R. J. Mathar_, Sep 04 2018
%t A123181 f[p_, e_] := (p^(e + 1) - 2*p + 1)/(p-1)*(p^e + 1)/(p^e - 1); q[1] = True; q[k_] := Denominator[(Times @@ f @@@ FactorInteger[k])/k] == 1; Select[Range[10^5], q] (* _Amiram Eldar_, Aug 24 2026 *)
%o A123181 (PARI) isok(k) = {my(f = factor(k)); denominator(prod(i = 1, #f~, p=f[i,1]; e=f[i,2]; (p^(e + 1) - 2*p + 1)/(p-1)*(p^e + 1)/(p^e - 1))/k) == 1;} \\ _Amiram Eldar_, Aug 24 2026
%Y A123181 Cf. A123182, A049060, A034448, A047994.
%K A123181 nonn,more,changed
%O A123181 1,2
%A A123181 _Yasutoshi Kohmoto_, Oct 03 2006
%E A123181 1 preprended by _R. J. Mathar_, Sep 04 2018
%E A123181 a(10)-a(12) added and a(13) confirmed by _Amiram Eldar_, Aug 24 2026
