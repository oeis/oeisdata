%I A123182 #17 Aug 24 2026 01:08:51
%S A123182 1,2,3,2,3,4,3,3,4,2,3,4,3
%N A123182 Values of k in A123181 in the order of their appearance.
%F A123182 a(n) = A049060(m)*A034448(m)/(m*A047994(m)), m = A123181(n). - _R. J. Mathar_, Sep 04 2018
%t A123182 f[p_, e_] := (p^(e + 1) - 2*p + 1)/(p-1)*(p^e + 1)/(p^e - 1); s[1] = 1; s[m_] := (Times @@ f @@@ FactorInteger[m])/m; Select[s /@ Range[10^5], IntegerQ] (* _Amiram Eldar_, Aug 24 2026 *)
%o A123182 (PARI) s(m) = {my(f = factor(m)); prod(i = 1, #f~, p=f[i,1]; e=f[i,2]; (p^(e + 1) - 2*p + 1)/(p-1)*(p^e + 1)/(p^e - 1))/m;}
%o A123182 list(mmax) = {my(k); for(m = 1, mmax, k = s(m); if(denominator(k) == 1, print1(k, ", ")));} \\ _Amiram Eldar_, Aug 24 2026
%Y A123182 Cf. A123181.
%K A123182 nonn,more,changed
%O A123182 1,2
%A A123182 _Yasutoshi Kohmoto_, Oct 03 2006
%E A123182 1 prepended by _R. J. Mathar_, Sep 04 2018
%E A123182 a(10)-a(13) from _Amiram Eldar_, Aug 24 2026
