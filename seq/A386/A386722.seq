%S A386722 1,8,91,1214,17731,274526,4426948,73561238,1250803171,21659155028,
%T A386722 380638861219,6771681469952,121716110229364,2207040281944856,
%U A386722 40323735229993336,741613603443652214,13718779315483616227,255086483631977702096,4764893748897482791633,89373590789286772582334
%N A386722 Expansion of (1/x) * Series_Reversion( x * (1-x)^2 / (1+2*x)^3 ).
%H A386722 Robert Israel, <a href="/A386722/b386722.txt">Table of n, a(n) for n = 0..765</a>
%H A386722 <a href="/index/Res#revert">Index entries for reversions of series</a>
%F A386722 a(n) = (1/(n+1)) * Sum_{k=0..n} 2^k * binomial(3*(n+1),k) * binomial(3*n-k+1,n-k).
%F A386722 a(n) = (1/(n+1)) * [x^n] ( (1+2*x)^3 / (1-x)^2 )^(n+1).
%F A386722 D-finite with recurrence: 1080*(3*n + 5)*(3*n + 4)*a(n) - 3*(781*n^2 + 3231*n + 3588)*a(n + 1) + (173*n^2 + 996*n + 1456)*a(n + 2) - 2*(n + 4)*(2*n + 7)*a(n + 3) = 0. - _Robert Israel_, Aug 09 2026
%p A386722 with(gfun):
%p A386722 eq:= numer(x - y*x*(1-y*x)^2/(1+2*y*x)^3):
%p A386722 de:= algeqtodiffeq(eq, y(x)):
%p A386722 rec:= diffeqtorec(de, y(x), a(n)):
%p A386722 f:= rectoproc(rec,a(n),remember):
%p A386722 map(f, [$0..20]); # _Robert Israel_, Aug 09 2026
%o A386722 (PARI) my(N=30, x='x+O('x^N)); Vec(serreverse(x*(1-x)^2/(1+2*x)^3)/x)
%o A386722 (PARI) a(n) = sum(k=0, n, 2^k*binomial(3*(n+1), k)*binomial(3*n-k+1, n-k))/(n+1);
%Y A386722 Cf. A371391, A386723.
%Y A386722 Cf. A385320.
%K A386722 nonn
%O A386722 0,2
