%N A386831 a(n) = Sum_{k=0..n} 3^k * 2^(n-k) * binomial(4*n+1,k) * binomial(4*n-k,n-k).
%F A386831 a(n) = [x^n] (1+3*x)^(4*n+1)/(1-2*x)^(3*n+1).
