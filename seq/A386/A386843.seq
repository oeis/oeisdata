%U A386843 69291946278861,538372925816886,4189702003359687,32651982699233340,254800541773725633,1990683254889381954
%N A386843 a(n) = Sum_{k=0..n} binomial(2*n+2,k) * binomial(2*n-k,n-k).
%F A386843 a(n) = [x^n] (1+x)^(2*n+2)/(1-x)^(n+1).
%F A386843 a(n) = [x^n] 1/((1-x)^2 * (1-2*x)^(n+1)).
%F A386843 a(n) = Sum_{k=0..n} 2^k * (-1)^(n-k) * (n-k+1) * binomial(2*n+2,k).
%F A386843 a(n) = Sum_{k=0..n} 2^k * (n-k+1) * binomial(n+k,k).
%F A386843 Conjecture D-finite with recurrence 5*n*a(n) +3*(-13*n+11)*a(n-1) +12*(-n-8)*a(n-2) +16*(2*n-3)*a(n-3)=0. - _R. J. Mathar_, Nov 02 2026
%F A386843 Conjecture D-finite with recurrence n*(n-1)*a(n) -(7*n-5)*(n-1)*a(n-1) -4*n*(2*n-1)*a(n-2)=0. - _R. J. Mathar_, Nov 02 2026
%o A386843 (PARI) a(n) = sum(k=0, n, binomial(2*n+2, k)*binomial(2*n-k, n-k));
