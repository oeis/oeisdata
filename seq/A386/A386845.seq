%N A386845 a(n) = Sum_{k=0..n} binomial(4*n+2,k) * binomial(4*n-k,n-k).
%F A386845 a(n) = [x^n] (1+x)^(4*n+2)/(1-x)^(3*n+1).
%F A386845 a(n) = [x^n] 1/((1-x)^2 * (1-2*x)^(3*n+1)).
%F A386845 a(n) = Sum_{k=0..n} 2^k * (-1)^(n-k) * (n-k+1) * binomial(4*n+2,k).
%F A386845 a(n) = Sum_{k=0..n} 2^k * (n-k+1) * binomial(3*n+k,k).
%F A386845 Conjecture D-finite with recurrence 357*n*(3*n-1)*(3*n-2)*a(n) +(209315*n^3 -1243758*n^2 +2143003*n -1111620)*a(n-1) +2*(-927859*n^3 -102078*n^2 +14674297*n -21847920)*a(n-2) +20*(-2949299*n^3 +26977560*n^2 -83822227*n +87003534)*a(n-3) -1778880*(2*n-5)*(4*n-13)*(4*n-11)*a(n-4)=0. - _R. J. Mathar_, Nov 02 2026
%F A386845 Conjecture D-finite with recurrence 3*n*(3*n-1)*(3*n-2)*(77*n^2-215*n+152)*a(n) +(-37345*n^5 +163411*n^4 -265221*n^3 +198401*n^2 -68846*n +9240)*a(n-1) -16*(4*n-3)*(2*n-1)*(4*n-5) *(77*n^2-61*n+14)*a(n-2)=0. - _R. J. Mathar_, Nov 02 2026
%o A386845 (PARI) a(n) = sum(k=0, n, binomial(4*n+2, k)*binomial(4*n-k, n-k));
