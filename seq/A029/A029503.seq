%S A029503 1,2,3,5,6,9,101,107,153,167,277,414,486,858,1659,2894,3093,4299,4842,
%T A029503 8838,22734,31869,69492,361057,429786,462018,859002,1170801,1334667,
%U A029503 1663923,6143512,6162396,6212646,7034661,8164443,205092269,259318224,677232324,1383613941,1983496001,2913159143,3336183009
%N A029503 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 10 (most significant digit on right).
%C A029503 This sequence differs from A061939 in that all least significant zeros are kept during concatenation.
%C A029503 Right concatenation, reverse order.
%C A029503 No more terms < 10^7. - _Lars Blomberg_, Oct 06 2011
%C A029503 No other terms < 3*10^11. - _Jeff Sponaugle_, Nov 05 2026
%H A029503 Jeff Sponaugle, <a href="/A029503/b029503.txt">Table of n, a(n) for n = 1..46</a>
%H A029503 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029503 n = 22 is not a term since 12345678901112131415161718191021222 is not divisible by 22.
%e A029503 a(7) = 101: written in base 10 with the most significant digit on the right, zeros kept, 1..101 are 1, 2, ..., 9, 01, 11, ..., 101; their concatenation 12345678901112131415...798999001101 in base 10 has 195 digits and is divisibleby 101.
%t A029503 b = 10; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 12 2020 *)
%o A029503 (PARI) isok(n) = my(s = ""); for (k=1, n, sk = digits(k); forstep (j=#sk, 1, -1, s = concat(s, sk[j]))); (eval(s) % n) == 0; \\ _Michel Marcus_, Jan 28 2017
%o A029503 (Python)
%o A029503 from itertools import count, islice
%o A029503 def A029503_gen(): # generator of terms
%o A029503     c = 0
%o A029503     for n in count(1):
%o A029503         v, k, l = 0, n, 0
%o A029503         while k:
%o A029503             k, r = divmod(k, 10)
%o A029503             v, l = 10*v+r, l+1 # n in base 10 backwards: value v, l digits
%o A029503         c = c*10**l+v # append it on the right
%o A029503         if c % n == 0:
%o A029503             yield n
%o A029503 A029503_list = list(islice(A029503_gen(), 21)) # _Jeff Sponaugle_, Nov 05 2026
