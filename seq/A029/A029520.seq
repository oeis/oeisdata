%I A029520 #47 Nov 14 2026 09:24:18
%S A029520 1,4,5,7,19,443,19952,81544,919648,1186844,35007875,55519853,
%T A029520 564397417,950571664,1178564356,9875685905,12680909180,42422329793,
%U A029520 98301131209
%N A029520 Numbers k such that k divides the (left) concatenation of all numbers <= k written in base 3 (most significant digit on right and removing all least significant zeros before concatenation).
%C A029520 This sequence differs from A061956 in that all least significant zeros are removed before concatenation.
%C A029520 No more terms < 10^7. [_Lars Blomberg_, Sep 02 2011]
%C A029520 No other terms < 10^12. - _Jeff Sponaugle_, Nov 13 2026
%H A029520 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029520 a(2) = 4: 1..4 in base 3 are 1, 2, 10, 11. Written with the most significant digit on the right, least significant zeros dropped, they are 1, 2, 1, 11; concatenated from 4 down to 1 they give 11121 in base 3, which is 124 = 4*31.
%t A029520 b = 3; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[IntegerDigits[IntegerReverse[#, b], b], c], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029520 (Python)
%o A029520 from itertools import count, islice
%o A029520 def A029520_gen(): # generator of terms
%o A029520     c, p = 0, 1 # p = 3**(digits so far)
%o A029520     for n in count(1):
%o A029520         v, k, l = 0, n, 0
%o A029520         while k % 3 == 0:
%o A029520             k //= 3 # drop the least significant zeros
%o A029520         while k:
%o A029520             k, r = divmod(k, 3)
%o A029520             v, l = 3*v+r, l+1 # n in base 3 backwards: value v, l digits
%o A029520         c, p = c+v*p, p*3**l # put it on the left
%o A029520         if c % n == 0:
%o A029520             yield n
%o A029520 A029520_list = list(islice(A029520_gen(), 7)) # _Jeff Sponaugle_, Nov 11 2026
%Y A029520 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
