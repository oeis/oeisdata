%S A029506 1,3,9,15,21,25,35,47,48,87,240,320,672,896,1760,2592,2688,3659,5152,
%T A029506 15456,16800,53200,60288,75360,92605,92736,121600,189648,204176,
%U A029506 334827,382368,401472,443919,1070720,1836855,2010432,4384128,5566077,19206432,47105349,52832192,63954317,64816325,91693616
%N A029506 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 13 (most significant digit on right).
%C A029506 This sequence differs from A061942 in that all least significant zeros are kept during concatenation.
%C A029506 No more terms < 10^7. - _Lars Blomberg_, Oct 07 2011
%C A029506 No other terms < 4*10^11. - _Jeff Sponaugle_, Nov 05 2026
%H A029506 Jeff Sponaugle, <a href="/A029506/b029506.txt">Table of n, a(n) for n = 1..65</a>
%H A029506 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029506 a(4) = 15: written in base 13 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..15 are 1, 2, ..., C, 01, 11, 21; their concatenation 123456789ABC011121 in base 13 is 10152224238713144160 = 15*676814949247542944.
%t A029506 b = 13; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 12 2020 *)
%o A029506 (PARI) lista(nn, m=13) = my(s, t); for(k=1, nn, s=k; while(s, t=t*m+s%m; s\=m); if(t%k==0, print1(k, ", "))); \\ _Jinyuan Wang_, Dec 05 2020
%o A029506 (Python)
%o A029506 from itertools import count, islice
%o A029506 def A029506_gen(): # generator of terms
%o A029506     c = 0
%o A029506     for n in count(1):
%o A029506         v, k, l = 0, n, 0
%o A029506         while k:
%o A029506             k, r = divmod(k, 13)
%o A029506             v, l = 13*v+r, l+1 # n in base 13 backwards: value v, l digits
%o A029506         c = c*13**l+v # append it on the right
%o A029506         if c % n == 0:
%o A029506             yield n
%o A029506 A029506_list = list(islice(A029506_gen(), 21)) # _Jeff Sponaugle_, Nov 05 2026
%Y A029506 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
