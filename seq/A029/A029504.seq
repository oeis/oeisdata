%S A029504 1,5,15,24,40,69,72,75,120,167,216,280,360,536,1192,1240,1360,11280,
%T A029504 25195,33216,33984,101328,221640,400479,531000,537640,600104,631155,
%U A029504 743085,958785,2660431,2777800,14330472,18635736,41678081,42583280,54652755,55767345,73412985,81156909,111858960,153846735
%N A029504 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 11 (most significant digit on right).
%C A029504 This sequence differs from A061940 in that all least significant zeros are kept during concatenation.
%C A029504 No more terms < 10^7. - _Lars Blomberg_, Oct 06 2011
%C A029504 No other terms < 4*10^11. - _Jeff Sponaugle_, Nov 05 2026
%H A029504 Jeff Sponaugle, <a href="/A029504/b029504.txt">Table of n, a(n) for n = 1..61</a>
%H A029504 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029504 a(3) = 15: written in base 11 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..15 are 1, 2, ..., A, 01, 11, ..., 41; their concatenation 123456789A0111213141 in base 11 is 74002499414027018220 = 15*4933499960935134548.
%t A029504 b = 11; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 12 2020 *)
%o A029504 (Python)
%o A029504 from itertools import count, islice
%o A029504 def A029504_gen(): # generator of terms
%o A029504     c = 0
%o A029504     for n in count(1):
%o A029504         v, k, l = 0, n, 0
%o A029504         while k:
%o A029504             k, r = divmod(k, 11)
%o A029504             v, l = 11*v+r, l+1 # n in base 11 backwards: value v, l digits
%o A029504         c = c*11**l+v # append it on the right
%o A029504         if c % n == 0:
%o A029504             yield n
%o A029504 A029504_list = list(islice(A029504_gen(), 19)) # _Jeff Sponaugle_, Nov 05 2026
%Y A029504 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
