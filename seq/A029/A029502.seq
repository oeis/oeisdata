%S A029502 1,3,32,320,544,2048,3331,5833,32281,125120,145760,317621,889760,
%T A029502 7371043,681881344,1195505760,1599149920,4700627456,7025720960,
%U A029502 8406182543,9491260256,11118505056,21765348960,27178524416,30063049760,207498386080,219046248797
%N A029502 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 9 (most significant digit on right).
%C A029502 This sequence differs from A061938 in that all least significant zeros are kept during concatenation.
%C A029502 No more terms < 10^7. - _Lars Blomberg_, Oct 04 2011
%C A029502 No other terms < 3*10^11. - _Jeff Sponaugle_, Nov 04 2026
%H A029502 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029502 a(3) = 32: written in base 9 with the most significant digit on the right, zeros kept, 1..32 are 1, 2, ..., 8, 01, 11, ..., 53; their concatenation 12345678011121314151617181021222324252627282031323334353 in base 9 is divisible by 32.
%t A029502 b = 9; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 12 2020 *)
%o A029502 (PARI) lista(nn, m=9) = my(s, t); for(k=1, nn, s=k; while(s, t=t*m+s%m; s\=m); if(t%k==0, print1(k, ", "))); \\ _Jinyuan Wang_, Dec 05 2020
%o A029502 (Python)
%o A029502 from itertools import count, islice
%o A029502 def A029502_gen(): # generator of terms
%o A029502     c = 0
%o A029502     for n in count(1):
%o A029502         v, k, l = 0, n, 0
%o A029502         while k:
%o A029502             k, r = divmod(k, 9)
%o A029502             v, l = 9*v+r, l+1 # n in base 9 backwards: value v, l digits
%o A029502         c = c*9**l+v # append it on the right
%o A029502         if c % n == 0:
%o A029502             yield n
%o A029502 A029502_list = list(islice(A029502_gen(), 8)) # _Jeff Sponaugle_, Nov 04 2026
%Y A029502 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
