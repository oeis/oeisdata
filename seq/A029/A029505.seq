%S A029505 1,2,3,4,6,11,106,616,990,1232,1276,1534,3494,8140,43054,52634,97691,
%T A029505 99280,131846,136006,355877,617749,824703,2115058,3011987,13043294,
%U A029505 20007789,32019806,86624921,152294905,682423753,1027145918,1034792902,1769218660,7012059439,14211109187,14898485107,64661067841
%N A029505 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 12 (most significant digit on right).
%C A029505 This sequence differs from A061941 in that all least significant zeros are kept during concatenation.
%C A029505 No more terms < 10^7. - _Lars Blomberg_, Oct 07 2011
%C A029505 No other terms < 4*10^11. - _Jeff Sponaugle_, Nov 05 2026
%H A029505 Jeff Sponaugle, <a href="/A029505/b029505.txt">Table of n, a(n) for n = 1..41</a>
%H A029505 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029505 a(7) = 106: written in base 12 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..106 are 1, 2, ..., B, 01, 11, ..., A8; their concatenation 123456789AB011121314...5868788898A8 in base 12 has 201 digits and is divisible by 106.
%t A029505 b = 12; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 12 2020 *)
%o A029505 (Python)
%o A029505 from itertools import count, islice
%o A029505 def A029505_gen(): # generator of terms
%o A029505     c = 0
%o A029505     for n in count(1):
%o A029505         v, k, l = 0, n, 0
%o A029505         while k:
%o A029505             k, r = divmod(k, 12)
%o A029505             v, l = 12*v+r, l+1 # n in base 12 backwards: value v, l digits
%o A029505         c = c*12**l+v # append it on the right
%o A029505         if c % n == 0:
%o A029505             yield n
%o A029505 A029505_list = list(islice(A029505_gen(), 14)) # _Jeff Sponaugle_, Nov 05 2026
%Y A029505 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
