%F A029408 a(n) = floor((n^3+54*n^2+636*n+8128)/31680 - (n mod 2)*n/192 + ((n^3+n^2+n+2) mod 4)*n/96 + ((4*n^3+n^2+4*n+2) mod 5)/5 + ((6*n^3+5*n^2+10*n+5) mod 11)/11). - _Hoang Xuan Thanh_, Aug 10 2026
