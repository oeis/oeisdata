%S A029500 1,3,11,16,48,480,947,1111,1137,1367,2125,6351,6841,8209,11392,32931,
%T A029500 166413,173904,263547,284047,634832,690589,2495931,6696245,7004640,
%U A029500 38241984,45637104,203134032,913535989,9852489792,30289620673,33712276128,36669618432,48384089856
%N A029500 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 7 (most significant digit on right).
%C A029500 This sequence differs from A061936 in that all least significant zeros are kept during concatenation.
%C A029500 No more terms < 10^7. - _Lars Blomberg_, Oct 03 2011
%C A029500 No other terms < 2*10^11. - _Jeff Sponaugle_, Nov 04 2026
%H A029500 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029500 a(3) = 11: 1..11 in base 7 are 1, 2, 3, 4, 5, 6, 10, 11, 12, 13, 14. Written with the most significant digit on the right, zeros kept, they are 1, 2, 3, 4, 5, 6, 01, 11, 21, 31, 41, and their concatenation 1234560111213141 in base 7 is 6461628063990 = 11*587420733090.
%t A029500 b = 7; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 12 2020 *)
%o A029500 (Python)
%o A029500 from itertools import count, islice
%o A029500 def A029500_gen(): # generator of terms
%o A029500     c = 0
%o A029500     for n in count(1):
%o A029500         v, k, l = 0, n, 0
%o A029500         while k:
%o A029500             k, r = divmod(k, 7)
%o A029500             v, l = 7*v+r, l+1 # n in base 7 backwards: value v, l digits
%o A029500         c = c*7**l+v # append it on the right
%o A029500         if c % n == 0:
%o A029500             yield n
%o A029500 A029500_list = list(islice(A029500_gen(), 15)) # _Jeff Sponaugle_, Nov 03 2026
%Y A029500 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
