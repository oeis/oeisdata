%I A029499 #25 Nov 04 2026 14:55:51
%S A029499 1,2,3,5,37,73,80,104,135,149,160,170,2860,3547,63335,112405,198734,
%T A029499 703957,1353979,21823558,46717373,101052095,139369832,181381366,
%U A029499 626927561,1598354140,10426560428,16550671135,39744951115,51098458755,58344091160,95892838715
%N A029499 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 6 (most significant digit on right).
%C A029499 This sequence differs from A061935 in that all least significant zeros are kept during concatenation.
%C A029499 No more terms < 10^7. - _Lars Blomberg_, Oct 03 2011
%C A029499 No other terms < 2*10^11. - _Jeff Sponaugle_, Nov 04 2026
%H A029499 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029499 a(5) = 37: written in base 6 with the most significant digit on the right, zeros kept, 1..37 are 1, 2, ..., 5, 01, 11, ..., 101; their concatenation 12345011121314151021...354555001101 in base 6 has 71 digits and is divisible by 37.
%t A029499 b = 6; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 12 2020 *)
%o A029499 (Python)
%o A029499 from itertools import count, islice
%o A029499 def A029499_gen(): # generator of terms
%o A029499     c = 0
%o A029499     for n in count(1):
%o A029499         v, k, l = 0, n, 0
%o A029499         while k:
%o A029499             k, r = divmod(k, 6)
%o A029499             v, l = 6*v+r, l+1 # n in base 6 backwards: value v, l digits
%o A029499         c = c*6**l+v # append it on the right
%o A029499         if c % n == 0:
%o A029499             yield n
%o A029499 A029499_list = list(islice(A029499_gen(), 14)) # _Jeff Sponaugle_, Nov 03 2026
%Y A029499 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
