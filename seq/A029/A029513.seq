%I A029513 #23 Nov 10 2026 23:18:18
%S A029513 1,2,4,5,6,10,12,14,18,19,53,703,1824,2185,2546,5054,6594,9841,
%T A029513 1393056,1648110,1984492,2648114,3430811,8070122,27330416,36079879,
%U A029513 51958819,141563002,267195684,517106782,539501592,1172001474,1207120278,10540217992,15995706488
%N A029513 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 20 (most significant digit on right).
%C A029513 This sequence differs from A061949 in that all least significant zeros are kept during concatenation.
%C A029513 No more terms < 10^7. [_Lars Blomberg_, Oct 14 2011]
%C A029513 No other terms < 9*10^11. - _Jeff Sponaugle_, Nov 10 2026
%H A029513 Jeff Sponaugle, <a href="/A029513/b029513.txt">Table of n, a(n) for n = 1..44</a>
%H A029513 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029513 See A029495 for example.a(11) = 53: written in base 20 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..53 are 1, 2, ..., J, 01, 11, ..., D2; their concatenation 123456789ABCDEFGHIJ0...8292A2B2C2D2 in base 20 has 87 digits and is divisible by 53.
%t A029513 b = 20; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029513 (Python)
%o A029513 from itertools import count, islice
%o A029513 def A029513_gen(): # generator of terms
%o A029513     c = 0
%o A029513     for n in count(1):
%o A029513         v, k, l = 0, n, 0
%o A029513         while k:
%o A029513             k, r = divmod(k, 20)
%o A029513             v, l = 20*v+r, l+1 # n in base 20 backwards: value v, l digits
%o A029513         c = c*20**l+v # append it on the right
%o A029513         if c % n == 0:
%o A029513             yield n
%o A029513 A029513_list = list(islice(A029513_gen(), 18)) # _Jeff Sponaugle_, Nov 10 2026
%Y A029513 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
