%I A029523 #35 Nov 14 2026 23:47:12
%S A029523 1,5,19,35,55,85,505,12047,113935,1107173,21814765,160973896009
%N A029523 Numbers k such that k divides the (left) concatenation of all numbers <= k written in base 6 (most significant digit on right and removing all least significant zeros before concatenation).
%C A029523 This sequence differs from A061959 in that all least significant zeros are removed before concatenation.
%C A029523 No more terms < 10^7. [_Lars Blomberg_, Sep 05 2011]
%C A029523 No other terms < 10^12. - _Jeff Sponaugle_, Nov 14 2026
%H A029523 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029523 a(3) = 19: written in base 6 with the most significant digit on the right, least significant zeros dropped, 1..19 are 1, 2, ..., 5, 1, 11, ..., 13; concatenated from 19 down to 1 they give 133524232221225141312111154321 in base 6, which is 59269700653762434097225 = 19*3119457929145391268275.
%t A029523 b = 6; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[IntegerDigits[IntegerReverse[#, b], b], c], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029523 (Python)
%o A029523 from itertools import count, islice
%o A029523 def A029523_gen(): # generator of terms
%o A029523     c, p = 0, 1 # p = 6**(digits so far)
%o A029523     for n in count(1):
%o A029523         v, k, l = 0, n, 0
%o A029523         while k % 6 == 0:
%o A029523             k //= 6 # drop the least significant zeros
%o A029523         while k:
%o A029523             k, r = divmod(k, 6)
%o A029523             v, l = 6*v+r, l+1 # n in base 6 backwards: value v, l digits
%o A029523         c, p = c+v*p, p*6**l # put it on the left
%o A029523         if c % n == 0:
%o A029523             yield n
%o A029523 A029523_list = list(islice(A029523_gen(), 8)) # _Jeff Sponaugle_, Nov 11 2026
%Y A029523 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
%K A029523 nonn,base,more,changed
