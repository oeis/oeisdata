%I A029510 #22 Nov 10 2026 23:17:57
%S A029510 1,19,27,45,64,111,192,243,320,1152,2112,3456,10747,11328,13824,16896,
%T A029510 18909,177408,306335,338369,414336,423552,1176203,2965056,15452224,
%U A029510 18611317,39652992,74919168,78002496,85814869,377854272,410173440,469226304,773029953
%N A029510 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 17 (most significant digit on right).
%C A029510 This sequence differs from A061946 in that all least significant zeros are kept during concatenation.
%C A029510 No more terms < 10^7. [_Lars Blomberg_, Oct 09 2011]
%C A029510 No other terms < 9*10^11. - _Jeff Sponaugle_, Nov 10 2026
%H A029510 Jeff Sponaugle, <a href="/A029510/b029510.txt">Table of n, a(n) for n = 1..51</a>
%H A029510 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029510 a(2) = 19: written in base 17 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..19 are 1, 2, ..., G, 01, 11, 21; their concatenation 123456789ABCDEFG011121 in base 17 is 77998316018982514828094654 = 19*4105174527314869201478666.
%t A029510 b = 17; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029510 (Python)
%o A029510 from itertools import count, islice
%o A029510 def A029510_gen(): # generator of terms
%o A029510     c = 0
%o A029510     for n in count(1):
%o A029510         v, k, l = 0, n, 0
%o A029510         while k:
%o A029510             k, r = divmod(k, 17)
%o A029510             v, l = 17*v+r, l+1 # n in base 17 backwards: value v, l digits
%o A029510         c = c*17**l+v # append it on the right
%o A029510         if c % n == 0:
%o A029510             yield n
%o A029510 A029510_list = list(islice(A029510_gen(), 17)) # _Jeff Sponaugle_, Nov 10 2026
%Y A029510 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
