%I A029529 #31 Nov 27 2026 12:24:33
%S A029529 1,11,143,1771,1931,3223,7409,17017,32417,125477,863203,14870735,
%T A029529 29849777,207060341,1126913381,9937184543,31649409979,39164989451,
%U A029529 648985446043
%N A029529 Numbers k such that k divides the (left) concatenation of all numbers <= k written in base 12 (most significant digit on right and removing all least significant zeros before concatenation).
%C A029529 This sequence differs from A061965 in that all least significant zeros are removed before concatenation.
%C A029529 No more terms < 10^7. - _Lars Blomberg_, Sep 14 2011
%C A029529 No other terms < 10^12. - _Jeff Sponaugle_, Nov 25 2026
%H A029529 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029529 a(3) = 143: written in base 12 (digits A = 10, B = 11, ...) with the most significant digit on the right, least significant zeros dropped, 1..143 are 1, 2, ..., B, 1, 11, ..., BB; concatenated from 143 down to 1 they give BBAB9B8B7B6B5B4B3B2B...1BA987654321 in base 12, which has 264 digits and is divisible by 143.
%t A029529 b = 12; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[IntegerDigits[IntegerReverse[#, b], b], c], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029529 (PARI) lista(nn, m=12) = my(c, s, t); for(k=1, nn, t+=m^c*s=fromdigits(Vecrev(digits(k, m)), m); c+=logint(s, m)+1; if(t%k==0, print1(k, ", "))); \\ _Jinyuan Wang_, Dec 05 2020
%o A029529 (Python)
%o A029529 from itertools import count, islice
%o A029529 def A029529_gen(): # generator of terms
%o A029529     c, p = 0, 1 # p = 12**(digits so far)
%o A029529     for n in count(1):
%o A029529         v, k, l = 0, n, 0
%o A029529         while k % 12 == 0:
%o A029529             k //= 12 # drop the least significant zeros
%o A029529         while k:
%o A029529             k, r = divmod(k, 12)
%o A029529             v, l = 12*v+r, l+1 # n in base 12 backwards: value v, l digits
%o A029529         c, p = c+v*p, p*12**l # put it on the left
%o A029529         if c % n == 0:
%o A029529             yield n
%o A029529 A029529_list = list(islice(A029529_gen(), 8)) # _Jeff Sponaugle_, Nov 25 2026
%Y A029529 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
