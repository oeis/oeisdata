%I A029511 #22 Nov 10 2026 23:17:53
%S A029511 1,2,3,6,9,17,25,65,85,160,169,175,187,221,325,856,1965,2264,2309,
%T A029511 3332,4080,4182,6073,20757,23392,47345,88689,97846,672676,901816,
%U A029511 1317677,2120393,8595637,16810042,78060380,155403382,247039495,417107172,1665237146
%N A029511 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 18 (most significant digit on right).
%C A029511 This sequence differs from A061947 in that all least significant zeros are kept during concatenation.
%C A029511 No more terms < 10^7. [_Lars Blomberg_, Oct 11 2011]
%C A029511 No other terms < 9*10^11. - _Jeff Sponaugle_, Nov 10 2026
%H A029511 Jeff Sponaugle, <a href="/A029511/b029511.txt">Table of n, a(n) for n = 1..50</a>
%H A029511 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029511 a(7) = 25: written in base 18 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..25 are 1, 2, ..., H, 01, 11, ..., 71; their concatenation 123456789ABCDEFGH0111213141516171 in base 18 is 16533596356398827187379355633557547743075 = 25*661343854255953087495174225342301909723.
%t A029511 b = 18; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029511 (Python)
%o A029511 from itertools import count, islice
%o A029511 def A029511_gen(): # generator of terms
%o A029511     c = 0
%o A029511     for n in count(1):
%o A029511         v, k, l = 0, n, 0
%o A029511         while k:
%o A029511             k, r = divmod(k, 18)
%o A029511             v, l = 18*v+r, l+1 # n in base 18 backwards: value v, l digits
%o A029511         c = c*18**l+v # append it on the right
%o A029511         if c % n == 0:
%o A029511             yield n
%o A029511 A029511_list = list(islice(A029511_gen(), 25)) # _Jeff Sponaugle_, Nov 10 2026
%Y A029511 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
