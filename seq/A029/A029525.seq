%I A029525 #31 Nov 14 2026 23:47:02
%S A029525 1,7,51,63,119,3717,91153,147037,208747,2707075,3097013,23073981,
%T A029525 63195267,308788739,337115105,597476551,745986915
%N A029525 Numbers k such that k divides the (left) concatenation of all numbers <= k written in base 8 (most significant digit on right and removing all least significant zeros before concatenation).
%C A029525 This sequence differs from A061961 in that all least significant zeros are removed before concatenation.
%C A029525 No more terms < 10^7. - _Lars Blomberg_, Sep 07 2011
%C A029525 No other terms < 10^12. - _Jeff Sponaugle_, Nov 14 2026
%H A029525 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029525 a(3) = 51: written in base 8 with the most significant digit on the right, least significant zeros dropped, 1..51 are 1, 2, ..., 7, 1, 11, ..., 36; concatenated from 51 down to 1 they give 36261667565554535251...211117654321 in base 8, which has 89 digits and is divisible by 51.
%t A029525 b = 8; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[IntegerDigits[IntegerReverse[#, b], b], c], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029525 (PARI) lista(nn, m=8) = my(c, s, t); for(k=1, nn, t+=m^c*s=fromdigits(Vecrev(digits(k, m)), m); c+=logint(s, m)+1; if(t%k==0, print1(k, ", "))); \\ _Jinyuan Wang_, Dec 05 2020
%o A029525 (Python)
%o A029525 from itertools import count, islice
%o A029525 def A029525_gen(): # generator of terms
%o A029525     c, p = 0, 1 # p = 8**(digits so far)
%o A029525     for n in count(1):
%o A029525         v, k, l = 0, n, 0
%o A029525         while k % 8 == 0:
%o A029525             k //= 8 # drop the least significant zeros
%o A029525         while k:
%o A029525             k, r = divmod(k, 8)
%o A029525             v, l = 8*v+r, l+1 # n in base 8 backwards: value v, l digits
%o A029525         c, p = c+v*p, p*8**l # put it on the left
%o A029525         if c % n == 0:
%o A029525             yield n
%o A029525 A029525_list = list(islice(A029525_gen(), 6)) # _Jeff Sponaugle_, Nov 11 2026
%Y A029525 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
