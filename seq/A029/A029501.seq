%S A029501 1,2,4,6,7,11,182,427,649,859,1559,5579,10577,11830,19915,533022,
%T A029501 546690,569462,673682,1050721,1233092,1621270,1771002,9151954,
%U A029501 23073631,27468769,370545197,5273108978,22220368849,39189501884,54679804025,56182657334,76946985385,288160590364
%N A029501 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 8 (most significant digit on right).
%C A029501 This sequence differs from A061937 in that all least significant zeros are kept during concatenation.
%C A029501 No more terms < 10^7. - _Lars Blomberg_, Oct 04 2011
%C A029501 No other terms < 3*10^11. - _Jeff Sponaugle_, Nov 04 2026
%H A029501 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029501 a(6) = 11: 1..11 in base 8 are 1, 2, 3, 4, 5, 6, 7, 10, 11, 12, 13. Written with the most significant digit on the right, zeros kept, they are 1, 2, 3, 4, 5, 6, 7, 01, 11, 21, 31, and their concatenation 123456701112131 in base 8 is 5744368063577 = 11*522215278507.
%t A029501 b = 8; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 12 2020 *)
%o A029501 (Python)
%o A029501 from itertools import count, islice
%o A029501 def A029501_gen(): # generator of terms
%o A029501     c = 0
%o A029501     for n in count(1):
%o A029501         v, k, l = 0, n, 0
%o A029501         while k:
%o A029501             k, r = divmod(k, 8)
%o A029501             v, l = 8*v+r, l+1 # n in base 8 backwards: value v, l digits
%o A029501         c = c*8**l+v # append it on the right
%o A029501         if c % n == 0:
%o A029501             yield n
%o A029501 A029501_list = list(islice(A029501_gen(), 15)) # _Jeff Sponaugle_, Nov 04 2026
%Y A029501 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
