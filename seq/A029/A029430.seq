%F A029430 a(n) = floor( (2*n^3 + 114*n^2 + 1975*n + 30285)/85536 + (-1)^n * ((n + 19)/288) + ((6*n^2 + 250*n + 2151)/15552)*(2 - 3*(n^2 mod 3)) + ((-6*n^2 - 162*n - 479)/15552)*(((n+1) mod 3) - 1) + (-1)^n * (((2*n + 71)/576)*(2 - 3*(n^2 mod 3)) + ((2*n + 27)/192)*(((n+1) mod 3) - 1)) + (((2*(n+7)*(n+5)*(n+1) + 1) mod 11) - 3) / 11 ). - _Hoang Xuan Thanh_, Nov 25 2026
