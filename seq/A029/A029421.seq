%S A029421 1,0,0,0,0,0,1,1,0,0,1,0,2,1,1,0,1,1,2,2,2,1,2,1,4,2,3,2,3,2,5,4,4,3,
%T A029421 5,3,7,5,6,4,7,5,9,7,8,6,9,7,12,9,11,8,12,9,15,12,14,11,15,12,19,15,
