%I A029527 #31 Nov 14 2026 23:46:52
%S A029527 1,3,9,27,99,471,60237,1028301,1085427,2851947,24427089,79391827,
%T A029527 263110767,1659673359,3522691071,5054825487,5413605357,9688094349,
%U A029527 14105654253,16375031573,267455194891,702965943573
%N A029527 Numbers k such that k divides the (left) concatenation of all numbers <= k written in base 10 (most significant digit on right and removing all least significant zeros before concatenation).
%C A029527 This sequence differs from A061963 in that all least significant zeros are removed before concatenation.
%C A029527 No more terms < 10^7. - _Lars Blomberg_, Sep 12 2011
%C A029527 No other terms < 10^12. - _Jeff Sponaugle_, Nov 14 2026
%H A029527 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029527 a(4) = 27: written in base 10 with the most significant digit on the right, least significant zeros dropped, 1..27 are 1, 2, ..., 9, 1, 11, ..., 72; concatenated from 27 down to 1 they give 7262524232221229181716151413121111987654321 in base 10, which is 7262524232221229181716151413121111987654321 = 27*268982378971156636359857459745226369913123.
%t A029527 b = 10; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[IntegerDigits[IntegerReverse[#, b], b], c], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029527 (PARI) lista(nn, m=10) = my(c, s, t); for(k=1, nn, t+=m^c*s=fromdigits(Vecrev(digits(k, m)), m); c+=logint(s, m)+1; if(t%k==0, print1(k, ", "))); \\ _Jinyuan Wang_, Dec 05 2020
%o A029527 (Python)
%o A029527 from itertools import count, islice
%o A029527 def A029527_gen(): # generator of terms
%o A029527     c, p = 0, 1 # p = 10**(digits so far)
%o A029527     for n in count(1):
%o A029527         v, k, l = 0, n, 0
%o A029527         while k % 10 == 0:
%o A029527             k //= 10 # drop the least significant zeros
%o A029527         while k:
%o A029527             k, r = divmod(k, 10)
%o A029527             v, l = 10*v+r, l+1 # n in base 10 backwards: value v, l digits
%o A029527         c, p = c+v*p, p*10**l # put it on the left
%o A029527         if c % n == 0:
%o A029527             yield n
%o A029527 A029527_list = list(islice(A029527_gen(), 6)) # _Jeff Sponaugle_, Nov 11 2026
%Y A029527 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
