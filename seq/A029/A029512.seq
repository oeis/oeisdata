%I A029512 #20 Nov 10 2026 23:17:48
%S A029512 1,3,9,23,24,27,40,45,72,120,135,141,145,161,243,360,520,801,1272,
%T A029512 1279,1512,2568,2681,3921,4584,7155,8704,12389,22405,27649,32640,
%U A029512 34720,40455,62755,65568,89163,120240,125671,144144,193680,204080,241200,302160,437040
%N A029512 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 19 (most significant digit on right).
%C A029512 This sequence differs from A061948 in that all least significant zeros are kept during concatenation.
%C A029512 No other terms < 9*10^11. - _Jeff Sponaugle_, Nov 10 2026
%H A029512 Jeff Sponaugle, <a href="/A029512/b029512.txt">Table of n, a(n) for n = 1..89</a> (terms 1..59 from Lars Blomberg)
%e A029512 a(4) = 23: written in base 19 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..23 are 1, 2, ..., I, 01, 11, ..., 41; their concatenation 123456789ABCDEFGHI0111213141 in base 19 is 37437722205522289643513592206246184 = 23*1627727052414012593196243139402008.
%t A029512 b = 19; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029512 (Python)
%o A029512 from itertools import count, islice
%o A029512 def A029512_gen(): # generator of terms
%o A029512     c = 0
%o A029512     for n in count(1):
%o A029512         v, k, l = 0, n, 0
%o A029512         while k:
%o A029512             k, r = divmod(k, 19)
%o A029512             v, l = 19*v+r, l+1 # n in base 19 backwards: value v, l digits
%o A029512         c = c*19**l+v # append it on the right
%o A029512         if c % n == 0:
%o A029512             yield n
%o A029512 A029512_list = list(islice(A029512_gen(), 30)) # _Jeff Sponaugle_, Nov 10 2026
%Y A029512 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
%K A029512 nonn,base,changed
%O A029512 1,2
%A A029512 _Olivier Gérard_
