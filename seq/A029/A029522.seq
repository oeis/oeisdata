%I A029522 #30 Nov 14 2026 23:47:20
%S A029522 1,8,16,19,1208,3187,5352,30984,80976,126944,670251,5306279,7640616,
%T A029522 11286107,79923991,443439816,521893363,890233056,2200571993,
%U A029522 4401460949,8329072807,34753999224,118532886307,164336220927,872239440813
%N A029522 Numbers k such that k divides the (left) concatenation of all numbers <= k written in base 5 (most significant digit on right and removing all least significant zeros before concatenation).
%C A029522 This sequence differs from A061958 in that all least significant zeros are removed before concatenation.
%C A029522 No more terms < 10^7. [_Lars Blomberg_, Sep 04 2011]
%C A029522 No other terms < 10^12. - _Jeff Sponaugle_, Nov 14 2026
%H A029522 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029522 a(2) = 8: 1..8 in base 5 are 1, 2, 3, 4, 10, 11, 12, 13. Written with the most significant digit on the right, least significant zeros dropped, they are 1, 2, 3, 4, 1, 11, 21, 31; concatenated from 8 down to 1 they give 31211114321 in base 5, which is 32129336 = 8*4016167.
%t A029522 b = 5; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[IntegerDigits[IntegerReverse[#, b], b], c], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029522 (Python)
%o A029522 from itertools import count, islice
%o A029522 def A029522_gen(): # generator of terms
%o A029522     c, p = 0, 1 # p = 5**(digits so far)
%o A029522     for n in count(1):
%o A029522         v, k, l = 0, n, 0
%o A029522         while k % 5 == 0:
%o A029522             k //= 5 # drop the least significant zeros
%o A029522         while k:
%o A029522             k, r = divmod(k, 5)
%o A029522             v, l = 5*v+r, l+1 # n in base 5 backwards: value v, l digits
%o A029522         c, p = c+v*p, p*5**l # put it on the left
%o A029522         if c % n == 0:
%o A029522             yield n
%o A029522 A029522_list = list(islice(A029522_gen(), 7)) # _Jeff Sponaugle_, Nov 11 2026
%Y A029522 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
