%S A029497 1,2,3,11,207,1239,7947,9233,49883,118669,315629,2640670,10150177,
%T A029497 11030997,43533530,64334049,184416603,240697017,2071153609,2653991757,
%U A029497 10175978470,10391198247,21648156903,68529406431,178522004370,187928867291
%N A029497 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 4 (most significant digit on right).
%C A029497 This sequence differs from A061933 in that all least significant zeros are kept during concatenation.
%C A029497 a(13) exceeds 10000000. - _Sean A. Irvine_, Sep 01 2009
%H A029497 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029497 a(4) = 11: 1..11 in base 4 are 1, 2, 3, 10, 11, 12, 13, 20, 21, 22, 23. Written with the most significant digit on the right, zeros kept, they are 1, 2, 3, 01, 11, 21, 31, 02, 12, 22, 32, and their concatenation 1230111213102122232 in base 4 is 116326737582 = 11*10575157962.
%t A029497 b = 4; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 12 2020 *)
%o A029497 (Python)
%o A029497 from itertools import count, islice
%o A029497 def A029497_gen(): # generator of terms
%o A029497     c = 0
%o A029497     for n in count(1):
%o A029497         v, k, l = 0, n, 0
%o A029497         while k:
%o A029497             k, r = divmod(k, 4)
%o A029497             v, l = 4*v+r, l+1 # n in base 4 backwards: value v, l digits
%o A029497         c = c*4**l+v # append it on the right
%o A029497         if c % n == 0:
%o A029497             yield n
%o A029497 A029497_list = list(islice(A029497_gen(), 8)) # _Jeff Sponaugle_, Nov 03 2026
%Y A029497 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
