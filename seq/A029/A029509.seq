%S A029509 1,2,3,4,5,6,8,9,10,12,15,25,45,163,234,661,1034,1191,1415,1835,2094,
%T A029509 3143,3284,3459,3638,3915,5215,16620,18505,18790,31965,36600,140835,
%U A029509 175302,187170,190545,283115,6926085,7607655,26072025,58226287,64919805,77984814
%N A029509 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 16 (most significant digit on right).
%C A029509 This sequence differs from A061945 in that all least significant zeros are kept during concatenation.
%C A029509 No more terms < 10^7. - _Lars Blomberg_, Oct 09 2011
%C A029509 No other terms < 9*10^11. - _Jeff Sponaugle_, Nov 10 2026
%H A029509 Jeff Sponaugle, <a href="/A029509/b029509.txt">Table of n, a(n) for n = 1..71</a>
%H A029509 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029509 a(12) = 25: written in base 16 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..25 are 1, 2, ..., F, 01, 11, ..., 91; their concatenation 123456789ABCDEF01112131415161718191 in base 16 is 99114423104580546005858778432474180583825 = 25*3964576924183221840234351137298967223353.
%t A029509 b = 16; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029509 (Python)
%o A029509 from itertools import count, islice
%o A029509 def A029509_gen(): # generator of terms
%o A029509     c = 0
%o A029509     for n in count(1):
%o A029509         v, k, l = 0, n, 0
%o A029509         while k:
%o A029509             k, r = divmod(k, 16)
%o A029509             v, l = 16*v+r, l+1 # n in base 16 backwards: value v, l digits
%o A029509         c = c*16**l+v # append it on the right
%o A029509         if c % n == 0:
%o A029509             yield n
%o A029509 A029509_list = list(islice(A029509_gen(), 30)) # _Jeff Sponaugle_, Nov 09 2026
%Y A029509 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
