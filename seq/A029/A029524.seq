%S A029524 1,3,9,12,36,96,128,2267,4031,29416,551444,2033727,2056797,2477144,
%T A029524 7974180,9482385,15327525,17842361,19860888,31985720,83784051,
%U A029524 90578028,114318412,521161800,1356476048,1779444852,2571510969,2849862732,3310370599,6081573024
%N A029524 Numbers k such that k divides the (left) concatenation of all numbers <= k written in base 7 (most significant digit on right and removing all least significant zeros before concatenation).
%C A029524 This sequence differs from A061960 in that all least significant zeros are removed before concatenation.
%C A029524 No more terms < 10^7. [_Lars Blomberg_, Sep 07 2011]
%C A029524 No other terms < 10^12. - _Jeff Sponaugle_, Nov 14 2026
%H A029524 Jeff Sponaugle, <a href="/A029524/b029524.txt">Table of n, a(n) for n = 1..37</a>
%H A029524 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029524 a(3) = 9: 1..9 in base 7 are 1, 2, 3, 4, 5, 6, 10, 11, 12. Written with the most significant digit on the right, least significant zeros dropped, they are 1, 2, 3, 4, 5, 6, 1, 11, 21; concatenated from 9 down to 1 they give 21111654321 in base 7, which is 612124479 = 9*68013831.
%t A029524 b = 7; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[IntegerDigits[IntegerReverse[#, b], b], c], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029524 (Python)
%o A029524 from itertools import count, islice
%o A029524 def A029524_gen(): # generator of terms
%o A029524     c, p = 0, 1 # p = 7**(digits so far)
%o A029524     for n in count(1):
%o A029524         v, k, l = 0, n, 0
%o A029524         while k % 7 == 0:
%o A029524             k //= 7 # drop the least significant zeros
%o A029524         while k:
%o A029524             k, r = divmod(k, 7)
%o A029524             v, l = 7*v+r, l+1 # n in base 7 backwards: value v, l digits
%o A029524         c, p = c+v*p, p*7**l # put it on the left
%o A029524         if c % n == 0:
%o A029524             yield n
%o A029524 A029524_list = list(islice(A029524_gen(), 10)) # _Jeff Sponaugle_, Nov 11 2026
%Y A029524 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
