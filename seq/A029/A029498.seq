%I A029498 #26 Nov 04 2026 22:44:44
%S A029498 1,7,16,96,103,112,224,864,6736,134208,292464,1000176,5891856,9647136,
%T A029498 83976096,246980989,493824592,2481907104,3102272784,3124016704,
%U A029498 4174156128,5873089353,7050059729,44021961131,56381852448,90827885001
%N A029498 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 5 (most significant digit on right).
%C A029498 This sequence differs from A061934 in that all least significant zeros are kept during concatenation.
%C A029498 No more terms < 10^7. - _Lars Blomberg_, Oct 02 2011
%C A029498 No other terms < 2*10^11. - _Jeff Sponaugle_, Nov 04 2026
%H A029498 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029498 a(2) = 7: 1..7 in base 5 are 1, 2, 3, 4, 10, 11, 12. Written with the most significant digit on the right, zeros kept, they are 1, 2, 3, 4, 01, 11, 21, and A029498 their concatenation 1234011121 in base 5 is 3032036 = 7*433148.
%t A029498 b = 5; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 12 2020 *)
%o A029498 (Python)
%o A029498 from itertools import count, islice
%o A029498 def A029498_gen(): # generator of terms
%o A029498     c = 0
%o A029498     for n in count(1):
%o A029498         v, k, l = 0, n, 0
%o A029498         while k:
%o A029498             k, r = divmod(k, 5)
%o A029498             v, l = 5*v+r, l+1 # n in base 5 backwards: value v, l digits
%o A029498         c = c*5**l+v # append it on the right
%o A029498         if c % n == 0:
%o A029498             yield n
%o A029498 A029498_list = list(islice(A029498_gen(), 9)) # _Jeff Sponaugle_, Nov 03 2026
%Y A029498 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
