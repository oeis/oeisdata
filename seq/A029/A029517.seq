%S A029517 1,2,3,4,6,8,10,12,20,23,3726,4900,5120,7452,8350,59708,483713,
%T A029517 1565449,2048350,2109790,2968633,4123900,6745900,6883670,16210417,
%U A029517 16411438,21659399,31327857,141663533,732335847,882607700,943742900,1797548463,2271802759,2328914450
%N A029517 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 24 (most significant digit on right).
%C A029517 This sequence differs from A061953 in that all least significant zeros are kept during concatenation.
%C A029517 No more terms < 10^7. [_Lars Blomberg_, Oct 14 2011]
%C A029517 No other terms < 10^12. - _Jeff Sponaugle_, Nov 13 2026
%H A029517 Jeff Sponaugle, <a href="/A029517/b029517.txt">Table of n, a(n) for n = 1..46</a>
%H A029517 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029517 a(11) = 3726: written in base 24 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..3726 are 1, 2, ..., N, 01, 11, ..., 6B6; their concatenation 123456789ABCDEFGHIJK...3B64B65B66B6 in base 24 has 10580 digits and is divisible by 3726.
%t A029517 b = 24; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029517 (Python)
%o A029517 from itertools import count, islice
%o A029517 def A029517_gen(): # generator of terms
%o A029517     c = 0
%o A029517     for n in count(1):
%o A029517         v, k, l = 0, n, 0
%o A029517         while k:
%o A029517             k, r = divmod(k, 24)
%o A029517             v, l = 24*v+r, l+1 # n in base 24 backwards: value v, l digits
%o A029517         c = c*24**l+v # append it on the right
%o A029517         if c % n == 0:
%o A029517             yield n
%o A029517 A029517_list = list(islice(A029517_gen(), 15)) # _Jeff Sponaugle_, Nov 11 2026
%Y A029517 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
