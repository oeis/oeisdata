%I A029526 #30 Nov 14 2026 23:46:58
%S A029526 1,13,16,224,320,355,800,7856,8720,11683,18829,36464,42544,159125,
%T A029526 19818800,21443360,23359685,78215099,83233360,121519424,515261216,
%U A029526 837006739,1397817920,121138610672,162873341680
%N A029526 Numbers k such that k divides the (left) concatenation of all numbers <= k written in base 9 (most significant digit on right and removing all least significant zeros before concatenation).
%C A029526 This sequence differs from A061962 in that all least significant zeros are removed before concatenation.
%C A029526 No more terms < 10^7. - _Lars Blomberg_, Sep 09 2011
%C A029526 No other terms < 10^12. - _Jeff Sponaugle_, Nov 14 2026
%H A029526 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029526 a(2) = 13: written in base 9 with the most significant digit on the right, least significant zeros dropped, 1..13 are 1, 2, ..., 8, 1, 11, ..., 41; concatenated from 13 down to 1 they give 41312111187654321 in base 9, which is 7689744330453523 = 13*591518794650271.
%t A029526 b = 9; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[IntegerDigits[IntegerReverse[#, b], b], c], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029526 (PARI) lista(nn, m=9) = my(c, s, t); for(k=1, nn, t+=m^c*s=fromdigits(Vecrev(digits(k, m)), m); c+=logint(s, m)+1; if(t%k==0, print1(k, ", "))); \\ _Jinyuan Wang_, Dec 05 2020
%o A029526 (Python)
%o A029526 from itertools import count, islice
%o A029526 def A029526_gen(): # generator of terms
%o A029526     c, p = 0, 1 # p = 9**(digits so far)
%o A029526     for n in count(1):
%o A029526         v, k, l = 0, n, 0
%o A029526         while k % 9 == 0:
%o A029526             k //= 9 # drop the least significant zeros
%o A029526         while k:
%o A029526             k, r = divmod(k, 9)
%o A029526             v, l = 9*v+r, l+1 # n in base 9 backwards: value v, l digits
%o A029526         c, p = c+v*p, p*9**l # put it on the left
%o A029526         if c % n == 0:
%o A029526             yield n
%o A029526 A029526_list = list(islice(A029526_gen(), 11)) # _Jeff Sponaugle_, Nov 11 2026
