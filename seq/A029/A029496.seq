%I A029496 #39 Nov 04 2026 16:44:32
%S A029496 1,7,8,112,424,595,1997,2336,2455,33265,2475701,9363208,15402464,
%T A029496 242890808,4335756601,12771459263
%N A029496 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 3 (most significant digit on right).
%C A029496 This sequence differs from A061932 in that all least significant zeros are kept during concatenation.
%C A029496 No more terms < 10^7. [_Lars Blomberg_, Oct 02 2011]
%C A029496 No other terms < 2*10^11. - _Jeff Sponaugle_, Nov 03 2026
%H A029496 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029496 a(2) = 7: 1..7 in base 3 are 1, 2, 10, 11, 12, 20, 21. Written with the most significant digit on the right, zeros kept, they are 1, 2, 01, 11, 21, 02, 12, and their concatenation 120111210212 in base 3 is 305312 = 7*43616.
%e A029496 a(3) = 8: appending 22 (8 in base 3) gives 12011121021222 in base 3, which is 2747816 = 8*343477.
%t A029496 b = 3; c = {}; Select[Range[10^4], Divisible[FromDigits[
%t A029496 c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 12 2020 *)
%o A029496 (Python)
%o A029496 from itertools import count, islice
%o A029496 def A029496_gen():  # generator of terms
%o A029496     c = 0
%o A029496     for n in count(1):
%o A029496         v, k, l = 0, n, 0
%o A029496         while k:
%o A029496             k, r = divmod(k, 3)
%o A029496             v, l = 3*v + r, l + 1   # n in base 3 backwards: value v, l digits
%o A029496         c = c*3**l + v              # append it on the right
%o A029496         if c % n == 0:
%o A029496             yield n
%o A029496 print(list(islice(A029496_gen(), 10))) # _Jeff Sponaugle_, Nov 03 2026
%Y A029496 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
