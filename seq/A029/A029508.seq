%S A029508 1,3,5,7,32,77,93,96,160,224,352,889,941,2275,3421,10368,23744,31104,
%T A029508 40832,168111,303296,3496928,6149591,8275552,8333395,9774432,11732896,
%U A029508 38153824,41245491,64051487,80142323,330443456,667028736,886246720,1158306624,2484994816,3530318953,15882143424,23283451387
%N A029508 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 15 (most significant digit on right).
%C A029508 This sequence differs from A061944 in that all least significant zeros are kept during concatenation.
%C A029508 No more terms < 10^7. - _Lars Blomberg_, Oct 08 2011
%C A029508 No other terms < 4*10^11. - _Jeff Sponaugle_, Nov 05 2026
%H A029508 Jeff Sponaugle, <a href="/A029508/b029508.txt">Table of n, a(n) for n = 1..44</a>
%H A029508 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029508 a(5) = 32: written in base 15 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..32 are 1, 2, ..., E, 01, 11, ..., 22; their concatenation 123456789ABCDE01112131415161718191A1B1C1D1E1021222 in base 15 is divisible by 32.
%t A029508 b = 15; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029508 (PARI) lista(nn, m=15) = my(s, t); for(k=1, nn, s=k; while(s, t=t*m+s%m; s\=m); if(t%k==0, print1(k, ", "))); \\ _Jinyuan Wang_, Dec 05 2020
%o A029508 (Python)
%o A029508 from itertools import count, islice
%o A029508 def A029508_gen(): # generator of terms
%o A029508     c = 0
%o A029508     for n in count(1):
%o A029508         v, k, l = 0, n, 0
%o A029508         while k:
%o A029508             k, r = divmod(k, 15)
%o A029508             v, l = 15*v+r, l+1 # n in base 15 backwards: value v, l digits
%o A029508         c = c*15**l+v # append it on the right
%o A029508         if c % n == 0:
%o A029508             yield n
%o A029508 A029508_list = list(islice(A029508_gen(), 17)) # _Jeff Sponaugle_, Nov 05 2026
%Y A029508 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
