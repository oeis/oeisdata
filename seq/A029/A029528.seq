%S A029528 1,5,20,32,815,1325,5600,7889,34385,138724,897165,1409360,2039049,
%T A029528 2182992,9174075,12483000,25684485,58955709,81911475,91785439,
%U A029528 166469195,235017517,318699848,1190793624,5915310300,14276420980,17862831280,29093375984,49135512696
%N A029528 Numbers k such that k divides the (left) concatenation of all numbers <= k written in base 11 (most significant digit on right and removing all least significant zeros before concatenation).
%C A029528 This sequence differs from A061964 in that all least significant zeros are removed before concatenation.
%C A029528 No more terms < 10^7. - _Lars Blomberg_, Sep 12 2011
%C A029528 No other terms < 10^12. - _Jeff Sponaugle_, Nov 14 2026
%H A029528 Jeff Sponaugle, <a href="/A029528/b029528.txt">Table of n, a(n) for n = 1..34</a>
%H A029528 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029528 a(3) = 20: written in base 11 (digits A = 10, B = 11, ...) with the most significant digit on the right, least significant zeros dropped, 1..20 are 1, 2, ..., A, 1, 11, ..., 91; concatenated from 20 down to 1 they give 9181716151413121111A987654321 in base 11, which is 1320712650263125867108808716820 = 20*66035632513156293355440435841.
%t A029528 b = 11; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[IntegerDigits[IntegerReverse[#, b], b], c], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029528 (PARI) lista(nn, m=11) = my(c, s, t); for(k=1, nn, t+=m^c*s=fromdigits(Vecrev(digits(k, m)), m); c+=logint(s, m)+1; if(t%k==0, print1(k, ", "))); \\ _Jinyuan Wang_, Dec 05 2020
%o A029528 (Python)
%o A029528 from itertools import count, islice
%o A029528 def A029528_gen(): # generator of terms
%o A029528     c, p = 0, 1 # p = 11**(digits so far)
%o A029528     for n in count(1):
%o A029528         v, k, l = 0, n, 0
%o A029528         while k % 11 == 0:
%o A029528             k //= 11 # drop the least significant zeros
%o A029528         while k:
%o A029528             k, r = divmod(k, 11)
%o A029528             v, l = 11*v+r, l+1 # n in base 11 backwards: value v, l digits
%o A029528         c, p = c+v*p, p*11**l # put it on the left
%o A029528         if c % n == 0:
%o A029528             yield n
%o A029528 A029528_list = list(islice(A029528_gen(), 8)) # _Jeff Sponaugle_, Nov 11 2026
