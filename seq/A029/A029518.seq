%S A029518 1,3,5,9,15,21,39,83,96,288,303,864,1824,2421,2496,2592,2817,3328,
%T A029518 6299,9440,13632,18592,26049,64857,69696,71904,79872,94848,120384,
%U A029518 258111,287232,319319,476736,524992,706368,904281,1817583,2003520,3156192,4479904,7460741
%N A029518 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 25 (most significant digit on right).
%C A029518 This sequence differs from A061954 in that all least significant zeros are kept during concatenation.
%C A029518 No other terms < 10^12. - _Jeff Sponaugle_, Nov 13 2026
%H A029518 Jeff Sponaugle, <a href="/A029518/b029518.txt">Table of n, a(n) for n = 1..74</a> (terms 1..42 from Lars Blomberg)
%H A029518 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029518 a(7) = 39: written in base 25 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..39 are 1, 2, ..., O, 01, 11, ..., E1; their concatenation 123456789ABCDEFGHIJKLMNO01112131415161718191A1B1C1D1E1 in base 25 is divisible by 39.
%t A029518 b = 25; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029518 (PARI) lista(nn, m=25) = my(s, t); for(k=1, nn, s=k; while(s, t=t*m+s%m; s\=m); if(t%k==0, print1(k, ", "))); \\ _Jinyuan Wang_, Dec 05 2020
%o A029518 (Python)
%o A029518 from itertools import count, islice
%o A029518 def A029518_gen(): # generator of terms
%o A029518     c = 0
%o A029518     for n in count(1):
%o A029518         v, k, l = 0, n, 0
%o A029518         while k:
%o A029518             k, r = divmod(k, 25)
%o A029518             v, l = 25*v+r, l+1 # n in base 25 backwards: value v, l digits
%o A029518         c = c*25**l+v # append it on the right
%o A029518         if c % n == 0:
%o A029518             yield n
%o A029518 A029518_list = list(islice(A029518_gen(), 23)) # _Jeff Sponaugle_, Nov 11 2026
