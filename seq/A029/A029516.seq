%I A029516 #27 Nov 14 2026 09:24:09
%S A029516 1,11,33,48,112,165,176,209,528,720,1584,2123,2717,6919,9680,18080,
%T A029516 23991,47597,58656,75213,106815,111392,253792,278245,343409,502523,
%U A029516 528128,934560,31122751,40650029,157712016,230006953,310676912,379370640,459228528,875159472
%N A029516 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 23 (most significant digit on right).
%C A029516 This sequence differs from A061952 in that all least significant zeros are kept during concatenation.
%C A029516 No more terms < 10^7. - _Lars Blomberg_, Oct 14 2011
%C A029516 No other terms < 10^12. - _Jeff Sponaugle_, Nov 13 2026
%H A029516 Jeff Sponaugle, <a href="/A029516/b029516.txt">Table of n, a(n) for n = 1..45</a>
%H A029516 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029516 a(3) = 33: written in base 23 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..33 are 1, 2, ..., M, 01, 11, ..., A1; their concatenation 123456789ABCDEFGHIJKLM01112131415161718191A1 in base 23 is divisible by 33.
%t A029516 b = 23; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029516 (Python)
%o A029516 from itertools import count, islice
%o A029516 def A029516_gen(): # generator of terms
%o A029516     c = 0
%o A029516     for n in count(1):
%o A029516         v, k, l = 0, n, 0
%o A029516         while k:
%o A029516             k, r = divmod(k, 23)
%o A029516             v, l = 23*v+r, l+1 # n in base 23 backwards: value v, l digits
%o A029516         c = c*23**l+v # append it on the right
%o A029516         if c % n == 0:
%o A029516             yield n
%o A029516 A029516_list = list(islice(A029516_gen(), 17)) # _Jeff Sponaugle_, Nov 11 2026
%Y A029516 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
