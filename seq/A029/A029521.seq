%I A029521 #34 Nov 14 2026 09:24:14
%S A029521 1,3,15,969,1107,136193,538019,2177475,2799315,5948555,46399701,
%T A029521 74304045,121428377,1467721527,2057284125,2344510025,4836747933,
%U A029521 9212877375,280889591419
%N A029521 Numbers k such that k divides the (left) concatenation of all numbers <= k written in base 4 (most significant digit on right and removing all least significant zeros before concatenation).
%C A029521 This sequence differs from A061957 in that all least significant zeros are removed before concatenation.
%C A029521 No more terms < 10^7. [_Lars Blomberg_, Sep 02 2011]
%C A029521 No other terms < 10^12. - _Jeff Sponaugle_, Nov 13 2026
%H A029521 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029521 a(3) = 15: written in base 4 with the most significant digit on the right, least significant zeros dropped, 1..15 are 1, 2, 3, 1, 11, ..., 33; concatenated from 15 down to 1 they give 332313332221223121111321 in base 4, which is 276525726143865 = 15*18435048409591.
%t A029521 b = 4; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[IntegerDigits[IntegerReverse[#, b], b], c], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029521 (Python)
%o A029521 from itertools import count, islice
%o A029521 def A029521_gen(): # generator of terms
%o A029521     c, p = 0, 1 # p = 4**(digits so far)
%o A029521     for n in count(1):
%o A029521         v, k, l = 0, n, 0
%o A029521         while k % 4 == 0:
%o A029521             k //= 4 # drop the least significant zeros
%o A029521         while k:
%o A029521             k, r = divmod(k, 4)
%o A029521             v, l = 4*v+r, l+1 # n in base 4 backwards: value v, l digits
%o A029521         c, p = c+v*p, p*4**l # put it on the left
%o A029521         if c % n == 0:
%o A029521             yield n
%o A029521 A029521_list = list(islice(A029521_gen(), 5)) # _Jeff Sponaugle_, Nov 11 2026
%Y A029521 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
