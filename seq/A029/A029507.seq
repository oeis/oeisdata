%T A029507 7709,17498,89190,100463,120133,168169,177840,477984,493806,2648444,
%U A029507 3922637,5012137,32342544,32543940,1298165492,3716084424,7360572430,7687010669,9488292749,10028149596,16208163751,102328619633
%N A029507 Numbers k such that k divides the (right) concatenation of all numbers <= k written in base 14 (most significant digit on right).
%C A029507 This sequence differs from A061943 in that all least significant zeros are kept during concatenation.
%C A029507 No more terms < 10^7. [_Lars Blomberg_, Oct 08 2011]
%C A029507 No other terms < 4*10^11. - _Jeff Sponaugle_, Nov 05 2026
%H A029507 Jeff Sponaugle, <a href="/A029507/b029507.txt">Table of n, a(n) for n = 1..44</a>
%H A029507 <a href="/index/N#concat">Index entries for related sequences</a>
%e A029507 a(7) = 86: written in base 14 (digits A = 10, B = 11, ...) with the most significant digit on the right, zeros kept, 1..86 are 1, 2, ..., D, 01, 11, ..., 26; their concatenation 123456789ABCD0111213...B5C5D5061626 in base 14 has 159 digits and is divisible by 86.
%t A029507 b = 14; c = {}; Select[Range[10^4], Divisible[FromDigits[c = Join[c, Reverse[IntegerDigits[#, b]]], b], #] &] (* _Robert Price_, Mar 13 2020 *)
%o A029507 (Python)
%o A029507 from itertools import count, islice
%o A029507 def A029507_gen(): # generator of terms
%o A029507     c = 0
%o A029507     for n in count(1):
%o A029507         v, k, l = 0, n, 0
%o A029507         while k:
%o A029507             k, r = divmod(k, 14)
%o A029507             v, l = 14*v+r, l+1 # n in base 14 backwards: value v, l digits
%o A029507         c = c*14**l+v # append it on the right
%o A029507         if c % n == 0:
%o A029507             yield n
%o A029507 A029507_list = list(islice(A029507_gen(), 20)) # _Jeff Sponaugle_, Nov 05 2026
%Y A029507 Cf. A029447-A029470, A029471-A029494, A029495-A029518, A029519-A029542, A061931-A061954, A061955-A061978.
