%F A099137 a(n) = A000326(a(n-1)), with a(0) = 2.
%F A099137 a(n) = A086714(n+2)/3. - _Muslim Alaa_, Nov 15 2026
%t A099137 NestList[PolygonalNumber[5,#]&,2,8] (* _Harvey P. Dale_, Sep 07 2024 *)
%o A099137 (PARI) a(n)=if(n==0, 2, my(t=a(n-1)); t*(3*t-1)/2); \\ _Joerg Arndt_, Mar 05 2023
