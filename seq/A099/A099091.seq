%I A099091 #20 Sep 20 2026 15:15:30
%S A099091 1,0,2,0,3,4,0,0,12,8,0,0,9,36,16,0,0,0,54,96,32,0,0,0,27,216,240,64,
%T A099091 0,0,0,0,216,720,576,128,0,0,0,0,81,1080,2160,1344,256,0,0,0,0,0,810,
%U A099091 4320,6048,3072,512,0,0,0,0,0,243,4860,15120,16128,6912,1024
%N A099091 Riordan array (1, 2+3x).
%C A099091 Row sums are A015518(n+1). Diagonal sums are A002447.
%C A099091 The Riordan array (1,s+tx) defines T(n,k) = binomial(k,n-k)s^k(t/s)^(n-k). The row sums satisfy a(n)=s*a(n-1)+t*a(n-2) and the diagonal sums satisfy a(n)=s*a(n-2)+t*a(n-3).
%H A099091 Paolo Xausa, <a href="/A099091/b099091.txt">Table of n, a(n) for n = 0..11475</a> (rows 0..150 of triangle, flattened).
%F A099091 T(n, k) = binomial(k, n-k)*2^k*(3/2)^(n-k).
%F A099091 Columns have g.f. (2x+3x^2)^k.
%F A099091 T(n, k) = 2*T(n-1, k-1) + 3*T(n-2, k-1) with T(0, 0)=1, T(n, k)=0 for k<0 or k>n. - _Ranjan Kumar Dhani_, Sep 14 2026
%e A099091 Rows begin
%e A099091   1;
%e A099091   0,2;
%e A099091   0,3,4;
%e A099091   0,0,12,8;
%e A099091   0,0,9,36,16;
%e A099091   ...
%t A099091 A099091[n_, k_] := Binomial[k, n - k]*2^k*(3/2)^(n - k);
%t A099091 Table[A099091[n, k], {n, 0, 10}, {k, 0, n}] (* _Paolo Xausa_, Sep 20 2026 *)
%Y A099091 Cf. A000079 (right diagonal), A002447, A015518.
%K A099091 easy,nonn,tabl,changed
%O A099091 0,3
%A A099091 _Paul Barry_, Sep 25 2004
