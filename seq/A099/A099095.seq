%I A099095 #19 Sep 18 2026 16:47:47
%S A099095 1,0,3,0,2,9,0,0,12,27,0,0,4,54,81,0,0,0,36,216,243,0,0,0,8,216,810,
%T A099095 729,0,0,0,0,96,1080,2916,2187,0,0,0,0,16,720,4860,10206,6561,0,0,0,0,
%U A099095 0,240,4320,20412,34992,19683,0,0,0,0,0,32,2160,22680,81648,118098,59049
%N A099095 Riordan array (1,3+2x).
%C A099095 Row sums are A007482. Diagonal sums are A053088.
%C A099095 The Riordan array (1,s+tx) defines T(n,k)=binomial(k,n-k)s^k(t/s)^(n-k). The row sums satisfy a(n)=s*a(n-1)+t*a(n-2) and the diagonal sums satisfy a(n)=s*a(n-2)+t*a(n-3).
%H A099095 Paolo Xausa, <a href="/A099095/b099095.txt">Table of n, a(n) for n = 0..11475</a> (rows 0..150 of triangle, flattened).
%H A099095 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/FermatPolynomial.html">Fermat Polynomial</a>
%F A099095 T(n, k) = binomial(k, n-k)3^k*(2/3)^(n-k).
%F A099095 Columns have g.f. (3x+2x^2)^k.
%F A099095 T(n,k) = 3*T(n-1,k-1) + 2*T(n-2,k-1) with T(0,0)=1, T(n,k)=0 for k<0 or k>n. - _Ranjan Kumar Dhani_, Sep 16 2026
%e A099095 Rows begin:
%e A099095   {1},
%e A099095   {0,3},
%e A099095   {0,2,9},
%e A099095   {0,0,12,27},
%e A099095   {0,0,4,54,81},
%e A099095   ...
%t A099095 A099095[n_, k_] := Binomial[k, n - k]*3^k*(2/3)^(n - k);
%t A099095 Table[A099095[n, k], {n, 0, 10}, {k, 0, n}] (* _Paolo Xausa_, Sep 18 2026 *)
%Y A099095 Cf. A000244, A007482, A038220, A053088.
