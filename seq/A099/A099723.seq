%I A099723 #14 Oct 06 2026 04:33:50
%S A099723 6,4560,13770,111552,256011840
%N A099723 Nonprime-power sigma-perfect numbers: numbers k such that NPPSigma(k) = 2*k, where, if k = Product p_i^r_i then NPPSigma(k) = Product{Sum p_i^s_i, s_i is not a prime number, 0 <= s_i <= r_i}.
%C A099723 a(6) > 10^10, if it exists. - _Amiram Eldar_, Oct 06 2026
%e A099723 NPPSigma(2^5*7^4) = (1+2+2^4)*(1+7+7^4) = 45771.
%e A099723 13770 = 2*3^4*5*17 so NPPSigma(2*3^4*5*17) = (1+2^1)*(1+3^1+3^4)*(1+5^1)*(1+17^1) = 2*13770.
%e A099723 Factorizations : 2*3, 2^4*3*5*19, 13770 = 2*3^4*5*17, 2^6*3*7*83, ...
%t A099723 f[p_, e_] := Plus @@ (p^Select[Range[0, e], ! PrimeQ[#] &]); s[n_] := Times @@ f @@@ FactorInteger[n]; s[1] = 1; Select[Range[300000], s[#] == 2*# &] (* _Amiram Eldar_, Oct 06 2026 *)
%o A099723 (PARI) isok(k) = {my(f = factor(k)); prod(i = 1, #f~, sum(j = 0, f[i, 2], if(!isprime(j), f[i, 1]^j))) == 2*k;} \\ _Amiram Eldar_, Oct 06 2026
%Y A099723 Cf. A096290.
%K A099723 nonn,more,changed
%O A099723 1,1
