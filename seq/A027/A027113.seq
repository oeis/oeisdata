%S A027113 1,1,1,2,1,1,2,4,3,1,1,2,4,7,9,7,1,1,2,4,7,13,20,23,16,1,1,2,4,7,13,
%T A027113 24,40,56,59,39,1,1,2,4,7,13,24,44,77,120,155,154,98,1,1,2,4,7,13,24,
%U A027113 44,81,145,241,352,429,407,252,1,1,2,4,7,13,24
%N A027113 Triangular array T given by rows: T(n,0)=1 for n >= 0, T(n,1)=1,T(n,2)=2 for n >= 1 and for n >= 2, T(n,k)=T(n-1,k-3)+T(n-1,k-2)+T(n-1,k-1) for 3<=k<=2n-1, T(n, 2n)=T(n-1,2n-3)+T(n-1,2n-2).
%C A027113 The rows are of lengths 1, 3, 5, 7, ...
%C A027113 First n+2 terms of the n-th row are the terms of A000073 excluding the 2 starting zeros, for n>0. - _Žiga Pirc_, Sep 12 2026
%H A027113 Žiga Pirc, <a href="/A027113/b027113.txt">Table of n, a(n) for n = 1..10000</a>
%e A027113 Triangle begins:
%e A027113   1;
%e A027113   1, 1, 2;
%e A027113   1, 1, 2, 4, 3;
%e A027113   1, 1, 2, 4, 7,  9,  7;
%e A027113   1, 1, 2, 4, 7, 13, 20, 23, 16;
%e A027113   1, 1, 2, 4, 7, 13, 24, 40, 56, 59, 39;
%e A027113   ...
%e A027113 T(5, 4) = 9, since T(2, 3) + T(3, 3) + T(4, 3) = 2 + 4 + 3.
%e A027113 T(8, 5) = 16, since T(5, 4) + T(6, 4) = 9 + 7.
%o A027113 (PARI)
%o A027113 N = 10;
%o A027113 T = vector(N, a, vector(2*N-1));
%o A027113 for(n = 1, N, T[n][1] = 1; T[n][2] = 1; T[n][3] = 2);
%o A027113 for(n = 3, N, for(k = 4, 2*n-1, T[n][k] = T[n-1][k-3] + T[n-1][k-2] + T[n-1][k-1]));
%o A027113 for(n = 1, N, for(k = 1, 2*n-1, print1(T[n][k]", "))); \\ _Žiga Pirc_, Sep 13 2026
%Y A027113 Cf. A000073, A027114-A027143.
%Y A027113 Row sums: A027115.
