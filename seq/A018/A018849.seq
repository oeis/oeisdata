%N A018849 Strobogrammatic squares: the same upside down (calculator-style numerals).
%C A018849 Subsequence of squares in A018846. - _Michel Marcus_, Aug 04 2014
%H A018849 Alexander Krivilev, <a href="/A018849/b018849.txt">Table of n, a(n) for n = 1..26</a>
%H A018849 Alexander Krivilev, <a href="/A018849/a018849_1.txt">Conjecture for numbers a(27) onward</a>
%t A018849 ok[n_] := n == (If[FreeQ[#, 3 | 4 | 7 | {__, 0 ..}], FromDigits@Reverse@(# /. {6 -> 9, 9 -> 6}), 0] &)@IntegerDigits@n; SetSharedVariable[a]; a = {}; ParallelDo[If[ok[n^2], AppendTo[a, n^2]], {n, 0, 12000000}]; Sort@a (* _Alexander Krivilev_, Oct 05 2026 *)
%o A018849 (PARI) is_A018846(n, t=Vec("012..59.86"))={ apply(x->t[eval(x)+1], n=Vec(Str(n)))==vecextract(n, "-1..1"); }
%o A018849 lista(nn) = {for(n=0, nn, if (is_A018846(n^2), print1(n^2, ", ")));} \\ _Michel Marcus_, Aug 04 2014
