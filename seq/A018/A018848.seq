%I A018848 #34 Oct 16 2026 21:45:28
%S A018848 0,1,6889,69169,109181601
%N A018848 Strobogrammatic squares: the same upside down (probably finite).
%C A018848 Square numbers which when written down and rotated by 180 degrees are unchanged.
%C A018848 Subsequence of squares in A000787. - _Derek Orr_ and _Michel Marcus_, Aug 04 2014
%C A018848 a(6) > 10^60. - _Jeff Sponaugle_, Oct 11 2026
%t A018848 ok[n_] := n == (If[FreeQ[#, 2 | 3 | 4 | 5 | 7 | {__, 0 ..}], FromDigits@Reverse@(# /. {6 -> 9, 9 -> 6}), 0] &)@IntegerDigits@n; SetSharedVariable[a]; a = {}; ParallelDo[If[ok[n^2], AppendTo[a, n^2]], {n, 0, 1000000}]; Sort@a (* _Alexander Krivilev_, Oct 05 2026 *)
%Y A018848 Cf. A000787, A018849 (similar sequence).
%K A018848 nonn,base,more
%O A018848 1,3
%A A018848 _David W. Wilson_
