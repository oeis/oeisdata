%U A356481 86417905242215256304933,46827523453474063148064566,29541408638014132220426677305,21466378230182442405119948196112
%N A356481 a(n) is the hafnian of a symmetric Toeplitz matrix M(2*n) whose first row consists of 1, 2, ..., 2*n.
%H A356481 Alois P. Heinz, <a href="/A356481/b356481.txt">Table of n, a(n) for n = 0..228</a>
%H A356481 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/DawsonsIntegral.html">Dawson's Integral</a>.
%H A356481 Wikipedia, <a href="https://en.wikipedia.org/wiki/Hafnian">Hafnian</a>.
%H A356481 Wikipedia, <a href="https://en.wikipedia.org/wiki/Symmetric_matrix">Symmetric matrix</a>.
%H A356481 Wikipedia, <a href="https://en.wikipedia.org/wiki/Toeplitz_matrix">Toeplitz Matrix</a>.
%F A356481 a(n) = (1/n!)*Sum_{S subseteq {1,...,2*n}} (-1)^|S|*(Sum_{i,j in S, i<j} (j-i+1))^n for n >= 1.
%F A356481 This yields a more efficient recurrence: R_0(x) = 1, R_n(x) = x*R_{n-1}(x) + (n+2)*R'_{n-1}(x) for n >= 1, with a(n) = R_{2*n}(0)/2^n. - _Vladeta Jovovic_, Nov 07 2026
%F A356481 a(n) ~ c * n!^2 * (2*r)^(2*n) / n, where r = A133841 = 0.9241388730045917670128232715... is the root of the equation DawsonF(r) = 1/(2*r) = A133842 and c = 2.295650152981837980160529137762556172102799354407863... - _Vaclav Kotesovec_, Nov 08 2026
%e A356481 a(2) = 21 because the hafnian of
%e A356481     1  2  3  4
%e A356481     2  1  2  3
%e A356481     3  2  1  2
%e A356481     4  3  2  1
%e A356481 equals M_{1,2}*M_{3,4} + M_{1,3}*M_{2,4} + M_{1,4}*M_{2,3} = 21.
%e A356481 R_0(x) = 1, R_2(x) = x^2 + 4, R_4(x) = x^4 + 32*x^2 + 84, R_6(x) = x^6 + 100*x^4 + 1972*x^2 + 4256. Hence a(0) = 1, a(1) = 4/2 = 2, a(2) = 84/4 = 21, and a(3) = 4256/8 = 532. - _Vladeta Jovovic_, Nov 07 2026
%p A356481 R:= proc(n) option remember; `if`(n=0, 1,
%p A356481       expand(x*R(n-1)+(n+2)*diff(R(n-1), x)))
%p A356481     end:
%p A356481 a:= n-> subs(x=0, R(2*n)/2^n):
%p A356481 seq(a(n), n=0..15);  # _Alois P. Heinz_, Nov 07 2026
%t A356481 k[i_]:=i; M[i_, j_, n_]:=Part[Part[ToeplitzMatrix[Array[k, n]], i], j]; a[n_]:=Sum[Product[M[Part[PermutationList[s, 2n], 2i-1], Part[PermutationList[s, 2n], 2i], 2n], {i, n}], {s, SymmetricGroup[2n]//GroupElements}]/(n!*2^n); Array[a, 6, 0]
%o A356481 (PARI) tm(n) = my(m = matrix(n, n, i, j, if (i==1, j, if (j==1, i)))); for (i=2, n, for (j=2, n, m[i, j] = m[i-1, j-1]; ); ); m;
%o A356481 a(n) = my(m = tm(2*n), s=0); forperm([1..2*n], p, s += prod(j=1, n, m[p[2*j-1], p[2*j]]); ); s/(n!*2^n); \\ _Michel Marcus_, May 02 2023
