%S A356738 1,21,101,121,1101,1121,21121,101121,121121,1101121,1121121,21121121,
%T A356738 101121121,121121121,1101121121,1121121121,21121121121,101121121121,
%U A356738 121121121121,1101121121121,1121121121121,21121121121121,101121121121121,121121121121121
%N A356738 Smallest positive integer whose American English name consists of n words.
%C A356738 For n>=1 and as long as the integers are named in a consistent manner, a(5n - 1) is palindromic and consists of n repetitions of 121. For example, a(9) = 121121. - _Ivan N. Ianakiev_, Oct 19 2026
%F A356738 a(n) == 1 (mod 20).
%t A356738 name[n_]:=StringReplace[IntegerName[n,"Words"],{", "->" ","\[Hyphen]"->" "}];
%t A356738 nameLen[n_]:=WordCount[name[n]]; f[1]=1; f[n_]:=f[n]=Module[{k=f[n-1]},
%t A356738 While[nameLen[k]<n,k=k+20];k]; f/@Range[10]
%Y A356738 Cf. A080777.
%K A356738 nonn,word,fini,changed
%O A356738 1,2
%A A356738 _Ivan N. Ianakiev_, Aug 25 2022
