%S A356482 1,1,16,714,62528,9056720,1960138560,592615689904,238560786221056,
%T A356482 123358665203311104,79683847063011614720,62880705523927756011008,
%U A356482 59524116382555092719812608,66573533984959225409363156992,86848970087680355697171238150144,130707866926275795929676985294202880
%N A356482 a(n) is the hafnian of a symmetric Toeplitz matrix M(2*n) whose first row consists of 2*n, 2*n-1, ..., 1.
%H A356482 Alois P. Heinz, <a href="/A356482/b356482.txt">Table of n, a(n) for n = 0..215</a>
%H A356482 Wikipedia, <a href="https://en.wikipedia.org/wiki/Hafnian">Hafnian</a>
%H A356482 Wikipedia, <a href="https://en.wikipedia.org/wiki/Symmetric_matrix">Symmetric matrix</a>
%H A356482 Wikipedia, <a href="https://en.wikipedia.org/wiki/Toeplitz_matrix">Toeplitz Matrix</a>
%F A356482 For fixed n >= 0, let R_0(x,y) = 1 and R_m(x,y) = (x+m*y)*R_{m-1}(x,y) + (2*n-m)*d/dx R_{m-1}(x,y) + d/dy R_{m-1}(x,y), for 1 <= m <= 2*n. Then a(n) = R_{2*n}(0,0). - _Vladeta Jovovic_, Nov 07 2026
%F A356482 a(n) ~ c * n!^2 * d^n / n, where d = 7.158750602606089415867165768446484956404801830981848055036125084697475068411... and c = 0.17521146426124286434640255145014663088420881097576741263835485899892119586... - _Vaclav Kotesovec_, Nov 08 2026
%e A356482 a(2) = 16 because the hafnian of
%e A356482     4  3  2  1
%e A356482     3  4  3  2
%e A356482     2  3  4  3
%e A356482     1  2  3  4
%e A356482 equals M_{1,2}*M_{3,4} + M_{1,3}*M_{2,4} + M_{1,4}*M_{2,3} = 16.
%e A356482 For n = 1, R_2(x,y) = x^2 + 3*x*y + 2*y^2 + 1.
%e A356482 For n = 2, R_4(x,y) = x^4 + 10*x^3*y + 35*x^2*y^2 + 50*x*y^3 + 24*y^4 + 14*x^2 + 70*x*y + 82*y^2 + 16.
%e A356482 For n = 3, R_6(x,y) = x^6 + 21*x^5*y + 175*x^4*y^2 + 735*x^3*y^3 + 1624*x^2*y^4 + 1764*x*y^5 + 720*y^6 + 55*x^4 + 770*x^3*y + 3857*x^2*y^2 + 8134*x*y^3 + 6036*y^4 + 598*x^2 + 4186*x*y + 7002*y^2 + 714.
%e A356482 Thus a(1) = 1, a(2) = 16, and a(3) = 714.
%p A356482 R:= proc(n, m) option remember; expand(`if`(m=0, 1, (x+m*y)*
%p A356482       R(n, m-1)+(2*n-m)*diff(R(n, m-1), x)+diff(R(n, m-1), y)))
%p A356482     end:
%p A356482 a:= n-> subs(x=0, y=0, R(n, 2*n)):
%p A356482 seq(a(n), n=0..15);  # _Alois P. Heinz_, Nov 07 2026
%t A356482 k[i_]:=i; M[i_, j_, n_]:=Part[Part[ToeplitzMatrix[Reverse[Array[k, n]]], i], j]; a[n_]:=Sum[Product[M[Part[PermutationList[s, 2n], 2i-1], Part[PermutationList[s, 2n], 2i], 2n], {i, n}], {s, SymmetricGroup[2n]//GroupElements}]/(n!*2^n); Array[a, 6, 0]
%o A356482 (PARI) tm(n) = my(m = matrix(n, n, i, j, if (i==1, n-j+1, if (j==1, n-i+1)))); for (i=2, n, for (j=2, n, m[i, j] = m[i-1, j-1]; ); ); m;
%o A356482 a(n) = my(m = tm(2*n), s=0); forperm([1..2*n], p, s += prod(j=1, n, m[p[2*j-1], p[2*j]]); ); s/(n!*2^n); \\ _Michel Marcus_, May 02 2023
