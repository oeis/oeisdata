%T A064501 94399912,104193054,140553735,155064548,184566592,188194335,215515727,
%U A064501 281107470,288564647,376388670,431031454,479685360,577129294,735517552,888105120,1066525860
%N A064501 Numbers k such that the sum of unitary divisors of k^3 is a square.
%H A064501 Donovan Johnson, <a href="/A064501/b064501.txt">Table of n, a(n) for n = 1..50</a> (terms < 10^11)
%t A064501 q[k_] := IntegerQ[Sqrt[Times @@ (1 + (Power @@@ FactorInteger[k])^3)]]; q[1] = True; Select[Range[10^5], q] (* _Amiram Eldar_, Aug 25 2026 *)
%o A064501 (PARI) {usigma(n, s=1, fac, i)= fac=factor(n); for(i=1,matsize(fac)[1], s=s*(1+fac[i,1]^fac[i,2]); ); return(s); }
%o A064501 isok(n) = issquare(usigma(n^3));
%Y A064501 Cf. A034448, A034677.
%K A064501 nonn,changed
