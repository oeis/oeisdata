%N A064143 Sum of unitary prime divisors of binomial(n, floor(n/2)).
%H A064143 Amiram Eldar, <a href="/A064143/b064143.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from Harry J. Smith)
%F A064143 a(n) = A063956(A001405(n)).
%t A064143 f[p_, e_] := If[e == 1, p, 0]; s[1] = 0; s[n_] := Plus @@ f @@@ FactorInteger[n]; a[n_] := s[Binomial[n, Floor[n/2]]]; Array[a, 61] (* _Amiram Eldar_, Sep 01 2026 *)
%o A064143 (PARI) a(n) = { my(f=factor(binomial(n, n\2))); sum(i=1, #f~, if (f[i,2]==1, f[i,1])) } \\ _Harry J. Smith_, Sep 09 2009
