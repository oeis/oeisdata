%I A064596 #10 Oct 14 2026 00:10:28
%S A064596 1,24,2520,186076800,1081895452249824576000
%N A064596 Smallest nonunitary multiperfect number of index n; i.e., smallest k such that sigma(k) - usigma(k) = n*k.
%t A064596 nusigma[ n_ ] := DivisorSigma[ 1, n ]-Times@@(1+Power@@#&/@FactorInteger[ n ]); a[ n_ ] := For[ k=1, True, k++, If[ nusigma[ k ]==n k, Return[ k ] ] ]
%Y A064596 Cf. A048146, A064591, A064592, A064593, A064594, A064595.
%K A064596 nonn,hard,more,changed
%O A064596 0,2
