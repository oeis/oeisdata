%I A064482 #17 Sep 05 2026 17:43:16
%S A064482 2,2,4,2,10,12,2,18,52,48,2,32,146,300,240,2,54,372,1204,1968,1440,2,
%T A064482 86,954,4082,10476,14640,10080,2,134,2376,13348,46012,97968,122400,
%U A064482 80640,2,206,5704,44274,186202,536652,990960,1139040,725760,2,312,13278,145216,742940,2655004,6562128,10847520,11692800,7257600
%N A064482 Triangle read by rows: T(n,k) (n >= 2, 1<=k<=n-1) is the number of permutations p of 1,...,n with max(|p(i)-p(i-1)|, i=2..n) = k.
%C A064482 T(n,n-1) = A052849; sum(T(n,k),k=1..n-1) = A000142.
%H A064482 Alois P. Heinz, <a href="/A064482/b064482.txt">Rows n = 2..18, flattened</a>
%e A064482 Triangle T(n,k) begins:
%e A064482   2;
%e A064482   2,   4;
%e A064482   2,  10,   12;
%e A064482   2,  18,   52,    48;
%e A064482   2,  32,  146,   300,   240;
%e A064482   2,  54,  372,  1204,  1968,  1440;
%e A064482   2,  86,  954,  4082, 10476, 14640,  10080;
%e A064482   2, 134, 2376, 13348, 46012, 97968, 122400, 80640;
%o A064482 (C++)
%o A064482 #include <iostream>
%o A064482 #include <vector>
%o A064482 #include <algorithm>
%o A064482 using namespace std;
%o A064482 inline int k(const vector<int> &s)
%o A064482 {
%o A064482     const int n = s.size();
%o A064482     int kmax = 0;
%o A064482     for (int i = 1; i < n; i++)
%o A064482     {
%o A064482         const int thisdiff = abs(s[i] - s[i - 1]);
%o A064482         if (thisdiff > kmax)
%o A064482             kmax = thisdiff;
%o A064482     }
%o A064482     return kmax;
%o A064482 }
%o A064482 int main(int argc, char *argv[])
%o A064482 {
%o A064482     for (int n = 2;; n++)
%o A064482     {
%o A064482         vector<int> s;
%o A064482         for (int i = 1; i <= n; i++)
%o A064482             s.push_back(i);
%o A064482         vector<unsigned long long> resul(n);
%o A064482         do
%o A064482         {
%o A064482             resul[k(s)]++;
%o A064482         } while (next_permutation(s.begin(), s.end()));
%o A064482         for (int i = 1; i < n; i++)
%o A064482             cout << resul[i] << ", ";
%o A064482         cout << endl;
%o A064482     }
%o A064482     return 0;
%o A064482 } // _R. J. Mathar_, Oct 11 2007
%Y A064482 Cf. A052849, A000142, A129534.
