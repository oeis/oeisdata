%T A256576 0,6,4,7,3,4,9,9,7,5,1,4,0,0,3,4,6,3,1,4,2,5,8,8,6,7,2,7,2,9,3,7,8,1,
%U A256576 1,7,2,1,2,1,0,5,0,3,9,7,1,4,2,5,2,4,0,5,3,8,0,7,9,6,7,4,9,8,9,2
%N A256576 Decimal expansion of Ramanujan's constant G(1) = Sum_{r>=1} 1/(2r^3)*(1 + 1/3 + ... + 1/(2r-1)).
%C A256576 Ramanujan gave a wrong formula for this constant: (Pi/4) * Sum_{k>=0} (-1)^k/(4*k+1)^3 - (Pi/(3*sqrt(3))) * Sum_{k>=0} 1/(2*k+1)^3 (Berndt, 1985; Nimbran and Sofo, 2019). - _Amiram Eldar_, Aug 28 2026
%D A256576 Bruce C. Berndt, Ramanujan's Notebooks Part I, Springer-Verlag, 1985. See p. 257, formula (11.3).
%H A256576 Marc-Antoine Coppo and Bernard Candelpergher, <a href="https://doi.org/10.1016/j.jnt.2014.11.007">Inverse binomial series and values of Arakawa-Kaneko zeta functions</a>, J. Number Theory 150 (2015), 98-119, eq. (25).
%H A256576 Amrik Singh Nimbran and Anthony Sofo, <a href="https://doi.org/10.7153/jca-2019-15-02">New interesting Euler sums</a>, Journal of Classical Analysis, Vol. 15, No. 1 (2019), pp. 9-22. See p. 14.
%H A256576 R. Sitaramachandrarao, <a href="https://doi.org/10.1016/0022-314X(87)90012-6">A Formula of S. Ramanujan</a>, Journal of Number Theory 25 (1987), 1-19.
%H A256576 <a href="/index/Ha#harmonic">Index entries for sequences related to harmonic numbers</a>.
%F A256576 G(1) = Pi^4/480 - (1/4)*Sum_{r>=2} (-1)^r*H(r-1,2)/r^2, where H(n,m) is the n-th harmonic number of order m.
%F A256576 F(1) = 7*zeta(3)/16 = Sum_{r>=1} (1+1/3+1/5+..+1/(2r-1))/r^2 = 0.525899895... [Coppo] - _R. J. Mathar_, Jun 13 2024
%F A256576 From _Amiram Eldar_, Aug 28 2026: (Start)
%F A256576 Equals Sum_{k>=1} O(k)/(2*k)^3, where O(k) = A350669(k)/A350670(k) is the k-th odd harmonic number (or harmonic number of the second kind).
%F A256576 Equals Pi^4/480 - A_4/4, where A_4 = A214508.
%F A256576 Equals -53*zeta(4)/64 + 7*zeta(3)*log(2)/8 - zeta(2)*log(2)^2/4 + log(2)^4/24 + polylog(4, 1/2). (End)
%e A256576 0.1622719394714833907153595518080712064734997514...
%t A256576 digits = 100; G1 = NSum[(1/(2*r)^3)*(1/2*(EulerGamma + Log[4]) + 1/2*PolyGamma[ 1/2+r]), {r, 1, Infinity}, WorkingPrecision -> digits+10, NSumTerms -> 40, Method -> {"NIntegrate", "MaxRecursion" -> 10}]; RealDigits[G1, 10, digits] // First
%t A256576 (* Alternative: *)
%t A256576 RealDigits[-53*Zeta[4]/64 + 7*Zeta[3]*Log[2]/8 - Zeta[2]*Log[2]^2/4 + Log[2]^4/24 + PolyLog[4,1/2], 10, 120][[1]] (* _Amiram Eldar_, Aug 28 2026 *)
%o A256576 (PARI) -53*zeta(4)/64 + 7*zeta(3)*log(2)/8 - zeta(2)*log(2)^2/4 + log(2)^4/24 + polylog(4, 1/2) \\ _Amiram Eldar_, Aug 28 2026
