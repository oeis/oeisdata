%N A358074 a(n) is the number of distinct ways n can be written as the sum of a perfect square and factorial.
%C A358074 This does not count x^2 and (-x)^2 as distinct, nor does it count 0! and 1! as distinct.
%C A358074 Conjecture: a(n) <= 3 for all n. - _Robert Israel_, Nov 10 2026
%H A358074 Robert Israel, <a href="/A358074/b358074.txt">Table of n, a(n) for n = 1..10000</a>
%e A358074 2 = 0^2 + 2! = 1^2 + 1!, so a(2) = 2.
%p A358074 f:= proc(n) local t,k,v;
%p A358074   t:= 0:
%p A358074   for k from 1 do
%p A358074     v:= n - k!;
%p A358074     if v < 0 then return t fi;
%p A358074     if issqr(v) then t:= t+1 fi
%p A358074   od
%p A358074 end proc:
%p A358074 map(f, [$1..100]); # _Robert Israel_, Nov 10 2026
%t A358074 With[{f = Range[5]!}, a[n_] := Count[f, _?(IntegerQ @ Sqrt[n - #] &)]; Array[a, f[[-1]]]] (* _Amiram Eldar_, Oct 30 2022 *)
%Y A358074 Cf. A000142, A000290, A359013.
%K A358074 nonn,changed
%O A358074 1,2
