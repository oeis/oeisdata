%S A358061 0,1,0,2,0,2,0,0,0,0,0,4,0,2,0,3,0,0,0,2,0,2,0,0,2,0,2,0,0,0,0,4,0,0,
%T A358061 0,3,0,2,0,0,0,4,0,2,0,2,0,6,0,2,0,0,0,2,0,0,0,0,0,4,0,2,0,4,0,4,0,2,
%U A358061 0,0,0,0,0,0,4,0,0,0,0,2,4,0,0,0,0,2,0,0,0,0
%N A358061 a(n) = phi(n) mod tau(n).
%C A358061 a(n) > 0 for n in A015733, a(n) = 0 for n in A020491.
%C A358061 From _Robert Israel_, Nov 10 2026: (Start)
%C A358061 Every nonnegative integer occurs infinitely often in the sequence.
%C A358061 For any m <> 1, let q be a prime > m, and let p be a prime such that p == (1-m)^(-1) (mod q).
%C A358061 Then tau(p^(q-1)) = q and phi(p^(q-1)) = p^(q-2)*(p-1) == m (mod q).
%C A358061 In the case m = 1, let p be a prime == 23 (mod 35).  Then tau(p^34) = 35 and phi(p^34) = (p-1)*p^33 == 1 (mod 35).
%C A358061 In both cases, Dirichlet's theorem says there are infinitely many such p.
%C A358061 (End)
%H A358061 Robert Israel, <a href="/A358061/b358061.txt">Table of n, a(n) for n = 1..10000</a>
%F A358061 a(n) = A000010(n) mod A000005(n).
%e A358061 For n = 4; a(4) = A000010(4) mod A000005(4) = 2 mod 3 = 2.
%p A358061 f:= n -> NumberTheory:-phi(n) mod NumberTheory:-tau(n):
%p A358061 map(f, [$1..100]); # _Robert Israel_, Nov 10 2026
%t A358061 a[n_] := Mod[EulerPhi[n], DivisorSigma[0, n]]; Array[a, 100] (* _Amiram Eldar_, Oct 28 2022 *)
%o A358061 (Python)
%o A358061 from math import prod
%o A358061 from sympy import factorint
%o A358061 def A358061(n):
%o A358061     f = factorint(n).items()
%o A358061     d = prod(e+1 for p, e in f)
%o A358061     return prod(pow(p,e-1,d)*((p-1)%d) for p, e in f) % d # _Chai Wah Wu_, Oct 29 2022
%o A358061 (PARI) a(n) = my(f=factor(n)); eulerphi(f) % numdiv(f); \\ _Michel Marcus_, Nov 10 2026
%Y A358061 Cf. A000005 (tau), A000010 (phi), A015733, A020491.
%K A358061 nonn,changed
%O A358061 1,4
