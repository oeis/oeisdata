%I A358798 #35 Aug 26 2026 16:29:52
%S A358798 2,3,5,7,11,13,17,19,23,31,29,37,41,47,43,61,53,67,59,73,71,83,89,79,
%T A358798 97,101,103,109,107,113,127,131,139,137,149,151,163,157,179,167,173,
%U A358798 181,193,191,211,197,199,227,233,223,229,239,251,241,277,257,271,263
%N A358798 a(1) = 2, a(2) = 3; for n > 2, a(n) is the smallest prime that can be appended to the sequence so that the smallest even number >= 4 that cannot be generated as the sum of two (not necessarily distinct) terms from {a(1), ..., a(n-1)} can be generated from {a(1), ..., a(n)}.
%C A358798 Related to the Goldbach conjecture. Proving that this sequence is non-terminating would prove the Goldbach conjecture.
%H A358798 Travis J Weber, <a href="/A358798/b358798.txt">Table of n, a(n) for n = 1..10002</a>
%H A358798 Travis J Weber, <a href="https://github.com/thetravisweber/goldbach/blob/main/Consecutive%20Prime%20list.ipynb">Python notebook code</a>
%e A358798 For n=5, the sequence a(1..4) is 2, 3, 5, 7. The even numbers 4..14 are sums of two terms and 16 is the smallest even number not a sum. The smallest prime allowing 16 to be made is 11, by 5 + 11 = 16. Thus, a(5) = 11.
%e A358798 For n=106, the smallest even number that is not the sum of two terms a(1..105) is 1082. The smallest prime allowing 1082 to be made is 541, by 541 + 541 = 1082. Thus, a(106) = 541.
%o A358798 (Python)
%o A358798 from sympy import isprime
%o A358798 from itertools import count, islice
%o A358798 def agen(): # generator of terms
%o A358798     alst, sums, m, oo = [2, 3], {4, 5, 6}, 8, float('inf')
%o A358798     yield from alst
%o A358798     for k in count(m, 2):
%o A358798         if k not in sums:
%o A358798             UB = k//2 if isprime(k//2) else oo
%o A358798             an = next((k-p for p in sorted(alst, reverse=True) if isprime(k-p)), UB)
%o A358798             an = min(an, UB)
%o A358798             if an != oo:
%o A358798                 alst.append(an)
%o A358798                 sums.update(ai+an for ai in alst)
%o A358798                 yield an
%o A358798                 while m in sums:
%o A358798                     m += 2
%o A358798 print(list(islice(agen(), 60))) # _Michael S. Branicky_, Aug 26 2026
%K A358798 nonn,changed
%O A358798 1,1
