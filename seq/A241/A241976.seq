%S A241976 0,9,60,357,2088,12177,70980,413709,2411280,14053977,81912588,
%T A241976 477421557,2782616760,16218279009,94527057300,550944064797,
%U A241976 3211137331488,18715879924137,109084142213340,635788973355909,3705649697922120,21598109214176817,125883005587138788
%N A241976 Values of k such that k^2 + (k+3)^2 is a square.
%C A241976 A075841 gives the corresponding values of sqrt(n^2 + (n+3)^2).
%C A241976 The solutions of x^2 + (x+3)^2 = y^2 with x >= 0 are described by the generalized Pell equation U^2 - 2*y^2 = -9, where U = 2*x+3. All nonnegative solutions are generated from the seed (x,y) = (0,3) by repeated application of the Pell transformation U' = 3*U + 4*y and y' = 2*U + 3*y, equivalently x' = 3*x + 2*y + 3. - _Farhad Banazadeh_, Oct 24 2026
%H A241976 Vincenzo Librandi, <a href="/A241976/b241976.txt">Table of n, a(n) for n = 1..200</a>
%H A241976 Farhad Banazadeh, <a href="https://doi.org/10.5281/zenodo.23592032">A Unified Pell-Orbit Theory for the Diophantine Equation x^2+(x+d)^2=y^2: Complete Parametrization, Recurrences, and an OEIS Catalogue</a>, Zenodo (2026), Section 11.4.1.
%H A241976 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (7,-7,1).
%F A241976 G.f.: 3*x^2*(x-3) / ((x-1)*(x^2-6*x+1)).
%F A241976 a(n) = 7*a(n-1) - 7*a(n-2) + a(n-3).
%F A241976 a(n) = 3*A001652(n-1).
%F A241976 a(n) = -3*(2 + (3-2*sqrt(2))^n*(1+sqrt(2)) - (-1+sqrt(2))*(3+2*sqrt(2))^n) / 4. - _Colin Barker_, Apr 13 2017
%F A241976 a(n) = 6*a(n-1) - a(n-2) + 6, with a(1) = 0 and a(2) = 9. - _Farhad Banazadeh_, Oct 24 2026
%e A241976 9 is in the sequence because 9^2 + 12^2 = 225 = 15^2.
%e A241976 For a(3) = 60, the associated Pythagorean triple is (60, 63, 87), since 60^2 + 63^2 = 87^2. With U = 2*60 + 3 = 123, the Pell equation gives 123^2 - 2*87^2 = -9. - _Farhad Banazadeh_, Oct 24 2026
%t A241976 CoefficientList[Series[3 x (x - 3)/((x - 1) (x^2 - 6 x + 1)), {x, 0, 30}], x] (* _Vincenzo Librandi_, Aug 11 2014 *)
%o A241976 (PARI) concat(0, Vec(3*x^2*(x-3)/((x-1)*(x^2-6*x+1)) + O(x^30)))
%o A241976 (Python)
%o A241976 def a241976(n):
%o A241976     x, y = 0, 3
%o A241976     for _ in range(n - 1):
%o A241976         x, y = 3*x + 2*y + 3, 4*x + 3*y + 6
%o A241976     return x
%o A241976 print([a241976(n) for n in range(1, 30)]) # _Farhad Banazadeh_, Oct 24 2026
%Y A241976 Cf. A001652, A065113, A075841.
%K A241976 nonn,easy,changed
%O A241976 1,2
%A A241976 _Colin Barker_, Aug 10 2014
