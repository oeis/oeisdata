%S A279094 2,2,4,2,25,2,59049,4,4,5,256,2,282475249,243,4,2,729,2,
%T A279094 1174562876521148458974062689,8,64,16,25,1331,594823321,16807,
%U A279094 38950081,151,361,2,470541197898347534873984161,19902511,241081,27,9,61,625,34271896307633,73441,53,1681
%N A279094 Smallest k such that sigma(k^n) is prime.
%C A279094 For any number k with two or more distinct prime divisors, the sum of divisors of k^n is composite, so each term is of the form p^j where p is prime and j >= 1, i.e., all terms are prime powers (A246655). Additionally, sigma(k^n) = sigma(p^(j*n)) = (p^(j*n + 1) - 1)/(p - 1) is composite when j*n + 1 is composite, so a(n) must be of the form p^j where j*n + 1 is prime.
%H A279094 Jon E. Schoenfield, <a href="/A279094/b279094.txt">Table of n, a(n) for n = 1..200</a>
%e A279094 a(1) = 2 because sigma(1^1) = sigma(1) = 1 (not prime), but sigma(2^1) = sigma(2) = 1 + 2 = 3 (prime).
%e A279094 a(3) = 4 because sigma(1^3) = 1 (not prime), sigma(2^3) = 1 + 2 + 4 + 8 = 15 (composite), sigma(3^3) = 1 + 3 + 9 + 27 = 40 (composite), but sigma(4^3) = sigma(2^6) = 1 + 2 + 4 + 8 + 16 + 32 + 64 = 127 (prime).
%e A279094 a(19) = 1174562876521148458974062689 = 17^22 because sigma((17^22)^19) is prime and sigma(k^19) is not prime for any smaller value of k.
%o A279094 (Python)
%o A279094 from heapq import heappop, heappush
%o A279094 from sympy import isprime, nextprime
%o A279094 def A279094(n):
%o A279094     k = 1
%o A279094     while not isprime(k*n+1):
%o A279094         k += 1
%o A279094     h, hset, jlist = [(1<<k,0,2)], {1<<k}, [k]
%o A279094     while True:
%o A279094         pj, i, p = heappop(h)
%o A279094         m = pj**n*p
%o A279094         if isprime((m-1)//(p-1)):
%o A279094             return pj
%o A279094         if i < len(jlist)-1:
%o A279094             j = jlist[i+1]
%o A279094         else:
%o A279094             j = jlist[i]+1
%o A279094             while not isprime(j*n+1):
%o A279094                 j += 1
%o A279094             jlist.append(j)
%o A279094         for w in [(p**j,i+1,p),((q:=nextprime(p))**k,0,q)]:
%o A279094             if w[0] not in hset:
%o A279094                 heappush(h,w)
%o A279094                 hset.add(w[0]) # _Chai Wah Wu_, Aug 18 2026
