%F A288342 a(n) = floor(n^7/25401600 + 29*n^6/7257600 + 397*n^5/2419200 + 145*n^4/41472 + 24863*n^3/604800 + 209*n^2/800 + 55021*n/68040 + 26/25 - (n mod 2)*(n^2 + 29*n)/1536 + (((n+1) mod 3) - (n mod 3))*n/486). - _Hoang Xuan Thanh_, Jul 29 2026
