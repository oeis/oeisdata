%I A288005 #40 Oct 31 2026 12:38:28
%S A288005 1,1,1,2,1,3,3,5,4,9,8,15,14,26,24,46,42,79,73,137,128,239,221,414,
%T A288005 385,719,668,1249,1161,2167,2016,3762,3499,6531,6075,11336,10546,
%U A288005 19676,18306,34153,31775,59279,55155,102890,95733,178587,166165,309968,288412
%N A288005 Number of symmetrical fountains of n coins.
%C A288005 From _Peter Luschny_, Oct 31 2026: (Start)
%C A288005 Also the number of symmetric primitive Dyck paths of area n, where a path is symmetric if it is invariant under reflection about its vertical midpoint, and the area is the sum of the starting heights of its up-steps.
%C A288005 Compare A400670, which counts the distinct images of the symmetric upper-envelope operator E on primitive Dyck paths of area n, whereas the current sequence counts its fixed points of area n. Since E(P) may have area greater than n, the two sequences differ. In particular, a(n) <= A400670(n) <= A005169(n). (End)
%H A288005 Alois P. Heinz, <a href="/A288005/b288005.txt">Table of n, a(n) for n = 0..8354</a>
%e A288005 a(7) = 5:
%e A288005 .. O O O ....... O O ....... O ... O ......... O ........................
%e A288005 . O O O O ... O O O O O ... O O O O O ... O O O O O O ... O O O O O O O .
%p A288005 b:= proc(n, i, p) option remember; `if`(n<0, 0, `if`(n=0,
%p A288005       `if`(p<0 and i=1, 1, 0), `if`(n=i or n=i+p, 1, 0)+
%p A288005       `if`(i<1 and p=1, 0, b(n-2*i, i, -p))+b(n-2*(i+p), i+p, -p)))
%p A288005     end:
%p A288005 a:= n-> `if`(n=0, 1, b(n, 0, 1)):
%p A288005 seq(a(n), n=0..60);  # _Alois P. Heinz_, Sep 02 2017
%t A288005 b[n_, i_, p_] := b[n, i, p] = If[n < 0, 0, If[n == 0, If[p < 0 && i == 1, 1, 0], If[n == i || n == i + p, 1, 0] + If[i < 1 && p == 1, 0, b[n - 2i, i, -p]] + b[n - 2(i + p), i + p, -p]]];
%t A288005 a[n_] := If[n == 0, 1, b[n, 0, 1]];
%t A288005 a /@ Range[0, 60] (* _Jean-François Alcover_, Nov 14 2020, after _Alois P. Heinz_ *)
%o A288005 (Python)
%o A288005 from math import isqrt
%o A288005 def A288005List(N: int) -> list[int]: # returns a(0), ..., a(N).
%o A288005     H = (1 + isqrt(8*N + 1)) // 2; R = H + 1
%o A288005     dp = [[0] * (H + 2) for _ in range(R)]; dp[0][1] = 1
%o A288005     counts = [1] + [0] * N
%o A288005     for a in range(1, N + 1):
%o A288005         row = dp[a % R]
%o A288005         row[:] = [0] * (H + 2)
%o A288005         for h in range(1, H + 1):
%o A288005             if h >= 2 and a >= h - 1: row[h] += dp[(a-h+1) % R][h-1]
%o A288005             if a >= h: row[h] += dp[(a-h) % R][h+1]
%o A288005             counts[a] += row[h]
%o A288005     return counts
%o A288005 print(A288005List(48))  # _Peter Luschny_, Oct 31 2026
%Y A288005 Cf. A005169, A288006, A400670.
%K A288005 nonn,changed
%O A288005 0,4
%A A288005 _Seiichi Manyama_, Sep 01 2017
%E A288005 a(33)-a(48) from _Alois P. Heinz_, Sep 02 2017
