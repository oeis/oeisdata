%I A032688 #16 Aug 03 2026 01:05:04
%S A032688 3,23,29,32,33,38,45,51,65,75,90,96,108,110,113,116,125,132,135,147,
%T A032688 167,183,185,186,195,204,216,218,227,236,242,246,248,254,255,257,263,
%U A032688 275,276,278,284,293,297,300,314,315,320,323,324,326,330,338,345,347
%N A032688 Numbers k such that k surrounded by digit '5' is a lucky number.
%H A032688 Robert Israel, <a href="/A032688/b032688.txt">Table of n, a(n) for n = 1..1381</a>
%e A032688 535 is lucky, so 3 is a term.
%p A032688 # using list of lucky numbers L, e.g. from the b-file of A000959
%p A032688 f:= proc(n) local m,d;
%p A032688    if n mod 10 <> 5 then return NULL fi;
%p A032688    m:=(n-5)/10;
%p A032688    d:= ilog10(m);
%p A032688    if floor(m/10^d) <> 5 then return NULL fi;
%p A032688    m:= m mod 10^d;
%p A032688    if m >= 10^(d-1) then m else NULL fi;
%p A032688 end proc:
%p A032688 f(5):= NULL:
%p A032688 map(f, L); # _Robert Israel_, Aug 03 2026
%Y A032688 Cf. A000959, A032682.
%K A032688 nonn,base,changed
%O A032688 1,1
%A A032688 _Patrick De Geest_, May 15 1998
