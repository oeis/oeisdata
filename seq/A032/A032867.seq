%N A032867 Numbers whose base-4 representation Sum_{i=0..m} d(i)*4^i has d(m) >= d(m-1) <= d(m-2) >= ...
%H A032867 Robert Israel, <a href="/A032867/b032867.txt">Table of n, a(n) for n = 1..10000</a>
%p A032867 extend:= proc(x) local i;
%p A032867   if ilog[4](x)::even then seq(4*x + i, i=0..(x mod 4)) else seq(4*x+i,i=(x mod 4) .. 3) fi
%p A032867 end proc:
%p A032867 L:= [1,2,3]: R:= op(L):
%p A032867 for i from 1 to 4 do L:= map(extend,L); R:= R, op(L) od:
