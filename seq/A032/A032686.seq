%I A032686 #15 Aug 03 2026 01:06:40
%S A032686 1,4,5,7,10,20,23,25,26,28,29,40,44,47,49,50,61,64,70,71,73,77,80,83,
%T A032686 92,94,101,109,118,130,134,137,139,149,152,154,158,164,172,173,178,
%U A032686 181,191,196,199,212,214,215,220,230,232,239,241,248,262,263
%N A032686 Numbers k such that k surrounded by digit '1' is a lucky number.
%H A032686 Robert Israel, <a href="/A032686/b032686.txt">Table of n, a(n) for n = 1..10000</a>
%e A032686 111 is lucky, so 1 is a term.
%p A032686 # using list of lucky numbers L, e.g. from the b-file of A000959
%p A032686 f:= proc(n) local m,d;
%p A032686    if n mod 10 <> 1 then return NULL fi;
%p A032686    m:=(n-1)/10;
%p A032686    d:= ilog10(m);
%p A032686    if floor(m/10^d) <> 1 then return NULL fi;
%p A032686    m:= m mod 10^d;
%p A032686    if m >= 10^(d-1) then m else NULL fi;
%p A032686 end proc:
%p A032686 f(1):= NULL:
%p A032686 map(f, L); # _Robert Israel_, Aug 02 2026
%Y A032686 Cf. A000959, A032682.
%K A032686 nonn,base,changed
%O A032686 1,2
%A A032686 _Patrick De Geest_, May 15 1998
