%I A032689 #15 Aug 03 2026 01:05:00
%S A032689 1,2,7,8,16,19,20,23,35,37,43,44,50,56,67,68,71,73,82,83,89,91,94,101,
%T A032689 103,104,115,127,134,151,154,155,157,161,169,199,212,215,218,227,232,
%U A032689 257,260,268,272,278,289,290,299,301,308,311,317,319,322,337,338
%N A032689 Numbers k such that k surrounded by digit '7' is a lucky number.
%H A032689 Robert Israel, <a href="/A032689/b032689.txt">Table of n, a(n) for n = 1..1413</a>
%e A032689 717 is lucky, so 1 is a term.
%p A032689 # using list of lucky numbers L, e.g. from the b-file of A000959
%p A032689 f:= proc(n) local m,d;
%p A032689    if n mod 10 <> 7 then return NULL fi;
%p A032689    m:=(n-7)/10;
%p A032689    d:= ilog10(m);
%p A032689    if floor(m/10^d) <> 7 then return NULL fi;
%p A032689    m:= m mod 10^d;
%p A032689    if m >= 10^(d-1) then m else NULL fi;
%p A032689 end proc:
%p A032689 f(7):= NULL:
%p A032689 map(f, L); # _Robert Israel_, Aug 03 2026
%Y A032689 Cf. A000959, A032684.
%K A032689 nonn,base,changed
%O A032689 1,2
%A A032689 _Patrick De Geest_, May 15 1998
