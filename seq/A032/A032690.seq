%I A032690 #14 Aug 03 2026 01:04:56
%S A032690 7,13,24,33,34,39,40,42,54,64,78,97,99,103,105,108,112,123,126,127,
%T A032690 129,132,133,139,142,147,150,163,172,177,205,217,219,223,229,237,240,
%U A032690 255,256,258,259,265,268,270,273,274,277,282,286,292,309,312,313,316
%N A032690 Numbers k such that k surrounded by digit '9' is a lucky number.
%H A032690 Robert Israel, <a href="/A032690/b032690.txt">Table of n, a(n) for n = 1..1356</a>
%e A032690 979 is lucky, so 7 is a term.
%p A032690 # using list of lucky numbers L, e.g. from the b-file of A000959
%p A032690 f:= proc(n) local m,d;
%p A032690    if n mod 10 <> 9 then return NULL fi;
%p A032690    m:=(n-9)/10;
%p A032690    d:= ilog10(m);
%p A032690    if floor(m/10^d) <> 9 then return NULL fi;
%p A032690    m:= m mod 10^d;
%p A032690    if m >= 10^(d-1) then m else NULL fi;
%p A032690 end proc:
%p A032690 f(9):= NULL:
%p A032690 map(f, L); # _Robert Israel_, Aug 03 2026
%Y A032690 Cf. A000959, A032685.
%K A032690 nonn,base,changed
%O A032690 1,1
%A A032690 _Patrick De Geest_, May 15 1998
