%N A032708 Numbers k such that k prefixed by '8' and followed by '1' is prime.
%H A032708 Robert Israel, <a href="/A032708/b032708.txt">Table of n, a(n) for n = 1..10000</a>
%p A032708 filter:= k -> isprime(8*10^(2+ilog10(k))+k*10+1):
%p A032708 select(filter, [$1..1000]); # _Robert Israel_, Sep 20 2026
%t A032708 Select[Range[250],PrimeQ[FromDigits[Join[{8}, IntegerDigits[#],{1}]]]&]  (* _Harvey P. Dale_, Mar 24 2011 *)
