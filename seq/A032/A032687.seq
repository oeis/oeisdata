%I A032687 #15 Aug 03 2026 01:06:36
%S A032687 0,9,12,13,15,16,18,21,22,24,31,36,40,43,45,60,61,63,66,75,76,79,84,
%T A032687 87,94,100,103,109,114,126,129,130,136,138,145,157,163,171,172,177,
%U A032687 186,189,190,195,201,205,213,217,222,237,240,243,253,256,259
%N A032687 Numbers k such that k surrounded by digit '3' is a lucky number.
%H A032687 Robert Israel, <a href="/A032687/b032687.txt">Table of n, a(n) for n = 1..1548</a>
%e A032687 303 is lucky, so 0 is a term.
%p A032687 # using list of lucky numbers L, e.g. from the b-file of A000959
%p A032687 f:= proc(n) local m,d;
%p A032687    if n mod 10 <> 3 then return NULL fi;
%p A032687    m:=(n-3)/10;
%p A032687    d:= ilog10(m);
%p A032687    if floor(m/10^d) <> 3 then return NULL fi;
%p A032687    m:= m mod 10^d;
%p A032687    if m >= 10^(d-1) then m else NULL fi;
%p A032687 end proc:
%p A032687 f(3):= NULL: f(303):= 0:
%p A032687 map(f, L); # _Robert Israel_, Aug 02 2026
%Y A032687 Cf. A000959, A032683.
%K A032687 nonn,base,changed
%O A032687 1,2
%A A032687 _Patrick De Geest_, May 15 1998
