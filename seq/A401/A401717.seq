%N A401717 a(n) = 1 if A003557(n) > A053669(n) and n is neither squarefree nor prime power, otherwise 0, where A003557(n) is n divided by its squarefree kernel, and A053669(n) is the smallest prime not dividing n.
%H A401717 Antti Karttunen, <a href="/A401717/b401717.txt">Table of n, a(n) for n = 1..65537</a>
%H A401717 <a href="/index/Ch#char_fns">Index entries for characteristic functions</a>.
%F A401717 a(n) = A355447(n) * (1-A401714(n)).
%F A401717 a(n) = A355447(n) - A401716(n).
%t A401717 f[x_] := Module[{q}, q = 2; While[Divisible[x, q], q = NextPrime[q]]; q]; rad[x_] := Times @@ FactorInteger[#][[All, 1]]; Array[Boole[And[Nor[PrimePowerQ[#], SquareFreeQ[#]], f[#] < #/rad[#]]] &, 120] (* _Michael De Vlieger_, Nov 07 2026 *)
%o A401717 (PARI)
%o A401717 A003557(n) = (n/factorback(factorint(n)[, 1]));
%o A401717 A053669(n) = forprime(p=2, , if(n%p, return(p)));
%o A401717 A401717(n) = (!issquarefree(n) && !isprimepower(n) && (A003557(n) > A053669(n)));
%Y A401717 Characteristic function of A360765.
%Y A401717 Cf. A003557, A007947, A053669, A355447, A401714, A401716.
%K A401717 nonn,easy,new
%O A401717 1
%A A401717 _Antti Karttunen_, Nov 07 2026
