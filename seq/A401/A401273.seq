%S A401273 1,3,7,10,15,22,31,39,49,62,73,87,103,118,135,154,175,197,223,245,271,
%T A401273 298,327,358,391,423,457,494,529,567,609,647,691,734,779,825,872,921,
%U A401273 971,1022,1075,1127,1185,1239,1297,1358,1417,1479,1543,1606,1671,1738
%N A401273 a(n) is the smallest deficient number that is equal to the sum of n distinct deficient numbers.
%C A401273 a(n) = Sum_{k = 1..n} A005100(k) = A173106(n) for n <> 1, 3, 7, 10, 13, 19, 25, 28, ...
%e A401273 a(3) = 7 since A005100(1) + A005100(2) + A005100(4) = 1 + 2 + 4 = 7 = A005100(6) while A005100(1) + A005100(2) + A005100(3) = 1 + 2 + 3 = 6 is not deficient.
%Y A401273 Cf. A005100, A173106, A401272 (similar but for abundant numbers).
%K A401273 nonn,more,new
%O A401273 1,2
%A A401273 _Bernard Schott_, Nov 04 2026
