%I A401133 #17 Nov 24 2026 05:05:39
%S A401133 60,84,840,924,1320,1716,3900,4620,12540,18480,18564,45144,59340,
%T A401133 62160,62496,85140,88536,112200,169260,184440,204204,218400,222456,
%U A401133 235620,271440,315276,355680,512064,568260,620256,731016,744120,778596,918060,966420,1035096,1087320,1282260,1284720,1316700
%N A401133 Areas of primitive Pythagorean triangles that are the sum of a pair of twin primes.
%H A401133 Robert Israel, <a href="/A401133/b401133.txt">Table of n, a(n) for n = 1..10000</a>
%e A401133 a(4) = 924 is a term because the primitive Pythagorean triangle with sides (33, 56, 65) has area 33 * 56/2 = 924, and 924 is the sum of the twin primes 461 and 463.
%e A401133 The first term that arises from more than one primitive Pythagorean triangle is a(43) = 1857240, which is the area of the triangles with sides (1232, 3015, 3257) and (720, 5159, 5209).
%p A401133 N:= 10^8: # for terms <= N
%p A401133 S:= {}:
%p A401133 for u from 1 while u*(u^2-1) <= N do
%p A401133   for v from 1 + (u mod 2) by 2 to u/2 do
%p A401133     if igcd(u,v) > 1 then next fi;
%p A401133     a:= u*v*(u^2-v^2); if a > N then break fi;
%p A401133     if isprime(a/2-1) and isprime(a/2+1) then S:= S union {a} fi
%p A401133   od;
%p A401133   for v from u-1 by -2 to u/2 do
%p A401133     if igcd(u,v) > 1 then next fi;
%p A401133     a:= u*v*(u^2-v^2); if a > N then break fi;
%p A401133     if isprime(a/2-1) and isprime(a/2+1) then S:= S union {a} fi
%p A401133 od od:
%p A401133 sort(convert(S,list));
%Y A401133 Cf. A402209, A401135. Intersection of A024365 and A054735.
%K A401133 nonn,new
%O A401133 1,1
%A A401133 _Will Gosnell_ and _Robert Israel_, Nov 20 2026
