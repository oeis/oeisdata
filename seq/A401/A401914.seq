%o A401914 A401914lista(up_to) = { my(v=vector(up_to),t,lista=List()); for(n=1,up_to,t = A401723(n); if(t<=up_to, v[t]++)); for(i=1,up_to,if(0==v[i], listput(lista,i))); Vec(lista); };
