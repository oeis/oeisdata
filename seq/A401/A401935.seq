%I A401935 #8 Nov 09 2026 23:26:24
%S A401935 1,2,3,4,5,7,8,9,10,11,12,13,15,16,17,19,23,25,27,28,29,31,32,35,37,
%T A401935 41,43,47,49,53,59,61,63,64,67,71,73,79,81,83,89,91,97,100,101,103,
%U A401935 107,108,109,113,121,125,127,128,131,135,137,139,143,144,149,151,155,157,161,163,167,169,173,179,181,187,191
%N A401935 Numbers k such that A276085(k) is a multiple of A083345(k), where A083345 is the numerator of the fully additive function with a(p) = 1/p, and A276085 is fully additive with a(p) = p#/p.
%H A401935 Antti Karttunen, <a href="/A401935/b401935.txt">Table of n, a(n) for n = 1..10000</a>
%H A401935 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%o A401935 (PARI)
%o A401935 A083345(n) = { my(f=factor(n)); numerator(vecsum(vector(#f~, i, f[i, 2]/f[i, 1]))); };
%o A401935 A276085_mod_m(n,m) = if(1==n,0,my(f = factor(n),lp=f[#f~,1],pr=1,s=0,k=1); forprime(p=2,lp,if(f[k,1]==p, s += f[k,2]*pr; s %= m; k++); pr *= p; pr %= m); (s));
%o A401935 is_A401935(k) = ((1==k) || !A276085_mod_m(k, A083345(k)));
%Y A401935 Cf. A083345, A276085.
%Y A401935 After the initial 1, gives the positions of 0's in A401934.
%Y A401935 Subsequences: A401727 (terms that are in A371083), A401732 (terms that are also in A401730).
%Y A401935 Cf. also A401725, A401728.
%K A401935 nonn,new
%O A401935 1,2
%A A401935 _Antti Karttunen_, Nov 09 2026
