%S A401064 2,2,7,11,31,5,19,11,89,109,17,67,151,197,61,269,11,137,13,17,101,3,
%T A401064 173,541,643,379,601,587,337,787,739,607,641,461,691,599,607,179,1129,
%U A401064 1321,701,229,193,761,2,1523,1123,617,1117,227,269,523,499,733,233,487,137,1543,1931,107,967,2111,2341,757,439,2143
%N A401064 Largest such q listed for each prime p (A401061) for which there exists a prime q <= p such that ((p#/p) / (q#/q)) == -1 mod p, where p# = A034386(p).
%H A401064 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401064 a(n) = A000040(1+A400837(A401065(n))).
%o A401064 (PARI) A401064_p2q(p) = if(2==p,2,my(n=primepi(p)-1, pr=1, lastk=0); forstep(k=n, 1, -1, if((p-1)==pr, return(prime(1+k))); pr *= prime(k); pr %= p; lastk = k); if((p-1)==pr,return(prime(lastk)),0));
%o A401064 forprime(p=2, 3571, if((q=A401064_p2q(p))>0, print1(q, ", ")));
%Y A401064 Cf. A000040, A034386, A400837, A401061, A401065.
%Y A401064 Cf. also A401062 for similar sequence.
%K A401064 nonn,new
%O A401064 1,1
%A A401064 _Antti Karttunen_, Oct 20 2026
