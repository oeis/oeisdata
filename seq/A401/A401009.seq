%S A401009 0,0,1,0,2,1,3,1,4,3,5,2,6,5,7,4,8,6,9,6,10,9,11,6,12,11,13,10,14,11,
%T A401009 15,11,16,15,17,12,18,17,19,14,20,17,21,18,22,21,23,16,24,22,25,22,26,
%U A401009 23,27,22,28,27,29,22,30,29,31,26,32,29,33,30,34,31,35
%N A401009 a(n) = the number of even non-divisors of n in 1..n.
%C A401009 The sequence contains all nonnegative integers.
%F A401009 a(2n+1) = n for n >= 0.
%F A401009 a(n) = 0 for n = 1, 2 and 4.
%F A401009 a(n) = A049820(n) - A401008(n) = A004526(n) - A183063(n).
%e A401009 For n = 7 there are three even non-divisors of 7: 2, 4, 6.
%t A401009 a[n_]:=Length[Select[Range[n],EvenQ[#]&&!Divisible[n,#] &]]; Array[a,71] (* _Stefano Spezia_, Oct 15 2026 *)
%o A401009 (Magma) [#S eq 0 select 0 else #S where S:= [k : k in [1..n] | not IsIntegral(n/k) and not IsOdd(k)]: n in [1..100]];
%o A401009 (PARI) a(n) = sum(k=1, n, (n%k) && !(k % 2)); \\ _Michel Marcus_, Oct 13 2026
%o A401009 (Python)
%o A401009 from sympy import divisor_count
%o A401009 def A401009(n): return (n>>1)-divisor_count(n>>(m:=(~n&n-1).bit_length()))*m # _Chai Wah Wu_, Oct 20 2026
