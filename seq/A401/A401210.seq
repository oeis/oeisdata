%S A401210 1,1,1,2,2,1,4,6,3,1,11,20,14,4,1,34,90,74,26,5,1,156,544,572,220,44,
%T A401210 6,1,1044,5096,6564,2910,562,68,7,1,12346,79264,125120,63304,12584,
%U A401210 1280,100,8,1,274668,2208612,4147832,2409488,508140,47418,2676,140,9,1
%N A401210 Triangle read by rows: T(n,k) is the number of simple graphs on n unlabeled vertices rooted at a k-clique.
%C A401210 T(n,k) is the number of simple graphs on n unlabeled vertices rooted at an independent vertex set of size k.
%C A401210 Equivalently, T(n,k) is the number of bicolored graphs on n unlabeled vertices with k black vertices and n-k white vertices such that black vertices are not adjacent to each other.
%H A401210 Andrew Howroyd, <a href="/A401210/b401210.txt">Table of n, a(n) for n = 0..860</a> (rows 0..40)
%H A401210 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Clique.html">Clique</a>.
%H A401210 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/IndependentVertexSet.html">Independent Vertex Set</a>.
%e A401210 Triangle begins:
%e A401210       1;
%e A401210       1,     1;
%e A401210       2,     2,      1;
%e A401210       4,     6,      3,     1;
%e A401210      11,    20,     14,     4,     1;
%e A401210      34,    90,     74,    26,     5,    1;
%e A401210     156,   544,    572,   220,    44,    6,   1;
%e A401210    1044,  5096,   6564,  2910,   562,   68,   7, 1;
%e A401210   12346, 79264, 125120, 63304, 12584, 1280, 100, 8, 1;
%e A401210   ...
%o A401210 (PARI)
%o A401210 permcount(v) = {my(m=1, s=0, k=0, t); for(i=1, #v, t=v[i]; k=if(i>1&&t==v[i-1], k+1, 1); m*=t*k; s+=t); s!/m}
%o A401210 edges(v) = {sum(i=2, #v, sum(j=1, i-1, gcd(v[i], v[j]))) + sum(i=1, #v, v[i]\2)}
%o A401210 cross(u, v) = {sum(i=1, #u, sum(j=1, #v, gcd(u[i], v[j])))}
%o A401210 U(nb, nw)={my(s=0); forpart(v=nw, my(t=0); forpart(u=nb, t += permcount(u) * 2^cross(u, v)); s += t*permcount(v) * 2^edges(v)/nb!); s/nw!}
%o A401210 row(n)=vector(n+1, k, k--; U(k, n-k))
%Y A401210 Row sums are A339832.
%Y A401210 Columns k=0..3 are A000088, A000666, A126122, A401211.
%Y A401210 Cf. A277219 (for labeled graphs), A401214.
%K A401210 nonn,tabl,new
%O A401210 0,4
%A A401210 _Andrew Howroyd_, Oct 17 2026
