%I A401910 #9 Nov 16 2026 17:51:37
%S A401910 0,1,4,7,12,16,23,29,39,46,57,68,81,92,109,124,140,154,175,193,216,
%T A401910 233,256,279,305,326,354,381,411,435,466,495,527,559,596,630,670,701,
%U A401910 740,780,822,859,900,943,992,1034,1081,1127,1175,1220,1274,1326,1378,1427
%N A401910 Number of distinct sizes of intervals [a,b] = {c : a <= c <= b}, a < b, in the n X n grid {0,...,n-1}^2 under the partial order (t,x) <= (t',x') iff t' >= t and |x'-x| <= t'-t (with a < b requiring t' > t).
%C A401910 Points are (t,x) with 0 <= t,x <= n-1. Write a = (t,x) < b = (t',x') when t' > t and |x'-x| <= t'-t. The interval [a,b] is the set of grid points c with a <= c <= b (an order interval clipped by the walls x = 0 and x = n-1).
%C A401910 For a = (0,xa), b = (d,xb), e = |xb-xa|, the size is ceiling((d+e+1)*(d-e+1)/2) - g(d-xa-xb) - g(xa+xb+d-2*(n-1)), where g(t) = floor(t/2)*ceiling(t/2) for t > 0 and 0 otherwise. Intervals are never clipped on both sides.
%C A401910 The largest size is A000982(n) = ceiling(n^2/2). Every size in [2, A000982(n)] is attained except Miss(n) of them, where Miss(n) is defined by a(n) = A000982(n) - 1 - Miss(n); Miss(n) = 0 exactly for n <= 5. Miss(n) > n first occurs at n = 323 (search n <= 1000).
%C A401910 For 0 <= k <= n-2 the size ceiling(n^2/2) - k is attained iff, for n odd, k = 2*x^2+y^2 or k = 2*x*(x+1)+y*(y+1)+1, and for n even, k = 2*x^2+y*(y+1) or k = 2*x*(x+1)+y^2 (x,y >= 0; n >= 16 by proof, smaller n by direct check). These are the numbers represented by x^2+2*y^2 with parity conditions (cf. A002479).
%H A401910 Scott M. Foltz, <a href="/A401910/b401910.txt">Table of n, a(n) for n = 1..1000</a>
%e A401910 For n = 3 the sizes are 2, 3, 4, 5, so a(3) = 4. For n = 6 the sizes 2..18 all occur except 15, so a(6) = 16.
%o A401910 (Python)
%o A401910 def g(t): return (t//2)*((t+1)//2) if t > 0 else 0
%o A401910 def a(n):
%o A401910     S = set()
%o A401910     for d in range(1, n):
%o A401910         for xa in range(n):
%o A401910             for xb in range(max(0, xa-d), min(n, xa+d+1)):
%o A401910                 e = abs(xb-xa)
%o A401910                 S.add(((d+e+1)*(d-e+1)+1)//2 - g(d-xa-xb) - g(xa+xb+d-2*(n-1)))
%o A401910     return len(S)
%o A401910 print([a(n) for n in range(1, 55)])
%o A401910 (PARI)
%o A401910 g(t)=if(t>0,(t\2)*((t+1)\2),0);
%o A401910 sz(n)={my(S=List());for(d=1,n-1,for(xa=0,n-1,for(xb=max(0,xa-d),min(n-1,xa+d),my(e=abs(xb-xa));listput(S,((d+e+1)*(d-e+1)+1)\2-g(d-xa-xb)-g(xa+xb+d-2*(n-1))))));Set(S)};
%o A401910 a(n)=#sz(n);
%o A401910 vector(54,n,a(n))
%Y A401910 Cf. A000982, A002479.
%K A401910 nonn,new
%O A401910 1,3
%A A401910 _Scott M. Foltz_, Nov 09 2026
