%T A401900 176176,290004,176176,37128,2128,14,42,11340,359394,3291792,11530740,
%U A401900 17323592,11530740,3291792,359394,11340,42,132,57552,2965512,45615504,282634044,809174432,1141657712,809174432,282634044,45615504,2965512,57552,132
%N A401900 Irregular triangle of palindromic numerator coefficients for the nonsymmetric Horn companion of the Gross-Witten-Wadia generating function, read by rows.
%C A401900 Row n consists of the 2*n+1 coefficients of a palindromic polynomial D_n(x). These polynomials are the numerators of the rational coefficient functions of one Horn companion of the third-order Gross-Witten-Wadia generating function.
%C A401900 Conjectural tree interpretation, checked for 1 <= n <= 8: Let tau range over description trees of type (2,2) with n edges, as in A000309. Each leaf has label 2; each internal vertex has a label between 2 and 2 plus the sum of its children's labels; the root has the maximal label. Let nu(tau) count the leaves and the internal vertices with maximal label. If B_n(z) is the polynomial formed from the absolute values in row n of A336110, the conjecture is B_n(z) = Sum_tau z^(nu(tau)-2). Conditional on this conjecture, T(n,k) counts pairs (tau,M), where M is a subset of 3*n+1 distinguishable abstract slots and nu(tau)-2+|M|=2*k. A local interpretation of the slots and a path bijection remain open.
%H A401900 Sergii Voloshyn, <a href="https://arxiv.org/abs/2609.31189">Differential Recursions, Projective Discriminants, and Algebraic Generating Functions</a>, arXiv:2609.31189 [math-ph], 2026. See Section 4.6.
%F A401900 T(n,k) = Sum_{j=0..k} (-1)^j*binomial(3*n+1,j)*P_n(k-j), for n >= 0 and 0 <= k <= 2*n where P_n(r) = 4^n*(r+1/2)_n*(r+1)_n*(r+3/2)_n/(n!*(3/2)_n*(n+1)!) and (x)_n indicates the rising factorial.
%F A401900 Equivalently, D_n(x) = (1-x)^(3*n+1)*Sum_{r>=0} P_n(r)*x^r and T(n,k) = [x^k]D_n(x). In particular, D_n(x) = x^(2*n)*D_n(1/x).
%F A401900 Let E_n(z) be the polynomial formed from row n of A140136, and let B_n(z) be the polynomial formed from the absolute values in row n of A336110. Then (1+z)^(3*n+1)*B_n(z) = D_n(z^2) + 4^n*z*E_n(z^2).
%F A401900 The first and last entries of row n are A000108(n). The row sum is D_n(1) = 2^(3*n)*A000309(n) = 2^(4*n)*(3*n)!/((n+1)!*(2*n+1)!).
%e A401900 Triangle begins:
%e A401900   1;
%e A401900   1, 6, 1;
%e A401900   2, 56, 140, 56, 2;
%e A401900   5, 370, 2955, 5628, 2955, 370, 5;
%e A401900   14, 2128, 37128, 176176, 290004, 176176, 37128, 2128, 14;
%e A401900   42, 11340, 359394, 3291792, 11530740, 17323592, 11530740, 3291792, 359394, 11340, 42;
%e A401900   ...
%t A401900 ClearAll[p, a];
%t A401900 p[n_Integer?NonNegative, r_Integer?NonNegative] := 4^n*Pochhammer[r+1/2,n]*Pochhammer[r+1,n]*Pochhammer[r+3/2,n]/(n!*Pochhammer[3/2,n]*(n+1)!);
%t A401900 a[n_Integer?NonNegative, k_Integer?NonNegative] := Sum[(-1)^j*Binomial[3*n+1,j]*p[n,k-j],{j,0,k}];
%t A401900 Flatten[Table[a[n,k],{n,0,5},{k,0,2*n}]]
%Y A401900 Cf. A336110, A111910, A140136, A000309, A000108.
%K A401900 nonn,tabf,frac,new
%O A401900 0,3
%A A401900 _Sergii Voloshyn_, Nov 09 2026
