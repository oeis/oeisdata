%T A401455 17,28,23,32,26,38,30,43,54,51,42,58,57,67,52,81,88,81,59,87,112,86,
%U A401455 41,87,165,119,45,99,142,136,80,120,167,163,99,125,193,180
%N A401455 Number of partitions of n into distinct positive parts such that the sum of any two distinct parts is squarefree.
%H A401455 Sean A. Irvine, <a href="/A401455/b401455.txt">Table of n, a(n) for n = 0..500</a>
%H A401455 Yonatan Haver, <a href="/A401455/a401455_1.pdf">Partitions with Squarefree Pairwise Sums, version 2</a> (2026).
%e A401455 For n = 8, the a(8) = 2 partitions are (8) and (5,2,1). For (5,2,1), the pairwise sums are 7, 6 and 3, all squarefree.
%o A401455 (Python)
%o A401455 from math import isqrt
%o A401455 def squarefree(m):
%o A401455     return all(m % (d*d) for d in range(2, isqrt(m)+1))
%o A401455 def a(n):
%o A401455     def visit(left, start, parts):
%o A401455         if left == 0:
%o A401455             return 1
%o A401455         return sum(visit(left-x, x+1, parts+(x,))
%o A401455                    for x in range(start, left+1)
%o A401455                    if all(squarefree(x+y) for y in parts))
%o A401455     return visit(n, 1, ())
%o A401455 print([a(n) for n in range(66)])
%K A401455 nonn,new
%O A401455 0,4
%A A401455 _Yonatan Haver_, Oct 25 2026
