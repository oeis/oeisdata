%U A401693 45766121740,170702379866,638698086644,2396598105744,9016443945274,34003643437978,128524391779864,486793093938932,1847304005333666
%N A401693 Number of ways to cut a nonempty Dyck word into a prefix and a suffix with both lengths at most n and of the same parity as n.
%C A401693 A Dyck word is a balanced string of parentheses, such as (()()). A word of length L has L+1 possible cut positions, including those before the first and after the last letter. The prefix or suffix may be empty when n is even.
%C A401693 For fixed admissible lengths i and j of the prefix and suffix, each of the A000108((i+j)/2) Dyck words of length i+j has exactly one such cut. Thus a(n) is the sum of A000108((i+j)/2) over all pairs (i, j) with 0 <= i <= n, 0 <= j <= n, i == j == n (mod 2) and (i, j) != (0, 0).
%C A401693 Hogan's program matrixMeanders (see Links) counts open meanders (A005316) and semi-meanders (A000682) using a form of the transfer-matrix method of Jensen (2000). In this method a vertical line between two consecutive crossings of the road meets some strands of the river. Read these strands from top to bottom, writing ( and ) for the upper and lower strands of each pair joined to the left of the line, and | for the road. The resulting Dyck word with a marked cut represents the state at that line.
%C A401693 For open meanders with N crossings, the two ends of the river are joined far to the left, and the computation starts from (|) for odd N and from ()| for even N. For semi-meanders with N >= 2 crossings, a single run of the computation starts from one state for each possible winding number r, and the possible values are 0 <= r <= N-2 with r == N (mod 2). The start state for r consists of r nested pairs across the road, such as ((|)) for r = 2; for r = 0 it is |. With n crossings still to come, including the last one, states with more than n strands on either side of the road are discarded, since they cannot be completed.
%C A401693 The numbers of strands above and below the road initially have the parity of N, and each changes by +1 or -1 at every crossing. No loop is allowed to close before the last crossing. Thus, after the first crossing, every retained state with n >= 1 crossings still to come is a nonempty Dyck word with a cut counted by a(n). For fixed n, the number of distinct such states does not decrease as N increases.
%C A401693 It appears that for n >= 2 the number of distinct states with n crossings still to come is a(n) if and only if N >= A007310(n) = 3*n - 1 - (n mod 2), for both A005316 and A000682, except that for A005316 with n = 2 the number is already a(2) = 4 for N >= 4. This has been checked for N <= 42, which covers the threshold for n <= 14.
%C A401693 The states counted by a(n) include some that cannot be completed with the remaining n crossings, such as ((|)) when n = 2. Jensen's paper describes two refinements that reduce the number of retained states: pruning based on the exact minimum number of further crossings needed for completion, and identifying states related by reflection in the road.
%H A401693 Alper Ferudun, <a href="/A401693/b401693.txt">Table of n, a(n) for n = 1..1000</a>
%H A401693 Hunter Hogan, <a href="https://github.com/hunterhogan/mapFolding">mapFolding: Create, alter, and optimize algorithms to count meanders, stamp foldings, and map foldings</a>, GitHub repository, 2026.
%H A401693 Iwan Jensen, <a href="https://arxiv.org/abs/cond-mat/0008178">A transfer matrix approach to the enumeration of plane meanders</a>, arXiv:cond-mat/0008178 [cond-mat.stat-mech], 2000.
%H A401693 Iwan Jensen, <a href="https://doi.org/10.1088/0305-4470/33/34/301">A transfer matrix approach to the enumeration of plane meanders</a>, J. Phys. A: Math. Gen. 33 (34) (2000), 5953-5963.
%F A401693 a(n) = Sum_{i=0..floor(n/2)} Sum_{j=0..floor(n/2)} A000108(i+j+(n mod 2)) - (1+(-1)^n)/2.
%F A401693 a(n) = Sum_{k=1..n} (1 + min(k - (n mod 2), n - k))*A000108(k).
%F A401693 a(n) = A014140(n) - 2*A014140(floor((n-1)/2)) - (1+(-1)^n)/2.
%F A401693 a(n) = a(n-2) + 2*A014137(n) - 2*A014137(floor((n-1)/2)) - A000108(n) for n >= 3.
%F A401693 G.f.: (2*sqrt(1-4*x^2) - (1+x)*sqrt(1-4*x) - (1-x)*(1+2*x))/(2*x*(1-x)^2*(1+x)).
%F A401693 G.f.: c(x)/(1-x)^2 - 2*x*c(x^2)/((1-x)*(1-x^2)) - 1/(1-x^2), where c(x) = (1-sqrt(1-4*x))/(2*x) is the g.f. of A000108.
%F A401693 D-finite with recurrence n*(n+1)*(5*n^3-36*n^2+80*n-54)*a(n) - n*(25*n^4-185*n^3+430*n^2-316*n+16)*a(n-1) - n*(5*n^4-61*n^3+266*n^2-488*n+308)*a(n-2) + (125*n^5-1225*n^4+4430*n^3-7172*n^2+4832*n-840)*a(n-3) - 2*(40*n^5-413*n^4+1585*n^3-2743*n^2+2011*n-420)*a(n-4) - 4*(25*n^5-260*n^4+1000*n^3-1714*n^2+1204*n-210)*a(n-5) + 8*(n-3)*(2*n-7)*(5*n^3-21*n^2+23*n-5)*a(n-6) = 0 for n >= 7.
%F A401693 a(n) ~ 2^(2*n+4)/(9*sqrt(Pi)*n^(3/2)).
%F A401693 a(n) = 2*a(n-2) - a(n-4) + ((25*n - 35) / (n + 1))*C(n-2) - 2*C(floor((n-1)/2)), where C(n) is the n-th Catalan number. - _Peter Luschny_, Nov 03 2026
%e A401693 a(1) = 1: writing | for the cut, the only word is (|).
%e A401693 a(2) = 4: ()|, |(), ()|() and ((|)).
%e A401693 a(3) = 10 = 1 + 2 + 2 + 5; by the lengths (i, j) of the prefix and the suffix, the words are:
%e A401693   (1, 1): (|);
%e A401693   (1, 3): (|()), (|)();
%e A401693   (3, 1): (()|), ()(|);
%e A401693   (3, 3): (((|))), (()|()), (()|)(), ()(|()), ()(|)().
%t A401693 a[n_] := Sum[(1 + Min[m - Mod[n, 2], n - m]) CatalanNumber[m], {m, n}]; Array[a, 29]
%o A401693 (PARI) a(n) = sum(m=1, n, (1+min(m-n%2, n-m))*binomial(2*m, m)/(m+1));
%o A401693 (PARI) my(N=29, x='x+O('x^(N+2)), c=(1-sqrt(1-4*x))/(2*x)); Vec((2*(c-x*subst(c, 'x, x^2))/(1-x)-c-1)/(1-x^2)) \\ via the g.f.
%o A401693 (Python)
%o A401693 def terms(N):
%o A401693     c = s = t = 1
%o A401693     T = [1]  # twice-summed Catalan numbers, A014140
%o A401693     for n in range(1, N+1):
%o A401693         c = c*(4*n-2)//(n+1)
%o A401693         s += c
%o A401693         t += s
%o A401693         T.append(t)
%o A401693     return [T[n] - 2*T[(n-1) >> 1] - (1-n%2) for n in range(1, N+1)]
%o A401693 print(terms(29))
%o A401693 (Python)
%o A401693 from itertools import islice
%o A401693 def a():
%o A401693     n, cat, half = 5, 5, 2
%o A401693     odd, evn, ODD, EVN = 1, 4, 10, 32
%o A401693     yield from (odd, evn, ODD, EVN)
%o A401693     while True:
%o A401693         odd, ODD = ODD, 2*ODD - odd + 5*(5*n - 7)*cat//(n + 1) - 2*half
%o A401693         yield ODD
%o A401693         cat = (4*n - 6)*cat//n
%o A401693         n += 1
%o A401693         evn, EVN = EVN, 2*EVN - evn + 5*(5*n - 7)*cat//(n + 1) - 2*half
%o A401693         yield EVN
%o A401693         cat = (4*n - 6)*cat//n
%o A401693         n += 1
%o A401693         half = (4*n - 8)*half//(n + 1)
%o A401693 print(list(islice(a(), 27)))  # _Peter Luschny_ and _Hunter Hogan_, Nov 03 2026
