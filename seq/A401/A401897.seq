%I A401897 #10 Nov 14 2026 21:45:16
%S A401897 1,5,7,10,13,17,22,24,29,32,37,40,45,44,55,56,61,63,71,72,74,81,85,87,
%T A401897 96,97,102,108,109,116,121,125,123,133,135,137,148,145,155,159,164,
%U A401897 162,169,176,179,181,193,190,198,198,205,211,215,217,226,227,236,236
%N A401897 Number of Gaussian integers w with N(w) < N(z) that are visible from z, where z = a+b*i is the n-th nonzero Gaussian integer with 0 <= b <= a, ordered by norm and then by b.
%C A401897 N(a+b*i) = a^2 + b^2 is the norm.
%C A401897 w is visible from z if no Gaussian integer lies strictly between them on the segment from z to w, i.e., gcd(Re(z-w), Im(z-w)) = 1. The points w checked include w = 0.
%C A401897 Only z with 0 <= b <= a are listed, because the count is the same for all associates and conjugates of z.
%C A401897 The number of Gaussian integers with norm < N(z) is A057655(N(z)-1); the number of them blocked from z is A057655(N(z)-1) - a(n).
%C A401897 Square-lattice analog of A401675.
%H A401897 Karan Sharma, <a href="/A401897/b401897.txt">Table of n, a(n) for n = 1..10000</a>
%H A401897 Karan Sharma, <a href="/A401897/a401897.png">Illustration of a(14) and a(127)</a>
%F A401897 Conjecture: a(n) ~ 48*n/Pi^2.
%e A401897 a(7) = 22: z = 3+i, N(z) = 10. There are A057655(9) = 29 Gaussian integers with norm < 10. Seven are blocked from z: -2+i, -1-i, -1+i, -2*i, i, 1-i, 1+i. For example, 2+i lies between 3+i and 1+i. So a(7) = 29 - 7 = 22.
%e A401897    n | z      | N(z) | norm < N(z) | blocked | a(n)
%e A401897   ---+--------+------+-------------+---------+-----
%e A401897    1 | 1      |   1  |       1     |     0   |   1
%e A401897    2 | 1+i    |   2  |       5     |     0   |   5
%e A401897    3 | 2      |   4  |       9     |     2   |   7
%e A401897    4 | 2+i    |   5  |      13     |     3   |  10
%e A401897    5 | 2+2*i  |   8  |      21     |     8   |  13
%e A401897    6 | 3      |   9  |      25     |     8   |  17
%e A401897    7 | 3+i    |  10  |      29     |     7   |  22
%e A401897    8 | 3+2*i  |  13  |      37     |    13   |  24
%o A401897 (Python)
%o A401897 from math import gcd, isqrt
%o A401897 def A_list(R):  # terms with norm <= R^2
%o A401897     pts = sorted((a*a+b*b, b, a) for a in range(1, R+1) for b in range(a+1) if a*a+b*b <= R*R)
%o A401897     out = []
%o A401897     for n, b, a in pts:
%o A401897         r = isqrt(n)
%o A401897         out.append(sum(1 for x in range(-r, r+1) for y in range(-r, r+1)
%o A401897                        if x*x+y*y < n and gcd(x-a, y-b) == 1))
%o A401897     return out
%Y A401897 Cf. A057655, A401675.
%K A401897 nonn,new
%O A401897 1,2
%A A401897 _Karan Sharma_, Nov 09 2026
