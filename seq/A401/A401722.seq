%I A401722 #13 Nov 07 2026 19:03:26
%S A401722 1,2,2,3,2,4,2,5,6,7,2,8,2,9,10,11,2,12,2,13,14,15,2,16,17,18,19,20,2,
%T A401722 21,2,22,23,24,25,26,2,27,28,29,2,30,2,31,32,33,2,34,35,36,37,38,2,39,
%U A401722 28,40,41,42,2,43,2,44,45,46,47,48,2,49,50,51,2,52,2,53,54,55,47,56,2,57,58,59,2,60,41,61,62,63,2,64,37,65,66,67,68,69,2,70,71,72,2,73,2,57
%N A401722 Lexicographically earliest infinite sequence such that a(i) = a(j) => A001065(i) = A001065(j) and A034460(i) = A034460(j), for all i, j >= 1, where A001065(n) is sigma(n)-n, and A034460(n) is usigma(n)-n.
%C A401722 Restricted growth sequence transform of the ordered pair [A001065(n), A034460(n)].
%C A401722 For all i, j >= 1:
%C A401722   A305800(i) = A305800(j) => a(i) = a(j) => A048146(i) = A048146(j).
%H A401722 Antti Karttunen, <a href="/A401722/b401722.txt">Table of n, a(n) for n = 1..65537</a>
%e A401722 For n=80, A001065(80) = sigma(80)-80 = 186-80 = 106, and A034460(80) = A034448(80)-80 = 102 - 80 = 22, and also for n=104, A001065(104) = sigma(104)-104 = 210-104 = 106, and A034460(104) = A034448(104)-104 = 126 - 104 = 22, so both a(80) and a(104) are assigned the same running count number (i.e., rank of the first appearance of combination [106, 22]) by the rgs-transform, which in this case is 57, therefore a(80) = a(104) = 57.
%o A401722 (PARI)
%o A401722 up_to = 65537;
%o A401722 rgs_transform(invec) = { my(om = Map(), outvec = vector(length(invec)), u=1); for(i=1, length(invec), if(mapisdefined(om,invec[i]), my(pp = mapget(om, invec[i])); outvec[i] = outvec[pp] , mapput(om,invec[i],i); outvec[i] = u; u++ )); outvec; };
%o A401722 A001065(n) = (sigma(n)-n);
%o A401722 A034460(n) = { my(f=factorint(n)); (prod(k=1, #f~, 1+(f[k, 1]^f[k, 2]))-n); };
%o A401722 Aux401722(n) = [A001065(n), A034460(n)];
%o A401722 v401722 = rgs_transform(vector(up_to,n,Aux401722(n)));
%o A401722 A401722(n) = v401722[n];
%Y A401722 Cf. A001065, A034460, A048146.
%Y A401722 Cf. also A401721.
%Y A401722 Differs from similar sequences A300235, A300249, A305895, A327931, A351260, A353560, A373379 first at n=104, where a(104) = 57, while those seven sequences all have 74 in that same position.
%K A401722 nonn,easy,new
%O A401722 1,2
%A A401722 _Antti Karttunen_, Nov 07 2026
