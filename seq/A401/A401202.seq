%F A401202 Equals Sum_{j>=0} A132862(j)/j!.
%F A401202 Equals 1 + Sum_{j>=0} A133385(j)/j!.
%e A401202 4.027076031452162384178440430584307639428538828265754492... .
%p A401202 g:= proc(n) option remember; `if`(n=0, 1, (b-> (f->
%p A401202       g(f)*n*g(n-1-f))(min(b-1, n-b/2)))(2^ilog2(n)))
%p A401202     end:
%p A401202 evalf[130](add(g(n)/n!, n=0..200));
