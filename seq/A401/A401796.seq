%S A401796 3,1,1,3,2,1,4,3,3,1,7,8,6,4,1,11,15,15,10,5,1,18,30,33,26,15,6,1,29,
%T A401796 56,70,63,42,21,7,1,47,104,144,144,110,64,28,8,1,76,189,288,318,270,
%U A401796 180,93,36,9,1,123,340,565,680,635,472,280,130,45,10,1,199,605,1089,1419,1441,1177,781,418,176,55,11,1
%N A401796 Triangle read by rows: T(n,k) is the number of circular words of length n over the alphabet {0,1,2} avoiding the circular subwords 11, 21, 12 with k 2's.
%C A401796 T(0,0) = 3 by convention only. The length 1 word (1) is considered to contain the circular subword (11) so is excluded.
%C A401796 For k < n-1 or even n >= 2, T(n,k) is the number of nonempty convex vertex sets with diameter k in the n-Lucas cube graph. For odd n >= 3, the number of convex vertex sets with diameter n-1 is T(n,n-1) + T(n,n) and there are no convex vertex sets with diameter n.
%H A401796 Andrew Howroyd, <a href="/A401796/b401796.txt">Table of n, a(n) for n = 0..1325</a> (rows 0..50)
%H A401796 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/GraphDiameter.html">Graph Diameter</a>.
%H A401796 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/LucasCubeGraph.html">Lucas Cube Graph</a>.
%F A401796 G.f.: (3 - 2*(1 + y)*x - x^2)/(1 - (1 + y)*x - x^2 + y*x^3).
%e A401796 Triangle begins:
%e A401796    3;
%e A401796    1,   1;
%e A401796    3,   2,   1;
%e A401796    4,   3,   3,   1;
%e A401796    7,   8,   6,   4,   1;
%e A401796   11,  15,  15,  10,   5,   1;
%e A401796   18,  30,  33,  26,  15,   6,  1;
%e A401796   29,  56,  70,  63,  42,  21,  7,  1;
%e A401796   47, 104, 144, 144, 110,  64, 28,  8, 1;
%e A401796   76, 189, 288, 318, 270, 180, 93, 36, 9, 1;
%e A401796   ...
%e A401796 A modified triangle showing the number of convex vertex sets with diameter k in the n-Lucas cube graph begins (n >= 1, k >= 0):
%e A401796    1,   0;
%e A401796    3,   2,   1;
%e A401796    4,   3,   4,   0;
%e A401796    7,   8,   6,   4,   1;
%e A401796   11,  15,  15,  10,   6,   0;
%e A401796    ...
%e A401796 The T(3,0) = 4 words are: 000, 001, 010, 100.
%e A401796 The T(3,1) = 3 words are: 002, 020, 200.
%e A401796 The T(3,2) = 2 words are: 022, 202, 220.
%e A401796 The T(3,3) = 1 word is 222.
%o A401796 (PARI) row(n) = my(M=[1, 1, y; 1, 0, 0; 1, 0, y]^n); Vecrev(sum(k=1,3,M[k,k]))
%o A401796 (PARI) T(n) = {[Vecrev(p) | p<-Vec((3 - 2*(1 + y)*x - x^2)/(1 - (1 + y)*x - x^2 + y*x^3) + O(x*x^n))]}
%o A401796 { my(A=T(10)); for(i=1, #A, print(A[i])) }
%Y A401796 Row sums are A274975.
%Y A401796 Column k=0 is A000032 for n > 0.
%Y A401796 Column k=1 is A099920(n-1) for n >= 2.
%Y A401796 Cf. A401795 (in Fibonacci cube graph).
