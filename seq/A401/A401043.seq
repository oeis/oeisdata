%I A401043 #7 Oct 29 2026 15:14:55
%S A401043 2,6,6,18,18,50,50,58,58,146,146,354,354,386,386,898,898,2050,2050,
%T A401043 2178,2178,4866,4866,5250,5250,5506,5506,12034,12034,26114,26114,
%U A401043 27138,27138,28674,28674,61442,61442,63490,63490,135170,135170,286722,286722,294914
%N A401043 Total Betti number of K[x_1,...,x_r]/I_n over K[x_1,...,x_r], where r = pi(n) and I_n is generated by the monomials x_1^e_1*...*x_r^e_r with prime(1)^e_1*...*prime(r)^e_r > n.
%C A401043 a(n) is the sum of the Betti numbers of K[x_1,...,x_r]/I_n, as a K[x_1,...,x_r] module; the quotient ring is the truncation to [1,n] of the ring of arithmetic functions under Dirichlet convolution.
%H A401043 Jan Snellman, <a href="/A401043/b401043.txt">Table of n, a(n) for n = 2..1000</a>
%H A401043 Jan Snellman, <a href="https://doi.org/10.4310/hha.2000.v2.n1.a2">Truncations of the ring of number-theoretic functions</a>, Homology Homotopy Appl. 2 (2000), 17-27; arXiv:math/9904143 [math.AC], 1999.
%H A401043 Jan Snellman, <a href="https://arxiv.org/abs/2608.29555">Truncations of the ring of number-theoretic functions, revisited</a>, arXiv:2608.29555 [math.AC], 2026.
%F A401043 a(n) = 1 + Sum_{k=1..pi(n)} A401040(n,k)*2^(pi(n)-k).
%F A401043 a(n) = Sum_{i=0..pi(n)} A401042(n,i).
%F A401043 a(2*m) = a(2*m-1) for m >= 2.
%e A401043 a(5) = 1 + 6 + 8 + 3 = 18.
%o A401043 (SageMath)
%o A401043 def a(n):
%o A401043     r = prime_pi(n)
%o A401043     phi = lambda k: len([m for m in range(1, n + 1) if all(m % p for p in prime_range(nth_prime(k) + 1))])
%o A401043     return 1 + sum(phi(k) * 2^(r - k) for k in range(1, r + 1))
%o A401043 print([a(n) for n in range(2, 50)])
%Y A401043 Cf. A000720, A182843, A401040, A401041, A401042.
%K A401043 nonn,new
%O A401043 2,1
%A A401043 _Jan Snellman_, Oct 21 2026
