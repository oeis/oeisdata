%I A401372 #12 Oct 30 2026 17:11:32
%S A401372 2,3,4,8,12,18,20,29,33,35,36,38,42,46,47,52,54,57,59,64,92,94,107,
%T A401372 112,118,132,135,153,157,163,165,180,184,188,190,194,200,216,234,239,
%U A401372 240,242,243,246,256,267,274,288,289,292,299,304,309,318,323,326,329,342,349,352,357
%N A401372 Numbers k such that with p = prime(1+k), there is at least one prime q < p such that ((p#/p) / (q#/q)) == +1 mod p, where p# = A034386(p).
%H A401372 Antti Karttunen, <a href="/A401372/b401372.txt">Table of n, a(n) for n = 1..4017</a>
%H A401372 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401372 a(n) = A000720(A401373(n))-1.
%F A401372 {k such that A401058(k) > 0}.
%o A401372 (PARI)
%o A401372 A401058(n) = { my(p=prime(1+n), pr=1, c=0); forstep(k=n, 1, -1, pr *= prime(k); pr %= p; c += (1==pr); ); (c); };
%o A401372 is_A401372(n) = (A401058(n)>0);
%Y A401372 Indices of nonzero terms in A401058.
%Y A401372 Cf. A000720, A401373 [= A000040(1+a(n))].
%Y A401372 Cf. also A401059, A401065.
%K A401372 nonn,new
%O A401372 1,1
%A A401372 _Antti Karttunen_, Oct 29 2026
