%S A401877 1,2,4,7,8,13,16,22,25,31,32,42,49,55,59,61,64,76,82,94,97,103,107,
%T A401877 109,115,117,121,127,128,148,162,174,182,186,193,199,203,205,211,213,
%U A401877 217,223,227,229,233,239,241,247,251,253,256,280,292,316,322,334,342
%N A401877 Numbers k such that the k-th composition in standard order has an odd number of parts, the first and last of which are equal.
%C A401877 The k-th composition in standard order (graded reverse-lexicographic, A066099) is obtained by taking the set of positions of 1's in the reversed binary expansion of k, prepending 0, taking first differences, and reversing again. This gives a bijective correspondence between nonnegative integers and integer compositions.
%F A401877 A400764 = A401878 \/ A401877.
%e A401877 The terms together with corresponding standard compositions begin:
%e A401877    1: (1)
%e A401877    2: (2)
%e A401877    4: (3)
%e A401877    7: (1,1,1)
%e A401877    8: (4)
%e A401877   13: (1,2,1)
%e A401877   16: (5)
%e A401877   22: (2,1,2)
%e A401877   25: (1,3,1)
%e A401877   31: (1,1,1,1,1)
%e A401877   32: (6)
%e A401877   42: (2,2,2)
%e A401877   49: (1,4,1)
%e A401877   55: (1,2,1,1,1)
%e A401877   59: (1,1,2,1,1)
%e A401877   61: (1,1,1,2,1)
%e A401877   64: (7)
%e A401877   76: (3,1,3)
%e A401877   82: (2,3,2)
%e A401877   94: (2,1,1,1,2)
%t A401877 stc[n_]:=Differences[Prepend[Join @@ Position[Reverse[IntegerDigits[n,2]],1],0]]//Reverse;
%t A401877 Select[Range[100],OddQ[Length[stc[#]]] && First[stc[#]]==Last[stc[#]]&]
%Y A401877 These compositions are counted by A128209.
%Y A401877 For full palindrome compositions of any length we have A400763, counted by A016116.
%Y A401877 Allowing any length gives A400764.
%Y A401877 For full palindrome compositions we have A400766, even A400765.
%Y A401877 The even version is A401878, counted by A078008.
%Y A401877 A001969 ranks even-length compositions, counted by A034008
%Y A401877 A006995 gives binary palindromes, complement A154809.
%Y A401877 A059893 reverses standard compositions.
%Y A401877 A066099 lists compositions in standard order.
%Y A401877 A098124 counts compositions with max part = length, ranks A389532.
%Y A401877 Cf. A000700, A001045, A027357, A029837, A048700, A091065, A124767, A333381, A389530.
