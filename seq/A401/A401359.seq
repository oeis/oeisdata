%S A401359 1,7,19,40,95,610,3926,9314,19596,46997,346630,55427257,8737037307,
%T A401359 59024271057,124614820915,213747985169,341871436397,541731132800,
%U A401359 896998483084,1704239738927,5333656592723,44917973960766,5086908525681040,183563786967913959
%N A401359 Records in A399581.
%C A401359 Any cycle of the 7x+1 map with fewer than 2964 odd terms would have smallest term at most a(11) = 346630. A search of all odd m <= 346630 with m == 1, 2 or 4 (mod 7) finds no cycle other than (1, 8, 4, 2).
%e A401359 A399581(1..6) = 1, 1, 1, 1, 1, 7, so a(1) = 1 and a(2) = A399581(6) = 7.
%o A401359 (Python)
%o A401359 from mpmath import mp, log, ceil, floor
%o A401359 mp.dps = 120
%o A401359 L = log(7)/log(2)
%o A401359 def f(n): return int(floor(n/(7*log(2)*(ceil(n*L) - n*L))))
%o A401359 S = 2**256; F = int(L*S)
%o A401359 r, out, x, d0 = -1, [], 0, S
%o A401359 for n in range(1, 911329440+1):
%o A401359     x += F; d = S - x % S  # d/S = ceiling(n*L) - n*L
%o A401359     if d < d0:
%o A401359         d0 = d; v = f(n)
%o A401359         if v > r: r = v; out.append(v)
%o A401359 print(out)
%Y A401359 Cf. A399581, A020860, A028509.
%K A401359 nonn,new
%O A401359 1,2
