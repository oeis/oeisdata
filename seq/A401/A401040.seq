%S A401040 1,2,1,2,1,3,2,1,3,2,1,4,3,2,1,4,3,2,1,5,3,2,1,5,3,2,1,6,4,3,2,1,6,4,
%T A401040 3,2,1,7,5,4,3,2,1,7,5,4,3,2,1,8,5,4,3,2,1,8,5,4,3,2,1,9,6,5,4,3,2,1,
%U A401040 9,6,5,4,3,2,1,10,7,6,5,4,3,2,1,10,7,6,5,4,3,2,1,11
%N A401040 Irregular triangle read by rows: T(n,k) is the number of integers in [1,n] having no prime factor <= prime(k), for n >= 2 and 1 <= k <= pi(n).
%C A401040 T(n,k) = Phi(n, prime(k)), Legendre's sifting function.
%C A401040 T(n,k) is the number of minimal generators, of least support k, of the monomial ideal I_n with K[x_1..x_pi(n)]/I_n isomorphic to the truncation of the ring of arithmetic functions (Dirichlet convolution) to [1,n]; the ideal is from Snellman (2000), the equality is Theorem 4 of the preprint.
%C A401040 Row n has pi(n) terms (A000720).
%C A401040 T(n,k) = pi(n) - k + 1 exactly when prime(k+1)^2 > n (Corollary 6 of the preprint).
%H A401040 Jan Snellman, <a href="/A401040/b401040.txt">Table of n, a(n) for n = 2..9954</a>
%H A401040 Jan Snellman, <a href="https://doi.org/10.4310/hha.2000.v2.n1.a2">Truncations of the ring of number-theoretic functions</a>, Homology Homotopy Appl. 2 (2000), 17-27; arXiv:math/9904143 [math.AC], 1999.
%H A401040 Jan Snellman, <a href="https://arxiv.org/abs/2608.29555">Truncations of the ring of number-theoretic functions, revisited</a>, arXiv:2608.29555 [math.AC], 2026.
%F A401040 T(n,k) = Sum_{d | prime(k)#} mu(d)*floor(n/d) (Legendre), where prime(k)# = A002110(k).
%F A401040 T(n,1) = ceiling(n/2) = A110654(n).
%F A401040 T(n,pi(n)) = 1.
%F A401040 Sum_{k=1..pi(n)} T(n,k) = A182843(n+1).
%F A401040 T(2*m,k) = T(2*m-1,k) for m >= 2.
%e A401040 Triangle begins:
%e A401040   n=2:  1;
%e A401040   n=3:  2, 1;
%e A401040   n=4:  2, 1;
%e A401040   n=5:  3, 2, 1;
%e A401040   n=6:  3, 2, 1;
%e A401040   n=7:  4, 3, 2, 1;
%e A401040   n=8:  4, 3, 2, 1;
%e A401040   n=9:  5, 3, 2, 1;
%e A401040   n=10: 5, 3, 2, 1;
%e A401040   n=11: 6, 4, 3, 2, 1;
%e A401040   ...
%e A401040 T(25,2) = 9: the integers in [1,25] with no prime factor <= 3 are 1, 5, 7, 11, 13, 17, 19, 23, 25.
%o A401040 (SageMath)
%o A401040 def T(n, k):
%o A401040     P = prime_range(nth_prime(k) + 1)
%o A401040     return len([m for m in range(1, n + 1) if all(m % p for p in P)])
%o A401040 print([T(n, k) for n in range(2, 40) for k in range(1, prime_pi(n) + 1)])
%Y A401040 Columns: A110654 (k=1), A092695 (k=4). Row lengths: A000720. Row sums: A182843 (shifted).
