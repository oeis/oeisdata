%I A401054 #18 Oct 18 2026 20:34:56
%S A401054 0,1,2,4,2,5,16,17,7,5,7,22,12,9,23,1,30,49,60,48,56,8,11,23,56,56,47,
%T A401054 50,101,60,18,104,85,39,92,113,106,31,41,39,84,7,125,175,113,10,12,90,
%U A401054 174,156,172,52,240,66,227,132,172,4,151,4,113,254,28,224,14,282,154,281,313,297,157,6,314,267,303,191
%N A401054 a(n) = 2*(product of first n primes) modulo prime(n+1).
%C A401054 Indices k for which a(k) = 1 (mod prime(1+k)) are: 1, 15, 1175, corresponding to primes 3, 53, 9491 and indices k for which a(k) = -1 (mod prime(1+k)) are: 6, 52, corresponding to primes 17, 241, and if there are any other cases, they are somewhere k > 43550.
%H A401054 Antti Karttunen, <a href="/A401054/b401054.txt">Table of n, a(n) for n = 0..43550</a>
%H A401054 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401054 a(n) = 2*A002110(n) mod A000040(1+n).
%F A401054 a(n) = 2*A062347(n) mod A000040(1+n).
%t A401054 Mod[FoldList[Times, 2, Most[#]], #] & [Prime[Range[100]]] (* _Paolo Xausa_, Oct 17 2026 *)
%o A401054 (PARI) A401054(n) = { my(p=prime(1+n), pr=Mod(2, p)); for(k=1,n,pr *= Mod(prime(k), p)); (lift(pr)); };
%o A401054 (PARI) A401054(n) = { my(p=prime(1+n), pr=2); for(k=1,n,pr *= prime(k); pr %= p); (pr%p); };
%Y A401054 Cf. A000040, A002110, A062347.
%K A401054 nonn,easy,new
%O A401054 0,3
%A A401054 _Antti Karttunen_, Oct 17 2026
