%I A401782 #34 Nov 23 2026 16:53:21
%S A401782 17,33,51,65,123,808,989,1027,1184,2193,4242,5229,8613,9633,25953,
%T A401782 28352,29354,33975,34417,38125,47874,70133,83549,84537,97444,100149,
%U A401782 119349,128288,128954,132288,140968,147092,147275,152160,155770,173224,177080,183701,189383,198011,198639
%N A401782 Positive integers k such that sopfr(k) = sopfr(3*k + 1).
%C A401782 Positive integers k such that the sum of the prime factors of k (with multiplicity) equals the sum of the prime factors of 3*k + 1 (with multiplicity).
%C A401782 In terms of core sequences: A001414(k) = A001414(3*k + 1).
%C A401782 This is an affine analog of Ruth-Aaron numbers (A006145), where prime factor sum conservation is evaluated across k -> 3*k + 1 rather than consecutive integers k and k + 1.
%H A401782 Michael S. Branicky, <a href="/A401782/b401782.txt">Table of n, a(n) for n = 1..1000</a>
%e A401782 17 is a term since sopfr(17) = 17; 3*17 + 1 = 52 = 2^2 * 13, and sopfr(52) = 2 + 2 + 13 = 17.
%e A401782 33 = 3*11 is a term since sopfr(33) = 3 + 11 = 14; 3*33 + 1 = 100 = 2^2 * 5^2, and sopfr(100) = 2 + 2 + 5 + 5 = 14.
%e A401782 808 = 2^3 * 101 is a term since sopfr(808) = 2 + 2 + 2 + 101 = 107; 3*808 + 1 = 2425 = 5^2 * 97, and sopfr(2425) = 5 + 5 + 97 = 107.
%t A401782 A401782Q[k_] := #[k] == #[3*k + 1] & [Plus @@ Times @@@ FactorInteger[#] &];
%t A401782 Select[Range[200000], A401782Q] (* _Paolo Xausa_, Nov 23 2026 *)
%o A401782 (PARI) sopfr(n) = (n=factor(n))[, 1]~*n[, 2]; \\ A001414
%o A401782 isok(k) = sopfr(k) == sopfr(3*k+1); \\ _Michel Marcus_, Nov 14 2026
%o A401782 (Python)
%o A401782 from sympy import factorint
%o A401782 def sopfr(n): return sum(p*e for p, e in factorint(n).items())
%o A401782 def ok(k): return sopfr(k) == sopfr(3*k + 1)
%o A401782 print([k for k in range(200000) if ok(k)]) # _Michael S. Branicky_, Nov 23 2026
%Y A401782 Cf. A001414, A016777, A006145.
%K A401782 nonn,new
%O A401782 1,1
%A A401782 _Vaibhav Kodag_, Nov 05 2026
