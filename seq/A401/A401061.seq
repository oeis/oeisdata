%I A401061 #28 Oct 16 2026 19:05:42
%S A401061 2,3,13,19,41,61,67,131,157,167,179,181,211,233,307,337,367,373,409,
%T A401061 467,479,557,673,751,757,797,809,811,853,929,971,1033,1049,1051,1061,
%U A401061 1063,1151,1259,1307,1361,1409,1427,1433,1451,1471,1553,1619,1627,1669,1697,1759,1801,1811,1871,1951,2063,2273,2287,2341,2411
%N A401061 Primes p for which there exists a prime q <= p such that ((p#/p) / (q#/q)) == -1 mod p, where p# = A034386(p).
%C A401061 Primes p such that 1+(A002110(k)/A002110(i)) is a multiple of prime(1+k) for some i, 0 <= i <= k.
%C A401061 The sequence includes also primes p such that p#/p == -1 mod p (in that case q=2), i.e., the next larger primes than those in A058233.
%C A401061 After the initial 2, primes p for which there exists a prime q < p such that ((#p/p) / (#q/q)) == -1 mod p or p#/p == -1 mod p.
%C A401061 After the initial 2, odd primes such that A400837(A000720(p)-1) >= 0.
%H A401061 Antti Karttunen, <a href="/A401061/b401061.txt">Table of n, a(n) for n = 1..3800</a>
%H A401061 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%e A401061 2 is a term because 1 + ((2#/2) / (q#/q)) will be a multiple of 2 when we set q to 2.
%e A401061 3 is a term because 1 + ((3#/3) / (q#/q)) will be a multiple of 3 when we set q to 2. Also 1 + (3#/3) = 1+2# is a multiple of 3.
%e A401061 13 is a term because 1 + ((13#/13) / (q#/q)) will be a multiple of 13 when we set q to 7, as then A002110(primepi(13)-1)/A002110(primepi(7)-1) = 2310/30 = 77, and 78 = 13*6.
%e A401061 19 is a term because 1 + ((19#/19) / (q#/q)) will be a multiple of 19 when we set q to 11, as then A002110(primepi(19)-1)/A002110(primepi(11)-1) = 510510/210 = 2431 and 2432 = 2^7 * 19.
%e A401061 Also, 19 is a term because 1 + (19#/19) = 1+17# = 1+A002110(7) = 510511 = 19*97*277 is a multiple of 19. Note that prevprime(19) = 17 is in A058233.
%e A401061 1471 is a term because 1 + (1471#/1471) = 1+1459# = 1+A002110(232) is a multiple of 1471. Note that prevprime(1471) = 1459 is in A058233.
%o A401061 (PARI) is_A401061_on_p(p) = { my(n=primepi(p)-1, pr=Mod(1, p)); forstep(k=n, 1, -1, if((p-1)==lift(pr), return(1)); pr *= Mod(prime(k), p)); ((p-1)==lift(pr)); };
%o A401061 (PARI)
%o A401061 A002110(n) = prod(i=1, n, prime(i));
%o A401061 is_A401061(k) = { my(p=prime(1+k)); for(i=0,k,if(!((1+(A002110(k)/A002110(i)))%p),return(1))); (0); };
%o A401061 is_A401061_on_p(p) = is_A401060(primepi(p)-1);
%Y A401061 Cf. A002110, A034386, A400837.
%Y A401061 Union of (A003961 o A058233) and A401060.
%Y A401061 Cf. also A400842, A401063.
%K A401061 nonn,new
%O A401061 1,1
%A A401061 _Antti Karttunen_, Oct 16 2026
