%o A401764 (Python)
%o A401764 from mpmath import mp, mpf, findroot
%o A401764 mp.dps = 110
%o A401764 r = findroot(lambda x: x**(x+1) - x**2 - 1, mpf('1.64'))
%o A401764 print([int(c) for c in str(r).replace('.', '')[:100]])
