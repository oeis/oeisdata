%S A401485 1,8,16,27,32,81,125,128,216,243,256,343,432,512,625,648,864,1000,
%T A401485 1296,1331,1944,2000,2048,2187,2197,2401,2592,2744,3125,3375,3456,
%U A401485 3888,4000,4096,4913,5000,5488,6561,6859,6912,7776,8192,9261,10000,10125,10368,10648,10976
%N A401485 Powerful numbers whose largest square unitary divisor is a fourth power.
%C A401485 Powerful numbers k (A001694) such that A350388(k) is a fourth power.
%C A401485 Numbers whose prime factorization exponents are larger than 1 and not congruent to 2 (mod 4) (i.e., they are terms in A042965 \ {1}).
%H A401485 Amiram Eldar, <a href="/A401485/b401485.txt">Table of n, a(n) for n = 1..10000</a>
%H A401485 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A401485 Sum_{n>=1} 1/a(n) = zeta(4) * Product_{p prime} (1 + 1/p^3 + 1/p^5) = 1.32008490499238111879... .
%F A401485 (1/zeta(2)) * Sum_{n>=1} 1/A001615(a(n)) = zeta(4) * Product_{p prime} (1 - 1/p^2 + 1/p^3 - 1/p^4) = 0.74061963657217328604... (the asymptotic density of A401484).
%t A401485 q[k_] := k == 1 || AllTrue[FactorInteger[k][[;; , 2]], # > 1 && Mod[#, 4] != 2 &]; Select[Range[12000], q]
%o A401485 (PARI) isok(k) = #select(e -> (e == 1 || e%4 == 2), factor(k)[, 2]) == 0;
%Y A401485 Intersection of A001694 (or A036966) and A401484.
%Y A401485 Cf. A013661, A013662, A042965, A350388.
%K A401485 nonn,easy,new
%O A401485 1,2
%A A401485 _Amiram Eldar_, Oct 27 2026
