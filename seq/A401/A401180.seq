%I A401180 #8 Oct 17 2026 21:00:07
%S A401180 2,4,26,363,9704,482715,44928556,7948385001,2711705463360,
%T A401180 1802161244466295,2348240317343292668,6024355635275039719701,
%U A401180 30515809959465637439376080,305806542571203973933572035955,6071637402314794520630762791848460,239100713002795575908713525594421481585
%N A401180 Total number of cliques in all connected labeled graphs on n vertices.
%H A401180 Andrew Howroyd, <a href="/A401180/b401180.txt">Table of n, a(n) for n = 1..50</a>
%H A401180 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Clique.html">Clique</a>.
%o A401180 (PARI)
%o A401180 G(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k/2^(k*(k-1)/2), O(x^n)))}
%o A401180 U(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k*2^(k*(k-1)/2), O(x^n)))}
%o A401180 seq(n)={my(g=U(exp(x+O(x*x^n)))); Vec(serlaplace(U(G(exp(x+O(x*x^n))-1)*G(g))/g + log(g)))}
%Y A401180 Row sums of A401182.
%Y A401180 Cf. A001187, A079491 (in not necessarily connected graphs), A401183.
%K A401180 nonn,new
%O A401180 1,1
%A A401180 _Andrew Howroyd_, Oct 17 2026
