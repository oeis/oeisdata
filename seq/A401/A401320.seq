%S A401320 1,1,3,1,13,15,7,1,75,186,219,146,57,12,1,541,2330,4985,6740,6278,
%T A401320 4160,1966,648,141,18,1,4683,31065,104175,229415,366621,446521,425331,
%U A401320 320873,192353,91213,33785,9555,1987,285,25,1
%N A401320 Irregular triangular array read by rows: T(n,k) is the number of ways to orient the edges of a simple labeled graph on [n] having k edges so that there are no vertex descents then surjectively color the vertices so that there are no color descents, 0<=k<=binomial(n,2), n>=0.
%C A401320 A descent in a labeled directed graph is an edge s->t such that s>t.
%C A401320 A color descent is an edge s->t such that the color of s is greater than the color of t.
%C A401320 A surjective coloring of a graph is a proper coloring with color set {c1,c2,c3,...} such that for all i<j if a vertex is colored with cj then there is at least one vertex colored with ci.
%H A401320 Kassie Archer, Ira M. Gessel, Christina Graves, and Xuming Liang, <a href="https://arxiv.org/abs/1909.01550">Counting acyclic and strong digraphs by descents</a>, arXiv:1909.01550 [math.CO], 20 Mar 2020.
%F A401320 Sum_{k>=0} Sum_{n>=0} T(n,k)*y^k*z^n/B(n) = 1/(2-e(z)) where e(z) = Sum_{n>=0} z^n/B(n) and B(n) = Product_{i=1..n} Sum_{j=0..i-1} (1+y)^j.
%e A401320 Triangle begins:
%e A401320     1;
%e A401320     1;
%e A401320     3,    1;
%e A401320    13,   15,    7,   1;
%e A401320    75,  186,  219,  146,   57,   12,   1;
%e A401320   541, 2330, 4985, 6740, 6278, 4160, 1966, 648, 141, 18, 1;...
%t A401320 nn = 6; B[n_] := FunctionExpand[QFactorial[n, (1 + y)]]; e[z_] := Sum[z^n/B[n], {n, 0, nn}]; Map[CoefficientList[#, y] &, Table[B[n], {n, 0, nn}] CoefficientList[Series[1/(2 - e[z]), {z, 0, nn}], z]]
%Y A401320 Cf. A289545 (row sums), A000670 (column k=0), A401277, A334282.
%K A401320 nonn,tabf,new
%O A401320 0,3
