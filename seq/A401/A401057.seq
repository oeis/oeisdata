%I A401057 #17 Oct 20 2026 15:52:31
%S A401057 19,853,1049,1151,2621,5147,7433,10799,11239,11833,13691,15889,20681,
%T A401057 21023,23887,25759,26669,29867,29927,32569,32621,33013,35227,37501,
%U A401057 42391,42397,45827,48871,49499,51893,56453,58243,69697,74507,75527,75641,76303,81517,85411,87317,89119,91967,96799,99023,100391,105097
%N A401057 Primes p for which there exists at least two distinct primes q < p such that ((p#/p) / (q#/q)) == -1 mod p, where p# = A034386(p).
%C A401057 Primes p such that A401056(A000720(p)-1) >= 2.
%C A401057 It is guaranteed that A276085(p^2 * q * r) is a multiple of p when q and r are two distinct such primes < p.
%H A401057 Antti Karttunen, <a href="/A401057/b401057.txt">Table of n, a(n) for n = 1..190</a>
%H A401057 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%e A401057 p=19 is a term as either q=2 or q=11 satisfies the condition.
%e A401057 p=49499 is a term as any one of three primes 44279, 43517, 7853 can be used as q, and the condition is satisfied.
%o A401057 (PARI) A401056(n) = { my(p=prime(1+n), pr=1, c=0); forstep(k=n,1,-1,c += ((p-1)==pr); pr *= prime(k); pr %= p); (c+((p-1)==pr)); };
%o A401057 is_A401057(n) = (A401056(n)>=2);
%o A401057 for(n=0,2^12,if(is_A401057(n),print1(prime(1+n),", ")));
%Y A401057 Cf. A000720, A002110, A276085, A401056.
%Y A401057 Subsequence of A401061.
%Y A401057 Cf. also A400843, A401063 for other similar sequences.
%K A401057 nonn,new
%O A401057 1,1
%A A401057 _Antti Karttunen_, Oct 17 2026
