%I A401836 #29 Nov 14 2026 22:18:58
%S A401836 8,12,15,24,27,35,47,48,59,63,68,71,75,80,84,99,108,111,116,120,128,
%T A401836 131,132,143,147,152,155,164,167,168,176,188,192,195,203,204,215,224,
%U A401836 227,231,236,243,248,255,263,272,275,276,279,287,288,300,308,312,323
%N A401836 Numbers k such that two distinct numbers can be removed from 1 through k so that the sum of their squares equals the sum of the remaining numbers.
%C A401836 Let T(k) = k*(k+1)/2. We seek two distinct integers 1 <= a < b <= k such that a^2+b^2 = T(k)-a-b. This condition is equivalent to a*(a+1)+b*(b+1) = T(k), or (2a+1)^2+(2b+1)^2 = 2*(k^2+k+1).
%C A401836 Thus the problem is related to representations of k^2+k+1 as a sum of two squares, excluding the case a=0. Every term satisfies k == 0, 3, 8, or 11 (mod 12).
%C A401836 The sequence is infinite: for every m >= 3, k = m^2-1 is a term, with a = (m^2-m-2)/2 and b = (m^2+m-2)/2.
%C A401836 For fixed a, the equation becomes the generalized Pell equation (2*k+1)^2 - 2*(2*b+1)^2 = 8*a*(a+1)-1.
%H A401836 Pieter Post, <a href="/A401836/b401836.txt">Table of n, a(n) for n = 1..200</a>
%e A401836 For k=12, removing 2 and 8 leaves 78 - 2 - 8 = 68 = 2^2 + 8^2.
%e A401836 For k=35, there are two solutions: (a,b) = (5,24) and (14,20).
%e A401836 For k=48, k^2+k+1 = 2353 = 13*181, and 2*2353 = 35^2+59^2 = 41^2+55^2, giving the two solutions (17,29) and (20,27).
%e A401836 For k=2304, k^2+k+1 = 13*37*61*181, giving eight distinct solutions.
%o A401836 (Python)
%o A401836 from math import isqrt
%o A401836 def ok(k):
%o A401836     t = k*(k+1)//2
%o A401836     for a in range(1, k):
%o A401836         q = t - a*(a+1)
%o A401836         if q <= 0:
%o A401836             break
%o A401836         d = isqrt(4*q + 1)
%o A401836         if d*d == 4*q + 1:
%o A401836             b = (d-1)//2
%o A401836             if a < b <= k:
%o A401836                 return True
%o A401836     return False
%o A401836 print([k for k in range(1, 1000) if ok(k)])
%o A401836 (PARI) isok(k) = for (x=1, k, for (y=x+1, k, if (x^2+y^2 == k*(k+1)/2-x-y, return(1)););); \\ _Michel Marcus_, Nov 09 2026
