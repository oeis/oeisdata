%T A401026 1,6,3,3,6,6,0,7,9,6,3,4,5,4,8,1,6,4,9,0,2,7,8,6,6,6,0,4,5,4,1,0,4,1,
%U A401026 4,7,6,6,5,7,4,2,3,6,6,9,8,3,0,7,1,2,1,2,6,3,3,4,6,4,2,3,8,7,6,3,7
%N A401026 Decimal expansion of 2*Pi^2/(9*Cl_2(2*Pi/3)), where Cl_2(x) = - Integral_{u=0..x} log(2*sin(u/2)) du.
%H A401026 Mohammad F. Marashdeh, <a href="https://arxiv.org/abs/2610.10570">Partition-theoretic density formulas: radial Tauberian theory and non-radial instability</a>, arXiv:2610.10570 [math.GM], 2026. See p. 9.
%e A401026 3.2414358746552231859322809256585821633660796345481649027...
%t A401026 RealDigits[Chop[N[4*I/(1 + 18 PolyLog[2, (-1)^(2/3)]/Pi^2), 110]], 10, 105][[1]] (* _Vaclav Kotesovec_, Oct 19 2026 *)
%o A401026 (PARI)
%o A401026 default(realprecision, 150);
%o A401026 xx = 2*Pi/3;
%o A401026 g(t) = if(t == 0, 0, log(sin(xx*t/2)/(xx*t/2)));
%o A401026 c2 = xx*(1 - log(xx)) - xx*intnum(t = 0, 1, g(t));
%o A401026 v = 2*Pi^2/(9*c2);
%o A401026 print(v);
%o A401026 print(digits(floor(v*10^100)));
%Y A401026 Cf. A019693, A164102.
%K A401026 nonn,cons,new
%O A401026 1,1
%A A401026 _Stefano Spezia_, Oct 14 2026
