%N A401660 a(0) = 1; a(n) = Sum_{k=1..n} binomial(4*n+k-1,k) * a(n-k).
%F A401660 G.f. A(x) satisfies A(x) = (1-5*x)/(1-x) * (2*A(x*(1-x)^4) - 1).
%F A401660 4|a(n) for n > 0.
%F A401660 a(n) ~ c * n! * n^(5*log(2)/8) * 4^n / log(2)^n, where c = 0.889541701397142455959631826047838588431131772000960302906671173085... - _Vaclav Kotesovec_, Nov 01 2026
%o A401660 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(4*i+j-1, j)*v[i-j+1])); v;
