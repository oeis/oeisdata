%I A401426 #7 Oct 24 2026 09:51:55
%S A401426 1,3,4,1,6,12,8,11,1,18,12,4,14,24,24,1,18,3,20,6,32,36,24,44,1,42,31,
%T A401426 8,30,72,32,3,48,54,48,1,38,60,56,66,42,96,44,12,6,72,48,4,1,3,72,14,
%U A401426 54,93,72,88,80,90,60,24,62,96,8,1,84,144,68,18,96,144,72
%N A401426 The sum of infinitary divisors of n that are numbers whose number of divisors is a power of 2.
%C A401426 First differs from A368471 and A390370 at n = 32.
%C A401426 The number of these divisors is A392628(n), and the largest of them is A401425(n).
%H A401426 Amiram Eldar, <a href="/A401426/b401426.txt">Table of n, a(n) for n = 1..10000</a>
%F A401426 Multiplicative with a(p^e) = Sum_{k=0..A007814(e+1)} p^(2^k-1).
%F A401426 a(n) = 1 if and only if n is a square.
%F A401426 a(n) = 3 if and only if n is of the form 2^(4*k+1) * m^2, where m is odd and k >= 0.
%F A401426 a(n) <= A049417(n), with equality if and only if n is squarefree (A005117).
%F A401426 Sum_{k=1..n} a(k) ~ n^2 / 2.
%t A401426 f[p_, e_] := Sum[p^(2^k - 1), {k, 0, IntegerExponent[e+1, 2]}]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 72]
%o A401426 (PARI) a(n) = vecprod([sum(k = 0, valuation(f[2]+1, 2), f[1]^((1 << k) - 1)) | f<-factor(n)~]);
%Y A401426 Cf. A005117, A007814, A036537, A049417, A077609, A368471, A390370, A392628, A401425.
%K A401426 nonn,mult,easy,new
%O A401426 1,2
%A A401426 _Amiram Eldar_, Oct 24 2026
