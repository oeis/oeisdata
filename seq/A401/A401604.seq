%S A401604 0,1,2,15,136,1705,24456,448399,9207248,222374961,6007553200,
%T A401604 182212921231,6082661600808,222934032455017,8866733941021880,
%U A401604 381167156078509935,17592826398372134176,868193525562404615521,45603517998581895796704,2540806066365622066315279,149644692658766637157475000
%N A401604 E.g.f. A(x) satisfies: A(x) = x * exp(A(x) + A(x^2) + A(x^3) + A(x^4) + ... ).
%H A401604 Vaclav Kotesovec, <a href="/A401604/b401604.txt">Table of n, a(n) for n = 0..377</a>
%F A401604 a(n) ~ c * n! * d^n / n^(3/2), where d = 3.183225957963402051227728... and c = 0.47550056622621525812424...
%t A401604 nmax = 20; A[_] = 0; Do[A[x_] = x Exp[Sum[A[x^k], {k, 1, nmax}]] + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x] Range[0, nmax]!
%t A401604 (* Alternative: *)
%t A401604 a[0] = 0; a[1] = 1; a[n_] := a[n] = n!/(n - 1) Sum[k a[j] a[n - j k]/((j - 1)! (n - j k)!), {k, 1, n - 1}, {j, 1, Floor[(n - 1)/k]}]; Table[a[n], {n, 0, 20}]  (* _Ilya Gutkovskiy_, Oct 30 2026 *)
%Y A401604 Cf. A401563.
%K A401604 nonn,new
%O A401604 0,3
%A A401604 _Vaclav Kotesovec_, Oct 30 2026
