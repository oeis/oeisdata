%I A401680 #17 Nov 16 2026 21:42:01
%S A401680 1,0,1,1,1,2,2,1,1,3,4,3,1,1,2,5,4,4,4,3,3,3,4,5,6,7,7,8,8,7,5,3,3,4,
%T A401680 5,5,8,10,11,10,11,11,10,9,9,10,8,7,7,7,8,6,6,8,9,11,13,14,15,17,17,
%U A401680 16,17,17,18,18,18,19,18,17,15,11,10,9,9,7,6,7,8
%N A401680 a(1) = 1; for n > 1, a(n) is the number of k < n such that a(k) < n - k <= 3*a(k).
%C A401680 Each term a(k) defines the interval of positions n with k + a(k) < n <= k + 3*a(k); a(n) is the number of earlier terms whose interval contains n.
%C A401680 The initial value a(1) = 1 is part of the definition (the rule would give 0 for n = 1, and with a(1) = 0 all terms would be 0).
%C A401680 Replacing the condition a(k) < n-k <= 3*a(k) by 0 < n-k <= 2*a(k) gives A006949(n) for n >= 1 (checked for n <= 10^6; A006949 has offset 0 with a(0) = 1).
%C A401680 Replacing the multiplier 3 by 1 or by 2 gives 1, 0, 0, 0, ... or 1, 0, 1, 0, 1, 0, ... respectively, so 3 is the smallest interesting integer multiplier.
%C A401680 a(n) > 0 for 3 <= n <= 3*10^7 (a(2) = 0 is the only zero in this range).
%C A401680 For 3000 <= n <= 3*10^7, 0.0851 < a(n)/n < 0.2890.
%H A401680 Sajid Khan Hussain, <a href="/A401680/b401680.txt">Table of n, a(n) for n = 1..10000</a>
%F A401680 a(n) = #{k < n : k + a(k) < n} - #{k < n : k + 3*a(k) < n}.
%F A401680 a(n+1) - a(n) = #{k <= n : k + a(k) = n} - #{k <= n : k + 3*a(k) = n} for n >= 2.
%e A401680 a(6) = 2, since the intervals (4, 6] of k = 3 and (5, 7] of k = 4 contain 6 (and no other interval does).
%o A401680 (Python)
%o A401680 def A_list(nmax):
%o A401680     a = [1]
%o A401680     d = [0]*(nmax + 4)
%o A401680     def add(k, x):
%o A401680         s, e = k + x + 1, k + 3*x
%o A401680         if s <= e and s <= nmax:
%o A401680             d[s] += 1
%o A401680             d[min(e, nmax) + 1] -= 1
%o A401680     add(1, 1)
%o A401680     run = d[1]
%o A401680     for n in range(2, nmax + 1):
%o A401680         run += d[n]
%o A401680         a.append(run)
%o A401680         add(n, run)
%o A401680     return a
%Y A401680 Cf. A006949.
%K A401680 nonn,easy,new
%O A401680 1,6
%A A401680 _Sajid Khan Hussain_, Nov 02 2026
