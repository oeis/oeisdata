%N A401069 Numbers k such that A276085(k) is not squarefree, where A276085 is fully additive with a(p) = p#/p.
%H A401069 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401069 {k such that A008966(A276085(k)) = 0}.
%o A401069 (PARI)
%o A401069 A276085(n) = { my(f = factor(n)); sum(k=1, #f~, f[k, 2]*prod(i=1,primepi(f[k, 1]-1),prime(i))); };
%o A401069 is_A401069(k) = !issquarefree(A276085(k));
%Y A401069 Cf. A008966, A013929, A276085, A401068 (complement).
%Y A401069 Subsequences: A001248\{4}, A369002, A377872, A377873, A377878.
