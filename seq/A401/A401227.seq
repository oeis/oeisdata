%I A401227 #21 Oct 21 2026 16:53:48
%S A401227 3,7,19,19,11,13,19,23,29,29,31,37,41,43,53,53,61,67,67,71,73,83,83,
%T A401227 89,97,101,103,107,109,113,127,131,137,139,149,151,157,163,167,173,
%U A401227 179,181,191,193,197,199,211,223,227,229,233,239,241,251,257,263,269,271,277,281,283,293,307,311,313,317,331,337,347
%N A401227 The least prime p >= prime(n+1) such that prime(n)# + p is composite, where prime(n)# = A002110(n), the n-th primorial.
%H A401227 Paolo Xausa, <a href="/A401227/b401227.txt">Table of n, a(n) for n = 0..1000</a>
%H A401227 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401227 If n>0 is not in A035346, then a(n) = prime(n+1) = A000040(n+1).
%t A401227 A401227[n_] := With[{pr = Times @@ Prime[Range[n]]}, NestWhile[NextPrime, Prime[n + 1], PrimeQ[pr + #] &]];
%t A401227 Array[A401227, 70, 0] (* _Paolo Xausa_, Oct 21 2026 *)
%o A401227 (PARI)
%o A401227 A002110(n) = prod(i=1,n,prime(i));
%o A401227 A401227(n) = { my(b=A002110(n)); forprime(p=prime(1+n),,if(!isprime(b+p), return(p))); };
%Y A401227 Cf. A000040, A002110, A005235, A035346, A038771.
%K A401227 nonn,new
%O A401227 0,1
%A A401227 _Antti Karttunen_, Oct 18 2026
