%T A401282 373769787055611,51334810638419683,8308637307397840999,
%U A401282 1565006511667785286647,339395070564431541949591,83956180216113975027472441,23497192425181337744396744073,7387008404909469891237689375539
%N A401282 Number of binary matrices with n rows, all column sums 2 and row sums at most 2.
%C A401282 The number of columns in the matrices will be at most n. Zero columns is also allowed.
%H A401282 Andrew Howroyd, <a href="/A401282/b401282.txt">Table of n, a(n) for n = 0..200</a>
%e A401282 The a(2) = 3 matrices can have 0, 1 or 2 columns:
%e A401282    []  [1]  [1 1]
%e A401282    []  [1]  [1 1]
%e A401282 The a(3) = 19 matrices (shown up to row permutation with counts below):
%e A401282    []  [1]  [1 1]  [1 1]  [1 1 0]
%e A401282    []  [1]  [1 1]  [1 0]  [1 0 1]
%e A401282    []  [0]  [0 0]  [0 1]  [0 1 1]
%e A401282    (1) (3)   (3)    (6)    (6)
%o A401282 (PARI) seq(n) = [subst(serlaplace(p),y,1) | p<-Vec(serlaplace( sqrt(exp(x - x*y + x/(1-x*y) + O(x*x^n))/(1-x*y)) ))]
%Y A401282 Row sums of A401281.
%K A401282 nonn,new
%O A401282 0,3
%A A401282 _Andrew Howroyd_, Oct 21 2026
