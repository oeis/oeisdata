%T A401121 958003200,16365888000,147891744000,3451812249600,41845579776000,
%U A401121 887063522881536,12804747411456000,303418254851712000,3998237918298624000,131619998642356224000,2248001455555215360000
%N A401121 Weighted evaluation of the cycle index of the cyclic group C_n, where each cycle of length d contributes weight w(1) = 1 and w(d) = 1/(d-1) for d >= 2.
%H A401121 Alois P. Heinz, <a href="/A401121/b401121.txt">Table of n, a(n) for n = 0..450</a>
%H A401121 Nicolae Boicu, <a href="https://math.stackexchange.com/questions/5151990/wreathed-permutations">Wreathed Permutations</a>, Mathematics StackExchange.
%F A401121 a(n) = n!*(Z(C_n)(1, 1, 1/2, 1/3, 1/4...)), where Z(C_n) is the cycle index of C_n.
%e A401121 For n=4, 4!*Z(C_4) = 6*((a_1)^4 + (a_2)^2 + 2*(a_4)) = 16.
%p A401121 a:= proc(n) uses numtheory; `if`(n=0, 1, (n-1)!*
%p A401121       add(phi(d)/max(1, d-1)^(n/d), d=divisors(n)))
%p A401121     end:
%p A401121 seq(a(n), n=0..23);  # _Alois P. Heinz_, Oct 15 2026
%o A401121 (PARI) a(n)= if (n==0, 1, my(d=divisors(n), v = vector(n, i, if (i==1, 1, 1/(i-1)))); n!*vecsum(vector(#d, k, eulerphi(d[k])*v[d[k]]^(n/d[k])))/n); \\ _Michel Marcus_, Oct 16 2026
%Y A401121 Cf. A399636.
%K A401121 nonn,changed
%O A401121 0,3
