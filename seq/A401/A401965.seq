%T A401965 94,65,412,106,3824,87,118,77,508,85,134,261,142,91,604,245,158,123,
%U A401965 166,49,5872,115,5764,141,764,119,369,202,206,159,214,133,325,145,7664
%N A401965 a(n) is the smallest number k such that 2*(k+n) = sigma(k) + n*tau(k).
%C A401965 Second row of A398713.
%C A401965 Same as with A398713, it's unknown if a(n) always exists.
%H A401965 Žiga Pirc, <a href="/A401965/b401965.txt">Table of n, a(n) for n = 0..500</a>
%e A401965 a(2) is 14, since sigma(14) + 2*tau(14) = 24 + 8 = 32 = 2*(14+2).
%o A401965 (PARI) A401965(n) = my(k=1); while(2*(k+n) != sigma(k) + n*numdiv(k), k++); return(k);
%Y A401965 Cf. A398713, A000005, A000203, A397899.
%K A401965 nonn,new
%O A401965 0,1
