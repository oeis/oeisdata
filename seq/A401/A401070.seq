%I A401070 #17 Oct 30 2026 21:10:14
%S A401070 1,2,3,5,6,7,8,10,11,13,14,15,17,19,21,22,23,24,26,27,28,29,30,31,32,
%T A401070 33,34,35,37,38,39,40,41,42,43,46,47,51,53,54,55,56,57,58,59,61,62,65,
%U A401070 66,67,69,70,71,73,74,77,78,79,82,83,84,85,86,87,88,89,91,93,94,95,96,97
%N A401070 Numbers that are divisible by the sum of the divisors of their largest unitary divisor that is a square.
%C A401070 It seems that for all k in this sequence, listing those k for which k/A351568(k) divides A351569(k) gives exactly the multi-perfect numbers, A007691.
%H A401070 Antti Karttunen, <a href="/A401070/b401070.txt">Table of n, a(n) for n = 1..10000</a>
%H A401070 <a href="/index/O#opnseqs">Index entries for sequences where odd perfect numbers must occur, if they exist at all</a>.
%F A401070 {k such that k == 0 mod A351568(k)}.
%o A401070 (PARI)
%o A401070 A350388(n) = { my(m=1, f=factor(n)); for(k=1, #f~, if(0==(f[k, 2]%2), m *= (f[k, 1]^f[k, 2]))); (m); };
%o A401070 A351568(n) = sigma(A350388(n));
%o A401070 is_A401070(k) = !(k%A351568(k));
%Y A401070 Cf. A350388, A351568, A351569, A401071 (complement).
%Y A401070 Subsequences: A000396, A005117, A007691 (conjectured), A268335, A401067.
%K A401070 nonn,new
%O A401070 1,2
%A A401070 _Antti Karttunen_, Oct 30 2026
