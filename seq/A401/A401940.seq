%S A401940 1,0,1,0,1,1,0,2,2,1,0,5,5,3,1,0,14,14,9,4,1,0,41,42,28,14,5,1,0,122,
%T A401940 130,90,48,20,6,1,0,365,407,294,165,75,27,7,1,0,1094,1278,965,568,275,
%U A401940 110,35,8,1,0,3281,4012,3165,1950,996,429,154,44,9,1,0,9842,12578,10350,6660,3570,1632,637,208,54,10,1
%N A401940 Riordan array (1,x*(1-3*x+x^2)/(1-4*x+3*x^2)).
%C A401940 T(n,k) is also the number of Dyck paths of semilength n, height at most 5 and k returns.
%H A401940 M. Bousquet-Mélou, <a href="https://www.mat.univie.ac.at/~slc/wpapers/s57bousquet.html">Discrete excursions</a>, Sém. Lothar. Combin., 57:B57d, 2008.
%F A401940 G.f.: (1-4*x+3*x^2)/(1-4*x+3*x^2-x*y*(1-3*x+x^2)).
%F A401940 Sum_{k=0..n} (-1)^k * T(n,k) = A122100(n). - _Alois P. Heinz_, Nov 09 2026
%e A401940 Triangle T(n,k) begins:
%e A401940   1;
%e A401940   0,   1;
%e A401940   0,   1,   1;
%e A401940   0,   2,   2,   1;
%e A401940   0,   5,   5,   3,   1;
%e A401940   0,  14,  14,   9,   4,   1;
%e A401940   0,  41,  42,  28,  14,   5,   1;
%e A401940   0, 122, 130,  90,  48,  20,   6,   1;
%e A401940   ...
%e A401940 T(5,4) = 4, since there are only 4 Dyck paths of semilength 4 and 4 returns: UUDDUDUDUD, UDUUDDUDUD, UDUDUUDDUD and UDUDUDUUDD (all are of height 2).
%p A401940 b:= proc(x, y) option remember; expand(`if`(y>x or y<0, 0,
%p A401940       `if`(x=0, 1, b(x-1, y-1)*`if`(y=1, z, 1)+`if`(y<5, b(x-1,y+1), 0))))
%p A401940     end:
%p A401940 T:= (n,k)-> coeff(b(2*n, 0), z, k):
%p A401940 seq(seq(T(n,k), k=0..n), n=0..11);  # _Alois P. Heinz_, Nov 09 2026
%o A401940 (Python)
%o A401940 import sympy as sym
%o A401940 x = sym.symbols('x')
%o A401940 def generate_matrix(k_range, n_range):
%o A401940    N = max(max(k_range), max(n_range)) + 1
%o A401940    elements = []
%o A401940    for k in k_range:
%o A401940       series = sym.series(((x*(1-3*x+x**2))/(1-4*x+3*x**2))**k,x,n=N)
%o A401940       elements.append([series.coeff(x,n) for n in n_range])
%o A401940    mat = sym.ImmutableDenseMatrix(elements).T
%o A401940    return mat
%o A401940 riordan = generate_matrix(range(n), range(n))
%o A401940 print(riordan)
%Y A401940 Columns k=0-1 give: A000007, A124302.
%Y A401940 Cf. A000012 (diagonal), A080937 (row sums), A122100, A147746.
%K A401940 nonn,tabl,new
%O A401940 0,8
%A A401940 _Narciso Gonzaga, Jr._, Nov 09 2026
