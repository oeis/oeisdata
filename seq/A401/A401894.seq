%S A401894 0,1,1,2,4,4,9,6,11,10,25,10,36,20,24,22,64,25,81,28,51,52,121,31,108,
%T A401894 74,102,58,196,51,225,86,139,130,167,72,324,164,198,100,400,106,441,
%U A401894 154,203,244,529,120,459,219,352,220,676,208,449,210,443,394,841
%N A401894 Number of doubly shaded cells in the n X n grid obtained by shading according to the additive orders in the group Z/nZ, using the same horizontal/vertical rule as in A395245.
%C A401894 Consider the n X n grid with rows and columns indexed by {1,2,...,n}.
%C A401894 For each i in {1,...,n} let ord(i) = n / gcd(i,n) (the additive order of i in Z/nZ; note that ord(n) = 1).
%C A401894 For every odd index i shade the cells (i,k) for 1 <= k <= ord(i) (horizontal shading).
%C A401894 For every even index j shade the cells (k,j) for 1 <= k <= ord(j) (vertical shading).
%C A401894 a(n) is the number of cells that receive both shadings, i.e. the number of pairs (i,j) with i odd, j even, 1 <= i,j <= n, j <= ord(i) and i <= ord(j).
%C A401894 If p is an odd prime then a(p) = ((p-1)/2)^2.
%F A401894 a(n) = #{(i,j) : 1 <= i <= n odd, 1 <= j <= n even, j <= n/gcd(i,n), i <= n/gcd(j,n)}.
%F A401894 a(p) = ((p-1)/2)^2 for every odd prime p.
%e A401894 For n = 5 the orders are all equal to 5 except ord(5)=1. The four pairs (1,2),(1,4),(3,2),(3,4) are doubly shaded, so a(5)=4.
%e A401894 For n = 6 the orders are ord(1)=6, ord(2)=3, ord(3)=2, ord(4)=3, ord(5)=6, ord(6)=1. The four pairs (1,2),(1,4),(1,6),(3,2) satisfy the conditions, so a(6)=4.
%o A401894 (Python)
%o A401894 from math import gcd
%o A401894 def a(n):
%o A401894     c = 0
%o A401894     for i in range(1, n+1, 2):
%o A401894         oi = n // gcd(i, n)
%o A401894         for j in range(2, n+1, 2):
%o A401894             if j <= oi and i <= n // gcd(j, n):
%o A401894                 c += 1
%o A401894     return c
%Y A401894 Cf. A395245, A397145, A397137, A398003.
%K A401894 nonn,new
%O A401894 1,4
