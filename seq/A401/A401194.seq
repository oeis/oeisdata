%I A401194 #7 Oct 29 2026 17:31:53
%S A401194 0,1,2,5,7,13,23,29,31,37,47,53,61,71,74,79,101,103,109,122,127,149,
%T A401194 151,157,167,173,181,191,197,199,218,223,229,239,263,269,271,277,293,
%U A401194 311,314,317,349,359,362,367,373,383,389,397,421,431,439,458,461,463,479
%N A401194 Nonnegative integers that do not occur as the largest incircle tangent length of a Heronian triangle.
%C A401194 Nonnegative integers t for which A401193(t) = 0.
%C A401194 Every positive term is squarefree, and every positive divisor of a positive term is a term, since A401193(d) <= A401193(t) for d | t and A401193(p^2) > 0 for every prime p: the tangent lengths (p^2, 2*p + 2, 2*p + 2) work for odd p, and (4, 4, 1) for p = 2.
%C A401194 For primes p >= 5, p is a term iff p is in A003628. The prime 2 is a term, 3 is not.
%C A401194 Conjecture: Every composite term is twice a prime in A139530. In particular, A401193(p*q) > 0 for all distinct primes p, q in A003628. The conjectural characterization in the formula section agrees with exact computation for all integers t from 0 to 33003.
%C A401194 There are infinitely many composite terms: if p is prime with p == 61 or 109 (mod 120), then p == 13 (mod 24) and p == 1 or 4 (mod 5), but p = 2*x^2 + 5*y^2 forces p == 0, 2 or 3 (mod 5); hence A401193(2*p) = 0 by the formula in A401193. By Dirichlet's theorem there are infinitely many such primes.
%C A401194 For p in A139530, membership in A106889 alone does not imply A401193(2*p) > 0; the additional bounds in the formula section must also be satisfied.
%H A401194 Felix Huber, <a href="/A401194/b401194.txt">Table of n, a(n) for n = 1..2000</a>
%H A401194 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/HeronianTriangle.html">Heronian Triangle</a>.
%F A401194 a(1) = 0; a(n) = min{t > a(n-1) : A401193(t) = 0} for n >= 2.
%F A401194 Conjecture: a(n) is the n-th smallest element of {0, 1, 2} union A003628 union {2*p : p in A139530, and there are no positive integers x, y satisfying p = 2*x^2 + 5*y^2 and 5*y^2 <= 4*x^2 <= 20*y^2}.
%e A401194 a(15) = 74, the first composite term, since A401193(74) = 0; here 74 = 2*37 with 37 == 13 (mod 24), and the only representation 37 = 2*4^2 + 5*1^2 violates 4*x^2 <= 20*y^2 (64 > 20).
%e A401194 26 is not a term, since A401193(26) = 1, although 26 = 2*13; here 13 = 2*2^2 + 5*1^2 satisfies 5*y^2 <= 4*x^2 <= 20*y^2 (5 <= 16 <= 20).
%p A401194 isA401194 := proc(t)
%p A401194     local k, m;
%p A401194     for k to t do
%p A401194         for m to k do
%p A401194             if issqr(t*k*m*(t + k + m)) then return false end if
%p A401194         end do
%p A401194     end do;
%p A401194     true
%p A401194 end proc:
%p A401194 A401194List := N -> select(isA401194, [$0 .. N]):
%p A401194 A401194List(479);
%o A401194 (Python)
%o A401194 from math import isqrt
%o A401194 def is_term(t):
%o A401194     return not any(
%o A401194         isqrt(q := t*k*m*(t + k + m))**2 == q
%o A401194         for k in range(1, t + 1)
%o A401194         for m in range(1, k + 1)
%o A401194     )
%o A401194 print([t for t in range(480) if is_term(t)])
%Y A401194 Cf. A003628, A045355, A106889, A139530, A400806, A401193.
%K A401194 nonn,new
%O A401194 1,3
