%S A401164 1,2,4,1,8,6,2,16,24,19,7,1,32,80,110,90,46,14,2,64,240,500,675,637,
%T A401164 429,203,64,12,1,128,672,1960,3850,5544,6076,5142,3360,1674,618,160,
%U A401164 26,2,256,1792,6944,18480,36953,58030,73277,75314,63284,43386,24067,10636,3653,938,169,19,1
%N A401164 Irregular triangular array read by rows. Let S_n be the set of labeled graphs G on [n] with 2-colored nodes where black nodes are only connected to white nodes and vice versa. Orient the edges in each such graph G from black to white. T(n,k) is the number of graphs in S_n containing no descents and k edges, n>=0, 0<=k<=A002620(n).
%C A401164 A descent in a labeled directed graph is an edge s->t such that s>t.
%H A401164 Kassie Archer, Ira M. Gessel, Christina Graves, and Xuming Liang, <a href="https://arxiv.org/abs/1909.01550">Counting acyclic and strong digraphs by descents</a>, arXiv:1909.01550 [math.CO], 20 Mar 2020.
%F A401164 Sum_{k>=0} Sum_{n>=0} T(n,k)*y^k*z^n/B(n) = e[z]^2 where e[z] = Sum_{n>=0} z^n/B(n) and B(n) = Product_{i=1..n} Sum_{j=0..i-1} (1+y)^j.
%F A401164 T(n,0) = 2^n.
%e A401164 Triangle begins ...
%e A401164   1;
%e A401164   2;
%e A401164   4,   1;
%e A401164   8,   6,   2;
%e A401164  16,  24,  19,   7,   1;
%e A401164  32,  80, 110,  90,  46,  14,   2;
%e A401164  64, 240, 500, 675, 637, 429, 203, 64, 12, 1; ...
%t A401164 nn = 8; B[n_] := FunctionExpand[QFactorial[n, (1 + y)]];e[z_] := Sum[z^n/B[n], {n, 0, nn}];Map[CoefficientList[#, y] &,Table[B[n], {n, 0,nn}]CoefficientList[Series[e[z]^2, {z, 0, nn}],z]] // Grid
%Y A401164 Cf. A381058, A047863, A006116 (row sums).
%K A401164 nonn,tabf,new
%O A401164 0,2
%A A401164 _Geoffrey Critzer_, Oct 16 2026
