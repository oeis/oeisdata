%N A401082 Decimal expansion of -Sum_{n>=1} lambda(n)*(n^(1/n) - 1), where lambda is the Liouville function.
%C A401082 The Liouville analog of the MRB constant A037077. Converges conditionally (prime number theorem: Sum_{n>=1} lambda(n)*log(n)/n = -zeta(2)).
%F A401082 Equals Pi^2/6 - Sum_{k>=2} ((-1)^k/k!) * (d^k/ds^k) (zeta(2*s)/zeta(s)) at s = k.
%F A401082 Equals Pi^2/6 - Sum_{n>=1} lambda(n)*(n^(1/n) - 1 - log(n)/n).
%e A401082 1.814026406304996479568394901791928279393194674964694473937013433289895581602974628842934997...
%o A401082 (PARI) \p 130
%o A401082 S(k) = k + x + O(x^(k+1));
%o A401082 -(-zeta(2) + sum(k = 2, 80, (-1)^k * polcoef(zeta(2*S(k))/zeta(S(k)), k)))
%Y A401082 Cf. A008836, A013661, A037077, A400904.
%K A401082 nonn,cons,new
%O A401082 1,2
