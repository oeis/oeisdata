%T A401342 66523,132669,264728,528469,1055341,2108098,4212015,8417265,16823584,
%U A401342 33629457,67230257,134414146,268753267,537385141,1074573864,2148829917,4297145605,8593459170,17185572071
%N A401342 Expansion of g.f. x*(1 - 2*x + x^2 - x^3)/((1 - x - x^2)*(1 - 2*x)).
%H A401342 Jiahao Zhang, Sergey Kitaev, Artem Pyatkin, and Xinyu Su, <a href="https://doi.org/10.1016/j.disc.2026.115472">Equidistribution of mesh patterns of short length on layered permutations</a>, Discrete Mathematics, Volume 350, Issue 2, 2027, 115472. See p. 5.
%H A401342 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (3,-1,-2).
%F A401342 a(n) = (5*4^n + 2*(1 + sqrt(5))^n*(3*sqrt(5) - 5) - 2*(1 - sqrt(5))^n*(5 + 3*sqrt(5)))/(5*2^(n+2)) for n > 1.
%F A401342 E.g.f.: (15 + 5*exp(2*x) - 10*x - 4*exp(x/2)*(5*cosh(sqrt(5)*x/2) - 3*sqrt(5)*sinh(sqrt(5)*x/2)))/20.
%p A401342 series(x*(1-2*x+x^2-x^3)/((1-x-x^2)*(1-2*x)), x, 37):
%p A401342 gfun[seriestolist](%)[];  # _Alois P. Heinz_, Oct 21 2026
%t A401342 CoefficientList[Series[x*(1-2x+x^2-x^3)/((1-x-x^2)(1-2x)),{x,0,36}],x]
%t A401342 (* Alternative: *)
%t A401342 a[n_]:=(5*4^n + 2*(1 + Sqrt[5])^n*(3*Sqrt[5]-5)-2*(1-Sqrt[5])^n*(5+3*Sqrt[5]))/(5*2^(n+2)); Join[{0,1},Array[a,35,2]]//Simplify
%t A401342 (* Alternative: *)
%t A401342 nmax=36; CoefficientList[Series[(15 + 5*Exp[2*x] - 10*x - 4*Exp[x/2]*(5*Cosh[Sqrt[5]*x/2] - 3*Sqrt[5]*Sinh[Sqrt[5]*x/2]))/20,{x,0,nmax}],x]*Range[0,nmax]!
%K A401342 nonn,easy,new
%O A401342 0,4
%A A401342 _Stefano Spezia_, Oct 21 2026
