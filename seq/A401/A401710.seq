%I A401710 #17 Nov 03 2026 19:43:43
%S A401710 1,1,1,1,1,2,1,1,1,1,1,1,1,4,1,1,1,1,1,1,1,2,1,1,1,1,1,2,1,12,1,1,1,1,
%T A401710 1,1,1,2,1,1,1,16,1,1,1,4,1,1,1,1,3,1,1,4,1,1,1,1,1,2,1,16,1,1,1,24,1,
%U A401710 1,1,8,1,1,1,1,1,1,1,4,1,1,1,1,1,8,1,2,1,1,1,1,1,2,1,8,1,3,1,1,1,1,1,36,1
%N A401710 a(n) = A017665(n)/A401375(n), where A017665(n) = sigma(n)/gcd(n,sigma(n)), A401375(n) is the largest divisor of sigma(n) coprime with n, and sigma is the sum of divisors function.
%H A401710 Antti Karttunen, <a href="/A401710/b401710.txt">Table of n, a(n) for n = 1..10000</a>
%H A401710 <a href="/index/Si#SIGMAN">Index entries for sequences related to sigma(n)</a>.
%F A401710 a(n) = A017665(n) / A401375(n).
%F A401710 a(n) = A401709(n) / A009194(n).
%e A401710 For n = 14 = 2*7, sigma(14) = (2+1)*(7+1) = 24, thus A017665(14) = 24/gcd(24,14) = 24/2 = 12. On the other hand, the greatest divisor of 24 that is relatively prime with 14 is A401375(24) = 3, therefore a(14) = 12/3 = 4.
%e A401710 For n = 36 = 2^2 * 3^2, sigma(36) = (4+2+1)*(9+3+1) = 7*13 = 91, thus A017665(36) = 91/gcd(36,91) = 91, while the greatest divisor of 91 that is relatively prime with 36 is also 91, therefore a(36) = 91/91 = 1.
%e A401710 For n = 51 = 3*17, sigma(51) = (3+1)*(17+1) = 72, thus A017665(51) = 72/gcd(51,72) = 72/3 = 24. On the other hand, the greatest divisor of 72 that is relatively prime with 51 is A401375(51) = 8, therefore a(51) = 24/8 = 3.
%e A401710 For n = 6125625 = 3^4 * 5^4 * 11^2, sigma(6125625) = 12568633 = 7 * 11^3 * 19 * 71, thus A017665(6125625) = 12568633/gcd(6125625,12568633) = 12568633/121 = 7*11*19*71 = 103873, while the greatest divisor of 12568633 that is relatively prime with 6125625 is 9443 = 7*19*71, therefore a(n) = 11.
%e A401710 For n = 173369889 = (3*3*7*11*19)^2, sigma(n) = 349491681 = 3^2 * 7 * 11^2 * 19^2 * 127, thus A017665(n) = 349491681/2751903 = 127, while the greatest divisor of 349491681 that is relatively prime with 173369889 is also 127, thus a(173369889) = 1.
%e A401710 For n = 53251562169 = (3*13*61*97)^2, sigma(n) = 85560689799 = 3^3 * 13^2 * 61 * 97 * 3169, thus A017665(n) = 9507 = 3*3169, while the greatest divisor of 85560689799 that is relatively prime with 53251562169 is 3169, therefore a(n) = 3.
%o A401710 (PARI) A401710(n) = { my(s=sigma(n)); fordiv(s,d,if(1==gcd(s/d,n), return(d/gcd(n,s)))); };
%Y A401710 Cf. A000203, A009194, A017665, A401375, A401709.
%Y A401710 Cf. A401711 (positions of 1's), A401712 (of terms > 1).
%K A401710 nonn,easy,new
%O A401710 1,6
%A A401710 _Antti Karttunen_, Nov 02 2026
