%o A401284 (PARI) T(n)={my(v=Vec(1/prod(k=2, n, (1 - x^k*y^k)*(1 - x^k*y^(k-1)), 1 - x + O(x*x^n)))); vector(#v,i,Vecrev(v[i],i))}
%o A401284 { my(A=T(12)); for(i=1, #A, print(A[i])) }
