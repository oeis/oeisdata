%U A401076 17451722654322017661600,1538161457186747574581400,130478129261136977886329400,10743980737220917952638672800,864454607453340183057309496320
%N A401076 Number of n X n {0,1}-matrices of rank 4 over the real numbers.
%C A401076 Also the number of n X n {0,1}-matrices of rank 4 over the rationals.
%C A401076 Every 4-dimensional subspace V of R^n spanned by binary vectors intersects {0,1}^n \ {0} in k in {4..15} nonzero binary vectors and belongs to one of 32 linear matroid isomorphism types, yielding an exact closed-form linear combination of exponential terms k^n for 1 <= k <= 16.
%C A401076 Terms a(4)..a(8) were computed by Živković (2005), Table 1.
%H A401076 Firdous Ahmad Mala, <a href="/A401076/b401076.txt">Table of n, a(n) for n = 0..100</a>
%H A401076 Miodrag Živković, <a href="https://arxiv.org/abs/math/0511636">Classification of small (0,1) matrices</a>, arXiv:math/0511636 [math.CO], 2005; see Table 3, p. 19; Linear Algebra and its Applications, 414 (2006), 310-346, see Table 3, p. 324.
%H A401076 <a href="/index/Rec#order_39">Index entries for linear recurrences with constant coefficients</a>, order 39.
%F A401076 a(n) = (2*80^n + 27*72^n + 35*70^n + 32*64^n - 21*63^n - 296*60^n - 756*56^n - 63*54^n + 505*50^n + 1568*49^n + 2556*48^n + 315*45^n - 6132*42^n - 4590*40^n + 3264*36^n + 7140*35^n + 3888*32^n - 5569*30^n - 5264*28^n + 441*27^n + 1005*25^n + 348*24^n + 2436*21^n + 940*20^n - 513*18^n - 602*16^n - 1740*15^n - 651*14^n + 1950*12^n + 916*10^n - 687*9^n - 1005*8^n + 77*7^n + 656*6^n - 173*5^n + 18*4^n - 113*3^n + 64*2^n - 8) / 24.
%F A401076 E.g.f.: P(exp(x)), where P(x) = x*(x - 1)^4*(2*x^75 + 8*x^74 + 20*x^73 + 40*x^72 + 70*x^71 + 112*x^70 + 168*x^69 + 240*x^68 + 357*x^67 + 548*x^66 + 877*x^65 + 1408*x^64 + 2205*x^63 + 3332*x^62 + 4853*x^61 + 6832*x^60 + 9365*x^59 + 12527*x^58 + 16393*x^57 + 21038*x^56 + 26241*x^55 + 31781*x^54 + 37437*x^53 + 42988*x^52 + 47457*x^51 + 49867*x^50 + 49178*x^49 + 44350*x^48 + 34343*x^47 + 18117*x^46 - 4863*x^45 - 33564*x^44 - 64397*x^43 - 93773*x^42 - 118103*x^41 - 133483*x^40 - 136009*x^39 - 121777*x^38 - 93015*x^37 - 51951*x^36 - 5403*x^35 + 39811*x^34 + 76873*x^33 + 98965*x^32 + 102533*x^31 + 91163*x^30 + 68441*x^29 + 37953*x^28 + 7173*x^27 - 16425*x^26 - 30936*x^25 - 34455*x^24 - 30341*x^23 - 21512*x^22 - 10886*x^21 - 376*x^20 + 8453*x^19 + 14036*x^18 + 14808*x^17 + 11640*x^16 + 6343*x^15 + 728*x^14 - 3907*x^13 - 6264*x^12 - 5647*x^11 - 3100*x^10 - 318*x^9 + 1004*x^8 + 1121*x^7 + 288*x^6 - 324*x^5 - 231*x^4 + 46*x^3 + 63*x^2 + 32*x - 8)/24. - _Jianing Song_, Nov 05 2026
%e A401076 There cannot be a 3 X 3 binary matrix of rank 4. So, a(3) = 0.
%o A401076 (Python)
%o A401076 def a(n):
%o A401076     terms = (
%o A401076         (2, 80), (27, 72), (35, 70), (32, 64), (-21, 63), (-296, 60),
%o A401076         (-756, 56), (-63, 54), (505, 50), (1568, 49), (2556, 48), (315, 45),
%o A401076         (-6132, 42), (-4590, 40), (3264, 36), (7140, 35), (3888, 32), (-5569, 30),
%o A401076         (-5264, 28), (441, 27), (1005, 25), (348, 24), (2436, 21), (940, 20),
%o A401076         (-513, 18), (-602, 16), (-1740, 15), (-651, 14), (1950, 12), (916, 10),
%o A401076         (-687, 9), (-1005, 8), (77, 7), (656, 6), (-173, 5), (18, 4),
%o A401076         (-113, 3), (64, 2), (-8, 1),
%o A401076     )
%o A401076     return sum(c * b**n for c, b in terms) // 24
%o A401076 print([a(n) for n in range(23)])
