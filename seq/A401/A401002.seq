%I A401002 #16 Oct 26 2026 23:53:54
%S A401002 5,13,17,101,113,137,149,173,181,229,241,313,353,397,401,421,449,457,
%T A401002 521,569,641,653,661,757,761,821,877,1013,1069,1097,1201,1289,1429,
%U A401002 1433,1549,1601,1693,1709,1733,1741,1777,1801,1933,2137,2221,2273,2333,2381
%N A401002 Pythagorean primes p = x^2 + y^2 with integers x > y > 0 for which one Pell-type recurrence step (x, y) -> (2*x + y, x) gives another Pythagorean prime q = (2*x + y)^2 + x^2.
%C A401002 For each term p, there are unique integers x > y > 0 such that p = x^2 + y^2. Let q = (2*x + y)^2 + x^2. The connection with the Pell numbers (A000129) is described in A401003.
%C A401002 The terms are the Pythagorean primes A002144(k) for which A401003(k) is prime, listed in increasing order of k. The corresponding primes q are also Pythagorean primes (A002144).
%C A401002 For each such p, Q = p^2*q is the square of one prime times a different prime. The construction in A401004 gives a 3 X 3 magic square with central entry Q^2 and nine distinct positive integer entries, at least six of them squares.
%H A401002 Chai Wah Wu, <a href="/A401002/b401002.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..484 from Edward Schmidt)
%H A401002 Edward Schmidt, <a href="/A401004/a401004.txt">Pythagorean primes, a Pell-type recurrence and a magic square with six squares</a>.
%H A401002 Edward Schmidt, <a href="/A400365/a400365.txt">Fourth powers of Pythagorean legs and a magic square with six squares</a>.
%F A401002 a(n) = A002144(k(n)), where k(n) is the n-th index k for which A401003(k) is prime.
%F A401002 Equivalently, the terms are the primes p = x^2 + y^2 for which 5*x^2 + 4*x*y + y^2 is prime, where x and y are integers with x > y > 0.
%e A401002 For p = 5 = 2^2 + 1^2, q = (2*2 + 1)^2 + 2^2 = 29 is prime. Thus a(1) = 5.
%e A401002 The next two Pythagorean primes, 13 = 3^2 + 2^2 and 17 = 4^2 + 1^2, give q = 8^2 + 3^2 = 73 and q = 9^2 + 4^2 = 97, both prime. Hence a(2) = 13 and a(3) = 17.
%e A401002 For p = 29 = 5^2 + 2^2, q = 12^2 + 5^2 = 169 = 13^2 is composite, so 29 is omitted.
%o A401002 (Python)
%o A401002 from math import isqrt
%o A401002 from sympy import isprime, primerange
%o A401002 def a401002(limit=2400):
%o A401002     # Return terms for hypotenuses p < limit.
%o A401002     out = []
%o A401002     for p in primerange(5, limit):
%o A401002         if p % 4 != 1:
%o A401002             continue
%o A401002         for y in range(1, isqrt(p // 2) + 1):
%o A401002             x = isqrt(p - y*y)
%o A401002             if x*x + y*y == p:
%o A401002                 q = (2*x + y)**2 + x*x
%o A401002                 if isprime(q):
%o A401002                     out.append(p)
%o A401002                 break
%o A401002     return out
%o A401002 (Python)
%o A401002 from itertools import islice
%o A401002 from sympy import isprime, nextprime
%o A401002 from sympy.solvers.diophantine.diophantine import diop_quadratic
%o A401002 def A401002_gen(): # generator of terms
%o A401002     from sympy.abc import x, y
%o A401002     p = 2
%o A401002     while True:
%o A401002         if not p&2:
%o A401002             a, b = sorted(map(abs,list(diop_quadratic(x**2+y**2-p))[0]))
%o A401002             if isprime(a*(a+(b<<2))+5*b*b):
%o A401002                 yield p
%o A401002         p = nextprime(p)
%o A401002 A401002_list = list(islice(A401002_gen(),40)) # _Chai Wah Wu_, Oct 24 2026
%Y A401002 Subsequence of A002144.
