%I A401390 #13 Nov 02 2026 10:32:16
%S A401390 1,14,39,124,155,546,399,1016,1089,2170,1463,4836,2379,798,6045,8176,
%T A401390 5219,15246,7239,19220,5187,20482,12719,39624,19525,33306,29511,49476,
%U A401390 25259,84630,30783,65504,57057,73066,61845,135036,52059,101346,2379,157480,70643,10374,81399,181412,168795,178066,106079,318864,137249
%N A401390 a(n) = n * A401375(n^2), where A401375 is the largest divisor of sigma(n) coprime with n, and sigma is the sum of divisors function.
%C A401390 If there are no odd terms (and thus no squares) in A105402 after its initial 1, then the only fixed point of this sequence is a(1) = 1.
%H A401390 Antti Karttunen, <a href="/A401390/b401390.txt">Table of n, a(n) for n = 1..10000</a>
%H A401390 <a href="/index/Si#SIGMAN">Index entries for sequences related to sigma(n)</a>.
%o A401390 (PARI)
%o A401390 A401375(n) = { my(s=sigma(n)); fordiv(s,d,if(1==gcd(s/d,n), return(s/d))); };
%o A401390 A401390(n) = (n * A401375(n^2));
%Y A401390 Cf. A105402, A401375, A401386, A401391 (number of iterations needed to reach a number that is not a prime power), A401392 (iterates starting from 3).
%K A401390 nonn,easy,new
%O A401390 1,2
%A A401390 _Antti Karttunen_, Nov 01 2026
