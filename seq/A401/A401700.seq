%I A401700 #12 Nov 16 2026 12:48:45
%S A401700 3,5,7,19,37,61,71,109,137,149,151,163,181,199,211,239,251,269,277,
%T A401700 311,479,491,587,613,647,743,761,883,919,967,977,1069,1097,1123,1151,
%U A401700 1181,1223,1321,1481,1499,1511,1531,1543,1559,1619,1709,1759,1877,1879,1907,1979,2003,2039,2111,2141,2161,2207,2297,2351
%N A401700 Primes p for which there exists a noncomposite q < p such that (p# / q#) == +1 mod r, where p# = A034386(p), and r is the least prime larger than p.
%C A401700 See comments in A401373.
%H A401700 Antti Karttunen, <a href="/A401700/b401700.txt">Table of n, a(n) for n = 1..4017</a>
%H A401700 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401700 a(n) = A000040(A401372(n)).
%F A401700 a(n) = A064989(A401373(n)).
%e A401700 With p=3 and q=1, we obtain (p# / q#) = (A034386(3) / A034386(1)) = (2*3) = 6 == +1 mod 5, where 5 is the next prime after 3, therefore 3 is included in this sequence.
%e A401700 With p=5 and q=2, we obtain (p# / q#) = (A034386(5) / A034386(2)) = (2*3*5)/(2) = (3*5) = 15 == +1 mod 7, where 7 is the next prime after 5, thus 5 is included.
%o A401700 (PARI)
%o A401700 A034386(n) = prod(i=1, primepi(n), prime(i));
%o A401700 is_A401700_on_p(p) = { my(prp=A034386(p), r=nextprime(1+p)); if(1==(prp%r), 1, forprime(q=2,p-1,if(1==((prp/A034386(q))%r), return(1))); (0)); }; \\ (reference implementation, very inefficient)
%o A401700 forprime(p=2,2351,if(is_A401700_on_p(p),print1(p,", ")));
%Y A401700 Cf. A000040, A002110, A034386, A064989, A401372, A401373.
%Y A401700 Cf. also A401701, A401702, A401703.
%K A401700 nonn,new
%O A401700 1,1
%A A401700 _Antti Karttunen_, Nov 16 2026
