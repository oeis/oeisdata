%S A401190 4,648,5184,11025,44100,2975625,11902500,23805000,190440000,428490000,
%T A401190 676350675,2705402700,8051590575,32206362300,182545666875,
%U A401190 730182667500,1460365335000,11682922680000,493940927004525,1975763708018100,146583330187100625,586333320748402500
%N A401190 Primitive terms of A401189: terms in A401189 that are powerful numbers (A001694).
%C A401190 Powerful numbers k larger than 1 that divide A400873(k).
%C A401190 The corresponding quotients are 2, 2, 2, 3, 6, 2, 4, 3, 3, 3, 3, 6, 3, 6, 2, 4, 3, 3, 3, 6, ... .
%C A401190 Analogous to primitive e-perfect numbers (A054980), with the sum of exponential divisors of the exponential divisors (A400873) instead of the sum of exponential divisors (A051377).
%C A401190 If k is a term, then k*m is a term in A401189 for any squarefree number m that is coprime to k.
%C A401190 Any term in A401189 is of the form k*m, where k is a term in this sequence and m is a squarefree number coprime to k. Therefore, A401189 can be generated from this sequence by multiplying with coprime squarefree numbers, and the asymptotic density of A401189 can be evaluated from the terms in this sequence (see the Comments section of A401189).
%t A401190 f[p_, e_] := DivisorSum[e, DivisorSigma[0, #]*p^(e/#) &]; q[k_] := Module[{r = (Times @@ f @@@ FactorInteger[k])/k}, r > 1 && IntegerQ[r]]; q[1] = False;
%t A401190 seq[lim_] := Select[Union[Flatten[Table[i^2 * j^3, {j, 1, Surd[lim, 3]}, {i, 1, Sqrt[lim/j^3]}]]], q]; seq[10^10]
%o A401190 (PARI) is1(k) = k > 1 && !(vecprod([sumdiv(v[2], d, numdiv(d) * v[1]^(v[2]/d)) | v <- factor(k)~]) % k);
%o A401190 list(lim) = {my(s = List(), m); for(j = 1, sqrtnint(lim, 3), for(i = 1, sqrtint(lim\j^3), m = i^2*j^3; if(is1(m), listput(s, m)))); Set(s);}
%o A401190 list(10^12)
%Y A401190 Intersection of A001694 and A401189.
%Y A401190 Cf. A005117, A051377, A054980, A400873.
%K A401190 nonn,new
%O A401190 1,1
