%I A401234 #4 Oct 21 2026 10:20:37
%S A401234 1,6,38,91,209,231,305,322,345,429,510,814,1122,1271,1273,1441,1462,
%T A401234 1671,1958,2185,2829,2905,2942,3043,3157,3363,3738,3774,3990,4037,
%U A401234 4495,4690,4902,5317,5518,5790,5966,6002,6231,7410,7881,7939,8022,8319,9118,9222,9322,11066,11245,11361,11803,12127,12341,12513,12535
%N A401234 Squarefree numbers k such that A006530(k) [the largest prime dividing k, 1 if k is 1] divides A276085(k), where A276085 is fully additive with a(p) = p#/p.
%o A401234 (PARI)
%o A401234 is_A401232(n) = if(1==n,1,my(f = factor(n)); 0==(sum(k=1, #f~, f[k, 2]*prod(i=1,primepi(f[k, 1]-1),prime(i)))%vecmax(f[,1])));
%o A401234 is_A401234(k) = (issquarefree(k) && is_A401232(k));
%Y A401234 Intersection of A005117 and A401232.
%Y A401234 Cf. A006530, A276085.
%K A401234 nonn,new
%O A401234 1,2
%A A401234 _Antti Karttunen_, Oct 21 2026
