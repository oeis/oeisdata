%S A401096 2,3,5,13,31,86,239,710,2146,6745,21578,70748,235882,800209,2753042,
%T A401096 9598427,33850954,120643777,433994424,1574445748,5755190325,
%U A401096 21182116649,78446201196,292160852166,1093705617811,4113535132680,15538028724116,58923982175989
%N A401096 Number of bicolored trees on n unlabeled vertices in which every path between two black vertices contains no other black vertices.
%C A401096 The black nodes form a mutual visibility set. a(n) is then the total number of inequivalent mutual visibility sets summed over unlabeled trees with n nodes, where equivalence of vertex sets is up to graph isomorphism.
%C A401096 Also, a(n) is the number of bicolored trees on n unlabeled vertices in which every path between two black vertices contains only black vertices.
%H A401096 Andrew Howroyd, <a href="/A401096/b401096.txt">Table of n, a(n) for n = 1..500</a>
%H A401096 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/VisibilityPolynomial.html">Visibility Polynomial</a>.
%F A401096 a(n) = A401094(n) + A000055(n).
%t A401096 eulerTS[p_,n_]:=Normal@Series[Exp@Total@Table[x^k/k DivisorSum[k,#*Coefficient[p,x,#]&],{k,n}],{x,0,n}];a[n_]:=Module[{t,u,v,w},t[p_]:=Normal@Series[p,{x,0,n}];{u,v,w}=Nest[With[{a=t[x eulerTS[#[[1]],n]]},With[{b=t[x eulerTS[#[[2]]+a,n]]},{a,b,t[(#[[3]]+b) a]}]]&,{0,0,0},n];Coefficient[t[u+v+w+(((u+v)/. x->x^2)-(u+v)^2)/2-u w],x,#]&/@Range[n]];a[28] (* From PARI *) (* _Shenghui Yang_, Oct 16 2026 *)
%o A401096 (PARI)
%o A401096 EulerTS(p)={my(n=serprec(p,x)-1); exp(x*Ser(dirmul(Vec(serchop(p,1),-n), vector(n,k,1/k)))) }
%o A401096 seq(n)={my(u=v=w=O(x)); for(n=1, n, u=x*EulerTS(u); v=x*EulerTS(v+u); w=(w + v)*u); Vec(u+v+w + (subst(u+v,x,x^2) - (u+v)^2)/2 - u*w) }
%Y A401096 Cf. A000055, A038056, A401092 (labeled version), A401094, A401095 (rooted).
%K A401096 nonn,new
%O A401096 1,1
%A A401096 _Andrew Howroyd_, Oct 16 2026
