%H A401809 <a href="/index/Rec#order_08">Index entries for linear recurrences with constant coefficients</a>, signature (784,-26020,281152,-1206414,2103696,-1227636,75168,-729).
%F A401809 a(k) = (Fibonacci(6*k-4)*(5*J(k-1)+48) + 9*Fibonacci(6*k-7) - 2*9^(k-1) - 30)/15, where Fibonacci(-1) = 1, J(0) = 13, J(1) = 525, and J(m) = 42*J(m-1) - 9*J(m-2) for m >= 2.
%F A401809 a(k) = 784*a(k-1) - 26020*a(k-2) + 281152*a(k-3) - 1206414*a(k-4) + 2103696*a(k-5) - 1227636*a(k-6) + 75168*a(k-7) - 729*a(k-8) for k >= 9.
%F A401809 G.f.: x*(6-962*x-20114*x^2+446694*x^3-2045838*x^4+2644698*x^5-308070*x^6+4482*x^7)/((1-x)*(1-9*x)*(1-18*x+x^2)*(1-756*x+4662*x^2-6804*x^3+81*x^4)).
%F A401809 Limit_{k->oo} a(k+1)/a(k) = (9+4*sqrt(5))*(21+12*sqrt(3)) = 749.794397945377...
%e A401809 a(3) = 2757494 = A401756(23) is the first term of A401756 larger than a(2) = 3742.
%t A401809 Rest@ CoefficientList[Series[x*(6 - 962*x - 20114*x^2 + 446694*x^3 - 2045838*x^4 + 2644698*x^5 - 308070*x^6 + 4482*x^7)/((1 - x)*(1 - 9*x)*(1 - 18*x + x^2)*(1 - 756*x + 4662*x^2 - 6804*x^3 + 81*x^4)), {x, 0, 13}], x] (* _Michael De Vlieger_, Nov 09 2026 *)
