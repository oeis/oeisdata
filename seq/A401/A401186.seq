%S A401186 1,1,3,16,169,3536,145721,11818892,1889787889,596953243168,
%T A401186 373176270176529,462269778297291196,1135793820664431416665,
%U A401186 5539216950159551009578592,53655011630588194642951874441,1032811229976773376907671376665548,39527014776052776307796390525683201633
%N A401186 Total number of maximal independent vertex sets in all labeled graphs on n vertices.
%C A401186 Also, a(n) is the total number of maximal cliques in all labeled graphs on n vertices.
%H A401186 Andrew Howroyd, <a href="/A401186/b401186.txt">Table of n, a(n) for n = 0..50</a>
%H A401186 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/MaximalClique.html">Maximal Clique</a>.
%H A401186 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/MaximalIndependentVertexSet.html">Maximal Independent Vertex Set</a>.
%F A401186 a(n) = Sum_{k=0..n} binomial(n,k)*(2^k-1)^(n-k)*2^binomial(n-k,2).
%e A401186 a(2) = 3 because there are 2 maximal independent sets in the path graph on 2 vertices and 1 maximal independent set in the empty graph on 2 vertices.
%t A401186 A401186[n_] := If[n == 0, 1, Sum[Binomial[n, k]*(2^k - 1)^(n - k)*2^Binomial[n - k, 2], {k, n}]] ;
%t A401186 Array[A401186, 20, 0] (* _Paolo Xausa_, Oct 18 2026 *)
%o A401186 (PARI) a(n) = sum(k=0, n, binomial(n,k)*(2^k-1)^(n-k)*2^binomial(n-k,2) )
%Y A401186 Cf. A079491 (not necessarily maximal), A401186, A401187 (in connected graphs).
%K A401186 nonn,new
%O A401186 0,3
%A A401186 _Andrew Howroyd_, Oct 17 2026
