%S A401437 0,1,1,0,0,1,3,4,4,5,5,4,2,1,1,0,0,1,1,0,0,1,3,4,6,9,11,12,12,13,15,
%T A401437 16,16,17,17,16,16,17,19,20,20,21,21,20,18,17,17,16,14,13,11,8,6,5,5,
%U A401437 4,4,5,5,4,2,1,1,0,0,1,1,0,0,1,3,4,4,5,5,4,2,1,1
%N A401437 Partial sums of A401409.
%C A401437 Let P_0 = (0,0) and P_{k+1} = P_k + i^A401409(k) (the alternate paperfolding curve, first step to the east). Then a(n) = 0 if and only if P_{n+1} lies on the x-axis, and a(n) = (n+1)/2 if and only if P_{n+1} lies on the diagonal x = y; this follows from the formulas below and Theorem 10 of the Ryde link, which shows that these points are indexed by A000695 and A062880, respectively. - _Leandro Hector Gallego_, Oct 25 2026
%C A401437 The nonnegativity of a(n) is the case eps_k = (-1)^k of a criterion for all generalized paperfolding sequences (see the second Gallego link). - _Leandro Hector Gallego_, Oct 25 2026
%H A401437 Leandro Hector Gallego, <a href="/A401437/b401437.txt">Table of n, a(n) for n = 0..10000</a>
%H A401437 Leandro Hector Gallego, <a href="/A401437/a401437.jpg">Plot of a(n)/n for n = 1..10^10 (logarithmic scale)</a>
%H A401437 Leandro Hector Gallego, <a href="https://doi.org/10.5281/zenodo.23631526">The partial sums of A401409 are nonnegative, with zeros described by the Moser-de Bruijn sequence</a>, Zenodo, 2026.
%H A401437 Leandro Hector Gallego, <a href="https://doi.org/10.5281/zenodo.23633853">Nonnegative double partial sums of generalized paperfolding sequences: an exact criterion, and a sharp upper bound for the partial sums of A401409</a>, Zenodo, 2026.
%H A401437 Kevin Ryde, <a href="https://download.tuxfamily.org/user42/alternate/alternate.pdf">Iterations of the Alternate Paperfolding Curve</a>, Draft 13, 2020.
%F A401437 a(n) = Sum_{k=0..n} A401409(k).
%F A401437 a(n) >= 0 for all n, and a(n) = 0 if and only if n+1 is in A000695 (conjectured by _Vaclav Kotesovec_, Oct 24 2026; proved in the first Gallego link).
%F A401437 a(4m+3) = 4*a(m) (see the first Gallego link).
%F A401437 a(n) <= (n+1)/2 for all n, with equality if and only if n+1 is in A062880 = 2*A000695 (see the second Gallego link). - _Leandro Hector Gallego_, Oct 25 2026
%t A401437 Join[{0}, Accumulate[Accumulate[Table[(-1)^IntegerExponent[n, 2] * JacobiSymbol[-1, n], {n, 1, 100}]]]]
%o A401437 (PARI) a(n) = my(s=0, t=0, v); for(k=1, n, v=valuation(k, 2); s += (-1)^v*kronecker(-4, k>>v); t += s); t; \\ _Leandro Hector Gallego_, Oct 25 2026
%Y A401437 Cf. A000695, A062880, A209615, A401409.
%K A401437 nonn,new
%O A401437 0,7
%A A401437 _Vaclav Kotesovec_ and _Leandro Hector Gallego_, Oct 24 2026
