%I A401697 #12 Nov 09 2026 22:14:01
%S A401697 1,1,1,1,1,2,1,2,1,2,1,2,1,2,2,1,1,2,1,2,2,2,1,5,1,2,2,2,1,5,1,2,2,2,
%T A401697 2,2,1,2,2,5,1,5,1,2,2,2,1,2,1,2,2,2,1,5,2,5,2,2,1,5,1,2,2,2,2,5,1,2,
%U A401697 2,5,1,5,1,2,2,2,2,5,1,2,1,2,1,5,2,2,2,5
%N A401697 Number of unordered factorizations of n into its distinct infinitary divisors.
%C A401697 First differs from A401695 at n = 120: a(120) = 16, while A401695(120) = 15.
%C A401697 The infinitary divisors of n are listed in row n of A077609.
%C A401697 a(n) depends only on the prime signature of n (A118914).
%H A401697 Amiram Eldar, <a href="/A401697/b401697.txt">Table of n, a(n) for n = 1..10000</a>
%H A401697 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%F A401697 a(n) >= A401695(n).
%F A401697 a(n) >= A401699(n), with equality if and only of n is a power of a prime (A000961).
%e A401697     n | a(n) | factorizations
%e A401697    ---|------|--------------------------------------------------------
%e A401697     2 |   1  | 2
%e A401697     6 |   2  | 6, 2*3
%e A401697    24 |   5  | 24, 3*8, 4*6, 2*12, 2*3*4
%e A401697   120 |  16  | 120, 2*60, 3*40, 4*30, 5*24, 6*20, 8*15, 10*12, 2*3*20,
%e A401697       |      | 2*4*15, 2*5*12, 2*6*10, 3*4*10, 3*5*8, 4*5*6, 2*3*4*5
%e A401697 Note that the additional factorization of 120 that is not enumerated by A401695 is 2*6*10.
%t A401697 a[n_] := Module[{e = FactorInteger[n][[;;, 2]], bits, divs, poly, x}, bits[m_] := Select[Range[0, m], BitAnd[#, m] == # &]; divs = Rest[Tuples[bits /@ e]]; poly = Expand[Product[1 + Product[x[i]^d[[i]], {i, 1, Length[e]}], {d, divs}]]; Coefficient[poly, Product[x[i]^e[[i]], {i, 1, Length[e]}]]]; Array[a, 88]
%Y A401697 Cf. A000961, A037445, A077609, A118914, A401695, A401696, A401698, A401699.
%K A401697 nonn,easy,new
%O A401697 1,6
%A A401697 _Amiram Eldar_, Nov 02 2026
