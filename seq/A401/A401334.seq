%I A401334 #11 Oct 29 2026 20:42:48
%S A401334 1,1,3,3,3,3,5,5,7,5,7,7,7,9,9,9,11,11,11,13,11,13,13,13,15,13,17,15,
%T A401334 17,15,19,17,19,19,19,21,21,21,23,21,25,21,25,23,27,23,27,25,27,27,27,
%U A401334 29,27,31,29,31,29,33,29,35,31,35,33,35,33,37,35,37,37,37
%N A401334 Multi-arch perturbed Hofstadter Q-sequence: a(n) = a(n-a(n-1)) + a(n-a(n-2)) - (-1)^n for n >= 8, with (a(1),...,a(7)) = (1,1,3,3,3,3,5).
%C A401334 Variant of A394051 with the opposite parity perturbation and seven initial values.
%C A401334 Every positive odd integer occurs, each only finitely often. The subsequences at even and odd indices are both nondecreasing. See sections 2-3 of Mantovanelli (2026).
%H A401334 Marco Mantovanelli, <a href="/A401334/b401334.txt">Table of n, a(n) for n = 1..10000</a>
%H A401334 Marco Mantovanelli, <a href="https://doi.org/10.13140/RG.2.2.12109.40162">A Multi-Arch Perturbed Hofstadter Q-Recursion: Gaussian Profiles and Exact Frequency Laws</a>, ResearchGate, 2026.
%e A401334 For n = 8, a(8) = a(8-5) + a(8-3) - 1 = a(3) + a(5) - 1 = 5.
%e A401334 For n = 9, a(9) = a(9-5) + a(9-5) + 1 = a(4) + a(4) + 1 = 7.
%t A401334 Clear[a, n, nmax];
%t A401334 nmax = 70;
%t A401334 a = ConstantArray[0, nmax];
%t A401334 a[[1 ;; 7]] = {1, 1, 3, 3, 3, 3, 5};
%t A401334 Do[
%t A401334   a[[n]] = a[[n - a[[n - 1]]]] +
%t A401334     a[[n - a[[n - 2]]]] - (-1)^n,
%t A401334   {n, 8, nmax}
%t A401334 ];
%t A401334 a
%Y A401334 Cf. A005185, A394051.
%K A401334 nonn,new
%O A401334 1,3
%A A401334 _Marco Mantovanelli_, Oct 21 2026
