%S A401724 0,0,0,0,3,0,0,0,0,0,4,0,4,0,0,0,5,0,8,2,3,0,5,0,1,0,0,0,9,0,0,2,11,0,
%T A401724 6,0,1,8,9,0,33,0,20,10,16,0,6,0,4,12,16,0,7,8,10,2,7,0,10,0,1,0,0,12,
%U A401724 30,0,8,2,37,0,7,0,1,3,32,6,41,0,10,0,31,0,34,6,16,8,3,0,11,0,44,2,36,12,7,0,6,14
%N A401724 a(n) = A276085(n) mod A342001(n), where A342001(n) = A003415(n)/A003557(n), and A276085 is fully additive with a(p) = p#/p.
%H A401724 Antti Karttunen, <a href="/A401724/b401724.txt">Table of n, a(n) for n = 2..20000</a>
%H A401724 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401724 a(n) = A276085(n) mod (A007947(n) * (Sum_{p^e || n} e/p)), where each p^e is the highest power of prime p that divides n.
%o A401724 (PARI)
%o A401724 A342001(n) = { my(f=factor(n)); (sum(i=1, #f~, f[i, 2]/f[i, 1]) * factorback(f[, 1])); };
%o A401724 A276085_mod_m(n,m) = if(1==n,0,my(f = factor(n),lp=f[#f~,1],pr=1,s=0,k=1); forprime(p=2,lp,if(f[k,1]==p, s += f[k,2]*pr; s %= m; k++); pr *= p; pr %= m); (s));
%o A401724 A401724(n) = A276085_mod_m(n,A342001(n));
%Y A401724 Cf. A003415, A003557, A007947, A276085, A342001, A401725 ({1} followed by the indices of 0's in this sequence).
%Y A401724 Cf. also A373148.
%K A401724 nonn,easy,new
%O A401724 2,5
%A A401724 _Antti Karttunen_, Nov 08 2026
