%S A401757 1,1,4,4,12,28,28,28,36,36,36,36,180,180,180,180,180,180,180,180,180,
%T A401757 180,180,180,900,900,900,900,900,900,2376,2376,2376,2376,2376,2376,
%U A401757 2376,2376,2376,2376,2376,2376,2376,2376,2376,2376,2376,2376,2376,44100,44100,44100,44100,44100
%N A401757 Least positive integer k such that j is squarefree if and only if j+k is squarefree for every j from 1 to n.
%H A401757 Seiichi Manyama, <a href="/A401757/b401757.txt">Table of n, a(n) for n = 1..200</a>
%H A401757 Thomas F. Bloom, <a href="https://www.erdosproblems.com/675">Erdős Problem 675</a>, Erdős Problems.
%o A401757 (PARI) a(n) = my(k=0); until(sum(j=1, n, issquarefree(j)!=issquarefree(j+k))==0, k++); k;
%K A401757 nonn,new
%O A401757 1,3
%A A401757 _Seiichi Manyama_, Nov 04 2026
