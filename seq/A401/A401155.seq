%I A401155 #9 Oct 19 2026 17:45:50
%S A401155 2,3,2,3,3,12,2,11,11,6,3,12,2,19,3,6,7,15,3,17,2,2,7,3,30,3,7,12,17,
%T A401155 2,3,3,2,3,23,10,35,7,3,14,17,3,3,12,7,13,6,2,3,26,7,2,2,3,3,18,41,11,
%U A401155 14,3,3,2,3,7,13,48,3,3,2,3,7,37,19,7,3,41,11,3
%N A401155 Smallest number that is a primitive root modulo both p = A001359(n) and p+2 = A006512(n).
%C A401155 Smallest number that is a primitive root modulo both members of the n-th twin prime pair.
%H A401155 Jianing Song, <a href="/A401155/b401155.txt">Table of n, a(n) for n = 1..10000</a>
%H A401155 Jianing Song, <a href="/A401155/a401155.txt">First 10000 pairs of twin primes with their least common primitive roots</a>.
%o A401155 (PARI) isprimroot(a,p) = (a%p) && znorder(Mod(a,p)) == p-1;
%o A401155 forprime(p=2, 1e4, if(isprime(p+2), for(a=1, oo, if(isprimroot(a,p) && isprimroot(a,p+2), print1(a, ", "); break()))));
%Y A401155 Cf. A001359, A006512, A001918.
%K A401155 nonn,new
%O A401155 1,1
%A A401155 _Jianing Song_, Oct 16 2026
