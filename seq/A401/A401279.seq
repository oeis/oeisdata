%e A401279    (21) -> (11) -> (1) -> (),
%e A401279    (111) -> (11) -> (1) -> ().
%o A401279 (PARI)
%o A401279 ForChomp(p, f) = { for(i=1, #p, for(j=1, p[i], f(if(j==1, p[1..i-1], vectorsmall(#p, k, if(k<i, p[k], min(p[k], j-1))))) )) }
%o A401279 T(n)={ my(M=Map(), v=vector(n+1)); mapput(M,vectorsmall(0),1); v[1] = [1]; for(r=1, n, my(t=0); forpart(p=r, local(s=0); my(p1=vecsort(p,,4)); ForChomp(p1, q->s+=mapget(M, q)); mapput(M, p1, s*x); t+=x*s); v[1+r]=Vecrev(t)); v }
%o A401279 my(A=T(9)); for(i=1, #A, print(A[i]))
