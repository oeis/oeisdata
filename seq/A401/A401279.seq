%e A401279 The T(3,2) = 6 reductions are:
%e A401279    (3) -> (2) -> (),
%e A401279    (3) -> (1) -> (),
%e A401279    (21) -> (2) -> (),
%e A401279    (21) -> (11) -> (),
%e A401279    (111) -> (11) -> (),
