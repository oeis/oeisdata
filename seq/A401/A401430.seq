%S A401430 1,0,16,16,128,224,800,1568,4160,7856,17472,31360,60848,102832,180896,
%T A401430 286720,466768,701376,1070672,1538208,2238464,3096480,4341600,5840640,
%U A401430 7944016,10443136,13884384,17882672,23302848,29531536,37785120,47140624,59441440
%N A401430 Expansion of g.f. Phi^8, where Phi = g.f. for A028930.
%C A401430 a(n) is the number of representations of n by the 16-variable quadratic form that is the sum of 8 copies of 2*x^2 + x*y + 3*y^2.
%H A401430 Karan Sharma, <a href="/A401430/b401430.txt">Table of n, a(n) for n = 0..1000</a>
%H A401430 Bülent Köklüce, <a href="https://doi.org/10.1007/s11139-013-9480-4">Cusp forms in S_6(Gamma_0(23)), S_8(Gamma_0(23)) and the number of representations of numbers by some quadratic forms in 12 and 16 variables</a>, Ramanujan J. 34 (2014), 187-208. See p. 204.
%o A401430 (PARI) th(M, N) = 1 + 2*x*Ser(qfrep(M, N, 1), x);
%o A401430 a(n) = polcoef(th([4, 1; 1, 6], n+1)^8, n);
%Y A401430 Cf. A028930, A028959, A328527, A328528, A328529, A328530, A328531, A328532, A328533, A328534, A328535, A328536.
