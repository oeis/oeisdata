%S A401635 1,3,105,41580,193243050,10803902709600,7390295791988709600,
%T A401635 62608955737421291398200000,6629487335365559419874977357500000,
%U A401635 8836585129521902503015049989374370200000000,149115218633460684169536931919790873285316993920000000
%N A401635 a(n) = Product_{k=0..n} binomial(4*n - k, k).
%F A401635 For n > 0, a(n) = Gamma(4*n) * sqrt(BarnesG(4*n) * BarnesG(2*n) / Gamma(2*n)) / (n * 2^(n/2) * BarnesG(n) * BarnesG(3*n) * Gamma(n)^(3/2) * Gamma(3*n)).
%F A401635 a(n) ~ A * 2^(9*n^2 + n - 5/8) * exp(n/2 - 1/12) / (3^(9*n^2/2 - 1/12) * n^(n/2 + 5/12) * Pi^((n+1)/2)), where A is the Glaisher-Kinkelin constant A074962.
%t A401635 Table[Product[Binomial[4*n-k, k], {k, 0, n}], {n, 0, 12}]
%t A401635 (* Alternative: *)
%t A401635 Join[{1}, Table[Gamma[4*n] * Sqrt[BarnesG[4*n] * BarnesG[2*n] / Gamma[2*n]] / (n * 2^(n/2) * BarnesG[n] * BarnesG[3*n] * Gamma[n]^(3/2) * Gamma[3*n]), {n, 1, 12}]]
%Y A401635 Cf. A073617, A296590, A401629.
%Y A401635 Cf. A262261.
