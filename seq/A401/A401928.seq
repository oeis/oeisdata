%T A401928 12,11,12,13,14,15,16,15,16,13,14,15,16,15,16,13,14,15,16,15,16,13,14,
%U A401928 15,16,15,16,9,10,11,12,11,12,13,14,15,16,15,16,13,14,15,16,15,16,13,14,15,16,15,16,13,14,15
%N A401928 Lexicographically earliest infinite sequence such that a(i) = a(j) => A328571(i) = A328571(j) for all i, j >= 0, where A328571(n) = A007947(A276086(n)), the squarefree kernel of the primorial base exp-function.
%C A401928 Restricted growth sequence transform of any of these sequences: A328571, A328841, A401927.
%C A401928 For all i, j >= 0:
%C A401928   a(i) = a(j) => A267263(i) = A267263(j).
%H A401928 Antti Karttunen, <a href="/A401928/b401928.txt">Table of n, a(n) for n = 0..60060</a>
%H A401928 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%H A401928 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%o A401928 (PARI)
%o A401928 up_to = 60060;
%o A401928 rgs_transform(invec) = { my(om = Map(), outvec = vector(length(invec)), u=1); for(i=1, length(invec), if(mapisdefined(om,invec[i]), my(pp = mapget(om, invec[i])); outvec[i] = outvec[pp] , mapput(om,invec[i],i); outvec[i] = u; u++ )); outvec; };
%o A401928 A328571(n) = { my(m=1, p=2); while(n, m *= (p^!!(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A401928 v401928 = rgs_transform(vector(1+up_to,n,A328571(n-1)));
%o A401928 A401928(n) = v401928[1+n];
%Y A401928 Cf. A007947, A276086, A328571, A328841, A401927.
%Y A401928 Cf. also A267263.
%K A401928 nonn,base,easy,new
%O A401928 0,2
%A A401928 _Antti Karttunen_, Nov 20 2026
