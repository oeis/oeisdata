%T A401297 790429548752363520,3277027906953248448000,46727245990155043543230000
%N A401297 Largest k in A293780 with n distinct prime factors.
%e A401297 Table of n, a(n) for n = 0..9:                Exponents of
%e A401297                                               prime factors
%e A401297                                                       1 1 1 1 2
%e A401297   n         i             A293780(i) = a(n)   2 3 5 7 1 3 7 9 3
%e A401297   -------------------------------------------------------------
%e A401297   0         1                            1    0
%e A401297   1         5                           32    5
%e A401297   2        32                         2592    5.4
%e A401297   3       201                       491520   15.1.1
%e A401297   4      1652                    632217600   13.2.2.3
%e A401297   5      8422                 317684713500    2.7.3.4.2
%e A401297   6     56151              777259883400000    6.1.5.7.2.1
%e A401297   7    274008           790429548752363520   13.4.1.8.1.1.2
%e A401297   8   1694062       3277027906953248448000    9.8.3.1.1.1.7.1
%e A401297   9  12080320   46727245990155043543230000    4.2.4.3.9.1.3.1.2
%t A401297 (* First, load the regs program from A369609. Note: effective maximum for this method is nn = 16 for most computers. *)
%t A401297 nn = 14; P[x_] := Product[Prime[i], {i, x}]; s[0] = {1}; c = 0; Table[Set[s[n], regs[-P[n], 2^nn*P[nn]]], {n, nn}]; Table[Set[m[n], Length[s[n]]], {n, 0, nn}]; Do[(If[#2 == c, c++]; a[#2] = #1) & @@ {#, PrimeNu[#]} &@ Min@ Array[If[j > m[#], Infinity, s[#][[j]] ] &, nn + 1, 0], {j, m[nn - 2] } ]; Array[a, c - 1, 0]
%Y A401297 Cf. A001221, A008479, A055932, A293780, A369609, A400546.
