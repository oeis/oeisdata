%T A401762 327524,642840,1263002,2483672,4888946,9632446,18996082,37494902,
%U A401762 74071730,146447792,289766618,573758474,1136864058,2254074784,4471899772,8876935794,17630553254
%N A401762 Number of distinct traces of length n of Wolfram's 2-state 3-symbol Turing machine; i.e., sequences of n (state, symbol read) pairs produced from an arbitrary tape and starting state.
%D A401762 Stephen Wolfram, A New Kind of Science, Wolfram Media, 2002, p. 709.
%H A401762 Renzo Bruera, Robert Cardona, Eva Miranda, Daniel Peralta-Salas, and Ville Salo, <a href="https://arxiv.org/abs/2404.07288">Topological entropy of Turing complete dynamics</a>, arXiv:2404.07288 [math.DS], 2024-2026.
%H A401762 Anahí Gajardo, Nicolas Ollinger, and Rodrigo Torres-Avilés, <a href="https://doi.org/10.46298/dmtcs.2137">Some undecidable problems about the trace-subshift associated to a Turing machine</a>, Discrete Math. Theor. Comput. Sci. 17(2) (2015), 267-284.
%H A401762 Petr Kůrka, <a href="https://doi.org/10.1016/S0304-3975(96)00025-4">On topological dynamics of Turing machines</a>, Theoret. Comput. Sci. 174 (1997), 203-216.
%H A401762 Piotr Oprocha, <a href="https://doi.org/10.1088/0951-7715/19/10/012">On entropy and Turing machine with moving tape dynamical model</a>, Nonlinearity 19 (2006), 2475-2487.
%H A401762 Alex Smith, <a href="https://doi.org/10.25088/ComplexSystems.29.1.1">Universality of Wolfram's 2,3 Turing machine</a>, Complex Systems 29 (2020), 1-44.
%H A401762 Wikipedia, <a href="https://en.wikipedia.org/wiki/Wolfram%27s_2-state_3-symbol_Turing_machine">Wolfram's 2-state 3-symbol Turing machine</a>.
%F A401762 a(n) = a(n-1) + 2*b(n-1) for n >= 2, where b(k) is the number of traces of length k after which the head is on a cell it has not visited (b(1)..b(7) = 6, 11, 25, 47, 96, 188, 371).
%e A401762 a(1) = 6: the pairs (A,0), (A,1), (A,2), (B,0), (B,1), (B,2).
%e A401762 a(2) = 18: after one step the head is always on a new cell, which may hold any of the 3 symbols, so each trace of length 1 has 3 continuations.
%e A401762 a(3) = 40 = 18 + 2*11: 11 of the 18 traces of length 2 leave the head on a new cell. For example, after (A,0)(B,0) the head is back on the cell where it wrote 1, so the only continuation is (A,1).
%o A401762 (Python)
%o A401762 R = {('A',0): (1,1,'B'), ('A',1): (2,-1,'A'), ('A',2): (1,-1,'A'),
%o A401762 ('B',0): (2,-1,'A'), ('B',1): (2,1,'B'), ('B',2): (0,1,'A')}
%o A401762 def a(n):
%o A401762     def f(q, tape, pos, k):
%o A401762         if k == n: return 1
%o A401762         syms = (tape[pos],) if pos in tape else (0, 1, 2)
%o A401762         return sum(f(R[q,s][2], {**tape, pos: R[q,s][0]}, pos + R[q,s][1], k + 1) for s in syms)
%o A401762     return f('A', {}, 0, 0) + f('B', {}, 0, 0)
%o A401762 print([a(n) for n in range(1, 17)])
%Y A401762 Cf. A208229, A393686, A393687.
