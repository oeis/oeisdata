%I A401302 #25 Oct 27 2026 21:49:59
%S A401302 1,3,13,9,781,39,137257,27,169,2343,28531167061,117,25239592216021,
%T A401302 411771,10153,81,51702516367896047761,507,109912203092239643840221,
%U A401302 7029,1784341,85593501183,949112181811268728834319677753,351,609961,75718776648063,2197
%N A401302 Completely multiplicative with a(p) = Phi_p(p) = (p^p-1)/(p-1) for prime p.
%C A401302 Phi_p(x) = (x^p-1)/(x-1) is the p-th cyclotomic polynomial.
%F A401302 Multiplicative with a(prime(k)^e) = A001039(k)^e.
%e A401302 a(1) = 1.
%e A401302 a(2) = Phi_2(2) = 1 + 2 = 3.
%e A401302 a(3) = Phi_3(3) = 1 + 3 + 3^2 = 13.
%e A401302 a(4) = Phi_2(2)^2 = 3^2 = 9.
%e A401302 a(6) = Phi_2(2) * Phi_3(3) = 3 * 13 = 39.
%t A401302 f[p_, e_] := ((p^p - 1)/(p - 1))^e; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 27] (* _Amiram Eldar_, Oct 20 2026 *)
%o A401302 (Python)
%o A401302 from sympy import cyclotomic_poly, factorint, Symbol
%o A401302 x = Symbol('x')
%o A401302 def a(n):
%o A401302     if n == 1:
%o A401302         return 1
%o A401302     factors = factorint(n)
%o A401302     res = 1
%o A401302     for p, exp in factors.items():
%o A401302         poly_val = int(cyclotomic_poly(p, x).subs(x, p))
%o A401302         res *= poly_val**exp
%o A401302     return res
%o A401302 (PARI) a(n)=my(f=factor(n)); prod(i=1, #f~, my([p,e]=f[i,]); ((p^p - 1)/(p - 1))^e) \\ _Andrew Howroyd_, Oct 20 2026
%Y A401302 Cf. A000040, A020500, A401029, A001039, A023037, A054767.
