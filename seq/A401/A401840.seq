%I A401840 #5 Nov 12 2026 14:07:00
%S A401840 600,300,1200,20280,10140,101400,354900,260100,69360,138720,1115400,
%T A401840 4200,606900,2129400,40560,2601000,210000,105000,3802500,21547500,
%U A401840 6069000,706440,1261500,34680,82500,1513800,7064400,1820700,7569000,15606600,5339100,41644980,1149960
%N A401840 a(n) is the area of the triangle with sides A401839(n)*A120133(n), A401839(n)*A120132(n), A401839(n)*A120131(n).
%C A401840 The set of terms of A401841 is exactly the closure of the set of terms of this sequence under multiplication by positive integer squares.
%H A401840 Felix Huber, <a href="/A401840/b401840.txt">Table of n, a(n) for n = 1..10000</a>.
%H A401840 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/HeronianTriangle.html">Heronian Triangle</a>.
%F A401840 a(n) = A401839(n)^2*A072294(n).
%e A401840 a(1) = 600: The triangle with sides 3, 4, 5 inflated by A401839(1) = 10 has sides 30, 40, 50 and area 600.
%e A401840 a(2) = 300: The triangle with sides 5, 5, 6 inflated by A401839(2) = 5 has sides 25, 25, 30 and area 300. This is the smallest term.
%p A401840 A401840 := proc(n)
%p A401840     local i, k, l, m, q, s, x, y, z;
%p A401840     i := 0;
%p A401840     for z from 1 do
%p A401840         for y from 1 to z do
%p A401840             for x from z - y + 2 to y by 2 do
%p A401840                 s := (x + y + z)/2;
%p A401840                 if igcd(x, y, z) = 1 then
%p A401840                     q := s*(s - x)*(s - y)*(s - z);
%p A401840                     if issqr(q) then
%p A401840                         i := i + 1;
%p A401840                         if i = n then
%p A401840                             m := isqrt(q);
%p A401840                             l := ilcm(x, y, z);
%p A401840                             k := l/igcd(l, m);
%p A401840                             return k^2*m;
%p A401840                         end if;
%p A401840                     end if;
%p A401840                 end if;
%p A401840             end do;
%p A401840         end do;
%p A401840     end do;
%p A401840 end proc:
%p A401840 seq(A401840(n), n = 1 .. 33);
%Y A401840 Cf. A072294, A120131, A120132, A120133, A224301, A401839, A401841.
%K A401840 nonn,easy,new
%O A401840 1,1
%A A401840 _Felix Huber_, Nov 07 2026
