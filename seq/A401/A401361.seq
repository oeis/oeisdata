%e A401361 Every row in array T(n, k) is infinite since for numbers v = 2^m * 3^n, m >= floor(log_2(3^n)), SRS(v) consists of a single unimodular part of maximum width n+1.
%t A401361 (* Definition of unimodalQ[v] is based on 2-dense sublists of divisors of v *)
%t A401361 unimodalQ[v_] := AllTrue[Map[Select[#, OddQ]&, Split[Divisors[v], #2 - 2*#1 <=0&]], 2^(IntegerExponent[v, 2]+1)Min[#]>Max[#]&]
%t A401361 a401361[b_] := Select[Range[b], unimodalQ]
%t A401361 a401361[80] (* first 72 terms of the sequence *)
%t A401361 (* Array computation in the Example section *)
%t A401361 T401361[n_, k_, b_] := Module[{list=Table[{}, n], v, o2dL, m, exp}, For[v=1, v<=b, v++, o2dL=Map[Select[#, OddQ]&, Split[Divisors[v], #2 - 2*#1 <=0&]]; m=Max[Map[Length, o2dL]]; exp=IntegerExponent[v, 2]; If[AllTrue[o2dL, 2^(exp+1)Min[#]>Max[#]&]&&m<=n&&Length[list[[m]]]<k, AppendTo[list[[m]], v]]]; list]
%t A401361 T401361[10, 10, 1500000]
%Y A401361 Cf. A174905, A237270, A237271, A237593, A249223, A249351, A320066, A341969, A384222, A384225, A401362 (complement).
