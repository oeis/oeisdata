%S A401008 0,0,0,1,1,1,2,3,2,3,4,4,5,5,4,7,7,6,8,8,7,9,10,10,10,11,10,12,13,11,
%T A401008 14,15,13,15,14,15,17,17,16,18,19,17,20,20,17,21,22,22,22,22,22,24,25,
%U A401008 23,24,26,25,27,28,26,29,29,26,31,29,29,32,32,31,31,34
%N A401008 a(n) = the number of odd non-divisors of n in 1..n.
%C A401008 The sequence contains all nonnegative integers.
%F A401008 a(n) = 0 for n = 1, 2 and 3.
%F A401008 a(n) = A049820(n) - A401009(n) = A065033(n) - A001227(n).
%e A401008 For n = 8 there are three odd non-divisors of 8: 3, 5, 7. So a(8) = 3.
%t A401008 a[n_]:=Length[Select[Range[n],OddQ[#]&&!Divisible[n,#] &]]; Array[a,71] (* _Stefano Spezia_, Oct 15 2026 *)
%o A401008 (Magma) [#S eq 0 select 0 else #S where S := [k: k in [1..n] | not IsIntegral(n/k) and IsOdd(k)]: n in [1..100]];
%o A401008 (Python)
%o A401008 from sympy import divisor_count
%o A401008 def A401008(n): return (n+1>>1)-divisor_count(n>>(~n&n-1).bit_length()) # _Chai Wah Wu_, Oct 20 2026
%Y A401008 Cf. A001227, A065033, A049820, A401009.
%K A401008 nonn,easy,new
%O A401008 1,7
