%I A401903 #17 Nov 24 2026 16:02:23
%S A401903 2,2,3,3,5,11,5,7,17,19,7,17,29,37,43,19,29,59,61,103,149,13,47,103,
%T A401903 113,223,271,593,499,1483,2777,4363,5237,5507,6043,6197,10433,17167,
%U A401903 26693,32507,34877,37957,55313,70717,72937
%N A401903 Triangle T(n,k) whose n-th row is either the lexicographically first n-tuple p of strictly increasing primes with minimal p(n) for which the set {p(i) + p(j) + p(k) : i < j < k} contains A111384(n) primes, or an n-tuple of zeros if no tuple with this property exists.
%H A401903 Markus Sigg, <a href="https://arxiv.org/abs/2309.14840">A note on OEIS sequence A111384</a>, arXiv:2309.14840 [math.CO], 2023.
%H A401903 James Youlton, <a href="https://web.archive.org/web/20240604035253/http://v-sonline.com/VSPCs/index.pl?C4">Virtual Source Programming Contests, Tribal Primes (Wayback Machine URL)</a>, 2009.
%e A401903 Triangle T(n,k) begins:
%e A401903       2
%e A401903       2     3
%e A401903       3     5    11
%e A401903       5     7    17    19
%e A401903       7    17    29    37    43
%e A401903      19    29    59    61   103   149
%e A401903      13    47   103   113   223   271   593
%e A401903     499  1483  2777  4363  5237  5507  6043  6197
%e A401903   10433 17167 26693 32507 34877 37957 55313 70717 72937
%e A401903 ...
%e A401903 T(4) = (5, 7, 17, 19) because this is the lexicographically first (in fact the only) 4-tuple p of strictly increasing primes with p(4) = 19 whose triple-sums create A111384(n) = 4 primes 5 + 7 + 17 = 29, 5 + 7 + 19 = 31, 5 + 17 + 19 = 41, 7 + 17 + 19 = 43, and there is no 4-tuple p of strictly increasing primes with this property and p(4) < 19.
%o A401903 (PARI) primeTripleSums(indexes, Primes) = {
%o A401903   my(n = #indexes, L = List());
%o A401903   for(i = 1, n, for(j = i+1, n, for(k = j+1, n,
%o A401903     my(x = Primes[indexes[i]] + Primes[indexes[j]] + Primes[indexes[k]]);
%o A401903     if(isprime(x), listput(L, x))
%o A401903   )));
%o A401903   return(Set(L))
%o A401903 };
%o A401903 T(n) = {
%o A401903   my(a111384 = floor(n/2) * ceil(n/2) * (n-2)/2, Primes = List(primes(n)), indexes = vector(n));
%o A401903   while(1,
%o A401903     for(i = 1, n-1, indexes[i] = i); indexes[n] = #Primes;
%o A401903     while(1,
%o A401903       if(#primeTripleSums(indexes, Primes) == a111384, return(apply(x -> Primes[x], indexes)));
%o A401903       my(k = n-1);
%o A401903       while(k >= 1 && indexes[k] == #Primes - n + k, k--);
%o A401903       if(k == 0, break, indexes[k]++);
%o A401903       for(j = k+1, n-1, indexes[j] = indexes[j-1] + 1)
%o A401903     );
%o A401903     listput(Primes, nextprime(Primes[#Primes] + 1))
%o A401903   )
%o A401903 };
%Y A401903 Cf. A111384, A401846.
%K A401903 nonn,hard,more,tabl,new
%O A401903 1,1
%A A401903 _Markus Sigg_, Nov 09 2026
