%U A401675 31,32,35,34,34,34,38,36,38,35,39,40,40,40,40,44,42,43,42,44,46,46,46,45
%N A401675 Number of earlier points visible from the n-th point of the hexagonal spiral on the Eisenstein lattice.
%C A401675 The points of the Eisenstein lattice are numbered along the hexagonal spiral of A345435: P(0) = 0, P(1) = 1, P(2) = 1 + w, P(3) = w, P(4) = -1, P(5) = -1 - w, P(6) = -w, P(7) = 1 - w, P(8) = 2, ..., where w = exp(2*Pi*i/3). Ring r >= 1 consists of P(n) for 3*r*(r-1) < n <= 3*r*(r+1) and begins at P(3*r*(r-1)+1) = 1 - (r-1)*w.
%C A401675 P(m) is visible from P(n) if no other lattice point lies on the segment between them. This happens exactly when P(n) - P(m) = x + y*w with gcd(x, y) = 1.
%C A401675 It appears that a(n)/n tends to 6/Pi^2.
%C A401675 The values 25, 33, 37, 41, 49, 57, 59, 69, 75, 77, 79, 84, ... do not occur for n <= 10000.
%H A401675 Karan Sharma, <a href="/A401675/b401675.txt">Table of n, a(n) for n = 0..10000</a>
%H A401675 Karan Sharma, <a href="/A401675/a401675.png">The points P(0)..P(3996), colored by how a(n) compares with the other points of the same ring</a>
%H A401675 Karan Sharma, <a href="/A401675/a401675_1.png">Spiral numbering with a(n) for rings 0-3, and the points visible from P(40)</a>
%H A401675 Karan Sharma, <a href="/A401675/a401675_2.png">Plot of a(n) - 6n/Pi^2 and of the missing values, n = 0..10000</a>
%H A401675 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/VisiblePoint.html">Visible Point</a>
%e A401675 a(9) = 7: P(9) = 2 + w. Of the earlier points, P(3) = w is hidden behind P(2) = 1 + w, and P(6) = -w is hidden behind P(1) = 1. The other 7 earlier points are visible.
%o A401675 (Python)
%o A401675 from math import gcd
%o A401675 def spiral(N): # (a, b) means a + b*t with t = 1 + w
%o A401675     P, r = [(0, 0)], 1
%o A401675     while len(P) < N:
%o A401675         a, b = r, 1 - r; P.append((a, b))
%o A401675         for (da, db), k in [((0, 1), r-1), ((-1, 1), r), ((-1, 0), r), ((0, -1), r), ((1, -1), r), ((1, 0), r)]:
%o A401675             for _ in range(k): a += da; b += db; P.append((a, b))
%o A401675         r += 1
%o A401675     return P[:N]
%o A401675 def A(N):
%o A401675     P = spiral(N)
%o A401675     return [sum(gcd(P[n][0]-P[m][0], P[n][1]-P[m][1]) == 1 for m in range(n)) for n in range(N)]
%o A401675 print(A(92))
