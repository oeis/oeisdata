%I A401542 #19 Nov 14 2026 14:26:05
%S A401542 10,12,38,45,49,57,84,85,104,110,159,164,187,195,203,266,275,287,294,
%T A401542 304,344,351,355,412,425,437,472,493,494,580,594,603,610,636,637,654,
%U A401542 759,775,790,845,869,871,874,962,980,1000,1053,1085,1111,1120,1139,1144
%N A401542 Numbers k such that k = i + (i+1) + ... + j with j > i >= 1, and k+1 is a sum of at least 2 consecutive integers starting at j+1.
%C A401542 Both blocks must have at least 2 terms. With single-term blocks every number would qualify.
%C A401542 Equivalently, with T(x) = x*(x+1)/2: there are integers i >= 1, j >= i+1, m >= 2 such that k = T(j)-T(i-1) and T(j+m)-2*T(j)+T(i-1) = 1.
%C A401542 All terms are composite: let r = j-i+1 be the number of terms of the first block, so 2k = r*(2i+r-1). Since k+1 >= (j+1)+(j+2), k >= 2j+2, which rules out r = 2 (then k = 2j-1). So r >= 3. If r is odd, r divides k and 3 <= r < k; if r is even, k = (r/2)*(2i+r-1) with both factors >= 2.
%C A401542 In particular, no term is prime or a power of 2.
%C A401542 k = (m+1)*(2*m^2+m-2)/2 is a term for every m >= 2, since the blocks m^2-1..m^2+m-1 and m^2+m..m^2+2m-1 have sums k and k+1. But there are other terms.
%e A401542 10 = 1+2+3+4 and 11 = 5+6, so 10 is a term.
%e A401542 12 = 3+4+5 and 13 = 6+7, so 12 is a term.
%e A401542 38 = 8+9+10+11 and 39 = 12+13+14, so 38 is a term.
%o A401542 (Python)
%o A401542 from math import isqrt
%o A401542 def tri(x):
%o A401542     d = 8*x + 1; s = isqrt(d)
%o A401542     return (s-1)//2 if s*s == d and s % 2 == 1 else None
%o A401542 def terms(limit):
%o A401542     out = set(); c = 2
%o A401542     while 2*c - 1 <= limit:
%o A401542         for k in range(2, c+1):
%o A401542             t = (c*(c+1) - (c-k)*(c-k+1))//2
%o A401542             if t > limit: break
%o A401542             x = c*(c+1) - (c-k)*(c-k+1)//2 + 1
%o A401542             c2 = tri(x)
%o A401542             if c2 is not None and c2 - c >= 2: out.add(t)
%o A401542         c += 1
%o A401542     return sorted(out)
%o A401542 print(terms(1500))
%Y A401542 Subsequence of A138591. Cf. A069283.
%K A401542 nonn,new
%O A401542 1,1
