%I A401052 #26 Oct 20 2026 10:38:18
%S A401052 3,3,11,67,79,53,139,37,163,31,197,163,7,59,43,41,151,223,409,41,331,
%T A401052 281,359,71,443,241,197,503,241,17,941,149,719,241,401,541,1201,607,
%U A401052 1427,3,797,433,1321,811,367,947,1123,29,31,131,61,1453,409,113,1069,1879,271,1091,23,257,199,383,2473,1187,1913,149
%N A401052 Largest such q listed for each prime p (A400842) for which there exists an odd prime q <= p such that 2*((p#/p) / (q#/q)) == -1 mod p, where p# = A034386(p).
%H A401052 Antti Karttunen, <a href="/A401052/b401052.txt">Table of n, a(n) for n = 1..4005</a>
%H A401052 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401052 a(n) = A400838(A400839(n)).
%e A401052 See examples in A400842, showing the cases for a(1), a(2) and a(4).
%o A401052 (PARI)
%o A401052 A400838(n) = { my(p=prime(1+n),pr=Mod(2,p)); forstep(k=n,1,-1, if((p-1)==lift(pr), return(prime(1+k))); pr *= Mod(prime(k),p)); (0); };
%o A401052 A401052_list(first_n) = { my(v=vector(first_n), k=0); for(n=1,oo,if((t=A400838(n))>0, k++; v[k] = t; if(k==#v, return(v)))); };
%Y A401052 Nonzero terms of A400838.
%Y A401052 Subsequence of A401062.
%Y A401052 Cf. A002110, A034386, A400839, A400842.
%K A401052 nonn,changed
%O A401052 1,1
%A A401052 _Antti Karttunen_, Oct 14 2026
