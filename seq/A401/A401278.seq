%U A401278 9,2,6,4,2,10,4,8,10,4,8,9,8,19,8,0,9,2,10,8,12,10,0,6
%N A401278 Triangle read by rows: T(n,k) is the number of partitions of n which represent Chomp positions with Sprague-Grundy value k, 0 <= k < n.
%H A401278 Andrew Howroyd, <a href="/A401278/b401278.txt">Table of n, a(n) for n = 1..1275</a> (rows 1..50)
%H A401278 Wikipedia, <a href="https://en.wikipedia.org/wiki/Chomp">Chomp</a>.
%H A401278 Wikipedia, <a href="https://en.wikipedia.org/wiki/Sprague%E2%80%93Grundy_theorem">Sprague-Grundy theorem</a>.
%e A401278 Triangle begins:
%e A401278   1;
%e A401278   0, 2;
%e A401278   1, 0, 2;
%e A401278   0, 0, 1, 4;
%e A401278   3, 0, 2, 0, 2;
%e A401278   0, 3, 0, 0, 4,  4;
%e A401278   3, 0, 0, 4, 2,  2, 4;
%e A401278   2, 2, 0, 0, 2,  2, 4, 10;
%e A401278   5, 4, 2, 4, 2,  5, 6,  0, 2;
%e A401278   2, 4, 2, 0, 0, 10, 4,  8, 8, 4;
%e A401278   ...
%o A401278 (PARI)
%o A401278 ForChomp(p, f) = { for(i=1, #p, for(j=1, p[i], f(if(j==1, p[1..i-1], vectorsmall(#p, k, if(k<i, p[k], min(p[k], j-1))))) )) }
%o A401278 T(n)= { my(M=Map(), v=vector(n)); for(r=1, n, my(t=vector(r)); forpart(p=r, local(b=0); my(p1=vecsort(p,,4)); ForChomp(p1, q->if(#q,b=bitor(b, 1<<mapget(M, q)))); my(gv=valuation(b+1,2)); mapput(M, p1, gv); t[1+gv]++); v[r]=t);  v; }
%o A401278 { my(A=T(12)); for(i=1, #A, print(A[i])) }
%Y A401278 Row sums are A000041.
