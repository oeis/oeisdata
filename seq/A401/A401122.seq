%S A401122 1,3,12,40,180,625,2800,9996,44100,160524,698544,2578752,11099088,
%T A401122 41409225,176679360,664592500,2815827300,10661208844,44914183600,
%U A401122 170956003296,716830370256,2740444480228,11445589052352,43918027026160,182811491808400,703673022750000,2920656969720000
%N A401122 a(n) is the size of the annular Jones monoid of degree n.
%C A401122 The odd terms of the sequence are A000515.
%H A401122 Jang Soo Kim, <a href="https://www.mat.univie.ac.at/~slc/wpapers/s69kim.html">Cyclic sieving phenomena on annular noncrossing permutations</a>, Séminaire Lotharingien de Combinatoire 69 (2013), Article B69b. See Theorems 6.1 and 6.2, pp. 18-19.
%F A401122 a(n) = n*binomial(n-1, floor((n-1)/2))^2 + (1+(-1)^n)*A000108(floor(n/2))^2/2, for n >= 1.
%o A401122 (Python)
%o A401122 from math import comb
%o A401122 def a(n: int) -> int:
%o A401122     """Return the size of the annular Jones monoid of degree n >= 1."""
%o A401122     if n < 1:
%o A401122         raise ValueError("n must be positive")
%o A401122     size = n * comb(n - 1, (n - 1) // 2) ** 2
%o A401122     if n % 2 == 0:
%o A401122         catalan = comb(n, n // 2) // (n // 2 + 1)
%o A401122         size += catalan ** 2
%o A401122     return size
%K A401122 nonn,easy,new
%O A401122 1,2
%A A401122 _James Mitchell_, Oct 15 2026
