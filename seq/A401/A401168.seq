%I A401168 #14 Oct 27 2026 21:59:19
%S A401168 6,17,33,54,80,112,149,191,238,291,349,412,481,554,633,718,807,902,
%T A401168 1002,1107,1218,1334,1455,1582,1713,1850,1992,2140,2293,2451,2614,
%U A401168 2783,2956,3136,3320,3510,3704,3905,4110,4321,4537,4758,4985,5216,5453,5696,5943,6196
%N A401168 a(n) = least k such that 2*x^k/(1 + x^(2*k)) < 1/2, where x = u/(u+1) and u = 2*n*(n+1).
%C A401168 Physical meaning: one photon of the polarization Bell pair (|HH> + |VV>)/sqrt(2) passes through k glass faces at Brewster's angle, in glass of refractive index N = 1 + 1/n. Each face transmits all p-polarized light and the fraction (2*N/(N^2+1))^2 of s-polarized light, and 2*N/(N^2+1) = u/(u+1). The concurrence of the pair after k faces is 2*x^k/(1 + x^(2*k)), so a(n) is the least number of faces that brings the concurrence below 1/2.
%C A401168 The inequality is equivalent to x^k < 2 - sqrt(3); equality is impossible because 2 + sqrt(3) is irrational.
%H A401168 Paolo Xausa, <a href="/A401168/b401168.txt">Table of n, a(n) for n = 1..10000</a>
%F A401168 a(n) = floor(log(2+sqrt(3))/log(1+1/u)) + 1 with u = 2*n*(n+1).
%F A401168 Conjecture: a(n) = floor(log(2+sqrt(3))*(2*n^2 + 2*n + 1/2)) + 1; true for n <= 10^8.
%F A401168 a(n) ~ 2*log(2+sqrt(3))*n^2.
%e A401168 For n=1, x = 4/5; 2*x^5/(1+x^10) = 0.5918... and 2*x^6/(1+x^12) = 0.4905..., so a(1) = 6.
%t A401168 A401168[n_] := Ceiling[Log[1 + 1/(2*n*(n + 1)), 2 + Sqrt[3]]];
%t A401168 Array[A401168, 50] (* _Paolo Xausa_, Oct 27 2026 *)
%o A401168 (Python)
%o A401168 def a(n):
%o A401168     u = 2*n*(n+1)
%o A401168     def below(k): return 3*(u+1)**(2*k) < (2*(u+1)**k - u**k)**2
%o A401168     k = max(1, int(1.31695789692*(u+0.5)))
%o A401168     while k > 1 and below(k-1): k -= 1
%o A401168     while not below(k): k += 1
%o A401168     return k
%Y A401168 Cf. A001075, A046092.
%K A401168 nonn,new
%O A401168 1,1
%A A401168 _Scott M. Foltz_, Oct 16 2026
