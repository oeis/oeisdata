%N A401380 Number of distinct prime factors in the largest divisor of sigma(n^2) that are coprime with n^2, where sigma is the sum of divisors function.
%H A401380 Antti Karttunen, <a href="/A401380/b401380.txt">Table of n, a(n) for n = 1..10000</a>
%F A401380 a(n) = A401379(n^2).
%o A401380 (PARI)
%o A401380 A401379(n) = { my(f=factorback(factor(n)[,1]), g=factorback(factor(sigma(n))[,1])); omega(g/gcd(f,g)); };
%o A401380 A401380(n) = A401379(n^2);
%Y A401380 Cf. A401375, A401379, A401385 (positions of 1's).
%K A401380 nonn,easy,new
%O A401380 1,6
%A A401380 _Antti Karttunen_, Oct 31 2026
