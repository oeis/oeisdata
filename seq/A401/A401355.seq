%I A401355 #18 Nov 01 2026 09:31:34
%S A401355 1,5,6,47,53,153,665,7468,8133,23734,55601,190537,5200100,5390637,
%T A401355 53715833,59106470,112822303,397573379,2895835956,3293409335,
%U A401355 65470613321,68764022656,753110839881,2328096542299,3081207382180,11571718688839,26224644759858,457390679606425
%N A401355 Denominators of convergents to log_2(9).
%C A401355 Since log_2(9) - 3 = log_2(9/8), the continued fractions of log_2(9) and log_2(9/8) differ only in the integer part, and their convergents have the same denominators: if N(n) is the numerator of the n-th convergent to log_2(9), then (N(n) - 3*a(n))/a(n) is the n-th convergent to log_2(9/8).
%C A401355 These approximations arise in the Diophantine reduction for certain perturbations of exponent words in Collatz cycles, as studied in the linked paper; the paper does not address the Collatz conjecture in its general form.
%H A401355 Miquel Cerda, <a href="/A401355/b401355.txt">Table of n, a(n) for n = 0..1000</a>
%H A401355 Miguel Cerdá Bennassar, <a href="https://doi.org/10.5281/zenodo.23412904">Perturbaciones de la palabra (1,2)^q en los ciclos de Collatz: reducción general y obstrucciones aritméticas al cierre</a>, Zenodo, 2026 (in Spanish).
%F A401355 a(n) = A028510(n)*a(n-1) + a(n-2) for n >= 2, with a(0) = 1 and a(1) = 5.
%e A401355 The first convergents to log_2(9) are 3/1, 16/5, 19/6, 149/47, 168/53, 485/153 and 2108/665. Their denominators are the first terms of this sequence.
%t A401355 Convergents[Log2[9],28]//Denominator (* _Stefano Spezia_, Nov 01 2026 *)
%o A401355 (Python)
%o A401355 from mpmath import mp
%o A401355 def a(n):
%o A401355     mp.dps = 30 + 3*n
%o A401355     x = mp.log(9)/mp.log(2)
%o A401355     q_prev2, q_prev1 = 1, 0
%o A401355     for _ in range(n + 1):
%o A401355         t = int(mp.floor(x))
%o A401355         q = t*q_prev1 + q_prev2
%o A401355         q_prev2, q_prev1 = q_prev1, q
%o A401355         x = 1/(x-t)
%o A401355     return q_prev1
%Y A401355 Cf. A028510 (continued fraction), A020861 (decimal expansion), A005663, A005664.
%K A401355 nonn,frac,new
%O A401355 0,2
%A A401355 _Miquel Cerda_, Oct 22 2026
