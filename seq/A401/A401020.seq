%I A401020 #6 Oct 13 2026 22:38:26
%S A401020 2,7,3,11,311,71,4679,2399,1259,26879,7559,93239,42839,347759,241919,
%T A401020 1411199,262079,1081079,1441439,453599,665279,1713599,2827439,8189999,
%U A401020 6425999,6652799
%N A401020 a(n) is the least prime p such that there are exactly n numbers k such that A175508(k) = p.
%C A401020 a(n) is the least prime p such that there are exactly n numbers k such that k - the sum of its prime factors, counted by multiplicity, is p.
%e A401020 a(3) = 11 because there are 3 numbers k such that k + (sum of the prime factors of k) = 11, namely 20, 21, 26: 20 - 2 - 2 - 5 = 21 - 3 - 7 = 26 - 2 - 13 = 11, and no prime < 11 works.
%p A401020 R:= Array(0..22): R[0]:= 2:
%p A401020 P:= select(isprime, [seq(i, i=3..10^7, 2)]):
%p A401020 for x from 1 to 10^7 do
%p A401020  if ListTools:-BinarySearch(P,x) <> 0 then next fi;
%p A401020  v:= x - add(t[1]*t[2], t = ifactors(x)[2]);
%p A401020  if v <= 5*10^6 and ListTools:-BinarySearch(P, v) <> 0 then
%p A401020    if assigned(V[v]) then V[v]:= V[v]+1 else V[v]:= 1 fi;
%p A401020  fi;
%p A401020 od:
%p A401020 for p in P do
%p A401020 if assigned(V[p]) and V[p] <= 22 and R[V[p]] = 0 then R[V[p]]:= p fi
%p A401020 od:
%p A401020 convert(R, list);
%Y A401020 Cf. A175508, A399707
%K A401020 nonn,more,new
%O A401020 0,1
%A A401020 _Will Gosnell_ and _Robert Israel_, Oct 13 2026
