%I A401566 #11 Oct 29 2026 14:21:26
%S A401566 0,0,0,0,1,1,0,1,1,2,0,2,1,2,2,2,1,2,0,3,2,1,0,6,2,3,3,3,1,8,0,5,1,2,
%T A401566 2,6,1,1,2,8,1,5,0,2,4,1,0,11,1,4,1,3,1,6,4,5,2,2,0,16,1,1,4,12,3,2,0,
%U A401566 4,1,4,0,17,1,2,3,2,1,5,0,19,8,2,0,19,3
%N A401566 Number of connected symmetric quartic graphs on n nodes.
%C A401566 Graphs are simple and undirected, and are counted up to isomorphism. Here "symmetric" means vertex- and edge-transitive; half-arc-transitive graphs are included.
%C A401566 The counts through n = 640 are obtained from the complete arc-transitive and half-arc-transitive censuses of Potocnik, Spiga and Verret.
%H A401566 Eric W. Weisstein, <a href="/A401566/b401566.txt">Table of n, a(n) for n = 1..640</a>
%H A401566 P. Potocnik, <a href="https://graphsym.net/">Datasets of Highly Symmetric Objects</a>.
%H A401566 P. Potocnik, P. Spiga and G. Verret, <a href="https://users.fmf.uni-lj.si/potocnik/work_datoteke/Census4val-640.mgm">Arc-transitive tetravalent graph census through 640 vertices</a>; <a href="https://users.fmf.uni-lj.si/potocnik/ATDcensus-OnLine/Census-HAT-1k-data.csv">Half-arc-transitive graph census through 1000 vertices</a>.
%H A401566 P. Potocnik, P. Spiga and G. Verret, <a href="https://arxiv.org/abs/1010.2546">Bounding the order of the vertex-stabiliser in 3-valent vertex-transitive and 4-valent arc-transitive graphs</a>, J. Combin. Theory Ser. B 111 (2015), 148-180.
%H A401566 P. Potocnik, P. Spiga and G. Verret, <a href="https://arxiv.org/abs/1201.5317">Cubic vertex-transitive graphs on up to 1280 vertices</a>, J. Symbolic Comput. 50 (2013), 465-477.
%H A401566 P. Potocnik, P. Spiga and G. Verret, <a href="https://arxiv.org/abs/1310.6543">A census of 4-valent half-arc-transitive graphs and arc-transitive digraphs of valence two</a>, Ars Math. Contemp. 8 (2015), 133-148.
%H A401566 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/ConnectedGraph.html">Connected Graph</a>.
%H A401566 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/QuarticSymmetricGraph.html">Quartic Symmetric Graph</a>.
%H A401566 S. Wilson and P. Potocnik, <a href="https://jan.ucc.nau.edu/~swilson/C4FullSite/index.html">A Census of Edge-Transitive Tetravalent Graphs</a>; <a href="https://jan.ucc.nau.edu/~swilson/C4FullSite/BigTable.html">Table</a>.
%F A401566 a(n) = Sum_{d|n} mu(n/d)*A087101(d), where mu is the Moebius function.
%e A401566 a(5) = a(6) = 1, corresponding to K_5 and the octahedral graph, respectively.
%t A401566 Module[{arc, hat, c},
%t A401566 	arc = Counts[StringCases[Import["https://users.fmf.uni-lj.si/potocnik/work_datoteke/Census4val-640.mgm", "Text"], "AT4val[" ~~ n : DigitCharacter .. :> FromDigits[n]]];
%t A401566 	hat = Counts[Rest[Import["https://users.fmf.uni-lj.si/potocnik/ATDcensus-OnLine/Census-HAT-1k-data.csv"]][[All, 2]]];
%t A401566 	c = Lookup[arc, Range[640], 0] + Lookup[hat, Range[640], 0];
%t A401566 	c
%t A401566 ]
%Y A401566 Cf. A087101 (connected or disconnected).
%Y A401566 Cf. A401567 (disconnected).
%Y A401566 Cf. A398351 (half-arc-transitive graphs).
%K A401566 nonn,more,new
%O A401566 1,10
%A A401566 _Eric W. Weisstein_, Oct 29 2026
