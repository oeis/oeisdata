%I A401736 #10 Nov 10 2026 13:47:46
%S A401736 0,1,1,2,1,2,3,3,1,2,3,3,4,4,4,4,1,2,3,3,4,4,5,4,2,5,4,5,6,6,6,5,1,2,
%T A401736 3,3,4,4,5,4,2,5,4,6,5,6,6,7,4,4,5,5,6,6,6,7,5,6,7,6,6,7,7,6,1,2,3,3,
%U A401736 4,4,5,4,5,5,6,5,6,6,6,6,4,4,5,4,7,5,7,6,6,7,7,7,6,7,7,7,5,6,6,5
%N A401736 Main diagonal of A401735.
%C A401736 a(n) = T(n,n), where T(x,y), x,y >= 0, is the least nonnegative color c such that no square with corners (x,y), (x-d,y), (x,y-d), (x-d,y-d), 1 <= d <= min(x,y), has all four corners colored c (the array A401735).
%C A401736 T is symmetric, and T(x,y) <= min(x,y), since each smaller color needs its own side d.
%C A401736 a(0) = 0, and for n >= 1, a(n) = 1 if and only if n is a power of 2. Hence liminf a(n) = 1.
%C A401736 Every value less than a(n) occurs earlier on the diagonal: each excluded color has an earlier diagonal corner as a witness. Thus successive record values increase by 1, and their positions are A401737.
%C A401736 Conjecture: limsup a(n) = infinity. This would follow from the conjecture in A401735 that every color first appears on the diagonal (verified for x <= 32769, for x >= 16384 by one computation only).
%C A401736 a(n) >= 3 for n == 3 (mod 4), n >= 7 (use k = 0, 1, 3 in the recursion in the formula section). Computer-assisted: rows 0..130 of A401735 are 245760-periodic from column 1935036 (certified, see A399521 and A401738), and for n = 2163834 the terms with k <= 130 of that recursion already exclude colors 0..8. Hence a(n) >= 9 for all n = 2163834 + 245760*j, j >= 0, so a(n) >= 9 infinitely often.
%C A401736 The maximum for 0 <= n <= 32769 is 33. All terms for n <= 32769 were computed by two separate programs, and terms through n = 16383 also by a third that does not use the symmetry.
%H A401736 Alper Ferudun, <a href="/A401736/b401736.txt">Table of n, a(n) for n = 0..9999</a>
%F A401736 T(x,y) = mex{c : T(x-d,y) = T(x,y-d) = T(x-d,y-d) = c for some 1 <= d <= min(x,y)}, where mex is the least missing nonnegative integer.
%F A401736 a(n) = mex{a(k): 0 <= k < n, T(n,k) = a(k)}.
%F A401736 a(n) <= 1 + max{a(k): 0 <= k < n} for n >= 1.
%e A401736 a(3) = 2: the square of side 3 excludes color 0, while the squares of sides 2 and 1 each exclude color 1. No square excludes color 2.
%o A401736 (Python)
%o A401736 def A(N):  # [a(0), ..., a(N-1)], a(n) = T(n,n)
%o A401736     T = [[0]*N for _ in range(N)]  # T[y][x] = T(x,y), filled row by row
%o A401736     for y in range(N):
%o A401736         for x in range(N):
%o A401736             s = {T[y][x-d] for d in range(1, min(x, y)+1) if T[y][x-d] == T[y-d][x] == T[y-d][x-d]}
%o A401736             T[y][x] = min(set(range(len(s)+1)) - s)
%o A401736     return [T[n][n] for n in range(N)]
%o A401736 print(A(130))
%o A401736 (Python)
%o A401736 def A(N):  # [a(0), ..., a(N-1)], a(n) = T(n,n)
%o A401736     # Masks hold colors c >= 1 only; color-0 slots stay empty.
%o A401736     R = [[0] for _ in range(N)]  # Bit N-1-j in R[i][c] means T(i,j)=c.
%o A401736     S = [[0] for _ in range(2*N-1)]  # Bit j in S[s][c] means T(s-j,j)=c.
%o A401736     a = [0]*N
%o A401736     for x in range(1, N):
%o A401736         r, bx, rx = R[x], 1 << x, 1 << (N-1-x)
%o A401736         # T(x,y)=0 iff x & y == 0; see the proof in A401735.
%o A401736         zero, bit = 1, 1
%o A401736         while bit <= x:
%o A401736             if not x & bit:
%o A401736                 zero |= zero << bit
%o A401736             bit <<= 1
%o A401736         left = ((1 << (x+1))-1) ^ zero
%o A401736         c = 1
%o A401736         # Process colors in order, leftmost admissible cell first.
%o A401736         # All smaller colors are excluded at cells left: hence mex.
%o A401736         while left:
%o A401736             if c == len(r):
%o A401736                 for v in R+S:
%o A401736                     v.append(0)
%o A401736             available = left
%o A401736             while available:
%o A401736                 bit = available & -available
%o A401736                 y = bit.bit_length()-1
%o A401736                 left ^= bit
%o A401736                 r[c] |= 1 << (N-1-y)
%o A401736                 # Symmetry: T(y,x)=T(x,y); transpose the recurrence.
%o A401736                 R[y][c] |= rx
%o A401736                 s = S[x+y]
%o A401736                 s[c] |= bit | bx
%o A401736                 e = N-1-x-y
%o A401736                 q = R[y][c]
%o A401736                 # Remove this cell and later cells making a square of color c.
%o A401736                 available &= ~(s[c] & (q >> e if e >= 0 else q << -e))
%o A401736                 if y == x:
%o A401736                     a[x] = c
%o A401736             c += 1
%o A401736     return a
%o A401736 print(A(130))
%Y A401736 Cf. A399521 (row periods), A401735 (array), A401737 (first occurrences), A401738 (row preperiods), A401739 (periods of the color-1 indicators).
