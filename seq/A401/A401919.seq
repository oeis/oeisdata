%S A401919 0,1,2,0,1,3,2,1,1,7,1,4,9,3,8,0,8,5,18,8,11,13,15,5,2,23,0,4,17,9,19,
%T A401919 1,14,9,1,0,11,19,11,9,6,33,26,14,10,39,35,0,4,3,44,24,27,1,51,5,20,
%U A401919 47,15,10,55,51,13,0,41,15,30,10,17,37,24,1,28,49,14,20,9,51,4,0,2,7,47,34,31,27,77,15,56,11
%N A401919 a(n) = A276085(n) mod A007947(n), where A276085 is fully additive with a(p) = p#/p, and A007947 is squarefree kernel (rad).
%H A401919 Antti Karttunen, <a href="/A401919/b401919.txt">Table of n, a(n) for n = 1..19683</a>
%H A401919 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%o A401919 (PARI)
%o A401919 A007947(n) = factorback(factorint(n)[, 1]);
%o A401919 A276085_mod_m(n,m) = if(1==n,0,my(f = factor(n),lp=f[#f~,1],pr=1,s=0,k=1); forprime(p=2,lp,if(f[k,1]==p, s += f[k,2]*pr; s %= m; k++); pr *= p; pr %= m); (s));
%o A401919 A401919(n) = A276085_mod_m(n,A007947(n));
%Y A401919 Cf. A007947, A276085, A062347 [= a(A000040(1+n))], A401920 (positions of 0's).
%Y A401919 Cf. also A372576, A373148, A401066, A401724, A401934
%K A401919 nonn,easy,new
%O A401919 1,3
%A A401919 _Antti Karttunen_, Nov 16 2026
