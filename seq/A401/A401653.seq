%U A401653 9131985902719651485,423376987247219610413,20846277077326332297831,1086411608933437292488815
%N A401653 a(0) = 1; a(n) = Sum_{k=1..n} binomial(2*n+k-2,k) * a(n-k).
%F A401653 G.f. A(x) satisfies A(x) = (1-3*x)/(1-x)^2 * (2*A(x*(1-x)^2) - 1).
%o A401653 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(2*i+j-2, j)*v[i-j+1])); v;
