%I A401102 #16 Oct 18 2026 14:05:13
%S A401102 20,210,2110,21100,211000,2110000,21100010,211000110,2110001110,
%T A401102 21100011100,211000111010,2110001110100,21100011101010,
%U A401102 211000111010100,2110001110101000,21100011101010000,211000111010100010,2110001110101000110,21100011101010001110,211000111010100011110
%N A401102 Base-5/2 expression (A024632) of 5*A401100(n).
%C A401102 a(n) is the base-5/2 expression of the least number with n+2 digits.
%C A401102 c*10^n - 1/9 < a(n)/10 < c*10^n for some constant c; cf. the comment in A061419 applied to {a(n)/10}, with alpha = 10, a = 0, and b = 1.
%H A401102 Jianing Song, <a href="/A401102/b401102.txt">Table of n, a(n) for n = 0..998</a>
%F A401102 Let b(n) = A401100(n).
%F A401102 If b(n-1) is even, then 5*b(n) = 5*(5*b(n-1))/2, and so a(n) ends in 00 (i.e., a(n) = 10*a(n-1));
%F A401102 If b(n-1) is odd, then 5*b(n) = 5*(5*b(n-1))/2 + 5/2, and so a(n) ends in 10 (i.e., a(n) = 10*a(n-1) + 10).
%F A401102 a(n) = A401101(n) + (5*10^(n+1) - 2)/3 = A401101(n) + A246057(n+1).
%e A401102 n | 5*A401100(n) | Base-5/2 expression
%e A401102 0 |         5    |              20
%e A401102 1 |        15    |             210
%e A401102 2 |        40    |            2110
%e A401102 3 |       100    |           21100
%e A401102 4 |       250    |          211000
%e A401102 5 |       625    |         2110000
%e A401102 6 |      1565    |        21100010
%e A401102 7 |      3915    |       211000110
%e A401102 8 |      9790    |      2110001110
%e A401102 9 |     24475    |     21100011100
%o A401102 (PARI) A401102_up_to_N(N) = my(v = vector(N+1), A401100_N = 1); v[1] = 20; for(n=1, N, v[n+1] = 10*v[n] + 10*(A401100_N % 2); A401100_N = ceil(5*A401100_N/2)); v \\ gives a(0..N)
%Y A401102 Cf. A024632, A401100, A401101.
%K A401102 nonn,base,new
%O A401102 0,1
%A A401102 _Jianing Song_, Oct 14 2026
