%I A401314 #13 Oct 27 2026 21:59:37
%S A401314 1,0,11,3,5,1,14,10,16,12,85,8,14,4,20,11,16,6,90,13,13,2,19,9,92,15,
%T A401314 26,88,4,11,73,84,94,17,69,7,90,13,23,24,75,86,35,19,19,9,30,82,92,15,
%U A401314 9,16,26,5,16,89,37,21,63,22,11,12,33,85,94,17,95,18,18
%N A401314 Number of steps for n to reach 1 under the map x -> 3x+1 if x is an even integer, x -> (x-1)/4 if x is an odd integer, x -> 6x+2 if x is half an odd integer.
%C A401314 The set of nonnegative integers and halves of odd integers is closed under the map, and 1 -> 0 -> 1 is a cycle.
%C A401314 On odd integers, the first return to an odd integer is n -> (3n+1)/2^v, where 2^v is the highest power of 2 dividing 3n+1 (the Syracuse form of the Collatz map), when n is not congruent to 5 mod 8, and n -> (n-1)/4 when n == 5 (mod 8). Thus the map agrees with the accelerated Collatz map on odd numbers except in the class 5 mod 8, where the 2-adic valuation of 3n+1 is unbounded, and there it is replaced by a fixed contraction.
%C A401314 It is conjectured that every n >= 0 reaches 1; this has been verified for n <= 2*10^6.
%H A401314 Miquel Cerda, <a href="/A401314/b401314.txt">Table of n, a(n) for n = 0..10000</a>
%H A401314 Miguel Cerdá Bennassar, <a href="https://doi.org/10.5281/zenodo.23490957">Un sistema dinámico sobre enteros y mitades de impares</a> [A dynamical system on integers and halves of odd integers], Zenodo, 2026 (in Spanish).
%F A401314 a(1) = 0, and for n != 1:
%F A401314 a(n) = 1 + a(3n+1) if n is even;
%F A401314 a(n) = 2 + a((3n+1)/2) if n == 3 (mod 4);
%F A401314 a(n) = 1 + a((n-1)/4) if n == 1 (mod 4).
%e A401314 a(7) = 10: 7 -> 3/2 -> 11 -> 5/2 -> 17 -> 4 -> 13 -> 3 -> 1/2 -> 5 -> 1.
%t A401314 A401314[n_] := Length[NestWhileList[Which[EvenQ[#], 3*# + 1, OddQ[#], (# - 1)/4, True, 6*# + 2] &, n, # != 1 &]] - 1;
%t A401314 Array[A401314, 100, 0] (* _Paolo Xausa_, Oct 27 2026 *)
%t A401314 (* Alternative: *)
%t A401314 A401314[n_] := A401314[n] = If[n == 1, 0, 1 + Switch[Mod[n, 4], 3, 1 + A401314[(3*n + 1)/2], 1, A401314[(n - 1)/4] , _, A401314[3*n + 1]]];
%t A401314 Array[A401314, 100, 0] (* _Paolo Xausa_, Oct 27 2026 *)
%o A401314 (PARI) a(n) = my(y=2*n, k=0); while(y!=2, if(y%2, y=6*y+4, if((y/2)%2==0, y=3*y+2, y=(y-2)/4)); k++); k
%o A401314 (Python)
%o A401314 def a(n):
%o A401314     y, k = 2*n, 0   # y = 2x
%o A401314     while y != 2:
%o A401314         if y % 2: y = 6*y + 4
%o A401314         elif (y//2) % 2 == 0: y = 3*y + 2
%o A401314         else: y = (y - 2)//4
%o A401314         k += 1
%o A401314     return k
%Y A401314 Cf. A006577, A006370.
%K A401314 nonn,new
%O A401314 0,3
