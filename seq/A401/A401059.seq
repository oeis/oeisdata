%I A401059 #15 Oct 20 2026 10:37:58
%S A401059 1,6,7,10,29,30,31,36,40,47,48,49,52,53,54,59,61,66,69,81,90,91,102,
%T A401059 104,107,115,117,121,142,148,154,155,169,174,181,184,192,198,203,214,
%U A401059 227,232,239,241,243,247,260,264,267,269,274,294,303,310,313,324,325,335,339,363,370,371,375,379,382,392,411,419,428,429
%N A401059 Numbers k such that for p = prime(1+k), there is at least one prime q <= p such that 2*((p#/p) / (q#/q)) == -1 mod p, where p# = A034386(p).
%C A401059 Union of A400839 and {6, 52, 59722, any others?}. See comments in A401054.
%H A401059 Antti Karttunen, <a href="/A401059/b401059.txt">Table of n, a(n) for n = 1..4102</a>
%H A401059 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401059 a(n) = A000720(A400843(n))-1.
%o A401059 (PARI)
%o A401059 A401053(n) = { my(p=prime(1+n), pr=2, c=0); forstep(k=n, 1, -1, c += ((p-1)==pr); pr *= prime(k); pr %= p); (c+((p-1)==pr)); };
%o A401059 is_A401059(k) = (A401053(k)>0);
%o A401059 (PARI) is_A401059(n) = { my(p=prime(1+n), pr=2); forstep(k=n, 1, -1, if((p-1)==pr,return(1)); pr *= prime(k); pr %= p); ((p-1)==pr); };
%Y A401059 Positions of strictly positive terms in A401053.
%Y A401059 Cf. A000720, A002110, A034386, A400843 [= A000040(1+a(n))], A401054, A401062 (the largest such prime q found).
%Y A401059 Cf. A400839 (subsequence).
%K A401059 nonn,new
%O A401059 1,2
%A A401059 _Antti Karttunen_, Oct 17 2026
