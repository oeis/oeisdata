%I A401930 #13 Nov 17 2026 18:07:56
%S A401930 2,3,4,5,9,8,7,25,27,16,11,49,125,81,6,13,121,343,625,32,64,17,169,
%T A401930 1331,2401,243,729,10,19,289,2197,14641,3125,15625,18,12,23,361,4913,
%U A401930 28561,16807,117649,128,15,14,29,529,6859,83521,161051,1771561,2187,256,50,21,31,841,12167,130321,371293,4826809,78125,6561,54,36,24
%N A401930 Square array A(n,k) read by descending antidiagonals where A(n,k) is the k-th solution x to A342001(x) = n.
%C A401930 Permutation of natural numbers larger than 1.
%e A401930 The top left corner of the array:
%e A401930   n\k|  1    2      3       4        5          6
%e A401930 -----+--------------------------------------------------
%e A401930    1 |  2,   3,     5,      7,      11,        13,  ...
%e A401930    2 |  4,   9,    25,     49,     121,       169,  ...
%e A401930    3 |  8,  27,   125,    343,    1331,      2197,  ...
%e A401930    4 | 16,  81,   625,   2401,   14641,     28561,  ...
%e A401930    5 |  6,  32,   243,   3125,   16807,    161051,  ...
%e A401930    6 | 64, 729, 15625, 117649, 1771561,   4826809,  ...
%e A401930    7 | 10,  18,   128,   2187,   78125,    823543,  ...
%e A401930    8 | 12,  15,   256,   6561,  390625,   5764801,  ...
%e A401930    9 | 14,  50,    54,    512,   19683,   1953125,  ...
%e A401930   10 | 21,  36,  1024,  59049, 9765625, 282475249,  ...
%e A401930   11 | 24,  75,    98,    162,     250,      2048,  ...
%e A401930   12 | 20,  35,   108,   4096,  531441, 244140625,  ...
%e A401930 Primes, A000040, occur as the row 1, as only for primes p, A342001(p) = 1.
%e A401930 Row 23 begins as: 56, 384, 405, 722, 845, 867, 2592, 3087, 5000, 9826, 17496, 43923, 46875, 118098, 742586, 3543122, 3906250, 8388608, 11529602, etc. Note that here even after the term 2^23 = 8388608, we know that there occurs a term that is not a prime power, as 11529602 = 2 * 7^8.
%e A401930 Row 25 begins as: 46, 99, 392, 847, 1083, 1152, 7776, 13718, 25000, 28125, 52488, 85683, 167042, 352947, 354294, 9653618, 19531250, 33554432, 38974342, 80707214, with at least two terms after 2^25, namely 38974342 (2 * 11^7) and 80707214 (2 * 7^9) that are not prime powers.
%o A401930 (PARI)
%o A401930 up_to = 66;
%o A401930 A342001(n) = { my(f=factor(n)); (sum(i=1, #f~, f[i, 2]/f[i, 1]) * factorback(f[, 1])); };
%o A401930 memoA401930sq = Map();
%o A401930 A401930sq(n, k) = { my(v=0); if(!mapisdefined(memoA401930sq,[n,k-1],&v),if(1==k, v=0, v = A401930sq(n, k-1))); for(i=1+v,oo,if(A342001(i)==n,mapput(memoA401930sq,[n,k],i); return(i))); };
%o A401930 A401930list(up_to) = { my(v = vector(up_to), i=0); for(a=1,oo, for(col=1,a, i++; if(i > up_to, return(v)); v[i] = A401930sq(col,(a-(col-1))))); (v); };
%o A401930 v401930 = A401930list(up_to);
%o A401930 A401930(n) = v401930[n];
%Y A401930 Cf. A342001.
%Y A401930 Cf. A401921 (column 1), A000040 (row 1), and also most likely the following rows are: A001248 (row 2), A030078, A030514, A030516 (row 6).
%Y A401930 Cf. A401931 (the number of terms in the beginning of row n that are not prime powers, i.e., one less than the index of 2^n on row n), A401932 (the last term before the first prime power of the row n, or 0 if the row begins with 2^n).
%Y A401930 Cf. also A182945, A328250.
%K A401930 nonn,tabl,new
%O A401930 1,1
