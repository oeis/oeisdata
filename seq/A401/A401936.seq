%S A401936 8,52,4,64,160,26,28,1936,248,1040,308,32,104,26,16,1664,1360,124,304,
%T A401936 1280,42,22,230,968,3800,676,468,224,3712,104,589,69952,154,8840,80,
%U A401936 1984,2072,1976,468,38720,7216,39,1376,2464,992,1495,47,832,2744,24700,136,832,4240,3042,880,616,456,24128,7316,128,16592
%N A401936 Numerator of ratio 2*n*sigma(A003961(2*n)) / sigma(2*n)*A003961(2*n), where sigma is the sum of divisors of n, and A003961 shifts the prime factorization of n one step towards larger primes.
%C A401936 By the lemma given in A341529, A401936(n)/A401937(n), like all ratios for arrays A341626/A341627, is confined to open interval (0.5 .. 1). See the plot.
%H A401936 Antti Karttunen, <a href="/A401936/b401936.txt">Table of n, a(n) for n = 1..10000</a>
%H A401936 Antti Karttunen, <a href="https://oeis.org/plot2a?name1=A401936&amp;name2=A401937&amp;tform1=untransformed&amp;tform2=untransformed&amp;shift=0&amp;radiop1=ratio&amp;drawpoints=true">Ratio A401936(n)/A401937(n) plotted with OEIS Plot tool</a>
%H A401936 <a href="/index/Pri#prime_indices">Index entries for sequences computed from indices in prime factorization</a>.
%H A401936 <a href="/index/Si#SIGMAN">Index entries for sequences related to sigma(n)</a>.
%F A401936 a(n) = A341526(2*n).
%o A401936 (PARI)
%o A401936 A003961(n) = { my(f=factor(n)); for(i=1, #f~, f[i, 1] = nextprime(f[i, 1]+1)); factorback(f); };
%o A401936 A341526(n) = { my(s=A003961(n)); numerator((sigma(s)*n)/(sigma(n)*s)); };
%o A401936 A401936(n) = A341526(2*n);
%Y A401936 Even bisection of A341526.
%Y A401936 Top row of array A341626.
%Y A401936 Cf. A000203, A003961, A341528, A341529, A401937 (denominators).
%Y A401936 Cf. also A402586.
%K A401936 nonn,easy,frac,new
%O A401936 1,1
%A A401936 _Antti Karttunen_, Nov 21 2026
