%I A401652 #14 Nov 12 2026 16:27:59
%S A401652 1,3,6,5,10,9,16,15,24,23,34,33,46,45,60,59,76,75,94,93,114,113,136,
%T A401652 135,160,159,186,185,214,213,244,243,276,275,310,309,346,345,384,383,
%U A401652 424,423,466,465,510,509,556,555,604,603,654,653,706,705,760,759,816,815,874,873
%N A401652 a(1) = 1; for n > 1: if a(n-1) is odd, a(n) = a(n-1) + n else a(n) = a(n-1) - 1.
%H A401652 Vincenzo Manto, <a href="/A401652/b401652.txt">Table of n, a(n) for n = 1..10000</a>
%H A401652 Vincenzo Manto, <a href="/A401652/a401652.png">a(n) vs n and phase of a(n) graphs</a>
%H A401652 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (1,2,-2,-1,1).
%F A401652 When a(n-1) is odd, a(n) = a(n-1) + n. When a(n-1) is even, a(n) = a(n-1) - 1.
%F A401652 From _Jason Yuen_, Nov 07 2026: (Start)
%F A401652 a(n) = (n^2-2*n+12)/4 if n is even.
%F A401652 a(n) = (n^2+15)/4 if n is odd and n > 1. (End)
%F A401652 From _Stefano Spezia_, Nov 07 2026: (Start)
%F A401652 G.f.: x*(1 + 2*x + x^2 - 5*x^3 + 3*x^5)/((1 - x)^3*(1 + x)^2).
%F A401652 E.g.f.: ((12 + x + x^2)*cosh(x) + (15 - x + x^2)*sinh(x) - 12*(1 + x))/4. (End)
%e A401652 For n = 2: a(1) is odd (1), so a(2) = 1 + 2 = 3.
%e A401652 For n = 3: a(2) is odd (3), so a(3) = 3 + 3 = 6.
%e A401652 For n = 4: a(3) is even (6), so a(4) = 6 - 1 = 5.
%e A401652 For n = 5: a(4) is odd (5), so a(5) = 5 + 5 = 10.
%t A401652 s={1};Do[If[OddQ[s[[-1]]],AppendTo[s,s[[-1]]+n],AppendTo[s,s[[-1]]-1]],{n,2,60}];s
%o A401652 (Python)
%o A401652 def generate_sequence(size, a1=1):
%o A401652   a = [0] * (size + 1)
%o A401652   a[1] = a1
%o A401652   for n in range(2, size + 1):
%o A401652     prev = a[n - 1]
%o A401652     if prev % 2 != 0:
%o A401652       a[n] = prev + n
%o A401652     else:
%o A401652       a[n] = prev - 1
%o A401652   return a[1:]
%o A401652 print(generate_sequence(60))
%Y A401652 Cf. A400113, A400485, A006370.
%K A401652 nonn,easy,new
%O A401652 1,2
%A A401652 _Vincenzo Manto_ and _James C. McMahon_, Nov 01 2026
