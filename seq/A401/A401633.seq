%I A401633 #12 Nov 01 2026 10:46:34
%S A401633 0,2,40,588,8160,114950,1688232,26120920,427329408,7396069770,
%T A401633 135305277800,2612259955492,53123579839200,1135703872355598,
%U A401633 25473536851378280,598308351844378800,14688430323702226432,376257908728901075730,10040264821823443588008,278667642830713585446140
%N A401633 a(n) = 2*(binomial(n+1, 3) + binomial(n, 3))*Sum_{m=0..n-2} binomial(n-2, m)*(n - 1)!/(n - m - 2)!.
%C A401633 a(n) is the total cross work on the symmetric inverse semigroup I_n (see Udo et al.).
%H A401633 Nsibiet E. Udo, Victor A. Owai, and Moses O. Francis, <a href="https://arxiv.org/abs/2610.34902">Cross work induced by transformations on the symmetric group and related transformation semigroups</a>, arXiv:2610.34902 [math.CO], 2026. See Table 2 on page 18.
%F A401633 a(n) = (n*(2*n^2-3*n+1)/3)*Sum_{m=0..n-2} binomial(n-2, m)*(n - 1)!/(n - m - 2)!.
%F A401633 a(n) = (-1)^n*(n - 1)*n*(2*n^2 - 3*n + 1)*U(2-n, 1, -1)/3, where U is the Tricomi confluent hypergeometric function.
%F A401633 From _Vaclav Kotesovec_, Nov 01 2026: (Start)
%F A401633 Recurrence: (n-2)*(2*n - 5)*(2*n - 3)*a(n) = 2*(n-1)*n*(2*n - 5)*(2*n - 1)*a(n-1) - (n-1)^2*n*(2*n - 3)*(2*n - 1)*a(n-2).
%F A401633 a(n) ~ (sqrt(2)/3) * exp(2*sqrt(n) - n - 1/2) * n^(n + 9/4) * (1 - 65/(48*sqrt(n))). (End)
%t A401633 a[n_]:=(n*(2*n^2-3*n+1)/3)*Sum[Binomial[n-2,m]*(n-1)!/(n-m-2)!,{m,0,n-2}]; Array[a,20]
%t A401633 (* Alternative: *)
%t A401633 a[n_]:=(-1)^n*n*(n-1)*(2*n^2-3*n+1)*HypergeometricU[2-n, 1, -1]/3; Array[a,20]
%Y A401633 Cf. A000292, A000330, A014105, A098077.
%Y A401633 Cf. A401630, A401631, A401632, A401634.
%K A401633 nonn,new
