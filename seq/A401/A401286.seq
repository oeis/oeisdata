%I A401286 #14 Nov 09 2026 21:02:45
%S A401286 3,9,60,162,981,2619,15726,41940,251655,671085,4026528,10737414,
%T A401286 64424505,171798687,1030792146,2748779064,16492674411,43980465105,
%U A401286 263882790660,703687441770,4222124650653,11258999068419,67553994410550,180143985094812,1080863910568911
%N A401286 Number of nonempty convex vertex sets in the n X n white bishop graph.
%H A401286 Andrew Howroyd, <a href="/A401286/b401286.txt">Table of n, a(n) for n = 2..1000</a>
%H A401286 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/WhiteBishopGraph.html">White Bishop Graph</a>.
%H A401286 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (1,17,-17,-16,16).
%F A401286 a(n) = (12*4^n - 15*n - 12)/50 for even n; a(n) = (8*4^n - 15*n - 17)/50 for odd n.
%F A401286 a(n) = a(n-1) + 17*a(n-2) - 17*a(n-3) - 16*a(n-4) + 16*a(n-5).
%F A401286 G.f.: 3*x^2*(1 + 2*x)/((1 - x)^2*(1 + x)*(1 - 4*x)*(1 + 4*x)).
%t A401286 LinearRecurrence[{1, 17, -17, -16, 16}, {3, 9, 60, 162, 981}, 30] (* _Paolo Xausa_, Nov 09 2026 *)
%o A401286 (PARI) \\ RookConvexSets, Bishop defined in A401285.
%o A401286 a(n) = RookConvexSets(Bishop(n, 1))
%o A401286 (PARI) a(n) = if(n%2, 8*4^n - 15*n - 17, 12*4^n - 15*n - 12)/50
%Y A401286 Cf. A401285.
%K A401286 nonn,easy,new
%O A401286 2,1
%A A401286 _Andrew Howroyd_, Nov 05 2026
