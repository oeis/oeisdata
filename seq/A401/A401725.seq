%I A401725 #7 Nov 08 2026 18:53:05
%S A401725 1,2,3,4,5,7,8,9,10,11,13,15,16,17,19,23,25,27,28,29,31,32,35,37,41,
%T A401725 43,47,49,53,59,61,63,64,67,71,73,79,81,83,89,91,97,100,101,103,107,
%U A401725 109,113,121,125,127,128,131,137,139,143,149,151,155,157,161,163,167,169,173,179,181,187,191,193,197,199,203
%N A401725 Numbers k such that A276085(k) is a multiple of A342001(k), where A342001(k) = A003415(k)/A003557(k), and A276085 is fully additive with a(p) = p#/p.
%H A401725 Antti Karttunen, <a href="/A401725/b401725.txt">Table of n, a(n) for n = 1..10000</a>
%H A401725 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%o A401725 (PARI)
%o A401725 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A401725 A003557(n) = (n/factorback(factorint(n)[, 1]));
%o A401725 A342001(n) = (A003415(n) / A003557(n));
%o A401725 A276085_mod_m(n,m) = if(1==n,0,my(f = factor(n),lp=f[#f~,1],pr=1,s=0,k=1); forprime(p=2,lp,if(f[k,1]==p, s += f[k,2]*pr; s %= m; k++); pr *= p; pr %= m); (s));
%o A401725 is_A401725(k) = ((1==k) || (0==A276085_mod_m(k,A342001(k))));
%Y A401725 After the initial 1, gives the positions of 0's in A401724.
%Y A401725 Cf. A003415, A003557, A276085, A342001.
%Y A401725 Subsequences: A000040, A373487, A401719, A401726.
%K A401725 nonn,new
%O A401725 1,2
%A A401725 _Antti Karttunen_, Nov 08 2026
