%I A401412 #6 Nov 01 2026 16:53:12
%S A401412 1,2,3,3,5,6,8,8,12,12,16,16,21,21,27,26,33,33,40,39,48,47,56,54,65,
%T A401412 64,75,73,85,81,96,94,108,106,120,118,133,131,147,144,161,156,176,173,
%U A401412 192,189,208,202,225,222,243,239,261,258,280,276,300,296,320,310
%N A401412 Number of distinct adjacency eigenvalues of the triangular lattice on an n X n torus (n^2 vertices).
%C A401412 The adjacency eigenvalues are 2*cos(2*Pi*i/n) + 2*cos(2*Pi*j/n) + 2*cos(2*Pi*(i+j)/n), 0 <= i,j <= n-1, so a(n) is the number of distinct values of this sum with 0 <= i <= j <= n-1.
%C A401412 For n >= 3 the graph is 6-regular, so a(n) is also the number of distinct Laplacian eigenvalues.
%C A401412 For n = 1 the graph is a single vertex with 3 loops (eigenvalue 6); for n = 2 it is K_4 with every edge doubled (eigenvalues 6, -2, -2, -2). The spectral formula still gives a(n).
%C A401412 Coincidences among the eigenvalues come from vanishing sums of roots of unity (Conway and Jones).
%H A401412 J. H. Conway and A. J. Jones, <a href="http://eudml.org/doc/205475">Trigonometric diophantine equations (On vanishing sums of roots of unity)</a>, Acta Arithmetica 30 (1976), 229-240.
%e A401412 For n = 3, the sums take the values 6 (i = j = 0), 0 (for example i = 0, j = 1) and -3 (i = j = 1), so a(3) = 3.
%o A401412 (Python)
%o A401412 from sympy import cyclotomic_poly, Poly, symbols
%o A401412 def a(n):
%o A401412     z = symbols('z'); P = Poly(cyclotomic_poly(n, z), z)
%o A401412     def red(exps):
%o A401412         c = [0]*n
%o A401412         for e in exps: c[e % n] += 1
%o A401412         return tuple(Poly(c[::-1], z).rem(P).all_coeffs())
%o A401412     return len({red([i, -i, j, -j, i+j, -i-j]) for i in range(n) for j in range(i, n)})
%o A401412 (PARI) a(n) = my(P=polcyclo(n,x), e(m)=x^(m%n), S=List()); for(i=0, n-1, for(j=i, n-1, listput(S, lift(Mod(e(i)+e(-i)+e(j)+e(-j)+e(i+j)+e(-i-j), P))))); #Set(S)
%Y A401412 Cf. A395911, A399677, A401170.
%K A401412 nonn,new
%O A401412 1,2
