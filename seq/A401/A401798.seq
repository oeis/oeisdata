%I A401798 #11 Nov 19 2026 22:09:02
%S A401798 1,1,1,1,3,1,1,7,7,1,1,15,27,15,1,1,31,81,81,31,1,1,63,213,303,213,63,
%T A401798 1,1,127,519,939,939,519,127,1,1,255,1207,2607,3307,2607,1207,255,1,1,
%U A401798 511,2725,6757,10201,10201,6757,2725,511,1,1,1023,6033,16743,28923,34383,28923,16743,6033,1023,1
%N A401798 Triangle read by rows: T(n,k) is the number of nonempty convex vertex sets in the Johnson graph J(n, k).
%C A401798 A vertex set in a Johnson graph is convex if it is a clique or if it is a sub-Johnson graph. A sub-Johnson graph J(n,k) is not a clique if 1 < k < n-1.
%H A401798 Andrew Howroyd, <a href="/A401798/b401798.txt">Table of n, a(n) for n = 0..1325</a> (rows 0..50)
%H A401798 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/JohnsonGraph.html">Johnson Graph</a>.
%H A401798 Wikipedia, <a href="https://en.wikipedia.org/wiki/Johnson_graph">Johnson graph</a>.
%F A401798 T(n,k) = T(n,n-k).
%F A401798 T(n,k) >= A401871(n,k) - 1.
%e A401798 Triangle begins:
%e A401798   1;
%e A401798   1,   1;
%e A401798   1,   3,    1;
%e A401798   1,   7,    7,    1;
%e A401798   1,  15,   27,   15,     1;
%e A401798   1,  31,   81,   81,    31,     1;
%e A401798   1,  63,  213,  303,   213,    63,    1;
%e A401798   1, 127,  519,  939,   939,   519,  127,    1;
%e A401798   1, 255, 1207, 2607,  3307,  2607, 1207,  255,   1;
%e A401798   1, 511, 2725, 6757, 10201, 10201, 6757, 2725, 511, 1;
%e A401798   ...
%o A401798 (PARI) \\ C(n,k) is A401871(n,k) - 1
%o A401798 C(n,k) = binomial(n, k)*((2^(k+1)-1)*(n-k)/(k+1) + (2^(n-k+1)-1)*k/(n-k+1) - (n-1) - k*(n-k)/2)
%o A401798 D(n,k) = sum(i=4, n, binomial(n,i) * sum(j=2, min(i-2,k), binomial(n-i,k-j)))
%o A401798 T(n,k) = C(n,k) + D(n,k)
%Y A401798 Columns k=0..3 are A000012, A000225, A338230 (n-triangular graph), A401799 (n-tetrahedral graph).
%Y A401798 Cf. A401871.
%K A401798 nonn,tabl,new
%O A401798 0,5
%A A401798 _Andrew Howroyd_, Nov 09 2026
