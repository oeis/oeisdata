%U A401452 21557816749990824984425855880,57201801255727138416863255878080,179070723964749563338144248571257000,653084189389384091112092321856975660000
%N A401452 Number of Young tableaux with walls of period n whose basic blocks are Z3, where Z3 is a special class of Young diagram with walls of shape 2 X 2.
%C A401452 The number of Young tableaux with walls of period n whose basic blocks are Z3, where Z3 is a special class of Young diagram with walls of shape 2 X 2. Z3 is given explicitly in paper: [Banderier and Wallner, 2021].
%H A401452 Karan Sharma, <a href="/A401452/b401452.txt">Table of n, a(n) for n = 1..199</a>
%H A401452 Cyril Banderier and Michael Wallner, <a href="https://www.mat.univie.ac.at/~slc/wpapers/FPSAC2021/47.html">Young tableaux with periodic walls: counting with the density method</a>, Séminaire Lotharingien de Combinatoire 85B (2021), Article #47.
%H A401452 Feihu Liu, Jiahang Liu, and Guoce Xin, <a href="https://arxiv.org/abs/2610.35067">Two families of Young tableaux with periodic walls: Counting formulas and differential transcendence</a>, arXiv:2610.35067 [math.CO], (2026).
%F A401452 a(n+1) = (4n)! * Integral_{0 < t_1 < t_2 < ... < t_{2n} < 1} (1 - t_1) * Product_{k=2..n} (1 - t_{2k-1}^2)/2 dt_1 ... dt_{2n}, where t_1, ..., t_{2n} are the entries of the top row.
%o A401452 (Python)
%o A401452 from sympy import symbols, integrate, factorial, Integer
%o A401452 x, y = symbols('x y')
%o A401452 def up(f):  # integral of f(y) for y from x to 1
%o A401452     return integrate(f.subs(x, y), (y, x, 1))
%o A401452 def a(n):
%o A401452     f = Integer(1)
%o A401452     for k in range(n-1, 0, -1):  # blocks from right to left
%o A401452         f = up(f)  # top-right cell
%o A401452         w = (1 - x) if k == 1 else (1 - x**2)/2
%o A401452         f = up(f*w)  # top-left cell
%o A401452     return factorial(4*(n-1)) * f.subs(x, 0)
%o A401452 print([a(n) for n in range(1, 15)])  # _Karan Sharma_, Oct 25 2026
%Y A401452 Cf. A211212, A213863.
