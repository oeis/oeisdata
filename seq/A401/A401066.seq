%S A401066 0,1,2,0,1,0,2,1,1,2,1,1,9,3,3,0,8,2,18,3,4,2,15,2,2,10,0,4,17,4,19,1,
%T A401066 3,9,1,0,11,0,11,4,6,5,26,3,0,16,35,0,4,3,10,11,27,1,7,5,1,18,15,0,55,
%U A401066 20,6,0,2,4,30,10,17,2,24,1,28,12,4,1,9,12,4,0,2,7,47,6,14,27,19,4,56,1,0,17,21,36,5
%N A401066 a(n) = A276085(n) mod A006530(n), where A276085 is fully additive with a(p) = p#/p, and A006530(n) is the largest prime dividing n.
%C A401066 For fixed m and primes p > A006530(m), a(m*p) = (a(p) + A276085(m)) mod p, so in the scatter plot the points (m*p, a(m*p)) form a copy of the points (p, a(p)) = (prime(k+1), A062347(k)), stretched horizontally by the factor m and shifted vertically by A276085(m) modulo p. - _Alper Ferudun_, Oct 22 2026
%H A401066 Antti Karttunen, <a href="/A401066/b401066.txt">Table of n, a(n) for n = 1..10000</a>
%H A401066 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401066 For all k in A048103, a(k) = A401238(A276085(k)).
%F A401066 a(1) = 0, for p prime, a(p) = A062347(A000720(p)-1), and for composite n, a(n) = (a(p) + A276085(n/p)) mod p, where p = A006530(n). - _Alper Ferudun_ and _Antti Karttunen_, Oct 22 2026
%o A401066 (PARI)
%o A401066 A006530(n) = if(n>1, vecmax(factor(n)[, 1]), 1);
%o A401066 A276085_mod_m(n,m) = if(1==n,0,my(f = factor(n),lp=f[#f~,1],pr=1,s=0,k=1); forprime(p=2,lp,if(f[k,1]==p, s += f[k,2]*pr; s %= m; k++); pr *= p; pr %= m); (s));
%o A401066 A401066(n) = A276085_mod_m(n,A006530(n));
%Y A401066 Cf. A006530, A048103, A276085, A062347 [= a(A000040(1+n))], A401232 (positions of 0's), A401238.
%K A401066 nonn,easy,look,new
%O A401066 1,3
%A A401066 _Antti Karttunen_, Oct 21 2026
