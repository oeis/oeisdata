%I A401528 #9 Nov 05 2026 17:09:10
%S A401528 1,2,3,4,5,6,7,9,11,13,16,17,19,20,23,24,25,28,29,30,31,32,35,36,37,
%T A401528 40,41,42,43,47,48,49,53,56,59,61,64,67,68,71,73,76,79,80,81,83,85,87,
%U A401528 88,89,90,92,93,95,97,99,100,101,103,106,107,108,109,110,113
%N A401528 Numbers k such that A382286(k) is a square.
%C A401528 This sequence is the union of three disjoint sets of integers:
%C A401528 (1) Numbers k with A382286(k) = 1 (equivalently, A381054(k) = 0), whose central divisors d = A033676(k) and k/d = A033677(k) satisfy floor(sqrt(d)) = floor(sqrt(k/d)).
%C A401528 (2) Prime numbers p (A000040), for which A382286(p) = A048760(p) = floor(sqrt(p))^2.
%C A401528 (3) Composite numbers k with A382286(k) = m^2 > 1. In particular, for any integer r >= 2 and prime p > r^4, k = r^2 * p belongs to this sequence if and only if r divides floor(sqrt(p)), in which case A382286(r^2 * p) = (floor(sqrt(p))/r)^2.
%C A401528 Conjecture: The counting function N(x) = #{n : a(n) <= x} satisfies lim_{x->oo} N(x) / pi(x) = zeta(3) = 1.2020569... (A002117), where pi(x) = A000720(x).
%e A401528 6 is a term because A382286(6) = 1 = 1^2 (since 6 = 2 * 3 and floor(sqrt(2)) = floor(sqrt(3)) = 1).
%e A401528 11 is a term because 11 is prime and A382286(11) = floor(sqrt(11))^2 = 9 = 3^2.
%e A401528 68 is the smallest composite term with A382286(k) > 1: 68 * 4 = 272 = 16 * 17 with floor(sqrt(16)) = floor(sqrt(17)) = 4, so A382286(68) = 4 = 2^2.
%o A401528 (PARI)
%o A401528 b0(n) = {
%o A401528   my(r=sqrtint(n), b=if(n<=1||r^2==n, 1, r^2), D=divisors(n));
%o A401528   if(!isprime(n),
%o A401528     forstep(i=(#D+1)\2, 2, -1,
%o A401528       my(d=D[i], v=n\d, K=sqrtint(v), u, k);
%o A401528       while(K^4 < n*b,
%o A401528         k = (K^2 + v - 1)\v;
%o A401528         if((u = (K^2 + d - 1)\d) <= (K^2 + 2*K)\d && k <= (K^2 + 2*K)\v,
%o A401528           b = min(b, u*k); break
%o A401528         );
%o A401528         K = max(K + 1, sqrtint(k*v))
%o A401528       );
%o A401528       if(b==1, break)
%o A401528     )
%o A401528   );
%o A401528   b;
%o A401528 }
%o A401528 isok(k) = issquare(b0(k));
%o A401528 first(n) = { my(res=vector(n), c=0, k=0); while(c<n, k++; if(isok(k), c++; res[c]=k)); res; }
%Y A401528 Cf. A000040, A000290, A000720, A002117, A033676, A033677, A048760, A381054, A382286, A382306, A383115.
%K A401528 nonn,new
%O A401528 1,2
