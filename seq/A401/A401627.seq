%N A401627 a(0) = 1; a(n) = Sum_{k=1..n} binomial(n+k+1,k) * a(n-k).
%F A401627 G.f. A(x) satisfies A(x) = (1-x) * (1-2*x) * (2*A(x*(1-x)) - 1).
%o A401627 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(i+j+1, j)*v[i-j+1])); v;
