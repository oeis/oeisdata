%S A401941 0,2,6,17,42,97,214,457,954,1960,3988,8062,16228,32581,65315,130814,
%T A401941 261846,523947,1048189,2096716,4193816,8388065,16776615,33553770,
%U A401941 67108138,134216935,268434593,536869976,1073740812,2147482557,4294966123,8589933334,17179867838
%N A401941 Largest m such that one defective in an m-item set and one in a disjoint 7-item set can always be identified in at most n adaptive tests, each returning the number of defectives in a selected subset (0 if no positive m is feasible).
%H A401941 Fedor Karpelevitch, <a href="https://arxiv.org/abs/2611.09076">Quantitative group testing with a fixed shore: sharp asymptotics and exact formulas</a>, arXiv:2611.09076 [math.CO], 2026.
%H A401941 Fedor Karpelevitch, <a href="https://doi.org/10.5281/zenodo.23996093">Evidence for quantitative group testing with a fixed shore: sharp asymptotics and exact formulas</a>, version 1.0.0, 2026.
%H A401941 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (5,-9,7,-2).
%F A401941 a(2) = 0; a(3) = 2.
%F A401941 a(n) = 2^n - n^2 + 4*n - 10 for 4 <= n <= 10.
%F A401941 a(n) = 2^n - n^2 + 3*n for 11 <= n <= 13.
%F A401941 a(n) = 2^n - (3*n^2 - 25*n + 74)/2 for n >= 14 (Karpelevitch, Theorem 1.2 and Section 1.1).
%F A401941 G.f.: x^3*(2 - 4*x + 5*x^2 - 3*x^3 + 2*x^4 - x^8 + 3*x^9 - 2*x^10 - 2*x^11 + 3*x^12 + 4*x^13 - 4*x^14)/((1 - x)^3*(1 - 2*x)).
%F A401941 E.g.f.: exp(2*x) - (3*x^2 - 22*x + 74)*exp(x)/2 + 36 + 24*x + 7*x^2 + 7*x^3/6 + x^4/24 - x^5/40 - x^6/120 - x^7/630 - x^8/4480 - x^9/40320 - x^10/453600 - x^11/5702400 - x^12/95800320 - x^13/3113510400.
%F A401941 a(n) = 5*a(n-1) - 9*a(n-2) + 7*a(n-3) - 2*a(n-4) for n >= 18. - _Jianing Song_, Nov 12 2026
%t A401941 LinearRecurrence[{5, -9, 7, -2}, {0, 2, 6, 17, 42, 97, 214, 457, 954, 1960, 3988, 8062, 16228, 32581, 65315, 130814}, 35] (* _Paolo Xausa_, Nov 21 2026 *)
