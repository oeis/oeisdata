%I A401966 #9 Nov 17 2026 21:10:18
%S A401966 2,3,5,11,41,7,37,13,223,2953,19,2749,193,4733,29,51899,17,67,46477,
%T A401966 101,89,163661,2269,151,59,31,46441,1163,197,1438907,14992883,541,
%U A401966 283426411,47,73,67619443,5003833453,219133,1777,120395507,213945675397
%N A401966 a(1) = 2; a(n+1) is the least prime factor of a(n) + Product_{k=1..n-1, a(k) active} a(k) which is not yet in the sequence, where a(k) becomes permanently inactive as soon as some later a(j), j>k, is less than a(k).
%C A401966 A variant of the Euclid-Mullin sequence A000945.
%C A401966 Same permanent benching as A400647, with N = a(n) + (product of the active terms other than a(n)) instead of N = 1 + (product of all active terms).
%C A401966 It is not proven that there is always at least one prime factor that is not yet in the sequence (this is not trivial because of the way we exclude certain values already in the sequence when forming the product for term n).
%H A401966 Tesfamichael Bogale, <a href="/A401966/b401966.txt">Table of n, a(n) for n = 1..10000</a>
%H A401966 Wikipedia, <a href="https://en.wikipedia.org/wiki/Euclid%E2%80%93Mullin_sequence">Euclid-Mullin sequence</a>.
%e A401966 a(1) = 2.
%e A401966 Active set {2}. N = 1+2 = 3, so a(2) = 3.
%e A401966 Active set {2, 3}. N = 2+3 = 5, so a(3) = 5.
%e A401966 Active set {2, 3, 5}. N = 2*3+5 = 11, so a(4) = 11.
%e A401966 Active set {2, 3, 5, 11}. N = 2*3*5+11 = 41, so a(5) = 41.
%e A401966 Active set {2, 3, 5, 11, 41}. N = 2*3*5*11+41 = 371 = 7*53, so a(6) = 7.
%e A401966 Active set {2, 3, 5, 7}. N = 2*3*5+7 = 37, so a(7) = 37.
%e A401966 Active set {2, 3, 5, 7, 37}. N = 2*3*5*7+37 = 247 = 13*19, so a(8) = 13.
%e A401966 Active set {2, 3, 5, 7, 13}. N = 2*3*5*7+13 = 223, so a(9) = 223.
%e A401966 Active set {2, 3, 5, 7, 13, 223}. N = 2*3*5*7*13+223 = 2953, so a(10) = 2953.
%e A401966 Active set {2, 3, 5, 7, 13, 223, 2953}. N = 2*3*5*7*13*223+2953 = 611743 = 11*19*2927, 11 already used, so a(11) = 19.
%e A401966 Active set {2, 3, 5, 7, 13, 19}. N = 2*3*5*7*13+19 = 2749, so a(12) = 2749.
%e A401966 ...
%o A401966 (Python)
%o A401966 from sympy import factorint
%o A401966 from math import prod
%o A401966 def a_list(nmax):
%o A401966     seq, active = [2], [2]
%o A401966     while len(seq) < nmax:
%o A401966         N = prod(active[:-1]) + active[-1]
%o A401966         p = min(q for q in factorint(N) if q not in seq)
%o A401966         seq.append(p)
%o A401966         active = [q for q in active if q < p] + [p]
%o A401966     return seq
%o A401966 print(a_list(41))
%Y A401966 Cf. A000945, A020639, A400347, A400647.
%K A401966 nonn,new
%O A401966 1,1
%A A401966 _Tesfamichael Bogale_, Nov 10 2026
