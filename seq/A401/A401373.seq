%I A401373 #17 Oct 30 2026 17:11:28
%S A401373 5,7,11,23,41,67,73,113,139,151,157,167,191,211,223,241,257,271,281,
%T A401373 313,487,499,593,617,653,751,769,887,929,971,983,1087,1103,1129,1153,
%U A401373 1187,1229,1327,1483,1511,1523,1543,1549,1567,1621,1721,1777,1879,1889,1913,1987,2011,2053
%N A401373 Primes p for which there exists a prime q < p such that ((p#/p) / (q#/q)) == +1 mod p, where p# = A034386(p).
%H A401373 Antti Karttunen, <a href="/A401373/b401373.txt">Table of n, a(n) for n = 1..4017</a>
%H A401373 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401373 a(n) = A000040(1+A401372(n)).
%e A401373 With p=5 and q=2, we obtain (p#/p)/(q#/q) = (A034386(5)/5) / (A034386(2)/2) = (2*3) = 6 == +1 mod 5, therefore 5 is included in this sequence.
%e A401373 With p=7 and q=3, we obtain (p#/p)/(q#/q) = (A034386(7)/7) / (A034386(3)/3) = (2*3*5)/(2) = (3*5) = 15 == +1 mod 7, thus 7 is a term.
%e A401373 With p=11 and q=2, we obtain (p#/p)/(q#/q) = (A034386(11)/11) / (A034386(2)/2) = (2*3*5*7) = 210 == +1 mod 11, therefore 11 is included in this sequence. Note that 11 and 2 are two possible "q"'s for p=19 in A401057. Note that 44279 and 49499 also occurs as terms here.
%o A401373 (PARI) is_A401373_on_p(p) = { my(n=primepi(p)-1, pr=1, c=0); forstep(k=n, 1, -1, pr *= prime(k); pr %= p; if(1==pr,return(1))); (0); };
%o A401373 forprime(p=2,8191,if(is_A401373_on_p(p),print1(p,", ")));
%Y A401373 Cf. A000040, A034386, A401058, A401372, A401374 [gives the corresponding prime q, the largest if there are several].
%Y A401373 Cf. also A401057, A401061, A400843, A401063.
%K A401373 nonn,new
%O A401373 1,1
%A A401373 _Antti Karttunen_, Oct 29 2026
