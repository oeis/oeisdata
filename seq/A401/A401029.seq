%U A401029 173401165343014841913811201,10269686618782340943281572650731961721994479821558945481862118252518194156801,52643875858853821378500020797440001
%N A401029 n-th cyclotomic polynomial evaluated at n!: a(n) = Phi_n(n!).
%C A401029 The n-th cyclotomic polynomial evaluated at n!.
%F A401029 a(n) = Product_{1 <= k <= n, gcd(k,n)=1} (n! - exp(2*Pi*i*k/n)).
%F A401029 a(n) = Phi_n(n!), where Phi_n is the n-th cyclotomic polynomial.
%e A401029 For n = 1, 1! = 1, and Phi_1(x) = x - 1, so a(1) = 1 - 1 = 0.
%e A401029 For n = 2, 2! = 2, and Phi_2(x) = x + 1, so a(2) = 2 + 1 = 3.
%e A401029 For n = 3, 3! = 6, and Phi_3(x) = x^2 + x + 1, so a(3) = 6^2 + 6 + 1 = 43.
%e A401029 For n = 4, 4! = 24, and Phi_4(x) = x^2 + 1, so a(4) = 24^2 + 1 = 577.
%o A401029 (Python)
%o A401029 from sympy import cyclotomic_poly, Symbol, factorial
%o A401029 x = Symbol('x')
%o A401029 def a(n):
%o A401029     if n == 1:
%o A401029         return 0
%o A401029     fn = factorial(n)
%o A401029     poly = cyclotomic_poly(n, x)
%o A401029     return int(poly.subs(x, fn))
%o A401029 (PARI) a(n) = polcyclo(n, n!); \\ _Michel Marcus_, Oct 14 2026
%Y A401029 Cf. A092502, A020500, A070518, A070526, A398557, A000142.
