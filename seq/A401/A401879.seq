%I A401879 #11 Nov 13 2026 16:18:23
%S A401879 4,29,2317,1419900,7950000845
%N A401879 Number of Xmas tree primes with exactly n blocks.
%C A401879 A Xmas tree prime is a prime whose decimal representation, split into blocks of lengths 1, 2, ..., n, consists of primes (see A195302).
%e A401879 For n = 2, 211 is a Xmas tree prime because 2 and 11 are prime; there are 29 such primes with exactly two blocks.
%o A401879 (Python)
%o A401879 from sympy import sieve
%o A401879 from itertools import product
%o A401879 from gmpy2 import is_prime, mpz
%o A401879 def a(n):
%o A401879     sieve.extend(10**n)
%o A401879     primes = list(str(p) for p in sieve._list)
%o A401879     primesbylen = [[p for p in primes if len(p)==i+1] for i in range(n)]
%o A401879     return sum(1 for t in product(*primesbylen) if is_prime(mpz("".join(t))))
%o A401879 print([a(n) for n in range(1, 5)]) # _Michael S. Branicky_, Nov 08 2026
%Y A401879 Cf. A195302, A195335, A000217.
%K A401879 nonn,base,hard,more,new
%O A401879 1,1
%A A401879 _Zhixiang Fan_, Nov 08 2026
