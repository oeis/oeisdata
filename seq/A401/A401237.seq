%I A401237 #18 Oct 21 2026 20:06:42
%S A401237 0,3,10,15,20,25,35,42,49,56,63,70,77,84,91,98,105,112,119,126,133,
%T A401237 140,147,154,161,168,175,182,189,196,203,220,231,242,253,264,275,286,
%U A401237 297,308,319,330,341,352,363,374,385,396,407,418,429,440,451,462,473,484,495,506,517,528,539,550,561,572,583,594,605
%N A401237 Numbers k such that prime(A235224(k)) divides k. Here we assume that prime(0) = 1, thus the initial term is 0.
%C A401237 Sequence A276085(A401233(.)), sorted into ascending order.
%C A401237 {0} followed by numbers k such that the radix prime of their most significant digit in the primorial base representation (A049345) divides k.
%H A401237 Antti Karttunen, <a href="/A401237/b401237.txt">Table of n, a(n) for n = 1..10000</a>
%H A401237 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%F A401237 {k such that k == 0 mod A008578(1+A235224(k))}.
%F A401237 {k such that A061395(A324198(k)) = A235224(k)}.
%F A401237 For all n > 1, A392608(a(n)) > 0.
%e A401237 A049345(25) = 4:0:1, with the most significant digit 4 occupying the digit position under radix prime 5, and therefore 25 is included as a term as 5 divides 25.
%e A401237 A049345(63) = 2:0:1:1, with the most siginificant digit 2 occupying the digit position under radix prime 7, and therefore 63 is included as it is a multiple of 7.
%e A401237 A049345(231) = 1:0:3:1:1, with the most siginificant digit occupying the digit position under radix prime 11, and therefore 231 = 3*7*11 is included as it is a multiple of 11.
%o A401237 (PARI) is_A401237(n) = { my(p=2,q=1,orgn=n); while(n, n = n\p; q=p; p = nextprime(1+p)); !(orgn%q); };
%Y A401237 Cf. A000040, A008578, A049345, A061395, A235224, A276085, A324198, A392608, A401233.
%Y A401237 After the initial 0, a subsequence of A324584.
%Y A401237 Indices of 0's in A401238.
%K A401237 nonn,base,new
%O A401237 1,2
%A A401237 _Antti Karttunen_, Oct 21 2026
