%T A401083 9,9,9,3,9,9,18,3,27,3,9,9,9,3,18,3,9,9,9,3,18,9,18,9,9,3,27,3,9,9,10,
%U A401083 9,27,3,9,9,27,3,18,3,9,9,9,9,27,3,18,6,9,3,27
%N A401083 The total number of exponentially odd divisors of the exponentially odd divisors of n.
%C A401083 The sum of these divisors is A401084(n).
%C A401083 The number of pairs of exponentially odd divisors d_1 <= d_2 of n such that d_1 divides d_2.
%H A401083 Amiram Eldar, <a href="/A401083/b401083.txt">Table of n, a(n) for n = 1..10000</a>
%H A401083 Vaclav Kotesovec, <a href="/A401083/a401083.jpg">Graph - the asymptotic ratio (100000 terms)</a>
%F A401083 a(n) = Sum_{d|n, A295316(d) = 1} A322483(d).
%F A401083 Multiplicative with a(p^e) = A008805(e+1) = binomial(floor((e+1)/2)+2, 2).
%F A401083 Dirichlet g.f.: zeta(s) * zeta(2*s)^2 * Product_{p prime} (1 + 2/p^s - 2/p^(2*s) - 1/p^(3*s) + 1/p^(4*s)).
%F A401083 From _Vaclav Kotesovec_, Oct 14 2026: (Start)
%F A401083 Let f(s) = Product_{primes p} (1 - p^s - 2*p^(2*s) + 2*p^(3*s) + p^(4*s)) / (p^(2*s)*(1 + p^s)^2).
%F A401083 Dirichlet g.f.: zeta(s)^3 * f(s).
%F A401083 Sum_{k=1..n} a(k) ~ n * (f(1)*log(n)^2/2 + log(n)*((3*gamma - 1)*f(1) + f'(1)) + f(1)*(1 - 3*gamma + 3*gamma^2 - 3*sg1) + (3*gamma - 1)*f'(1) + f''(1)/2), where
%F A401083 f(1) = Product_{primes p} (1 - (3*p^2 + p - 1)/(p^2*(1 + p)^2)) = 0.406930682297767481141388173910566568649383791876485659800917968778047949341...,
%F A401083 f'(1) = f(1) * Sum_{primes p} (-2 - 3*p + 3*p^2 + 6*p^3) * log(p) / (1 - 3*p^2 + 3*p^4 + p^5) = f(1) * 1.8899463972678864884467612769405307547144140910042617647955356...,
%F A401083 f''(1) = f'(1)^2/f(1) + f(1) * Sum_{primes p} -p*(3 + 6*p - 9*p^2 - 24*p^3 - 19*p^4 + 6*p^5 + 27*p^6 + 12*p^7) * log(p)^2 / (1 - 3*p^2 + 3*p^4 + p^5)^2 = f'(1)^2/f(1) + f(1) * (-5.8939031937886235517401577623979491085001037872596752838358388783...),
%F A401083 gamma is the Euler-Mascheroni constant A001620 and sg1 is the first Stieltjes constant (see A082633). (End)
%t A401083 f[p_, e_] := Binomial[Floor[(e+1)/2] + 2, 2]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 84]
%o A401083 (PARI) a(n) = vecprod(apply(e -> ((e+1)\2+1)*((e+1)\2+2)/2, factor(n)[, 2]));
%Y A401083 Cf. A008805, A033634 (sum of exponentially odd divisors), A268335, A295316, A322483 (number of exponentially odd divisors), A369307, A401084.
%Y A401083 Analogous sequences: A007425 (with all the divisors), A074816 (unitary), A388067 (square), A375230 (infinitary).
%K A401083 nonn,mult,easy,new
%O A401083 1,2
%A A401083 _Amiram Eldar_, Oct 14 2026
