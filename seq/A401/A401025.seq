%I A401025 #18 Oct 22 2026 10:11:20
%S A401025 0,0,0,2,0,3,0,6,6,5,0,10,0,7,12,14,0,15,0,18,18,11,0,22,20,13,24,26,
%T A401025 0,27,0,30,30,17,30,34,0,19,36,38,0,39,0,42,42,23,0,46,42,45,48,50,0,
%U A401025 51,50,54,54,29,0,58,0,31,60,62,60,63,0,66,66,65,0,70,0,37,72,74,70,75,0,78
%N A401025 Maximum absolute difference between consecutive terms of n/gcd(n,k), k = 1..n-1.
%C A401025 Equivalently, a(n) is the largest absolute difference between consecutive entries among the first n-1 entries of row n of A054531, whose k-th entry is n/gcd(n,k).
%C A401025 Since n/gcd(n,k) is the additive order of k in Z/nZ, a(n) is the maximum absolute difference between the additive orders of consecutive nonzero residues.
%C A401025 For n > 1, a(n) = 0 if and only if n is prime.
%C A401025 Let D_n be the vector of absolute differences between consecutive terms n/gcd(n,k), 1 <= k <= n-2. Then a(n) is the infinity norm of D_n, whereas A397676(n) is its 1-norm and A397783(n) is the square of its 2-norm.
%H A401025 Paolo Xausa, <a href="/A401025/b401025.txt">Table of n, a(n) for n = 1..10000</a>
%F A401025 a(n) = max_{1 <= k <= n-2} abs(n/gcd(n,k+1) - n/gcd(n,k)), n >= 3.
%F A401025 a(n) = 0 if n = 1 or n is prime;
%F A401025 a(n) = n-2 if 4 divides n;
%F A401025 a(n) = n-q otherwise, if n is composite, where q is the smallest odd prime divisor of n.
%e A401025 For n = 12, the first n-1 terms n/gcd(n,k) are 12, 6, 4, 3, 12, 2, 12, 3, 4, 6, 12. Hence a(12) = 10.
%e A401025 For n = 25, the terms at k = 5 and k = 6 are 5 and 25, respectively, so a(25) = 20.
%e A401025 For n = 22, a(22) = 22-11 = 11, where 11 is the smallest odd prime divisor of 22.
%t A401025 A401025[n_] := If[n == 2, 0, n - FactorInteger[If[OddQ[n], n, n/2]][[1, 1]]];
%t A401025 Array[A401025, 100] (* _Paolo Xausa_, Oct 22 2026 *)
%o A401025 (Python)
%o A401025 from math import gcd
%o A401025 def a(n):
%o A401025     return max((abs(n//gcd(n,k+1) - n//gcd(n,k)) for k in range(1,n-1)), default=0)
%o A401025 (Python)
%o A401025 from sympy import isprime, factorint
%o A401025 def a(n):
%o A401025     if n == 1 or isprime(n):
%o A401025         return 0
%o A401025     if n % 4 == 0:
%o A401025         return n - 2
%o A401025     q = min(p for p in factorint(n) if p % 2)
%o A401025     return n - q
%o A401025 (Python)
%o A401025 from sympy import isprime, primefactors
%o A401025 def A401025(n): return n-(n if n==1 or isprime(n) else min(primefactors(n>>(n&1^1)))) # _Chai Wah Wu_, Oct 20 2026
