%N A401911 The greatest common divisor of n and A342001(n), where A342001(n) = A003415(n)/A003557(n).
%H A401911 Antti Karttunen, <a href="/A401911/b401911.txt">Table of n, a(n) for n = 1..10000</a>
%F A401911 a(n) = A401912(n)*A369008(n).
%o A401911 (PARI)
%o A401911 A342001(n) = { my(f=factor(n)); (sum(i=1, #f~, f[i, 2]/f[i, 1]) * factorback(f[, 1])); };
%o A401911 A401911(n) = gcd(n, A342001(n));
%Y A401911 Cf. A003415, A003557, A085731, A342001, A369008, A369009, A401912.
%Y A401911 Cf. A342090 (apparently, the positions of terms > 1), A369070.
%K A401911 nonn,easy,new
%O A401911 1,4
%A A401911 _Antti Karttunen_, Nov 09 2026
