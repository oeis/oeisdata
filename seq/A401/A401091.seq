%S A401091 1,3,18,164,2020,31542,599410,13475464,350951688,10417933610,
%T A401091 347917987054,12931386473964,530060097033532,23774736750379006,
%U A401091 1158941678656010610,61034083034297324048,3454324969653293237008,209125964533789125734994,13486618368353311671690838,923074690846282273557231220
%N A401091 Total number of (non-null) connected induced subgraphs in all labeled trees on n vertices.
%H A401091 Andrew Howroyd, <a href="/A401091/b401091.txt">Table of n, a(n) for n = 1..300</a>
%H A401091 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Vertex-InducedSubgraph.html">Vertex-Induced Subgraph</a>.
%F A401091 E.g.f.: B(C(x)) where 1 + B(x) is the e.g.f. of A000272 and C(x) is the e.g.f. of A000169.
%F A401091 E.g.f.: -LambertW(lambertW(-x)) - LambertW(LambertW(-x))^2/2.
%o A401091 (PARI) seq(n)={my(u=v=w=O(x)); for(n=1, n, u=x*exp(u); v=x*exp(v+u); w=(w + v)*u); Vec(serlaplace(intformal((v+w)/x)), -n)}
%o A401091 (PARI) seq(n) = {my(g=-lambertw(lambertw(-x + O(x*x^n)))); Vec(serlaplace(g - g^2/2))}
%Y A401091 Cf. A000169, A000272, A038058, A401092, A401094 (unlabeled version).
%K A401091 nonn,new
%O A401091 1,2
%A A401091 _Andrew Howroyd_, Oct 14 2026
