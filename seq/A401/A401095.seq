%I A401095 #7 Oct 16 2026 19:03:06
%S A401095 2,4,12,37,120,394,1327,4527,15691,55080,195782,703738,2556423,
%T A401095 9376111,34693935,129412230,486264819,1839262702,6998628099,
%U A401095 26774866817,102934095460,397469647060,1540916415546,5995459786347,23404032594439,91634020186295,359756322519420,1415945529008689
%N A401095 Number of rooted bicolored trees on n unlabeled vertices in which every path between two black vertices contains no other black vertices.
%C A401095 Also, a(n) is the number of rooted bicolored trees on n unlabeled vertices in which every path between two black vertices contains only black vertices.
%H A401095 Andrew Howroyd, <a href="/A401095/b401095.txt">Table of n, a(n) for n = 1..500</a>
%F A401095 a(n) = A401093(n) + A000081(n).
%o A401095 (PARI)
%o A401095 EulerTS(p)={my(n=serprec(p,x)-1); exp(x*Ser(dirmul(Vec(serchop(p,1),-n), vector(n,k,1/k)))) }
%o A401095 seq(n)={my(u=v=w=O(x)); for(n=1, n, u=x*EulerTS(u); v=x*EulerTS(v+u); w=(w + v)*u); Vec(u+v+w) }
%Y A401095 Cf. A000081, A038055, A401092, A401093, A401096.
%K A401095 nonn,new
%O A401095 1,1
%A A401095 _Andrew Howroyd_, Oct 16 2026
