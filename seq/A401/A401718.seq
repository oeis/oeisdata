%I A401718 #14 Nov 09 2026 11:12:08
%S A401718 0,1,7,8,16,91,1333,2556,5112,7668,10224,23677,24067,24457,24847,
%T A401718 25237,2554949,2884907,21122647,145202611,149583996,232361665
%N A401718 Numbers k such that k is a multiple of A342002(k), and A327860(k) is a multiple of k.
%C A401718 After the initial 0, numbers k such that A342002(k) is a divisor of k and k/A342002(k) is a divisor of A328572(k).
%C A401718 Sequence A276085(A401726(.)) sorted into ascending order.
%H A401718 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%e A401718 As A327860(0) = A342002(0) = 0, and 0 is a multiple of 0, 0 is included in this sequence.
%o A401718 (PARI)
%o A401718 A328572(n) = { my(m=1, p=2); while(n, if(n%p, m *= p^((n%p)-1)); n = n\p; p = nextprime(1+p)); (m); };
%o A401718 A342002(n) = { my(s=0, m=1, p=2, e); while(n, e = (n%p); m *= p^(e>0); s += (e/p); n = n\p; p = nextprime(1+p)); (s*m); };
%o A401718 is_A401718(n) = if(!n,1,my(t=A328572(n), w=A342002(n)); (!(n%w) && !(t%(n/w))));
%Y A401718 Cf. A003415, A276085, A276086, A328572, A342002, A327860, A401726.
%Y A401718 Intersection of A351087 and A400155.
%Y A401718 Subsequences: A328110, A401731.
%Y A401718 Cf. also A401376, A401729.
%K A401718 nonn,base,hard,more,new
%O A401718 1,3
%A A401718 _Antti Karttunen_, Nov 08 2026
