%U A401062 607,1427,3,797,433,1321,811,367,947,1123,29,31,131,61,1453,409,113,1069,1879,271,1091,23,257,199,383,2473,1187,1913,149
%N A401062 Largest such q listed for each prime p (A400843) for which there exists a prime q <= p such that 2*((p#/p) / (q#/q)) == -1 mod p, where p# = A034386(p).
%H A401062 Antti Karttunen, <a href="/A401062/b401062.txt">Table of n, a(n) for n = 1..4102</a>
%H A401062 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%o A401062 (PARI) A401062_p2q(p) = { my(n=primepi(p)-1, pr=2, lastk=0); forstep(k=n, 1, -1, if((p-1)==pr, return(prime(1+k))); pr *= prime(k); pr %= p; lastk = k); if((p-1)==pr,return(prime(lastk)),0); };
%o A401062 forprime(p=2, 2903, if((q=A401062_p2q(p))>0, print1(q, ", ")));
%Y A401062 Second column of irregular triangle A401051.
%Y A401062 Cf. A002110, A034386, A400843, A401059.
%Y A401062 Cf. A401052 (subsequence).
%Y A401062 Cf. also A401062 for similar sequence.
%K A401062 nonn,new
%O A401062 1,1
