%N A401655 a(0) = 1; a(n) = Sum_{k=1..n} binomial(2*n+k+1,k) * a(n-k).
%F A401655 G.f. A(x) satisfies A(x) = (1-x) * (1-3*x) * (2*A(x*(1-x)^2) - 1).
%F A401655 a(n) ~ c * n! * n^(1 + 3*log(2)/4) * 2^n / log(2)^n, where c = 0.5715296839307552337696624422630050462991969620097761186505354888692... - _Vaclav Kotesovec_, Nov 01 2026
%o A401655 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(2*i+j+1, j)*v[i-j+1])); v;
