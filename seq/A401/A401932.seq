%I A401932 #12 Nov 17 2026 19:48:46
%S A401932 0,0,0,0,6,0,18,15,54,36,250,108,1250,375,6250,1029,33614,2916,235298,
%T A401932 12500,1647086,62500,3906250,312500,19531250,1562500,125497034,
%U A401932 7812500,488281250,39062500
%N A401932 a(n) is the largest k less than 2^n for which A342001(k) = n, or 0 if no such k exists.
%F A401932 If A401931(n) = 0, then a(n) = 0, otherwise a(n) = A401930(n, A401931(n)).
%o A401932 (PARI)
%o A401932 A342001(n) = { my(f=factor(n)); (sum(i=1, #f~, f[i, 2]/f[i, 1]) * factorback(f[, 1])); };
%o A401932 A401932(n) = { forstep(i=(2^n)-1,1,-1,if(A342001(i)==n,return(i))); (0); };
%o A401932 (PARI) \\ See program in A401931.
%Y A401932 Cf. A342001, A401930, A401931.
%K A401932 nonn,more,new
%O A401932 1,5
%A A401932 _Antti Karttunen_, Nov 17 2026
