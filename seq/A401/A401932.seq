%I A401932 #27 Nov 19 2026 21:30:43
%S A401932 0,0,0,0,6,0,18,15,54,36,250,108,1250,375,6250,1029,33614,2916,235298,
%T A401932 12500,1647086,62500,3906250,312500,19531250,1562500,125497034,
%U A401932 7812500,488281250,39062500,820677346,195312500,1787743478
%N A401932 a(n) is the largest k less than 2^n for which A342001(k) = n, or 0 if no such k exists.
%C A401932 Note that not all terms k of A361102 for which A342001(k) = n are necessarily less than 2^n. See the "additional cases" column in the example section.
%F A401932 If A401931(n) = 0, then a(n) = 0, otherwise a(n) = A401930(n, A401931(n)).
%e A401932 Nonzero terms up to a(33):
%e A401932 n      Largest k < 2^n      Additional cases k > 2^n for which also A342001(k) = n
%e A401932 -------------------------------------------------------------------------------------
%e A401932 5            6 = 2 * 3,
%e A401932 7           18 = 2 * 3^2,
%e A401932 8           15 = 3 * 5,
%e A401932 9           54 = 2 * 3^3,
%e A401932 10          36 = 2^2 * 3^2,
%e A401932 11         250 = 2 * 5^3,
%e A401932 12         108 = 2^2 * 3^3,
%e A401932 13        1250 = 2 * 5^4,
%e A401932 14         375 = 3 * 5^3,
%e A401932 15        6250 = 2 * 5^5,
%e A401932 16        1029 = 3 * 7^3,
%e A401932 17       33614 = 2 * 7^5,
%e A401932 18        2916 = 2^2 * 3^6,
%e A401932 19      235298 = 2 * 7^6,
%e A401932 20       12500 = 2^2 * 5^5,
%e A401932 21     1647086 = 2 * 7^7,
%e A401932 22       62500 = 2^2 * 5^6,
%e A401932 23     3906250 = 2 * 5^9,   Also A342001(11529602)=23, where 11529602 = 2 * 7^8 > 2^23,
%e A401932 24      312500 = 2^2 * 5^7,
%e A401932 25    19531250 = 2 * 5^10,  Also 38974342 = 2*11^7 and 80707214 = 2 * 7^9, both > 2^25,
%e A401932 26     1562500 = 2^2 * 5^8,
%e A401932 27   125497034 = 2 * 13^7,  Also 428717762 = 2*11^8 and 564950498 = 2*7^10, both > 2^27,
%e A401932 28     7812500 = 2^2 * 5^9,
%e A401932 29   488281250 = 2 * 5^12,  Also 1631461442 = 2*13^8, 3954653486 = 2*7^11, 4715895382 = 2*11^9, all > 2^29,
%e A401932 30    39062500 = 2^2 * 5^10,
%e A401932 31   820677346 = 2 * 17^7,  A342001(2441406250)=31, where 2441406250 = 2*5^13 > 2^31,
%e A401932 32   195312500 = 2^2 * 5^11,
%e A401932 33  1787743478 = 2 * 19^7.  A342001(12207031250)=33, where 12207031250 = 2*5^14 > 2^33.
%o A401932 (PARI)
%o A401932 A342001(n) = { my(f=factor(n)); (sum(i=1, #f~, f[i, 2]/f[i, 1]) * factorback(f[, 1])); };
%o A401932 A401932(n) = { forstep(i=(2^n)-1,1,-1,if(A342001(i)==n,return(i))); (0); };
%o A401932 (PARI) \\ See program in A401931.
%Y A401932 Cf. A342001, A361102, A401930, A401931.
%K A401932 nonn,more,new
%O A401932 1,5
