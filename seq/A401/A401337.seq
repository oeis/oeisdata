%U A401337 6,11,4,3,3,3,5,15,10,10,12,8,12,3,6,4,16,5,0,2,8,11,13
%N A401337 Absolute difference between the number of primes in the left half and the right half of the interval [prime(n)^2, prime(n+1)^2].
%H A401337 James C. McMahon, <a href="/A401337/b401337.txt">Table of n, a(n) for n = 1..1000</a>
%e A401337 For n = 3, the interval is [5^2, 7^2] = [25, 49]. The primes in this interval are {29, 31, 37, 41, 43, 47}. The midpoint is M(3) = (25+49)/2 = 37. The "left half" primes are {29, 31} (2 primes), and the "right half" primes are {41, 43, 47} (3 primes). Since 37 is the midpoint itself, it is excluded from both halves. The absolute difference is |2 - 3| = 1, so a(3) = 1.
%t A401337 a[n_]:=Module[{m=Mean[{Prime[n]^2,Prime[n+1]^2}],p=Select[Range[Prime[n]^2,Prime[n+1]^2],PrimeQ]},Abs[Length[Select[p,#<m&]]-Length[Select[p,#>m&]]]];Array[a,88] (* _James C. McMahon_, Nov 01 2026 *)
%o A401337 (Python)
%o A401337 from sympy import prime, primepi
%o A401337 def a(n):
%o A401337     p1 = prime(n)
%o A401337     p2 = prime(n + 1)
%o A401337     m = (p1**2 + p2**2) // 2
%o A401337     left_count = primepi(m - 1) - primepi(p1**2)
%o A401337     right_count = primepi(p2**2) - primepi(m)
%o A401337     return abs(left_count - right_count)
%o A401337 print([a(n) for n in range(1, 89)])
%Y A401337 Cf. A001248, A050216.
