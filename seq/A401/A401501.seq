%I A401501 #15 Oct 28 2026 04:16:27
%S A401501 1,1,0,3,4,0,15,40,18,0,105,420,430,96,0,945,5040,8260,4536,600,0,
%T A401501 10395,69300,157500,144928,49644,4320,0,135135,1081080,3153150,
%U A401501 4145680,2460780,574848,35280,0,2027025,18918900,67477410,116276160,100948540,41920560,7090416,322560,0
%N A401501 Triangle read by rows: T(n, k) is the number of partitions of the set {1, 2,..., 2*n-k} into n-k nonempty lists, such that the smallest element of each list is not in the initial position. The lists themselves are unordered.
%F A401501 T(n, n) = 0 for n >= 1, and T(0, 0) = 1.
%F A401501 T(n, n-1) = n*n!.
%F A401501 T(n, 0) = (2*n-1)!!.
%F A401501 T(n, 1) = (2*n-1)!! * 4*(n-1)/3.
%F A401501 T(n, k) = B_{2*n-k, n-k}(c1, c2, ..., c_{n+1}), where B_{m,r} is the partial exponential Bell polynomial and c_j = (j-1)*(j-1)! for j >= 1.
%F A401501 T(n, k) = (2*n - k)! [x^n y^k] exp(Sum_{j>=1} (j / (j+1)) * x^j * y^(j-1)).
%F A401501 Recurrence: T(n, k) = (2*n-k-1) * (T(n-1, k) + 2*T(n-1, k-1) - (2*n-k-2)*T(n-2, k-2)) for n >= 1 and 0 <= k <= n, with T(0, 0) = 1, and in all other cases = 0.
%e A401501 Triangle begins:
%e A401501   [0]       1;
%e A401501   [1]       1,       0;
%e A401501   [2]       3,       4,       0;
%e A401501   [3]      15,      40,      18,       0;
%e A401501   [4]     105,     420,     430,      96,       0;
%e A401501   [5]     945,    5040,    8260,    4536,     600,       0;
%e A401501   [6]   10395,   69300,  157500,  144928,   49644,    4320,     0;
%e A401501   [7]  135135, 1081080, 3153150, 4145680, 2460780,  574848, 35280,  0;
%e A401501 .
%e A401501 {[3,1], [4,2,5]} and {[4,2,5], [3,1]} are regarded as the same partition but different from {[1,3], [4,2,5]}. The last partition is not counted since 1 is the first element its list.
%p A401501 T := proc(n, k) option remember;
%p A401501 if n = 0 and k = 0 then return 1 elif n < 0 or k < 0 or k > n then return 0 fi;
%p A401501 (2*n-k-1) * (T(n-1,k) + 2*T(n-1,k-1) - (2*n-k-2)*T(n-2,k-2) ) end:
%p A401501 rowT := n -> local k; seq(T(n, k), k = 0..n): seq(rowT(n), n = 0..8);
%p A401501 # Alternative:
%p A401501 T := proc(n,k) local j; if k > n then return 0 elif n=0 then return 1 fi;
%p A401501 IncompleteBellB(2*n-k, n-k, seq((j-1)*factorial(j-1), j = 1..n+1)) end:
%p A401501 seq(seq(T(n, k), k = 0..n), n = 0..8);
%t A401501 T[n_, k_] := BellY[2 n - k, n - k, Table[(j - 1) (j - 1)!, {j, n + 1}]];
%t A401501 Table[T[n, k], {n, 0, 8}, {k, 0, n}] // Flatten
%t A401501 (* Alternative: *)
%t A401501 T[0,0] = 1; T[n_, k_] := Module[{r = n-k, partitions}, If[k >= n, Return[0]];
%t A401501 partitions = Select[IntegerPartitions[k], Length[#] <= r &];
%t A401501 (2 n - k)! Total[Function[p, 1/(2^(r - Length[p]) (r - Length[p])!) * Times @@ (Function[t, ((t[[1]] + 1)/(t[[1]] + 2))^t[[2]] / t[[2]]! ] /@ Tally[p])] /@ partitions]]; Table[T[n, k], {n, 0, 8}, {k, 0, n}] // Flatten
%o A401501 (Python)
%o A401501 from functools import cache
%o A401501 @cache
%o A401501 def T(n, k):
%o A401501     if n == k == 0: return 1
%o A401501     if n < 0 or k < 0 or k > n: return 0
%o A401501     return (2*n-k-1) * (T(n-1, k) + 2*T(n-1, k-1) - (2*n-k-2)*T(n-2, k-2))
%o A401501 def RowT(n): return [T(n, k) for k in range(n+1)]
%o A401501 triangle = [RowT(n) for n in range(9)]
%o A401501 for row in triangle: print(row)
%o A401501 (SageMath)
%o A401501 def T(n, k):
%o A401501     if n == k == 0: return ZZ(1)
%o A401501     if not 0 <= k <= n: return ZZ(0)
%o A401501     p = bell_polynomial(2*n-k, n-k)
%o A401501     R = p.parent()
%o A401501     return ZZ(p.subs({R.gen(j): j*factorial(j) for j in range(n+1)}))
%o A401501 print(flatten([[T(n,k) for k in range(n+1)] for n in range(9)]))
%Y A401501 Cf. A001147, A001563, A048174 (row sums).
%K A401501 nonn,tabl,new
