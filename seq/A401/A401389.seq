%I A401389 #6 Oct 31 2026 20:19:08
%S A401389 3,7,15,21,31,33,51,69,91,93,105,127,135,141,159,165,213,217,231,255,
%T A401389 273,285,321,345,357,381,435,465,483,561,573,651,679,705,759,775,795,
%U A401389 819,861,885,889,891,945,987,1023,1065,1113,1149,1155,1173,1185,1293,1335,1365,1419,1485,1491,1551,1561,1581,1605,1743
%N A401389 Numbers k such that {the largest divisor of sigma(k) coprime with k} is a power of 2 larger than 1.
%C A401389 All terms are odd and no squares are present.
%H A401389 Antti Karttunen, <a href="/A401389/b401389.txt">Table of n, a(n) for n = 1..10000</a>
%H A401389 <a href="/index/O#opnseqs">Index entries for sequences where odd perfect numbers must occur, if they exist at all</a>.
%F A401389 {k such that A401375(k) > 1 and A209229(A401375(k)) = 1}.
%o A401389 (PARI)
%o A401389 A209229(n) = (n && !bitand(n,n-1));
%o A401389 A401375(n) = { my(s=sigma(n)); fordiv(s,d,if(1==gcd(s/d,n), return(s/d))); };
%o A401389 is_A401389(k) = { my(u=A401375(k)); (u>1 && A209229(u)); };
%Y A401389 Cf. A000203, A401375, A209229.
%Y A401389 Subsequence of A401381.
%Y A401389 Cf. also A336702.
%K A401389 nonn,new
%O A401389 1,1
%A A401389 _Antti Karttunen_, Oct 31 2026
