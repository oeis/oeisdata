%I A401515 #6 Nov 03 2026 17:44:34
%S A401515 5,13,17,29,37,41,53,85,101,113,125,145,193,221,265,293,281,325,305,
%T A401515 353,425,449,461,505,557,533,629,601,653,697,689,845,793,857,797,937,
%U A401515 1025,941,1037,1109,1025,1105,1097,1189,1405,1217,1445,1289,1517,1537,1465,1585,1649,1565,1625,1745,1865
%N A401515 Hypotenuses of the primitive Pythagorean triples corresponding to A398554.
%H A401515 Robert Israel, <a href="/A401515/b401515.txt">Table of n, a(n) for n = 1..10000</a>
%F A401515 a(k) = m^2 + n^2 where m and n are coprime with opposite parity and A398554(k) = (2*m^2 + 2*m*n)^2 - (m^2+n^2).
%e A401515 a(3) = 17 because 17 is the hypotenuse of the primitive Pythagorean triple (8,15,17) which has perimeter 40, hypotenuse 17, and 40^2 - 17 = 1583 = A398554(3).
%p A401515 N:= 10^7: # for terms where A398554(k) <= N
%p A401515 R:= NULL:
%p A401515 for m from 1 while 4*m^4 + 8*m^3 + 3*m^2-1 <= N do
%p A401515   for n from (m mod 2) + 1 by 2 to m-1 do
%p A401515     if igcd(m, n) > 1 then next fi;
%p A401515     v:= (2*m^2 + 2*m*n)^2 - (m^2+n^2);
%p A401515     if v > N then break fi;
%p A401515     if isprime(v) then R:= R, [v, m^2+n^2] fi
%p A401515 od od:
%p A401515 R:= sort([R], (s, t) -> s[1]<t[1]):
%p A401515 R[.., 2];
%Y A401515 Cf. A398554, A401513, A401514.
%K A401515 nonn,new
%O A401515 1,1
%A A401515 _Will Gosnell_ and _Robert Israel_, Oct 27 2026
