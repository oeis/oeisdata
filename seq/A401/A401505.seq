%N A401505 a(n) = log_2(A307848(n)).
%C A401505 First differs from A056170 and A369165 at n = 64, and from A389836 at n = 256.
%H A401505 Amiram Eldar, <a href="/A401505/b401505.txt">Table of n, a(n) for n = 1..10000</a>
%F A401505 a(n) = A007814(A307848(n)).
%F A401505 Additive with a(p^e) = A064547(e).
%F A401505 Asymptotic mean: Limit_{m->oo} (1/m) * Sum_{k=1..m} a(k) = Sum_{k>=2} (A064547(k)-A064547(k-1))*P(k) = 0.46376237622537016314..., where P(s) is the prime zeta function.
%t A401505 f[p_, e_] := Sum[DigitSum[k, 2], {k, FactorInteger[e][[;; , 2]]}]; f[p_, 1] := 0; a[1] = 0; a[n_] := Plus @@ f @@@ FactorInteger[n]; Array[a, 92]
%o A401505 (PARI) s(n) = vecsum(apply(hammingweight, factor(n)[, 2]));
%o A401505 a(n) = vecsum(apply(s, factor(n)[, 2]));
%Y A401505 Cf. A007814, A064547, A307848.
%Y A401505 Cf. A056170, A369165, A389836.
