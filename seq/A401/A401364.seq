%I A401364 #4 Oct 28 2026 00:01:04
%S A401364 37,2953,6173,6353,36833,48407
%N A401364 Numbers k such that (29^k + 28^k)/57 is prime.
%C A401364 The definition implies that k must be a prime.
%C A401364 a(7) > 10^5.
%H A401364 P. Bourdelais, <a href="https://listserv.nodak.edu/cgi-bin/wa.exe?A2=NMBRTHRY;417ab0d6.0906">A Generalized Repunit Conjecture</a>.
%H A401364 J. Brillhart et al., <a href="https://doi.org/10.1090/conm/022">Factorizations of b^n +- 1</a>, Contemporary Mathematics, Vol. 22, Amer. Math. Soc., Providence, RI, 3rd edition, 2002.
%H A401364 H. Dubner and T. Granlund, <a href="https://www.cs.uwaterloo.ca/journals/JIS/VOL3/DUBNER/dubner.html">Primes of the Form (b^n+1)/(b+1)</a>, J. Integer Sequences, 3 (2000), #P00.2.7.
%H A401364 H. Lifchitz, <a href="http://www.primenumbers.net/Henri/us/MersFermus.htm">Mersenne and Fermat primes field</a>
%H A401364 OEIS Wiki, <a href="https://oeis.org/wiki/Primes_of_the_form_(a%5En%2Bb%5En)/(a%2Bb)_and_(a%5En-b%5En)/(a-b)">Primes of the form (a^n+b^n)/(a+b) and (a^n-b^n)/(a-b)</a>
%H A401364 Eric Weisstein's World of Mathematics, <a href="http://mathworld.wolfram.com/Repunit.html">Repunit</a>.
%t A401364 Select[Prime[Range[10000]], PrimeQ[(29^# + 28^#)/57] &]
%Y A401364 Cf. A057187, A057188, A062587, A062589, A127996, A127997, A128344, A204940, A217320, A225807, A228922, A229542, A375161, A375236, A377031, A377856.
