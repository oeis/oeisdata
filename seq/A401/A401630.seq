%U A401630 3243032432640000,62600987344896000,1269804118302720000,27005212290760704000,600926796019630080000,13964857526933913600000
%N A401630 a(n) = 2*(n - 1)!*(binomial(n+1, 3) + binomial(n, 3)).
%C A401630 a(n) is the total cross work on the symmetric group S_n (see Udo et al.).
%H A401630 Nsibiet E. Udo, Victor A. Owai, and Moses O. Francis, <a href="https://arxiv.org/abs/2610.34902">Cross work induced by transformations on the symmetric group and related transformation semigroups</a>, arXiv:2610.34902 [math.CO], 2026. See Table 2 on page 18.
%F A401630 a(n) = n!*(2*n^2 - 3*n + 1)/3.
%F A401630 a(n) = A006331(n-1)*(n-1)!.
%F A401630 E.g.f.: x^2*(3 + x)*(3*(1 - x)^3).
%F A401630 a(n) ~ 2*sqrt(2*Pi)*exp(-n)*n^(n+5/2)/3 = 10*A019734*exp(-n)*n^(n+5/2).
%t A401630 a[n_]:=2*(n-1)!*(Binomial[n+1,3]+Binomial[n,3]); Array[a,21]
%Y A401630 Cf. A000142, A000292, A000330, A006331, A014105, A019734.
%Y A401630 Cf. A401631, A401632, A401633, A401634.
