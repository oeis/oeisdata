%I A401882 #15 Nov 17 2026 20:56:28
%S A401882 1,2,2,2,8,26,56,98,188,434,1016,2186,4484,9386,20384,44498,95516,
%T A401882 202850,432488,929114,1998836,4285658,9167408,19623842,42073292,
%U A401882 90236690,193404536,414315434,887666084,1902436874,4077634880,8738725490,18725812604,40127520962
%N A401882 Rational part of x(n), where x(1) = 1, x(2) = 2 and x(n) = x(n-1) + sqrt(6)*x(n-2).
%C A401882 x(n) = a(n) + A401883(n)*sqrt(6) is the apothem of the central regular tetrahedron at level n of an additive pyramidal fractal, measured in units of the apothem of the seed tetrahedron. At each level a new central regular tetrahedron receives, centered on each of its 4 faces and with parallel edges, a copy of the previous level; its apothem satisfies r(n) = r(n-1) + h(n-2)*cos(30 degrees), and since the height of a regular tetrahedron is h = 2*sqrt(2)*r, this is r(n) = r(n-1) + sqrt(6)*r(n-2), with r(2) = 2*r(1).
%C A401882 Because sqrt(6)*sqrt(6) = 6, a(n) collects the contributions that pass through an even number of factors sqrt(6), and A401883(n) those that pass through an odd number.
%C A401882 a(n)/A401883(n) tends to sqrt(6) and x(n+1)/x(n) tends to (1 + sqrt(1 + 4*sqrt(6)))/2 = 2.1430123988...
%H A401882 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,0,6).
%F A401882 a(n) = a(n-1) + 6*A401883(n-2), where A401883(n) = A401883(n-1) + a(n-2).
%F A401882 a(n) = 2*a(n-1) - a(n-2) + 6*a(n-4) for n >= 5.
%F A401882 G.f.: x*(1 - x)*(1 + x)/(1 - 2*x + x^2 - 6*x^4).
%e A401882 x(3) = x(2) + sqrt(6)*x(1) = 2 + sqrt(6), so a(3) = 2.
%e A401882 x(5) = x(4) + sqrt(6)*x(3) = (2 + 3*sqrt(6)) + sqrt(6)*(2 + sqrt(6)) = 8 + 5*sqrt(6), so a(5) = 8.
%t A401882 LinearRecurrence[{2, -1, 0, 6}, {1, 2, 2, 2}, 40]
%o A401882 (Python)
%o A401882 def a(n):
%o A401882     r, s = [1, 2], [0, 0]
%o A401882     for k in range(2, n):
%o A401882         r.append(r[k-1] + 6*s[k-2]); s.append(s[k-1] + r[k-2])
%o A401882     return r[n-1]
%Y A401882 Cf. A010464, A041006, A048473, A401883.
%K A401882 nonn,easy,new
%O A401882 1,2
