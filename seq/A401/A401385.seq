%N A401385 Numbers k for which {the largest divisor of sigma(k^2) that is coprime with k^2} is a prime power.
%H A401385 Antti Karttunen, <a href="/A401385/b401385.txt">Table of n, a(n) for n = 1..10000</a>
%F A401385 {k such that A401380(k) = 1}.
%o A401385 (PARI)
%o A401385 A401379(n) = { my(f=factorback(factor(n)[,1]), g=factorback(factor(sigma(n))[,1])); omega(g/gcd(f,g)); };
%o A401385 is_A401385(k) = (1==A401379(k^2));
%Y A401385 Positions of 1's in A401380.
%Y A401385 Cf. A401375, A401379, A401386 (subsequence of terms that are not prime powers), A401387 (squares of these terms).
