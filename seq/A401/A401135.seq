%I A401135 #30 Nov 24 2026 12:24:33
%S A401135 60,1320,12540,1491420,17957940,67669140,82082280,120863880,158133360,
%T A401135 196549920,212012640,243238380,323730480,352181340,356658120,
%U A401135 376756380,461605620,1157230620,1396016160,1528066260,1797880560,2117848740,2357424300,3030245400,3583725600,3843196500,4159916040,4458760680
%N A401135 Areas of primitive Pythagorean triangles that are both the sum of a pair of twin primes and the average of a pair of twin primes.
%H A401135 Robert Israel, <a href="/A401135/b401135.txt">Table of n, a(n) for n = 1..1700</a>
%e A401135 a(3) = 12540 is a term because it is the area of the primitive Pythagorean triangle with sides (120, 209, 241), the average of twin primes 12539 and 12541, and the sum of twin primes 6269 and 6271.
%p A401135 N:= 10^10: S:= {}:
%p A401135 for u from 1 while u*(u^2-1) <= N do
%p A401135   for v from 1 + (u mod 2) by 2 to u/2 do
%p A401135     if igcd(u,v) > 1 then next fi;
%p A401135     a:= u*v*(u^2-v^2); if a > N then break fi;
%p A401135     if andmap(isprime,[a/2-1,a/2+1,a-1,a+1]) then S:= S union {a} fi
%p A401135   od;
%p A401135   for v from u-1 by -2 to u/2 do
%p A401135     if igcd(u,v) > 1 then next fi;
%p A401135     a:= u*v*(u^2-v^2); if a > N then break fi;
%p A401135     if andmap(isprime,[a/2-1,a/2+1,a-1,a+1]) then S:= S union {a} fi
%p A401135 od od:
%p A401135 sort(convert(S,list));
%Y A401135 Cf. A401133, A402209. Intersection of A076504 and A024365.
%K A401135 nonn,new
%O A401135 1,1
%A A401135 _Will Gosnell_ and _Robert Israel_, Nov 20 2026
