%I A401233 #5 Oct 21 2026 10:20:33
%S A401233 1,6,38,45,91,117,126,150,175,209,231,294,305,322,345,375,429,495,510,
%T A401233 578,686,725,775,814,833,981,1083,1122,1175,1250,1271,1273,1441,1462,
%U A401233 1573,1671,1694,1750,1958,2107,2185,2205,2535,2829,2905,2942,3043,3157,3363,3630,3738,3774,3850,3990,4037,4495,4550,4554
%N A401233 Numbers k with no p^p factors and such that A006530(k) [the largest prime dividing k, 1 if k is 1] divides A276085(k), where A276085 is fully additive with a(p) = p#/p.
%o A401233 (PARI)
%o A401233 A359550(n) = { my(pp); forprime(p=2, , pp = p^p; if(!(n%pp), return(0)); if(pp > n, return(1))); };
%o A401233 is_A401232(n) = if(1==n,1,my(f = factor(n)); 0==(sum(k=1, #f~, f[k, 2]*prod(i=1,primepi(f[k, 1]-1),prime(i)))%vecmax(f[,1])));
%o A401233 is_A401233(k) = (A359550(k) && is_A401232(k));
%Y A401233 Cf. A006530, A276085, A359550.
%Y A401233 Intersection of A048103 and A401232.
%Y A401233 Subsequences: A401229, A401231, A401234 (squarefree terms).
%K A401233 nonn,new
%O A401233 1,2
%A A401233 _Antti Karttunen_, Oct 21 2026
