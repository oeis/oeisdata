%I A401118 #14 Oct 24 2026 16:58:00
%S A401118 1,2,3,4,5,5,6,7,8,9,10,10,11,12,12,13,14,15,16,16,17,18,19,19,20,21,
%T A401118 22,23,24,24,25,26,27,28,28,29,30,31,32,32,33,33,34,35,35,36,37,37,38,
%U A401118 39,40,41,42,42,43,43,44,45,46,46,47,48,48,49,50,50,51,52,53,53,54,54,55
%N A401118 Size of the largest subset of {1..n} having no 3-element subset with all pairwise LCMs equal.
%C A401118 Erdős problem #536 asks for an estimate of a(n).
%C A401118 a(n) can be formulated as an integer linear program: max(x(1) + .. + x(n)) subject to x(i) + x(j) + x(k) <= 2 where x(i) in {0,1} for all i, and 1 <= i < j < k <= n forms an LCM triangle; that is, lcm(i,j) = lcm(j,k) = lcm(k,i).
%C A401118 The first 656 terms were computed with two ILP solvers, SCIP and HiGHS, which agree.
%C A401118 They also agree with the first 186 values computed by a branch and bound, and the first 45 values posted by papanokechi in GitHub issue #354 (see links).
%D A401118 H. L. Abbott and B. Gardner, An extremal problem in number theory, Canad. Math. Bull. 10 (1967), 173-177.
%D A401118 P. Erdős, On a problem in elementary number theory and a combinatorial problem, Math. Comp. 18 (1964), 644-646.
%H A401118 Mark Ma, <a href="/A401118/b401118.txt">Table of n, a(n) for n = 1..656</a>
%H A401118 T. F. Bloom, <a href="https://www.erdosproblems.com/536">Erdős Problem #536</a>.
%H A401118 Erdős problems forum, <a href="https://www.erdosproblems.com/forum/thread/536">Discussion of Erdős Problem #536</a> (2025-2026).
%H A401118 K. Kitamura, <a href="https://github.com/KitaKen1/erdos536-lean-five-six-bound">Lean 4 proof of a 5/6-type upper bound for Erdős Problem #536</a> (2026).
%H A401118 papanokechi, <a href="https://github.com/teorth/erdosproblems/issues/354">OEIS: computed sequences for 7 problems flagged possible with no OEIS match</a>, GitHub issue #354 (2026).
%F A401118 a(n) <= a(n+1) <= a(n) + 1.
%F A401118 a(p) = a(p-1) + 1 for prime p.
%F A401118 a(n) >= A399779(n).
%F A401118 a(n) >= (1 - o(1))*n*log(log(n))/log(n), Abbott and Gardner (1967).
%F A401118 a(n) <= n - floor(n/6), Kitamura (2026).
%e A401118 a(6) = 5: delete any element from the only LCM triangle {2,3,6}.
%e A401118 a(12) = 10: delete 2 and 4 to eliminate all LCM triangles {{2,3,6},{2,5,10},{3,4,12},{4,6,12}}. a(12) cannot exceed 10 because two of the LCM triangles, {2,5,10} and {3,4,12}, are disjoint.
%o A401118 (Python)
%o A401118 from math import lcm
%o A401118 from itertools import combinations
%o A401118 def a(n):
%o A401118     bad = [t for t in combinations(range(1, n + 1), 3) if lcm(t[0], t[1]) == lcm(t[1], t[2]) == lcm(t[2], t[0])]
%o A401118     for k in range(n, 0, -1):
%o A401118         for S in combinations(range(1, n + 1), k):
%o A401118             s = set(S)
%o A401118             if not any(s.issuperset(t) for t in bad):
%o A401118                 return k
%o A401118     return 0
%Y A401118 Cf. A068509, A399779.
%K A401118 nonn,new
%O A401118 1,2
%A A401118 _Mark Ma_, Oct 15 2026
