%U A401028 9,4,8,6,0,7,2,5,9,8,6,2,4,2,9,4,6,3,3,8,5,9,7,2,7,6,7,6,6,1,5,1,5
%N A401028 Decimal expansion of 5*Pi^2/(36*Cl_2(Pi/3)), where Cl_2(x) = - Integral_{u=0..x} log(2*sin(u/2)) du.
%H A401028 Mohammad F. Marashdeh, <a href="https://arxiv.org/abs/2610.10570">Partition-theoretic density formulas: radial Tauberian theory and non-radial instability</a>, arXiv:2610.10570 [math.GM], 2026. See p. 9.
%e A401028 1.350598281106342994138450385691075901402533181061735...
%t A401028 RealDigits[Chop[N[5*I/(36*PolyLog[2, (-1)^(1/3)]/Pi^2 - 1), 110]], 10, 105][[1]] (* _Vaclav Kotesovec_, Oct 19 2026 *)
%o A401028 (PARI)
%o A401028 default(realprecision, 150);
%o A401028 xx = Pi/3;
%o A401028 g(t) = if(t == 0, 0, log(sin(xx*t/2)/(xx*t/2)));
%o A401028 c2 = xx*(1 - log(xx)) - xx*intnum(t = 0, 1, g(t));
%o A401028 v = 5*Pi^2/(36*c2);
%o A401028 print(v);
%o A401028 print(digits(floor(v*10^100)));
%Y A401028 Cf. A002388, A019670, A086729, A102753.
%K A401028 nonn,cons,new
%O A401028 1,2
%A A401028 _Stefano Spezia_, Oct 14 2026
