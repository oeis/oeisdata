%S A401427 1,12,111,112,135,144,216,432,2112,11112,11115,11232,12312,13824,
%T A401427 14112,21112,23112,27216,31212,41112,81216,93312,111132,122112,124416,
%U A401427 131112,132192,186624,212112,221112,221184,222912,239112,248832,311472,316224,341712,411264,417312,422144,714112
%N A401427 Numbers that are divisible by the product of the sum and product of their digits.
%C A401427 A positive integer k is in the sequence if A007953(k) * A007954(k) divides k.
%C A401427 It implies that k is zeroless.
%H A401427 Michael S. Branicky, <a href="/A401427/b401427.txt">Table of n, a(n) for n = 1..1000</a>
%e A401427 12 is a term since 1+2 = 3, 1*2 = 2 and 12/(3*2) = 2.
%e A401427 216 is a term since 2+1+6 = 9, 2*1*6 = 12 and 216/(9*12) = 2.
%e A401427 36 is not a term since 3+6 = 9, 3*6 = 18 but 9*18 = 162 does not divide 36.
%t A401427 q[k_] := Module[{d = IntegerDigits[k]}, FreeQ[d, 0] && Divisible[k, (Plus @@ d)*(Times @@ d)]]; Select[Range[720000], q] (* _Amiram Eldar_, Oct 24 2026 *)
%o A401427 (PARI) isok(k) = my(d=digits(k)); vecprod(d) && !(k % (vecprod(d)*vecsum(d))); \\ _Michel Marcus_, Oct 24 2026
%o A401427 (Python)
%o A401427 from math import prod
%o A401427 def ok(n):
%o A401427     d = list(map(int, str(n)))
%o A401427     return 0 not in d and n%(prod(d)*sum(d)) == 0
%o A401427 print([k for k in range(714113) if ok(k)]) # _Michael S. Branicky_, Oct 24 2026
%Y A401427 Supersequence of A038369.
%Y A401427 Subsequence of A005349, A007602, A038186, and A052382.
%Y A401427 Cf. A007953, A007954, A343682.
%K A401427 nonn,base,new
%O A401427 1,2
