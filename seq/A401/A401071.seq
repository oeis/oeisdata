%T A401071 90,92,98,99,100,108,112,116,121,124,126,132,144,147,148,150,153,156,
%U A401071 162,164,169,171,172,175,176,180,188,192,196,198,200,204,207,208,212,220,225,228,236,240
%N A401071 Numbers that are not divisible by the sum of the divisors of their largest unitary divisor that is a square.
%H A401071 Antti Karttunen, <a href="/A401071/b401071.txt">Table of n, a(n) for n = 1..10000</a>
%F A401071 {k such that k != 0 mod A351568(k)}.
%o A401071 (PARI)
%o A401071 A350388(n) = { my(m=1, f=factor(n)); for(k=1, #f~, if(0==(f[k, 2]%2), m *= (f[k, 1]^f[k, 2]))); (m); };
%o A401071 A351568(n) = sigma(A350388(n));
%o A401071 is_A401071(k) = !!(k%A351568(k));
%Y A401071 Cf. A350388, A351568, A401070 (complement).
%Y A401071 Subsequence of A013929, and also of (A377816 U A377817).
%K A401071 nonn,new
%O A401071 1,1
