%S A401695 1,1,1,1,1,2,1,2,1,2,1,2,1,2,2,1,1,2,1,2,2,2,1,5,1,2,2,2,1,5,1,2,2,2,
%T A401695 2,2,1,2,2,5,1,5,1,2,2,2,1,2,1,2,2,2,1,5,2,5,2,2,1,5,1,2,2,2,2,5,1,2,
%U A401695 2,5,1,5,1,2,2,2,2,5,1,2,1,2,1,5,2,2,2,5
%N A401695 Number of unordered factorizations of n into its distinct and pairwise infinitarily coprime infinitary divisors.
%C A401695 First differs from A401697 at n = 120: a(120) = 15, while A401697(120) = 16.
%C A401695 The infinitary divisors of n are listed in row n of A077609.
%C A401695 Two numbers are infinitarily coprime if their greatest common infinitary divisor (A400137) equals 1 (see also A064379).
%H A401695 Amiram Eldar, <a href="/A401695/b401695.txt">Table of n, a(n) for n = 1..10000</a>
%H A401695 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%F A401695 a(n) = A000110(A064547(n)).
%e A401695     n | a(n) | factorizations
%e A401695    ---|------|------------------------------------------------------
%e A401695     2 |   1  | 2
%e A401695     6 |   2  | 6, 2*3
%e A401695    24 |   5  | 24, 3*8, 4*6, 2*12, 2*3*4
%e A401695   120 |  15  | 120, 2*60, 3*40, 4*30, 5*24, 6*20, 8*15, 10*12,
%e A401695       |      | 2*3*20, 2*4*15, 2*5*12, 3*4*10, 3*5*8, 4*5*6, 2*3*4*5
%t A401695 a[n_] := BellB[Plus @@ (DigitSum[FactorInteger[n][[;;, 2]], 2])]; Array[a, 88]
%o A401695 (PARI) bell(n) = {my(b = [1]); for(i = 1, n, my(s = vector(i+1)); s[1] = b[#b]; for(j = 1, i, s[j+1] = s[j] + b[j]); b = s); b[1];}
%o A401695 a(n) = bell(vecsum(apply(hammingweight, factor(n)[, 2])));
%Y A401695 Cf. A000110, A037445, A064379, A064380, A064547, A077609, A400137, A401696, A401697, A401698, A401699.
%Y A401695 Cf. A259936 (unitary analog).
%K A401695 nonn,easy,new
%O A401695 1,6
%A A401695 _Amiram Eldar_, Nov 02 2026
