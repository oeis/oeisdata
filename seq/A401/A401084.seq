%I A401084 #10 Oct 18 2026 09:52:15
%S A401084 1,4,5,4,7,20,9,15,5,28,13,20,15,36,35,15,19,20,21,28,45,52,25,75,7,
%T A401084 60,36,36,31,140,33,58,65,76,63,20,39,84,75,105,43,180,45,52,35,100,
%U A401084 49,75,9,28,95,60,55,144,91,135,105,124,61,140,63,132,45,58,105,260
%N A401084 The total sum of exponentially odd divisors of the exponentially odd divisors of n.
%C A401084 The number of these divisors is A401083(n).
%H A401084 Amiram Eldar, <a href="/A401084/b401084.txt">Table of n, a(n) for n = 1..10000</a>
%F A401084 a(n) = Sum_{d|n, A295316(d) = 1} A033634(d).
%F A401084 Multiplicative with a(p^e) = p * (p^(2*h+4) - (h+2)*p^2 + h + 1)/(p^2-1)^2 + h + 2, where h = floor((e-1)/2).
%F A401084 Dirichlet g.f.: zeta(s) * zeta(2*s-2) * zeta(2*s) * Product_{p prime} (1 + 1/p^(s-1) + 1/p^s - 1/p^(2*s-2) - 1/p^(2*s) - 1/p^(3*s-2) + 1/p^(4*s-2)).
%F A401084 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = zeta(2)^2 * zeta(4) * Product_{p prime} (1 - 1/p^2 - 2/p^4 + 2/p^5 + 1/p^6 - 1/p^7) = 1.61586967353639608026... .
%t A401084 f[p_, e_] := With[{h = Floor[(e - 1)/2]}, p*(p^(2*h + 4) - (h + 2)*p^2 + h + 1)/(p^2 - 1)^2 + h + 2]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 66]
%o A401084 (PARI) a(n) = {my(f = factor(n), p, h); prod(i = 1, #f~, p = f[i, 1]; h = (f[i, 2]-1)\2; p*(p^(2*h + 4) - (h + 2)*p^2 + h + 1)/(p^2 - 1)^2 + h + 2);}
%Y A401084 Cf. A008805, A013661, A013663, A033634 (sum of exponentially odd divisors), A268335, A295316, A322483 (number of exponentially odd divisors), A401083.
%Y A401084 Analogous sequences: A007429 (with all the divisors), A107759 (unitary), A400874 (infinitary), A401085 (square).
%K A401084 nonn,mult,easy,new
%O A401084 1,2
%A A401084 _Amiram Eldar_, Oct 14 2026
