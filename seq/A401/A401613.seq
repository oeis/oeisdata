%T A401613 85,31,22,32,10,298,138,96,66,75,48,79,34,124,44,28,133,47,33,48,10,
%U A401613 491,227,155,107,98,75,111,53,172,60,42,181,63,44,64,14,586
%N A401613 Least height of a building at position 0 that would be seen by the building at position n in the city-building sequence A400000.
%C A401613 The top of building m = A397809(n) constitutes the leftwards horizon from the top of building n. Building m determines the height at which an extra building at position 0 would be seen, as shown in the formula.
%H A401613 Jeff Sponaugle, <a href="/A401613/b401613.txt">Table of n, a(n) for n = 2..10001</a>
%F A401613 a(n) = ceiling((n*A400000(m) - m*A400000(n)) / (n - m)), where m = A397809(n).
%F A401613 If A400708(m) = k then for n <= k, a(n) <= m - 1.
%Y A401613 Cf. A397809, A400000, A400708.
%K A401613 sign,new
%O A401613 2,4
%A A401613 _Peter Munn_, Oct 30 2026
%E A401613 a(17) onward from _Jeff Sponaugle_, Nov 05 2026
