%I A401513 #7 Nov 03 2026 17:47:39
%S A401513 3,5,15,21,35,9,45,77,99,15,117,17,95,21,23,285,231,323,207,225,87,
%T A401513 351,261,377,165,435,621,551,315,185,561,123,665,825,555,215,1023,741,
%U A401513 315,141,897,1073,585,611,53,705,1443,1161,165,1505,1127,1457,1551,1173,1113,1617,1833,2115,195,1485
%N A401513 Odd legs of the primitive Pythagorean triples corresponding to A398554.
%H A401513 Robert Israel, <a href="/A401513/b401513.txt">Table of n, a(n) for n = 1..10000</a>
%F A401513 a(k) = m^2 - n^2 where m and n are coprime with opposite parity and A398554(k) = (2*m^2 + 2*m*n)^2 - (m^2+n^2).
%e A401513 a(3) = 15 because 15 is the odd leg of the primitive Pythagorean triple (8,15,17) which has perimeter 40, hypotenuse 17, and 40^2 - 17 = 1583 = A398554(3).
%p A401513 N:= 10^7: # for terms where A398554(k) <= N
%p A401513 R:= NULL:
%p A401513 for m from 1 while 4*m^4 + 8*m^3 + 3*m^2-1 <= N do
%p A401513   for n from (m mod 2) + 1 by 2 to m-1 do
%p A401513     if igcd(m,n) > 1 then next fi;
%p A401513     v:= (2*m^2 + 2*m*n)^2 - (m^2+n^2);
%p A401513     if v > N then break fi;
%p A401513     if isprime(v) then R:= R, [v,m^2-n^2] fi
%p A401513 od od:
%p A401513 R:= sort([R],(s,t) -> s[1]<t[1]):
%p A401513 R[..,2];
%Y A401513 Cf. A398554, A401514, A401515.
%K A401513 nonn,new
%O A401513 1,1
%A A401513 _Will Gosnell_ and _Robert Israel_, Oct 27 2026
