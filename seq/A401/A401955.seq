%I A401955 #21 Nov 26 2026 17:47:38
%S A401955 0,4,3,1,2,5,14,1,4,8,13,4,4,3,7,1,12,11,16,3,2,34,6,4,18,11,10,15,15,
%T A401955 15,203,1,33,19,5,5,16,17,10,3,9,28,211,14,14,7,202,4,20,32,18,5,4,30,
%U A401955 206,15,16,21,9,8,8,8,27,1,210,18,19,13,6,13,201,5
%N A401955 Number of steps to reach 1 by the map x -> (3x+1)/2 if x is odd, 3x/2 if x == 2 (mod 4), and largest odd factor of x if x == 0 (mod 4), or -1 if 1 is never reached.
%H A401955 Paolo Xausa, <a href="/A401955/b401955.txt">Table of n, a(n) for n = 1..10000</a>
%H A401955 Oleg Vasilyev, <a href="https://arxiv.org/abs/2611.10311">Up or down by half: a family of Collatz-type maps</a>, arXiv:2611.10311 [math.DS], 2026.
%e A401955 a(6) = 5 because the orbit of 6 is 6, 9, 14, 21, 32, 1.
%t A401955 A401955[n_] := Length[NestWhileList[Which[OddQ[#], (3*# + 1)/2, Mod[#, 4] == 2, 3*#/2, True, #/2^IntegerExponent[#, 2]] &, n, # > 1 &]] - 1;
%t A401955 Array[A401955, 100] (* _Paolo Xausa_, Nov 26 2026 *)
%Y A401955 Cf. A006577 (the Collatz steps), A000265 (odd part).
%Y A401955 Cf. A064455 (odd x -> (x+1)/2, even x -> 3x/2), A064433.
%K A401955 nonn,new
%O A401955 1,2
%A A401955 _Oleg Vasilyev_, Nov 10 2026
