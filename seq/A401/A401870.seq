%N A401870 Triangle read by rows: T(n,k) is the number of maximal cliques in the Johnson graph J(n,k).
%H A401870 Andrew Howroyd, <a href="/A401870/b401870.txt">Table of n, a(n) for n = 0..1325</a> (rows 0..50)
%H A401870 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/JohnsonGraph.html">Johnson Graph</a>.
%H A401870 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/MaximalClique.html">Maximal Clique</a>.
%H A401870 Wikipedia, <a href="https://en.wikipedia.org/wiki/Johnson_graph">Johnson graph</a>.
%F A401870 T(n,k) = binomial(n,k-1) + binomial(n,k+1) = A051601(n,k) for 1 < k < n-1.
%F A401870 T(n,k) = T(n,n-k).
%F A401870 T(n,0) = T(n,n) = 1; T(n,1) = T(n,n-1) = 1 for n > 0.
%e A401870 Triangle begins:
%e A401870   1;
%e A401870   1, 1;
%e A401870   1, 1,  1;
%e A401870   1, 1,  1,   1;
%e A401870   1, 1,  8,   1,   1;
%e A401870   1, 1, 15,  15,   1,   1;
%e A401870   1, 1, 26,  30,  26,   1,   1;
%e A401870   1, 1, 42,  56,  56,  42,   1,  1;
%e A401870   1, 1, 64,  98, 112,  98,  64,  1, 1;
%e A401870   1, 1, 93, 162, 210, 210, 162, 93, 1, 1;
%e A401870   ...
%t A401870 A401870[n_, k_] := If[k < 2 || k > n - 2, 1, Plus @@ Binomial[n, {k - 1, k + 1}]];
%t A401870 Table[A401870[n, k], {n, 0, 12}, {k, 0, n}] (* _Paolo Xausa_, Nov 15 2026 *)
%o A401870 (PARI) T(n,k) = if(k<=1||k>=n-1, k>=0&&k<=n, binomial(n,k-1) + binomial(n,k+1))
%Y A401870 Row sums are A142974(n+1) for n >= 3.
%Y A401870 Column k=2 is A000125(n-1) for n >= 4.
%Y A401870 Column k=3 is A055795 for n >= 5.
%Y A401870 Cf. A051601, A381451, A401871 (all cliques).
