%T A401017 0,3,6,1,5,2,4,0,3,6,1,5,2,4,0,7,3,6,1,5,2,4,0,7,3,6,1,5,2,4,8,0,7,3,
%U A401017 6,1,5,2,4,8,0,7,3,6,1,5,2,9,4,8,0,7,3
%N A401017 Sprague-Grundy values of the take-away game in which a player may remove between 1 and floor(sqrt(n)) stones from a pile of n stones.
%C A401017 The positions n with a(n) = 0 are 0 and the terms of the square sieve A002960.
%C A401017 a(m^2) = m, and a(n) = a(n-m-1) for m^2 < n < (m+1)^2, where m = floor(sqrt(n)); this is a special case of a lemma of Levine on restricted Nim.
%H A401017 Andrei Leonov, <a href="https://doi.org/10.5281/zenodo.23183139">The square-root take-away game, the Josephus problem, and Silverman's square sieve</a>, Zenodo, 2026.
%H A401017 Lionel Levine, <a href="https://arxiv.org/abs/math/0409408">Fractal sequences and restricted Nim</a>, arXiv:math/0409408 [math.CO], 2004.
%F A401017 a(n) = A025480(2m - r), where m = floor(sqrt(n)) and r = (n - m^2) mod (m+1).
%e A401017 For n = 1000: m = 31 and r = 39 mod 32 = 7, so a(1000) = A025480(55) = 3. The only move to a position of value 0 removes 8 stones and leaves 992 = 31^2 + A006257(31).
%o A401017 (Python)
%o A401017 from math import isqrt
%o A401017 def a(n):
%o A401017     m = isqrt(n); w = 2*m + 1 - (n - m*m) % (m + 1)
%o A401017     while w % 2 == 0: w //= 2
%o A401017     return (w - 1)//2
%o A401017 print([a(n) for n in range(87)])
%Y A401017 Cf. A002960, A006257, A025480.
%K A401017 nonn,easy,new
%O A401017 0,5
%A A401017 _Andrei Leonov_, Oct 13 2026
