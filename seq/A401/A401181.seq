%U A401181 112501276163032897744759500800,2305434302355034827912249514869760,93009045707100953332301252456803450880
%N A401181 Total number of triangles in all connected labeled graphs on n vertices.
%H A401181 Andrew Howroyd, <a href="/A401181/b401181.txt">Table of n, a(n) for n = 1..50</a>
%F A401181 E.g.f: B(x)/C(x) where B(x) is the e.g.f. of A278704 and C(x) is the e.g.f. of A006125.
%o A401181 (PARI) seq(n) = Vec(serlaplace(sum(j=3, n, binomial(j,3)*2^(binomial(j,2)-3)*x^j/j!, O(x*x^n))/sum(j=0, n, 2^binomial(j,2)*x^j/j!)), -n)
%Y A401181 Column k=3 of A401182.
%Y A401181 Cf. A006125, A278704 (not necessarily connected).
%K A401181 nonn,new
%O A401181 1,4
