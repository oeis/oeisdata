%S A401170 1,3,5,9,13,19,25,33,41,51,55,73,85,87,113,129,133,163,181,195,221,
%T A401170 243,247,289,313,339,365,393,383,451,481,513,545,579,583,649,685,723,
%U A401170 761,801,799,883,925,957,1013,1059,1063,1153,1201,1251,1301,1353,1357,1459,1513,1569,1625,1683,1673,1801
%N A401170 Number of distinct adjacency eigenvalues of the n X n grid graph P_n X P_n.
%C A401170 The adjacency eigenvalues of P_n X P_n are 2*cos(Pi*i/(n+1)) + 2*cos(Pi*j/(n+1)), 1 <= i,j <= n, so a(n) is the number of distinct values of cos(Pi*i/(n+1)) + cos(Pi*j/(n+1)) with 1 <= i <= j <= n.
%e A401170 For n=3 the values cos(Pi*i/4), i=1..3, are r, 0, -r with r = sqrt(2)/2; the six sums with i <= j are 2r, r, 0, 0, -r, -2r, so a(3) = 5.
%o A401170 (Python)
%o A401170 from sympy import cyclotomic_poly, Poly, symbols
%o A401170 def a(n):
%o A401170     x = symbols('x'); m = 2*(n+1)
%o A401170     P = Poly(cyclotomic_poly(m, x), x); s = set()
%o A401170     for i in range(1, n+1):
%o A401170         for j in range(i, n+1):
%o A401170             p = Poly(x**i + x**(m-i) + x**j + x**(m-j), x)
%o A401170             s.add(tuple(p.rem(P).all_coeffs()))
%o A401170     return len(s)
%Y A401170 Cf. A395911.
%K A401170 nonn,new
%O A401170 1,2
%A A401170 _Scott M. Foltz_, Oct 16 2026
