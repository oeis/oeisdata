%N A401967 a(n) = n!^2 / 2^(n - A000120(n)).
%C A401967 By Legendre's formula 2^(n - A000120(n)) = A060818(n) divides n!.
%H A401967 Paolo Xausa, <a href="/A401967/b401967.txt">Table of n, a(n) for n = 0..250</a>
%p A401967 A000120 := n -> add(convert(n, base, 2)): a := n -> n!^2 / 2^(n - A000120(n)): seq(a(n), n = 0..19);
%t A401967 A401967[n_] := n!^2/2^(n - DigitSum[n, 2]); Array[A401967, 20, 0] (* _Paolo Xausa_, Nov 20 2026 *)
