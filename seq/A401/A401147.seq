%S A401147 10,12,14,16,20,24,30,36,40,42,54,60,66,84,90,102,108,110,130,156,198,
%T A401147 210,250,264,306,312,396,444,462,490,522,600,654,690,700,750,810,828,
%U A401147 864,906,920,966,1010,1020,1050,1060,1062,1150,1278,1410,1440,1452,1460
%N A401147 Numbers k such that k^4 - 1 is the product of exactly 4 primes (counted with multiplicity).
%C A401147 All terms are even, since for odd k, v_2(k^4 - 1) >= 4 and k^4 - 1 > 16, so Omega(k^4 - 1) >= 5.
%H A401147 Enyu Chen, <a href="/A401147/b401147.txt">Table of n, a(n) for n = 1..4946</a>
%e A401147 10 is a term because 10^4 - 1 = 9999 = 3^2 * 11 * 101 has exactly 4 prime factors.
%o A401147 (PARI) isok(k) = !(k%2) && bigomega(k^4 - 1) == 4
%o A401147 (Python)
%o A401147 from itertools import count, islice
%o A401147 from sympy import factorint
%o A401147 def A401147_gen(startvalue=2): # generator of terms >= startvalue
%o A401147     for k in count(max(startvalue+(startvalue&1),2),2):
%o A401147         if sum(factorint(k-1).values())+sum(factorint(k+1).values())+sum(factorint(k*k+1).values()) == 4:
%o A401147             yield k
%o A401147 A401147_list = list(islice(A401147_gen(),40)) # _Chai Wah Wu_, Oct 21 2026
%Y A401147 Cf. similar for bigomega(x^m-1) = m: A014574 (m=2), A386915 (m=3).
%Y A401147 Cf. A001222, A368163.
%K A401147 nonn,new
%O A401147 1,1
