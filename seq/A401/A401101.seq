%I A401101 #14 Oct 18 2026 14:04:56
%S A401101 4,44,444,4434,44334,443334,4433344,44333444,443334444,4433344434,
%T A401101 44333444344,443334443434,4433344434344,44333444343434,
%U A401101 443334443434334,4433344434343334,44333444343433344,443334443434333444,4433344434343334444,44333444343433344444,443334443434333444444
%N A401101 Base-5/2 expression (A024632) of 5*A401100(n) - 1.
%C A401101 a(n) is the base-5/2 expression of the largest number with n+1 digits.
%C A401101 c*10^n - 4/9 < (a(n) - 4)/10 < c*10^n - 1/3 for some constant c; cf. the comment in A061419 applied to {(a(n)-4)/10}, with alpha = 10, a = 3, and b = 4.
%H A401101 Jianing Song, <a href="/A401101/b401101.txt">Table of n, a(n) for n = 0..999</a>
%F A401101 Let b(n) = A401100(n).
%F A401101 If b(n-1) is even, then 5*b(n) - 1 = 5*(5*b(n-1) - 1)/2 + 3/2, and so a(n) ends in 34 (i.e., a(n) = 10*a(n-1) - 6);
%F A401101 If b(n-1) is odd, then 5*b(n) - 1 = 5*(5*b(n-1) - 1)/2 + 4, and so a(n) ends in 44 (i.e., a(n) = 10*a(n-1) + 4).
%e A401101 n | 5*A401100(n)-1 | Base-5/2 expression
%e A401101 0 |          4     |               4
%e A401101 1 |         14     |              44
%e A401101 2 |         39     |             444
%e A401101 3 |         99     |            4434
%e A401101 4 |        249     |           44334
%e A401101 5 |        624     |          443334
%e A401101 6 |       1564     |         4433344
%e A401101 7 |       3914     |        44333444
%e A401101 8 |       9789     |       443334444
%e A401101 9 |      24474     |      4433344434
%o A401101 (PARI) A401101_up_to_N(N) = my(v = vector(N+1), A401100_N = 1); v[1] = 4; for(n=1, N, v[n+1] = 10*v[n] - 6 + 10*(A401100_N % 2); A401100_N = ceil(5*A401100_N/2)); v \\ gives a(0..N)
%Y A401101 Cf. A024632, A401100, A401102.
%K A401101 nonn,base,new
%O A401101 0,1
%A A401101 _Jianing Song_, Oct 14 2026
