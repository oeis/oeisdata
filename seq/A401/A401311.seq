%I A401311 #34 Nov 05 2026 21:20:32
%S A401311 3,11,127,1787,52711,1128889,37139213,997525853,36294260117,
%T A401311 1765037224331,75063692618249,4176603711876241,214616508361122337,
%U A401311 10643741922535940459
%N A401311 Prime staircase: a(n) is obtained by starting from n and iterating the prime-indexing map x -> prime(x) exactly n+1 times.
%H A401311 Neil Fernandez, <a href="https://www.borve.org/primeness/FOP.html">An order of primeness, F(p)</a>, 1999.
%H A401311 Piotr Miska, János T. Tóth, and Błażej Żmija, <a href="https://arxiv.org/abs/1908.10421">On distribution of subsequences of primes having prime indices with respect to the (R)-denseness and convergence exponent</a>, arXiv:1908.10421 [math.NT], 2019-2022.
%H A401311 Justo Tapiador, <a href="https://github.com/Justo-Tapiador/maths/blob/main/prime-staircase/prime_staircase.pdf">The Prime Staircase: Superexponential Growth along the Diagonal of the Hierarchy of Higher-Order Primes</a>, preprint, 2026.
%F A401311 a(n) = A000040(A058009(n)).
%F A401311 F(a(n)) = n + 1 + F(n), where F = A049076 (order of primeness).
%F A401311 log a(n) ~ n*log(n) ~ prime(n). [Tapiador 2026].
%F A401311 #{n >= 1 : a(n) <= x} ~ log x/log log x. [Tapiador 2026].
%F A401311 From _Michael S. Branicky_, Oct 31 2026: (Start)
%F A401311 a(n) = A354967(n, n+1).
%F A401311 a(n) = first subdiagonal of A377173. (End)
%e A401311 Starting from n and applying x -> prime(x) exactly n+1 times:
%e A401311   a(1): 1 -> 2 -> 3
%e A401311   a(2): 2 -> 3 -> 5 -> 11
%e A401311   a(3): 3 -> 5 -> 11 -> 31 -> 127
%e A401311   a(4): 4 -> 7 -> 17 -> 59 -> 277 -> 1787
%e A401311   a(5): 5 -> 11 -> 31 -> 127 -> 709 -> 5381 -> 52711
%e A401311   a(6): 6 -> 13 -> 41 -> 179 -> 1063 -> 8527 -> 87803 -> 1128889
%t A401311 f[n_] := Prime[n];
%t A401311 a[n_] := Nest[f, n, n + 1];
%t A401311 Table[a[n], {n, 1, 8}]
%o A401311 (PARI)
%o A401311 a(n) = my(x = n); for(i = 1, n+1, x = prime(x)); x;
%o A401311 vector(8, n, a(n))
%o A401311 (Python)
%o A401311 from sympy import prime
%o A401311 def a(n):
%o A401311     x = n
%o A401311     for _ in range(n + 1):
%o A401311         x = prime(x)
%o A401311     return x
%o A401311 print([a(n) for n in range(1, 9)])
%Y A401311 Cf. A000040, A058009, A354967, A377173.
%Y A401311 Cf. A049203, A049202, A049076, A061775.
%K A401311 nonn,hard,more,new
%O A401311 1,1
%A A401311 _Justo Tapiador_, Oct 20 2026
