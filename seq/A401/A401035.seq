%S A401035 10588881419,13604651997,4602075977773,7185059419357,22771734649091,
%T A401035 103362575997617,125522831763757,127347490786823,135120626406611,
%U A401035 378192218282731,816193198463833,1185441474342581,1625729892390521,1713544049269207,2006267725078037,4466448534863069
%N A401035 Numbers that are the sum of 3 cubes of primes in at least 5 ways.
%C A401035 The primes need not be distinct; representations are counted as unordered triples p <= q <= r. a(1)-a(51) are all the terms below 2.18*10^17. Each has exactly five representations, and in each representation the three primes are distinct. - _Jeff Sponaugle_, Nov 05 2026
%H A401035 Jeff Sponaugle, <a href="/A401035/b401035.txt">Table of n, a(n) for n = 1..113</a>
%H A401035 Thomas Bloom, <a href="https://www.erdosproblems.com/979">Problem 979</a>, Erdős Problems.
%H A401035 Jeff Sponaugle, <a href="/A401035/a401035.txt">The terms below 2.18*10^17 with their representations</a>
%e A401035 a(1) = 10588881419 = 59^3 + 1669^3 + 1811^3 = 83^3 + 1567^3 + 1889^3 = 139^3 + 1427^3 + 1973^3 = 349^3 + 1091^3 + 2099^3 = 479^3 + 929^3 + 2131^3.
%o A401035 (Python)
%o A401035 from sympy import primerange
%o A401035 from collections import Counter
%o A401035 def aupto(lim):
%o A401035     ps = list(primerange(2, int(round(lim**(1/3))) + 2))
%o A401035     c = Counter()
%o A401035     for i, p in enumerate(ps):
%o A401035         for j in range(i, len(ps)):
%o A401035             s2 = p**3 + ps[j]**3
%o A401035             if s2 + ps[j]**3 > lim: break
%o A401035             for k in range(j, len(ps)):
%o A401035                 s = s2 + ps[k]**3
%o A401035                 if s > lim: break
%o A401035                 c[s] += 1
%o A401035     return sorted(n for n, v in c.items() if v >= 5)
%o A401035 print(aupto(2*10**10))
%Y A401035 Cf. A385316.
%Y A401035 Cf. A030078, A258865, A385316.
%K A401035 nonn,changed
