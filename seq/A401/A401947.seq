%I A401947 #21 Nov 10 2026 06:26:02
%S A401947 1,0,1,0,2,0,2,1,0,2,2,0,2,3,1,0,2,4,2,0,2,5,4,0,2,6,6,1,0,2,7,9,2,0,
%T A401947 2,8,12,4,0,2,9,16,7,1,0,2,10,20,11,2,0,2,11,25,16,4,0,2,12,30,23,7,0,
%U A401947 2,13,36,31,12,1,0,2,14,42,41,18,2,0,2,15,49,53,27,4
%N A401947 Irregular triangle read by rows: T(n,k) is the number of k-element sets of line sizes that can arise from configurations of n distinct points in the real plane, for n >= 1 and 0 <= k <= floor(sqrt(4*n+3)) - 2.
%C A401947 For a set P of points, the set of line sizes is obtained by counting the points of P on each line that contains at least two points of P.
%H A401947 Thomas F. Bloom, <a href="https://www.erdosproblems.com/607">Erdős Problem 607</a>, Erdős Problems.
%H A401947 Wikipedia, <a href="https://en.wikipedia.org/wiki/Sylvester-Gallai theorem">Sylvester-Gallai theorem</a>.
%F A401947 T(n,1) = 2 for n >= 3.
%F A401947 T(n,2) = n - 3 for n >= 4.
%e A401947 Irregular triangle begins:
%e A401947   1;
%e A401947   0, 1;
%e A401947   0, 2;
%e A401947   0, 2, 1;
%e A401947   0, 2, 2;
%e A401947   0, 2, 3, 1;
%e A401947   0, 2, 4, 2;
%e A401947   0, 2, 5, 4;
%e A401947   0, 2, 6, 6, 1;
%e A401947   0, 2, 7, 9, 2;
%e A401947   ...
%o A401947 (PARI) T(n, k) = if(k<2, if(k, min(n-1, 2), n==1), my(r=k-1, cnt=0); forsubset([n-1, r], s, if(s[1]>=3, cnt+=sum(i=1, r, max(0, s[i]+i-r))<=n)); cnt);
%Y A401947 Row sums give A401948.
%K A401947 nonn,tabf,new
%O A401947 1,5
%A A401947 _Seiichi Manyama_, Nov 09 2026
