%S A401482 1,8,27,125,128,216,343,1000,1331,2187,2197,2744,3375,3456,4913,6859,
%T A401482 9261,10648,12167,16000,17496,17576,24389,27000,29791,32768,35937,
%U A401482 39304,42875,43904,50653,54872,59319,68921,74088,78125,79507,97336,103823,132651,148877,166375
%N A401482 Powerful numbers whose number of divisors is a power of 2.
%C A401482 All the terms are cubefull, since the number of divisors of a number with an exponent 2 in its prime factorization is divisible by 3 and therefore it is not a power of 2.
%C A401482 All the terms of A036537 are a product of a term in this sequence and a coprime squarefree number (A005117).
%C A401482 The asymptotic density of terms in A036537 whose powerful part (A057521, or cubefull part, A360540) is a term k in this sequence is (1/(zeta(2)*k)) * Product_{p|k} p/(p+1) = 1/(zeta(2)*A001615(k)). Therefore, A327839 (the asymptotic density of A036537) can be evaluated by summing over terms in this sequence (see the 2nd formula).
%H A401482 Amiram Eldar, <a href="/A401482/b401482.txt">Table of n, a(n) for n = 1..10000</a>
%H A401482 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A401482 Sum_{n>=1} 1/a(n) = Product_{p prime} (1 + Sum_{k>=2} 1/p^(2^k-1)) = 1.19034363901128237028... .
%F A401482 Sum_{n>=1} 1/A001615(a(n)) = zeta(2) * A327839.
%t A401482 q[k_] := k == 1 || AllTrue[FactorInteger[k][[;; , 2]], # > 1 && # + 1 == 2^IntegerExponent[# + 1, 2] &]; Select[Range[170000], q]
%o A401482 (PARI) isok(k) = {my(e = factor(k)[, 2]); for(i = 1, #e, if(e[i] == 1 || (e[i] + 1) >> valuation((e[i]+1), 2) > 1, return(0))); 1;}
%Y A401482 Intersection of A001694 (or A036966) and A036537.
%Y A401482 Cf. A001615, A005117, A013661, A057521, A327839, A360540.
%Y A401482 Similar sequences: A335988, A369567, A401483.
%K A401482 nonn,easy,new
%O A401482 1,2
