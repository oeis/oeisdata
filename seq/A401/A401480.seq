%S A401480 4,18,735,65065,1446445,30715685,855189335,207245839801,9152243699599,
%T A401480 415808693487187,18751957908727043,963327326055303209,
%U A401480 540204098376659741453,34069482204399167761807,2507178780582751870209043,188637137804741077279459489,14158412779738946490454079111
%N A401480 Smallest k = prime(j) * Product_{h=i..j} prime(h) such that A008479(k) = n+1.
%C A401480 Smallest numbers k of the form rad(k) * p_n such that A008479(k) = n+1 (i.e., A008479(k) is minimized for numbers of that form), where rad = A007947 and p_n is the n-th smallest distinct prime factor of k.
%C A401480 Proper subset of A229027, numbers k of the form rad(k) * gpf(k), where gpf(k) is the greatest prime factor of k.
%H A401480 Michael De Vlieger, <a href="/A401480/b401480.txt">Table of n, a(n) for n = 1..301</a>
%e A401480 Table of n, a(n) for n = 1..8:
%e A401480   n            a(n)                                 A008479(a(n))
%e A401480   ---------------------------------------------------------------
%e A401480   1              4 = 2^2                                      2
%e A401480   2             18 = 2 *  3^2                                 3
%e A401480   3            735 = 3 *  5 *  7^2                            4
%e A401480   4          65065 = 5 *  7 * 11 * 13^2                       5
%e A401480   5        1446445 = 5 *  7 * 11 * 13 * 17^2                  6
%e A401480   6       30715685 = 5 *  7 * 11 * 13 * 17 * 19^2             7
%e A401480   7      855189335 = 5 *  7 * 11 * 13 * 17 * 19 * 23^2        8
%e A401480   8   207245839801 = 7 * 11 * 13 * 17 * 19 * 23 * 29 * 31^2   9
%t A401480 (* First, load the theta program from links in A369609, then: *)
%t A401480 Q[i_, j_] := Prime[i + j] * Product[Prime[h], {h, i, i + j}]; i = 1; Transpose@ Reap[Do[While[theta[-Q[i, j] ] > j + 2, i++]; Sow[Q[i, j]], {j, 0, 16}] ][[-1, 1]]
%Y A401480 Cf. A007947, A008479, A229027.
%K A401480 nonn,new
%O A401480 1,1
%A A401480 _Michael De Vlieger_, Oct 27 2026
