%S A401253 0,0,0,2,0,4,0,10,8,12,0,22,0,20,24,34,0,44,0,50,40,36,0,82,32,44,56,
%T A401253 82,0,108,0,98,72,60,80,154,0,68,88,166,0,168,0,146,168,84,0,242,72,
%U A401253 172,120,178,0,236,144,254,136,108,0,366,0,116,256,258,176,296,0,242,168,348
%N A401253 Sum of absolute differences of consecutive terms of gcd(n,k), k = 1..n-1.
%C A401253 Equivalently, a(n) is the total variation of the finite sequence gcd(n,1), gcd(n,2), ..., gcd(n,n-1), obtained from the gcd table A109004.
%C A401253 For n > 1, a(n) = 0 if and only if n is prime.
%C A401253 a(n) == 2 (mod 4) if 4 divides n, and a(n) == 0 (mod 4) otherwise.
%C A401253 This is the gcd counterpart of A397676, which considers the total variation of n/gcd(n,k).
%H A401253 Paolo Xausa, <a href="/A401253/b401253.txt">Table of n, a(n) for n = 1..10000</a>
%F A401253 a(n) = Sum_{k=1..n-2} abs(gcd(n,k+1) - gcd(n,k)), with a(1) = 0.
%F A401253 a(p^r) = 2*((r*p-r-p)*p^(r-1) + 1), for prime p and r >= 1.
%F A401253 a(p*q) = 4*(p-1)*(q-2), for distinct primes p < q.
%e A401253 For n = 6, the terms gcd(6,k), k = 1..5, are 1, 2, 3, 2, 1. Hence a(6) = 1+1+1+1 = 4.
%e A401253 For n = 12, the terms are 1, 2, 3, 4, 1, 6, 1, 4, 3, 2, 1. Their consecutive absolute differences sum to a(12) = 22.
%t A401253 A401253[n_] := 2*Total[Abs[Differences[GCD[n, Range[n/2]]]]];
%t A401253 Array[A401253, 100] (* _Paolo Xausa_, Oct 25 2026 *)
%o A401253 (Python)
%o A401253 from math import gcd
%o A401253 def a(n):
%o A401253     return sum(abs(gcd(n, k+1) - gcd(n, k))
%o A401253                for k in range(1, n-1))
%o A401253 (PARI)
%o A401253 a(n) = sum(k=1, n-2, abs(gcd(n,k+1)-gcd(n,k)));
%Y A401253 Cf. A018804, A054531, A109004, A397676, A397783, A401025.
%K A401253 nonn,new
%O A401253 1,4
