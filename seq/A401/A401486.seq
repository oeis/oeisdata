%T A401486 8192,10000,14641,16807,19683,20000,20736,28561,38416,41472,50000,
%U A401486 50625,62208,65536,76832,83521,100000,104976,124416,130321,131072,151875,160000,161051,194481
%N A401486 Powerful numbers that have an odd number of square divisors.
%C A401486 Powerful numbers k such that A046951(k) is odd.
%C A401486 Powerful numbers k such that the largest square dividing k (A008833) is a fourth power.
%C A401486 Numbers whose prime factorization exponents are larger than 1 and of the form 4*k or 4*k+1 with k >= 1.
%H A401486 Amiram Eldar, <a href="/A401486/b401486.txt">Table of n, a(n) for n = 1..10000</a>
%H A401486 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A401486 Sum_{n>=1} 1/a(n) = zeta(4) * zeta(5) / zeta(10) = 1.12117590740019433961... .
%F A401486 (1/zeta(2)) * Sum_{n>=1} 1/A001615(a(n)) = zeta(4) / zeta(2) = Pi^2/15 (A182448, the asymptotic density of A252895).
%t A401486 q[k_] := k == 1 || AllTrue[FactorInteger[k][[;; , 2]], # > 1 && Mod[#, 4] < 2 &]; Select[Range[200000], q]
%o A401486 (PARI) isok(k) = #select(e -> (e == 1 || e%4 > 1), factor(k)[, 2]) == 0;
%Y A401486 Intersection of A001694 (or A036967) and A252895.
%Y A401486 Cf. A001615, A008833, A046951.
%Y A401486 Cf. A013661, A013662, A013663, A013668, A182448.
