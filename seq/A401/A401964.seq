%I A401964 #13 Nov 13 2026 16:43:03
%S A401964 1,4,2,7,4,11,7,16,11,22,16,29,22,37,29,46,37,56,46,67,56,79,67,92,79,
%T A401964 106,92,121,106,137,121,154,137,172,154,191,172,211,191,232,211,254,
%U A401964 232,277,254,301,277,326,301,352,326,379,352,407,379,436,407,466,436,497,466,529,497
%N A401964 a(n) with a(1) = 1, a(2*n) = a(2*n-1) + (2*n+1) and a(2*n+1) = a(2*n) - (n+1).
%C A401964 Sequence A000124 fills not only the odd-indexed terms but also the even-indexed terms, i.e., a(2*n+3) = a(2*n).
%C A401964 a(n) - a(n+1) - a(n+2) + a(n+3) = (1 - (-1)^n * 3) / 2.
%C A401964 a(n) - 2*a(n+2) + a(n+4) = 1.
%H A401964 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (1,2,-2,-1,1).
%F A401964 a(2*n-1) = (n*(n-1) + 2) / 2; a(2*n) = ((n+2)*(n+1) + 2) / 2.
%F A401964 a(n) = a(n-1) + (1 + (-1)^n * 3) * (n+1) / 4 for n > 1.
%F A401964 a(n) = a(n-1) + 2 * a(n-2) - 2 * a(n-3) - a(n-4) + a(n-5) for n > 5.
%F A401964 a(n) = (2*n*(n+3) + 23 + (-1)^n * (6*n + 9)) / 16.
%F A401964 G.f.: x * (1 + 3 * x - 4 * x^2 - x^3 + 2 * x^4) / ((1-x)^3 * (1+x)^2).
%t A401964 LinearRecurrence[{1, 2, -2, -1, 1}, {1, 4, 2, 7, 4}, 63] (* _Amiram Eldar_, Nov 10 2026 *)
%o A401964 (PARI) a(n)=(2*n*(n+3)+23+(-1)^n*(6*n+9))/16
%Y A401964 Cf. A000124.
