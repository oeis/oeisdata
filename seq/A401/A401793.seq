%F A401793 a(n) = (7*n^4 - 16*n^3 + 20*n^2 - 11*n + 3)/3.
%F A401793 G.f.: x*(1 + 10*x + 30*x^2 + 14*x^3 + x^4)/(1 - x)^5.
%t A401793 A401793[n_] := (n - 1)*n*(n*(7*n - 9) + 11)/3 + 1; Array[A401793, 50] (* _Paolo Xausa_, Nov 21 2026 *)
