%N A401682 a(0) = 1; a(n) = Sum_{k=1..n} binomial(3*n,k) * a(n-k).
%F A401682 G.f. A(x) satisfies A(x) = (1-2*x)/(1+x) * (2*A(x/(1+x)^3) - 1).
%F A401682 3|a(n) for n > 0.
%F A401682 a(n) ~ c * n! * 3^n * n^(log(2)/3) / log(2)^n, where c = 0.82375333226767364175335946383312182538262447689226568790726... - _Vaclav Kotesovec_, Nov 02 2026
%t A401682 a[0] = 1; a[n_] := a[n] = Sum[Binomial[3*n, k]*a[n-k], {k, 1, n}]; Table[a[n], {n, 0, 20}] (* _Vaclav Kotesovec_, Nov 02 2026 *)
%o A401682 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(3*i, j)*v[i-j+1])); v;
