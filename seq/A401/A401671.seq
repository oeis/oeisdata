%S A401671 1,8,2080,14899040,2822177161216,13895602221623143040,
%T A401671 1762801240359502504316108800,5732363441438284689943863013142388224,
%U A401671 476276701320993264805672364377789450632036352000,1008864170338381111551758102567434764908191487812197183211520
%N A401671 Number of spanning trees of the n X n triangular-lattice rhombus graph.
%C A401671 The triangular-lattice rhombus graph is the grid graph P_n X P_n with one diagonal (x,y)-(x+1,y+1) in each unit square.
%H A401671 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/SpanningTree.html">Spanning Tree</a>.
%e A401671 a(2) = 8: K_4 minus an edge has 8 spanning trees.
%o A401671 (Python)
%o A401671 from flint import fmpz_mat
%o A401671 def rhombus(n):  # P_n X P_n plus the diagonal (x,y)-(x+1,y+1) in every unit square
%o A401671     V = n*n; A = [[0]*V for _ in range(V)]
%o A401671     for x in range(n):
%o A401671         for y in range(n):
%o A401671             for dx, dy in ((1, 0), (0, 1), (1, 1)):
%o A401671                 if x+dx < n and y+dy < n:
%o A401671                     u, v = x*n+y, (x+dx)*n+y+dy; A[u][v] = A[v][u] = 1
%o A401671     return A
%o A401671 def a(n):
%o A401671     if n == 1: return 1
%o A401671     A = rhombus(n); V = n*n
%o A401671     L = [[(sum(A[i]) if i == j else -A[i][j]) for j in range(V)] for i in range(V)]
%o A401671     return int(fmpz_mat([r[1:] for r in L[1:]]).det())
%o A401671 print([a(n) for n in range(1, 8)])
%Y A401671 Cf. A066864, A007341, A116469, A174579, A351994, A351888.
%K A401671 nonn,new
