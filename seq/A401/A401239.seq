%U A401239 2,3,1,3,1,2,2,2,2,3,1,3,2,2,1,3,2,2,2,3
%N A401239 The number of prime powers with odd exponents (A246551) that divide n.
%C A401239 First differs from A376885 at n = 64.
%C A401239 Inverse Moebius transform of A353817.
%H A401239 Amiram Eldar, <a href="/A401239/b401239.txt">Table of n, a(n) for n = 1..10000</a>
%F A401239 Additive with a(p^e) = ceiling(e/2) = A110654(e).
%F A401239 a(n) = Sum_{d|n} A353817(d).
%F A401239 a(n) = A001222(n) - A362412(n).
%F A401239 a(n) = (A001222(n) + A162642(n))/2.
%F A401239 a(n) <= A001222(n), with equality if and only if n is squarefree (A005117).
%F A401239 a(n) = A001222(A019554(n)).
%F A401239 a(n) = A001222(A053143(n))/2.
%F A401239 a(n) = 1 if and only if n is a prime or a square of a prime (A000430).
%F A401239 Sum_{k=1..n} a(k) ~ n * (log(log(n)) + c), where c = A083342 - A154945 = 0.48296058424... .
%t A401239 f[p_, e_] := Ceiling[e/2]; a[1] = 0; a[n_] := Plus @@ f @@@ FactorInteger[n]; Array[a, 88]
%o A401239 (PARI) a(n) = vecsum(ceil(factor(n)[,2]/2));
%Y A401239 Cf. A000430, A001222, A005117, A019554, A053143, A083342, A110654, A154945, A162642, A246551, A353817, A362412, A376885.
