%e A401763 For n = 3, k = 4, r = 3, s = 4 - 3*(3-1)/2 = 1.
%e A401763 A(3,4) = 3^(3-0)*1^0 + 3^(3-1)*1^1 + 3^(3-2)*1^2 + 3^(3-3)*1^3 = 27 + 9 + 3 + 1 = 40.
%o A401763 (Python)
%o A401763 def h(n, r, s):
%o A401763     return sum(r**(n-i) * s**i for i in range(n+1))
%o A401763 def A(n, k):
%o A401763     r = 1
%o A401763     while r*(r+1)//2 < k:
%o A401763         r += 1
%o A401763     s = k - r*(r-1)//2
%o A401763     return h(n, r, s)
%o A401763 a = []
%o A401763 for d in range(2, 12):
%o A401763     a.extend(A(n, d-n) for n in range(1, d))
%o A401763 print(a)
%o A401763 (PARI) a(n, k) = my(r=(sqrtint(8*k)+1)\2, s=k-r*(r-1)/2); ([r, 1; 0, s]^(n+1))[1, 2]; \\ _Ruud H.G. van Tol_, Nov 05 2026
