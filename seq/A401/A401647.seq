%U A401647 50331142143124851064711819,704111621731641051165713829,905011821931841251468714839,1105712022132141451569718869,13065124222323417517611720889
%N A401647 Summarize all the previous terms (digits in increasing order), starting with a(1) = 1.
%C A401647 Like A005151, but summarizes all previous terms, instead of only the most recent.
%C A401647 Differs from A060857 starting at n=8. - _Michael S. Branicky_, Nov 01 2026
%H A401647 Michael S. Branicky, <a href="/A401647/b401647.txt">Table of n, a(n) for n = 1..10000</a>
%e A401647 a(4) = 4113 since the previous terms are 1, 11, 31; sorting all digits gives 11113, and summarizing that gives 4 1s and 1 3.
%o A401647 (Python)
%o A401647 from itertools import islice
%o A401647 from collections import Counter
%o A401647 def A401647(): # generator of terms
%o A401647     s, c = "1", Counter()
%o A401647     while True:
%o A401647         yield int(s)
%o A401647         c.update(s)
%o A401647         s = "".join(str(c[d])+d for d in "0123456789" if c[d]>0)
%o A401647 print(list(islice(A401647(), 16))) # _Michael S. Branicky_, Nov 01 2026
%Y A401647 Cf. A005151, A045982, A060857.
%K A401647 nonn,base,new
%O A401647 1,2
