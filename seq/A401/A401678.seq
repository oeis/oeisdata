%U A401678 131052690664284549141,7830914898133491507243,496269322167966752506761,33247589007689080145839935
%N A401678 a(0) = 1; a(n) = Sum_{k=1..n} 2^(k-1) * binomial(2*n+k,k) * a(n-k).
%F A401678 G.f. A(x) satisfies A(x) = (1-6*x) * (3*A(x*(1-2*x)^2) - 2).
%F A401678 3|a(n) for n > 0.
%o A401678 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, 2^(j-1)*binomial(2*i+j, j)*v[i-j+1])); v;
