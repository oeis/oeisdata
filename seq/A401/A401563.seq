%U A401563 98484922246850760,4186537094169545840,190256402005538649219,9202096547991508884606,472047180706419697255171,25595964879004748234280600
%N A401563 E.g.f. A(x) satisfies: A(x) = x * exp( A(x) + A(x^2)/2! + A(x^3)/3! + A(x^4)/4! + ... ).
%H A401563 Vaclav Kotesovec, <a href="/A401563/b401563.txt">Table of n, a(n) for n = 0..380</a>
%F A401563 a(n) ~ c * n! * d^n / n^(3/2), where d = 2.929023298793058679757384848827769822164205331... and c = 0.4336592682217896389441301141438819609643... - _Vaclav Kotesovec_, Oct 30 2026
%t A401563 nmax = 20; A[_] = 0; Do[A[x_] = x Exp[Sum[A[x^k]/k!, {k, 1, nmax}]] + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x] Range[0, nmax]!
%t A401563 (* Alternative: *)
%t A401563 a[0] = 0; a[1] = 1; a[n_] := a[n] = n!/(n - 1) Sum[a[j] a[n - j k]/((k - 1)! (j - 1)! (n - j k)!), {k, 1, n - 1}, {j, 1, Floor[(n - 1)/k]}]; Table[a[n], {n, 0, 20}]
%Y A401563 Cf. A000081, A035051.
%K A401563 nonn,new
