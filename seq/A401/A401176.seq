%S A401176 -2,-1,0,1,0,1,0,1,2,1,0,1,0,1,2,1,0,1,0,1,2,1,2,3,4,1,2,1,0,1,0,1,2,
%T A401176 3,4,1,0,1,2,1,0,1,0,1,2,3,4,5,6,1,2,1,2,3,4,1,2,1,0,1,0,1,2,3,4,1,0,
%U A401176 1,2,1,0,1,2,3,4,5,6,1,0,1,2,1,2,3,4,1,2,3,4,5,6,1,2,3,4,1,0,1,2,1,0
%N A401176 a(n) = n - min_{k > n, k composite} (k - spf(k)), where spf(k) is the smallest prime factor of k.
%C A401176 This is n - F(n), where F(n) is defined in the commentary on Erdős Problem 463.
%H A401176 Seiichi Manyama, <a href="/A401176/b401176.txt">Table of n, a(n) for n = 0..10000</a>
%H A401176 Thomas F. Bloom, <a href="https://www.erdosproblems.com/463">Erdős Problem 463</a>, Erdős Problems.
%F A401176 a(n) >= 0 for n > 1.
%o A401176 (PARI) a(n) = if(n<2, n-2, my(r=n); forcomposite(k=n+1, 2*n, r=min(r, k-factor(k)[1, 1])); n-r);
%Y A401176 Cf. A020639, A322292.
%K A401176 sign,new
%O A401176 0,1
%A A401176 _Seiichi Manyama_, Oct 16 2026
