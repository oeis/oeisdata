%I A401665 #9 Nov 08 2026 15:30:45
%S A401665 34,54,68,73,74,89,96,102,119,139,143,144,146,164,165,168,172,183,187,
%T A401665 198,208,210,211,215,227,229,234,242,243,252,257,259,271,278,281,282,
%U A401665 286,288,289,292,296,308,321,334,337,348,352,353,357,358,361,364,366
%N A401665 Numbers k >= 2 such that the root mean square of the consecutive integers r, r+1, ..., k is an integer for some 1 <= r <= k-1.
%C A401665 Equivalently, numbers k such that (k*(k + 1)*(2*k + 1) - (r - 1)*r*(2*r-1)) / (6*(k - r + 1)) = c^2, where r is from [1, k-1], k >= 2, c are positive integers.
%C A401665 The block (1, ..., k) gives the subsequence 337, 65521, 12710881, ... (A084231).
%C A401665 The least k such that RMS(r, r+1, ..., k) is an integer for 1,2,3,... distinct values of r is {34, 139, 712, 1493, 3126, 6464, ...}.
%e A401665 For k = 34: (34*35*69 - (r - 1)*r*(2*r-1)) / (210 - 6*r) = c^2 for r = 4, c = 21, thus 34 is a term.
%e A401665 For k = 139: (139*140*279 - (r - 1)*r*(2*r - 1)) / (840 - 6*r) = c^2 for r = 45, c = 96, and for r = 69, c = 106, thus 139 is a term.
%t A401665 q[k_] := AnyTrue[Range[k-1], IntegerQ[Sqrt[(k*(k + 1)*(2*k + 1) - (# - 1)*#*(2*# - 1))/(6*(k - # + 1))] ] &]; Select[Range[366], q] (* _Amiram Eldar_, Nov 01 2026 *)
%Y A401665 Cf. A084231 (subsequence, r = 1), A214492.
%K A401665 nonn,new
%O A401665 1,1
%A A401665 _Ctibor O. Zizka_, Nov 01 2026
