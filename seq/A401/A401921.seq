%S A401921 1,2,4,8,16,6,64,10,12,14,21,24,20,22,33,26,28,40,65,34,51,38,57,56,
%T A401921 44,46,69,160,52,117,112,30,87,62,93,88,68,150,217,74,76,42,185,82,
%U A401921 123,86,60,294,92,94,141,270,235,136,208,106,159,352,265,70,116,66,84,122,124,279,305,416,427,134,201,78,335
%N A401921 Position of the first occurrence of n in A342001.
%C A401921 Sequence is well-defined, because for all prime powers p^e, A342001(p^e) = A003415(p^e)/A003557(p^e) = e*(p^(e-1)) / p^(e-1) = e.
%H A401921 Antti Karttunen, <a href="/A401921/b401921.txt">Table of n, a(n) for n = 0..10144</a>
%F A401921 A342001(a(n)) = n.
%F A401921 a(n) <= A000079(n).
%o A401921 (PARI)
%o A401921 A342001(n) = { my(f=factor(n)); (sum(i=1, #f~, f[i, 2]/f[i, 1]) * factorback(f[, 1])); };
%o A401921 A401921(n) = for(i=1,oo,if(A342001(i)==n,return(i)));
%o A401921 (PARI)
%o A401921 up_to = 2^23;
%o A401921 A342001(n) = { my(f=factor(n)); (sum(i=1, #f~, f[i, 2]/f[i, 1]) * factorback(f[, 1])); };
%o A401921 A401921list(up_to) = { my(v=vector(1+up_to), t); for(n=1,#v,t = 1+A342001(n); if(t<=#v && !v[t], v[t] = n)); for(i=1,#v,if(0==v[i], return(vector(i-1,j,v[j])))); (v); };
%o A401921 v401921 = A401921list(up_to);
%o A401921 A401921(n) = v401921[1+n];
%Y A401921 Cf. A000079, A003415, A003557, A342001, A401931, A401932.
%Y A401921 After the initial 1, the leftmost column of array A401930.
%K A401921 nonn,new
%O A401921 0,2
