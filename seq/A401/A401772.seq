%I A401772 #6 Nov 11 2026 15:01:07
%S A401772 0,1,5,39,37,55,149,267,367,455,461,85,293,421,445,503,515,711,747,
%T A401772 839,863,909,1141,1327,1547,1559,1675,1941,1965,2069,2359,2383,2487,
%U A401772 2533,2765,2893,2951,3183,3311,3323,3787,21,335,485,493,717,957,1109,1263,1421
%N A401772 Irregular triangle read by rows in which row n gives the congruences (mod 2^floor(1+n*log_2(7))) that have an admissible sequence of order n; related to 7x+1 problem.
%C A401772 Similar to A177789, but for the 7x+1 problem. The length of row n is A174796(n).
%H A401772 V. Barbera, <a href="/A401772/b401772.txt">Table of n, a(n) for n = 0..20045</a> (rows n = 0..8, flattened).
%e A401772 Triangle begins:
%e A401772    0;
%e A401772    1;
%e A401772    5, 39;
%e A401772    37, 55, 149, 267, 367, 455, 461;
%e A401772    ...
%o A401772 (PARI) row(n, q=7) = {if(n<1, [0], my(r=[1], d=floor(log(q)/log(2)), km=d+1); for(m=1, n-1, my(s=[], c=if(q^(m+1)<2^(km+d), d, d+1)); for(i=1, #r, my(dm=km, t=r[i], e); for(j=1, m-1, t-=q^(m-j); e=valuation(t,2); t/=2^e; dm-=e); s=concat(s, vector(dm-1, j, q*r[i]+2^(km-dm+j)))); km=km+c; r=s); vecsort(apply(x->((-x)*lift(Mod(1/q^n, 2^km)))%2^km, r)));}
%Y A401772 Cf. A174796, A177789, A398731.
%K A401772 nonn,tabf,new
%O A401772 0,3
%A A401772 _V. Barbera_, Nov 05 2026
