%N A401078 a(1)=2, a(2)=3, thereafter a(n) is the sum of the two largest primes <= a(n-1).
%F A401078 a(n) = prime(pi(a(n-1))) + prime(pi(a(n-1))-1) for n >= 3.
%F A401078 a(n) = prevprime(a(n-1)) + prevprime(prevprime(a(n-1))-1) for n >= 3, where prevprime(n) = A007917(n).
%e A401078 a(3) = 3+2 = 5.
%e A401078 a(4) = 5+3 = 8.
%e A401078 a(5) = 7+5 = 12.
%e A401078 a(6) = 11+7 = 18.
%e A401078 a(7) = 17+13 = 30.
%e A401078 a(8) = 29+23 = 52.
%e A401078 a(9) = 47+43 = 90.
%t A401078 p[1] = 2;
%t A401078 p[2] = 3;
%t A401078 p[n_] := p[n] = Prime[PrimePi[p[n-1]]] + Prime[PrimePi[p[n-1]]-1];
%t A401078 Table[p[n], {n, 38}]
%Y A401078 Except the initial two terms a subsequence of A001043.
