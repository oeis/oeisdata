%N A401283 Number of 2n X n binary matrices with all column sums 2 and row sums at most 2.
%H A401283 Andrew Howroyd, <a href="/A401283/b401283.txt">Table of n, a(n) for n = 0..100</a>
%F A401283 a(n) = A401281(2*n,n).
%e A401283 The a(2) = 36 4 X 2 matrices (shown up to row permutation with counts below):
%e A401283    [1 1]  [1 1]  [1 0]
%e A401283    [1 1]  [1 0]  [1 0]
%e A401283    [0 0]  [0 1]  [0 1]
%e A401283    [0 0]  [0 0]  [0 1]
%e A401283     (6)    (24)   (6)
%o A401283 (PARI) seq(n)={ my(v=Vec(serlaplace( sqrt(exp(x - x*y + x/(1-x*y) + O(x^(2*n+1)))/(1-x*y)) ))); vector(n+1, i, i--; i!*polcoef(v[2*i+1], i)) }
%Y A401283 Central coefficients of A401281.
%K A401283 nonn,new
%O A401283 0,3
