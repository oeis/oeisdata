%S A401187 1,2,9,108,2645,122590,10718799,1790385816,579451648953,
%T A401187 367113528000698,458130375044511147,1130221338300702755316,
%U A401187 5524415109347374448793221,53577358533250029707547706726,1032005821069859022841891571426343,39510483345212588032660767191746859184
%N A401187 Total number of maximal independent vertex sets in all connected labeled graphs on n vertices.
%H A401187 Andrew Howroyd, <a href="/A401187/b401187.txt">Table of n, a(n) for n = 1..50</a>
%H A401187 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/MaximalIndependentVertexSet.html">Maximal Independent Vertex Set</a>.
%F A401187 E.g.f.: log(B(x)) where B(x) is the e.g.f. of A401186.
%o A401187 (PARI) \\ here b(n) is A401186(n).
%o A401187 b(n) = sum(k=0, n, binomial(n, k)*(2^k-1)^(n-k)*2^binomial(n-k, 2) )
%o A401187 seq(n) = Vec(serlaplace(log(sum(k=0, n, b(k)*x^k/k!, O(x*x^n)))))
%Y A401187 Cf. A058925 (in trees), A401183 (not necessarily maximal), A401186 (in not necessarily connected graphs).
%K A401187 nonn,new
%O A401187 1,2
%A A401187 _Andrew Howroyd_, Oct 17 2026
