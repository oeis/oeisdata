%I A401185 #8 Oct 17 2026 20:59:41
%S A401185 1,1,1,1,2,0,4,12,3,0,38,152,84,4,0,728,3640,3140,460,5,0,26704,
%T A401185 160224,186360,48280,2190,6,0,1866256,13063792,18926544,6987400,
%U A401185 624190,9534,7,0,251548592,2012388736,3463311488,1633528064,217478800,7212688,39032,8,0
%N A401185 Triangle read by rows: T(n,k) is the total number of independent vertex sets of size k in all simple connected labeled graphs on n vertices.
%C A401185 T(0,0) = 1 by convention for consistency with A001187. However, there is also an opinion that the null graph should not be considered connected (or disconnected).
%H A401185 Andrew Howroyd, <a href="/A401185/b401185.txt">Table of n, a(n) for n = 0..1325</a> (rows 0..50)
%H A401185 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/IndependentVertexSet.html">Independent Vertex Set</a>.
%e A401185 Triangle begins:
%e A401185         1;
%e A401185         1,        1;
%e A401185         1,        2,        0;
%e A401185         4,       12,        3,       0;
%e A401185        38,      152,       84,       4,      0;
%e A401185       728,     3640,     3140,     460,      5,    0;
%e A401185     26704,   160224,   186360,   48280,   2190,    6, 0;
%e A401185   1866256, 13063792, 18926544, 6987400, 624190, 9534, 7, 0;
%e A401185   ...
%o A401185 (PARI)
%o A401185 G(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k/2^(k*(k-1)/2), O(x^n)))}
%o A401185 U(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k*2^(k*(k-1)/2), O(x^n)))}
%o A401185 T(n)={my(g=U(exp(x+O(x*x^n))), v=Vec(serlaplace(1+log(U(G(exp(x*y+O(x*x^n)))*G(g)))))); vector(#v, i, Vecrev(v[i], i))}
%o A401185 { my(A=T(7)); for(i=1, #A, print(A[i])) }
%Y A401185 Row sums are A401183.
%Y A401185 Columns k=0..2 are A001187, A053549, A401184.
%Y A401185 Cf. A277219 (not necessarily connected), A401182.
%K A401185 nonn,tabl,new
%O A401185 0,5
%A A401185 _Andrew Howroyd_, Oct 17 2026
