%I A401674 #26 Nov 11 2026 22:05:14
%S A401674 0,1,-1,2,6,1,-5,2,10,19,29,18,6,19,33,48,64,47,29,48,68,89,111,88,64,
%T A401674 39,13,-14,-42,-13,17,-14,-46,-79,-113,-148,-184,-147,-109,-70,-30,
%U A401674 -71,-113,-70,-26,19,65,18,-30,-79,-129,-180,-232,-179,-125,-70,-14,43,101,42,-18
%N A401674 a(n) = Sum_{k=1..n} k*(-1)^pi(k), where pi = A000720.
%H A401674 Alberto Fraile, Roberto Martínez, and Daniel Fernández, <a href="https://doi.org/10.3390/mca25010005">Jacob's Ladder: Prime Numbers in 2D</a>, Mathematical and Computational Applications, 25(1), 5 (2020).
%e A401674 For n = 1, a(1) = 1, since 1 is not prime and the initial sign is positive.
%e A401674 For n = 2, a(2) = 1 - 2 = -1, since 2 is prime and the sign changes from positive to negative.
%e A401674 For n = 3, a(3) = 1 - 2 + 3 = 2, since 3 is prime and the sign changes back to positive.
%e A401674 For n = 5, a(5) = 1 - 2 + 3 + 4 - 5 = 1, since 5 is the third prime and the sign changes to negative.
%p A401674 a:= proc(n) option remember; `if`(n<1, 0,
%p A401674       a(n-1)+n*(-1)^numtheory[pi](n))
%p A401674     end:
%p A401674 seq(a(n), n=0..60);  # _Alois P. Heinz_, Nov 02 2026
%t A401674 a[n_Integer?Positive]:=a[n]=a[n-1]+n(-1)^PrimePi[n]; a[0]=0; (* Generate first 100 terms *) terms=Table[a[n],{n,0,100}]
%o A401674 (Python)
%o A401674 from sympy import primerange
%o A401674 def sequence(N):
%o A401674     primes = set(primerange(1, N + 1))
%o A401674     total = 0
%o A401674     sign = 1
%o A401674     result = []
%o A401674     for n in range(N + 1):
%o A401674         if n in primes:
%o A401674             sign *= -1
%o A401674         total += sign * n
%o A401674         result.append(total)
%o A401674     return result
%o A401674 print(sequence(100))
%o A401674 (Python)
%o A401674 from math import comb
%o A401674 from sympy import primerange
%o A401674 def A401674(n):
%o A401674     c, i = 0, 0
%o A401674     for i, p in enumerate(primerange(n+1),1):
%o A401674         c += p*(p-1) if i&1 else -p*(p-1)
%o A401674     return c-comb(n+1,2) if i&1 else c+comb(n+1,2) # _Chai Wah Wu_, Nov 02 2026
%o A401674 (PARI) a(n) = sum(k=1, n, k*(-1)^primepi(k)); \\ _Michel Marcus_, Nov 02 2026
