%I A401692 #24 Nov 10 2026 10:25:01
%S A401692 22,102,1005,10001,100005,1000001,10000010,100000002,1000000002,
%T A401692 10000000001,100000000009,1000000000009,10000000000007,
%U A401692 100000000000015,1000000000000009,10000000000000001,100000000000000006,1000000000000000005,10000000000000000005,100000000000000000018
%N A401692 Least n-digit integer k such that its largest and second-largest prime factors differ in length by exactly one digit.
%e A401692 22 is a 2-digit number. Its largest prime factors are 11 (2 digits) and 2 (1 digit); their digit lengths differ by 1. So a(2) = 22.
%e A401692 102 is a 3-digit number. Its largest prime factors are 17 (2 digits) and 3 (1 digit); their digit lengths differ by 1. So a(3) = 102.
%e A401692 And no lesser number have this property.
%p A401692 filter:= proc(n) local F,p,q; F:= NumberTheory:-PrimeFactors(n);
%p A401692    if nops(F) < 2 then return false fi;
%p A401692    p:= max(F);
%p A401692    q:= max(F minus {p});
%p A401692    ilog10(p) - ilog10(q) = 1
%p A401692 end proc:
%p A401692 f:= proc(n) local k;
%p A401692      for k from 10^(n-1) do if filter(k) then return k fi od;
%p A401692 end proc:
%p A401692 map(f, [$2..30]); # _Robert Israel_, Nov 03 2026
%t A401692 A401692[n_] := NestWhile[# + 1 &, 10^(n - 1), Last[Differences[IntegerLength[FactorInteger[#][[All, 1]]]], 0] != 1 &];
%t A401692 Array[A401692, 20, 2] (* _Paolo Xausa_, Nov 10 2026 *)
%o A401692 (PARI) isok(k) = my(f=factor(k)[,1]~, i=#f); if (i>1, #Str(f[i]) == 1 + #Str(f[i-1]));
%o A401692 a(n) = my(k=10^(n-1)); while(!isok(k), k++); k; \\ _Michel Marcus_, Nov 02 2026
%Y A401692 Cf. A000040, A006530, A162422, A398757.
%K A401692 nonn,base,new
%O A401692 2,1
