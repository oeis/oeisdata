%S A401474 1,2,14,42,128,364,914,2128,4778,9788,19432,36204,65468,111566,187476,
%T A401474 298260,469786,708792,1062580,1532412,2210524,3079512,4294064,5816306,
%U A401474 7893834,10422726,13826258,17887238,23236908,29535154,37726480,47157026,59336664
%N A401474 Expansion of g.f. Phi^7*F, where Phi = g.f. for A028930 and F = g.f. for A028959.
%C A401474 a(n) is the number of representations of n by the 16-variable quadratic form that is the sum of 7 copies of 2*x^2 + x*y + 3*y^2 and 1 copy of x^2 + x*y + 6*y^2.
%H A401474 Karan Sharma, <a href="/A401474/b401474.txt">Table of n, a(n) for n = 0..1000</a>
%H A401474 Bülent Köklüce, <a href="https://doi.org/10.1007/s11139-013-9480-4">Cusp forms in S_6(Gamma_0(23)), S_8(Gamma_0(23)) and the number of representations of numbers by some quadratic forms in 12 and 16 variables</a>, Ramanujan J. 34 (2014), 187-208. See p. 204.
%o A401474 (PARI) th(M, N) = 1 + 2*x*Ser(qfrep(M, N, 1), x);
%o A401474 a(n) = polcoef(th([4, 1; 1, 6], n+1)^7 * th([2, 1; 1, 12], n+1), n);
%Y A401474 Cf. A028930, A028959, A328527, A328528, A328529, A328530, A328531, A328532, A328533, A328534, A328535, A328536, A401430.
%K A401474 nonn,new
