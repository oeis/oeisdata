%N A401323 Antidiagonal sums of the array A144048.
%H A401323 Alois P. Heinz, <a href="/A401323/b401323.txt">Table of n, a(n) for n = 0..160</a>
%F A401323 a(n) = Sum_{k=0..n} [x^(n-k)] Product_{j=1..n-k} (1 - x^j)^(-j^k).
%p A401323 A:= proc(n, k) option remember; `if`(n=0, 1, add(A(n-j, k)
%p A401323       *add(d*d^k, d=numtheory[divisors](j)), j=1..n)/n)
%p A401323     end:
%p A401323 a:= n-> add(A(j, n-j), j=0..n):
%p A401323 seq(a(n), n=0..24);  # _Alois P. Heinz_, Oct 21 2026
%t A401323 a[n_]:=Sum[SeriesCoefficient[Product[(1-x^j)^(-j^k),{j,n-k}],{x,0,n-k}],{k,0,n}]; Array[a,25,0]
