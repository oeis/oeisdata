%U A401679 260125283559958364160,21521345711909233987584,1897372715920181108269056,177584306763324425358127104,17586364839280745263798468608
%N A401679 a(0) = 1; a(n) = Sum_{k=1..n} 2^(k-1) * binomial(3*n+k,k) * a(n-k).
%F A401679 G.f. A(x) satisfies A(x) = (1-8*x) * (3*A(x*(1-2*x)^3) - 2).
%F A401679 4|a(n) for n > 0.
%o A401679 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, 2^(j-1)*binomial(3*i+j, j)*v[i-j+1])); v;
