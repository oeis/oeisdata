%I A401065 #11 Oct 20 2026 15:52:45
%S A401065 0,1,5,7,12,17,18,31,36,38,40,41,46,50,62,67,72,73,79,90,91,101,121,
%T A401065 132,133,138,139,140,146,157,163,173,175,176,177,178,189,204,213,217,
%U A401065 222,224,226,229,232,244,255,257,262,264,273,278,279,285,296,310,337,339,346,357,364,379,380,386,399,402,404,420,421
%N A401065 Numbers k such that for p = prime(1+k), there is at least one prime q <= p such that ((p#/p) / (q#/q)) == -1 mod p, where p# = A034386(p).
%H A401065 Antti Karttunen, <a href="/A401065/b401065.txt">Table of n, a(n) for n = 1..4188</a>
%H A401065 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401065 a(n) = A000720(A401061(n))-1.
%F A401065 {k such that A401056(k)>0}.
%o A401065 (PARI)
%o A401065 A401056(n) = { my(p=prime(1+n), pr=1, c=0); forstep(k=n,1,-1,c += ((p-1)==pr); pr *= prime(k); pr %= p); (c+((p-1)==pr)); };
%o A401065 is_A401065(n) = (A401056(n)>0);
%Y A401065 Cf. A000720, A002110, A034386.
%Y A401065 Positions of strictly positive terms in A400836 and in A401056.
%Y A401065 Positions of nonnegative terms in A400266 and in A400837.
%Y A401065 Cf. A401061 [= A000040(1+a(n))].
%Y A401065 Cf. also A401059 for similar sequence.
%K A401065 nonn,new
%O A401065 1,3
%A A401065 _Antti Karttunen_, Oct 20 2026
