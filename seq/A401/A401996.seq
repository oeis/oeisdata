%S A401996 1,684,1224,1248,1539,6032,9675,17024,18450,27360,32634,41328,71604,
%T A401996 86000,122544,230202,249744,291456,319302,355904,382912,466875,484704,
%U A401996 517376,520300,557384,749250,763776,801504,864432,904203,1316016,1339560,1715625,1722240,1771440
%N A401996 Numbers k such that k and sigma(k) have the same number and sum of prime factors counted with multiplicity.
%H A401996 Michael S. Branicky, <a href="/A401996/b401996.txt">Table of n, a(n) for n = 1..500</a>
%e A401996 684 is a term since sigma(684) = 1820, Omega(684) = Omega(1820) = 5, and sopfr(684) = sopfr(1820) = 29.
%o A401996 (Python)
%o A401996 from sympy import divisor_sigma, factorint
%o A401996 def Omega(f): return sum(f.values())
%o A401996 def sopfr(f): return sum(p*e for p, e in f.items())
%o A401996 def ok(k):
%o A401996     sigmak = divisor_sigma(k)
%o A401996     fk, fsk = factorint(k), factorint(sigmak)
%o A401996     return Omega(fk) == Omega(fsk) and sopfr(fk) == sopfr(fsk)
%o A401996 print([k for k in range(1, 10**5) if ok(k)]) # _Michael S. Branicky_, Nov 11 2026
%o A401996 (PARI) sf(f) = sum(k=1, matsize(f)[1], f[k, 1]*f[k, 2]); \\ A001414
%o A401996 isok(k) = my(f=factor(k), fs=factor(sigma(f))); (bigomega(f) == bigomega(fs)) && (sf(f) == sf(fs)); \\ _Michel Marcus_, Nov 14 2026
