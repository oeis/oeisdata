%T A401937 1701,55,27,261,1395,4557,833,625,297,4185,147,666,92583,195,10773,99,
%U A401937 2925,2337,2415,595,52731,8127,55,1551,3159,1365,1827,53,1215,3267,31899,171,1071,4779,4375,1053,837,575,29295,8235,189
%N A401937 Denominator of ratio 2*n*sigma(A003961(2*n)) / sigma(2*n)*A003961(2*n), where sigma is the sum of divisors of n, and A003961 shifts the prime factorization of n one step towards larger primes.
%H A401937 Antti Karttunen, <a href="/A401937/b401937.txt">Table of n, a(n) for n = 1..10000</a>
%H A401937 <a href="/index/Pri#prime_indices">Index entries for sequences computed from indices in prime factorization</a>.
%H A401937 <a href="/index/Si#SIGMAN">Index entries for sequences related to sigma(n)</a>.
%F A401937 a(n) = A341527(2*n).
%o A401937 (PARI)
%o A401937 A003961(n) = { my(f=factor(n)); for(i=1, #f~, f[i, 1] = nextprime(f[i, 1]+1)); factorback(f); };
%o A401937 A341527(n) = { my(s=A003961(n)); denominator((sigma(s)*n)/(sigma(n)*s)); };
%o A401937 A401937(n) = A341527(2*n);
%Y A401937 Even bisection of A341527.
%Y A401937 Top row of array A341627.
%Y A401937 Cf. A000203, A003961, A401936 (numerators).
%Y A401937 Cf. also A402587.
%K A401937 nonn,easy,frac,new
%O A401937 1,1
%A A401937 _Antti Karttunen_, Nov 21 2026
