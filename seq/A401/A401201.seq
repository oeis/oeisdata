%S A401201 3,2,1,1,2,1,1,4,7,14,2,1,2,1,4,13,4,52,43,7,7,5,9,24,12,12,45,7,2,1,
%T A401201 2,1,1,27,9,5,2,1,3,4,23,51,14,57,53,6,4,18,11,8,19,4,10,39,25,4,21,8,
%U A401201 66,106,11,27,9,7,7,29,71,55,39,9,18,171,48,22,18,20,14,5,156
%N A401201 Smallest k such that k*(k+1)*(k+2)*...*(k+n-1)-1 is prime.
%e A401201 a(2)=2 because 2 is the smallest integer such that 2*3-1 is prime.
%e A401201 a(8)=4 because 4 is the smallest integer such that 4*5*...*(4+7)-1=6652799 is prime.
%t A401201 A401201[n_] := NestWhile[# + 1 &, 1, !PrimeQ[Pochhammer[#, n] - 1] &];
%t A401201 Array[A401201, 100] (* _Paolo Xausa_, Oct 23 2026 *)
%Y A401201 Cf. A000040, A045619, A083522.
%K A401201 nonn,new
