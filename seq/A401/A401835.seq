%I A401835 #18 Nov 13 2026 17:38:39
%S A401835 1,8,36,109,243,419,614,813,1012,1211,1410,1609,1808,2007,2206,2405,
%T A401835 2604,2803,3002,3201,3400,3599,3798,3997,4196,4395,4594,4793,4992,
%U A401835 5191,5390,5589,5788,5987,6186,6385,6584,6783,6982,7181,7380,7579,7778,7977,8176,8375,8574,8773,8972
%N A401835 Number of different amounts that can be paid with exactly n euro coins (1, 2, 5, 10, 20, 50 cents, 1 and 2 euros).
%H A401835 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1).
%F A401835 a(n) = 199*n - 580 for n >= 6.
%F A401835 From _Jianing Song_, Nov 13 2026: (Start)
%F A401835 G.f.: (1 + 6*x + 21*x^2 + 45*x^3 + 61*x^4 + 42*x^5 + 19*x^6 + 4*x^7)/(1 - x)^2.
%F A401835 E.g.f.: (199*x - 580)*exp(x) + (1/30*x^5 + 9/8*x^4 + 46/3*x^3 + 109*x^2 + 389*x + 581). (End)
%e A401835 a(1) = 8 because a single coin gives 8 different amounts.
%o A401835 (Python)
%o A401835 def a(n):
%o A401835     S, D = {0}, [1, 2, 5, 10, 20, 50, 100, 200]
%o A401835     for _ in range(n):
%o A401835         S = {x+d for x in S for d in D}
%o A401835     return len(S)
%Y A401835 Analog of A135454 (banknotes 1, 5, 10, 20, 50, 100).
%K A401835 nonn,easy,new
%O A401835 0,2
%A A401835 _Pierre Colmant_, Nov 07 2026
