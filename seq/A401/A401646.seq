%I A401646 #15 Nov 22 2026 15:12:29
%S A401646 0,1,3,8,23,72,240,834,2979,10844,40016,149190,560692,2120782,8063982,
%T A401646 30796722,118050327,453948192,1750396092,6765602442,26205497532,
%U A401646 101692882362,395288086602,1538820132102,5998595109552,23412301098426,91479550718754,357806170264958,1400809434005018,5488902686135598
%N A401646 Total number of symmetric peaks over all Dyck paths of semilength n.
%C A401646 A peak of a Dyck path is symmetric if the maximal mountain U^i D^j containing it satisfies i = j. Here U = (1,1) and D = (1,-1). The empty Dyck path has no peaks, so a(0) = 0.
%H A401646 Alois P. Heinz, <a href="/A401646/b401646.txt">Table of n, a(n) for n = 0..1665</a>
%H A401646 Sergi Elizalde, <a href="https://doi.org/10.1016/j.disc.2021.112364">Symmetric peaks and symmetric valleys in Dyck paths</a>, Discrete Mathematics 344 (2021), 112364.
%H A401646 Rigoberto Flórez and José L. Ramírez, <a href="https://doi.org/10.1016/j.disc.2020.112118">Enumerating symmetric and asymmetric peaks in Dyck paths</a>, Discrete Mathematics 343 (2020), 112118.
%F A401646 a(0) = 0; a(n) = 2*Sum_{k=0..n} binomial(2*k,k) - 5*binomial(2*n,n)/2 for n >= 1.
%F A401646 G.f.: (1 + (5*x - 1)/((1 - x)*sqrt(1 - 4*x)))/2.
%F A401646 a(0) = 0, a(1) = 1; a(n) = a(n-1) + (n+2)*binomial(2*n-2,n-1)/(2*n) for n >= 2.
%F A401646 a(n+1) - a(n) = A189176(n) for n >= 0.
%F A401646 a(n) ~ 2^(2*n-1) / (3*sqrt(Pi*n)). - _Vaclav Kotesovec_, Nov 11 2026
%e A401646 For n = 3, the five Dyck paths UUUDDD, UUDUDD, UUDDUD, UDUUDD and UDUDUD have respectively 1, 0, 2, 2 and 3 symmetric peaks. Therefore a(3) = 8.
%p A401646 a:= proc(n) option remember; `if`(n<3, [0, 1, 3][n+1], (
%p A401646       (5*n^2+3*n-12)*a(n-1)-2*(n+2)*(2*n-3)*a(n-2))/(n*(n+1)))
%p A401646     end:
%p A401646 seq(a(n), n=0..29);  # _Alois P. Heinz_, Nov 07 2026
%t A401646 Table[If[n == 0,0, 2 Sum[Binomial[2 k, k], {k, 0, n}] - 5 Binomial[2 n, n]/2], {n, 0, 29}]
%Y A401646 Cf. A000108, A000984, A189176.
%K A401646 nonn,easy,new
%O A401646 0,3
%A A401646 _José Luis Ramírez Ramírez_, Oct 31 2026
