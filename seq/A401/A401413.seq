%T A401413 641,675,739,779,1000,1077,1294,1381,1617,1667,1715,1877,1976,2088,
%U A401413 2190,2366,2672,2851,3107,3241,3377,3585,3868,4396,4627,4857,5106,5442,5522
%N A401413 Indices k such that prime(k) + 2 is a square.
%H A401413 Vincenzo Librandi, <a href="/A401413/b401413.txt">Table of n, a(n) for n = 1..1493</a>
%F A401413 a(n) = A000720(A028871(n)).
%e A401413 a(1) = 1 because prime(1) + 2 = 2^2.
%e A401413 a(3) = 9 because prime(9) + 2 = 5^2.
%e A401413 a(5) = 22 because prime(22) + 2 = 9^2.
%e A401413 The columns give k, p_k and m, respectively, where p_k = m^2 - 2.
%e A401413    k    p_k    m
%e A401413    1     2     2
%e A401413    4     7     3
%e A401413    9    23     5
%e A401413   15    47     7
%e A401413   22    79     9
%t A401413 Select[Range[6000], IntegerQ[Sqrt[Prime[#] + 2]] & ]
%o A401413 (Magma) [n : n in [1..6000] | IsSquare(NthPrime(n) + 2) ];
%Y A401413 Cf. A028870, A028871, A000040, A000720.
%K A401413 nonn,new
%O A401413 1,2
%A A401413 _Vincenzo Librandi_, Nov 19 2026
