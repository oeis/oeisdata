%N A401922 Position of the first occurrence of n in A342002.
%H A401922 Antti Karttunen, <a href="/A401922/b401922.txt">Table of n, a(n) for n = 0..419</a>
%H A401922 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%o A401922 (PARI)
%o A401922 A342002(n) = { my(s=0, p=2); while(n, s += ((n%p)/p); n = n\p; p = nextprime(1+p)); numerator(s); };
%o A401922 A401922(n) = for(i=0,oo,if(A342002(i)==n,return(i)));
%o A401922 (PARI)
%o A401922 up_to = 2^23;
%o A401922 A342002(n) = { my(s=0, p=2); while(n, s += ((n%p)/p); n = n\p; p = nextprime(1+p)); numerator(s); };
%o A401922 A401922list(up_to) = { my(v=vector(1+up_to), t); for(n=0,#v,t = 1+A342002(n); if(t<=#v && !v[t], v[t] = n)); for(i=2,#v,if(0==v[i], return(vector(i-1,j,v[j])))); (v); };
%o A401922 v401922 = A401922list(up_to);
%o A401922 A401922(n) = v401922[1+n];
