%S A401810 1,2,23,400,7165,128558,2306867,41395036,742803769,13329072794,
%T A401810 239180506511,4291920044392,77015380292533,1381984925221190,
%U A401810 24798713273688875,444994854001178548,7985108658747524977,143286961003454271026,2571180189403429353479,46137956448258274091584,827912035879245504295021
%N A401810 Indices of records of A401756.
%C A401810 The orbit of (2*a(k)-1, 1) under the outer billiards map of A401756 contains exactly A107839(k-1) points (2j-1, 1) with j >= 1.
%C A401810 The formulas and the preceding comment were proved with computer assistance; see the Ferudun proof link. - _Alper Ferudun_, Nov 08 2026
%C A401810 A401809 gives the corresponding record values.
%H A401810 Alper Ferudun, <a href="/A401810/b401810.txt">Table of n, a(n) for n = 1..300</a>
%H A401810 Alper Ferudun, <a href="/A401756/a401756_4.txt">Proof of the record law, the period regimes and the congruence mod 4 of A401756 (computer-assisted)</a>.
%H A401810 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (19,-19,1).
%F A401810 a(k) = (Fibonacci(6*k-7)+3)/4, with Fibonacci(-1) = 1.
%F A401810 a(k) = (A134497(k-2)+3)/4 for k >= 2.
%F A401810 a(k) = 18*a(k-1) - a(k-2) - 12 for k >= 3.
%F A401810 G.f.: x*(1-17*x+4*x^2)/((1-x)*(1-18*x+x^2)).
%e A401810 a(3) = 23: A401756(23) = 2757494 is the first term of A401756 larger than A401756(2) = 3742.
%t A401810 Rest@ CoefficientList[Series[x*(1 - 17*x + 4*x^2)/((1 - x)*(1 - 18*x + x^2)), {x, 0, 21}], x] (* _Michael De Vlieger_, Nov 09 2026 *)
%Y A401810 Cf. A000045, A107839, A134497, A401756, A401809.
%K A401810 nonn,easy,new
%O A401810 1,2
