%e A401594 10729 is prime but it is not in the column 10 because 10729 contains the string "10".
%e A401594 17029 is prime and it is in the column 10 because 17029 does not contain the string "10".
%t A401594 A401594list[dmax_] := Table[#[[m, n - m + 2]], {n, dmax}, {m, n}] & [Table[NestList[NestWhile[NextPrime, NextPrime[#], StringContainsQ[IntegerString[#], IntegerString[k]] &] &, 1, dmax - k], {k, 0, dmax - 1}]];
%t A401594 A401594list[15] (* _Paolo Xausa_, Nov 12 2026 *)
