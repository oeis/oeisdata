%N A401510 Number of partitions of n into parts whose product is a square.
%H A401510 Alois P. Heinz, <a href="/A401510/b401510.txt">Table of n, a(n) for n = 0..500</a>
%e A401510 a(7) = 4: 1111111, 22111, 331, 4111.
%e A401510 a(8) = 7: 11111111, 221111, 2222, 3311, 41111, 422, 44.
%e A401510 a(9) = 8: 111111111, 2211111, 22221, 33111, 411111, 4221, 441, 9.
%e A401510 a(10) = 12: 1111111111, 22111111, 222211, 331111, 3322, 4111111, 42211, 433, 4411, 55, 82, 91.
%p A401510 g:= (n, i, p)-> `if`(max(p)>i, 0, `if`(n=0 or i=1, 1, b(n, i, p))):
%p A401510 b:= proc(n, i, p) option remember; g(n, i-1, p)+g(n-i, min(n-i, i),
%p A401510       {select(h-> irem(h[2], 2)=1, ifactors(mul(j, j=p)*i)[2])[.., 1][]})
%p A401510     end:
%p A401510 a:= n-> g(n$2, {}):
%p A401510 seq(a(n), n=0..53);
