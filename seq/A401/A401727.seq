%I A401727 #10 Nov 10 2026 10:22:16
%S A401727 9,25,49,63,121,125,169,225,289,343,361,529,625,686,841,847,931,961,
%T A401727 1225,1331,1369,1375,1681,1849,1859,2197,2209,2401,2809,2975,3481,
%U A401727 3721,4489,4913,5041,5239,5329,5491,5687,5819,6241,6727,6859,6889,7267,7921,8281,8303,9409,9826,10201,10469,10609,10693,10769,10933
%N A401727 Nonsquarefree numbers k with no p^p-factors, for which A276085(k) is a multiple of A083345(k), where A083345 is the numerator of the fully additive function with a(p) = 1/p, and A276085 is fully additive with a(p) = p#/p.
%C A401727 Equally, nonsquarefree numbers k with no p^p-factors, such that A276085(k) is a multiple of A342001(k).
%H A401727 Antti Karttunen, <a href="/A401727/b401727.txt">Table of n, a(n) for n = 1..10000</a>
%H A401727 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%o A401727 (PARI)
%o A401727 A083345(n) = { my(f=factor(n)); numerator(vecsum(vector(#f~, i, f[i, 2]/f[i, 1]))); };
%o A401727 A276085_mod_m(n,m) = if(1==n,0,my(f = factor(n),lp=f[#f~,1],pr=1,s=0,k=1); forprime(p=2,lp,if(f[k,1]==p, s += f[k,2]*pr; s %= m; k++); pr *= p; pr %= m); (s));
%o A401727 A359550(n) = { my(pp); forprime(p=2, , pp = p^p; if(!(n%pp), return(0)); if(pp > n, return(1))); };
%o A401727 is_A401727(n) = (!issquarefree(n) && A359550(n) && !A276085_mod_m(n,A083345(n)));
%Y A401727 Cf. A083345, A342001, A276085.
%Y A401727 Intersection of A371083 and A401935.
%Y A401727 The nonsquarefree terms of A401726 are all contained in this sequence.
%K A401727 nonn,new
%O A401727 1,1
%A A401727 _Antti Karttunen_, Nov 09 2026
