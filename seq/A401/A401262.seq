%S A401262 1,1,1,1,5,1,1,19,26,1,1,65,460,154,1,1,211,6920,15196,1044,1,1,665,
%T A401262 95536,1229704,672336,8028,1,1,2059,1254176,89222896,346296384,
%U A401262 38724624,69264,1,1,6305,15958720,6060649504,157188439296,146661388992,2827466496,663696,1
%N A401262 Triangle J(m,k) of hyperharmonic integers, read by ascending antidiagonals. k >= 0, m >= 2.
%H A401262 Hugo Pfoertner, <a href="/A401262/b401262.txt">Table of n, a(n) for n = 2..529</a> (32 lines, flattened).
%H A401262 Dominique Foata, Guo-Niu Han, and Bodo Lass, <a href="https://web.archive.org/web/20041115042927/http://www-irma.u-strasbg.fr/~foata/paper/pub88fratrie.pdf">Les nombres hyperharmoniques et la fratrie du collectionneur de vignettes</a>, Séminaire Lotharingien de Combinatoire [electronic only] 47 (2001): B47a, 20 p (formulas 1.2, 1.4, page 3; 9.1, page 17).
%F A401262 K(1,k) = 0 for k >= 1,
%F A401262 K(m,0) = 1 for m >= 1,
%F A401262 K(m,k) = K(m-1,k) + K(m,k-1)/m for m >= 2 and k >= 1.
%F A401262 J(m,k) = K(m,k)*(m!^k).
%e A401262 The triangle begins:
%e A401262   1,
%e A401262   1,   1,
%e A401262   1,   5,     1,
%e A401262   1,  19,    26,       1,
%e A401262   1,  65,   460,     154,      1,
%e A401262   1, 211,  6920,   15196,   1044,    1,
%e A401262   1, 665, 95536, 1229704, 672336, 8028, 1,
%e A401262 ...
%o A401262 (PARI) K(m,k) = if(k==0, return(1)); if(m==1, return(0)); K(m-1,k) + K(m,k-1)/m;
%o A401262 J(m,k) = K(m,k)*m!^k
%Y A401262 Cf. A001047, A001705, A020594.
%K A401262 nonn,tabl,new
%O A401262 2,5
%A A401262 _Hugo Pfoertner_, Oct 19 2026
