%T A401370 31536057656443072051,429960961,25712185251858160157026682941,
%U A401370 2863503060378793,19139303955689288670391,900610946612241479594722,1791227249100068721647196820961861382651369027318641,297683700609835878913
%N A401370 Evaluation of the n-th cyclotomic polynomial at the n-th Fibonacci number: a(n) = Phi_n(F(n)).
%C A401370 Evaluations of the n-th cyclotomic polynomial Phi_n(x) at the n-th Fibonacci number F(n).
%H A401370 Paolo Xausa, <a href="/A401370/b401370.txt">Table of n, a(n) for n = 1..70</a>
%F A401370 a(n) = Product_{1 <= k <= n, gcd(k,n) = 1} (F(n) - e^(2*Pi*I*k/n)).
%e A401370 a(1) = Phi_1(F_1) = Phi_1(1) = 0.
%e A401370 a(2) = Phi_2(F_2) = Phi_2(1) = 1 + 1 = 2.
%e A401370 a(3) = Phi_3(F_3) = Phi_3(2) = 2^2 + 2 + 1 = 7.
%e A401370 a(4) = Phi_4(F_4) = Phi_4(3) = 3^2 + 1 = 10.
%e A401370 a(5) = Phi_5(F_5) = Phi_5(5) = 5^4 + 5^3 + 5^2 + 5 + 1 = 781.
%t A401370 A401370[n_] := Cyclotomic[n, Fibonacci[n]]; Array[A401370, 20] (* _Paolo Xausa_, Oct 30 2026 *)
%o A401370 (Python)
%o A401370 from sympy import fibonacci, cyclotomic_poly, Symbol
%o A401370 def a(n):
%o A401370     if n == 1:
%o A401370         return 0
%o A401370     x = Symbol('x')
%o A401370     return int(cyclotomic_poly(n, x).subs(x, fibonacci(n)))
%Y A401370 Cf. A000045, A020500, A070518, A070526, A398557, A000142.
%K A401370 nonn,new
%O A401370 1,2
%A A401370 _Iurii Kirpichev_, Oct 23 2026
