%t A401140 A401140list[rowmax_] := With[{s = Table[#*(n - #) & [Range[n/2]], {n, rowmax}]}, Table[Length[Intersection[s[[n]], s[[k]]]], {n, 2, rowmax}, {k, n - 1}]];
%t A401140 A401140list[10] (* _Paolo Xausa_, Oct 16 2026 *)
%o A401140 (PARI) S(n) = Set(vector(n\2, j, j*(n-j)));
%o A401140 T(n, k) = #setintersect(S(n), S(k));
