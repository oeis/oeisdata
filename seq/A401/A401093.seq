%S A401093 1,3,10,33,111,374,1279,4412,15405,54361,193940,698972,2543937,
%T A401093 9343138,34606124,129176849,485629972,1837541543,6993939423,
%U A401093 26762040589,102898873628,397372591879,1540648132691,5994716061363,23401965419794,91628260549785,359740238785091,1415900521942420
%N A401093 Number of rooted bicolored trees on n unlabeled vertices in which the black vertices form a nonempty connected subset.
%H A401093 Andrew Howroyd, <a href="/A401093/b401093.txt">Table of n, a(n) for n = 1..500</a>
%o A401093 (PARI)
%o A401093 EulerTS(p)={my(n=serprec(p,x)-1); exp(x*Ser(dirmul(Vec(serchop(p,1),-n), vector(n,k,1/k)))) }
%o A401093 seq(n)={ my(u=v=w=O(x)); for(n=1, n, u=x*EulerTS(u); v=x*EulerTS(v+u); w=(w + v)*u); Vec(v+w) }
%Y A401093 Cf. A038055, A401091, A401094, A401095.
%K A401093 nonn,new
%O A401093 1,2
%A A401093 _Andrew Howroyd_, Oct 16 2026
