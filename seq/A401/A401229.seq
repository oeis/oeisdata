%T A401229 3426211,3691507,4492001,4658699,6491523,8105827,9407081,10269163,
%U A401229 10330877,14108657,17229031,18391951,27018003,29172551,39524743,87095381,89198401,91617521,97889599,104916739,109155889,126241991,133433813,148269983
%N A401229 Numbers of the form p^2*q where p and q are primes with p > q, and p divides A276085(p^2*q), where A276085 is fully additive with a(p) = p#/p.
%C A401229 Primes p and q of each term satisfy the condition specified in the irregular triangle A401051.
%C A401229 This condition is a necessary (but not sufficient) condition for a term of A095990 being included in A373487. See A401230 for the terms that are also included there.
%H A401229 Antti Karttunen, <a href="/A401229/b401229.txt">Table of n, a(n) for n = 1..236</a>
%H A401229 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%o A401229 (PARI)
%o A401229 A276085(n) = { my(f = factor(n)); sum(k=1, #f~, f[k, 2]*prod(i=1,primepi(f[k, 1]-1),prime(i))); };
%o A401229 is_A401229(k) = { my(f=factor(k)); (2==#f~ && f[1,2]==1 && f[2,2]==2 && !(A276085(k)%f[2,1])); };
%Y A401229 Sequence A401228\{27} sorted into ascending order.
%Y A401229 Intersection of A095990 and A401232. Subsequence of A401233.
%Y A401229 Cf. A401230 (subsequence).
%Y A401229 Cf. A276085, A373487, A401051.
%Y A401229 Cf. also A401231.
%K A401229 nonn,new
%O A401229 1,1
%A A401229 _Antti Karttunen_, Oct 20 2026
