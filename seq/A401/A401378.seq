%U A401378 32400,36864,44100,46656,48841,50625,57600,60025,72900,82944,90000,99225,104329,104976,129600,140625,147456,148225,164025,176400,186624
%N A401378 Square numbers, other than prime powers, whose distinct prime factors are consecutive primes.
%H A401378 Antti Karttunen, <a href="/A401378/b401378.txt">Table of n, a(n) for n = 1..10000</a>
%H A401378 <a href="/index/Pri#prime_indices">Index entries for sequences related to prime indices in the factorization of n</a>.
%F A401378 a(n) = A066312(n)^2.
%F A401378 Conjecture: A401379(a(n)) >= 2 for all n.
%o A401378 (PARI) A401378(n) = (A066312(n)^2);
%o A401378 (PARI) is_A401378(n) = if(omega(n)<2 || !issquare(n), 0, f=factor(n); ((primepi(f[#f~,1])-primepi(f[1,1])) == (omega(n)-1)));
%o A401378 (PARI) is_A401378(k) = if(!issquare(k), 0, my(f=factor(k)); if(#f~<2, 0, forprime(p=f[1,1],f[#f~,1],if(k%p, return(0))); (1)));
%Y A401378 Terms of A066312 squared.
%Y A401378 Intersection of A000290 and A066312.
%Y A401378 Subsequences: A166329, A401377.
%Y A401378 Cf. A401379.
%K A401378 nonn,new
%O A401378 1,1
