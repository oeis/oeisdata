%F A401683 G.f. A(x) satisfies A(x) = (1-3*x)/(1+x) * (2*A(x/(1+x)^4) - 1).
%F A401683 4|a(n) for n > 0.
%F A401683 a(n) ~ c * n! * 4^n * n^(3*log(2)/8) / log(2)^n, where c = 0.8345813701370686231130633990115215044499303461827546913294... - _Vaclav Kotesovec_, Nov 02 2026
%t A401683 a[0] = 1; a[n_] := a[n] = Sum[Binomial[4*n, k]*a[n-k], {k, 1, n}]; Table[a[n], {n, 0, 20}] (* _Vaclav Kotesovec_, Nov 02 2026 *)
%o A401683 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(4*i, j)*v[i-j+1])); v;
