%U A401656 28929498177549770060,1858253561446504252004,127378797936101602846659,9281233998150025753035481,716330302301017255645257646
%N A401656 a(0) = 1; a(n) = Sum_{k=1..n} binomial(3*n+k-3,k) * a(n-k).
%F A401656 G.f. A(x) satisfies A(x) = (1-4*x)/(1-x)^3 * (2*A(x*(1-x)^3) - 1).
%o A401656 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(3*i+j-3, j)*v[i-j+1])); v;
%Y A401656 Cf. A400623, A401657, A401658, A401659.
