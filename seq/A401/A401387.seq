%S A401387 4,9,16,25,64,81,289,400,729,1521,1681,2401,3481,4096,5041,7921,9604,
%T A401387 10201,15625,17161,27889,28561,29929,65536,83521,85849,146689,257049,
%U A401387 262144,279841,458329,480249,491401,531441,552049,579121,597529,683929,703921,707281,734449,829921,1190281,1203409,1352569,1394761
%N A401387 Squares k for which {the largest divisor of sigma(k) that is coprime with k} is a prime power.
%C A401387 The set of numbers given by A350388(A401067(.)) is a subset of (the odd terms of) this sequence.
%H A401387 Antti Karttunen, <a href="/A401387/b401387.txt">Table of n, a(n) for n = 1..10000</a>
%F A401387 a(n) = A401385(n)^2.
%F A401387 {k^2 such that A401380(k) = 1}.
%o A401387 (PARI)
%o A401387 A401379(n) = { my(f=factorback(factor(n)[,1]), g=factorback(factor(sigma(n))[,1])); omega(g/gcd(f,g)); };
%o A401387 is_A401387(k) = (issquare(k) && (1==A401379(k)));
%Y A401387 Intersection of A000290 and A401385. Terms of A401385 squared.
%Y A401387 Cf. A350388, A401067, A401380, A401388 (subsequence, terms that are not prime powers).
%K A401387 nonn,new
%O A401387 1,1
%A A401387 _Antti Karttunen_, Oct 31 2026
