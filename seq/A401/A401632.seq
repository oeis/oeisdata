%N A401632 a(n) = 2*(n^(n-1) - (n-1)!)*(binomial(n+1,3) + binomial(n,3)).
%C A401632 a(n) is the total cross work on the semigroup of singular transformations Sing_n (see Udo et al.).
%H A401632 Nsibiet E. Udo, Victor A. Owai, and Moses O. Francis, <a href="https://arxiv.org/abs/2610.34902">Cross work induced by transformations on the symmetric group and related transformation semigroups</a>, arXiv:2610.34902 [math.CO], 2026. See Table 2 on page 18.
%F A401632 a(n) = (n^n - n!)*(2*n^2 - 3*n + 1)/3.
%F A401632 a(n) = A401631(n) - A401630(n).
%t A401632 a[n_]:=(n^n - n!)*(2*n^2 - 3*n + 1)/3; Array[a,20]
