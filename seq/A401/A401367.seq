%I A401367 #29 Nov 07 2026 03:30:59
%S A401367 0,1,4,2,22,24,3,52,171,96,4,94,528,972,320,5,148,1185,3968,4725,960,
%T A401367 6,214,2232,11100,25600,20898,2688,7,292,3759,25056,89375,150528,
%U A401367 86751,7168,8,382,5856,49196,241920,656250,831488,344088,18432
%N A401367 Array A(n,k), n >= 1, k >= 2, read by descending antidiagonals: number of pairs of adjacent edges in the k^n cubic grid.
%C A401367 Case 1: collinear edge pairs. There are n coordinate directions, k^(n-1) parallel grid lines per direction, and (k-2) vertices along each line where two collinear edges meet. Therefore, the number of collinear edge pairs = n*k^(n-1)*(k-2).
%C A401367 Case 2: perpendicular edge pairs. For n >= 2, there are binomial(n,2) axis pairs, k^(n-2) coordinate-parallel planes per axis pair, each containing (k-1)^2 unit squares, with 4 perpendicular edge-pairs per unit square. Therefore, the number of perpendicular edge pairs = 4*binomial(n,2)*k^(n-2)*(k-1)^2.
%C A401367 A(n,k) is the sum of Cases 1 and 2.
%H A401367 Eddie Lin Rui, <a href="/A401367/b401367.txt">Table of n, a(n) for n = 1..10011; the first 141 antidiagonals of the array</a>
%F A401367 A(n,k) = n*k^(n-2)*((2*n-1)*(k-1)^2-1), for n >= 1, k >= 2.
%e A401367 For a 4 X 4 X 4 cubic grid, there are 3*4*4*(4-2) = 96 pairs of collinear edges and 4*binomial(3,2)*4*(4-1)^2 = 432 pairs of perpendicular edges. Therefore, A(3,4) = 96 + 432 = 528.
%e A401367 The array begins:
%e A401367        k=2      3       4        5         6         7          8           9
%e A401367   n=1    0      1       2        3         4         5          6           7
%e A401367   n=2    4     22      52       94       148       214        292         382
%e A401367   n=3   24    171     528     1185      2232      3759       5856        8613
%e A401367   n=4   96    972    3968    11100     25056     49196      87552      144828
%e A401367   n=5  320   4725   25600    89375    241920    553945    1126400     2095875
%e A401367   n=6  960  20898  150528   656250   2130624   5690370   13221888    27674298
%e A401367   n=7 2688  86751  831488  4528125  17635968  54942083  145883136   343488033
%e A401367   n=8 7168 344088 4390912 29875000 139594752 507302488 1539309568  4077215352
%e A401367   ....
%e A401367 A(3,4) = 3*4^(3-2)*((2*3-1)*(4-1)^2-1) = 3*4*(5*9-1) = 528.
%t A401367 A401367[n_, k_] := n*k^(n - 2)*((2*n - 1)*(k - 1)^2 - 1);
%t A401367 Table[A401367[k - 1, n - k + 3], {n, 10}, {k, 2, n + 1}] (* _Paolo Xausa_, Nov 05 2026 *)
%o A401367 (Python)
%o A401367 def A(n, k):
%o A401367     if n == 1:
%o A401367         return k - 2
%o A401367     return n*k**(n-2)*((2*n-1)*(k-1)**2-1)
%o A401367 a = []
%o A401367 for d in range(1, 10):
%o A401367     a.extend(A(n, d + 2 - n) for n in range(1, d + 1))
%o A401367 print(a)
%Y A401367 Cf. A400505, A401120.
