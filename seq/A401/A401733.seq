%I A401733 #12 Nov 09 2026 22:03:10
%S A401733 1,1,1,2,1,2,1,2,2,2,1,2,1,2,2,3,1,2,1,2,2,2,1,2,2,2,2,2,1,2,1,2,2,2,
%T A401733 2,4,1,2,2,2,1,2,1,2,2,2,1,3,2,2,2,2,1,2,2,2,2,2,1,3,1,2,2,4,2,2,1,2,
%U A401733 2,2,1,2,1,2,2,2,2,2,1,3,3,2,1,3,2,2,2,2
%N A401733 Number of factorizations of n into factors that have the same number of divisors.
%C A401733 First differs from A401734 at n = 48: a(48) = 3, while A401734(48) = 2.
%C A401733 a(n) depends only on the prime signature of n (A118914).
%H A401733 Amiram Eldar, <a href="/A401733/b401733.txt">Table of n, a(n) for n = 1..10000</a>
%F A401733 a(n) >= A401734(n).
%F A401733 a(p^k) = A000005(k) for k >= 1 and any prime p.
%F A401733 a(n) = A038041(A001221(n)) for squarefree n.
%e A401733      n | a(n) | factorization                                             | number of divisors
%e A401733   -----|------|-----------------------------------------------------------|-------------------
%e A401733      1 |    1 | 1                                                         | 1
%e A401733      4 |    2 | 4, 2*2                                                    | 3, 2
%e A401733     16 |    3 | 16, 4*4, 2*2*2*2                                          | 5, 3, 2
%e A401733     36 |    4 | 36, 6*6, 4*9, 2*2*3*3                                     | 9, 4, 4, 2
%e A401733    210 |    5 | 210, 6*35, 10*21, 14*15, 2*3*5*7                          | 16, 4, 4, 4, 2
%e A401733   3600 |    6 | 3600, 36*100, 60*60, 4*4*9*25, 6*6*10*10, 2*2*2*2*3*3*5*5 | 45, 9, 12, 3, 4, 2
%e A401733 a(48) = 3 since 48 has 3 factorizations into factors that have the same number of divisors: 48, 6*8 (A000005(6) = A000005(8) = 4), and 2*2*2*2*3 (A000005(2) = A000005(3) = 2). A401734(48) = 2 since in the factorization 6*8, 6 and 8 having the same number of divisors (4) but different signatures (6 = 2*3, 8 = 2^3).
%t A401733 a[n_] := Count[f[n], _?(Equal @@ DivisorSigma[0, #] &)]; Array[a, 88] (* using the function f by _T. D. Noe_ at A162247 *)
%Y A401733 Cf. A000005, A001221, A005117, A038041, A118914, A162247, A322794, A401734.
%K A401733 nonn,easy,new
%O A401733 1,4
%A A401733 _Amiram Eldar_, Nov 03 2026
