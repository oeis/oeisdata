%T A401517 1397,4637,4085,4017,7356,9980,11724,21505,21094,21406,46185,66225,
%U A401517 57257,97560,169932,224076,240497,291086,323205,443244,807688,927424,1009304,1564940
%N A401517 Sum of products of parts in all partitions of n into distinct parts whose product is a square.
%H A401517 Alois P. Heinz, <a href="/A401517/b401517.txt">Table of n, a(n) for n = 0..500</a>
%e A401517 a(5) = 4: 41.
%e A401517 a(9) = 9: 9.
%e A401517 a(10) = 25 = 16 + 9: 82, 91.
%e A401517 a(11) = 52 = 36 + 16: 632, 821.
%e A401517 a(14) = 100 = 64 + 36: 842, 941.
%p A401517 g:= (n, i, p)-> `if`(i*(i+1)/2<n or max(p)>i, 0, `if`(n=0, 1, b(n, i, p))):
%p A401517 b:= proc(n, i, p) option remember; g(n, i-1, p)+i*g(n-i, min(n-i, i-1),
%p A401517       {select(i-> i[2]::odd, ifactors(mul(j, j=p)*i)[2])[.., 1][]})
%p A401517     end:
%p A401517 a:= n-> g(n$2, {}):
%p A401517 seq(a(n), n=0..46);
