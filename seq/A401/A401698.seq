%S A401698 1,1,1,2,1,2,2,5,1,2,2,5,2,5,5,27,1,2,2,5,2,5,5,22,2,5,5,18,5,19,27,
%T A401698 340,1,2,2,5,2,5,5,19,2,5,5,17,5,16,22,701,2,5,5,17,5,16,18,337,5,19,
%U A401698 19,203,27,151,340,14848,1,2,2,5,2,5,5,19,2,5,5,16,5
%N A401698 Number of unordered partitions of n into distinct parts such that every 1 in the binary expansion of each part is also a 1 in the binary expansion of n.
%C A401698 The number of partitions of n into distinct parts k such that (k bitand n) = k.
%C A401698 The number of factorizations of a prime power p^n into its distinct infinitary divisors, for any prime p (see A401699).
%H A401698 Amiram Eldar, <a href="/A401698/b401698.txt">Table of n, a(n) for n = 0..10000</a>
%F A401698 a(2^n) = 1, a(n) > 1 if n > 0 and is not a power of 2.
%F A401698 a(2^n-1) = A000009(2^n-1). a(n) < A000009(n) if n is not of the form 2^k-1.
%F A401698 a(n) = 2 if and only if n is in A018900.
%F A401698 a(2*n) = a(n), or, equivalently for n >= 1: a(n) = a(A000265(n)).
%F A401698 a(n) = A401699(p^n) for any prime p.
%F A401698 a(n) >= A050315(n), with equality if A000120(n) <= 3.
%e A401698    n | binary | parts               | a(n) | partitions
%e A401698   ---|--------|---------------------|------|------------------------
%e A401698    1 | 1      | 1                   | 1    | 1
%e A401698    2 | 10     | 2                   | 1    | 2
%e A401698    3 | 11     | 1, 2, 3             | 2    | 3, 1+2
%e A401698    4 | 100    | 4                   | 1    | 4
%e A401698    5 | 101    | 1, 4, 5             | 2    | 5, 1+4
%e A401698    6 | 110    | 2, 4, 6             | 2    | 6, 2+4
%e A401698    7 | 111    | 1, 2, 3, 4, 5, 6, 7 | 5    | 7, 1+6, 2+5, 3+4, 1+2+4
%e A401698    8 | 1000   | 8                   | 1    | 8
%e A401698    9 | 1001   | 1, 8, 9             | 2    | 9, 1+8
%e A401698   10 | 1010   | 2, 8, 10            | 2    | 10, 2+8
%t A401698 A401698[n_] := Coefficient[Product[1 + x^b, {b, Select[Range[1, n], BitAnd[#, n] == # &]}], x, n]; Array[A401698, 40, 0]
%t A401698 (* Alternative: *)
%t A401698 A401698[n_] := Module[{v = ConstantArray[0, n + 1]}, v[[1]] = 1; Do[If[BitAnd[k, n] == k, Do[v[[i+1]] += v[[i-k+1]], {i, n, k, -1}]], {k, 1, n}]; v[[n + 1]]]; Array[A401698, 77, 0]
%o A401698 (PARI) A401698(n) = polcoeff(prod(k = 1, n, if(bitand(k,n) == k, 1 + x^k, 1), 1 + O(x^(n+1))), n);
%o A401698 (PARI) A401698(n) = {my(v = vector(n+1)); v[1] = 1; for(k = 1, n, if(bitand(k,n) == k, forstep(i = n, k, -1, v[i+1] += v[i-k+1]))); v[n+1];}
%Y A401698 Cf. A000009, A000120, A000265, A004198, A018900, A038573 (number of partitions of n into 2 parts k such that (k bitand n) = k), A401699.
%K A401698 nonn,base,new
%O A401698 0,4
