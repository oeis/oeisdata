%N A401615 a(0) = 1; a(n) = Sum_{k=0..n-1} binomial(2*n-k,k) * a(k).
%F A401615 G.f. A(x) satisfies: 2*A(x) = 1 + A(x/(1 - sqrt(x))) / (2*(1 - sqrt(x))) + A(x/(1 + sqrt(x))) / (2*(1 + sqrt(x))).
%F A401615 a(n) ~ c * n!^2 * n^(1/2 + log(2 + sqrt(3))/sqrt(3)) / log(2 + sqrt(3))^(2*n), where c = 0.7725620359716985108215199639541704432593771820981614376720475... - _Vaclav Kotesovec_, Oct 31 2026
%t A401615 a[0] = 1; a[n_] := a[n] = Sum[Binomial[2 n - k, k] a[k], {k, 0, n - 1}]; Table[a[n], {n, 0, 18}]
%t A401615 (* Alternative: *)
%t A401615 nmax = 18; A[_] = 0; Do[A[x_] = 1 - A[x] + A[x/(1 - Sqrt[x])]/(2 (1 - Sqrt[x])) + A[x/(1 + Sqrt[x])]/(2 (1 + Sqrt[x])) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%Y A401615 Cf. A005439, A094088, A092684, A296590.
