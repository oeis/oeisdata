%N A401393 a(n) = n / A305007(n), where A305007 are the denominators of coefficients in expansion of Sum_{k>=1} x^k/(k*(1 + x^k)).
%H A401393 Antti Karttunen, <a href="/A401393/b401393.txt">Table of n, a(n) for n = 1..10000</a>
%o A401393 (PARI)
%o A401393 A305007(n) = denominator(sumdiv(n, d, (-1)^(d+1)*d/n));
%o A401393 A401393(n) = (n/A305007(n));
%Y A401393 Cf. A305007.
