%I A401721 #12 Nov 08 2026 17:37:06
%S A401721 1,2,2,3,2,4,2,5,5,6,2,7,2,8,9,10,2,11,2,12,13,14,2,15,16,17,18,19,2,
%T A401721 20,2,21,22,23,24,25,2,26,27,28,2,29,2,30,31,32,2,33,34,35,36,37,2,38,
%U A401721 27,39,40,41,2,42,2,43,44,45,46,47,2,48,49,50,2,51,2,52,53,54,46,55,2,56,57,58,2,59,40,60,61,62,2,63,36
%N A401721 Lexicographically earliest infinite sequence such that a(i) = a(j) => A034460(i) = A034460(j) and A325313(i) = A325313(j), for all i, j >= 1, where A034460(n) is usigma(n)-n, and A325313(n) is (the sum of squarefree divisors of n)-n.
%C A401721 Restricted growth sequence transform of the ordered pair [A034460(n), A325313(n)].
%C A401721 For all i, j >= 1:
%C A401721   A305800(i) = A305800(j) => a(i) = a(j),
%C A401721   a(i) = a(j) => A325977(i) = A325977(j) => A401715(i) = A401715(j).
%H A401721 Antti Karttunen, <a href="/A401721/b401721.txt">Table of n, a(n) for n = 1..65537</a>
%o A401721 (PARI)
%o A401721 up_to = 65537;
%o A401721 rgs_transform(invec) = { my(om = Map(), outvec = vector(length(invec)), u=1); for(i=1, length(invec), if(mapisdefined(om,invec[i]), my(pp = mapget(om, invec[i])); outvec[i] = outvec[pp], mapput(om,invec[i],i); outvec[i] = u; u++ )); outvec; };
%o A401721 A034460(n) = { my(f=factorint(n)); (prod(k=1, #f~, 1+(f[k, 1]^f[k, 2]))-n); };
%o A401721 A325313(n) = (factorback(apply(p -> p+1,factor(n)[,1]))-n);
%o A401721 Aux401721(n) = [A034460(n), A325313(n)];
%o A401721 v401721 = rgs_transform(vector(up_to,n,Aux401721(n)));
%o A401721 A401721(n) = v401721[n];
%Y A401721 Cf. A034448, A034460, A048250, A325313.
%Y A401721 Cf. A305800, A325977, A401715.
%K A401721 nonn,easy,new
%O A401721 1,2
%A A401721 _Antti Karttunen_, Nov 07 2026
