%I A401977 #16 Nov 17 2026 21:46:27
%S A401977 2,1,-3,1,-2,5,1,-1,3,-7,1,0,2,-4,11,1,1,2,-2,7,-13,1,2,3,0,5,-6,17,1,
%T A401977 3,5,3,5,-1,11,-19,1,4,8,8,8,4,10,-8,23,1,5,12,16,16,12,14,2,15,-29,1,
%U A401977 6,17,28,32,28,26,16,17,-14,31,1,7,23,45,60,60,54,42,33,3,17,-37
%N A401977 Triangle read by rows: T(0,0) = 2; for n >= 1, T(n,0) = 1, T(n,n) = (-1)^n*prime(n+1), and T(n,k) = T(n-1,k-1) + T(n-1,k) for 0 < k < n.
%C A401977 Called the Bourgeois triangle by Rouyea and Bourgeois: a Pascal-type array with a unit left border and the odd primes, with alternating signs, down the right border. The apex value 2 does not affect any later row.
%H A401977 Blaize Rouyea and Corey Bourgeois, <a href="https://www.alphaxiv.org/abs/2608.bourgeois-triangle-prime-wheels-ramanujan">The Bourgeois Triangle: A First-Principles Linear Medium for Prime Wheels, Ramanujan Lanes, and the von Mangoldt Doorway</a>, alphaXiv preprint (2026).
%F A401977 For n >= 1, T(n,1) = n - 4.
%F A401977 For n >= 1, T(n,n-1) = (-1)^(n-1)*A036467(n).
%F A401977 For n >= 2, Sum_{k=0..n} (-1)^k*T(n,k) = A001043(n).
%F A401977 For n >= 1, T(n,k) = binomial(n-1,k) + Sum_{m=1..k} u(m)*binomial(n-m,k-m), where u(1) = -3 and u(m) = (-1)^m*(prime(m) + prime(m+1)) for m >= 2.
%e A401977 Triangle begins:
%e A401977   2;
%e A401977   1,  -3;
%e A401977   1,  -2,   5;
%e A401977   1,  -1,   3,  -7;
%e A401977   1,   0,   2,  -4,  11;
%e A401977   1,   1,   2,  -2,   7, -13;
%e A401977   1,   2,   3,   0,   5,  -6,  17;
%e A401977   1,   3,   5,   3,   5,  -1,  11, -19;
%e A401977   1,   4,   8,   8,   8,   4,  10,  -8,  23;
%e A401977   1,   5,  12,  16,  16,  12,  14,   2,  15, -29;
%o A401977 (Python)
%o A401977 from sympy import prime
%o A401977 def bourgeois(rows):
%o A401977     T = [[2]]
%o A401977     for n in range(1, rows):
%o A401977         T.append([1] + [T[n-1][k-1] + T[n-1][k] for k in range(1, n)] + [(-1)**n*prime(n+1)])
%o A401977     return T
%o A401977 print([x for row in bourgeois(12) for x in row])
%Y A401977 Cf. A000040, A001043, A036467.
%K A401977 sign,tabl,new
%O A401977 0,1
%A A401977 _Blaize Rouyea_, Nov 10 2026
