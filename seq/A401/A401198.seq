%I A401198 #19 Nov 02 2026 22:25:42
%S A401198 0,3,57,1317,43437,2157213,165105597,19698691197,3688580371197,
%T A401198 1088505305995773,507549887129656317,374611372420852746237,
%U A401198 438194836437331642920957,813008483043978263307657213,2394004672462530850131440025597
%N A401198 Number of ways to add one improperly colored vertex to a properly colored graph of n-1 vertices.
%C A401198 This sequence counts pairs of (graph, 3-coloring) on n labeled vertices such that the induced subgraph on the first n-1 vertices is properly 3-colored, but the introduction of the n-th vertex (with its pre-assigned color and incident edges) introduces at least one monochromatic edge, causing the coloring to become improper for the first time.
%C A401198 It captures the boundary where a local operation (adding a vertex and its incident edges) disrupts a global property (properness of the chosen coloring).
%F A401198 a(n) = 3 * 2^(n-1) * A191371(n-1) - A191371(n).
%t A401198 f[{k_, r_, m_}] := Binomial[m + r + k, k] Binomial[m + r, r] 2^(k r + k m + r m);
%t A401198 aSeq = Table[Total[Map[f, Compositions[n, 3]]], {n, 0, 20}];
%t A401198 a[n_Integer?Positive] := 3*2^(n - 1)*aSeq[[n]] - aSeq[[n + 1]];
%t A401198 Table[a[n], {n, 1, 20}]
%Y A401198 Cf. A191371.
%K A401198 nonn,new
%O A401198 1,2
%A A401198 _Kanata Matsumaru_, Oct 17 2026
