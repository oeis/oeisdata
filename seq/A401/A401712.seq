%N A401712 Numbers k such that A017665(k) is larger than A401375(k), where A017665(n) = sigma(n)/gcd(n,sigma(n)), A401375(n) is the largest divisor of sigma(n) coprime with n, and sigma is the sum of divisors function.
%C A401712 First squares in this sequence: 879844, 1223236, 6125625, ...
%H A401712 Antti Karttunen, <a href="/A401712/b401712.txt">Table of n, a(n) for n = 1..10000</a>
%F A401712 {k such that A017665(k) > A401375(k)}.
%F A401712 {k such that A017665(k) = m*A401375(k), with m > 1}.
%o A401712 (PARI) is_A401712(n) = { my(s=sigma(n)); fordiv(s,d,if(1==gcd(s/d,n), return(d!=gcd(n,s)))); };
%Y A401712 Cf. A000203, A017665, A401375, A401711 (complement).
%Y A401712 Positions of terms larger than 1 in A401710.
%K A401712 nonn,new
%O A401712 1,1
