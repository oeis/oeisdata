%I A401179 #8 Oct 17 2026 12:29:39
%S A401179 0,0,1,31,1357,98092,12404458,2844613544,1213319407368,
%T A401179 979881231507936,1517136064903451184,4542947638962961820608,
%U A401179 26475599948526131107379200,301684383030098070299849646464,6744714556051006221339942620454784,296643637313435848465711307937699335168
%N A401179 Total number of induced cycles in all connected labeled graphs on n vertices.
%H A401179 Andrew Howroyd, <a href="/A401179/b401179.txt">Table of n, a(n) for n = 1..50</a>
%o A401179 (PARI)
%o A401179 G(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k/2^(k*(k-1)/2), O(x^n)))}
%o A401179 U(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k*2^(k*(k-1)/2), O(x^n)))}
%o A401179 seq(n)={my(g=U(exp(x+O(x*x^n)))); Vec(serlaplace(U(G((-x-x^2/2-log(1-x+O(x*x^n)))/2)*G(g))/g), -n)}
%Y A401179 Cf. A401098, A401099, A401178.
%K A401179 nonn,new
%O A401179 1,4
%A A401179 _Andrew Howroyd_, Oct 16 2026
