%N A401281 Triangle read by rows: T(n,k) is the number of n X k binary matrices with all column sums 2 and row sums at most 2.
%H A401281 Andrew Howroyd, <a href="/A401281/b401281.txt">Table of n, a(n) for n = 0..1325</a> (rows 0..50)
%F A401281 Bivariate e.g.f.: sqrt(exp(x - x*y + x/(1 - x*y))/(1 - x*y)).
%e A401281 Triangle begins:
%e A401281   1;
%e A401281   1,  0;
%e A401281   1,  1,   1;
%e A401281   1,  3,   9,    6;
%e A401281   1,  6,  36,  114,     90;
%e A401281   1, 10, 100,  690,   2490,   2040;
%e A401281   1, 15, 225, 2640,  20610,  80190,   67950;
%e A401281   1, 21, 441, 7770, 102690, 871290, 3586590, 3110940;
%e A401281   ...
%o A401281 (PARI)
%o A401281 T(n)={ my(v=Vec(serlaplace( sqrt(exp(x - x*y + x/(1-x*y) + O(x*x^n))/(1-x*y)) ))); vector(#v, i, Vecrev(serlaplace(v[i]), i)) }
%o A401281 { my(A=T(10)); for(i=1, #A, print(A[i])) }
%Y A401281 Row sums are A401282.
%Y A401281 Main diagonal is A001499.
%Y A401281 Central coefficients are A401283.
%Y A401281 Columns k=0..2 are A000012, A161680, A000537(n-1).
%Y A401281 Cf. A008300, A401284 (up to row and column permutations).
%K A401281 nonn,tabl,new
%O A401281 0,8
