%U A401184 11743863033398379517949952,112432524142921683080815611904,2127443312423157488302563911224320,79709870012779739474676183821246545920
%N A401184 Total number of unordered pairs of vertices not connected by an edge in all connected labeled graphs on n vertices.
%C A401184 Equivalently, a(n) is the total number of edges in all labeled graphs on n vertices whose complement is connected.
%H A401184 Andrew Howroyd, <a href="/A401184/b401184.txt">Table of n, a(n) for n = 1..50</a>
%F A401184 a(n) = binomial(n,2)*A001187(n) - A094594(n).
%o A401184 (PARI) seq(n) = my(g=sum(j=0, n, 2^binomial(j, 2)*x^j/j!, O(x*x^n)), gc=log(g)); Vec(serlaplace(sum(j=1,n,binomial(j,2)*polcoef(gc,j)*x^j) - sum(j=2, n, binomial(j, 2)*2^(binomial(j, 2)-1)*x^j/j!, O(x*x^n))/g), -n)
%Y A401184 Column k=2 of A401185.
%Y A401184 Cf. A001187, A094594, A322278.
%K A401184 nonn,new
%O A401184 1,3
%A A401184 _Andrew Howroyd_, Oct 17 2026
