%I A401938 #21 Nov 11 2026 16:25:03
%S A401938 4,5,6,7,8,9,10,11,12,20,21,22,30,88,100,200,212,300,1000,1011,1101,
%T A401938 2000,3000,10000,20000,30000,100000,200000,300000,1000000,1010011,
%U A401938 1100101,2000000,3000000,10000000,20000000,30000000,100000000,200000000,300000000,1000000000,2000000000,3000000000
%N A401938 Numbers k such that k times its decimal digit reversal contains exactly two distinct decimal digits.
%C A401938 The sequence consists of the positive integers k for which A401895(k) = 2.
%C A401938 The sequence is infinite, since 10^m is a term for every m >= 1.
%C A401938 The terms 12, 21, 1011, 1101, 1010011, and 1100101 are nonpalindromic, are not divisible by 10, and have products containing exactly two distinct digits.
%e A401938 a(1) = 4 because 4*4 = 16, which contains exactly two distinct decimal digits.
%e A401938 12*21 = 252.
%e A401938 1011*1101 = 1113111.
%e A401938 1010011*1100101 = 1111114111111.
%o A401938 (Python)
%o A401938 def is_ok(k):
%o A401938     r = int(str(k)[::-1])
%o A401938     return len(set(str(k*r))) == 2
%o A401938 def sequence():
%o A401938     k = 1
%o A401938     while True:
%o A401938         if is_ok(k):
%o A401938             yield k
%o A401938         k += 1
%o A401938 (PARI) is_a401938(k) = my(d=digits(k), r=Vecrev(d)); #Set(digits(k*fromdigits(r))) == 2 \\ _Hugo Pfoertner_, Nov 11 2026
%Y A401938 Cf. A004086, A043537, A061205, A401895, A397143.
