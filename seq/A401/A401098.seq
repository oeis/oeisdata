%I A401098 #9 Oct 17 2026 12:29:51
%S A401098 1,3,25,446,15838,1106936,153232716,42235652496,23195274203024,
%T A401098 25344722581933120,55022959325687403488,237184753246977915382912,
%U A401098 2030118167175029350019376384,34517429763085017906471138426624,1166612625999694777921379655647588608,78435444110564472007212327519473524029440
%N A401098 Total number of (non-null) connected induced subgraphs in all connected labeled graphs on n vertices.
%H A401098 Andrew Howroyd, <a href="/A401098/b401098.txt">Table of n, a(n) for n = 1..50</a>
%o A401098 (PARI)
%o A401098 G(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k/2^(k*(k-1)/2), O(x^n)))}
%o A401098 U(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k*2^(k*(k-1)/2), O(x^n)))}
%o A401098 seq(n)={my(g=U(exp(x+O(x*x^n)))); Vec(serlaplace(U(G(log(g))*G(g))/g))}
%Y A401098 Cf. A401091 (in trees), A401097 (not necessarily connected), A401099, A401178, A401179, A401180.
%K A401098 nonn,new
%O A401098 1,2
%A A401098 _Andrew Howroyd_, Oct 16 2026
