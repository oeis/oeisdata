%I A401514 #7 Nov 03 2026 17:45:58
%S A401514 4,12,8,20,12,40,28,36,20,112,44,144,168,220,264,68,160,36,224,272,
%T A401514 416,280,380,336,532,308,100,240,572,672,400,836,432,232,572,912,64,
%U A401514 580,988,1100,496,264,928,1020,1404,992,76,560,1508,312,936,624,560,1036,1184,656,344,92,2108,1148,1748
%N A401514 Even legs of the primitive Pythagorean triples corresponding to A398554.
%H A401514 Robert Israel, <a href="/A401514/b401514.txt">Table of n, a(n) for n = 1..10000</a>
%F A401514 a(k) = 2*m*n where m and n are coprime with opposite parity and A398554(k) = (2*m^2 + 2*m*n)^2 - (m^2+n^2).
%e A401514 a(3) = 8 because 8 is the even leg of the primitive Pythagorean triple (8,15,17) which has perimeter 40, hypotenuse 17, and 40^2 - 17 = 1583 = A398554(3).
%p A401514 N:= 10^7: # for terms where A398554(k) <= N
%p A401514 R:= NULL:
%p A401514 for m from 1 while 4*m^4 + 8*m^3 + 3*m^2-1 <= N do
%p A401514   for n from (m mod 2) + 1 by 2 to m-1 do
%p A401514     if igcd(m, n) > 1 then next fi;
%p A401514     v:= (2*m^2 + 2*m*n)^2 - (m^2+n^2);
%p A401514     if v > N then break fi;
%p A401514     if isprime(v) then R:= R, [v, 2*m*n] fi
%p A401514 od od:
%p A401514 R:= sort([R], (s, t) -> s[1]<t[1]):
%p A401514 R[.., 2];
%Y A401514 Cf. A398554, A401513, A401515.
%K A401514 nonn,new
%O A401514 1,1
%A A401514 _Will Gosnell_ and _Robert Israel_, Oct 27 2026
