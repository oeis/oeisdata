%I A401130 #21 Nov 04 2026 13:37:32
%S A401130 1,3,6,10,15,21,28,36,45,145,309,545,860,1260,1750,2334,3015,3795,
%T A401130 12175,25920,45782,72469,106631,148848,199620,259359,328383,1056088,
%U A401130 2254554,3994280,6343405,9366348,13122543,17665299,23040810,29287335,94352467
%N A401130 a(n) is the number of points (x, y) of the square lattice Z^2 with x, y >= 0 connected to the origin by a path of unit horizontal and vertical steps through points of the first quadrant satisfying digitsum(x) + digitsum(y) <= n.
%C A401130 With binary digit sums in place of decimal ones, the count is binomial(2n+3, n) = A002054(n+1) exactly, via a reflection argument on the interleaved-bit walk.
%C A401130 Same reachability criterion as A401129.
%H A401130 Adam Benzan, <a href="/A401130/b401130.txt">Table of n, a(n) for n = 0..100</a>
%H A401130 Adam Benzan, <a href="/A401129/a401129.pdf">An exact reachability criterion for digit-sum-bounded lattice walks</a>, 2026.
%e A401130 For n = 0 only the origin is allowed, so a(0) = 1.
%e A401130 For n = 1 the reachable points in the first quadrant are (0,0), (1,0) and (0,1), so a(1) = 3.
%e A401130 For n = 19 the point (300,0) is not counted despite digitsum(300) = 3, because the column x = 299 (digit sum 20) walls it off.
%o A401130 (Python)
%o A401130 def a(n, b=10):
%o A401130     B = b - 1
%o A401130     k = n // B + 1
%o A401130     w = [0] * (2 * b - 1)
%o A401130     for i in range(b):
%o A401130         for j in range(b):
%o A401130             w[i + j] += 1
%o A401130     W = {B * k - n: 1}
%o A401130     for s in range(k):
%o A401130         cap = 1 if s < k - 1 else 0
%o A401130         nxt = {}
%o A401130         for d, c in W.items():
%o A401130             for m, wm in enumerate(w):
%o A401130                 if d + m - B <= cap:
%o A401130                     nxt[d + m - B] = nxt.get(d + m - B, 0) + c * wm
%o A401130         W = nxt
%o A401130     Q = sum(W.values())
%o A401130     return Q
%Y A401130 Cf. A401129 (full-plane version), A002054 (base-2 analog), A051885 (least integer with given digit sum), A007953 (digit sum).
%K A401130 nonn,base,walk,new
%O A401130 0,2
%A A401130 _Adam Benzan_, Oct 15 2026
