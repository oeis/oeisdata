%N A401512 Denominators of continued fraction convergents to A226771.
%F A401512 a(n) = denominator( K_{i=0..n} A000217(i) ), where K is the Gauss notation for a continued fraction. In the expanded form, A226771 = 1/(0 + 1/(1 + 1/(3 + 1/(6 + 1/(10 + 1/(15 + ... + 1/A000217(n) )))))).
%F A401512 Limit_{n->oo} A071896(n)/a(n) = A226771.
%e A401512 1/1, 4/3, 25/19, 254/193, 3835/2914, 80789/61387, ...
%t A401512 a[n_]:=Denominator[ContinuedFractionK[Binomial[k+1,2],{k,0,n}]]; Array[a,19]
%Y A401512 Cf. A000217 (continued fraction), A071896 (convergent numerators), A226771 (decimal expansion).
%K A401512 nonn,frac,new
