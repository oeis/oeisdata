%U A401681 303475363906438430,13299438159179072654,621166750613039074478,30803083675180347926354,1616306017904228112755882
%N A401681 a(0) = 1; a(n) = Sum_{k=1..n} binomial(2*n,k) * a(n-k).
%F A401681 G.f. A(x) satisfies A(x) = (1-x)/(1+x) * (2*A(x/(1+x)^2) - 1).
%F A401681 a(n) is even for n > 0.
%F A401681 a(n) ~ c * n! * 2^n * n^(log(2)/4) / log(2)^n, where c = 0.80072529543959884071021118708251096606866926018452188550059... - _Vaclav Kotesovec_, Nov 02 2026
%t A401681 a[0] = 1; a[n_] := a[n] = Sum[Binomial[2*n, k]*a[n-k], {k, 1, n}]; Table[a[n], {n, 0, 20}] (* _Vaclav Kotesovec_, Nov 02 2026 *)
%o A401681 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(2*i, j)*v[i-j+1])); v;
%Y A401681 Cf. A000670, A401682, A401683.
