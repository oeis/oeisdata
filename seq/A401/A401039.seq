%I A401039 #4 Oct 14 2026 09:39:50
%S A401039 0,1,0,1,1,1,1,2,1,3,2,3,3,4,4,5,6,6,7,9,8,11,11,13,14,16,17,20,21,24,
%T A401039 26,29,31,35,38,41,45,50,53,59,64,69,75,82,88,96,103,112,120
%N A401039 Number of partitions of n into consecutive initial prime numbers.
%C A401039 "Consecutive" means that a partition like 10=3+7 is not counted (because the intermediate prime 5 is missing). "Initial" means that the first prime (=2) must appear at least once as a part.
%e A401039 a(8)=2 counts 2+2+2+2 and 2+3+3. a(9)=1 counts 2+2+2+3. a(10) =3 counts 2+2+2+2+2, 2+2+3+3 and 2+3+5. a(17)=6 counts 2+2+2+2+2+2+2+3, 2+2+2+2+3+3+3, 2+3+3+3+3+3, 2+2+2+3+3+5, 2+2+3+5+5 and 2+3+5+7.
%p A401039 A401039 := proc(n)
%p A401039     local a,p,admit,iset,ili;
%p A401039     a := 0 ;
%p A401039     for p in combinat[partition](n) do
%p A401039         admit := true ;
%p A401039         # prime index set
%p A401039         iset := {} ;
%p A401039         for pa in p do
%p A401039             if A049084(pa) =0 then
%p A401039                 # reject if non-prime parts
%p A401039                 admit := false ;
%p A401039             else
%p A401039                 iset := iset union {A049084(pa)} ;
%p A401039             end if;
%p A401039         end do ;
%p A401039         if admit then
%p A401039             # check that iset is consecutive integer range (first diffs)
%p A401039             ili := sort(convert(iset,list)) ;
%p A401039             for i from 2 to nops(ili) do
%p A401039                 if op(i,ili) - op(i-1,ili) >=2 then
%p A401039                     admit := false ;
%p A401039                 end if;
%p A401039             end do:
%p A401039             # check that iset starts at 1 (=prime 2)
%p A401039             if op(1,ili) <> 1 then
%p A401039                 admit := false;
%p A401039             end if;
%p A401039         end if;
%p A401039         if admit then
%p A401039             # print(n,p) ;
%p A401039             a := a+1 ;
%p A401039         end if;
%p A401039     end do:
%p A401039     a ;
%p A401039 end proc:
%p A401039 for n from 1 do
%p A401039     printf("%d,\n",A401039(n)) ;
%p A401039 end do:
%Y A401039 Cf. A000607, A172491 (similar with Fibonacci parts), A034707 (distinct prime parts).
%K A401039 nonn,less,more,new
%O A401039 1,8
%A A401039 _R. J. Mathar_, Oct 14 2026
