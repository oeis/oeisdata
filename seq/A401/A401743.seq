%S A401743 4,1,0,1,3,4,1,4,5,0,1,5,9,7,4,1,6,14,16,9,0,1,7,20,30,25,11,4,1,8,27,
%T A401743 50,55,36,13,0,1,9,35,77,105,91,49,15,4,1,10,44,112,182,196,140,64,17,
%U A401743 0,1,11,54,156,294,378,336,204,81,19,4,1,12,65,210,450,672,714,540,285,100,21,0
%N A401743 Triangle read by rows: for n>0 and 0<=k<=n, T(n,k) is the number of circular (n+k)-bit strings with k 1's that, when circularly shifted by 2 bits, do not have any coincident 1's when placed over the original bit string.
%C A401743 T(n,k) is the number of tilings of a circular (n+k)-board using k curved (1,1)-fences and n-k curved unit square tiles. A (1,g)-fence is composed of two unit square tiles separated by a gap of width g.
%C A401743 This is the m=2 member in the sequence of triangles A029635, A401743, A401744, A401745, A401746 which give the number of tilings of a circular (n+k) X 1 board using k curved (1,m-1)-fences and n-k curved unit square tiles.
%C A401743 This is also the m=2, t=2 member of a two-parameter family of triangles such that T(n,k) is the number of tilings of an (n+(t-1)*k) X 1 circular board using k curved (1,m-1;t)-combs and n-k curved unit square tiles. A (1,g;t)-comb is composed of a line of t unit square tiles separated from each other by gaps of width g.
%C A401743 T(n,k) is the coefficient of x^k in (L((n+k)/p))^p where p=gcd(n+k,2) and L(n,x) is a form of Lucas polynomial defined by L(n,x) = L(n-1,x) + x*L(n-2,x) where L(0,x)=2, L(1,x)=1, and L(n,x)=0 for n<0.
%C A401743 For n+k>2, T(n,k) is the number of k-subsets of n+k objects arranged in a circle such that no two objects in a subset are separated (without wrap-around) by 1 object.
%C A401743 For n>0, sum of row n is A259713(n-1).
%C A401743 Sum of n-th antidiagonal (counting initial 4 as the 0th) is A001638(n).
%C A401743 Replacing all the entries in the leading diagonal by 2 yields the Lucas triangle A029635.
%C A401743 The s-th diagonal (counting the leading diagonal as the 0th) for s=3,..,11 is A000330, A002415, A005585, A040977, A050486, A053347, A054333, A054334, A057788, respectively.
%F A401743 G.f.: (4 - 3*x - x^2*y)/(1 - x - x^2*y*(1 + y)) where T(n,k) is the coefficient of x^n*y^k.
%F A401743 T(n,0) = 1 for n>0.
%F A401743 T(n,1) = n+1 for n>=2.
%F A401743 T(2*k,2*k) = 4 for k>=0.
%F A401743 T(2*k+1,2*k+1) = 0 for k>=0.
%F A401743 T(k+1,k) = 2*k+1 for k>=0.
%F A401743 T(k+2,k) = (k+1)^2 for k>=0.
%F A401743 T(n,k) = C(n,k)*(n+k)/n if k<n.
%F A401743 T(n,k) = C(n,k) + C(n-1,k-1) for n>1 and 0<k<n.
%F A401743 T(n,k) = T(n-1,k) + T(n-1,k-1) for n>1 and 0<k<n-1.
%F A401743 T(n,k) = 4*delta(n,0)*delta(k,0) - 3*delta(n,1)*delta(k,0) - delta(n,2)*delta(k,1) + T(n-1,k) + T(n-2,k-1) + T(n-2,k-2).
%e A401743 Triangle begins:
%e A401743   4;
%e A401743   1,   0;
%e A401743   1,   3,   4;
%e A401743   1,   4,   5,   0;
%e A401743   1,   5,   9,   7,   4;
%e A401743   1,   6,  14,  16,   9,   0;
%e A401743   1,   7,  20,  30,  25,  11,   4;
%e A401743   1,   8,  27,  50,  55,  36,  13,   0;
%e A401743   1,   9,  35,  77, 105,  91,  49,  15,   4;
%e A401743   1,  10,  44, 112, 182, 196, 140,  64,  17,   0;
%e A401743   1,  11,  54, 156, 294, 378, 336, 204,  81,  19,   4;
%e A401743   1,  12,  65, 210, 450, 672, 714, 540, 285, 100,  21,   0;
%e A401743 ...
%t A401743 LP[n_]:=If[n<0,0,Expand[LP[n-1]+x*LP[n-2]]+2KroneckerDelta[n,0]-KroneckerDelta[n,1]];
%t A401743 T[n_,k_]:=Module[{p=GCD[n+k,2]},Coefficient[LP[(n+k)/p]^p,x,k]];
%t A401743 Flatten@Table[T[n, k], {n, 0, 11}, {k, 0, n}]
%Y A401743 Other triangles related to tiling using fences: A059259, A123521, A157897, A335964, A350110.
