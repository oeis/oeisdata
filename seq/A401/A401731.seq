%o A401731 (PARI)
%o A401731 A342002(n) = { my(s=0, p=2); while(n, s += ((n%p)/p); n = n\p; p = nextprime(1+p)); numerator(s); };
%o A401731 is_A401731(k) = (A342002(k)==k);
