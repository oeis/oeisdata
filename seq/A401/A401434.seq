%I A401434 #29 Nov 02 2026 16:35:06
%S A401434 13,109,433,769,1453,3889,4801,10093,18253,20173,37633,47629,65713,
%T A401434 73009,108301,115249,147853,169933,172801,238573,280909,299569,326701,
%U A401434 363313,415153,640333,685453,720301,967873,995329,1138369,1145773,1190701,1651693,1769473
%N A401434 Primes of the form 3*(p-1)^2 + 1, where p is prime.
%H A401434 Hector Yan Estivel, <a href="/A401434/b401434.txt">Table of n, a(n) for n = 1..10000</a>
%e A401434 For p = 3, we have 3*(3-1)^2 + 1 = 13, which is prime. For p = 5, we have 3*(5-1)^2 + 1 = 49, which is composite. For p = 7, we have 3*(7-1)^2 + 1 = 109, which is prime. Thus the first two terms are a(1) = 13 and a(2) = 109.
%p A401434 f:= p-> (q-> `if`(andmap(isprime, [p, q]), q, [][]))(3*(p-1)^2+1):
%p A401434 map(f, [$1..770])[];  # _Alois P. Heinz_, Oct 24 2026
%t A401434 Select[Prime[Range[133000]],PrimeQ[Sqrt[(#-1)/3]+1] &] (* _Stefano Spezia_, Oct 24 2026 *)
%o A401434 (SageMath)
%o A401434 from math import isqrt
%o A401434 def aupto(limit):
%o A401434     max_p = isqrt((limit - 1) // 3) + 1
%o A401434     result = []
%o A401434     for p in prime_range(2, max_p + 1):
%o A401434         q = 3*(p - 1)**2 + 1
%o A401434         if q > limit:
%o A401434             break
%o A401434         if is_prime(q):
%o A401434             result.append(q)
%o A401434     return result
%o A401434 print(aupto(2*10^6))
%Y A401434 Subsequence of A002648.
%Y A401434 Cf. A400920, A400684.
%K A401434 nonn,easy,new
