%T A401984 -40,45,-12,1,-56,-20,228,-70,-100,66,-14,1,73,-232,-278,488,-5,-196,
%U A401984 91,-16,1,22,597,-360,-1044,798,189,-336,120,-18,1,-263,-476,2151,264,-2625,1008,588,-528,153,-20,1
%N A401984 Triangle read by rows: Riordan array ( 1/(1 + 2*x + 3*x^2), x/(1 + 2*x + 3*x^2) ).
%H A401984 Stefano Spezia, <a href="/A401984/b401984.txt">Table of n, a(n) for n = 0..11475</a> (151 rows of the triangle, flattened)
%H A401984 Paul Barry, <a href="https://arxiv.org/abs/2611.05673">Orthogonal polynomials on two or more intervals: the Sprugnoli context</a>, arXiv:2611.05673 [math.CO], 2026. See p. 4.
%F A401984 abs(T(n,0)) = abs(A088137(n+1)).
%F A401984 Sum_{k=0..n} T(n,k) = A214733(n+1).
%e A401984 The triangle begins as:
%e A401984     1;
%e A401984    -2,   1;
%e A401984     1,  -4,   1;
%e A401984     4,   6,  -6,   1;
%e A401984   -11,   4,  15,  -8,   1;
%e A401984    10, -37,  -8,  28, -10,   1;
%e A401984    13,  72, -66, -40,  45, -12, 1;
%e A401984    ...
%t A401984 T[n_,k_]:=SeriesCoefficient[x^k/(1+2*x+3*x^2)^(k+1),{x,0,n}]; Table[T[n,k],{n,0,10},{k,0,n}]//Flatten
%Y A401984 Inverse array is A401985.
%Y A401984 Oblique side gives A000012.
%Y A401984 Cf. A088137, A214733.
%K A401984 sign,easy,tabl,new
%O A401984 0,2
%A A401984 _Stefano Spezia_, Nov 11 2026
