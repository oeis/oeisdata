%S A401847 1,1,2,4,12,36,144,576,2880,17280,120960,604800,4838400,29030400,
%T A401847 261273600,2612736000,28740096000,201180672000,2414168064000,
%U A401847 19313344512000,251073478656000,3515028701184000,52725430517760000,474528874659840000,7592461994557440000
%N A401847 Number of permutations of {1..n} such that all primes are adjacent (form a single contiguous block).
%C A401847 For n = 0 and n = 1, there are no primes in {1..n}, so the empty permutation and (1) trivially satisfy the condition, giving a(0) = a(1) = 1.
%C A401847 Formula explanation: Treat all p = pi(n) primes as a single block, which can be ordered internally in p! ways. This block together with the c = n - p nonprimes forms c + 1 objects that can be arranged in (c + 1)! ways, giving a(n) = p! * (c + 1)!.
%C A401847 For 0 <= n <= 9, a(n) = A401790(n + 1).
%H A401847 Mykola Filipchuk, <a href="/A401847/b401847.txt">Table of n, a(n) for n = 0..487</a>
%F A401847 a(0) = a(1) = 1 and a(n) = pi(n)! * (n - pi(n) + 1)! for n >= 2, where pi = A000720.
%F A401847 a(n) = p! * (c + 1)! for n >= 2, where p = pi(n) and c = n - p.
%e A401847 For n = 3, the primes {2, 3} must be adjacent, giving a(3) = 4 valid permutations: (1, 2, 3), (1, 3, 2), (2, 3, 1), (3, 2, 1).
%e A401847 For n = 4, the primes {2, 3} form a single block that can be ordered internally in 2! = 2 ways and arranged with the nonprimes {1, 4} in 3! = 6 ways, giving a(4) = 2 * 6 = 12 valid permutations.
%p A401847 a:= n-> `if`(n<2, 1, (p-> p!*(n-p+1)!)(numtheory[pi](n))):
%p A401847 seq(a(n), n=0..24);
%o A401847 (Python)
%o A401847 import math
%o A401847 from sympy import primepi
%o A401847 def a(n):
%o A401847     if n <= 1: return 1
%o A401847     p = primepi(n)
%o A401847     return math.factorial(p) * math.factorial(n - p + 1)
%o A401847 print([a(n) for n in range(0, 25)])
%o A401847 (PARI)
%o A401847 a(n) = if(n<2, 1, my(p=primepi(n)); p!*(n-p+1)!);
%o A401847 vector(25, n, a(n-1))
