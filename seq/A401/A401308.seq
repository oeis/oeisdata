%N A401308 Decimal expansion of the smallest positive solution of Phi(x^6; x^4) = 0.
%C A401308 Definition: Phi(x^6; x^4) = Sum_{j>=0} ((-1)^j*x^(4*j^2 + 2*j) / Product_{k=1..j} (1 - x^(4*k))).
%C A401308 Apparently constant^(-1) = 1.112336... is the exponential growth constant of A400282.
%e A401308 0.899008919582777872799531498558332636405875563...
%t A401308 dFunction[x_?NumericQ, prec_Integer?Positive] := Module[{xx, term, sum, j = 0, tol}, xx = SetPrecision[x, prec + 20]; tol = 10^(-prec - 15); term = 1; sum = term; While[Abs[term] > tol || j < 5, term *= -xx^(8 j + 6)/(1 - xx^(4 j + 4)); sum += term; j++; ]; sum ]
%t A401308 rho[prec_Integer?Positive] := Module[{x, wp = prec + 20}, With[{lo = N[85/100, wp], hi = N[95/100, wp] }, x /. FindRoot[dFunction[x, prec] == 0, {x, lo, hi}, WorkingPrecision -> wp, AccuracyGoal -> prec, PrecisionGoal -> prec, MaxIterations -> 100 ]]]
%t A401308 Print[First[RealDigits[N[rho[119], 106]]]]
%Y A401308 Cf. A400282.
%K A401308 nonn,cons,new
