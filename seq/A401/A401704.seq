%I A401704 #8 Nov 03 2026 19:43:56
%S A401704 12,24,40,45,48,56,80,90,96,112,120,135,160,176,180,192,208,224,240,
%T A401704 270,288,297,300,315,320,352,360,384,396,405,416,448,459,468,475,480,
%U A401704 528,540,544,594,608,612,621,630,637,640,672,675,704,720,736,768,810,819,828,832,864,891,896,918,928,931,945,950,960
%N A401704 Numbers k such that A401705(k) < A401707(k).
%C A401704 Numbers k such that algorithm B in Pollack & Pomerance "Prime-Perfect Numbers" paper does not return the largest unitary divisor d of n with gcd(d, sigma(d)) = 1 as its result.
%C A401704 Numbers k such that A401706(k) > A401708(k).
%H A401704 Antti Karttunen, <a href="/A401704/b401704.txt">Table of n, a(n) for n = 1..10000</a>
%H A401704 Paul Pollack and Carl Pomerance, <a href="http://www.integers-ejcnt.org/a14self/a14self.Abstract.html">Prime-Perfect Numbers</a>, INTEGERS, Electronic J. of Combinatorial Number Theory, Vol. 12a, Paper A14, 2012. (See page 6).
%H A401704 <a href="/index/Si#SIGMAN">Index entries for sequences related to sigma(n)</a>.
%o A401704 (PARI)
%o A401704 A401705(n) = { my(f=factor(n),d=1,u); forstep(i=#f~,1,-1,u = (f[i,1]^f[i,2])*d; if(1==gcd(sigma(u),u), d = u)); (d); };
%o A401704 A401707(n) = fordiv(n,d,if(1==gcd(d,n/d) && 1==gcd(n/d,sigma(n/d)), return(n/d)));
%o A401704 is_A401704(k) = (A401705(k)!=A401707(k));
%Y A401704 Cf. A000203, A014567, A401705, A401706, A401707, A401708.
%K A401704 nonn,new
%O A401704 1,1
%A A401704 _Antti Karttunen_, Nov 03 2026
