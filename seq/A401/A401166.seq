%S A401166 1,1,1,1,2,4,7,11,17,28,48,82,137,234,421,787,1479,2757,5127,9591,
%T A401166 18070,34129,64336,120878,226508,423643,790947,1473773,2740497,
%U A401166 5087895,9438771,17511395,32506682,60390560,112310177,209184954,390448991,730678864,1371238775,2580731932
%N A401166 Number of compositions of n in which the multiplicity of each part is divisible by that part.
%H A401166 Alois P. Heinz, <a href="/A401166/b401166.txt">Table of n, a(n) for n = 0..2000</a> (first 1001 terms from Vladeta Jovovic)
%F A401166 a(n) = Sum_{Sum_j j^2*r_j = n} (Sum_j j*r_j)! / Product_j (j*r_j)!, where the sum is over all partitions of n into squares and r_j is the multiplicity of j^2.
%e A401166 a(6) = 7, counting (1,1,1,1,1,1), (1,1,2,2), (1,2,1,2), (1,2,2,1), (2,1,1,2), (2,1,2,1) and (2,2,1,1).
%p A401166 b:= proc(n, i, p) option remember; `if`(n=0 or i=1, (p+n)!/n!, add(
%p A401166       b(n-i^2*j, min(n-i^2*j, i-1), p+i*j)/(i*j)!, j=0..n/i^2))
%p A401166     end:
%p A401166 a:= n-> b(n, isqrt(n), 0):
%p A401166 seq(a(n), n=0..39);  # _Alois P. Heinz_, Oct 16 2026
%Y A401166 Cf. A001156 (partition analog).
