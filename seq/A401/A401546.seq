%F A401546 a(n) = A059268(n-1) + 1 if n is a triangular number and a(n) = A059268(n-1) otherwise.
%o A401546 (Python)
%o A401546 from math import isqrt, comb
%o A401546 def A401546(n):
%o A401546     x = (1<<(m:=isqrt(n<<3)+1>>1))+(1<<(n-1-comb(m,2)))
%o A401546     return (x^((a:=-x&x+1)|(a>>1)))-x if x&1 else (((x&~(b:=x+(a:=x&-x)))>>a.bit_length())^b)-x
%o A401546 (Python)
%o A401546 from math import isqrt, comb
%o A401546 from sympy.ntheory.primetest import is_square
%o A401546 def A401546(n):
%o A401546     a = (m:=isqrt(k:=n<<1))-(k<=m*(m+1))
%o A401546     return (1<<n-1-comb(a+1,2))+is_square((n<<3)+1)
