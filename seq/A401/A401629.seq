%I A401629 #12 Oct 31 2026 12:21:27
%S A401629 1,2,30,3360,2910600,19978358400,1104908105901600,
%T A401629 498341680695226368000,1849759701880615980751296000,
%U A401629 56907487276416774524617471180800000,14593293299994018492201536301144180120000000,31338785818870851384589816712782683260588851200000000
%N A401629 a(n) = Product_{k=0..n} binomial(3*n - k, k).
%F A401629 For n > 0, a(n) = Gamma(3*n) * sqrt(BarnesG(3*n) * Gamma(n/2) / (BarnesG(n) * Gamma(3*n/2))) / (n * 2^(n/2) * BarnesG(2*n+1) * Gamma(n)^2).
%F A401629 a(n) ~ A * 3^(9*n^2/4 + 3*n/4 - 1/24) * exp(n/2 - 1/12) / (2^(2*n^2 + n/2 + 5/12) * n^(n/2 + 5/12) * Pi^((n+1)/2)), where A is the Glaisher-Kinkelin constant A074962.
%t A401629 Table[Product[Binomial[3*n-k, k], {k, 0, n}], {n, 0, 12}]
%t A401629 (* Alternative: *)
%t A401629 Join[{1}, Table[Gamma[3*n] * Sqrt[BarnesG[3*n] * Gamma[n/2] / (BarnesG[n] * Gamma[3*n/2])] / (n * 2^(n/2) * BarnesG[2*n+1] * Gamma[n]^2), {n, 1, 12}]]
%Y A401629 Cf. A073617, A296590, A401635, A268196.
%K A401629 nonn,new
%O A401629 0,2
