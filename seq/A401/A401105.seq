%U A401105 3940652,7330690,13672114,25563768,47899828,89933925,169221589,318932723,602209948,1138920048
%N A401105 Number of unordered representations of 2^n as a sum of two numbers, each an odd prime multiplied by a power of 2.
%C A401105 a(n) counts the unordered representations 2^n = p*2^k + q*2^k, where p and q are distinct odd primes and 1 <= k <= n-3.
%C A401105 The two exponents must be equal because, if they differed, dividing by the smaller power of 2 would give an odd integer equal to an even integer.
%C A401105 Questions: 1) Does every odd prime appear in at least one pair in this sequence?
%C A401105 2) How many different partners can a particular prime have?
%F A401105 a(n) = a(n-1) + A006307(n) for n > 2. - _Chai Wah Wu_, Oct 19 2026
%e A401105 a(5) = 5 because:
%e A401105 32 = 3 + 29,
%e A401105 32 = 2*3 + 2*13,
%e A401105 32 = 2^2*3 + 2^2*5,
%e A401105 32 = 2*5 + 2*11,
%e A401105 32 = 2*13 + 19.
%Y A401105 Cf. A038550, A401106, A006307.
%K A401105 nonn,more,new
%O A401105 0,5
