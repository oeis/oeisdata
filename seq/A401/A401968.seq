%I A401968 #13 Nov 18 2026 13:04:13
%S A401968 2,14,62,254,1022,4094,16382,9362,262142,1048574,4194302,16777214,
%T A401968 67108862,268435454,1073741822,4294967294,17179869182,68719476734,
%U A401968 274877906942,1099511627774,4398046511102,17592186044414,70368744177662,281474976710654,1125899906842622,4503599627370494
%N A401968 a(n) = denominator(r(n)), where r(n) = euler(2*n-3, 1)*(1-n)/(1-2^(2*n-1)) for n >= 2, r(1) = 1/2.
%C A401968 a(n) is not squarefree for n in {11, 32, 53, 74, 78, 95, 116, 127, ...}.
%H A401968 Carl Pomerance and Samuel S. Wagstaff Jr, <a href="https://arxiv.org/abs/2105.13252">The denominators of the Bernoulli numbers</a>, arXiv:2105.13252 [math.NT], 2021. Also in <a href="https://doi.org/10.4064/aa210601-16-11">Acta Arithmetica</a>, 209 (2023), 1-15.
%p A401968 a := n -> denom(ifelse(n=1, 1/2, euler(2*n-3, 1)*(1-n)/(1-2^(2*n-1)))):
%p A401968 seq(a(n), n = 1..26);
%t A401968 a[1]=2;a[n_]:=Denominator[EulerE[2n-3,1]*(1-n)/(1-2^(2n-1))];Array[a,26] (* _James C. McMahon_, Nov 18 2026 *)
%o A401968 (Python)
%o A401968 from fractions import Fraction as QQ
%o A401968 from sympy import euler
%o A401968 def r(n: int) -> QQ:
%o A401968     if n < 2: return QQ(1, n+1)
%o A401968     m = n // 2
%o A401968     return((-1)**m * m * euler(2*m - 1, 1) / (1 - 2**n))
%o A401968 a = lambda n: r(2*n - 1).denominator
%o A401968 print([a(n) for n in range(1, 27)])
%Y A401968 Odd bisection of A401970.
%K A401968 nonn,frac,new
%O A401968 1,1
%A A401968 _Peter Luschny_, Nov 15 2026
