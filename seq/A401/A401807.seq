%I A401807 #10 Nov 06 2026 08:32:08
%S A401807 2,2,9,4,1,1,5,7,0,1,5,5,6,0,2,6,3,9,6,0,8,7,8,4,8,6,5,1,8,2,8,0,8,6,
%T A401807 9,7,1,5,2,9,6,0,9,1,4,8,4,0,3,7,1,2,3,6,4,1,0,8,9,6,8,6,4,2,4,0,7,0,
%U A401807 7,8,9,6,0,9,7,9,6,7,1,1,1,7,2,3,5,0,0,9,6,0,3,6,1,1,2,9,4,4,5,8,3,6,6,1,7
%N A401807 Decimal expansion of Sum_{k>=1} 1/sqrt(k^3+1).
%C A401807 Computed by the Euler transformation of the alternating series over the Zeta-functions obtained by expanding the inverse square root in a Taylor series of 1/k.
%H A401807 Stackexchange, <a href="https://math.stackexchange.com/questions/2388587">What is Sum_{n=1}^oo 1/sqrt(n^3+1)</a> (2024)
%F A401807 Equals Sum_{k>=1} 1/sqrt( A001093(k) ).
%e A401807 2.29411570155602...
%p A401807 Digits :=30 :
%p A401807 # absolute value of m-th term of the alternating series
%p A401807 am := proc(m)
%p A401807     1/4^m*binomial(2*m,m)*Zeta(3*m+3/2) ;
%p A401807     evalf(%) ;
%p A401807 end proc:
%p A401807 # forward difference operator on the series terms
%p A401807 fdiff := proc(k)
%p A401807     add((-1)^m*binomial(k,m)*am(m), m=0..k) ;
%p A401807 end proc:
%p A401807 # start with partial sum zero and add Euler series terms
%p A401807 val :=0.0 ;
%p A401807 for k from 0 to 50 do
%p A401807     val := val+fdiff(k)/2^(k+1) ;
%p A401807     print(k,val) ;
%p A401807 end do:
%p A401807 #
%p A401807 # Alternative:
%p A401807 evalf(Sum(((-1)^k/4^k*binomial(2*k, k)*Zeta(3*k + 3/2)), k=0..infinity), 106); # _Vaclav Kotesovec_, Nov 06 2026
%o A401807 (PARI) default(realprecision, 200); sumalt(k=0, (-1)^k/4^k*binomial(2*k, k)*zeta(3*k + 3/2)) \\ _Vaclav Kotesovec_, Nov 06 2026
%Y A401807 Cf. A339606 (sum without square root).
%K A401807 nonn,cons,new
%O A401807 1,1
%A A401807 _R. J. Mathar_, Nov 06 2026
%E A401807 More terms from _Vaclav Kotesovec_, Nov 06 2026
