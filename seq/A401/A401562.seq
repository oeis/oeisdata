%T A401562 23505,29,59555,1285,158167,1,418947,1,1103369,8641,2930375,221,
%U A401562 7840751,1,20926471,59557,56171077,1,151422085,1,408324897,416809,1104985331,1,2997938971
%N A401562 G.f. A(x) satisfies: A(x) = x + A(A(x^2)) + A(A(x^3)) + A(A(x^4)) + ...
%F A401562 If p is prime, a(p) = 1.
%t A401562 nmax = 48; A[_] = 0; Do[A[x_] = x + Sum[A[A[x^k]], {k, 2, nmax}] + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A401562 (* Alternative: *)
%t A401562 nmax = 48; a = {0, 1}; T[n_, k_] /; k == 1 := a[[n + 1]]; T[n_, k_] /; k > n := 0; T[n_, k_] /; k == n := 1; T[n_, k_] /; 2 <= k <= n - 1 := T[n, k] = Sum[a[[j + 1]] T[n - j, k - 1], {j, 1, n - k + 1}]; Do[AppendTo[a, Sum[Sum[a[[m + 1]] T[d, m], {m, 1, d}], {d, Most[Divisors[n]]}]], {n, 2, nmax}]; a
%Y A401562 Cf. A030266, A074206.
%K A401562 nonn,new
