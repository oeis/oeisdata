%I A401592 #18 Nov 09 2026 13:32:52
%S A401592 -3,-6,-13,-12,9,-26,-175,-24,1187,18,-37,-52,-31,-350,-359,-48,-115,
%T A401592 2374,2309,36,57,-74,-81,-104,484621,-62,
%U A401592 -9524900602199285607458130661822164920919992357046007825331988413,-700,-673,-718
%N A401592 Numerator of the 2-adic rational xi(h(n)), where h is the parity-preserving conjugacy between the Collatz map T = A014682 and Monks' q-analog T_q(x) = x/q if x is even, ((1+q)*x+1)/q if x is odd, on F_2[[q]].
%C A401592 The denominators are in A401593.
%C A401592 xi reads a power series over F_2 as a 2-adic integer, the coefficient of q^i as the binary digit of 2^i. Monks (2025) lists xi(h(n)) for n = 1..20 in Table 1; h(1) = P1 = (1+q)/(1+q^3), xi(P1) = -3/7, a point of the 2-cycle of T_q.
%C A401592 Every h(n) is rational: with s = A006666(n), m = A006667(n), and the odd steps of the T-orbit of n at positions k_1 < ... < k_m, h(n) = (q^s*P1 + Sum_{o=1..m} q^(k_o)*(1+q)^(m-o))/(1+q)^m, the q-analog of 3^m*n = 2^s - Sum_{o=1..m} 2^(k_o)*3^(m-o) with 2 -> q, 3 -> 1+q (no signs in characteristic 2). So the coefficients of h(n) are eventually periodic, and A401593(n) divides 2^e - 1, e the period.
%H A401592 Ruud H.G. van Tol, <a href="/A401592/b401592.txt">Table of n, a(n) for n = 1..10000</a>
%H A401592 Kenneth G. Monks, <a href="https://arxiv.org/abs/2508.10153">On q-analogs of the 3x+1 Dynamical System</a>, J. Integer Sequences 28 (2025), Article 25.6.8 (Table 1); arXiv:2508.10153 [math.NT], 2025.
%H A401592 Ruud H.G. van Tol, <a href="https://github.com/druud/Collatz-but-stop-at-the-drop">Collatz, but stop at the drop</a>, Lean 4 formalization (modules TMonksDrop, TMonksXi).
%F A401592 a(2n) = 2*a(n).
%e A401592 a(1) = -3: h(1) = (1+q)/(1+q^3) = 1 + q + q^3 + q^4 + q^6 + q^7 + ..., so xi(h(1)) = 1 + 2 + 8 + 16 + 64 + 128 + ... = 3*(1 + 8 + 64 + ...) = 3/(1-8) = -3/7.
%o A401592 (PARI) xh(n) = { my(w=List(), s, m, o=0, r=0, h, D, e=1, C, p, c); while(n>1, listput(~w, n%2); n=if(n%2, 3*n+1, n)/2); s=#w; m=vecsum(Vec(w)); for(k=1, s, if(w[k], o++; r+=x^(k-1)*(1+x)^(m-o))); h=Mod(1, 2)*(x^s+(1+x+x^2)*r)/((1+x)^m*(1+x+x^2)); D=Mod(1, 2)*denominator(h); while(Mod(x, D)^e != 1, e++); C=numerator(h)*((x^e+1)/D); p = max(0, poldegree(C)+1-e); c=vector(p+e, i, polcoef(C, i-1)); for(i=e+1, p+e, c[i]+=c[i-e]); c = lift(c); sum(i=1, p, c[i]*2^(i-1)) + 2^p*sum(i=1, e, c[p+i]*2^(i-1))/(1-2^e)};
%o A401592 a(n) = numerator(xh(n));
%Y A401592 Cf. A006666, A006667, A014682, A389685 (the same for Monks' T_{1,1+q^2}, Table 2), A401593 (denominators).
%K A401592 frac,sign,new
%O A401592 1,1
%A A401592 _Ruud H.G. van Tol_, Oct 29 2026
