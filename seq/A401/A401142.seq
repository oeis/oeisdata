%S A401142 1,3,3,0,3,9,3,5,0,9,3,0,3,9,9,0,3,0,3,0,9,9,3,15,0,9,5,0,3,27,3,8,9,
%T A401142 9,9,0,3,9,9,15,3,27,3,0,0,9,3,0,0,0,9,0,3,15,9,15,9,9,3,0,3,9,0,0,9,
%U A401142 27,3,0,9,27,3,0,3,9,0,0,9,27,3,0,0,9,3,0,9,9,9
%N A401142 The number of ordered pairs of exponentially odd divisors (d_1, d_2) of n such that n is an exponentially odd divisor of d_1 * d_2.
%H A401142 Amiram Eldar, <a href="/A401142/b401142.txt">Table of n, a(n) for n = 1..10000</a>
%H A401142 Vaclav Kotesovec, <a href="/A401142/a401142.jpg">Graph - the asymptotic ratio (100000 terms)</a>
%F A401142 Multiplicative with a(p^e) = (e^2 + 4*e + 19)/8 if e is odd, and 0 if e is even.
%F A401142 a(n) = 0 if and only if n is not an exponentially odd number (i.e., in A072587, or, equivalently, not in A268335).
%F A401142 Dirichlet g.f.: zeta(2*s)^3 * Product_{p prime} (1 + 3/p^s - 3/p^(2*s) - 4/p^(3*s) + 3/p^(4*s) + 2/p^(5*s) - 1/p^(6*s)).
%F A401142 From _Vaclav Kotesovec_, Oct 16 2026: (Start)
%F A401142 Let f(s) = Product_{primes p} (3*p^(2*s) - 4*p^(3*s) - 3*p^(4*s) + 3*p^(5*s) + p^(6*s) + 2*p^s - 1) / ((p^s + 1)^3 * p^(3*s)).
%F A401142 Dirichlet g.f.: zeta(s)^3 * f(s).
%F A401142 Sum_{k=1..n} a(k) ~ n * (f(1)*log(n)^2/2 + log(n)*((3*gamma - 1)*f(1) + f'(1)) + f(1)*(1 - 3*gamma + 3*gamma^2 - 3*sg1) + (3*gamma - 1)*f'(1) + f''(1)/2), where
%F A401142 f(1) = Product_{primes p} (1 - (6*p^4 + 5*p^3 - 3*p^2 - 2*p + 1) / (p^3 * (p+1)^3)) = 0.188005082074522506618572854074297577174030184964325694336242413328839...,
%F A401142 f'(1) = f(1) * Sum_{primes p} (12*p^5 + 9*p^4 - 12*p^3 - 13*p^2 + 2*p + 3) * log(p) / (p^7 + 4*p^6 - 7*p^4 - p^3 + 5*p^2 + p - 1) = f(1) * 3.508890233225870366297374955911558556241620613370108547721671836136982...,
%F A401142 f''(1) = f'(1)^2/f(1) + f(1) * Sum_{primes p} -p*(24*p^11 + 75*p^10 + 24*p^9 - 125*p^8 - 172*p^7 - 26*p^6 + 116*p^5 + 64*p^4 - 28*p^3 - 22*p^2 + 4*p + 5) / (p^7 + 4*p^6 - 7*p^4 - p^3 + 5*p^2 + p - 1)^2 = f'(1)^2/f(1) + f(1) * (-11.0167829547216741248855078750754699992215232974646624379978115344268...),
%F A401142 gamma is the Euler-Mascheroni constant A001620 and sg1 is the first Stieltjes constant (see A082633). (End)
%t A401142 f[p_, e_] := If[OddQ[e], (e^2 + 4*e + 19)/8, 0]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 87]
%o A401142 (PARI) a(n) = vecprod(apply(e -> if(e % 2, (e^2+4*e+19)/8, 0), factor(n)[, 2]));
%Y A401142 Cf. A072587, A268335, A355837, A365345, A401083, A401086, A401087.
%K A401142 nonn,mult,easy,new
%O A401142 1,2
%A A401142 _Amiram Eldar_, Oct 16 2026
