%U A401428 12167,12811,12973,14641,16819,19183,19321,22091,24299,24863,25169,26179,27533,27841,29293
%N A401428 Numbers k such that the trajectory of k->ord(-10,k) reaches 1 before reaching a number not coprime to -10. Here ord(b,k) is the multiplicative order of b modulo k.
%C A401428 Closed under multiplication; see A400096 for details.
%H A401428 Jianing Song, <a href="/A401428/b401428.txt">Table of n, a(n) for n = 1..4530</a> (all terms <= 10^10)
%e A401428 Powers of 11 are terms: 11^n -> 11^(n-1) -> ... -> 11 -> 1;
%e A401428 139 is a term: 139 -> 23 -> 11 -> 1;
%e A401428 If p is any prime factor of (10^121 + 1)/(11*(10^11 + 1)), then p is a term: p -> 121 -> 11 -> 1.
%t A401428 (* okQ is defined at A400096 *)
%t A401428 Select[Range[30000], okQ[#, -10] &] (* _Paolo Xausa_, Nov 26 2026 *)
%o A401428 (PARI) isok(n, -10) \\ see A400096 for isok
%Y A401428 See A400096 for list of sequences in other bases.
%K A401428 nonn,new
%O A401428 1,2
