%T A401072 6,3,13,8,6,5,8,6,4,5,7,8,3,5,5,2,9,8,4,6,5,5,4,6,9,5,2,1,4,3,4,2,7,4,
%U A401072 7,3,7,5,4,6,6,4,6,11,9,12,7,8,3,9,13,9,4,8,10,8,9,6,11,8,12,11,9,8,13,7,14,5,13,10,9
%N A401072 a(n) is the count of numbers of the form k = p^2 * q * r, for which A276085(k) is a multiple of p, where r < q < p = A000040(n), with p, r, q distinct primes, and A276085 is fully additive with a(p) = p#/p.
%H A401072 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401072 a(n) = Sum_{i=1..inf} [A006530(A401231(i)) = A000040(n)], where [ ] is the Iverson bracket.
%F A401072 a(n) = Sum_{p=A000040(n), r < q < p, q and r primes} [(((2*(p#/p)/(q#/q))+1) * ((q#/q)/(r#/r))) == -1 (mod p)], where x# stands for A034386(x).
%F A401072 Thus, it is guaranteed that a(A000720(A401057(n))) > 0 for all n. [Plug two distinct q's of each A401057(.) as q and r in the above formula and then simplify]
%e A401072 19 is the 8th prime, so a(8) lists all numbers A401231 whose largest prime factor (A006530) is 19, and they are 7942 (19^2 * 11 * 2), 42959 (19^2 * 17 * 7), and 79781 (19^2 * 17 * 13), therefore a(8) = 3.
%o A401072 (PARI)
%o A401072 is_A401232(n) = if(1==n,1,my(f = factor(n),mp=f[#f~,1],pr=1,s=0,k=1); forprime(p=2,,if(f[k,1]==p, s += f[k,2]*pr; s %= mp; if(p==mp,return(!s)); k++); pr *= p; pr %= mp));
%o A401072 A401072(n) = { my(c=0, p = prime(n)); forprime(q=3,p-1,forprime(r=2,q-1,c += is_A401232(p^2 * q * r))); (c); };
%o A401072 (PARI)
%o A401072 A034386(n) = prod(i=1, primepi(n), prime(i));
%o A401072 A401072(n) = { my(c=0, p = prime(n)); forprime(q=2,p-1,forprime(r=2,q-1,if( (((((2*A034386(p)/p)/(A034386(q)/q))+1)*((A034386(q)/q)/(A034386(r)/r)))%p)==(p-1), c++))); (c); };
%Y A401072 Cf. A000040, A006530, A034386, A276085, A401057, A401232.
%Y A401072 Cf. A401231 (lists such numbers k in the ascending order of magnitude).
%Y A401072 Cf. also A401053, an analogous sequence for numbers of the form p^2*q. Note however the different indexing (offset) used.
%K A401072 nonn,new
%O A401072 1,6
