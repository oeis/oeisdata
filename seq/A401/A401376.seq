%I A401376 #11 Oct 30 2026 17:11:18
%S A401376 1,2,6,7,8,30,210,2310,2340,2556,30030,510510,9699690,9729720,
%T A401376 223092870,223093080,6469693230,6469695540
%N A401376 Numbers k such that A328572(k) is a divisor of k and A342002(k) is an unitary divisor of k.
%C A401376 Note that x = A276085(855523) = 559469993635709872356669612125495026320977730 mentioned in A380527 is also included as a term.
%H A401376 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%o A401376 (PARI)
%o A401376 A328572(n) = { my(m=1, p=2); while(n, if(n%p, m *= p^((n%p)-1)); n = n\p; p = nextprime(1+p)); (m); };
%o A401376 A342002(n) = { my(s=0, m=1, p=2, e); while(n, e = (n%p); m *= p^(e>0); s += (e/p); n = n\p; p = nextprime(1+p)); (s*m); };
%o A401376 is_A401376(n) = { my(t=A328572(n), w=A342002(n)); (!(n%t) && !(n%w) && 1==gcd(n/w,w)); };
%Y A401376 Cf. A328572, A342002.
%Y A401376 Subsequence of A380527, of A400155, and of A400835.
%K A401376 nonn,base,more,new
%O A401376 1,2
%A A401376 _Antti Karttunen_, Oct 30 2026
