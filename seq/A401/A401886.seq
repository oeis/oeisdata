%S A401886 0,1,1,2,2,3,3,4,5,6,6,7,7,8,8,9,9,10,10,11,11,12,12,13,14,15,16,17,
%T A401886 17,18,18,19,19,20,20,21,21,22,22,23,23,24,24,25,26,27,27,28,29,30,30,
%U A401886 31,31,32,32,33,33,34,34,35,35,36,37,38,38,39,39,40,40,41,41,42,42,43,44,45,45
%N A401886 Maximum size of a subset S of {1, ..., n} such that x*y is not squarefree for all x, y in S.
%C A401886 Number of positive integers k <= n that are even or not squarefree (Alexeev, Mixon and Sawin; also Weisenberg).
%H A401886 Seiichi Manyama, <a href="/A401886/b401886.txt">Table of n, a(n) for n = 1..10000</a>
%H A401886 Boris Alexeev, Dustin G. Mixon, and Will Sawin, <a href="https://arxiv.org/abs/2507.01928">The independence and clique cover numbers of the squarefree graph</a>, arXiv:2507.01928 [math.CO], 2025.
%H A401886 Thomas F. Bloom, <a href="https://www.erdosproblems.com/844">Erdős Problem 844</a>, Erdős Problems.
%F A401886 a(n) = n - #{1 <= k <= n : k is odd and squarefree}.
%o A401886 (PARI) a(n) = n-sum(k=1, (n+1)\2, issquarefree(2*k-1));
%Y A401886 Cf. A005117, A056911.
%K A401886 nonn,new
%O A401886 1,4
%A A401886 _Seiichi Manyama_, Nov 08 2026
