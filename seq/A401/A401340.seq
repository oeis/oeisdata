%I A401340 #20 Nov 15 2026 20:45:17
%S A401340 6,7,9,10,73,81,82,85,91,94,546,571,637,676,721,739,751,793,811,819,
%T A401340 853,871,898,946,961,969,975,991,6316,6625,7146,7225,7371,7462,7606,
%U A401340 7735,7801,7861,7896,7975,8164,8188,8281,8335,8671,8686,8697,8785,8854,9091,9166,9256,9285,9289
%N A401340 Primitive quotients in increasing order, obtained when a primitive term m of A401339 divides the number formed by inserting a 0 between each pair of consecutive digits of this term m.
%C A401340 That is the primitive part of the quotients sequence A343551, differences are: removing repeated values, terms in increasing order, 10 is the only term ending with 0.
%C A401340 This sequence proposes very large gaps between some successive terms, there is no primitive quotients between 94 and 546, nor between 991 and 6316.
%e A401340 A401339(3) = 18, then 108/18 = 6 and a(1) = 6.
%e A401340 A401339(7) = 45, then 405/45 = 9 and a(3) = 9.
%e A401340 A401339(8) = 50, then 500/50 = 10 and a(4) = 10.
%o A401340 (PARI) f(k) = my(d=digits(k)); fromdigits(vector(2*#d-1, i, if (i%2, d[i\2+1]))); \\ A051022
%o A401340 isoka(k) = if (k>=10, my(d=digits(k), kk = fromdigits(vector(2*#d-1, i, if (i%2, d[i\2+1])))); (kk % k) == 0); \\ A343550
%o A401340 isprimitive(k) = if (isoka(k), my(p=valuation(k, 10)); if (p, forstep(i=p, 1, -1, if (isoka(k/10^i), return(0)))); 1);
%o A401340 listap(nn) = my(list=List()); for (n=1, 10^(1+logint(nn, 10)), if (isprimitive(n), listput(list, f(n)/n););); vecsort(Vec(list),,8); \\ _Michel Marcus_, Nov 10 2026
%Y A401340 Cf. A343550, A343551, A401339, A401340.
%K A401340 nonn,base,new
%O A401340 1,1
%A A401340 _Bernard Schott_, Nov 07 2026
%E A401340 More terms from _Michel Marcus_, Nov 08 2026
