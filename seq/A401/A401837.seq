%I A401837 #19 Nov 16 2026 17:38:26
%S A401837 12,59,64,67,115,119,160,235,244,280,319,415,440,504,520,579,744,792,
%T A401837 835,952,960,1024,1260,1299,2260,2552,3247,3519,3652,3859,4120,4247,
%U A401837 4687,5260,5439,5967,6579,7104,7479,7660,8475,8944,8960,9464,10740,10759,11232
%N A401837 Numbers k such that two distinct integers can be removed from 1 through k so that the sum of their cubes equals the sum of the remaining integers.
%C A401837 Let T(k) = k*(k+1)/2.
%C A401837 The sequence consists of numbers k for which there exist distinct positive integers 1 <= a < b <= k satisfying a^3 + b^3 = T(k) - a - b.
%C A401837 Equivalently, a^3 + a + b^3 + b = T(k).
%C A401837 Since a^3+a and b^3+b are both even, T(k) must be even. Consequently, every term satisfies n == 0 or 3 (mod 4). This condition is necessary but not sufficient.
%H A401837 Pieter Post, <a href="/A401837/b401837.txt">Table of n, a(n) for n = 1..200</a>
%e A401837 For k=12, the numbers 2 and 4 can be removed, since 2^3 + 4^3 = 72 = 78 - 2 - 4.
%e A401837 For k=59, the numbers 3 and 12 can be removed, since 3^3 + 12^3 = 1755 = 1770 - 3 - 12.
%o A401837 (Python)
%o A401837 from math import isqrt
%o A401837 def cube_terms(N):
%o A401837     terms = set()
%o A401837     T = N*(N+1)//2
%o A401837     b = 2
%o A401837     while b**3 + b + 2 <= T:
%o A401837         for a in range(1, b):
%o A401837             s = a**3 + a + b**3 + b
%o A401837             if s > T:
%o A401837                 break
%o A401837             d = isqrt(8*s + 1)
%o A401837             if d*d == 8*s + 1:
%o A401837                 k = (d - 1)//2
%o A401837                 if b <= k <= N:
%o A401837                     terms.add(k)
%o A401837         b += 1
%o A401837     return sorted(terms)
%o A401837 print(cube_terms(12000))
%Y A401837 Cf. A000217, A401836, A401838.
%K A401837 nonn,new
%O A401837 1,1
