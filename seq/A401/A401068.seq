%N A401068 Numbers k such that A276085(k) is squarefree, where A276085 is fully additive with a(p) = p#/p.
%H A401068 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401068 {k such that A008966(A276085(k)) = 1}.
%o A401068 (PARI)
%o A401068 A276085(n) = { my(f = factor(n)); sum(k=1, #f~, f[k, 2]*prod(i=1,primepi(f[k, 1]-1),prime(i))); };
%o A401068 is_A401068(k) = issquarefree(A276085(k));
%Y A401068 Cf. A005117, A008966, A276085, A401069 (complement).
