%S A401673 1,2,1,36,126,105,12,1,6728,84132,413932,934213,1000638,491689,99554,
%T A401673 6638,36,1,12988816,381233080,4924514652,35167723972,151708056673,
%U A401673 414390443420,734997028142,854245466616,646928970205,312256068860,91859468926,15162565624,1195684186,32053424,363228,80,1
%N A401673 Triangle read by rows: T(n,k) is the number of domicule tilings of the 2n X 2n square with exactly 2k diagonal domicules, 0 <= k <= n^2.
%C A401673 A diagonal domicule joins two cells that share only a corner (see A239264). In a checkerboard coloring a domino covers one black and one white cell, while a diagonal domicule covers two cells of one color. The board has as many black cells as white ones, so as many diagonal domicules lie on black cells as on white cells, and their number is even.
%C A401673 Rows 0-6 come from a transfer matrix in exact integers that weights each diagonal domicule by x. Rows 7-10 come from the same transfer modulo primes. Each row sums to A239273(n) and starts with A004003(n).
%H A401673 Dawid Ryłko, <a href="/A401673/b401673.txt">Rows n = 0..10 of triangle, flattened</a>
%H A401673 Dawid Ryłko, <a href="https://dawidrylko.github.io/lattice-dimers/notes/diagonals.html">Diagonal pieces</a>.
%F A401673 T(n,0) = A004003(n).
%F A401673 Sum_{k=0..n^2} T(n,k) = A239273(n).
%F A401673 Conjecture: T(n,n^2) = 1 and T(n,n^2-1) = A011379(n) = n^2*(n+1); true for n <= 10.
%e A401673 Triangle begins:
%e A401673      1;
%e A401673      2,     1;
%e A401673     36,   126,    105,     12,       1;
%e A401673   6728, 84132, 413932, 934213, 1000638, 491689, 99554, 6638, 36, 1;
%e A401673   ...
%e A401673 T(1,1) = 1: the 2 X 2 square is covered by its two diagonal domicules, which cross.
%o A401673 (PARI) \\ P(h, w): the coefficient of x^j counts the tilings of an h X w board with j diagonal domicules.
%o A401673 P(h, w) = {my(S = 2^(w+2), v = vector(S), u); if(h*w == 0, return(1)); v[1] = 1; for(p = 0, h*w-1, my(r = p\w, c = p%w, d = [], e = []); if(c+1 < w, d = concat(d, 1); e = concat(e, 1)); if(r+1 < h, if(c > 0, d = concat(d, w-1); e = concat(e, x)); d = concat(d, w); e = concat(e, 1); if(c+1 < w, d = concat(d, w+1); e = concat(e, x))); u = vector(S); for(s = 0, S-1, my(y = v[s+1]); if(y, if(bitand(s, 1), u[(s>>1) + 1] += y, for(i = 1, #d, if(!bittest(s, d[i]), my(t = (s + 2^d[i])>>1); u[t+1] += e[i]*y))))); v = u); v[1]};
%o A401673 row(n) = my(q = P(2*n, 2*n)); vector(n^2+1, k, polcoef(q, 2*(k-1)));
%Y A401673 Column k=0 gives A004003.
%Y A401673 Row sums give A239273.
%Y A401673 Cf. A011379, A239264, A401669, A401670.
%K A401673 nonn,tabf,new
%O A401673 0,2
%A A401673 _Dawid Ryłko_, Nov 01 2026
