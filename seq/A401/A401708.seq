%S A401708 1,1,1,1,1,2,1,1,1,2,1,3,1,2,3,1,1,2,1,4,1,2,1,3,1,2,1,4,1,6,1,1,3,2,
%T A401708 1,1,1,2,1,5,1,2,1,4,5,2,1,3,1,1,3,4,1,2,1,7,1,2,1,12,1,2,1,1,1,6,1,4,
%U A401708 3,2,1,8,1,2,1,4,1,2,1,5,1,2,1,4,1,2,3,8,1,10,7,4,1,2,5,3,1,1,9,1,1,6,1,8,3
%N A401708 a(n) = n / A401707(n), where A401707(n) is the largest unitary divisor d of n with gcd(d, sigma(d)) = 1.
%H A401708 Antti Karttunen, <a href="/A401708/b401708.txt">Table of n, a(n) for n = 1..10000</a>
%H A401708 <a href="/index/Si#SIGMAN">Index entries for sequences related to sigma(n)</a>.
%o A401708 (PARI)
%o A401708 A401707(n) = fordiv(n,d,if(1==gcd(d,n/d) && 1==gcd(n/d,sigma(n/d)), return(n/d)));
%o A401708 A401708(n) = (n/A401707(n));
%Y A401708 Cf. A000203, A014567, A401704 (positions where differs from A401706),  A401707.
%K A401708 nonn,easy,new
%O A401708 1,6
%A A401708 _Antti Karttunen_, Nov 03 2026
