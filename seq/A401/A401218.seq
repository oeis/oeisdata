%T A401218 4,4,4,3,5,5,5,4,5,3,4,5,5,4,5,4,5,5,4,3,2,6,6,4,6,5,7,4,4,5,4,5,5,4,
%U A401218 6,5,4,6,5,5,4,6,4,5,3,4,6,5,6,3,4,5,4,4,5,6
%N A401218 Number of distinct primes in the Pratt primality certificate for the n-th prime.
%H A401218 Andrew Howroyd, <a href="/A401218/b401218.txt">Table of n, a(n) for n = 1..10000</a>
%H A401218 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/PrattCertificate.html">Pratt Certificate</a>.
%e A401218 a(9) = 4 because the Pratt primality certificate for prime(9) = 23 is:
%e A401218       23
%e A401218      /  \
%e A401218     2   11
%e A401218         / \
%e A401218        2   5
%e A401218           / \
%e A401218          2   2
%e A401218   which contains the 4 primes {2,5,11,23}.
%e A401218 a(1000) = 7 because the primality certificate for prime(1000) = 7919 contains the 7 primes {2, 3, 13, 37, 53, 107, 7919}. See the World of Mathematics link for the full certificate.
%o A401218 (PARI)
%o A401218 pset(p)=my(L=[p], P=Set(L), i=1); while(i<=#L, my(X=setminus(factor(L[i]-1)[,1]~, P)); if(#X, P=setunion(P,X); L=concat(L,X)); i++); P
%o A401218 a(n) = {#pset(prime(n))}
%Y A401218 Cf. A019434 gives primes which have 2 primes in their certificate.
%Y A401218 Cf. A037202, A130790, A366927, A401219.
%K A401218 nonn,new
%O A401218 1,2
%A A401218 _Andrew Howroyd_, Oct 19 2026
