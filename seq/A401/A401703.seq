%I A401703 #11 Nov 16 2026 12:48:53
%S A401703 3,5,7,19,23,41,59,107,113,163,167,197,211,233,347,349,383,409,449,
%T A401703 509,521,547,571,599,619,641,673,727,733,757,809,863,937,997,1061,
%U A401703 1109,1123,1217,1259,1327,1361,1423,1427,1429,1447,1451,1453,1459,1471,1499,1553,1579,1583,1607,1609,1663,1721,1801,1867,1877
%N A401703 Primes p for which there exists a noncomposite q <= p such that 3*(p# / q#) == -1 mod r, where p# = A034386(p), and r is the least prime larger than p.
%C A401703 See comments in A401063.
%H A401703 Antti Karttunen, <a href="/A401703/b401703.txt">Table of n, a(n) for n = 1..3800</a>
%H A401703 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401703 a(n) = A064989(A401063(n)).
%e A401703 3 is a term because 1 + 3*(3# / 2#) = 1+(3*3) = 10 = 2*5 is a multiple of 5, which is the next prime after 3.
%e A401703 5 is a term because 1 + 3*(5# / 1#) = 1 + 3*30 = 91 = 7*13 is a multiple of 7, which is the next prime after 5.
%o A401703 (PARI)
%o A401703 A034386(n) = prod(i=1, primepi(n), prime(i));
%o A401703 is_A401703(p) = if(!isprime(p), 0, my(prp=A034386(p), r=nextprime(1+p)); if((r-1)==((3*prp)%r), 1, forprime(q=2,p,if((r-1)==(((3*prp)/A034386(q))%r), return(1))); (0))); \\ (reference implementation, very inefficient)
%Y A401703 Cf. A000040, A002110, A034386, A064989, A401063.
%Y A401703 Cf. also A401700, A401701, A401702.
%K A401703 nonn,new
%O A401703 1,1
%A A401703 _Antti Karttunen_, Nov 16 2026
