%I A401034 #20 Oct 22 2026 00:12:07
%S A401034 1,3,5,5,5,5,5,7,9,11,13,15,17,17,17,17,17,17,17,17,17,19,21,23,25,27,
%T A401034 29,31,33,35,37,37,37,37,37,37,37,37,37,37,37,37,37,39,41,43,45,47,49,
%U A401034 51,53,55,57,59,61,63,65,65,65,65,65,65,65,65,65,65,65,65,65,65,65,65,65,67,69,71,73
%N A401034 a(n) = n + x + y where x and y are the coordinates of n in the square spiral.
%C A401034 Spiral begins:
%C A401034   17--16--15--14--13
%C A401034    |               |
%C A401034   18   5---4---3  12
%C A401034    |   |       |   |
%C A401034   19   6   1---2  11
%C A401034    |   |           |
%C A401034   20   7---8---9--10
%C A401034    |
%C A401034   21--22--23--24--25--...
%H A401034 Jens Ahlström, <a href="/A401034/b401034.txt">Table of n, a(n) for n = 1..10000</a>
%F A401034 a(n) = n + A180714(n-1) = n + A174344(n) + A274923(n), for n>0.
%e A401034 The first point where n=1 has x=0 and y=0, so a(1) = 1+0+0 = 1.
%o A401034 (Python)
%o A401034 import math
%o A401034 def y(n):
%o A401034     n -= 1
%o A401034     m = math.isqrt(n)
%o A401034     k = math.ceil(m/2)
%o A401034     n -= 4*k*k
%o A401034     if n < 0: return 3*k+n if n < -m else k
%o A401034     return k-n if n < m else -k
%o A401034 def x(n):
%o A401034     n -= 1
%o A401034     m = math.isqrt(n)
%o A401034     k = math.ceil(m/2)
%o A401034     n -= 4*k*k
%o A401034     if n < 0: return k if n < -m else -k-n
%o A401034     return -k if n < m else n-3*k
%o A401034 def a(n):
%o A401034     return x(n) + y(n) + n
%Y A401034 Cf. A174344, A180714, A214526, A274923, A336336, A391618, A399250, A399251.
%K A401034 nonn,easy,new
%O A401034 1,2
