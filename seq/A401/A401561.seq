%U A401561 216011201674807,2331424617510289,25868977631264527,294792832241481809,3446994672271515419
%N A401561 G.f. A(x) satisfies: A(x) = x + x * A(A(x)) / (1 - x).
%t A401561 nmax = 23; A[_] = 0; Do[A[x_] = x + x A[A[x]]/(1 - x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A401561 (* Alternative: *)
%t A401561 nmax = 23; a = {0, 1, 1}; T[n_, k_] /; k == 1 := a[[n + 1]]; T[n_, k_] /; k > n := 0; T[n_, k_] /; k == n := 1; T[n_, k_] /; 2 <= k <= n - 1 := T[n, k] = Sum[a[[j + 1]] T[n - j, k - 1], {j, 1, n - k + 1}]; Do[AppendTo[a, 2 a[[-1]] + Sum[a[[k + 1]] T[n - 1, k], {k, 2, n - 1}]], {n, 3, nmax}]; a
%Y A401561 Cf. A011782, A030266, A090345, A213591.
