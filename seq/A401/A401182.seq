%I A401182 #11 Oct 17 2026 20:59:59
%S A401182 1,1,1,1,2,1,4,12,9,1,38,152,144,28,1,728,3640,4140,1120,75,1,26704,
%T A401182 160224,214200,74200,7200,186,1,1866256,13063792,20264832,8598520,
%U A401182 1093050,41664,441,1,251548592,2012388736,3580049088,1805420288,284415600,14335888,225792,1016,1
%N A401182 Triangle read by rows: T(n,k) is the total number of k-cliques in all simple connected labeled graphs on n vertices.
%C A401182 T(0,0) = 1 by convention for consistency with A001187. However, there is also an opinion that the null graph should not be considered connected (or disconnected).
%H A401182 Andrew Howroyd, <a href="/A401182/b401182.txt">Table of n, a(n) for n = 0..1325</a> (rows 0..50)
%H A401182 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Clique.html">Clique</a>.
%F A401182 E.g.f. of column k > 0: B(x)/C(x) where B(x) is the e.g.f. of column k of A277219 and C(x) is the e.g.f. of A006125.
%e A401182 Triangle begins:
%e A401182         1;
%e A401182         1,        1;
%e A401182         1,        2,        1;
%e A401182         4,       12,        9,       1;
%e A401182        38,      152,      144,      28,       1;
%e A401182       728,     3640,     4140,    1120,      75,     1;
%e A401182     26704,   160224,   214200,   74200,    7200,   186,   1;
%e A401182   1866256, 13063792, 20264832, 8598520, 1093050, 41664, 441, 1;
%e A401182   ...
%o A401182 (PARI)
%o A401182 G(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k/2^(k*(k-1)/2), O(x^n)))}
%o A401182 U(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k*2^(k*(k-1)/2), O(x^n)))}
%o A401182 T(n)={my(g=U(exp(x+O(x*x^n)))); [Vecrev(p) | p<-Vec(serlaplace(U(G(exp(x*y+O(x*x^n))-1)*G(g))/g + log(g) + 1))]}
%o A401182 { my(A=T(7)); for(i=1, #A, print(A[i])) }
%Y A401182 Row sums are A401180.
%Y A401182 Columns k=0..3 are A001187, A053549, A094594, A401181.
%Y A401182 Subdiagonal is A058877(n) for n >= 2.
%Y A401182 Cf. A006125, A277219 (not necessarily connected).
%K A401182 nonn,tabl,new
%O A401182 0,5
%A A401182 _Andrew Howroyd_, Oct 17 2026
