%T A401116 924,10332,24710,19796,4806,242,1,3432,45276,138012,160454,71892,
%U A401116 10406,338,1,12870,195624,725340,1114428,758214,211508,19942,450,1,48620,836550,3655080,7008540,6506172,2856326,533364,34950,578,1
%N A401116 Array read by anti-diagonals: T(n,k) = [x^n] cosh((2*k+1)*arctanh(2*sqrt(x))).
%F A401116 G.f. for column k: (1/2) * ((1 + 2*sqrt(x))^(2*k+1) + (1 - 2*sqrt(x))^(2*k+1)) / (1 - 4*x)^(k + 1/2).
%F A401116 G.f. for column k: hypergeom([-(2*k+1)/2, (2*k+1)/2], [1/2], 4*x/(4*x-1)).
%F A401116 T(n,k) = 2*(2*n-1)*Q(n,k)*T(n-1,k)/(n*Q(n-1,k)) for n >= 1, k >= 0, T(0,k) = 1, where Q(n,k) = (Sum_{j=0..k} binomial(2*k+1, 2*j)*binomial(n-j+k-1/2, n-j)) / binomial(n-1/2, n).
%F A401116 T(n,k) = binomial(2*n, n) * Q(n,k) with Q(n,k) as above.
%e A401116 The array T(n,k) (with n >= 0, k >= 0) begins:
%e A401116          k = 0    k = 1    k = 2    k = 3    k = 4    k = 5
%e A401116   n = 0:     1,       1,       1,       1,       1,       1
%e A401116   n = 1:     2,      18,      50,      98,     162,     242
%e A401116   n = 2:     6,     102,     550,    1862,    4806,   10406
%e A401116   n = 3:    20,     500,    4020,   19796,   71892,  211588
%e A401116   n = 4:    70,    2310,   24710,  160454,  758214, 2856326
%p A401116 T := proc (n, k) local x, G, S: G := (1/2)*((1+2*sqrt(x))^(2*k+1)+(1-2*sqrt(x))^(2*k+1))/(1-4*x)^(k+1/2): S := series(G, x = 0, n+1): return coeff(S, x, n) end proc; out_list := 1: max_diag := 10; for d from 0 to max_diag do for k from 0 to d+1 do n := d-k+1: out_list := [op(out_list), T(n, k)] end do end do: StringTools:-Join(map(convert, out_list, string), ", ");
%Y A401116 Columns k=0..4 are A000984, A285043, A285044, A285045, A285046.
