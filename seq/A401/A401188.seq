%S A401188 1,2,8,24,105,120,210,840,7560,10296,45045,51480,83160,90090,96525,
%T A401188 135135,193050,237405,270270,360360,474810,772200,1081080,1899240,
%U A401188 17093160,101846745,121605624,188024760,203693490,305540235,608028120,611080470,814773960,1140052725
%N A401188 Numbers k that divide A400874(k).
%C A401188 The corresponding quotients A400874(k)/k are 1, 2, 3, 5, 3, 7, 6, 9, 11, 5, 3, 7, 13, 6, 3, 5, 6, 3, 10, 9, 6, 9, 15, 9, 11, ... .
%C A401188 Analogous to infinitary multiperfect numbers (A007358), with the sum of infinitary divisors of the infinitary divisors (A400874) instead of the sum of infinitary divisors (A049417).
%C A401188 If k and m are coprime terms, then k*m is also a term, since A400874(n)/n is multiplicative.
%C A401188 In particular, if k is an odd term, then 2*k and 8*k are also terms.
%t A401188 f[p_, e_] := p^(2^(-1 + Position[Reverse@IntegerDigits[e, 2], _?(# == 1 &)])); q[k_] := Divisible[Times @@ (Flatten@(f @@@ FactorInteger[k]) + 2), k]; q[1] = True; Select[Range[500000], q]
%o A401188 (PARI) isok(k) = {my(f = factor(k), b); !(prod(i = 1, #f~, b = binary(f[i, 2]); prod(j = 1, #b, if(b[j], 2 + f[i, 1]^(2^(#b-j)), 1))) % k);}
%Y A401188 Cf. A007358, A049417, A400874.
%Y A401188 Analogous sequences: A068978 (with all the divisors), A054862 (unitary), A401189 (exponential).
%K A401188 nonn,new
%O A401188 1,2
%A A401188 _Amiram Eldar_, Oct 17 2026
