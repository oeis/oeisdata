%I A401097 #9 Oct 17 2026 12:29:55
%S A401097 1,5,40,614,19128,1228368,162121232,43553559472,23590068178688,
%T A401097 25581375394340224,55304762287795689216,237848856357358963164672,
%U A401097 2033211179607681753424055296,34545898998684765927014002740224,1167130851873465444946943380884606976,78454118855819138599239974833550217795584
%N A401097 Total number of (non-null) connected induced subgraphs in all labeled graphs on n vertices.
%H A401097 Andrew Howroyd, <a href="/A401097/b401097.txt">Table of n, a(n) for n = 1..50</a>
%H A401097 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Vertex-InducedSubgraph.html">Vertex-Induced Subgraph</a>.
%o A401097 (PARI)
%o A401097 G(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k/2^(k*(k-1)/2), O(x^n)))}
%o A401097 U(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k*2^(k*(k-1)/2), O(x^n)))}
%o A401097 seq(n)={my(g=U(exp(x+O(x*x^n)))); Vec(serlaplace(U(G(log(g))*G(g))))}
%Y A401097 Cf. A401091 (in trees), A401098 (in connected graphs).
%K A401097 nonn,new
%O A401097 1,2
%A A401097 _Andrew Howroyd_, Oct 16 2026
