%S A401670 1,24,17552,1393836408,10460530355843328,7259829482503772231361024,
%T A401670 464778919849879305868191391185324176,
%U A401670 2743949253453878323721620757393919402021091285528,1493818604384654177402428232647033968399591852459255168583663616
%N A401670 Number of domicule tilings of a 2n X 2n toroidal grid.
%C A401670 For n > 1, a(n) is the number of perfect matchings of the strong product C_2n X C_2n, which is the king's graph on the 2n X 2n torus. For n = 1 the torus has multiple edges, and each of them counts as a separate piece, as in A335586.
%C A401670 Terms a(0)-a(6) agree between two transfer-matrix programs, one by rows in exact integers and one by cells modulo primes. Only the modular program computed a(7) and a(8). It checks them with one more prime than the Chinese remainder theorem needs.
%H A401670 Dawid Ryłko, <a href="https://dawidrylko.github.io/lattice-dimers/notes/tori.html">Tori and cylinders</a>.
%F A401670 a(n) = trace(M_{2n}^(2n)), where M_w is the row transfer matrix of domicule tilings of the cylinder of circumference w (see PARI program).
%F A401670 Conjecture: a(n) ~ 2*exp(4*s*n^2), where s = A401669; log(a(8)/2)/256 - s = 4.5*10^-10.
%e A401670 a(1) = 24: on the 2 X 2 torus each cell is joined to its row neighbor by 2 edges, to its column neighbor by 2 edges and to the diagonal cell by 4 edges, so a(1) = 2*2 + 2*2 + 4*4 = 24.
%o A401670 (PARI) \\ M(w): row transfer matrix of the cylinder of circumference w; a torus count is a trace.
%o A401670 R(w, c, f, t) = {my(v = []); if(c == w, return([t])); if(bittest(f, c), return(R(w, c+1, f, t))); if(c+1 < w && !bittest(f, c+1), v = concat(v, R(w, c+2, f + 2^c + 2^(c+1), t))); if(c == 0 && !bittest(f, w-1), v = concat(v, R(w, 1, f + 1 + 2^(w-1), t))); for(d = -1, 1, my(j = (c+d) % w); if(!bittest(t, j), v = concat(v, R(w, c+1, f + 2^c, t + 2^j)))); v};
%o A401670 M(w) = {my(A = matrix(2^w, 2^w)); for(f = 0, 2^w-1, my(v = R(w, 0, f, 0)); for(i = 1, #v, A[f+1, v[i]+1]++)); A};
%o A401670 a(n) = trace(M(2*n)^(2*n));
%Y A401670 Cf. A239264, A239273, A401669.
%Y A401670 Cf. A335586 (domino tilings of the 2n X 2n torus).
%K A401670 nonn,more,new
%O A401670 0,2
%A A401670 _Dawid Ryłko_, Nov 01 2026
