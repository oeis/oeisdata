%U A401842 0,0,0,0,4,0,4,4,0,0,2,8,0,10,10,4,0,0
%N A401842 Span of the n-th maximal cluster of primes with consecutive gaps at most 4.
%C A401842 The initial span a(1)=21 is the unique maximum since every later cluster has span at most 16 (A399292). Later spans are even.
%C A401842 For primes greater than 5, removing multiples of 2, 3 and 5 leaves components with gaps at most 4 of span at most 16.
%H A401842 Jwalin Bhatt, <a href="/A401842/b401842.txt">Table of n, a(n) for n = 1..10000</a>
%e A401842 The first cluster is {2,3,5,7,11,13,17,19,23} and has span 23-2=21, so a(1)=21. The next two clusters are {29,31} and {37,41,43,47}, giving a(2)=2 and a(3)=10. The fourth cluster is {53}, so a(4)=0.
%e A401842 The ninth cluster is {97,101,103,107,109,113} and has span 16, attaining the bound for later clusters.
%t A401842 s={};p1=2;Do[p=p1;While[NextPrime[p]-p<=4,p=NextPrime[p]];AppendTo[s,p-p1];p1=NextPrime[p],{i,84}];s (* _James C. McMahon_, Nov 09 2026 *)
%o A401842 (Python)
%o A401842 from sympy import nextprime
%o A401842 from itertools import islice
%o A401842 def gen_A401842():
%o A401842     start = p = 2
%o A401842     while True:
%o A401842         q = int(nextprime(p))
%o A401842         if q - p > 4:
%o A401842             yield p - start
%o A401842             start = q
%o A401842         p = q
%o A401842 print(list(islice(gen_A401842(), 84)))
