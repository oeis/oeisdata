%S A401643 1,4,1,36,1,8,9,20,1,24,1,28,15,16,1,36,1,40,21,44,1,48,25,52,27,56,1,
%T A401643 60,1,32,33,68,35,72,1,76,39,80,1,84,1,88,45,92,1,96,49,100,51,104,1,
%U A401643 108,55,112,57,116,1,120,1,124,63,64,65,132,1,136,69,140,1
%N A401643 a(n) is the largest positive integer k such that 1/k of the area of a regular n-gon is a signed sum of areas of distinct cells formed by drawing all its diagonals.
%C A401643 Allowing arbitrary integer coefficients instead of {-1, 0, 1} does not change a(n).
%C A401643 It is open whether 1/a(n) of the polygon's area can always be obtained as a union of cells (coefficients in {0, 1}).
%H A401643 Felix Huber, <a href="/A401643/b401643.txt">Table of n, a(n) for n = 3..10000</a>.
%H A401643 Felix Huber, <a href="https://doi.org/10.5281/zenodo.23841077">The Area Lattice of a Regular Polygon: Rational Fractions and Signed Cell Decompositions</a>, Zenodo, Oct 31 2026.
%H A401643 Felix Huber, <a href="/A401643/a401643.pdf">Positive and signed decompositions of the regular nonagon</a>.
%H A401643 Shoichi Inoue and Keiichi Watanabe, <a href="https://arxiv.org/abs/2610.22970">Rational Area Profiles of Regular Polygons Cut by Two Congruent Diagonals</a>, arXiv:2610.22970 [math.MG], 2026.
%F A401643 a(n) = 1 if n is prime; 36 if n = 6; n if n is odd and composite or a power of 2; 2*n otherwise.
%e A401643 For n = 6, a(6) = 36, since an elementary cell has area 1/36 of the hexagon's area.
%e A401643 For n = 9, a(9) = 9. The linked illustration shows two realizations of 1/9 of the polygon's area: a union of 18 distinct cells and a signed difference of two chord-bounded triangles.
%p A401643 A401643 := n -> `if`(isprime(n), 1, `if`(n = 6, 36, `if`(irem(n, 2) = 1 or type(n, 'primepower'), n, 2*n))):
%p A401643 seq(A401643(n), n = 3 .. 71);
%o A401643 (Python)
%o A401643 from sympy import isprime
%o A401643 def A401643(n):
%o A401643     if isprime(n):
%o A401643         return 1
%o A401643     if n == 6:
%o A401643         return 36
%o A401643     return n if n % 2 or (n & (n - 1)) == 0 else 2*n
%o A401643 print([A401643(n) for n in range(3, 72)])
%Y A401643 Cf. A000040, A000079, A006533, A007678.
%K A401643 nonn,easy,new
