%I A401326 #9 Oct 28 2026 10:14:31
%S A401326 1,5,60,650,7100,77500,846000,9235000,100810000,1100450000,
%T A401326 12012600000,131130500000,1431431000000,15625615000000,
%U A401326 170570460000000,1861960750000000,20325312100000000,221872728500000000,2421980406000000000,26438531345000000000,288605117510000000000
%N A401326 a(n) = 10*a(n-1) + 10*a(n-2), with a(0)=1 and a(1)=5.
%C A401326 Lucas-type companion to A057093, halved to remove the common factor 2. The case n = 5 corresponds to the Decimal golden ratio delta_5 = 5 + sqrt(35), distinguished in Rajput (2026) as the unique member of the family with floor(delta_5) = 10 (Section 10).
%H A401326 Paolo Xausa, <a href="/A401326/b401326.txt">Table of n, a(n) for n = 0..963</a>
%H A401326 Chetansing Rajput, <a href="https://doi.org/10.51846/jnhm.v2i2.5488">Deca-metallic ratios: a base-10 analogue of metallic means with their geometric origin in primitive Pythagorean triples</a>, J. New Horiz. Math., 2026.
%H A401326 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (10,10).
%F A401326 a(n) = 10*a(n-1) + 10*a(n-2) for n > 1, with a(0)=1 and a(1)=5.
%F A401326 a(n) = ((5+sqrt(35))^n + (5-sqrt(35))^n)/2.
%F A401326 G.f.: (1 - 5*x)/(1 - 10*x - 10*x^2).
%F A401326 E.g.f.: exp(5*x)*cosh(sqrt(35)*x).
%t A401326 LinearRecurrence[{10, 10}, {1, 5}, 25] (* _Paolo Xausa_, Oct 28 2026 *)
%o A401326 (Python)
%o A401326 a, b = 1, 5
%o A401326 for n in range(25):
%o A401326     print(a, end=", ")
%o A401326     a, b = b, 10*b + 10*a
%Y A401326 Cf. A057093, A400851, A399405, A399776.
%K A401326 nonn,easy,new
%O A401326 0,2
%A A401326 _Chetansing Rajput_, Oct 20 2026
