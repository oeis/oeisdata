%S A401425 1,2,3,1,5,6,7,8,1,10,11,3,13,14,15,1,17,2,19,5,21,22,23,24,1,26,27,7,
%T A401425 29,30,31,2,33,34,35,1,37,38,39,40,41,42,43,11,5,46,47,3,1,2,51,13,53,
%U A401425 54,55,56,57,58,59,15,61,62,7,1,65,66,67,17,69,70,71,8
%N A401425 The largest infinitary divisor of n whose number of divisors is a power of 2.
%C A401425 First differs from A350389 at n = 32.
%C A401425 The number of these divisors is A392628(n), and their sum is A401426(n).
%H A401425 Amiram Eldar, <a href="/A401425/b401425.txt">Table of n, a(n) for n = 1..10000</a>
%F A401425 Multiplicative with a(p^e) = p^(2^A007814(e+1)-1).
%F A401425 a(n) = 1 if and only if n is a square.
%F A401425 a(n) = n if and only if n is in A036537.
%F A401425 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = Product_{p prime} f(1/p) = 0.72461031194354595356..., where f(x) = (1-x) * (1 + Sum_{k>=1} x^(2*k - 2^A007814(k+1) + 1)).
%t A401425 f[p_, e_] := p^(2^IntegerExponent[e+1, 2] - 1); a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 72]
%o A401425 (PARI) a(n) = vecprod([f[1]^((1 << valuation(f[2]+1, 2)) - 1) | f<-factor(n)~]);
%Y A401425 Cf. A007814, A036537, A350389, A372379, A392628, A401426.
%K A401425 nonn,mult,easy,new
%O A401425 1,2
%A A401425 _Amiram Eldar_, Oct 24 2026
