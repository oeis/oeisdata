%S A401042 1,1,1,3,2,1,3,2,1,6,8,3,1,6,8,3,1,10,20,15,4,1,10,20,15,4,1,11,23,18,
%T A401042 5,1,11,23,18,5,1,16,44,51,28,6,1,16,44,51,28,6,1,22,75,115,94,40,7,1,
%U A401042 22,75,115,94,40,7,1,23,80,125,104,45,8,1,23,80,125,104,45,8,1,30,124,240,264,170,60,9
%N A401042 Irregular triangle read by rows: T(n,i) is the i-th Betti number of K[x_1,...,x_r]/I_n over K[x_1,...,x_r], where r = pi(n) and I_n is the ideal generated by the monomials x_1^e_1*...*x_r^e_r with prime(1)^e_1*...*prime(r)^e_r > n; n >= 2, 0 <= i <= pi(n).
%C A401042 K[x_1..x_r]/I_n is the truncation to [1,n] of the ring of arithmetic functions under Dirichlet convolution (Snellman 2000); so T(n,i) are its Betti numbers, the same over any field K of characteristic 0.
%C A401042 I_n is stable after reversing the order of the variables, so the Eliahou-Kervaire resolution is minimal; with Theorem 4 of arXiv:2608.29555 this gives the formula below.
%C A401042 T(n,1) = number of minimal generators.
%C A401042 T(n,pi(n)) = Cohen-Macaulay type = ceiling(n/2) (Corollary 29).
%H A401042 Jan Snellman, <a href="/A401042/b401042.txt">Table of n, a(n) for n = 2..9997</a>
%H A401042 Jan Snellman, <a href="https://doi.org/10.4310/hha.2000.v2.n1.a2">Truncations of the ring of number-theoretic functions</a>, Homology Homotopy Appl. 2 (2000), 17-27; arXiv:math/9904143 [math.AC], 1999.
%H A401042 Jan Snellman, <a href="https://arxiv.org/abs/2608.29555">Truncations of the ring of number-theoretic functions, revisited</a>, arXiv:2608.29555 [math.AC], 2026.
%F A401042 T(n,0) = 1; T(n,i) = Sum_{k=1..pi(n)} A401040(n,k)*binomial(pi(n)-k, i-1) for 1 <= i <= pi(n).
%F A401042 T(n,1) = A182843(n+1); T(n,pi(n)) = ceiling(n/2).
%F A401042 Sum_{i=0..pi(n)} (-1)^i*T(n,i) = 0.
%F A401042 Sum_{i=0..pi(n)} T(n,i) = A401043(n).
%F A401042 T(2*m,i) = T(2*m-1,i) for m >= 2.
%e A401042 Triangle begins:
%e A401042   n=2:  1, 1;
%e A401042   n=3:  1, 3, 2;
%e A401042   n=4:  1, 3, 2;
%e A401042   n=5:  1, 6, 8, 3;
%e A401042   n=6:  1, 6, 8, 3;
%e A401042   n=7:  1, 10, 20, 15, 4;
%e A401042   ...
%e A401042 For n=5: I_5 = (x_1^3, x_1*x_2, x_1*x_3, x_2^2, x_2*x_3, x_3^2), with resolution 1 <- 6 <- 8 <- 3.
%o A401042 (SageMath)
%o A401042 def T(n, i):
%o A401042     r = prime_pi(n)
%o A401042     if i == 0: return 1
%o A401042     phi = lambda k: len([m for m in range(1, n + 1) if all(m % p for p in prime_range(nth_prime(k) + 1))])
%o A401042     return sum(phi(k) * binomial(r - k, i - 1) for k in range(1, r + 1))
%o A401042 print([T(n, i) for n in range(2, 25) for i in range(prime_pi(n) + 1)])
%Y A401042 Row sums: A401043. Cf. A000720, A110654, A182843, A401040, A401041.
%K A401042 nonn,tabf,new
%O A401042 2,4
%A A401042 _Jan Snellman_, Oct 15 2026
