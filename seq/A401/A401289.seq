%I A401289 #7 Oct 26 2026 20:42:56
%S A401289 1,8,27,44,80,135,224,495,944,1215,2024,3968,4095,5264,7424,21735,
%T A401289 50624,76544,126224,165375,1245375,1763775,1890944,3578175,4096575,
%U A401289 5694975,7316000,8555624
%N A401289 Numbers k such that min(A001055(k), A001055(k+1)) is larger than the corresponding values of all previous numbers.
%C A401289 Also: Numbers k such that min(A028422(k), A028422(k+1)) is larger than the corresponding values of all previous numbers.
%e A401289 224 is in this sequence because A001055(224) = 19, and A001055(225) = 9, so min(A001055(224), A001055(225)) = 9, and there is no number between 1 and 223 where min(A001055(k), A001055(k+1)) is bigger than or equals to 9.
%o A401289 (PARI)
%o A401289 A001055(n) = { my(f = factor(max(n, 2))[, 2], var(n) = eval(Str("x"n)),
%o A401289     o = prod(i=1, #f, 1/(1-var(i))+O(var(i)^(f[i]+1)))-1,
%o A401289     s(p, f, n) = for(i=1, #f, my(v=var(i)); p=subst(p+O(v^(1+f[i]\n)), v, v^n)); p,
%o A401289     p = exp(sum(i=1, vecmax(f), s(o, f, i)/i)));
%o A401289   for(i=1, #f, p=polcoef(p, f[i], var(i))); p }
%o A401289 print1(r=1); for(n=2, 1e6, if(min(A001055(n), A001055(n+1))>r, r=min(A001055(n), A001055(n+1)); print1(", "n)))
%Y A401289 Cf. A001055.
%K A401289 nonn,more,new
%O A401289 1,2
%A A401289 _Zhicheng Wei_, Oct 19 2026
