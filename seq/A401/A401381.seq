%N A401381 Numbers k such that {the largest divisor of sigma(k) coprime with k} is a prime power > 1, where sigma is the sum of divisors function.
%H A401381 Antti Karttunen, <a href="/A401381/b401381.txt">Table of n, a(n) for n = 1..10000</a>
%F A401381 {k such that A401375(k) > 1 and A010055(A401375(k)) = 1}.
%o A401381 (PARI) is_A401381(n) = { my(s=sigma(n)); fordiv(s,d,if(1==gcd(s/d,n), return(!!isprimepower(s/d)))); };
