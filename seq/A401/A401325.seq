%S A401325 21,27,39,55,63,65,85,105,111,119,125,147,171,189,203,205,207,225,253,
%T A401325 275,297,315,319,351,365,377,399,407,429,441,465,495,533,539,555,583,
%U A401325 595,629,675,685,697,729,741,779,783,833,855,903,915,935,945,987,1007,1029,1081,1105,1127,1157,1197
%N A401325 Numbers of the form (2*x + 1)*(2^y + 4*x + 1) with x,y > 0.
%C A401325 The number of such composites up to N is asymptotically W(N) ~ (sqrt(N) * log_2(N)) / (4*sqrt(2)).
%t A401325 Select[Union[Flatten[Table[(2*x + 1)*(2^k + 4*x + 1), {x, 1, 150}, {k, 1, 150}]]], # <= 1500 &]
%o A401325 (Python)
%o A401325 def generate_weak_composites(limit):
%o A401325     s = set()
%o A401325     x = 1
%o A401325     while True:
%o A401325         Q = 2 * x + 1
%o A401325         n_k1 = Q * (2**1 + 4*x + 1)
%o A401325         if n_k1 > limit:
%o A401325             break
%o A401325         k = 1
%o A401325         while True:
%o A401325             n = Q * (2**k + 4*x + 1)
%o A401325             if n <= limit:
%o A401325                 s.add(n)
%o A401325                 k += 1
%o A401325             else:
%o A401325                 break
%o A401325         x += 1
%o A401325     return sorted(list(s))
%o A401325 print(generate_weak_composites(1500))
%Y A401325 Cf. A000217, A000225.
%K A401325 nonn,easy,new
%O A401325 1,1
