%U A401677 37732935799163520,1182839105309184000,39215218750078337280,1371008132047026040320,50412373303272870652416
%N A401677 a(0) = 1; a(n) = Sum_{k=1..n} 2^(k-1) * binomial(n+k,k) * a(n-k).
%F A401677 G.f. A(x) satisfies A(x) = (1-4*x) * (3*A(x*(1-2*x)) - 2).
%F A401677 a(n) is even for n > 0.
%F A401677 a(n) ~ c * n! * 2^n * n^(1 + log(3)) / log(3)^n, where c = 0.34860154956050022965110032989226500421828834527226051534344... - _Vaclav Kotesovec_, Nov 04 2026
%t A401677 a[0]=1; a[n_]:=a[n]=Sum[2^(k-1) * Binomial[n+k, k]*a[n-k], {k, 1, n}]; Table[a[n], {n, 0, 20}] (* _Vaclav Kotesovec_, Nov 04 2026 *)
%o A401677 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, 2^(j-1)*binomial(i+j, j)*v[i-j+1])); v;
