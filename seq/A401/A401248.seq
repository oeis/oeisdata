%T A401248 1,9,1,2,1,8,1,8,1,3,1,2,1,10,1,2,1,3,1,8,1,8,1,2,1,12,1,2,1,7,1,8,1,
%U A401248 3,1,2,1,12,1,2,1,3,1,4,1,10,1,2,1,12,1,2,1,8,1,12,1,3,1,2,1,12,1,2,1,9,1,4
%N A401248 Minimum number of terms in a 2-dense sublist of divisors of n.
%C A401248 a(n) is also the smallest number in the n-th row of A384222.
%H A401248 Paolo Xausa, <a href="/A401248/b401248.txt">Table of n, a(n) for n = 1..10000</a>
%F A401248 a(n) = A001511(n) * A401249(n).
%e A401248 For n = 70 the divisors of 70 are 1, 2, 5, 7, 10, 14, 35, 70. There are three 2-dense sublists of divisors, they are [1, 2], [5, 7, 10, 14], [35, 70]. The first sublist has two terms. The second sublist has four terms. The third sublist has two terms. Therefore the minimum number of terms in a 2-dense sublist is 2, so a(70) = 2.
%t A401248 A401248[n_] := Min[Map[Length, Split[Divisors[n], #2 <= 2*# &]]];
%t A401248 Array[A401248, 100] (* _Paolo Xausa_, Oct 28 2026 *)
%Y A401248 Cf. A000012 is a bisection.
%Y A401248 Cf. A001511, A174973 (2-dense numbers), A237271, A384222, A384225, A400194, A400195, A401249.
%K A401248 nonn,new
%O A401248 1,2
%A A401248 _Omar E. Pol_, Oct 18 2026
