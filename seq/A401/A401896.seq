%S A401896 87,16,12,32,8,0,18,32,0,10,6,12,22,4,0,2,18,10,0,4,10,2,6,20,32,0,20,
%T A401896 10,0,0,0,0,16,10,4,0,0,2,8,0,10,10,4,0,0,16,16,6,12,8,2,8,22,12,2,0,
%U A401896 0,12,0,24,0,0,30,8,12,0,0,0,16,12,0,18,0,0,0,16
%N A401896 Span of the n-th maximal cluster of primes with consecutive gaps at most 6.
%C A401896 The initial span a(1)=87 is the unique maximum since every later cluster has span at most 78 (A399292). Later spans are even.
%C A401896 For primes greater than 7, removing multiples of 2, 3, 5 and 7 leaves components with gaps at most 6 of span at most 78.
%H A401896 Jwalin Bhatt, <a href="/A401896/b401896.txt">Table of n, a(n) for n = 1..10000</a>
%e A401896 The first cluster is 2,...,89 and has span 89-2=87, so a(1)=87. The next two clusters are {97,101,103,107,109,113} and {127,131,137,139}, giving a(2)=16 and a(3)=12. The sixth cluster is {211}, so a(6)=0.
%t A401896 s={};p1=2;Do[p=p1;While[NextPrime[p]-p<=6,p=NextPrime[p]];AppendTo[s,p-p1];p1=NextPrime[p],{i,76}];s (* _James C. McMahon_, Nov 09 2026 *)
%o A401896 (Python)
%o A401896 from sympy import nextprime
%o A401896 from itertools import islice
%o A401896 def gen_A401896():
%o A401896     start = p = 2
%o A401896     while True:
%o A401896         q = int(nextprime(p))
%o A401896         if q - p > 6:
%o A401896             yield p - start
%o A401896             start = q
%o A401896         p = q
%o A401896 print(list(islice(gen_A401896(), 76)))
