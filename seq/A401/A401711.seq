%T A401711 31,32,33,34,35,36,37,39,40,41,43,44,45,47,48,49,50,52,53,55,56,57,58,
%U A401711 59,61,63,64,65,67,68,69,71,72,73,74,75,76,77,79,80,81,82,83,85,87,88,89,90,91,93,95,97,98,99,100,101
%N A401711 Numbers k such that A017665(k) is equal to A401375(k), where A017665(n) = sigma(n)/gcd(n,sigma(n)) and A401375(n) is the largest divisor of sigma(n) coprime with n, where sigma is the sum of divisors function.
%H A401711 Antti Karttunen, <a href="/A401711/b401711.txt">Table of n, a(n) for n = 1..10000</a>
%F A401711 {k such that A017665(k) = A401375(k)}.
%F A401711 {k such that A401710(k) = 1}.
%o A401711 (PARI) is_A401711(n) = { my(s=sigma(n)); fordiv(s,d,if(1==gcd(s/d,n), return(d==gcd(n,s)))); };
%Y A401711 Cf. A000203, A017665, A401375, A401712 (complement).
%Y A401711 Positions of 1's in A401710.
%K A401711 nonn,new
%O A401711 1,2
%A A401711 _Antti Karttunen_, Nov 02 2026
