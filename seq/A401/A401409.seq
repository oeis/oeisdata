%I A401409 #17 Oct 25 2026 04:15:44
%S A401409 0,1,0,-1,0,1,2,1,0,1,0,-1,-2,-1,0,-1,0,1,0,-1,0,1,2,1,2,3,2,1,0,1,2,
%T A401409 1,0,1,0,-1,0,1,2,1,0,1,0,-1,-2,-1,0,-1,-2,-1,-2,-3,-2,-1,0,-1,0,1,0,
%U A401409 -1,-2,-1,0,-1,0,1,0,-1,0,1,2,1,0,1,0,-1,-2,-1,0,-1
%N A401409 Partial sums of A209615.
%C A401409 Denoted as {L(n;4,2,3)} in the Humphries, Shekatkar, and Wong (2019) article.
%C A401409 First occurrence of k is A037481(k); first occurrence of -k is A043291(k).
%H A401409 Leandro Hector Gallego and Jianing Song, <a href="/A401409/b401409.txt">Table of n, a(n) for n = 0..10000</a>
%H A401409 Peter Humphries, Snehal M. Shekatkar, and Tian An Wong, <a href="https://doi.org/10.5802/jtnb.1066">Biases in prime factorizations and Liouville functions for arithmetic progressions</a>, J. Théor. Nombres Bordeaux 31 (2019), 1-25.
%F A401409 a(0) = 0, a(2n) = -a(n) + [n odd], a(2n+1) = -a(n) + [n even].
%F A401409 a(0) = 0, a(n) = -a(floor(n/2)) + (a(floor(n/2)) + n) mod 2 for n > 0.
%t A401409 Accumulate[Join[{0}, Table[(-1)^IntegerExponent[n, 2] * JacobiSymbol[-1, n], {n, 1, 79}]]] (* _Amiram Eldar_, Oct 23 2026 *)
%o A401409 (PARI) a(n) = sum(k=1, n, (-1)^valuation(k, 2)*kronecker(-1, k))
%o A401409 (PARI) a(n) = if(n<1, 0, -a(n\2)+(a(n\2)+n)%2)
%Y A401409 Cf. A209615, A037481, A043291.
%Y A401409 Cf. A068639 ({L(n;2,0)}), -A318682 ({L(n;2,1)}), A062756 ({L(n;3,2)}), A401408 ({L(n;4,1)}), A005811 ({L(n;4,3)}), this sequence ({L(n;4,2,3)}).
%Y A401409 Cf. A401437 (partial sums).
%K A401409 sign,easy,new
%O A401409 0,7
%A A401409 _Leandro Hector Gallego_ and _Jianing Song_, Oct 23 2026
