%S A401867 4,0,2,6,4,10,18,14,4,60,50,22,4,182,98,30,4,408,162,38,4,770,242,46,
%T A401867 4,1300,338,54,4,2030,450,62,4,2992,578,70,4,4218,722,78,4,5740,882,
%U A401867 86,4,7590,1058,94,4,9800,1250,102,4,12402,1458,110,4,15428,1682,118,4
%N A401867 Number of minimum independent dominating sets in the n-prism graph.
%C A401867 The n-prism graph is defined for n >= 3. The sequence has been extended to n = 0 using the formula.
%C A401867 A minimum independent dominating set is a maximal independent set of minimum size.
%C A401867 In an n-prism graph, a minimum independent dominating set has 2*ceiling(n/4) = A122461(n+3) vertices.
%C A401867 a(4*n) = 4 since this prism has 8*n vertices, and its vertex set can be partitioned into four (independent) dominating sets, which have (minimum) size 2*n. - _Allan Bickle_, Nov 11 2026
%H A401867 Andrew Howroyd, <a href="/A401867/b401867.txt">Table of n, a(n) for n = 0..999</a>
%H A401867 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/IndependentDominatingSet.html">Independent Dominating Set</a>.
%H A401867 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/PrismGraph.html">Prism Graph</a>.
%H A401867 <a href="/index/Rec#order_16">Index entries for linear recurrences with constant coefficients</a>, signature (0,0,0,4,0,0,0,-6,0,0,0,4,0,0,0,-1).
%F A401867 a(4*n) = 4; a(4*n+1) = 2*n*(2*n+1)*(4*n+1)/3; a(4*n+2) = 2*(2*n+1)^2; a(4*n+3) = 8*n + 6.
%F A401867 a(n) = 4*a(n-4) - 6*a(n-8) + 4*a(n-12) - a(n-16).
%F A401867 G.f.: 2*(2 + x^2 + 3*x^3 - 6*x^4 + 5*x^5 + 5*x^6 - 5*x^7 + 6*x^8 + 10*x^9 - 5*x^10 + x^11 - 2*x^12 + x^13 - x^14 + x^15)/((1 - x)^4*(1 + x)^4*(1 + x^2)^4).
%e A401867 For the 3-prism, 4-prism (cube), and 5-prism, all minimum independent dominating sets are equivalent to those shown below, so a(3) = 6, a(4) = 4, and a(5) = 10.
%e A401867    -o-x-o-   -o-x-o-o-   -o-x-o-x-o-
%e A401867    -o-o-x-   -o-o-o-x-   -x-o-x-o-o-
%t A401867 A401867[n_] := Switch[Mod[n, 4], 0, 4, 1, n*(n^2 - 1)/12, 2, n^2/2, _, 2*n];
%t A401867 Array[A401867, 100, 0] (* _Paolo Xausa_, Nov 11 2026 *)
%o A401867 (PARI) a(n) = my(m=n\4, r=n%4); 2*if(r==0, 2, r==1, m*(2*m+1)*(4*m+1)/3, r==2, (2*m+1)^2, 4*m + 3);
%Y A401867 Cf. A007040, A122461, A303053, A347634, A397751.
%K A401867 nonn,easy,new
%O A401867 0,1
%A A401867 _Andrew Howroyd_, Nov 10 2026
