%I A401926 #10 Nov 21 2026 00:13:54
%S A401926 1,2,2,4,6,12,2,4,4,8,12,24,6,12,12,24,36,72,30,60,60,120,180,360,210,
%T A401926 420,420,840,1260,2520,2,4,4,8,12,24,4,8,8,16,24,48,12,24,24,48,72,
%U A401926 144,60,120,120,240,360,720,420,840,840,1680,2520,5040,6,12,12,24,36,72,12,24,24,48,72,144,36,72,72,144
%N A401926 a(n) = A124859(A276086(n)), where A124859 is multiplicative with p^e -> primorial(e), and A276086 is the primorial base exp-function.
%H A401926 Antti Karttunen, <a href="/A401926/b401926.txt">Table of n, a(n) for n = 0..16170</a>
%H A401926 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%H A401926 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401926 a(n) = Product_{d over all digits of primorial base expansion of n (A049345)} A002110(d).
%F A401926 a(n) = A124859(A278226(n)).
%e A401926 For n = 52, its primorial base representation is A049345(52) = '1320', thus a(n) = A002110(1) * A002110(3) * A002110(2) = 2 * 30 * 6 = 360.
%o A401926 (PARI)
%o A401926 A124859(n) = {my(f = factor(n)); for(k=1, #f~, f[k, 1] = prod(j=1, f[k, 2], prime(j)); f[k, 2] = 1); factorback(f); };
%o A401926 A276086(n) = { my(m=1, p=2); while(n, m *= (p^(n%p)); n = n\p; p = nextprime(1+p)); (m); };
%o A401926 A401926(n) = A124859(A276086(n));
%o A401926 (PARI) A401926(n) = { my(m=1, p=2); while(n, m *= prod(j=1, n%p, prime(j)); n = n\p; p = nextprime(1+p)); (m); };
%Y A401926 Cf. A002110, A049345, A124859, A276086, A278226 [= A124859(a(n))], A286626 (rgs-transform).
%Y A401926 Cf. also A401927.
%K A401926 nonn,base,easy,new
%O A401926 0,2
%A A401926 _Antti Karttunen_, Nov 20 2026
