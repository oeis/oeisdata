%I A401545 #25 Oct 29 2026 13:59:11
%S A401545 1,2,2,4,4,3,7,7,5,4,9,9,7,7,5,12,12,9,9,7,6,18,18,12,12,9,10,7,24,24,
%T A401545 18,18,12,14,9,8,32,32,24,24,18,18,12,12,9,38,38,32,32,24,24,18,18,12,
%U A401545 10,42,42,38,38,32,32,24,24,18,14,11,50,50,42,42,38,38,32,32,24,18,13,12
%N A401545 Square array A(n,k), n >= 1, k >= 0, read by antidiagonals downwards: A(n,k) = n + Sum_{j=0..k-1} tau(A(n,j)).
%C A401545 A(n,k) = h_k(n) in Erdős Problem 414, with h_0(n) = n.
%H A401545 Paolo Xausa, <a href="/A401545/b401545.txt">Table of n, a(n) for n = 1..11325</a> (first 150 antidiagonals, flattened).
%H A401545 Thomas F. Bloom, <a href="https://www.erdosproblems.com/414">Erdős Problem 414</a>, Erdős Problems.
%F A401545 A(A(n,j), k) = A(n,j+k) for n >= 1 and j, k >= 0.
%e A401545 Square array begins:
%e A401545   1,  2,  4,  7,  9, 12, 18, ...
%e A401545   2,  4,  7,  9, 12, 18, 24, ...
%e A401545   3,  5,  7,  9, 12, 18, 24, ...
%e A401545   4,  7,  9, 12, 18, 24, 32, ...
%e A401545   5,  7,  9, 12, 18, 24, 32, ...
%e A401545   6, 10, 14, 18, 24, 32, 38, ...
%e A401545   ...
%t A401545 A401545[n_, k_] := Nest[# + DivisorSigma[0, #] &, n, k];
%t A401545 Table[A401545[m, n - m], {n, 15}, {m, n}] (* _Paolo Xausa_, Oct 29 2026 *)
%t A401545 (* Alternative: faster *)
%t A401545 A401545list[nmax_] := With[{a = Table[NestList[# + DivisorSigma[0, #] &, n, nmax - n], {n, nmax}]}, Table[a[[m, n - m + 1]], {n, nmax}, {m, n}]];
%t A401545 A401545list[15] (* _Paolo Xausa_, Oct 29 2026 *)
%o A401545 (PARI) a(n, k) = for(j=1, k, n+=numdiv(n)); n;
%Y A401545 Columns k=0..1 give A000027, A062249.
%Y A401545 Rows n=1 and n=2 give A064491(k+1) and A064491(k+2), respectively.
%Y A401545 Cf. A000005.
%K A401545 nonn,tabl,new
%O A401545 1,2
%A A401545 _Seiichi Manyama_, Oct 28 2026
