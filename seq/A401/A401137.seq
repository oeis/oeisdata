%S A401137 1,1,1,1,1,1,1,2,3,1,1,1,3,4,1,1,2,5,7,5,1,1,1,4,10,15,6,1,1,2,4,14,
%T A401137 25,21,7,1,1,1,5,10,40,31,28,8,1,1,2,4,14,31,96,63,36,9,1,1,1,4,11,50,
%U A401137 81,189,92,45,10,1,1,2,5,15,50,142,224,267,129,55,11,1
%N A401137 Triangle read by rows: T(n,k) is the number of distinct equality patterns among compositions of n into exactly k parts, 1 <= k <= n.
%C A401137 Two compositions (a_1,...,a_k) and (b_1,...,b_k) are equivalent if a_i = a_j if and only if b_i = b_j for all 1 <= i,j <= k.
%H A401137 Vladeta Jovovic, <a href="/A401137/b401137.txt">Table of n, a(n) for n = 1..5050</a>
%F A401137 T(n,k) = Sum_{m in M(n), Sum_i m_i = k} k! / (Product_i m_i! * Product_j c_j(m)!), where M(n) is the set of distinct nonincreasing sequences obtained by sorting the multiplicities of the distinct parts of each partition of n, and c_j(m) is the number of entries of m equal to j.
%e A401137 The triangle begins:
%e A401137   1;
%e A401137   1, 1;
%e A401137   1, 1, 1;
%e A401137   1, 2, 3, 1;
%e A401137   1, 1, 3, 4, 1;
%e A401137   1, 2, 5, 7, 5, 1;
%e A401137   1, 1, 4, 10, 15, 6, 1;
%e A401137   1, 2, 4, 14, 25, 21, 7, 1.
%e A401137 For n = 5, representatives grouped by the number k of parts are:
%e A401137   k = 1: (5);
%e A401137   k = 2: (1,4);
%e A401137   k = 3: (1,1,3), (1,3,1), (1,2,2);
%e A401137   k = 4: (1,1,1,2), (1,1,2,1), (1,2,1,1), (2,1,1,1);
%e A401137   k = 5: (1,1,1,1,1).
%e A401137 Thus row 5 is 1, 1, 3, 4, 1.
%Y A401137 Cf. A401134 (row sums), A088887.
