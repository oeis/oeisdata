%S A401934 0,0,0,0,3,0,0,0,0,0,0,0,4,0,0,0,5,0,2,2,3,0,5,0,1,0,0,0,9,0,0,2,11,0,
%T A401934 1,0,1,8,9,0,33,0,8,10,16,0,6,0,4,12,2,0,1,8,10,2,7,0,10,0,1,0,0,12,
%U A401934 30,0,8,2,37,0,7,0,1,3,12,6,41,0,10,0,31,0,3,6,16,8,3,0,11,0,20,2,36,12,7,0,6,14
%N A401934 a(n) = A276085(n) mod A083345(n), where A083345 is the numerator of the fully additive function with a(p) = 1/p, and A276085 is fully additive with a(p) = p#/p.
%H A401934 Antti Karttunen, <a href="/A401934/b401934.txt">Table of n, a(n) for n = 2..20000</a>
%H A401934 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%o A401934 (PARI)
%o A401934 A083345(n) = { my(f=factor(n)); numerator(vecsum(vector(#f~, i, f[i, 2]/f[i, 1]))); };
%o A401934 A276085_mod_m(n,m) = if(1==n,0,my(f = factor(n),lp=f[#f~,1],pr=1,s=0,k=1); forprime(p=2,lp,if(f[k,1]==p, s += f[k,2]*pr; s %= m; k++); pr *= p; pr %= m); (s));
%o A401934 A401934(n) = A276085_mod_m(n, A083345(n));
%Y A401934 Cf. A083345, A276085.
%Y A401934 Cf. A401935 (after the initial 1, gives the indices of 0's in this sequence).
%Y A401934 Cf. also A373148, A401724.
%K A401934 nonn,new
%O A401934 2,5
%A A401934 _Antti Karttunen_, Nov 09 2026
