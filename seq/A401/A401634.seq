%U A401634 688758242876,2898531113056,12166556318472,50950348588640,212917676349508,888062647326912,3697552353876584,15370446289466144
%N A401634 a(n) = 2*Sum_{i=1..n-1} Sum_{1<=j<k<=n} abs(i-k)*binomial(i+j-2, i-1)*binomial(2*n-i-k-1, n-i-1).
%C A401634 a(n) is the total cross work on the semigroup POI_n of partial order-preserving injective transformations (see Udo et al.).
%H A401634 Nsibiet E. Udo, Victor A. Owai, and Moses O. Francis, <a href="https://arxiv.org/abs/2610.34902">Cross work induced by transformations on the symmetric group and related transformation semigroups</a>, arXiv:2610.34902 [math.CO], 2026. See Table 2 on page 18.
%F A401634 a(n) = (n+3) * 2^(2*n-3) - 2*(2*n)! / ((n-1)!*(n+1)!). - _Vaclav Kotesovec_, Nov 01 2026
%t A401634 a[n_]:=2*Sum[Sum[Sum[Abs[i-k]*Binomial[i+j-2,i-1]*Binomial[2n-i-k-1,n-i-1],{k,j+1,n}],{j,n}],{i,n-1}]; Array[a,30]
%t A401634 (* Alternative: *)
%t A401634 Table[(n+3) * 2^(2*n-3) - 2*(2*n)! / ((n-1)!*(n+1)!), {n, 1, 30}] (* _Vaclav Kotesovec_, Nov 01 2026 *)
