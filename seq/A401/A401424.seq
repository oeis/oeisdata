%S A401424 1,2,3,6,5,6,7,2,12,10,11,18,13,14,15,30,17,24,19,30,21,22,23,6,30,26,
%T A401424 3,42,29,30,31,2,33,34,35,72,37,38,39,10,41,42,43,66,60,46,47,90,56,
%U A401424 60,51,78,53,6,55,14,57,58,59,90,61,62,84,6,65,66,67,102,69,70,71,24
%N A401424 The sum of coreful divisors of the smallest coreful infinitary divisor of n.
%C A401424 The number of these divisors is A401423(n).
%H A401424 Amiram Eldar, <a href="/A401424/b401424.txt">Table of n, a(n) for n = 1..10000</a>
%F A401424 a(n) = A057723(A365296(n)).
%F A401424 a(n) = n if and only if n is squarefree (A005117).
%F A401424 Multiplicative with a(p^e) = (p^(A006519(e)+1) - 1)/(p-1) - 1.
%F A401424 Sum_{k=1..n} a(k) ~ c * n^2 / 2, where c = Product_{p prime} (1-1/p) * (1 + Sum_{k>=1} a(k)/p^(2*k)) = 1.02056770551652806216... .
%t A401424 f[p_, e_] := (p^(2^IntegerExponent[e, 2]+1) - 1)/(p-1) - 1; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 72]
%o A401424 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, (f[i, 1]^(2^valuation(f[i, 2], 2)+1) - 1)/(f[i, 1]-1) - 1);}
%Y A401424 Cf. A005117, A006519, A057723, A284318 (coreful divisors), A365296, A401423.
%K A401424 nonn,mult,easy,new
%O A401424 1,2
%A A401424 _Amiram Eldar_, Oct 24 2026
