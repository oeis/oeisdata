%I A401760 #7 Nov 10 2026 22:41:36
%S A401760 1,8,8,27,96,40,64,432,720,160,125,1280,4320,4320,560,216,3000,16000,
%T A401760 34560,22680,1792,343,6048,45000,160000,241920,108864,5376,512,10976,
%U A401760 105840,540000,1400000,1548288,489888,15360
%N A401760 Array A(n,k), n >= 3, k >= 2, read by antidiagonals: number of unit cubes in the k^n cubic grid.
%C A401760 For n >= 3, there are binomial(n,3) ways to choose three distinct coordinate axes, k^(n-3) coordinate-parallel 3-dimensional slices per choice, and (k-1)^3 unit 3-cubes per slice.
%H A401760 Eddie Lin Rui, <a href="/A401760/b401760.txt">Table of n, a(n) for n = 3..10013; the first 141 antidiagonals of the array</a>
%F A401760 A(n,k) = binomial(n,3)*k^(n-3)*(k-1)^3.
%e A401760 For a 4-dimensional, 3 X 3 X 3 X 3 cubic grid, there are binomial(4,3) = 4 ways to choose three distinct coordinate axes (wxy, wxz, wyz, xyz), 3 coordinate-parallel 3-dimensional slices per choice, and (3-1)^3 = 8 unit 3-cubes per slice. Therefore, A(4,3) = 4*3*8 = 96.
%e A401760 The array begins:
%e A401760          k=2      3       4        5        6         7         8          9
%e A401760   n=3      1      8      27       64      125       216       343        512
%e A401760   n=4      8     96     432     1280     3000      6048     10976      18432
%e A401760   n=5     40    720    4320    16000    45000    105840    219520     414720
%e A401760   n=6    160   4320   34560   160000   540000   1481760   3512320    7464960
%e A401760   n=7    560  22680  241920  1400000  5670000  18151560  49172480  117573120
%e A401760   n=8   1792 108864 1548288 11200000 54432000 203297472 629407744 1693052928
%e A401760 ....
%e A401760 A(4,3) = binomial(4,3)*3^(4-3)*(3-1)^3 = 4*3*8 = 96.
%o A401760 (Python)
%o A401760 from math import comb
%o A401760 def A(n, k):
%o A401760     return comb(n, 3)*k**(n-3)*(k-1)**3
%o A401760 a = []
%o A401760 for d in range(8):
%o A401760     a.extend(A(3+i, d+2-i) for i in range(d+1))
%o A401760 print(a)
