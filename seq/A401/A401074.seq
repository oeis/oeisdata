%N A401074 Number of n X n (0,1)-matrices of rank 3 over the real numbers.
%C A401074 Also the number of n X n (0,1)-matrices of rank 3 over the rationals.
%C A401074 Every 3-dimensional subspace V of R^n spanned by binary vectors intersects {0,1}^n \ {0} in k in {3, 4, 5, 7} nonzero binary vectors with t in {0, 1, 2, 6} linearly dependent triples {u, v, u+v} (where u, v have disjoint supports). Specifically, there are 5 matroid isomorphism types (k, t) in {(3,0), (4,0), (4,1), (5,2), (7,6)}.
%H A401074 <a href="/index/Rec#order_18">Index entries for linear recurrences with constant coefficients</a>, signature (240, -26395, 1765110, -80310967, 2635915140, -64564213085, 1204431733830, -17310598954688, 192660583830000, -1659976462885520, 11012735877118560, -55643870471209344, 210352419462597120, -578980617050880000, 1112661454970880000, -1394617980764160000, 1006286163148800000, -309586821120000000).
%F A401074 a(n) = N1(n)*F1(n) + N2(n)*F2(n) + N3(n)*F3(n) + N4(n)*F4(n) + N5(n)*F5(n), where:
%F A401074   N1(n) = (8^n - 12*6^n + 30*5^n - 35*4^n + 24*3^n - 10*2^n + 2)/6, F1(n) = 4^n - 3*3^n + 3*2^n - 1;
%F A401074   N2(n) = (6^n - 5*5^n + 10*4^n - 10*3^n + 5*2^n - 1)/8, F2(n) = 5^n - 6*3^n + 8*2^n - 3;
%F A401074   N3(n) = 4*N2(n), F3(n) = 5^n - 4^n - 3*3^n + 5*2^n - 2;
%F A401074   N4(n) = 5*(5^n - 4*4^n + 6*3^n - 4*2^n + 1)/8, F4(n) = 6^n - 2*4^n - 4*3^n + 9*2^n - 4;
%F A401074   N5(n) = (4^n - 3*3^n + 3*2^n - 1)/6, F5(n) = 8^n - 6*4^n - 3*3^n + 17*2^n - 9.
%F A401074 a(n) ~ 32^n / 3 as n -> infinity.
%F A401074 From _Jianing Song_, Oct 15 2026: (Start)
%F A401074 a(n) = (8*32^n + 30*30^n - 75*25^n - 144*24^n + 300*20^n + 180*18^n - 140*16^n - 300*15^n + 96*12^n + 150*10^n - 72*9^n - 112*8^n + 138*6^n - 30*5^n - 8*4^n - 36*3^n + 14*2^n + 1)/24.
%F A401074 G.f.: 6*x^3*(29 - 960*x - 147920*x^2 + 12470310*x^3 - 418938293*x^4 + 7335130530*x^5 - 61073520880*x^6 - 54509163360*x^7 + 6541989621264*x^8 - 67349693855520*x^9 + 337756427424000*x^10 - 847124671680000*x^11 + 699412008960000*x^12 + 790315315200000*x^13 - 1074954240000000*x^14)/((1 - x)*(1 - 2*x)*(1 - 3*x)*(1 - 4*x)*(1 - 5*x)*(1 - 6*x)*(1 - 8*x)*(1 - 9*x)*(1 - 10*x)*(1 - 12*x)*(1 - 15*x)*(1 - 16*x)*(1 - 18*x)*(1 - 20*x)*(1 - 24*x)*(1 - 25*x)*(1 - 30*x)*(1 - 32*x)).
%F A401074 E.g.f.: P(exp(x)), where P(x) = x*(x - 1)^3*(8*x^28 + 24*x^27 + 78*x^26 + 170*x^25 + 300*x^24 + 468*x^23 + 674*x^22 + 843*x^21 + 831*x^20 + 638*x^19 + 264*x^18 - 291*x^17 - 727*x^16 - 1044*x^15 - 1062*x^14 - 781*x^13 - 341*x^12 - 42*x^11 + 116*x^10 + 133*x^9 + 105*x^8 + 32*x^7 + 64*x^6 + 129*x^5 + 115*x^4 + 22*x^3 - 12*x^2 - 17*x - 1)/24. (End)
%e A401074 For n = 3, a(3) = 174 = A055165(3) is the number of nonsingular 3 X 3 (0,1)-matrices over R (168 with determinant +-1 and 6 with determinant +-2).
%e A401074 For n = 4, The three per-subspace counts were incorrect even though their errors canceled. a(4) = 20*60+15*600+10*2580 = 36000.
%o A401074 (Python)
%o A401074 def a(n):
%o A401074     n1 = (8**n - 12*6**n + 30*5**n - 35*4**n + 24*3**n - 10*2**n + 2) // 6
%o A401074     f1 = 4**n - 3*3**n + 3*2**n - 1
%o A401074     n2 = (6**n - 5*5**n + 10*4**n - 10*3**n + 5*2**n - 1) // 8
%o A401074     f2 = 5**n - 6*3**n + 8*2**n - 3
%o A401074     n3, f3 = 4 * n2, 5**n - 4**n - 3*3**n + 5*2**n - 2
%o A401074     n4 = 5 * (5**n - 4*4**n + 6*3**n - 4*2**n + 1) // 8
%o A401074     f4 = 6**n - 2*4**n - 4*3**n + 9*2**n - 4
%o A401074     n5 = (4**n - 3*3**n + 3*2**n - 1) // 6
%o A401074     f5 = 8**n - 6*4**n - 3*3**n + 17*2**n - 9
%o A401074     return n1*f1 + n2*f2 + n3*f3 + n4*f4 + n5*f5
%o A401074 print([a(n) for n in range(18)])
%o A401074 (PARI)
%o A401074 a(n) = {
%o A401074   my(n1 = (8^n - 12*6^n + 30*5^n - 35*4^n + 24*3^n - 10*2^n + 2)/6,
%o A401074      f1 = 4^n - 3*3^n + 3*2^n - 1,
%o A401074      n2 = (6^n - 5*5^n + 10*4^n - 10*3^n + 5*2^n - 1)/8,
%o A401074      f2 = 5^n - 6*3^n + 8*2^n - 3,
%o A401074      n3 = 4*n2, f3 = 5^n - 4^n - 3*3^n + 5*2^n - 2,
%o A401074      n4 = 5*(5^n - 4*4^n + 6*3^n - 4*2^n + 1)/8,
%o A401074      f4 = 6^n - 2*4^n - 4*3^n + 9*2^n - 4,
%o A401074      n5 = (4^n - 3*3^n + 3*2^n - 1)/6,
%o A401074      f5 = 8^n - 6*4^n - 3*3^n + 17*2^n - 9);
%o A401074   n1*f1 + n2*f2 + n3*f3 + n4*f4 + n5*f5;
%o A401074 }
