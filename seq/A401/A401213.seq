%S A401213 0,1,18,480,24320,2580480,600047616,310982475776,359488762675200,
%T A401213 921082880820510720,5188529576699137884160,63759086408696735981371392,
%U A401213 1697533703571883141402485325824,97343485350169641830189134344355840,11961569609481853971519035342695830650880
%N A401213 Total number of undirected paths in all labeled graphs on n vertices, singleton paths excluded.
%C A401213 The paths considered here are undirected and have at least one edge.
%H A401213 Andrew Howroyd, <a href="/A401213/b401213.txt">Table of n, a(n) for n = 1..50</a>
%H A401213 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/GraphPath.html">Graph Path</a>.
%F A401213 a(n) = Sum_{k=2..n} binomial(n,k) * k! * 2^(binomial(n,2)-k).
%t A401213 A401213[n_] := Sum[Binomial[n, k]*k!*2^(# - k), {k, 2, n}] & [Binomial[n, 2]];
%t A401213 Array[A401213, 15] (* _Paolo Xausa_, Oct 18 2026 *)
%t A401213 (* Alternative: *)
%t A401213 A401213[n_] := 2^((n - 2)*(n + 1)/2)*(2^(1 - n)*Exp[2]*Gamma[n + 1, 2] - n - 2);
%t A401213 Array[A401213, 15] (* _Paolo Xausa_, Oct 18 2026 *)
%o A401213 (PARI) a(n)=sum(k=2, n, binomial(n,k)*k!*2^(binomial(n,2)-k))
%Y A401213 Cf. A288430 (unlabeled), A401178, A401212 (cycles).
%K A401213 nonn,new
%O A401213 1,3
%A A401213 _Andrew Howroyd_, Oct 18 2026
