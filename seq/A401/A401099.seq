%S A401099 1,3,24,396,12465,736770,82409327,17661298776,7322216623209,
%T A401099 5908301329133750,9314005827484894459,28761374138166075935364,
%U A401099 174323549615850031283523117,2077252904827794072213000714002,48732400006196973851777081664738615,2253584363239508568951262584038269623344
%N A401099 Total number of induced trees in all connected labeled graphs on n vertices.
%C A401099 Here an induced tree has at least one vertex.
%H A401099 Andrew Howroyd, <a href="/A401099/b401099.txt">Table of n, a(n) for n = 1..50</a>
%o A401099 (PARI)
%o A401099 G(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k/2^(k*(k-1)/2), O(x^n)))}
%o A401099 U(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k*2^(k*(k-1)/2), O(x^n)))}
%o A401099 seq(n)={my(g=U(exp(x+O(x*x^n))), t=-lambertw(-x+O(x*x^n))); Vec(serlaplace(U(G(t-t^2/2)*G(g))/g))}
%Y A401099 Cf. A000272, A401091 (in trees), A401098, A401178, A401179.
%K A401099 nonn,new
%O A401099 1,2
%A A401099 _Andrew Howroyd_, Oct 16 2026
