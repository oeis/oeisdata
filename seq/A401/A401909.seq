%U A401909 5,4,1,6,1,1,1,4,2,2,8,1,4,3,1,2,1,4,4
%N A401909 Number of primes in the n-th maximal cluster of primes with consecutive gaps at most 6.
%C A401909 The initial count a(1)=24 is the unique maximum since every later cluster contains at most 19 primes (A399821).
%C A401909 For jump limit 8, whether a later cluster equals or exceeds the initial count 30 remains unresolved (A399819).
%C A401909 For jump limit 12, the initial count 30 is exceeded by the cluster 127 to 293, containing 32 primes.
%H A401909 Jwalin Bhatt, <a href="/A401909/b401909.txt">Table of n, a(n) for n = 1..10000</a>
%e A401909 The first cluster is {2, ..., 89} and contains 24 primes, so a(1) = 24.
%e A401909 The second cluster is {97, 101, 103, 107, 109, 113}, so a(2) = 6.
%e A401909 The third cluster is {127, 131, 137, 139}, so a(3) = 4.
%e A401909 The sixth cluster is {211}, so a(6) = 1.
%t A401909 Map[Length, Most[Split[Prime[Range[300]], #2 - # <= 6 &]]] (* _Paolo Xausa_, Nov 15 2026 *)
%o A401909 (Python)
%o A401909 from sympy import nextprime
%o A401909 from itertools import islice
%o A401909 def gen_A401909():
%o A401909     p, count = 2, 1
%o A401909     while True:
%o A401909         q = int(nextprime(p))
%o A401909         if q - p > 6:
%o A401909             yield count
%o A401909             count = 0
%o A401909         count += 1
%o A401909         p = q
%o A401909 print(list(islice(gen_A401909(), 87)))
%Y A401909 Cf. A000040, A000720, A001223, A399819, A399821, A401896.
%K A401909 nonn,new
%O A401909 1,1
