%S A401516 1,1,1,1,9,9,18,18,66,75,188,224,597,669,1478,1883,4548,5548,11346,
%T A401516 14379,31801,40926,80004,105458,217073,281479,528094,715020,1389628,
%U A401516 1854043,3387901,4599349,8536443,11634623,20708566,28512995,51301896,70287707,121935680
%N A401516 Sum of products of parts in all partitions of n into parts whose product is a square.
%H A401516 Alois P. Heinz, <a href="/A401516/b401516.txt">Table of n, a(n) for n = 0..500</a>
%e A401516 a(7) = 18 = 1 + 4 + 9 + 4: 1111111, 22111, 331, 4111.
%e A401516 a(8) = 66 = 1 + 4 + 16 + 9 + 4 + 16 + 16: 11111111, 221111, 2222, 3311, 41111, 422, 44.
%p A401516 g:= (n, i, p)-> `if`(max(p)>i, 0, `if`(n=0 or i=1, 1, b(n, i, p))):
%p A401516 b:= proc(n, i, p) option remember; g(n, i-1, p)+i*g(n-i, min(n-i, i),
%p A401516       {select(h-> irem(h[2], 2)=1, ifactors(mul(j, j=p)*i)[2])[.., 1][]})
%p A401516     end:
%p A401516 a:= n-> g(n$2, {}):
%p A401516 seq(a(n), n=0..38);
%Y A401516 Cf. A006906, A401510, A401517.
%K A401516 nonn,new
%O A401516 0,5
