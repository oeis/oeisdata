%S A401508 3,7,31,73,151,31,631,73,127,151,331,601,4421,631,2731,257,1429,127,
%T A401508 1103,3121,2143,1321,5153,601,2351,14327,2971,2857,3191,3391,683,2593,
%U A401508 17029,2687,2731,1801,11471,1103,49999,6361,17467,2143,5419,25609,5581,5153,26227,2113,51941,2351
%N A401508 Least prime p such that 2^((p-1)/n) == 1 (mod p).
%H A401508 Robert G. Wilson v, <a href="/A401508/b401508.txt">Table of n, a(n) for n = 1..10000</a>
%e A401508 a(1) = 3 since it is the first term in A065091 and the first odd prime in A015919 and A176997;
%e A401508 a(2) = 7 since it is the first term in A001132 and the first odd term in A038873;
%e A401508 a(3) = 31 since it is the first term in A306787;
%e A401508 a(4) = 73 since it is the first term in A014754;
%e A401508 a(5) = 151 since it is the first term in A059858;
%e A401508 a(6) = 31 since 2^((31-1)/6 = 2^5 = 32 and 32 == 1 (mod 31);
%e A401508 a(7) = 631 since it is the first term in A270802; etc.
%t A401508 a[n_] := Block[{c = 1 + Boole[ OddQ[ n]], p}, p = c*n; While[ !PrimeQ[p +1] || PowerMod[2, p/n, p +1] != 1, p += c*n]; p +1]
%Y A401508 Cf. A065091, A015919, A176997, A001132, A038873, A306787, A014754, A040028, A040098, A059858, A270802.
%K A401508 nonn,new
%O A401508 1,1
%A A401508 _Robert G. Wilson v_, Oct 27 2026
