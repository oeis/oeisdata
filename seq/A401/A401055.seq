%I A401055 #12 Oct 16 2026 11:19:29
%S A401055 1,127,313,347,523,2287,3581,7927,8377,8741,12437,16427,22501,28837,
%T A401055 31751,33757,36691,44069,56317,56977,57503,60661,79777,93097,93937,
%U A401055 126859,130517,133183,153067,154331,154943,155887,221189,237767,248777,254959,356197,528217
%N A401055 Numbers k such that A276085(k * 113^2 * 67) is a multiple of A003415(k * 113^2 * 67).
%C A401055 The fourth row of irregular triangle A401051 is the first one that gives such a pair of primes p, q, for which p^2 * q is found in A373487, namely p=113, q=67, and 113^2 * 67 = 855523 is also the first term of A371083 (and of A095990) that is included there. The condition that allows such p^2 * q products to be candidate terms for A373487, also allows some products like r * p^2 * q, A020639(r) > p, to be in A373487.
%C A401055 The first composite term in this sequence is a(18) = 44069 = 127*347 = a(2)*a(4).
%F A401055 {k such that A373486(k*855523) = 1}.
%o A401055 (PARI)
%o A401055 A003415(n) = if(n<=1, 0, my(f=factor(n)); n*sum(i=1, #f~, f[i, 2]/f[i, 1]));
%o A401055 A276085(n) = { my(f = factor(n)); sum(k=1, #f~, f[k, 2]*prod(i=1,primepi(f[k, 1]-1),prime(i))); };
%o A401055 A373486(n) = (1==n || !(A276085(n)%A003415(n)));
%o A401055 is_A401055(k) = A373486(k * 113^2 * 67);
%Y A401055 Cf. A003415, A095990, A276085, A371083, A373487.
%K A401055 nonn,new
%O A401055 1,2
%A A401055 _Antti Karttunen_, Oct 15 2026
