%T A401379 2,2,2,2,2,1,3,0,2,2,2,1,2,1,2,2,1,1,2,1,2,2,2,2,3,1,2,1,2,1,3,0,2,2,
%U A401379 1,1,2,2,2,2,2,2,2,1,2,2,1,2,3,0,2,2,2,2,3,1,1,2,1,1,2,1,2,2,2,2,3,0,2,3,1
%N A401379 Number of distinct prime factors in the largest divisor of sigma(n) coprime with n, where sigma is the sum of divisors function.
%H A401379 Antti Karttunen, <a href="/A401379/b401379.txt">Table of n, a(n) for n = 1..10000</a>
%e A401379 a(n) = A001221(A401375(n)).
%e A401379 a(n) = A001222(A080398(n)/gcd(A007947(n),A080398(n))).
%o A401379 (PARI) A401379(n) = { my(s=sigma(n)); fordiv(s,d,if(1==gcd(s/d,n), return(omega(s/d)))); };
%o A401379 (PARI) A401379(n) = { my(f=factorback(factor(n)[,1]), g=factorback(factor(sigma(n))[,1])); omega(g/gcd(f,g)); };
%Y A401379 Cf. A000203, A001221, A001222, A007949, A080398, A401375, A401380 [= a(n^2)].
%Y A401379 Cf. A105402 (positions of 0's), A401381 (positions of 1's), A401384 (positions of records).
%K A401379 nonn,new
%O A401379 1,5
%A A401379 _Antti Karttunen_, Oct 31 2026
