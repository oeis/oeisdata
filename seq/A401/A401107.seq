%S A401107 2,3,3,4,3,4,5,5,5,5,6,5,5,5,6,7,7,7,7,7,7,8,7,8,7,8,7,8,9,9,7,9,9,7,
%T A401107 9,9,10,9,10,10,9,10,10,9,10,11,11,11,11,11,11,11,11,11,11,12,11,11,
%U A401107 11,12,12,12,11,11,11,12,13,13,13,13,13,13,13,13,13,13,13,13
%N A401107 Triangle read by rows: T(n,k) = max{d : 1 <= d <= n and d | binomial(n,k)}, for n >= 2 and 1 <= k < n.
%H A401107 Seiichi Manyama, <a href="/A401107/b401107.txt">Rows n = 2..141, flattened</a>
%H A401107 Thomas F. Bloom, <a href="https://www.erdosproblems.com/387">Erdős Problem 387</a>, Erdős Problems.
%F A401107 T(n,k) = T(n,n-k).
%F A401107 If p is prime, T(p,k) = p.
%e A401107 Triangle begins:
%e A401107   n\k| 1  2  3  4  5  6  7
%e A401107   ---+---------------------
%e A401107    2 | 2;
%e A401107    3 | 3, 3;
%e A401107    4 | 4, 3, 4;
%e A401107    5 | 5, 5, 5, 5;
%e A401107    6 | 6, 5, 5, 5, 6;
%e A401107    7 | 7, 7, 7, 7, 7, 7;
%e A401107    8 | 8, 7, 8, 7, 8, 7, 8;
%o A401107 (PARI) T(n, k) = my(b=binomial(n, k), d=n); while(b%d, d--); d;
%Y A401107 Row minima form A401108.
%K A401107 nonn,tabl,new
%O A401107 2,1
%A A401107 _Seiichi Manyama_, Oct 14 2026
