%I A401752 #4 Nov 10 2026 21:49:28
%S A401752 4,200,1936,83232,529984,6242400,26499200,6059065600,91430352000,
%T A401752 137145528000,837942796800,6936691737600,12034346688000,
%U A401752 99623212416000,215464652121600,1783668142771200,5911061650179840000,20495684455347628800
%N A401752 Primitive terms of A401751: terms in A401751 that are powerful numbers (A001694).
%C A401752 Analogous to primitive e-perfect numbers (A054980), which have a ratio A051377(k)/k = 2 instead of 3/2.
%C A401752 If k is a term, then k*m is a term in A401751 for any squarefree number m that is coprime to k.
%C A401752 Any term in A401751 is of the form k*m, where k is a term in this sequence and m is a squarefree number coprime to k. Therefore, A401751 can be generated from this sequence by multiplying with coprime squarefree numbers, and the asymptotic density of A401751 can be evaluated from the terms in this sequence (see the Comments section of A401751).
%H A401752 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%t A401752 f[p_, e_] := DivisorSum[e, p^# &]; esigma[1] = 1; esigma[n_] := Times @@ f @@@ FactorInteger[n]; q[k_] := esigma[k] == 3*k/2;
%t A401752 seq[lim_] := Select[Union[Flatten[Table[i^2 * j^3, {j, 1, Surd[lim, 3]}, {i, 1, Sqrt[lim/j^3]}]]], q]; seq[10^11]
%o A401752 (PARI) is1(k) = vecprod([sumdiv(f[2], d, f[1]^d) | f <- factor(k)~]) == 3*k/2;
%o A401752 list(lim) = {my(s = List(), m); for(j = 1, sqrtnint(lim, 3), for(i = 1, sqrtint(lim\j^3), m = i^2*j^3; if(is1(m), listput(s, m)))); Set(s);}
%o A401752 list(10^11)
%Y A401752 Intersection of A001694 and A401751.
%Y A401752 Cf. A005117, A051377, A054980.
%K A401752 nonn,more,new
%O A401752 1,1
%A A401752 _Amiram Eldar_, Nov 04 2026
