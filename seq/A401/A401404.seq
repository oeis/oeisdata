%S A401404 2,3,6,9,16,17,18,21,30,34,35,42,43,44,55,56,64,65,79,80,81,90,96,106,
%T A401404 107,108,109,110,111,121,122,123,124,125,139,140,142,143,144,145,146,
%U A401404 166,167,168,177,178,179,184,185,186,201,202,203,204,216,231,255,256,257,258,259,260
%N A401404 Numbers m such that pi(2*m) is prime, where pi is A000720.
%H A401404 Vincenzo Manto, <a href="/A401404/b401404.txt">Table of n, a(n) for n = 1..1561</a>
%H A401404 Vincenzo Manto, <a href="/A401404/a401404.png">a(n) vs n and phase of a(n) graphs</a>
%e A401404 For n = 2, 2*n = 4, the primes <= 4 are 2 and 3 so pi(4) = 2. Since 2 is prime, 2 is in the sequence.
%e A401404 For n = 3, 2*3 = 6, the primes <= 6 are 2, 3 and 5 so pi(6) = 3. Since 3 is prime, 3 is in the sequence.
%e A401404 For n = 4, 2*4 = 8, the primes <= 8 are 2, 3, 5 and 7 so pi(8) = 4. Since 4 is not a prime, 4 is not in the sequence.
%t A401404 Select[Range[300], PrimeQ[PrimePi[2*#]] &] (* _Paolo Xausa_, Nov 04 2026 *)
%o A401404 (Python)
%o A401404 from sympy import isprime, primepi
%o A401404 print([n for n in range(1, 261) if isprime(primepi(2 * n))])
%Y A401404 Cf. A304483, A000720, A000040, A099802.
%Y A401404 Intersection of A099802 and A000040
