%T A401374 181,283,5,607,523,79,409,937,1013,487,11,331,461,653,421,7,1061,1279,
%U A401374 641,997,1489,337,647,1163,829,1427,353,269,499,1619,1129,701,1471,1291,863,1637
%N A401374 Largest such q listed for each prime p (A401373) for which there exists a prime q < p such that ((p#/p) / (q#/q)) == +1 mod p, where p# = A034386(p).
%H A401374 Antti Karttunen, <a href="/A401374/b401374.txt">Table of n, a(n) for n = 1..4017</a>
%H A401374 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%o A401374 (PARI) if_is_A401373_on_p_return_A401374(p) = { my(n=primepi(p)-1, pr=1, c=0); forstep(k=n, 1, -1, pr *= prime(k); pr %= p; if(1==pr,return(prime(k)))); (0); };
%o A401374 forprime(p=2,8191,if((q=if_is_A401373_on_p_return_A401374(p))>0,print1(q,", ")));
%Y A401374 Cf. A034386, A401373.
%Y A401374 Cf. also A401062, A401064.
%K A401374 nonn,new
%O A401374 1,1
