%T A401564 7,5,4,5,4,9,6,8,3,5,0,7,4,1,7,1,3,4,5,4,7,5,5,7,8,2,8,6,0,9,7,7,8,1,
%U A401564 1,9,4,7,4,4,6,8,9,9,6,9,7,1,4,8,4,2,8,0,9,9,3,2,7,6,7,3,2,0,5,1,1,0,4,7,5
%N A401564 Decimal expansion of -lim_{x->oo} (Sum_{primes p <= x} (p^(1/p) - 1) - log(x)).
%C A401564 Sum_{primes p <= x} (p^(1/p) - 1) = log(x) + c + o(1), since Sum_{primes p <= x} log(p)/p = log(x) - A083343 + o(1) and Sum_p (p^(1/p) - 1 - log(p)/p) converges absolutely; this sequence gives the decimal expansion of -c.
%C A401564 This is the prime analog of the MRB constant A037077 (cf. A400904 for the Moebius analog). Since p^(1/p) - 1 = log(p)/p + O(log(p)^2/p^2), the series Sum_p (p^(1/p) - 1) diverges in the same way as Mertens's first theorem Sum_{primes p <= x} log(p)/p = log(x) + O(1), and the constant term c = -0.928667... of its partial sums is the natural regularized value of the divergent series; it plays the role that -A083343 plays for Mertens's sum. The convergent companion Sum_p (p^(1/p) - 1)/p is A401473.
%F A401564 Equals A083343 - Sum_{p prime} (p^(1/p) - 1 - log(p)/p).
%F A401564 Equals A083343 - Sum_{k>=2} ((-1)^k/k!) * P^(k)(k), where P^(k)(s) denotes the k-th derivative of the prime zeta function P(s) = Sum_{p prime} p^(-s).
%F A401564 Equals A083343 - Sum_{k>=2} (1/k!) * Sum_{p prime} log(p)^k/p^k.
%e A401564 0.928667346145151453709535421950483575454968350741713454755782860...
%o A401564 (PARI) \p 120 \\ the only parameter: every truncation point below is derived from the precision
%o A401564 Q = 100; q = nextprime(Q+1); \\ primes p <= Q are summed directly; Q affects speed only, not correctness
%o A401564 \\ k-th Taylor coefficient at s0 of P_Q(s) = Sum_{p>Q} p^-s, by Moebius inversion of log(zeta(s)*Prod_{p<=Q} (1-p^-s)). M is the first m at which the neglected terms are < 10^-D; the extra digits offset the factor m^k in the x^k coefficient of zeta(m*s0 + m*x).
%o A401564 PQk(s0, k) = my(D = default(realprecision), eps = 10.^-D, M = 1, r = 0, s); while(4*(M*log(q))^k/k!*q^(-M*s0) >= eps, M++); localprec(D + ceil(k*log(M)/log(10)) + 10); for(m = 1, M, if(moebius(m), s = m*s0 + m*x + O(x^(k+1)); r += moebius(m)/m*polcoef(log(zeta(s)) + sum(i = 1, primepi(Q), log(1 - prime(i)^-s)), k))); r;
%o A401564 a() = my(eps = 10.^-default(realprecision), E, S, t); E = Euler + sum(i = 1, primepi(Q), my(p = prime(i)); log(p)/(p*(p-1))); S = sum(i = 1, primepi(Q), my(p = prime(i)); p^(1/p) - 1 - log(p)/p); for(j = 2, oo, E -= PQk(j, 1); if(1.*Q^-j < eps, break)); for(k = 2, oo, t = (-1)^k*PQk(k, k); S += t; if(t < eps, break)); E - S; \\ E = A083343
%o A401564 a()
%Y A401564 Cf. A000040, A083343, A401473.
%K A401564 nonn,cons,new
%O A401564 0,1
%A A401564 _Madhav Gaur_, Oct 29 2026
