%I A401701 #14 Nov 16 2026 12:48:49
%S A401701 1,2,11,17,37,59,61,127,151,163,173,179,199,229,293,331,359,367,401,
%T A401701 463,467,547,661,743,751,787,797,809,839,919,967,1031,1039,1049,1051,
%U A401701 1061,1129,1249,1303,1327,1399,1423,1429,1447,1459,1549,1613,1621,1667,1693,1753,1789,1801,1867,1949,2053,2269,2281,2339
%N A401701 Noncomposites p for which there exists a noncomposite q <= p such that (p# / q#) == -1 mod r, where p# = A034386(p), and r is the least prime larger than p.
%C A401701 See comments in A401061.
%H A401701 Antti Karttunen, <a href="/A401701/b401701.txt">Table of n, a(n) for n = 1..4188</a>
%H A401701 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401701 a(n) = A064989(A401061(n)).
%F A401701 For n > 1, a(n) = A000040(A401065(n)).
%e A401701 1 is a term because 1 + (1# / q#) will be a multiple of 2 (next prime larger than 1) when we set q to 1.
%e A401701 2 is a term because 1 + (2# / q#) will be a multiple of 3 (next prime larger than 2) when we set q to 1.
%e A401701 11 is a term because 1 + (11# / q#) will be a multiple of 13 (next prime larger than 11) when we set q to 5, as 1+((11*7*5*3*2) / (5*3*2)) = 78 = 13*6.
%o A401701 (PARI)
%o A401701 A034386(n) = prod(i=1, primepi(n), prime(i));
%o A401701 is_A401701(p) = if(p>1 && !isprime(p), 0, my(prp=A034386(p), r=nextprime(1+p)); if((r-1)==(prp%r), 1, forprime(q=2,p,if((r-1)==((prp/A034386(q))%r), return(1))); (0))); \\ (reference implementation, very inefficient)
%Y A401701 Cf. A000040, A034386, A064989, A401061, A401065.
%Y A401701 Subsequences: A058233.
%Y A401701 Cf. also A401700, A401702, A401703.
%K A401701 nonn,new
%O A401701 1,2
%A A401701 _Antti Karttunen_, Nov 16 2026
