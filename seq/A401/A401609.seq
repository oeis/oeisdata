%I A401609 #15 Nov 12 2026 19:19:38
%S A401609 0,1,3,4,4,6,6,8,7,4,4,1,10,10,5,8,8,5,4,7,6,8,2,10,10,5,3,5,5,3,5,0,
%T A401609 10,11,6,11,6,10,15,4,7,8,5,4,10,9,7,6,6,5,6,3,6,3,9,5,7,5,8,3,8,8,4,
%U A401609 8,6,6,12,6,6,7,5,9,5,3,8,9,4,9,13,3,2,10,11,5
%N A401609 Number of distinct primes of the form P(n)/d - d, where P(n) is the n-th primorial A002110(n) and d<prime(n) is a divisor of P(n).
%C A401609 a(n) = number of integers k that make A002110(n)/A005117(k)-A005117(k) prime, A005117(k)<prime(n).
%C A401609 d is a squarefree number (A005117).
%C A401609 Conjecture: a(n) > 0 except for n = 1 and n = 32.
%H A401609 Sean A. Irvine, <a href="/A401609/b401609.txt">Table of n, a(n) for n = 1..250</a>
%e A401609 P(2)=6; prime(2)=3; A005117(1)=1, 6/1-1=5 is prime; A005117(2)=2, 6/2-2=1 is not prime; A005117(3)=3 is not less than prime(2)=3; so a(2)=1.
%e A401609 P(3)=30; prime(3)=5; A005117(1)=1, 30/1-1=29 is prime; A005117(2)=2, 30/2-2=13 is prime; A005117(3)=3, 30/3-3=7 is prime; A005117(4)=5 is not less than prime(3)=5; so a(3)=3.
%o A401609 (PARI) a(n) = my(S=0, P=prime(n)-1, Primo=vecprod(primes(n))); for(D=1, P, if(issquarefree(D) && ispseudoprime(Primo/D-D), S++)); return(S);
%Y A401609 Cf. A002110, A005117, A400506.
%K A401609 nonn,new
%O A401609 1,3
%A A401609 _Alain Rocchelli_, Oct 30 2026
