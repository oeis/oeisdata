%S A401232 1,4,6,16,27,36,38,45,48,60,64,80,91,117,126,150,156,162,168,175,200,
%T A401232 208,209,216,224,231,256,288,294,305,308,322,345,375,384,392,429,460,
%U A401232 495,500,510,572,578,660,680,686,725,729,775,810,814,833,880,945,972,981,1024,1080,1083,1122,1175,1250,1260,1271,1273,1296
%N A401232 Numbers k such that A006530(k) divides A276085(k), where A006530(k) is the largest prime dividing k, 1 if k is 1, and A276085 is fully additive with a(p) = p#/p.
%H A401232 Antti Karttunen, <a href="/A401232/b401232.txt">Table of n, a(n) for n = 1..11515</a>
%H A401232 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401232 {k such that A276085(k) == 0 mod A006530(k)}.
%F A401232 {k such that A006530(A373361(k)) = A006530(k)}.
%o A401232 (PARI) is_A401232(n) = if(1==n,1,my(f = factor(n),mp=f[#f~,1],pr=1,s=0,k=1); forprime(p=2,,if(f[k,1]==p, s += f[k,2]*pr; s %= mp; if(p==mp,return(!s)); k++); pr *= p; pr %= mp));
%Y A401232 Cf. A006530, A276085, A373361.
%Y A401232 Positions of 0's in A401066.
%Y A401232 Subsequences: A401229, A401231, A401233 (terms with no p^p factors), A401234 (squarefree terms).
%K A401232 nonn,new
%O A401232 1,2
%A A401232 _Antti Karttunen_, Oct 21 2026
