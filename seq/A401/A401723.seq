%I A401723 #16 Nov 17 2026 10:24:56
%S A401723 1,2,3,16,5,6,7,216,36,10,11,48,13,14,15,4096,17,72,19,80,21,22,23,
%T A401723 648,100,26,729,112,29,30,31,100000,33,34,35,576,37,38,39,1080,41,42,
%U A401723 43,176,180,46,47,12288,196,200,51,208,53,1458,55,1512,57,58,59,240,61,62,252,2985984,65,66,67,272,69,70,71,7776
%N A401723 Multiplicative with a(p^e) = (e*p)^e.
%C A401723 Sequence is not injective. See the examples.
%H A401723 Antti Karttunen, <a href="/A401723/b401723.txt">Table of n, a(n) for n = 1..10000</a>
%F A401723 a(n) = n*A112622(n).
%F A401723 a(n) >= n, with equality if and only if n is a squarefree number (A005117).
%e A401723 For n = 64 = 2^6, a(n) = (2*6)^6 = 12^6 = 2985984.
%e A401723 For n = 432 = 2^4 * 3^3, a(n) = (2*4)^4 * (3*3)^3 = 8^4 * 9^3 = 2985984.
%t A401723 f[x_] := Times @@ MapApply[(#2*#1)^#2 &, FactorInteger[x] ]; Array[f, 72] (* _Michael De Vlieger_, Nov 16 2026 *)
%o A401723 (PARI) A401723(n) = { my(f = factor(n)); for(i=1, #f~, f[i, 1] *= f[i,2]); factorback(f); };
%Y A401723 Cf. A000027, A112622, A401715 (number of times each n occurs in this sequence).
%Y A401723 Cf. A005117 (fixed points), A401913 (numbers that occur in this sequence), A401914 (numbers that do not occur in this sequence), A401916 (numbers that occur more than once).
%Y A401723 Cf. also A133482.
%K A401723 nonn,easy,mult,new
%O A401723 1,2
%A A401723 _Antti Karttunen_, Nov 16 2026
