%I A401183 #11 Oct 17 2026 20:59:54
%S A401183 2,3,19,278,7973,423764,41477723,7585507408,2640354432665,
%T A401183 1775288599069284,2328634232828805559,5996481030436673639840,
%U A401183 30438261087144588930160517,305382988725198591040608910628,6067084178701975275426166735120355,239004178675859837923779384765620721856
%N A401183 Total number of independent vertex sets in all connected labeled graphs on n vertices.
%H A401183 Andrew Howroyd, <a href="/A401183/b401183.txt">Table of n, a(n) for n = 1..50</a>
%H A401183 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/IndependentVertexSet.html">Independent Vertex Set</a>.
%F A401183 E.g.f.: log(B(x)) where B(x) is the e.g.f. of A079491.
%o A401183 (PARI)
%o A401183 G(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k/2^(k*(k-1)/2), O(x^n)))}
%o A401183 U(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k*2^(k*(k-1)/2), O(x^n)))}
%o A401183 seq(n)={my(g=U(exp(x+O(x*x^n)))); Vec(serlaplace(log(U(G(exp(x+O(x*x^n)))*G(g)))))}
%Y A401183 Row sums of A401185.
%Y A401183 Cf. A001187, A079491 (in not necessarily connected graphs), A394610, A399451 (in trees), A401180, A401187.
%K A401183 nonn,new
%O A401183 1,1
%A A401183 _Andrew Howroyd_, Oct 17 2026
