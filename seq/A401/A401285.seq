%I A401285 #11 Nov 05 2026 20:11:49
%S A401285 1,3,22,60,367,981,5896,15726,94369,251655,1509946,4026528,24159187,
%T A401285 64424505,386547052,1030792146,6184752901,16492674411,98956046494,
%U A401285 263882790660,1583296743991,4222124650653,25332747903952,67553994410550,405323966463337,1080863910568911
%N A401285 Number of nonempty convex vertex sets in the n X n black bishop graph.
%C A401285 A vertex set in a connected graph is convex if for every pair of vertices in the set it contains all other vertices that lie on a shortest path between the two vertices.
%C A401285 The empty set is also convex but is excluded here.
%C A401285 A vertex set in a bishop graph is convex if it is the intersection of the vertices in a subset of diagonals and the vertices in a subset of antidiagonals.
%H A401285 Andrew Howroyd, <a href="/A401285/b401285.txt">Table of n, a(n) for n = 1..1000</a>
%H A401285 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/BlackBishopGraph.html">Black Bishop Graph</a>.
%H A401285 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (1,17,-17,-16,16).
%F A401285 a(n) = (12*4^n - 15*n - 12)/50 for even n; a(n) = (18*4^n - 15*n - 7)/50 for odd n.
%F A401285 a(n) = a(n-1) + 17*a(n-2) - 17*a(n-3) - 16*a(n-4) + 16*a(n-5).
%F A401285 G.f.: x*(1 + 2*x)*(1 + 2*x^2)/((1 - x)^2*(1 + x)*(1 - 4*x)*(1 + 4*x)).
%o A401285 (PARI)
%o A401285 RookConvexSets(sig) = { my(r=vector(vecmax(sig))); foreach(vecsort(sig), m, r[m] += 2^m - 1 + sum(k=1, m, r[k]*2^(m-k))); vecsum(r) }
%o A401285 Bishop(n, white)=vector(n-if(white, n%2, 1-n%2), i, n-i+if(white, 1-i%2, i%2));
%o A401285 a(n) = RookConvexSets(Bishop(n,0))
%o A401285 (PARI) a(n) = if(n%2, 18*4^n - 15*n - 7, 12*4^n - 15*n - 12)/50
%Y A401285 Cf. A014825 (triangular honeycomb bishop graph), A060867 (rook graph), A401286 (white bishop graph).
%K A401285 nonn,easy,new
%O A401285 1,2
%A A401285 _Andrew Howroyd_, Nov 05 2026
