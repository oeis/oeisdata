%S A401745 16,1,0,1,3,0,1,0,5,0,1,5,9,7,16,1,6,14,32,9,0,1,7,24,30,25,11,0,1,8,
%T A401745 27,50,55,0,13,0,1,9,35,77,81,91,49,15,16,1,10,44,108,182,196,140,128,
%U A401745 17,0,1,11,54,156,294,378,416,204,81,19,0,1,12,65,210,450,704,714,540,285,0,21,0
%N A401745 Triangle read by rows: for n>0 and 0<=k<=n, T(n,k) is the number of circular (n+k)-bit strings with k 1's that, when circularly shifted by 4 bits, do not have any coincident 1's when placed over the original bit string.
%C A401745 T(n,k) is the number of tilings of a circular (n+k)-board using k curved (1,3)-fences and n-k curved unit square tiles. A (1,g)-fence is composed of two unit square tiles separated by a gap of width g.
%C A401745 This is the m=4 member in the sequence of triangles A029635, A401743, A401744, A401745, A401746, A402564 which give the number of tilings of a circular (n+k) X 1 board using k curved (1,m-1)-fences and n-k curved unit square tiles.
%C A401745 This is also the m=4, t=2 member of a two-parameter family of triangles such that T(n,k) is the number of tilings of an (n+(t-1)*k) X 1 circular board using k curved (1,m-1;t)-combs and n-k curved unit square tiles. A (1,g;t)-comb is composed of a line of t unit square tiles separated from each other by gaps of width g.
%C A401745 T(n,k) is the coefficient of x^k in (L((n+k)/p))^p where p=gcd(n+k,4) and L(n,x) is a form of Lucas polynomial defined by L(n,x) = L(n-1,x) + x*L(n-2,x) where L(0,x)=2, L(1,x)=1, and L(n,x)=0 for n<0.
%C A401745 For n+k>4, T(n,k) is the number of k-subsets of n+k objects arranged in a circle such that no two objects in a subset are separated by 3 objects.
%C A401745 Sum of n-th antidiagonal (counting initial 16 as the 0th) is (L(n/p))^p where p=gcd(n,4) and L(i) is the i-th Lucas number A000032.
%F A401745 T(n,0) = 1 for n>0.
%F A401745 T(n,1) = n+1 for n>=4.
%F A401745 T(4*k,4*k) = 16 for k>=0.
%F A401745 T(4*k+j,4*k+j) = 0 for k>=0 and j=1,2,3.
%F A401745 T(k+1,k) = 2*k+1 for k>=0.
%F A401745 T(2*k+2,2*k) = (2*k+1)^2 for k>=0.
%F A401745 T(4*k+3,4*k+1) = 0 for k>=0.
%F A401745 T(4*k+5,4*k+3) = 32*(k+1)^2 for k>=0.
%F A401745 T(4*(k+1),4*k) = (2k+1)^4 for k>=0.
%F A401745 T(n,k) = C(n,k)*(n+k)/n if n+k is prime.
%F A401745 T(n,k) = T(n-1,k) + T(n-1,k-1) for n>=3k+2 and k>=0.
%e A401745 Triangle begins:
%e A401745  16;
%e A401745   1,   0;
%e A401745   1,   3,   0;
%e A401745   1,   0,   5,   0;
%e A401745   1,   5,   9,   7,  16;
%e A401745   1,   6,  14,  32,   9,   0;
%e A401745   1,   7,  24,  30,  25,  11,   0;
%e A401745   1,   8,  27,  50,  55,   0,  13,   0;
%e A401745   1,   9,  35,  77,  81,  91,  49,  15,  16;
%e A401745   1,  10,  44, 108, 182, 196, 140, 128,  17,   0;
%e A401745   1,  11,  54, 156, 294, 378, 416, 204,  81,  19,   0;
%e A401745   1,  12,  65, 210, 450, 704, 714, 540, 285,   0,  21,   0;
%e A401745 ...
%t A401745 LP[n_]:=If[n<0,0,Expand[LP[n-1]+x*LP[n-2]]+2KroneckerDelta[n,0]-KroneckerDelta[n,1]];
%t A401745 T[n_,k_]:=Module[{p=GCD[n+k,4]},Coefficient[LP[(n+k)/p]^p,x,k]];
%t A401745 Flatten@Table[T[n, k], {n, 0, 11}, {k, 0, n}]
%Y A401745 Other triangles related to tiling using fences: A059259, A123521, A157897, A335964, A350110.
