%I A401881 #9 Nov 13 2026 15:45:57
%S A401881 1,2,4,6,8,15,16,17,18,19,119,220,240,260,280,210,320,340,360,380,400,
%T A401881 420,440,460,310,500,520,540,560,580,600,620,640,660,410,700,720,740,
%U A401881 760,780,800,820,840,510,880,900,920,940,960,980,1000,1020,1040,610,1080,1100,2056,1804,1406,1109
%N A401881 a(n) is the least number k such that there are exactly n numbers j, 1 <= j <= k/2, such that the product of digits of k is the sum of the product of digits of j and the product of digits of k-j, or -1 if there is no such k.
%C A401881 a(n) is the least k such that A401862(k) = n, or -1 if there is no such k.
%H A401881 Robert Israel, <a href="/A401881/b401881.txt">Table of n, a(n) for n = 0..2000</a>
%e A401881 a(5) = 15 because 1*5 = 5 = 1 + 1*4 = 2 + 1*3 = 3 + 1*2 = 4 + 1*1 = 5 + 1*0, and 15 is the least number that works.
%p A401881 N:= 200: # for a(0) .. a(N)
%p A401881 pd:= proc(n) option remember;  convert(convert(n, base, 10), `*`) end proc:
%p A401881 f:= proc(n) local t, k, count;
%p A401881   t:= pd(n); count:= 0;
%p A401881 for k from 1 to n/2 while count <= N do
%p A401881   if pd(k) + pd(n-k) = t then count:= count+1 fi
%p A401881 od;
%p A401881 count
%p A401881 end proc:
%p A401881 V:= Array(0..N): count:= 0:
%p A401881 for n from 1 while count < N+1 do
%p A401881   v:= f(n);
%p A401881   if v <= N and V[v] = 0 then V[v]:= n; count:= count+1 fi;
%p A401881 od:
%p A401881 convert(V,list);
%Y A401881 Cf. A007954, A400774, A401802, A401862.
%K A401881 nonn,base,look,new
%O A401881 0,2
%A A401881 _Robert Israel_, Nov 08 2026
