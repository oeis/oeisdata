%I A401568 #5 Oct 29 2026 14:42:38
%S A401568 0,0,1,0,1,3,0,1,1,1,1,4,0,0,2,3,0,4,0,1,2,1,0
%N A401568 Number of quintic symmetric graphs on 2n vertices.
%C A401568 Graphs are simple and undirected, and are counted up to isomorphism. Here "symmetric" means vertex- and edge-transitive, equivalently arc-transitive for odd valency.
%C A401568 Both connected and disconnected graphs are included. Every such graph is a disjoint union of isomorphic connected quintic symmetric graphs.
%C A401568 The counts through n = 23 are obtained from Conder's complete census of connected symmetric graphs on at most 47 vertices.
%H A401568 Marston Conder, <a href="https://www.math.auckland.ac.nz/~conder/symmetricgraphs-orderupto47-byedges.txt">Connected symmetric graphs of order 2 to 47</a>, December 2021.
%H A401568 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/QuinticSymmetricGraph.html">Quintic Symmetric Graph</a>.
%H A401568 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/SymmetricGraph.html">Symmetric Graph</a>.
%F A401568 a(n) = Sum_{d|n} A400580(d) = A400580(n) + A401569(n).
%e A401568 a(3) = 1, corresponding to the complete graph K_6.
%t A401568 Module[{lines, c},
%t A401568 	lines = StringTrim /@ Import["https://www.math.auckland.ac.nz/~conder/symmetricgraphs-orderupto47-byedges.txt", "Lines"];
%t A401568 	c = Counts[FromDigits[Last[StringSplit[lines[[# - 1]]]]]/2 & /@ Flatten[Position[lines, "Valency 5"]]];
%t A401568 	c = Lookup[c, Range[23], 0];
%t A401568 	Table[Total[c[[Divisors[n]]]], {n, 23}]
%t A401568 ]
%Y A401568 Cf. A400580 (connected).
%Y A401568 Cf. A401569 (disconnected).
%K A401568 nonn,more,new
%O A401568 1,6
%A A401568 _Eric W. Weisstein_, Oct 29 2026
