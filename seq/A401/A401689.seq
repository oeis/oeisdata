%N A401689 G.f. A(x) satisfies A(x) = A(x^4/(1 - x)^2) / (1 - x), with A(0) = 1.
%F A401689 a(0) = 1; a(n) = Sum_{k=0..floor(n/4)} binomial(n-2*k,2*k) * a(k).
%o A401689 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=0, i\4, binomial(i-2*j, 2*j)*v[j+1])); v;
