%U A401345 6,4,5,6,0,7,6,1,8,6,5,9,3,2,4,7,5,5,9,2,6,5,7,5,6,2,8,0,2,2,6,6
%N A401345 Decimal expansion of Product_{k>0} 1/(1 - (2*k)^(-8)).
%H A401345 Aleksandar Petojević, <a href="https://doi.org/10.13140/RG.2.2.26039.07847">Exponential Moderateness as a Structural Obstacle in the Theory of Stochastic Very Weak Solutions with Singular Potentials</a>, ResearchGate, 2026. See p. 5.
%F A401345 Equals -Pi^4 * csc(Pi*exp(i*Pi/4)/2) * csc(Pi*exp(3*i*Pi/4)/2) * csch(Pi/2)/16, where i = sqrt(-1).
%F A401345 Equals Pi^4 * csch(Pi/2) / (8*(cosh(Pi/sqrt(2)) - cos(Pi/sqrt(2)))). - _Vaclav Kotesovec_, Oct 22 2026
%e A401345 1.00393755850398994621476430619774014222811936356...
%p A401345 evalf[120](Product(1/(1-(2*k)^(-8)), k=1..infinity));  # _Alois P. Heinz_, Oct 21 2026
%t A401345 RealDigits[Re[-Pi^4 * Csc[Pi*Exp[I*Pi/4]/2] * Csc[Pi*Exp[3*I*Pi/4]/2] * Csch[Pi/2]/16],10,100][[1]]
%t A401345 (* Alternative: *)
%t A401345 RealDigits[Pi^4 * Csch[Pi/2] / (8*(Cosh[Pi/Sqrt[2]] - Cos[Pi/Sqrt[2]])), 10, 100][[1]] (* _Vaclav Kotesovec_, Oct 22 2026 *)
%Y A401345 Cf. A019669, A092425.
%Y A401345 Cf. A401343, A401344, A401346, A401347.
%K A401345 nonn,cons,new
%O A401345 1,4
