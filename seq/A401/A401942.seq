%S A401942 0,1,5,15,38,91,206,447,939,1938,3956,8018,16172,32514,65237,130723,
%T A401942 261741,523828,1048054,2096564,4193647,8387877,16776407,33553542,
%U A401942 67107888,134216662,268434297,536869655,1073740465,2147482184,4294965722,8589932904,17179867379
%N A401942 Largest m such that one defective in an m-item set and one in a disjoint 8-item set can always be identified in at most n adaptive tests, each returning the number of defectives in a selected subset (0 if no positive m is feasible).
%H A401942 Paolo Xausa, <a href="/A401942/b401942.txt">Table of n, a(n) for n = 2..1000</a>
%H A401942 Fedor Karpelevitch, <a href="https://arxiv.org/abs/2611.09076">Quantitative group testing with a fixed shore: sharp asymptotics and exact formulas</a>, arXiv:2611.09076 [math.CO], 2026.
%H A401942 Fedor Karpelevitch, <a href="https://doi.org/10.5281/zenodo.23996093">Evidence for quantitative group testing with a fixed shore: sharp asymptotics and exact formulas</a>, version 1.0.0, 2026.
%H A401942 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-5,3,-4,5,-2).
%F A401942 a(2) = 0; a(3) = 1; a(4) = 5; a(5) = 15; a(6) = 38; a(7) = 91; a(8) = 206; a(9) = 447; a(10) = 939.
%F A401942 a(n) = 2^n - 2*n^2 + 16*n - 44 for 11 <= n <= 12.
%F A401942 a(n) = 2^n - 2*n^2 + floor((49*n - 145)/3) for n >= 13 (Karpelevitch, Theorem 1.2).
%F A401942 G.f.: x^3*(1 + x + 3*x^4 + 2*x^5 + x^6 - 5*x^7 + 3*x^8 + 3*x^9 + 7*x^10 - x^11 - x^12 - x^13 - 3*x^14 + 2*x^15)/((1 - x)^3*(1 - 2*x)*(1 + x + x^2)).
%F A401942 E.g.f.: exp(2*x) - (6*x^2 - 43*x + 146)*exp(x)/3 + exp(-x/2)*(sin(sqrt(3)*x/2)/sqrt(3) - cos(sqrt(3)*x/2))/3 + 48 + 32*x + 10*x^2 + 11*x^3/6 + x^4/6 - x^6/240 - x^7/1008 - x^8/10080 - x^9/362880 + x^11/39916800 + x^12/479001600.
%F A401942 a(n) = 4*a(n-1) - 5*a(n-2) + 3*a(n-3) - 4*a(n-4) + 5*a(n-5) - 2*a(n-6) for n >= 19. - _Jianing Song_, Nov 12 2026
%t A401942 LinearRecurrence[{4, -5, 3, -4, 5, -2}, {0, 1, 5, 15, 38, 91, 206, 447, 939, 1938, 3956, 8018, 16172, 32514, 65237, 130723, 261741}, 35] (* _Paolo Xausa_, Nov 18 2026 *)
