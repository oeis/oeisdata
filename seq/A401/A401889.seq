%I A401889 #23 Nov 17 2026 09:38:40
%S A401889 0,3,6,8,11,13,16,16,19,21,23,24,26,28,28,30
%N A401889 a(n) is the minimum number of sums needed to obtain all nonnegative integer pairs (a,b) with a + b = n starting from (1,0) and (0,1).
%C A401889 Upper bounds for a(17)-a(32): 32, 34, 36, 36, 39, 41, 43, 43, 45, 46, 47, 49, 51, 52, 54, 55.
%H A401889 A. Zanoni, <a href="https://bivariate-1-norm-addition-chains.jimdosite.com">Bivariate addition chains: 1-norm</a>.
%e A401889 n = 2: (2,0) = (1,0) + (1,0)
%e A401889        (1,1) = (1,0) + (0,1)
%e A401889        (0,2) = (0,1) + (0,1)
%e A401889 n = 3: (2,0) = (1,0) + (1,0)
%e A401889        (0,2) = (0,1) + (0,1)
%e A401889        (3,0) = (2,0) + (1,0)
%e A401889        (2,1) = (2,0) + (0,1)
%e A401889        (1,2) = (0,2) + (1,0)
%e A401889        (0,3) = (0,2) + (0,1)
%e A401889 n = 4: (2,0) = (1,0) + (1,0)
%e A401889        (1,1) = (0,1) + (1,0)
%e A401889        (0,2) = (0,1) + (0,1)
%e A401889        (4,0) = (2,0) + (2,0)
%e A401889        (3,1) = (1,1) + (2,0)
%e A401889        (2,2) = (0,2) + (2,0)
%e A401889        (1,3) = (0,2) + (1,1)
%e A401889        (0,4) = (0,2) + (0,2)
%Y A401889 Cf. A383330.
%K A401889 nonn,hard,more,new
%O A401889 1,2
%A A401889 _Alberto Zanoni_, Nov 08 2026
