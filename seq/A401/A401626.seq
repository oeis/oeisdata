%T A401626 76139073600,1513153247840,32240149792256,733176886489920,
%U A401626 17725853125729152,454018662213785696,12281520750408884736,349883965796346127488,10471021329201010764800,328434438132782160197760
%N A401626 a(0) = 1; a(n) = Sum_{k=1..n} binomial(n+k,k) * a(n-k).
%F A401626 G.f. A(x) satisfies A(x) = (1-2*x) * (2*A(x*(1-x)) - 1).
%F A401626 a(n) is even for n > 0.
%o A401626 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(i+j, j)*v[i-j+1])); v;
