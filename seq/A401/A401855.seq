%I A401855 #22 Nov 16 2026 17:44:35
%S A401855 1,2,2,3,2,2,2,2,5,2,3,2,2,2,2,2,2,2,2,3,2,7,3,2,2,2,2,2,2,2,2,2,2,2,
%T A401855 2,2,2,5,2,2,3,2,3,3,2,2,2,2,2,2,2,2,2,11,2,2,2,2,2,2,2,2,2,2,2,2,2,2,
%U A401855 3,2,2,5,3,2,2,2,3,2,3,2
%N A401855 a(1) = 1, for n>1, a(n) is the smallest prime number where A025487(n)/a(n) is still in A025487.
%C A401855 Also: a(1) = 1, for n>1, a(n) is the smallest number where A025487(n)/a(n) is still in A025487. Because the smallest number k such that any number in A025487 (>1) divide by k is still in A025487 are always prime numbers.
%C A401855 For any a(n) != 2, A025487(n) is in A056153.
%H A401855 Michael De Vlieger, <a href="/A401855/b401855.txt">Table of n, a(n) for n = 1..10000</a> (first 4000 terms from Zhicheng Wei)
%H A401855 Michael De Vlieger, <a href="/A401855/a401855.png">Log log scatterplot of primepi(a(n))</a>, n = 2..1240172.
%e A401855 a(23) = 3 because A025487(23) = 216, while 216/2 = 108 which is not in A025487, but 216/3 = 72 is in A025487.
%t A401855 (* First, load Mathematica function f from A025487, then: *)
%t A401855 fQ[x_] := Or[x == 1, Times @@ MapIndexed[Prime[First[#2] ]^#1 &, ReverseSort[FactorInteger[x][[;; , -1]] ] ] == x]; {1}~Join~Map[(k = 1; While[! fQ[#/Prime[k]], k++]; Prime[k]) &, Rest@ Union@ Flatten@ f[6] ] (* _Michael De Vlieger_, Nov 09 2026 *)
%o A401855 (PARI)
%o A401855 A283980(n) = {my(f=factor(n)); prod(i=1, #f~, my(p=f[i, 1], e=f[i, 2]); if(p==2, 6, nextprime(p+1))^e)}
%o A401855 A025487list(e) = { my(lista = List([1, 2]), i=2, u = 2^e, t); while(lista[i] != u, if(2*lista[i] <= u, listput(lista, 2*lista[i]); t = A283980(lista[i]); if(t <= u, listput(lista, t))); i++); vecsort(Vec(lista)); }
%o A401855 v025487 = A025487list(101)
%o A401855 A025487(n) = v025487[n]
%o A401855 isA025487(n)=my(k=valuation(n, 2), t); n>>=k; forprime(p=3, default(primelimit), t=valuation(n, p); if(t>k, return(0), k=t); if(k, n/=p^k, return(n==1)))
%o A401855 A401855(n)=for(t=2,1e4,if(isA025487(A025487(n)/t),return(t)))
%Y A401855 Cf. A025487, A056153.
%K A401855 nonn,new
%O A401855 1,2
%A A401855 _Zhicheng Wei_, Nov 07 2026
