%I A401539 #17 Nov 06 2026 04:25:32
%S A401539 0,1,0,1,1,2,1,1,0,1,2,1,2,1,1,1,0,2,1,1,1,1,3,2,1,4,1,2,1,2,6,1,1,4,
%T A401539 1,1,3,1,3,0,1,2,1,5,1,2,1,2,4,1,1,1,2,2,1,0,2,1,1,2,6,1,1,1,1,1,1,8,
%U A401539 2,1,3,3,1,1,4,1,2,1,6,2,1,1,2,1,3,2,1,1,6,0,1,4,1,10,1,1,2,1,1,1
%N A401539 Semiprime residuals: a(n) = q (mod p), where p <= q are the prime factors of the n-th semiprime S_n = p*q.
%C A401539 a(n) is the remainder when the larger factor of the n-th semiprime is divided by the smaller factor.
%C A401539 a(n) = 0 if and only if S_n is a square semiprime p^2 (A001248).
%C A401539 a(n) = 1 whenever S_n = 2*p for an odd prime p > 2.
%C A401539 The sequence a(n) is unbounded.
%H A401539 Paolo Xausa, <a href="/A401539/b401539.txt">Table of n, a(n) for n = 1..10000</a>
%F A401539 a(n) = A006530(A001358(n)) (mod A020639(A001358(n))).
%F A401539 a(n) = A069859(A001358(n)).
%e A401539 a(1) = 0 since S_1 = 4 = 2*2 and 2 (mod 2) = 0.
%e A401539 a(6) = 2 since S_6 = 15 = 3*5 and 5 (mod 3) = 2.
%e A401539 a(94) = 10 since S_94 = 473 = 11*43 and 43 (mod 11) = 10.
%t A401539 Table[If[Plus @@ #[[All, 2]] == 2, Mod[#[[-1, 1]], #[[1, 1]]], Nothing] & [FactorInteger[k]], {k, 500}] (* _Paolo Xausa_, Nov 06 2026 *)
%Y A401539 Cf. A000040, A001248, A001358, A006530, A020639, A069859.
%K A401539 nonn,new
%O A401539 1,6
%A A401539 _Michael Shmoish_, Oct 28 2026
