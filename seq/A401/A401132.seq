%S A401132 2,9,5,8,6,7,5,1,1,9,1,8,8,6,3,8,8,9,2,3,1,0,8,2,1,3,5,7,7,2,7,7,1,9,
%T A401132 5,6,6,4,7,4,8,9,8,1,9,6,0,5,7,9,8,2,5,3,0,6,5,6,2,9,2,8,4,5,0,3,0,5,
%U A401132 9,4,8,2,2,0,1,7,9,0,9,3,0,5,0,2,6,1,7
%N A401132 Decimal expansion of Gamma(1/4)/Gamma(3/4).
%D A401132 F. W. J. Olver, D. W. Lozier, R. F. Boisvert, and C. W. Clark (eds.), NIST Handbook of Mathematical Functions, Cambridge University Press, 2010, Chapters 5 and 19.
%H A401132 William Steinmetz, <a href="/A401132/b401132.txt">Table of n, a(n) for n = 1..1000</a>
%H A401132 Henri Cohen and Wadim Zudilin, <a href="https://arxiv.org/abs/2510.00215">Continued Fractions and Irrationality Measures for Chowla-Selberg Gamma Quotients</a>, arXiv:2510.00215 [math.NT], 2025.
%H A401132 NIST Digital Library of Mathematical Functions, <a href="https://dlmf.nist.gov/5.2#E1">Euler's integral for the gamma function</a>.
%H A401132 NIST Digital Library of Mathematical Functions, <a href="https://dlmf.nist.gov/5.5#E3">Euler's reflection formula</a>.
%H A401132 NIST Digital Library of Mathematical Functions, <a href="https://dlmf.nist.gov/5.12#E1">Euler's beta integral</a>.
%H A401132 NIST Digital Library of Mathematical Functions, <a href="https://dlmf.nist.gov/19.8">Arithmetic-geometric mean transformations</a>.
%F A401132 Equals Gamma(1/4)^2/(sqrt(2)*Pi).
%F A401132 Equals B(1/4,1/2)/sqrt(Pi), where B is the beta function.
%F A401132 Equals (4/sqrt(Pi))*Integral_{x=0..1} 1/sqrt(1-x^4) dx.
%F A401132 Equals 2*sqrt(Pi)/AGM(1,sqrt(2)), where AGM is the arithmetic-geometric mean.
%F A401132 Equals (Integral_{x=0..infinity} exp(-x^4) dx)/(Integral_{x=0..infinity} x^2*exp(-x^4) dx).
%F A401132 Equals sqrt(2*Pi*Sum_{k>=0} binomial(2*k,k)^3/64^k).
%F A401132 a(n) = floor(c*10^(n-1)) - 10*floor(c*10^(n-2)), where c = Gamma(1/4)/Gamma(3/4).
%e A401132 2.958675119188638892310821357727719566474898196057982530656292...
%p A401132 Digits := 130:
%p A401132 c := evalf(GAMMA(1/4)/GAMMA(3/4)):
%p A401132 seq(floor(c*10^(n-1))-10*floor(c*10^(n-2)), n=1..87);
%t A401132 RealDigits[N[Gamma[1/4]/Gamma[3/4], 130], 10, 87][[1]]
%o A401132 (Python)
%o A401132 from mpmath import mp
%o A401132 mp.dps = 130
%o A401132 n = 87
%o A401132 c = mp.gamma(mp.mpf(1)/4) / mp.gamma(mp.mpf(3)/4)
%o A401132 digits = str(int(mp.floor(c * 10**(n-1))))
%o A401132 print(", ".join(digits))
%Y A401132 Cf. A014549, A062539, A091670.
%K A401132 nonn,cons,new
%O A401132 1,1
%A A401132 _William Steinmetz_, Oct 15 2026
