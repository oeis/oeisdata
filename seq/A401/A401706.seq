%S A401706 1,1,1,1,1,2,1,1,1,2,1,4,1,2,3,1,1,2,1,4,1,2,1,8,1,2,1,4,1,6,1,1,3,2,
%T A401706 1,1,1,2,1,8,1,2,1,4,9,2,1,16,1,1,3,4,1,2,1,8,1,2,1,12,1,2,1,1,1,6,1,
%U A401706 4,3,2,1,8,1,2,1,4,1,2,1,16,1,2,1,4,1,2,3,8,1,18,7,4,1,2,5,32,1,1,9,1,1,6,1,8,3
%N A401706 a(n) = n / A401705(n).
%H A401706 Antti Karttunen, <a href="/A401706/b401706.txt">Table of n, a(n) for n = 1..10000</a>
%H A401706 <a href="/index/Si#SIGMAN">Index entries for sequences related to sigma(n)</a>.
%o A401706 (PARI)
%o A401706 A401705(n) = { my(f=factor(n),d=1,u); forstep(i=#f~,1,-1,u = (f[i,1]^f[i,2])*d; if(1==gcd(sigma(u),u), d = u)); (d); };
%o A401706 A401706(n) = (n / A401705(n));
%Y A401706 Cf. A401705.
%Y A401706 Cf. A401704 (positions where differs from A401708).
%K A401706 nonn,easy,new
%O A401706 1,6
