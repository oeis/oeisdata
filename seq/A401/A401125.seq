%I A401125 #26 Nov 25 2026 20:02:45
%S A401125 1,0,1,0,1,1,1,1,2,1,3,4,3,3,1,8,13,10,6,4,1,22,39,35,20,10,5,1,62,
%T A401125 119,116,75,35,15,6,1,178,369,387,271,140,56,21,7,1,519,1157,1303,978,
%U A401125 546,238,84,28,8,1,1533,3660,4410,3541,2114,994,378,120,36,9,1
%N A401125 Triangle read by rows: T(n,k) is the number of Dyck paths of semilength n with exactly k symmetric peaks, 0 <= k <= n.
%C A401125 A peak of a Dyck path is symmetric if the maximal mountain U^i D^j containing it satisfies i = j. Here U = (1,1) and D = (1,-1).
%H A401125 Alois P. Heinz, <a href="/A401125/b401125.txt">Rows n = 0..140, flattened</a>
%H A401125 Sergey Elizalde, <a href="https://doi.org/10.1016/j.disc.2021.112364">Symmetric peaks and symmetric valleys in Dyck paths</a>, Discrete Mathematics 344 (2021), 112364.
%H A401125 Rigoberto Flórez and José Luis Ramírez, <a href="https://doi.org/10.1016/j.disc.2020.112118">Enumerating symmetric and asymmetric peaks in Dyck paths</a>, Discrete Mathematics 343 (2020), 112118.
%F A401125 T(n,0) = A188464(n-3) for n >= 3.
%F A401125 Sum_{k=0..n} k*T(n,k) = A401646(n).
%F A401125 G.f.: Sum_{n>=0} Sum_{k=0..n} T(n,k)*t^k*z^n = (1-z)*(1-t*z-(t-1)*z^2-sqrt((1-z)*(1-(3+2*t)*z+ (t^2+4*t-1)*z^2-(t-1)^2*z^3)))/(2*z*(1-t*z)^2).
%e A401125 The five Dyck paths of semilength 3 are UUUDDD, UUDUDD, UUDDUD, UDUUDD and UDUDUD. They have respectively 1, 0, 2, 2 and 3 symmetric peaks. Thus row 3 is 1, 1, 2, 1.
%e A401125 Triangle T(n,k) begins:
%e A401125      1;
%e A401125      0,    1;
%e A401125      0,    1,    1;
%e A401125      1,    1,    2,    1;
%e A401125      3,    4,    3,    3,    1;
%e A401125      8,   13,   10,    6,    4,   1;
%e A401125     22,   39,   35,   20,   10,   5,   1;
%e A401125     62,  119,  116,   75,   35,  15,   6,   1;
%e A401125    178,  369,  387,  271,  140,  56,  21,   7,  1;
%e A401125    519, 1157, 1303,  978,  546, 238,  84,  28,  8, 1;
%e A401125   1533, 3660, 4410, 3541, 2114, 994, 378, 120, 36, 9, 1;
%e A401125   ...
%p A401125 p:= proc(n) option remember; expand(`if`(n<5, [1, z, z+z^2,
%p A401125       1+z+2*z^2+z^3, 3+4*z+3*z^2+3*z^3+z^4][n+1], (p(n-1)*
%p A401125         (3*n*z+4*n+z-3)+(-3*n*z^2-10*n*z-2*n+z^2+13*z+7)*p(n-2)+
%p A401125         (n*z^3+8*n*z^2+4*n*z-z^3-16*z^2-16*z+1)*p(n-3)+
%p A401125         (-2*n*z^3-3*n*z^2+2*n*z-n+6*z^3+15*z^2-13*z+6)*p(n-4)+
%p A401125          z*(n-5)*(z-1)^2*p(n-5))/(n+1)))
%p A401125     end:
%p A401125 T:= (n, k)-> coeff(p(n), z, k):
%p A401125 seq(seq(T(n, k), k=0..n), n=0..10);  # _Alois P. Heinz_, Nov 18 2026
%t A401125 delta = (1 - z) (1 - (3 + 2 t) z + (t^2 + 4 t - 1) z^2 - (t - 1)^2 z^3);
%t A401125 gf = (1 - z) (1 - t z - (t - 1) z^2 - Sqrt[delta])/(2 z (1 - t z)^2);
%t A401125 triangle[m_Integer?NonNegative] := Module[{series}, series = Normal[Series[gf, {z, 0, m}]]; Table[Coefficient[Coefficient[series, z, n], t, k], {n, 0, m}, {k, 0, n}]];
%t A401125 Flatten[triangle[10]]
%Y A401125 Row sums give A000108.
%Y A401125 Cf. A188464, A401646.
%K A401125 nonn,tabl,new
%O A401125 0,9
%A A401125 _José Luis Ramírez Ramírez_, Nov 12 2026
