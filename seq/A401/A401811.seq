%I A401811 #10 Nov 13 2026 21:05:36
%S A401811 1,0,1,1,0,1,1,5,0,1,3,5,21,0,1,6,51,21,85,0,1,15,118,819,85,341,0,1,
%T A401811 36,715,1974,13107,341,1365,0,1,91,2400,39675,31926,209715,1365,5461,
%U A401811 0,1,232,12075,152784,2432955,512182,3355443,5461,21845,0,1
%N A401811 Array read by ascending antidiagonals: T(n, k) is the coefficient of x^n in (1 - ((1 - (2^k + 1)*x) / (1 + (2^k - 1)*x))^(2^(-k))) / (2*x) for n >= 0, k >= 1.
%H A401811 Dmytro Dmitrishin, <a href="https://doi.org/10.13140/RG.2.2.14652.60804">On a Generalization of the Riordan Numbers</a>, ResearchGate, September 2026.
%F A401811 G.f. for column k: (1 - ((1 - (2^k + 1)*x) / (1 + (2^k - 1)*x))^(2^(-k))) / (2*x).
%F A401811 T(n,k) = (n-1)*(2*T(n-1,k) + (4^k-1)*T(n-2,k))/(n+1) for n >= 2, with T(0,k)=1, T(1,k)=0.
%F A401811 T(n, k) = -(1/2) * Sum_{j=0..n+1} ( binomial(2^(-k), j) * binomial(-2^(-k), n-j+1) * (-2^k-1)^j * (2^k-1)^(n-j+1) ).
%e A401811 The array T(n,k) (with n >= 0, k >= 1) begins:
%e A401811 ==================================================
%e A401811 n \ k |   1       2       3       4       5
%e A401811 --------------------------------------------------
%e A401811 n = 0 |   1       1       1       1       1
%e A401811 n = 1 |   0       0       0       0       0
%e A401811 n = 2 |   1       5      21      85     341
%e A401811 n = 3 |   1       5      21      85     341
%e A401811 n = 4 |   3      51     819   13107  209715
%e A401811 n = 5 |   6     118    1974   31926  512182
%p A401811 T := proc (nn, kk) local x, G, S: G := (1/2)*(1-((1-(2^kk+1)*x)/(1+(2^kk-1)*x))^(2^(-kk)))/x: S := series(G, x = 0, nn+2): return coeff(S, x, nn) end proc: out_list := []: max_diag := 10: for d to max_diag do for kk to d do n := d-kk: out_list := [op(out_list), T(n, kk)] end do end do: StringTools:-Join(map(convert, out_list, string), ", ");
%Y A401811 Cf. A005043 (k=1), A400445 (k=2), A002450 (n=2, 3), A182512 (n=4).
%K A401811 nonn,tabl,easy,new
%O A401811 0,8
%A A401811 _Dmytro Dmytryshyn_, Nov 06 2026
