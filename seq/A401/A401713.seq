%I A401713 #6 Nov 05 2026 20:12:25
%S A401713 1,2,3,4,3,5,3,6,7,8,3,9,3,8,10,11,3,9,3,12,10,8,3,13,7,8,14,12,3,15,
%T A401713 3,16,10,8,10,17,3,8,10,18,3,15,3,12,19,8,3,20,7,12,10,12,3,21,10,18,
%U A401713 10,8,3,22,3,8,19,23,10,15,3,12,10,24,3,25,3,8,19,12,10,15,3,26,27,8,3,22,10,8,10,18,3,22,10,12,10,8,10,28,3
%N A401713 Lexicographically earliest infinite sequence such that a(i) = a(j) => A046523(i) = A046523(j) and A055881(i) = A055881(j), for all i, j >= 1, where A046523(n) is the smallest number with same prime signature as n, and A055881(n) is the largest m such that m! divides n.
%C A401713 Restricted growth sequence transform of A286143, or equally, of the ordered pair [A046523(n), A055881(n)].
%C A401713 For all i, j >= 1: A305801(i) = A305801(j) => a(i) = a(j).
%H A401713 Antti Karttunen, <a href="/A401713/b401713.txt">Table of n, a(n) for n = 1..65537</a>
%o A401713 (PARI)
%o A401713 up_to = 65537;
%o A401713 rgs_transform(invec) = { my(om = Map(), outvec = vector(length(invec)), u=1); for(i=1, length(invec), if(mapisdefined(om,invec[i]), my(pp = mapget(om, invec[i])); outvec[i] = outvec[pp] , mapput(om,invec[i],i); outvec[i] = u; u++ )); outvec; };
%o A401713 A046523(n) = { my(f=vecsort(factor(n)[, 2], , 4), p); prod(i=1, #f, (p=nextprime(p+1))^f[i]); };
%o A401713 A055881(n) = { my(i); i=2; while((0 == (n%i)), n = n/i; i++); return(i-1); }
%o A401713 v401713 = rgs_transform(vector(up_to, n, [A046523(n), A055881(n)]));
%o A401713 A401713(n) = v401713[n];
%Y A401713 Cf. A046523, A055881, A286143, A305801.
%Y A401713 Differs from a similar A328470 first at n=42, where a(42) = 15, while A328470(42) = 19.
%K A401713 nonn,easy,new
%O A401713 1,2
%A A401713 _Antti Karttunen_, Nov 05 2026
