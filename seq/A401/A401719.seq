%I A401719 #16 Nov 08 2026 18:52:57
%S A401719 1,2,4,8,10,15,16,28,32,64,100,128,225,256,512,686,784,1000,1024,2048,
%T A401719 3375,4096,5005,5096,8192,8232,10000,16384,21952,32768,50625,65536,
%U A401719 96228,100000,131072,205821,211288,262144,470596,518616,524288,614656,759375,1000000,1048576,1100736,1411788,2097152,4194304,5619712
%N A401719 Numbers k such that A276085(k) is a multiple of A342001(k) and A003415(k) is a multiple of A276085(k), where A003415 is the arithmetic derivative, and A276085 is fully additive with a(p) = p#/p.
%C A401719 After 1, numbers k such that A342001(k) is a divisor of A276085(k) and A276085(k)/A342001(k) is a divisor of A003557(k).
%H A401719 Antti Karttunen, <a href="/A401719/b401719.txt">Table of n, a(n) for n = 1..97</a>
%H A401719 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%e A401719 1 is a term as A003415(1) = A342001(1) = A276085(1) = 0, and 0 is a multiple of 0.
%e A401719 225 is a term as A003415(225) = 240, A342001(225) = A276085(225) = 16, and 16 is a multiple of 16, and 240 is a multiple of 16 also.
%e A401719 5005 is a term as A003415(5005) = A342001(5005) = A276085(5005) = 2556, and 2556 is a multiple of 2556.
%o A401719 (PARI)
%o A401719 A342001(n) = { my(f=factor(n)); (sum(i=1, #f~, f[i, 2]/f[i, 1]) * factorback(f[, 1])); };
%o A401719 A276085_mod_m(n,m) = if(1==n,0,my(f = factor(n),lp=f[#f~,1],pr=1,s=0,k=1); forprime(p=2,lp,if(f[k,1]==p, s += f[k,2]*pr; s %= m; k++); pr *= p; pr %= m); (s));
%o A401719 A276085(n) = { my(f = factor(n)); sum(k=1, #f~, f[k, 2]*prod(i=1,primepi(f[k, 1]-1),prime(i))); };
%o A401719 is_A401719(k) = if(1==k, 1, my(w=A342001(k)); if(A276085_mod_m(k,w)>0, 0, !(A003557(k)%(A276085(k)/w)))); \\ This is still quite slow.
%Y A401719 Cf. A003415, A003557, A276085, A342001.
%Y A401719 Intersection of A373490 and A401725.
%Y A401719 Subsequences: A369650, A401726 (terms that have no p^p factors).
%K A401719 nonn,new
%O A401719 1,2
%A A401719 _Antti Karttunen_, Nov 08 2026
