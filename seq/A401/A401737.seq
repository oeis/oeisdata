%I A401737 #4 Nov 10 2026 13:49:48
%S A401737 0,1,3,6,12,22,28,47,102,118,239,455,742,983,1263,1779,2398,2866,3501,
%T A401737 4088,5335,6010,7071,9035,10183,11609,13204,15026,17919,19409,22102,
%U A401737 24297,27410,30279
%N A401737 Least k such that A401736(k) = n.
%C A401737 Also the positions of successive records of A401736. Each new record exceeds the preceding record by 1, since every smaller color has an earlier diagonal witness. Thus a(n) is strictly increasing on its domain.
%C A401737 Conjecture: a(n) exists for every n. By the preceding no-skips property, this is equivalent to the conjecture that A401736 is unbounded.
%C A401737 Conjecture: a(n) is also the least m such that color n occurs in the square [0,m]^2 of A401735, and (a(n),a(n)) is the only cell of color n in [0,a(n)]^2. This follows from the conjecture in A401735 and holds for n <= 33 (for n >= 28 by one computation only).
%C A401737 All terms come from the diagonal through n = 32769, computed by two separate programs. If a(34) exists, then a(34) > 32769.
%e A401737 a(3) = 6 because A401736(0)..A401736(6) = 0,1,1,2,1,2,3.
%o A401737 (Python)
%o A401737 def A(N):  # [A401736(0), ..., A401736(N-1)], A401736(n) = T(n,n)
%o A401737     T = [[0]*N for _ in range(N)]  # T[y][x] = T(x,y), filled row by row
%o A401737     for y in range(N):
%o A401737         for x in range(N):
%o A401737             s = {T[y][x-d] for d in range(1, min(x, y)+1) if T[y][x-d] == T[y-d][x] == T[y-d][x-d]}
%o A401737             T[y][x] = min(set(range(len(s)+1)) - s)
%o A401737     return [T[n][n] for n in range(N)]
%o A401737 d = A(130); print([d.index(c) for c in range(max(d)+1)])
%o A401737 (Python)
%o A401737 def A(N):  # [A401736(0), ..., A401736(N-1)], A401736(n) = T(n,n)
%o A401737     # Masks hold colors c >= 1 only; color-0 slots stay empty.
%o A401737     R = [[0] for _ in range(N)]  # Bit N-1-j in R[i][c] means T(i,j)=c.
%o A401737     S = [[0] for _ in range(2*N-1)]  # Bit j in S[s][c] means T(s-j,j)=c.
%o A401737     a = [0]*N
%o A401737     for x in range(1, N):
%o A401737         r, bx, rx = R[x], 1 << x, 1 << (N-1-x)
%o A401737         # T(x,y)=0 iff x & y == 0; see the proof in A401735.
%o A401737         zero, bit = 1, 1
%o A401737         while bit <= x:
%o A401737             if not x & bit:
%o A401737                 zero |= zero << bit
%o A401737             bit <<= 1
%o A401737         left = ((1 << (x+1))-1) ^ zero
%o A401737         c = 1
%o A401737         # Process colors in order, leftmost admissible cell first.
%o A401737         # All smaller colors are excluded at cells left: hence mex.
%o A401737         while left:
%o A401737             if c == len(r):
%o A401737                 for v in R+S:
%o A401737                     v.append(0)
%o A401737             available = left
%o A401737             while available:
%o A401737                 bit = available & -available
%o A401737                 y = bit.bit_length()-1
%o A401737                 left ^= bit
%o A401737                 r[c] |= 1 << (N-1-y)
%o A401737                 # Symmetry: T(y,x)=T(x,y); transpose the recurrence.
%o A401737                 R[y][c] |= rx
%o A401737                 s = S[x+y]
%o A401737                 s[c] |= bit | bx
%o A401737                 e = N-1-x-y
%o A401737                 q = R[y][c]
%o A401737                 # Remove this cell and later cells making a square of color c.
%o A401737                 available &= ~(s[c] & (q >> e if e >= 0 else q << -e))
%o A401737                 if y == x:
%o A401737                     a[x] = c
%o A401737             c += 1
%o A401737     return a
%o A401737 # Prints a(0), ..., a(15), the first 16 DATA terms.
%o A401737 d = A(2000); print([d.index(c) for c in range(max(d)+1)])
%Y A401737 Cf. A401735 (array), A401736 (diagonal).
