%S A401242 0,1,3,3,4,5,6,7,9,13,15,15,15,17,20,22,23,25,28,31,34,37,39,42,44,46,
%T A401242 49,53,57,61,62,64,65,65,65,67,68,69,69,70,71,76,78,81,88,97,106,115,
%U A401242 124,131,137,142,147,153,159,167,174,182,190,198,207,217,227
%N A401242 Maximum entry in the n-th row of A032531 read as a triangle.
%C A401242 This sequence is trivially infinite and nondecreasing. There exists a plateau at a(n)=42877 from n=2137 to 7078, followed by continued increase. As A107263 contains at least one value equal to zero, this sequence diverges to infinity.
%H A401242 Yifeng Zou, <a href="/A401242/b401242.txt">Table of n, a(n) for n = 0..10000</a>
%e A401242 For n=3, a(3)=3, as row 3 of A032531 consists of 2,3,1,2, of which 3 is the maximum.
%o A401242 (Python)
%o A401242 from collections import Counter
%o A401242 def row_maxima_A032531(n):
%o A401242     counts = Counter()
%o A401242     result = []
%o A401242     for row in range(n + 1):
%o A401242         maximum = 0
%o A401242         for k in range(row + 1):
%o A401242             value = counts[k]
%o A401242             maximum = max(maximum, value)
%o A401242             counts[value] += 1
%o A401242         result.append(maximum)
%o A401242     return result
%o A401242 print(row_maxima_A032531(62))
%Y A401242 Cf. A032531, A107263.
%K A401242 nonn,new
%O A401242 0,3
