%S A401366 2,4,5,6,10,11,16,16,23,24,32,31,42,42,53,52,66,65,80,78,95,94,112,
%T A401366 107,130,128,149,146,170,161,192,188,215,212,240,235,266,262,293,288,
%U A401366 322,311,352,346,383,378,416,403,450,444,485,478,522,515,560,552,599
%N A401366 Number of distinct adjacency eigenvalues of the honeycomb lattice on an n X n torus (2*n^2 vertices).
%C A401366 The adjacency eigenvalues are +-|1 + w^j + w^k| with w = exp(2*Pi*i/n), 0 <= j,k <= n-1.
%C A401366 The eigenvalue 0 occurs if and only if 3 divides n, since three complex numbers of absolute value 1 sum to 0 only when they form an equilateral triangle.
%C A401366 For n = 1 the graph is two vertices joined by three parallel edges; for n = 2 it is the cube graph Q_3. The spectral description above is used for all n.
%C A401366 In the nearest-neighbor tight-binding model of graphene the energy levels are proportional to these eigenvalues.
%D A401366 J. H. Conway and A. J. Jones, Trigonometric diophantine equations (On vanishing sums of roots of unity), Acta Arithmetica 30 (1976), 229-240.
%D A401366 P. R. Wallace, The Band Theory of Graphite, Phys. Rev. 71 (1947), 622-634.
%F A401366 a(n) = 2*d(n) - [3|n], where d(n) is the number of distinct values of 3 + 2*cos(2*Pi*j/n) + 2*cos(2*Pi*k/n) + 2*cos(2*Pi*(j-k)/n), 0 <= j,k <= n-1, and [ ] is the Iverson bracket.
%e A401366 For n = 2, w = -1 and |1 + w^j + w^k| takes the values 3 and 1, so the eigenvalues are 3, 1, -1, -3 and a(2) = 4.
%o A401366 (Python)
%o A401366 from sympy import cyclotomic_poly, Poly, symbols
%o A401366 def a(n):
%o A401366     z = symbols('z'); P = Poly(cyclotomic_poly(n, z), z)
%o A401366     def red(exps):
%o A401366         c = [0]*n
%o A401366         for e in exps: c[e % n] += 1
%o A401366         return tuple(Poly(c[::-1], z).rem(P).all_coeffs())
%o A401366     s = {red([0,0,0,j,-j,k,-k,j-k,k-j]) for j in range(n) for k in range(j, n)}
%o A401366     return 2*len(s) - (red([]) in s)
%o A401366 (PARI) a(n) = my(P=polcyclo(n,x), e(m)=x^(m%n), S=List()); for(j=0, n-1, for(k=j, n-1, listput(S, lift(Mod(3+e(j)+e(-j)+e(k)+e(-k)+e(j-k)+e(k-j), P))))); S=Set(S); 2*#S - #select(v->v==0, S)
%Y A401366 Cf. A395911, A399677.
