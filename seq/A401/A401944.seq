%I A401944 #6 Nov 15 2026 17:22:44
%S A401944 2,3,4,12,18,24,64,81,96,192,243,486,512,1296,1536,1944,2304,2916,
%T A401944 15552,16384,18432,26244,82944,221184,393216,944784,3145728,7962624,
%U A401944 21233664,28697814,63700992,191102976,229582512,339738624,573308928,1033121304,1088391168
%N A401944 3-smooth numbers k > 1 such that 3*k^2 - 3*k + 1 is prime.
%C A401944 Intersection of A002504 and A003586.
%C A401944 For these k, the prime p = 3*k^2 - 3*k + 1 has a Pocklington N-1 primality certificate, because 3*k divides p - 1 and (3*k)^2 > p.
%H A401944 Hassane Bakkaoui, <a href="/A401944/b401944.txt">Table of n, a(n) for n = 1..63</a>
%H A401944 Hassane Bakkaoui, <a href="https://arxiv.org/abs/2606.18859">Unconditional Primality Certificates for the Hexagonal 3-smooth Family p=3m(m+1)+1: Deterministic Pocklington Witnesses and Arithmetic Filters</a>, arXiv:2606.18859 [math.GM], 2026.
%e A401944 12 is a term because 12 = 2^2*3 and 3*12^2 - 3*12 + 1 = 397 is prime.
%o A401944 (PARI) lista(kmax)=my(v=List()); for(a=0, logint(kmax, 2), my(k=2^a); while(k<=kmax, if(k>1 && isprime(3*k^2-3*k+1), listput(v, k)); k*=3)); vecsort(Vec(v)) \\ terms <= kmax
%o A401944 (Python)
%o A401944 from sympy import isprime
%o A401944 def a_list(kmax):  # terms <= kmax
%o A401944     out = []
%o A401944     t2 = 1
%o A401944     while t2 <= kmax:
%o A401944         k = t2
%o A401944         while k <= kmax:
%o A401944             if k > 1 and isprime(3*k*k - 3*k + 1):
%o A401944                 out.append(k)
%o A401944             k *= 3
%o A401944         t2 *= 2
%o A401944     return sorted(out)
%Y A401944 Cf. A002407, A002504, A003586, A401943 (the corresponding primes).
%K A401944 nonn,new
%O A401944 1,1
%A A401944 _Hassane Bakkaoui_, Nov 09 2026
