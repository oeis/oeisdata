%I A401386 #40 Nov 03 2026 00:04:07
%S A401386 20,39,98,507,693,1386,2379,6591,13167,26334,29511,105336,119164,
%T A401386 129032,148955,230763,235298,595820,1672209,3344418,8852259,13377672,
%U A401386 212370543,424741086,731287947
%N A401386 Numbers k, not powers of primes, for which {the largest divisor of sigma(k^2) that is coprime with k^2} is a prime power.
%C A401386 See comments in A401388 (the squares of these terms) for the significance of this sequence.
%C A401386 a(26) <= 2317451504043 = 3 * 13 * 61 * 97 * 3169^2.
%H A401386 <a href="/index/Si#SIGMAN">Index entries for sequences related to sigma(n)</a>.
%F A401386 {k such that A010055(k) = 0 and A401380(k) = 1}.
%F A401386 {k > 1 such that A010055(k) = 0 and A010055(A401375(k^2)) = 1}.
%e A401386   The first 12 odd terms factored:                        A401375(k^2)
%e A401386   --------------------------------------------------------------------
%e A401386          39 = 3 * 13                                               61
%e A401386         507 = 3 * 13^2                  = 13*39                 30941
%e A401386         693 = 3^2 * 7 * 11                                       19^2
%e A401386        2379 = 3 * 13 * 61               = 61*39                    97
%e A401386        6591 = 3 * 13^3                  = 13 * 507            5229043
%e A401386       13167 = 3^2 * 7 * 11 * 19         = 19*693                  127
%e A401386       29511 = 3^3 * 1093                                       398581
%e A401386      148955 = 5 * 31^3                                      917087137
%e A401386      230763 = 3 * 13 * 61 * 97          = 97*2379                3169
%e A401386     1672209 = 3^2 * 7 * 11 * 19 * 127   = 127*13167              5419
%e A401386     8852259 = 3 * 13 * 61^3             = 61^2 * 2379     52379047267
%e A401386   212370543 = 3^2 * 7 * 11 * 19 * 127^2 = 127*1677209       262209281
%e A401386 .
%e A401386 Thus, both 39 and 693 form "seeds" around which other factors can accrete (see A401391 and A401392), while there are also "spontaneously emerging" terms like 29511 and 148955.
%t A401386 okQ[k_]:=!PrimePowerQ[k]&&PrimePowerQ[Select[Divisors[DivisorSigma[1,k^2]],CoprimeQ[#,k^2]&][[-1]]];Select[Range[300000],okQ] (* _James C. McMahon_, Nov 02 2026 *)
%o A401386 (PARI) is_A401386(n) = { my(fct=factor(n)); if(#fct~ < 2, 0, for(i=1,#fct~,fct[i,2] <<= 1); my(f=factorback(fct[, 1]), g=factorback(factor(sigma(fct))[, 1])); isprime(g/gcd(f,g))); };
%Y A401386 Intersection of A024619 and A401385.
%Y A401386 Cf. A000203, A010055, A401375, A401379, A401380, A401388 [= a(n)^2], A401391.
%Y A401386 Terms A401392(1..5): 39, 2379, 230763, 731287947, 2448773999701419 are all included in this sequence.
%K A401386 nonn,hard,more,new
%O A401386 1,1
%A A401386 _Antti Karttunen_, Oct 31 2026
