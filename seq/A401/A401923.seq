%S A401923 0,1,2,4,6,8,12,13,16,18,24,30,32,36,44,60,64,72,88,90,92,108,120,121,
%T A401923 144,150,164,180,184,206,210,212,216,217,222,224,240,244,252,272,296,
%U A401923 300,312,316,372,392,397,420,421,424,426,432,444,446,448,452,453,480,482,504,516,524,544,600,606,617,624,626,630
%N A401923 Numbers k such that A342002(k) is a multiple of A276150(k).
%H A401923 Antti Karttunen, <a href="/A401923/b401923.txt">Table of n, a(n) for n = 1..16722</a>
%H A401923 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%o A401923 (PARI)
%o A401923 A276150(n) = { my(s=0, p=2, d); while(n, d = (n%p); s += d; n = (n-d)/p; p = nextprime(1+p)); (s); };
%o A401923 A342002(n) = { my(s=0, p=2); while(n, s += ((n%p)/p); n = n\p; p = nextprime(1+p)); numerator(s); };
%o A401923 is_A401923(k) = (0==k || 0==(A342002(k)%A276150(k)));
%Y A401923 Cf. A049345, A276150, A342002.
%Y A401923 Cf. A060735 (subsequence).
%K A401923 nonn,base,new
%O A401923 1,3
%A A401923 _Antti Karttunen_, Nov 19 2026
