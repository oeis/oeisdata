%T A401212 59713376992886784,296943715530766811136,3264667872676969025896448,
%U A401212 78661384088990322774996156416,4120943083372225397765058460647424,466236447472265393853437412093728915456,113266814151646540160473374646851553793671168
%N A401212 Total number of undirected cycles in all labeled graphs on n vertices.
%H A401212 Andrew Howroyd, <a href="/A401212/b401212.txt">Table of n, a(n) for n = 1..50</a>
%H A401212 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/GraphCycle.html">Graph Cycle</a>.
%F A401212 a(n) = Sum_{k=3..n} binomial(n,k) * (k-1)! * 2^(binomial(n,2)-k-1).
%F A401212 a(n) ~ sqrt(Pi) * 2^((n^2-3*n-1)/2) * n^(n - 1/2) / exp(n-2). - _Vaclav Kotesovec_, Oct 25 2026
%t A401212 A401212[n_] := Sum[Binomial[n, k]*(k - 1)!*2^(# - k - 1), {k, 3, n}] & [Binomial[n, 2]];
%t A401212 Array[A401212, 15] (* _Paolo Xausa_, Oct 18 2026 *)
%o A401212 (PARI) a(n)=sum(k=3, n, binomial(n,k)*(k-1)!*2^(binomial(n,2)-k-1))
%Y A401212 Cf. A234601 (unlabeled), A401179, A401213 (paths).
%K A401212 nonn,easy,new
%O A401212 1,4
%A A401212 _Andrew Howroyd_, Oct 18 2026
