%I A401734 #9 Nov 09 2026 21:59:52
%S A401734 1,1,1,2,1,2,1,2,2,2,1,2,1,2,2,3,1,2,1,2,2,2,1,2,2,2,2,2,1,2,1,2,2,2,
%T A401734 2,4,1,2,2,2,1,2,1,2,2,2,1,2,2,2,2,2,1,2,2,2,2,2,1,3,1,2,2,4,2,2,1,2,
%U A401734 2,2,1,2,1,2,2,2,2,2,1,2,3,2,1,3,2,2,2,2
%N A401734 Number of factorizations of n into factors that have the same prime signature.
%C A401734 First differs from A401733 at n = 48: a(48) = 2, while A401733(48) = 3.
%C A401734 a(n) depends only on the prime signature of n (A118914).
%H A401734 Amiram Eldar, <a href="/A401734/b401734.txt">Table of n, a(n) for n = 1..10000</a>
%F A401734 a(n) <= A401733(n). Inequality occurs for n = 48, 80, 112, 120, 162, 168, 176, 208, ... .
%F A401734 a(p^e) = A000005(k) for k >= 1 and any prime p.
%F A401734 a(n) = A038041(A001221(n)) for squarefree n.
%e A401734      n | a(n) | factorizations
%e A401734   -----|------|----------------------------------------------------------
%e A401734      1 |    1 | 1
%e A401734      4 |    2 | 4, 2*2
%e A401734     16 |    3 | 16, 4*4, 2*2*2*2
%e A401734     36 |    4 | 36, 6*6, 4*9, 2*2*3*3
%e A401734    210 |    5 | 210, 6*35, 10*21, 14*15, 2*3*5*7
%e A401734   3600 |    6 | 3600, 36*100, 60*60, 4*4*9*25, 6*6*10*10, 2*2*2*2*3*3*5*5
%e A401734 a(48) = 2 since 48 has 2 factorizations into factors that have the same prime signature: 48 and 2*2*2*2*3. A401733(48) = 3 since 48 has an additional factorization, 6*8, with 6 and 8 having the same number of divisors (4) but different signatures (6 = 2*3, 8 = 2^3).
%t A401734 psig[n_] := Sort[FactorInteger[n][[;; , 2]]];
%t A401734 a[n_] := Count[f[n], _?(Equal @@ (psig /@ #) &)]; Array[a, 88] (* using the function f by _T. D. Noe_ at A162247 *)
%Y A401734 Cf. A000005, A001221, A005117, A038041, A118914, A162247, A322794, A401733.
%K A401734 nonn,easy,new
%O A401734 1,4
%A A401734 _Amiram Eldar_, Nov 03 2026
