%I A401004 #11 Oct 24 2026 21:32:12
%S A401004 725,12337,28033,142129,280645,371501,856745,1209325,2264825,4000105,
%T A401004 5316085,5518741,7473149,7572017,14958893,18404629,22307345,28522337,
%U A401004 30828101,41160145,40244933,65498809,71932925,80209861,88835905,106008865,120080885,128311625
%N A401004 Square roots of the central entries in a six-square 3 X 3 magic-square construction from Pythagorean primes using a Pell-type recurrence.
%C A401004 For p = A002144(n), let q = A401003(n) and Q = a(n) = p^2*q.
%C A401004 There are unique integers x > y > 0 such that p = x^2 + y^2.
%C A401004 Let u = x^2 - y^2, v = 2*x*y, h = p*q, C = Q^2, X + i*Y = (u + i*v)*(2*x^2 + i*(x+y)^2)^2, d = 2*u*v*h^2, e = 2*X*Y, F = x*(x+y)*p^2 - y*(x-y)*q^2.
%C A401004 If e > 0, use the array with rows
%C A401004   [C+d,   C-d-e, C+e],
%C A401004   [C-d+e, C,     C+d-e],
%C A401004   [C-e,   C+d+e, C-d].
%C A401004 If e < 0, use the array with rows
%C A401004   [C+e,     C+d, C-d-e],
%C A401004   [C-d-2*e, C,   C+d+2*e],
%C A401004   [C+d+e,   C-d, C-e].
%C A401004 The case e = 0 does not occur. In either case the array is a 3 X 3 magic square with magic sum 3*C. The six entries C+d, C-d, C+e, C-e, C-d-e and C are respectively (h*(u+v))^2, (h*(u-v))^2, (X+Y)^2, (X-Y)^2, F^2 and Q^2.
%C A401004 All nine entries are positive and distinct; see the linked note for the proof. The construction works whether q is prime or composite.
%C A401004 The terms are listed in increasing order of p, not in increasing order of Q.
%C A401004 Since gcd(p,q) = 1, Q is the square of one prime times a different prime exactly when the corresponding p belongs to A401002.
%C A401004 For background on 3 X 3 magic squares with six square entries, see Morgenstern's discussion of Euler's formulas and Boyer's work linked below.
%H A401004 Edward Schmidt, <a href="/A401004/b401004.txt">Table of n, a(n) for n = 1..2549</a>
%H A401004 Christian Boyer, <a href="http://www.multimagie.com/English/SquaresOfSquares.htm">Magic squares of squares</a>.
%H A401004 Christian Boyer, <a href="https://doi.org/10.1007/BF02985794">Some notes on the magic squares of squares problem</a>, The Mathematical Intelligencer, 27 (2005), 52-64.
%H A401004 Christian Boyer, <a href="http://www.multimagie.com/English/SquaresOfSquaresSearch.htm">Latest research on the "3x3 magic square of squares" problem</a>.
%H A401004 Lee Morgenstern, <a href="http://www.multimagie.com/English/Morgenstern14.htm">Euler's Formulas for 3x3 Magic Squares of 6 Squares</a>, December 2011.
%H A401004 Edward Schmidt, <a href="/A400365/a400365.txt">Fourth powers of Pythagorean legs and a magic square with six squares</a>.
%H A401004 Edward Schmidt, <a href="/A401004/a401004.txt">Pythagorean primes, a Pell-type recurrence and a magic square with six squares</a>.
%F A401004 a(n) = A002144(n)^2*A401003(n).
%e A401004 For p = 5, q = 5^2 + 2^2 = 29 and a(1) = 5^2*29 = 725. Here e < 0, and the construction gives
%e A401004   [   263^2, 1015^2,   691^2 ]
%e A401004   [  933937,  725^2,  117313 ]
%e A401004   [  573769,  145^2,   991^2 ]
%e A401004 Every row, column and diagonal sums to 3*725^2 = 1576875. All nine entries are positive and distinct, and exactly six of them are squares.
%e A401004 For p = 29, q = 12^2 + 5^2 = 169 is composite and a(4) = 29^2*169 = 142129; the same construction again gives a magic square with six square entries.
%o A401004 (Python)
%o A401004 from math import isqrt
%o A401004 from sympy import primerange
%o A401004 def a401004(limit=300):
%o A401004     # Return terms for hypotenuses p < limit.
%o A401004     out = []
%o A401004     for p in primerange(5, limit):
%o A401004         if p % 4 != 1:
%o A401004             continue
%o A401004         for y in range(1, isqrt(p // 2) + 1):
%o A401004             x = isqrt(p - y*y)
%o A401004             if x*x + y*y == p:
%o A401004                 out.append(p*p*((2*x + y)**2 + x*x))
%o A401004                 break
%o A401004     return out
%Y A401004 Cf. A000129, A002144, A400363, A400364, A400365, A401002, A401003.
%K A401004 nonn,easy,new
%O A401004 1,1
%A A401004 _Edward Schmidt_, Oct 17 2026
