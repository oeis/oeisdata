%T A401823 0,1,12,55,150,291,428,429,0,1,14,75,240,551,994,1429,1430,0,1,16,98,
%U A401823 359,945,1974,3424,4861,4862,0,1,18,124,511,1512,3556,7036,11925,16795,16796
%N A401823 Triangle read by rows: T(n,k) is the number of parking permutations avoiding the pattern 312 with lucky set {1,2,...,k}.
%H A401823 Melanie Ferreri and Lucy Martinez, <a href="https://arxiv.org/abs/2611.07267">Pattern avoidance classes of parking permutations with fixed lucky sets</a>, arXiv:2611.07267 [math.CO], 2026.
%F A401823 T(n,k) = (n-k+1)*binomial(n+k,k)/(n+1) - binomial(n-1,k) for k>=1, T(n,0) = A000007(n).
%e A401823 Triangle begins:
%e A401823   1;
%e A401823   0, 1;
%e A401823   0, 1,  2;
%e A401823   0, 1,  4,  5;
%e A401823   0, 1,  6, 13,  14;
%e A401823   0, 1,  8, 24,  41,  42;
%e A401823   0, 1, 10, 38,  85, 131,  132;
%e A401823   0, 1, 12, 55, 150, 291,  428,  429;
%e A401823   0, 1, 14, 75, 240, 551,  994, 1429, 1430;
%e A401823   0, 1, 16, 98, 359, 945, 1974, 3424, 4861, 4862;
%e A401823   ...
%e A401823 For n=5 and k=2, there are 42 permutations that avoid the pattern 312 but only the following 8 permutations are parking permutations whose lucky cars are cars 1 and 2. Such parking permutations are the following: 12345, 13245, 13425, 13452, 21345, 23145, 23415, 23451.
%o A401823 (SageMath)
%o A401823 def p312(n,k):
%o A401823     if k==0: return 0^n
%o A401823     return((n-k+1)/(n+1)*binomial(n+k,k)-binomial(n-1,k))
%o A401823 [[p312(n,k) for k in range(n+1)] for n in range(9)]
%Y A401823 Columns 0..3 are A000007, A057427, A299174(n-1), A140090(n-2).
%Y A401823 Main diagonal is A000108.
%Y A401823 Row sums give A289612.
%Y A401823 Cf. A000272, A401822.
%K A401823 nonn,tabl,easy,new
%O A401823 0,6
