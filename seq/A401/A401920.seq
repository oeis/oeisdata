%T A401920 1728,1744,2196,2228,2304,2928,3072,3125,3904,3920,4096,5103,5888,
%U A401920 6400,6804,9072,9500,11264,12096,16128,16384,16875,19683,21141,21504,22500,22599,26244,28188,28672,30000,30132,34263,34992,37584,40000
%N A401920 Numbers k such that A276085(k) is a multiple of A007947(k), where A276085 is fully additive with a(p) = p#/p, and A007947 is squarefree kernel.
%C A401920 There are no common terms with A401233 (A048103) after 1, because applying A276085 to such terms would yield "numbers k such that A328571(k) divides k" (cf. A401237), but there are no such numbers after 1, as A020639(A328571(n)) = A053669(n) for all n > 0.
%H A401920 Antti Karttunen, <a href="/A401920/b401920.txt">Table of n, a(n) for n = 1..199</a>
%H A401920 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A401920 {k such that A276085(k) == 0 mod A007947(k)}.
%o A401920 (PARI) is_A401920(k) = (0==A401919(k));
%Y A401920 Cf. A007947, A020639, A053669, A276085, A328571.
%Y A401920 Positions of 0's in A401919.
%Y A401920 Subsequence of A401232. After the initial 1, a subsequence of A100716.
%Y A401920 Cf. also A048103, A401233, A401237.
%K A401920 nonn,new
%O A401920 1,2
%A A401920 _Antti Karttunen_, Nov 16 2026
