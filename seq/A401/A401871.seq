%S A401871 2,2,2,2,4,2,2,8,8,2,2,16,27,16,2,2,32,76,76,32,2,2,64,192,261,192,64,
%T A401871 2,2,128,456,757,757,456,128,2,2,256,1045,2003,2423,2003,1045,256,2,2,
%U A401871 512,2344,5035,6931,6931,5035,2344,512,2,2,1024,5186,12286,18643,21043,18643,12286,5186,1024,2
%N A401871 Triangle read by rows: T(n,k) is the number of cliques in the Johnson graph J(n,k).
%C A401871 The cliques in the Johnson graphs consist of the empty vertex set, vertices, edges and for j >= 3, the j-cliques are formed from a j-element subset S of [n] in one of two ways. Given a k-1 element subset of [n] \ S, create j sets by adding one element of S. Also, given a k+1-j element subset of [n] \ S, create j sets by adding all but one element of S. The vertices corresponding to these sets form a clique.
%H A401871 Andrew Howroyd, <a href="/A401871/b401871.txt">Table of n, a(n) for n = 0..1325</a> (rows 0..50)
%H A401871 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Clique.html">Clique</a>.
%H A401871 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/JohnsonGraph.html">Johnson Graph</a>.
%H A401871 Wikipedia, <a href="https://en.wikipedia.org/wiki/Johnson_graph">Johnson graph</a>.
%F A401871 T(n,k) = T(n,n-k).
%F A401871 T(n,k) = 1 + binomial(n,k)*(1 + k*(n-k)/2) + Sum_{j=3..n} binomial(n,j)*(binomial(n-j,k-1) + binomial(n-j,k+1-j)).
%F A401871 T(n,k) = 1 + binomial(n,k)*((2^(k+1)-1)*(n-k)/(k+1) + (2^(n-k+1)-1)*k/(n-k+1) - (n-1) - k*(n-k)/2).
%e A401871 Triangle begins:
%e A401871   2;
%e A401871   2,   2;
%e A401871   2,   4,    2;
%e A401871   2,   8,    8,    2;
%e A401871   2,  16,   27,   16,    2;
%e A401871   2,  32,   76,   76,   32,    2;
%e A401871   2,  64,  192,  261,  192,   64,    2;
%e A401871   2, 128,  456,  757,  757,  456,  128,    2;
%e A401871   2, 256, 1045, 2003, 2423, 2003, 1045,  256,   2;
%e A401871   ...
%t A401871 A401871[n_, k_] := 1 + Binomial[n, k]*((2^(k + 1) - 1)*#/(k + 1) + (2^(# + 1) - 1)*k/(# + 1) - k*#/2 - n + 1) & [n - k];
%t A401871 Table[A401871[n, k], {n, 0, 10}, {k, 0, n}] (* _Paolo Xausa_, Nov 15 2026 *)
%o A401871 (PARI) \\ U(n,k,j) is number of j-cliques in J(n,k).
%o A401871 U(n,k,j) = if(j<=2, if(j==0, 1, binomial(n,k)*if(j==1, 1, k*(n-k)/2)), binomial(n,j)*(binomial(n-j,k-1) + binomial(n-j,k+1-j)))
%o A401871 T(n,k) = sum(j=0, n + (n==0), U(n,k,j))
%o A401871 (PARI) T(n,k) = 1 + binomial(n,k)*((2^(k+1)-1)*(n-k)/(k+1) + (2^(n-k+1)-1)*k/(n-k+1) - (n-1) - k*(n-k)/2)
%Y A401871 Columns k=0..3 are A007395, A000079, A290056, A289837.
%Y A401871 Cf. A007318 (number of vertices), A129533 (number of edges), A401871 (maximal cliques).
