%I A401783 #7 Nov 11 2026 15:18:03
%S A401783 1,87,247,18060,21720,25752,33592,41648,1155840,1388016,1390080,
%T A401783 1648128,2149888,2665472
%N A401783 Numbers k such that psi(k) = phi(k) + Omega(k)^6.
%H A401783 S. I. Dimitrov, <a href="https://github.com/Stoyan16/Numbers-k-such-that-psi-k-phi-k-Omega-k-6/blob/main/A401783">Python program</a> (GitHub).
%e A401783 87 is a term since psi(87) = 120 = 56 + 2^6 = phi(87) + Omega(87)^6.
%o A401783 (PARI) isok(k) = {my(f = factor(k)); prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) - eulerphi(f) == bigomega(f)^6; } \\ _Amiram Eldar_, Nov 05 2026
%Y A401783 Cf. A000010, A001222, A001615, A399541.
%K A401783 nonn,hard,more,new
%O A401783 1,2
%A A401783 _S. I. Dimitrov_, Nov 05 2026
