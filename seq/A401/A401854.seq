%I A401854 #8 Nov 13 2026 18:23:53
%S A401854 2,2,3,2,30,18,126,32,504,430,979,240,1105,2198,6820,2816,78812,7812,
%T A401854 183920,142580,352884,122870,3459591,421188,10828525,334308,81688176,
%U A401854 989212,463347935,5921860,1211061438,26636800,3315517623,187950912,24752893585
%N A401854 Maximum period of cellular automaton rule 45 in a cyclic universe of width n.
%C A401854 The maximum is taken over all 2^n initial configurations, with periodic boundary conditions and synchronous update.
%C A401854 Rules 75, 89 and 101 (obtained from rule 45 by reflection and/or complementation) give the same sequence. In particular, rule 75 is the complement of rule 45, so A334515 gives the period of rule 45 starting from a single 0 cell, while A334508 gives it starting from a single 1 cell.
%C A401854 For odd n the longest cycle typically contains a large fraction of all 2^n states (e.g., about 72% for n = 35), while for even n the maximum period is typically one to two orders of magnitude smaller than for neighboring odd n.
%C A401854 Terms computed by exhaustive search over all initial configurations, using the rotation symmetry to reduce the search to necklaces.
%F A401854 max(A334508(n), A334515(n)) <= a(n) <= A357950(n) <= 2^n.
%F A401854 a(n) = max(A334508(n), A334515(n)) for all n <= 35 except n = 8, 12, 13, 16, 23, 24, 25, 26, 28, 34.
%F A401854 a(n) = A357950(n) for all n <= 35 except n = 3, 4, 8, 16.
%e A401854 For n = 5, the single-cell configuration 00001 lies on a cycle of length 30 under rule 45, and no configuration of width 5 has a longer period, so a(5) = 30.
%e A401854 For n = 8, a single cell reaches a cycle of period 2 (A334508(8) = A334515(8) = 2), but other initial configurations reach a cycle of period 32, so a(8) = 32.
%o A401854 (Python)
%o A401854 def a(n, rule=45):
%o A401854     f = [sum(((rule >> (((s >> ((i+1) % n) & 1) << 2) | (((s >> i) & 1) << 1)
%o A401854                | ((s >> ((i-1) % n)) & 1))) & 1) << i for i in range(n))
%o A401854          for s in range(1 << n)]
%o A401854     best, seen = 0, [0]*(1 << n)
%o A401854     for s in range(1 << n):
%o A401854         path = {}
%o A401854         while not seen[s] and s not in path:
%o A401854             path[s] = len(path); s = f[s]
%o A401854         if s in path: best = max(best, len(path) - path[s])
%o A401854         for t in path: seen[t] = 1
%o A401854     return best
%o A401854 print([a(n) for n in range(1, 17)])
%Y A401854 Cf. A334508 (rule 45, single cell), A334515 (rule 75, single cell), A357950 (all rules), A334497 (rule 30), A204714 (rule 54), A204371 (rule 110).
%K A401854 nonn,more,new
