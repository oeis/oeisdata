%I A401206 #32 Nov 22 2026 15:06:50
%S A401206 8,105719004,77401040908104410,24845630402060641702669818431121505,
%T A401206 1436669252986604046243044745182993372702370706363156398992231559707684
%N A401206 Indices in a greedy approximation to the Marvin Ray Burns (MRB) constant using f(m) = 2*m^(-1/m)*sin(Pi/m)/Pi.
%C A401206 This sequence gives the indices selected by a greedy approximation algorithm for the MRB constant C = Sum_{k>=1} (-1)^k*(k^(1/k)-1) (A037077), using a function arising from a complex-analytic residue construction.
%C A401206 Define f(m) = (2/Pi)*m^(-1/m)*sin(Pi/m), for integers m >= 4.
%C A401206 Start with the remainder r(0) = C. At each step, choose the integer m >= 4 for which f(m) is closest to abs(r(n-1)). Record this integer as a(n), and update the remainder by subtracting sign(r(n-1))*f(a(n)).
%C A401206 First step: C = 0.187859642462067120... . We have f(7) = 0.209182430943..., f(8) = 0.187859661380..., and f(9) = 0.170570869031... . Since f(m) is strictly decreasing and f(8) is closest to C, a(1) = 8. The resulting remainder is r(1) = C - f(8) = -1.891807127880073527...*10^(-8).
%C A401206 Second step: We now seek f(m) closest to abs(r(1)). This occurs at m = 105719004, giving a(2) = 105719004. Since r(1) is negative, we add f(105719004), obtaining r(2) = -2.583944578180195427...*10^(-17).
%C A401206 Third step: Repeating the procedure gives a(3) = 77401040908104410, reducing the absolute remainder to approximately 8.04970519014935*10^(-35).
%C A401206 The construction terminates if a remainder is exactly zero.
%C A401206 Because f(m) is positive and strictly decreasing for integers m >= 4, the minimization can be performed efficiently by finding the two consecutive integers whose function values bracket the magnitude of the current remainder and comparing their distances. Binary search makes this practical even for extremely large indices.
%C A401206 As m tends to infinity, f(m) = 2/m - 2*log(m)/m^2 + O(log(m)^2/m^3).
%C A401206 The first selected term has the exact value f(8) = sqrt(2-sqrt(2))/(2^(3/8)*Pi).
%C A401206 The rapid growth of the indices reflects the increasingly small remainders generated by the greedy construction. The computed terms do not establish whether the MRB constant is rational or irrational.
%D A401206 Richard E. Crandall, "The MRB Constant," in Algorithmic Reflections: Selected Works, PSI Press, 2012, pp. 28-29.
%D A401206 Hugo Duminil-Copin and Stanislav Smirnov, "The connective constant of the honeycomb lattice equals sqrt(2+sqrt(2))," Annals of Mathematics, Vol. 175, No. 3 (2012), pp. 1653-1665.
%D A401206 Steven R. Finch, Mathematical Constants, Cambridge University Press, 2003, pp. 448-452.
%H A401206 Marvin Ray Burns, <a href="https://www.linkedin.com/feed/update/urn:li:activity:7517324258939772928/">From Ramanujan to Greedy: An Invitation Across Fields</a>.
%H A401206 Marvin Ray Burns, <a href="https://www.wolframcloud.com/obj/bmmmburns/Published/A401206.nb">Mathematica program</a>.
%H A401206 Richard E. Crandall, <a href="https://www.marvinrayburns.com/UniversalTOC25.pdf">Unified algorithms for polylogarithm, L-series, and zeta variants</a>.
%H A401206 Hugo Duminil-Copin and Stanislav Smirnov, <a href="https://arxiv.org/abs/1007.0575">The connective constant of the honeycomb lattice equals sqrt(2+sqrt(2))</a>, arXiv:1007.0575 [math-ph], 2010-2011.
%H A401206 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/MRBConstant.html">MRB Constant</a>.
%e A401206 For n = 1, a(1) = 8, since f(8) = sqrt(2-sqrt(2))/(2^(3/8)*Pi) = 0.187859661380138399... is numerically the closest f(m) to the MRB constant C = 0.187859642462067120....
%e A401206 The first remainder is r(1) = C - f(8) = -1.891807127880073527...*10^(-8).
%e A401206 For n = 2, a(2) = 105719004. The next remainder is r(2) = r(1) + f(105719004) = -2.583944578180195427...*10^(-17).
%e A401206 For n = 3, a(3) = 77401040908104410, reducing the absolute remainder to approximately 8.04970519014935*10^(-35).
%t A401206 ClearAll[f, greedyIndex, digits, c, r, a, wp];
%t A401206 wp = 70;
%t A401206 (* MRB constant: 73 known decimal digits *)
%t A401206 digits = "1878596424620671202485179340542732300559030949001387861720046840894772315";
%t A401206 c = N[FromDigits[digits]/10^StringLength[digits], wp];
%t A401206 (* Positive, decreasing greedy term *)
%t A401206 f[m_Integer?Positive] := f[m] =
%t A401206   N[(2/Pi) Exp[-Log[m]/m] Sin[Pi/m], wp];
%t A401206 (* Find the integer giving the nearest term *)
%t A401206 greedyIndex[t_?NumericQ] :=
%t A401206  Module[{lo = 4, hi = 4, mid},
%t A401206   If[t >= f[4], Return[4]];
%t A401206   While[f[hi] > t, hi = 2 hi];
%t A401206   lo = Quotient[hi, 2];
%t A401206   While[hi - lo > 1,
%t A401206    mid = Quotient[lo + hi, 2];
%t A401206    If[f[mid] > t, lo = mid, hi = mid];
%t A401206   ];
%t A401206   If[Abs[t - f[lo]] <= Abs[t - f[hi]],
%t A401206    lo, hi
%t A401206   ]
%t A401206  ];
%t A401206 (* Carry out four greedy steps *)
%t A401206 r = c;
%t A401206 Table[
%t A401206  a = greedyIndex[Abs[r]];
%t A401206  r = r - Sign[r] f[a];
%t A401206  {n, a, ScientificForm[r, 12]},
%t A401206  {n, 1, 4}
%t A401206 ] // TableForm
%Y A401206 Cf. A037077.
%K A401206 nonn,new
%O A401206 1,1
%A A401206 _Marvin Ray Burns_, Oct 17 2026
