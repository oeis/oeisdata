%t A401405 (* First, load function f from the Mathematica section of A025487, then: *)
%t A401405 s = Partition[Union@ Flatten@ f[24], 2, 1]; t = Divide @@@ s; Map[s[[FirstPosition[t, #][[1]], 1]] &, Union@ FoldList[Max, t] ] (* _Michael De Vlieger_, Oct 23 2026 *)
%o A401405 (PARI)
%o A401405 A283980(n) = {my(f=factor(n)); prod(i=1, #f~, my(p=f[i, 1], e=f[i, 2]); if(p==2, 6, nextprime(p+1))^e)};
%o A401405 A025487list(e) = { my(lista = List([1, 2]), i=2, u = 2^e, t); while(lista[i] != u, if(2*lista[i] <= u, listput(lista, 2*lista[i]); t = A283980(lista[i]); if(t <= u, listput(lista, t))); i++); vecsort(Vec(lista)); };
%o A401405 v025487 = A025487list(108);
%o A401405 A025487(n) = v025487[n];
%o A401405 print1(1);r=0.5;for(n=2, #v025487-1, if(A025487(n)/A025487(n+1)>r, r=A025487(n)/A025487(n+1); print1(", "A025487(n))))
