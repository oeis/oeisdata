%S A401287 3,5,11,27,43,73,99,143,179,237,283,355,411,497,563,663,739,853,939,
%T A401287 1067,1163,1305,1411,1567,1683,1853,1979,2163,2299,2497,2643,2855,
%U A401287 3011,3237,3403,3643,3819,4073,4259,4527,4723,5005,5211,5507,5723,6033,6259,6583,6819,7157,7403
%N A401287 Number of nonempty convex vertex sets in the n-antiprism graph.
%C A401287 The n-antiprism graph is defined for n >= 3. The sequence has been extended to n=0 using the formula.
%H A401287 Andrew Howroyd, <a href="/A401287/b401287.txt">Table of n, a(n) for n = 0..1000</a>
%H A401287 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/AntiprismGraph.html">Antiprism Graph</a>.
%H A401287 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (1,2,-2,-1,1).
%F A401287 a(n) = 3 + 2*n*floor((3*n-1)/2).
%F A401287 a(n) = 3 + 2*A191967(n).
%F A401287 G.f.: (3 + 2*x + 12*x^3 + 7*x^4)/((1 - x)^3*(1 + x)^2).
%F A401287 E.g.f.: (3 + 2*x + 3*x^2)*cosh(x) + (3 + x + 3*x^2)*sinh(x). - _Stefano Spezia_, Nov 07 2026
%t A401287 A401287[n_] := 3 + 2*n*Quotient[3*n - 1, 2]; Array[A401287, 50, 0] (* _Paolo Xausa_, Nov 07 2026 *)
%Y A401287 Cf. A191967.
%K A401287 nonn,easy,new
%O A401287 0,1
%A A401287 _Andrew Howroyd_, Nov 05 2026
