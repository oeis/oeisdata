%S A401086 1,3,3,4,3,9,3,6,4,9,3,12,3,9,9,8,3,12,3,12,9,9,3,18,4,9,6,12,3,27,3,
%T A401086 10,9,9,9,16,3,9,9,18,3,27,3,12,12,9,3,24,4,12,9,12,3,18,9,18,9,9,3,
%U A401086 36,3,9,12,13,9,27,3,12,9,27,3,24,3,9,12,12,9,27,3,24
%N A401086 The number of ordered pairs of exponentially odd divisors (d_1, d_2) of n such that d_1 * d_2 is a divisor of n.
%H A401086 Amiram Eldar, <a href="/A401086/b401086.txt">Table of n, a(n) for n = 1..10000</a>
%F A401086 Multiplicative with a(p^e) = (e+3)*(e+5)/8 if e is odd, and (e^2+10*e+8)/8 if e is even.
%F A401086 Dirichlet g.f.: zeta(s)^3 * Product_{p prime} (1 - 1/(p^s*(p^s+1)))^2.
%t A401086 f[p_, e_] := If[OddQ[e], (e+3)*(e+5)/8, (e^2+10*e+8)/8]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 80]
%o A401086 (PARI) a(n) = vecprod(apply(e -> if(e % 2, (e+3)*(e+5)/8, (e^2+10*e+8)/8), factor(n)[, 2]));
%Y A401086 Cf. A268335, A365345, A401083, A401087.
%K A401086 nonn,mult,easy,new
%O A401086 1,2
%A A401086 _Amiram Eldar_, Oct 14 2026
