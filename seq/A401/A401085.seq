%I A401085 #13 Oct 18 2026 09:52:10
%S A401085 1,1,1,6,1,1,1,6,11,1,1,6,1,1,1,27,1,11,1,6,1,1,1,6,27,1,11,6,1,1,1,
%T A401085 27,1,1,1,66,1,1,1,6,1,1,1,6,11,1,1,27,51,27,1,6,1,11,1,6,1,1,1,6,1,1,
%U A401085 11,112,1,1,1,6,1,1,1,66,1,1,27,6,1,1,1,27,102
%N A401085 The total sum of square divisors of the square divisors of n.
%C A401085 The number of these divisors is A388067(n).
%H A401085 Amiram Eldar, <a href="/A401085/b401085.txt">Table of n, a(n) for n = 1..10000</a>
%F A401085 a(n) = Sum_{d|n, A010052(d) = 1} A035316(d).
%F A401085 Multiplicative with a(p^e) = (p^(2*h+4) - (h+2)*p^2 + h + 1)/(p^2-1)^2, where h = floor(e/2).
%F A401085 Dirichlet g.f.: zeta(s) * zeta(2*s-2) * zeta(2*s).
%F A401085 Sum_{k=1..n} a(k) ~ c * n^(3/2), where c = zeta(3/2) * zeta(3) / 3 = 1.046741273843781138672... .
%F A401085 More precise asymptotics: Sum_{k=1..n} a(k) ~ zeta(3/2)*zeta(3)*n^(3/2)/3 - Pi^2*n/12. - _Vaclav Kotesovec_, Oct 18 2026
%t A401085 f[p_, e_] := With[{h = Floor[e/2]}, (p^(2*h + 4) - (h + 2)*p^2 + h + 1)/(p^2 - 1)^2]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 81]
%o A401085 (PARI) a(n) = {my(f = factor(n), p, h); prod(i = 1, #f~, p = f[i, 1]; h = f[i, 2]\2; (p^(2*h + 4) - (h + 2)*p^2 + h + 1)/(p^2 - 1)^2);}
%Y A401085 Cf. A010052, A035316, A046951, A388067.
%Y A401085 Cf. A002117, A078434.
%Y A401085 Analogous sequences: A007429 (with all the divisors), A107759 (unitary), A400874 (infinitary), A401084 (exponentially odd).
%K A401085 nonn,mult,easy,new
%O A401085 1,4
%A A401085 _Amiram Eldar_, Oct 14 2026
