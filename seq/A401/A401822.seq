%S A401822 1,0,1,0,1,2,0,1,4,5,0,1,8,13,14,0,1,16,32,41,42,0,1,32,76,112,131,
%T A401822 132,0,1,64,176,292,380,428,429,0,1,128,400,736,1049,1290,1429,1430,0,
%U A401822 1,256,896,1808,2792,3698,4424,4861,4862,0,1,512,1984,4352,7224,10214,13026,15356,16795,16796
%N A401822 Triangle read by rows: T(n,k) is the number of parking permutations avoiding the pattern 321 with lucky set {1,2,...,k}.
%H A401822 Melanie Ferreri and Lucy Martinez, <a href="https://arxiv.org/abs/2611.07267">Pattern avoidance classes of parking permutations with fixed lucky sets</a>, arXiv:2611.07267 [math.CO], 2026.
%F A401822 T(n,k) = Sum_{i=0..n-k} binomial(n-k, i)*((n-i-k+2)*binomial(n-i+k-1,k-1)/(n-i+1) - binomial(n-i-2,k-1) ) for k >= 2.
%e A401822 Triangle begins:
%e A401822   1;
%e A401822   0, 1;
%e A401822   0, 1, 2;
%e A401822   0, 1, 4, 5;
%e A401822   0, 1, 8, 13, 14;
%e A401822   0, 1, 16, 32, 41, 42;
%e A401822   0, 1, 32, 76, 112, 131, 132;
%e A401822   0, 1, 64, 176, 292, 380, 428, 429;
%e A401822   0, 1, 128, 400, 736, 1049, 1290, 1429, 1430;
%e A401822   0, 1, 256, 896, 1808, 2792, 3698, 4424, 4861, 4862;
%e A401822   ...
%e A401822 For n=5 and k=2, there are 42 permutations that avoid the pattern 321 but only the following 16 permutations are parking permutations whose lucky cars are cars 1 and 2. Such parking permutations are the following: 12345, 13245, 13425, 13452, 13524, 14235, 14523, 15234, 21345, 23145, 23415, 23451, 23514, 24135, 24513, 25134.
%o A401822 (SageMath)
%o A401822 def p321(n,k):
%o A401822     if k==0:
%o A401822         return 0^n
%o A401822     if k==1:
%o A401822         return 1
%o A401822     s=0
%o A401822     for i in range(0,n-k+1):
%o A401822         s+=binomial(n-k, i)*((n-i-k+2)/(n-i+1)*binomial(n-i+k-1,k-1)- binomial(n-i-2,k-1))
%o A401822     return s
%o A401822 [[p321(n,k) for k in range(n+1)] for n in range(9)]
%Y A401822 Columns 0..3 are A000007, A057427, A299174(n-1), A098156(n-1).
%Y A401822 Main diagonal is A000108.
%Y A401822 Cf. A000272, A401823.
%K A401822 nonn,tabl,new
