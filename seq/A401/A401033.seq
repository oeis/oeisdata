%S A401033 2,2,2,2,7,2,2,2,43,3,2,5,41,191,19,3,3,2,5,67,227,5,17,2,41,3,337,2,
%T A401033 13,359,2,41,809,19,263,23,13,359,59,53,2293,491,883,4523,661,227,677,
%U A401033 277,739,457,47,1049,227,1543,401,19,331,181,3,4153,191,103,5
%N A401033 Let m = prime(n), then a(n) is the smallest prime p for which (p^m-(q-p)^m)/(2*p-q) is prime where q is the next prime after p; or -1 if no such prime exists.
%e A401033 a(1) = 2, since m = 2 and (2^2 - (3 - 2)^2)/(2*2 - 3) = 3, which is prime.
%e A401033 a(5) = 7, since m = 11 and (7^11 - (11 - 7)^11)/(2*7 - 11) = 657710813, which is prime.
%o A401033 (PARI) a(n) = my(p=2, m=prime(n), q=nextprime(p+1)); while (!isprime((p^m-(q-p)^m)/(2*p-q)), p=q; q=nextprime(p+1)); p; \\ _Michel Marcus_, Oct 14 2026
%Y A401033 Cf. A000040.
