%S A401924 1,-2,-3,-2,-5,2,-7,-2,-3,3,-11,4,-13,5,6,-2,-17,7,-19,8,9,10,-23,11,
%T A401924 -5,12,-3,13,-29,14,-31,-2,15,16,17,18,-37,19,20,21,-41,22,-43,23,24,
%U A401924 25,-47,26,-7,27,28,29,-53,30,31,32,33,34,-59,35,-61,36,37,-2,38,39,-67,40,41,42,-71,43,-73,44,45,46,47,48,-79,49,-3
%N A401924 If n is a prime power of the form p^k, k >= 1, then a(n) = -p, otherwise a(n) is the position of n in A361102, numbers that are not prime powers.
%H A401924 Antti Karttunen, <a href="/A401924/b401924.txt">Table of n, a(n) for n = 1..19683</a>
%F A401924 a(1) = 1; for n > 1, if A010055(n) = 1, i.e., if n = p^k for some prime p and exponent k >= 1, then a(n) = -p, otherwise a(n) = 1+A085970(n).
%o A401924 (PARI)
%o A401924 up_to = 19683;
%o A401924 partialsums(f, up_to) = { my(v = vector(up_to), s=0); for(i=1, up_to, s += f(i); v[i] = s); (v); }
%o A401924 v065515 = partialsums(n -> (omega(n)<=1), up_to);
%o A401924 A065515(n) = v065515[n];
%o A401924 A085970(n) = (n - A065515(n));
%o A401924 A401924(n) = if(1==n, n, my(p, e = isprimepower(n,&p)); if(p, -p, 1+A085970(n)));
%Y A401924 Cf. A010055, A065515, A085970, A246655, A361102, A401925 (rgs-transform).
%Y A401924 Cf. also A305974.
%K A401924 sign,easy,new
%O A401924 1,2
