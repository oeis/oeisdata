%I A401108 #14 Oct 14 2026 22:47:58
%S A401108 2,3,3,5,5,7,7,7,9,11,11,13,13,13,14,17,17,19,19,19,19,23,23,23,23,25,
%T A401108 23,29,29,31,31,31,33,34,34,37,37,37,38,41,41,43,43,43,43,47,47,47,48,
%U A401108 47,47,53,53,53,53,55,57,59,59,61,61,61,62,62,62,67,67,67,67,71,71
%N A401108 a(n) = min_{1 <= k < n} max{d : 1 <= d <= n and d | binomial(n,k)}.
%H A401108 Seiichi Manyama, <a href="/A401108/b401108.txt">Table of n, a(n) for n = 2..10000</a>
%H A401108 Thomas F. Bloom, <a href="https://www.erdosproblems.com/387">Erdős Problem 387</a>, Erdős Problems.
%F A401108 a(n) = min_{1 <= k < n} A401107(n,k).
%F A401108 a(n) = n if and only if n is prime.
%o A401108 (PARI) a401107(n, k) = my(b=binomial(n, k), d=n); while(b%d, d--); d;
%o A401108 a(n) = vecmin(vector(n\2, k, a401107(n, k)));
%Y A401108 Row minima of A401107.
%K A401108 nonn
%O A401108 2,1
%A A401108 _Seiichi Manyama_, Oct 14 2026
