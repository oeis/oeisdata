%S A401489 0,0,0,1,0,1,0,1,1,1,0,2,0,1,1,1,0,2,0,2,1,0,0,2,1,0,1,2,0,3,0,1,0,0,
%T A401489 1,3,0,0,0,2,0,3,0,1,2,0,0,2,1,2,0,1,0,2,0,2,0,0,0,4,0,0,2,1,0,1,0,1,
%U A401489 0,3,0,3,0,0,2,1,0,1,0,2,1,0,0,4,0,0,0,1,0,4,0,1
%N A401489 Numbers of divisors of n that are brilliant (A078972).
%C A401489 The brilliant numbers are generally useful in cryptography, and for testing the performance of prime factoring algorithms.
%C A401489 First 19 terms agree with those of A063962; then a(20) = 2, whereas A063962(20) = 1.
%C A401489 First 21 terms agree with those of A086971; then a(22) = 0, whereas A086971(22) = 1, since 22 is semiprime but not brilliant.
%H A401489 Giovanni Resta, <a href="https://www.numbersaplenty.com/set/brilliant_number/">Brilliant numbers</a>, Numbers Aplenty.
%e A401489 30 is divisible by brilliant numbers 6 = 2*3, 10 = 2*5 and 15 = 3*5, so a(30) = 3.
%t A401489 brilQ[n_] := With[{f = FactorInteger[n]}, f[[;; , 2]] == {2} || f[[;; , 2]] == {1, 1} && SameQ @@ IntegerLength[f[[;; , 1]]]];
%t A401489 a[n_] := DivisorSum[n, 1 &, brilQ[#] &]; Array[a, 92] (* _Amiram Eldar_, Oct 27 2026 *)
%Y A401489 Cf. A078972, A401490.
%Y A401489 Similar: A063962, A086971.
%K A401489 nonn,base,new
%O A401489 1,12
