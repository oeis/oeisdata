%U A401375 54,5,72,15,80,45,60,7,62,3,104,127,84,1,68,63,32,9,72,65,74,57,124,35,96,7,80,93,121,63,84,1,108
%N A401375 Largest divisor of sigma(n) coprime with n, where sigma is the sum of divisors function.
%H A401375 Antti Karttunen, <a href="/A401375/b401375.txt">Table of n, a(n) for n = 1..10000</a>
%F A401375 a(n)|A017665(n).
%F A401375 Also, apparently, a(n)|A244669(n).
%t A401375 Table[Select[Divisors[DivisorSigma[1, n]], CoprimeQ[#, n] &][[-1]], {n, 85}] (* _Michael De Vlieger_, Oct 31 2026 *)
%o A401375 (PARI) A401375(n) = { my(s=sigma(n)); fordiv(s,d,if(1==gcd(s/d,n), return(s/d))); };
%Y A401375 Cf. A000203, A017665, A244669, A401379 [= omega(a(n))].
%Y A401375 Cf. A014567 (positions where equal to sigma(n)), A105402 (positions of 1's), A401381 (positions of prime powers > 1), A401382 (positions of primes), A401389 (positions of powers of 2 larger than 1).
%K A401375 nonn,easy,new
%O A401375 1,2
%A A401375 _Antti Karttunen_, Oct 31 2026
