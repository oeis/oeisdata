%S A401217 1,2,2,3,2,4,5,2,6,7,7,2,6,8,12,11,2,8,10,16,19,15,2,8,12,16,22,30,22,
%T A401217 2,10,14,22,23,38,45,30,2,10,18,24,27,40,52,67,42,2,12,20,32,30,50,53,
%U A401217 82,97,56,2,12,24,36,38,52,63,82,112,139,77,2,14,28,46,44,68,67,102,115,166,195
%N A401217 Triangle read by rows: T(n,k) is the number of ways that an integer partition of n can be reduced to an integer partition of k by a single Chomp move, 0 <= k < n.
%C A401217 In the game of Chomp positions are represented by integer partitions. Select a square on the Ferrers diagram of a partition and remove everything that is neither above nor to the left of the chosen square resulting in a partition of smaller size. T(n,k) is the number of such reductions that reduce a partition of size n to a partition of size k.
%H A401217 Andrew Howroyd, <a href="/A401217/b401217.txt">Table of n, a(n) for n = 1..1275</a> (rows 1..50)
%H A401217 Wikipedia, <a href="https://en.wikipedia.org/wiki/Chomp">Chomp</a>.
%H A401217 Wikipedia, <a href="https://en.wikipedia.org/wiki/Ferrers_diagram">Ferrers diagram</a>.
%e A401217 Triangle begins:
%e A401217    1;
%e A401217    2, 2;
%e A401217    3, 2,  4;
%e A401217    5, 2,  6,  7;
%e A401217    7, 2,  6,  8, 12;
%e A401217   11, 2,  8, 10, 16, 19;
%e A401217   15, 2,  8, 12, 16, 22, 30;
%e A401217   22, 2, 10, 14, 22, 23, 38, 45;
%e A401217   30, 2, 10, 18, 24, 27, 40, 52, 67;
%e A401217   42, 2, 12, 20, 32, 30, 50, 53, 82, 97;
%e A401217   ...
%e A401217 The T(3,2) = 4 reductions are (3)->(2), (21)->(2), (21)->(11), (111)->(11). Illustrated below:
%e A401217    x    x o    x x    x x o
%e A401217    x    x      o
%e A401217    o
%o A401217 (PARI)
%o A401217 ChompCuts(p)={p=vecsort(p, , 4); my(r=vector(sum(i=1,#p,p[i]))); for(i=1, #p, for(j=1, p[i], my(s=sum(k=1, #p, if(k<i, p[k], min(p[k], j-1)))); r[s+1]++; )); r}
%o A401217 row(n)={my(s=vector(n)); forpart(p=n, s+=ChompCuts(p)); s}
%o A401217 { for(n=1, 12, print(row(n))) }
%Y A401217 Row sums are A066186.
%Y A401217 Column k=0 is A000041.
%Y A401217 Main diagonal is A000070(n-1).
%Y A401217 Cf. A259478, A401278, A401279.
