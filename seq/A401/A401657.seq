%U A401657 83071384526740073641,5455424908612632601956,381803081179732950095115,28368800737193252575390450
%N A401657 a(0) = 1; a(n) = Sum_{k=1..n} binomial(3*n+k-2,k) * a(n-k).
%F A401657 G.f. A(x) satisfies A(x) = (1-4*x)/(1-x)^2 * (2*A(x*(1-x)^3) - 1).
%o A401657 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(3*i+j-2, j)*v[i-j+1])); v;
