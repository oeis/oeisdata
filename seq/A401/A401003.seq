%I A401003 #16 Oct 26 2026 23:54:06
%S A401003 29,73,97,169,205,221,305,325,425,505,565,541,629,593,797,829,905,953,
%T A401003 941,1105,1037,1249,1325,1381,1345,1465,1565,1625,1585,1613,1717,1937,
%U A401003 2005,2053,2173,2225,2297,2081,2249,2161,2405,2609,2557,2665,2885,3001,3145
%N A401003 Sum of two squares obtained from the n-th Pythagorean prime by one Pell-type recurrence step: a(n) = (2*x + y)^2 + x^2, where x > y > 0 are integers and x^2 + y^2 = A002144(n).
%C A401003 For p = A002144(n) = x^2 + y^2 with integers x > y > 0, let s(0) = y, s(1) = x and s(k+2) = 2*s(k+1) + s(k). This is the recurrence satisfied by the Pell numbers A000129, with different initial values. Then p = s(0)^2 + s(1)^2 and a(n) = s(1)^2 + s(2)^2 = (2*x + y)^2 + x^2.
%C A401003 Each prime p supplies a new pair of initial values. Terms are listed in increasing order of p, not in increasing order of a(n); for example, a(11) > a(12).
%C A401003 A401002 lists the Pythagorean primes p for which a(n) is prime.
%C A401003 For p = A002144(n), let Q = p^2*a(n). The construction in A401004 gives a 3 X 3 magic square with central entry Q^2 and nine distinct positive integer entries, at least six of them squares. This works whether a(n) is prime or composite.
%H A401003 Chai Wah Wu, <a href="/A401003/b401003.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..2549 from Edward Schmidt)
%H A401003 Christian Boyer, <a href="http://www.multimagie.com/English/SquaresOfSquares.htm">Magic squares of squares</a>.
%H A401003 Christian Boyer, <a href="https://doi.org/10.1007/BF02985794">Some notes on the magic squares of squares problem</a>, The Mathematical Intelligencer, 27 (2005), 52-64.
%H A401003 Christian Boyer, <a href="http://www.multimagie.com/English/SquaresOfSquaresSearch.htm">Latest research on the "3x3 magic square of squares" problem</a>.
%H A401003 Lee Morgenstern, <a href="http://www.multimagie.com/English/Morgenstern14.htm">Euler's Formulas for 3x3 Magic Squares of 6 Squares</a>, December 2011.
%H A401003 Edward Schmidt, <a href="/A401004/a401004.txt">Pythagorean primes, a Pell-type recurrence and a magic square with six squares</a>.
%H A401003 Edward Schmidt, <a href="/A400365/a400365.txt">Fourth powers of Pythagorean legs and a magic square with six squares</a>.
%F A401003 If p = A002144(n) = x^2 + y^2 with integers x > y > 0, then a(n) = (2*x + y)^2 + x^2 = 5*x^2 + 4*x*y + y^2 = p + 4*x*(x+y).
%F A401003 a(n) = (2*A002330(n+1) + A002331(n+1))^2 + A002330(n+1)^2.
%F A401003 The shift by 1 skips the initial prime 2 in A002313.
%e A401003 The first Pythagorean prime is 5 = 2^2 + 1^2. Thus a(1) = 5^2 + 2^2 = 29.
%e A401003 The next two Pythagorean primes are 13 = 3^2 + 2^2 and 17 = 4^2 + 1^2. Consequently, a(2) = 8^2 + 3^2 = 73 and a(3) = 9^2 + 4^2 = 97.
%e A401003 For p = 29 = 5^2 + 2^2, a(4) = 12^2 + 5^2 = 169 = 13^2.
%o A401003 (Python)
%o A401003 from math import isqrt
%o A401003 from sympy import primerange
%o A401003 def a401003(limit=600):
%o A401003     # Return terms for hypotenuses p < limit.
%o A401003     out = []
%o A401003     for p in primerange(5, limit):
%o A401003         if p % 4 != 1:
%o A401003             continue
%o A401003         for y in range(1, isqrt(p // 2) + 1):
%o A401003             x = isqrt(p - y*y)
%o A401003             if x*x + y*y == p:
%o A401003                 out.append((2*x + y)**2 + x*x)
%o A401003                 break
%o A401003     return out
%o A401003 (Python)
%o A401003 from itertools import islice
%o A401003 from sympy import nextprime
%o A401003 from sympy.solvers.diophantine.diophantine import diop_quadratic
%o A401003 def A401003_gen(): # generator of terms
%o A401003     from sympy.abc import x, y
%o A401003     p = 2
%o A401003     while True:
%o A401003         if not p&2:
%o A401003             a, b = sorted(map(abs,list(diop_quadratic(x**2+y**2-p))[0]))
%o A401003             yield a*(a+(b<<2))+5*b*b
%o A401003         p = nextprime(p)
%o A401003 A401003_list = list(islice(A401003_gen(),40)) # _Chai Wah Wu_, Oct 24 2026
%Y A401003 Cf. A000129, A002144, A002313, A002330, A002331, A400363, A400364, A400365, A401002, A401004.
%K A401003 nonn,easy,new
%O A401003 1,1
