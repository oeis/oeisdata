%I A401228 #21 Oct 21 2026 10:19:50
%S A401228 27,578,1083,10571,855523,1274191,909533,3426211,1185517,8105827,
%T A401228 1597399,10330877,116162,10269163,462343,4658699,3691507,4492001,
%U A401228 18391951,39524743,89198401,17229031,9407081,104916739,91617521,126241991,29172551,185443787,109155889,133433813,371154143,198258409,14108657,965625029
%N A401228 Numbers of the form p^2*q where p and q are primes, with p taken from the first column of irregular array A401051, and q from the subsequent columns.
%C A401228 27, followed by terms of A401229, first sorted by their larger prime factor p (A400843) in ascending order, and then (if there are several terms with the same p), by their prime factor q in descending order.
%C A401228 Of the initial 4311 terms, 2529 (~59%) are in A373487.
%H A401228 Antti Karttunen, <a href="/A401228/b401228.txt">Table of n, a(n) for n = 1..4311</a>
%H A401228 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%e A401228 a(21) = 467^2 * 409 = 89198401 and a(22) = 467^2 * 79 = 17229031, corresponding to the three terms of row 21 in A401051.
%o A401228 (PARI)
%o A401228 v401051 = readvec("b401051_to.txt"); \\ Prepared from the b-file of A401051.
%o A401228 make_ppq_lista(irtrvec) = { my(v=irtrvec,p=0,q=0,lista=List([])); for(i=1,#v,if(v[i]>p, p=v[i], q=v[i]; listput(lista,p*p*q))); Vec(lista); };
%o A401228 v401228 = make_ppq_lista(v401051);
%o A401228 A401228(n) = v401228[n];
%Y A401228 Apart from the initial 27, each term is in A095990.
%Y A401228 Cf. A373487, A400843, A401051, A401229 (terms without the initial 27, sorted into ascending order).
%K A401228 nonn,new
%O A401228 1,1
%A A401228 _Antti Karttunen_, Oct 20 2026
