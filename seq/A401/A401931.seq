%I A401931 #14 Nov 17 2026 18:07:51
%S A401931 0,0,0,0,1,0,2,2,3,2,5,3,7,5,6,8,12,7,13,10,12,12,17,13,17,17,18
%N A401931 Number of terms k in range [1..(2^n)-1] for which A342001(k) = n.
%C A401931 Each 2^n occurs in column 1+a(n) of the row n in array A401930.
%F A401931 a(n) = Sum_{i=1..(2^n)-1} [A342001(k) = n], where [ ] is the Iverson bracket.
%o A401931 (PARI)
%o A401931 A342001(n) = { my(f=factor(n)); (sum(i=1, #f~, f[i, 2]/f[i, 1]) * factorback(f[, 1])); };
%o A401931 A401931(n) = sum(i=1,(2^n)-1,(n==A342001(i)));
%o A401931 (PARI)
%o A401931 A342001(n) = { my(f=factor(n)); (sum(i=1, #f~, f[i, 2]/f[i, 1]) * factorback(f[, 1])); };
%o A401931 compute_A401931_and_A401932(up_to_n) = { my(k=0, v1=vector(up_to_n), v2=vector(up_to_n), t); for(e=1,up_to_n,for(i=2^(e-1),(2^e)-1, if(!isprimepower(i), t=A342001(i); if(t>0 && t<=up_to_n,if(i < 2^t, v1[t]++; v2[t]=i, write("A401931_and_A401932_warnings_log.txt","Found A342001("i")=",t," with i >= 2^"t" !!!"))))); write("b401931.txt", e, " ",v1[e]); write("b401932.txt", e, " ",v2[e]); print(e,": ",v1[e],", ",v2[e])); };
%o A401931 compute_A401931_and_A401932(27);
%Y A401931 Cf. A342001, A401921, A401930, A401932.
%K A401931 nonn,more,new
%O A401931 1,7
%A A401931 _Antti Karttunen_, Nov 17 2026
