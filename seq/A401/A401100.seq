%I A401100 #13 Oct 18 2026 17:13:38
%S A401100 1,3,8,20,50,125,313,783,1958,4895,12238,30595,76488,191220,478050,
%T A401100 1195125,2987813,7469533,18673833,46684583,116711458,291778645,
%U A401100 729446613,1823616533,4559041333,11397603333,28494008333,71235020833,178087552083,445218880208,1113047200520
%N A401100 a(0) = 1, thereafter a(n+1) = ceiling(5*a(n)/2).
%C A401100 5*a(n) is the least number with n+2 digits in base 5/2 (A024632).
%C A401100 c*(5/2)^n - 1/3 < a(n) < c*(5/2)^n for constant c = A401103; cf. the comment in A061419 with alpha = 5/2, a = 0, and b = 1/2.
%H A401100 Jianing Song, <a href="/A401100/b401100.txt">Table of n, a(n) for n = 0..2000</a>
%t A401100 NestList[Ceiling[5*#/2] &, 1, 30] (* _Paolo Xausa_, Oct 18 2026 *)
%o A401100 (PARI) A401100_up_to_N(N) = my(v = vector(N+1)); v[1] = 1; for(n=1, N, v[1+n] = ceil(5*v[n]/2)); v \\ gives a(0..N)
%Y A401100 Cf. A024632, A401103.
%Y A401100 Cf. A061418, A061419, A087192, A390254.
%K A401100 nonn,new
%O A401100 0,2
