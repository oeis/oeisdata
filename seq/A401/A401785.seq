%S A401785 4,144,200,10800,83232,529984,6242400,26499200,515471616,38660371200,
%T A401785 41736240000,62604360000,91430352000,137145528000,353691878400,
%U A401785 68092769530368,99623212416000,1783668142771200,5106957714777600,11274770026598400,3175726890825216000,56858665244135731200
%N A401785 Primitive terms of A401784: terms in A401784 that are powerful numbers (A001694).
%C A401785 Analogous to primitive e-unitary perfect (A391281), which have a ratio A322857(k)/k = 2 instead of 3/2.
%C A401785 If k is a term, then k*m is a term in A401784 for any squarefree number m that is coprime to k.
%C A401785 Any term in A401784 is of the form k*m, where k is a term in this sequence and m is a squarefree number coprime to k. Therefore, A401784 can be generated from this sequence by multiplying with coprime squarefree numbers, and the asymptotic density of A401784 can be evaluated from the terms in this sequence (see the Comments section of A401784).
%H A401785 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%t A401785 f[p_, e_] := DivisorSum[e, p^# &, CoprimeQ[#, e/#] &]; eusigma[1] = 1; eusigma[n_] := Times @@ f @@@ FactorInteger[n]; q[k_] := eusigma[k] == 3*k/2;
%t A401785 seq[lim_] := Select[Union[Flatten[Table[i^2 * j^3, {j, 1, Surd[lim, 3]}, {i, 1, Sqrt[lim/j^3]}]]], q]; seq[10^11]
%o A401785 (PARI) is1(k) = vecprod([sumdiv(f[2], d, if(gcd(f[2]/d, d) == 1,f[1]^d)) | f <- factor(k)~]) == 3*k/2;
%o A401785 list(lim) = {my(s = List(), m); for(j = 1, sqrtnint(lim, 3), for(i = 1, sqrtint(lim\j^3), m = i^2*j^3; if(is1(m), listput(s, m)))); Set(s);}
%o A401785 list(10^11)
%Y A401785 Intersection of A001694 and A401784.
%Y A401785 Cf. A005117, A322857, A361255, A391281, A401752.
%K A401785 nonn,new
%O A401785 1,1
%A A401785 _Amiram Eldar_, Nov 05 2026
