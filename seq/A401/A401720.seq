%I A401720 #7 Nov 07 2026 19:05:37
%S A401720 1,2,3,4,3,5,3,6,7,8,3,9,3,8,10,11,3,12,3,13,10,8,3,14,15,8,16,13,3,
%T A401720 17,3,18,10,8,10,19,3,8,10,20,3,21,3,13,22,8,3,23,24,25,10,13,3,26,10,
%U A401720 20,10,8,3,27,3,8,22,28,10,21,3,13,10,29,3,30,3,8,31,13,10,21,3,32,33,8,3,34,10,8,10,20,3,35,10,13,10,8,10,36,3,37,22
%N A401720 Lexicographically earliest infinite sequence such that a(i) = a(j) => A046523(i) = A046523(j), A003557(i) = A003557(j) and A053669(i) = A053669(j), for all i, j >= 1, where A046523(n) is the smallest number with same prime signature as n, A003557(n) is n divided by its squarefree kernel, and A053669(n) is the smallest prime not dividing n.
%C A401720 Restricted growth sequence transform of the ordered triple [A046523(n), A003557(n), A053669(n)].
%C A401720 For all i, j >= 1:
%C A401720   A305801(i) = A305801(j) => a(i) = a(j),
%C A401720   a(i) = a(j) => A319347(i) = A319347(j) => A294877(i) = A294877(j),
%C A401720   a(i) = a(j) => A319347(i) = A319347(j) => A305891(i) = A305891(j),
%C A401720   a(i) = a(j) => A328470(i) = A328470(j),
%C A401720   a(i) = a(j) => A361026(i) = A361026(j) => A401714(i) = A401714(j),
%C A401720   a(i) = a(j) => A401716(i) = A401716(j),
%C A401720   a(i) = a(j) => A401717(i) = A401717(j).
%H A401720 Antti Karttunen, <a href="/A401720/b401720.txt">Table of n, a(n) for n = 1..65537</a>
%o A401720 (PARI)
%o A401720 up_to = 65537;
%o A401720 rgs_transform(invec) = { my(om = Map(), outvec = vector(length(invec)), u=1); for(i=1, length(invec), if(mapisdefined(om,invec[i]), my(pp = mapget(om, invec[i])); outvec[i] = outvec[pp] , mapput(om,invec[i],i); outvec[i] = u; u++ )); outvec; };
%o A401720 A003557(n) = (n/factorback(factorint(n)[, 1]));
%o A401720 A046523(n) = { my(f=vecsort(factor(n)[, 2], , 4), p); prod(i=1, #f, (p=nextprime(p+1))^f[i]); };
%o A401720 A053669(n) = forprime(p=2, , if(n%p, return(p)));
%o A401720 Aux401720(n) = [A046523(n), A003557(n), A053669(n)];
%o A401720 v401720 = rgs_transform(vector(up_to,n,Aux401720(n)));
%o A401720 A401720(n) = v401720[n];
%Y A401720 Cf. A003557, A053669, A046523.
%Y A401720 Sequences mentioned in the comments section that have coarser equivalence class partitioning: A101296, A294877, A305891, A319347, A328470, A361026, A401714, A401716, A401717.
%Y A401720 Cf. also A305801, A353520.
%K A401720 nonn,easy,new
%O A401720 1,2
%A A401720 _Antti Karttunen_, Nov 07 2026
