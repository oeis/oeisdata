%I A401664 #8 Nov 08 2026 16:55:30
%S A401664 3,16,19,149,168,485,2108,23673,25781,75235,176251,603988,16483927,
%T A401664 17087915,170275162,187363077,357638239,1260277794,9179582797,
%U A401664 10439860591,207536934026,217976794617,2387304880196,7379891435205,9767196315401,36681480381408
%N A401664 Numerators of convergents to log_2(9).
%C A401664 a(n)/A401355(n) is the n-th convergent to log_2(9), and (a(n) - 3*A401355(n))/A401355(n) is the n-th convergent to log_2(9/8).
%C A401664 The numerators of these shifted convergents, a(n) - 3*A401355(n), begin 0, 1, 1, 8, 9, 26, 113, 1269, 1382, 4033, 9448, 32377, ...
%C A401664 These shifted convergents are used in the Diophantine reduction of a family of perturbed exponent words in Collatz cycles, as described in the linked paper.
%H A401664 Miquel Cerda, <a href="/A401664/b401664.txt">Table of n, a(n) for n = 0..1000</a>
%H A401664 Miguel Cerdá Bennassar, <a href="https://doi.org/10.5281/zenodo.23412904">Perturbaciones de la palabra (1,2)^q en los ciclos de Collatz: reducción general y obstrucciones aritméticas al cierre</a>, Zenodo, 2026 (in Spanish).
%F A401664 a(n) = A028510(n)*a(n-1) + a(n-2) for n >= 2, with a(0) = 3 and a(1) = 16.
%e A401664 The first convergents to log_2(9) are 3/1, 16/5, 19/6, 149/47, 168/53, 485/153 and 2108/665. Their numerators are the first terms of this sequence.
%t A401664 Convergents[Log2[9],26]//Numerator (* _Stefano Spezia_, Nov 01 2026 *)
%o A401664 (Python)
%o A401664 from mpmath import mp
%o A401664 def a(n):
%o A401664     mp.dps = 30 + 3*n
%o A401664     x = mp.log(9)/mp.log(2)
%o A401664     p_prev2, p_prev1 = 0, 1
%o A401664     for _ in range(n + 1):
%o A401664         t = int(mp.floor(x))
%o A401664         p = t*p_prev1 + p_prev2
%o A401664         p_prev2, p_prev1 = p_prev1, p
%o A401664         x = 1/(x-t)
%o A401664     return p_prev1
%Y A401664 Cf. A028510 (continued fraction), A020861 (decimal expansion), A005663, A005664.
%Y A401664 Denominators are in A401355.
%K A401664 nonn,frac,new
%O A401664 0,1
%A A401664 _Miquel Cerda_, Nov 01 2026
