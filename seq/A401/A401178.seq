%I A401178 #8 Oct 17 2026 12:29:43
%S A401178 0,1,12,240,8460,534720,61838112,13353316032,5473692732672,
%T A401178 4310192951354880,6574237591572984960,19537501139715325476864,
%U A401178 113606367799699353698715648,1296606394271548717877682140160,29115609641445699248049490100367360,1288765150889566794976162300768924139520
%N A401178 Total number of induced paths in all connected labeled graphs on n vertices, excluding singleton paths.
%C A401178 The paths considered here are undirected and have at least one edge.
%H A401178 Andrew Howroyd, <a href="/A401178/b401178.txt">Table of n, a(n) for n = 1..50</a>
%o A401178 (PARI)
%o A401178 G(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k/2^(k*(k-1)/2), O(x^n)))}
%o A401178 U(p)={my(n=serprec(p, x)); serconvol(p, sum(k=0, n-1, x^k*2^(k*(k-1)/2), O(x^n)))}
%o A401178 seq(n)={my(g=U(exp(x+O(x*x^n)))); Vec(serlaplace(U(G((x/(1-x)-x)/2 + O(x*x^n))*G(g))/g), -n)}
%Y A401178 Cf. A401098, A401099, A401179.
%K A401178 nonn,new
%O A401178 1,3
%A A401178 _Andrew Howroyd_, Oct 16 2026
