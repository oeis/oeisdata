%I A401728 #10 Nov 09 2026 11:12:15
%S A401728 1,2,8,10,12,15,32,128,144,225,480,512,1000,1350,1890,2048,2160,2835,
%T A401728 4032,5005,8192,8232,12320,20736,32768,35000,50625,128000,131072,
%U A401728 135000,155520,182250,205821,211288,218700,248832,263424,329280,420000,428652,486000,524288,768320,1140480,1203125,2097152,4147200,4330260
%N A401728 Numbers k such that A083345(k) is a multiple of A276085(k), where A083345 is the numerator of the fully additive function with a(p) = 1/p, and A276085 is fully additive with a(p) = p#/p.
%H A401728 Antti Karttunen, <a href="/A401728/b401728.txt">Table of n, a(n) for n = 1..124</a>
%H A401728 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%o A401728 (PARI)
%o A401728 A083345(n) = { my(f=factor(n)); numerator(vecsum(vector(#f~, i, f[i, 2]/f[i, 1]))); };
%o A401728 A276085(n) = { my(f = factor(n)); sum(k=1, #f~, f[k, 2]*prod(i=1,primepi(f[k, 1]-1),prime(i))); };
%o A401728 is_A401728(k) = ((1==k) || !(A083345(k)%A276085(k)));
%Y A401728 Cf. A083345, A276085, A401726.
%Y A401728 Subsequence of A373490.
%Y A401728 Subsequence: A401730 (terms found in A048103).
%K A401728 nonn,new
%O A401728 1,2
