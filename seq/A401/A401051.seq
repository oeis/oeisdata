%e A401051    467, 409, 79;
%e A401051    479, 41;
%e A401051    563, 331;
%e A401051    571, 281;
%e A401051    593, 359;
%e A401051    641, 71;
%e A401051    647, 443;
%e A401051    673, 241;
%e A401051    823, 197;
