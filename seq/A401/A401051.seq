%e A401051   1091, 719;
%e A401051 etc.
%e A401051 Note that both 1+2*((467#/467)/(409#/409)) and 1+2*((467#/467)/(79#/79)) are multiples of 467 (thus both satisfy the condition), but only 467^2 * 409 = 89198401 is a term of A373487, while 467^2 * 79 = 17229031 is not.
%o A401051 (PARI)
%o A401051 rows_up_to = 430;
%o A401051 A401051_rest_of_row(n) = { my(lista=List([]), p=prime(1+n), pr=Mod(2, p), lastk=0); forstep(k=n, 1, -1, if((p-1)==lift(pr), listput(lista, prime(1+k))); pr *= Mod(prime(k), p); lastk=k); if((p-1)==lift(pr), listput(lista, prime(lastk))); (lista); };
%o A401051 A401051_list(rows_up_to) = { my(lista=List([]), rowrest); for(rown=1, rows_up_to, rowrest = A401051_rest_of_row(rown); if(#rowrest > 0, listput(lista, prime(1+rown)); lista = concat(lista, rowrest))); Vec(lista); };
%o A401051 v401051 = A401051_list(rows_up_to);
%o A401051 A401051(n) = v401051[n];
%o A401051 for(n=1,#v401051,write("b401051.txt", n, " ", A401051(n)));
%Y A401051 Row lengths are given by nonzero terms of A401053, when incremented by one.
%Y A401051 Leftmost column: A400843. Second column: A401062.
%Y A401051 Cf. A002110, A034386, A401054, A401055, A401059.
%Y A401051 Cf. A401228 (gives the corresponding numbers p^2 * q), A401229.
%K A401051 nonn,easy,tabf,new
%O A401051 1,1
%A A401051 _Antti Karttunen_, Oct 14 2026
