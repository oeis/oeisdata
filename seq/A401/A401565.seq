%T A401565 8,5,6,7,4,2,6,7,5,6,2,6,6,6,2,2,1,5,2,1,4,7,1,1,5,8,2,1,8,5,8,6,0,9,
%U A401565 9,1,8,6,2,0,5,6,9,2,3,5,6,8,4,3,3,8,8,2,6,4,7,7,1,1,0,0,7,3,3,0,5,6,5,8,3
%N A401565 Decimal expansion of lim_{x->oo} (Sum_{n <= x} Lambda(n)*(n^(1/n) - 1) - log(x)^2/2), where Lambda is the von Mangoldt function.
%C A401565 This is the von Mangoldt analog of the MRB constant A037077. Since Lambda(n)*(n^(1/n) - 1) = Lambda(n)*log(n)/n + O(Lambda(n)*log(n)^2/n^2), the partial sums grow like Sum_{n <= x} Lambda(n)*log(n)/n = log(x)^2/2 - gamma^2 - 2*gamma_1 + o(1), and this constant is the corresponding constant term, i.e., the regularized value of the divergent series Sum_{n>=1} Lambda(n)*(n^(1/n) - 1). The Stieltjes constants enter through the Laurent expansion of -zeta'(s)/zeta(s) at s = 1. Cf. A401564 for the sum over primes.
%F A401565 Equals -gamma^2 - 2*gamma_1 + Sum_{n>=2} Lambda(n)*(n^(1/n) - 1 - log(n)/n), where gamma = A001620 and gamma_1 = -A082633.
%F A401565 Equals -gamma^2 - 2*gamma_1 + Sum_{k>=2} ((-1)^k/k!) * (d^k/ds^k) (-zeta'(s)/zeta(s)) at s = k.
%e A401565 0.851811237683890730968422668498054385674267562666221521471158218586099186205692356843388264...
%o A401565 (PARI) \p 120
%o A401565 a() = my(eps = 10.^-default(realprecision), s, t, k = 1); s = -Euler^2 + 2*polcoef(zeta(1 + x + O(x^4)), 1); until(abs(t) < eps, k++; t = polcoef(-deriv(log(zeta(k + x + O(x^(k+2))))), k); s += (-1)^k*t); s;
%o A401565 a()
%Y A401565 Cf. A001620, A014963, A082633.
%K A401565 nonn,cons,new
%O A401565 0,1
%A A401565 _Madhav Gaur_, Oct 29 2026
