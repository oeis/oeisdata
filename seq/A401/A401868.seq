%S A401868 1,1,1,1,1,1,1,3,3,1,1,16,384,16,1,1,125,2048000,2048000,125,1,1,1296,
%T A401868 518400000000,96745881600000000,518400000000,1296,1,1,16807,
%U A401868 7192939211224252416,125989765379040715407360000000000000,125989765379040715407360000000000000,7192939211224252416,16807,1
%N A401868 Triangle read by rows: T(n,k) is the number of spanning trees in the Johnson graph J(n,k).
%H A401868 Andrew Howroyd, <a href="/A401868/b401868.txt">Table of n, a(n) for n = 0..77</a> (rows 0..11)
%H A401868 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/JohnsonGraph.html">Johnson Graph</a>.
%H A401868 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/SpanningTree.html">Spanning Tree</a>.
%H A401868 Wikipedia, <a href="https://en.wikipedia.org/wiki/Johnson_graph">Johnson graph</a>.
%e A401868 Triangle begins:
%e A401868   1;
%e A401868   1,    1;
%e A401868   1,    1,            1;
%e A401868   1,    3,            3,                 1;
%e A401868   1,   16,          384,                16,            1;
%e A401868   1,  125,      2048000,           2048000,          125,    1;
%e A401868   1, 1296, 518400000000, 96745881600000000, 518400000000, 1296, 1;
%e A401868   ...
%o A401868 (PARI)
%o A401868 J(n,k)={my(v=vector(binomial(n,k)), i=0); forsubset([n,k], s, i++; v[i]=sum(j=1,#s,2^(s[j]-1))); matrix(#v,#v,i,j,hammingweight(bitxor(v[i],v[j]))==2)}
%o A401868 LaplacianMatrix(M)={matdiagonal(vecsum(Vec(M))) - M}
%o A401868 SpanningTreeCount(M)={my(n=#M); abs(matdet(LaplacianMatrix(M)[2..n, 2..n]))}
%o A401868 T(n,k)=SpanningTreeCount(J(n,k))
%Y A401868 Columns k=0..2 are A000012, A000272, A193154.
%K A401868 nonn,tabl,new
%O A401868 0,8
%A A401868 _Andrew Howroyd_, Nov 10 2026
