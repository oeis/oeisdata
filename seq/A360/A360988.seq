%N A360988 E.g.f. A(x) satisfies A(x) = exp(x * A(-x)^3).
%H A360988 Michael De Vlieger, <a href="/A360988/b360988.txt">Table of n, a(n) for n = 0..348</a>
%H A360988 Lien-Hung Su, <a href="https://doi.org/10.5281/zenodo.24366920">Arithmetic of Implicit, Reflected, and Composed Generating Functions</a>, ResearchGate, 2026. See p. 16.
%F A360988 a(n) = Sum_{k=0..n} (3*n - 3*k + 1)^(k-1) * (-3*k)^(n-k) * binomial(n,k).
%F A360988 a(0) = 1; a(n) = (-1)^(n-1) * (n-1)! * Sum_{i, j, k, l>=0 and i+j+k+l=n-1} (-1)^i * (n-i) * a(i) * a(j) * a(k) * a(l)/(i! * j! * k! * l!). - _Seiichi Manyama_, Jul 06 2025
%t A360988 {1}~Join~Table[Sum[(3*n - 3*k + 1)^(k - 1)*(-3*k)^(n - k)*Binomial[n, k], {k, 0, n}], {n, 17}] (* _Michael De Vlieger_, Nov 24 2026 *)
%o A360988 (PARI) a(n) = sum(k=0, n, (3*n-3*k+1)^(k-1)*(-3*k)^(n-k)*binomial(n, k));
