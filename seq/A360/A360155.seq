%S A360155 17,59,89,131,137,233,401,449,587,617,659,683,857,971,1019,1097,1217,
%T A360155 1283,1361,1481,1499,1571,1667,1787,1889,2081,2129,2411,2441,2531,
%U A360155 2729,2843,2969,3137,3203,3257,3371,3491,3617,4019,4073,4091,4409,4451,4547,4643,4649,4931,5153,5297,6113,6353
%N A360155 Primes of the form m^2 + 2*(k+1)^2 such that m^2 + 2*k^2 is also prime.
%C A360155 Primes of the form m^2 + 2*k^2 are the norms of prime elements of Z[i*sqrt(2)]. Pairs of primes of the form (m^2 + 2*k^2, m^2 + 2*(k+1)^2) correspond to primes in Z[i*sqrt(2)] differing by i*sqrt(2).
%C A360155 A prime cannot simultaneously be the lesser of such a pair and the greater of another.
%H A360155 Robert Israel, <a href="/A360155/b360155.txt">Table of n, a(n) for n = 1..10000</a>
%F A360155 If m^2 + 2*k^2 and m^2 + 2*(k+1)^2 are primes, then m == 3 (mod 6) and k == 1 (mod 3).
%e A360155 The first 3 such prime pairs are
%e A360155   (11,17) = (3^2 + 2*1^2, 3^2 + 2*2^2) with m=3 and k=1,
%e A360155   (41,59) = (3^2 + 2*4^2, 3^2 + 2*5^2) with m=3 and k=4,
%e A360155   (83,89) = (9^2 + 2*1^2, 9^2 + 2*2^2) with m=9 and k=1.
%p A360155 N:= 10^4: # for terms <= N
%p A360155 S:= {}:
%p A360155 for m from 3 by 6 while m^2 <= N do
%p A360155   for k from 1 by 3 do
%p A360155     v:= m^2 + 2*(k+1)^2;
%p A360155     if v > N then break fi;
%p A360155     if isprime(v) and isprime(m^2 + 2*k^2) then S:= S union {v} fi
%p A360155 od od:
%p A360155 sort(convert(S,list)); # _Robert Israel_, Nov 15 2026
%Y A360155 See A360154 for lesser primes.
%Y A360155 Cf. A000040 (prime numbers).
%Y A360155 Cf. A033203 (primes of the form m^2 + 2*k^2).
%K A360155 nonn,changed
%O A360155 1,1
