%t A360280 Total[#^2]&/@Union[Sort/@({Times@@#,(Last[#]^2-First[#]^2)/2}&/@(Select[Subsets[Range[1,25,2],{2}],GCD@@#==1&]))]//Union (* _Harvey P. Dale_, Oct 06 2026 *)
