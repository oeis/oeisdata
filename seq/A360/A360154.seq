%S A360154 11,41,83,107,113,227,347,443,521,563,593,641,827,929,953,1091,1187,
%T A360154 1193,1259,1409,1427,1553,1601,1697,1811,1979,2003,2297,2339,2393,
%U A360154 2699,2801,2819,3011,3089,3209,3251,3449,3467,3929,3947,4001,4259,4289,4457,4481,4523,4817,5099,5171,6011,6131
%N A360154 Primes of the form m^2 + 2*k^2 such that m^2 + 2*(k+1)^2 is also prime.
%C A360154 Primes of the form m^2 + 2*k^2 are norms of prime elements of Z[i*sqrt(2)]. Prime couples of the form (m^2 + 2*k^2, m^2 + 2*(k+1)^2) correspond to primes in Z[i*sqrt(2)] differing from i*sqrt(2).
%C A360154 A prime cannot be simultaneously the lesser of one such couple and the greater of another.
%H A360154 Robert Israel, <a href="/A360154/b360154.txt">Table of n, a(n) for n = 1..10000</a>
%F A360154 If (m^2 + 2*k^2, m^2 + 2*(k+1)^2) is a prime couple, then m is congruent to 3 modulo 6 and k is congruent to 1 modulo 3.
%e A360154 The first 3 prime couples of the form (m^2 + 2*k^2, m^2 + 2*(k+1)^2) are (11,17) = (3^2 + 2*1^2, 3^2 + 2*2^2), (41,59) = (3^2 + 2*4^2, 3^2 + 2*5^2) and (83,89) = (9^2 + 2*1^2, 9^2 + 2*2^2).
%p A360154 N:= 10^4: # for terms <= N
%p A360154 S:= {}:
%p A360154 for m from 3 by 6 while m^2 <= N do
%p A360154   for k from 1 by 3 do
%p A360154     v:= m^2 + 2*k^2;
%p A360154     if v > N then break fi;
%p A360154     if isprime(v) and isprime(m^2 + 2*(k+1)^2) then S:= S union {v} fi
%p A360154 od od:
%p A360154 sort(convert(S,list)): # _Robert Israel_, Nov 15 2026
%Y A360154 See A360155 for greater values.
%Y A360154 Cf. A000040 (prime numbers).
%Y A360154 Cf. A033203 (primes of form m^2 + 2*k^2).
