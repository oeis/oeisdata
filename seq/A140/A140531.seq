%S A140531 0,0,1,0,1,2,0,1,2,4,0,1,2,4,8,0,1,2,4,8,16,0,1,2,4,8,16,32,0,1,2,4,8,
%T A140531 16,32,64,0,1,2,4,8,16,32,64,128,0,1,2,4,8,16,32,64,128,256,0,1,2,4,8,
%U A140531 16,32,64,128,256,512,0,1,2,4,8,16,32,64,128,256,512,1024
%N A140531 Concatenate subsequences 0, 1, 2, 4, ..., 2^k.
%C A140531 A sequence B is called a reluctant sequence of sequence A, if B is triangle array read by rows: row number k coincides with first k elements of the sequence A. Sequence A140531 is the reluctant sequence of A131577. - _Boris Putievskiy_, Dec 12 2012
%H A140531 Boris Putievskiy, <a href="https://arxiv.org/abs/1212.2732">Transformations Integer Sequences And Pairing Functions</a>, arXiv:1212.2732 [math.CO], 2012.
%F A140531 a(n) = floor(2^(n-2-t*(t+1)/2)), where t=floor((-1+sqrt(8*n-7))/2), n>=1. - _Boris Putievskiy_, Dec 13 2012
%F A140531 G.f.: x*y/((1 - x)*(1 - 2*x*y)). - _Stefano Spezia_, Aug 12 2026
%e A140531 The triangle begins as:
%e A140531   0;
%e A140531   0, 1;
%e A140531   0, 1, 2;
%e A140531   0, 1, 2, 4;
%e A140531   0, 1, 2, 4, 8;
%e A140531   0, 1, 2, 4, 8, 16;
%e A140531   0, 1, 2, 4, 8, 16, 32;
%e A140531   0, 1, 2, 4, 8, 16, 32, 64;
%e A140531   ...
%t A140531 T[n_,k_]:=If[k==0,0,2^(k-1)]; Table[T[n,k],{n,0,11},{k,0,n}]//Flatten (* _Stefano Spezia_, Aug 12 2026 *)
%o A140531 (Python)
%o A140531 from math import isqrt, comb
%o A140531 def A140531(n):
%o A140531     a = (m:=isqrt(k:=n+1<<1))+(k>m*(m+1))
%o A140531     x = a-comb(a+1,2)+n-1
%o A140531     return 1<<x if x>=0 else 0 # _Chai Wah Wu_, Aug 12 2026
