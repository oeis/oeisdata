%N A140725 Inverse binomial transform of (0 followed by A037481).
%C A140725 From _Sean A. Irvine_, Jun 07 2025: (Start)
%C A140725 For n>=1, the number of walks of length n-1 starting at vertex 1 (or, by symmetry, vertex 4) in the graph K_{1,1,3}:
%C A140725     1---2
%C A140725    /|\ /
%C A140725   0 | X
%C A140725    \|/ \
%C A140725     4---3. (End)
%H A140725 Sean A. Irvine, <a href="https://oeis.org/wiki/User:Sean_A._Irvine/Walks_on_Graphs#5_vertices">Walks on Graphs</a>.
%H A140725 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (1,6).
%F A140725 a(n) = (-1)^n*A091003(n), n>0.
%F A140725 a(n+1)-3*a(n) = (-1)^(n+1)*A000079(n-1), n>0.
%F A140725 abs(a(n+1)-3*a(n)) = A011782(n).
%F A140725 From _R. J. Mathar_, Jul 14 2008: (Start)
%F A140725 O.g.f.: (1+3*x)*x / ((1+2*x)*(1-3*x)).
%F A140725 a(n) = ((-2)^n+4*3^n)/10, n>0. (End)
%F A140725 From _Philippe Deléham_, Nov 17 2013: (Start)
%F A140725 a(n) = a(n-1)+6*a(n-2) for n>2, a(0)=0, a(1)=1, a(2)=4.
%F A140725 a(n) + a(n+1) = A140796(n).
%F A140725 a(n+1) = Sum_{k=0..n} A108561(n,k)*(-3)^k. (End)
%F A140725 From _Elmo R. Oliveira_, Nov 16 2026: (Start)
%F A140725 a(n) = A133467(n)/2 for n > 0.
%F A140725 E.g.f.: (4*exp(3*x) + exp(-2*x) - 5)/10. (End)
%t A140725 Join[{0},LinearRecurrence[{1,6},{1,4},26]] (* _James C. McMahon_, Jul 13 2025 *)
%t A140725 (* Alternative: *)
%t A140725 a[0]=0;a[n_]:= ((-2)^n+4*3^n)/10;Array[a,27,0] (* _James C. McMahon_, Jul 13 2025 *)
