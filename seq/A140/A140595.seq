%e A140595  Reading the columns from top to bottom gives (1, 2, 3), (4, 5, 6, 7), (9, 8, 11, 10), (13, 14, 12, 15), (16, 18, 19, 17), (21, 23, 22, 20), (25, 26, 24, 27), (28, 29, 30, 31), (33, 32, 34, 35), (37, 36, 39, 38), (40, 43, 42, 41), ...
%o A140595 (Python)
%o A140595 def A140595_list(N):  # a(0..N-1)
%o A140595      def s(n):  # A396771(n), second-smallest non-divisor of n
%o A140595          k = c = 0
%o A140595          while c < 2:
%o A140595              k += 1
%o A140595              c += n % k > 0
%o A140595          return k
%o A140595      X = N + 2000
%o A140595      f = [0] + [n + s(n) for n in range(1, X + 1)]
%o A140595      row, key = [0]*(X + 1), {}
%o A140595      for m in range(1, N + 8):
%o A140595         if row[m]: continue
%o A140595          x = last = m
%o A140595          while x <= X and not row[x]:
%o A140595              row[x], last, x = m, x, f[x]
%o A140595          key[m] = () if m == 1 else key[row[x]] + ((x, -last),)
%o A140595      return [n for k in range(N//4 + 1) for n in
%o A140595              sorted(range(max(1, 4*k), 4*k + 4), key=lambda n: key[row[n]])][:N]
%o A140595  print(A140595_list(60)) # _Jeff Sponaugle_, Nov 03 2026
