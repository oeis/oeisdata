%S A387107 1,2,6,4,30,6,126,16,72,30,88,12,8190,126,150,256,131070,72,524286,
%T A387107 120,1008,2728,178480,240,1800,8190,262656,1008,39672,1650,2147483646,
%U A387107 65536,2397912,131070,1106280,216,616318176,524286,12743640,61680,26815350376,43344,1186422030
%N A387107 a(n) = psi(2^n-1), where psi = A002322 is the Carmichael (lambda) function.
%C A387107 Each term a(n) is divisible by n. Are there only finitely many k such that a(k) = a(m) for some m < k? Many numbers of the form a(n)+1 are prime (contains, among others, all Mersenne primes and all Fermat primes). Is a(n)+1 prime for infinitely many n? See A397249. - _Thomas Ordowski_, Aug 12 2026
%H A387107 Amiram Eldar, <a href="/A387107/b387107.txt">Table of n, a(n) for n = 1..1206</a>
%F A387107 a(n) = A002322(A000225(n)).
%F A387107 A005420(n)-1 <= a(n) <= A000918(n). - _Thomas Ordowski_, Aug 21 2026
%t A387107 a[n_] := CarmichaelLambda[2^n - 1]; Array[a, 50] (* _Amiram Eldar_, Aug 16 2025 *)
%o A387107 (PARI) a(n) = lcm(znstar(2^n-1)[2]); \\ _Michel Marcus_, Aug 22 2025
%Y A387107 Cf. A000225, A000918, A002322, A005420, A397249, A399070.
