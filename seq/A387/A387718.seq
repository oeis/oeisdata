%N A387718 Smallest divisor d of n such that n/d is deficient, i.e., sigma(n/d) < 2*(n/d).
%H A387718 Antti Karttunen, <a href="/A387718/b387718.txt">Table of n, a(n) for n = 1..65537</a>
%F A387718 a(n) = n / A387717(n).
%F A387718 a(n) >= A378660(n).
%F A387718 a(n) = A020639(n) if n is primitive abundant number (A071395). - _Amiram Eldar_, Oct 13 2026
%t A387718 a[n_] := Min[Select[Divisors[n], DivisorSigma[-1, n/#] < 2 &]]; Array[a, 105] (* _Amiram Eldar_, Oct 13 2026 *)
%o A387718 (PARI) A387718(n) = { fordiv(n, d, if(sigma(n/d)<2*(n/d), return(d))); (n); };
%Y A387718 Cf. A000203, A005100 (positions of 1's), A020639, A071395, A378660, A387717.
%K A387718 nonn
