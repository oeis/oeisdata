%S A387611 0,8,256,648,8192,5000,20736,134456,262144,157464,160000,1288408,
%T A387611 663552,2970344,4302592,405000,8388608,11358856,5038848,19808792,
%U A387611 5120000,10890936,41229056,51490744,21233664,15625000,95051008,38263752,137682944,164089192,12960000,229033208
%N A387611 a(n) = numerator(Integral_{(x,y,z) in R^3 : 0 <= x^2 + y^2 + z^2 <= n^2} (x^2 + y^2) dx dy dz)/Pi.
%C A387611 The integral gives the moment of inertia of a sphere of radius n.
%H A387611 Mathematics Stack Exchange, <a href="https://math.stackexchange.com/questions/2535654/moment-of-inertia-of-a-sphere">Moment of inertia of a sphere</a>, 2017.
%H A387611 R. Nave, <a href="https://www.hyperphysics.gsu.edu/hbase/isph.html">Moment of inertia: Sphere</a>, HyperPhysics.
%F A387611 a(n) = numerator(8*n^5/15).
%F A387611 a(n) = 8*n^5/gcd(n,15). - _Chai Wah Wu_, Sep 08 2025
%F A387611 From _Amiram Eldar_, Oct 27 2026: (Start)
%F A387611 Sum_{k=1..n} a(k) ~ 196 * n^6 / 225.
%F A387611 Sum_{k>=1} 1/a(k) = 51107*zeta(5)/405000. (End)
%t A387611 a[n_]:=Numerator[8n^5/15]; Array[a,31,0]
%o A387611 (Python)
%o A387611 def A387611(n): return (n**5<<3)//((((not n%3)<<1)+1)*(((not n%5)<<2)+1)) # _Chai Wah Wu_, Sep 08 2025
%o A387611 (PARI) a(n) = 8*n^5/gcd(n,15); \\ _Amiram Eldar_, Oct 27 2026
