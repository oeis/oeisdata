%S A387478 1,0,2,6,4,48,44,216,664,984,5216,9312,30160,93312,194528,717792,
%T A387478 1674688,4842624,14554304,35517312,112151680,293213568,823387136,
%U A387478 2409934848,6348908800,18760218624,51418362368,143838905856,414017065984,1132211048448,3255687793664
%N A387478 a(n) = Sum_{k=0..floor(n/2)} 2^k * 3^(n-2*k) * binomial(k,n-2*k)^2.
%H A387478 Vincenzo Librandi, <a href="/A387478/b387478.txt">Table of n, a(n) for n = 0..1000</a>
%F A387478 G.f.: 1/sqrt((1-2*x^2-6*x^3)^2 - 48*x^5).
%F A387478 D-finite with recurrence: (108 + 36*n)*a(n) + (-84 - 24*n)*a(n + 1) + (16 + 4*n)*a(n + 2) + (-54 - 12*n)*a(n + 3) + (-4*n - 20)*a(n + 4) + (n + 6)*a(n + 6) = 0. - _Robert Israel_, Sep 17 2026
%p A387478 with(gfun):
%p A387478 g:=  1/sqrt((1-2*x^2-6*x^3)^2 - 48*x^5):
%p A387478 de:= holexprtodiffeq(g,y(x)):
%p A387478 rec:= diffeqtorec(de,y(x),a(n)):
%p A387478 f:= rectoproc(rec,a(n),remember):
%p A387478 map(f, [$0..50]); # _Robert Israel_, Sep 17 2026
%t A387478 Table[Sum[2^k* 3^(n-2*k)*Binomial[k,n-2*k]^2,{k,0,Floor[n/2]}],{n,0,40}] (* _Vincenzo Librandi_, Sep 01 2025 *)
%o A387478 (PARI) a(n) = sum(k=0, n\2, 2^k*3^(n-2*k)*binomial(k, n-2*k)^2);
%o A387478 (Magma) [(&+[2^k *3^(n-2*k)* Binomial(k,n-2*k)^2: k in [0..Floor(n/2)]]): n in [0..40]]; // _Vincenzo Librandi_, Sep 01 2025
