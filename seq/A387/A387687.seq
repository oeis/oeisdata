%S A387687 2,3,5,7,13,19,23,31,41,61,67,127,197,257,277,311,331,563,653,709,719,
%T A387687 823,1031,1103,1163,1327,1471,1723,1811,1879,1931,1973,2447,2633,2707,
%U A387687 2927,3119,3253,3701,4409,4787,5167,5749,6121,6133,6359,7039,7103,7331,7963
%N A387687 a(n) is the smallest prime p greater than all previous terms such that the product of the previous terms plus p is prime.
%C A387687 The presence of the even prime 2 makes this sequence work. a(1) = 2 since the empty product is 1 and 1 + 2 = 3 is a prime.
%H A387687 Chai Wah Wu, <a href="/A387687/b387687.txt">Table of n, a(n) for n = 1..220</a>
%e A387687 2 + 3 = 5 (a prime).
%e A387687 2 * 3 + 5 = 11 (a prime).
%e A387687 2 * 3 * 5 * 7 * 13 * 19 + 23 = 51893 (a prime).
%e A387687 2 * 3 * 5 * 7 * 13 * 19 * 23 * 31 * 41 * 61 + 67 = 92495258377 (a prime).
%p A387687 x := 1: for i to 1010 do if isprime(x+ithprime(i)) then x := x*ithprime(i); printf("%d, ", ithprime(i)) end if; end do;
%t A387687 x = 1; p = {}; For[i = 1, i < 1010, i++, If[PrimeQ[x + Prime[i]], x *= Prime[i]; p = Append[p, Prime[i]]]]; p
%o A387687 (PARI) my(x=1); forprime(p=2, 8000, if(isprime(x+p), x*=p; print1(p, ", ")))
%o A387687 (Python)
%o A387687 from itertools import islice
%o A387687 from sympy import nextprime, isprime
%o A387687 def A387687_gen(): # generator of terms
%o A387687     a, c = 2, 2
%o A387687     yield a
%o A387687     while True:
%o A387687         m = nextprime(a+c)
%o A387687         while not isprime(m-c):
%o A387687             m = nextprime(m)
%o A387687         yield m-c
%o A387687         a, c = m-c, c*(m-c)
%o A387687 A387687_list = list(islice(A387687_gen(),50)) # _Chai Wah Wu_, Sep 29 2026
%Y A387687 Cf. A000040 (primes).
