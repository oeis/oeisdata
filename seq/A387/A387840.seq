%S A387840 1,4,27,221,2004,19370,195584,2038664,21770217,236941760,2618720692,
%T A387840 29311169343,331577919891,3784930267188,43541666412459,
%U A387840 504299421731877,5875568109960575,68816531233181276,809783886875736683,9569059083207116356,113504808314574441720
%N A387840 Expansion of (1/x) * Series_Reversion( x*(1-x)^5/(1-x+x^2) ).
%H A387840 Robert Israel, <a href="/A387840/b387840.txt">Table of n, a(n) for n = 0..904</a>
%H A387840 Robert Israel, <a href="/A387840/a387840.txt">Recurrence of order 9</a>
%F A387840 a(n) = (1/(n+1)) * Sum_{k=0..floor(n/2)} binomial(n+1,k) * binomial(5*n-k+3,n-2*k).
%F A387840 a(n) = (1/(n+1)) * Sum_{k=0..n} binomial(n+1,k) * binomial(4*n+k+2,n-k).
%F A387840 a(n) = (1/(n+1)) * [x^n] ((1-x+x^2) / (1-x)^5)^(n+1).
%F A387840 D-finite with recurrence of order 9 (see link). - _Robert Israel_, Sep 06 2026
%p A387840 eq := x^5*y^6 - 5*x^4*y^5 + 10*x^3*y^4 - 10*x^2*y^3 + x^2*y^2 + 5*x*y^2 - x*y - y + 1:
%p A387840 de:= algeqtodiffeq(eq,y(x)):
%p A387840 rec:= diffeqtorec(de,y(x),a(n)):
%p A387840 f:= rectoproc(rec,a(n),remember):
%p A387840 map(f, [$0..30]); # _Robert Israel_, Sep 06 2026
%o A387840 (PARI) a(n) = sum(k=0, n\2, binomial(n+1, k)*binomial(5*n-k+3, n-2*k))/(n+1);
%Y A387840 Cf. A005043, A109081, A366049, A366050.
%K A387840 nonn,changed
%O A387840 0,2
