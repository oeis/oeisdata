%U A387978 13051691536,42618442977,64339296875,84835994984,90075015625,103749698404,229783203125,373714754427,882735153125,941480149401,1785793904896,2100931392681,5352009260481,7730680042917
%N A387978 Numbers k = p_i^e_i * p_j^e_j such that i/e_i + j/e_j = 1 for e_i, e_j >= 1, p_i, p_j distinct prime numbers.
%C A387978 Integers k that have exactly two distinct prime factors p_i, p_j with exponents e_i, e_j satisfying i/e_i + j/e_j = 1 where i, j are the 1-based indices of the primes (A000040).
%H A387978 Max Alekseyev, <a href="/A387978/b387978.txt">Table of n, a(n) for n = 1..1198</a>
%e A387978 For k = 216 = 2^3 * 3^3 we have 1/3 + 2/3 = 1 thus k = 216 is a term.
%e A387978 For k = 941192 = 2^3 * 7^6 we have 1/3 + 4/6 = 1 thus k = 941192 is a term.
%o A387978 (PARI) isok(k) = my(f=factor(k)); (#f~ == 2) && (sum(i=1, #f~, primepi(f[i, 1])/f[i, 2]) == 1); \\ _Michel Marcus_, Oct 14 2025
%Y A387978 Subsequence of A007774.
%K A387978 nonn
