%I A057922 #21 Oct 01 2026 12:34:39
%S A057922 1,2,5,7,11,13,14,17,19,21,23,26,29,31,33,34,37,38,39,41,43,44,47,49,
%T A057922 53,55,57,59,61,65,67,69,71,73,75,77,79,83,85,86,87,89,93,94,95,97,98,
%U A057922 101,103,104,107,109,113,116,118,119,122,125,127,129,131,133,134,135
%N A057922 Numbers k such that d(k) divides d(k+1), where d(k) is number of positive divisors of k.
%H A057922 Ivan Neretin, <a href="/A057922/b057922.txt">Table of n, a(n) for n = 1..10001</a>
%e A057922 11 is a term because d(11) = 2 divides d(12) = 6.
%t A057922 Select[Range@150, Divisible @@ DivisorSigma[0, {# + 1, #}] &] (* _Ivan Neretin_, May 29 2015 *)
%t A057922 (* Alternative: *)
%t A057922 Position[Partition[DivisorSigma[0,Range[150]],2,1],_?(Divisible[#[[2]], #[[1]]]&),1,Heads->False]//Flatten (* _Harvey P. Dale_, May 08 2019 *)
%o A057922 (PARI) isok(k) = !(numdiv(k+1) % numdiv(k)); \\ _Amiram Eldar_, Oct 01 2026
%o A057922 (PARI) list(kmax) = {my(d1 = 1, d2); for(k = 2, kmax, d2 = numdiv(k); if(!(d2 % d1), print1(k-1, ", ")); d1 = d2);} \\ _Amiram Eldar_, Oct 01 2026
