%S A057921 2,6,10,12,14,18,21,22,26,28,30,33,34,38,40,42,44,46,52,54,56,57,58,
%T A057921 60,66,70,72,75,78,80,82,84,85,86,88,90,93,94,96,98,102,104,105,106,
%U A057921 108,110,112,114,116,118,122,126,128,130,132,133,135,136,138,140,141,142
%N A057921 Numbers k such that d(k+1) divides d(k), where d(k) is number of positive divisors of k.
%H A057921 Ivan Neretin, <a href="/A057921/b057921.txt">Table of n, a(n) for n = 1..10001</a>
%e A057921 10 is a term because d(11) = 2 divides d(10) = 4.
%t A057921 Select[Range@150, Divisible @@ DivisorSigma[0, {#, # + 1}] &] (* _Ivan Neretin_, May 29 2015 *)
%o A057921 (PARI) isok(k) = !(numdiv(k) % numdiv(k+1)); \\ _Amiram Eldar_, Oct 01 2026
%o A057921 (PARI) list(kmax) = {my(d1 = 1, d2); for(k = 2, kmax, d2 = numdiv(k); if(!(d1 % d2), print1(k-1, ", ")); d1 = d2);} \\ _Amiram Eldar_, Oct 01 2026
