%I A292633 #17 Aug 26 2026 00:26:30
%S A292633 0,1,6,54,656,10100,189252,4195870,107803712,3158565192,104179336100,
%T A292633 3827097857594,155176637687568,6890781261435916,332846314505306084,
%U A292633 17384125179840159150,976545328548757184768,58723524484105985029136,3764267361608204263229892,256245748998712921762125922
%N A292633 a(n) = n! * [x^n] -exp(n*x)*LambertW(-x).
%C A292633 The n-th term of the n-th binomial transform of A000169.
%H A292633 G. C. Greubel, <a href="/A292633/b292633.txt">Table of n, a(n) for n = 0..365</a>
%H A292633 N. J. A. Sloane, <a href="/transforms.txt">Transforms</a>
%F A292633 a(n) ~ exp(n*exp(-1)) * n^(n-1) / (1-exp(-1))^(3/2). - _Vaclav Kotesovec_, Sep 20 2017
%F A292633 From _Natalia L. Skirrow_, Aug 25 2026: (Start)
%F A292633 E.g.f.: T(T(x))/(1-T(x)), where T(x) = -LambertW(-x) is the e.g.f. for A000169.
%F A292633 a(n) = Sum_{k=1..n} C(n,k) * k^(k-1) * n^(n-k).
%F A292633 a(n) = Sum_{k=0..n-1} C(n,k) * k^k * A207833(n-k).
%F A292633 a(n) = Sum_{k=1..n} C(n,k) * k * n^(n-k-1) * A277505(k).
%F A292633 A277505(n) = Sum_{k=1..n} C(n,k) * (-k)^(n-k) * a(k).
%F A292633 (End)
%t A292633 Table[n!*SeriesCoefficient[-E^(n*x)*LambertW[-x],{x,0,n}], {n,0,20}] (* _Vaclav Kotesovec_, Sep 20 2017 *)
%t A292633 T[x_]=-LambertW[-x];CoefficientList[Series[T[T[x]]/(1-T[x]),{x,0,20}],x]*Range[0,20]! (* _Natalia L. Skirrow_, Aug 25 2026 *)
%o A292633 (Python)
%o A292633 A292633=lambda n: n and (c:=n**n)+sum((c:=c*(n+1-k)//(k*n))*k**(k-1) for k in range(2,n+1))
%o A292633 print(A292633(21)) # For computing a single term without any before it. - _Natalia L. Skirrow_, Aug 25 2026
%o A292633 (Python)
%o A292633 from functools import cache
%o A292633 A277505=cache(lambda n: n if n<2 else n*(A277505(n-1) + n**(n-2)))
%o A292633 A292633=lambda n: n and (c:=1)*A277505(n)+sum((c:=n*(n-k)*c//k)*A277505(n-k) for k in range(1,n))
%o A292633 print([A292633(n) for n in range(21)]) # For generating lists of initial terms. - _Natalia L. Skirrow_, Aug 25 2026
%Y A292633 Main diagonal of A294411.
%Y A292633 Cf. A000169, A207833, A277505, A290840.
%K A292633 nonn,changed
%O A292633 0,3
