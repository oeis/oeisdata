%I A249107 #35 Oct 29 2026 15:23:11
%S A249107 4031,10823,416959,496939,1354980,9146115,38949392,44472866,262908396,
%T A249107 380264131,1058578125,1072281223,1774631673,2539872501,9873543431,
%U A249107 30429212500
%N A249107 Numbers that form a Pythagorean 7-tuple with their first five arithmetic derivatives.
%C A249107 If we consider Pythagorean 8-tuple and 9-tuple there are no terms up to n = 10^8.
%C A249107 30429212500 < a(17) <= 2434337*3^3*5^5 = 205397184375. - _Carlo Corti_, Oct 21 2026
%H A249107 Carlo Corti, <a href="https://doi.org/10.5281/zenodo.23534992">Arithmetic-Derivative Pythagorean 7-Tuples: Exact Extension and Homothetic Structure of OEIS A249107</a>, Zenodo archive, 2026.
%H A249107 Carlo Corti, <a href="/A249107/a249107.txt">Table of i, a(i), its first five arithmetic derivatives, and the integer root, for i = 1..16</a>
%H A249107 Wojciech Izykowski, <a href="https://miller-rabin.appspot.com/">Deterministic variants of the Miller-Rabin primality test</a>, Miller-Rabin SPRP bases records.
%H A249107 Jurij Kovič, <a href="https://cs.uwaterloo.ca/journals/JIS/VOL15/Kovic/kovic4.html">The Arithmetic Derivative and Antiderivative</a>, Journal of Integer Sequences 15 (2012), Article 12.3.8.
%e A249107 First five arithmetic derivatives of 4031 are 168, 332, 336, 832, 2560 and sqrt(4031^2 + 168^2 + 332^2 + 336^2 + 832^2 + 2560^2) = 4873.
%p A249107 with(numtheory);
%p A249107 Dr:=proc(w) local x,p; x:=w*add(op(2,p)/op(1,p),p=ifactors(w)[2]); end:
%p A249107 P:=proc(q,h) local a,b,k,n; for n from 2 to q do a:=n; b:=n^2;
%p A249107 for k from 1 to h do a:=Dr(a); b:=b+a^2; od; if type(sqrt(b),integer) then print(n);
%p A249107 fi; od; end: P(10^9,5);
%Y A249107 Cf. A003415, A051674, A210503, A230543, A249105, A249106, A249110, A258645.
