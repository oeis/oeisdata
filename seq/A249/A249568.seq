%S A249568 3,11,43,59,347,491,1499,383,4091,563,27059,8627,11831,42863,7151,
%T A249568 3119,64319,16943,5279,28607,88259,1173947,919679,2636087,483611,
%U A249568 1768343,52691,2276303,6368459,5430407,10722659,29125787,12816959,151731707,215553911,261860243,169247579,393129311,164037911
%N A249568 Primes arising from A249567.
%C A249568 Sequence is not monotonic.
%H A249568 Robert Israel, <a href="/A249568/b249568.txt">Table of n, a(n) for n = 1..5000</a>
%p A249568 S:= 1: R:= NULL:
%p A249568 for n from 1 to 50 do
%p A249568   m0:= ceil(sqrt(2+S));
%p A249568   if m0::odd then m0:= m0+1 fi;
%p A249568   for m from m0 by 2 do
%p A249568     if isprime(m^2 - S) then
%p A249568       R:= R, m^2-S;
%p A249568       S:= S + m^2;
%p A249568       break
%p A249568 fi od od:
%p A249568 R; # _Robert Israel_, Sep 09 2026
%Y A249568 Cf. A249567.
%K A249568 nonn,changed
%O A249568 1,1
