%C A249149 After 1, these terms factorize as: 5, 7, 2 * 7, 2^4, 2^2 * 11, 2^4 * 3, 2^4 * 3 * 5, 2^5 * 3^2 * 5^2, 2^4 * 3^2 * 5 * 23, 2^5 * 3^3 * 5^2, 2^5 * 3^2 * 5 * 23, 2^4 * 3^4 * 5 * 7, 2^6 * 3^3 * 5 * 7, 2^5 * 3^4 * 5 * 7, 2^5 * 3^4 * 5 * 7 * 13, ...
%F A249149 a(n) = A249440(n)+1.
%o A249149 (Python)
%o A249149 from itertools import count, islice
%o A249149 def A249149_gen(): # generator of terms; uses code/imports from A249442
%o A249149     record = -1
%o A249149     for n in count(0):
%o A249149         v = A249442(n)
%o A249149         if v > record:
%o A249149             record = v
%o A249149             yield n+1
%o A249149 print(list(islice(A249149_gen(), 15))) # _Michael S. Branicky_, Jul 24 2026
