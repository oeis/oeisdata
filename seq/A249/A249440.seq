%N A249440 Positions of records in A249442.
%C A249440 a(16) = 1179359 is the largest term less than 7,000,000.
%C A249440 From a(8) = 239 onward the decimal representation of all terms seem to end with '9', which indicates that from then on, one larger numbers (A249149) are multiples of ten.
%o A249440 (Python)
%o A249440 from itertools import count, islice
%o A249440 def A249440_gen(): # generator of terms; uses code/imports from A249442
%o A249440     record = -1
%o A249440     for n in count(0):
%o A249440         v = A249442(n)
%o A249440         if v > record:
%o A249440             record = v
%o A249440             yield n
%o A249440 print(list(islice(A249440_gen(), 15))) # _Michael S. Branicky_, Jul 24 2026
%Y A249440 A249439 gives the corresponding record values.
