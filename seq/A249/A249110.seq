%I A249110 #27 Nov 03 2026 16:30:58
%S A249110 4,27,3125,398747,823543,1072281223,1320016916,8910114183,10361580899
%N A249110 Numbers that form a Pythagorean 10-tuple with their first eight arithmetic derivatives.
%C A249110 22000000000 < a(10) <= 285311670611 = 11^11. - _Carlo Corti_, Oct 27 2026
%H A249110 Carlo Corti, <a href="https://doi.org/10.5281/zenodo.23695423">Nine-Square Arithmetic-Derivative Tuples: An Extension of OEIS A249110 and Their Scaling Structure</a>, 2026.
%H A249110 Carlo Corti, <a href="/A249110/a249110.txt">Table of arithmetic-derivative witnesses for terms 1..9</a>
%F A249110 330004229*A051674(k) is a term for k >= 1. - _Carlo Corti_, Oct 27 2026
%e A249110 First eight arithmetic derivatives of 398747 are 1692, 2856, 5812, 5816, 8732, 9116, 9500, 15700 and sqrt(398747^2 + 1692^2 + 2856^2 + 5812^2 + 5816^2 + 8732^2 + 9116^2 + 9500^2 + 15700^2) = 399467.
%p A249110 with(numtheory);
%p A249110 Dr:=proc(w) local x,p; x:=w*add(op(2,p)/op(1,p),p=ifactors(w)[2]); end:
%p A249110 P:=proc(q,h) local a,b,k,n; for n from 2 to q do a:=n; b:=n^2;
%p A249110 for k from 1 to h do a:=Dr(a); b:=b+a^2; od; if type(sqrt(b),integer) then print(n);
%p A249110 fi; od; end: P(10^9,8);
%Y A249110 A051674 is a subsequence. - _Ray Chandler_, Dec 22 2016
%Y A249110 Cf. A003415, A051674, A210503, A230543, A249105, A249106, A249107, A258648, A258651.
%K A249110 nonn,more,changed
%O A249110 1,1
