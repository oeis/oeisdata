%S A249636 1,1,2,7,33,186,1213,8949,73300,657589,6396829,66936872,748528619,
%T A249636 8896663389,111873459298,1482522176651,20633389026901,300705290677218,
%U A249636 4576892504775417,72584518271451169,1196883163316172252,20482129284796798609,363138667441109774065,6659922487212111452776
%N A249636 G.f.: Sum_{n>=0} x^n / Product_{k=n..2*n-1} (1 - k*x).
%C A249636 From _Vladeta Jovovic_, Sep 05 2026: (Start)
%C A249636 For n >= 0, a(n+1) is the number of transitive right-Euclidean relations on an n-element labeled set. A relation R is right-Euclidean if xRy and xRz imply yRz for all x, y, z. For n = 2, the 7 transitive right-Euclidean relations are {}, {(1,1)}, {(2,2)}, {(1,1),(2,1)}, {(1,2),(2,2)}, {(1,1),(2,2)}, and {(1,1),(1,2),(2,1),(2,2)}. Hence a(3) = 7.
%C A249636 Equivalently, a(n+1) counts set partitions of an n-element labeled set in which every nonsingleton block has a nonempty distinguished subset, while a singleton block may either have its element distinguished or be left undistinguished. For n = 3, the one-block partition gives 7 choices of a nonempty distinguished subset; the three partitions of type 2+1 give 3*3*2 = 18 choices; and the partition into three singletons gives 2^3 = 8 choices. Hence a(4) = 7 + 18 + 8 = 33. (End)
%H A249636 Alois P. Heinz, <a href="/A249636/b249636.txt">Table of n, a(n) for n = 0..505</a> (first 351 terms from Vaclav Kotesovec)
%F A249636 From _Vladeta Jovovic_, Sep 05 2026: (Start)
%F A249636 E.g.f. of a(n+1): exp(x + exp(2*x) - exp(x)).
%F A249636 a(n+1) = Sum_{k=0..n} binomial(n,k)*A143405(k). (End)
%F A249636 E.g.f.: sqrt(Pi)/2*exp(-1/4)*erfi(exp(x)-1/2) + A367549. - _Alois P. Heinz_, Sep 05 2026
%e A249636 G.f.: A(x) = 1 + x + 2*x^2 + 7*x^3 + 33*x^4 + 186*x^5 + 1213*x^6 +...
%e A249636 where
%e A249636 A(x) = 1 + x/(1-x) + x^2/((1-2*x)*(1-3*x)) + x^3/((1-3*x)*(1-4*x)*(1-5*x)) + x^4/((1-4*x)*(1-5*x)*(1-6*x)*(1-7*x)) + x^5/((1-5*x)*(1-6*x)*(1-7*x)*(1-8*x)*(1-9*x)) +...
%p A249636 b:= proc(n) option remember; `if`(n=0, 1, add(
%p A249636       b(n-j)*binomial(n-1, j-1)*(2^j-1), j=1..n))
%p A249636     end:
%p A249636 a:= n-> add(binomial(n-1, k)*b(k), k=0..n):
%p A249636 seq(a(n), n=0..23);  # _Alois P. Heinz_, Sep 05 2026
%o A249636 (PARI) {a(n)=polcoeff(sum(m=0,n,x^m/prod(k=m,2*m-1,1-k*x +x*O(x^n))),n)}
%o A249636 for(n=0,30,print1(a(n),", "))
%Y A249636 Cf. A143405, A367549.
%K A249636 nonn,changed
%O A249636 0,3
%A A249636 _Paul D. Hanna_, Nov 02 2014
