%S A375493 0,0,1,0,-1,1,3,0,2,-1,-4,1,-2,3,0,0,-3,2,7,-1,4,-4,-12,1,-2,-2,3,3,8,
%T A375493 0,0,0,-3,-3,2,2,-6,7,-1,-1,-9,4,17,-4,1,-12,-33,1,6,-2,-2,-2,-10,3,
%U A375493 -5,3,8,8,21,0,0,0,5,0,-3,-3,-3,-3,-11,2,2,2,15,-6
%N A375493 "s" coefficients of a log_2-like sequence of algebraic integers of the form (r+phi*s), where r and s are integers and phi = (1+sqrt(5))/2 is the golden ratio.
%C A375493 This sequence and A375484 are a co-recursive pair, see A375484 for the construction.
%H A375493 Amiram Eldar, <a href="/A375493/b375493.txt">Table of n, a(n) for n = 1..10000</a>
%F A375493 Totally additive with a(2) = 0, and a(p) = a(p-1) + A375484(p+1) - A375484(p-1) for an odd prime p. - _Amiram Eldar_, Oct 21 2026
%t A375493 A375484[1] = 0; A375484[2] = 1; A375493[1] = 0; A375493[2] = 0;
%t A375493 A375484[n_] := A375484[n] = If[PrimeQ[n], 2*A375484[n-1] + A375493[n+1] - A375484[n+1] - A375493[n-1], With[{p = FactorInteger[n][[1, 1]]}, A375484[p] + A375484[n/p]]];
%t A375493 A375493[n_] := A375493[n] = If[PrimeQ[n], A375493[n-1] + A375484[n+1] - A375484[n-1], With[{p = FactorInteger[n][[1, 1]]}, A375493[p] + A375493[n/p]]];
%t A375493 Array[A375493, 74] (* _Amiram Eldar_, Oct 21 2026 *)
