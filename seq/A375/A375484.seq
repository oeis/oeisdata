%S A375484 0,1,0,2,4,1,-2,3,0,5,10,2,7,-1,4,4,9,1,-7,6,-2,11,24,3,8,8,0,0,-8,5,
%T A375484 5,5,10,10,2,2,15,-6,7,7,20,-1,-22,12,4,25,59,4,-4,9,9,9,22,1,14,1,-7,
%U A375484 -7,-28,6,6,6,-2,6,11,11,11,11,24,3,3,3,-18,16
%N A375484 a(n) = r in a log_2-like sequence of algebraic integers f(n) = (r+phi*s), where phi = (1+sqrt(5))/2 is the golden ratio.
%C A375484 The corresponding s value is A375493(n).
%C A375484 f(n) is logarithmic with f(x*y) = f(x) + f(y) and in particular this requires f(1) = 0.
%C A375484 The value of f(2) is chosen to be f(2) = 1.
%C A375484 For odd primes n, f(n) is a linear interpolation f(p) = ( f(p-1) + phi*f(p+1) ) / (1 + phi), biased towards the higher f(p+1).
%C A375484 Since 1/(1 + phi) = 2 - phi, the r and s coefficients are always integers.
%C A375484 The two sequences can also be generated by a pair of co-recursive integer functions with no reference to phi.
%C A375484 The sequence is not injective and not monotonic.
%H A375484 Amiram Eldar, <a href="/A375484/b375484.txt">Table of n, a(n) for n = 1..10000</a>
%F A375484 f(n) = a(n) + phi*A375493(n).
%F A375484 Totally additive with a(2) = 1, and a(p) = 2*a(p-1) + A375493(p+1) - a(p+1) - A375493(p-1) for an odd prime p. - _Amiram Eldar_, Oct 21 2026
%e A375484 n = 87654321
%e A375484 a(n) = 441
%e A375484 A375493(n) = -256
%e A375484 f(n) = 441+phi*(-256) = 26.78329888
%e A375484 Compare log_2(87654321) = 26.38532187
%t A375484 A375484[1] = 0; A375484[2] = 1; A375493[1] = 0; A375493[2] = 0;
%t A375484 A375484[n_] := A375484[n] = If[PrimeQ[n], 2*A375484[n-1] + A375493[n+1] - A375484[n+1] - A375493[n-1], With[{p = FactorInteger[n][[1, 1]]}, A375484[p] + A375484[n/p]]];
%t A375484 A375493[n_] := A375493[n] = If[PrimeQ[n], A375493[n-1] + A375484[n+1] - A375484[n-1], With[{p = FactorInteger[n][[1, 1]]}, A375493[p] + A375493[n/p]]];
%t A375484 Array[A375484, 74] (* _Amiram Eldar_, Oct 21 2026 *)
%o A375484 (Python)
%o A375484 from sympy import primefactors, isprime
%o A375484 def a(n): # the present sequence
%o A375484     if n in {1,2}: return n-1
%o A375484     if isprime(n): return 2*a(n-1) + b(n+1) - (a(n+1) + b(n-1))
%o A375484     return (lambda f: a(f) + a(n//f))(primefactors(n)[0])
%o A375484 def b(n): # A375493
%o A375484     if n in {1,2}: return 0
%o A375484     if isprime(n): return b(n-1) + a(n+1) - a(n-1)
%o A375484     return (lambda f: b(f) + b(n//f))(primefactors(n)[0])
%Y A375484 Cf. A001622, A375493.
