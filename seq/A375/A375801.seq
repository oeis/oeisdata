%I A375801 #25 Oct 08 2026 00:14:17
%S A375801 1243,40633,43489,132217,132653,163817,355247,356071,356483,356689,
%T A375801 1020403,1021211,1023433,1024039,1024241,1025251,1026059,1026463,
%U A375801 1027069,1027877,1028281,1029493,4018657,4086233,4120399,4236923,4324963,4348051,4386749,4468027,4662677
%N A375801 Digits of composite k start as k', where k' is the arithmetic derivative of k, but k' <> k.
%C A375801 Prime numbers are not considered because any prime with 1 as MSD would be in the sequence.
%C A375801 From _Robert Israel_, Oct 07 2026: (Start)
%C A375801 Let m >= 1, 0 <= r < 10^m and b = 10^(2*m)+r. If d divides b with d + 10^m and b/d + 10^m prime, then the semiprime (d + 10^m) * (b/d + 10^m) is a term.
%C A375801 The first term that is not a semiprime is a(93) = 134801827. (End)
%H A375801 Robert Israel, <a href="/A375801/b375801.txt">Table of n, a(n) for n = 1..200</a>
%e A375801 1243'= 124; 40633' = 406; 355247' = 3552.
%p A375801 ader:= proc(n) local t;
%p A375801    n * add(t[2]/t[1], t = ifactors(n)[2])
%p A375801 end proc:
%p A375801 filter:= proc(n) local d;
%p A375801   if isprime(n) then return false fi;
%p A375801   d:= ader(n);
%p A375801   d < n and d = floor(n/10^(ilog10(n)-ilog10(d)))
%p A375801 end proc:
%p A375801 select(filter, [$4 .. 10^7]); # _Robert Israel_, Oct 06 2026
%Y A375801 Cf. A003415, A249540, A263024, A375819.
