%I A375959 #70 Aug 13 2026 16:25:19
%S A375959 1,1,1,3,3,9,45,315,315,945,4725,33075,297675,3274425,42567525,
%T A375959 638512875,638512875,1915538625,9577693125,67043851875,603394666875,
%U A375959 6637341335625,86285437363125,1294281560446875,22002786527596875,418052944024340625,8779111824511153125,201919571963756521875
%N A375959 Partial products of A006257.
%C A375959 Also the determinant of the n X n lower triangular matrix where row j is the Eytzinger array permutation of {1,2,...,j} (A375825), and similarly any lower triangular matrices with A006257 on their diagonal.
%C A375959 a(n) = a(n-1) iff n = 2^k, since those n are where A006257(n) = 1. - _Stefano Spezia_, Sep 06 2024
%C A375959 Number of permutations that give the maximum number of comparisons for sorting n elements by binary insertions with taking into account left-to-right maxima. - _Alexander Krivilev_, Aug 08 2026
%H A375959 Alois P. Heinz, <a href="/A375959/b375959.txt">Table of n, a(n) for n = 0..506</a>
%H A375959 A. V. Krivilev and E. O. Gavrichenko, <a href="https://journals.rcsi.science/0132-3474/article/view/437980">Analysis of the Binary Insertion Sort Algorithm and Its Modification Based on Comparison Forests</a>, Programming / Programming and computer software. 2026;1:40-59. (In Russian)
%H A375959 Sergey Slotin, <a href="https://algorithmica.org/en/eytzinger">Eytzinger binary search</a>.
%F A375959 a(n) = Product_{k=1..n} A006257(k).
%F A375959 a(n) = a(n-1)*(A152423(n) - 1). - _Alexander Krivilev_, Aug 08 2026
%e A375959 For n = 9, a(9) = 1*1*3*1*3*5*7*1*3 = 945.
%e A375959 For n = 3, there are six possible permutations. Of these, exactly one permutation, namely <3,1,2>, requires the maximum of three comparisons. This is the right element in the n = 3 row of the triangle in A398464. - _Alexander Krivilev_, Aug 08 2026
%p A375959 b:= proc(n) option remember; `if`(n=0, 0, 1+irem(1+b(n-1), n)) end:
%p A375959 a:= proc(n) option remember; `if`(n=0, 1, a(n-1)*b(n)) end:
%p A375959 seq(a(n), n=0..27);  # _Alois P. Heinz_, Jul 28 2026
%t A375959 Table[Product[Flatten[Table[Range[1, 2^n - 1, 2], {n, 1, 6}]][[i]],{i,n}],{n,0,27}] (* _James C. McMahon_, Sep 19 2024 *)
%t A375959 (* Alternative: *)
%t A375959 a[1]=1; a[n_/;(n>1&&IntegerQ[n])]:=a[n]=a[n-1](2n-2^Ceiling[Log2[n]]-1); Table[a[n],{n,1,28}] (* _Alexander Krivilev_, Aug 08 2026 *)
%o A375959 (Python)
%o A375959 from sympy import prod
%o A375959 a = lambda n: prod(((j-(1 << j.bit_length()-1))<<1)+1 for j in range(1, n+1))
%o A375959 print([a(n) for n in range(28)])
%o A375959 (PARI) a(n) = prod(k=1, n, 2*k-2^logint(2*k, 2)+1); \\ _Michel Marcus_, Sep 06 2024
%Y A375959 Cf. A006257, A375825.
%Y A375959 Cf. A398374, A398464.
%K A375959 nonn,easy
%O A375959 0,4
%A A375959 _Darío Clavijo_, Sep 03 2024
%E A375959 a(0)=1 prepended by _Alois P. Heinz_, Jul 28 2026
