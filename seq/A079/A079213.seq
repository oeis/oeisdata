%e A079213   1, 41, 336, 1016, 1376, 996, 378, 92, 9, 1;
%e A079213   ...
%e A079213 T(5,3)=22; one of the 22 sets of 3 is shown by the asterisks below; the 'o's denote black squares not in the set.
%e A079213    *.o.o
%e A079213    .*.o.
%e A079213    o.o.*
%e A079213    .o.o.
%e A079213    o.o.o
%t A079213 f[m_, n_, 0] := 1; f[m_, n_, k_] := f[m, n, k]=Sum[If[EvenQ[m+n+mp+np], f[mp, np, k-1], 0], {mp, k-1, m-1}, {np, k-1, n-1}]; T[n_, k_] := f[n, n, k]; Flatten[Table[T[n, k], {n, 0, 11}, {k, 0, n}]]
%o A079213 (PARI)
%o A079213 T(n) = { my(g=(1+x) * (1+x*y) / ((1-x^2) * (1-x^2*y^2) - x^2*y*z*(1+x^2*y)) + O(x^(2*n+1))); vector(n+1, n, n--; Vecrev(polcoef(polcoef(g, 2*n, x), n, y))) }
%o A079213 { my(A=T(10)); for(i=1, #A, print(A[i])) } \\ _Andrew Howroyd_, Aug 31 2026
%Y A079213 Row sums appear to be A025565(n+1).
%Y A079213 Columns 0..1 are A000012, A000982.
