%S A079129 1,1,2,6,21,105,530,3710,27265,229705,2083354,24025694,263359173,
%T A079129 3457302849,44575118874,600902614598,9242750538593,169974915437041,
%U A079129 2905860232733458,56257078771371478,1041600031067604437,19990420041926339577,419763750266646291714
%N A079129 Number of degree-n permutations with pairwise coprime cycle lengths.
%C A079129 a(n) is the number of permutations of [n] whose cycle lengths are pairwise coprime; fixed points may repeat, but every cycle length k >= 2 occurs at most once. - _Pierre Colmant_, Oct 12 2026
%H A079129 Alois P. Heinz, <a href="/A079129/b079129.txt">Table of n, a(n) for n = 0..200</a>
%F A079129 E.g.f.: exp(x) * Sum_{S} Product_{k in S} (x^k/k), where S ranges over finite pairwise-coprime subsets of {2,3,...}. - _Pierre Colmant_, Oct 12 2026
%o A079129 (Python)
%o A079129 from math import gcd, factorial
%o A079129 def parts(n, m=None):
%o A079129     if m is None: m = n
%o A079129     if n == 0:
%o A079129         yield {}
%o A079129         return
%o A079129     for k in range(min(n, m), 0, -1):
%o A079129         for p in parts(n - k, k):
%o A079129             q = dict(p); q[k] = q.get(k, 0) + 1
%o A079129             yield q
%o A079129 def a(n):
%o A079129     t = 0
%o A079129     for p in parts(n):
%o A079129         ks = list(p)
%o A079129         if all(p[k] == 1 for k in ks if k > 1) and all(gcd(i, j) == 1 for i in ks for j in ks if i < j):
%o A079129             d = 1
%o A079129             for k in ks: d *= k**p[k] * factorial(p[k])
%o A079129             t += factorial(n) // d
%o A079129     return t
%o A079129 print([a(n) for n in range(23)]) # _Pierre Colmant_, Oct 12 2026
%Y A079129 Cf. A051424, A079128, A319113 (the subfamily with no fixed points and distinct prime cycle lengths).
