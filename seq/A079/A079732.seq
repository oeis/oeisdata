%I A079732 #9 Oct 22 2026 19:02:16
%S A079732 5,11,13,23,29,37,43,53,61,71,83,101,103,107,109,131,139,149,151,163,
%T A079732 167,173,181,197,211,229,263,277,293,317,331,349,359,373,389,397,419,
%U A079732 439,461,467,491,503,523,541,547,557,587,599,613,631,643,653,659,677,683,701,709
%N A079732 Primes of the form x^2 + y^2 + 3 (x,y positive).
%H A079732 Robert Israel, <a href="/A079732/b079732.txt">Table of n, a(n) for n = 1..10000</a>
%p A079732 isss:= proc(n) local F;
%p A079732    F:= ifactors(n)[2];
%p A079732    if ormap(t -> t[1] mod 4 = 3 and t[2]::odd, F) then return false fi;
%p A079732    ormap(t -> (t[1] = 2 and t[2]::odd) or (t[1] mod 4 = 1), F)
%p A079732 end proc:
%p A079732 select(t -> isprime(t) and isss(t-3), [seq(i,i=5..1000,2)]); # _Robert Israel_, Oct 21 2026
%Y A079732 Cf. A079733, A079739, A079740.
%K A079732 nonn,changed
%O A079732 1,1
%A A079732 _N. J. A. Sloane_, Feb 18 2003
