%T A131602 12,8,3,4,1,0,8,2,2,7,6,11,15,3,10,2,7,2,5,1,15,8,6,12,6,10,1,1,13,0,
%U A131602 12,1,8,14,9,5,2,7,6,7,15,0,11,1,5,3,13,2,7,11,7,15,0,3,4,7,0,4,5,11,5,11
%N A131602 Hexadecimal expansion of golden ratio phi = (1 + sqrt 5) / 2.
%H A131602 Adam Reichert, <a href="/A131602/b131602.txt">Table of n, a(n) for n = 1..10000</a>
%H A131602 R. L. Graham, D. E. Knuth, and O. Patashnik, <a href="https://archive.org/details/B-001-002-135/page/n85/mode/1up">Concrete Mathematics: A Foundation for Computer Science</a>, 1st ed., Addison-Wesley, 1989, p. 72.
%H A131602 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/GoldenRatio.html">Golden Ratio</a>
%F A131602 Equals (1 + sqrt 5) / 2 [base 16].
%F A131602 a(n) = floor((s + floor(sqrt(5*s^2)))/2) mod 16, where s = 16^(n-1). This follows from the definition of phi and the floor identity in Graham, Knuth, and Patashnik, p. 72. - _Adam Reichert_, Oct 14 2026
%F A131602 a(1) = 1; for n >= 2, a(n) = 8*A068432(4*n-6) + 4*A068432(4*n-5) + 2*A068432(4*n-4) + A068432(4*n-3). - _Adam Reichert_, Oct 14 2026
%e A131602 (1.9E3779B97F4A7C15F39CC0605CEDC...)_16. - _Adam Reichert_, Oct 14 2026
%e A131602 a(21) = 12 because A068432(78), ..., A068432(81) are 1, 1, 0, 0, giving 8*1 + 4*1 + 2*0 + 0 = 12. - _Adam Reichert_, Oct 14 2026
%t A131602 RealDigits[(1 + Sqrt[5])/2, 16, 200] (* _Stefan Steinerberger_, Sep 14 2007 *)
%t A131602 (* Alternative: *)
%t A131602 RealDigits[GoldenRatio,16,100][[1]] (* _Harvey P. Dale_, Oct 24 2020 *)
%o A131602 (Python)
%o A131602 from math import isqrt
%o A131602 def a131602(n, base=16):
%o A131602     scale = base ** (n - 1)
%o A131602     return ((scale + isqrt(5 * scale**2)) // 2) % base # _Adam Reichert_, Oct 14 2026
