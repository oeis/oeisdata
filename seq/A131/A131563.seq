%N A131563 Decimal expansion of e*Pi*phi, where phi = (1 + sqrt(5))/2.
%H A131563 Harry J. Smith, <a href="/A131563/b131563.txt">Table of n, a(n) for n = 2..20000</a>
%F A131563 From _G. C. Greubel_, Nov 11 2026: (Start)
%F A131563 Equals e*Pi*(1 + sqrt(5))/2 = A001113 * A000796 * A001622 = A019609 * A001622.
%F A131563 Equals A001113 * A094886 = A094885 * A000796 = 5*A135155. (End)
%e A131563 e*Pi*phi = 13.817580227...
%p A131563 exp(1)*Pi*(1+sqrt(5))/2;
%t A131563 phi=(5^(1/2)+1)/2; RealDigits[N[Pi*E*phi,6! ]][[1]] (* _Vladimir Joseph Stephan Orlovsky_, Jun 18 2009 *)
%t A131563 (* Alternative: *)
%t A131563 RealDigits[E*Pi*GoldenRatio,10,120][[1]] (* _Harvey P. Dale_, Nov 02 2020 *)
%o A131563 (PARI) { default(realprecision, 20080); phi = (1 + sqrt(5))/2; x=exp(1)*Pi*phi/10; for (n=2, 250, d=floor(x); x=(x-d)*10; write("b131563.txt", n, " ", d)); } \\ _Harry J. Smith_, Apr 26 2009
%o A131563 (Magma)
%o A131563 m:= 250; R:=RealField(m+2); SetDefaultRealField(R);
%o A131563 c:= Exp(1)*Pi(R)*(1+Sqrt(5))/2;
%o A131563 Prune(Reverse(IntegerToSequence(Round( c*10^m )))); // _G. C. Greubel_, Nov 11 2026
%o A131563 (SageMath)
%o A131563 m=250
%o A131563 c=numerical_approx( exp(1)*pi*(1+sqrt(5))/2 , digits=m+5)
%o A131563 print([ZZ(i) for i in c.str()[:-5] if i.isdigit()]) # _G. C. Greubel_, Nov 11 2026
%Y A131563 Decimal expansions: A000796 (Pi), A001113 (e), A001622 (phi), A019609 (e*phi), A094885 (e*phi), A094886 (Pi*phi).
%Y A131563 Cf. A135155.
%K A131563 cons,nonn,changed
