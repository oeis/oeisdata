%S A320910 2,6,20,50,128,302,708,1612,3624,8048,17704,38604,83660,180118,386096,
%T A320910 823540,1750564,3707226,7828508,16483728,34625100,72563238,151764504,
%U A320910 316802680,660183124,1373536476,2853491920,5919903070,12265917752,25384351034
%N A320910 a(n)/2^n is the expected length of the longest palindromic subsequence of a length-n binary string.
%C A320910 By subsequence we mean "not necessarily contiguous subsequence".
%C A320910 Also the sum of the lengths of the longest palindromic subsequence of each length-n binary string. - _Michael S. Branicky_, Aug 20 2026
%C A320910 The longest palindromic subsequence is at least floor((n+1)/2) via the subsequence of equal elements. - _David A. Corneth_, Aug 20 2026
%F A320910 floor((n+1)/2)*2^n <= a(n) <= n*2^n. - _Michael S. Branicky_, Aug 20 2026
%e A320910 For n = 3, the binary strings are 000, 001, 010, 011, and their bitwise complements, with longest palindromic subsequence of length 3,2,3,2 respectively, so a(3) = 2*(3+2+3+2) = 20.
%o A320910 (Python)
%o A320910 from itertools import product
%o A320910 def lps_len(s): # length of longest palindromic subsequence
%o A320910     n = len(s)
%o A320910     dp = [[0]*n for _ in range(n)]
%o A320910     for i in range(n): dp[i][i] = 1
%o A320910     for L in range(2, n+1):
%o A320910         for i in range(n-L+1):
%o A320910             if s[i] == s[j:=i+L-1]: dp[i][j] = 2 + (dp[i+1][j-1] if L>2 else 0)
%o A320910             else: dp[i][j] = max(dp[i+1][j], dp[i][j-1])
%o A320910     return dp[0][n-1]
%o A320910 def a(n): return 2*sum(lps_len("0"+"".join(w)) for w in product("01", repeat=n-1))
%o A320910 print([a(n) for n in range(1, 18)]) # _Michael S. Branicky_, Aug 19 2026
