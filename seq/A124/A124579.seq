%T A124579 8,9,10,12,12,11,12,13,13,14,15,14,15,13,16,16,17,18,14,19,17,20,15,
%U A124579 21,16,17,18,22,19,18,23,24,19,20,21,25,20,22,23,26,24,21,27,28,22,25,26,29
%N A124579 Number of natural numbers less than n which have identical Moebius mu values.
%H A124579 Alois P. Heinz, <a href="/A124579/b124579.txt">Table of n, a(n) for n = 1..20000</a>
%e A124579 a(10) = 2 because in the first nine integers less than 10, mu(1) = mu(6) = mu(10).
%p A124579 b:= proc(n) b(n):= `if`(n<1, 0, b(n-1)+x^numtheory[mobius](n)) end:
%p A124579 a:= n-> coeff(b(n-1), x, numtheory[mobius](n)):
%p A124579 seq(a(n), n=1..80);  # _Alois P. Heinz_, Aug 05 2026
%t A124579 a[n_] := a[n] = MoebiusMu@n; f[n_] := Count[a /@ Range[n - 1], a@n]; Array[f, 80]
%t A124579 With[{mu=MoebiusMu[Range[80]]},Table[Count[Take[mu,n],_?(#==MoebiusMu[ n+1]&)],{n,0,Length[mu]}]] (* _Harvey P. Dale_, Aug 18 2016 *)
%o A124579 (Python)
%o A124579 # uses Python code from A002321 and A013928
%o A124579 from sympy import mobius
%o A124579 def A124579(n):
%o A124579     x, y = A002321(n-1), A013928(n)
%o A124579     dx, dy = mobius(n), A013928(n+1)-y
%o A124579     sx, sy = dx+(x<<1), dy+(y<<1)
%o A124579     return (dx*sx+3*dy*sy>>2)+n*(1-dy)-y-1 # _Chai Wah Wu_, Aug 12 2026
%Y A124579 Cf. A124580.
%Y A124579 Cf. A008683, A002321.
%K A124579 nonn,changed
%O A124579 1,5
