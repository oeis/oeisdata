%S A155142 5,13,23,29,31,41,53,59,67,71,79,103,113,131,139,149,151,157,167,173,
%T A155142 179,193,211,229,239,241,257,271,283,311,337,359,367,373,379,383,401,
%U A155142 409,419,421,463,479,491,499,503,509,521,563,599,601,607,617,641,643
%N A155142 Primes p that belong neither to A155140 nor to A155141.
%C A155142 The numbers of terms that do not exceed the (10^k)-th prime, for k = 1, 2, ..., are 4, 47, 429, 4263, 42595, 425898, 4255470, 42559800, 425609018, 4256085129, ... . It appears that the relative asymptotic density of this sequence within the primes exists and equals 2 * Product_{p odd prime} (1-1/(p*(p-1))) - 2 * Product_{p odd prime} (1-2/(p*(p-1))) = 0.4256092292435316856509... . - _Amiram Eldar_, Aug 20 2026
%H A155142 John Cerkan, <a href="/A155142/b155142.txt">Table of n, a(n) for n = 1..10000</a>
%t A155142 lst={};Do[p=Prime[n];If[SquareFreeQ[p-4]&&SquareFreeQ[p+4],NULL,If[ !SquareFreeQ[p-4]&&!SquareFreeQ[p+4],NULL,AppendTo[lst,p]]],{n,6!}];lst
%o A155142 (PARI) list(pmax) = forprime(p = 2, pmax, if (issquarefree(p-4) != issquarefree(p+4), print1(p, ", "))); \\ _Amiram Eldar_, Aug 20 2026
