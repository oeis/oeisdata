%U A153807 189808681,196906961,199609661,616906919,661609199,666101999,668609899,689609689,691609169,698609869
%N A153807 Strobogrammatic cyclops primes.
%C A153807 Primes in A153806.
%H A153807 Andrew Howroyd, <a href="/A153807/b153807.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..184 from Alexander Krivilev)
%t A153807 strobogrammaticQ[n_] := n == (If[FreeQ[#, 2 | 3 | 4 | 5 | 7 | {__, 0..}], FromDigits@Reverse@(# /. {6 -> 9, 9 -> 6}), 0] &)@ IntegerDigits@n;
%t A153807 Select[FromDigits@Flatten[#] & /@ Tuples[{Append[#, 0] & /@ Tuples[{1, 6, 8, 9}, #], Tuples[{1, 6, 8, 9}, #]}], PrimeQ[#] && strobogrammaticQ[#] &] & /@ Range[1, 5] // Flatten (* _Alexander Krivilev_, Oct 18 2026 *)
%o A153807 (PARI) lista(n) = my(L=List(), lv=[1,6,8,9], rv=[1,9,8,6]); for(k=1, oo, forvec(x=vector(k,i,[1,4]), my(p=fromdigits(vector(2*k+1, i, if(i<=k, lv[x[i]], i>k+1, rv[x[2*k+2-i]], 0)))); if(isprime(p), listput(L,p); if(#L==n, return(Vec(L)))) )); \\ _Andrew Howroyd_, Oct 18 2026
