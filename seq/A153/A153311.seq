%N A153311 Triangle read by rows: T(n,k) = [x^k] P(n) where P(0) = 2, P(1) = 3+x, P(2) = 2+14*x+2*x^2, and P(n) = (x+1) * (P(n-1) + 3^(n-2) * (x + x^floor(n/2) + x^(n-2))).
%C A153311 Row sums are 2*3^n.
%e A153311 Triangle begins:
%e A153311   {2},
%e A153311   {3, 3},
%e A153311   {2, 14, 2},
%e A153311   {2, 25, 25, 2},
%e A153311   {2, 36, 77, 45, 2},
%e A153311   {2, 65, 167, 176, 74, 2},
%e A153311   {2, 148, 313, 424, 412, 157, 2},
%e A153311   {2, 393, 704, 980, 1079, 812, 402, 2},
%e A153311   {2, 1124, 1826, 1684, 2788, 2620, 1943, 1133, 2},
%e A153311   {2, 3313, 5137, 3510, 6659, 7595, 4563, 5263, 3322, 2},
%e A153311   {2, 9876, 15011, 8647, 10169, 20815, 18719, 9826, 15146, 9885, 2},
%e A153311   ...
%t A153311 Clear[p, n, m, x];
%t A153311 p[x, 0] = 2; p[x, 1] = 3*x + 3; p[x, 2] = 2*x^2 + 14*x + 2;
%t A153311 p[x_, n_] := p[x, n] = (x + 1)*(p[x, n - 1] + 3^(n - 2)*(x + x^Floor[n/2] + x^(n - 2)));
%t A153311 Table[ExpandAll[p[x, n]], {n, 0, 10}];
%t A153311 Table[CoefficientList[p[x, n], x], {n, 0, 10}];
%t A153311 Flatten[%]
%Y A153311 Cf. A025192.
%K A153311 nonn,less,tabl,changed
