%I A153214 #22 Aug 03 2026 11:10:48
%S A153214 47,1447,1847,3701,6653,11273,14947,15727,17053,18493,21661,24923,
%T A153214 26647,29153,32789,33023,38873,39323,42437,42923,44053,47527,47977,
%U A153214 49853,52027,52153,56747,56873,59929,71147,74189,79427,80953,99277,99713,109267,112997,113227,115553
%N A153214 Primes p such that p+-2 and p+-3 are not squarefree.
%H A153214 David A. Corneth, <a href="/A153214/b153214.txt">Table of n, a(n) for n = 1..10000</a>
%e A153214 47 is a term since 47 is prime and each of 47 - 3, 47 - 2, 47 + 2 and 47 + 3 are not squarefree. - _David A. Corneth_, Aug 02 2026
%t A153214 lst={};Do[p=Prime[n];If[ !SquareFreeQ[p-2]&&!SquareFreeQ[p+2]&&!SquareFreeQ[p-3]&&!SquareFreeQ[p+3],AppendTo[lst,p]],{n,3*7!}];lst
%t A153214 (* Alternative: *)
%t A153214 Select[Prime[Range[10000]],NoneTrue[#+{-3,-2,2,3},SquareFreeQ]&] (* Requires Mathematica version 10 or later *) (* _Harvey P. Dale_, Aug 27 2019 *)
%o A153214 (PARI) is(n) = {if(n < 47, return(0)); if(!isprime(n), return(0)); my(d = [-3, -2, 2, 3]); for(i = 1, #d, if(issquarefree(n + d[i]), return(0))); 1} \\ _David A. Corneth_, Aug 02 2026
