%N A372706 a(n) = Sum_{k=1..n} mu(n*k), where mu is the Moebius function A008683.
%H A372706 Amiram Eldar, <a href="/A372706/b372706.txt">Table of n, a(n) for n = 1..10000</a>
%F A372706 If n is not squarefree, a(n) = 0.
%t A372706 a[n_] := Sum[MoebiusMu[n*k], {k, 1, n}]; Array[a, 100] (* _Amiram Eldar_, Sep 15 2026 *)
%o A372706 (PARI) a(n) = sum(k=1, n, moebius(n*k));
