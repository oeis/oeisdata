%S A372305 1,1,2,2,32,2,648,8,648,32,12500000,8,214990848,648,2048,2048,
%T A372305 562949953421312,648,11712917736940032,2048,3359232,12500000,
%U A372305 1377791989621882898843648,128,5120000000000000000,214990848,11712917736940032,3359232,6582680986455533438466227437568,2048
%N A372305 a(n) = Product_{k=2..n-1} MultiplicativeOrder(k,n) where gcd(k,n)=1.
%C A372305 All terms are even for n>=3.
%H A372305 Robert Israel, <a href="/A372305/b372305.txt">Table of n, a(n) for n = 1..438</a>
%F A372305 From _Ridouane Oudra_, May 23 2026: (Start)
%F A372305 a(n) = Product_{d|lambda(n)} d^A252911(n,d), where lambda = A002322.
%F A372305 If n is in A033948 then:
%F A372305 a(n) = Product_{d|lambda(n)} d^phi(d), or also: a(n) = Product_{d|phi(n)} d^phi(d).
%F A372305 In particular, a(p) = Product_{d|(p-1)} d^phi(d), for p prime. (End)
%p A372305 f:= proc(n) local k;
%p A372305   mul(`if`(igcd(k,n)=1, NumberTheory:-MultiplicativeOrder(k,n),1),k=1..n-1)
%p A372305 end proc:
%p A372305 map(f, [$1..30]); # _Robert Israel_, Nov 22 2026
%t A372305 Table[Times @@ Map[MultiplicativeOrder[#, n] &, Select[Range[2, n - 1], CoprimeQ[n, #] &]], {n, 2, 30}] (* _Michael De Vlieger_, Apr 25 2024 *)
%o A372305 (Python)
%o A372305 from sympy import n_order, gcd, prod
%o A372305 a = lambda n: prod(n_order(k,n) for k in range(2, n) if gcd(k,n)==1)
%o A372305 print([a(n) for n in range(1, 28)])
%o A372305 (PARI) a(n) = prod(k=2, n-1, if (gcd(k,n)==1, znorder(Mod(k,n)), 1)); \\ _Michel Marcus_, Apr 26 2024
