%I A372946 #10 Aug 04 2026 01:18:09
%S A372946 1,7,217,3937,6727,6847,51943,170671,330337,385687,2484247,2566537,
%T A372946 2904007,3020857,3696967,6465577,9405337,12021439,19384207,23618497,
%U A372946 28127137,32247967,46050361,51064657,70694167,104171137,104237017,107571457,111313849,215502871,316653127
%N A372946 Numbers k that divide the k-th NSW number.
%C A372946 Numbers k such that k | A002315(k).
%H A372946 Chai Wah Wu, <a href="/A372946/b372946.txt">Table of n, a(n) for n = 1..100</a>
%e A372946 7 is a term since A002315(7) = 275807 = 7 * 39401 is divisible by 7.
%t A372946 seq[kmax_] := Module[{nsw0 = 1, nsw1 = 7, nsw2, s = {1}}, Do[nsw2 = 6*nsw1 - nsw0; If[Divisible[nsw2, k], AppendTo[s, k]]; nsw0 = nsw1; nsw1 = nsw2, {k, 2, kmax}]; s]; seq[52000]
%o A372946 (PARI) lista(kmax) = {my(nsw0 = 1, nsw1 = 7, nsw2); print1("1, "); for(k = 2, kmax, nsw2 = 6*nsw1 - nsw0; if(!(nsw2 % k), print1(k, ", ")); nsw0 = nsw1; nsw1 = nsw2);}
%o A372946 (Python)
%o A372946 from itertools import count, islice, filterfalse
%o A372946 def A372946_gen(startvalue=1): # generator of terms >= startvalue
%o A372946     def A002315_mod(n,m): # n-th NSW number mod m
%o A372946         a, b, c, d, a2, b2, c2, d2 = 6, -1, 1, 0, 1, 0, 0, 1
%o A372946         for x in bin(n)[2:]:
%o A372946             e, f = b2*c2%m, k if (k:=a2+d2)<m else k-m
%o A372946             a2, b2, c2, d2 = (a2*a2+e)%m, b2*f%m, c2*f%m, (d2*d2+e)%m
%o A372946             if x=='1':
%o A372946                 a2, b2, c2, d2 = (a2*a+b2*c)%m, (a2*b+b2*d)%m, (c2*a+d2*c)%m, (c2*b+d2*d)%m
%o A372946         return (7*c2+d2)%m
%o A372946     return filterfalse(lambda k:A002315_mod(k,k), count(max(startvalue,1)))
%o A372946 A372946_list = list(islice(A372946_gen(),10)) # _Chai Wah Wu_, Aug 03 2026
%Y A372946 Cf. A002315, A330276.
