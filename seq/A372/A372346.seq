%U A372346 114418196763735113,5670168958036693977,309630356618418661738,18536683645526372648446,1211038603734731649106307,85983731724631359047504967
%N A372346 a(n) = Sum_{j=0..n} p(n - j, j) where p(n, x) = Sum_{k=0..n} k! * Stirling2(n, k) * x^k. Row sums of A344499.
%H A372346 Alois P. Heinz, <a href="/A372346/b372346.txt">Table of n, a(n) for n = 0..314</a>
%F A372346 a(n) = A094422(n - 1) + 1.
%p A372346 p := n -> local k; add(k!*Stirling2(n, k)*x^k, k = 0..n):
%p A372346 a := n -> local j; add(subs(x = j, p(n - j)),  j = 0..n):
%p A372346 seq(a(n), n = 0..21);
%p A372346 # Alternative:
%p A372346 b:= proc(n,k) option remember; `if`(n=0, 1,
%p A372346       k*add(binomial(n, j)*b(j, k), j=0..n-1))
%p A372346     end:
%p A372346 a:= n-> add(b(j,n-j), j=0..n):
%p A372346 seq(a(n), n=0..21);  # _Alois P. Heinz_, Jul 27 2026
%Y A372346 Cf. A094416, A344499, A131689, A094422.
%K A372346 nonn,changed
