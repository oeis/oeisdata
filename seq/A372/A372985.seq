%N A372985 a(n) = floor((a(n-1)+a(n-2)+n)/a(n-2)), with a(1)=1, a(2)=2.
%C A372985 -2 < a(n) - sqrt(n) < 4 for n >= 9. - _Robert Israel_, Nov 18 2026
%H A372985 Robert Israel, <a href="/A372985/b372985.txt">Table of n, a(n) for n = 1..10000</a>
%p A372985 f:= proc(n) option remember;
%p A372985      floor((procname(n-1)+procname(n-2)+n)/procname(n-2))
%p A372985 end proc:
%p A372985 f(1):= 1: f(2):= 2:
%p A372985 map(f, [$1..100]); # _Robert Israel_, Nov 18 2026
%t A372985 a[1] = 1; a[2] = 2;
%t A372985 a[n_] := a[n] = Floor[(a[n - 1] + a[n - 2] + n)/a[n - 2]];
%t A372985 Table[a[n], {n, 1, 100}]
%Y A372985 Cf. A372982, A372983, A372984.
