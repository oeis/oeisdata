%S A372899 1,2,6,18,54,66,162,198,486,594,726,1314,1458,1782,2178,2838,3222,
%T A372899 3942,4374,5346,5778,5874,6534,7986,8514,8646,9666,11826,13122,14454,
%U A372899 16038,17334,17622,19602,23958,25542,25938,28998,31218,35442,35478,39366,43362,48114
%N A372899 Numbers k that divide the k-th companion Pell number.
%C A372899 Numbers k such that k | A002203(k).
%H A372899 Chai Wah Wu, <a href="/A372899/b372899.txt">Table of n, a(n) for n = 1..4281</a> (terms 1..327 from Amiram Eldar)
%e A372899 2 is a term since A002203(2) = 6 = 2 * 3 is divisible by 2.
%e A372899 6 is a term since A002203(6) = 198 = 6 * 33 is divisible by 6.
%t A372899 Select[Range[50000], Divisible[LucasL[#, 2], #] &]
%o A372899 (PARI) lista(kmax) = {my(p1 = 2, p2 = 6, p3); print1("1, 2, "); for(k = 3, kmax, p3 = p1 + 2*p2; if(!(p3 % k), print1(k, ", ")); p1 = p2; p2 = p3);}
%o A372899 (Python)
%o A372899 from itertools import count, islice, filterfalse
%o A372899 def A372899_gen(startvalue=1): # generator of terms >= startvalue
%o A372899     def A002203_mod(n,m): # A002203(n) mod m
%o A372899         a2, b2, c2, d2 = 1, 0, 0, 1
%o A372899         for x in bin(n)[2:]:
%o A372899             e, f = b2*c2%m, k if (k:=a2+d2)<m else k-m
%o A372899             a2, b2, c2, d2 = (a2*a2+e)%m, b2*f%m, c2*f%m, (d2*d2+e)%m
%o A372899             if x=='1':
%o A372899                 a2, b2, c2, d2 = ((a2<<1)+b2)%m, a2, ((c2<<1)+d2)%m, c2
%o A372899         return (c2+d2<<1)%m
%o A372899     return filterfalse(lambda k: A002203_mod(k,k),count(max(startvalue,1)))
%o A372899 A372899_list = list(islice(A372899_gen(),30)) # _Chai Wah Wu_, Aug 07 2026
%Y A372899 Cf. A002203.
