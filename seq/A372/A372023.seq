%U A372023 210178458,-591347988,1668172842,-4717282752,13369522250,-37970114702,108045430902,-308001125516
%N A372023 Expansion of ( (1 + 3*x)/(1 - x) )^(1/2).
%H A372023 Alois P. Heinz, <a href="/A372023/b372023.txt">Table of n, a(n) for n = 0..2108</a>
%F A372023 a(n) = Sum_{k=0..n} 4^k * binomial(1/2,k) * binomial(n-1,n-k).
%F A372023 a(n) = (-1)^(n-1) * 2 * A005043(n-1) for n > 0.
%F A372023 a(n) ~ (-1)^(n+1) * 3^(n + 1/2) / (4*sqrt(Pi)*n^(3/2)). - _Vaclav Kotesovec_, Apr 16 2024
%F A372023 a(n) = (-2*(n-2)*a(n-1) + 3*(n-2)*a(n-2)) / n for n >= 2, a(0) = 1, a(1) = 2. - _Dmytro Dmytryshyn_, Sep 13 2026
%p A372023 a:= proc(n) option remember; `if`(n<2, 1+n,
%p A372023      (-(2*(n-2))*a(n-1)+(3*(n-2))*a(n-2))/n)
%p A372023     end:
%p A372023 seq(a(n), n=0..30); # _Dmytro Dmytryshyn_, Sep 13 2026
%o A372023 (PARI) my(N=40, x='x+O('x^N)); Vec(sqrt((1+3*x)/(1-x)))
%o A372023 (PARI) a(n) = sum(k=0, n, 4^k*binomial(1/2, k)*binomial(n-1, n-k));
%Y A372023 Cf. A005043, A103872, A372024.
