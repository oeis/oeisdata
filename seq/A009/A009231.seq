%N A009231 Expansion of e.g.f. exp(sinh(x)*log(1+x)).
%F A009231 From _Seiichi Manyama_, Oct 21 2026: (Start)
%F A009231 E.g.f.: (1 + x)^sinh(x).
%F A009231 a(0) = 1; a(n) = (1/2) * Sum_{k=1..n} (-1)^k * (A002104(k) - A002741(k)) * binomial(n-1,k-1) * a(n-k). (End)
%F A009231 a(n) ~ n! * (-1)^n * n^(sinh(1)-1) / Gamma(sinh(1)). - _Vaclav Kotesovec_, Oct 21 2026
%t A009231 With[{nn=20}, CoefficientList[Series[Exp[Sinh[x]Log[1+x]], {x,0,nn}] ,x] Range[0,nn]!] (* _Harvey P. Dale_, Dec 19 2012 *)
%o A009231 (PARI) my(N=30, x='x+O('x^N)); Vec(serlaplace((1+x)^sinh(x))) \\ _Seiichi Manyama_, Oct 21 2026
%Y A009231 Cf. A002104, A002741, A353995.
%K A009231 sign,easy,changed
%O A009231 0,3
