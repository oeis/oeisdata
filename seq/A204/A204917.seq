%I A204917 #12 Aug 12 2026 01:37:08
%S A204917 1,2,1,2,1,3,1,2,1,2,1,3,1,2,1,2,1,4,1,2,1,3,7,3,1,4,1,2,1,4,1,3,1,5,
%T A204917 2,4,11,4,1,2,1,5,1,3,1,7,13,3,1,8,1,4,15,9,1,2,1,7,1,4,1,8,3,6,2,3,
%U A204917 18,5,7,2,1,4,1,11,1,4,8,4,18,2,1,10,17,5,2,8,1,3,20,6,1
%N A204917 Least j such that n divides s(A204916(n))-s(j), where s(j)=(prime(j))^2.
%C A204917 For a guide to related sequences, see A204892.
%H A204917 Robert Israel, <a href="/A204917/b204917.txt">Table of n, a(n) for n = 1..10000</a>
%p A204917 f:= proc(n) local S,J,p,s,k;
%p A204917   S:= {}: p:= 1:
%p A204917   for k from 1 do
%p A204917     p:= nextprime(p);
%p A204917     s:= p^2 mod n;
%p A204917     if member(s,S) then return J[s] fi;
%p A204917     S:= S union {s};
%p A204917     J[s]:= k;
%p A204917   od
%p A204917 end proc:
%p A204917 map(g, [$1..100]); # _Robert Israel_, Aug 11 2026
%t A204917 (* See the program at A204916. *)
%Y A204917 Cf. A204916, A204908, A204900, A204892.
%K A204917 nonn,look,changed
%O A204917 1,2
