%T A204985 252,248,240,224,192,128,510,508,504,496,480,448,384,256,1022,1020,
%U A204985 1016,1008,992,960,896,768,512,2046,2044,2040,2032,2016,1984,1920
%N A204985 Ordered differences of numbers 2^k for k>=1.
%C A204985 Equals 2*A130328.  For a guide to related sequences, see A204892.
%t A204985 (See the program at A204987.)
%o A204985 (Python)
%o A204985 from math import isqrt, comb
%o A204985 def A204985(n):
%o A204985     a = (m:=isqrt(k:=n<<1))+(k>m*(m+1))+1
%o A204985     return (1<<a)-(1<<a+n-comb(a,2)-1) # _Chai Wah Wu_, Oct 09 2026
%Y A204985 Cf. A130328, A204987, A204892.
%K A204985 nonn,changed
