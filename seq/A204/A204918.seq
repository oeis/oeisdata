%T A204918 289,841,49,529,361,841,121,961,169,841,121,169,529,289,121,1849,961,
%U A204918 121,49,1849,289,1681,289,49,841,2809,121,2209,961,361,361,3481
%N A204918 Square of the least prime p such that n divides p^2-q^2 for some prime q satisfying q<p.
%C A204918 For a guide to related sequences, see A204892.
%H A204918 Robert Israel, <a href="/A204918/b204918.txt">Table of n, a(n) for n = 1..10000</a>
%F A204918 a(n) = A001248(A204916(n)). - _Robert Israel_, Aug 11 2026
%p A204918 f:= proc(n) local S,p,s,k;
%p A204918   S:= {}: p:= 1:
%p A204918   for k from 1 do
%p A204918     p:= nextprime(p);
%p A204918     s:= p^2 mod n;
%p A204918     if member(s,S) then return p^2 fi;
%p A204918     S:= S union {s}
%p A204918   od
%p A204918 end proc:
%p A204918 map(f, [$1..100]); # _Robert Israel_, Aug 11 2026
%t A204918 (* See the program at A204916. *)
%Y A204918 Cf. A001248, A204916, A204908, A204900, A204892.
%K A204918 nonn,look,changed
%O A204918 1,1
