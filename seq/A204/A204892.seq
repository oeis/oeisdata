%C A204892   s(k): A205132, s(j): A205133, s(k) - s(j): A205134 = n*A205135;
%C A204892 central binomial coefficients: s = A000984(.-1), k: A205010, j: A205011,
%C A204892   s(k): A205012, s(j): A205013, s(k) - s(j): A205014 = n*A205015;
%C A204892 half central binomial coefficients: s = A088218, k: A205386, j: A205387,
%C A204892   s(k): A205388, s(j): A205389, s(k) - s(j): A205390 = n*A205391;
%C A204892 oblong numbers n(n+1): s = A002378, k: A205018, j: A205028,
%C A204892   s(k): A205029, s(j): A205030, s(k) - s(j): A205031 = n*A205032;
