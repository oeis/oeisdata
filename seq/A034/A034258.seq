%S A034258 1,1,1,2,2,2,2,2,3,3,3,3,3,4,4,5,5,5,5,6,6,6,6,7,7,7,8,8,8,8,8,9,9,10,
%T A034258 10,10,10,11,11,12,12,12,12,12,12,13,13,13,14,14,15,15,15,15,15,15,16,
%U A034258 17,17,17,17,18,18,18,19,19,19,20,20,20,20,21,21,21,21,21,22,22,22
%N A034258 Write n! as a product of n numbers, n! = k(1)*k(2)*...*k(n) with k(1) <= k(2) <= ..., in all possible ways; a(n) = max value of k(1).
%C A034258 36, 49, 52 and 55 are not in this sequence. - _Don Reble_, Nov 29 2001
%C A034258 a(n) >= a(n-1). - Larry Reeves (larryr(AT)acm.org), Jan 06 2005
%C A034258 From _Bernard Schott_, Oct 31 2021: (Start)
%C A034258 a(n) is a monotonic, though not strictly monotonic, increasing function of n.
%C A034258 Complement for 1st comment: a(124) = 35 and a(125) = 37 (see Guy's book). (End)
%D A034258 Richard K. Guy, Unsolved Problems in Number Theory, 3rd Edition, Springer, 2004, Section B22, pp. 122-123.
%H A034258 Terence Tao, <a href="/A034258/b034258.txt">Table of n, a(n) for n = 1..10000</a>
%H A034258 Thomas Bloom, <a href="https://www.erdosproblems.com/391">Problem 391</a>, Erdős Problems.
%H A034258 Diophante, <a href="http://www.diophante.fr/problemes-par-themes/arithmetique-et-algebre/a1-pot-pourri/1967-a1987-les-factorielles-revisitees">A1987 - Les factorielles revisitées</a> (c. 2011).
%H A034258 Erdős problems database contributors, <a href="https://github.com/teorth/erdosproblems/blob/main/README.md#table">Erdős problem database</a>, see no. 391.
%H A034258 Richard K. Guy and John L. Selfridge, <a href="https://www.jstor.org/stable/2588996">Factoring factorial n</a>, Amer. Math. Monthly, Vol. 105, No. 8 (1998), pp. 766-767.
%H A034258 Bernard Schott, <a href="/A034258/a034258_2.txt">Corresponding products for n!</a>
%H A034258 Terence Tao, <a href="https://arxiv.org/abs/2503.20170">Decomposing a factorial into large factors</a>, arXiv:2503.20170 [math.NT], 2025.
%H A034258 Terence Tao, <a href="https://github.com/teorth/erdos-guy-selfridge">Erdos-Guy-Selfridge project</a> - a collaborative project to compute upper and lower bounds on this sequence
%H A034258 Terence Tao, <a href="https://github.com/teorth/erdos-guy-selfridge/blob/main/Data/a034258-lpsolve.txt">The first 10000 elements of the sequence</a> (from the above project)
%F A034258 If p is prime, a(p-1) = a(p). - _Bernard Schott_, Oct 24 2021
%F A034258 Tao proves that a(n) ~ n/e. Apparently this was in the unpublished work of Erdős, Selfridge, and Straus but this proof has been lost. See Tao (2025) for more precise results. - _Charles R Greathouse IV_, May 13 2025
%e A034258 3! = 6 = 1*2*3 is the only possible factorization, so a(3) = 1.
%e A034258 27! = 8^4 * 9^6 * 10^6 * 11^2 * 12 * 13^2 * 14^3 * 17 * 19 * 23, with 4 + 6 + 6 + 2 + 1 + 2 + 3 + 1 + 1 + 1 = 27 factors, which is the required number. Since the first factor is 8, a(27) >= 8. In fact no larger value can be obtained and a(27) = 8.
%o A034258 (Python)
%o A034258 import numpy as np
%o A034258 from sympy import primerange, factorint
%o A034258 from scipy.optimize import milp, LinearConstraint
%o A034258 def a(n):
%o A034258     P = list(primerange(2, n+1))
%o A034258     E = [sum(n//p**j for j in range(1, n.bit_length()+1)) for p in P]
%o A034258     def possible(k):
%o A034258         s = sum(p < k for p in P)
%o A034258         need = n - sum(E[s:])
%o A034258         if need <= 0: return True
%o A034258         F = []
%o A034258         for d in range(k, k*(k-1)):
%o A034258             f = factorint(d)
%o A034258             if max(f) < k and all(d//p < k for p in f):
%o A034258                 F.append([f.get(p, 0) for p in P[:s]])
%o A034258         if not F: return False
%o A034258         A = np.vstack((np.array(F).T, np.ones(len(F))))
%o A034258         c = LinearConstraint(A, lb=[0]*s+[need], ub=E[:s]+[np.inf])
%o A034258         r = milp(np.zeros(len(F)), integrality=1, constraints=c)
%o A034258         if r.status not in (0, 2): raise RuntimeError(r.message)
%o A034258         return r.status == 0
%o A034258     lo, hi = 1, n+1
%o A034258     while hi-lo > 1:
%o A034258         k = (lo+hi)//2
%o A034258         if possible(k): lo = k
%o A034258         else: hi = k
%o A034258     return lo
%o A034258 print([a(n) for n in range(1, 80)])  # _Jwalin Bhatt_, Oct 13 2026
%Y A034258 Cf. A034259, A034260.
