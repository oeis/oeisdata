%I A034055 #28 Aug 11 2026 01:09:59
%S A034055 8,18,24,29,36,38,42,46,49,63,64,66,67,76,77,79,81,83,88,92,94,97,99,
%T A034055 118,124,129,136,138,142,146,149,163,164,166,167,176,177,179,181,183,
%U A034055 188,192,194,197,199,214,219,222,226,229,233,234,236,237,241,243,248
%N A034055 Numbers with multiplicative digital root value 8.
%H A034055 Robert Israel, <a href="/A034055/b034055.txt">Table of n, a(n) for n = 1..10000</a>
%H A034055 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/MultiplicativeDigitalRoot.html">Multiplicative Digital Root</a>
%H A034055 <a href="/index/Ar#10-automatic">Index entries for 10-automatic sequences</a>.
%p A034055 A031347:= proc(n) local x;
%p A034055   x:= n;
%p A034055   while x > 10 do
%p A034055     x:= convert(convert(x, base, 10), `*`)
%p A034055   od;
%p A034055   x
%p A034055 end proc:
%p A034055 select(A031347=8, [$1..1000]); # _Robert Israel_, Aug 10 2026
%t A034055 dr8Q[n_]:=NestWhile[Times@@IntegerDigits[#]&,n,#>9&]==8; Select[ Range[ 250],dr8Q] (* _Harvey P. Dale_, Jun 10 2011 *)
%Y A034055 Cf. A031347.
%Y A034055 Cf. A034048, A002275, A034049, A034050, A034051, A034052, A034053, A034054, A034055, A034056 (numbers having multiplicative digital roots 0-9).
%K A034055 nonn,base,easy
%O A034055 1,1
%A A034055 _Patrick De Geest_, Sep 15 1998
