%I A336088 #17 Nov 14 2026 23:47:33
%S A336088 28,61,90,105,121,321,339,382,408,466,602,1079,1121,1596,1782,2067,
%T A336088 2104,2170,2220,2250,2435,2456,2884,3141,3242,3321,3328,3435,4195,
%U A336088 4323,4348,4497,4766,4914,5241,5526,6290,6581,6597,9306,9734
%N A336088 k such that L(H(k,2)) = 2*L(H(k,1)) where L(x) is the number of terms in the continued fraction of x and H(k,r) = Sum_{u=1..k} 1/u^r.
%C A336088 Conjecture: this sequence is infinite. More generally for any fixed integers a,b,c,d >= 1, there are infinitely many k's such that c*d*L(H(k,a)^b) = a*b*L(H(k,c)^d) where L(x) is the number of terms in the continued fraction of x and H(k,r) = Sum_{u=1..k} 1/u^r. Here, (a,b,c,d) = (2,1,1,1).
%H A336088 Robert Israel, <a href="/A336088/b336088.txt">Table of n, a(n) for n = 1..147</a>
%p A336088 L:= x -> nops(convert(x,confrac)):
%p A336088 S1:= 1: S2:= 1:
%p A336088 R:= NULL: count:= 0:
%p A336088 for k from 2 while count < 50 doS1:= S1 + 1/k; S2:= S2 + 1/k^2;
%p A336088   q:= L(S2); if q::odd then next fi;
%p A336088   if q = 2*L(S1) then R:= R,k; count:= count+1  fi;
%p A336088 od:
%p A336088 R; # _Robert Israel_, Nov 14 2026
%t A336088 c[n_, r_] := Length @ ContinuedFraction @ HarmonicNumber[n, r]; Select[Range[10^4], c[#, 2] == 2 * c[#, 1] &] (* _Amiram Eldar_, Oct 04 2020 *)
%o A336088 (PARI) H1=H2=1;for(n=2,10000,H1=H1+1/n;H2=H2+1/n^2;if(length(contfrac(H2))==2*length(contfrac(H1)),print1(n,",")))
%Y A336088 Cf. A055573, A070985.
%K A336088 nonn,changed
%O A336088 1,1
