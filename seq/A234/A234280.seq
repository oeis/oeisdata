%T A234280 383153287764,6882295587337,125142587106976,2299766005431680,
%U A234280 42657879257182171,797781215792214462,15029592907246003006,285010352305631756578,5436807589818287862078,104269311275736063130539
%N A234280 Number of 231-avoiding extensions of comb K_{s,3}^{alpha}.
%C A234280 A more efficient recurrence for this sequence follows from Theorem 3.1 of Defant (2017). - _Vladeta Jovovic_, Nov 10 2026
%H A234280 Colin Defant, <a href="https://arxiv.org/abs/1608.03951">Poset Pattern-Avoidance Problems Posed by Yakoubov</a>, arXiv:1608.03951 [math.CO], 2016-2017.
%H A234280 Sophia Yakoubov, <a href="https://dx.doi.org/10.4310/JOC.2015.v6.n1.a13">Pattern avoidance in extensions of comb-like posets</a>, Journal of Combinatorics, Vol. 6, No. 1-2 (2015), pp. 249-272; <a href="https://arxiv.org/abs/1310.2979">arXiv preprint</a>, arXiv:1310.2979 [math.CO], 2013-2014.
%F A234280 Let p_n(j) = j - 1 for 2 <= j <= n, and p_n(j) = j - n for n < j <= 3*n. Define F_n(i,j) = 1 for i >= j, and F_n(i,j) = Sum_{k=max(i,p_n(j)+1)..j} F_n(i,k-1)*F_n(k,j-1) for i < j. Then a(n) = F_n(1,3*n). - _Vladeta Jovovic_, Nov 10 2026
%K A234280 nonn,changed
