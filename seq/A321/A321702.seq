%S A321702 0,1,2,3,5,8,10,11,12,13,15,18,20,21,22,23,25,28,30,31,32,33,35,38,50,
%T A321702 51,52,53,55,58,80,81,82,83,85,88,100,101,102,103,105,108,110,111,112,
