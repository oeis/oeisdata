%D A306215 N. J. A. Sloane, "Interesting Unsolved Integer Sequences", REU Seminar, DIMACS, Rutgers University, June 2026.
%H A306215 Benjamin Chaffin, <a href="/A306215/b306215.txt">Table of n, a(n) for n = 1..65</a>
%o A306215 (Python)
%o A306215 def runs(seq):
%o A306215     if not seq: return []
%o A306215     r, c = [], 1
%o A306215     for i in range(1, len(seq)):
%o A306215         if seq[i] == seq[i-1]: c += 1
%o A306215         else: r.append(c); c = 1
%o A306215     r.append(c); return r
%o A306215 def A306211_lengths(max_gen=40):
%o A306215     S = [1]
%o A306215     for _ in range(max_gen + 1):
%o A306215         yield len(S)
%o A306215         S += runs(S) # _Jean Lauro Muller_, Jul 30 2026
