%S A306215 1,2,3,5,8,13,22,37,61,100,162,260,416,663,1053,1664,2617,4102,6416,
%T A306215 10029,15684,24561,38531,60560,95334,150238,236878,373449,588441,
%U A306215 926449,1457335,2290726,3599062,5654352,8886976,13979961,22020411,34743031,54922083
%N A306215 a(n) gives the length of A306211 after n generations.
%D A306215 N. J. A. Sloane, "Interesting Unsolved Integer Sequences", REU Seminar, DIMACS, Rutgers University, June 2026.
%H A306215 Benjamin Chaffin, <a href="/A306215/b306215.txt">Table of n, a(n) for n = 1..65</a>
%F A306215 a(1) = 1; a(n+1) = a(n) + (number of runs in S_n) for n >= 1. - _Jean Lauro Muller_, Aug 13 2026
%e A306215 a(2) = 3 because S_2 = [1, 1, 2] has length 3.
%e A306215 a(20) = 10029 because S_20 has 10029 terms.
%e A306215 Array showing the S_n for n >= 1:
%e A306215   n | A306211 after n generations
%e A306215   --+-----------------------------
%e A306215   1 | [1]
%e A306215   2 | [1, 1]
%e A306215   3 | [1, 1, 2]
%e A306215   4 | [1, 1, 2, 2, 1]
%e A306215   5 | [1, 1, 2, 2, 1, 2, 2, 1]
%e A306215   6 | [1, 1, 2, 2, 1, 2, 2, 1, 2, 2, 1, 2, 1]
%e A306215   7 | [1, 1, 2, 2, 1, 2, 2, 1, 2, 2, 1, 2, 1, 2, 2, 1, 2, 1, 2, 1, 1, 1]...
%o A306215 (Python)
%o A306215 def runs(seq):
%o A306215     if not seq: return []
%o A306215     r, c = [], 1
%o A306215     for i in range(1, len(seq)):
%o A306215         if seq[i] == seq[i-1]: c += 1
%o A306215         else: r.append(c); c = 1
%o A306215     r.append(c); return r
%o A306215 def A306211_lengths(max_gen=40):
%o A306215     S = [1]
%o A306215     for _ in range(max_gen + 1):
%o A306215         yield len(S)
%o A306215         S += runs(S) # _Jean Lauro Muller_, Jul 30 2026
