%S A222058 0,1,4,21,138,1095,10208,109473,1328470,18003675,269580492,4420677525,
%T A222058 78801184322,1517300654415,31386251780536,694190761402377,
%U A222058 16348768018619694,408472183061464515,10791720442056792740,300605598797790229629,8805117712245004098586,270562051319419652165175,8702576800277309526639504,292425620801795849417200881
%N A222058 Harmonic-geometric numbers.
%H A222058 Alois P. Heinz, <a href="/A222058/b222058.txt">Table of n, a(n) for n = 0..424</a> (first 201 terms from Vincenzo Librandi)
%H A222058 Ayhan Dil and Veli Kurt, <a href="https://www.integers-ejcnt.org/m38/m38.Abstract.html">Polynomials related to harmonic numbers and evaluation of harmonic number series I</a>, INTEGERS, 12 (2012), #A38.
%F A222058 a(n) = Sum_{k=0..n} Stirling2(n,k)*|Stirling1(k+1,2)|.
%F A222058 Maximal term in the sum is asymptotically in position k = n/(2*log(2)) and limit n-> infinity (a(n)/n!)^(1/n) = 1/log(2). - _Vaclav Kotesovec_, Feb 09 2013
%F A222058 E.g.f.: -log(2 - exp(x))/(2 - exp(x)). - _Ilya Gutkovskiy_, May 31 2018
%F A222058 a(n) ~ n! * log(n) / (2 * (log(2))^(n+1)) * (1 + (gamma - log(2) - log(log(2))) / log(n)), where gamma is the Euler-Mascheroni constant A001620. - _Vaclav Kotesovec_, Oct 13 2018
%F A222058 Conjecture: a(n) = Sum_{k>=0} k^n * (H(k) - log(2))/2^(k+1), where H(k) is the k-th harmonic number. - _Velin Yanev_, Jul 22 2026
%p A222058 b:= proc(n, m) option remember;
%p A222058      `if`(n=0, abs(Stirling1(m+1, 2)), m*b(n-1, m)+b(n-1, m+1))
%p A222058     end:
%p A222058 a:= n-> b(n,0):
%p A222058 seq(a(n), n=0..23);  # _Alois P. Heinz_, Oct 02 2026
%t A222058 Table[Sum[StirlingS2[n, k]*Abs[StirlingS1[k + 1, 2]], {k, 0, n}], {n, 0, 20}] (* _Vaclav Kotesovec_, Feb 09 2013 *)
%Y A222058 Row sums of A222057 or A222060.
%Y A222058 Cf. A000254.
%K A222058 nonn,changed
%O A222058 0,3
%A A222058 _N. J. A. Sloane_, Feb 08 2013
