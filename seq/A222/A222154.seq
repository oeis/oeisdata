%T A222154 215040,272160,336000,393120,406560,483840,510720,567840,658560,
%U A222154 665280,698880,756000,860160,971040,1088640,1092000,1145760,1149120,1212960,1344000,1367520,1481760
%N A222154 Numbers m such that there are at least 3 distinct triples (k, k+m, k+2m) of squares.
%H A222154 Arina Bator, <a href="/A222154/b222154.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..93 from Zdenek Cervenka)
%e A222154 The following 3 triples have a common difference of 3360: (2^2, 58^2, 82^2), (46^2, 74^2, 94^2), and (97^2, 113^2, 127^2).
%o A222154 (PARI)
%o A222154 triples(m)={my(L=List()); fordiv(m,d, if(d^2<m, my(t=(d+m/d)/2); if(!frac(t) && issquare(t^2+m), listput(L,t-d)))); Vecrev(L)}
%o A222154 isok(m,d=3) = #triples(m) >= d \\ _Andrew Howroyd_, Sep 29 2026
%Y A222154 Cf. A198387, A222155, A214155, A226858, A226954.
%K A222154 nonn,changed
%O A222154 1,1
