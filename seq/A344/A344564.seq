%T A344564 22364160,58490880,150405120,381026304,952565760,2353397760,
%U A344564 5752750080,13927710720,33426505728,79586918400,188114534400,441660211200,1030540492800,2390853943296,5517355253760,12669482434560,28958816993280
%N A344564 a(n) = [x^n] 3/(1 - 2*x)^5.
%H A344564 Paolo Xausa, <a href="/A344564/b344564.txt">Table of n, a(n) for n = 0..1000</a>
%H A344564 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (10,-40,80,-80,32).
%F A344564 a(n) = 2*(n + 4)*a(n - 1) / n for n >= 2.
%F A344564 a(n) = 2^(n - 3)*(n + 1)*(n + 2)*(n + 3)*(n + 4).
%F A344564 a(n) = n! * [x^n] (2*x^4 + 16*x^3 + 36*x^2 + 24*x + 3)*exp(2*x).
%F A344564 a(n) ~ 2^(n - 3) * n^4.
%F A344564 From _Amiram Eldar_, Jul 07 2026: (Start)
%F A344564 Sum_{n>=0} 1/a(n) = 20/9 - 8*log(2)/3.
%F A344564 Sum_{n>=0} (-1)^n/a(n) = 72*log(3/2) - 260/9. (End)
%F A344564 E.g.f.: (3 + 24*x + 36*x^2 + 16*x^3 + 2*x^4)*exp(2*x). - _G. C. Greubel_, Nov 14 2026
%F A344564 From _Alois P. Heinz_, Nov 14 2026: (Start)
%F A344564 a(n) = 3 * A003472(n+4).
%F A344564 a(n) = 6 * A080951(n) for n>=1. (End)
%p A344564 a := n -> 2^(n - 3)*(n + 1)*(n + 2)*(n + 3)*(n + 4): seq(a(n), n = 0..25);
%t A344564 A344564[n_] := 2^(n - 3)*(n + 1)*(n + 2)*(n + 3)*(n + 4);
%t A344564 Array[A344564, 30, 0] (* _Paolo Xausa_, Jul 02 2026 *)
%o A344564 (Magma)
%o A344564 A344564:= func< n | 3*2^n*Binomial(n+4, 4) >;
%o A344564 [A344564(n): n in [0..30]]; // _G. C. Greubel_, Nov 14 2026
%o A344564 (PARI)
%o A344564 A344564(n)= 3*2^n*binomial(n+4, 4);
%o A344564 vector(31, n, A344564(n-1)) \\ _G. C. Greubel_, Nov 14 2026
%o A344564 (SageMath)
%o A344564 def A344564(n): return 3*2^n*binomial(n+4, 4)
%o A344564 print([A344564(n) for n in range(31)]) # _G. C. Greubel_, Nov 14 2026
