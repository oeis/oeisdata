%N A344575 a(n) = Sum_{d|n} d^(mu(n/d)^2).
%C A344575 Sum of the divisors d of n such that n/d is squarefree plus the number of divisors of n such that n/d is not squarefree. - _Wesley Ivan Hurt_, Nov 17 2026
%F A344575 a(n) = psi(n) + tau(n) - tau(rad(n)). - _Wesley Ivan Hurt_, Nov 17 2026
%F A344575 If p is prime, a(p) = p+1.
%t A344575 Table[Sum[d^(MoebiusMu[n/d]^2), {d, Divisors[n]}], {n, 100}] (* _Wesley Ivan Hurt_, Nov 17 2026 *)
