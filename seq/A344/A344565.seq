%p A344565 T := (n, k) -> (n + 4)! / (8 * k! * (n - k)!):
%p A344565 for n from 0 to 9 do seq(T(n, k), k = 0..n) od;
%t A344565 T[n_, k_] := (n + 4)!/(8*k!*(n - k)!); Table[T[n, k], {n, 0, 8}, {k, 0, n}] // Flatten (* _Amiram Eldar_, May 28 2021 *)
%o A344565 (Magma)
%o A344565 A344565:= func< n,k | 3*Binomial(k+4,4)*Binomial(n+4,k+4) >;
%o A344565 [A344565(n,k): k in [0..n], n in [0..12]]; // _G. C. Greubel_, Nov 14 2026
%o A344565 (PARI)
%o A344565 A344564(n,k)= 3*binomial(n,k)*binomial(n+4, 4);
%o A344565 for(n=0, 12, for(k=0, n, print1(A344564(n,k), " "))) \\ _G. C. Greubel_, Nov 14 2026
%o A344565 (SageMath)
%o A344565 def A344565(n,k): return 3*binomial(k+4,4)*binomial(n+4,k+4)
%o A344565 print(flatten([[A344565(n,k) for k in range(n+1)] for n in range(13)])) # _G. C. Greubel_, Nov 14 2026
