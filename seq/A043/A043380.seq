%S A043380 518,1814,2678,2894,3038,3074,3098,3104,3108,3109,3111,3112,3113,3116,
%T A043380 3122,3128,3146,3182,3218,3326,3542,3758,4406,5702,6998,8294,9590,
%U A043380 10454,10670,10814,10850,10874,10880,10884,10885,10887,10888,10889,10892,10898,10904
%N A043380 Numbers having exactly four 2's in base 6.
%H A043380 Žiga Pirc, <a href="/A043380/b043380.txt">Table of n, a(n) for n = 1..10000</a>
%e A043380 518 in base 6 is 2222.
%e A043380 1814 in base 6 is 12222.
%e A043380 2678 in base 6 is 20222.
%e A043380 3110 = 22222_6 is not a term.
%t A043380 Select[Range[11000],DigitCount[#,6,2]==4&] (* _Harvey P. Dale_, Aug 20 2011 *)
%o A043380 (PARI) is_A043380(n) = my(d = digits(n,6), a = 0;); for(k = 1, #d, if(d[k] == 2, a++)); return(a==4); \\ _Žiga Pirc_, Oct 28 2026
%o A043380 (PARI) isok(k) = #select(x->x==2, digits(k, 6)) == 4; \\ _Michel Marcus_, Oct 28 2026
