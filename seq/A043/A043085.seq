%U A043085 6122,6132,6142,6152,6162,6172,6182,6192,6203,6213
%N A043085 a(n)=(s(n)+4)/10, where s(n)=n-th base 10 palindrome that starts with 6.
%H A043085 Harvey P. Dale, <a href="/A043085/b043085.txt">Table of n, a(n) for n = 1..1000</a>
%t A043085 sixes[n_]:=Module[{},Which[n==1,{6},n==2,{66},n>2,FromDigits/@(Join[{6},#,{6}]&/@Tuples[Range[0,9],n-2])]]; (#+4)/10&/@Select[Flatten[Table[sixes[n],{n,5}]],PalindromeQ] (* _Harvey P. Dale_, Aug 12 2026 *)
