%N A043172 Numbers k such that 3 and 6 occur juxtaposed in the base-8 representation of k but not of k-1.
%H A043172 Harvey P. Dale, <a href="/A043172/b043172.txt">Table of n, a(n) for n = 1..1000</a>
%t A043172 SequencePosition[Table[If[SequenceCount[IntegerDigits[n,8],{3,6}]>0||SequenceCount[IntegerDigits[n,8],{6,3}]>0,1,0],{n,1500}],{0,1}][[;;,2]] (* _Harvey P. Dale_, May 18 2025 *)
%t A043172 (* Alternative: *)
%t A043172 SequencePosition[Table[Boole[StringContainsQ[IntegerString[n,8],"36"|"63"]],{n,1500}],{0,1}][[;;,2]] (* _Harvey P. Dale_, Sep 09 2026 *)
