%I A039610 #14 Aug 17 2026 05:27:19
%S A039610 20,97,152,176,188,200,212,224,236,240,242,243,244,245,246,247,249,
%T A039610 250,251,260,272,284,308,385,452,529,596,673,740,817,884,961,1028,
%U A039610 1105,1153,1164,1166,1167,1168,1169,1170,1171,1173,1174,1175,1177
%N A039610 Numbers whose base-12 representation has the same nonzero number of 1's and 8's.
%p A039610 noDigs := proc(n,bas,dig)
%p A039610     local a,dgs,d ;
%p A039610     a := 0 ;
%p A039610     dgs := convert (n,base,bas) ;
%p A039610     for d in dgs do
%p A039610         if d = dig then
%p A039610             a := a+1 ;
%p A039610         end if;
%p A039610     end do:
%p A039610     a ;
%p A039610 end proc:
%p A039610 for n from 1 to 1000 do
%p A039610     if noDigs(n,12,1) = noDigs(n,12,8) and noDigs(n,12,1) > 0 then
%p A039610         printf("%d,",n) ;
%p A039610     end if;
%p A039610 end do: # _R. J. Mathar_, Aug 17 2026
%t A039610 Select[Range[1200],DigitCount[#,12,1]==DigitCount[#,12,8]>0&] (* _Harvey P. Dale_, Mar 05 2014 *)
%Y A039610 Subsequence of A039226.
%K A039610 nonn,base,easy,changed
%O A039610 1,1
%A A039610 _Olivier Gérard_
