%I A039773 #16 Sep 24 2026 05:52:00
%S A039773 5,34,66,130,490,18130
%N A039773 Numbers k such that phi(k) is equal to the sum of prime factors and exponents of k-1.
%C A039773 Next term if it exists is >= 5*10^7. - _Naohiro Nomoto_, Jun 24 2001
%C A039773 a(7) > 10^10, if it exists. - _Amiram Eldar_, Sep 24 2026
%e A039773 phi(34) = 16, 33 = 3^1 * 11^1, 3 + 1 + 11 + 1 = 16.
%t A039773 Select[Range[20000],Total[Flatten[FactorInteger[#-1]]]==EulerPhi[#]&] (* _Harvey P. Dale_, Mar 27 2017 *)
%o A039773 (PARI) list(kmax) = {my(s = 0, f); for(k = 2, kmax, f = factor(k); if(eulerphi(f) == s, print1(k, ", ")); s = sum(i = 1, #f~, f[i, 1] + f[i, 2]));} \\ _Amiram Eldar_, Sep 24 2026
%Y A039773 Cf. A000010, A008474.
%K A039773 nonn,more,changed
%O A039773 1,1
%A A039773 _Olivier Gérard_
