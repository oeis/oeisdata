%S A109948 2,43,643,51853,108643,3925927,45925927,525925927,9876543211,
%T A109948 65925925927,6665925925927,1453331851851853,1154657766913580249,
%U A109948 45219875551604938273,7873482297771358024693,742965003571105432098767
%N A109948 Smallest prime == 1 (mod f(n)), where f(n) = concatenation n,n-1,...,3,2,1.
%t A109948 s = "1"; Do[s = ToString[n] <> s; k = ToExpression[s]; i = 1; While[ !PrimeQ[i*k + 1], i++ ]; Print[i*k + 1], {n, 2, 30}] (* _Ryan Propper_, Aug 01 2005 *)
%t A109948 (* Alternative: *)
%t A109948 Table[With[{c=FromDigits[Flatten[IntegerDigits/@Range[n,1,-1]]]},SelectFirst[Range[1,6*10^8,c],PrimeQ]],{n,8}] (* The program generates the first 8 terms of the sequence. *) (* _Harvey P. Dale_, Sep 02 2026 *)
%Y A109948 Cf. A109947.
%K A109948 base,nonn,changed
%O A109948 1,1
%A A109948 _Amarnath Murthy_, Jul 20 2005
%E A109948 More terms from _Ryan Propper_, Aug 01 2005
