%F A109717 a(n) = A000088(n) - A133206(n) = A004110(n) - A133279(n). - _Carlo Corti_, Sep 09 2026
%t A109717 k = {}; For[i = 1, i < 8, i++, lg = ListGraphs[i] ; len = Length[lg]; k = Append[k, Length[Select[Range[len], Det[ToAdjacencyMatrix[lg[[ # ]]]] != 0 &]]]]; k
