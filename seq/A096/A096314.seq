%S A096314 0,1,1,5,12,119,135,5039,20160,240219,1545075,39916799,88550154,
%T A096314 6227020799,42798202447,698726730520,10461394944000,355687428095999,
%U A096314 1375276302469251,121645100408831999,845066215769150100,32417387902774348033,561962763353716980255
%N A096314 a(n) = Sum_{1<=k<=n, gcd(n,k)=1} (-1)^(n-k)*Stirling1(n,k).
%C A096314 a(n) is the number of permutations of {1, 2, ..., n} whose number of cycles is relatively prime to n. - _Pierre Colmant_, Oct 06 2026
%C A096314 If 4|n, then a(n) is even. The row polynomial for the unsigned Stirling numbers of the first kind is Product_{i=0..n-1} (x+i). Modulo 2, for 4|n this becomes x^(n/2)*(x+1)^(n/2), which has no odd powers. Since gcd(n,k)=1 implies that k is odd, every summand contributing to a(n) is even. - _Pierre Colmant_, Oct 06 2026
%H A096314 Alois P. Heinz, <a href="/A096314/b096314.txt">Table of n, a(n) for n = 0..450</a>
%F A096314 For prime p, a(p) = p! - 1. - _Pierre Colmant_, Oct 06 2026
%F A096314 a(n) = Sum_{d|n} mu(d)*Sum_{j=1..n/d} (-1)^(n-d*j)*Stirling1(n,d*j). - _Pierre Colmant_, Oct 06 2026
%e A096314 a(4) = 12 because the permutations of {1,2,3,4} with 1 or 3 cycles number Stirling1(4,1) + Stirling1(4,3) in absolute value, that is 6 + 6 = 12. - _Pierre Colmant_, Oct 06 2026
%p A096314 T:= proc(n,k) option remember;
%p A096314       `if`(n=k, 1, `if`(k=0, 0, T(n-1, k-1)+(n-1)*T(n-1, k)))
%p A096314     end:
%p A096314 a:= n-> add(`if`(igcd(k, n)=1, T(n,k), 0), k=1..n):
%p A096314 seq(a(n), n=0..25);  # _Alois P. Heinz_, Oct 06 2026
%t A096314 f[n_] := Sum[ If[ GCD[n, k] == 1, (-1)^(n - k)StirlingS1[n, k], 0], {k, n}]; Table[ f[n], {n, 20}] (* _Robert G. Wilson v_, Aug 12 2004 *)
%o A096314 (PARI) a(n) = sum(k=1, n, if(gcd(n, k)==1, abs(stirling(n, k, 1)))); \\ _Pierre Colmant_, Oct 06 2026
