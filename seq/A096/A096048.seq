%S A096048 1,42,1446,51486,1848966,66524910,2394568086,86201542014,
%T A096048 3103229527206,111716029897998,4021774981740726,144783880503964062,
%U A096048 5212219528644719046,187639901505929327406,6755036440486736068566,243181311733985242231230,8754527221311646299091686
%N A096048 a(n) = B(2n,6)/B(2n) (see comment).
%C A096048 B(n,p) = Sum_{i=0..n} p^i * (Sum_{j=0..i} binomial(n,j)*B(j)) where B(k) = k-th Bernoulli number.
%H A096048 Paolo Xausa, <a href="/A096048/b096048.txt">Table of n, a(n) for n = 0..600</a>
%H A096048 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (50,-553,1800,-1296).
%F A096048 a(n) = (1/10)*(11*36^n+2*9^n+3*4^n-6).
%F A096048 a(n) = 50*a(n-1)-553*a(n-2)+1800*a(n-3)-1296*a(n-4); a(0)=1, a(1)=42, a(2)=1446, a(3)=51486.
%F A096048 From _Elmo R. Oliveira_, Sep 12 2026: (Start)
%F A096048 G.f.: (1 - 8*x - 101*x^2 + 612*x^3) / ((1-x)*(1-4*x)*(1-9*x)*(1-36*x)).
%F A096048 E.g.f.: (1/10)*(-6 + 3*exp(3*x) + 2*exp(8*x) + 11*exp(35*x))*exp(x). (End)
%t A096048 A096048[n_] := (11*36^n + 2*9^n + 3*4^n - 6)/10; Array[A096048, 20, 0] (* _Paolo Xausa_, Sep 17 2026 *)
%o A096048 (PARI) a(n)=sum(i=0,2*n,6^i*sum(j=0,i,binomial(2*n,j)*bernfrac(j)))/bernfrac(2*n)
%o A096048 (Maxima) a[0]:1$ a[1]:42$ a[2]:1446$ a[3]:51486$ a[n]:=(1/10)*(11*36^n+2*9^n+3*4^n-6)$ A096048(n):=a[n]$ makelist(A096048(n),n,0,30); /* _Martin Ettl_, Nov 13 2012 */
