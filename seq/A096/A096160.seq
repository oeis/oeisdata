%I A096160 #15 Nov 02 2026 10:21:26
%S A096160 4,6,8,10,12,22,30,34,58,82,118,142,202,214,274,298,358,382,394,454,
%T A096160 478,538,562,622,694,838,862,922,1038,1042,1138,1198,1234,1282,1318,
%U A096160 1618,1642,1654,1714,1762,2038,2062,2098,2122,2182,2302,2458,2554,2578,2602
%N A096160 Composite numbers whose proper divisors can be arranged in such a way that all sums of adjacent pairs are primes.
%C A096160 A096158(a(n)) > 0; subsequence of A096157.
%C A096160 From _Robert Israel_, Nov 01 2026: (Start)
%C A096160 The terms that are semiprimes are 4 and 2*p where p is a lower twin prime (A001359).
%C A096160 Terms that are not semiprimes include 6*p where p, p+6, 2*p+1, 2*p+3 and 3*p+2 are prime.
%C A096160 Are 8 and 12 the only terms not of those forms?  (End)
%H A096160 Robert Israel, <a href="/A096160/b096160.txt">Table of n, a(n) for n = 1..10000</a>
%e A096160 Proper divisors of 30 are {1,2,3,5,6,10,15}: [3,10,1,6,5,2,15] -> (3+10,10+1,1+6,6+5,5+2,2+15) = (13,11,7,11,7,17): therefore 30 is a term.
%p A096160 filter:= proc(n) local V,nV,E,i,j,G; uses GraphTheory;
%p A096160   V:= convert(NumberTheory:-Divisors(n) minus {n},list);
%p A096160   nV:= nops(V);
%p A096160   if nV <= 1 then return false fi;
%p A096160   if abs(2*nops(select(t -> t::even, V)) - nV) > 1 then return false fi;
%p A096160   E:= select(t -> isprime(t[1]+t[2]), {seq(seq({V[i],V[j]},j=1..i-1),i=1..nops(V))});
%p A096160   G:= Graph(V,E);
%p A096160   if ormap(t -> Degree(G,t) = 0, V) then return false fi;
%p A096160   if nops(select(t -> Degree(G,t) = 1, V)) > 2 then return false fi;
%p A096160   FindHamiltonianPath(G)<> NULL;
%p A096160 end proc:
%p A096160 select(filter, [seq(i,i=4..10000,2)]); # _Robert Israel_, Nov 01 2026
%Y A096160 Cf. A096157, A096158.
%Y A096160 Subsequence of A002808.
%K A096160 nonn,changed
%O A096160 1,1
