%I A295462 #19 Aug 24 2026 01:12:10
%S A295462 1,1001,2731365,8452632980,27614258931525,92994778322102376,
%T A295462 319323042934810327908,1111423634892509277158820,
%U A295462 3907116913932203786698907205,13840531451943824412017357524400,49326067264186310295180241747943240,176657291645522807951014259080005974280
%N A295462 a(n) = (15*n)!*(2*n)!/((10*n)!*(6*n)!*n!).
%D A295462 From _Peter Bala_, Aug 23 2026: (Start)
%D A295462 For n >= 0, both a(n)/(10*n+1) and a(n)/(6*n+1) are integers.
%D A295462 Conjecture: a(n) is odd iff the 1 bits in the binary expansion of n are separated by at least three 0's, that is, iff n belongs to A048718. (End)
%H A295462 Peter Bala, <a href="/A295462/a295462.pdf">A295462(n) is divisible by 6*n+1 and 10*n+1</a>, 2026
%F A295462 G.f.: hypergeom([1/15, 2/15, 4/15, 7/15, 8/15, 11/15, 13/15, 14/15], [1/10, 1/6, 3/10, 1/2, 7/10, 5/6, 9/10], 61509375/16384*x).
%F A295462 a(n) = binomial(15*n,5*n)*binomial(2*n,n)/binomial(6*n,n) = binomial(15*n,5*n)*binomial(7*n,n)/binomial(7*n,2*n). - _Chai Wah Wu_, Feb 16 2026
%F A295462 a(n) ~ 3^(9*n) * 5^(5*n) / (2^(14*n+1) * sqrt(Pi*n)). - _Amiram Eldar_, Feb 22 2026
%t A295462 a[n_] := (15*n)!*(2*n)!/((10*n)!*(6*n)!*n!); Array[a, 12, 0] (* _Amiram Eldar_, Feb 22 2026 *)
%o A295462 (Python)
%o A295462 from math import comb
%o A295462 def A295462(n): return comb(15*n,5*n)*comb(2*n,n)//comb(6*n,n) # _Chai Wah Wu_, Feb 16 2026
