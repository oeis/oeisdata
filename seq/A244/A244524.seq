%e A244524 13:  [ . . 2 ]  [ . 1 2 ]
%e A244524 14:  [ . 1 . ]  [ . . . ]
%e A244524 15:  [ . 1 . ]  [ . . 2 ]
%e A244524 16:  [ . 1 . ]  [ . 1 . ]
%e A244524 17:  [ . 1 . ]  [ . 1 2 ]
%e A244524 18:  [ . 1 1 ]  [ . . . ]
