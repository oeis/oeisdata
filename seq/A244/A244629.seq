%I A244629 #13 Aug 03 2026 18:53:57
%S A244629 1,3,7,17,37,79,163,321,617,1179,2047,3761,6773,12103,20723,36733,
%T A244629 62881,110231,186379,324953,538273,935115,1546339,2685477,4492981,
%U A244629 7796299
%N A244629 Number of power series 1 + c_1*x^1 + c_2*x^2 + ... + c_{n-1}*x^{n-1} + O(x^n) with c_k in {-1, 0, 1} whose reciprocal has the same property.
%C A244629 a(n) is odd since taking the reciprocal is an involution with only one fixed point.
%e A244629 a(3) = 7 since 1 / (1 +- x - x^2 + O(x^3)) = 1 -+ x + 2*x^2 + O(x^3) are excluded, but the other 7 power series 1 + c_1*x^1 + c_2^x^2 + O(x^3) have the property.
%p A244629 g:= proc(uv,n) local q;
%p A244629      q:= coeftayl(uv[1]*uv[2],x=0,n);
%p A244629      if q = -2 then  uv + [x^n,x^n]
%p A244629      elif q = -1 then  uv + [0,x^n], uv + [x^n,0]
%p A244629      elif q = 0 then  uv + [-x^n,x^n],uv,uv+[x^n,-x^n]
%p A244629      elif q = 1 then uv + [0,-x^n], uv + [-x^n,0]
%p A244629      elif q = 2 then uv - [x^n,x^n]
%p A244629      else NULL
%p A244629      fi
%p A244629 end proc:
%p A244629 P:= {[1,1]}: R:= 1:
%p A244629 for n from 2 to 26 do
%p A244629   P:= map(g,P,n-1);
%p A244629   R:= R, nops(P);
%p A244629 od:
%p A244629 R; # _Robert Israel_, Aug 03 2026
%o A244629 (PARI) {a(n) = my(c); if( n<1, 0, forvec( v = vector(n, i, [(-1)^(i>1), 1]), if( 1 >= vecmax( abs( Vec( 1 / Ser(v)))), c++)); c)};
%K A244629 nonn,more
%O A244629 1,2
%A A244629 _Michael Somos_, Jul 02 2014
%E A244629 More terms from _Robert Israel_, Aug 03 2026
