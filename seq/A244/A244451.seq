%I A244451 #22 Aug 20 2026 01:15:14
%S A244451 1,1,4,26,236,2756,39376,665464,12986416,287394416,7112021696,
%T A244451 194607175136,5834321568064,190181750900416,6697115871398656,
%U A244451 253362903806266496,10248299242094541056,441359565949128552704,20163160035504969573376,973917774772339989408256
%N A244451 E.g.f.: exp( Sum_{n>=1} Fibonacci(2*n)*x^n/n ).
%H A244451 Vaclav Kotesovec, <a href="/A244451/b244451.txt">Table of n, a(n) for n = 0..380</a>
%F A244451 E.g.f.: ( (1 - x/Phi^2) / (1 - Phi^2*x) )^(sqrt(5)/5) where Phi = (sqrt(5)+1)/2.
%F A244451 E.g.f.: exp( Integral 1/(1-3*x+x^2) dx ).
%F A244451 a(n) ~ n! * 5^(1/(2*sqrt(5))) * n^(1/sqrt(5)-1) * ((1+sqrt(5))/2)^(2*n-2/sqrt(5)) / Gamma(1/sqrt(5)). - _Vaclav Kotesovec_, Jun 28 2014
%F A244451 From  _Peter Bala_, Jul 29 2026: (Start)
%F A244451 a(n) = (-1)^n * n! * Sum_{k = 0..n} binomial(1/sqrt(5), k)*binomial(-1/sqrt(5), n-k)*Phi^(2*n-4*k).
%F A244451 For prime p == +-1 (mod 5), the p-adic value v_p(a(n)) >= v_p(n!). Hence, the prime power p^m divides a(n) for n >= m*p.
%F A244451 The e.g.f. A(x) satisfies the differential equation (1 - 3*x + x^2)*A'(x) - A(x) = 0 with A(0) = 1.
%F A244451 a(n) = (3*n - 2)*a(n-1) - (n - 1)*(n - 2)*a(n-2) with a(0) = a(1) = 1.
%F A244451 For n >= 0, k >= 1, a(n+k) == a(n)*a(k) (mod k).
%F A244451 Reducing the sequence modulo k gives an eventually periodic sequence. For example, modulo 10 the sequence becomes [1, 1,  4, 6, 6, 6, 6,  4, 6, 6, 6, 6,  4, 6, 6, 6, 6, ...], with period 5 starting at n = 2. (End)
%e A244451 E.g.f.: A(x) = 1 + x + 4*x^2/2! + 26*x^3/3! + 236*x^4/4! + 2756*x^5/5! +...
%e A244451 where
%e A244451 log(A(x)) = x + 3*x^2/2 + 8*x^3/3 + 21*x^4/4 + 55*x^5/5 + 144*x^6/6 + 377*x^7/7 + 987*x^8/8 +...+ A000045(2*n)*x^n/n +...
%p A244451 a := proc(n) option remember; if n < 2 then 1 else (3*n - 2)*a(n-1) - (n - 1)*(n - 2)*a(n-2) fi; end:
%p A244451 seq(a(n), n = 0..20); # _Peter Bala_, Aug 05 2026
%o A244451 (PARI) {a(n)=n!*polcoeff(exp(intformal(1/(1-3*x+x^2 +x*O(x^n)))), n)}
%o A244451 for(n=0, 30, print1(a(n), ", "))
%Y A244451 Cf. A000045, A213527, A244430.
%K A244451 nonn,easy,changed
%O A244451 0,3
