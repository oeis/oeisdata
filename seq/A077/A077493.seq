%I A077493 #13 Oct 04 2026 15:02:20
%S A077493 1001,21,112,14,42,7,35,63,28,56,84,49,77,168,196,98,189,469,497,399,
%T A077493 679,896,798,889,1799,2898,2989,3899,4998,6979,5999,8799,9898,9989,
%U A077493 29799,19999,39998,58989,59899,68999,79989,99799,89999,199899,389998
%N A077493 a(n) = smallest multiple of 7 with a digit sum = n.
%H A077493 Robert Israel, <a href="/A077493/b077493.txt">Table of n, a(n) for n = 2..8954</a>
%F A077493 a(n+54) = 10^6 * a(n) + 999999 for n >= 44. - _Robert Israel_, Oct 01 2026
%p A077493 f:= proc(n) option remember;
%p A077493    local m,x,i,cons;
%p A077493    if n >= 44+54 then return 10^6 * procname(n-54) + 999999 fi;
%p A077493    m:= ceil(n/9)+3;
%p A077493   cons:= {add(L[i mod 6+1]*x[i],i=0..m)-7*r = 0,
%p A077493         add(x[i],i=0..m)=n,
%p A077493         seq(x[i]<=9,i=0..m)};
%p A077493 Minimize(add(10^i*x[i],i=0..m),cons,assume=nonnegint)[1]
%p A077493 end proc:
%p A077493 map(f, [$2..80]); # _Robert Israel_, Oct 01 2026
%Y A077493 Cf. A069532, A069534, A077494.
%K A077493 base,nonn,easy,changed
%O A077493 2,1
