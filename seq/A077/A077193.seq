%I A077193 #33 Aug 31 2026 23:17:41
%S A077193 1,1,6,6,24,360,720,5040,362880,1814400,23587200,1089728640,9500493726
%N A077193 Number of multiples of n that can be obtained by permuting the digits of number formed by the concatenation of first n numbers.
%e A077193 a(4) = 6 as using the digits of 1234 one gets six multiples of 4 e.g. 1324,3124,1432,4132,4312 and 3412.
%o A077193 (PARI) a(n)={my(X=vecsort(concat(vector(n,i,digits(i)))), s=0); forperm(X, p, if(fromdigits(Vec(p))%n==0, s+=1)); s} \\ _Andrew Howroyd_, Oct 07 2023
%o A077193 (Python)
%o A077193 from sympy.utilities.iterables import multiset_permutations
%o A077193 def a(n):
%o A077193     s = "".join(str(i) for i in range(1, n+1))
%o A077193     return sum(1 for p in multiset_permutations(s) if int("".join(p))%n==0)
%o A077193 print([a(n) for n in range(1, 10)]) # _Michael S. Branicky_, Aug 31 2026
%K A077193 nonn,base,hard,more,changed
