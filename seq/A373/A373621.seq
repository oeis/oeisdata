%T A373621 42016,53296,456976,658806,916411,1238666,1635071,11881376,17706456,
%U A373621 25462936,35569066,48496846,308915776,472880356,698851961,1003283216,1405555496,8031810176
%N A373621 Expansion of 1 / ( (1 - 25*x^5) * (1 - x/(1 - 25*x^5)^(1/5)) ).
%H A373621 Robert Israel, <a href="/A373621/b373621.txt">Table of n, a(n) for n = 0..3515</a>
%F A373621 a(5*n) = 26^n for n >= 0.
%F A373621 a(n) = Sum_{k=0..floor(n/5)} 25^k * binomial(n/5,k).
%F A373621 a(n) == 1 (mod 5).
%F A373621 D-finite with recurrence: 10156250*(n + 10)*(n + 20)*(n + 5)*(n + 15)*a(n) - 15625*(n + 10)*(n + 20)*(n + 15)*(129*n + 1685)*a(n + 5) + 5000*(n + 20)*(n + 15)*(32*n^2 + 995*n + 7920)*a(n + 10) - 50*(n + 20)*(127*n^3 + 6870*n^2 + 125285*n + 769950)*a(n + 15) + 2*(63*n^4 + 5170*n^3 + 159705*n^2 + 2200850*n + 11415312)*a(n + 20) - (n + 24)*(n + 23)*(n + 22)*(n + 21)*a(n + 25) = 0. - _Robert Israel_, Nov 22 2026
%p A373621 with(gfun):
%p A373621 de:=holexprtodiffeq(1 / ( (1 - 25*x^5) * (1 - x/(1 - 25*x^5)^(1/5)) ),y(x)):
%p A373621 rec:= diffeqtorec(de,y(x),a(n)):
%p A373621 f:= rectoproc(rec,a(n),remember):
%p A373621 map(f, [$0..40]); # _Robert Israel_, Nov 22 2026
%o A373621 (PARI) a(n) = sum(k=0, n\5, 25^k*binomial(n/5, k));
