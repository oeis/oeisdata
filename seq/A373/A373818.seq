%I A373818 #15 Aug 31 2026 14:45:16
%S A373818 1,3,27,261,2592,26082,264384,2691954,27488403,281236779,2881239093,
%T A373818 29546332821,303201787140,3113043334560,31974807932820,
%U A373818 328518361498968,3376062893960244,34700713221307482,356719230542209212,3667432457788644762,37708163269636391982
%N A373818 Expansion of 1/(2 - 1/(1 - 9*x)^(1/3)).
%H A373818 Robert Israel, <a href="/A373818/b373818.txt">Table of n, a(n) for n = 0..984</a>
%F A373818 a(n) = 9^n * Sum_{k>=0} (1/2)^(k+1) * binomial(n-1+k/3,n).
%F A373818 D-finite with recurrence: -648*(3*n + 2)*(3*n + 1)*a(n) + 9*(207*n^2 + 495*n + 302)*a(n + 1) - 18*(n + 2)*(11*n + 19)*a(n + 2) + 7*(n + 3)*(n + 2)*a(n + 3) = 0. - _Robert Israel_, Aug 31 2026
%p A373818 with(gfun):
%p A373818 eq:= (1-9*x)*(2*y-1)^3 - y^3:
%p A373818 de:= eval(algeqtodiffeq(eq,y(x)),RootOf(7*_Z^3 - 12*_Z^2 + 6*_Z - 1)=1):
%p A373818 rec:= diffeqtorec(de,y(x),a(n)):
%p A373818 f:= rectoproc(rec,a(n),remember):
%p A373818 map(f, [$0..30]); # _Robert Israel_, Aug 31 2026
%o A373818 (PARI) my(N=30, x='x+O('x^N)); Vec(1/(2-1/(1-9*x)^(1/3)))
%Y A373818 Cf. A001027, A373939.
%K A373818 nonn,easy,changed
%O A373818 0,2
%A A373818 _Seiichi Manyama_, Aug 04 2024
