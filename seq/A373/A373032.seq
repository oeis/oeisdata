%N A373032 Expansion of Sum_{k>=1} (-1)^(k+1) * k^2 * x^(k*(k+1)) / (1 - x^k).
%H A373032 Amiram Eldar, <a href="/A373032/b373032.txt">Table of n, a(n) for n = 1..10000</a>
%F A373032 a(n) = Sum_{d|n, d < sqrt(n)} (-1)^(d+1) * d^2.
%t A373032 nmax = 70; CoefficientList[Series[Sum[(-1)^(k + 1) k^2 x^(k (k + 1))/(1 - x^k), {k, 1, nmax}], {x, 0, nmax}], x] // Rest
%t A373032 (* Alternative: *)
%t A373032 a[n_] := DivisorSum[n, (-1)^(#+1) * #^2 &, #^2 < n &]; Array[a, 70] (* _Amiram Eldar_, Nov 05 2026 *)
%o A373032 (PARI) a(n) = sumdiv(n, d, if(d^2 < n, (-1)^(d+1) * d^2)); \\ _Amiram Eldar_, Nov 05 2026
