%N A373031 Expansion of Sum_{k>=1} (-1)^(k+1) * k^2 * x^(k^2) / (1 - x^k).
%H A373031 Amiram Eldar, <a href="/A373031/b373031.txt">Table of n, a(n) for n = 1..10000</a>
%F A373031 a(n) = Sum_{d|n, d <= sqrt(n)} (-1)^(d+1) * d^2.
%t A373031 nmax = 70; CoefficientList[Series[Sum[(-1)^(k + 1) k^2 x^(k^2)/(1 - x^k), {k, 1, nmax}], {x, 0, nmax}], x] // Rest
%t A373031 (* Alternative: *)
%t A373031 a[n_] := DivisorSum[n, (-1)^(#+1) * #^2 &, #^2 <= n &]; Array[a, 70] (* _Amiram Eldar_, Nov 05 2026 *)
%o A373031 (PARI) a(n) = sumdiv(n, d, if(d^2 <= n, (-1)^(d+1) * d^2)); \\ _Amiram Eldar_, Nov 05 2026
