%T A373627 19419,59049,90483,133893,192327,531441,832911,1264173,1865539,
%U A373627 4782969,7628799,11816853,17828163,43046721,69620541,109646397,168500385,387420489,633634769
%N A373627 Expansion of 1 / ( (1 - 8*x^4) * (1 - x/(1 - 8*x^4)^(1/4)) ).
%H A373627 Robert Israel, <a href="/A373627/b373627.txt">Table of n, a(n) for n = 0..4170</a>
%F A373627 a(4*n) = 9^n for n >= 0.
%F A373627 a(n) = Sum_{k=0..floor(n/4)} 8^k * binomial(n/4,k).
%F A373627 a(n) == 1 (mod 2).
%F A373627 D-finite with recurrence: 4608*(n + 4)*(n + 8)*(n + 12)*a(n) - 64*(35*n + 302)*(n + 12)*(n + 8)*a(n + 4) + 24*(n + 12)*(17*n^2 + 360*n + 1945)*a(n + 8) - 3*(11*n^3 + 414*n^2 + 5225*n + 22110)*a(n + 12) + (n + 15)*(n + 14)*(n + 13)*a(n + 16) = 0. - _Robert Israel_, Nov 22 2026
%p A373627 with(gfun):
%p A373627 g:= 1 / ( (1 - 8*x^4) * (1 - x/(1 - 8*x^4)^(1/4)) ):
%p A373627 de:= holexprtodiffeq(g,y(x)):
%p A373627 rec:= diffeqtorec(de,y(x),a(n)):
%p A373627 f:= rectoproc(rec,a(n),remember):
%p A373627 map(f, [$0..37]); # _Robert Israel_, Nov 22 2026
%o A373627 (PARI) a(n) = sum(k=0, n\4, 8^k*binomial(n/4, k));
%Y A373627 Cf. A373509, A373583.
%K A373627 nonn,changed
%O A373627 0,5
