%T A373619 7654975021,121021831360,2196593121997,40464132512896,817485662059921,
%U A373619 17159299818547456,382733978898335185,8982388245979044352,219867829220866999861,5684505550914409716736
%N A373619 Expansion of e.g.f. exp(x / (1 - x^2)^(3/2)).
%H A373619 Robert Israel, <a href="/A373619/b373619.txt">Table of n, a(n) for n = 0..441</a>
%F A373619 a(n) = n! * Sum_{k=0..floor(n/2)} binomial(3*n/2-2*k-1,k)/(n-2*k)!.
%F A373619 a(n) == 1 mod 9.
%F A373619 a(n) ~ 3^(1/5) * 5^(-1/2) * exp(3^(-1/5)*n^(1/5)/4 + 5*3^(-3/5)*n^(3/5)/2 - n) * n^(n - 1/5) * (1 - 1/(10*3^(4/5)*n^(1/5))). - _Vaclav Kotesovec_, Jun 11 2024
%F A373619 D-finite with recurrence: 2*n*(n + 10)*(n + 9)*(n + 8)*(n + 7)*(n + 6)*(n + 5)*(n + 4)*(n + 3)*(n + 1)*(n + 2)^2*a(n) - 3*(3*n + 8)*(n + 10)*(n + 9)*(n + 8)*(n + 7)*(n + 6)*(n + 5)*(n + 4)*(n + 3)*(n + 2)*a(n + 2) + (n + 10)*(n + 9)*(n + 8)*(n + 7)*(n + 6)*(n + 5)*(15*n^2 + 105*n + 188)*a(n + 4) - 2*(n + 10)*(n + 9)*(n + 8)*(n + 7)*(5*n^2 + 40*n + 54)*a(n + 6) - 6*(n + 10)*(n + 9)*(39 + 5*n)*a(n + 8) + (3*n^2 + 66*n + 361)*a(n + 10) - a(n + 12) = 0. - _Robert Israel_, Nov 22 2026
%p A373619 with(gfun):
%p A373619 de:= holexprtodiffeq(exp(x / (1 - x^2)^(3/2)),y(x)):
%p A373619 erec:= diffeqtorec(de, y(x), b(n)):
%p A373619 arec1:=
%p A373619 collect(numer(simplify(eval(erec[1], {seq(b(n+i)=a(n+i)*n!/(n+i)!,i=0..12)}))),a):
%p A373619 ics:= seq(a(i) = i!*subs(erec[2..-1],b(i)),i=0..11):
%p A373619 f:= rectoproc({arec1,ics},a(n),remember):
%p A373619 map(f, [$0..25]); # _Robert Israel_, Nov 22 2026
%o A373619 (PARI) a(n) = n!*sum(k=0, n\2, binomial(3*n/2-2*k-1, k)/(n-2*k)!);
%Y A373619 Cf. A012150, A088009, A373620.
%Y A373619 Cf. A373577.
