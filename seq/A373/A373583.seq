%U A373583 39950221,63153481,96159061,410338673,696126557,1129839065,1767607973,6975757441,12080257069
%N A373583 Expansion of 1 / ( (1 - 16*x^4) * (1 - x/(1 - 16*x^4)^(1/4)) ).
%H A373583 Robert Israel, <a href="/A373583/b373583.txt">Table of n, a(n) for n = 0..3234</a>
%F A373583 a(4*n) = 17^n for n >= 0.
%F A373583 a(n) = Sum_{k=0..floor(n/4)} 16^k * binomial(n/4,k).
%F A373583 a(n) == 1 (mod 4).
%F A373583 D-finite with recurrence: 69632*(n + 4)*(n + 8)*(n + 12)*a(n) - 256*(n + 8)*(67*n + 574)*(n + 12)*a(n + 4) + 48*(n + 12)*(33*n^2 + 696*n + 3745)*a(n + 8) - (65*n^3 + 2442*n^2 + 30763*n + 129930)*a(n + 12) + (n + 15)*(n + 14)*(n + 13)*a(n + 16) = 0. - _Robert Israel_, Nov 22 2026
%p A373583 with(gfun):
%p A373583 g:= 1/((1 - 16*x^4) * (1 - x/(1 - 16*x^4)^(1/4))):
%p A373583 de:= holexprtodiffeq(g,y(x)):
%p A373583 rec:= diffeqtorec(de,y(x),a(n)):
%p A373583 f:= rectoproc(rec,a(n),remember):
%p A373583 A:=map(f, [$0..40]); # _Robert Israel_, Nov 22 2026
%o A373583 (PARI) a(n) = sum(k=0, n\4, 16^k*binomial(n/4, k));
%Y A373583 Cf. A000079, A100095, A373278, A373621.
