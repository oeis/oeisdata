%I A128256 #18 Aug 26 2026 21:51:42
%S A128256 1,-1,1,2,0,1,-2,2,1,1,3,0,3,2,1,-3,3,3,5,3,1,4,0,6,8,8,4,1,-4,4,6,14,
%T A128256 16,12,5,1,5,0,10,20,30,28,17,6,1,-5,5,10,30,50,58,45,23,7,1,6,0,15,
%U A128256 40,80,108,103,68,30,8,1,-6,6,15,55,120,188,211,171,98,38,9,1
%N A128256 Matrix product of (-1)^(n-k) * A004736(n+1,k+1) with A007318 (Pascal's triangle).
%H A128256 ProofWiki, <a href="https://proofwiki.org/wiki/Euler%27s_Transformation">Euler's transformation</a>, <a href="https://proofwiki.org/wiki/Pfaff%27s_Transformation">Pfaff's transformation</a>.
%H A128256 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/EulersHypergeometricTransformations.html">Euler's Hypergeometric Transformations</a>, <a href="https://mathworld.wolfram.com/PfaffTransformation.html">Pfaff Transformation</a>.
%F A128256 A004736 (with alternate signs: (1; -2,1; 3,-2,1;...)) * A007318, Pascal's triangle.
%F A128256 From _Natalia L. Skirrow_, Aug 21 2026: (Start)
%F A128256 O.g.f.: 1/((1+x)^2 * (1-(1+y)*x)).
%F A128256 Row o.g.f.: ((1+y)^(n+2) + (3+2*n + (2+n)*y)*(-1)^n)/(2+y)^2.
%F A128256 E.g.f.: ((1+y)^2*e^(x*(2+y)) + 3 + 2*y - x*(2 + y)) / (e^x * (2+y)^2).
%F A128256 T(n,k) = Sum_{j=0..n-k} (-1)^j*(j+1)*C(n-j,k).
%F A128256 T(n,k) = Sum_{j=k..n} C(n+2,j+2) * C(j,k) * (-1)^(n-j) * 2^(j-k).
%F A128256 T(n,k) = (-1)^(n-k)*(2*n+3-k)/2^(k+2) + Sum_{j=0..k} (-1)^j*C(n+2,k-j)*(j+1)/2^(j+2).
%F A128256 These are due to Pfaff's & Euler's transformations, which can be stated:
%F A128256 T(n,k) = C(n,k) * hypergeom([   2,k-n],[-n], -1).
%F A128256 T(n,k) = C(n,k) * hypergeom([   2, -k],[-n],1/2) / 4.
%F A128256 T(n,k) = C(n,k) * hypergeom([-n-2, -k],[-n], -1) / 2^(2+k).
%F A128256 (End)
%e A128256 First few rows of the triangle are:
%e A128256 n\k|  0  1  2  3  4  5  6 7 8
%e A128256 ---+-------------------------
%e A128256  0 |  1
%e A128256  1 | -1  1
%e A128256  2 |  2  0  1
%e A128256  3 | -2  2  1  1
%e A128256  4 |  3  0  3  2  1
%e A128256  5 | -3  3  3  5  3  1
%e A128256  6 |  4  0  6  8  8  4  1
%e A128256  7 | -4  4  6 14 16 12  5 1
%e A128256  8 |  5  0 10 20 30 28 17 6 1
%e A128256   ...
%o A128256 (Python)
%o A128256 from math import comb
%o A128256 A128256=lambda n,k: sum((-1)**j*(j+1)*comb(n-j,k) for j in range(n-k+1)) # _Natalia L. Skirrow_, Aug 21 2026
%Y A128256 Cf. A004736, A007318, A053088 (row sums).
%K A128256 tabl,sign,changed
%O A128256 0,4
%A A128256 _Gary W. Adamson_, Feb 21 2007
