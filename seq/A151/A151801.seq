%S A151801 2,4,21,330,14610,1820715,653629616,696496706166,2267861968974085,
%T A151801 23151301116946350437,757490164568070202377310,
%U A151801 80950840941871760357231324684,28717989813276657346258327676447790,34297679194541685920299930878909636581738,139588714091899886855341433838992643658475861276
%N A151801 Number of n X n binary arrays with rows, considered as binary numbers, in strictly increasing order, and columns, considered as binary numbers, in nondecreasing order.
%C A151801 From _Meghanto Majumder_, Sep 21 2026: (Start)
%C A151801 Equivalently, a(n) counts doubly lexically ordered n X n binary matrices with distinct rows.
%C A151801 After the first k rows, partition the columns into maximal consecutive blocks having equal k-bit prefixes. A new row preserves the column order exactly when its entries are nondecreasing within every block. The partition is then refined by splitting each block between its 0's and 1's.
%C A151801 The lower bound below follows by applying double ordering to binary matrices with distinct rows and columns; a union bound excludes at most n*(n-1)/2^n of all labeled matrices.
%C A151801 (End)
%H A151801 Meghanto Majumder, <a href="/A151801/b151801.txt">Table of n, a(n) for n = 1..17</a>
%H A151801 R. H. Hardin, <a href="/A151801/a151801.txt">Binary arrays with both rows and cols sorted, symmetries</a>
%H A151801 Anna Lubiw, <a href="https://doi.org/10.1137/0216057">Doubly Lexical Orderings of Matrices</a>, SIAM J. Comput. 16 (1987), no. 5, 854-879.
%F A151801 From _Meghanto Majumder_, Sep 21 2026: (Start)
%F A151801 Let F_k(P,x) count valid k-row arrays whose last row is x and whose equal-prefix blocks form the interval partition P. Initially, for every nondecreasing binary row x, F_1(P(x),x)=1, where P(x) is the partition into maximal constant blocks.
%F A151801 For every y>x that is nondecreasing on each block of P, add F_k(P,x) to F_(k+1)(P|y,y), where P|y is obtained by splitting each block between the 0's and 1's of y. Then a(n)=Sum_{P,x} F_n(P,x).
%F A151801 2^(n^2)*(1-n*(n-1)/2^n)/(n!)^2 <= a(n) <= 2^(n^2) for all sufficiently large n. Consequently, lim_{n->infinity} a(n)^(1/n^2)=2.
%F A151801 (End)
%o A151801 (Python)
%o A151801 def a(n):
%o A151801     r = 1 << n
%o A151801     m = r // 2 - 1
%o A151801     d = [(x >> 1) & (x ^ (r - 1)) for x in range(r)]
%o A151801     e = [(x ^ (x >> 1)) & m for x in range(r)]
%o A151801     f = {(e[x], x): 1 for x in range(r) if not d[x]}
%o A151801     for _ in range(1, n):
%o A151801         g = {}
%o A151801         for (s, x), c in f.items():
%o A151801             for y in range(x + 1, r):
%o A151801                 if d[y] & ~s == 0:
%o A151801                     k = (s | e[y], y)
%o A151801                     g[k] = g.get(k, 0) + c
%o A151801         f = g
%o A151801     return sum(f.values())
%o A151801 # _Meghanto Majumder_, Sep 21 2026
%Y A151801 Cf. A089006 (both orders non-strict), A162100 (both orders strict).
%K A151801 nonn,changed
%O A151801 1,1
%A A151801 _R. H. Hardin_, Jun 27 2009
%E A151801 a(13)-a(15) from _Meghanto Majumder_, Sep 21 2026
