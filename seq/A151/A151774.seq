%N A151774 Characteristic function of numbers with binary weight 2 (A018900).
%C A151774 First differences of A340068. - _Ridouane Oudra_, Sep 17 2026
%H A151774 Reinhard Zumkeller, <a href="/A151774/b151774.txt">Table of n, a(n) for n = 0..10000</a>
%H A151774 <a href="/index/Ch#char_fns">Index entries for characteristic functions</a>.
%F A151774 Let Theta = Sum_{k >= 0} x^(2^k). G.f. is (x + Theta^2 - Theta)/2 (cf. A151758).
%F A151774 a(A018900(n)) = 1; a(A161989(n)) = 0. - _Reinhard Zumkeller_, Jun 24 2009
%F A151774 From _Ridouane Oudra_, Sep 19 2026: (Start)
%F A151774 a(n) = A151758(n)/2, for n > 1.
%F A151774 a(n) = (A073267(n) - A209229(n))/2, for n > 1.
%F A151774 a(n) = A209229(A000265(n)-1), for n > 0.
%F A151774 a(n) = A209229(A153733(n-1)), for n > 0. (End)
%t A151774 w[n_] := IntegerDigits[n, 2] // Total;
%t A151774 a[n_] := Boole[w[n] == 2];
%t A151774 a /@ Range[0, 105] (* _Jean-François Alcover_, Mar 31 2021 *)
%o A151774 (PARI) a(n)=hammingweight(n)==2 \\ _Charles R Greathouse IV_, Sep 26 2015
%o A151774 (Python)
%o A151774 def A151774(n): return int(n.bit_count()==2) # _Chai Wah Wu_, Sep 18 2026
%Y A151774 Cf. A000120, A018900, A073267, A151758, A161989, A209229, A340068, A000265, A153733.
