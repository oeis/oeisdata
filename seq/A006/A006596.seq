%I A006596 M1325 #43 Oct 28 2026 23:54:17
%S A006596 2,5,6,14,21,26,141,278,281,306,345,1365,2573,2661,4766,5385,110945,
%T A006596 117549,152933,155513,166613,396030,673890,834609,941393,1152890,
%U A006596 2621669
%N A006596 Numbers k such that (2^(2*k+1) - 2^(k+1) + 1)/5 is prime.
%C A006596 The definition implies that 2*k + 1 must be prime. - _Jonathan Carroll_, Oct 21 2026
%D A006596 J. Brillhart et al., Factorizations of b^n +- 1. Contemporary Mathematics, Vol. 22, Amer. Math. Soc., Providence, RI, 2nd edition, 1985; and later supplements.
%D A006596 N. J. A. Sloane and Simon Plouffe, The Encyclopedia of Integer Sequences, Academic Press, 1995 (includes this sequence).
%H A006596 J. Brillhart et al., <a href="https://doi.org/10.1090/conm/022">Factorizations of b^n +- 1</a>, Contemporary Mathematics, Vol. 22, Amer. Math. Soc., Providence, RI, 3rd edition, 2002.
%H A006596 Victor Meally, <a href="/A006556/a006556.pdf">Letter to N. J. A. Sloane</a>, no date.
%H A006596 S. S. Wagstaff, Jr., <a href="http://www.cerias.purdue.edu/homes/ssw/cun/index.html">The Cunningham Project</a>
%F A006596 a(n) = (A125742(n) - 1)/2. - _Jonathan Carroll_, Oct 19 2026
%F A006596 a(n) = (p - 1)/2 for the terms p of A124112 with p == 3 or 5 (mod 8) (for those p the norm of ((1+i)^p + 1)/(2+i) is (2^p - 2^((p+1)/2) + 1)/5); these p are exactly the terms of A125742. - _Jonathan Carroll_, Oct 21 2026
%t A006596 For[ n=1, n<=5400, n++, If[ PrimeQ[ ( 2^(2n+1) - 2^(n+1) + 1)/5 ], Print[ n ] ] ]
%t A006596 (* Alternative: *)
%t A006596 Select[Range[5400],PrimeQ[(2^(2#+1)-2^(#+1)+1)/5]&] (* _Harvey P. Dale_, Jun 28 2023 *)
%o A006596 (PARI) is(n)=my(t=(2^(2*n+1) - 2^(n+1) + 1)/5); !frac(t) && ispseudoprime(t) \\ _Charles R Greathouse IV_, Jun 13 2017
%Y A006596 Cf. A124112, A125742.
%K A006596 nonn,hard,more,changed
%O A006596 1,1
%A A006596 _N. J. A. Sloane_
%E A006596 More terms from Douglas R. Burke (dburke(AT)nevada.edu)
