%H A006885 Robert G. Wilson v, <a href="/A006877/a006877.pdf">Letter to N. J. A. Sloane with attachments, Jan. 1989</a>
%H A006885 Robert G. Wilson v, <a href="/A006884/a006884.pdf">Tables of A6877, A6884, A6885, Jan. 1989</a>
%H A006885 <a href="/index/Go#GEB">Index entries for sequences from "Goedel, Escher, Bach"</a>
%H A006885 <a href="/index/3#3x1">Index entries for sequences related to 3x+1 (or Collatz) problem</a>
%F A006885 a(n) = A025586(A006884(n)); A025586(m) < a(n) for m < A006884(n). - _Reinhard Zumkeller_, May 11 2013
%e A006885 The trajectory of 3 is {3, 10, 5, 16, 8, 4, 2, 1} with a highest point of 16. This is greater than the highest point for any smaller number, so 16 is in the sequence. - _Michael B. Porter_, Oct 10 2026
%p A006885 b:= proc(n) option remember; `if`(n=1, 1,
%p A006885       max(n, b(`if`(n::even, n/2, 3*n+1))))
%p A006885     end:
%p A006885 g:= proc(n) option remember; local k,t;
%p A006885       k:=g(n-1); t:= b(k);
%p A006885       do k:=k+1; if b(k)>t then break fi od; k
%p A006885     end: g(1):=1:
%p A006885 a:= n-> b(g(n)):
%p A006885 seq(a(n), n=1..30);  # _Alois P. Heinz_, Jan 14 2026
%t A006885 mcoll[n_]:=Max@@NestWhileList[If[EvenQ[#],#/2,3#+1]&,n,#>=n&]; t={1,max=2}; Do[If[(y=mcoll[n])>max,AppendTo[t,max=y]],{n,3,10^6,4}]; t (* _Jayanta Basu_, May 28 2013 *)
%o A006885 (Haskell) a006885 = a025586 . a006884  -- _Reinhard Zumkeller_, May 11 2013
%o A006885 (PARI) A006885(n) = A025586(A006884(n)) \\ _M. F. Hasler_, Nov 05 2026
%o A006885 (Python) A006885 = lambda n: A006884(n) and A006884.v[n-1] # assuming A006884.v lists the record values, see program there. - _M. F. Hasler_, Nov 05 2026
