%I A006934 M5119 #74 Aug 25 2026 19:34:12
%S A006934 1,1,21,671,180323,20898423,7426362705,1874409467055,5099063967524835,
%T A006934 2246777786836681835,2490122296790918386363,1694873049836486741425113,
%U A006934 5559749161756484280905626951,5406810236613380495234085140851,12304442295910538475633061651918089
%N A006934 A series for Pi.
%C A006934 Formula (21) in Luke (see ref.): Let y = 4*n+1. Then for n -> oo
%C A006934 Pi ~ 4*(n!)^4*2^(4*n)/(y*((2*n)!)^2)*(Sum_{k>=0}((-1)^k*y^(-2*k)* A006934(k)/A088802(k)))^2. (Luke does not reference the sequences in this form.) - _Peter Luschny_, Mar 23 2014 [However, note that the sum over k is not convergent. The maximum k summed to should grow as ~ Pi*n. - _Natalia L. Skirrow_, Aug 14 2026]
%C A006934 This might be related to the numerators of eq. (18) in N. Elezovic' "Asymptotic Expansions of Central Binomial...", J. Int. Seq. 17 (2014) # 14.2.1. - _R. J. Mathar_, Mar 23 2014
%C A006934 Several references give an erroneous value of 1874409465055 instead of a(7) in the formula for Pi. - _M. F. Hasler_, Mar 23 2014
%C A006934 The sum is an enveloping series; it alternates between upper and lower bounds, and the error from the true value is always between 0 and the first omitted term. [Elezović (2014)] - _Natalia L. Skirrow_, Aug 14 2026
%D A006934 Y. L. Luke, The Special Functions and their Approximation, Vol. 1, Academic Press, NY, 1969, see p. 36.
%D A006934 N. J. A. Sloane and Simon Plouffe, The Encyclopedia of Integer Sequences, Academic Press, 1995 (includes this sequence).
%H A006934 Neven Elezović, <a href="https://cs.uwaterloo.ca/journals/JIS/VOL17/Elezovic/elezovic5.html">Asymptotic Expansions of Central Binomial Coefficients and Catalan Numbers</a>. Journal of Integer Sequences, Vol. 17 (2014), article 14.2.1. (See formula (18).)
%H A006934 J. L. Fields, <a href="https://doi.org/10.1017/S0013091500013171">A note on the asymptotic expansion of a ratio of gamma functions</a>, Proc. Edinburgh Math. Soc. (15), 43-45, 1966.
%H A006934 A. Gil, J. Segura, N. M. Temme, <a href="https://doi.org/10.1093/imanum/drq012">Fast and accurate computation of the Weber parabolic cylinder function W(a,x)</a>, IMA J. Num. Anal. 31 (2011), 1194-1216, eq (3.8).
%H A006934 A. Lupas, <a href="http://mathforum.org/kb/message.jspa?messageID=457303">Re: Pi Calculation ?</a>, on mathforum.org, Feb 15 2003.
%H A006934 Peter Luschny, <a href="https://www.luschny.de/math/factorial/approx/SimpleCases.html">Approximation Formulas for the Factorial Function</a>.
%H A006934 C. Mortici, <a href="http://naimlbraha.ilirias.com/repository/docs/BMAA2-4-17.pdf">On some accurate estimates of Pi</a>, Bull. Math. Anal. Appl. 2(4) (2010) 137-139. (Formula (1.5), same typo as in Luke)
%H A006934 Natalia L. Skirrow, <a href="https://oeis.org/wiki/User:Natalia_L._Skirrow/Stirling&#39;s_approximations">Stirling's approximations</a>.
%H A006934 Natalia L. Skirrow, <a href="https://math.stackexchange.com/a/5144931">answer to "Elementary central binomial coefficient estimates"</a> (2026), Mathematics StackExchange.
%H A006934 <a href="/index/Ph#Pi314">Index entries for sequences related to the number Pi</a>
%F A006934 Let p(n,x) = sum(k=0..n, x^k*A220412(n,k))/A220411(n) then a(n) = (-1)^n*p(n,1/4)*A088802(n)*A001448(n). - _Peter Luschny_, Mar 23 2014
%F A006934 Pi = lim_{n->oo} 2^{4n+2}/((4n+1)*C(2n,n)^2)*(sum_{k=0..oo} (-1)^k*a(k)/(A088802(k)*(4n+1)^{2k}))^2. - _M. F. Hasler_, Mar 23 2014
%F A006934 From _Natalia L. Skirrow_, Aug 14 2026: (Start)
%F A006934 Let coeff(2*n) = (-1)^n * a(n) * 16^n / A088802(n) (an integer sequence), and coeff(2*n+1) = 0.
%F A006934 Let f(x) = sqrt(x+1/4)*Gamma(x+1/2)/Gamma(x+1) = C(2*x,x)*sqrt(Pi*(x+1/4))/4^x.
%F A006934 The following Laplace transform representations hold:
%F A006934 log(f(x)) = Integral_{t=0..oo} e^(-(n+1/4)*t) * (1/cosh(t/4) - 1) /(2*t) dt.
%F A006934 f(x) = sqrt((x+1/4)/Pi) * Integral_{t=0..oo} e^(-(x+1/4)*t) / sqrt(2*sinh(t/2)) dt.
%F A006934 The following asymptotic expansions hold as formal power series:
%F A006934 log(f(x)) ~ Sum_{k>=0} A028296(k) * (-1)^k / (4 * k * (4*x+1)^(2*k)).
%F A006934 f(x) ~ Sum_{n>=1} coeff(2*n) / (4*(4*x+1))^(2*n) = Sum_{n>=1} (-1)^n * a(n) / (A088802(n) * (4*x+1)^(2*n)).
%F A006934 E.g.f. for coeff(n) / C(2*n,n): sqrt(2*x / sinh(2*x)).
%F A006934 coeff(n) = C(2*n,n) * B^(1/2)_n(1/4) * 4^n, where B^(r)_n(x) is a Nørlund polynomial.
%F A006934 coeff(n) = C(2*n,n) * Sum_{j=0..n} C(n,j) * Sum_{k=0..j} (-1)^k*C(2*k,k)*4^(j-k)*A008299(j+k,k)/C(j+k,k).
%F A006934 coeff(n) = C(2*n,n) * Sum_{j=0..n} C(n,j) * Sum_{k=0..j} (-1)^k*A008517(j,k) * C(2*j,k)/C(2*j,j) * C(4*j,2*j)/C(4*j,2*k), with the extension A008517(n,0) = [n=0].
%F A006934 Recurrence: coeff(2*n) = (1/n)*Sum_{k=1..n} A028296(k) * coeff(2*(n-k)) * 4^(2*k-1).
%F A006934 coeff(n)/16^n ~ cos(Pi*n/2) * (n-1)! * (2/Pi) / (2*Pi)^n.
%F A006934 (End)
%F A006934 a(n) = |A239792/A239793(n)| * A001448(n) * 2^A004134(n). - _Peter Luschny_, Aug 15 2026
%e A006934 a(n) / A088802(n) begins (for n=1..8):
%e A006934  1/1, 1/4, 21/32, 671/128, 180323/2048, 20898423/8192, 7426362705/65536, 1874409467055/262144.
%e A006934 C(2*n,n) ~ (4^n/sqrt(Pi*m)) * (1 - 1/(4*m^2) + 21/(32*m^4) - 671/(128*m^6) + 180323/(2048*m^8) - ...), where m=4*n+1.
%e A006934 sqrt(t/(2*sinh(t/2))) = 1 - t^2/(4*2!*C(4,2)) + 21*t^4/(32*4!*C(8,4)) - 671*t^6/(128*6!*C(12,6)) + 180323*t^8/(2048*8!*C(16,8)) - ...
%p A006934 A006934_list := proc(n) local k, f, bp;
%p A006934 bp := proc(n,x) option remember; local k; if n = 0 then 1 else -x*add(binomial(n-1,2*k+1)*bernoulli(2*k+2)/(k+1)*bp(n-2*k-2,x), k=0..n/2-1) fi end:
%p A006934 f := n -> 2^(3*n-add(i, i=convert(n,base,2)));
%p A006934 add(bp(2*k,1/4)*binomial(4*k,2*k)*x^(2*k), k=0..n-1);
%p A006934 seq((-1)^k*f(k)*coeff(%,x,2*k), k=0..n-1) end:
%p A006934 A006934_list(15);  # _Peter Luschny_, Mar 23 2014
%p A006934 # Alternative: without using Nörlund's generalized Bernoulli polynomials, based on Euler numbers:
%p A006934 A006934_list := proc(n) local a,c,j;
%p A006934 c := n -> 4^n/2^add(i, i=convert(n,base,2));
%p A006934 a := [seq((-4)^j*euler(2*j)/(4*j), j=1..n)];
%p A006934 expand(exp(add(a[j]*x^(-j), j=1..n))); taylor(%, x=infinity, n+2);
%p A006934 subs(x=1/x, convert(%,polynom)): seq(c(iquo(j,2))*coeff(%,x,j), j=0..n) end:
%p A006934 A006934_list(14); # _Peter Luschny_, Apr 08 2014
%t A006934 A006934List[n_] := Module[{c, a, s, sx}, c[k_] := 4^k/2^Total[ IntegerDigits[k, 2]]; a = Table[(-4)^j EulerE[2j]/(4j), {j, 1, n}]; s[x_] = Series[Exp[Sum[a[[j]] x^(-j), {j, 1, n}]], {x, Infinity, n+2}] // Normal; sx = s[1/x]; Table[c[Quotient[j, 2]] Coefficient[sx, x, j], {j, 0, n}]];
%t A006934 A006934List[14] (* _Jean-François Alcover_, Jun 02 2019, from second Maple program *)
%t A006934 (* Alternative: *)
%t A006934 n=12;r=Range[0,2*n,2];Numerator[CoefficientList[Series[Sqrt[Sqrt[t]/(2*Sinh[Sqrt[t]/2])],{t,0,n}],t]*r!*Binomial[2*r,r]] (* _Natalia L. Skirrow_, Aug 14 2026 *)
%o A006934 (SageMath)
%o A006934 @CachedFunction
%o A006934 def p(n):
%o A006934     if n < 2: return 1
%o A006934     return -add(binomial(n-1,k-1)*bernoulli(k)*p(n-k)/k for k in range(2,n+1,2))/2
%o A006934 def A006934(n): return (-1)^n*p(2*n)*binomial(4*n,2*n)*2^(3*n-sum(n.digits(2)))
%o A006934 [A006934(n) for n in (0..14)]  # _Peter Luschny_, Mar 24 2014
%o A006934 (Python)
%o A006934 from sympy import euler #euler(2*k) = A028296(k)
%o A006934 from functools import cache
%o A006934 eul=cache(euler)
%o A006934 A006934_unsimp=cache(lambda n: not n or sum(eul(2*k) * (-1)**k * A006934_unsimp(n-k)<<3*k-2 for k in range(1, n+1))//n) # A006934_unsimp(n) * (-2)**n = coeff(2*n)
%o A006934 A006934=lambda n: A006934_unsimp(n)>>n.bit_count()
%o A006934 print([A006934(n) for n in range(15)]) # _Natalia L. Skirrow_, Aug 14 2026
%Y A006934 Cf. A088802 (denominators).
%Y A006934 Cf. A028296 (Euler numbers), A008299 (second-order Stirling subset numbers), A008517 (second-order Eulerian numbers), A220411, A220412, A239792/A239793, A001448, A004134.
%K A006934 nonn,changed
%O A006934 0,3
%A A006934 _Simon Plouffe_ and _N. J. A. Sloane_
%E A006934 a(7) corrected, a(8)-a(14) from _Peter Luschny_, Mar 23 2014
