%F A006455 E.g.f.: exp(S(x)-1) where S(x)is the e.g.f. for A323502. - _Ludovic Schwob_, Mar 29 2024
%F A006455 From _James Guillochon_, Sep 27 2026: (Start)
%F A006455 a(n+k) = Sum_{P,Q} i(Q^op x P), where P and Q run over the naturally labeled posets on [n] and [k], Q^op x P is the product order, and i(X) is the number of order ideals of X (= the number of order-preserving maps from Q to the ideal lattice of P).
%F A006455 a(n+k) = Sum_{P,Q} w(P)*w(Q)*i(Q^op x P) over unlabeled posets P on n and Q on k points, where w(P) = e(P)/|Aut(P)| is the number of natural labelings of P and e(P) is its number of linear extensions. The case k = 1 is a(n+1) = Sum_P w(P)*i(P). (End)
%e A006455 a(3) = 7: {}, {1R2}, {1R3}, {2R3}, {1R2, 1R3}, {1R3, 2R3}, {1R2, 1R3, 2R3}.
%o A006455 (Python)
%o A006455 def A006455(n):  # uses the split formula with n = m + (n-m); slow, for checking small n
%o A006455     def ideals(p):
%o A006455         r = [0]
%o A006455         for j, d in enumerate(p):
%o A006455             r += [x | 1 << j for x in r if x & d == d]
%o A006455         return r
%o A006455     def nat(m):
%o A006455         ps = [()]
%o A006455         for j in range(m):
%o A006455             ps = [p + (d,) for p in ps for d in ideals(p)]
%o A006455         return ps
%o A006455     def hom(q, J, phi=()):
%o A006455         j = len(phi)
%o A006455         if j == len(q): return 1
%o A006455         lo = 0
%o A006455         for i in range(j):
%o A006455             if q[j] >> i & 1: lo |= phi[i]
%o A006455         return sum(hom(q, J, phi + (I,)) for I in J if I & lo == lo)
%o A006455     m = n // 2
%o A006455     return sum(hom(q, ideals(p)) for p in nat(m) for q in nat(n - m))  # _James Guillochon_, Sep 27 2026
%Y A006455 Cf. A000112, A001035, A121337, A323502.
