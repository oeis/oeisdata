%T A118743 216862434431944426122117120047,
%U A118743 1874480713189654839282450157086195210900931486780353469173376681742503659434414632312033372643386765197475111737132341321962070865661132800000000000000000173
%N A118743 Primes of the form k!! + k + 1.
%C A118743 The corresponding k are listed in A398791. - _Mauro Fiorentini_, Aug 05 2026
%C A118743 a(14), corresponding to k=8170, has 14210 digits. - _Michael S. Branicky_, Aug 06 2026
%D A118743 G. Balzarotti and P. P. Lava, Le sequenze di numeri interi, Hoepli, 2008, p. 159
%H A118743 Michael S. Branicky, <a href="/A118743/b118743.txt">Table of n, a(n) for n = 1..13</a>
%e A118743 For k=0, 0!! + 0 + 1 = 1 + 0 + 1 = 2, which is prime;
%e A118743 For k=2, 2!! + 2 + 1 = 2 + 2 + 1 = 5, which is prime;
%e A118743 for k=4, 4!! + 4 + 1 = 4*2 + 4 + 1 = 8 + 4 + 1 = 13, which is prime.
%p A118743 SFACT:= proc(n) local i,j,k; for k from 1 by 1 to n do i:=k; j:=k-2; while j >0 do i:=i*j; j:=j-2; od: if isprime(i+k+1) then print(i+k+1); fi; od: end: SFACT(550);
%t A118743 Select[Table[n!!+n+1,{n,0,250}],PrimeQ] (* _Harvey P. Dale_, Nov 22 2012 *)
%Y A118743 Cf. A006882, A398791.
%K A118743 nonn,changed
%O A118743 1,1
%A A118743 _Paolo P. Lava_ and _Giorgio Balzarotti_, May 22 2006
%E A118743 a(1) = 2 inserted by _Michael S. Branicky_, Aug 05 2026
