%S A339952 5,13,17,25,29,37,41,45,53,61,65,73,85,89,97,101,109,113,117,125,137,
%T A339952 145,149,153,157,169,173,181,185,193,197,205,221,225,229,233,241,245,
%U A339952 257,261,265,269,277,281,289,293,305,313,317,325,333,337,349,353,365,369
%N A339952 Numbers that are the sum of an even square > 0 and an odd square.
%C A339952 Also, 1 + 4*(sums of two positive triangular numbers), i.e., the range of T(n,k) = 1 + 4*(A000217(n) + A000217(k)), n >= k >= 1; also, a supersequence of A020882. - _M. F. Hasler_, Sep 08 2026
%H A339952 Robert Israel, <a href="/A339952/b339952.txt">Table of n, a(n) for n = 1..10000</a>
%e A339952 a(2) = 13 is a term in the sequence since it is the sum of an even square > 0 and an odd square: 2^2 + 3^2 = 4 + 9 = 13.
%p A339952 N:= 10^5: # for terms <= N
%p A339952 m:= floor(sqrt(N)):
%p A339952 sort(convert(select(`<=`,{seq(seq(i^2+j^2,i=1..m,2),j=2..m,2)},N),list)): # _Robert Israel_, Sep 08 2026
%t A339952 Table[If[Sum[Sign[(Mod[i, 2] Mod[n - i + 1, 2] + Mod[i + 1, 2] Mod[n - i, 2])] (Floor[Sqrt[i]] - Floor[Sqrt[i - 1]]) (Floor[Sqrt[n - i]] - Floor[Sqrt[n - i - 1]]), {i, Floor[n/2]}] > 0, n, {}], {n, 369}] // Flatten
%o A339952 (Python)
%o A339952 from math import isqrt
%o A339952 def aupto(limit):
%o A339952   m = isqrt(limit) + 2
%o A339952   es = [i*i for i in range(2, m, 2)]
%o A339952   os = [i*i for i in range(1, m, 2)]
%o A339952   return sorted(set(a+b for a in es for b in os if a+b <= limit))
%o A339952 print(aupto(377)) # _Michael S. Branicky_, May 13 2021
