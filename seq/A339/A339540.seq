%U A339540 6997,7417,8221,8353,8461,9133,9181,9661,9721,10837,11497,12457,12553,12601,12721,12757,13681,13921,14437,15013
%N A339540 Primes p that are the smallest prime congruent to 1 mod k only for k = p - 1.
%C A339540 Old name: Primes that are not terms of A338929.
%C A339540 Equivalently, primes that occur only once in A034694. - _Peter Munn_, May 02 2023
%H A339540 Robert Israel, <a href="/A339540/b339540.txt">Table of n, a(n) for n = 1..10000</a>
%p A339540 N:= 20000: # for terms <= N
%p A339540 g:= proc(k) option remember; local j;
%p A339540   for j from k+1 by k do if isprime(j) then return j fi od
%p A339540 end proc:
%p A339540 filter:= p -> isprime(p) and andmap(k -> g(k) <> p, NumberTheory:-Divisors(p-1) minus {p-1}):
%p A339540 select(filter, [2,seq(i,i=3..N,2)]); # _Robert Israel_, Sep 20 2026
%Y A339540 Cf. A000040, A034694, A338929.
%K A339540 nonn,changed
%O A339540 1,1
%A A339540 _Ahmad J. Masad_, Dec 08 2020
%E A339540 New name from _Peter Munn_, May 02 2023
%E A339540 Corrected by _Robert Israel_, Sep 20 2026
