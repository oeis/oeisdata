%T A065756 32323181593821704288671,1481630482369728860007652801,
%U A065756 114129022540066183425609121804831
%N A065756 Generalization of the Genocchi numbers given by the Gandhi polynomials A(n+1,r) = r^5 A(n, r + 1) - (r - 1)^5 A(n, r); A(1,r) = r^5 - (r-1)^5.
%H A065756 Michael De Vlieger, <a href="/A065756/b065756.txt">Table of n, a(n) for n = 1..123</a>
%H A065756 Michael Domaratzki, <a href="https://research.cs.queensu.ca/TechReports/Reports/2001-449.pdf">A Generalization of the Genocchi Numbers with Applications to Enumeration of Finite Automata</a>, Tech. Report 2001-449, Dept. Comput. Info. Sci., Queen's Univ. Kingston, Kingston, Ontario, Canada, 2001.
%H A065756 Michael Domaratzki, <a href="https://cs.uwaterloo.ca/journals/JIS/VOL7/Domaratzki/doma23.html">Combinatorial Interpretations of a Generalization of the Genocchi Numbers</a>, J. Int. Seq. 7 (2004), Art. 04.3.6.
%H A065756 Dominique Dumont, <a href="https://doi.org/10.1016/0012-365X(72)90039-8">Sur une conjecture de Gandhi concernant les nombres de Genocchi</a>, (in French), Disc. Math. 1 (1972), 321-327.
%H A065756 Dominique Dumont, <a href="https://doi.org/10.1215/S0012-7094-74-04134-9">Interprétations combinatoires des nombres de Genocchi</a>, Duke Math. J. 41 (1974), 305-318.
%H A065756 Dominique Dumont, <a href="/A001469/a001469_3.pdf">Interprétations combinatoires des nombres de Genocchi</a>, Duke Math. J. 41 (1974), 305-318. (Annotated scanned copy)
%H A065756 Derek Hanely, Edison Muçllari, and Vasily Zadorozhnyy, <a href="https://arxiv.org/abs/2611.28407">A general triangle generation of the d-dimensional Genocchi numbers</a>, arXiv:2611.28407 [math.CO], 2026. See pp. 9, 15.
%F A065756 a(n) = A(n-1, 1) for the above Gandhi polynomials.
%t A065756 a[n_ /; n >= 0, r_ /; r >= 0] := a[n, r] = r^5*a[n-1, r+1]-(r-1)^5*a[n-1, r]; a[1, r_ /; r >= 0] := r^5-(r-1)^5; a[_, _] = 1; a[n_] := a[n-1, 1]; Table[a[n], {n, 0, 10}] (* _Jean-François Alcover_, May 23 2013 *)
