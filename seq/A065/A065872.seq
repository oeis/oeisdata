%S A065872 2,3,5,6,7,10,11,12,13,14,15,17,18,19,20,21,23,26,29,30,31,33,34,35,
%T A065872 37,38,40,41,43,44,45,46,47,48,51,53,54,55,56,57,58,59,61,63,65,67,68,
%U A065872 71,72,73,74,75,78,79,80,83,85,86,88,89,90,93,96,97,98,101,103,105,107
%N A065872 Numbers k such that usigma(k) - 1 is a prime.
%C A065872 From _Amiram Eldar_, Aug 25 2026: (Start)
%C A065872 Includes all the primes since usigma(p) - 1 = p for all primes p.
%C A065872 If p is a prime such that 3*p + 2 is also a prime (A023208), then 2*p is a term.
%C A065872 If p is a prime such that 4*p + 3 is also a prime (A023213), then 3*p is a term.
%C A065872 If p is a prime such that 6*p + 5 is also a prime (A023221), then 5*p is a term.
%C A065872 If p is a prime such that 8*p + 7 is also a prime (A023221), then 7*p is a term.
%C A065872 If p is a prime such that 12*p + 11 is also a prime (A157974), then 11*p is a term.
%C A065872 If p is a prime such that 14*p + 13 is also a prime (A089440), then 13*p is a term. (End)
%H A065872 Amiram Eldar, <a href="/A065872/b065872.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from Harry J. Smith)
%t A065872 f[n_] := Block[ {a = FactorInteger[n], k = l = s = 1}, l = Length[a]; While[k <= l, s = s * (a[[k, 1]]^a[[k, 2]] + 1); k++ ]; Return[s]]; Select[ Range[200], PrimeQ[ f[ # ] - 1] & ]
%o A065872 (PARI) usigma(n)= { local(f,s=1); f=factor(n); for(i=1, matsize(f)[1], s*=1 + f[i, 1]^f[i, 2]); return(s) }
%o A065872 isok(m) = isprime(usigma(m) - 1); \\ _Harry J. Smith_, Nov 02 2009
%Y A065872 Cf. A034448 (usigma), A065871.
%Y A065872 Cf. A023208, A023213, A023221, A023231, A089440, A157974.
%K A065872 nonn,changed
%O A065872 1,1
