%S A065871 1,3,5,6,9,10,11,17,18,20,22,24,26,27,28,29,30,38,41,42,44,45,46,50,
%T A065871 51,52,55,56,59,62,69,71,76,77,80,81,82,85,88,90,91,98,100,101,104,
%U A065871 105,106,107,112,114,116,118,125,126,132,136,137,140,141,145,146,148,149
%N A065871 Numbers k such that usigma(k) + 1 is a prime.
%C A065871 From _Amiram Eldar_, Aug 25 2026: (Start)
%C A065871 Includes the lesser members of twin primes (A001359).
%C A065871 If p is a prime such that 3*p + 4 is also a prime (A023209), then 2*p is a term.
%C A065871 If p is a prime such that 4*p + 5 is also a prime (A023214) and p != 3, then 3*p is a term.
%C A065871 If p is a prime such that 6*p + 7 is also a prime (A023222) and p != 5, then 5*p is a term.
%C A065871 If p is a prime such that 8*p + 9 is also a prime (A023232), then 7*p is a term.
%C A065871 If p is a prime such that 12*p + 13 is also a prime (A089443), then 11*p is a term. (End)
%H A065871 Amiram Eldar, <a href="/A065871/b065871.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from Harry J. Smith)
%t A065871 f[n_] := Block[ {a = FactorInteger[n], k = l = s = 1}, l = Length[a]; While[k <= l, s = s * (a[[k, 1]]^a[[k, 2]] + 1); k++ ]; Return[s]]; Select[ Range[200], PrimeQ[ f[ # ] + 1] & ]
%o A065871 (PARI) usigma(n)= { local(f,s=1); f=factor(n); for(i=1, matsize(f)[1], s*=1 + f[i, 1]^f[i, 2]); return(s) }
%o A065871 isok(m) = isprime(usigma(m) + 1); \\ _Harry J. Smith_, Nov 02 2009
%Y A065871 Cf. A034448 (usigma), A065872.
%Y A065871 Cf. A001359, A023209, A023214, A023222, A023232, A089443.
%K A065871 nonn,changed
%O A065871 1,2
