%T A065967 67,36,74,30,121,32,48,80,87,82,102,38,97,94,108,42,167,44,114,114,
%U A065967 117,48,136,56,135,122,134,54,153,126,148,136,147,60,242
%N A065967 a(n) = n * Sum_{primes p dividing n} (1 + 1/p).
%H A065967 Amiram Eldar, <a href="/A065967/b065967.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from Harry J. Smith)
%F A065967 From _Amiram Eldar_, Sep 07 2026: (Start)
%F A065967 a(n) = n * A001221(n) + A069359(n).
%F A065967 Dirichlet g.f.: zeta(s-1)*(primezeta(s-1) + primezeta(s)). (End)
%p A065967 A065967 := proc(n) local i,j,k,t1,t2,t3; t1 := ifactors(n)[2]; t2 := n^1*add((1+1/(t1[i][1])^1),i=1..nops(t1)); end;
%t A065967 a[n_] := n * Total[1 + 1/FactorInteger[n][[;; , 1]]]; a[1] = 0; Array[a, 65] (* _Amiram Eldar_, Sep 07 2026 *)
%o A065967 (PARI) a(n) = { my(s=0); foreach(factor(n)[,1], p, s+=(1 + 1/p)); n*s } \\ _Harry J. Smith_, Nov 05 2009
%Y A065967 Cf. A001221, A065968, A065969, A065970, A069359.
