%S A065343 14,18,85,51,6,34,10,15,14,21,18,35,36,33,26,30,72,65,34,42,30,57,231,
%T A065343 70,30,30,42,66,54,106,58,60,116,93,42,105,140,249,60,84,30,134,82,
%U A065343 114,70,174,220,140,66,105,98,147,66,178,90,105,78,298,154,291,118,90,90
%N A065343 Smallest k such that usigma(n+k) = usigma(k).
%H A065343 Amiram Eldar, <a href="/A065343/b065343.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from Harry J. Smith)
%t A065343 usigma[n_] := usigma[n] = Times @@ (1 + Power @@@ FactorInteger[n]); usigma[1] = 1;
%t A065343 a[n_] := Module[{k = 1}, While[usigma[n+k] != usigma[k], k++]; k]; Array[a, 63] (* _Amiram Eldar_, Sep 01 2026 *)
%o A065343 (PARI) usigma(n)= { local(f,s=1); f=factor(n); for(i=1, matsize(f)[1], s*=1 + f[i, 1]^f[i, 2]); return(s) }
%o A065343 a(n) = { my(k=1); while (usigma(n + k) != usigma(k), k++); k } \\ _Harry J. Smith_, Oct 16 2009
%Y A065343 Cf. A034448 (usigma), A007365.
