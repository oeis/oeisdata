%S A260795 2,3,5,8,12,17,25,36,52,73,105,148,212,297,425,596,852,1193,1705,2388,
%T A260795 3412,4777,6825,9556,13652,19113,27305,38228,54612,76457,109225,
%U A260795 152916,218452,305833,436905,611668,873812,1223337,1747625,2446676,3495252,4893353,6990505
%N A260795 Number of steps required by the Hwang-Deutsch merging algorithm.
%H A260795 Amiram Eldar, <a href="/A260795/b260795.txt">Table of n, a(n) for n = 3..57</a> (corrected by Alper Ferudun)
%H A260795 Frank K. Hwang and David N. Deutsch, <a href="https://doi.org/10.1145/321738.321749">A class of merging algorithms</a>, Journal of the ACM (JACM) 20.1 (1973): 148-159. See "R" page 157.
%o A260795 (PARI) S(m) = my(s=1, k=1); while(2^(k-1) <= m, s += 2^k*(min(m, 2^k-1) - 2^(k-1) + 1); k++); s; \\ Sum_{p=0..m} 2^ceil(log_2(p+1))
%o A260795 a(n) = my(lo=0, hi=2^n); while(lo < hi, my(m=(lo+hi+1)\2); if(S(m) <= 2^n, lo=m, hi=m-1)); lo; \\ _Alper Ferudun_, Oct 16 2026
%Y A260795 Cf. A260794, A200310, A260996, A260997.
