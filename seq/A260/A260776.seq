%S A260776 1,5,60,1001,19380,408595,9104550,210905400,5028168132,122563178210,
%T A260776 3040594338320,76520801509425,1948777701739050,50129821093933224,
%U A260776 1300611345665798320,33994757853301868560,894295618431497324900,23660280955151412585930,629143806228348421209768
%N A260776 Certain directed lattice paths.
%C A260776 See Dziemianczuk (2014) for precise definition.
%H A260776 Lars Blomberg, <a href="/A260776/b260776.txt">Table of n, a(n) for n = 0..100</a>
%H A260776 M. Dziemianczuk, <a href="https://arxiv.org/abs/1410.5747">On Directed Lattice Paths With Additional Vertical Steps</a>, arXiv preprint arXiv:1410.5747 [math.CO], 2014.
%F A260776 See Dziemianczuk (2014) Equation (36b) with N=3.
%F A260776 From _Peter Bala_, Mar 30 2020: (Start)
%F A260776 a(n) = (1/n)*C(5*n,2*n-1) for n >= 1.
%F A260776 a(n) = 2*Sum_{k = 0..n} C(3*n+k,n+3*k)*C(n+3*k,k)/(n+2*k+1). Cf. A027307(n) = Sum_{k = 0..n} C(2*n+k,n+2*k)*C(n+2*k,k)/(n+k+1) for n >= 1. (End)
%F A260776 From _Stefano Spezia_, Sep 28 2026: (Start)
%F A260776 G.f.: 2*hypergeom([1/5, 2/5, 3/5, 4/5], [1/2, 2/3, 4/3], 5^5*x/(2^2*3^3)) - 1.
%F A260776 a(n) ~ 3^(-3*n-3/2)*4^(-n)*5^(5*n+1/2)/(n^(3/2)*sqrt(Pi)). (End)
%F A260776 D-finite with recurrence 6*n*(3*n-1)*(2*n-1)*(3*n+1)*a(n) -5*(5*n-4)*(5*n-3)*(5*n-2)*(5*n-1)*a(n-1)=0. - _R. J. Mathar_, Sep 28 2026
%t A260776 a[0]:=1; a[n_]:=(1/n)*Binomial[5*n,2*n-1]; Array[a,19,0] (* _Stefano Spezia_, Sep 28 2026 *)
%t A260776 (* Alternative: *)
%t A260776 CoefficientList[Series[-1+2*HypergeometricPFQ[{1/5,2/5,3/5,4/5},{1/2,2/3,4/3},5^5*x/(2^2*3^3)],{x,0,18}],x] (* _Stefano Spezia_, Sep 28 2026 *)
%Y A260776 Cf. A027307.
%K A260776 nonn,easy,changed
%O A260776 0,2
%A A260776 _N. J. A. Sloane_, Jul 30 2015
%E A260776 More terms from _Lars Blomberg_, Aug 01 2015
