%T A260306 6319924923392,-8773495082018816,-49004477022654464,
%U A260306 1709650943378038784,480380831834367035260928,-88481173388026066736939008,-660883915180095254454665216,888962079683152174584309088256
%N A260306 Numerators in Ramanujan's asymptotic expansion of theta(n), defined by Sum_{k=0..n-1} n^k/k! + theta(n)*n^n/n! = exp(n)/2.
%C A260306 Let Sum_{k=0..n-1} n^k/k! + theta(n)*n^n/n! = exp(n)/2. Ramanujan gave initial terms of the asymptotic expansion theta(n) ~ 1/3 + (4/135)/n + (-8/2835)/n^2 + (-16/8505)/n^3 + O(1/n^4). This sequence gives the numerators in this expansion, and A065973 gives the denominators.
%C A260306 Ramanujan's asymptotic is also considered in the literature in the form 1-theta(n) (see for example formula (5) in the Choi link). The numerators that appear in that form are given in A090804 (the denominators are the same). The first term A090804(0) = 2 is different, and signs of other terms are opposite to a(n).
%C A260306 Knuth considered "Ramanujan's function" in the form Q(n) = n!*(e/n)^n/2 - theta(n) in the context of statistics of hashmap collisions and trees. - _Natalia L. Skirrow_, Sep 25 2026
%D A260306 G. E. Andrews, R. Askey and R. Roy, Special Functions, Cambridge, 1999; Problem 4, p. 616.
%D A260306 B. C. Berndt, Ramanujan's Notebooks II, Springer, 1989; p. 181, Entry 48. See also pp. 184, 193ff.
%D A260306 E. T. Copson, An Introduction to the Theory of Functions of a Complex Variable, Oxford Univ. Press, 1935; see p. 230, Problem 18.
%D A260306 S. Ramanujan, Collected Papers, edited by G. H. Hardy et al., Cambridge, 1927, pp. 323-324, Question 294.
%H A260306 G. C. Greubel and D. Turner, <a href="/A260306/b260306.txt">Table of n, a(n) for n = 0..117</a>
%H A260306 K. P. Choi, <a href="https://doi.org/10.1090/S0002-9939-1994-1195477-8">On the medians of gamma distributions and an equation of Ramanujan</a>, Proc. Amer. Math. Soc. 121(1) (May, 1994), 245-251.
%H A260306 Philippe Flajolet, Peter J. Grabner, Peter Kirschenhofer, and Helmut Prodinger, <a href="https://doi.org/10.1016/0377-0427(93)E0258-N">On Ramanujan's Q-function</a>, J. Comput. Appl. Math. 58(1) (1995), 103-116.
%H A260306 Donald E. Knuth, <a href="https://doi.org/10.1016/0196-6774(85)90037-9">An analysis of optimal caching</a>, J. Algorithms 6(2) (1985), 181-199.
%H A260306 John C. W. Marsaglia, <a href="https://doi.org/10.1080/00949658608810899">The incomplete gamma function and Ramanujan's rational approximation to exp(x)</a>, J. Statist. Comput. Simulation 24 (1986), 163-168.
%H A260306 Cormac O'Sullivan, <a href="https://arxiv.org/abs/2205.08504">Ramanujan's approximation to the exponential function and generalizations</a>, arXiv:2205.08504 [math.NT], 2022.
%H A260306 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/RamanujanSequence.html">Ramanujan Sequence</a>.
%F A260306 Let c(n) = a(n)/A065973(n) (these being the numerator and denominator, written in simplest form).
%F A260306 c(n) = 2^n * (3*n+2)! / (2*n+1)! * Sum_{i=1..2*n+1} Sum_{j=1..i} Sum_{k=1..j} (-1)^(k+1) * 2^i * k^(2*n+i+j+1) * C(2*n+1,i) * C(i,j) * C(j,k) / ((2*n+i+j+1)! * (n+i+1)), where C(n,k) = A007318(n,k) are binomial coefficients.
%F A260306 c(n) = 2^n * (3*n+2)! * Sum_{i=1..2*n+1} Sum_{j=1..i} (-1)^(j+1) * 2^i * Stirling2(2*n+i+j+1,j) / ((2*n+i+j+1)! * (2*n-i+1)! * (i-j)! * (n+i+1)).
%F A260306 From _Natalia L. Skirrow_, Sep 25 2026: (Start)
%F A260306 c(n) = -n! * [x^(2*n+1)] (x^2/(e^x-1-x))^(n+1)/2.
%F A260306 c(n) = Sum_{j=1..2*n+1} (-1)^(j-1) * A059022(2*(n+j)+1,j) * 2^(n+j) * (n+j)!/(2*(n+j)+1)!.
%F A260306 E.g.f.: Sum_{n>=0} c(n) * x^(n+1)/(n+1)! = log(sinh(f)/f), where f = f(x) satisfies x = f*coth(f) + log(sinh(f)/f) - 1.
%F A260306 |c(n)| ~ n!/(sqrt(2*n)*(2*Pi)^(n+1)).
%F A260306 c(n) ~ cos((2*n-1)*Pi/4) * (n/e)^n/(2*Pi)^(n+1/2); (sgn a(n),) = (+,+,-,-,...) has period 4.
%F A260306 theta(n) ~ Sum_{k=0..K} c(k)/n^k reaches its closest approximation when K is about 2*Pi*n.
%F A260306 (End)
%e A260306 From _Natalia L. Skirrow_, Sep 26 2026: (Start)
%e A260306 theta(n) = 1/3 + 4/(135*n) - 8/(2835*n^2) - 16/(8505*n^3) + 8992/(12629925*n^4) + 334144/(492567075*n^5) - ...
%e A260306 log(sinh(f)/f) = x/3 + (4/135)*x^2/2! - (8/2835)*x^3/3! - (16/8505)*x^4/4! + (8992/12629925)*x^5/5! + (334144/492567075)*x^6/6! - ...
%e A260306 (End)
%p A260306 h := proc(k) option remember; local j; `if`(k<=0, 1,
%p A260306 (h(k-1)/k-add((h(k-j)*h(j))/(j+1),j=1..k-1))/(1+1/(k+1))) end:
%p A260306 A260306 := n -> `if`(n=0, 1, -numer(h(2*n+1)*doublefactorial(2*n))):
%p A260306 seq(A260306(n), n=0..16); # _Peter Luschny_, Nov 20 2015
%t A260306 Numerator[Table[2^n*(3*n + 2)! * Sum[ Sum[ (-1)^(j + 1)*2^i*StirlingS2[2*n + i + j + 1, j]/((2*n + i + j + 1)!*(2*n - i + 1)!*(i - j)!*(n + i + 1)), {j, 1, i}], {i, 1, 2*n+1}], {n, 0, 20}]] (* _Vaclav Kotesovec_, Nov 20 2015 *)
%t A260306 Numerator[Table[-n!*SeriesCoefficient[(x^2/(E^x-1-x))^(n+1),{x,0,2*n+1}]/2,{n,0,20}]] (* _Natalia L. Skirrow_, Sep 25 2026 *)
%t A260306 lim=20;b=InverseSeries[Simplify[Series[x+Exp[-x]-1,{x,0,2*lim+3}],x>0],x];Table[Numerator[(n+1)!*SeriesCoefficient[b,{x,0,n+1}]],{n,0,lim}] (* _Natalia L. Skirrow_, Sep 25 2026 *)
%t A260306 lim=16;g=Normal[InverseSeries[Series[x*Coth[x]-1+Log[Sinh[x]/x],{x,0,2*lim}],x]];Numerator[Simplify[CoefficientList[Series[Log[Sinh[g]/g],{x,0,lim}],x]][[2;;]]*Range[lim]!] (* has prepended 0, is slower but uses the generating function with no additional half-integer terms; _Natalia L. Skirrow_, Sep 25 2026 *)
%o A260306 (Python)
%o A260306 from functools import cache
%o A260306 from fractions import Fraction as frac
%o A260306 from math import factorial as fact
%o A260306 b=cache(lambda n: -frac(n,n+2<<1)*b(n-1) - (~n&1 and b(n>>1)**2/2) - sum(b(k-1)*b(n+1-k) for k in range(2,(n+1)//2+1)) if n else frac(1))
%o A260306 A260306=lambda n: -(2*b(2*n+1)*fact(n+1)).numerator<<n
%o A260306 A065973=lambda n: (2*b(2*n+1)*fact(n+1)).denominator
%o A260306 print([A260306(n) for n in range(12)]) # _Natalia L. Skirrow_, Sep 25 2026
%o A260306 (Python) # Alternative (faster for isolated terms, slower for blocks of terms):
%o A260306 from functools import cache
%o A260306 from fractions import Fraction as frac
%o A260306 from math import comb,perm
%o A260306 subset_o=cache(lambda n,k,o=1: int(n>=o*k and k*subset_o(n-1,k,o) + comb(n-1,o-1)*subset_o(n-o,k-1,o) if k else n==0)) #o-associated (or o-th order) Stirling numbers of the second kind
%o A260306 A059022=lambda n,k: subset_o(n,k,3)
%o A260306 coeff=lambda n: frac(A059022(2*n+1,1),c:=perm(2*n+1,n+1)>>n)+sum(frac(A059022(2*(n+j)-1,j),c:=c*(1-2*(n+j))) for j in range(2,2*n))
%o A260306 A260306=lambda n: coeff(n+1).numerator
%o A260306 print([A260306(n) for n in range(21)]) # _Natalia L. Skirrow_, Sep 25 2026
%Y A260306 Cf. A065973 (denominators), A059022, A090804, A264148, A005447, A005446.
%K A260306 sign,frac,changed
%O A260306 0,2
%A A260306 _Vladimir Reshetnikov_, Nov 10 2015
%E A260306 More terms from _Vaclav Kotesovec_, Nov 20 2015
