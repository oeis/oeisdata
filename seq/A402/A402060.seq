%I A402060 #13 Nov 16 2026 04:28:05
%S A402060 1,2,3,5,6,7,8,10,11,13,14,15,17,19,21,22,23,24,26,27,29,30,31,32,33,
%T A402060 34,35,37,38,39,40,41,42,43,46,47,51,53,54,55,56,57,58,59,61,62,65,66,
%U A402060 67,69,70,71,73,74,77,78,79,82,83,85,86,87,88,89,91,93,94,95
%N A402060 Numbers k such that gcd(d_4(k^4), 6) = 1, where d_4 = A007426 is the 4th Piltz function.
%C A402060 First differs from A268335 at n = 184: a(184) = 256 = 2^8 is not a term in A268335. Also, A268335(1444) = 2048 is the least term in A268335 that is not a term in this sequence.
%C A402060 First differs from A382061 at n = 53: A382061(53) = 72 is not a term in this sequence. Also, a(184) = 256 is the least term in this sequence that is not a term in A382061.
%C A402060 Numbers k such that d_3(k^4) is a 5-rough number (A007310).
%C A402060 Numbers whose prime factorization exponents are all non-congruent to 2, 4, or 6 (mod 9).
%C A402060 The asymptotic density of this sequence is zeta(9) * Product_{p prime} (1 - 1/p^2 + 1/p^3 - 1/p^4 + 1/p^5 - 1/p^6 + 1/p^7 - 1/p^9) = 0.70645866822615644919... .
%C A402060 Differs from A002035: 256 is a term in this but not in A002035, for example. - _R. J. Mathar_, Nov 16 2026
%H A402060 Amiram Eldar, <a href="/A402060/b402060.txt">Table of n, a(n) for n = 1..10000</a>
%H A402060 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%F A402060 a(n) = A402059(n)^(1/4).
%e A402060 2 is a term since A007426(2^4) = 35, and gcd(35, 6) = 1.
%t A402060 f[p_, e_] := (4*e + 1)*(4*e + 2)*(4*e + 3)/6; d44[n_] := Times @@ f @@@ FactorInteger[n]; d44[1] = 1; q[k_] := CoprimeQ[d44[k], 6]; Select[Range[95], q]
%o A402060 (PARI) isok(k) = #select(e -> (e % 9 != 2 && e % 9 != 4 && e % 9 != 6) == 0, factor(k)[, 2]) == 0;
%Y A402060 Cf. A007310, A007426, A268335, A352475, A382061, A402059.
%K A402060 nonn,easy,new
%O A402060 1,2
%A A402060 _Amiram Eldar_, Nov 12 2026
