%T A402330 66946288698233,5958219694142737,577947310331845489,
%U A402330 59528572964180085367,6726728744952349646471,854294550608948405101817,117038353433425931498948929,17672791368447315656341288279
%N A402330 Product of the first n primes p for which p mod 8 equals 1 or 7 (A001132).
%C A402330 Equals the smallest number s for which there exist 2^(n-1) (a record number of) distinct primitive Pythagorean triangles which share the same sum s of their leg lengths.
%e A402330 a(3) = 2737 = 7 * 17 * 23 = the sum of the leg lengths of record 2^(3-1) = 4 distinct primitive Pythagorean triangles: 73,2664,2665, 564,2173,2245, 1032,1705,1993, and 1312,1425,1937.
%o A402330 (PARI) a(n)={my(s=1); forprime(p=2, oo, if(!n, break); if(abs((p%8)-4)!=3, next); s*=p; n--); s}
%Y A402330 Cf. A001132.
%K A402330 nonn,new
%O A402330 1,1
%A A402330 _Charles L. Hohn_, Nov 17 2026
