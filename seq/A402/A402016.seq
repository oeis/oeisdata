%T A402016 4,2,3,0,4,8,4,9,7,5,4,6,5,3,2,3,0,9,6,1,3,1,0,0,1,4,8,7,0,9,6,7,3,0,
%U A402016 6,1,7,3,7,8,7,4,4,0,3,9,0,5,2,3,3,2,5,3
%N A402016 Decimal expansion of L'(1,chi_8)/L(1,chi_8), where chi_8 is the Dirichlet character kronecker(8,.).
%F A402016 Equals A402011 - (1/(2*log(1+sqrt(2)))) * (zeta''(0,1/8) - zeta''(0,3/8) - zeta''(0,5/8) + zeta''(0,7/8)), where zeta''(s,x) is the second partial derivative of the Hurwitz zeta function with respect to s.
%e A402016 L'(1,chi_8)/L(1,chi_8) = 0.63211496603984832603...
%o A402016 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402016 f(8)
%o A402016 (PARI) f(D) = my([h, loge] = vecextract(quadclassunit(D), [1,4])); log(2*Pi) + Euler() - (1/(2*h*loge)) * sum(a=1, D, kronecker(D,a)*zetahurwitz(0, a/D, 2)); \\ D > 0 is a fundamental discriminant
%o A402016 f(8)
%Y A402016 Cf. A091337 (chi_8). See A402011 for related sequences.
%K A402016 nonn,cons,new
%O A402016 0,1
