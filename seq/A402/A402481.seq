%N A402481 G.f.: Sum_{k>=1} x^(k*(k+1)) * Product_{j=1..2*k} (1 + x^j).
%H A402481 Vaclav Kotesovec, <a href="/A402481/b402481.txt">Table of n, a(n) for n = 0..10000</a>
%F A402481 G.f.: Sum_{k>=1} Product_{j=1..k} x^(2*j)*(1 + x^(2*j))*(1 + x^(2*j-1)).
%F A402481 a(n) ~ c * A376621^sqrt(n) / sqrt(n), where c = 0.228374141466973767368... is the positive real root of the equation -1 - 24*c^2 + 15872*c^6 = 0.
%t A402481 nmax = 100; CoefficientList[Series[Sum[x^(k*(k+1))*Product[1+x^j, {j, 1, 2*k}], {k, 1, Sqrt[nmax]}], {x, 0, nmax}], x]
