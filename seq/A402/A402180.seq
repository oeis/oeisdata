%S A402180 0,0,0,0,0,2,0,0,0,2,0,4,0,2,2,0,0,4,0,4,2,2,0,7,0,2,0,4,0,12,0,0,2,2,
%T A402180 2,6,0,2,2,7,0,12,0,4,4,2,0,11,0,4,2,4,0,7,2,7,2,2,0,23,0,2,4,0,2,12,
%U A402180 0,4,2,12,0,9,0,2,4,4,2,12,0,11,0,2,0,23
%N A402180 a(n) = binomial(bigomega(n) + omega(n), omega(n)) - tau(n), where bigomega = A001222, omega = A001221, and tau = A000005.
%H A402180 Michael De Vlieger, <a href="/A402180/b402180.txt">Table of n, a(n) for n = 1..10000</a>
%F A402180 a(n) = 0 for n that are powers of primes (n in A000961).
%F A402180 a(n) = 2 for squarefree semiprime n (in A006881).
%F A402180 a(n) = 2*A108958(A001221(n)) for squarefree n (in A005117), since for such n, a(n) = binomial(2*m, m) - 2^m, with m = omega(n).
%e A402180 Table of n, a(n) for select n:
%e A402180     n                  a(n)
%e A402180   -------------------------
%e A402180     1 = 1                0
%e A402180     2 = 2                0
%e A402180     3 = 3                0
%e A402180     4 = 2^2              0
%e A402180     6 = 2 * 3            2
%e A402180    12 = 2^2 * 3          4
%e A402180    20 = 2^2 * 5          4
%e A402180    24 = 2^3 * 3          7
%e A402180    30 = 2 * 3 * 5       12
%e A402180    60 = 2^2 * 3 * 5     23
%e A402180   120 = 2^3 * 3 * 5     40
%e A402180   210 = 2 * 3 * 5 * 7   54
%t A402180 f[x_] := Binomial[PrimeOmega[x] + PrimeNu[x], PrimeNu[x] ] - DivisorSigma[0, x]; Array[f, 120]
%o A402180 (PARI) a(n) = my(f=factor(n)); binomial(bigomega(f) + omega(f), omega(f)) - numdiv(f); \\ _Michel Marcus_, Nov 16 2026
%Y A402180 Cf. A000005, A000961, A001221, A001222, A000961, A006881, A108958, A376567.
