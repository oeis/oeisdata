%S A402139 1,3,6,7,13,14,15,26,27,29,30,31,52,53,54,55,58,59,61,62,63,105,106,
%T A402139 107,108,109,110,111,116,117,118,119,122,123,125,126,127,210,211,212,
%U A402139 213,214,215,217,218,219,220,221,222,223,233,234,235,236,237,238,239
%N A402139 Numbers k such that the k-th composition in standard order is a 1-based restricted growth sequence.
%C A402139 The k-th composition in standard order (graded reverse-lexicographic, A066099) is obtained by taking the set of positions of 1's in the reversed binary expansion of k, prepending 0, taking first differences, and reversing again. This gives a bijective correspondence between nonnegative integers and integer compositions.
%C A402139 A 1-based restricted growth sequence of length j is a sequence (a_1, ..., a_j), satisfying a_1 = 1 and a_i <= 1 + max(a_1, ..., a_{i-1}) for all i = 2, 3, ..., j.
%e A402139 The terms together with their standard composition begin:
%e A402139    1: (1)
%e A402139    3: (1,1)
%e A402139    6: (1,2)
%e A402139    7: (1,1,1)
%e A402139   13: (1,2,1)
%e A402139   14: (1,1,2)
%e A402139   15: (1,1,1,1)
%e A402139   26: (1,2,2)
%e A402139   27: (1,2,1,1)
%e A402139   29: (1,1,2,1)
%e A402139   30: (1,1,1,2)
%e A402139   31: (1,1,1,1,1)
%e A402139   52: (1,2,3)
%e A402139   53: (1,2,2,1)
%e A402139   54: (1,2,1,2)
%e A402139   55: (1,2,1,1,1)
%e A402139   58: (1,1,2,2)
%e A402139   59: (1,1,2,1,1)
%e A402139   61: (1,1,1,2,1)
%e A402139   62: (1,1,1,1,2)
%t A402139 stc[n_]:=Differences[Prepend[Join @@ Position[Reverse[IntegerDigits[n,2]],1],0]]//Reverse;
%t A402139 rgoQ[y_]:=y[[1]]==1&&And@@Table[y[[i]] <= 1+Max@@Take[y,i-1],{i,2,Length[y]}];
%t A402139 Select[Range[100],rgoQ[stc[#]]&]
%Y A402139 These compositions are counted by A383253, triangle A383713, complement A402142.
%Y A402139 The complement is A402141, counted by A402138.
%Y A402139 The normal complement is A402140, ranks A402143.
%Y A402139 For reversed partitions instead of compositions we have A055932, counted by A047967.
%Y A402139 A011782 counts compositions, strict A032020.
%Y A402139 A066099 lists compositions in standard order.
%Y A402139 A107429 counts normal compositions, ranked by A333217.
