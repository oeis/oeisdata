%U A402260 23111359446144323,591959575838403089,16012918452764501736,456186454925804357973,13652349254555570844485
%N A402260 a(n) = 1 + Sum_{k=1..n} binomial(n+k,k) * a(n-k).
%F A402260 G.f. A(x) satisfies A(x) = (1-2*x) * (2*A(z) - 1/(1-z)), where z = x*(1-x).
%o A402260 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(i+j, j)*v[i-j+1])); v;
