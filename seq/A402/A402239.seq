%S A402239 1,2,2,2,2,4,2,2,2,4,2,4,2,4,4,2,2,4,2,4,4,4,2,4,2,4,2,4,2,8,2,2,4,4,
%T A402239 4,4,2,4,4,4,2,8,2,4,4,4,2,4,2,4,4,4,2,4,4,4,4,4,2,8,2,4,4,3,4,8,2,4,
%U A402239 4,8,2,4,2,4,4,4,4,8,2,4,2,4,2,8,4,4,4,4
%N A402239 Number of divisors d of n such that gcd(d, n/d) is a cube.
%C A402239 First differs from A034444 at n = 64.
%C A402239 First differs from A365491 at n = 32.
%H A402239 Amiram Eldar, <a href="/A402239/b402239.txt">Table of n, a(n) for n = 1..10000</a>
%F A402239 Multiplicative with a(p^e) = A099480(e).
%F A402239 Dirichlet g.f.: zeta(s)^2 * zeta(6*s) / zeta(2*s).
%F A402239 Sum_{k=1..n} a(k) ~ (zeta(6)/zeta(2)) * n * (log(n) + 2*gamma - 1 + 6*zeta'(6)/zeta(6) - 2*zeta'(2)/zeta(2)), where gamma is Euler's constant (A001620).
%t A402239 A099480[n_] := A099480[n] = If[Divisible[n, 6], n/3 + 1, 2*(Floor[n/6] + 1)];
%t A402239 f[p_, e_] := A099480[e]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 88]
%o A402239 (PARI) a(n) = vecprod(apply(e -> if(e % 6, 2*((e\6) + 1), e/3 + 1), factor(n)[, 2]));
%Y A402239 Cf. A099480, A365491.
%Y A402239 Cf. A001620, A013661, A013664, A306016.
%Y A402239 Number of divisors d of n such that gcd(d, n/d) is: A034444 (1), A069733 (odd), A365171 (square), A365173 (exponentially odd), A365207 (power of 2), A365208 (3-smooth), A365210 (5-rough), A369310 (powerful), A400450 (prime), A400452 (prime power), this sequence (cube).
%K A402239 nonn,mult,easy,new
%O A402239 1,2
%A A402239 _Amiram Eldar_, Nov 16 2026
