%I A402190 #15 Nov 23 2026 16:52:48
%S A402190 504,840,1320,1560,4080,5016,7440,10920,11856,13800,18480,19320,23760,
%T A402190 25200,29400,30600,31920,32736,62160,63960,66120,68640,85560,97440,
%U A402190 98040,100464,112200,120120,123240,132840,143640,147600,159840,175560,184440,190920,214320,218400,225120,254880,262080
%N A402190 Differences of squares of primes that are areas of right triangles with coprime integer sides.
%H A402190 Robert Israel, <a href="/A402190/b402190.txt">Table of n, a(n) for n = 1..10000</a>
%e A402190 a(3) = 1320 is a term because 1320 is the area of the primitive Pythagorean triangle with sides (48, 55, 73), and 1320 = 37^2 - 7^2 where 37 and 7 are prime.
%p A402190 N:= 10^6: # for terms <= N
%p A402190 S:= {}:
%p A402190 for v from 1 while (v+1)*v*(2*v+1) <= N do
%p A402190   for u from v+1 by 2 do
%p A402190     a:= u*v*(u^2-v^2);
%p A402190     if a > N then break fi;
%p A402190   if igcd(u,v) > 1 then next fi;
%p A402190     if ormap(d -> d^2 > a and (d-a/d)::even and isprime((d + a/d)/2) and isprime((d - a/d)/2), NumberTheory:-Divisors(a))
%p A402190  then S:= S union {a} fi;
%p A402190 od od:
%p A402190 sort(convert(S,list));
%Y A402190 Intersection of A024365 and A124865.
%K A402190 nonn,new
%O A402190 1,1
%A A402190 _Will Gosnell_ and _Robert Israel_, Nov 14 2026
