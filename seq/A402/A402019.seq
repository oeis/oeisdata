%T A402019 3,8,0,9,2,6,3,4,1,0,9,1,5,0,4,2,1,2,7,8,8,0,0,7,0,2,5,8,0,7,9,7,4,0,
%U A402019 6,3,9,0,5,0,0,8,3,1,5,2,9,8,0,3,3,5,6,1
%N A402019 Decimal expansion of L'(1,chi_12)/L(1,chi_12), where chi_12 is the Dirichlet character kronecker(12,.).
%F A402019 Equals A402011 - (1/(2*log(2+sqrt(3)))) * (zeta''(0,1/12) - zeta''(0,5/12) - zeta''(0,7/12) + zeta''(0,11/12)), where zeta''(s,x) is the second partial derivative of the Hurwitz zeta function with respect to s.
%e A402019 L'(1,chi_12)/L(1,chi_12) = 0.47674994334694971942...
%o A402019 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402019 f(12)
%o A402019 (PARI) f(D) = my([h, loge] = vecextract(quadclassunit(D), [1,4])); log(2*Pi) + Euler() - (1/(2*h*loge)) * sum(a=1, D, kronecker(D,a)*zetahurwitz(0, a/D, 2)); \\ D > 0 is a fundamental discriminant
%o A402019 f(12)
%Y A402019 Cf. A110161 (chi_12). See A402011 for related sequences.
%K A402019 nonn,cons,new
%O A402019 0,1
%A A402019 _Jianing Song_, Nov 11 2026
