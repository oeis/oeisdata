%T A402675 243,256,289,324,343,361,400,441,484,512,529,625,676,729,784,841,900,
%U A402675 961,1000,1024,1089,1156,1225,1296,1331,1369,1444,1521,1681,1728,1764,1849,1936
%N A402675 Perfect powers of the form m^k where m is a cubefree number and k >= 2.
%C A402675 Subsequence of A001597 and first differs from it at n = 33: A001597(33) = 576 is not a term in this sequence.
%C A402675 Numbers of the form s^k * t^(2*k) where s and t are coprime squarefree numbers and k >= 2.
%H A402675 Amiram Eldar, <a href="/A402675/b402675.txt">Table of n, a(n) for n = 1..10000</a>
%H A402675 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%H A402675 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402675 Sum_{n>=1} 1/a(n) = 1 + Sum_{k>=2} (zeta(k)/zeta(3*k) - zeta(2*k)/zeta(4*k)) = 1.86884216499995816397... .
%t A402675 q[k_] := k == 1 || Module[{e = FactorInteger[k][[;; , 2]], g}, g = GCD @@ e; g > 1 && AllTrue[e/g, # < 3 &]]; Select[Range[2000], q]
%o A402675 (PARI) isok(k) = if(k == 1, 1, my(e = factor(k)[, 2], g = gcd(e)); g > 1 && #select(x -> (x>2), apply(x -> x/g, e)) == 0);
