%N A402279 Triangle read by rows: T(n,k) is the number of ways to hang out n pairs of socks on a washing line with exactly k pairs matching (the two socks of the same pair are side by side).
%H A402279 Philippe Gibone, <a href="/A402279/b402279.txt">Table of n, a(n) for n = 0..1034</a> (rows 0..44)
%F A402279 T(n, k) = (2 * n - k)* T(n-1, k-1) + binomial(2 * n - 1 - k; 2) * T(n-1, k) + k * T(n-1, k) + (k + 1) * (2 * (n-1) - k) * T(n-1, k+1) + binomial(k + 2; 2) * T(n-1, k+2).
%F A402279 T(n, k) = binomial(n, k) * Sum_{i = k..n} (-1)^(i-k) * binomial(n-k, i-k) * (2*n-i)!/2^(n-i).
%F A402279 T(n, k) = 2^(k-n)*binomial(n,k)*(2*n - k)!*hypergeom([k-n], [k-2*n], -2). - _Stefano Spezia_, Nov 23 2026
%e A402279 Triangle T(n, k) begins:
%e A402279         1;
%e A402279         0,       1;
%e A402279         2,       2,       2;
%e A402279        30,      36,      18,      6;
%e A402279       864,     984,     504,    144,    24;
%e A402279     39480,   43800,   22200,   6600,  1200,   120;
%e A402279   2631600, 2868480, 1447200, 439200, 86400, 10800, 720;
%e A402279  ...
%e A402279 T(0, 0) = 1, There is only one way to hang no socks (no pair is matched).
%e A402279 T(1, 0) = 0, It is impossible to hang a single pair of socks without it being matched.
%e A402279 T(1, 1) = 1, There is only one way to hang a single pair of socks, and it is matched.
%e A402279 T(2, 1) = 2 : xyyx, yxxy.
%e A402279 T(3, 3) = 6 : xxyyzz, xxzzyy, yyxxzz, yyzzxx, zzxxyy, zzyyxx.
%e A402279 T(3, 2) = 18 : xxyzzy, xxzyyz, xzzxyy, xyyxzz,xzzyyx, xyyzzx.
%e A402279 (Only the solutions starting with x are shown)
%t A402279 T[n_,k_]:=2^(k-n)*Binomial[n,k](2*n-k)!*Hypergeometric1F1[k-n, k-2*n, -2]; Table[T[n,k],{n,0,8},{k,0,n}]//Flatten (* _Stefano Spezia_, Nov 23 2026 *)
%o A402279 (PARI) T(n,k) = binomial(n, k) * sum(i = k, n, (-1)^(i-k) * binomial(n-k, i-k) * (2*n-i)!/2^(n-i)) \\ _Andrew Howroyd_, Nov 21 2026
