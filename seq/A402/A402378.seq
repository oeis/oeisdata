%S A402378 1,1,1,0,4,0,36,0,576,14400,259200,518400,12700800,25401600,812851200,
%T A402378 21946982400,548674560000,2194698240000,66389621760000,
%U A402378 265558487040000,9560105533440000,323131567030272000,10555631189655552000,63333787137933312000
%N A402378 Number of permutations of {1..n} such that all primes are in nonprime positions.
%C A402378 This sequence represents the total number of ways to arrange the elements of the set {1, 2, ..., n} such that every prime number is placed at an index which is nonprime (a composite number or 1).
%C A402378 For n = 0 and n = 1, there are no primes in {1..n}, so the empty permutation and (1) trivially satisfy the condition, giving a(0) = a(1) = 1.
%C A402378 a(n) = 0 for n in {3, 5, 7} because there are more primes than nonprime positions (pi(n) > n - pi(n)). For n in {2, 4, 6} and all n >= 8, n >= 2*pi(n) and thus a(n) > 0.
%C A402378 Formula explanation: Let p = pi(n) and c = n - p. For c >= p (i.e., n >= 2*p), choose p places out of the c nonprime positions and arrange the p primes in them in binomial(c, p) * p! = c! / (c - p)! ways. The remaining c nonprimes can then be arranged in the remaining c positions in c! ways, giving a(n) = (c!)^2 / (c - p)!.
%C A402378 For n in {0, 1, 2, 4, 6, 8}, a(n) = A401790(n).
%H A402378 Mykola Filipchuk, <a href="/A402378/b402378.txt">Table of n, a(n) for n = 0..453</a>
%F A402378 a(n) = ((n - pi(n))!)^2 / (n - 2*pi(n))! for n >= 2*pi(n), and 0 otherwise, where pi = A000720.
%e A402378 For n = 2, a(2) = 1: the only valid permutation is (2, 1), where the prime 2 is at the nonprime position 1.
%e A402378 For n = 4, a(4) = 4: the primes {2, 3} must be placed in the nonprime positions {1, 4}, while the nonprimes {1, 4} occupy the prime positions {2, 3}. The 4 valid permutations are: (2, 1, 4, 3), (2, 4, 1, 3), (3, 1, 4, 2), (3, 4, 1, 2).
%p A402378 a:= n-> (p-> `if`(n<2*p, 0, ((n-p)!)^2/(n-2*p)!))(numtheory[pi](n)):
%p A402378 seq(a(n), n=0..23);
%t A402378 A402378[n_] := If[n < 2*#, 0, (n - #)!^2/(n - 2*#)!] & [PrimePi[n]];
%t A402378 Array[A402378, 25, 0] (* _Paolo Xausa_, Nov 24 2026 *)
%o A402378 (Python)
%o A402378 import math
%o A402378 from sympy import primepi
%o A402378 def a(n):
%o A402378     p = primepi(n)
%o A402378     if n < 2 * p:
%o A402378         return 0
%o A402378     return (math.factorial(n - p) ** 2) // math.factorial(n - 2 * p)
%o A402378 print([a(n) for n in range(24)])
%o A402378 (PARI)
%o A402378 a(n) = my(p=primepi(n)); if(n < 2*p, 0, ((n-p)!)^2 / (n-2*p)!);
%o A402378 vector(24, n, a(n-1))
