%S A402601 1,2,2,3,2,4,2,5,6,7,2,8,2,9,10,11,2,12,2,13,14,15,2,16,17,18,19,20,2,
%T A402601 21,2,22,23,24,25,26,2,27,28,29,2,30,2,31,32,33,2,34,35,36,37,38,2,39,
%U A402601 28,40,41,42,2,43,2,44,45,46,47,48,2,49,50,51,2,52,2,53,54,55,47,56,2,57,58,59,2,60,41,61,62,63,2,64,37,65,66,67,68,69,2,70,71,72,2,73,2,74,75
%N A402601 Lexicographically earliest infinite sequence such that a(i) = a(j) => A001065(i) = A001065(j), A306927(i) = A306927(j), and A046523(i) = A046523(j), for all i, j >= 1, where A001065(n) is sigma(n)-n, A306927(n) is A001615(n)-n, and A046523(n) is the smallest number with same prime signature as n.
%C A402601 Restricted growth sequence transform of the ordered triple [A001065(n), A306927(n), A046523(n)].
%C A402601 For all i, j >= 1:
%C A402601   A305800(i) = A305800(j) => a(i) = a(j),
%C A402601   a(i) = a(j) => A300235(i) = A300235(j),
%C A402601   a(i) = a(j) => A402602(i) = A402602(j),
%C A402601   a(i) = a(j) => A402379(i) = A402379(j).
%H A402601 Antti Karttunen, <a href="/A402601/b402601.txt">Table of n, a(n) for n = 1..100000</a>
%o A402601 (PARI)
%o A402601 up_to = 100000;
%o A402601 rgs_transform(invec) = { my(om = Map(), outvec = vector(length(invec)), u=1); for(i=1, length(invec), if(mapisdefined(om,invec[i]), my(pp = mapget(om, invec[i])); outvec[i] = outvec[pp] , mapput(om,invec[i],i); outvec[i] = u; u++ )); outvec; };
%o A402601 A001065(n) = (sigma(n)-n);
%o A402601 A306927(n) = n*(sumdivmult(n, d, issquarefree(d)/d) - 1);
%o A402601 A046523(n) = { my(f=vecsort(factor(n)[, 2], , 4), p); prod(i=1, #f, (p=nextprime(p+1))^f[i]); };
%o A402601 Aux402601(n) = [A001065(n), A306927(n), A046523(n)];
%o A402601 v402601 = rgs_transform(vector(up_to,n,Aux402601(n)));
%o A402601 A402601(n) = v402601[n];
%Y A402601 Cf. A000203, A001065, A001615, A046523, A306927.
%Y A402601 Cf. A305800, A402379.
%Y A402601 Differs first from A401722 at n=104, where a(104)=74, A300235 at n=153 where a(153)=110, from A300249, A351260 and A402601 at n=105, where a(105) = 75, from A305895, A327931, A353560, A373379 at n=182, where a(182)=124, from A402600 at n=2891, where a(2891) = 2119.
