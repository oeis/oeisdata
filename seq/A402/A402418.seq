%U A402418 23,1,2,1,5,1,2,1,3,5,11,1,2,1,7,11,17,1,3,1,3,5,7
%N A402418 Irregular triangle read by rows: Row n lists the minimal elements of cosets of (Z/nZ)*^2 in (Z/nZ)*, where (Z/nZ)* is the multiplicative group of integers modulo n and (Z/nZ)*^2 is the subgroup of squares.
%C A402418 Row n has length A060594(n).
%C A402418 If n = p^e*s for p odd prime, e >= 2, and gcd(p,s) = 1, since squares modulo n and squares modulo p*s are the same, row n is identical with row p*s. Similarly, if n = 2^e*s for e >= 4 and odd s, then row n is identical with row 8*s.
%H A402418 Jianing Song, <a href="/A402418/b402418.txt">Table of n, a(n) for n = 1..10008</a> (rows n = 1..1932)
%e A402418 Table begins
%e A402418   0
%e A402418   1
%e A402418   1, 2
%e A402418   1, 3
%e A402418   1, 2
%e A402418   1, 5
%e A402418   1, 3
%e A402418   1, 3, 5, 7
%e A402418   1, 2
%e A402418   1, 3
%e A402418   1, 2
%e A402418   1, 5, 7, 11
%e A402418   1, 2
%e A402418   1, 3
%e A402418   1, 2, 7, 11
%e A402418   1, 3, 5, 7
%e A402418 List of (Z/nZ)*/(Z/nZ)*^2 for n = 1..16:
%e A402418   {{0}}
%e A402418   {{1}}
%e A402418   {{1}, {2}}
%e A402418   {{1}, {3}}
%e A402418   {{1, 4}, {2, 3}}
%e A402418   {{1}, {5}}
%e A402418   {{1, 2, 4}, {3, 5, 6}}
%e A402418   {{1}, {3}, {5}, {7}}
%e A402418   {{1, 4, 7}, {2, 5, 8}}
%e A402418   {{1, 9}, {3, 7}}
%e A402418   {{1, 3, 4, 5, 9}, {2, 6, 7, 8, 10}}
%e A402418   {{1}, {5}, {7}, {11}}
%e A402418   {{1, 3, 4, 9, 10, 12}, {2, 5, 6, 7, 8, 11}}
%e A402418   {{1, 9, 11}, {3, 5, 13}}
%e A402418   {{1, 4}, {2, 8}, {7, 13}, {11, 14}}
%e A402418   {{1, 9}, {3, 11}, {5, 13}, {7, 15}}
%o A402418 (PARI) A402418_row(n) = {
%o A402418 my(m = 2^#znstar(n)[3], list_rep = [], num_rep = 0, new_rep); \\ m is the number of square roots of 1
%o A402418 for(d=0, n-1,
%o A402418     if(gcd(d,n)==1,
%o A402418         new_rep = 1;
%o A402418         for(j=1, num_rep, if(issquare(Mod(d,n)/Mod(list_rep[j],n))==1, new_rep = 0; break())); \\ d has a smaller representative
%o A402418         if(new_rep, list_rep = concat(list_rep, d); num_rep++);
%o A402418     );
%o A402418     if(num_rep == m, return(list_rep));
%o A402418 );
%o A402418 }
%Y A402418 Cf. A060594, A402416.
%K A402418 nonn,tabf,new
