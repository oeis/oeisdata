%F A402544 Equals -53*zeta(4)/8 + (7*log(2) + 1)*zeta(3) + 2*(1 - log(2)^2)*zeta(2) + log(2)^4/3 - 8*log(2) + 8*Li_4(1/2).
%e A402544 0.244923108148351808729587937602657476386883031074824...
%t A402544 RealDigits[-53*Zeta[4]/8 + (7*Log[2]+1)*Zeta[3] + 2*(1 - Log[2]^2)*Zeta[2] + Log[2]^4/3 - 8*Log[2] + 8*PolyLog[4, 1/2], 10, 105][[1]]
%o A402544 (PARI) -53*zeta(4)/8 + (7*log(2) + 1)*zeta(3) + 2*(1 - log(2)^2)*zeta(2) + log(2)^4/3 - 8*log(2) + 8*polylog(4, 1/2)
