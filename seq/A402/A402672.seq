%I A402672 #7 Nov 24 2026 09:31:39
%S A402672 1,4,8,9,16,25,27,32,36,49,64,81,100,121,125,128,169,196,216,225,243,
%T A402672 256,289,343,361,441,484,512,529,576,625,676,729,841,900,961,1000,
%U A402672 1024,1089,1156,1225,1296,1331,1369,1444,1521,1600,1681,1764,1849,2048,2116,2187
%N A402672 Perfect powers of the form m^k, where m is an exponentially odd number and k >= 2.
%C A402672 First differs from its subsequence A076292 at n = 30: a(30) = 576 = 2^6 * 3^2 is not a term in A076292.
%H A402672 Amiram Eldar, <a href="/A402672/b402672.txt">Table of n, a(n) for n = 1..10000</a>
%H A402672 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%H A402672 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402672 Sum_{n>=1} 1/a(n) = 1 + Sum_{k>=1} f(2^k) - Sum_{k>=1} mu(2*k+1)*f(2*k+1) = 1.85289146022474775556..., where f(s) = Sum_{n>=2} 1/A268335(n)^s = zeta(2*s) * Product_{p prime} (1 + 1/p^s - 1/p^(2*s)) - 1, and mu is the Moebius function (A008683).
%t A402672 q[k_] := k == 1 || Module[{e = FactorInteger[k][[;; , 2]], g}, g = GCD @@ e; g > 1 && AllTrue[e/g, OddQ]]; Select[Range[2200], q]
%o A402672 (PARI) isok(k) = if(k == 1, 1, my(e = factor(k)[, 2], g = gcd(e)); g > 1 && #select(x -> !(x % 2), apply(x -> x/g, e)) == 0);
%Y A402672 Subsequence of A001597.
%Y A402672 Subsequences: A072777, A076292, A374458.
%Y A402672 Cf. A008683, A268335.
%K A402672 nonn,easy,new
%O A402672 1,2
