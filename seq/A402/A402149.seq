%S A402149 0,0,0,1,0,1,0,5,3,1,0,9,0,1,4,23,0,22,0,14,5,1,0,56,10,1,75,20,0,40,
%T A402149 0,119,6,1,15,165,0,1,7,110,0,65,0,27,165,1,0,355,35,95,8,35,0,582,21,
%U A402149 190,9,1,0,375,0,1,315,719,28,98,0,44,10,175,0,1236
%N A402149 Number of non-1-based restricted growth permutations of row n of A305936 (a multiset whose multiplicities are the prime indices of n).
%C A402149 This described multiset (row n of A305936, Heinz number A181821) is generally not the same as the multiset of prime indices of n (A112798). For example, the prime indices of 12 are {1,1,2}, while a multiset whose multiplicities are {1,1,2} is {1,1,2,3}.
%C A402149 A prime index of n is a number m such that prime(m) divides n. The multiset of prime indices of n is row n of A112798, sum A056239.
%C A402149 A 1-based restricted growth sequence of length j is a sequence (a_1, ..., a_j), satisfying a_1 = 1 and a_i <= 1 + max(a_1, ..., a_{i-1}) for all i = 2, 3, ..., j. We also include the empty sequence.
%F A402149 a(n) = A402147(A181821(n)).
%e A402149 The a(12) = 9 permutations are: (1,1,3,2), (1,3,1,2), (1,3,2,1), (2,1,1,3), (2,1,3,1), (2,3,1,1), (3,1,1,2), (3,1,2,1), (3,2,1,1).
%t A402149 nrmptn[n_]:=Join@@MapIndexed[Table[#2[[1]],{#1}]&,If[n==1,{},Flatten[Cases[FactorInteger[n]//Reverse,{p_,k_}:>Table[PrimePi[p],{k}]]]]];
%t A402149 rgoQ[y_]:=y=={}||y[[1]]==1&&And@@Table[y[[i]]<=1+Max@@Take[y,i-1],{i,2,Length[y]}];
%t A402149 Table[Length[Select[Permutations[nrmptn[n]],!rgoQ[#]&]],{n,100}]
%Y A402149 Positions of positive terms are A002808.
%Y A402149 Positions of 0 are A008578.
%Y A402149 Positions of 1 are A100484.
%Y A402149 Without restricted growth we have A318762.
%Y A402149 For normal sequences see A402144, complement A000110.
%Y A402149 For permutations of prime indices we have A402147, complement A402146.
%Y A402149 The complement is counted by A402150.
%Y A402149 A008480 counts permutations of prime indices.
%Y A402149 A383253 counts 1-based restricted growth compositions, ranks A402139, triangle A383713.
%Y A402149 A402138 counts non-restricted growth compositions, ranks A402141, triangle A402142.
%Y A402149 A402140 counts covering compositions without restricted growth, ranks A402143.
%Y A402149 Cf. A001221, A001222, A005651, A055932, A080259, A181821, A304464, A305936, A318283, A318360, A401975, A402151, A402152.
