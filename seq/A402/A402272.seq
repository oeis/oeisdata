%I A402272 #7 Nov 16 2026 12:48:25
%S A402272 0,2,4,6,1,10,12,14,16,18,20,22,1,26,28,30,32,34,36,38,40,42,19,46,1,
%T A402272 50,52,54,56,58,60,55,64,66,68,70,72,26,76,78,1,82,84,86,88,90,92,94,
%U A402272 96,10,100,102,104,106,108,110,112,114,64,118,1,122,124,126,128
%N A402272 a(n) is the label of the Dirichlet character Jacobi(.,2*n+1) modulo 2*n+1 in the Conrey labeling system.
%H A402272 Jianing Song, <a href="/A402272/b402272.txt">Table of n, a(n) for n = 0..10000</a>
%H A402272 LMFDB, <a href="https://www.lmfdb.org/Character/Dirichlet/Labels">Dirichlet character labels</a>.
%F A402272 Write 2*n+1 = p1^e1*...*pr^er, then a(n) is the number x in [0,2*n] such that x == (-1)^ei (mod pi^ei) for all i. In particular, a(n) = 1 if and only if 2*n+1 > 1 is a square, and a(n) = n-1 if and only if 2*n+1 is in A376218.
%e A402272 For 2*n+1 = 9, Jacobi(.,9) is the principal character modulo 9, so a(4) = 1.
%e A402272 For 2*n+1 = 45, Jacobi(.,45) is the product of Jacobi(.,5) (having label -1 modulo 5) and Jacobi(.,9) (having label 1 modulo 9, since Jacobi(.,9) is principal). The label of Jacobi(.,45) must be congruent to -1 modulo 5 and 1 modulo 9, and so a(22) = 19.
%o A402272 (PARI) a(n) = my(f=factor(2*n+1), even_exp=1, odd_exp=1); for(i=1, #f~, if(f[i, 2]%2==0, even_exp*=f[i, 1]^f[i, 2], odd_exp*=f[i, 1]^f[i, 2])); lift(chinese(Mod(-1, odd_exp), Mod(1, even_exp)))
%Y A402272 Cf. A376218, A402273 (conductors). Bisection of A402232.
%K A402272 nonn,easy,new
%O A402272 0,2
%A A402272 _Jianing Song_, Nov 16 2026
