%S A402333 1,5,36,312,3151,36367,472198,6812378,108110025,1871637561,
%T A402333 35102628952,708993441964,15342919841203,354162469882547,
%U A402333 8686123462464858,225565690389251790,6183027555466110925,178404463839015369085,5405047940313039278476,171552388903648008224576
%N A402333 a(n) = 1 + Sum_{k=1..n} binomial(n+3,k) * a(n-k).
%F A402333 G.f. A(x) satisfies 2*A(x) - 1/(1-x) = A(x/(1-x))/(1-x)^4.
%F A402333 G.f. A(x) satisfies A(x) = (2*A(z) - 1/(1-z))/(1+x)^4, where z = x/(1+x).
%F A402333 E.g.f.: d^3/dx^3 ( (1 - x - x^2/2)/(2 - exp(x)) ).
%F A402333 a(n) = (n+3)! * [x^(n+3)] (exp(x) - 1 - x - x^2/2)/(2 - exp(x)).
%F A402333 a(n) = A000670(n+3) - (n+3)*A000670(n+2) - binomial(n+3,2)*A000670(n+1).
%F A402333 a(n) ~ (2 - log(2)^2 - 2*log(2)) * n! * n^3 / (4 * log(2)^(n+4)). - _Vaclav Kotesovec_, Nov 17 2026
%o A402333 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(i+3, j)*v[i-j+1])); v;
%Y A402333 Cf. A000629, A000670, A053525, A402334.
%Y A402333 Cf. A352863.
%K A402333 nonn,new
