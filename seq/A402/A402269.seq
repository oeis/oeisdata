%I A402269 #39 Nov 25 2026 21:33:48
%S A402269 10,20,26,28,50,52,58,68,76,116,119,122,172,188,212,268,292,356,388,
%T A402269 452,508,548,556,628,668,692,772,788,796,892,908,916,1018,1076,1108,
%U A402269 1132,1228,1348,1396,1412,1516,1532,1588,1636,1756
%N A402269 Composite numbers c such that psi(c+6) - psi(c) = 6 where psi is Dedekind's psi function (A001615).
%C A402269 Together with A023201 all solutions of psi(n+6)-psi(n)=6 are given.
%o A402269 (PARI)
%o A402269 dpsi(n) = my(f = factor(n)); n * prod(i = 1, matsize(f)[1], 1 + 1/f[i,1]);
%o A402269 isok(c) = !isprime(c) && dpsi(c+6) - dpsi(c) == 6;
%o A402269 select(x->isok(x), [1..2000])
%Y A402269 Cf. A001615 (psi), A054903 (analogous), A023201.
%K A402269 nonn,new
%O A402269 1,1
%A A402269 _Werner Aumayr_, Nov 16 2026
