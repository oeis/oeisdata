%S A402143 5,11,21,22,23,37,38,41,43,44,45,46,47,50,75,77,78,83,85,86,87,89,90,
%T A402143 91,92,93,94,95,101,102,114,149,150,151,154,155,157,158,165,166,167,
%U A402143 169,171,172,173,174,175,178,179,180,181,182,183,185,186,187,188,189
%N A402143 Numbers k such that the k-th composition in standard order covers an initial interval of positive integers but is not a 1-based restricted growth sequence.
%C A402143 The k-th composition in standard order (graded reverse-lexicographic, A066099) is obtained by taking the set of positions of 1's in the reversed binary expansion of k, prepending 0, taking first differences, and reversing again. This gives a bijective correspondence between nonnegative integers and integer compositions.
%C A402143 A 1-based restricted growth sequence of length j is a sequence (a_1, ..., a_j), satisfying a_1 = 1 and a_i <= 1 + max(a_1, ..., a_{i-1}) for all i = 2, 3, ..., j.
%e A402143 The terms together with corresponding compositions begin:
%e A402143    5: (2,1)
%e A402143   11: (2,1,1)
%e A402143   21: (2,2,1)
%e A402143   22: (2,1,2)
%e A402143   23: (2,1,1,1)
%e A402143   37: (3,2,1)
%e A402143   38: (3,1,2)
%e A402143   41: (2,3,1)
%e A402143   43: (2,2,1,1)
%e A402143   44: (2,1,3)
%e A402143   45: (2,1,2,1)
%e A402143   46: (2,1,1,2)
%e A402143   47: (2,1,1,1,1)
%e A402143   50: (1,3,2)
%e A402143   75: (3,2,1,1)
%e A402143   77: (3,1,2,1)
%e A402143   78: (3,1,1,2)
%e A402143   83: (2,3,1,1)
%e A402143   85: (2,2,2,1)
%e A402143   86: (2,2,1,2)
%t A402143 stc[n_]:=Differences[Prepend[Join @@ Position[Reverse[IntegerDigits[n,2]],1],0]]//Reverse;
%t A402143 rgoQ[y_]:=y[[1]]==1&&And@@Table[y[[i]] <= 1+Max@@Take[y,i-1],{i,2,Length[y]}];
%t A402143 Select[Range[100],Union[stc[#]] == Range[1,Max@@stc[#]]&&!rgoQ[stc[#]]&]
%Y A402143 These compositions are counted by A402140.
%Y A402143 Normal case of A402141, counted by A402138.
%Y A402143 A011782 counts compositions, strict A032020.
%Y A402143 A055932 ranks normal partitions.
%Y A402143 A107429 counts normal compositions, ranked by A333217.
%Y A402143 A402139 ranks restricted  growth compositions, counted by A383253.
%Y A402143 A402142 counts non-restricted growth compositions by length, complement A383713.
