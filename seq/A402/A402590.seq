%N A402590 a(n) = 1 if no subset of its nontrivial divisors {1 < d < n : d | n} can sum to n, otherwise 0.
%H A402590 Antti Karttunen, <a href="/A402590/b402590.txt">Table of n, a(n) for n = 1..13223</a> (prepared from the b-file of A392650 as computed Robert Israel)
%H A402590 <a href="/index/Ch#char_fns">Index entries for characteristic functions</a>.
%o A402590 (PARI)
%o A402590 sumbybits(v,m) = { my(s=0); for(i=1,#v,s += ((m%2)*v[i]); m >>= 1); (s); };
%o A402590 A402590(n) = if(n<=2, 1, my(nontrivdivs=divisors(n)[2..-2]); for(i=1,(2^#nontrivdivs)-1,if(sumbybits(nontrivdivs,i)==n,return(0))); (1)); \\ Inefficient!
