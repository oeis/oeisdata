%S A402799 1,2,3,4,5,6,7,10,11,12,13,14,15,16,17,19,20,21,22,23,26,27,28,29,30,
%T A402799 31,33,34,35,36,37,38,39,41,42,43,44,46,47,48,51,52,53,55,57,58,59,60,
%U A402799 61,62,64,65,66,67,68,69,70,71,73,74,76,77,78,79,80,82,83,84,85,86,87,89,91,92,93,94,95,97,101,102
%N A402799 Numbers k such that A276085(k) is a multiple of A071773(k), where A276085 is fully additive with a(p) = p#/p, and A071773(n) is the squarefree kernel (rad) of the largest square dividing n.
%H A402799 Antti Karttunen, <a href="/A402799/b402799.txt">Table of n, a(n) for n = 1..10000</a>
%H A402799 <a href="/index/Pri#primorial_numbers">Index entries for sequences related to primorial numbers</a>.
%F A402799 {k such that A276085(k) == 0 mod A007947(A003557(k))}.
%o A402799 (PARI)
%o A402799 A071773(n) = { my(f=factor(n)); prod(i=1, #f~, f[i, 1]^(f[i, 2]>1)); };
%o A402799 A276085_mod_m(n,m) = if(1==n,0,my(f = factor(n),lp=f[#f~,1],pr=1,s=0,k=1); forprime(p=2,lp,if(f[k,1]==p, s += f[k,2]*pr; s %= m; k++); pr *= p; pr %= m); (s));
%o A402799 is_A402799(k) = !(A276085_mod_m(k,A071773(k)));
%Y A402799 Cf. A003557, A007947, A071773, A276085.
%Y A402799 Positions of 0's A402798.
%Y A402799 Subsequences: A005117, A402797.
%K A402799 nonn,new
%O A402799 1,2
%A A402799 _Antti Karttunen_, Nov 27 2026
