%S A402568 1,3,7,13,23,36,55,75,97,121,146,174,203,232,261,291,321,351,381,411,
%T A402568 441,471,501,531,561,591,621,651,681,711,742,773,804,835,867,900,933,
%U A402568 966,1001,1036,1071,1106,1143,1181,1219,1259,1299,1339,1379,1419,1459,1499
%N A402568 Length after n rounds of the decimal self-stirring word: start with 1; each round visits 0,...,9, skipping zero counts and otherwise appending the current count followed by its label, with immediate count updates.
%H A402568 Lei Zhou (SWUST), <a href="/A402568/b402568.txt">Table of n, a(n) for n = 0..9999</a>
%H A402568 Lei Zhou, <a href="https://www.preprints.org/manuscript/202610.1633/v2">Self-Stirring Sequences: Exact Dynamics and Statistical Rigidity</a>, Preprints.org, version 2, November 19, 2026.
%F A402568 a(n) = 10*n*log_10(n) + 10*n*log_10(log_10(n)) + 10*n*F(frac(log_10(n*log_10(n)))) + O(n*log(log(n))/log(n)) as n tends to infinity, where F(t) = 2-t-10^(1-t)/9 for 0 <= t < 1, extended with period 1, and frac(x) = x-floor(x). In particular, a(n) ~ 10*n*log_10(n). See Zhou, Theorem 2.7.
%e A402568 a(0)=1 is the seed length. Round 1 appends 11, giving a(1)=3. Round 2 appends 31 and then 13, giving a(2)=7. Round 3 appends 51,23,15, giving a(3)=13.
%o A402568 (Python)
%o A402568 def terms():
%o A402568     c = [0]*10
%o A402568     c[1] = 1
%o A402568     size = 1
%o A402568     yield size
%o A402568     while True:
%o A402568         for d in range(10):
%o A402568             q = c[d]
%o A402568             if q:
%o A402568                 block = list(map(int, str(q))) + [d]
%o A402568                 for x in block:
%o A402568                     c[x] += 1
%o A402568                 size += len(block)
%o A402568         yield size
%Y A402568 Cf. A402566 (digit stream), A402567 (positive counts).
%K A402568 nonn,base,easy,new
%O A402568 0,2
%A A402568 _Lei Zhou (SWUST)_, Nov 21 2026
