%U A402392 10,4,1,1,8,19,22,15,5,2,1,9,22,27,21,8,3,1,9,24,33,28,13,5,1,10,27,40,37,20,7,1
%N A402392 Triangle read by rows: T(n,k) is the number of positive integers that reach 1 in exactly n steps of the '3x+1' problem, k of them being tripling steps.
%C A402392 Row n splits the A005186(n) numbers that need exactly n steps to reach 1 according to how many of those steps are tripling steps x -> 3x+1.
%C A402392 By the formula of Joe Slater in A006666, a number m that reaches 1 in n steps, k of them tripling steps, satisfies 2^(n-1) < m*6^k <= 2^n. These ranges do not overlap for different k, so among the numbers that need the same number of steps, those with more tripling steps are smaller. In particular, the smallest number that needs n steps, A033491(n), has the largest number of tripling steps, A177001(n), which is the column of the last term of row n.
%C A402392 T(n,0) = 1, counting 2^n, and T(n,1) = floor((n-3)/2) for n >= 3, counting the numbers 2^a*(4^j-1)/3 with j >= 2 and a + 2*j + 1 = n.
%H A402392 Carlos Alberto Terencio de Bastos, <a href="/A402392/b402392.txt">Table of n, a(n) for n = 0..621</a> (rows 0..60, flattened)
%H A402392 <a href="/index/3#3x1">Index entries for sequences related to 3x+1 (or Collatz) problem</a>
%F A402392 Sum_{k>=0} T(n,k) = A005186(n).
%e A402392 Triangle begins:
%e A402392   n=0:  1;
%e A402392   n=1:  1;
%e A402392   ...
%e A402392   n=5:  1, 1;
%e A402392   n=7:  1, 2, 1;
%e A402392   n=12: 1, 4, 4, 1;
%e A402392   n=16: 1, 6, 10, 8, 3, 1;
%e A402392   n=20: 1, 8, 19, 22, 15, 5, 2;
%e A402392 Of the A005186(20) = 72 numbers that need 20 steps, the two with 6 tripling steps are 18 and 19, the smallest ones, and the only one with no tripling step is 2^20 = 1048576, the largest one.
%o A402392 (Python)
%o A402392 def rows(N):
%o A402392     cur, out = [(1, 0)], []
%o A402392     for n in range(N+1):
%o A402392         c = {}
%o A402392         for m, k in cur: c[k] = c.get(k, 0) + 1
%o A402392         out.append([c.get(k, 0) for k in range(max(c)+1)])
%o A402392         nxt = []
%o A402392         for m, k in cur:
%o A402392             nxt.append((2*m, k))
%o A402392             if m % 6 == 4 and m > 4: nxt.append(((m-1)//3, k+1))
%o A402392         cur = nxt
%o A402392     return out
%o A402392 print([t for r in rows(23) for t in r])
%Y A402392 Cf. A005186 (row sums), A006577, A006666, A006667, A033491, A177001.
