%I A402029 #6 Nov 11 2026 16:44:32
%S A402029 1,-2,1,-9,0,1,24,-12,-2,1,93,0,-21,0,1,-258,129,48,-24,-2,1,-981,0,
%T A402029 330,0,-33,0,1,2736,-1368,-804,402,72,-36,-2,1,10377,0,-4626,0,711,0,
%U A402029 -45,0,1,-28962,14481,11664,-5832,-1638,819,96,-48,-2,1,-109809,0,60939,0,-12663,0,1236,0,-57,0,1
%N A402029 Triangle read by rows: Sprugnoli array ( (1 - 2*x + 3*x^2)/(1 + 12*x^2 + 15*x^4), x/(1 - 2*x + 3*x^2), x/(1 + 12*x^2 + 15*x^4) ).
%H A402029 Paul Barry, <a href="https://arxiv.org/abs/2611.05673">Orthogonal polynomials on two or more intervals: the Sprugnoli context</a>, arXiv:2611.05673 [math.CO], 2026. See pp. 6-7.
%F A402029 T(n,k) = [x^n] g(x)*f_1(x)^(k mod 2)*(x*f_2(x))^floor(k/2), where g(x) = (1 - 2*x + 3*x^2)/(1 + 12*x^2 + 15*x^4),  f_1(x) = x/(1 - 2*x + 3*x^2), and f_2(x) = x/(1 + 12*x^2 + 15*x^4).
%e A402029 The triangle begins as:
%e A402029      1;
%e A402029     -2,   1;
%e A402029     -9,   0,   1;
%e A402029     24, -12,  -2,   1;
%e A402029     93,   0, -21,   0,   1;
%e A402029   -258, 129,  48, -24,  -2, 1;
%e A402029   -981,   0, 330,   0, -33, 0, 1;
%e A402029   ...
%t A402029 g[x_]:=(1-2x+3x^2)/(1+12x^2+15x^4); f1[x_]:=x/(1-2x+3x^2); f2[x_]:=x/(1+12x^2+15x^4); T[n_,k_]:=SeriesCoefficient[g[x]*f1[x]^Mod[k,2]*(x*f2[x])^Floor[k/2],{x,0,n}]; Table[T[n,k],{n,0,10},{k,0,n}]//Flatten
%Y A402029 Oblique side gives A000012.
%Y A402029 Row sums give A402030.
%K A402029 sign,easy,tabl,new
%O A402029 0,2
%A A402029 _Stefano Spezia_, Nov 11 2026
