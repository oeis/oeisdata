%S A402273 1,3,5,7,1,11,13,15,17,19,21,23,1,3,29,31,33,35,37,39,41,43,5,47,1,51,
%T A402273 53,55,57,59,61,7,65,67,69,71,73,3,77,79,1,83,85,87,89,91,93,95,97,11,
%U A402273 101,103,105,107,109,111,113,115,13,119,1,123,5,127,129,131,133,15
%N A402273 Bisection of A007913: a(n) = A007913(2*n+1).
%C A402273 a(n) is the conductor of the Dirichlet character Jacobi(.,2*n+1) modulo 2*n+1. In other words, a(n) is the least m such that Jacobi(k,2*n+1) = Jacobi(k,m) for all k coprime to 2*n+1.
%H A402273 Jianing Song, <a href="/A402273/b402273.txt">Table of n, a(n) for n = 0..10000</a>
%e A402273 For 2*n+1 = 9, Jacobi(.,9) is the principal character modulo 9, so a(4) = 1.
%e A402273 For 2*n+1 = 45, Jacobi(.,45) is induced by the primitive character Jacobi(.,5) modulo 5, so a(22) = 5.
%t A402273 A402273[n_] := Times @@ Map[First[#]^Mod[Last[#], 2] &, FactorInteger[2*n + 1]];
%t A402273 Array[A402273, 100, 0] (* _Paolo Xausa_, Nov 16 2026 *)
%o A402273 (PARI) a(n) = core(2*n+1)
