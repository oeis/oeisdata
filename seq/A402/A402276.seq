%T A402276 9,4,4,7,4,2,2,1,7,3,2,2,12,3,5,2,7,1,4,4,7,2,6,7,3,3,4,1,7,1,2,3,1,
%U A402276 20,2,5,1,6,7,1,5,5,3,2,3,3,1,3,3,5,4,1,8
%N A402276 Number of primes in the n-th maximal cluster of primes with consecutive gaps at most 10.
%C A402276 Whether a later cluster contains at least 30 primes remains unresolved here. The Hardy-Littlewood prime-tuples conjecture predicts later clusters containing at least 31 primes.
%C A402276 For jump limits 2, 4 and 6, the initial counts 4, 9 and 24 are provably unique maxima since every later cluster contains at most 2, 6 and 19 primes, respectively (A399821).
%C A402276 For limit 12, the initial count 30 is exceeded by the cluster 127 to 293, containing 32 primes.
%H A402276 Jwalin Bhatt, <a href="/A402276/b402276.txt">Table of n, a(n) for n = 1..10000</a>
%e A402276 The first cluster is {2, ..., 113} and contains 30 primes, so a(1) = 30.
%e A402276 The second cluster is {127, ..., 199} and contains 16 primes, so a(2) = 16.
%e A402276 The third cluster is {211}, so a(3) = 1.
%e A402276 The sixth cluster is {331, ..., 467} and contains 25 primes, so a(6) = 25.
%t A402276 s={}; p1=2; Do[p=p1; While[NextPrime[p]-p<=10, p=NextPrime[p]]; AppendTo[s, 1+PrimePi[p]-PrimePi[p1]]; p1=NextPrime[p], {i, 84}]; s
%o A402276 (Python)
%o A402276 from sympy import nextprime
%o A402276 from itertools import islice
%o A402276 def gen_A402276():
%o A402276     p, count = 2, 1
%o A402276     while True:
%o A402276         q = int(nextprime(p))
%o A402276         if q - p > 10:
%o A402276             yield count
%o A402276             count = 0
%o A402276         count += 1
%o A402276         p = q
%o A402276 print(list(islice(gen_A402276(), 84)))
