%I A402053 #8 Nov 15 2026 08:09:14
%S A402053 16,32,48,64,80,81,96,112,144,160,162,176,192,208,224,240,243,256,272,
%T A402053 288,304,320,324,336,352,368,400,405,416,432,448,464,480,486,496,512,
%U A402053 528,544,560,567,576,592,608,624,625,648,656,672,688,704,720,729,736,752
%N A402053 Numbers k such that d_4(k) is not a 5-smooth number, where d_4 = A007426 is the 4th Piltz function.
%C A402053 First differs from its subsequence A360723 at n = 2356: a(2356) = 32768 = 2^15 is not a term in A360723.
%C A402053 Numbers whose prime factorization includes at least one exponent that is not equal to 1, 2, 3, or 7.
%C A402053 The asymptotic density of this sequence is 1 - Product_{p prime} (1 - 1/p^4 + 1/p^7 - 1/p^8) = 0.07191495387140317672... .
%H A402053 Amiram Eldar, <a href="/A402053/b402053.txt">Table of n, a(n) for n = 1..10000</a>
%H A402053 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%e A402053 16 is a term since A007426(16) = 35 is not a 5-smooth number.
%t A402053 f[p_, e_] := (e+1)*(e+2)*(e+3)/6; d4[n_] := Times @@ f @@@ FactorInteger[n]; d4[1] = 1; smQ[n_] := n == Times @@ ({2, 3, 5}^IntegerExponent[n, {2, 3, 5}]); q[k_] := !smQ[d4[k]]; Select[Range[760], q]
%t A402053 (* Alternative: *)
%t A402053 q[k_] := !AllTrue[FactorInteger[k][[;; , 2]], MemberQ[{1, 2, 3, 7}, #] &]; Select[Range[760], q]
%o A402053 (PARI) isok(k) = {my(e = factor(k)[, 2]); for(i = 1, #e, if(e[i] > 3 && e[i] != 7, return(1))); 0;}
%Y A402053 Cf. A051037, A007426.
%Y A402053 A360723 is a subsequence.
%K A402053 nonn,easy,new
%O A402053 1,1
%A A402053 _Amiram Eldar_, Nov 12 2026
