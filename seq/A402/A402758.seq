%U A402758 4155200,5645968,7613120,10167664,13321536,17506304,22813632,29077024,37091520,46901632,58796400
%N A402758 Expansion of g.f. F^8, where F = g.f. for A028959.
%C A402758 a(n) is the number of representations of n by the 16-variable quadratic form that is the sum of 8 copies of x^2 + x*y + 6*y^2.
%H A402758 Karan Sharma, <a href="/A402758/b402758.txt">Table of n, a(n) for n = 0..1000</a>
%H A402758 Bülent Köklüce, <a href="https://doi.org/10.1007/s11139-013-9480-4">Cusp forms in S_6(Gamma_0(23)), S_8(Gamma_0(23)) and the number of representations of numbers by some quadratic forms in 12 and 16 variables</a>, Ramanujan J. 34 (2014), 187-208. See p. 204.
%o A402758 (PARI) th(M, N) = 1 + 2*x*Ser(qfrep(M, N, 1), x);
%o A402758 a(n) = polcoef(th([2, 1; 1, 12], n+1)^8, n);
%Y A402758 Cf. A028660, A028930, A028959, A328093, A328094, A328527, A328528, A328529, A328530, A328531, A328532, A328533, A328534, A328535, A328536, A401430, A401474, A401519, A402729, A402730, A402753, A402756, A402757.
