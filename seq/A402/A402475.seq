%N A402475 G.f.: Sum_{k>=1} x^(k*(k+1)/2) * Product_{j=1..2*k} (1 + x^j).
%H A402475 Vaclav Kotesovec, <a href="/A402475/b402475.txt">Table of n, a(n) for n = 0..10000</a>
%F A402475 G.f.: Sum_{k>=1} Product_{j=1..k} x^j*(1 + x^(2*j))*(1 + x^(2*j-1)).
%F A402475 a(n) ~ c * A376659^sqrt(n) / sqrt(n), where c = 0.3086896288477654368433844... is the positive real root of the equation -1 - 48*c^2 - 368*c^4 + 10304*c^6 = 0.
%t A402475 nmax = 100; CoefficientList[Series[Sum[x^(k*(k+1)/2)*Product[1+x^j, {j, 1, 2*k}], {k, 1, Sqrt[2*nmax]}], {x, 0, nmax}], x]
