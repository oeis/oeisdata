%S A402537 1,1,2,4,95,31,10819,20797,1110889,1262993,14867417,5304757,428274523,
%T A402537 7265899991,5701986220589,472357622252171,6932017267247791,
%U A402537 194993275223567,67977459173746289,146021019208398151,4425719599528056755591,1273100988615155737013
%N A402537 Numerators of coefficients of expansion of (1 - x)^(-1/(1 + log(1 - x))).
%C A402537 For x, y > 1, let mult(x, y) = exp(log(x) * log(y)) = exp(exp(log(log(x)) + log(log(y)))).
%C A402537 This operation is associative and commutative, has neutral element e and inverse inv(x) = exp(1/log(x)) = exp(exp(-log(log(x)))) for x > 1.
%C A402537 For x < 1 - 1/e, let inv'(x) = (1/e) * inv(e*(1 - x)).
%C A402537 Then we have inv'(x) = (1 - x)^(-1/(1 + log(1 - x))).
%C A402537 Expanding inv'(x) around 0 gives the power series inv'(x) = Sum_{n >= 0} (a(n) / A402538(n)) * x^n.
%H A402537 Elia Immanuel Auer, <a href="/A402537/b402537.txt">Table of n, a(n) for n = 0..400</a>
%H A402537 Albert A. Bennett, <a href="https://doi.org/10.2307/2007124">Note on an Operation of the Third Grade</a>, Annals of Mathematics, Vol. 17, No. 2 (Dec. 1915), pp. 74-75.
%F A402537 a(n) = numerator(A088815(n)/n!).
%F A402537 G.f.: (1 - x)^(-1/(1 + log(1 - x))) = Sum_{n >= 0} (a(n) / A402538(n)) * x^n.
%e A402537 (1 - x)^(-1/(1 + log(1 - x))) = 1 + x + 2*x^2 + 4*x^3 + (95/12)*x^4 + (31/2)*x^5 + ...
%p A402537 a := proc(n) local x; numer(coeff(series(1/(1-x)^(1/(1 + log(1-x))), x=0, n+1), x, n)) end: seq(a(n), n=0..21);
%o A402537 (SageMath)
%o A402537 def a(n):
%o A402537     x = PowerSeriesRing(QQ, 'x', default_prec=n+1).gen()
%o A402537     return ((1/(1 + (1 - x).log()) - 1).exp()[n]).numerator()
%o A402537 print([a(n) for n in range(22)])  # _Peter Luschny_, Nov 25 2026
%o A402537 (Python)
%o A402537 from fractions import Fraction as QQ
%o A402537 def a_gen():
%o A402537     s = [0, 1]; b = [1, 1]; f = 1; n = 1
%o A402537     yield 1
%o A402537     yield 1
%o A402537     while True:
%o A402537         n += 1
%o A402537         b.append((2 * n - 1) * b[-1] - (n - 1) * (n - 2) * b[-2])
%o A402537         s.append(0)
%o A402537         for k in range(n, 0, -1): s[k] = (n - 1) * s[k] + s[k - 1]
%o A402537         f *= n
%o A402537         yield QQ(sum(x * y for x, y in zip(s, b)), f).numerator
%o A402537 a = a_gen(); a_list = [next(a) for _ in range(22)]; print(a_list) # _Peter Luschny_, Nov 26 2026
