%I A402454 #13 Nov 26 2026 22:34:35
%S A402454 4,84,10,35,165,286,680,969,1771,3654,4495,7770,10660,12341,16215,
%T A402454 23426,32509,35990,47905,57155,62196,79079,91881,113564,147440,166650,
%U A402454 176851,198485,209934,234136,333375,366145,419220,437989,540274,562475,632710,708561,762355
%N A402454 a(n) is the smallest tetrahedral number divisible by the n-th prime.
%C A402454 a(n) = A000292(k) for the smallest k >= 1 such that A000040(n) divides A000292(k).
%F A402454 a(n) = prime(n)*(prime(n) - 1)*(prime(n) - 2)/6 for n >= 3.
%e A402454 For n = 1, prime(1) = 2. The positive tetrahedral numbers are 1, 4, 10, ...; the smallest divisible by 2 is 4, so a(1) = 4.
%e A402454 For n = 2, prime(2) = 3. The positive tetrahedral numbers are 1, 4, 10, 20, 35, 56, 84, ...; the smallest divisible by 3 is 84, so a(2) = 84.
%e A402454 For n = 3, prime(3) = 5. The smallest positive tetrahedral number divisible by 5 is 10, so a(3) = 10.
%t A402454 a[n_] := Binomial[Prime[n], 3]; a[1] = 4; a[2] = 84; Array[a, 39] (* _Amiram Eldar_, Nov 20 2026 *)
%o A402454 (PARI) a(n) = if(n==1, 4, n==2, 84, binomial(prime(n), 3));
%Y A402454 Cf. A000040 (primes), A000292 (tetrahedral numbers).
%K A402454 nonn,easy,new
%O A402454 1,1
%A A402454 _G. L. Honaker, Jr._, Nov 18 2026
