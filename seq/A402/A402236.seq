%I A402236 #8 Nov 18 2026 10:43:48
%S A402236 1,2,18,346,11605,604611,45435922,4674152960,632873769129,
%T A402236 109364554679815,23529768124833586,6175758384500262768,
%U A402236 1944010807638645841069,723399443297226594376037,314311722367700681109658530,157760733270776915081518475776,90622109628115427591402020990993
%N A402236 Number of weakly connected acyclic digraphs (or DAGs) on n labeled nodes in which every node has in-degree at most 2.
%C A402236 Without the bound on the in-degree the count is A082402. With in-degree at most 1 it is n^(n-1) = A000169(n), the number of rooted labeled trees.
%C A402236 a(n) = A082402(n) for n <= 3; a(4) = 346 against A082402(4) = 446.
%H A402236 Tyler Satchel Orden, <a href="/A402236/b402236.txt">Table of n, a(n) for n = 1..60</a>
%F A402236 E.g.f.: log(A(x)), where A(x) is the e.g.f. of A397711.
%F A402236 a(n) = A397711(n) - Sum_{j=1..n-1} binomial(n-1,j-1)*a(j)*A397711(n-j).
%e A402236 a(3) = 18: of the 25 acyclic digraphs on 3 nodes, the one with no arcs and the 6 with a single arc are not connected.
%e A402236 a(4) = 346: all 100 acyclic digraphs on 4 nodes that have a node with in-degree 3 are connected, and 446 - 100 = 346.
%o A402236 (Python)
%o A402236 from math import comb
%o A402236 def aList(N, k=2):  # a(1), ..., a(N)
%o A402236     f = lambda m: sum(comb(m, i) for i in range(k+1))
%o A402236     A = [1]  # all acyclic digraphs with in-degree at most k
%o A402236     for n in range(1, N+1):
%o A402236         A.append(sum((-1)**(t+1)*comb(n, t)*f(n-t)**t*A[n-t] for t in range(1, n+1)))
%o A402236     c = [0]
%o A402236     for n in range(1, N+1):
%o A402236         c.append(A[n] - sum(comb(n-1, j-1)*c[j]*A[n-j] for j in range(1, n)))
%o A402236     return c[1:]
%o A402236 print(aList(17))
%Y A402236 Cf. A397711 (not necessarily connected), A082402 (no bound on the in-degree), A000169.
%K A402236 nonn,new
%O A402236 1,2
%A A402236 _Tyler Satchel Orden_, Nov 16 2026
