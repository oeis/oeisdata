%N A402024 Decimal expansion of L'(1,chi_{-20})/L(1,chi_{-20}) negated, where chi_{-20} is the Dirichlet character kronecker(-20,.).
%F A402024 Equals A402011 - (1/2) * (log Gamma(1/20) + log Gamma(3/20) + log Gamma(7/20) + log Gamma(9/20) - log Gamma(11/20) - log Gamma(13/20) - log Gamma(17/20) - log Gamma(19/20)).
%e A402024 L'(1,chi_{-20})/L(1,chi_{-20}) = -0.31751444576069318259...
%o A402024 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402024 f(-20)
%o A402024 (PARI) f(D) = my(h = qfbclassno(D)); log(2*Pi) + Euler() - (1/h) * sum(a=1, abs(D), kronecker(D,a)*lngamma(a/abs(D))); \\ D < -4 is a fundamental discriminant
%o A402024 f(-20)
