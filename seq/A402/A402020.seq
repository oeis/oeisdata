%T A402020 3,0,1,3,9,8,8,0,6,2,5,3,3,3,5,8,0,7,6,4,7,3,3,0,5,0,9,4,5,6,3,8,6,9,
%U A402020 1,3,4,8,7,0,7,2,4,1,5,6,0,9,3,5,1,3,9,6
%N A402020 Decimal expansion of L'(1,chi_13)/L(1,chi_13), where chi_13 is the Dirichlet character kronecker(13,.).
%F A402020 Equals A402011 - (1/(2*log((3+sqrt(13))/2))) * Sum_{a=1..12} Legendre(a,13)*zeta''(0,a/13), where zeta''(s,x) is the second partial derivative of the Hurwitz zeta function with respect to s.
%e A402020 L'(1,chi_13)/L(1,chi_13) = 0.46997156683078013930...
%o A402020 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402020 f(13)
%o A402020 (PARI) f(D) = my([h, loge] = vecextract(quadclassunit(D), [1,4])); log(2*Pi) + Euler() - (1/(2*h*loge)) * sum(a=1, D, kronecker(D,a)*zetahurwitz(0, a/D, 2)); \\ D > 0 is a fundamental discriminant
%o A402020 f(13)
%Y A402020 Cf. A011583 (chi_13). See A402011 for related sequences.
%K A402020 nonn,cons,new
%O A402020 0,1
%A A402020 _Jianing Song_, Nov 11 2026
