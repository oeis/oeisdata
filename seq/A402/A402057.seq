%I A402057 #8 Nov 15 2026 08:14:52
%S A402057 1,4096,531441,2097152,244140625,2176782336,10460353203,13841287201,
%T A402057 68719476736,1000000000000,1114512556032,3138428376721,23298085122481,
%U A402057 35184372088832,42845606719488,56693912375296,129746337890625,476837158203125,512000000000000,582622237229761
%N A402057 Numbers k such that gcd(d_3(k), 30) = 1, where d_3 = A007425 is the 3rd Piltz function.
%C A402057 Numbers k such that d_3(k) is a 7-rough number (A007775).
%C A402057 All the terms are cubes.
%C A402057 Numbers whose prime factorization has only exponents e that are multiples of 3, such that e/3 is congruent to 0 or 3 (mod 4) (A014601) and also congruent to 0, 2, or 4 (mod 5) (A047212).
%H A402057 Amiram Eldar, <a href="/A402057/b402057.txt">Table of n, a(n) for n = 1..10000</a>
%H A402057 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%H A402057 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402057 a(n) = A402058(n)^3.
%F A402057 Sum_{n>=1} 1/a(n) = zeta(60) * Product_{p prime} (1 + 1/p^12 + 1/p^21 + 1/p^36 + 1/p^45 + 1/p^57) = 1.000246503878716151698404... .
%e A402057 4096 is a term since A007425(4096) = 91, and gcd(91, 30) = 1.
%t A402057 f[p_, e_] := (e + 1)*(e + 2)/2; d3[n_] := Times @@ f @@@ FactorInteger[n]; d3[1] = 1; q[k_] := CoprimeQ[d3[k], 30]; Select[Range[84000]^3, q]
%o A402057 (PARI) isok(k) = ispower(k, 3) && #select(e -> (e % 4 > 0 && e % 4 < 3) || (e % 5) % 2, factor(sqrtnint(k, 3))[, 2]) == 0;
%Y A402057 Subsequence of A000578 and A402055.
%Y A402057 Cf. A007775, A007425, A014601, A047212, A252849 (d_3(k) is even), A252895 (d_3(k) is odd), A354178, A402058.
%K A402057 nonn,easy,new
%O A402057 1,2
%A A402057 _Amiram Eldar_, Nov 12 2026
