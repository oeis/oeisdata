%N A402028 Decimal expansion of L'(1,chi_{-24})/L(1,chi_{-24}) negated, where chi_{-24} is the Dirichlet character kronecker(-24,.).
%F A402028 Equals A402011 - (1/2) * (log Gamma(1/24) + log Gamma(5/24) + log Gamma(7/24) + log Gamma(11/24) - log Gamma(13/24) - log Gamma(17/24) - log Gamma(19/24) - log Gamma(23/24)).
%e A402028 L'(1,chi_{-24})/L(1,chi_{-24}) = -0.32952887283776775552...
%o A402028 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402028 f(-24)
%o A402028 (PARI) f(D) = my(h = qfbclassno(D)); log(2*Pi) + Euler() - (1/h) * sum(a=1, abs(D), kronecker(D,a)*lngamma(a/abs(D))); \\ D < -4 is a fundamental discriminant
%o A402028 f(-24)
