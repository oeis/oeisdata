%S A402116 15,26,39,49,51,58,62,85,93,94,155,158,159,265,394,398,493,497,511,
%T A402116 514,581,586,589,622,623,629,851,933,2654,3946,3949,3981,3983,3985,
%U A402116 3986,5111,5114,5141,5143,5818,5891,5893,5899,6227,6233,6239,6295,8518,9335
%N A402116 Right-truncatable emirpimes in base 10, stopping at two digits.
%C A402116 An emirpimes is a semiprime whose decimal reversal is a different semiprime. Successively deleting the rightmost digit must leave an emirpimes at every step down to two digits.
%C A402116 There are 87 terms. The largest and unique nine-digit term is 933587953 (G. L. Honaker, Jr.).
%C A402116 The numbers of terms with 2, 3, ..., 9 digits are 10, 18, 21, 17, 12, 5, 3, 1.
%H A402116 Eric W. Weisstein, <a href="/A402116/b402116.txt">Table of n, a(n) for n = 1..87</a> (complete sequence).
%H A402116 G. L. Honaker, Jr., <a href="https://t5k.org/curios/page.php?number_id=6055657">Prime Curios!: 933587953</a>.
%H A402116 G. L. Honaker, Jr., <a href="https://t5k.org/curios/page.php?curio_id=50971">Prime Curios!: 359785339</a>.
%H A402116 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Emirpimes.html">Emirpimes</a>.
%t A402116 emirpimesQ[n_] := With[{r = IntegerReverse[n]}, n != r && PrimeOmega[n] == 2 && PrimeOmega[r] == 2];
%t A402116 levels = NestWhileList[Select[Flatten[Outer[Plus, 10 #, Range[0, 9]]], emirpimesQ] &, Select[Range[10, 99], emirpimesQ], Length[#] > 0 &];
%t A402116 Flatten[levels]
%Y A402116 Cf. A097393.
%Y A402116 Cf. A402118 (left-truncatable emirpimes).
%K A402116 nonn,base,fini,full,new
%O A402116 1,1
