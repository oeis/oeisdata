%U A402581 0,92,0,1,51,192,1,5,0,4,1,59,0,156,0,1,55,4,1,5,0,176,108,1,0,124,1,1,1,12,0,123,1,4
%N A402581 Primorial base mongrel derivative: Compute otherwise like A327860, but take the exponents e from the prime factorization of n, like A003415 (arithmetic derivative) does.
%C A402581 Note: a(n) is not equal to A085731(n) * A402582(n). The first n for which the product gives different result are 338, 507, 578, 676, 722, 845, 867, 1014, etc.
%H A402581 Antti Karttunen, <a href="/A402581/b402581.txt">Table of n, a(n) for n = 1..16170</a>
%H A402581 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%o A402581 (PARI) A402581(n) = { my(orgn=n, s=0, m=1, p=2, e); while(n, e = valuation(orgn,p); m *= (p^e); s += (e/p); n = n\p; p = nextprime(1+p)); (s*m); };
%Y A402581 Cf. A085731, A402582, A402583.
%Y A402581 Cf. also A003415, A327860,
%K A402581 nonn,base,easy,new
%O A402581 1,4
%A A402581 _Antti Karttunen_, Nov 21 2026
