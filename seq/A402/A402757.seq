%S A402757 1,14,86,310,772,1596,3194,6120,10782,18668,32848,55612,89576,140650,
%T A402757 217308,332980,500802,735168,1072460,1540260,2161716,3016272,4162648,
%U A402757 5670302,7658398,10172954,13423314,17604218,22739964,29223350,37248600,46976318,58949220
%N A402757 Expansion of g.f. Phi*F^7, where Phi = g.f. for A028930 and F = g.f. for A028959.
%C A402757 a(n) is the number of representations of n by the 16-variable quadratic form that is the sum of 1 copy of 2*x^2 + x*y + 3*y^2 and 7 copies of x^2 + x*y + 6*y^2.
%H A402757 Karan Sharma, <a href="/A402757/b402757.txt">Table of n, a(n) for n = 0..1000</a>
%H A402757 Bülent Köklüce, <a href="https://doi.org/10.1007/s11139-013-9480-4">Cusp forms in S_6(Gamma_0(23)), S_8(Gamma_0(23)) and the number of representations of numbers by some quadratic forms in 12 and 16 variables</a>, Ramanujan J. 34 (2014), 187-208. See p. 204.
%o A402757 (PARI) th(M, N) = 1 + 2*x*Ser(qfrep(M, N, 1), x);
%o A402757 a(n) = polcoef(th([4, 1; 1, 6], n+1) * th([2, 1; 1, 12], n+1)^7, n);
%Y A402757 Cf. A028930, A028959, A328527, A328528, A328529, A328530, A328531, A328532, A328533, A328534, A328535, A328536, A401430, A401474, A401519, A402729, A402730, A402753, A402756.
%K A402757 nonn,new
%O A402757 0,2
