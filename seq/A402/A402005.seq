%I A402005 #13 Nov 17 2026 23:15:22
%S A402005 1,2,4,3,6,9,4,8,12,16,5,10,15,20,25,6,12,18,24,30,32,7,14,21,28,31,
%T A402005 38,45,8,16,24,32,36,44,52,60,9,18,27,32,41,50,59,68,69,10,20,30,36,
%U A402005 46,56,66,72,78,88,11,22,33,40,51,62,69,76,87,98,109
%N A402005 Triangle T(n,k) read by rows: number of distinct proper crossing points formed by n vertical chords and k horizontal chords of a circle, equally spaced along their respective diameters, 1 <= k <= n.
%C A402005 The n vertical chords divide the horizontal diameter into n+1 equal intervals, and the k horizontal chords divide the vertical diameter into k+1 equal intervals. Intersections on the circumference are excluded.
%C A402005 The underlying square array is symmetric: T(n,k) = T(k,n); only the lower triangular part is listed.
%H A402005 Eddie Lin Rui, <a href="/A402005/b402005.txt">Table of n, a(n) for n = 1..10011 (first 141 rows, flattened)</a>
%H A402005 Eddie Lin Rui, <a href="/A402005/a402005.png">Illustration of T(6,6) = 32</a>
%F A402005 T(n,k) = Sum_{i=1..n} Sum_{j=1..k} [((2*i-n-1)/(n+1))^2 + ((2*j-k-1)/(k+1))^2 < 1], where [P] = 1 if P is true and 0 otherwise.
%F A402005 T(2*n-1, 2*n-1) = A051132(n).
%F A402005 T(2*n, 2*n) = A383915(n).
%e A402005 The triangle begins:
%e A402005    1;
%e A402005    2,  4;
%e A402005    3,  6,  9;
%e A402005    4,  8, 12, 16;
%e A402005    5, 10, 15, 20, 25;
%e A402005    6, 12, 18, 24, 30, 32;
%e A402005    7, 14, 21, 28, 31, 38, 45;
%e A402005    8, 16, 24, 32, 36, 44, 52, 60;
%e A402005    9, 18, 27, 32, 41, 50, 59, 68, 69;
%e A402005   10, 20, 30, 36, 46, 56, 66, 72, 78, 88;
%e A402005 ...
%e A402005 For n = k = 6, draw six equally spaced vertical lines and six equally spaced horizontal lines within a square circumscribed about the circle. These lines form 36 intersection points, of which 4 lie outside the circle (see illustration in Links). Hence T(6,6) = 32.
%t A402005 A402005[n_, k_] := Sum[Boole[(n + 1)^2*(2*j - k - 1)^2 < 4*i*(n + 1 - i)*(k + 1)^2], {i, n}, {j, k}];
%t A402005 Table[A402005[n, k], {n, 12}, {k, n}] (* _Paolo Xausa_, Nov 17 2026 *)
%o A402005 (Python)
%o A402005 def T(n, k):
%o A402005     return sum(
%o A402005         (2*i-n-1)**2 * (k+1)**2
%o A402005         + (2*j-k-1)**2 * (n+1)**2
%o A402005         < (n+1)**2 * (k+1)**2
%o A402005         for i in range(1, n+1)
%o A402005         for j in range(1, k+1))
%o A402005 print([T(n, k) for n in range(1, 12)
%o A402005        for k in range(1, n+1)])
%Y A402005 Cf. A051132, A088897, A088898, A088899, A383915.
%K A402005 nonn,tabl,new
%O A402005 1,2
%A A402005 _Eddie Lin Rui_, Nov 11 2026
