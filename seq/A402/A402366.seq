%I A402366 #20 Nov 27 2026 16:57:51
%S A402366 67171,138164,169195,180724,184091,184756,184819,282659,313690,325219,
%T A402366 328586,329251,329314,384683,396212,399579,400244,400307,427243,
%U A402366 430610,431275,431338,442139,442804,442867,446171,446234,446899,551956,582987,594516,597883,598548,598611
%N A402366 Numbers that are the sum of six distinct positive 6th powers.
%H A402366 Robert Israel, <a href="/A402366/b402366.txt">Table of n, a(n) for n = 1..10000</a>
%e A402366 a(1) = 1^6 + 2^6 + 3^6 + 4^6 + 5^6 + 6^6 = A031971(6) is clearly the smallest such number.
%e A402366 a(2) = 1^6 + 2^6 + 3^6 + 4^6 + 5^6 + 7^6 is the next larger such number, then
%e A402366 a(3) = 1^6 + 2^6 + 3^6 + 4^6 + 6^6 + 7^6 (5^6 is omitted),
%e A402366 a(4) = 1^6 + 2^6 + 3^6 + 5^6 + 6^6 + 7^6 (4^6 is omitted),
%e A402366 a(5) = 1^6 + 2^6 + 4^6 + 5^6 + 6^6 + 7^6 (3^6 is omitted),
%e A402366 a(6) = 1^6 + 3^6 + 4^6 + 5^6 + 6^6 + 7^6 (2^6 is omitted),
%e A402366 a(7) = 2^6 + 3^6 + 4^6 + 5^6 + 6^6 + 7^6 (1^6 is omitted).
%e A402366 We see that the first 7 terms are a(n) = a(7)+1 - (8-n)^6, 1 <= n <= 7.
%e A402366 Then the sequence goes on with 2 omitted terms among {k^6, 1 <= k <= 8}, then with 3 omitted terms among {k^6, 1 <= k <= 9}. This pattern breaks when m^6 < Sum_{k=m-6..m-1} k^6, which happens for m = 11. At this point, some sums with largest term 11^6 are smaller than some sums with largest term 10^6:
%e A402366 a(176) = 1792076 = 1^6 + 2^6 + 3^6 + 4^6 + 5^6 + 11^6 comes before
%e A402366 a(177) = 1794379 = 1^6 + 2^6 + 3^6 + 8^6 + 9^6 + 10^6; similar for
%e A402366 a(187) = 1823107 = 1^6 + 2^6 + 3^6 + 4^6 + 6^6 + 11^6, etc., and only
%e A402366 a(231) = 1973515 = 5^6 + 6^6 + 7^6 + 8^6 + 9^6 + 10^6 is the last sum with largest term 10^6.
%e A402366 The first number that arises as more than one sum is a(4495) = 19198660 = 1^6 + 3^6 + 5^6 + 8^6 + 14^6 + 15^6 = 2^6 + 3^6 + 7^6 + 9^6 + 11^6 + 16^6. - _Robert Israel_, Nov 24 2026
%p A402366 N:= 10^6: # for terms <= N
%p A402366 S:= {}:
%p A402366 for x1 from 1 while 6*x1^6 < N do
%p A402366   for x2 from x1+1 while x1^6 + 5*x2^6 < N do
%p A402366     for x3 from x2+1 while x1^6 + x2^6 + 4*x3^6 < N do
%p A402366       for x4 from x3+1 while x1^6 + x2^6 + x3^6 + 3*x4^6 < N do
%p A402366         for x5 from x4+1 while x1^6 + x2^6 + x3^6 + x4^6 + 2*x5^6 < N do
%p A402366           for x6 from x5+1 do
%p A402366             v:= x1^6 + x2^6 + x3^6 + x4^6 + x5^6 + x6^6;
%p A402366             if v > N then break fi;
%p A402366             S:= S union {v}
%p A402366 od od od od od od:
%p A402366 sort(convert(S,list)); # _Robert Israel_, Nov 24 2026
%o A402366 (PARI) A402366_first(n=50, k=6)=my(L=List(),m=k); while(#L<n^1.05, forvec(v=vector(k,i,[m^(i==k),m]), listput(L,sum(i=1,k,v[i]^k)), 2); m++); Set(L)[1..n]
%Y A402366 Cf. A001014 (sixth powers), A031971 (Sum k^n, k=1..n).
%Y A402366 Row 8 of A402364 (n-th row lists sums of n distinct n-th powers > 0).
%Y A402366 Other sequences of sums of k distinct positive k-th powers: A004431 (k = 2), A024975 (k = 3), A176197 (k = 4), A402365 (k = 5), A402367 (k = 7).
%K A402366 nonn,new
%O A402366 1,1
%A A402366 _M. F. Hasler_, Nov 17 2026
