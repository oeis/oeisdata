%T A402485 577,723,903,1123,1395,1722,2121,2605,3192,3892,4742,5753,6971,8421,
%U A402485 10153,12208,14660,17555,20990,25043,29828,35451,42080,49846,58964,69627,82104
%N A402485 Number of partitions of n such that (greatest part) / (least part) > number of parts.
%H A402485 Seiichi Manyama, <a href="/A402485/b402485.txt">Table of n, a(n) for n = 1..10000</a>
%F A402485 G.f.: Sum_{i>=0, j>=1} x^((i+1)*j) * (1 - Product_{k=1..i} (1 - x^(i*j+k))) / Product_{k=1..i} (1 - x^k).
%e A402485 a(10) = 12 because we have [9,1], [8,2], [8,1,1], [7,3], [7,2,1], [7,1,1,1], [6,3,1], [6,2,1,1], [6,1,1,1,1], [5,4,1], [5,3,1,1] and [5,2,2,1].
%t A402485 nmax = 50; CoefficientList[Series[Sum[x^((i + 1) j) (1 - Product[1 - x^(i j + k), {k, 1, i}])/Product[1 - x^k, {k, 1, i}], {i, 0, nmax}, {j, 1, Floor[nmax/(i + 1)]}], {x, 0, nmax}], x] // Rest
%Y A402485 Cf. A116902, A237833, A237870, A402484, A402486.
