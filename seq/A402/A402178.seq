%I A402178 #7 Nov 19 2026 21:51:09
%S A402178 1,1,2,3,6,12,22,40,73,131,234,411,702,1168,1909,3088,4978,8032,12980,
%T A402178 20963,33726,53927,85648,135199,212436,332754,520169,811925,1265400,
%U A402178 1968370,3054024,4722793,7273535
%N A402178 Number of distinct values at x = 1 of polynomials obtained after n steps starting from P(x) = 1 and repeatedly applying either P -> x*(x*P)' or P -> P(0) + Integral_{t=0..x} ((P(t) - P(0))/t) dt.
%C A402178 Since the second operation maps 1 to 1, the set S_n of reachable polynomials satisfies S_{n-1} subset S_n for all n >= 1, so a(n) also counts the distinct values at x = 1 obtained in at most n steps.
%C A402178 Equivalently, a(0) = 1 and for n >= 1, a(n) is the number of distinct positive rational numbers of the form k! / Product_{i=1..n-k} d_i, where 1 <= k <= n and 1 <= d_1 <= d_2 <= ... <= d_{n-k} <= k (with the empty product equal to 1).
%o A402178 (PARI)
%o A402178 f(P) = x*(x*P)';
%o A402178 g(P) = subst(P, x, 0) + intformal((P - subst(P, x, 0))/x);
%o A402178 seq(N) = {
%o A402178   my(res = vector(N), S = Set(x^0), F = S);
%o A402178   if(N >= 1, res[1] = 1);
%o A402178   for(n = 1, N - 1,
%o A402178     my(c = setunion(Set([f(P) | P <- F]), Set([g(P) | P <- F])));
%o A402178     F = setminus(c, S);
%o A402178     S = setunion(S, F);
%o A402178     res[n + 1] = #Set([subst(P, x, 1) | P <- S]);
%o A402178   );
%o A402178   res;
%o A402178 }
%o A402178 seq(25)
%Y A402178 Cf. A402177 (number of distinct polynomials before evaluating at x = 1).
%K A402178 nonn,more,new
%O A402178 0,3
%A A402178 _Luc Rousseau_, Nov 14 2026
%E A402178 a(30)-a(32) from _Sean A. Irvine_, Nov 19 2026
