%T A402416 7,7,3,6,11,2,3,14,31,3,13,2,13,11,5,5,23,3,3,7,7,2,5,6,31,10,3,2,29,
%U A402416 2,3,10,7,6,17,2,15,7,23,7,23,5,5,11,13,6,17,3
%N A402416 a(n) is the largest minimal element of cosets of (Z/nZ)*^2 in (Z/nZ)*, where (Z/nZ)* is the multiplicative group of integers modulo n and (Z/nZ)*^2 is the subgroup of squares.
%C A402416 a(n) is the largest element of the n-th row in A402418.
%C A402416 In other words, a(n) is the smallest k such that: For every i coprime to n, there exists 0 <= j <= k coprime to n such that i/j is a square modulo n.
%C A402416 If n = p^e*s for p odd prime, e >= 2, and gcd(p,s) = 1, since squares modulo n and squares modulo p*s are the same, we have a(n) = a(p*s). Similarly, if n = 2^e*s for e >= 4 and odd s, then a(n) = a(8*s).
%C A402416 For odd prime p, a(p) is the smallest quadratic nonresidue modulo p (A053760).
%H A402416 Jianing Song, <a href="/A402416/b402416.txt">Table of n, a(n) for n = 1..10000</a>
%e A402416 a(120) = 83, since (Z/120Z)*/(Z/120Z)*^2 = {{1, 49}, {7, 103}, {11, 59}, {13, 37}, {17, 113}, {19, 91}, {23, 47}, {29, 101}, {31, 79}, {41, 89}, {43, 67}, {53, 77}, {61, 109}, {71, 119}, {73, 97}, {83, 107}}, and the coset with the largest minimal element is {83, 107}.
%e A402416 a(840) = 311, since (Z/840Z)*/(Z/840Z)*^2 = {{1, 121, 169, 289, 361, 529}, ..., {311, 479, 551, 671, 719, 839}}.
%o A402416 (PARI) a(n) = vecmax(A402418_row(n)) \\ see A402418 for its program
%Y A402416 Cf. A402418, A053760.
%K A402416 nonn,new
