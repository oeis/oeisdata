%U A402504 2459559130353965641,130356633908760178921,7691041400616850556281,469153525437627883933081,31433286204321068223516361
%N A402504 a(n) = 4*prime(n)# + 1, where prime(n)# = A002110(n).
%C A402504 For n >= 1, a(n) is a pseudo-square (or a square) in the sense that it is congruent to 1 modulo 8 and a quadratic residue modulo every odd prime p <= prime(n).
%H A402504 Jianing Song, <a href="/A402504/b402504.txt">Table of n, a(n) for n = 0..350</a>
%t A402504 4*FoldList[Times, 1, Prime[Range[20]]] + 1 (* _Paolo Xausa_, Nov 22 2026 *)
%o A402504 (PARI) my(P=4); forprime(p=2, 100, print1(P+1, ", "); P*=p)
%Y A402504 Cf. A002189, A215658 (4*p#+1 being squares), A402440.
%Y A402504 See A402499 for a list of related sequences.
%K A402504 nonn,easy,new
%O A402504 0,1
