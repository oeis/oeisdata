%I A402056 #9 Nov 15 2026 08:16:06
%S A402056 1,8,16,27,81,125,128,216,256,343,432,625,648,1000,1296,1331,2000,
%T A402056 2048,2187,2197,2401,2744,3375,3456,4096,4913,5000,5488,6561,6859,
%U A402056 6912,9261,10000,10125,10368,10648,12167,14641,16000,16875,17496,17576,19208,20736,21296
%N A402056 Numbers k such that gcd(d_3(k^3), 6) = 1, where d_3 = A007425 is the 3rd Piltz function.
%C A402056 Numbers k such that d_3(k^3) is a 5-rough number (A007310).
%C A402056 Numbers whose prime factorization has only exponents that are congruent to 0 or 3 (mod 4) (A014601).
%H A402056 Amiram Eldar, <a href="/A402056/b402056.txt">Table of n, a(n) for n = 1..10000</a>
%H A402056 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%H A402056 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402056 a(n) = A402055(n)^(1/3).
%F A402056 Sum_{n>=1} 1/a(n) = Product_{p prime} (1 + 1/(p^3 - p^2 + p - 1)) = zeta(3) * zeta(4) / zeta(6) = 1.27883519645251737277... .
%e A402056 8 is a term since A007425(8^3) = 55, and gcd(55, 6) = 1.
%t A402056 f[p_, e_] := (3*e + 1)*(3*e + 2)/2; d33[n_] := Times @@ f @@@ FactorInteger[n]; d33[1] = 1; q[k_] := CoprimeQ[d33[k], 6]; Select[Range[22000], q]
%o A402056 (PARI) isok(k) = #select(e -> (e % 4 > 0 && e % 4 < 3), factor(k)[, 2]) == 0;
%Y A402056 Subsequence of A001694.
%Y A402056 A402058 is a subsequence.
%Y A402056 Cf. A007310, A007425, A014601, A252849 (d_3(k) is even), A252895 (d_3(k) is odd), A352475, A402055.
%Y A402056 Cf. A002117, A013662, A013664.
%K A402056 nonn,easy,new
%O A402056 1,2
%A A402056 _Amiram Eldar_, Nov 12 2026
