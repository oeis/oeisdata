%T A402487 7,12,1,2,5,8,1,6,1,4,3,2,1,16,13,10,7,4,1,6,7,8,5,2,1,20,1,2,17,32,
%U A402487 25,18,1,4,9,14,1,24,1,2,3,4,7,10,1,16,9,2,1
%N A402487 Total number of prime leaves in the binary partition tree of n, where each composite node k is split into floor(k/2) and ceiling(k/2).
%C A402487 a(n) = A094521(n) for n < 27.
%C A402487 For all even numbers n > 2, a(n) is even (every even number greater than 2 can be represented as the sum of an even number of primes). For all odd number n > 1, a(n) is odd (every odd number greater than 1 can be represented as the sum of an odd number of primes).
%H A402487 Chai Wah Wu, <a href="/A402487/b402487.txt">Table of n, a(n) for n = 2..10000</a>
%e A402487 a(35) = 7 because the partition tree for n = 35 has 7 prime leaves {17, 2, 2, 5, 2, 2, 5}:
%e A402487 .
%e A402487    2   2   2   2
%e A402487     \ /     \ /
%e A402487      4   5   4   5
%e A402487       \ /     \ /
%e A402487        9      9
%e A402487         \    /
%e A402487     17    18
%e A402487       \  /
%e A402487        35
%t A402487 A402487[n_] := A402487[n] = If[PrimeQ[n], 1, A402487[Quotient[n, 2]] + A402487[Ceiling[n/2]]];
%t A402487 Array[A402487, 100, 2] (* _Paolo Xausa_, Nov 27 2026 *)
%o A402487 (Python)
%o A402487 from sympy import isprime
%o A402487 from functools import lru_cache
%o A402487 @lru_cache(maxsize=None)
%o A402487 def A402487(n):
%o A402487     if isprime(n): return 1
%o A402487     return A402487(n//2) + A402487((n+1)//2)
%o A402487 print([A402487(n) for n in range(2, 84)])
%o A402487 (Python)
%o A402487 from collections import Counter
%o A402487 from sympy import isprime
%o A402487 def A402487(n):
%o A402487     m, d = 0, {n: 1}
%o A402487     while d:
%o A402487         e = Counter()
%o A402487         for v, c in d.items():
%o A402487             if isprime(v):
%o A402487                 m += c
%o A402487             else:
%o A402487                 e[v>>1] += c
%o A402487                 e[v+1>>1] += c
%o A402487         d = e
%o A402487     return m # _Chai Wah Wu_, Nov 27 2026
%o A402487 (PARI) {M402487=Map(); A402487(n)=if(isprime(n), 1, mapisdefined(M402487,n,&n),n, mapput(M402487, n, n=A402487(n\2)+A402487(n\/2));n)} \\ _M. F. Hasler_, Nov 19 2026
