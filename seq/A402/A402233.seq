%I A402233 #26 Nov 24 2026 21:28:33
%S A402233 1,1,1,1,2,1,1,4,4,1,1,6,11,6,1,1,9,25,25,9,1,1,12,49,76,49,12,1,1,16,
%T A402233 87,196,196,87,16,1,1,20,144,440,635,440,144,20,1,1,25,225,900,1764,
%U A402233 1764,900,225,25,1,1,30,336,1700,4356,5926,4356,1700,336,30,1
%N A402233 Triangle T(n,k) read by rows: Weighted count of pairs of binary necklaces of length n, one containing k black beads and the other n-k black beads, with relatively prime repetition counts. Each pair contributes the reciprocal of the product of its repetition counts.
%C A402233 The triangle T(n, k) starts with n = 2, where k counts from 1 to n-1. Not shown in the triangle is T(1, 0) = 1 and T(1, 1) = 1 and T(n, 0) = 0 for n > 1. The row sums of the triangle are given by A268619(n).
%C A402233 T(n, k) count interleavings of pairs of binary necklaces of length n, with k and n-k black beads, respectively, whose resulting 2n-bead necklace has no nontrivial period starting at an even position. Divide the number of such interleavings by n.
%C A402233 Every entry is an integer because it counts pairs of binary necklaces satisfying the stated coprimality condition, with each pair weighted by the reciprocal of the product of its repetition counts (p, q). Equivalently, each such pair has exactly n^2/(p*q) distinct pairs of linear representatives, so the weighted sum is the number of admissible pairs of linear representatives divided by n^2.
%H A402233 Paolo Xausa, <a href="/A402233/b402233.txt">Table of n, a(n) for n = 2..11176</a> (rows 2..150 of triangle, flattened).
%F A402233 T(n, k) = (1/n^2)* Sum_{d|gcd(n, k)} A008683(d)*binomial(n/d, k/d)^2.
%F A402233 T(n, 2) = T(n, n-2) = A002620(n-1).
%F A402233 Product_{n>=1} Product_{k=0..n} (1 - x^n*y^k)^(-n*T(n, k)) = Sum_{l>=0} (Sum_{m>=0} A001263(l+1, m+1)*y^m)*x^l.
%F A402233 Product_{n>=1} Product_{k=0..n} (1 - x^n*y^k)^T(n, k) = Sum_{l>=0} (Sum_{m>=0} T327913(l, m)*y^m)*x^l. T327913(l, m) means the interpretation of the array A327913 as triangle by rows.
%e A402233 The triangle T(n, k) starts:
%e A402233    n\k  1  2  3  4  5  6  7  ...
%e A402233    2:   1
%e A402233    3:   1  1
%e A402233    4:   1  2  1
%e A402233    5:   1  4  4  1
%e A402233    6:   1  6 11  6  1
%e A402233    7:   1  9 25 25  9  1
%e A402233    8:   1 12 49 76 49 12  1
%e A402233 .
%e A402233 Example for n=6 and k=1:
%e A402233  000001       111110
%e A402233  p=1          q=1
%e A402233  Weight = 1/(p*q) = 1.
%e A402233 Example for n=6 and k=2:
%e A402233  The three necklaces with two black beads are:
%e A402233   000011       000101       001001
%e A402233   p=1          p=1          p=2
%e A402233  Their complementary necklaces are:
%e A402233   111100       111010       110110
%e A402233   q=1          q=1          q=2
%e A402233  All nine possible pairs, except the pair with both repetition counts equal to 2, are admissible. Their total contribution is:
%e A402233   2*2 pairs with weight 1       = 4
%e A402233   2*2 pairs with weight 1/2     = 2
%e A402233  -----------------------------------
%e A402233   Total                         = 6.
%e A402233 Example for n=6 and k=3:
%e A402233  The four necklaces with three black beads are:
%e A402233   000111       001011       001101       010101
%e A402233   p=1          p=1          p=1          p=3
%e A402233  Here the complementary necklaces are the same four necklaces (up to rotation).
%e A402233  The pair with both repetition counts equal to 3 is excluded.
%e A402233   3*3 pairs with weight 1       = 9
%e A402233   3*1 pairs with weight 1/3     = 1
%e A402233   1*3 pairs with weight 1/3     = 1
%e A402233  -----------------------------------
%e A402233   Total                         = 11.
%t A402233 A402233[n_, k_] := DivisorSum[GCD[n, k], MoebiusMu[#]*Binomial[n/#, k/#]^2 &]/n^2;
%t A402233 Table[A402233[n, k], {n, 2, 15}, {k, n - 1}] (* _Paolo Xausa_, Nov 24 2026 *)
%o A402233 (PARI) T(n, k) = sumdiv(gcd(n, k) , d, moebius(d)*binomial(n/d, k/d)^2)/n^2
%Y A402233 Cf. A001263, A002620, A008683, A327913.
%Y A402233 Cf. A268619 (row sums).
%K A402233 nonn,tabl,new
%O A402233 2,5
