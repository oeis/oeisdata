%S A402781 1,3,6,6,15,21,28,32,36,55,66,54,91,105,120,104,153,144,190,150,231,
%T A402781 253,276,264,300,351,351,294,435,465,496,448,561,595,630,432,703,741,
%U A402781 780,720,861,903,946,726,900,1081,1128,936,1176,1200,1326,1014,1431,1377,1540
%N A402781 Sum of the integers k from 1 to n such that gcd(n, k) is an exponentially odd number.
%C A402781 The number of these integers is A384041(n).
%H A402781 Amiram Eldar, <a href="/A402781/b402781.txt">Table of n, a(n) for n = 1..10000</a>
%F A402781 a(n) = Sum_{k=1..n, gcd(n, k) is exponentially odd} k = Sum_{k=1..n} A295316(gcd(n, k)) * k.
%F A402781 a(n) = n * (A295316(n) + A384041(n)) / 2.
%F A402781 Dirichlet g.f.: (1 + zeta(s-2)/zeta(s-1)) * (zeta(2*s-2)/2) * Product_{p prime} (1 + 1/p^(s-1) - 1/p^(2*s-2)).
%F A402781 Sum_{k=1..n} a(k) ~ c * n^3 / 6, where c = Product_{p prime} (1 - 1/p^2 + 1/(p^2+1)) = 0.93749428273130025078... .
%t A402781 f1[p_, e_] := Mod[e, 2];
%t A402781 f2[p_, e_] := (p^(e + 1) + p^e - p^(e - 1) - (-1)^e)/(p + 1);
%t A402781 a[1] = 1; a[n_] := Module[{f = FactorInteger[n]}, (n/2)*(Times @@ f1 @@@ f + Times @@ f2 @@@ f)]; Array[a, 55]
%o A402781 (PARI) a(n) = {my(f = factor(n)); (prod(i = 1, #f~, f[i, 2] % 2) + prod(i = 1, #f~, ((f[i, 1]^2+f[i, 1]-1)*f[i, 1]^(f[i, 2]-1) - (-1)^f[i, 2])/(f[i, 1] + 1))) * n /2;}
%Y A402781 Cf. A268335, A295316, A384041.
%Y A402781 Sum of the integers k from 1 to n such that gcd(n, k) is: A023896 (1), A119790 (prime power, A246655), A390800 (power of prime, A000961), A390801 (prime), A390802 (odd), A390803 (5-rough), A390804 (power of 2), A390805 (3-smooth), A390806 (squarefree), A390807 (cubefree), A390808 (square), A390809 (1 or 2), A402778 (cube), A402779 (powerful), A402780 (cubefull), this sequence (exponentially odd).
%K A402781 nonn,easy,new
%O A402781 1,2
