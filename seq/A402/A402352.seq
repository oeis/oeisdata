%t A402352 nn = 225; r = 4; rad[x_] := Times @@ FactorInteger[x][[All, 1]]; s = Select[Range[nn], Nor[SquareFreeQ[#], Divisible[#, rad[#]^2] ] &]; Reap[Do[k = s[[i]]; If[# > r, r = #, Sow[k]] &[DivisorSigma[0, k] ], {i, Length[s] }] ][[-1, 1]]
