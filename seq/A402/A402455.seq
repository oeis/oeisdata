%N A402455 a(n) = 1 + Sum_{k=1..n} k^n * a(n-k).
%H A402455 Seiichi Manyama, <a href="/A402455/b402455.txt">Table of n, a(n) for n = 0..110</a>
%F A402455 G.f. A(x) satisfies A(x) = 1/(1-x) + Sum_{k>=1} (k*x)^k * A(k*x).
%o A402455 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, j^i*v[i-j+1])); v;
