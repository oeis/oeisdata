%S A402244 1,2,3,2,5,6,7,2,3,10,11,6,13,14,15,16,17,6,19,10,21,22,23,6,5,26,3,
%T A402244 14,29,30,31,32,33,34,35,6,37,38,39,10,41,42,43,22,15,46,47,48,7,10,
%U A402244 51,26,53,6,55,14,57,58,59,30,61,62,21,32,65,66,67,34,69,70
%N A402244 Largest divisor of n that is a term in A252895.
%C A402244 First differs from A386469 at n = 32.
%C A402244 The number of these divisors is A365171(n), and their sum is A402243(n).
%H A402244 Amiram Eldar, <a href="/A402244/b402244.txt">Table of n, a(n) for n = 1..10000</a>
%F A402244 a(n) <= n, with equality if and only if n is in A252895.
%F A402244 Multiplicative with a(p^e) = 4*floor(e/4) + min((e mod 4), 1).
%F A402244 Dirichlet g.f.: zeta(4*s-4) * Product_{p prime} (1 + 1/p^(s-1) + 1/p^(2*s-1) + 1/p^(3*s-1)).
%F A402244 Sum_{k=1..n} a(k) ~ c * zeta(4) * n^2 / 2, where c = Product_{p prime} (1 - 1/p^2 + 1/p^3 - 1/p^4 + 1/p^5 - 1/p^6) = 0.69976901953539632879... .
%t A402244 f[p_, e_] := p^(4*Floor[e/4] + Min[Mod[e, 4], 1]); a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 70]
%o A402244 (PARI) a(n) = vecprod([f[1]^(4*(f[2]\4) + min(f[2] % 4, 1)) | f <- factor(n)~]);
%Y A402244 Cf. A013662, A252895, A365171, A386469, A402243.
%K A402244 nonn,mult,easy,new
%O A402244 1,2
%A A402244 _Amiram Eldar_, Nov 16 2026
