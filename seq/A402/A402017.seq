%U A402017 8,0,5,7,9,6,9,5,2,2,4,3,5,0,4,3,3,0,8,2
%N A402017 Decimal expansion of L'(1,chi_{-8})/L(1,chi_{-8}) negated, where chi_{-8} is the Dirichlet character kronecker(-8,.).
%F A402017 Equals A402011 - (log Gamma(1/8) + log Gamma(3/8) - log Gamma(5/8) - log Gamma(7/8)).
%e A402017 L'(1,chi_{-8})/L(1,chi_{-8}) = -0.02071140579929095887...
%o A402017 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402017 f(-8)
%o A402017 (PARI) f(D) = my(h = qfbclassno(D)); log(2*Pi) + Euler() - (1/h) * sum(a=1, abs(D), kronecker(D,a)*lngamma(a/abs(D))); \\ D < -4 is a fundamental discriminant
%o A402017 f(-8)
%Y A402017 Cf. A188510 (chi_{-8}). See A402011 for related sequences.
%K A402017 nonn,cons,new
%O A402017 -1,1
