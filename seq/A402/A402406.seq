%I A402406 #4 Nov 24 2026 21:58:57
%S A402406 3,13,37,109,1217,196247
%N A402406 Smallest possible largest element of a set of 2^n distinct primes forming an n-dimensional Hilbert cube {m + Sum_{i in S} s(i) : S subset of {1..n}} with integers 0 < s(1) < ... < s(n).
%C A402406 The cube is nondegenerate: all 2^n subset sums are distinct. Its smallest element m is prime and its diameter is s(1)+...+s(n).
%C A402406 If all 2^n elements are prime with smallest element p, then n < p: among the partial sums of any p axes two are congruent mod p, giving an element > p divisible by p. Hence m >= 7 for n = 5, 6.
%C A402406 a(6) was found and proved minimal by an exhaustive search over all bases m and all axes with every element <= 320000, done by two independent programs (CPU and GPU) with identical search-tree node counts. The cube in the Example is the only 6-dimensional Hilbert cube of primes with all elements <= 320000.
%C A402406 A cube of 2^n primes all greater than 2^n is admissible, so its diameter is at least A398220(n).
%e A402406 a(1) = 3: {2, 3}.
%e A402406 a(2) = 13: 3 + {0,2,8,10} = {3,5,11,13}, and also 5 + {0,2,6,8} = {5,7,11,13}.
%e A402406 a(3) = 37: m = 5, axes (6,8,18): 5, 11, 13, 19, 23, 29, 31, 37.
%e A402406 a(4) = 109: m = 11, axes (6,20,30,42).
%e A402406 a(5) = 1217: m = 43, axes (66,120,270,340,378).
%e A402406 a(6) = 196247: m = 883, axes (648,1330,6996,40530,67050,78810); the 64 primes range from 883 to 196247.
%o A402406 (Python)
%o A402406 from sympy import isprime, primerange
%o A402406 def a(n):  # a(1..5) in a few minutes
%o A402406     X = 2
%o A402406     while True:
%o A402406         X += 1
%o A402406         if not isprime(X): continue
%o A402406         for m in primerange(2, X):
%o A402406             def rec(k, last, rem, S):
%o A402406                 if k == n: return rem == 0
%o A402406                 r, s = n - k, last + 1
%o A402406                 while s*r + r*(r-1)//2 <= rem:
%o A402406                     T = [t + s for t in S]
%o A402406                     if all(isprime(m + t) for t in T) and not set(T) & set(S):
%o A402406                         if rec(k+1, s, rem - s, S + T): return True
%o A402406                     s += 1
%o A402406                 return False
%o A402406             if rec(0, 0, X - m, [0]): return X
%o A402406 print([a(n) for n in range(1, 6)])
%Y A402406 Cf. A000040, A398220.
%K A402406 nonn,hard,more,new
%O A402406 1,1
