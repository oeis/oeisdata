%U A402449 3374111298327620829,156430495112494738400,7702339859474384070038,401410352949072254479749,22075008212550273863992151
%N A402449 a(n) = 1 + Sum_{k=1..n} binomial(2*n+k,k) * a(n-k).
%F A402449 G.f. A(x) satisfies A(x) = (1-3*x) * (2*A(z) - 1/(1-z)), where z = x*(1-x)^2.
%o A402449 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(2*i+j, j)*v[i-j+1])); v;
%Y A402449 Cf. A402260, A402450.
