%T A402025 1,1,9,3,3,5,0,0,3,7,4,3,3,0,2,2,4,6,2,5,0,3,6,9,4,2,2,3,5,4,8,3,9,9,
%U A402025 2,8,6,9,2,4,1,9,7,9,1,1,6,4,3,8,6,3,8,2
%N A402025 Decimal expansion of L'(1,chi_21)/L(1,chi_21), where chi_21 is the Dirichlet character kronecker(21,.).
%F A402025 Equals A402011 - (1/(2*log((5+sqrt(21))/2))) * Sum_{a=1..21} Jacobi(a,21)*zeta''(0,a/21), where zeta''(s,x) is the second partial derivative of the Hurwitz zeta function with respect to s.
%e A402025 L'(1,chi_21)/L(1,chi_21) = 0.33897248420075331238...
%o A402025 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402025 f(21)
%o A402025 (PARI) f(D) = my([h, loge] = vecextract(quadclassunit(D), [1,4])); log(2*Pi) + Euler() - (1/(2*h*loge)) * sum(a=1, D, kronecker(D,a)*zetahurwitz(0, a/D, 2)); \\ D > 0 is a fundamental discriminant
%o A402025 f(21)
%Y A402025 Cf. A322829 (chi_21). See A402011 for related sequences.
%K A402025 nonn,cons,new
%O A402025 0,1
