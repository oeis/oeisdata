%I A402779 #9 Nov 27 2026 12:30:47
%S A402779 1,1,3,8,10,6,21,28,36,20,55,36,78,42,60,104,136,63,171,120,126,110,
%T A402779 253,144,275,156,297,252,406,120,465,400,330,272,420,396,666,342,468,
%U A402779 480,820,252,903,660,630,506,1081,576,1078,525,816,936,1378,567,1100,1008
%N A402779 Sum of the integers k from 1 to n such that gcd(n, k) is a powerful number.
%C A402779 The number of these integers is A384039(n).
%H A402779 Amiram Eldar, <a href="/A402779/b402779.txt">Table of n, a(n) for n = 1..10000</a>
%H A402779 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402779 a(n) = Sum_{k=1..n, gcd(n, k) is powerful} k = Sum_{k=1..n} A112526(gcd(n, k)) * k.
%F A402779 a(n) = n * (A112526(n) + A384039(n)) / 2.
%F A402779 Dirichlet g.f.: (1 + zeta(s-2)/zeta(s-1)) * zeta(2*s-2) * zeta(3*s-3) / (2*zeta(6*s-6)).
%F A402779 Sum_{k=1..n} a(k) ~ c * n^3, where c = 15015/(1382*Pi^4) = 0.11153670300585042899... .
%t A402779 f1[p_, e_] := Boole[e > 1];
%t A402779 f2[p_, e_] := If[e == 1, p - 1, p^(e-2)*(p^2 - p + 1)]; a[1] = 1;
%t A402779 a[n_] := Module[{f = FactorInteger[n]}, (n/2)*(Times @@ f1 @@@ f + Times @@ f2 @@@ f)]; Array[a, 56]
%o A402779 (PARI) a(n) = {my(f = factor(n)); (prod(i = 1, #f~, f[i, 2] > 1) + prod(i = 1, #f~, if(f[i, 2] == 1, f[i, 1] - 1, f[i, 1]^(f[i, 2]-2)*(f[i, 1]^2 - f[i, 1] + 1)))) * n /2;}
%Y A402779 Cf. A001694, A112526, A384039.
%Y A402779 Sum of the integers k from 1 to n such that gcd(n, k) is: A023896 (1), A119790 (prime power, A246655), A390800 (power of prime, A000961), A390801 (prime), A390802 (odd), A390803 (5-rough), A390804 (power of 2), A390805 (3-smooth), A390806 (squarefree), A390807 (cubefree), A390808 (square), A390809 (1 or 2), A402778 (cube), this sequence (powerful), A402780 (cubefull), A402781 (exponentially odd).
%K A402779 nonn,easy,new
%O A402779 1,3
%A A402779 _Amiram Eldar_, Nov 27 2026
