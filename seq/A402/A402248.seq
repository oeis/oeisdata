%I A402248 #7 Nov 16 2026 07:26:34
%S A402248 1,3,4,7,6,12,8,15,13,18,12,28,14,24,24,27,18,39,20,42,32,36,24,60,31,
%T A402248 42,40,56,30,72,32,51,48,54,48,91,38,60,56,90,42,96,44,84,78,72,48,
%U A402248 108,57,93,72,98,54,120,72,120,80,90,60,168,62,96,104,127,84,144
%N A402248 Sum of divisors d of n such that gcid(d, n/d) is an exponentially odd number, where gcid is the greatest common infinitary divisor.
%C A402248 First differs from at A365170, A365174 and A402247 at n = 64.
%C A402248 The number of these divisors is A400141(n).
%H A402248 Amiram Eldar, <a href="/A402248/b402248.txt">Table of n, a(n) for n = 1..10000</a>
%F A402248 Multiplicative with a(p^e) = isigma(p^e) if e is odd, and isigma(p^e) + p*(p^e - 1)/(p^2 - 1) if e is even, where isigma(n) = A049417(n).
%F A402248 Sum_{k=1..n} a(k) ~ c * n^2, where c = (zeta(2)/2) * Product_{p prime} ((1-1/p)*(1-1/p^2) * Product_{k>=1} (1 + 1/p^(2^k) + 1/p^(2^(k+1))) + 1/(p^3*(1-1/p)*(1-1/p^2))) = 0.81223686576362981786... .
%t A402248 f[p_, e_] := Times @@ (1 + Flatten[p^(2^(-1 + Position[Reverse@ IntegerDigits[e, 2], _?(# == 1 &)]))]) + If[OddQ[e], 0, p*(p^e - 1)/(p^2 - 1)]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 66]
%o A402248 (PARI) a(n) = {my(f = factor(n), d); prod(i = 1, #f~, d = binary(f[i, 2]); prod(k = 1, #d, if(d[k], 1 + f[i, 1]^(2^(#d - k)), 1)) + if(f[i, 2] % 2, 0, f[i, 1]*(f[i, 1]^f[i, 2] - 1)/(f[i, 1]^2 - 1))); }
%Y A402248 Cf. A049417, A077609, A268335, A365170, A365174, A390370, A400137, A400141.
%Y A402248 Sum of divisors d of n such that gcid(d, n/d) is: A049417 (1), A400144 (square), A400145 (odd), A400146 (power of 2), A402247 (squarefree), this sequence (exponentially odd), A402249 (powerful).
%K A402248 nonn,mult,easy,new
%O A402248 1,2
%A A402248 _Amiram Eldar_, Nov 16 2026
