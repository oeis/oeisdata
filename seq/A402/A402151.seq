%I A402151 #7 Nov 27 2026 23:47:00
%S A402151 1,3,10,20,30,40,42,60,84,90,120,150,168,180,210,252,270,300,320,330,
%T A402151 360,400,420,450,504,540,600,630,640,672,720,750,800,840,900,960,1008,
%U A402151 1050,1080,1200,1260,1320,1350,1440,1470,1500,1512,1600,1620,1680,1764
%N A402151 Positions of first appearances in A402147. Indices k such that A402147(k) is different from A402147(j) for all j < k, where A402147(n) counts non-1-based restricted growth permutations of prime indices of n.
%C A402151 A 1-based restricted growth sequence of length j is a sequence (a_1, ..., a_j), satisfying a_1 = 1 and a_i <= 1 + max(a_1, ..., a_{i-1}) for all i = 2, 3, ..., j. We also include the empty sequence.
%C A402151 A prime index of n is a number m such that prime(m) divides n. The multiset of prime indices of n is row n of A112798, sum A056239.
%e A402151 a(7) = 60 because A402147(60) = 9 is the first appearance of 9 in A402147, corresponding to the following non-1-based restricted growth permutations of prime indices: (1132), (1312), (1321), (2113), (2131), (2311), (3112), (3121), (3211). Not included are: (1123), (1213), (1231).
%e A402151 The a(n) permutations for selected n:
%e A402151   n=3  n=10   n=20   n=30   n=40    n=42   n=60    n=84
%e A402151   (2)  (13)  (113)  (132)  (1113)  (124)  (1132)  (1124)
%e A402151        (31)  (131)  (213)  (1131)  (142)  (1312)  (1142)
%e A402151              (311)  (231)  (1311)  (214)  (1321)  (1214)
%e A402151                     (312)  (3111)  (241)  (2113)  (1241)
%e A402151                     (321)          (412)  (2131)  (1412)
%e A402151                                    (421)  (2311)  (1421)
%e A402151                                           (3112)  (2114)
%e A402151                                           (3121)  (2141)
%e A402151                                           (3211)  (2411)
%e A402151                                                   (4112)
%e A402151                                                   (4121)
%e A402151                                                   (4211)
%t A402151 prix[n_]:=If[n==1,{},Flatten[Cases[FactorInteger[n],{p_,k_}:>Table[PrimePi[p],{k}]]]];
%t A402151 rgoQ[y_]:=y=={}||y[[1]]==1&&And@@Table[y[[i]]<=1+Max@@Take[y,i-1],{i,2,Length[y]}];
%t A402151 fur[q_]:=Select[Range[Length[q]],FreeQ[Take[q,#-1],q[[#]]]&]
%t A402151 fur[Table[Length[Select[Permutations[prix[n]],!rgoQ[#]&]],{n,1000}]]
%Y A402151 Allowing restricted growth gives A358526.
%Y A402151 These are positions of first appearances in A402147.
%Y A402151 For normal partitions we have firsts in A402149, complement A402150.
%Y A402151 The complement is counted by A402152, firsts in A402146.
%Y A402151 A008480 counts permutations of prime indices.
%Y A402151 A055932 ranks normal partitions, counted by A047967.
%Y A402151 A080259 ranks non-normal partitions, counted by A000065.
%Y A402151 A107429 counts normal compositions, ranks A333217.
%Y A402151 A383253 counts 1-based restricted growth compositions, ranks A402139.
%Y A402151 A402138 counts non-1-based restricted growth compositions, ranks A402141.
%Y A402151 Cf. A001227, A008277, A011782, A383713, A401975, A402140, A402142.
