%U A402582 1,5,0,1,1,59,0,13,0,1,11,1,1,5,0,11,4,1,0,31,1,1,1,3,0,41,1,1,1,1,1,17,0,11,2
%N A402582 Variant of primorial base mongrel derivative A402581: Compute otherwise like A342002, but take the exponents e from the prime factorization of n, like A342001 (arithmetic derivative without its inherited divisor) does.
%H A402582 Antti Karttunen, <a href="/A402582/b402582.txt">Table of n, a(n) for n = 1..16170</a>
%H A402582 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%o A402582 (PARI) A402582(n) = { my(orgn=n,s=0, p=2); while(n, s += (valuation(orgn,p)/p); n = n\p; p = nextprime(1+p)); numerator(s); };
%Y A402582 Cf. A402583 (denominators).
%Y A402582 Cf. also A342001, A342002, A402581.
%K A402582 nonn,easy,frac,new
%O A402582 1,6
%A A402582 _Antti Karttunen_, Nov 21 2026
