%I A402394 #14 Nov 27 2026 11:15:29
%S A402394 0,1,2,1,3,1,4,1,1,5,2,1,1,6,2,1,1,7,2,1,1,1,3,1,8,2,1,1,1,3,1,9,2,1,
%T A402394 1,1,3,2,1,10,1,2,1,4,1,1,1,3,2,1,11,1,2,1,1,4,1,1,1,3,2,1,12,1,2,1,1,
%U A402394 4,2,1,1,1,1,1,3,2,1,1,5,13,1,2,1,1,4,2,1,1,1,1
%N A402394 a(n) = minimum exponent in the prime factorization of A025487(n).
%C A402394 If a(n) != 1 then A025487(n) is in A001694 and A181800, if a(n) = 1 then A025487(n) is not in A001694 or A181800.
%H A402394 Zhicheng Wei, <a href="/A402394/b402394.txt">Table of n, a(n) for n = 1..10000</a>
%H A402394 Michael De Vlieger, <a href="/A402394/a402394.png">Log log scatterplot of a(n)</a>, n = 2..2^20.
%F A402394 a(n) = A051904(A025487(n)).
%e A402394 a(30) = 3 because A025487(30) = 432, while 432 = 2^4*3^3, and the smallest prime power is 3.
%o A402394 (PARI)
%o A402394 A051904(n)=if(n>1, vecmin(factor(n)[, 2]), 0)
%o A402394 A283980(n) = {my(f=factor(n)); prod(i=1, #f~, my(p=f[i, 1], e=f[i, 2]); if(p==2, 6, nextprime(p+1))^e)};
%o A402394 A025487list(e) = { my(lista = List([1, 2]), i=2, u = 2^e, t); while(lista[i] != u, if(2*lista[i] <= u, listput(lista, 2*lista[i]); t = A283980(lista[i]); if(t <= u, listput(lista, t))); i++); vecsort(Vec(lista)); }; \\ Returns a list of terms up to the term 2^e.
%o A402394 v025487 = A025487list(101);
%o A402394 A025487(n) = v025487[n];
%o A402394 A402394(n) = A051904(A025487(n))
%Y A402394 Cf. A025487, A051904.
%K A402394 nonn,new
%O A402394 1,3
%A A402394 _Zhicheng Wei_, Nov 18 2026
