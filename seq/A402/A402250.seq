%U A402250 3854214846217872079,174460877104408443831,8399875057467046124998,428650741558518244388997
%N A402250 a(n) = 1 + Sum_{k=1..n} binomial(2*n-1,k) * a(n-k).
%F A402250 G.f. A(x) satisfies A(x) = (1-x) * (2*A(z) - 1/(1-z)), where z = x/(1+x)^2.
%o A402250 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(2*i-1, j)*v[i-j+1])); v;
%Y A402250 Cf. A398734, A402251, A402252.
