%F A402561 G.f.: (2*x^26 +2*x^25 -4*x^24 +2*x^23 -6*x^22 -52*x^21 -96*x^20 -54*x^19 +34*x^18 +55*x^17 +67*x^16 +123*x^15 +143*x^14 +71*x^13 -34*x^12 -97*x^11 -85*x^10 -15*x^9 +24*x^8 +24*x^7 -24*x^6 -42*x^5 -16*x^4 -3*x^3 -1) / ((x-1)*(x^15 +3*x^14 +4*x^13 +2*x^12 +x^11 -2*x^9 -5*x^8 -7*x^7 -5*x^6 -x^5 -x^4 -x^3 -x^2 +1)).
%e A402561 a(7) = 178: 1234567, 1234576, 1234657, 1234675, ..., 7654213, 7654231, 7654312, 7654321. The complete list ist given in the linked file above.
%p A402561 b:= proc(s, w, x, y) option remember; `if`(s={}, 1, add(
%p A402561       `if`((w=0 or abs(w-j)<=5) and (x=0 or abs(x-j)<=4) and
%p A402561            (y=0 or abs(y-j)<=3), b(s minus {j}, x, y, j), 0), j=s))
%p A402561     end:
%p A402561 a:= n-> b({$1..n}, 0$3):
%p A402561 seq(a(n), n=0..20);
