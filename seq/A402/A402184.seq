%I A402184 #10 Nov 22 2026 22:16:10
%S A402184 1,2,2,6,2,4,2,14,11,4,2,20,2,4,4,30,2,31,2,28,4,4,2,52,27,4,38,36,2,
%T A402184 8,2,62,4,4,4,83,2,4,4,76,2,8,2,52,58,4,2,116,51,79,4,60,2,112,4,100,
%U A402184 4,4,2,104,2,4,76,126,4,8,2,76,4,8,2,187,2,4,104,84,4,8,2,172,119,4,2,136,4,4,4,148
%N A402184 a(n) = Sum_{d|n} d^(1 - mu(d)^2).
%C A402184 Number of squarefree divisors of n plus the sum of the divisors of n that are not squarefree.
%C A402184 For each divisor d of n, add 1 if d is squarefree, else add d.
%C A402184 Inverse Möbius transform of n^c(n), where c = A107078.
%H A402184 Michael De Vlieger, <a href="/A402184/b402184.txt">Table of n, a(n) for n = 1..10000</a>
%F A402184 a(n) = sigma(n) - sigma(rad(n)) + tau(rad(n)).
%F A402184 a(n) = A000203(n) - A048250(n) + A034444(n).
%F A402184 a(n) = A000203(n) - A065608(A007947(n)).
%t A402184 Table[Sum[d^(1 - MoebiusMu[d]^2), {d, Divisors[n]}], {n, 100}]
%Y A402184 Cf. A000005 (tau), A000203 (sigma), A005117, A007947 (rad), A008683 (mu), A034444, A048250, A107078, A344465, A402379.
%K A402184 nonn,easy,new
%O A402184 1,2
%A A402184 _Wesley Ivan Hurt_, Nov 14 2026
