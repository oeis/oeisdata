%I A402531 #8 Nov 20 2026 12:57:53
%S A402531 36,100,144,196,216,225,324,400,441,484,576,676,784,1000,1089,1156,
%T A402531 1225,1296,1444,1521,1600,1728,1936,2025,2116,2304,2500,2601,2704,
%U A402531 2744,2916,3025,3136,3249,3364,3375,3844,3969,4225,4624,4761,5184,5476,5625,5776,5832,5929
%N A402531 Perfect powers that have exactly 2 distinct prime factors.
%C A402531 Numbers of the form p^k * q^m where p and q are distinct primes, and gcd(k, m) >= 2.
%C A402531 The least roots (see A025478) of the terms are either terms in A084227 or terms in A393816.
%H A402531 Amiram Eldar, <a href="/A402531/b402531.txt">Table of n, a(n) for n = 1..10000</a>
%H A402531 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402531 Sum_{n>=1} 1/a(n) = Sum_{n>=1} 1/(A084227(n)*(A084227(n)-1)) + Sum_{n>=1} 1/(A393816(n)*(A393816(n)-1)).
%F A402531 Sum_{n>=1} 1/a(n) = Sum_{k>=2} mu(k) * (Sum_{p prime} (1/(p^k-1)^2) - (Sum_{p prime} (1/p^k-1))^2)/2 = 0.095651419301016496002..., where mu is the Moebius function (A008683).
%e A402531   n | a(n) | factorization
%e A402531   --+------+--------------
%e A402531   1 |   36 |    2^2 * 3^2
%e A402531   2 |  100 |    2^2 * 5^2
%e A402531   3 |  144 |    2^4 * 3^2
%e A402531   4 |  196 |    2^2 * 7^2
%e A402531   5 |  216 |    2^3 * 3^3
%t A402531 q[k_] := Module[{e = FactorInteger[k][[;; , 2]]}, Length[e] == 2 && GCD @@ e > 1]; Select[Range[6000], q]
%o A402531 (PARI) isok(k) = {my(e = factor(k)[, 2]); #e == 2 && gcd(e) > 1;}
%Y A402531 Intersection of A001597 and A007774.
%Y A402531 Complement of A393816 within A355462.
%Y A402531 Subsequences of A007774: A006881 (squarefree), A033845 (3-smooth), A084227 (nonpowerful), A200511 (nonsquarefree), A355462 (powerful), A303661 (powers of squarefree semiprimes), A393816 (Achilles), this sequence (perfect powers).
%Y A402531 Cf. A001694, A008683, A025478.
%K A402531 nonn,easy,new
%O A402531 1,1
%A A402531 _Amiram Eldar_, Nov 20 2026
