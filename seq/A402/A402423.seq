%N A402423 Least m > 1 such that 4*prime(n)# - m is prime, where prime(n)# = A002110(n).
%C A402423 The first 1000 terms are primes.
%H A402423 Jianing Song, <a href="/A402423/b402423.txt">Table of n, a(n) for n = 1..1000</a>
%e A402423 n = 1: largest prime < 8-1 is 5 = 803;
%e A402423 n = 2: largest prime < 8*3-1 is 19 = 8*3-5;
%e A402423 n = 3: largest prime < 8*3*5-1 is 113 = 8*3*5-7;
%e A402423 n = 4: largest prime < 8*3*5*7-1 is 829 = 8*3*5*7-11;
%e A402423 n = 5: largest prime < 8*3*5*7*11-1 is 9227 = 8*3*5*7*11-13.
%o A402423 (PARI) my(P=4); forprime(p=2, 1000, P*=p; print1(P-precprime(P-2), ", "))
%Y A402423 Cf. A002110 (primorials), A102476 (4 times primorials), A005235, A055211.
%Y A402423 Cf. A402422, A402429 (prime(n) such that a(n) = prime(n+1)).
