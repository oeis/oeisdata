%S A402505 7,79,559,3079,40039,1361359,25865839,297457159,17252515279,
%T A402505 534827973679,19788635026159,405667018036279,17443681775560039,
%U A402505 1639706086902643759,43452211302920059639,5127360933744567037519,312769016958418589288719,20955524136214045482344239,743921106835598614623220519
%N A402505 a(n) is the number equal to either (4/3)*prime(n)# - 1 or (8/3)*prime(n)# - 1 that is not divisible by 3, where prime(n)# = A002110(n).
%C A402505 By requiring a(n) not being divisible by 3, sequence forms a compatible system modulo {A102476(n+1)=4*prime(n)#}: a(n) mod 4*prime(m)# = a(m) for n > m >= 2.
%H A402505 Jianing Song, <a href="/A402505/b402505.txt">Table of n, a(n) for n = 2..350</a>
%F A402505 Let b(n) = A340764(prime(n)) be the number of primes p <= prime(n) that are congruent to 2 modulo 3. Then a(n) = (4/3)*prime(n)# - 1 if b(n) is odd and (8/3)*prime(n)# - 1 if b(n) is even.
%F A402505 a(n) = A102476(n+1) - A402500(n).
%o A402505 (PARI) my(P=8, pi32=1); forprime(p=5, 100, print1(if(pi32==1, P-1, 2*P-1), ", "); P*=p; if(p%3==2, pi32=1-pi32))
%Y A402505 Cf. A002110 (primorials), A102476 (4 times primorials), A340764, A402432.
%Y A402505 See A402499 for a list of related sequences.
%K A402505 nonn,easy,new
%O A402505 2,1
%A A402505 _Jianing Song_, Nov 19 2026
