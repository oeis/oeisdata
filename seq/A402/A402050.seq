%I A402050 #9 Nov 15 2026 08:10:47
%S A402050 64,192,320,448,576,704,729,832,960,1024,1088,1216,1344,1458,1472,
%T A402050 1600,1728,1856,1984,2112,2240,2368,2496,2624,2752,2880,2916,3008,
%U A402050 3072,3136,3264,3392,3520,3645,3648,3776,3904,4032,4096,4160,4288,4416,4544,4672,4800,4928
%N A402050 Numbers whose number of divisors is not a 5-smooth number.
%C A402050 First differs from its subsequence A336596 at n = 10: a(10) = 1024 is not a term in A336596.
%C A402050 Number whose prime factorization includes at least one exponent e such that e+1 is a term in A279622.
%C A402050 The asymptotic density of this sequence is 1 - Product_{p prime} ((1-1/p) * Sum_{k in A051037} 1/p^(k-1)) = 0.0094726649008322713413... .
%H A402050 Amiram Eldar, <a href="/A402050/b402050.txt">Table of n, a(n) for n = 1..10000</a>
%H A402050 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%e A402050 64 is a term since A000005(64) = 7 is not a 5-smooth number.
%t A402050 smQ[n_] := n == Times @@ ({2, 3, 5}^IntegerExponent[n, {2, 3, 5}]); q[k_] := !smQ[DivisorSigma[0, k]]; Select[Range[5000], q]
%o A402050 (PARI) isok(k) = {my(d = numdiv(k)); vecprod(apply(x -> x^valuation(d, x), [2, 3, 5])) != d;}
%Y A402050 Subsequence of A354181.
%Y A402050 A336596 is a subsequence.
%Y A402050 Cf. A000005, A051037, A279622.
%K A402050 nonn,easy,new
%O A402050 1,1
%A A402050 _Amiram Eldar_, Nov 12 2026
