%I A402114 #10 Nov 22 2026 17:09:12
%S A402114 0,0,0,1,2,3,3,5,9,15,17,17,23,35,37,47,56,69,73,83,104,117,128,136,
%T A402114 163,194,210,219,249,270,311,333,357,392,425,469,514,559,588,619,689,
%U A402114 730,779,817,869,950,999,1048,1136,1198,1272,1345,1437,1540,1592,1675,1767
%N A402114 a(n) is the number of tangential quadrilaterals, up to congruence, with integer side lengths, integer inradius, and semiperimeter n.
%C A402114 Congruence includes reflections. By Pitot's theorem, opposite sides sum to n, so every side-length class has a representative (i, j, n - i, n - j), where 1 <= i <= j <= floor(n/2).
%C A402114 The area equals n*r, where r is the inradius. Thus, this sequence counts precisely those quadrilaterals counted by A402115 whose area is divisible by n.
%C A402114 For tangent lengths (t, i - t, j - i + t, n - j - t) and area k, one has k^2 = n*(2*i*(n - j)*t + i*(n - j)*(j - i) - n*t^2). This quadratic gives at most two admissible solutions for fixed side lengths and area.
%C A402114 Every positive multiple of n not exceeding floor(n^2/4) occurs as an area. Consequently, a(n) >= floor(n/4), and a(n) > 0 if and only if n >= 4.
%C A402114 For the formula, put h = floor(n/2), p = i*j*(n - i)*(n - j), l = n*i*(n - j)*(j - i), and u = n*i*j*(n - i - j). Here [condition] equals 1 if the condition holds and 0 otherwise.
%C A402114 The asymptotic formula follows by Riemann summation, since integer-rounding corrections contribute only lower-order terms. The same leading constant occurs in A402115.
%H A402114 Felix Huber, <a href="/A402114/b402114.txt">Table of n, a(n) for n = 1..400</a>
%H A402114 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/TangentialQuadrilateral.html">Tangential Quadrilateral</a>.
%F A402114 a(n) = Sum_{1 <= i <= j <= h, 2*j = n} (floor(sqrt(p)/n) - floor(sqrt(l)/n)) + Sum_{1 <= i <= j <= h, 2*j < n} (2*floor(sqrt(p)/n) - floor(sqrt(l)/n) - floor(sqrt(u)/n) - [p is a square and n divides sqrt(p)]).
%F A402114 a(n) ~ c*n^3, where c = Integral_{y=0..1/2} Integral_{x=0..y} (2*sqrt(x*y*(1 - x)*(1 - y)) - sqrt(x*(1 - y)*(y - x)) - sqrt(x*y*(1 - x - y))) dx dy = 0.00863321215757...
%e A402114 a(4) = 1: The square with side length 2 has semiperimeter 4 and inradius 1.
%e A402114 a(5) = 2: Two noncongruent kites with sides (2, 2, 3, 3) have area 5 and inradius 1. Their tangent lengths are (t, 2 - t, t, 3 - t), where t = (6 + sqrt(11))/5 or (6 - sqrt(11))/5. In particular, the tangent lengths need not be rational.
%p A402114 A402114 := proc(n)
%p A402114     local a, i, j, h, p, l, u, q, s, t;
%p A402114     h := iquo(n, 2);
%p A402114     a := 0;
%p A402114     for i from 1 to h do
%p A402114         for j from i to h do
%p A402114             p := i*j*(n - i)*(n - j);
%p A402114             l := n*i*(n - j)*(j - i);
%p A402114             q := isqrt(p);
%p A402114             s := isqrt(l);
%p A402114             if q^2 > p then q := q - 1 end if;
%p A402114             if s^2 > l then s := s - 1 end if;
%p A402114             if 2*j = n then
%p A402114                 a := a + iquo(q, n) - iquo(s, n);
%p A402114             else
%p A402114                 u := n*i*j*(n - i - j);
%p A402114                 t := isqrt(u);
%p A402114                 if t^2 > u then t := t - 1 end if;
%p A402114                 a := a + 2*iquo(q, n) - iquo(s, n) - iquo(t, n);
%p A402114                 if q^2 = p and irem(q, n) = 0 then
%p A402114                     a := a - 1;
%p A402114                 end if;
%p A402114             end if;
%p A402114         end do;
%p A402114     end do;
%p A402114     a;
%p A402114 end proc:
%p A402114 seq(A402114(n), n = 1 .. 57);
%Y A402114 Cf. A273771, A402115.
%K A402114 nonn,new
%O A402114 1,5
%A A402114 _Felix Huber_, Nov 13 2026
