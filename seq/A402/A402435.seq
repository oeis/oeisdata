%I A402435 #13 Nov 21 2026 06:01:02
%S A402435 1,2,3,3,2,3,0,4,3,3,3,4,2,4,1,5,3,3,3,4,2,4,0,5,3,4,3,5,2,5,1,6,3,3,
%T A402435 3,4,2,4,0,5,3,4,3,5,2,5,1,6,3,4,3,5,2,5,0,6,3,5,3,6,2,6,1,7,3,3,3,4,
%U A402435 2,4,0,5,3,4,3,5,2,5,1,6,3,4,3,5,2,5,0,6
%N A402435 A conjecture about the 2-adic valuation of A386381. See the Maple function for the definition.
%C A402435 The purpose of this sequence is the study of the arithmetic properties of _Mikhail Kurkov_'s A386381 (that also is the column 1 of A402436).
%C A402435 Conjecture: a(n) = n + 1 - valuation_2(A386381(n)) for n >= 1.
%C A402435 If this conjecture is true then 2*A386381(n) is divisible by A060818(n), wich is a conjecture stated in A386381.
%p A402435 a := proc(n) local r; r := irem(n, 16);
%p A402435     if type(n, odd) then 1 + add(convert(n, base, 2))  # A007814
%p A402435     elif r = 0 or r = 2 or r = 8 or r = 10 then if n = 0 then 1 else 3 fi
%p A402435     elif r = 4 or r = 12 then 2
%p A402435     elif r = 6 then 0
%p A402435     else 1 fi end:
%t A402435 a[n_] := If[OddQ[n], 1 + DigitCount[n, 2, 1], Switch[BitAnd[n, 15], 0 | 2 | 8 | 10, If[n != 0, 3, 1], 4 | 12, 2, 6, 0, _, 1] ]; a /@ Range[0, 87]
%o A402435 (Python)
%o A402435 def a(n: int) -> int:
%o A402435     match n & 15:
%o A402435         case _ if n & 1:     return 1 + n.bit_count()
%o A402435         case 0 | 2 | 8 | 10: return 3 if n else 1
%o A402435         case 4 | 12:         return 2
%o A402435         case 6:              return 0
%o A402435         case _:              return 1
%o A402435 print([a(n) for n in range(88)])
%Y A402435 Cf. A386381, A386363, A402436, A007814, A060818.
%K A402435 nonn,easy,new
%O A402435 0,2
%A A402435 _Peter Luschny_, Nov 19 2026
