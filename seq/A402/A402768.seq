%T A402768 0,0,144,0,0,0,234,0,0,0,220,0,0,0,264,135,0,0,312,49,75,0,364,0,189,
%U A402768 0,420,0,0,0,480,0,0,252,544,0,0,0,612,0,0,0,900,0,0,150,760,0,0,0,840,405,0,0,924
%N A402768 Sum of the numbers k in [1..n] such that gcd(n,k) is divisible by a square > 1.
%H A402768 Michael De Vlieger, <a href="/A402768/b402768.txt">Table of n, a(n) for n = 1..10000</a>
%F A402768 a(n) = Sum_{k=1..n} k * (1 - mu(gcd(n,k))^2).
%F A402768 a(n) = (1/2) * Sum_{d|n} phi(d)*(n+1-(n+mu(n)^2)*mu(n/d)^2).
%F A402768 a(n) = A162296(n) + A402766(n).
%F A402768 a(n) = A000217(n) - A390806(n).
%F A402768 Sum_{k=1..n} a(k) ~ c * n^3, where c = 1/6 - 15/Pi^4 = 0.0126769... . - _Amiram Eldar_, Nov 27 2026
%t A402768 Table[Sum[k*(1 - MoebiusMu[GCD[n, k]]^2), {k, n}], {n, 100}]
%o A402768 (PARI) a(n) = {my(f = factor(n)); n*(n+1)/2 - (n + issquarefree(f)) * prod(i = 1, #f~, if(f[i, 2] == 1, f[i, 1], f[i, 1]^f[i, 2] - f[i, 1]^(f[i, 2]-2))) / 2;} \\ _Amiram Eldar_, Nov 27 2026
%Y A402768 Cf. A000010 (phi), A000217, A008683 (mu), A162296, A390806, A402766.
%K A402768 nonn,easy,new
%O A402768 1,4
%A A402768 _Wesley Ivan Hurt_, Nov 26 2026
