%S A402530 16,42,144,210,216,288,300,960,1008,1200,1560,1620,1800,1920,1980,
%T A402530 2100,2340,2400,2880,3024,3120,3240,3600,5760,5880,6120,6240,6300,
%U A402530 6720,7200,7920,8400,8820,10920,11340,11760,11880,12240,13440,16380,16800,17640,19800
%N A402530 Numbers that are highly abundant numbers (A002093), but not Ramanujan's largely composite numbers (A067128).
%e A402530 300 is in this sequence because sigma(300) = 868, which is higher than sum of positive divisors of all previous numbers. numdiv(300) = 18, but before 300, numdiv(240) = 20, which is larger than number of divisors of 300.
%t A402530 r = s = 0; t = True; Reap[Do[(If[#1 >= r, r = #1; t = False, t = True]; If[#2 > s, s = #2; If[t, Sow[n]; t = True]]) & @@ DivisorSigma[{0, 1}, n], {n, 20000}] ][[-1, 1]] (* _Michael De Vlieger_, Nov 20 2026 *)
%Y A402530 Cf. A002093, A067128, A395337.
%K A402530 nonn,new
%O A402530 1,1
