%N A402255 a(n) = 1 + Sum_{k=1..n} binomial(4*n,k) * a(n-k).
%F A402255 G.f. A(x) satisfies A(x) = (1-3*x)/(1+x) * (2*A(z) - 1/(1-z)), where z = x/(1+x)^4.
%o A402255 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(4*i, j)*v[i-j+1])); v;
