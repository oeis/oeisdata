%T A402334 118355185392,2561256585478,59121794789187,1450010242563618,
%U A402334 37654606551323742,1032158168626177930,29781789425800441945,902286838181434998886,28637944431882255079756
%N A402334 a(n) = 1 + Sum_{k=1..n} binomial(n+4,k) * a(n-k).
%F A402334 G.f. A(x) satisfies 2*A(x) - 1/(1-x) = A(x/(1-x))/(1-x)^5.
%F A402334 G.f. A(x) satisfies A(x) = (2*A(z) - 1/(1-z))/(1+x)^5, where z = x/(1+x).
%F A402334 E.g.f.: d^4/dx^4 ( (1 - x - x^2/2 - x^3/6)/(2 - exp(x)) ).
%F A402334 a(n) = (n+4)! * [x^(n+4)] (exp(x) - 1 - x - x^2/2 - x^3/6)/(2 - exp(x)).
%F A402334 a(n) = A000670(n+4) - (n+4)*A000670(n+3) - binomial(n+4,2)*A000670(n+2) - binomial(n+4,3)*A000670(n+1).
%o A402334 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(i+4, j)*v[i-j+1])); v;
%Y A402334 Cf. A000629, A000670, A053525, A402333.
