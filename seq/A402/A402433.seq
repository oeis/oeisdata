%I A402433 #12 Nov 21 2026 12:34:34
%S A402433 0,1,2,2,3,2,4,3,7,8,13,18,28,37,49,70,88,118,143,192,233,300,355,459,
%T A402433 545,690,811,1015,1209,1488,1766,2157,2564,3099,3683,4434,5252,6266,
%U A402433 7424,8802,10425,12283,14497,17015,20025,23413,27472,32002,37441,43477,50716,58699,68279,78841,91444,105325
%N A402433 Number of integer partitions of n having exactly one part j, up to multiplicity, such that neither j-1 nor j+1 is a part (i.e., for every other part k != j, at least one of k-1 or k+1 is a part).
%F A402433 Let A_0(x,u) = 1, B_0(x,u) = C_0(x,u) = 0, and q_m(x) = x^m/(1-x^m).
%F A402433 For m >= 1,
%F A402433 A_m(x,u) = A_{m-1}(x,u) + C_{m-1}(x,u) + u*B_{m-1}(x,u),
%F A402433 B_m(x,u) = q_m(x)*A_{m-1}(x,u),
%F A402433 C_m(x,u) = q_m(x)*(B_{m-1}(x,u) + C_{m-1}(x,u)).
%F A402433 Then a(n) = [x^n*u] (A_n(x,u) + C_n(x,u) + u*B_n(x,u)).
%e A402433 For n = 30, the partition (6,6,6,4,3,3,2) is counted because j = 6 is the unique part, up to multiplicity, such that neither j-1 nor j+1 is a part. Every other part k has at least one of k-1 or k+1 as a part.
%e A402433 For n = 3, let q_m = x^m/(1-x^m).
%e A402433 A_0 = 1, B_0 = C_0 = 0.
%e A402433 A_1 = 1,
%e A402433 B_1 = q_1,
%e A402433 C_1 = 0.
%e A402433 A_2 = 1 + u*q_1,
%e A402433 B_2 = q_2,
%e A402433 C_2 = q_1*q_2.
%e A402433 A_3 = 1 + u*(q_1 + q_2) + q_1*q_2,
%e A402433 B_3 = q_3*(1 + u*q_1),
%e A402433 C_3 = q_3*(q_2 + q_1*q_2).
%e A402433 Hence
%e A402433 a(3) = [x^3*u](A_3 + C_3 + u*B_3)
%e A402433 = [x^3*u](1 + u*(q_1 + q_2) + q_1*q_2 + q_3*(q_2 + q_1*q_2) + u*q_3*(1 + u*q_1))
%e A402433 = [x^3](q_1 + q_2 + q_3)
%e A402433 = [x^3](x/(1-x) + x^2/(1-x^2) + x^3/(1-x^3))
%e A402433 = [x^3](x + 2*x^2 + 2*x^3 + O(x^4))
%e A402433 = 2.
%Y A402433 Cf. A355394.
%K A402433 nonn,new
%O A402433 0,3
