%U A402261 2867796733011797,69334078338432968,1775878727515209266,48038755358293505207,1368559364777413073918,40957047763666712533454
%N A402261 a(n) = 1 + Sum_{k=1..n} binomial(n+k-1,k) * a(n-k).
%F A402261 G.f. A(x) satisfies A(x) = (1-2*x)/(1-x) * (2*A(z) - 1/(1-z)), where z = x*(1-x).
%o A402261 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(i+j-1, j)*v[i-j+1])); v;
%Y A402261 Cf. A213048, A402260.
