%I A402579 #12 Nov 23 2026 22:26:45
%S A402579 60,70,84,130,154,168,170,180,195,198,204,220,228,230,234,238,255,264,
%T A402579 270,273,280,312,336,340,348,350,364,370,372,374,385,390,396,399,414,
%U A402579 418,430,434,440,450,455,456,460,468,470,480,483,492,494,504,510,516,522,530,546,550,558,560,570,572,580,594,598,609
%N A402579 Numbers k such that A345994(k) is not equal to A052128(k).
%C A402579 Equally, numbers k for which A346596(k) is not equal to A354933(k), where A346596(n) = n / A345994(n) and A354933(n) = n / A052128(n).
%H A402579 Antti Karttunen, <a href="/A402579/b402579.txt">Table of n, a(n) for n = 1..10000</a>
%o A402579 (PARI)
%o A402579 A345994(n) = { my(u=A344005(n)); min(gcd(u,n), gcd(u+1,n)); };
%o A402579 A052128(n) = fordiv(n, d, if((d>=(n/d)) && 1==gcd(d, n/d), return(n/d)));
%o A402579 is_A402579(k) = (A345994(k)!=A052128(k));
%Y A402579 Cf. A052128, A345994, A346596, A354933.
%Y A402579 Positions of nonzero terms in A402578.
%K A402579 nonn,new
%O A402579 1,1
%A A402579 _Antti Karttunen_, Nov 23 2026
