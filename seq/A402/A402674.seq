%I A402674 #7 Nov 24 2026 09:30:08
%S A402674 864,1944,3456,4000,10976,16000,17496,25000,30375,31104,42592,43904,
%T A402674 55296,69984,70304,83349,84375,108000,124416,134456,157216,170368,
%U A402674 219488,221184,243000,256000,273375,281216,296352,323433,389344,400000,432000,453789,497664,533871
%N A402674 Exponentially odd Achilles numbers.
%C A402674 Numbers whose prime factorization has only odd exponents greater than 1, with the greatest common divisor of the exponents being 1.
%H A402674 Amiram Eldar, <a href="/A402674/b402674.txt">Table of n, a(n) for n = 1..10000</a>
%H A402674 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%H A402674 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402674 Sum_{n>=1} 1/a(n) = Product_{p prime} (1 + 1/(p*(p^2-1))) - 1 + Sum_{k>=1} mu(2*k+1)*f(2*k+1) = 0.0027721281266424839382..., where f(s) = Sum_{n>=2} 1/A268335(n)^s = zeta(2*s) * Product_{p prime} (1 + 1/p^s - 1/p^(2*s)) - 1, and mu is the Moebius function (A008683).
%e A402674   n |  a(n) | factorization
%e A402674   --+-------+--------------
%e A402674   1 |   864 | 2^5 * 3^3
%e A402674   2 |  1944 | 2^3 * 3^5
%e A402674   3 |  3456 | 2^7 * 3^3
%e A402674   4 |  4000 | 2^5 * 3^3
%e A402674   5 | 10976 | 2^5 * 3^3
%t A402674 q[k_] := Module[{e = FactorInteger[k][[;; , 2]]}, GCD @@ e == 1 && AllTrue[e, # > 1 && OddQ[#] &]]; Select[Range[600000], q]
%o A402674 (PARI) isok(k) = {my(e = factor(k)[, 2], g = gcd(e)); g == 1 && #select(x -> x < 2 || !(x % 2), e) == 0;}
%Y A402674 Intersection of A052486 and A268335.
%Y A402674 Complement of A402673 within A335988.
%Y A402674 Cf. A008683.
%K A402674 nonn,easy,new
