%S A402264 1,6,24,28,36,130,276,496,1860,2016,2316,8128,8190,17864,20196,41860,
%T A402264 42336,45864,126144,148480,179196,236736,392448,714240,840056,934902,
%U A402264 1015690,1184820,1419874,1571328,1602516,3039520,3415095,3447632,3984036,11877300,14381676,33550336,47148036
%N A402264 Positive integers equal to the sum of the p-th powers of their first k divisors for some positive integers p and k.
%C A402264 After 1, the first odd number in this sequence is 3415095, making it the smallest positive integer which is the sum of the p-th powers of its first k proper divisors for some positive integers p and k. In this case, p=4 and k=7.
%C A402264 The sequence is infinite as it contains the number 1+2^p+3^p for all odd p.
%e A402264 24 --> (1, 2, 3, 4, 6, 8): 1^1 + 2^1 + 3^1 + 4^1 + 6^1 + 8^1 = 24.
%e A402264 130 --> (1, 2, 5, 10): 1^2 + 2^2 + 5^2 + 10^2 = 130.
%e A402264 17864 --> (1, 2, 4, 7): 1^5 + 2^5 + 4^5 + 7^5 = 17864.
%e A402264 41860 --> (1, 2, 4, 5, 7, 10, 13): 1^4 + 2^4 + 4^4 + 5^4 + 7^4 + 10^4 + 13^4 = 41860.
%e A402264 1184820 --> (1, 2, 3, 4, 5, 6, 7, 10): 1^6 + 2^6 + 3^6 + 4^6 + 5^6 + 6^6 + 7^6 + 10^6 = 1184820.
%t A402264 Do[
%t A402264     divs = Divisors[n];
%t A402264     found = False;
%t A402264     Do[
%t A402264       total = 0;
%t A402264       Do[
%t A402264         total += divs[[i]]^p;
%t A402264         If[total == n, found = True; Print[{n, p, i, Take[divs, i]}]; Break[]];
%t A402264         If[total > n, Break[]],
%t A402264         {i, Length[divs]}
%t A402264       ];
%t A402264       If[found, Break[]],
%t A402264       {p, 1, Max[1, Floor[Log2[n]]]}
%t A402264     ],
%t A402264     {n, 1, 2000000000}
%t A402264   ]
%Y A402264 Cf. A064510, A185584, A185960, A399360.
%K A402264 nonn,new
%O A402264 1,2
%A A402264 _Stephen Casey_, Nov 16 2026
