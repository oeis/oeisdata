%I A402059 #11 Nov 15 2026 08:08:51
%S A402059 1,16,81,625,1296,2401,4096,10000,14641,28561,38416,50625,83521,
%T A402059 130321,194481,234256,279841,331776,456976,531441,707281,810000,
%U A402059 923521,1048576,1185921,1336336,1500625,1874161,2085136,2313441,2560000,2825761,3111696,3418801,4477456
%N A402059 Numbers k such that gcd(d_4(k), 6) = 1, where d_4 = A007426 is the 4th Piltz function.
%C A402059 First differs from A377022 at n = 13: A377022(13) = 65536 is not a term in this sequence. Also, a(24) = 1048576 is the least term in this sequence that is not a term in A377022.
%C A402059 Numbers k such that d_4(k) is a 5-rough number (A007310).
%C A402059 All the terms are fourth powers (A000583).
%C A402059 Numbers whose prime factorization exponents e are all multiples of 4 such that e/4 is non-congruent to 2, 4, or 6 (mod 9).
%H A402059 Amiram Eldar, <a href="/A402059/b402059.txt">Table of n, a(n) for n = 1..10000</a>
%H A402059 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%H A402059 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402059 a(n) = A402060(n)^4.
%F A402059 Sum_{n>=1} 1/a(n) = zeta(4) * zeta(36) * Product_{p prime} (1 - 1/p^8 + 1/p^12 - 1/p^16 + 1/p^20 - 1/p^24 + 1/p^28 - 1/p^36) = 1.078178802820126525255... .
%e A402059 16 is a term since A007426(16) = 35, and gcd(35, 6) = 1.
%t A402059 f[p_, e_] := (e + 1)*(e + 2)*(e + 3)/6; d4[n_] := Times @@ f @@@ FactorInteger[n]; d4[1] = 1; q[k_] := CoprimeQ[d4[k], 6]; Select[Range[46]^4, q]
%o A402059 (PARI) isok(k) = ispower(k, 4) && #select(e -> (e % 9 != 2 && e % 9 != 4 && e % 9 != 6) == 0, factor(sqrtnint(k, 4))[, 2]) == 0;
%Y A402059 Subsequence of A000583.
%Y A402059 Cf. A007310, A007426, A013662, A377022, A402060.
%K A402059 nonn,easy,new
%O A402059 1,2
%A A402059 _Amiram Eldar_, Nov 12 2026
