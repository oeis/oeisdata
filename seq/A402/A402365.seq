%I A402365 #12 Nov 23 2026 08:32:40
%S A402365 4425,9076,11177,11958,12169,12200,18107,20208,20989,21200,21231,
%T A402365 24859,25640,25851,25882,27741,27952,27983,28733,28764,28975,34068,
%U A402365 36169,36950,37161,37192,40820,41601,41812,41843,43702,43913,43944,44694,44725,44936,49851,50632,50843,50874,52733
%N A402365 Numbers that are the sum of five distinct positive 5th powers.
%e A402365 a(1) = 1^5 + 2^5 + 3^5 + 4^5 + 5^5 = A031971(5) is the smallest such number.
%e A402365 a(2) = 1^5 + 2^5 + 3^5 + 4^5 + 6^5 is the next larger such number, then:
%e A402365 a(3) = 1^5 + 2^5 + 3^5 + 5^5 + 6^5,
%e A402365 a(4) = 1^5 + 2^5 + 4^5 + 5^5 + 6^5,
%e A402365 a(5) = 1^5 + 3^5 + 4^5 + 5^5 + 6^5,
%e A402365 a(6) = 2^5 + 3^5 + 4^5 + 5^5 + 6^5.
%e A402365 We see that the first terms are a(n) = a(6)+1 - (7-n)^5.
%e A402365 The sequence continues in a similar way with 2 omitted smaller terms, then 3.
%e A402365 However, with 3 omitted terms we have Sum(k=4..8, k^5) = 61500 > 60349 = 9^5 + Sum(k=1..4, k^5). That is, we get a smaller sum by incrementing the largest term, rather than taking all terms as large as possible for a given largest term 8^5.
%o A402365 (PARI) A402365_first(n=50, k=5)=my(L=List(),m=k); while(#L<n^1.05, forvec(v=vector(k,i,[m^(i==k),m]), listput(L,sum(i=1,k,v[i]^k)), 2); m++); Set(L)[1..n]
%Y A402365 Cf. A000584 (fifth powers), A031971 (Sum k^n, k=1..n).
%Y A402365 Row 5 of A402364 (n-th row lists sums of n distinct n-th powers > 0).
%Y A402365 Similar sequences of numbers that are the sum of k distinct positive k-th powers: A004431 (k=2), A024975 (k=3), A176197 (k=4), A402366 (k=6), A402367 (k=7), A402368 (k=8).
%K A402365 nonn,new
%O A402365 1,1
