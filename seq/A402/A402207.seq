%I A402207 #18 Nov 24 2026 22:38:39
%S A402207 3,8,10,16,14,24,18,28,25,32,26,40,30,40,36,44,38,48,42,48,44,56,50,
%T A402207 48,49,64,52,56,62,48,66,60,60,80,52,40,78,88,68,40,86,48,90,72,42,
%U A402207 104,98,16,81,72,84,80,110,48,68,32,92,128,122,-48,126,136,38,60
%N A402207 a(n) = 4*sigma(n) - n*tau(n).
%C A402207 a(n) is the total perimeter minus the total area of the tau(n) rectangles d X (n/d), one for each divisor d of n (so a X b and b X a are counted separately when a != b).
%C A402207 By G. L. Cohen (1997), H(n) = n*A000005(n)/A000203(n) and no positive integer n has H(n) = 4, so a(n) != 0 for all n.
%H A402207 G. L. Cohen, <a href="http://doi.org/10.1090/S0025-5718-97-00819-3">Numbers whose positive divisors have small integral harmonic mean</a>, Math. Comp. 66 (1997), 883-891.
%H A402207 T. Goto and S. Shibata, <a href="http://doi.org/10.1090/S0025-5718-03-01554-0">All numbers whose positive divisors have integral harmonic mean up to 300</a>, Math. Comp. 73 (2004), 475-491.
%F A402207 a(n) = 4*A000203(n) - n*A000005(n).
%F A402207 a(n) = 4*A000203(n) - A038040(n).
%F A402207 a(p) = 2*(p + 2) for prime p.
%F A402207 a(p^2) = (p + 2)^2 for prime p.
%F A402207 a(6*p) = 48 for every prime p > 2.
%e A402207 For n = 6: a(6) = 4*A000203(6) - 6*A000005(6) = 24.
%e A402207 For n = 60: a(60) = 4*A000203(60) - 60*A000005(60) = -48.
%t A402207 a[n_] := {4, -n}.DivisorSigma[{1, 0}, n]; Array[a, 64] (* _Amiram Eldar_, Nov 15 2026 *)
%o A402207 (PARI) a(n) = 4*sigma(n) - n*numdiv(n);
%Y A402207 Cf. A000005, A000203, A001599, A001600, A038040.
%K A402207 sign,easy,new
%O A402207 1,1
%A A402207 _Ctibor O. Zizka_, Nov 15 2026
