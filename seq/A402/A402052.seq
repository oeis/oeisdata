%I A402052 #8 Nov 15 2026 08:05:35
%S A402052 32,64,96,160,192,224,243,288,320,352,416,448,480,486,512,544,576,608,
%T A402052 672,704,729,736,800,832,864,928,960,972,992,1024,1056,1088,1120,1184,
%U A402052 1215,1216,1248,1312,1344,1376,1440,1458,1472,1504,1536,1568,1600,1632,1696
%N A402052 Numbers k such that d_3(k) is not a 5-smooth number, where d_3 = A007425 is the 3rd Piltz function.
%C A402052 Numbers whose prime factorization includes at least one exponent that is not in {1, 2, 3, 4, 7, 8, 14, 23, 79}.
%C A402052 The asymptotic density of this sequence is 1 - Product_{p prime} (1 - 1/p^5 + 1/p^7 - 1/p^9 + 1/p^14 - 1/p^15 + 1/p^23 - 1/p^24 + 1/p^79 - 1/p^80) = 0.029339961501504002109... .
%H A402052 Amiram Eldar, <a href="/A402052/b402052.txt">Table of n, a(n) for n = 1..10000</a>
%H A402052 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%e A402052 32 is a term since A007425(32) = 21 is not a 5-smooth number.
%t A402052 f[p_, e_] := (e+1)*(e+2)/2; d3[n_] := Times @@ f @@@ FactorInteger[n]; d3[1] = 1; smQ[n_] := n == Times @@ ({2, 3, 5}^IntegerExponent[n, {2, 3, 5}]); q[k_] := !smQ[d3[k]]; Select[Range[1700], q]
%t A402052 (* Alternative: *)
%t A402052 q[k_] := !AllTrue[FactorInteger[k][[;; , 2]], MemberQ[{1, 2, 3, 4, 7, 8, 14, 23, 79}, #] &]; Select[Range[1700], q]
%o A402052 (PARI) isok(k) = {my(e = factor(k)[, 2], v = Set([1, 2, 3, 4, 7, 8, 14, 23, 79])); for(i = 1, #e, if(!setsearch(v, e[i]), return(1))); 0;}
%Y A402052 Subsequence of A046099.
%Y A402052 Cf. A051037, A007425, A354181.
%K A402052 nonn,easy,new
%O A402052 1,1
%A A402052 _Amiram Eldar_, Nov 12 2026
