%S A402332 1,1,1,1,2,2,1,5,12,12,1,14,110,286,286,1,42,1274,12376,33592,33592,1,
%T A402332 132,17136,759696,8320480,23178480,23178480,1,429,255816,58837680,
%U A402332 3257467920,38469144960,108995910720,108995910720,1,1430,4124406,5382349830,1745537452560,111555711740880,1385995206477600,3973186258569120,3973186258569120
%N A402332 Triangle read by rows: T(n,k) = number of standard shifted Young tableaux with k rows containing n, n-1, ..., n-k+1 entries.
%C A402332 Also the number of ways a floor tiler can tile an unshifted tableau with rows of n, n-1, ..., n-k+1 tiles observing that with each step the number of tiles in the rows is strictly decreasing.
%F A402332 T(n,k) = (((n+1)*n/2-(n-k+1)*(n-k)/2)!/Product_{j=0..k-1}(n-j)!) * Product_{j=1..k-1}(k-j)!*(2n-k-j+1)!/(2n-2j+1)! (using Schur's shifted product formula).
%F A402332 T(n, n-1) = T(n, n).
%e A402332 Triangle begins:
%e A402332  1
%e A402332  1    1
%e A402332  1    2       2
%e A402332  1    5      12         12
%e A402332  1   14     110        286           286
%e A402332  1   42    1274      12376         33592           33592
%e A402332  1  132   17136     759696       8320480        23178480         23178480
%e A402332  1  429  255816   58837680    3257467920     38469144960     108995910720     108995910720
%e A402332  1 1430 4124406 5382349830 1745537452560 111555711740880 1385995206477600 3973186258569120 3973186258569120
%e A402332  ...
%e A402332 Tiling example for (n,k) = (4,3):
%e A402332   _ _ _ _
%e A402332  |_|_|_|_|
%e A402332  |_|_|_|
%e A402332  |_|_|
%e A402332 Tiling (here: 9 steps) for n > 1 always begins with the first two tiles in the first row and ends with the last tile in the last row. Between these 3 fixed steps there are T(4,3) = 12 ways of tiling.
%t A402332 T[n, k] = (((n + 1) n/2 - (n - k + 1)*(n - k)/2)!/Product[(n - j)!, {j, 0, k-1}]) *Product[(k - j)! (2*n - k - j + 1)!/(2*n - 2*j + 1)!, {j, k-1}]
%t A402332 (* Alternative: Triangle *)
%t A402332 Table[If[k > n," ",(((n + 1)*n/2 - (n - k + 1)*(n - k)/2)!/Product[(n - j)!, {j, 0, k-1}])*Product[(k - j)!*(2*n - k - j + 1)!/(2*n - 2*j + 1)!, {j, k-1}]],{n, 9}, {k, 9}] // TableForm
%Y A402332 Cf. A003121 (diagonal).
%Y A402332 Cf. A000108 (k=2).
%Y A402332 Cf. A007724 (k=3).
%K A402332 nonn,tabl,new
%O A402332 1,5
