%U A402254 127584230384158558449,8421679327525845299124,592304052452175244938892,44217709401707029574031843
%N A402254 a(n) = 1 + Sum_{k=1..n} binomial(3*n,k) * a(n-k).
%F A402254 G.f. A(x) satisfies A(x) = (1-2*x)/(1+x) * (2*A(z) - 1/(1-z)), where z = x/(1+x)^3.
%o A402254 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(3*i, j)*v[i-j+1])); v;
