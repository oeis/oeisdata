%T A402388 6,8,7,9,6,9,6,9,7,9,6,8,5,8,6,9,7,10,8,11,8,12,8,12,9,12,9,12,8,13,8,
%U A402388 13,10,13,11,14,9,14,10,15,12,16,11,15,10,15
%N A402388 Number of distinct values of x AND y AND z over all nonnegative integers x, y, z with x + y + z = n, where AND is the bitwise AND operator.
%H A402388 Vicenzo P DeMaar, <a href="/A402388/b402388.txt">Table of n, a(n) for n = 0..10000</a>
%F A402388 a(0) = 1; a(2*n+1) = a(n) + a(n-1); a(2*n) = a(n) + a(n-1) - a(floor((n-1)/2)); with a(-1) = 0.
%F A402388 a(2^k-1) = A000045(k+1) for k >= 0.
%F A402388 a(2^k-2) = a(2^k) = A000045(k) for k >= 1.
%F A402388 Sum_{n=0..2^(k+1)-1} a(n) = 4*Sum_{n=0..2^k-1} a(n) - 2*Sum_{n=0..2^(k-1)-1} a(n) - A000032(k) for k >= 1.
%F A402388 Sum_{n=0..2^k-1} a(n) = A000045(k+1) + (A006012(k+1) - 2*A006012(k) + A000045(k))/3 for k >= 0.
%F A402388 G.f. for Sum_{n=0..2^k-1} a(n), k >= 0: (1 - 3*x)/((1 - x - x^2)*(1 - 4*x + 2*x^2)).
%F A402388 Sum_{n=2^(k-1)..2^k-1} a(n) ~ (2 + sqrt(2))^k/6 as k -> infinity.
%e A402388 a(7) = 3: with x + y + z = 7, the value x AND y AND z can be 0 (7 + 0 + 0), 1 (1 + 3 + 3) or 2 (2 + 2 + 3). It cannot exceed min(x, y, z) <= 7/3.
%e A402388 a(8) = 2: the values are 0 (8 + 0 + 0) and 2 (2 + 3 + 3). The value 1 would require x, y and z all odd, which makes x + y + z odd.
%e A402388 a(14) = a(7) + a(6) - a(3) = 3 + 2 - 2 = 3: the values are 0 (14 + 0 + 0), 2 (2 + 6 + 6) and 4 (4 + 5 + 5).
%o A402388 (Python)
%o A402388 from functools import lru_cache
%o A402388 @lru_cache(maxsize=None)
%o A402388 def a(n):
%o A402388     if n < 0: return 0
%o A402388     if n == 0: return 1
%o A402388     m, r = divmod(n, 2)
%o A402388     if r: return a(m) + a(m-1)
%o A402388     return a(m) + a(m-1) - a((m-1)//2)
%o A402388 print([a(n) for n in range(80)])
%o A402388 (Python)
%o A402388 def a(n): return len({x & y & (n-x-y) for x in range(n+1) for y in range(n-x+1)})
%o A402388 print([a(n) for n in range(80)])
