%S A402519 1,1,2,1,6,1,30,1,4,3,210,1,2310,15,2,1,30030,2,510510,3,10,105,
%T A402519 9699690,1,36,1155,8,15,223092870,1,6469693230,1,70,15015,6,1,
%U A402519 200560490130,255255,770,3,7420738134810,5,304250263527210,105,4,4849845,13082761331670030
%N A402519 a(n) = the smallest number k such that k * n is in A025487.
%C A402519 This sequence contains every positive integer.
%F A402519 a(n) = A073039(n) / n.
%F A402519 From _Michael De Vlieger_, Nov 22 2026: (Start)
%F A402519 a(n) = 1 for n in A025487.
%F A402519 a(prime(k)^m) = A002110(k-1)^m. (End)
%e A402519 a(33) = 70 because 33 * 70 = 2310, which is in A025487, while there is no number k below 70 where 33 * k is in A025487.
%t A402519 f[x_] := If[x == 1, {0}, Function[h, ReplacePart[Table[0, {PrimePi[h[[-1, 1]]]}], #] &@ Map[PrimePi@ First[#] -> Last[#] &, h] ][FactorInteger[x]], x]; g[x_] := Times @@ Flatten@ MapIndexed[Prime[#2]^#1 &, x]; Array[r = 0; g[Reverse@ FoldList[Max, Reverse@f[#] ] ]/# &, 50] (* _Michael De Vlieger_, Nov 19 2026 *)
%Y A402519 Cf. A025487, A073039.
%K A402519 nonn,easy,new
%O A402519 1,3
%A A402519 _Zhicheng Wei_, Nov 19 2026
