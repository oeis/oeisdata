%I A402336 #9 Nov 22 2026 22:53:35
%S A402336 0,1,2,3,5,7,10,13,18,23,30,36,47,56,70,83,101,118,144,165,198,227,
%T A402336 268,306,361,408,474,537,621,699,808,902,1034,1159,1320,1474,1676,
%U A402336 1863,2108,2347,2644,2932,3301,3652,4094,4531,5059,5587,6238,6872,7646,8422,9344,10276
%N A402336 G.f.: Sum_{k>=1} x^k / Product_{j=k..4*k} (1 - x^j).
%C A402336 Number of partitions of n such that 4*(least part) >= greatest part.
%H A402336 Vaclav Kotesovec, <a href="/A402336/b402336.txt">Table of n, a(n) for n = 0..10000</a>
%F A402336 a(n) ~ c * d^sqrt(n) / sqrt(n), where d = 4.9219345... (the same as in A237826) and c = 0.616919...
%t A402336 nmax = 60; CoefficientList[Series[Sum[x^j/Product[1-x^k, {k, j, 4*j}], {j, 1, nmax}], {x, 0, nmax}], x]
%t A402336 (* Alternative: *)
%t A402336 nmax = 60; p = 1; s = 0; Do[p = Simplify[p*(1 - x^(4*k - 3))*(1 - x^(4*k - 2))*(1 - x^(4*k - 1))*(1 - x^(4*k))/(1 - x^k)]; p = Normal[p + O[x]^nmax]; s += x^k/(1 - x^k)/p;, {k, 1, nmax}]; CoefficientList[Series[s, {x, 0, nmax}], x]
%Y A402336 Cf. A035296, A237824, A363076, A393973.
%K A402336 nonn,new
%O A402336 0,3
%A A402336 _Vaclav Kotesovec_, Nov 17 2026
