%S A402538 1,1,1,1,12,2,360,360,10080,6048,37800,7200,311850,2851200,1210809600,
%T A402538 54486432000,435891456000,6706022400,1282526784000,1515713472000,
%U A402538 25342729251840000,4031797835520000,238945732945920000,300213869598720000,3231502092360622080000
%N A402538 Denominators of coefficients of expansion of (1 - x)^(-1/(1 + log(1 - x))).
%C A402538 For x, y > 1, let mult(x, y) = exp(log(x) * log(y)) = exp(exp(log(log(x)) + log(log(y)))).
%C A402538 This operation is associative and commutative, has neutral element e and inverse inv(x) = exp(1/log(x)) = exp(exp(-log(log(x)))) for x > 1.
%C A402538 For x < 1 - 1/e, let inv'(x) = (1/e) * inv(e*(1 - x)).
%C A402538 Then we have inv'(x) = (1 - x)^(-1/(1 + log(1 - x))).
%C A402538 Expanding inv'(x) around 0 gives the power series inv'(x) = Sum_{n >= 0} (A402537(n) / a(n)) * x^n.
%H A402538 Elia Immanuel Auer, <a href="/A402538/b402538.txt">Table of n, a(n) for n = 0..400</a>
%H A402538 Albert A. Bennett, <a href="https://doi.org/10.2307/2007124">Note on an Operation of the Third Grade</a>, Annals of Mathematics, Vol. 17, No. 2 (Dec. 1915), pp. 74-75.
%F A402538 a(n) = denominator(A088815(n)/n!).
%F A402538 G.f.: (1 - x)^(-1/(1 + log(1 - x))) = Sum_{n >= 0} (A402537(n) / a(n)) * x^n.
%e A402538 (1 - x)^(-1/(1 + log(1 - x))) = 1 + x + 2*x^2 + 4*x^3 + (95/12)*x^4 + (31/2)*x^5 + ...
%p A402538 a := proc(n) local x; denom(coeff(series(1/(1-x)^(1/(1 + log(1-x))), x=0, n+1), x, n)) end: seq(a(n), n=0..24); # _Peter Luschny_, Nov 26 2026
%o A402538 (SageMath)
%o A402538 def a(n):
%o A402538     x = PowerSeriesRing(QQ, 'x', default_prec=n+1).gen()
%o A402538     return ((1/(1 + (1 - x).log()) - 1).exp()[n]).denominator()
%o A402538 print([a(n) for n in range(25)])
%Y A402538 Cf. A402537 (numerators), A000262, A088815.
%K A402538 frac,nonn,new
%O A402538 0,5
