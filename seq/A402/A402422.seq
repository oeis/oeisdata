%T A402422 97,97,167,103,163,227,167,197,239,239,179,173,157,331,257,199,251,
%U A402422 241,199,433,479,197,227,439,251,257,433,307,383,349,257,1051,353,283,383
%N A402422 Least m > 1 such that 4*prime(n)# + m is prime, where prime(n)# = A002110(n).
%C A402422 The first 1000 terms are primes.
%H A402422 Jianing Song, <a href="/A402422/b402422.txt">Table of n, a(n) for n = 1..1000</a>
%e A402422 n = 1: least prime > 8+1 is 11 = 8+3;
%e A402422 n = 2: least prime > 8*3+1 is 29 = 8*3+5;
%e A402422 n = 3: least prime > 8*3*5+1 is 127 = 8*3*5+7;
%e A402422 n = 4: least prime > 8*3*5*7+1 is 853 = 8*3*5*7+13;
%e A402422 n = 5: least prime > 8*3*5*7*11+1 is 9257 = 8*3*5*7*11+17.
%o A402422 (PARI) my(P=4); forprime(p=2, 1000, P*=p; print1(nextprime(P+2)-P, ", "))
%Y A402422 Cf. A002110 (primorials), A102476 (4 times primorials), A005235, A055211.
%Y A402422 Cf. A402423, A402428 (prime(n) such that a(n) = prime(n+1)).
%K A402422 nonn,new
%O A402422 1,1
%A A402422 _Jianing Song_, Nov 18 2026
