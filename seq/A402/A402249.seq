%I A402249 #10 Nov 16 2026 05:39:33
%S A402249 1,3,4,5,6,12,8,15,10,18,12,20,14,24,24,21,18,30,20,30,32,36,24,60,26,
%T A402249 42,40,40,30,72,32,63,48,54,48,50,38,60,56,90,42,96,44,60,60,72,48,84,
%U A402249 50,78,72,70,54,120,72,120,80,90,60,120,62,96,80,93,84,144
%N A402249 Sum of divisors d of n such that gcid(d, n/d) is a powerful number, where gcid is the greatest common infinitary divisor.
%C A402249 First differs from A376888 and A400144 at n = 64.
%C A402249 The number of these divisors is A400139(n).
%H A402249 Amiram Eldar, <a href="/A402249/b402249.txt">Table of n, a(n) for n = 1..10000</a>
%F A402249 Multiplicative with a(p^e) = (p^(e+1) - 1)/(p-1) if e is odd, and (p^(e+1) - 1)/(p-1) - p * isigma(p^(e-2)) if e is even, where isigma(n) = A049417(n).
%F A402249 Sum_{k=1..n} a(k) ~ c * n^2, where c = (zeta(2)/2) * Product_{p prime} (1 - ((1-1/p)*(1-1/p^2)/p^3) * Product_{k>=1} (1 + 1/p^(2^k) + 1/p^(2^(k+1)))) = 0.74120108876447393734... .
%t A402249 f[p_, e_] := Times @@ (1 + Flatten[p^(2^(-1 + Position[Reverse@IntegerDigits[e, 2], _?(# == 1 &)]))]);
%t A402249 f2[p_, e_] := (p^(e+1) - 1)/(p-1) - If[OddQ[e], 0, p*f[p, e-2]];
%t A402249 a[1] = 1; a[n_] := Times @@ f2 @@@ FactorInteger[n]; Array[a, 66]
%o A402249 (PARI) a(n) = {my(f = factor(n), d); prod(i = 1, #f~, (f[i, 1]^(f[i, 2]+1) - 1)/(f[i, 1]-1) - if(!(f[i, 2] % 2), d = binary(f[i, 2] - 2); f[i, 1] * prod(k = 1, #d, if(d[k], 1 + f[i, 1]^(2^(#d - k)), 1))));}
%Y A402249 Cf. A001694, A049417, A077609, A376888, A400137, A400139, A400144.
%Y A402249 Sum of divisors d of n such that gcid(d, n/d) is: A049417 (1), A400144 (square), A400145 (odd), A400146 (power of 2), A402247 (squarefree), A402248 (exponentially odd), this sequence (powerful).
%K A402249 nonn,mult,easy,new
%O A402249 1,2
%A A402249 _Amiram Eldar_, Nov 16 2026
