%U A402245 1,0,2,0,1,0,3,0,0,2,0,1,0,5,0,0,1,0,3,0
%N A402245 Exponent of highest power of 2 dividing A122132(n).
%C A402245 The asymptotic density of the occurrences of k = 0, 1, 2, ... is 1/2^(k+1).
%H A402245 Amiram Eldar, <a href="/A402245/b402245.txt">Table of n, a(n) for n = 1..10000</a>
%F A402245 a(n) = A007814(A122132(n)).
%F A402245 Asymptotic mean: Limit_{m->oo} (1/m) * Sum_{k=1..m} a(k) = 1.
%t A402245 s[n_] := Module[{e = IntegerExponent[n, 2]}, If[SquareFreeQ[n/2^e], e, Nothing]]; Array[s, 105]
%o A402245 (PARI) list(kmax) = {my(e); for(k = 1, kmax, e = valuation(k, 2); if(issquarefree(k >> e), print1(e, ", ")));}
%Y A402245 Cf. A007814, A122132.
%K A402245 nonn,easy,new
%O A402245 1,4
%A A402245 _Amiram Eldar_, Nov 16 2026
