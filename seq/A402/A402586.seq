%S A402586 9,279,6,1053,189,372,231,5751,2565,5859,1053,702,17,7161,9,67797,513,
%T A402586 513,207,22113,11,2511,696,7668,1029,1054,3750,2079,5301,558,6993,
%U A402586 14238099,702,31806,441,60021,1353,6417,340,120771,2322,682,3807,123201,7695,1392,53,45198,199287,31899,684,1989,5487,46500,3159
%N A402586 a(n) = A341526(A003961(2*n)), where A341526(n) is the numerator of ratio n*sigma(A003961(n)) / sigma(n)*A003961(n), where sigma is the sum of divisors of n, and A003961 shifts the prime factorization of n one step towards larger primes.
%C A402586 By the lemma given in A341529, A402586(n)/A402587(n), like all ratios for arrays A341626/A341627, is confined to open interval (0.5 .. 1). See the plot.
%H A402586 Antti Karttunen, <a href="/A402586/b402586.txt">Table of n, a(n) for n = 1..10000</a>
%H A402586 Antti Karttunen, <a href="https://oeis.org/plot2a?name1=A402586&amp;name2=A402587&amp;tform1=untransformed&amp;tform2=untransformed&amp;shift=0&amp;radiop1=ratio&amp;drawpoints=true">Ratio A402586(n)/A402587(n) plotted with OEIS Plot tool</a>
%H A402586 <a href="/index/Pri#prime_indices">Index entries for sequences computed from indices in prime factorization</a>.
%H A402586 <a href="/index/Si#SIGMAN">Index entries for sequences related to sigma(n)</a>.
%F A402586 a(n) = A341526(A249734(n)).
%o A402586 (PARI)
%o A402586 A003961(n) = { my(f=factor(n)); for(i=1, #f~, f[i, 1] = nextprime(f[i, 1]+1)); factorback(f); };
%o A402586 A341526(n) = { my(s=A003961(n)); numerator((sigma(s)*n)/(sigma(n)*s)); };
%o A402586 A402586(n) = A341526(A003961(2*n));
%Y A402586 Second row of array A341626.
%Y A402586 Cf. A000203, A003961, A249734, A341528, A341529, A402587 (denominators).
%Y A402586 Cf. also A401936.
%K A402586 nonn,easy,frac,new
%O A402586 1,1
%A A402586 _Antti Karttunen_, Nov 21 2026
