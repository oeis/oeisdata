%I A402061 #9 Nov 15 2026 10:32:32
%S A402061 1,1,1,1,3,1,1,5,1,1,1,7,2,3,1,1,9,2,6,1,1,1,11,3,10,3,3,1,1,13,3,15,
%T A402061 3,7,1,1,1,15,4,21,6,13,4,3,1,1,17,4,28,6,22,4,8,1,1,1,19,5,36,10,34,
%U A402061 10,16,5,3,1,1,21,5,45,10,50,10,30,5,9,1,1,1,23,6,55,15,70,20,50,15,19,6,3,1
%N A402061 Triangle read by rows: Sprugnoli array ( 1/(1 - x), x*(1 + x)/(1 - x), x/(1 - x^2) ).
%H A402061 Michael De Vlieger, <a href="/A402061/b402061.txt">Table of n, a(n) for n = 0..11475</a> (rows n = 0..150, flattened.)
%H A402061 Paul Barry, <a href="https://arxiv.org/abs/2611.05673">Orthogonal polynomials on two or more intervals: the Sprugnoli context</a>, arXiv:2611.05673 [math.CO], 2026. See p. 11.
%F A402061 T(n,k) = [x^n] g(x)*f_1(x)^(k mod 2)*(x*f_2(x))^floor(k/2), where g(x) = 1/(1 - x), f_1(x) = x*(1 + x)/(1 - x), and f_2(x) = x/(1 - x^2).
%F A402061 T(n,1) = A005408(n) for n > 0.
%F A402061 T(n,3) = A000217(n-2) for n > 1.
%F A402061 T(n,4) = A008805(n-4) for n > 3.
%F A402061 T(n,5) = A002623(n-5) for n > 4.
%F A402061 T(n,6) = A058187(n-6) for n > 5.
%F A402061 T(n,7) = A002624(n-7) for n > 6.
%F A402061 T(n,9) = A038163(n-9) for n > 8.
%F A402061 T(n,11) = A299336(n-11) for n > 10.
%F A402061 T(n,12) = A299338(n-12) for n > 11.
%e A402061 The triangle begins as:
%e A402061   1;
%e A402061   1,  1;
%e A402061   1,  3, 1;
%e A402061   1,  5, 1,  1;
%e A402061   1,  7, 2,  3, 1;
%e A402061   1,  9, 2,  6, 1,  1;
%e A402061   1, 11, 3, 10, 3,  3, 1;
%e A402061   1, 13, 3, 15, 3,  7, 1, 1;
%e A402061   1, 15, 4, 21, 6, 13, 4, 3, 1;
%e A402061   ...
%t A402061 g[x_]:=1/(1-x); f1[x_]:=x(1+x)/(1-x); f2[x_]:=x/(1-x^2); T[n_, k_]:=SeriesCoefficient[g[x]*f1[x]^Mod[k, 2]*(x*f2[x])^Floor[k/2], {x, 0, n}]; Table[T[n, k], {n, 0, 12}, {k, 0, n}]//Flatten
%Y A402061 Column k=0 and oblique side give A000012.
%Y A402061 Column k=2 gives A004526.
%Y A402061 Column k=8 gives A189976.
%Y A402061 Column k=10 gives A189980.
%Y A402061 Row sums give A402062.
%Y A402061 Cf. A000217, A002623, A002624, A005408, A008805, A038163, A058187, A299336.
%K A402061 nonn,easy,tabl,new
%O A402061 0,5
%A A402061 _Stefano Spezia_, Nov 12 2026
