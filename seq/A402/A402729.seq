%I A402729 #8 Nov 26 2026 13:50:45
%S A402729 1,4,16,60,172,464,1176,2648,5692,11544,21992,40128,70412,118396,
%T A402729 193224,306400,473312,713496,1058512,1531992,2191544,3070360,4260088,
%U A402729 5791972,7838756,10394556,13748608,17858884,23163600,29516132,37652680,47191180,59259780
%N A402729 Expansion of g.f. Phi^6*F^2, where Phi = g.f. for A028930 and F = g.f. for A028959.
%C A402729 a(n) is the number of representations of n by the 16-variable quadratic form that is the sum of 6 copies of 2*x^2 + x*y + 3*y^2 and 2 copies of x^2 + x*y + 6*y^2.
%H A402729 Karan Sharma, <a href="/A402729/b402729.txt">Table of n, a(n) for n = 0..1000</a>
%H A402729 Bülent Köklüce, <a href="https://doi.org/10.1007/s11139-013-9480-4">Cusp forms in S_6(Gamma_0(23)), S_8(Gamma_0(23)) and the number of representations of numbers by some quadratic forms in 12 and 16 variables</a>, Ramanujan J. 34 (2014), 187-208. See p. 204.
%o A402729 (PARI) th(M, N) = 1 + 2*x*Ser(qfrep(M, N, 1), x);
%o A402729 a(n) = polcoef(th([4, 1; 1, 6], n+1)^6 * th([2, 1; 1, 12], n+1)^2, n);
%Y A402729 Cf. A028930, A028959, A328527, A328528, A328529, A328530, A328531, A328532, A328533, A328534, A328535, A328536, A401430, A401474.
%K A402729 nonn,new
%O A402729 0,2
