%S A402004 17,179,197,827,1151,3527,4481,4787,5021,5741,5867,6551,6569,7127,
%T A402004 10331,10889,12041,13337,17207,17657,17747,19421,25307,28277,34127,
%U A402004 36467,39041,41849,52541,56501,57347,59219,69929,72269,75167,75401,79811,81017,83717,86111
%N A402004 Lesser twin primes p such that (7*p+4)/3 is also a lesser twin prime.
%C A402004 Terms are the primes p = A001359(k) for which A401268(k) = 0.
%C A402004 All terms are congruent to 17 (mod 18).
%C A402004 Equivalently, p = 3*m-1 where 3*m-1, 3*m+1, 7*m-1 and 7*m+1 are all prime.
%e A402004 17 is a term: 17 and 19 are twin primes, (7*17+4)/3 = 41, and 41 and 43 are twin primes.
%e A402004 179 is a term: (7*179+4)/3 = 419, and 419 and 421 are twin primes.
%p A402004 mf:= m -> andmap(isprime, [3*m-1,3*m+1,7*m-1,7*m+1]):
%p A402004 map(t -> 3*t-1,select(mf, [seq(m,m=6..30000,6)])); # _Robert Israel_, Nov 11 2026
%o A402004 (Python)
%o A402004 from sympy import isprime
%o A402004 def ok(p): return isprime(p) and isprime(p+2)
%o A402004 print([p for p in range(3, 90000) if ok(p) and (7*p+4)%3==0 and ok((7*p+4)//3)])
%Y A402004 Cf. A001359, A401268.
%K A402004 nonn,new
%O A402004 1,1
