%S A402587 10,325,7,1250,220,455,260,6875,3038,7150,1190,875,19,8450,11,81250,
%T A402587 575,637,232,27500,13,2975,775,9625,1210,1235,4459,2500,5920,715,7790,
%U A402587 17078125,833,37375,520,75950,1505,7540,399,151250,2585,845,4240,148750,9548,1625,59,56875,224770,39325,805,2375,6100,57967
%N A402587 a(n) = A341527(A003961(2*n)), where A341527(n) is the denominator of ratio n*sigma(A003961(n)) / sigma(n)*A003961(n), where sigma is the sum of divisors of n, and A003961 shifts the prime factorization of n one step towards larger primes.
%H A402587 Antti Karttunen, <a href="/A402587/b402587.txt">Table of n, a(n) for n = 1..10000</a>
%H A402587 <a href="/index/Pri#prime_indices">Index entries for sequences computed from indices in prime factorization</a>.
%H A402587 <a href="/index/Si#SIGMAN">Index entries for sequences related to sigma(n)</a>.
%F A402587 a(n) = A341527(A249734(n)).
%o A402587 (PARI)
%o A402587 A003961(n) = { my(f=factor(n)); for(i=1, #f~, f[i, 1] = nextprime(f[i, 1]+1)); factorback(f); };
%o A402587 A341527(n) = { my(s=A003961(n)); denominator((sigma(s)*n)/(sigma(n)*s)); };
%o A402587 A402587(n) = A341527(A003961(2*n));
%Y A402587 Second row of array A341627.
%Y A402587 Cf. A000203, A003961, A249734, A402586 (numerators).
%Y A402587 Cf. also A401937.
%K A402587 nonn,easy,frac,new
%O A402587 1,1
%A A402587 _Antti Karttunen_, Nov 21 2026
