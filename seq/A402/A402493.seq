%T A402493 1,2,2,5,3,11,1,2,4,8,3,2,7,30,4,5,4,1,3,1,10,1,1,2,3,4,2,4,18,12,3,
%U A402493 15,5,2,10,3,1,3,1,5,5,4,31,3,6,3,1,5,3,1
%N A402493 a(n) = least k >= 1 such that prime(n)*prime(n+1) + k*(prime(n+1) - prime(n)) is prime.
%C A402493 a(n) exists for all n since gcd(prime(n)*prime(n+1), prime(n+1)-prime(n)) = 1 and Dirichlet's theorem applies.
%H A402493 Michael S. Branicky, <a href="/A402493/b402493.txt">Table of n, a(n) for n = 1..10000</a>
%e A402493 a(4) = 3 because prime(4)*prime(5) = 7*11 = 77 and the gap is 11 - 7 = 4. The numbers 77 + 4 = 81 and 77 + 2*4 = 85 are composite, but 77 + 3*4 = 89 is prime.
%e A402493 a(5) = 3 because 11*13 = 143, the gap is 2, and 145 and 147 are composite, but 149 is prime.
%p A402493 f:= proc(n) local p,q,a,b,k;
%p A402493   p:= ithprime(n); q:= nextprime(p);
%p A402493   a:= p*q; b:= q-p;
%p A402493   for k from 1 do
%p A402493     if isprime(a+b*k) then return k fi
%p A402493   od
%p A402493 end proc:
%p A402493 map(f, [$1..100]); # _Robert Israel_, Nov 19 2026
%t A402493 q = 2; Table[Set[{k, p, q}, {1, q, NextPrime[q]}]; While[! PrimeQ[p*q + k*(q - p)], k++]; k, {n, 84}] (* _Michael De Vlieger_, Nov 23 2026 *)
%o A402493 (Python)
%o A402493 from sympy import prime, isprime
%o A402493 def a(n):
%o A402493     p, q = prime(n), prime(n+1)
%o A402493     k = 1
%o A402493     while not isprime(p*q + k*(q-p)):
%o A402493         k += 1
%o A402493     return k
%o A402493 print([a(n) for n in range(1, 85)])
