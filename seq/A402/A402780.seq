%S A402780 1,1,3,4,10,6,21,24,27,20,55,24,78,42,60,88,136,54,171,80,126,110,253,
%T A402780 120,250,156,270,168,406,120,465,336,330,272,420,216,666,342,468,400,
%U A402780 820,252,903,440,540,506,1081,480,1029,500,816,624,1378,513,1100,840,1026
%N A402780 Sum of the integers k from 1 to n such that gcd(n, k) is a cubefull number.
%C A402780 The number of these integers is A384040(n).
%H A402780 Amiram Eldar, <a href="/A402780/b402780.txt">Table of n, a(n) for n = 1..10000</a>
%H A402780 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402780 a(n) = Sum_{k=1..n, gcd(n, k) is cubefull} k = Sum_{k=1..n} c(gcd(n, k)) * k, where c is the characteristic function of cubefull numbers.
%F A402780 a(n) = n * (c(n) + A384040(n)) / 2, where c is the characteristic function of cubefull numbers.
%F A402780 Dirichlet g.f.: ((zeta(s-1) + zeta(s-2))/2) * Product_{p prime} (1 - 1/p^(s-1) + 1/p^(3*s-3)).
%F A402780 Sum_{k=1..n} a(k) ~ c * n^3 / 6, where c = Product_{p prime} (1 - 1/p^2 + 1/p^6) = 0.62159731307414305346... .
%t A402780 f1[p_, e_] := Boole[e > 2];
%t A402780 f2[p_, e_] := If[e < 3, (p-1)*p^(e-1), p^(e-3)*(p^3 - p^2 + 1)];
%t A402780 a[1] = 1; a[n_] := Module[{f = FactorInteger[n]}, (n/2)*(Times @@ f1 @@@ f + Times @@ f2 @@@ f)]; Array[a, 57]
%o A402780 (PARI) a(n) = {my(f = factor(n)); (prod(i = 1, #f~, f[i, 2] > 2) + prod(i = 1, #f~, if(f[i, 2] < 3, (f[i, 1] - 1)*f[i, 1]^(f[i, 2] - 1), f[i, 1]^(f[i, 2]-3)*(f[i, 1]^3 - f[i, 1]^2 + 1)))) * n /2;}
%Y A402780 Cf. A036966, A384040.
%Y A402780 Sum of the integers k from 1 to n such that gcd(n, k) is: A023896 (1), A119790 (prime power, A246655), A390800 (power of prime, A000961), A390801 (prime), A390802 (odd), A390803 (5-rough), A390804 (power of 2), A390805 (3-smooth), A390806 (squarefree), A390807 (cubefree), A390808 (square), A390809 (1 or 2), A402778 (cube), A402779 (powerful), this sequence (cubefull), A402781 (exponentially odd).
%K A402780 nonn,easy,new
%O A402780 1,3
