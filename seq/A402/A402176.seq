%I A402176 #5 Nov 25 2026 20:59:39
%S A402176 1,1,3,2,3,18,926,150,12,1317,21,1062046,1472,84919,1883815,
%T A402176 1890540477,15966,113,1979640,1605828925095,302491776677,
%U A402176 3761444042315,202,4154533920820,184605,3911227954,27429774158,23143247640427220285105,135971054501947437,711207342634
%N A402176 a(n) is the number of ways to write m = A025487(A402175(n)) as a quotient in which every divisor d > 1 of m occurs exactly once as a factor of the numerator or denominator.
%C A402176 Two quotients are counted as different if some divisor d > 1 lies in the numerator in one and in the denominator in the other. As in A402175, the count depends only on the prime signature of m.
%C A402176 Let t = A000005(m) and let S be the set of divisors d > 1 placed in the denominator. The lower bounds in FORMULA follow from the following families of sets S, using the complementary divisor pairs {d, m/d}. If t = 4*j + 2, S consists of both members of j of the 2*j pairs other than {1, m}, or of m together with both members of j - 1 of these pairs (the second family is empty for j = 0). These two disjoint families contain binomial(2*j, j) + binomial(2*j, j - 1) = A001700(j) sets.
%C A402176 If m = q^4 > 1 and t = 4*j + 1, S contains either q^3 or both q and q^2, together with both members of j - 1 of the 2*j - 2 pairs other than {1, m} and {q, q^3}. These two disjoint families contain 2*A000984(j - 1) sets.
%H A402176 Felix Huber, <a href="/A402176/b402176.txt">Table of n, a(n) for n = 1..42</a>
%F A402176 a(n) = the coefficient of x_1^s_1*...*x_r^s_r in prod_{d|m, d>1}(1 + x_1^v_1(d)*...*x_r^v_r(d)), where m = A025487(A402175(n)) = p_1^e_1*...*p_r^e_r, t = A000005(m), s_i = e_i*(t - 2)/4, and v_i(d) is the exponent of p_i in d. All s_i are integers by A402175.
%F A402176 a(n) = A394723(j) if m = 2^A042948(j), j >= 0. This occurs for n = 1, 2, 4, 5, 9, 11, 18, 23, 35, 40, ...
%F A402176 a(n) >= A001700(j) if t = 4*j + 2, j >= 0.
%F A402176 a(n) >= 2*A000984(j - 1) if m = q^4 > 1 and t = 4*j + 1, j >= 1.
%F A402176 1 <= a(n) <= 2^(t - 1).
%e A402176 a(1) = 1: m = A025487(A402175(1)) = 1 has no divisors d > 1, and the empty quotient equals m.
%e A402176 a(3) = 3: m = A025487(A402175(3)) = 12, with quotients (2*3*4*6)/12, (3*4*12)/(2*6), and (2*6*12)/(3*4).
%e A402176 a(4) = 2: m = A025487(A402175(4)) = 16, with quotients (2*4*16)/8 and (8*16)/(2*4).
%p A402176 A402176 := proc(n)
%p A402176     local b, c, d, f, g, h, i, j, m, q, r, s, t, v, w, z;
%p A402176     t := 1;
%p A402176     g := proc(i, e, m, d)
%p A402176         local j, p, x;
%p A402176         h[m] := evalb(irem(d, 4) = 2 or iroot(m, 4)^4 = m); p := ithprime(i); x := m;
%p A402176         for j to e while x*p <= t do
%p A402176             x := x*p;
%p A402176             g(i + 1, j, x, d*(j + 1));
%p A402176         end do;
%p A402176     end proc;
%p A402176     do
%p A402176         h := table(); g(1, t, 1, 1); v := select(x -> h[x], sort([indices(h, 'nolist')]));
%p A402176         if nops(v) >= n then break end if;
%p A402176         t := 2*t;
%p A402176     end do;
%p A402176     m := v[n]; f := ifactors(m)[2]; r := nops(f); c := mul(f[i][2] + 1, i = 1 .. r);
%p A402176     s := [seq(f[i][2]*(c - 2)/4, i = 1 .. r)];
%p A402176     w := [seq(mul(f[j][2]*c/2 + 1, j = 1 .. i - 1), i = 1 .. r)];
%p A402176     z := add(s[i]*w[i], i = 1 .. r); b := Array(0 .. z, 'fill' = 0); b[0] := 1;
%p A402176     for d in (NumberTheory:-Divisors(m) minus {1}) do
%p A402176         q := add(padic:-ordp(d, f[i][1])*w[i], i = 1 .. r);
%p A402176         for j from z by -1 to q do
%p A402176             b[j] := b[j] + b[j - q];
%p A402176         end do;
%p A402176     end do;
%p A402176     b[z];
%p A402176 end proc:
%p A402176 seq(A402176(n), n = 1 .. 12);
%Y A402176 Cf. A000005, A000984, A001700, A025487, A042948, A394723, A402175.
%K A402176 nonn,new
%O A402176 1,3
%A A402176 _Felix Huber_, Nov 19 2026
