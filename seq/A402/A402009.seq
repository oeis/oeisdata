%I A402009 #21 Nov 18 2026 10:56:32
%S A402009 0,1,1,2,2,2,3,1,3,2,3,4,2,2,3,4,3,4,5,1,3,2,3,2,4,5,3,4,5,6,3,2,3,4,
%T A402009 7,3,4,3,4,5,6,4,5,6,7,1,4,2,3,2,4,5,2,8,3,4,5,3,4,5,6,7,4,5,6,7,8,2,
%U A402009 2,4,5,5,3,4,5,3,4,5,6,3,8,9,4,5,6,9,4,5,5,6,7,8,5,6,7,8,9
%N A402009 A multidimensional generalization of the city building sequence A400000, giving the height of buildings located at (x_1, ..., x_k, 0, 0, ...) for partitions (x_1, ..., x_k) in the order given by A080577.
%C A402009 For nonnegative integers x_1, x_2, ..., finitely many of which are nonzero, define H(x_1, x_2, ...) recursively as the smallest height h of a building located at x = (x_1, x_2, ...) such that exactly h buildings are visible in decreasing, axis parallel directions. More precisely, consider the building at x-r*e_i, where e_i is the i-th unit vector and 1 <= r <= x_i. Such a building is visible from the building at x if every intermediate building at x-s*e_i, 1 <= s < r, has its top on or below the straight line joining the tops of the buildings at x and x-r*e_i. H(x) is the smallest height h for which exactly h such buildings are visible from the building at x.
%C A402009 H(x_1, x_2, ...) always exists. This can be proved in the same way as for A400000.
%C A402009 By symmetry, H is invariant under permutations of the coordinates. Thus H depends only on the integer partition formed by the nonzero coordinates.
%C A402009 Define a(n) = H(x_1, ..., x_k) = H(x_1, ..., x_k, 0, 0, ...), where (x_1, ..., x_k) is the n-th integer partition in the ordering of A080577, starting with the empty partition at n = 0.
%C A402009 In contrast to A400000, A401750, and A402010, coordinates start at 0 instead of 1.
%H A402009 Pontus von Brömssen, <a href="/A402009/b402009.txt">Table of n, a(n) for n = 0..11731</a> (partitions with sum 0..26)
%F A402009 With the convention A000070(-1) = 0:
%F A402009   A400000(n) = H(n-1) = a(A000070(n-2)) for n >= 1;
%F A402009   A401750(n,k) = H(n-1,k-1) = a(A000070(n+k-3)+A000070(k-2)) for n >= k >= 1.
%e A402009 a(0) = H() = 0.
%e A402009 a(1) = H(1) = A400000(2) = 1.
%e A402009 a(2) = H(2) = A400000(3) = 1.
%e A402009 a(3) = H(1,1) = A401750(2,2) = 2.
%e A402009 a(4) = H(3) = A400000(4) = 2.
%e A402009 a(5) = H(2,1) = A401750(3,2) = 2.
%e A402009 a(6) = H(1,1,1) = 3, because the three buildings at (1,1,0), (1,0,1), and (0,1,1) are visible from the building at (1,1,1) regardless of its height.
%o A402009 (Python)
%o A402009 from functools import cache
%o A402009 from itertools import count
%o A402009 from sympy.combinatorics import IntegerPartition
%o A402009 @cache
%o A402009 def H(p):
%o A402009     # This function is not parameterized in the same way as in the definition of H in the comment above.
%o A402009     # Here, p[k] is the number of occurrences of k+1 in x = (x_1, x_2, ...) in the definition, k >= 0.
%o A402009     for a in count():
%o A402009         c = 0
%o A402009         for x,m in enumerate(p,1):
%o A402009             if m == 0: continue
%o A402009             dx0 = dy0 = 0
%o A402009             for dx in range(1,x+1):
%o A402009                 pp = list(p)
%o A402009                 pp[x-1] -= 1
%o A402009                 if dx != x: pp[x-dx-1] += 1
%o A402009                 if x == len(p) and pp[-1] == 0:
%o A402009                     i0 = next((i for i,m in enumerate(pp[-2::-1],1) if m != 0),0)
%o A402009                     del pp[-i0:]
%o A402009                 dy = H(tuple(pp))-a
%o A402009                 if dx0*dy >= dx*dy0:
%o A402009                     c += m
%o A402009                     if c > a: break
%o A402009                     dx0,dy0 = dx,dy
%o A402009             else: continue
%o A402009             break
%o A402009         else:
%o A402009             if c == a: break
%o A402009     return a
%o A402009 def A402009_generator():
%o A402009     yield H(())
%o A402009     for n in count(1):
%o A402009         p = IntegerPartition([n])
%o A402009         while True:
%o A402009             p_dict = p.as_dict()
%o A402009             yield H(tuple(p_dict[x] if x in p_dict else 0 for x in range(1,max(p_dict)+1)))
%o A402009             if len(p.args[1]) == n: break
%o A402009             p = p.prev_lex()
%Y A402009 Cf. A000070, A080577, A400000 (1 dimension), A401750 (2 dimensions), A402010 (diagonals).
%K A402009 nonn,new
%O A402009 0,4
%A A402009 _Pontus von Brömssen_, Nov 13 2026
