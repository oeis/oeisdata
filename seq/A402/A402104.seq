%I A402104 #6 Nov 18 2026 19:27:10
%S A402104 60,59040,2839680,6120,667800,1560,78950040,32655480,84466200,
%T A402104 588850080,73080,556920,3298680,106210398840,557759562360,1441440,
%U A402104 69116927880,52092811680,10210200,1481376812160,25714448760,16136491800,7603666816200,3390538341960,4170556309920,92951304600,10874118255000
%N A402104 a(n) is the first term of A393526 that can be written in exactly n ways as the difference of two squares of primes, or -1 if there is no such term.
%C A402104 a(n) is the least number k of the form a*b*c*r, where (a,b,c) is a primitive Pythagorean triple with inradius r, such that there are exactly n pairs of primes (p,q) with k = p^2 - q^2.
%H A402104 Robert Israel, <a href="/A402104/b402104.txt">Table of n, a(n) for n = 0..112</a>
%e A402104 a(3) = 6120 because 6120 = A393526(3) and 6120 = 79^2-11^2 = 103^2-67^2 = 107^2-73^2 with 79, 11, 103, 67, 107 and 73 prime.
%p A402104 # using a list B of terms of A393526
%p A402104 f:= proc(n)
%p A402104    nops(select(d -> d^2 > n and (d-n/d)::even and isprime((d + n/d)/2) and isprime((d - n/d)/2),
%p A402104      NumberTheory:-Divisors(n)))
%p A402104 end proc:
%p A402104 M:= 30: # for a(0) .. a(M), assuming such terms are in B
%p A402104 V:= Array(0..M): count:= 0:
%p A402104 for b in B while count < M+1 do
%p A402104   v:= f(b);
%p A402104   if v <= M and V[v] = 0 then V[v]:= b; count:= count+1 fi
%p A402104 od:
%p A402104 convert(V,list);
%Y A402104 Cf. A092204, A393526.
%K A402104 nonn,new
%O A402104 0,1
%A A402104 _Will Gosnell_ and _Robert Israel_, Nov 12 2026
