%N A402032 Row sums of the triangle A402031.
%t A402032 nmax=27; g[x_]:=(1-2x+3x^2)/(1+12x^2+15x^4); f1[x_]:=x/(1-2x+3x^2); f2[x_]:=x/(1+12x^2+15x^4); A402029[n_,k_]:=SeriesCoefficient[g[x]*f1[x]^Mod[k,2]*(x*f2[x])^Floor[k/2],{x,0,n}]; A402031=Inverse[Table[If[k <= n, T[n, k], 0], {n, 0, nmax}, {k, 0, nmax}]]; a[n_]:=Total[Table[A402031[[n + 1, k + 1]], {k, 0, n}]]; Array[a,nmax,0]
