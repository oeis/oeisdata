%I A402651 #13 Nov 23 2026 09:25:17
%S A402651 1,1,1,1,1,1,1,6,1,1,1,6,1,1,6,6,1,1,1,6,6,1,1,35,1,1,1,6,1,6,1,6,6,1,
%T A402651 6,6,1,1,6,35,1,6,1,6,6,1,1,35,1,1,6,6,1,1,6,35,6,1,1,35,1,1,6,6,6,6,
%U A402651 1,6,6,6,1,35,1,1,6,6,6,6,1,35,1,1,1,35,6
%N A402651 a(n) = A289383(A046072(n)); for n >= 3, number of prime races modulo n.
%C A402651 For the definition of prime races modulo n, see A400017.
%H A402651 Jianing Song, <a href="/A402651/b402651.txt">Table of n, a(n) for n = 1..10000</a>
%H A402651 Greg Martin and Daniel Fiorilli, <a href="https://personal.math.ubc.ca/~gerg/slides/Chennai-31Aug10.pdf">Prime number races: An asymptotic formula for the densities</a>, Analytic and Combinatorial Number Theory, Institute of Mathematical Sciences, Chennai, India. August 31, 2010.
%H A402651 Wikipedia, <a href="https://en.wikipedia.org/wiki/Chebyshev%27s_bias">Chebyshev's bias</a>.
%F A402651 a(n) = (2^m - 1)*A006116(m-1), m = A046072(n).
%e A402651 For n = 8, there are 3 prime races of index 2:
%e A402651   (H,S) = ({1,3}, {5,7}), T = {chi_{-8}};
%e A402651   (H,S) = ({1,5}, {3,7}), T = {chi_{-4}};
%e A402651   (H,S) = ({1,7}, {3,5}), T = {chi_8},
%e A402651 and 3 prime races of index 4:
%e A402651   (H,S) = ({1}, {3}), T = {chi_{-4}, chi_8};
%e A402651   (H,S) = ({1}, {5}), T = {chi_8, chi_{-8}};
%e A402651   (H,S) = ({1}, {7}), T = {chi_{-4}, chi_{-8}}.
%e A402651 For n = 24, there are 7 prime races of index 2:
%e A402651   (H,S) = ({1,5,7,11}, {13,17,19,23}), T = {chi_{-24}};
%e A402651   (H,S) = ({1,5,13,17}, {7,11,19,23}), T = {chi_{-4}};
%e A402651   (H,S) = ({1,5,19,23}, {7,11,13,17}), T = {chi_24};
%e A402651   (H,S) = ({1,7,13,19}, {5,11,17,23}), T = {chi_{-3}};
%e A402651   (H,S) = ({1,7,17,23}, {5,11,13,19}), T = {chi_8};
%e A402651   (H,S) = ({1,11,13,23}, {5,7,17,19}), T = {chi_12};
%e A402651   (H,S) = ({1,11,17,19}, {5,7,13,23}), T = {chi_{-8}},
%e A402651 and 7 prime races of index 8:
%e A402651   (H,S) = ({1}, {5}), T = {chi_{-3}, chi_8, chi_{-8}, chi_12};
%e A402651   (H,S) = ({1}, {7}), T = {chi_{-4}, chi_{-8}, chi_12, chi_24};
%e A402651   (H,S) = ({1}, {11}), T = {chi_{-3}, chi_{-4}, chi_8, chi_24};
%e A402651   (H,S) = ({1}, {13}), T = {chi_8, chi_{-8}, chi_24, chi_{-24}};
%e A402651   (H,S) = ({1}, {17}), T = {chi_{-3}, chi_12, chi_24, chi_{-24}};
%e A402651   (H,S) = ({1}, {19}), T = {chi_{-4}, chi_8, chi_12, chi_{-24}};
%e A402651   (H,S) = ({1}, {23}), T = {chi_{-3}, chi_{-4}, chi_{-8}, chi_{-24}}.
%e A402651 For the 21 prime races of index 4, see A401958.
%o A402651 (PARI) a(n) = if(n<=2, 1, my(m=#znstar(n)[2]); (matpascal(m-1, 2) * matrix(m, 1, i, j, 1))[m,1] * (2^m - 1))
%Y A402651 Cf. A046072, A239383, A006116, A401958. Row sums of A400017.
%Y A402651 Cf. A033948 (indices of 1), A102476 (indices of new values).
%K A402651 nonn,new
%O A402651 1,8
%A A402651 _Jianing Song_, Nov 22 2026
