%I A402533 #7 Nov 24 2026 03:07:37
%S A402533 14641,58564,131769,234256,366025,527076,923521,937024,1185921,
%T A402533 1464100,2108304,2825761,3294225,3694084,3748096,4231249,4743684,
%U A402533 5856400,7745089,8311689,8433216,9150625,10673289,11303044,12313081,13176900,13845841,14776336,14992384,16924996
%N A402533 Numbers m for which the smallest k > 1 such that k divides sigma(k*m) is equal to 5.
%C A402533 Numbers m such that A049605(m) = 5.
%C A402533 All the terms are squares.
%C A402533 A square number m is a term if and only if its prime factorization has at least one prime factor p == 1 (mod 5) with an exponent e == 4 (mod 10), and all its prime factors p == 1 (mod 3) have an exponent e == 0 or 4 (mod 6).
%H A402533 Amiram Eldar, <a href="/A402533/b402533.txt">Table of n, a(n) for n = 1..10000</a>
%F A402533 Sum_{n>=1} 1/a(n) = Product_{primes p == 1 (mod 3)} (1 + 1/p^4)/(1 - 1/p^6) * Product_{primes p != 1 (mod 3)} 1/(1 - 1/p^2) - (75/64) * Product_{prime p == 2, 8, or 14 (mod 15)} (1 - 1/p^2) * Product_{prime p == 4, 7, or 13 (mod 15)} (1 + 1/p^4)/(1 - 1/p^6) * Product_{prime p == 11 (mod 15)} (1 + 1/p^6)/(1 - 1/p^10) * Product_{prime p == 1 (mod 15)} (1 + 1/p^6)*(1 + 1/p^10)*(1 + 1/p^12)/(1 - 1/p^30) = 0.0001103010003937... .
%t A402533 q[m_] := Module[{f = FactorInteger[m]}, AllTrue[f, Mod[First[#], 3] != 1 || Mod[Last[#], 6] != 2 &] && AnyTrue[f, Mod[First[#], 5] == 1 && Mod[Last[#], 10] == 4 &]]; Select[Range[4200]^2, q]
%o A402533 (PARI) isok(m) = if(issquare(m), my(f = factor(m), ok = 0); for(i = 1, #f~, if(f[i, 1] % 3 == 1 && f[i, 2] % 6 == 2, return(0)); if(f[i, 1] % 5 == 1 && f[i, 2] % 10 == 4, ok = 1)); ok, 0);
%Y A402533 Cf. A000203 (sigma), A049605.
%Y A402533 Smallest k > 1 such that k divides sigma(k*m): A028983 (k = 2), A067051 (k = 3), this sequence (k = 5), A072862 (k = 6).
%K A402533 nonn,easy,new
%O A402533 1,1
%A A402533 _Amiram Eldar_, Nov 20 2026
