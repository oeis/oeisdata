%T A402231 11927724720,117462513168,1165493695464,11640248292288,
%U A402231 116929064980056,1180626550585152,11975554917588624,121975042856240112,1246999597381941864,12791835532462832208,131625892179685049256
%N A402231 Number of closed non-backtracking walks of length n starting and ending at a fixed vertex of the face-centered cubic lattice.
%C A402231 The same numbers hold at every sphere of the hexagonal close packing and of every close-packed stacking (dhcp, ..., periodic or not); the corresponding statement for all closed walks (A002899) is Thorpe (1972) for periodic stackings.
%D A402231 M. F. Thorpe, Random walks in polytype structures, J. Math. Phys. 13 (1972), 294-299.
%H A402231 DICTO, <a href="https://doi.org/10.5281/zenodo.24037664">Every Site Hears the Same: the Loop Equality Is a Theorem</a>, Zenodo (2026), Corollary 3.
%F A402231 G.f.: 10*x^2/(1-x^2) - 22*x^2/(1+11*x^2) + ((1-11*x^2)/(1+11*x^2))*(F(x/(1+11*x^2)) - 1), where F(x) is the g.f. for A002899 (Ihara-Bass formula for a 12-regular net).
%e A402231 a(3) = 48: each vertex lies on 24 triangles (the 24 edges of its cuboctahedron of neighbors), walked in 2 directions.
%o A402231 (Python)
%o A402231 from math import comb
%o A402231 from fractions import Fraction
%o A402231 def domb(n):  # A002895
%o A402231     return sum(comb(n,k)**2*comb(2*k,k)*comb(2*n-2*k,n-k) for k in range(n+1))
%o A402231 def fcc(n):   # A002899
%o A402231     return sum(comb(n,k)*(-4)**(n-k)*domb(k) for k in range(n+1))
%o A402231 def loops(W, q):  # Ihara-Bass per vertex of a (q+1)-regular net; W[i] = closed i-step walks
%o A402231     M = len(W)-1; c = [Fraction(0)]*(M+1)
%o A402231     for k in range(1, M//2+1): c[2*k] += Fraction(q-1, 2*k)
%o A402231     for j in range(1, M+1):
%o A402231         for i in range(j+1):
%o A402231             if 2*j-i <= M: c[2*j-i] += Fraction(comb(j,i)*W[i]*(-q)**(j-i), j)
%o A402231     return [int(m*c[m]) for m in range(1, M+1)]   # lengths 1..M
%o A402231 print(loops([fcc(i) for i in range(23)], 11))
%Y A402231 Cf. A002899, A002895, A400949 (diamond analog), A293237.
%K A402231 nonn,walk,new
%O A402231 1,3
%A A402231 _James Baker_, Nov 15 2026
