%T A402484 187,219,269,323,392,460,561,659,795,937,1122,1319,1578,1848,2195,
%U A402484 2573,3037,3546,4184,4875,5722,6661,7793,9049,10563,12234,14233,16468,19109
%N A402484 Number of partitions of n such that (greatest part) / (least part) = number of parts.
%F A402484 G.f.: Sum_{i>=0, j>=1} x^((2*i+1)*j) * Product_{k=1..i-1} (1 - x^(i*j+k)) / (1 - x^k).
%e A402484 a(10) = 5 because we have [10], [6,2,2], [5,2,1,1,1], [4,4,1,1] and [4,3,2,1].
%t A402484 nmax = 55; CoefficientList[Series[Sum[x^((2 i + 1) j) Product[(1 - x^(i j + k))/(1 - x^k), {k, 1, i - 1}], {i, 0, nmax}, {j, 1, Floor[nmax/(2 i + 1)]}], {x, 0, nmax}], x] // Rest
