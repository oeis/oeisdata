%I A402600 #10 Nov 25 2026 15:19:09
%S A402600 1,2,2,3,2,4,2,5,6,7,2,8,2,9,10,11,2,12,2,13,14,15,2,16,17,18,19,20,2,
%T A402600 21,2,22,23,24,25,26,2,27,28,29,2,30,2,31,32,33,2,34,35,36,37,38,2,39,
%U A402600 28,40,41,42,2,43,2,44,45,46,47,48,2,49,50,51,2,52,2,53,54,55,47,56,2,57,58,59,2,60,41,61,62,63,2,64,37,65,66,67,68,69,2
%N A402600 Lexicographically earliest infinite sequence such that a(i) = a(j) => A001065(i) = A001065(j), A034460(i) = A034460(j) and A046523(i) = A046523(j) for all i, j >= 1, where A001065(n) = sigma(n)-n, A034460 = usigma(n)-n, and A046523(n) is the smallest number with same prime signature as n.
%C A402600 Restricted growth sequence transform of the ordered triple [A001065(n), A034460(n), A046523(n)].
%C A402600 For all i, j >= 1:
%C A402600   A305800(i) = A305800(j) => a(i) = a(j),
%C A402600   a(i) = a(j) => A300235(i) = A300235(j),
%C A402600   a(i) = a(j) => A401722(i) = A401722(j) => A048146(i) = A048146(j),
%C A402600   a(i) = a(j) => A395435(i) = A395435(j).
%H A402600 Antti Karttunen, <a href="/A402600/b402600.txt">Table of n, a(n) for n = 1..100000</a>
%o A402600 (PARI)
%o A402600 up_to = 100000;
%o A402600 rgs_transform(invec) = { my(om = Map(), outvec = vector(length(invec)), u=1); for(i=1, length(invec), if(mapisdefined(om, invec[i]), my(pp = mapget(om, invec[i])); outvec[i] = outvec[pp] , mapput(om, invec[i], i); outvec[i] = u; u++ )); outvec; };
%o A402600 A001065(n) = (sigma(n)-n);
%o A402600 A034460(n) = { my(f=factorint(n)); (prod(k=1, #f~, 1+(f[k, 1]^f[k, 2]))-n); };
%o A402600 A046523(n) = { my(f=vecsort(factor(n)[, 2], , 4), p); prod(i=1, #f, (p=nextprime(p+1))^f[i]); };
%o A402600 Aux402600(n) = [A001065(n), A034460(n), A046523(n)];
%o A402600 v402600 = rgs_transform(vector(up_to, n, Aux402600(n)));
%o A402600 A402600(n) = v402600[n];
%Y A402600 Cf. A001065, A034460, A046523.
%Y A402600 Cf. A305800, A395435, A048146.
%Y A402600 Differs from A401722 first at n=104, where a(104) = 74, from A300249, A351260 first at n=105, where a(105) = 75, from A300235 first at n=153, where a(n) = 110, from A305895, A327931, A353560 and A373379 first at n=182, where a(182) = 124.
%K A402600 nonn,easy,new
%O A402600 1,2
%A A402600 _Antti Karttunen_, Nov 25 2026
