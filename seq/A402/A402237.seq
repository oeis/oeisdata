%S A402237 1,2,12,156,3600,130860,6924960,504544320,48551529600,5975468528400,
%T A402237 916853325141600,171767946969511200,38618371578606019200,
%U A402237 10269047100499819632000,3189692300725849686768000,1144943451627825358821312000,470507009540593235344662528000
%N A402237 Number of acyclic digraphs (or DAGs) on n labeled nodes in which every node has in-degree at most 2 and there is exactly one source and exactly one sink.
%C A402237 A source is a node with in-degree 0 and a sink is a node with out-degree 0; for n = 1 the single node is both.
%C A402237 These are the project networks (activity-on-node) with one start activity and one finish activity in which every activity has at most 2 immediate predecessors.
%C A402237 Without the bound on the in-degree the count is A165950. With in-degree at most 1 it is n! (the directed Hamiltonian paths).
%C A402237 For n >= 2, a(n) is divisible by n*(n-1), since the number of these digraphs with a given source and a given sink is the same for every ordered pair of nodes.
%C A402237 a(n) = A165950(n) for n <= 3; a(4) = 156 against A165950(4) = 216.
%H A402237 Tyler Satchel Orden, <a href="/A402237/b402237.txt">Table of n, a(n) for n = 1..60</a>
%H A402237 Ira M. Gessel, <a href="https://doi.org/10.1016/0012-365X(95)00119-H">Counting acyclic digraphs by sources and sinks</a>, Discrete Math., 160 (1996), 253-258.
%F A402237 Let G(n,s) be the number of acyclic digraphs on n labeled nodes with in-degree at most 2 and exactly s sources, and let M(n,t,s) = binomial(n,t) * Sum_{j=0..min(t,s)} binomial(t,j) * e(n-t)^(t-j) * G(n-t,s-j), where e(m) = m*(m+1)/2 is the number of nonempty sets of at most 2 parents among m nodes (and 0^0 = 1). Then G(0,0) = 1, G(n,s) = Sum_{t=1..n} (-1)^(t+1)*M(n,t,s) for n >= 1, and a(n) = Sum_{t=1..n} (-1)^(t+1)*t*M(n,t,1).
%F A402237 (M(n,t,s) is the sum, over the sets X of t nodes, of the number of these digraphs with s sources in which every node of X is a sink; j is the number of nodes of X that are isolated.)
%e A402237 a(3) = 12: the 6 directed paths a -> b -> c and the same 6 paths with the extra arc a -> c.
%e A402237 a(4) = 156: of the 216 acyclic digraphs on 4 nodes with one source and one sink, 60 have a node with in-degree 3.
%o A402237 (Python)
%o A402237 from math import comb
%o A402237 def aList(N, k=2):  # a(1), ..., a(N)
%o A402237     e = lambda m: sum(comb(m, i) for i in range(1, k+1))
%o A402237     G = [[1]]  # G[n][s]: n nodes, s sources
%o A402237     def M(n, t, s):
%o A402237         m = n-t
%o A402237         return comb(n, t)*sum(comb(t, j)*e(m)**(t-j)*G[m][s-j] for j in range(min(t, s)+1) if s-j <= m)
%o A402237     a = []
%o A402237     for n in range(1, N+1):
%o A402237         G.append([sum((-1)**(t+1)*M(n, t, s) for t in range(1, n+1)) for s in range(n+1)])
%o A402237         a.append(sum((-1)**(t+1)*t*M(n, t, 1) for t in range(1, n+1)))
%o A402237     return a
%o A402237 print(aList(17))
%Y A402237 Cf. A165950 (no bound on the in-degree), A000142.
%Y A402237 Cf. A397711 (all acyclic digraphs with in-degree at most 2).
%Y A402237 Cf. A195737 (one source, any number of sinks).
%K A402237 nonn,new
%O A402237 1,2
%A A402237 _Tyler Satchel Orden_, Nov 16 2026
