%N A402599 Nonsquarefree numbers that have no p^p-factors and whose least prime factor appears with multiplicity 1.
%C A402599 Sequence A276086(A392611(.)), sorted into ascending order.
%H A402599 Antti Karttunen, <a href="/A402599/b402599.txt">Table of n, a(n) for n = 1..10000</a>
%t A402599 Select[Range[1200], Function[facs, And[AnyTrue[facs[[;; , -1]], # > 1 &], facs[[1, -1]] == 1, NoneTrue[facs, #1 <= #2 & @@ # &] ] ]@ FactorInteger[#] &] (* _Michael De Vlieger_, Nov 27 2026 *)
%o A402599 (PARI) is_A402599(n) = if(n<2 || issquarefree(n), 0, my(f = factor(n)); if(f[1,2]>1, 0, for(k=2, #f~, if(f[k,2]>=f[k,1], return(0))); (1)));
