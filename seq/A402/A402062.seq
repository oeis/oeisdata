%N A402062 Expansion of g.f. (1 + x)*(1 + x^2)/((1 - x)*(1 - 2*x^2)).
%H A402062 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (1,2,-2).
%F A402062 a(n) = a(n-1) + 2*a(n-2) - 2*a(n-3) for n > 3.
%F A402062 a(n) = -4 + 3*2^((n-5)/2)*(4 - 4*(-1)^n + 3*sqrt(2) + 3*(-1)^n*sqrt(2)) for n > 0.
%F A402062 E.g.f.: (1 - 8*cosh(x) + 9*cosh(sqrt(2)*x) - 8*sinh(x) + 6*sqrt(2)*sinh(sqrt(2)*x))/2.
%t A402062 CoefficientList[Series[(1+x)(1+x^2)/((1-x)(1-2x^2)),{x,0,42}],x]
%t A402062 (* Alternative: *)
%t A402062 LinearRecurrence[{1,2,-2},{1,2,5,8},43]
