%U A402251 48001038737385233232,3099344658079871215327,213514104863222041675608,15631944999114791247860191
%N A402251 a(n) = 1 + Sum_{k=1..n} binomial(3*n-1,k) * a(n-k).
%F A402251 G.f. A(x) satisfies A(x) = (1-2*x) * (2*A(z) - 1/(1-z)), where z = x/(1+x)^3.
%o A402251 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(3*i-1, j)*v[i-j+1])); v;
