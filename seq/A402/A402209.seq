%I A402209 #12 Nov 24 2026 12:24:28
%S A402209 6,30,60,180,1320,2310,2340,2730,6090,8970,10710,11550,11970,12540,
%T A402209 29400,33150,34650,43890,60900,61380,65100,77550,84630,84870,140070,
%U A402209 153510,181890,273060,325080,332010,371070,373860,383520,420420,474810,603900,650760,694830,713310,778050,820410,912450
%N A402209 Areas of primitive Pythagorean triangles that are the average of a pair of twin primes.
%H A402209 Robert Israel, <a href="/A402209/b402209.txt">Table of n, a(n) for n = 1..10000</a>
%e A402209 a(3) = 60 is a term because it is the area of the primitive Pythagorean triangle with sides (8, 15, 17) and 60-1 = 59 and 60+1 = 61 are both primes.
%p A402209 N:= 10^6: # for terms <= N
%p A402209 S:= {}:
%p A402209 for v from 1 while (2*v+1)*(v+1)*v <= N do
%p A402209   for u from v+1 by 2 do
%p A402209     a:= (u^2-v^2)*u*v;
%p A402209     if a > N then break fi;
%p A402209     if igcd(u,v)=1 and isprime(a-1) and isprime(a+1) then
%p A402209        S:= S union {a};
%p A402209     fi
%p A402209 od od:
%p A402209 sort(convert(S,list));
%Y A402209 Cf. A401133, A401135. Intersection of A014574 and A024365.
%K A402209 nonn,new
%O A402209 1,1
%A A402209 _Will Gosnell_ and _Robert Israel_, Nov 15 2026
