%I A402058 #9 Nov 15 2026 08:16:32
%S A402058 1,16,81,128,625,1296,2187,2401,4096,10000,10368,14641,28561,32768,
%T A402058 34992,38416,50625,78125,80000,83521,130321,194481,234256,279841,
%U A402058 279936,307328,331776,456976,524288,531441,707281,810000,823543,923521,1048576,1185921,1250000,1336336
%N A402058 Numbers k such that gcd(d_3(k^3), 30) = 1, where d_3 = A007425 is the 3rd Piltz function.
%C A402058 Numbers k such that d_3(k^3) is a 7-rough number (A007775).
%C A402058 Numbers whose prime factorization has only exponents that are congruent to 0 or 3 (mod 4) (A014601) and also congruent to 0, 2, or 4 (mod 5) (A047212).
%H A402058 Amiram Eldar, <a href="/A402058/b402058.txt">Table of n, a(n) for n = 1..10000</a>
%H A402058 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%H A402058 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402058 a(n) = A402057(n)^(1/3).
%F A402058 Sum_{n>=1} 1/a(n) = (zeta(3) * zeta(5) * zeta(20) / (zeta(9) * zeta(10))) * Product_{p prime} (1 - 1/p^3 + 1/p^4 - 1/p^5 + 1/p^8) = 1.08664365471831363262... .
%e A402058 16 is a term since A007425(16^3) = 91, and gcd(91, 30) = 1.
%t A402058 f[p_, e_] := (3*e + 1)*(3*e + 2)/2; d33[n_] := Times @@ f @@@ FactorInteger[n]; d33[1] = 1; q[k_] := CoprimeQ[d33[k], 30]; Select[Range[1350000], q]
%o A402058 (PARI) isok(k) = #select(e -> (e % 4 > 0 && e % 4 < 3) || (e % 5) % 2, factor(k)[, 2]) == 0;
%Y A402058 Subsequence of A001694 and A402056.
%Y A402058 Cf. A007775, A007425, A014601, A047212, A252849 (d_3(k) is even), A252895 (d_3(k) is odd), A354178, A402057.
%K A402058 nonn,easy,new
%O A402058 1,2
%A A402058 _Amiram Eldar_, Nov 12 2026
