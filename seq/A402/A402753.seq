%S A402753 1,10,46,146,408,1036,2290,4640,9042,16572,28888,49420,82052,132310,
%T A402753 209572,323540,489498,729000,1062980,1528940,2172236,3036456,4192928,
%U A402753 5718970,7702994,10272574,13558338,17696734,22908204,29396522,37365760,47159594,59055072
%N A402753 Expansion of g.f. Phi^3*F^5, where Phi = g.f. for A028930 and F = g.f. for A028959.
%C A402753 a(n) is the number of representations of n by the 16-variable quadratic form that is the sum of 3 copies of 2*x^2 + x*y + 3*y^2 and 5 copies of x^2 + x*y + 6*y^2.
%H A402753 Karan Sharma, <a href="/A402753/b402753.txt">Table of n, a(n) for n = 0..1000</a>
%H A402753 Bülent Köklüce, <a href="https://doi.org/10.1007/s11139-013-9480-4">Cusp forms in S_6(Gamma_0(23)), S_8(Gamma_0(23)) and the number of representations of numbers by some quadratic forms in 12 and 16 variables</a>, Ramanujan J. 34 (2014), 187-208. See p. 204.
%o A402753 (PARI) th(M, N) = 1 + 2*x*Ser(qfrep(M, N, 1), x);
%o A402753 a(n) = polcoef(th([4, 1; 1, 6], n+1)^3 * th([2, 1; 1, 12], n+1)^5, n);
%Y A402753 Cf. A028930, A028959, A328527, A328528, A328529, A328530, A328531, A328532, A328533, A328534, A328535, A328536, A401430, A401474, A401519, A402729, A402730.
