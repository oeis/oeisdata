%I A402031 #6 Nov 11 2026 16:44:28
%S A402031 1,2,1,9,0,1,18,12,2,1,96,0,21,0,1,192,159,42,24,2,1,1179,0,363,0,33,
%T A402031 0,1,2358,2268,726,462,66,36,2,1,16056,0,6030,0,774,0,45,0,1,32112,
%U A402031 34146,12060,8352,1548,909,90,48,2,1,234954,0,100026,0,15993,0,1329,0,57,0,1
%N A402031 Triangle read by rows: inverse of Sprugnoli array A402029.
%H A402031 Paul Barry, <a href="https://arxiv.org/abs/2611.05673">Orthogonal polynomials on two or more intervals: the Sprugnoli context</a>, arXiv:2611.05673 [math.CO], 2026. See pp. 6-7.
%e A402031 The triangle begins as:
%e A402031      1;
%e A402031      2,   1;
%e A402031      9,   0,   1;
%e A402031     18,  12,   2,  1;
%e A402031     96,   0,  21,  0,  1;
%e A402031    192, 159,  42, 24,  2, 1;
%e A402031   1179,   0, 363,  0, 33, 0, 1;
%e A402031   ...
%t A402031 nmax=10; g[x_]:=(1-2x+3x^2)/(1+12x^2+15x^4); f1[x_]:=x/(1-2x+3x^2); f2[x_]:=x/(1+12x^2+15x^4); A402029[n_,k_]:=SeriesCoefficient[g[x] * f1[x]^Mod[k,2] * (x*f2[x])^Floor[k/2],{x,0,n}]; A=Inverse[Table[If[k <= n, T[n, k], 0], {n, 0, nmax}, {k, 0, nmax}]]; Table[A[[n + 1, k + 1]], {n, 0, nmax}, {k, 0, n}]//Flatten
%Y A402031 Oblique side gives A000012.
%Y A402031 Row sums give A402032.
%Y A402031 Cf. A402029.
%K A402031 nonn,easy,tabl,new
%O A402031 0,2
%A A402031 _Stefano Spezia_, Nov 11 2026
