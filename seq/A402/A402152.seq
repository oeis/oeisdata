%I A402152 #10 Nov 26 2026 10:32:23
%S A402152 1,3,12,24,48,72,96,144,180,288,360,384,576,720,864,1080,1152,1440,
%T A402152 1536,1620,1728,2160,2304,2880,3240,4200,4320,5184,5760,6144,6300,
%U A402152 6480,6912,8640,9216,9720,10500,10800,11520,12288,12960,13824,15552,16200,17280,18432
%N A402152 Positions of first appearances in A402146. Indices k such that A402146(k) is different from A402146(j) for all j < k, where A402146(n) counts 1-based restricted growth permutations of the multiset of prime indices of n.
%C A402152 A prime index of n is a number m such that prime(m) divides n. The multiset of prime indices of n is row n of A112798, sum A056239.
%C A402152 A 1-based restricted growth sequence of length j is a sequence (a_1, ..., a_j), satisfying a_1 = 1 and a_i <= 1 + max(a_1, ..., a_{i-1}) for all i = 2, 3, ..., j. We also include the empty sequence.
%e A402152 We have a(8) = 180 because A402146(180) = 8 is the first appearance of 8 in A402146.
%e A402152 The 1-based restricted growth permutations of prime indices for n = 1, 3, 12, 24, 48, 72, 96, 144, 180 are:
%e A402152   ()  .  (112)  (1112)  (11112)  (11122)  (111112)  (111122)  (11223)
%e A402152          (121)  (1121)  (11121)  (11212)  (111121)  (111212)  (11232)
%e A402152                 (1211)  (11211)  (11221)  (111211)  (111221)  (12123)
%e A402152                         (12111)  (12112)  (112111)  (112112)  (12132)
%e A402152                                  (12121)  (121111)  (112121)  (12213)
%e A402152                                  (12211)            (112211)  (12231)
%e A402152                                                     (121112)  (12312)
%e A402152                                                     (121121)  (12321)
%e A402152                                                     (121211)
%e A402152                                                     (122111)
%t A402152 prix[n_]:=If[n==1,{},Flatten[Cases[FactorInteger[n],{p_,k_}:>Table[PrimePi[p],{k}]]]];
%t A402152 rgoQ[y_]:=y=={}||y[[1]]==1&&And@@Table[y[[i]]<=1+Max@@Take[y,i-1],{i,2,Length[y]}];
%t A402152 fur[q_]:=Select[Range[Length[q]],FreeQ[Take[q,#-1],q[[#]]]&]
%t A402152 fur[Table[Length[Select[Permutations[prix[n]],rgoQ[#]&]],{n,1000}]]
%Y A402152 Without restricted growth we have A358526.
%Y A402152 These are positions of first appearances in A402146.
%Y A402152 For normal partitions we have firsts in A402150, complement A402149.
%Y A402152 The complement is counted by A402151, firsts in A402147.
%Y A402152 A008480 counts permutations of prime indices.
%Y A402152 A055932 ranks normal partitions, counted by A047967.
%Y A402152 A080259 ranks non-normal partitions, counted by A000065.
%Y A402152 A107429 counts normal compositions, ranks A333217.
%Y A402152 A383253 counts 1-based restricted growth compositions, ranks A402139.
%Y A402152 A402138 counts non-1-based restricted growth compositions, ranks A402141.
%Y A402152 Cf. A001227, A008277, A011782, A383713, A401975, A402140, A402142.
