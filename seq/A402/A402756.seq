%S A402756 1,12,64,212,548,1296,2808,5416,9892,17864,30968,51808,85476,137268,
%T A402756 214776,329280,493104,730728,1069264,1531080,2168456,3031912,4173544,
%U A402756 5694636,7670428,10220084,13509360,17638252,22821968,29313708,37305240,47085956,59005868
%N A402756 Expansion of g.f. Phi^2*F^6, where Phi = g.f. for A028930 and F = g.f. for A028959.
%C A402756 a(n) is the number of representations of n by the 16-variable quadratic form that is the sum of 2 copies of 2*x^2 + x*y + 3*y^2 and 6 copies of x^2 + x*y + 6*y^2.
%H A402756 Karan Sharma, <a href="/A402756/b402756.txt">Table of n, a(n) for n = 0..1000</a>
%H A402756 Bülent Köklüce, <a href="https://doi.org/10.1007/s11139-013-9480-4">Cusp forms in S_6(Gamma_0(23)), S_8(Gamma_0(23)) and the number of representations of numbers by some quadratic forms in 12 and 16 variables</a>, Ramanujan J. 34 (2014), 187-208. See p. 204.
%o A402756 (PARI) th(M, N) = 1 + 2*x*Ser(qfrep(M, N, 1), x);
%o A402756 a(n) = polcoef(th([4, 1; 1, 6], n+1)^2 * th([2, 1; 1, 12], n+1)^6, n);
%Y A402756 Cf. A028930, A028959, A328527, A328528, A328529, A328530, A328531, A328532, A328533, A328534, A328535, A328536, A401430, A401474, A401519, A402729, A402730, A402753.
