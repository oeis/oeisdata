%U A402252 44537704656459250167,3607293421849453398574,312947053921891922857038,28952403212762510796767753,2845382363522595613924950720
%N A402252 a(n) = 1 + Sum_{k=1..n} binomial(4*n-1,k) * a(n-k).
%F A402252 G.f. A(x) satisfies A(x) = (1-3*x) * (2*A(z) - 1/(1-z)), where z = x/(1+x)^4.
%o A402252 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(4*i-1, j)*v[i-j+1])); v;
%Y A402252 Cf. A398736, A402250, A402251.
