%N A402012 Decimal expansion of L'(1,chi_{-3})/L(1,chi_{-3}), where chi_{-3} is the Dirichlet character kronecker(-3,.).
%H A402012 Paolo Xausa, <a href="/A402012/b402012.txt">Table of n, a(n) for n = 0..10000</a>
%F A402012 Equals A402011 - 3*(log Gamma(1/3) - log Gamma(2/3)).
%e A402012 L'(1,chi_{-3})/L(1,chi_{-3}) = 0.36828161597014784263...
%t A402012 First[RealDigits[EulerGamma + Log[8*Pi^(5/2)/Gamma[1/6]^3], 10, 100]] (* _Paolo Xausa_, Nov 11 2026 *)
%o A402012 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402012 f(-3)
%o A402012 (PARI) log(2*Pi) + Euler() - 3*(lngamma(1/3) - lngamma(2/3))
%Y A402012 Cf. A102283 (chi_{-3}). See A402011 for related sequences.
