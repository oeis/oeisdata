%T A402022 2,1,1,3,5,3,1,8,1,6,5,3,4,1,2,4,0,6,0,7,4,0,9,9,1,1,7,2,1,7,2,7,1,4,
%U A402022 2,0,5,6,1,7,4,6,0,2,0,6,4,4,9,2,9,8,6,8
%N A402022 Decimal expansion of L'(1,chi_17)/L(1,chi_17), where chi_17 is the Dirichlet character kronecker(17,.).
%F A402022 Equals A402011 - (1/(2*log(4+sqrt(17)))) * Sum_{a=1..16} Legendre(a,17)*zeta''(0,a/17), where zeta''(s,x) is the second partial derivative of the Hurwitz zeta function with respect to s.
%e A402022 L'(1,chi_17)/L(1,chi_17) = 0.33109143435550611725...
%o A402022 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402022 f(17)
%o A402022 (PARI) f(D) = my([h, loge] = vecextract(quadclassunit(D), [1,4])); log(2*Pi) + Euler() - (1/(2*h*loge)) * sum(a=1, D, kronecker(D,a)*zetahurwitz(0, a/D, 2)); \\ D > 0 is a fundamental discriminant
%o A402022 f(17)
%Y A402022 Cf. A011584 (chi_17). See A402011 for related sequences.
%K A402022 nonn,cons,new
%O A402022 0,1
