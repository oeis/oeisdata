%U A402486 13216,15862,18977,22678,27028,32184,38218,45347,53683,63478,74908,88309
%N A402486 Number of partitions of n such that (greatest part) / (least part) <= number of parts.
%F A402486 G.f.: Sum_{i>=0, j>=1} x^((i+1)*j) * Product_{k=1..i} (1 - x^(i*j+k)) / (1 - x^k).
%e A402486 a(6) = 9 because we have [6], [4,2], [3,3], [3,2,1], [3,1,1,1], [2,2,2], [2,2,1,1], [2,1,1,1,1] and [1,1,1,1,1,1].
%t A402486 nmax = 48; CoefficientList[Series[Sum[x^((i + 1) j) Product[(1 - x^(i j + k))/(1 - x^k), {k, 1, i}], {i, 0, nmax}, {j, 1, Floor[nmax/(i + 1)]}], {x, 0, nmax}], x] // Rest
