%T A402408 22160,5165,16109,16868,154708,57098,31657,52393,401480,176810,101349,
%U A402408 105572,678356,241882,501716,393817,284002,685541,1437353,1751296,3225578,3439258,2479594
%N A402408 First occurrence of difference n between two consecutive terms of A001481. a(n) gives the lower term. The upper term is A402409.
%H A402408 Hugo Pfoertner, <a href="/A402408/b402408.txt">Table of n, a(n) for n = 1..105</a>
%F A402408 a(n) = A402409 - n.
%o A402408 (PARI) is_a001481(n) = {my(f=factor(n)); for(i=1, #f[, 1], if(f[i, 2]%2 && f[i, 1]%4==3, return(0))); 1}; \\ after _Charles R Greathouse IV_
%o A402408 is_a402408(n) = my(p=0); for(k=1, oo, if(is_a001481(k), if(k-p==n, return(p)); p=k))
%Y A402408 Cf. A001481, A355237, A355238, A402409.
%K A402408 nonn,new
%O A402408 1,2
%A A402408 _Hugo Pfoertner_, Nov 23 2026
