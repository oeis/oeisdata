%N A402013 Decimal expansion of L'(1,chi_{-4})/L(1,chi_{-4}), where chi_{-4} is the Dirichlet character kronecker(-4,.).
%H A402013 Paolo Xausa, <a href="/A402013/b402013.txt">Table of n, a(n) for n = 0..10000</a>
%F A402013 Equals A402011 - 2*(log Gamma(1/4) - log Gamma(3/4)).
%e A402013 L'(1,chi_{-4})/L(1,chi_{-4}) = 0.24560958477731417238...
%t A402013 First[RealDigits[Log[2*Pi] + EulerGamma - 2*(LogGamma[1/4] - LogGamma[3/4]), 10, 100]] (* _Paolo Xausa_, Nov 11 2026 *)
%o A402013 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402013 f(-4)
%o A402013 (PARI) log(2*Pi) + Euler() - 2*(lngamma(1/4) - lngamma(3/4))
%Y A402013 Cf. A101455 (chi_{-4}). See A402011 for related sequences.
