%I A402465 #11 Nov 26 2026 21:25:35
%S A402465 1,2,18,446,23715,2387891,416416287,117179155080,50244622311681,
%T A402465 31331508020646895,27348383493179058211,32375701064733227638108,
%U A402465 50625037179984101740737949,102248005642793383366567788865,261681756671569696325279788698775,834706978985782938206377269553999056
%N A402465 Number of weakly connected acyclic digraphs (or DAGs) on n labeled nodes in which every node has in-degree at most 3.
%C A402465 Without the bound on the in-degree the count is A082402. With in-degree at most 1 it is n^(n-1) = A000169(n), the number of rooted labeled trees.
%C A402465 a(n) = A082402(n) for n <= 4; a(5) = 23715 against A082402(5) = 26430.
%H A402465 Tyler Satchel Orden, <a href="/A402465/b402465.txt">Table of n, a(n) for n = 1..60</a>
%F A402465 E.g.f.: log(A(x)), where A(x) is the e.g.f. of A397712.
%F A402465 a(n) = A397712(n) - Sum_{j=1..n-1} binomial(n-1,j-1)*a(j)*A397712(n-j).
%e A402465 a(3) = 18: of the 25 acyclic digraphs on 3 nodes, the one with no arcs and the 6 with a single arc are not connected.
%e A402465 a(5) = 23715: all 2715 acyclic digraphs on 5 nodes that have a node with in-degree 4 are connected, and 26430 - 2715 = 23715.
%o A402465 (Python)
%o A402465 from math import comb
%o A402465 def aList(N, k=3):  # a(1), ..., a(N)
%o A402465     f = lambda m: sum(comb(m, i) for i in range(k+1))
%o A402465     A = [1]  # all acyclic digraphs with in-degree at most k
%o A402465     for n in range(1, N+1):
%o A402465         A.append(sum((-1)**(t+1)*comb(n, t)*f(n-t)**t*A[n-t] for t in range(1, n+1)))
%o A402465     c = [0]
%o A402465     for n in range(1, N+1):
%o A402465         c.append(A[n] - sum(comb(n-1, j-1)*c[j]*A[n-j] for j in range(1, n)))
%o A402465     return c[1:]
%o A402465 print(aList(16))
%Y A402465 Cf. A397712 (not necessarily connected), A082402 (no bound on the in-degree), A000169, A402236 (in-degree at most 2).
%K A402465 nonn,new
%O A402465 1,2
%A A402465 _Tyler Satchel Orden_, Nov 21 2026
