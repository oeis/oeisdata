%I A402247 #10 Nov 16 2026 07:26:54
%S A402247 1,3,4,7,6,12,8,15,13,18,12,28,14,24,24,27,18,39,20,42,32,36,24,60,31,
%T A402247 42,40,56,30,72,32,51,48,54,48,91,38,60,56,90,42,96,44,84,78,72,48,
%U A402247 108,57,93,72,98,54,120,72,120,80,90,60,168,62,96,104,119,84,144
%N A402247 Sum of divisors d of n such that gcid(d, n/d) is squarefree, where gcid is the greatest common infinitary divisor.
%C A402247 First differs from at A365170, A365174 and A402248 at n = 64.
%C A402247 The number of these divisors is A400138(n).
%H A402247 Amiram Eldar, <a href="/A402247/b402247.txt">Table of n, a(n) for n = 1..10000</a>
%F A402247 Multiplicative with a(p^e) = isigma(p^e) if e is odd, and isigma(p^e) + p*isigma(p^(e-2)) if e is even, where isigma(n) = A049417(n).
%F A402247 Sum_{k=1..n} a(k) ~ c * n^2, where c = (1/(2*zeta(4))) * Product_{k>=1} zeta(2^k)/zeta(3*2^k) = 0.81155506955355015021... .
%t A402247 f[p_, e_] := Times @@ (1 + Flatten[p^(2^(-1 + Position[Reverse@IntegerDigits[e, 2], _?(# == 1 &)]))]);
%t A402247 f2[p_, e_] := f[p, e] + If[OddQ[e], 0, p*f[p, e-2]];
%t A402247 a[1] = 1; a[n_] := Times @@ f2 @@@ FactorInteger[n]; Array[a, 66]
%o A402247 (PARI) isigma(p, e) = {my(d = binary(e)); prod(k = 1, #d, if(d[k], 1 + p^(2^(#d - k)), 1));}
%o A402247 a(n) = {my(f = factor(n), d); prod(i = 1, #f~, isigma(f[i, 1], f[i, 2]) + if(!(f[i, 2] % 2), f[i, 1]*isigma(f[i, 1], f[i, 2]-2))); }
%Y A402247 Cf. A005117, A077609, A365170, A365174, A400137, A400138.
%Y A402247 Sum of divisors d of n such that gcid(d, n/d) is: A049417 (1), A400144 (square), A400145 (odd), A400146 (power of 2), this sequence (squarefree), A402248 (exponentially odd), A402249 (powerful).
%K A402247 nonn,mult,easy,new
%O A402247 1,2
%A A402247 _Amiram Eldar_, Nov 16 2026
