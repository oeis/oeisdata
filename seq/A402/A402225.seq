%I A402225 #12 Nov 25 2026 21:07:42
%S A402225 0,1,9,24,88,153,369,544,1056,1425,2425,3096,4824,5929,8673,10368,
%T A402225 14464,16929,22761,26200,34200,38841,49489,55584,69408,77233,94809,
%U A402225 104664,126616,138825,165825,180736,213504,231489,270793,292248,338904,364249,419121,448800,512800,547281
%N A402225 Generalized polyoctahedral numbers: k^2*(3*k^2 - 4*k + 2), k = 0, +-1, +-2, +-3, ...
%C A402225 These numbers extend the polyoctahedral numbers (based on the 24-cell) in A092181 to all integer indices via the formula k^2*(3*k^2 - 4*k + 2), evaluated in the order given by A001057 (k = 0, 1, -1, 2, -2, 3, -3, ...).
%C A402225 Deza and Deza give the original formula on page 193 and discuss this generalization on page 241.
%D A402225 Elena Deza and Michel Marie Deza, Figurate numbers, World Scientific Publishing (2012), pages 193 and 241.
%H A402225 <a href="/index/Rec#order_09">Index entries for linear recurrences with constant coefficients</a>, signature (1,4,-4,-6,6,4,-4,-1,1).
%F A402225 a(0) = 0. a(2k-1) = k^2*(3*k^2 - 4*k + 2), for k >= 1. a(2k) = k^2*(3*k^2 + 4*k + 2), for k >= 1.
%F A402225 a(n) = A001057(n)^2*(3*A001057(n)^2 - 4*A001057(n) + 2).
%F A402225 G.f.: x*(1 + 8*x + 11*x^2 + 32*x^3 + 11*x^4 + 8*x^5 + x^6)/((1-x)^5*(1+x)^4).
%F A402225 a(n) = a(n-1) + 4*a(n-2) - 4*a(n-3) - 6*a(n-4) + 6*a(n-5) + 4*a(n-6) - 4*a(n-7) - a(n-8) + a(n-9).
%e A402225 a(5) = 153, since A001057(5) = 3 and 3^2*(3*3^2 - 4*3 + 2) = 9*17 = 153.
%e A402225 a(6) = 369, since A001057(6) = -3 and (-3)^2*(3*(-3)^2 - 4*(-3) + 2) = 9*41 = 369.
%e A402225 G.f. = x + 9*x^2 + 24*x^3 + 88*x^4 + 153*x^5 + 369*x^6 + 544*x^7 + 1056*x^8 + 1425*x^9 + ...
%t A402225 P[n_] := n^2 (3 n^2 - 4 n + 2)
%t A402225 a[0] := 0
%t A402225 a[n_Integer?Positive] := If[OddQ[n], P[(n + 1)/2], P[-n/2]]
%t A402225 Table[a[n], {n, 0, 41}]
%Y A402225 Cf. A092181, A001057.
%K A402225 nonn,easy,new
%O A402225 0,3
%A A402225 _Edgar Delgado Vega_, Nov 15 2026
