%N A402450 a(n) = 1 + Sum_{k=1..n} binomial(3*n+k,k) * a(n-k).
%F A402450 G.f. A(x) satisfies A(x) = (1-4*x) * (2*A(z) - 1/(1-z)), where z = x*(1-x)^3.
%o A402450 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(3*i+j, j)*v[i-j+1])); v;
%Y A402450 Cf. A402260, A402449.
