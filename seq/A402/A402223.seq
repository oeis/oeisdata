%T A402223 11,1,3,1,5,1,3,1,6,1,7,1,2,1,4,1,3,1,12,1,3,1,4,1,5,1,2,1,13,1,2,1,4,
%U A402223 1,2,1,14,1,2,1,3,1,15,1,3,1,5,1,2,1,7,1
%N A402223 Fill the cells of the square grid in spiral order, starting at the center. a(n) is the smallest positive k such that no earlier cell within k steps (up, down, left, right) of cell n has k.
%C A402223 A perfect plan needs only 15 numbers (see the Subercaseaux and Heule link). This one-cell-at-a-time rule reached 32. Does it ever need 33? Unknown.
%C A402223 In the first billion cells, no cell needed a number bigger than 32.
%H A402223 Connor Harrington, <a href="/A402223/b402223.txt">Table of n, a(n) for n = 1..10000</a>
%H A402223 Bernardo Subercaseaux and Marijn J. H. Heule, <a href="https://arxiv.org/abs/2301.09757">The packing chromatic number of the infinite square grid is 15</a>, arXiv:2301.09757 [cs.DM], 2023-2025.
%o A402223 (Python)
%o A402223 def a_list(N):
%o A402223     col, out = {}, []
%o A402223     x = y = 0; dx, dy = 1, 0; seg, pos, turns = 1, 0, 0
%o A402223     for _ in range(N):
%o A402223         k = 1
%o A402223         while any(col.get((x + i, y + j)) == k for i in range(-k, k + 1) for j in range(abs(i) - k, k - abs(i) + 1)):
%o A402223             k += 1
%o A402223         col[(x, y)] = k; out.append(k)
%o A402223         x += dx; y += dy; pos += 1
%o A402223         if pos == seg:
%o A402223             pos = 0; dx, dy = -dy, dx; turns += 1
%o A402223             if turns == 2: turns = 0; seg += 1
%o A402223     return out
%Y A402223 Cf. A361486, A362580.
%K A402223 nonn,new
%O A402223 1,2
%A A402223 _Connor Harrington_, Nov 15 2026
