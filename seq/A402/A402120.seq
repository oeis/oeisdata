%I A402120 #7 Nov 15 2026 08:04:26
%S A402120 0,6,90,540,2100,6300,15409,34469,70469,131255,231474,384444,590352,
%T A402120 936176,1430887,2100297,2925878,4135670,5739280,7808293,10499709,
%U A402120 13870916,18018303,23312142,29348349,37253060,46799696,57487391,71273499,87530569,106244552,128803083,153475768,183750723,215554864
%N A402120 a(n) is the sum of distinct sums i^3 + j^3 + k^3 for 0<=i<=j<=k<=n.
%H A402120 Robert Israel, <a href="/A402120/b402120.txt">Table of n, a(n) for n = 0..200</a>
%F A402120 a(n) <= sum_{0 <= i <= j <= k <= n} (i^3 + j^3 + k^3) = n^2 * (n+1)^2 * (n+2) * (n+3)/8, with equality for n <= 5.
%e A402120 For n = 1 the sums are 0^3 + 0^3 + 0^3 = 0, 0^3 + 0^3 + 1^3 = 1, 0^3 + 1^3 + 1^3 = 2 and 1^3 + 1^3 + 1^3 = 3 which are all distinct, so a(1) = 0 + 1 + 2 + 3 = 6.
%e A402120 For n = 6 the sums are not all distinct because 216 = 3^3 + 4^3 + 5^3 = 0^3 + 0^3 + 6^3 and 251 = 1^3 + 5^3 + 5^3 = 2^3 + 3^3 + 6^3, so a(6) = 6^2 * (6+1)^2 * (6+2) * (6+3)/8 - 216 - 251 = 15409.
%p A402120 N:= 40: # for a(0) .. a(N)
%p A402120 V:= {}:
%p A402120 s:= 0:
%p A402120 for n from 0 to N do
%p A402120   for j from 0 to n do
%p A402120     for i from 0 to j do
%p A402120       v:= i^3 + j^3 + n^3;
%p A402120       if not member(v,V) then
%p A402120         V:= V union {v};
%p A402120         s:= s + v;
%p A402120       fi
%p A402120   od od;
%p A402120   S[n]:= s
%p A402120 od:
%p A402120 convert(S,list); # _Robert Israel_, Nov 13 2026
%Y A402120 Cf. A374710.
%K A402120 nonn,new
%O A402120 0,2
%A A402120 _Robert Israel_, Nov 13 2026
