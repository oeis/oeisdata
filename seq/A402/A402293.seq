%S A402293 1,2,3,5,8,11,14,17,20,23,26,29,32,35,38,41,44,47,50,53,56,59,62,65,
%T A402293 68,71,74,77,80,83,86,89,92,95,98,101,104,107,110,113,116,119,122,125,
