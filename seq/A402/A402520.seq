%T A402520 44,72,72,44,12,1,1,14,59,110,131,110,59,14,1,1,16,76,156,208,208,156,
%U A402520 76,16,1,1,18,95,210,303,338,303,210,95,18,1,1,20,116,272,416,500,500,416,272,116,20,1
%N A402520 Array read by antidiagonals: T(m,n) is the number of minimal hull sets in the grid graph P_m X P_n.
%C A402520 A hull set is a vertex set whose convex hull is the entire graph.
%C A402520 In the grid graph a hull set has a vertex on each border of the grid. For n > 1 and m > 1, the minimal hull sets have size between 2 and 4. Otherwise, the graph is a path and there is just one minimal hull set containing the end points of the path.
%H A402520 Andrew Howroyd, <a href="/A402520/b402520.txt">Table of n, a(n) for n = 1..1275</a> (first 50 antidiagonals)
%H A402520 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/GridGraph.html">Grid Graph</a>.
%F A402520 T(m,n) = T(n,m).
%F A402520 T(1,n) = T(n,1) = 1.
%F A402520 T(m,n) = 2 + 2*(m+n-4) + 4*(m-2)*(n-2) + (m-2)^2*(n-2)^2 for m > 1, n > 1.
%e A402520 Array begins:
%e A402520 =======================================
%e A402520 m\n | 1  2  3   4   5   6    7    8 ...
%e A402520 ----+----------------------------------
%e A402520   1 | 1  1  1   1   1   1    1    1 ...
%e A402520   2 | 1  2  4   6   8  10   12   14 ...
%e A402520   3 | 1  4 11  20  31  44   59   76 ...
%e A402520   4 | 1  6 20  42  72 110  156  210 ...
%e A402520   5 | 1  8 31  72 131 208  303  416 ...
%e A402520   6 | 1 10 44 110 208 338  500  694 ...
%e A402520   7 | 1 12 59 156 303 500  747 1044 ...
%e A402520   8 | 1 14 76 210 416 694 1044 1466 ...
%e A402520   ...
%e A402520 The 3 X 4 grid has 20 minimal hull sets as illustrated below:
%e A402520     x . . .   x . . .   x . . x   x . . .   . x . .
%e A402520     . . . .   . . . x   . . . .   . . . x   x . . x
%e A402520     . . . x   x . . .   . x . .   . x . .   . . x .
%e A402520       (2)       (2)       (4)       (8)       (4)
%t A402520 A402520[m_, n_] := If[m == 1 || n == 1, 1, 2 + 2*(m + n - 4) + 4*(m - 2)*(n - 2) + (m - 2)^2*(n - 2)^2];
%t A402520 Table[A402520[m - n + 1, n], {m, 15}, {n, m}] (* _Paolo Xausa_, Nov 20 2026 *)
%o A402520 (PARI) T(m,n) = if(m==1||n==1, 1, 2 + 2*(m+n-4) + 4*(m-2)*(n-2) + (m-2)^2*(n-2)^2)
%Y A402520 Main diagonal is A402521.
