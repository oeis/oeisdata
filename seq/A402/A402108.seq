%I A402108 #6 Nov 18 2026 20:26:22
%S A402108 1,60,120,180,240,504,420,360,960,1008,840,720,1080,1260,1800,1440,
%T A402108 1680,3240,2160,2880,10500,3600,3360,2520,4320,6480,6300,9360,6720,
%U A402108 7920,8640,8400,11880,5040,13440,14400,7560,13860,19800,15840,17640,16800,12600,10080,18480
%N A402108 a(n) is the least positive integer k for which exactly n composite divisors d of k have the same sum of prime factors as a smaller composite divisor of k (with multiplicity).
%C A402108 Let c(k) count repeated values of A001414(d) over the composite divisors d of k, with each equal-sum class of size t contributing t - 1. Equivalently, c(k) = A055212(k) - #{A001414(d): d|k, d composite}, and a(n) = min{k >= 1: c(k) = n}.
%C A402108 Only composite divisors count: A001414(5) = A001414(6) = 5 for k = 30 is excluded because 5 is prime; the first collision occurs at k = 60. Although d|k implies c(d) <= c(k), the sequence a(n) is not monotonic: a(20) = 10500 > a(21) = 3600.
%C A402108 For distinct primes p and q and integers r, s >= 0, c(p^r*q^s) = max(0, r - q + 1)*max(0, s - p + 1). In particular, c(2^(n + 2)*3^2) = n for n >= 0, so every term a(n) exists and a(n) <= 9*2^(n + 2).
%C A402108 For k with c(k) = 1 and no proper divisor with a collision, k belongs to A402109. For primitive k, c(k) is either 1 or 2.
%H A402108 Felix Huber, <a href="/A402108/b402108.txt">Table of n, a(n) for n = 0..1000</a>
%H A402108 Felix Huber, <a href="https://doi.org/10.5281/zenodo.24196197">Prime-Factor Sum Collisions among Composite Divisors: Primitive Cases and Additive Generalizations</a>, Zenodo (2026).
%F A402108 a(n) <= 9*2^(n + 2) for n >= 0.
%e A402108 a(0) = 1 because 1 has no composite divisors, hence c(1) = 0.
%e A402108 a(1) = 60: the composite divisors 10 and 12 have equal sums of prime factors, 2 + 5 = 2 + 2 + 3 = 7.
%e A402108 a(2) = 120: besides {10, 12} with sum 7, the composite divisors 20 and 24 have equal sum 9.
%e A402108 For p = 2, q = 3, r = n + 2 and s = 2, the formula gives c(2^(n + 2)*3^2) = n.
%p A402108 c := proc(k)
%p A402108     local l, d, q, j, x, y;
%p A402108     l := [[0, 0]];
%p A402108     for q in ifactors(k)[2] do
%p A402108         l := [seq(seq([x[1] + j*q[1], x[2] + j], j = 0 .. q[2]), x in l)];
%p A402108     end do;
%p A402108     d := select(y -> y[2] > 1, l);
%p A402108     nops(d) - nops({seq(x[1], x in d)});
%p A402108 end proc:
%p A402108 A402108List := proc(n)
%p A402108     local v, k, i, j;
%p A402108     v := Array(0 .. n, fill = 0);
%p A402108     i := 0;
%p A402108     k := 1;
%p A402108     while i <= n do
%p A402108         j := c(k);
%p A402108         if j <= n and v[j] = 0 then
%p A402108             v[j] := k;
%p A402108             i := i + 1;
%p A402108         end if;
%p A402108         k := k + 1;
%p A402108     end do;
%p A402108     [seq(v[j], j = 0 .. n)];
%p A402108 end proc:
%p A402108 A402108List(44);
%Y A402108 Cf. A001414, A055212, A305611, A305613, A402109.
%K A402108 nonn,new
%O A402108 0,2
%A A402108 _Felix Huber_, Nov 13 2026
