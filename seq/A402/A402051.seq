%I A402051 #8 Nov 15 2026 08:05:21
%S A402051 8,16,24,27,32,40,48,54,56,64,72,80,81,88,96,104,108,112,120,125,135,
%T A402051 136,144,152,160,162,168,176,184,189,192,200,208,216,224,232,240,243,
%U A402051 248,250,256,264,270,272,280,288,296,297,304,312,320,324,328,336,343,344
%N A402051 Numbers k such that d_3(k) is not a 3-smooth number, where d_3 = A007425 is the 3rd Piltz function.
%C A402051 First differs from A046099 and A375145 at n = 21: A046099(21) = A375145(21) = 128 = 2^7 is not a term in this sequence.
%C A402051 Numbers whose prime factorization includes at least one exponent that is not equal to 1, 2, or 7.
%C A402051 The asymptotic density of this sequence is 1 - Product_{p prime} (1 - 1/p^3 + 1/p^7 - 1/p^8) = 0.16410467890758987421... .
%H A402051 Amiram Eldar, <a href="/A402051/b402051.txt">Table of n, a(n) for n = 1..10000</a>
%H A402051 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%e A402051 8 is a term since A007425(8) = 10 is not a 3-smooth number.
%t A402051 f[p_, e_] := (e+1)*(e+2)/2; d3[n_] := Times @@ f @@@ FactorInteger[n]; d3[1] = 1; smQ[n_] := n == Times @@ ({2, 3}^IntegerExponent[n, {2, 3}]); q[k_] := !smQ[d3[k]]; Select[Range[350], q]
%t A402051 (* Alternative: *)
%t A402051 q[k_] := !AllTrue[FactorInteger[k][[;; , 2]], MemberQ[{1, 2, 7}, #] &]; Select[Range[350], q]
%o A402051 (PARI) isok(k) = {my(e = factor(k)[, 2]); for(i = 1, #e, if(e[i] > 2 && e[i] != 7, return(1))); 0;}
%Y A402051 Subsequence of A046099.
%Y A402051 Cf. A003586, A007425, A354181.
%K A402051 nonn,easy,new
%O A402051 1,1
%A A402051 _Amiram Eldar_, Nov 12 2026
