%T A402014 4,6,7,5,3,8,6,3,9,5,2,6,7,4,9,6,8,9,5,4,6,4,5,3,1,5,2,8,3,1,2,9,7,5,
%U A402014 3,1,6,1,5,6,6,1,1,6,8,5,5,6,5,1,0,0,4,7
%N A402014 Decimal expansion of L'(1,chi_5)/L(1,chi_5), where chi_5 is the Dirichlet character kronecker(5,.).
%F A402014 Equals A402011 - (1/(2*log((1+sqrt(5))/2))) * (zeta''(0,1/5) - zeta''(0,2/5) - zeta''(0,3/5) + zeta''(0,4/5)), where zeta''(s,x) is the second partial derivative of the Hurwitz zeta function with respect to s.
%e A402014 L'(1,chi_5)/L(1,chi_5) = 0.82767947671550488799...
%o A402014 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402014 f(5)
%o A402014 (PARI) f(D) = my([h, loge] = vecextract(quadclassunit(D), [1,4])); log(2*Pi) + Euler() - (1/(2*h*loge)) * sum(a=1, D, kronecker(D,a)*zetahurwitz(0, a/D, 2)); \\ D > 0 is a fundamental discriminant
%o A402014 f(5)
%Y A402014 Cf. A080891 (chi_5). See A402011 for related sequences.
%K A402014 nonn,cons,new
%O A402014 0,1
%A A402014 _Jianing Song_, Nov 11 2026
