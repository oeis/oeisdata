%I A402429 #8 Nov 20 2026 09:47:13
%S A402429 2,3,5,7,11,13,17,37,109,131,157,197,373,439,2017,2161,2399,2927,
%T A402429 13751,24841,32957
%N A402429 Primes p such that 4*p# - p' is prime, where p' is the next prime > p.
%C A402429 Primes prime(m) such that A402423(m) = prime(m+1).
%C A402429 Furthur terms are greater than 40000.
%e A402429 8 - 3 = 5 is prime => 2 is a term;
%e A402429 8*3 - 5 = 19 is prime => 3 is a term;
%e A402429 8*3*5 - 7 = 113 is prime => 5 is a term;
%e A402429 8*3*5*7 - 11 = 829 is prime => 7 is a term;
%e A402429 8*3*5*7*11 - 13 = 9227 is prime => 11 is a term;
%e A402429 8*3*5*7*11*13 - 17 = 120103 is prime => 13 is a term;
%e A402429 8*3*5*7*11*13*17 - 19 = 2042021 is prime => 17 is a term;
%e A402429 8*3*5*7*11*13*17*19 - 23 = 38798737 = 3541*10957 => 19 is not a term.
%o A402429 (PARI) my(P=4, p=2, pnext); while(p<1000, P*=p; pnext=nextprime(p+1); if(ispseudoprime(P-pnext), print1(p, ", ")); p=pnext)
%Y A402429 Cf. A002110 (primorials), A102476 (4 times primorials), A402423, A402428.
%K A402429 nonn,more,new
%O A402429 1,1
%A A402429 _Jianing Song_, Nov 18 2026
