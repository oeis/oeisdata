%I A402280 #5 Nov 17 2026 17:05:33
%S A402280 1,1,4,1,27,7,256,67,6,3125,821,110,46656,12281,1970,90,823543,217015,
%T A402280 38612,3150,16777216,4424071,842254,91140,2520,387420489,102207817,
%U A402280 20410266,2619708,143640,10000000000,2639010709,546067242,78638910,6123600,113400
%N A402280 Irregular triangle read by rows: T(n,k) = k!*Sum_{j=0..k}(-1)^j*binomial(n,j)*A354794(n-j+1, k-j+1), for 0 <= k <= floor(n/2).
%C A402280 For every prime p, T(p, 1) == 1 (mod p), and T(p, k) == 0 (mod p) for k = 0 or 2 <= k <= floor(p/2).
%F A402280 T(2*n, n) = A000680(n).
%F A402280 T(n, 1) = A060226(n) - A065440(n), for n >= 2.
%F A402280 E.g.f. of column k: (1-x-exp(LambertW(-x)))^k / (1+LambertW(-x)).
%F A402280 Limit_{n->oo} T(n, k)/n^n = (1-2/e)^k, for each fixed k >= 0.
%F A402280 T(n,k) = -Sum_{j=2*k-2..n-2} A215534(n, j)*T(j,k-1), for 1 <= k <= floor(n/2), with T(n,0) = n^n
%e A402280 Triangle T(n, k) begins:
%e A402280 n\k :          0          1         2         3         4
%e A402280 ==========================================================
%e A402280 0   :          1
%e A402280 1   :          1
%e A402280 2   :          4          1
%e A402280 3   :         27          7
%e A402280 4   :        256         67         6
%e A402280 5   :       3125        821       110
%e A402280 6   :      46656      12281      1970        90
%e A402280 7   :     823543     217015     38612      3150
%e A402280 8   :   16777216    4424071    842254     91140      2520
%e A402280 9   :  387420489  102207817  20410266   2619708    143640
%e A402280 ...
%p A402280 egf := k -> (1-x-exp(LambertW(-x)))^k/(1+LambertW(-x)):
%p A402280 T := (n,k) -> n!*coeff(series(egf(k), x=0, n+1), x, n):
%p A402280 seq(print(seq(T(n,k), k=0..iquo(n,2))), n=0..10);
%o A402280 (Python)
%o A402280 from math import comb
%o A402280 T = lambda n,k: n**n if k==0 else sum(comb(n,j)*(n-j-1)**(n-j-1)*T(j,k-1) for j in range(2*k-2,n-1))
%o A402280 for n in range(11): print([T(n,k) for k in range(n//2+1)])
%Y A402280 Column k=0 gives A000312.
%Y A402280 Row sums give A133297(n+1).
%Y A402280 Cf. A000680, A060226, A065440, A215534, A354794.
%K A402280 nonn,tabf,new
%O A402280 0,3
