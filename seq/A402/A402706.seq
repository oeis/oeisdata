%S A402706 0,0,2,3,9,9,20,21,32,37,54,42,77,81,96,93,135,132,170,132,199,217,
%T A402706 252,204,294,309,320,270,405,393,464,381,513,541,582,420,665,681,724,
%U A402706 582,819,807,902,690,876,1009,1080,852,1168,1182,1254,972,1377,1284,1468,1152,1573,1621,1710,1278
%N A402706 Sum of the numbers k < n not dividing n such that gcd(k,n) is squarefree.
%H A402706 Michael De Vlieger, <a href="/A402706/b402706.txt">Table of n, a(n) for n = 1..10000</a>
%F A402706 a(n) = Sum_{d|n} (phi(d)*(n+mu(n)^2)/2-n/d) * mu(n/d)^2.
%F A402706 a(n) = Sum_{k=1..n} k * mu(gcd(n,k))^2 * (ceiling(n/k) - floor(n/k)).
%F A402706 a(n) = A390806(n) - A048250(n).
%e A402706 a(12) = 42 since the sum of the nondivisors of 12 that give squarefree gcd with 12 is 5+7+9+10+11 = 42.
%t A402706 Table[Sum[(EulerPhi[d](n + MoebiusMu[n]^2)/2 - n/d) MoebiusMu[n/d]^2, {d, Divisors[n]}], {n, 100}]
%Y A402706 Cf. A000010 (phi), A008683 (mu), A048250, A390806, A402704.
%K A402706 nonn,easy,new
%O A402706 1,3
%A A402706 _Wesley Ivan Hurt_, Nov 25 2026
