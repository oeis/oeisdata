%I A402466 #12 Nov 26 2026 21:28:57
%S A402466 1,2,12,216,9020,736680,105380940,24380396320,8586395254080,
%T A402466 4389644286468000,3135420731131827600,3032461233732880857600,
%U A402466 3868791227370825052096800,6368490035284998104469585600,13272801993006886792836213840000,34454573429090317386125627024640000
%N A402466 Number of acyclic digraphs (or DAGs) on n labeled nodes in which every node has in-degree at most 3 and there is exactly one source and exactly one sink.
%C A402466 A source is a node with in-degree 0 and a sink is a node with out-degree 0; for n = 1 the single node is both.
%C A402466 These are the project networks (activity-on-node) with one start activity and one finish activity in which every activity has at most 3 immediate predecessors.
%C A402466 Without the bound on the in-degree the count is A165950. With in-degree at most 1 it is n! (the directed Hamiltonian paths).
%C A402466 For n >= 2, a(n) is divisible by n*(n-1), since the number of these digraphs with a given source and a given sink is the same for every ordered pair of nodes.
%C A402466 a(n) = A165950(n) for n <= 4; a(5) = 9020 against A165950(5) = 10600.
%H A402466 Tyler Satchel Orden, <a href="/A402466/b402466.txt">Table of n, a(n) for n = 1..60</a>
%H A402466 Ira M. Gessel, <a href="https://doi.org/10.1016/0012-365X(95)00119-H">Counting acyclic digraphs by sources and sinks</a>, Discrete Math., 160 (1996), 253-258.
%F A402466 Let G(n,s) be the number of acyclic digraphs on n labeled nodes with in-degree at most 3 and exactly s sources, and let M(n,t,s) = binomial(n,t) * Sum_{j=0..min(t,s)} binomial(t,j) * e(n-t)^(t-j) * G(n-t,s-j), where e(m) = (m^3+5*m)/6 is the number of nonempty sets of at most 3 parents among m nodes (and 0^0 = 1). Then G(0,0) = 1, G(n,s) = Sum_{t=1..n} (-1)^(t+1)*M(n,t,s) for n >= 1, and a(n) = Sum_{t=1..n} (-1)^(t+1)*t*M(n,t,1).
%F A402466 (M(n,t,s) is the sum, over the sets X of t nodes, of the number of these digraphs with s sources in which every node of X is a sink; j is the number of nodes of X that are isolated.)
%e A402466 a(3) = 12: the 6 directed paths a -> b -> c and the same 6 paths with the extra arc a -> c.
%e A402466 a(5) = 9020: of the 10600 acyclic digraphs on 5 nodes with one source and one sink, 1580 have a node with in-degree 4.
%o A402466 (Python)
%o A402466 from math import comb
%o A402466 def aList(N, k=3):  # a(1), ..., a(N)
%o A402466     e = lambda m: sum(comb(m, i) for i in range(1, k+1))
%o A402466     G = [[1]]  # G[n][s]: n nodes, s sources
%o A402466     def M(n, t, s):
%o A402466         m = n-t
%o A402466         return comb(n, t)*sum(comb(t, j)*e(m)**(t-j)*G[m][s-j] for j in range(min(t, s)+1) if s-j <= m)
%o A402466     a = []
%o A402466     for n in range(1, N+1):
%o A402466         G.append([sum((-1)**(t+1)*M(n, t, s) for t in range(1, n+1)) for s in range(n+1)])
%o A402466         a.append(sum((-1)**(t+1)*t*M(n, t, 1) for t in range(1, n+1)))
%o A402466     return a
%o A402466 print(aList(16))
%Y A402466 Cf. A165950 (no bound on the in-degree), A402237 (in-degree at most 2), A000142.
%Y A402466 Cf. A397712 (all acyclic digraphs with in-degree at most 3).
%K A402466 nonn,new
%O A402466 1,2
%A A402466 _Tyler Satchel Orden_, Nov 21 2026
