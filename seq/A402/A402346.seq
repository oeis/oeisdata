%I A402346 #13 Nov 26 2026 20:42:23
%S A402346 1,4,2,1,12,6,3,22,11,40,20,10,5,48,24,12,6,3,70,35,108,54,27,116,58,
%T A402346 29,132,66,33,146,73,204,102,51,200,100,50,25,192,96,48,24,12,6,3,202,
%U A402346 101,324,162,81,314,157,398,199,456,228,114,57,334,167,450,225
%N A402346 a(1) = 1; for n > 1: if a(n-1) is even, a(n) = a(n-1)/2 else a(n) = a(n-1) + prime(n).
%C A402346 Every odd term is immediately followed by an even term as adding the A000040(n) to an odd value always yields an even result.
%H A402346 Vincenzo Manto, <a href="/A402346/b402346.txt">Table of n, a(n) for n = 1..10000</a>
%H A402346 Vincenzo Manto, <a href="/A402346/a402346.png">a(n) vs n and phase of a(n) graphs</a>
%e A402346 For n = 2: a(1) is odd (1), so a(2) = 1 + A000040(1) = 4.
%e A402346 For n = 3: a(2) is even (4), so a(3) = 4 / 2 = 2.
%e A402346 For n = 4: a(3) is even (2), so a(4) = 2 / 2 = 1.
%e A402346 For n = 5: a(4) is odd (1), so a(5) = 1 + A000040(5) = 12.
%t A402346 s={1};Do[If[EvenQ[s[[-1]]],AppendTo[s,s[[-1]]/2],AppendTo[s,s[[-1]]+Prime[n]]],{n,2,62}];s
%o A402346 (Python)
%o A402346 from sympy import prime
%o A402346 def generate_sequence(size, a1=1):
%o A402346   a = [0] * (size + 1)
%o A402346   a[1] = a1
%o A402346   for n in range(2, size + 1):
%o A402346     prev = a[n - 1]
%o A402346     if prev % 2 != 0:
%o A402346       a[n] = prev + prime(n)
%o A402346     else:
%o A402346       a[n] = int(prev / 2)
%o A402346   return a[1:]
%o A402346 print(generate_sequence(62))
%Y A402346 Cf. A000040, A350877, A400485.
%K A402346 nonn,less,new
