%I A402704 #12 Nov 27 2026 17:07:10
%S A402704 0,0,1,1,3,2,5,4,6,6,9,5,11,10,11,10,15,12,17,11,17,18,21,14,22,22,22,
%T A402704 17,27,22,29,22,29,30,31,20,35,34,35,26,39,34,41,29,36,42,45,32,46,44,
%U A402704 47,35,51,44,51,38,53,54,57,37,59,58,52,46,61,58,65,47,65,62,69,44,71,70
%N A402704 Number of numbers k < n not dividing n such that gcd(k,n) is squarefree.
%H A402704 Michael De Vlieger, <a href="/A402704/b402704.txt">Table of n, a(n) for n = 1..10000</a>
%F A402704 a(n) = Sum_{d|n} (phi(d) - 1) * mu(n/d)^2.
%F A402704 a(n) = Sum_{k=1..n} mu(gcd(n,k))^2 * (ceiling(n/k)-floor(n/k)).
%F A402704 a(n) = A063659(n) - A034444(n).
%e A402704 a(12) = 5 since the nondivisors of 12 are {5,7,8,9,10,11} and all but 1 have a squarefree gcd with 12 except 8 since gcd(8,12) = 4 (not squarefree).
%t A402704 Table[Sum[(EulerPhi[d] - 1) MoebiusMu[n/d]^2, {d, Divisors[n]}], {n, 100}]
%o A402704 (PARI) a(n) = {my(f = factor(n)); prod(i = 1, #f~, if(f[i, 2] == 1, f[i, 1], f[i, 1]^(f[i, 2]-2) * (f[i, 1]^2 - 1))) - 2^#f~;} \\ _Amiram Eldar_, Nov 27 2026
%Y A402704 Cf. A000010 (phi), A008683 (mu), A034444, A063659, A402706.
%K A402704 nonn,easy,new
%O A402704 1,5
%A A402704 _Wesley Ivan Hurt_, Nov 25 2026
