%S A402428 2,3,5,17,59,89,101,193,347,419,421,443,647,691,2503,3907,7309,9377,
%T A402428 9421,10949,13807,22157,22397,55217,66071,94583
%N A402428 Primes p such that 4*p# + p' is prime, where p' is the next prime > p.
%C A402428 Primes prime(m) such that A402422(m) = prime(m+1).
%C A402428 a(27) > 10^5. - _Michael S. Branicky_, Nov 21 2026
%e A402428 8 + 3 = 11 is prime => 2 is a term;
%e A402428 8*3 + 5 = 29 is prime => 3 is a term;
%e A402428 8*3*5 + 7 = 127 is prime => 5 is a term;
%e A402428 8*3*5*7 + 11 = 851 = 23*37 => 7 is not a term;
%e A402428 8*3*5*7*11 + 13 = 9253 = 19*487 => 11 is not a term;
%e A402428 8*3*5*7*11*13 + 17 = 120137 = 19*6323 => 13 is not a term;
%e A402428 8*3*5*7*11*13*17 + 19 = 2042059 is prime => 17 is a term;
%e A402428 8*3*5*7*11*13*17*19 + 23 = 38798783 = 229*169427 => 19 is not a term.
%o A402428 (PARI) my(P=4, p=2, pnext); while(p<1000, P*=p; pnext=nextprime(p+1); if(ispseudoprime(P+pnext), print1(p, ", ")); p=pnext)
%Y A402428 Cf. A002110 (primorials), A102476 (4 times primorials), A402422, A402429.
