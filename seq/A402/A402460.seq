%S A402460 1,2,3,4,5,6,7,8,9,12,13,14,15,16,17,18,19,23,24,25,26,27,28,29,34,35,
%T A402460 36,37,38,39,45,46,47,48,49,56,57,58,59,67,68,69,78,79,89,102,103,104,
%U A402460 105,106,107,108,109,113,114,115,116,117,118,119,124,125,126,127,128,129,135,136,137,138,139,146
%N A402460 Numbers whose last decimal digit is strictly greater than the sum of all other digits.
%C A402460 For any k-digit term with k >= 2, the sum of the first k-1 digits is at most 8, since the last digit is at most 9.
%C A402460 The sum of the reciprocals of all terms converges to approximately 4.8218.
%C A402460 Sequence and programs done in collaboration with Neil John Tomcy.
%C A402460 Infinite since it contains, for example, 10^k + 2 for all k >= 0. - _Michael S. Branicky_, Nov 19 2026
%F A402460 Number of k-digit terms for k >= 2 is binomial(k+7, k).
%e A402460 a(10) = 12 because 2 > 1.
%e A402460 a(46) = 102 because 2 > 1+0.
%e A402460 a(54) = 113 because 3 > 1+1.
%p A402460 isok := proc(n) local L; L := convert(n, base, 10); evalb(L[1] > add(L[i], i = 2..nops(L))); end proc:
%p A402460 select(isok, [$1..200]);
%t A402460 Select[Range[200], Last[IntegerDigits[#]] > Total[Most[IntegerDigits[#]]] &]
%o A402460 (Python)
%o A402460 def is_ok(n):
%o A402460     s = [int(d) for d in str(n)]
%o A402460     return s[-1] > sum(s[:-1])
%o A402460 print([n for n in range(1, 200) if is_ok(n)])
%o A402460 (PARI)
%o A402460 isok(n) = my(d=digits(n)); d[#d] > sum(i=1, #d-1, d[i]);
%K A402460 nonn,base,easy,less,new
%O A402460 1,2
%A A402460 _Abhiram Binu_, Nov 19 2026
