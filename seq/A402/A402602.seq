%I A402602 #8 Nov 26 2026 11:11:39
%S A402602 1,2,2,3,2,4,2,5,6,7,2,8,2,9,10,11,2,12,2,13,14,15,2,16,17,18,19,20,2,
%T A402602 21,2,22,23,24,25,26,2,27,28,29,2,30,2,31,32,33,2,34,35,36,37,38,2,39,
%U A402602 28,40,41,42,2,43,2,44,45,46,47,48,2,49,50,51,2,52,2,53,54,55,47,56,2,57,58,59,2,60,41,61,62,63,2,64,37,65,66,67,68,69,2,70,71,72,2,73,2,57,74
%N A402602 Lexicographically earliest infinite sequence such that a(i) = a(j) => A001065(i) = A001065(j) and A306927(i) = A306927(j), for all i, j >= 1, where A001065(n) is sigma(n)-n and A306927(n) is psi(n)-n, with psi = A001615.
%C A402602 Restricted growth sequence transform of the ordered pair [A001065(n), A306927(n)].
%C A402602 For all i, j >= 1:
%C A402602   A305800(i) = A305800(j) => A402601(i) = A402601(j) => a(i) = a(j),
%C A402602   a(i) = a(j) => A244963(i) = A244963(j),
%C A402602   a(i) = a(j) => A344753(i) = A344753(j).
%H A402602 Antti Karttunen, <a href="/A402602/b402602.txt">Table of n, a(n) for n = 1..65537</a>
%o A402602 (PARI)
%o A402602 up_to = 65537;
%o A402602 rgs_transform(invec) = { my(om = Map(), outvec = vector(length(invec)), u=1); for(i=1, length(invec), if(mapisdefined(om,invec[i]), my(pp = mapget(om, invec[i])); outvec[i] = outvec[pp] , mapput(om,invec[i],i); outvec[i] = u; u++ )); outvec; };
%o A402602 A001065(n) = (sigma(n)-n);
%o A402602 A306927(n) = n*(sumdivmult(n, d, issquarefree(d)/d) - 1);
%o A402602 Aux402602(n) = [A001065(n), A306927(n)];
%o A402602 v402602 = rgs_transform(vector(up_to,n,Aux402602(n)));
%o A402602 A402602(n) = v402602[n];
%Y A402602 Cf. A000203, A001065, A001615, A306927.
%Y A402602 Cf. A305800, A244963, A344753.
%Y A402602 Differs from A300235, A300249, A305895, A351260, A327931, A353560, A373379, A402600, A402601 first at n=104, where a(104) = 57, and from A401722 first at n=125, where a(125) = 90.
%K A402602 nonn,easy,new
%O A402602 1,2
%A A402602 _Antti Karttunen_, Nov 26 2026
