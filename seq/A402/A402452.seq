%I A402452 #10 Nov 18 2026 22:32:02
%S A402452 8,12,15,16,20,24,28,30,32,33,36,42,44,45,48,51,52,60,64,66,69,70,72,
%T A402452 75,76,78,84,90,91,92,93,96,99,100,108,110,111,114,115,116,119,120,
%U A402452 123,124,126,128,129,130,133,135,138,140,144,145,150,153,154,156,159,161
%N A402452 Numbers k in A033949 such that the minimal element of every coset of (Z/kZ)*^2 in (Z/kZ)* is 1 or prime, where (Z/kZ)* is the multiplicative group of integers modulo k and (Z/kZ)*^2 is the subgroup of squares.
%C A402452 In other words, numbers k in A033949 such that: For every m coprime to k, either m is a square modulo k, either there exists a prime p <= m not dividing k such that m/p is a square modulo k.
%C A402452 Numbers in A033948 are excluded since they trivially satisfy this condition (the least quadratic residue modulo an odd prime is always prime).
%C A402452 If k = p^e*s for p odd prime, e >= 2, and gcd(p,s) = 1, since squares modulo n and squares modulo p*s are the same, k is a term if and only if p*s is. Similarly, if k = 2^e*s for e >= 4 and odd s, k is a term if and only if 8*s is.
%C A402452 The k-th row of A402418 lists the minimal elements of cosets of (Z/kZ)*^2 in (Z/kZ)*.
%H A402452 Jianing Song, <a href="/A402452/b402452.txt">Table of n, a(n) for n = 1..10000</a>
%e A402452 15 is a term: The nonsquare composite numbers m < 15 coprime to 15 are 8 and 14; 8/2 and 14/11 are squares modulo 15.
%e A402452 28 is a term: The nonsquare composite numbers m < 28 coprime to 28 are 15 and 27; 15/11 and 27/3 are squares modulo 28.
%e A402452 51 is a term: For every m coprime to 51, one (and exactly one) of m, m/2, m/5, and m/7 is a square modulo 51.
%e A402452 52 is a term: For every m coprime to 51, one (and exactly one) of m, m/3, m/5, and m/7 is a square modulo 51.
%e A402452 120 is a term: The nonsquare composite numbers m < 120 coprime to 120 are 77, 91, and 119; 77/53, 91/19, and 119/71 are squares modulo 120.
%o A402452 (PARI) isA402452(n, A033949_only=1) = {
%o A402452 my(m = 2^#znstar(n)[2], list_rep = [], num_rep = 0, new_rep); \\ m is the number of square roots of 1
%o A402452 if(A033949_only && m <= 2, return(0)); \\ n in A033949 if and only if m > 2
%o A402452 for(d=0, n-1,
%o A402452     if(gcd(d, n)==1,
%o A402452         new_rep = 1;
%o A402452         for(j=1, num_rep, if(issquare(Mod(d, n)/Mod(list_rep[j], n))==1, new_rep = 0; break())); \\ d has a smaller representative
%o A402452         if(new_rep, if(d>1 && !isprime(d), return(0)); list_rep = concat(list_rep, d); num_rep++); \\ d has no smaller representatives, check is d is prime
%o A402452     );
%o A402452     if(num_rep == m, return(1)); \\ list_rep consists of only 1 and primes as representatives
%o A402452 );
%o A402452 }
%Y A402452 Cf. A033949, A402418, A402453.
%K A402452 nonn,new
%O A402452 1,1
%A A402452 _Jianing Song_, Nov 18 2026
