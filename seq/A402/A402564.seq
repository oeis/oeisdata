%T A402564 27,50,55,192,13,0,1,9,35,77,240,91,49,0,4,1,10,44,160,182,196,125,64,
%U A402564 17,0,1,11,60,156,294,375,336,204,0,19,4,1,12,65,210,450,672,714,0,285,100,0,0
%N A402564 Triangle read by rows: for n>0 and 0<=k<=n, T(n,k) is the number of circular (n+k)-bit strings with k 1's that, when circularly shifted by 6 bits, do not have any coincident 1's when placed over the original bit string.
%C A402564 T(n,k) is the number of tilings of a circular (n+k)-board using k curved (1,5)-fences and n-k curved unit square tiles. A (1,g)-fence is composed of two unit square tiles separated by a gap of width g.
%C A402564 This is the m=6 member in the sequence of triangles A029635, A401743, A401744, A401745, A401746, A402564 which give the number of tilings of a circular (n+k) X 1 board using k curved (1,m-1)-fences and n-k curved unit square tiles.
%C A402564 This is also the m=6, t=2 member of a two-parameter family of triangles such that T(n,k) is the number of tilings of an (n+(t-1)*k) X 1 circular board using k curved (1,m-1;t)-combs and n-k curved unit square tiles. A (1,g;t)-comb is composed of a line of t unit square tiles separated from each other by gaps of width g.
%C A402564 T(n,k) is the coefficient of x^k in (L((n+k)/p))^p where p=gcd(n+k,6) and L(n,x) is a form of Lucas polynomial defined by L(n,x)=L(n-1,x)+x*L(n-2,x) where L(0,x)=2, L(1,x)=1, and L(n,x)=0 for n<0.
%C A402564 For n+k>6, T(n,k) is the number of k-subsets of n+k objects arranged in a circle such that no two objects in a subset are separated by 5 objects.
%C A402564 Sum of n-th antidiagonal (counting initial 64 as the 0th) is (L(n/p))^p where p=gcd(n,6) and L(i) is the i-th Lucas number A000032.
%F A402564 T(n,0) = 1 for n>0.
%F A402564 T(n,1) = n+1 for n>=6.
%F A402564 T(6*k,6*k) = 64 for k>=0.
%F A402564 T(2*k+1,2*k+1) = 0 for k>=0.
%F A402564 T(6*k+2,6*k+2) = T(6*k+4,6*k+4) = 4 for k>=0.
%F A402564 T(k+1,k) = 2*k+1 for k>=0 if k mod 3 is not 1.
%F A402564 T(3*k+2,3*k+1) = 0 for k>=0.
%F A402564 T(k+2,k) = (k+1)^2 for k>=0 if k mod 3 is not 2.
%F A402564 T(6*k+4,6*k+2) = 0 for k>=0.
%F A402564 T(k+2,k) = (16/3)*(k+1)^2 if k mod 6 is 5.
%F A402564 T(6*k+5,6*k+1) = 0 for k>=0.
%F A402564 T(6*(k+1),6*k) = (2k+1)^6 for k>=0.
%F A402564 T(n,k) = C(n,k)*(n+k)/n if n+k and 6 are relatively prime.
%F A402564 T(n,k) = T(n-1,k) + T(n-1,k-1) for n>=5k+2 and k>=0.
%e A402564 Triangle begins:
%e A402564  64;
%e A402564   1,   0;
%e A402564   1,   0,   4;
%e A402564   1,   4,   5,   0;
%e A402564   1,   5,   0,   7,   4;
%e A402564   1,   0,  14,  16,   0,   0;
%e A402564   1,   7,  20,  27,  25,  11,  64;
%e A402564   1,   8,  27,  50,  55, 192,  13,   0;
%e A402564   1,   9,  35,  77, 240,  91,  49,   0,   4;
%e A402564   1,  10,  44, 160, 182, 196, 125,  64,  17,   0;
%e A402564   1,  11,  60, 156, 294, 375, 336, 204,   0,  19,   4;
%e A402564   1,  12,  65, 210, 450, 672, 714,   0, 285, 100,   0,   0;
%e A402564 ...
%t A402564 LP[n_]:=If[n<0,0,Expand[LP[n-1]+x*LP[n-2]]+2KroneckerDelta[n,0]-KroneckerDelta[n,1]];
%t A402564 T[n_,k_]:=Module[{p=GCD[n+k,6]},Coefficient[LP[(n+k)/p]^p,x,k]];
%t A402564 Flatten@Table[T[n, k], {n, 0, 11}, {k, 0, n}]
