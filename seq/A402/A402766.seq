%N A402766 Sum of the numbers k < n not dividing n such that gcd(n,k) is divisible by a square > 1.
%H A402766 Michael De Vlieger, <a href="/A402766/b402766.txt">Table of n, a(n) for n = 1..10000</a>
%F A402766 a(n) = Sum_{k=1..n} k * (1-mu(gcd(n,k))^2) * (ceiling(n/k)-floor(n/k)).
%F A402766 a(n) = A402768(n) - A162296(n).
%t A402766 Table[Sum[k*(1 - MoebiusMu[GCD[n, k]]^2) (Ceiling[n/k] - Floor[n/k]), {k, n}], {n, 100}]
%o A402766 (PARI) a(n) = {my(f = factor(n)); n*(n+1)/2 - (n + issquarefree(f)) * prod(i = 1, #f~, if(f[i, 2] == 1, f[i, 1], f[i, 1]^f[i, 2] - f[i, 1]^(f[i, 2]-2))) / 2 - sigma(f) + vecprod(apply(x -> x+1, f[, 1]));} \\ _Amiram Eldar_, Nov 27 2026
%Y A402766 Cf. A008683 (mu), A162296, A402768.
%K A402766 nonn,easy,new
%O A402766 1,12
%A A402766 _Wesley Ivan Hurt_, Nov 26 2026
