%N A402594 a(n) = 1 if n is a composite number whose least prime factor appears with multiplicity 1, otherwise 0.
%H A402594 Antti Karttunen, <a href="/A402594/b402594.txt">Table of n, a(n) for n = 1..65537</a>
%H A402594 <a href="/index/Ch#char_fns">Index entries for characteristic functions</a>.
%F A402594 a(n) = A066247(n)*(1-A319710(n)) = A066247(n) - A319710(n).
%F A402594 For n > 2, a(n) >= A391844(n).
%t A402594 a[n_]:=If[!PrimeQ[n]&&FactorInteger[n][[1,-1]]==1,1,0];Join[{0},Table[a[n],{n,2,106}]] (* _James C. McMahon_, Nov 27 2026 *)
%o A402594 (PARI) A402594(n) = if(1==n || isprime(n), 0, my(f=factor(n)); (1==f[1, 2]));
%Y A402594 Characteristic function of A080364.
%Y A402594 Cf. A066247, A319710, A391844.
%Y A402594 Cf. also A402596.
