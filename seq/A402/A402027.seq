%T A402027 0,8,2,0,1,6,8,8,4,9,2,0,7,2,0,1,0,8,3,8,3,2,7,5,1,2,2,9,0,7,5,1,1,9,
%U A402027 5,0,4,5,6,8,3,1,9,2,3,9,7,9,9,2,2,3,3,0
%N A402027 Decimal expansion of L'(1,chi_24)/L(1,chi_24), where chi_24 is the Dirichlet character kronecker(24,.).
%F A402027 Equals A402011 - (1/(2*log(5+2*sqrt(6)))) * (zeta''(0,1/24) + zeta''(0,5/24) - zeta''(0,7/24) - zeta''(0,11/24) - zeta''(0,13/24) - zeta''(0,17/24) + zeta''(0,19/24) + zeta''(0,23/24)), where zeta''(s,x) is the second partial derivative of the Hurwitz zeta function with respect to s.
%e A402027 L'(1,chi_24)/L(1,chi_24) = 0.24119496888967014232...
%o A402027 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402027 f(24)
%o A402027 (PARI) f(D) = my([h, loge] = vecextract(quadclassunit(D), [1,4])); log(2*Pi) + Euler() - (1/(2*h*loge)) * sum(a=1, D, kronecker(D,a)*zetahurwitz(0, a/D, 2)); \\ D > 0 is a fundamental discriminant
%o A402027 f(24)
%Y A402027 Cf. A322796 (chi_24). See A402011 for related sequences.
