%T A402588 -4,1,0,-10,-1,-5,-3,1,1,1,-4,1,-5,1,-10,-8,-1,1,-2,1,1,-16,-3,1,-1,
%U A402588 -3,-6,-1,-1,1,-14,1,1,-8,0,-4,-10,1,-3,-22,-13,1,-7,1,1,1,-18,-4,-5,1,-2,1,-1,1,1,-15,1,-28
%N A402588 a(n) = gcd(n+1, A344005(n)) - gcd(n, A344005(n)), where A344005(n) is the smallest positive m such that n divides the oblong number m*(m+1).
%H A402588 Antti Karttunen, <a href="/A402588/b402588.txt">Table of n, a(n) for n = 1..20000</a>
%F A402588 a(n) = gcd(n + 1, A344005(n)) - A345992(n).
%o A402588 (PARI)
%o A402588 A344005(n) = { my(m=1); while((m*(m+1)) % n, m++); m; };
%o A402588 A402588(n) = { my(u=A344005(n)); (gcd(1+n,u)-gcd(n,u)); };
%Y A402588 Cf. A344005, A345992, A345995 (positions of negative terms).
%Y A402588 Cf. also A354988.
%K A402588 sign,new
%O A402588 1,12
