%I A402055 #9 Nov 15 2026 08:14:01
%S A402055 1,512,4096,19683,531441,1953125,2097152,10077696,16777216,40353607,
%T A402055 80621568,244140625,272097792,1000000000,2176782336,2357947691,
%U A402055 8000000000,8589934592,10460353203,10604499373,13841287201,20661046784,38443359375,41278242816,68719476736,118587876497
%N A402055 Numbers k such that gcd(d_3(k), 6) = 1, where d_3 = A007425 is the 3rd Piltz function.
%C A402055 Numbers k such that d_3(k) is a 5-rough number (A007310).
%C A402055 All the terms are cubes.
%C A402055 Numbers whose prime factorization has only exponents e that are multiples of 3, such that e/3 is congruent to 0 or 3 (mod 4) (A014601).
%H A402055 Amiram Eldar, <a href="/A402055/b402055.txt">Table of n, a(n) for n = 1..10000</a>
%H A402055 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%H A402055 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402055 a(n) = A402056(n)^3.
%F A402055 Sum_{n>=1} 1/a(n) = Product_{p prime} (1 + 1/(p^9 - p^6 + p^3 - 1)) = zeta(9) * zeta(12) / zeta(18) = 1.00225114773130244883... .
%e A402055 512 is a term since A007425(512) = 55, and gcd(55, 6) = 1.
%t A402055 f[p_, e_] := (e + 1)*(e + 2)/2; d3[n_] := Times @@ f @@@ FactorInteger[n]; d3[1] = 1; q[k_] := CoprimeQ[d3[k], 6]; Select[Range[4913]^3, q]
%o A402055 (PARI) isok(k) = ispower(k, 3) && #select(e -> (e % 4 > 0 && e % 4 < 3), factor(sqrtnint(k, 3))[, 2]) == 0;
%Y A402055 Subsequence of A000578.
%Y A402055 A402057 is a subsequence.
%Y A402055 Cf. A007310, A007425, A014601, A252849 (d_3(k) is even), A252895 (d_3(k) is odd), A352475, A402056.
%Y A402055 Cf. A013667, A013670, A013676.
%K A402055 nonn,easy,new
%O A402055 1,2
%A A402055 _Amiram Eldar_, Nov 12 2026
