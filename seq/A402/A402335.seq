%I A402335 #10 Nov 22 2026 22:53:30
%S A402335 0,1,2,2,4,4,5,6,7,7,9,10,11,13,15,18,20,23,26,30,33,36,42,46,52,57,
%T A402335 62,69,77,86,95,104,113,126,138,153,167,184,200,219,240,260,285,311,
%U A402335 338,367,398,431,469,508,550,594,643,695,751,811,873,942,1016,1095,1178
%N A402335 G.f.: Sum_{k>=1} x^k * Product_{j=k..4*k} (1 + x^j).
%H A402335 Vaclav Kotesovec, <a href="/A402335/b402335.txt">Table of n, a(n) for n = 0..10000</a>
%F A402335 a(n) ~ c * d^sqrt(n) / sqrt(n), where d = 3.557273664... and c = 0.47628200...
%t A402335 nmax = 60; CoefficientList[Series[Sum[x^j * Product[1+x^k, {k, j, 4*j}], {j, 1, nmax}], {x, 0, nmax}], x]
%t A402335 (* Alternative: *)
%t A402335 nmax = 60; p = 1; s = 0; Do[p = Simplify[p*(1 + x^(4*k - 3))*(1 + x^(4*k - 2))*(1 + x^(4*k - 1))*(1 + x^(4*k))/(1 + x^k)]; p = Normal[p + O[x]^nmax]; s += p*x^k*(1 + x^k);, {k, 1, nmax}]; CoefficientList[Series[s, {x, 0, nmax}], x]
%Y A402335 Cf. A363076, A385068, A384426, A393147.
%K A402335 nonn,new
%O A402335 0,3
%A A402335 _Vaclav Kotesovec_, Nov 17 2026
