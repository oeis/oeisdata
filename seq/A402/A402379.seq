%I A402379 #21 Nov 27 2026 12:27:50
%S A402379 1,2,2,3,2,4,2,5,3,4,2,8,2,4,4,9,2,7,2,10,4,4,2,16,3,4,6,12,2,8,2,17,
%T A402379 4,4,4,23,2,4,4,22,2,8,2,16,10,4,2,32,3,7,4,18,2,16,4,28,4,4,2,32,2,4,
%U A402379 12,33,4,8,2,22,4,8,2,55,2,4,8,24,4,8,2,46,15,4,2,40,4,4,4,40,2,26,4,28,4,4,4,64
%N A402379 a(n) = Sum_{d|n} d^(1 - mu(n/d)^2).
%C A402379 Number of divisors of n such that n/d is squarefree plus the sum of the divisors d of n such that n/d is not squarefree.
%H A402379 Antti Karttunen, <a href="/A402379/b402379.txt">Table of n, a(n) for n = 1..10000</a>
%F A402379 a(n) = sigma(n) - psi(n) + tau(rad(n)).
%F A402379 a(n) = sigma(n) - psi(n) + 2^omega(n). - _M. F. Hasler_, Nov 17 2026
%F A402379 If p is prime and u is squarefree and coprime to p, a(p^2*u) = 2*tau(u) + sigma(u). - _Robert Israel_, Nov 23 2026
%F A402379 From _Antti Karttunen_, Nov 25 2026: (Start)
%F A402379 a(n) = A244963(n) + A034444(n).
%F A402379 For all i, j >= 1: A295300(i) = A295300(j) => a(i) = a(j), i.e., technically, a(n) is a function of A295300(n), as well as that of A402601(n). (End).
%p A402379 f:= proc(n) local F,t;
%p A402379     F:= ifactors(n)[2];
%p A402379     mul((t[1]^(1+t[2])-1)/(t[1]-1), t = F) - n*mul(1+1/t[1],t=F) + 2^nops(F)
%p A402379 end proc:
%p A402379 map(f, [$1..100]); # _Robert Israel_, Nov 23 2026
%t A402379 Table[Sum[d^(1 - MoebiusMu[n/d]^2), {d, Divisors[n]}], {n, 100}]
%o A402379 (PARI) apply( {A402379(n)=sigma(n)-A001615(n)+2^omega(n)}, [1..99]) \\ _M. F. Hasler_, Nov 17 2026
%Y A402379 Cf. A000203 (sigma), A001615 (psi), A008683 (mu), A034444, A244963, A295300, A344575, A402184, A402601.
%Y A402379 Cf. A007947 (rad = squarefree kernel), A001221 (omega).
%K A402379 nonn,easy,look,new
%O A402379 1,2
%A A402379 _Wesley Ivan Hurt_, Nov 17 2026
