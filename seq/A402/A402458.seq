%I A402458 #10 Nov 24 2026 03:02:24
%S A402458 19,7,1027,3907,433,20,65539,4921,250003,442891,27649,70,143,105469,
%T A402458 4194307,6034393,314929,107,16000003,6,28344979,37008973,1769473,
%U A402458 61035157,217,3587227,26,148705831,6750001,289,268435459,11958037,386201107,19,20155393,323,6272,12,1024000003,1187526061,124
%N A402458 a(n) is the least number k such that k*n^3 = x^3 + y^3 for some x, y > 0 which are coprime to n.
%C A402458 a(n) <= n^6/4 + 3 if n is even or (n^6+3)/4 if n is odd, with equality for n in A004612 (numbers whose prime factors are all == 2 (mod 3)).
%C A402458 This comes from m^3 + (n^3-m)^3 = (n^6 - 3*m*n^3 + 3*m^2)*n^3, which is minimized when m is as close as possible to n^3/2.
%C A402458 a(n) >= 6, with infinitely many solutions to a(n) = 6.
%H A402458 Robert Israel, <a href="/A402458/b402458.txt">Table of n, a(n) for n = 2..1000</a>
%e A402458 a(3) = 7 because 7*3^3 = 4^3 + 5^3 and no k < 7 works.
%p A402458 f:= proc(n) local M,S,x,y,yy;
%p A402458  if n::odd then M:= (n^6+3)/4 else M:= n^6/4+3 fi;
%p A402458  if NumberTheory:-PrimeFactors(n) mod 3 = {2} then return M fi;
%p A402458  S:= map(rhs@op, [msolve(x^3=-1,n^3)]);
%p A402458  for x from 1 while 2*x^3 < n^3 * M do
%p A402458   if igcd(x,n)>1 then next fi;
%p A402458   yy:= min(map(t -> t*x mod n^3, S));
%p A402458   M:= min(M,(x^3 + yy^3)/n^3);
%p A402458  od:
%p A402458  M
%p A402458 end proc:
%p A402458 map(f, [$2..40]);
%Y A402458 Cf. A004612.
%K A402458 nonn,look,new
%O A402458 2,1
%A A402458 _Robert Israel_, Nov 18 2026
