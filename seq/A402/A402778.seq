%I A402778 #11 Nov 27 2026 12:30:36
%S A402778 1,1,3,4,10,6,21,24,27,20,55,24,78,42,60,72,136,54,171,80,126,110,253,
%T A402778 120,250,156,270,168,406,120,465,288,330,272,420,216,666,342,468,400,
%U A402778 820,252,903,440,540,506,1081,432,1029,500,816,624,1378,513,1100,840,1026
%N A402778 Sum of the integers k from 1 to n such that gcd(n, k) is a cube.
%C A402778 The number of these integers is A078429(n).
%H A402778 Amiram Eldar, <a href="/A402778/b402778.txt">Table of n, a(n) for n = 1..10000</a>
%F A402778 a(n) = Sum_{k=1..n, gcd(n, k) is cube} k = Sum_{k=1..n} A010057(gcd(n, k)) * k.
%F A402778 a(n) = n * (A010057(n) + A078429(n)) / 2.
%F A402778 Dirichlet g.f.: (1 + zeta(s-2)/zeta(s-1)) * zeta(3*s-3) / 2.
%F A402778 Sum_{k=1..n} a(k) ~ Pi^4 * n^3 / 945.
%t A402778 f1[p_, e_] := Boole[Divisible[e, 3]];
%t A402778 f2[p_, e_] := Sum[If[3*k == e, 1, (p-1)*p^(e-3*k-1)], {k, 0, Floor[e/3]}];
%t A402778 a[1] = 1; a[n_] := Module[{f = FactorInteger[n]}, (n/2)*(Times @@ f1 @@@ f + Times @@ f2 @@@ f)]; Array[a, 57]
%o A402778 (PARI) s(p, e) = sum(k = 0, e\3, if(3*k == e, 1, (p-1)*p^(e-3*k-1)));
%o A402778 a(n) = {my(f = factor(n)); (prod(i = 1, #f~, !(f[i, 2] % 3)) + prod(i = 1, #f~, s(f[i, 1], f[i, 2]))) * n/2;}
%Y A402778 Cf. A010057, A078429.
%Y A402778 Sum of the integers k from 1 to n such that gcd(n, k) is: A023896 (1), A119790 (prime power, A246655), A390800 (power of prime, A000961), A390801 (prime), A390802 (odd), A390803 (5-rough), A390804 (power of 2), A390805 (3-smooth), A390806 (squarefree), A390807 (cubefree), A390808 (square), A390809 (1 or 2), this sequence (cube), A402779 (powerful), A402780 (cubefull), A402781 (exponentially odd).
%K A402778 nonn,easy,new
%O A402778 1,3
%A A402778 _Amiram Eldar_, Nov 27 2026
