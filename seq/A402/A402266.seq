%N A402266 Indices m for which the sum of the first m deficient numbers A173106(m) is itself deficient.
%C A402266 The analogous sequence for abundant numbers is A402265.
%F A402266 Integers m such that A173106(m) = A401273(m).
%e A402266 A173106(1) = 1 that is deficient, so 1 is a term.
%e A402266 A173106(2) = 3 that is deficient, so 2 is another term.
%e A402266 A173106(3) = 6 that is perfect, so 3 is not a term.
%t A402266 Position[Accumulate[Select[Range[120], DivisorSigma[-1, #] < 2 &]], _?(DivisorSigma[-1, #] < 2 &)] // Flatten (* _Amiram Eldar_, Nov 17 2026 *)
%o A402266 (PARI) isd(x) = (sigma(x)/x) < 2;
%o A402266 lista(nn) = my(vd=select(isd, [1..nn]), s=0, list=List()); for (m=1, #vd, s+=vd[m]; if (isd(s), print1(s, ", "); listput(list, m));); Vec(list); \\ _Michel Marcus_, Nov 17 2026
%Y A402266 Cf. A005100, A173106, A401273.
%Y A402266 Cf. A402265.
%K A402266 nonn,new
