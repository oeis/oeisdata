%I A402054 #8 Nov 15 2026 08:09:52
%S A402054 256,512,768,1024,1280,1536,1792,2048,2304,2560,2816,3072,3328,3584,
%T A402054 3840,4096,4352,4608,4864,5120,5376,5632,5888,6144,6400,6561,6656,
%U A402054 6912,7168,7424,7680,7936,8448,8704,8960,9216,9472,9728,9984,10240,10496,10752,11008,11264
%N A402054 Numbers k such that d_4(k) is not a 7-smooth number, where d_4 = A007426 is the 4th Piltz function.
%C A402054 First differs from A309092 at n = 17: A309092(17) = 4097 is not a term in this sequence. Also a(26) = 6561 is not a term in A309092.
%C A402054 Numbers whose prime factorization includes at least one exponent that is not in {1, 2, 3, 4, 5, 6, 7, 13, 47}.
%C A402054 The asymptotic density of this sequence is 1 - Product_{p prime} (1 - 1/p^8 + 1/p^13 - 1/p^14 + 1/p^47 - 1/p^48) = 0.0039993559852592182754... .
%H A402054 Amiram Eldar, <a href="/A402054/b402054.txt">Table of n, a(n) for n = 1..10000</a>
%H A402054 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%e A402054 256 is a term since A007426(256) = 165 = 3 * 5 * 11 is not a 7-smooth number.
%t A402054 f[p_, e_] := (e+1)*(e+2)*(e+3)/6; d4[n_] := Times @@ f @@@ FactorInteger[n]; d4[1] = 1; smQ[n_] := n == Times @@ ({2, 3, 5, 7}^IntegerExponent[n, {2, 3, 5, 7}]); q[k_] := !smQ[d4[k]]; Select[Range[11300], q]
%t A402054 (* Alternative: *)
%t A402054 q[k_] := !AllTrue[FactorInteger[k][[;; , 2]], MemberQ[{1, 2, 3, 4, 5, 6, 7, 13, 47}, #] &]; Select[Range[11300], q]
%o A402054 (PARI) isok(k) = {my(e = factor(k)[, 2]); for(i = 1, #e, if(e[i] > 7 && e[i] != 13 && e[i] != 47, return(1))); 0;}
%Y A402054 Cf. A002473, A007426, A309092.
%K A402054 nonn,easy,new
%O A402054 1,1
%A A402054 _Amiram Eldar_, Nov 12 2026
