%I A402243 #9 Nov 16 2026 05:54:21
%S A402243 1,3,4,3,6,12,8,3,4,18,12,12,14,24,24,19,18,12,20,18,32,36,24,12,6,42,
%T A402243 4,24,30,72,32,51,48,54,48,12,38,60,56,18,42,96,44,36,24,72,48,76,8,
%U A402243 18,72,42,54,12,72,24,80,90,60,72,62,96,32,51,84,144,68,54
%N A402243 Sum of divisors of n that are terms in A252895.
%C A402243 First differs from A386471 at n = 32.
%C A402243 The number of these divisors is A365171(n), and the largest of them is A402244(n).
%H A402243 Amiram Eldar, <a href="/A402243/b402243.txt">Table of n, a(n) for n = 1..10000</a>
%F A402243 a(n) <= A000203(n) with equality if and only if n is squarefree.
%F A402243 Multiplicative with a(p^e) = (p+1)*(p^(4*(floor(e/4)+1))-1)/(p^4-1) - p^(4*floor(e/4)+1)*[e == 0 (mod 4)], where [] is the Iverson bracket.
%F A402243 Dirichlet g.f.: zeta(s-1) * zeta(s) * zeta(4*s-4) / zeta(2*s-2).
%F A402243 Sum_{k=1..n} a(k) ~ zeta(4) * n^2 / 2.
%t A402243 f[p_, e_] := With[{m = Floor[e/4]}, (p+1)*(p^(4*(m+1))-1)/(p^4-1) - p^(4*m+1)*Boole[Divisible[e, 4]]]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 67]
%o A402243 (PARI) s(p, e) = (p+1)*(p^(4*((e\4)+1))-1)/(p^4-1) - if(!(e%4), p^(4*(e\4)+1));
%o A402243 a(n) = vecprod([s(f[1], f[2]) | f <- factor(n)~]);
%Y A402243 Cf. A000203, A005117, A013662, A252895, A365171, A386471, A402244.
%K A402243 nonn,mult,easy,new
%O A402243 1,2
%A A402243 _Amiram Eldar_, Nov 16 2026
