%e A402142                  (2,2,2)
%t A402142 rgoQ[y_]:=y=={}||y[[1]]==1&&And @@ Table[y[[i]]<=1+Max@@Take[y,i-1],{i,2,Length[y]}];
%t A402142 Table[Length[Select[Join@@Permutations/@IntegerPartitions[n,{k}], !rgoQ[#]&]],{n,0,10},{k,0,n}]
