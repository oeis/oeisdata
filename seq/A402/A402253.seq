%U A402253 407696087207364415,17866784406346081150,834490320625603578563,41381601875808709367015,2171384295406745660143552
%N A402253 a(n) = 1 + Sum_{k=1..n} binomial(2*n,k) * a(n-k).
%F A402253 G.f. A(x) satisfies A(x) = (1-x)/(1+x) * (2*A(z) - 1/(1-z)), where z = x/(1+x)^2.
%F A402253 a(n) ~ c * n! * (2/log(2))^n * n^(log(2)/4), where c = 1.0757135791073288604295649958177809980780267118112011812927247767565... - _Vaclav Kotesovec_, Nov 16 2026
%t A402253 a[n_] := a[n] = If[n < 1, 1, 1 + Sum[Binomial[2*n, k]*a[n-k], {k, 1, n}]]; Table[a[n], {n, 0, 20}] (* _Vaclav Kotesovec_, Nov 16 2026 *)
%o A402253 (PARI) a_vector(n) = my(v=vector(n+1)); for(i=0, n, v[i+1]=1+sum(j=1, i, binomial(2*i, j)*v[i-j+1])); v;
