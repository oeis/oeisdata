%N A402589 a(n) = 1 if gcd(n, A344005(n)) > gcd(n + 1, A344005(n)), otherwise 0, where A344005(n) is the smallest positive m such that n divides the oblong number m*(m+1).
%H A402589 Antti Karttunen, <a href="/A402589/b402589.txt">Table of n, a(n) for n = 1..100000</a>
%H A402589 <a href="/index/Ch#char_fns">Index entries for characteristic functions</a>.
%F A402589 a(n) = [A345992(n) > gcd(n + 1, A344005(n))], where [ ] is the Iverson bracket.
%o A402589 (PARI)
%o A402589 A344005(n) = { my(m=1); while((m*(m+1)) % n, m++); m; };
%o A402589 A402589(n) = { my(u=A344005(n)); (gcd(n,u) > gcd(1+n,u)); }
%Y A402589 Characteristic function of A345995.
%Y A402589 Cf. A344005, A345992.
%Y A402589 Cf. also A354989.
%K A402589 nonn,new
%O A402589 1
