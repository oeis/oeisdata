%N A402021 Decimal expansion of L'(1,chi_{-15})/L(1,chi_{-15}) negated, where chi_{-15} is the Dirichlet character kronecker(-15,.).
%F A402021 Equals A402011 - (1/2) * (log Gamma(1/15) + log Gamma(2/15) + log Gamma(4/15) - log Gamma(7/15) + log Gamma(8/15) - log Gamma(11/15) - log Gamma(13/15) - log Gamma(14/15)).
%e A402021 L'(1,chi_{-15})/L(1,chi_{-15}) = -0.26336992967157300863...
%o A402021 (PARI) f(D) = my(L=lfuncreate(D)); lfun(L,1,1)/lfun(L,1,0); \\ D is a fundamental discriminant
%o A402021 f(-15)
%o A402021 (PARI) f(D) = my(h = qfbclassno(D)); log(2*Pi) + Euler() - (1/h) * sum(a=1, abs(D), kronecker(D,a)*lngamma(a/abs(D))); \\ D < -4 is a fundamental discriminant
%o A402021 f(-15)
%Y A402021 Cf. A316569 (chi_{-15}). See A402011 for related sequences.
