%S A402673 1,8,27,32,125,128,216,243,343,512,1000,1331,2048,2187,2197,2744,3125,
%T A402673 3375,4913,6859,7776,8192,9261,10648,12167,13824,16807,17576,19683,
%U A402673 24389,27000,29791,32768,35937,39304,42875,50653,54872,59319,64000,68921,74088,78125,79507
%N A402673 Exponentially odd numbers that are perfect powers.
%C A402673 Differs from its subsequence A384518 by having the terms 1, 8192, 9261, 10648, ... .
%C A402673 Numbers whose prime factorization has only odd exponents greater than 1, with the greatest common divisor of the exponents being greater than 1.
%H A402673 Amiram Eldar, <a href="/A402673/b402673.txt">Table of n, a(n) for n = 1..10000</a>
%H A402673 <a href="/index/Eu#epf">Index entries for sequences computed from exponents in factorization of n</a>.
%H A402673 <a href="/index/Pow#powerful">Index entries for sequences related to powerful numbers</a>.
%F A402673 Sum_{n>=1} 1/a(n) = 1 - Sum_{k>=1} mu(2*k+1)*f(2*k+1) = 1.22851902076196107883..., where f(s) = Sum_{n>=2} 1/A268335(n)^s = zeta(2*s) * Product_{p prime} (1 + 1/p^s - 1/p^(2*s)) - 1, and mu is the Moebius function (A008683).
%t A402673 q[k_] := k == 1 || Module[{e = FactorInteger[k][[;; , 2]]}, GCD @@ e > 1 && AllTrue[e, OddQ]]; Select[Range[80000], q]
%o A402673 (PARI) isok(k) = if(k == 1, 1, my(e = factor(k)[, 2], g = gcd(e)); g > 1 && #select(x -> !(x % 2), e) == 0);
%Y A402673 Intersection of A001597 and A268335.
