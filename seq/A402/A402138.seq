%I A402138 #11 Nov 20 2026 19:08:37
%S A402138 0,1,2,5,11,23,48,99,203,414,842,1708,3458,6990,14111,28456,57332,
%T A402138 115422,232219,466944
%N A402138 Number of integer compositions of n not comprising a 1-based restricted growth sequence.
%C A402138 A 1-based restricted growth sequence of length j is a sequence (a_1, ..., a_j), satisfying a_1 = 1 and a_i <= 1 + max(a_1, ..., a_{i-1}) for all i = 2, 3, ..., j.
%H A402138 Lindsey R. Campbell, Samantha Dahlberg, Robert Dorward, Jonathan Gerhard, Thomas Grubb, Carlin Purcell, and Bruce E. Sagan, <a href="https://www.sciencedirect.com/science/article/pii/S0196885818300599">Restricted growth function patterns and statistics</a>, Adv. Appl. Math. 100 (2018), 1-42.
%e A402138 The a(n) compositions for n = 1..5:
%e A402138   .  (2)  (3)   (4)    (5)
%e A402138           (21)  (13)   (14)
%e A402138                 (22)   (23)
%e A402138                 (31)   (32)
%e A402138                 (211)  (41)
%e A402138                        (113)
%e A402138                        (131)
%e A402138                        (212)
%e A402138                        (221)
%e A402138                        (311)
%e A402138                        (2111)
%t A402138 rgoQ[y_]:=y[[1]]==1&&And@@Table[y[[i]] <= 1+Max@@Take[y,i-1],{i,2,Length[y]}];
%t A402138 Table[Length[Select[Join@@Permutations /@ IntegerPartitions[n],!rgoQ[#]&]],{n,1,15}]
%Y A402138 For partitions instead of compositions we have A000065, ranks A080259.
%Y A402138 For reversed partitions we have A047967, ranks A055932.
%Y A402138 The complement is counted by A383253, ranks A402139.
%Y A402138 The normal case is A402140, ranks A402143.
%Y A402138 These compositions are ranked by A402141.
%Y A402138 Row sums of A402142, complement A383713.
%Y A402138 A011782 counts compositions, strict A032020.
%Y A402138 A107429 counts normal compositions, ranks A333217.
%Y A402138 Cf. A008277, A066099, A098133, A119387, A171682, A356844, A358135.
%K A402138 nonn,more,new
%O A402138 1,3
