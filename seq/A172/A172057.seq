%I A172057 #24 Oct 04 2026 12:24:10
%S A172057 7,13,19,31,43,61,73,103,109,139,151,181,193,199,229,241,271,283,313,
%T A172057 349,421,433,463,523,571,601,619,643,661,811,823,829,859,883,1021,
%U A172057 1033,1051,1063,1093,1153,1231,1279,1291,1303,1321,1429,1453,1483,1489,1609
%N A172057 Primes p such that either p-3 or p-2 (but not both) is/are prime.
%C A172057 Greater of twin primes where the greater is of the form 6*k+1.
%H A172057 Harvey P. Dale, <a href="/A172057/b172057.txt">Table of n, a(n) for n = 1..1000</a>
%H A172057 Cristian Cobeli and Alexandru Zaharescu, <a href="https://arxiv.org/abs/2403.14894">On the discrete trajectories of a self-propelled particle</a>, arXiv:2403.14894 [math.NT], 2024. See p. 11.
%F A172057 a(n) = A006512(n+1).
%t A172057 Select[Prime@ Range[4, 250], AnyTrue[# - 5/2 + {-1/2, 1/2}, PrimeQ] &] (* _Michael De Vlieger_, Mar 28 2024 *)
%t A172057 (* Alternative: *)
%t A172057 Select[Prime[Range[4,300]],AnyTrue[#+{-2,-3},PrimeQ]&] (* _Harvey P. Dale_, Oct 04 2026 *)
%t A172057 (* Alternative: *)
%t A172057 Select[Partition[Prime[Range[300]],2,1],#[[2]]-#[[1]]==2&&IntegerQ[(#[[2]]-1)/6]&][[;;,2]] (* _Harvey P. Dale_, Oct 04 2026 *)
%Y A172057 Cf. A006512.
%Y A172057 Intersection of A172240 and A006512.
%K A172057 nonn,less,changed
