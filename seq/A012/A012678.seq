%N A012678 Expansion of e.g.f. arcsin(tanh(x)*arctan(x)) (only even powers).
%e A012678 E.g.f. = 2/2!*x^2 - 16/4!*x^4 + 440/6!*x^6 - 25856/8!*x^8 + ...
%t A012678 With[{nn=30},Take[CoefficientList[Series[ArcSin[Tanh[x]ArcTan[x]],{x,0,nn}],x] Range[0,nn]!,{3,-1,2}]] (* _Harvey P. Dale_, Nov 22 2024 *)
%o A012678 (PARI) my(x='x+O('x^50), v=Vec(serlaplace(asin(tanh(x)*atan(x))))); vector(#v\2, i, v[2*i-1]) \\ _Michel Marcus_, Sep 26 2026
