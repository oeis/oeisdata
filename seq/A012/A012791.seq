%U A012791 4871968356294907783585792,5570589015199967686042095616,7500169763456956638544205586432,11744892751397802992530713372049408,21165291869669386140363163655871528960
%N A012791 Expansion of e.g.f.: arctanh(sec(x)*arcsin(x)) (odd powers).
%F A012791 a(n) ~ (2*n)! / r^(2*n+1), where r = 0.6948196907307875655784200727751937626855... is the root of the equation sec(r)*arcsin(r) = 1. - _Vaclav Kotesovec_, Feb 05 2015
%e A012791 E.g.f. = x + 6/3!*x^3 + 148/5!*x^5 + 9184/7!*x^7 + ...
%t A012791 nn = 20; Table[(CoefficientList[Series[ArcTanh[ArcSin[x]*Sec[x]], {x, 0, 2*nn+1}], x] * Range[0, 2*nn+1]!)[[n]], {n, 2, 2*nn, 2}] (* _Vaclav Kotesovec_, Feb 05 2015 *)
%K A012791 nonn
%O A012791 0,2
%A A012791 _Patrick Demichel_
