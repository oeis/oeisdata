%I A116330 #11 Jul 31 2026 02:23:55
%S A116330 4,85,76982,714689,952313,90438190,96320543,32980078899028,
%T A116330 34346653774237,42816188292272,42881990066487,57118009933511,
%U A116330 57183811707726,65653346225761,67019921100970,81321742742209
%N A116330 Numbers k such that k*(k+3) gives the concatenation of two numbers m and m+6.
%H A116330 Robert Israel, <a href="/A116330/b116330.txt">Table of n, a(n) for n = 1..160</a>
%e A116330 96320543 * 96320546 = 92776472//92776478, where // denotes concatenation.
%p A116330 f:= proc(d) local R,x,xx,m;
%p A116330   R:= NULL:
%p A116330 for xx in map(t -> rhs(op(t)), [msolve(x^2 = 33, 4*(10^d+1))]) do
%p A116330    m:= (xx^2-33)/(4*(10^d+1));
%p A116330    if m+6 >= 10^(d-1) and m + 6 < 10^d then R:= R, (xx-3)/2 fi
%p A116330 od;
%p A116330 sort([R]);
%p A116330 end proc:
%p A116330 seq(op(f(d)),d=1..50); # _Robert Israel_, Jul 30 2026
%Y A116330 Cf. A116172, A116316, A116329, A116331, A116336.
%K A116330 nonn,base,changed
%O A116330 1,1
%A A116330 _Giovanni Resta_, Feb 06 2006
