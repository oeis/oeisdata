%T A116545 36,39,41,42,43,44,49,50,51,52,54,55,56,57,60,61,62,63,65,67,68,69,70,
%U A116545 72,74,75,77,78,81,82,85,86,87,88,90,91,92,94,95,96,97,98,100,101,102,103,106,107,108,110,112,113,114,115,116,117,118,119,121,122,123,124,127,128,130,131,133,134,135,136
%N A116545 Sum of the largest Fibonacci exponent of prime factorizations of k, k=1..n.
%H A116545 Amiram Eldar, <a href="/A116545/b116545.txt">Table of n, a(n) for n = 1..10000</a>
%F A116545 a(n) ~ c*n, where c = 1.51093734684523345129... (see A115568 for the formula of this constant). - _Amiram Eldar_, Sep 19 2026
%t A116545 fibQ[n_] := Or @@ IntegerQ /@ Sqrt[5*n^2 + {-4, 4}];
%t A116545 A115568[n_] := Max[Select[DeleteDuplicates[FactorInteger[n][[;; , 2]]], fibQ]] /. -Infinity -> 1;
%t A116545 Accumulate[Array[A115568, 100]] (* _Amiram Eldar_, Sep 19 2026 *)
%Y A116545 Partial sums of A115568.
%K A116545 easy,nonn,changed
%O A116545 1,2
%A A116545 _Giovanni Teofilatto_, Mar 28 2006
