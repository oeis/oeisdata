%S A353156 1,-3,4,-4,2,6,-22,46,-74,86,-40,-120,450,-958,1506,-1694,744,2500,
%T A353156 -9184,19422,-30450,34032,-14178,-52286,188038,-394724,615102,-681110,
%U A353156 268666,1089974,-3847390,8021030,-12426638,13632728,-5063588,-22711916,78708912,-162966020,251005706
%N A353156 a(0) = 1; a(n) = -Sum_{k=1..n} prime(k+1) * a(n-k).
%H A353156 Robert Israel, <a href="/A353156/b353156.txt">Table of n, a(n) for n = 0..4567</a>
%F A353156 G.f.: 1 / (1 + Sum_{k>=1} prime(k+1) * x^k).
%p A353156 G:= 1/(1 + add(ithprime(k+1)*x^k, k=1..100)):
%p A353156 S:= series(G,x,101):
%p A353156 seq(coeff(S,x,i),i=0..100); # _Robert Israel_, Nov 03 2026
%t A353156 a[0] = 1; a[n_] := a[n] = -Sum[Prime[k + 1] a[n - k], {k, 1, n}]; Table[a[n], {n, 0, 38}]
%t A353156 (* Alternative: *)
%t A353156 nmax = 38; CoefficientList[Series[1/(1 + Sum[Prime[k + 1] x^k, {k, 1, nmax}]), {x, 0, nmax}], x]
