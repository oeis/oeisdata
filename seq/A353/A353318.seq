%p A353318 gf:= k-> x^(k*(k+1))/expand((1-x^(k+1))*mul((1-x^j)^2, j=1..k)):
%p A353318 T:= (n,k)-> coeff(series(gf(k),x,n+1),x,n):
%p A353318 seq(seq(T(n,k), k=0..floor(sqrt(n+1)-1/2)), n=0..22);  # _Alois P. Heinz_, Nov 20 2026
%t A353318 partsabove[y_]:=Length[Select[Range[Length[y]],#<y[[#]]&]];
%t A353318 DeleteCases[Table[Length[Select[IntegerPartitions[n],partsabove[#]==k&]],{n,1,15},{k,0,n-1}],0,2]
