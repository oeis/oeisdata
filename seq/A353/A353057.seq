%I A353057 #36 Oct 25 2026 17:16:12
%S A353057 8,9,16,49,81,1089,1156,1444,1936,3364,3481,4489,7056,7744,8836,10648,
%T A353057 34969,35344,37636,97969,98596,110592,110889,111556,140608,150544,
%U A353057 190969,197136,199809,306916,311364,407044,444889,473344,499849,544644,553536,558009,561001
%N A353057 Numbers N of the form m^k in ascending order having the property that for any choice of m and k such that N = m^k, the sets of distinct digits of m, k, and m^k are pairwise disjoint.
%C A353057 In this sequence, no similar digit sharing constraint applies between equivalent m^k's, so 2^4 = 4^2 = 16 is a valid term here.
%C A353057 Can a term exist in this sequence where neither m, k, m^k contains the decimal digit 2 in any of the ways m^k may be written? Examples for all the other missing decimal digits from m, k and m^k are easily found among the terms.
%H A353057 Robert Israel, <a href="/A353057/b353057.txt">Table of n, a(n) for n = 1..403</a> (all terms < 10^14)
%e A353057 10648 (where m=22, k=3) is a term because 22^3 = 10648 and the three sets of digits [2], [3] and [1,0,6,4,8] are mutually disjoint.
%e A353057 81 is a term because 3^4 = 81 and the three sets of digits [3], [4] and [8,1] are mutually disjoint. 9^2 = 81 too, and here the three sets of digits [9], [2] and [8,1] are also mutually disjoint. This example illustrates the cases where there is more than one choice for m and k.
%p A353057 M:= 10^10: # for terms < M
%p A353057 V:= Vector(M, storage=sparse):
%p A353057 S:= {}:
%p A353057 for m from 2 while m^2 < M do
%p A353057   dm:= convert(convert(m,base,10),set);
%p A353057   for k from 2 do
%p A353057     x:= m^k;
%p A353057     if x >= M then break fi;
%p A353057     dk:= convert(convert(k,base,10),set);
%p A353057     dx:= convert(convert(x,base,10),set);
%p A353057     isgood:= (dm intersect dk = {}) and (dm intersect dx = {}) and (dk intersect dx = {});
%p A353057     if isgood then
%p A353057       if V[x] = 0 then V[x]:= 1; S:= S union {x}; fi;
%p A353057     else
%p A353057       if V[x] = 1 then S:= S minus {x};  fi;
%p A353057       V[x]:= -1;
%p A353057     fi
%p A353057   od
%p A353057 od:
%p A353057 sort(convert(S,list)); # _Robert Israel_, Oct 23 2026
%Y A353057 Cf. A001597.
%K A353057 nonn,base,changed
%O A353057 1,1
