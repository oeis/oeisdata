%I A130857 #21 Aug 12 2026 18:45:18
%S A130857 0,3,17,57,147,322,630,1134,1914,3069,4719,7007,10101,14196,19516,
%T A130857 26316,34884,45543,58653,74613,93863,116886,144210,176410,214110,
%U A130857 257985,308763,367227,434217,510632,597432,695640,806344,930699,1069929
%N A130857 a(n) = (n-1)*n*(n+1)*(n+2)*(2*n+11)/120.
%C A130857 The motivation for this sequence is the triple sum Sum_{j=1..n} Sum_{m=1..j} Sum_{k=1..m} (k^2-1), which can be simplified into the polynomial term given as definition.
%C A130857 With a(0) = 0, convolution of A005563 with the triangular numbers (A000217). - _Klaus Purath_, Aug 11 2026
%H A130857 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (6,-15,20,-15,6,-1).
%F A130857 G.f.: -x^2*(x-3)/(-1+x)^6. - _R. J. Mathar_, Nov 14 2007
%F A130857 a(n) = 6*a(n-1) - 15*a(n-2) + 20*a(n-3) - 15*a(n-4) + 6*a(n-5) - a(n-6). - _Klaus Purath_, Aug 11 2026
%F A130857 E.g.f.: exp(x)*x^2*(180 + 160*x + 35*x^2 + 2*x^3)/120. - _Stefano Spezia_, Aug 12 2026
%t A130857 Table[(n - 1)*n(n + 1)*(n + 2)*(2*n + 11)/120, {n, 1, 35}]
%t A130857 (* Alternative: *)
%t A130857 Times@@#*(2#[[2]]+11)/120&/@Partition[Range[0,40],4,1] (* _Harvey P. Dale_, Oct 28 2012 *)
%Y A130857 Cf. A117662, A000217, A005563.
