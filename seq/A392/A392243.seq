%I A392243 #105 Sep 04 2026 00:43:00
%S A392243 -1,1,4,8,3,-3,-10,-18,-27,-17,-6,6,19,33,48,64,47,29,10,-10,-31,-53,
%T A392243 -76,-100,-125,-99,-72,-44,-15,15,46,78,111,145,180,216,179,141,102,
%U A392243 62,21,-21,-64,-108,-153,-199,-246,-294,-343,-293,-242,-190,-137,-83,-28,28,85,143,202,262,323
%N A392243 a(n) = Sum_{i=1..n} i*(-1)^ceiling(sqrt(i)).
%C A392243 If abs(a(n)) = abs(a(n+1)) then abs(a(n)) is a triangular number (A000217).
%C A392243 More precisely, abs(a(n-1)) = abs(a(n)) iff n = k*(k+1) for some k >= 1, in which case the common value is k*(k+1)/2. - _Jake Foth_, Aug 08 2026
%C A392243 The common value in abs(a(n-1))=abs(a(n)) at n=k*(k+1) is a square z^2 iff (2k+1)^2-8z^2=1. - _Jake Foth_, Aug 28 2026
%H A392243 Paolo Xausa, <a href="/A392243/b392243.txt">Table of n, a(n) for n = 1..10000</a>
%H A392243 Jake Foth, <a href="https://doi.org/10.5281/zenodo.22148482">The Arithmetic and Cube-Path Geometry of A392243</a>, Zenodo (2026).
%F A392243 a(k^2) = (-1)^k * k^3.
%F A392243 a(n) = (-1)^k * (k^3 - r*(2*n-r+1)/2) where k = A000196(n) and r = A053186(n) are square root and remainder n = k^2 + r. - _Kevin Ryde_, Jan 13 2026
%F A392243 From _Jake Foth_, Jul 16 2026 to Aug 28 2026: (Start)
%F A392243 a(n) = (-1)^k*((k*(k+1))^2-n*(n+1))/2, where k=floor(sqrt(n)).
%F A392243 a(m^4) = (-1)^m*m^6 for m>=1.
%F A392243 a(n) = F(j)^6 if j == 1 (mod 3), otherwise a(n) = -F(j)^6, where j>=3, F(m)=A000045(m), e=(-1)^(j-1), k=F(j)*F(j+1)+(e-1)/2, and n=k*(k+1)+e*F(j-1)^2. (End)
%t A392243 Accumulate[Array[#*(-1)^Ceiling[Sqrt[#]] &, 100]] (* _Paolo Xausa_, Jan 12 2026 *)
%o A392243 (PARI) a(n) = sum(i=1, n, if (ceil(sqrt(i)) % 2, -i, i)); \\ _Michel Marcus_, Jan 06 2026
