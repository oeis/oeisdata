%S A392677 -1,3,12,28,3,-33,-82,-146,-227,-127,-6,138,307,503,728,984,695,371,
%T A392677 10,-390,-831,-1315,-1844,-2420,-3045,-2369,-1640,-856,-15,885,1846,
%U A392677 2870,3959,5115,6340,7636,6267,4823,3302,1702,21,-1743,-3592,-5528,-7553,-9669,-11878,-14182,-16583,-14083
%N A392677 a(n) = Sum_{i=1..n} i^2*(-1)^ceiling(sqrt(i)).
%C A392677 If n is of the form k^2+k-1 where k is some positive integer then abs(a(n)) is a triangular number (A000217).
%C A392677 More precisely, for k >= 1, a(k*(k+1)-1) = (-1)^k*k*(k+1)/2, so abs(a(k*(k+1)-1)) = A000217(k). - _Jake Foth_, Aug 13 2026
%H A392677 Jake Foth, <a href="https://doi.org/10.5281/zenodo.21721439">A Unique Square in a Fixed-Offset Family of OEIS A392677: A Computer-Assisted Proof via an Elliptic Curve</a>, Zenodo, 2026.
%F A392677 Let b(n) = abs(a(n)). Then b(1) = 1 and, for n >= 2, with k = floor(sqrt(n-1)), b(n) = b(n-1) + n^2 if n > k*(k+1); otherwise b(n) = abs(b(n-1) - n^2). - _Jake Foth_, Aug 06 2026
%F A392677 a(n) = (-1)^k*(K*(2*K^2 - 3*K + 4) - n*(n+1)*(2*n+1))/6, where k = floor(sqrt(n)) and K = k*(k+1). - _Jake Foth_, Aug 19 2026
%t A392677 a[n_]:=Sum[i^2*(-1)^Ceiling[Sqrt[i]],{i,n}]; Array[a,50] (* _Stefano Spezia_, Jan 19 2026 *)
%o A392677 (PARI) a(n) = sum(i=1, n, if (ceil(sqrt(i)) % 2, -i^2, i^2)); \\ _Michel Marcus_, Jan 19 2026
