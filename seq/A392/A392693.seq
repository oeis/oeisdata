%N A392693 Numbers k such that sigma(k) = 2*k + 5*phi(k).
%C A392693 Also numbers k with abundance 5*phi(k).
%H A392693 Max Alekseyev, <a href="/A392693/b392693.txt">Table of n, a(n) for n = 1..33</a>
%e A392693 n=1080 has sigma(1080) = 3600, phi(1080) = 288, 2*1080 + 5*288 = 3600.
%t A392693 q[k_] := DivisorSigma[1, k] == 2*k + 5*EulerPhi[k]; Select[Range[60000], q] (* _Amiram Eldar_, Jan 21 2026 *)
%o A392693 (PARI) isok(n) = sigma(n) == 2*n + 5*eulerphi(n);
%Y A392693 Numbers with abundance k*phi(x): A008578 (k=-1), A000396 (k=0), A088826 (k=1), A099650 (k=2), A392691 (k=3), A392692 (k=4), this sequence (k=5).
