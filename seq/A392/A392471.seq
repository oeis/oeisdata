%T A392471 15,1,0,3114,7322,5299,1645,280,21,1,0,24240,65764,55244,21329,4200,
%U A392471 490,28,1,0,219456,659880,630944,279720,67809,9324,798,36,1,0,2231280,7237296,7782720,3925340,1091265,182973,18690,1230,45,1
%N A392471 Triangle read by rows: T(n,k) is the number of nested cycle partitions of n labeled nodes into k components.
%C A392471 A nested cycle of order m consists of a labeled cycle on m nodes with some additional cycles concentrically nested within it, where the cycle lengths are strictly decreasing. A nested cycle partition on k components consists of k such objects on a total of n nodes with the components forming a set, no order on the components.
%H A392471 Alois P. Heinz, <a href="/A392471/b392471.txt">Rows n = 0..150, flattened</a>
%H A392471 Marko Riedel, <a href="/A392471/a392471.maple.txt">Maple code for sequence</a>.
%H A392471 Marko Riedel, <a href="/A392471/a392471.pdf">Nested Cycle Partitions: definitions and basic recurrences</a>.
%F A392471 T(n,k) = (n!/k!) * [z^n] Q^k, where Q = -1 + Product_{m>=1} (1+z^m/m).
%F A392471 T(n,k) = n! * rho(n,k), where rho(n,k) = (1/n) * Sum_{m=0..n-1} rho(n-1-m,k-1) * (m+1) * kappa(m+1) with rho(0,j)=delta(0,j) and kappa(n) = (1/n) * ( nu(n) + Sum_{m=0..n-1} kappa(n-1-m) * nu(m+1) ), and kappa(0) = 0 and nu(m) = Sum_{d|m} (-1/d)^(m/d-1).
%e A392471 The triangular array starts:
%e A392471   n/k
%e A392471   0: 1;
%e A392471   1: 0,  1;
%e A392471   2: 0,  1,   1;
%e A392471   3: 0,  5,   3,  1;
%e A392471   4: 0, 14,  23,  6,  1;
%e A392471   5: 0, 74, 120, 65, 10, 1;
%e A392471   ...
%p A392471 b:= proc(n, i) option remember; `if`(i*(i+1)/2<n, 0, `if`(n=0, 1,
%p A392471       b(n, i-1)+b(n-i, min(n-i, i-1))*binomial(n, i)*(i-1)!))
%p A392471     end:
%p A392471 g:= proc(n) option remember; expand(`if`(n=0, 1,
%p A392471       x*add(g(n-j)*b(j$2)*binomial(n-1, j-1), j=1..n)))
%p A392471     end:
%p A392471 T:= (n, k)-> coeff(g(n), x, k):
%p A392471 seq(seq(T(n,k), k=0..n), n=0..10);  # _Alois P. Heinz_, Oct 05 2026
%Y A392471 Cf. A007838 (T(n,1)), A308338 (row sums).
