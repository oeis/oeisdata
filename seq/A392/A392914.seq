%T A392914 42689,45329,49253,55889,65537,70177,71249,90017,92369,92849,113761,
%U A392914 120929,129893,143249,150217,155081,156749,160481,166273,166289,167009,174241,190577,193937,198929,206177,218401,240257,249857
%N A392914 Primes starting a run of at least 4 consecutive primes with binary Hamming distance 1.
%C A392914 Binary hamming distance is d(x,y) = A101080(x,y) and a prime p here followed by primes q, r, s has d(p,q)=1, d(q,r)=1, and d(r,s)=1.
%C A392914 These correspond to three consecutive 1s in sequence A205510.
%H A392914 Michael S. Branicky, <a href="/A392914/b392914.txt">Table of n, a(n) for n = 1..10000</a>
%e A392914 166273 is in the sequence because the 4 consecutive primes are:
%e A392914   166273 = 101000100110000001_2
%e A392914   166289 = 101000100110010001_2
%e A392914   166297 = 101000100110011001_2
%e A392914   166301 = 101000100110011101_2
%e A392914 and the successive binary Hamming distances are 1, 1, 1.
%e A392914 166297 is not in the sequence because the 4 consecutive primes are:
%e A392914   166297 = 101000100110011001_2
%e A392914   166301 = 101000100110011101_2
%e A392914   166303 = 101000100110011111_2
%e A392914   166319 = 101000100110101111_2
%e A392914 and the successive binary Hamming distances are 1, 1, 2.
%t A392914 Select[Partition[Prime[Range[26000]], 4, 1], AllTrue[DigitSum[BitXor @@@ Partition[#, 2, 1], 2], # == 1 &] &][[;; , 1]] (* _Amiram Eldar_, Jan 27 2026 *)
%o A392914 (Python)
%o A392914 from sympy import primerange
%o A392914 def hamming_quadruples(limit):
%o A392914     primes = list(primerange(2, limit))
%o A392914     for p1, p2, p3, p4 in zip(primes, primes[1:], primes[2:], primes[3:]):
%o A392914         if (bin(p1 ^ p2).count('1') == 1 and
%o A392914             bin(p2 ^ p3).count('1') == 1 and
%o A392914             bin(p3 ^ p4).count('1') == 1):
%o A392914             print(p1, end=", ")
%o A392914 hamming_quadruples(500000)
%o A392914 (Python)
%o A392914 from gmpy2 import next_prime
%o A392914 from itertools import islice
%o A392914 def agen(): # generator of terms
%o A392914     p1, p2, p3, p4 = 2, 3, 5, 7
%o A392914     h1, h2, h3 = 1, 2, 1
%o A392914     while True:
%o A392914         if (h1, h2, h3) == (1, 1, 1):
%o A392914             yield int(p1)
%o A392914         p1, p2, p3, p4 = p2, p3, p4, next_prime(p4)
%o A392914         h1, h2, h3 = h2, h3, (p3^p4).bit_count()
%o A392914 print(list(islice(agen(), 41))) # _Michael S. Branicky_, Sep 27 2026
%Y A392914 Cf. A101080 (Hamming distance), A205510 (successive primes distance), A205511 (lesser of Hamming twins), A205533 (middle of Hamming triples), A007530 (prime quadruples).
