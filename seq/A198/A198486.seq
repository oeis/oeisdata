%N A198486 Numbers with the property that all pairs of consecutive digits differ by 9.
%H A198486 Alois P. Heinz, <a href="/A198486/b198486.txt">Table of n, a(n) for n = 1..1008</a>
%H A198486 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (10,1,-10).
%F A198486 G.f.: x*(80*x^10+62*x^9-18*x^8-18*x^7-18*x^6-18*x^5-18*x^4-18*x^3-18*x^2-8*x+1) / ((x-1) * (10*x-1) * (x+1)). - _Alois P. Heinz_, Sep 19 2026
%p A198486 a:= proc(n) option remember; `if`(n<10, n, a(n-1)*10+9*(n mod 2)) end:
%p A198486 seq(a(n), n=1..27);  # _Alois P. Heinz_, Sep 19 2026
%t A198486 t = {1, 2, 3, 4, 5, 6, 7, 8, 9}; Do[AppendTo[t, 10*t[[-1]]]; AppendTo[t, 10*t[[-1]] + 9], {9}]; t (* _T. D. Noe_, Oct 22 2013 *)
%o A198486 (Python)
%o A198486 def A198486():
%o A198486     print('Numbers whose consecutive digits differ by 9')
%o A198486     for i in range(1, 100001):
%o A198486         b, n = True, i
%o A198486         if n > 9:
%o A198486             while n > 9:
%o A198486                 a = abs((n // 10) % 10 - n % 10)
%o A198486                 if a != 9: b = False
%o A198486                 n = n // 10
%o A198486         if b: print(i, end=', ')
%o A198486     return
%Y A198486 Cf. A033075, A033088, A033081, A048406-A048410.
