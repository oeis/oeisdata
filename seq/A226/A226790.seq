%N A226790 Numbers of the form (3^j + 5^k)/2, for j and k >= 0.
%H A226790 Adam Reichert, <a href="/A226790/b226790.txt">Table of n, a(n) for n = 1..10000</a>
%H A226790 Adam Reichert, <a href="/A226790/a226790.py.txt">Python program</a>
%F A226790 a(n) = A226809(n)/2. - _Robert Israel_, Sep 16 2026
%p A226790 N:= 10000: # for terms <= N
%p A226790 S:= {}:
%p A226790 for j from 0 while 3^j <= 2*N do
%p A226790   S:= S union {seq((3^j + 5^k)/2, k = 0 .. ilog[5](2*N-3^j))}
%p A226790 od:
%p A226790 sort(convert(S,list)); # _Robert Israel_, Sep 16 2026
%t A226790 a = 3; b = 5; mx = 8000; Union[Flatten[Table[a^n + b^m, {m, 0, Log[b, mx]}, {n, 0, Log[a, mx - b^m]}]]]/2
%Y A226790 Cf. A226809 (3^j + 5^k).
%K A226790 nonn,changed
%O A226790 1,2
