%S A025717 1,2,4,7,11,16,22,29,36,44,53,63,74,86,99,112,126,141,157,174,192,211,
%T A025717 230,250,271,293,316,340,365,390,416,443,471,500,530,561,593,625,658,
%U A025717 692,727,763,800,838,876,915,955,996,1038,1081,1125,1169,1214,1260,1307,1355,1404,1454,1504,1555,1607,1660,1714,1769,1825,1882
%N A025717 Index of 6^n within the sequence of the numbers of the form 6^i*8^j.
%C A025717 Positions of zeros in A025674. - _R. J. Mathar_, Jul 06 2025
%H A025717 Amiram Eldar, <a href="/A025717/b025717.txt">Table of n, a(n) for n = 0..10000</a>
%F A025717 From _Amiram Eldar_, Nov 13 2025: (Start)
%F A025717 A025627(a(n)) = 6^n.
%F A025717 a(n) = 1 + Sum_{k=0..n} ceiling(k * c), where c = log_8(6) (A153493).
%F A025717 a(n) ~ c * n^2 / 2, where c is defined above. (End)
%t A025717 Accumulate[Table[Ceiling[n * Log[8, 6]], {n, 0, 60}]] + 1 (* _Amiram Eldar_, Nov 13 2025 *)
%o A025717 (Python)
%o A025717 def A025717(n):
%o A025717     c, m = n+1, 1
%o A025717     for i in range(n+1):
%o A025717         c += (m.bit_length()-1)//3
%o A025717         m *= 6
%o A025717     return c # _Chai Wah Wu_, Aug 17 2026
%Y A025717 Differs from A025702 at a(65).
%Y A025717 Cf. A000400, A025627, A025674, A153493.
