%N A025544 a(n) = sum of the exponents in the prime factorization of the least common multiple of the first n composite numbers.
%H A025544 Amiram Eldar, <a href="/A025544/b025544.txt">Table of n, a(n) for n = 1..10000</a>
%F A025544 a(n) = A001222(A025543(n)).
%t A025544 seq[lim_] := With[{c = Select[Range[lim], CompositeQ]}, PrimeOmega[Table[LCM @@ c[[1 ;; k]], {k, 1, Length[c]}]]]; seq[100] (* _Amiram Eldar_, Sep 22 2026 *)
