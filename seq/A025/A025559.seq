%N A025559 a(n) = (1/1 - 1/3 + 1/6 + ... + d/C(n+1,2))*LCM{1,3,6,...,C(n+1,2)}, where d = (-1)^n.
%H A025559 Robert Israel, <a href="/A025559/b025559.txt">Table of n, a(n) for n = 1..2291</a>
%p A025559 a:= proc(n) option remember;
%p A025559      procname(n-1) + (-1)^(n+1)/binomial(n+1,2)
%p A025559 end proc:
%p A025559 a(1):= 1:
%p A025559 b:= proc(n) ilcm(procname(n-1),binomial(n+1,2)) end proc:
%p A025559 b(1):= 1:
%p A025559 seq(a(n)*b(n),n=1..30); # _Robert Israel_, Jul 26 2026
