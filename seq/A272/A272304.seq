%T A272304 4,69,25,28,7,97,174,4,48,127,11,40,58,48,69,45,40,34,119,6,7,92,61,2,
%U A272304 40,138,105,332,28,70,322,62,231,78,339,245,66,49,439,298
%N A272304 Position of the first n-digit prime occurring in the decimal expansion of e.
%C A272304 Leading zeros are not allowed.
%H A272304 Michael S. Branicky, <a href="/A272304/b272304.txt">Table of n, a(n) for n = 1..1000</a> (terms 1..200 from Harvey P. Dale)
%e A272304 a(1) = 1 because the initial digit "2" of e is prime.
%t A272304 With[{ed = RealDigits[E, 10, 10000][[1]]}, Table[Position[Partition[ed, n, 1], _?(PrimeQ[FromDigits[#]] && #[[1]] != 0 &), {1}, 1, Heads -> False], {n, 100}]] // Flatten
%o A272304 (Python)
%o A272304 from sympy import E, isprime
%o A272304 e = "2"+str(E.n(10**6))[2:] # or load data from file
%o A272304 def A095935_A272304(n): return next(((p, i+1) for i in range(len(e)-n-10) if e[i]!="0" and isprime(p:=int(e[i:i+n]))), "not enough digits")
%o A272304 print([A095935_A272304(n)[1] for n in range(1, 66)]) # _Michael S. Branicky_, Oct 09 2026
%Y A272304 Cf. A001113, A095935 (corresponding primes).
