%T A205107 1,2,2,3,4,4,6,1,9,2,2,3,6,3,1,4,3,4,11,1,2,5,3,2,5,2,4,7,2,1,4,2,12,
%U A205107 3,7,1,1,3,4,2,4,3,5,4,2,4,3,6,1,5,3,9,7,5,9
%N A205107 The least index j < k such that n divides s(k) - s(j), where s(m) = 3^m - 2^m = A001047(m) and k = A205000(n) is the least index for which such j exists.
%C A205107 For a guide to related sequences, see A204892.
%t A205107 (* See the program at A205000. *)
%o A205107 (PARI) \\ cf. A205000 or A205108, with return(j) instead.
%o A205107 (PARI) a(n) = {my(l = List()); for(i = 1, oo, c = Mod(3, n)^i - Mod(2, n)^i; for(j = 1, #l, if(l[j] == c, return(j))); listput(l, c))} \\ _David A. Corneth_, Oct 09 2026
%o A205107 (Python) A205107 = lambda n, s=A1047: next(j for k in range(2,8<<88) if (sk:=s(k)) and (j:=next((j for j in range(1,k) if (sk-s(j))%n==0),0))) # with A1047=lambda n:3**n-2**n # _M. F. Hasler_, Oct 09 2026
%Y A205107 Cf. A001047, A205000, A204892.
%K A205107 nonn,easy,changed
