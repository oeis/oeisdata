%S A205108 5,5,19,5,65,19,19,65,19,65,665,65,2059,19,65,65,665,19,665,65,211,
%T A205108 665,65,211,665,2059,19171,2059,1586131,65,19171,65,665,665,211,6305,
%U A205108 19171,665,6305,665,2059,211,527345,665,6305,65,6305,211,2059,665
%N A205108 Least s(k) such that n divides s(k)-s(j) for some j<k, where s(j) = 3^j-2^j = A001047(j).
%C A205108 For a guide to related sequences, see A204892.
%C A205108 A205000 gives the index k such that a(n) = A001047(k) = 3^k - 2^k.
%F A205108 a(n) = A001047(A205000(n)).
%t A205108 (* See the program at A205000. *)
%o A205108 (PARI) apply( {A205108(n, s(n)=3^n-2^n)=for(k=2, oo, my(sk=s(k)); for(j=1, k-1, (sk-s(j))%n||return(sk)))}, [1..66]) \\ _M. F. Hasler_, Oct 09 2026
%o A205108 (Python) A205108 = lambda n, s=A001047: next(sk for k in range(2,8<<88) if (sk:=s(k)) and any((sk-s(j))%n==0 for j in range(1,k))) # with A001047=lambda n:3**n-2**n # _M. F. Hasler_, Oct 09 2026
%Y A205108 Cf. A205000, A204892.
%Y A205108 Cf. A001047 (3^n - 2^n).
%K A205108 nonn,changed
%O A205108 1,1
