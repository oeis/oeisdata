%I A205000 #20 Oct 11 2026 14:51:08
%S A205000 2,2,3,2,4,3,3,4,3,4,6,4,7,3,4,4,6,3,6,4,5,6,4,5,6,7,9,7,13,4,9,4,6,6,
%T A205000 5,8,9,6,8,6,7,5,12,6,8,4,8,5,7,6,7,8,16,9,6,7,9,13,13,4,22,9,8,4,8,6,
%U A205000 17,7,9,5,9,9,5,9,6,9,7,8,7,8,21,7,6,7,7,12,21,7
%N A205000 Least k such that n divides s(k)-s(j) for some j satisfying 1<=j<k, where s(j)=3^j-2^j.
%C A205000 See A204892 for a discussion and guide to related sequences.
%C A205000 a(n) <= n + 1 by the pigeonhole principle. - _David A. Corneth_, Oct 09 2026
%H A205000 David A. Corneth, <a href="/A205000/b205000.txt">Table of n, a(n) for n = 1..10000</a>
%e A205000 The remainders of 3^i - 2^i mod (n=4) are 1, 1 for i = 1..k=2. In the remainders so far there are two matches. k = 2 is the smallest value for which there is a match. Therefore a(4) = 2. - _David A. Corneth_, Oct 09 2026
%t A205000 s[n_] := s[n] = 3^n - 2^n; z1 = 500; z2 = 60;
%t A205000 Table[s[n], {n, 1, 30}]      (* A001047 *)
%t A205000 u[m_] := u[m] = Flatten[Table[s[k] - s[j], {k, 2, z1}, {j, 1, k - 1}]][[m]]
%t A205000 Table[u[m], {m, 1, z1}]      (* A205105 *)
%t A205000 v[n_, h_] := v[n, h] = If[IntegerQ[u[h]/n], h, 0]
%t A205000 w[n_] := w[n] = Table[v[n, h], {h, 1, z1}]
%t A205000 d[n_] := d[n] = First[Delete[w[n], Position[w[n], 0]]]
%t A205000 Table[d[n], {n, 1, z2}]  (* A205106 *)
%t A205000 k[n_] := k[n] = Floor[(3 + Sqrt[8 d[n] - 1])/2]
%t A205000 m[n_] := m[n] = Floor[(-1 + Sqrt[8 n - 7])/2]
%t A205000 j[n_] := j[n] = d[n] - m[d[n]] (m[d[n]] + 1)/2
%t A205000 Table[k[n], {n, 1, z2}]                  (* A205000 *)
%t A205000 Table[j[n], {n, 1, z2}]                  (* A205107 *)
%t A205000 Table[s[k[n]], {n, 1, z2}]               (* A205108 *)
%t A205000 Table[s[j[n]], {n, 1, z2}]               (* A205109 *)
%t A205000 Table[s[k[n]] - s[j[n]], {n, 1, z2}]     (* A205110 *)
%t A205000 Table[(s[k[n]] - s[j[n]])/n, {n, 1, z2}] (* A205111 *)
%o A205000 (PARI) apply( {A205000(n, s(n)=3^n-2^n)=for(k=1,oo, my(t=Mod(s(k),n)); for(j=1,k-1, t-s(j)||return(k)))}, [1..88]) \\ _M. F. Hasler_, Oct 09 2026
%o A205000 (PARI) a(n) = {my(l = List()); for(i = 1, oo, c = Mod(3, n)^i - Mod(2, n)^i; for(j = 1, #l, if(l[j] == c, return(i))); listput(l, c))} \\ _David A. Corneth_, Oct 09 2026
%o A205000 (Python) A205000 = lambda n, s=A1047: next(k for k in range(2,8<<88) if (sk:=s(k)) and any((sk-s(j))%n==0 for j in range(1,k))) # with A1047=lambda n:3**n-2**n # _M. F. Hasler_, Oct 09 2026
%Y A205000 Cf. A001047, A204892, A205111.
%K A205000 nonn,easy
%O A205000 1,1
%A A205000 _Clark Kimberling_, Jan 22 2012
