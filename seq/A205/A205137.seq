%I A205137 #14 Aug 08 2026 05:21:22
%S A205137 1,1,4,1,6,8,3,15,37,6,2,19,10,25,8,15,5,37,21,24,4,28,9,19,11,75,352,
%T A205137 30,14,8,55,231,34,7,20,37,78,150,13,24,27,53,105,95,70,12,35,19,72,
%U A205137 11,76,98,44,380,41,30,26,18,54,103
%N A205137 Least k such that n divides a difference between distinct pentagonal numbers when the differences are ordered as in A205136.
%C A205137 For a guide to related sequences, see A204892.
%H A205137 Robert Israel, <a href="/A205137/b205137.txt">Table of n, a(n) for n = 1..1001</a>
%F A205137 From _Robert Israel_, Aug 07 2026: (Start)
%F A205137 If p is a prime == 1 (mod 3), then a(p) = (p+2)*(p-1)/18.
%F A205137 If p > 5 is a prime == 2 (mod 3), then a(p) = (p+13)*(p-5)/72.
%F A205137 a(3^k) = (9^k - 3^k)/2 + 1.
%F A205137 It appears that if p is a prime == 1 (mod 3) then a(p^2) = 121/72*t^2 - 29/18*t + 67/72, and if p is an odd prime == 2 (mod 3), then a(p^2) = 49/72*t^2 - 25/18*t + 67/72. (End)
%p A205137 pent:= k -> k*(3*k-1)/2:
%p A205137 f:= proc(n) local R,kk,jj;
%p A205137   R:= select(t -> subs(t,j) > 0 and subs(t,j) < subs(t,k), [msolve(pent(k)-pent(j),n)]);
%p A205137   if R = [] then return (n^2-n)/2 + 1 fi;
%p A205137   kk:= min(map(t -> subs(t,k), R));
%p A205137   jj:= min(map(t -> subs(t,j),select(s -> subs(s,k)=kk, R)));
%p A205137  (kk-3)*kk/2 + 1 + jj;
%p A205137 end proc:
%p A205137 f(1):= 1:
%p A205137 map(f, [$1..100]); # _Robert Israel_, Aug 07 2026
%t A205137 (* See the program at A205138. *)
%Y A205137 Cf. A205138, A204892.
%K A205137 nonn
%O A205137 1,3
%A A205137 _Clark Kimberling_, Jan 25 2012
