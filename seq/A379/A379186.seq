%U A379186 11142842570134264,172101193009427174,2673445730846829604,41742159037922167264,654721526817143247304,10311337739352708700427
%N A379186 G.f. A(x) satisfies A(x) = 1/((1 - x*A(x)^3) * (1 - x*A(x))^2).
%H A379186 Robert Israel, <a href="/A379186/b379186.txt">Table of n, a(n) for n = 0..813</a>
%H A379186 Robert Israel, <a href="/A379186/a379186.txt">Recurrence of order 26</a>
%F A379186 a(n) = Sum_{k=0..n} binomial(n+3*k+1,k) * binomial(3*n+3*k+1,n-k)/(n+3*k+1).
%F A379186 D-finite with recurrence of order 26 (see link). - _Robert Israel_, Oct 27 2026
%p A379186 with(gfun):
%p A379186 eq:= y*(1-x*y^3)*(1-x*y)^2 - 1:
%p A379186 de:= algeqtodiffeq(eq,y(x)):
%p A379186 rec:= diffeqtorec(de,y(x),a(n)):
%p A379186 f:= rectoproc(rec,a(n),remember):
%p A379186 A:=map(f, [$0..30]); # _Robert Israel_, Oct 27 2026
%t A379186 terms = 21; A[_] = 0; Do[A[x_] = 1/((1-x*A[x]^3)*(1 -x*A[x])^2) + O[x]^terms // Normal, terms]; CoefficientList[A[x], x] (* _Stefano Spezia_, Jun 14 2025 *)
%o A379186 (PARI) a(n) = sum(k=0, n, binomial(n+3*k+1, k)*binomial(3*n+3*k+1, n-k)/(n+3*k+1));
