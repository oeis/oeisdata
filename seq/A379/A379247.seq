%T A379247 5603256962842,170587626013306,5257389708399426,163705194058656258,
%U A379247 5142396822771086970,162763301041914082970,5185766155796261822338,166183971861135163491458
%N A379247 G.f. A(x) satisfies A(x) = 1 + x * A(x)^4 * (1 + A(x)^5).
%H A379247 Robert Israel, <a href="/A379247/b379247.txt">Table of n, a(n) for n = 0..648</a>
%H A379247 Robert Israel, <a href="/A379247/a379247.txt">Recurrence of order 31</a>
%F A379247 a(n) = Sum_{k=0..n} binomial(n,k) * binomial(4*n+5*k+1,n)/(4*n+5*k+1).
%F A379247 D-finite with recurrence of order 31 (see link). - _Robert Israel_, Aug 25 2026
%p A379247 with(gfun):
%p A379247 eq:= -y + 1 + x*y^4*(1+y^5):
%p A379247 de:= algeqtodiffeq(eq,y(x)):
%p A379247 rec:= diffeqtorec(de,y(x),a(n)):
%p A379247 f:= rectoproc(rec,a(n),remember):
%p A379247 map(f, [$0..40]); # _Robert Israel_, Aug 25 2026
%o A379247 (PARI) a(n) = sum(k=0, n, binomial(n, k)*binomial(4*n+5*k+1, n)/(4*n+5*k+1));
%Y A379247 Cf. A363380.
%K A379247 nonn,changed
%O A379247 0,2
