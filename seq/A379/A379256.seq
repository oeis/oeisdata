%S A379256 1,2,20,296,5168,98896,2006592,42403584,923292672,20570204672,
%T A379256 466681402112,10744734700032,250415336695808,5896251565619200,
%U A379256 140051037257007104,3351752341884928000,80744484314316193792,1956433860220223062016,47647871136991576260608
%N A379256 G.f. A(x) satisfies A(x) = 1 + x * A(x)^3 * (1 + A(x)^4).
%H A379256 Robert Israel, <a href="/A379256/b379256.txt">Table of n, a(n) for n = 0..703</a>
%H A379256 Robert Israel, <a href="/A379256/a379256.txt">Recurrence of order 19</a>
%F A379256 a(n) = Sum_{k=0..n} binomial(n,k) * binomial(3*n+4*k+1,n)/(3*n+4*k+1).
%F A379256 D-finite with recurrence of order 19 (see link). - _Robert Israel_, Aug 27 2026
%p A379256 with(gfun):
%p A379256 eq:= -y + 1 + x*y^3*(1+y^4):
%p A379256 de:= algeqtodiffeq(eq,y(x)):
%p A379256 rec:= diffeqtorec(de,y(x),a(n)):
%p A379256 f:= rectoproc(rec,a(n),remember):
%p A379256 map(f, [$0..20]); # _Robert Israel_, Aug 27 2026
%o A379256 (PARI) a(n) = sum(k=0, n, binomial(n, k)*binomial(3*n+4*k+1, n)/(3*n+4*k+1));
%Y A379256 Cf. A379257.
%K A379256 nonn,changed
%O A379256 0,2
