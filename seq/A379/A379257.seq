%S A379257 1,2,26,530,12850,342370,9684010,285483666,8675363298,269823659586,
%T A379257 8547536496442,274825739078930,8945617644054546,294204116545534370,
%U A379257 9761360051405903434,326339380099797219474,10982521821776648986050,371758494418806559639170
%N A379257 G.f. A(x) satisfies A(x) = 1 + x * A(x)^3 * (1 + A(x)^7).
%H A379257 Robert Israel, <a href="/A379257/b379257.txt">Table of n, a(n) for n = 0..638</a>
%H A379257 Robert Israel, <a href="/A379257/a379257.txt">Recurrence of order 43</a>
%F A379257 a(n) = Sum_{k=0..n} binomial(n,k) * binomial(3*n+7*k+1,n)/(3*n+7*k+1).
%F A379257 D-finite with recurrence of order 43 (see link). - _Robert Israel_, Aug 27 2026
%p A379257 with(gfun):
%p A379257 eq:= -y + 1 + x*y^3*(1+y^7):
%p A379257 de:= algeqtodiffeq(eq,y(x)):
%p A379257 rec:= diffeqtorec(de,y(x),a(n)):
%p A379257 f:= rectoproc(rec,a(n),remember):
%p A379257 map(f, [$0..50]); # _Robert Israel_, Aug 27 2026
%o A379257 (PARI) a(n) = sum(k=0, n, binomial(n, k)*binomial(3*n+7*k+1, n)/(3*n+7*k+1));
%Y A379257 Cf. A379256.
%K A379257 nonn,changed
%O A379257 0,2
%A A379257 _Seiichi Manyama_, Dec 19 2024
