%S A379253 1,2,18,250,4114,74274,1422370,28375578,583343970,12271614850,
%T A379253 262896435954,5715805729274,125797580340978,2797216275743010,
%U A379253 62745424152317314,1418139209556260250,32263795396317233090,738290052194219833346,16981168956515987563730
%N A379253 G.f. A(x) satisfies A(x) = 1 + x * A(x)^2 * (1 + A(x)^5).
%H A379253 Robert Israel, <a href="/A379253/b379253.txt">Table of n, a(n) for n = 0..715</a>
%H A379253 Robert Israel, <a href="/A379253/a379253.txt">Recurrence of order 21</a>
%F A379253 a(n) = Sum_{k=0..n} binomial(n,k) * binomial(2*n+5*k+1,n)/(2*n+5*k+1).
%F A379253 D-finite with recurrence of order 21 (see link).
%p A379253 with(gfun):
%p A379253 eq:= -y + 1 + x*y^2*(1+y^5):
%p A379253 de:= algeqtodiffeq(eq,y(x)):
%p A379253 rec:= diffeqtorec(de,y(x),a(n)):
%p A379253 f:= rectoproc(rec,a(n),remember):
%p A379253 map(f, [$0..30]); # _Robert Israel_, Aug 26 2026
%o A379253 (PARI) a(n) = sum(k=0, n, binomial(n, k)*binomial(2*n+5*k+1, n)/(2*n+5*k+1));
%Y A379253 Cf. A361638.
%K A379253 nonn,changed
%O A379253 0,2
%A A379253 _Seiichi Manyama_, Dec 19 2024
