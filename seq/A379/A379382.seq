%S A379382 1,2,8,48,336,2560,20608,172416,1484288,13062144,116977664,1062600704,
%T A379382 9767067648,90673700864,848971661312,8007542571008,76014137180160,
%U A379382 725681289822208,6962697126019072,67105309925048320,649362348326256640,6306663216709632000
%N A379382 G.f. A(x) satisfies A(x) = sqrt( (1 + 2*x*A(x))/(1 - 2*x*A(x)^2) ).
%H A379382 Robert Israel, <a href="/A379382/b379382.txt">Table of n, a(n) for n = 0..982</a>
%F A379382 a(n) = 2^n * Sum_{k=0..n} binomial(n/2+3*k/2-1/2,k) * binomial(n/2+k/2+1/2,n-k)/(n+k+1).
%F A379382 a(n) = 2^n * A106228(n).
%F A379382 D-finite with recurrence: -48*n*(n + 1)*(n + 2)*a(n) + 4*(n + 24)*(n + 2)*(n + 1)*a(n + 1) - 4*(2*n + 5)*(7*n + 3)*(n + 2)*a(n + 2) + 4*(n + 3)*(17*n^2 + 114*n + 190)*a(n + 3) - 3*(n + 4)*(n + 3)*(2*n + 9)*a(n + 4) = 0. - _Robert Israel_, Oct 20 2026
%p A379382 with(gfun):
%p A379382 eq:= y^2 * (1-2*x*y^2) - (1+2*x*y);
%p A379382 de:= subs(RootOf(_Z^2-1)=1,algeqtodiffeq(eq,y(x)));
%p A379382 rec:= diffeqtorec(de,y(x),a(n));
%p A379382 f:= rectoproc(rec,a(n),remember):
%p A379382 map(f, [$0..30]); # _Robert Israel_, Oct 20 2026
%o A379382 (PARI) a(n) = 2^n*sum(k=0, n, binomial(n/2+3*k/2-1/2, k)*binomial(n/2+k/2+1/2, n-k)/(n+k+1));
%Y A379382 Cf. A138020, A379383.
%Y A379382 Cf. A151374, A379327, A379330.
%Y A379382 Cf. A106228.
%K A379382 nonn,changed
