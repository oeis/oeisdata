%S A060757 1,4,256,262144,4294967296,1125899906842624,4722366482869645213696,
%T A060757 316912650057057350374175801344,
%U A060757 340282366920938463463374607431768211456,5846006549323611672814739330865132078623730171904,1606938044258990275541962092341162602522202993782792835301376
%N A060757 a(n) = 4^(n^2).
%C A060757 Number of n X n matrices over GF(4).
%C A060757 a(n) = k^(n^2) with k = 2, 3, 4,... counts n X n matrices over GF(k). - Vincenzo Origlio (vincenzo.origlio(AT)itc.cnr.it), Nov 14 2002
%C A060757 From _Peter Bala_, Jul 25 2026: (Start)
%C A060757 This sequence is an example of a polynomial recursive sequence as defined by Cadilhac et al: a(n+1) = P(a(n), b(n)) and b(n+1) = Q(a(n), b(n)) with a(0) = b(0) = 1, where P(x, y) = 4*x*y^2, Q(x, y) = 4*y and b(n) = 4^n.
%C A060757 For prime p, the sequence obtained by reducing a(n) modulo p is ultimately periodic. For example, reducing the sequence modulo 13 gives the sequence [1, 4, 9, 12, 9, 4,  1, 4, 9, 12, 9, 4,  1, 4, 9, 12, 9, 4,  1, 4, 9, ...] with period 6 (= (13 - 1)/2) starting at n = 0. (End)
%H A060757 Harry J. Smith, <a href="/A060757/b060757.txt">Table of n, a(n) for n = 0..40</a>
%H A060757 Michaël Cadilhac, Filip Mazowiecki, Charles Paperman, Michał Pilipczuk, and Géraud Sénizergues, <a href="https://arxiv.org/abs/2002.08630">On polynomial recursive sequences</a>, arXiv:2002.08630 [cs.FL], 2020.
%F A060757 a(n) = A118185(2n,n). - _Alois P. Heinz_, Jun 29 2021
%F A060757 a(n)*a(n+2) - 16*a(n+1)^2 = 0 for n >= 0. - _Peter Bala_, Jul 25 2026
%t A060757 f[n_]:=4^(n^2);f[Range[0,14]] (* _Vladimir Joseph Stephan Orlovsky_, Feb 19 2011 *)
%o A060757 (PARI) a(n)={4^(n^2)} \\ _Harry J. Smith_, Jul 10 2009
%o A060757 (Maxima) A060757(n):=4^(n^2)$
%o A060757 makelist(A060757(n),n,0,10); /* _Martin Ettl_, Nov 08 2012 */
%o A060757 (SageMath) def A060757(n): return 4^(n^2)
%o A060757 print([A060757(n) for n in range(0,11)]) # _Stefano Spezia_, Mar 28 2025
