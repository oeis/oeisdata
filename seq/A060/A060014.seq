%N A060014 Sum of orders of all permutations of n letters.
%C A060014 Conjecture: This sequence eventually becomes cyclic mod m for all m. - _Isaac Saffold_, Dec 01 2019
%C A060014 This is true; see the OEISwiki link for a proof based on Alois P. Heinz's program. - _Natalia L. Skirrow_, Aug 31 2026
%D A060014 D. S. Mitrinovic et al., Handbook of Number Theory, Kluwer, Section XIII.2, p. 460.
%H A060014 Alois P. Heinz, <a href="/A060014/b060014.txt">Table of n, a(n) for n = 0..170</a>
%H A060014 Paul Erdős, Pál Turán, <a href="https://doi.org/10.1007/BF02280290">On some problems of a statistical group theory, III</a>, Acta Math. Acad. Sci. Hungar. 19 (1968), pp. 413-435. [alternate links <a href="https://combinatorica.hu/~p_erdos/1967-15.pdf">1</a>, <a href="https://renyi.hu/~p_erdos/1967-15.pdf">2</a>]
%H A060014 Paul Erdős, Pál Turán, <a href="https://doi.org/10.1007/bf01894517">On some problems of a statistical group theory, IV</a>, Acta Math. Acad. Sci. Hungar. 19 (1968), pp. 413-435. [alternate links <a href="https://combinatorica.hu/~p_erdos/1968-11.pdf">1</a>, <a href="https://www.renyi.hu/~p_erdos/1968-11.pdf">2</a>]
%H A060014 FindStat - Combinatorial Statistic Finder, <a href="https://www.findstat.org/StatisticsDatabase/St000058/">The order of a permutation</a>
%H A060014 William M. Y. Goh and Eric Schmutz, <a href="https://web.archive.org/web/20210506201130/http://www.pages.drexel.edu/~schmutze/PAPERS/musn.pdf">The expected order of a random permutation</a>, Bulletin of the London Mathematical Society 23:1 (1991), pp. 34-42.
%H A060014 Joshua Harrington, Lenny Jones, and Alicia Lamarche, <a href="https://doi.org/10.1155/2014/835125">Characterizing Finite Groups Using the Sum of the Orders of the Elements</a>, International Journal of Combinatorics, Volume 2014, Article ID 835125, 8 pages.
%H A060014 Edmund Landau, <a href="https://archive.org/details/handbuchderlehre01landuoft">Handbuch der Lehre von der Verteilung der Primzahlen</a> (1909), Leipzig. (See discussion of A000793 starting on <a href="https://archive.org/details/handbuchderlehre01landuoft/page/222/mode/2up">page 222</a>.)
%H A060014 J. L. Nicolas, <a href="https://doi.org/10.1007/bf01955024">Distribution statistique de l'ordere d'un elemente du groupe symmetrique</a>, Acta Math. Hungar. 45 (1985), pp. 69-84. [<a href="https://web.archive.org/web/20220308100312/http://math.univ-lyon1.fr/~nicolas/actahung85.pdf">alternate link</a>]
%H A060014 Eric Schmutz, <a href="https://doi.org/10.1016/0022-314X(89)90073-5">Proof of a conjecture of Erdös and Turán</a>, Journal of Number Theory, vol. 31, iss. 3 (received 1987), pp. 260-271.
%H A060014 Manoj Kumar Singh, <a href="https://arxiv.org/abs/2609.05805">Odd square roots and the sum of element orders on S_n and A_n</a>, arXiv:2609.05805 [math.GM], 2026. See Table 2 p. 7.
%H A060014 Natalia L. Skirrow, <a href="/wiki/User:Natalia_L._Skirrow/A060014">notes on A060014</math>.
%H A060014 Richard Stong, <a href="https://doi.org/10.37236/1379">The Average Order of a Permutation</a>, The Electronic Journal of Combinatorics (1998), 5(1), #R41.
%F A060014 E.g.f.: Sum_{k>=1} k*Sum_{i|k} moebius(k/i)*Product_{j|i} exp(x^j/j). - _Vladeta Jovovic_, Dec 29 2004; The sum over k should run to at least A000793(n) for producing the n-th entry. - _Wouter Meeussen_, Jun 16 2012
%F A060014 a(n) = Sum_{k>=1} k*A057731(n,k). - _R. J. Mathar_, Aug 31 2017
%F A060014 From _Natalia L. Skirrow_, Aug 31 2026: (Start)
%F A060014 The maximum order across all permutations in S_n (A000793) is exp( sqrt(n*log n) * (1+o(1)) ) [Landau, 1909].
%F A060014 The mean of the logarithm is ~ (log n)^2/2, with variance ~ (log n)^3/3, and almost all permutations have order < exp((log n)^2) [Erdős & Turán, 1967].
%F A060014 log(A009490(n)) = (2*Pi/sqrt(6)) * sqrt(n/log n) + O(sqrt(n)*log log n/log n) [Erdős & Turán, 1968, theorem 1]
%F A060014 log(a(n)/n!) = O(sqrt(n/log n)) [conjectured in Erdős & Turán, 1968].
%F A060014 log(a(n)/n!) > (2*Pi/sqrt(6)) * sqrt(n/log n) * (1 + o(1)) [Nicolas, 1985; this is analogous to the result about A009490 but the RHS counts only the distinct squarefree orders of permutations].
%F A060014 log(a(n)/n!) ~ C * sqrt(n/log n) [Schmutz, 1987].
%F A060014 C = 2.99047039... = A244292 = 2*sqrt(2*Integral_{t=0..oo} log(1 + log 1/(1-e^-t)) dt) [Goh & Schmutz, 1991].
%F A060014 log(a(n)/n!) = C * sqrt(n/log n) + O(sqrt(n)*log log n/log n) [Stong, 1998].
%F A060014 (End)
%e A060014 For n = 4 there is 1 permutation of order 1, 9 permutations of order 2, 8 of order 3 and 6 of order 4, for a total of 67.
%p A060014 b:= proc(n, g) option remember; `if`(n=0, g, add((j-1)!
%p A060014       *b(n-j, ilcm(g, j))*binomial(n-1, j-1), j=1..n))
%p A060014     end:
%p A060014 a:= n-> b(n, 1):
%p A060014 seq(a(n), n=0..30);  # _Alois P. Heinz_, Jul 11 2017
%t A060014 CoefficientList[Series[Sum[n Fold[#1+MoebiusMu[n/#2] Apply[Times, Exp[x^#/#]&/@Divisors[#2] ]&,0,Divisors[n]],{n,Max[Apply[LCM,Partitions[19],1]]}],{x,0,19}],x] Range[0,19]! (* _Wouter Meeussen_, Jun 16 2012 *)
%t A060014 (* Alternative: *)
%t A060014 a[ n_] := If[ n < 1, Boole[n == 0], 1 + Total @ Apply[LCM, Map[Length, First /@ PermutationCycles /@ Drop[Permutations @ Range @ n, 1], {2}], 1]]; (* _Michael Somos_, Aug 19 2018 *)
%o A060014 (PARI) \\ Naive method -- sum over cycles directly
%o A060014 cycleDecomposition(v:vec)={
%o A060014     my(cyc=List(), flag=#v+1, n);
%o A060014     while((n=vecmin(v))<#v,
%o A060014         my(cur=List(), i, tmp);
%o A060014         while(v[i++]!=n,);
%o A060014         while(v[i] != flag,
%o A060014             listput(cur, tmp=v[i]);
%o A060014             v[i]=flag;
%o A060014             i=tmp
%o A060014         );
%o A060014         if(#cur>1, listput(cyc, Vec(cur)))    \\ Omit length-1 cycles
%o A060014     );
%o A060014     Vec(cyc)
%o A060014 };
%o A060014 permutationOrder(v:vec)={
%o A060014     lcm(apply(length, cycleDecomposition(v)))
%o A060014 };
%o A060014 a(n)=sum(i=0,n!-1,permutationOrder(numtoperm(n,i)))
%o A060014 \\ _Charles R Greathouse IV_, Nov 06 2014
%o A060014 (PARI)
%o A060014 A060014(n) =
%o A060014 {
%o A060014   my(factn = n!, part, nb, i, j, res = 0);
%o A060014   forpart(part = n,
%o A060014     nb = 1; j = 1;
%o A060014     for(i = 1, #part,
%o A060014       if (i == #part || part[i + 1] != part[i],
%o A060014         nb *= (i + 1 - j)! * part[i]^(i + 1 - j);
%o A060014         j = i + 1));
%o A060014     res += (factn / nb) * lcm(Vec(part)));
%o A060014   res;
%o A060014 } \\ _Jerome Raulin_, Jul 11 2017 (much faster, O(A000041(n)) vs O(n!))
%o A060014 (Python)
%o A060014 from math import perm,lcm
%o A060014 from functools import cache
%o A060014 b=cache(lambda n,g: sum(perm(n-1,j-1)*b(n-j,lcm(g,j)) for j in range(1,n+1)) if n else g)
%o A060014 A060014=lambda n: b(n,1) # _Natalia L. Skirrow_, Aug 31 2026, after _Alois P. Heinz_
%Y A060014 Cf. A000793, A009490, A028418, A060015, A057731, A074859, A244292, A256553, A290932, A346066.
