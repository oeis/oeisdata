%S A111222 4,5,6,7,8,9,10,11,12,14,15,16,19,20,24,27,28,29,30,32,33,34,37,38,42,
%T A111222 50,51,52,55,56,60,73,74,78,96,123,124,125,126,128,129,130,133,134,
%U A111222 138,146,147,148,151,152,156,169,170,174,192,242,243,244,247,248,252,265
%N A111222 Integers that can be expressed as the sum of 4 factorials.
%C A111222 The subsequence of integers which are a sum of 4 distinct factorials starts 33 =1!+2!+3!+4!, 129 = 1!+2!+3!+5!, 147=1!+2!+4!+5!, 151=1!+3!+4!+5!, 152=2!+3!+4!+5!,... - _R. J. Mathar_, Oct 08 2026
%F A111222 n = a! + b! + c! + d! being a, b, c, d positive integers or zeros
%e A111222 Example: 0! + 1! + 3! + 4! = 1 + 1 + 6 + 24 = 32
%p A111222 amax := 1000 ;
%p A111222 L := {} ;
%p A111222 for d from 1 do
%p A111222     for c from d do
%p A111222         for b from c do
%p A111222             for a from b do
%p A111222                 if a!+b!+c!+d! > amax then
%p A111222                     break ;
%p A111222                 end if;
%p A111222                 L := L union {a! +b!+ c!+ d!} ;
%p A111222             end do:
%p A111222             if b!+c!+d! > amax then
%p A111222                 break ;
%p A111222             end if;
%p A111222         end do:
%p A111222         if c! +d! > amax then
%p A111222             break ;
%p A111222         end if;
%p A111222     end do:
%p A111222     if d! > amax then
%p A111222         break ;
%p A111222     end if;
%p A111222 end do:
%p A111222 sort(convert(L,list)) ; # _R. J. Mathar_, Oct 08 2026
%t A111222 nmax = 266; k = 1; s = 0; While[k! <= nmax, s += x^(k!); k++ ]; Select[Range[nmax], Coefficient[s^4, x, # ] > 0 &] (* _Ray Chandler_, Nov 01 2005 *)
