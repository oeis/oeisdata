%I A111502 #20 Oct 16 2026 19:05:00
%S A111502 33,48,203,6648,27048,63293,80288,168348,194298,201178,218888,280103,
%T A111502 310828,313668,315448,341893,375298,405958,440643,479668,520058,
%U A111502 611868,615893,628068,632533,666973,812888,882728,883643,941143,950983,971158
%N A111502 Numbers k such that (k+j)^3-(k+j)^2+1 are primes for j=0 to 3.
%H A111502 Alper Ferudun, <a href="/A111502/b111502.txt">Table of n, a(n) for n = 1..10000</a>
%e A111502 33^3 - 33^2 + 1 = 34849 is prime,
%e A111502 34^3 - 34^2 + 1 = 38149 is prime,
%e A111502 35^3 - 35^2 + 1 = 41651 is prime,
%e A111502 36^3 - 36^2 + 1 = 45361 is prime, so 33 is a term.
%t A111502 fQ[n_] := Block[{j = {0, 1, 2, 3}}, Union@PrimeQ[(n + j)^3 - (n + j)^2 + 1] == {True}]; t = {}; Do[ If[ fQ[n], AppendTo[t, n]], {n, 1005807}] (* _Robert G. Wilson v_, Nov 18 2005 *)
%t A111502 (* Alternative: *)
%t A111502 slv[n_]:=x/.Solve[x^3-x^2+1==n,x][[1]]; slv/@(Transpose[Select[ Partition[ Table[ n^3-n^2+1,{n,980000}],4,1],And@@PrimeQ[#]&]][[1]]) (* _Harvey P. Dale_, May 03 2014 *)
%o A111502 (Python)
%o A111502 from gmpy2 import is_prime
%o A111502 def ok(k): return all(is_prime((k+j)**3-(k+j)**2+1) for j in range(4))
%o A111502 print([k for k in range(10**6) if ok(k)]) # _Michael S. Branicky_, Oct 16 2026
%K A111502 nonn,changed
%O A111502 1,1
%A A111502 _Pierre CAMI_, Nov 16 2005
%E A111502 a(6)-a(32) from _Robert G. Wilson v_, Nov 18 2005
