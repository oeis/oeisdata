%S A093771 4,8,9,25,27,32,36,49,100,121,125,128,144,169,196,216,225,243,289,324,
%T A093771 343,361,400,441,484,529,576,676,784,841,900,961,1000,1089,1156,1225,
%U A093771 1331,1369,1444,1521,1600,1681,1728,1764,1849,1936,2025,2048,2116,2187
%N A093771 Perfect powers for which the exponent is a prime number: solutions to {A052409(x) is prime}.
%C A093771 Numbers k such that the GCD of the exponents in the canonical prime factorization of k is prime.
%C A093771 All the 2nd, 3rd, 5th, 7th, ... powers are terms, the 4th, 6th, 8th, ... powers are excluded from A001597.
%C A093771 Th ordered terms of the set {A007916(k)^prime(m) | m,k >= 1}. - _Amiram Eldar_, Sep 21 2026
%H A093771 Reinhard Zumkeller, <a href="/A093771/b093771.txt">Table of n, a(n) for n = 1..10000</a>
%F A093771 A010051(A025479(n)) = 1. - _Reinhard Zumkeller_, Mar 28 2014
%F A093771 Sum_{n>=1} 1/a(n) = Sum_{m,k>=1} mu(k)*(zeta(prime(m)*k)-1) = 0.7719533714834800724275887..., where mu is the Moebius function (A008683). - _Amiram Eldar_, Sep 21 2026
%t A093771 ffi[x_] := Flatten[FactorInteger[x]];
%t A093771 ep[x_] := Table[Part[ffi[x], 2*w], {w, 1, lf[x]}];
%t A093771 lf[x_] := Length[FactorInteger[x]];
%t A093771 Do[If[PrimeQ[Apply[GCD, ep[n]]], Print[n]], {n, 2, 10000}]
%o A093771 (Haskell)
%o A093771 a093771 n = a093771_list !! (n-1)
%o A093771 a093771_list = [a001597 x | x <- [2..], a010051 (a025479 x) == 1]
%o A093771 -- _Reinhard Zumkeller_, Mar 28 2014
%o A093771 (PARI) is(n)=isprime(ispower(n)) \\ _Charles R Greathouse IV_, Oct 19 2015
