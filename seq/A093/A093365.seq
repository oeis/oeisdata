%U A093365 4281133,4344889,4408645,25371361,26143825,33344305,852688273,1138267241,3106000349,3131438993
%N A093365 Least number which is the end of an arithmetic progression of n numbers that are the sums of two nonzero squares.
%C A093365 a(34) > 225000000.
%C A093365 a(38) > 10^10. - _Hugo Pfoertner_, Aug 04 2026
%H A093365 Ben Green and Terence Tao, <a href="http://arXiv.org/abs/math/0404188">The primes contain arbitrarily long arithmetic progressions</a>, arXiv:math/0404188 [math.NT], 2004-2007. (chapter 11, p. 50)
%e A093365 a(6)=65: 5=2^2+1^2, 17=4^2+1^2, 29=5^2+2^2, 41=5^2+4^2, 53=7^2+2^2, 65=7^2+4^2.
%o A093365 (PARI) \\ uses is_A000404(n) from A000404
%o A093365 check(n,last,step) = my(m=0); forstep(k=last, 0, -step, if(is_A000404(k), m++, break)); m==n;
%o A093365 \\ returns [a(n), A093366(n)]; not suitable for n>21
%o A093365 a093365_66(n) = if(n<2, return([2,0])); for(last=2, oo, for(step=1, last, if(check(n,last,step), return([last,step]); break))); \\ _Hugo Pfoertner_, Aug 04 2026
%Y A093365 Arithmetic progressions in A000404. For gaps see A093366.
