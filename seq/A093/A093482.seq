%S A093482 0,0,5,20,3,0,0,55,215,0,13,0,11,0,209,1139,0,0,80,4,3,0,25,551,23,0,
%T A093482 0,1196,0,0,8993,0,0,0,1189,84,0,0,41,0,39,0,0,180,1323,0,0,2255,
%U A093482 30575,0,0,0,1315,0,8,168,0,0,61,380,59,0,80,67535,1615,0,0,156,371,0
%N A093482 a(n) = the least positive k such that (n+k)+1 and (n*k)+1 are both squares; or 0 if no such k exists.
%C A093482 For n >1 if a(n) = m then a(m) = n. Subsidiary sequence: indices of zero.
%H A093482 Robert Israel, <a href="/A093482/b093482.txt">Table of n, a(n) for n = 1..5120</a>
%e A093482 a(3) = 5, 3+5 +1 =9 and 3*5 +1 = 16 are both Squares.
%p A093482 f:= proc(n) local S,S0,i;
%p A093482   S:= [isolve(n*x^2 - n^2 - y^2 - n + 1)];
%p A093482   if S = [] then return 0 fi;
%p A093482   for i from 0 do S0:= select(t -> subs(t,x)>0 and subs(t,y)>0 and subs(t,x^2-n-1)>0,expand(eval(S,_Z1=i)));
%p A093482        if S0 <> [] then return min(map(t -> subs(t,x)^2-n-1, S0)) fi
%p A093482   od;
%p A093482   FAIL
%p A093482 end proc;
%p A093482 f(1):= 0:
%p A093482 map(f, [$1..100]); # _Robert Israel_, Sep 18 2026
