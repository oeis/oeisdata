%N A390471 a(n) = Sum_{k=0..n} binomial(n+3*k+2,k).
%H A390471 Vincenzo Librandi, <a href="/A390471/b390471.txt">Table of n, a(n) for n = 0..800</a>
%H A390471 Robert Israel, <a href="/A390471/a390471.txt">Recurrence of order 11</a>
%F A390471 G.f.: g^2/((1-4*x*g^3) * (1-x*g)) where g = 1+x*g^4 is the g.f. of A002293.
%F A390471 D-finite with recurrence of order 11 (see link). - _Robert Israel_, Oct 02 2026
%F A390471 From _Vaclav Kotesovec_, Oct 02 2026: (Start)
%F A390471 a(n) ~ 2^(8*n + 21/2) / (55 * sqrt(Pi*n) * 3^(3*n + 5/2)).
%F A390471 Recurrence (of order 4): 3*n*(3*n + 1)*(3*n + 2)*(302005*n^7 - 3162228*n^6 + 13688322*n^5 - 31620200*n^4 + 41882285*n^3 - 31605892*n^2 + 12486348*n - 1977840)*a(n) = 8*(2*n - 5)*(4*n - 9)*(4*n - 7)*(302005*n^7 - 1048193*n^6 + 1057059*n^5 - 41835*n^4 - 389680*n^3 + 111668*n^2 + 22896*n - 7200)*a(n-1) + 3*n*(3*n + 1)*(3*n + 2)*(302005*n^7 - 3162228*n^6 + 13688322*n^5 - 31620200*n^4 + 41882285*n^3 - 31605892*n^2 + 12486348*n - 1977840)*a(n-2) - (85467415*n^10 - 848099749*n^9 + 3378370664*n^8 - 6773795234*n^7 + 6742094459*n^6 - 2048300021*n^5 - 1729842194*n^4 + 1434577244*n^3 - 166213224*n^2 - 95254560*n + 18144000)*a(n-3) + 8*(2*n - 5)*(4*n - 9)*(4*n - 7)*(302005*n^7 - 1048193*n^6 + 1057059*n^5 - 41835*n^4 - 389680*n^3 + 111668*n^2 + 22896*n - 7200)*a(n-4). (End)
%p A390471 with(gfun):
%p A390471 e1:= 1+x*g^4-g:
%p A390471 e2:= y*(1-4*x*g^3)*(1-x*g)-g^2:
%p A390471 eq:= resultant(e1,e2,g):
%p A390471 de:= algeqtodiffeq(eq,y(x)):
%p A390471 rec:= diffeqtorec(de, y(x), a(n)):
%p A390471 f:= rectoproc(rec, a(n), remember):
%p A390471 map(f [$0..30]); # _Robert Israel_, Oct 02 2026
%t A390471 Table[Sum[Binomial[n+3*k+2,k],{k,0,n}],{n,0,20}] (* _Vincenzo Librandi_, Nov 07 2025 *)
%o A390471 (PARI) a(n) = sum(k=0, n, binomial(n+3*k+2, k));
