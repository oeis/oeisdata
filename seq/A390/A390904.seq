%I A390904 #16 Aug 10 2026 00:50:35
%S A390904 0,0,0,2107,46144,432250,2548160,11135495,39398912,119084364,
%T A390904 318528000,772705395,1730491840,3625678342,7179774784,13546271375,
%U A390904 24507822080,42739759160,72155446272,118351228779,189171144000,295414111090,451709030080,677586082327
%N A390904 a(n) is the number of 3 X 3 matrices with elements 1..n where at least one row is strictly increasing.
%H A390904 <a href="/index/Rec#order_10">Index entries for linear recurrences with constant coefficients</a>, signature (10,-45,120,-210,252,-210,120,-45,10,-1).
%F A390904 a(n) = n^9 - (n^3 * (1 + n)^3 * (5*n - 2)^3)/216.
%F A390904 a(n) = n^9 - (n^3 - binomial(n,3))^3.
%F A390904 G.f.: x^3*(2107 + 25074*x + 65625*x^2 + 49300*x^3 + 10335*x^4 + 438*x^5 + x^6)/(1 - x)^10. - _Stefano Spezia_, Nov 23 2025
%F A390904 From _Elmo R. Oliveira_, Aug 09 2026: (Start)
%F A390904 E.g.f.: x^3*(75852 + 339444*x + 400680*x^2 + 181404*x^3 + 35757*x^4 + 3051*x^5 + 91*x^6)*exp(x)/216.
%F A390904 a(n) = 10*a(n-1) - 45*a(n-2) + 120*a(n-3) - 210*a(n-4) + 252*a(n-5) - 210*a(n-6) + 120*a(n-7) - 45*a(n-8) + 10*a(n-9) - a(n-10). (End)
%t A390904 a[n_, d_] := a[n, d] = AnyTrue[#, OrderedQ[#, Less] &] & /@ Tuples[Range[1, n], {d, d}] // Boole // Total;
%t A390904 Table[a[n, 3], {n, 0, 7}]
%Y A390904 Cf. A206808 (2 X 2 matrices).
%K A390904 nonn,easy
%O A390904 0,4
%A A390904 _Robert P. P. McKone_, Nov 23 2025
