%N A390297 Numbers k such that sigma(k) = psi(k) + tau(k)^3.
%C A390297 Includes p * q * r^2 where p, q, r are distinct primes such that (p+1)*(q+1) = 1728.  Possible {p,q} pairs are {3, 431}, {23, 71}, {31, 53}. - _Robert Israel_, Nov 11 2025
%H A390297 Robert Israel, <a href="/A390297/b390297.txt">Table of n, a(n) for n = 1..1000</a>
%F A390297 Union of { 3429, 24003, 35500, 55008, 77571, 130683, 176364, 177444, 248500, 258500, 263500, 271524, 385056, 402336, 419616, 428922, 524745, 542997, 1134540, 1165860, 1188540, 1234548, 1242108, 1284228, 1309068, 1621500, 1809500, 1836780, 1844500, 1900668, 2816352, 2937312, 3002454, 3111966, 3673215, 6145149, 7941780, 8161020, 8319780, 8654580, 8989596, 9163476, 11350500, 11764500, 12857460, 21783762, 43016043, 60582060, 82351500 } and infinite series { m*p^2 | p is prime not dividing m } for m in { 1293, 1633, 1643, 6906, 8426, 8786, 9051, 9741, 9951, 10011, 10505, 10795, 11005, 11431, 11501, 11891, 12121, 48342, 52854, 53862, 54102, 58982, 59210, 59690, 61502, 63195, 64262, 65895, 67022, 68187, 69657, 70077, 71247, 72633, 73535, 74307, 75565, 77035, 80135, 83237, 84847, 356190, 369978, 377034, 378714, 390786, 393954, 401574, 414470, 417830, 433070, 442365, 449834, 461265, 469154, 481965, 498729, 502665, 508431, 520149, 560945, 2493330, 2716530, 2735502, 2757678, 2811018, 3031490, 3373755, 3518655, 19015710 }. - _Max Alekseyev_, Oct 11 2026
%e A390297 3429 is in the sequence since sigma(3429) = 5120 = 4608 + 8^3 = psi(3429) + tau(3429)^3.
%p A390297 filter:= proc(n) local F, sigma, psi, tau, t;
%p A390297  F:= ifactors(n)[2];
%p A390297  sigma:= mul((t[1]^(1+t[2])-1)/(t[1]-1), t=F);
%p A390297  psi:= n * mul(1+1/t[1], t=F);
%p A390297  tau:= mul(1+t[2], t=F);
%p A390297  sigma = psi + tau^3
%p A390297 end proc:
%p A390297 select(filter, [$1..2*10^5]);
%t A390297 psi[n_] := n * Times @@ (1 + 1/FactorInteger[n][[;; , 1]]); psi[1] = 1; Select[Range[200000], DivisorSigma[1, #] == psi[#] + DivisorSigma[0, #]^3 &] (* _Amiram Eldar_, Oct 31 2025 *)
%Y A390297 Cf. A000005 (tau), A000203 (sigma), A001615 (psi), A387953, A387999, A389478, A390252, A390296.
