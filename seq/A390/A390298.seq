%T A390298 1891545955,15945663152,135575825122,1161265584549,10011115240466,
%U A390298 86796094401682,756321790481689,6620155558163442,58181764203020977,513207862840300696,4541940432627503029
%N A390298 Expansion of g/(1 - x^3*g), where g = 1+x*g^4 is the g.f. of A002293.
%H A390298 Vincenzo Librandi, <a href="/A390298/b390298.txt">Table of n, a(n) for n = 0..1000</a>
%H A390298 Robert Israel, <a href="/A390298/a390298.txt">Recurrence of order 28</a>
%F A390298 a(n) = Sum_{k=0..floor(n/3)} (k+1) * binomial(4*n-11*k+1,n-3*k)/(4*n-11*k+1).
%F A390298 D-finite with a recurrence of order 28 (see link). - _Robert Israel_, Oct 28 2026
%p A390298 with(gfun):
%p A390298 e1:= y*(1-x^3*g)-g:
%p A390298 e2:= -g+1+x*g^4:
%p A390298 eq:= resultant(e1,e2,g):
%p A390298 de:= algeqtodiffeq(eq,y(x)):
%p A390298 rec:= diffeqtorec(de,y(x),a(n)):
%p A390298 f:= rectoproc(rec,a(n),remember):
%p A390298 A:=map(f, [$0..30]); # _Robert Israel_, Oct 28 2026
%t A390298 Table[Sum[ (k+1)*Binomial[4* n-11*k+1,n-3*k]/(4*n-11*k+1),{k,0,Floor[n/3]}],{n,0,26}] (* _Vincenzo Librandi_, Nov 29 2025 *)
%o A390298 (PARI) a(n) = sum(k=0, n\3, (k+1)*binomial(4*n-11*k+1, n-3*k)/(4*n-11*k+1));
%o A390298 (Magma) [&+[(k+1)*Binomial(4*n-11*k+1, n-3*k)/(4*n-11*k+1): k in [0..Floor(n/3)]] : n in [0..40] ]; // _Vincenzo Librandi_, Nov 29 2025
%Y A390298 Cf. A002293, A389653, A391103.
%K A390298 nonn,changed
%O A390298 0,3
%A A390298 _Seiichi Manyama_, Nov 28 2025
