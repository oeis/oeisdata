%U A390030 103,1,5,8,233,3,21,1,19,3,21,1,248,1,5,8,19,3,21,1,210,8,5,1,103,3,5,3,65,1,70,3
%N A390030 Number of perfect overpartitions of n.
%C A390030 A perfect overpartition of n is one that contains exactly one overpartition of every positive integer less than n.
%F A390030 a(n) = Sum_{r=0..s} Sum_{v=r..s} binomial(v,r)*f_v(n+1), where s = A007814(n+1) and f_v(N) is the number of ordered factorizations of N having v copies of 2; that is, f_v(N) is the number of objects counted by A074206(N) that contain v copies of 2.
%F A390030 Dirichlet g.f.: Sum_{n>=1} a(n-1)/n^s = 1/(2-zeta(s)-2^(-s)). - _Vladeta Jovovic_, Nov 08 2026
%F A390030 Sum_{k=1..n} a(k) ~ n^r / (r*(log(2)/2^r - zeta'(r))), where r = 1.913219891493156446833747524723573054601441630868380549586772449777817109901862... is the root of the equation zeta(r) + 2^(-r) = 2. - _Vaclav Kotesovec_, Nov 09 2026
%e A390030 n=0: 1  (the empty partition)
%e A390030 n=1: 2  (1), (1')
%e A390030 n=2: 1  (1,1)
%e A390030 n=3: 5  (1,1,1), (2,1), (2',1), (2,1'), (2',1')
%e A390030 n=4: 1  (1,1,1,1)
%e A390030 n=5: 5  (1,1,1,1,1), (2,2,1), (2,2,1'), (3,1,1), (3',1,1)
%e A390030 n=6: 1  (1,1,1,1,1,1)
%e A390030 n=7: 13  (1,1,1,1,1,1,1), (2,2,2,1), (2,2,2,1'), (4,1,1,1), (4',1,1,1), (2,4,1), (2',4,1), (2,4',1), (2,4,1'), (2',4',1), (2',4,1'), (2,4',1'), (2',4',1')
%Y A390030 Cf. A015128, A002033, A330773, A074206.
