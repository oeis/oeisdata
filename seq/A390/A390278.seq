%S A390278 2,3,4,5,7,8,9,11,12,13,16,17,18,19,20,23,24,25,27,28,29,30,31,32,36,
%T A390278 37,40,41,42,43,44,45,47,48,49,50,52,53,54,56,59,60,61,63,64,66,67,68,
%U A390278 70,71,72,73,75,76,78,79,80,81,83,84,88,89,90,92,96,97,98,99,100
%N A390278 All positive numbers except those that are the product of an even number of distinct primes (including 1).
%C A390278 Numbers that either contain a repeated prime factor, or else are built from an odd number of distinct primes. Compare A174891.
%C A390278 From _Amiram Eldar_, Sep 17 2026: (Start)
%C A390278 Disjoint union of A013929 and A030059.
%C A390278 Complement of A030229.
%C A390278 The asymptotic density of this sequence is 1 - 3/Pi^2. (End)
%H A390278 Amiram Eldar, <a href="/A390278/b390278.txt">Table of n, a(n) for n = 1..10000</a>
%F A390278 k is term <=> Moebius(k) <= 0.
%e A390278 Since 210 = 2*3*5*7 is the product of an even number of distinct primes it is not in this sequence but is a term of A246716.
%p A390278 select(n -> numtheory:-mobius(n) <= 0, [seq(1..100)]);
%t A390278 Select[Range[100], MoebiusMu[#] <= 0 &] (* _Amiram Eldar_, Nov 03 2025 *)
%o A390278 (PARI) isok(k) = moebius(k) <= 0; \\ _Amiram Eldar_, Sep 17 2026
%Y A390278 Cf. A008683, A030229, A030059 (subsequence), A013929 (subsequence), A000040 (subsequence), A332785 (subsequence), A246716, A174891, A353629.
