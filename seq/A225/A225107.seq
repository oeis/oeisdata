%S A225107 3,24,228,2256,22512,225024,2250048,22500096,225000192,2250000384,
%T A225107 22500000768,225000001536,2250000003072,22500000006144,
%U A225107 225000000012288,2250000000024576,22500000000049152,225000000000098304,2250000000000196608,22500000000000393216
%N A225107 Number of (4*n-3)-digit 4th powers in carryless arithmetic mod 10.
%D A225107 J. Y. Lee and J.-L. Kim, Powers, Pythagorean triples, and Fermat's Last Theorem in carryless arithmetic mod 10, preprint, April, 18, 2013.
%H A225107 Paolo Xausa, <a href="/A225107/b225107.txt">Table of n, a(n) for n = 1..1000</a>
%H A225107 Jon-Lark Kim, <a href="http://maths.sogang.ac.kr/jlkim/preprints.html"> Preprints</a>
%H A225107 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (12,-20).
%F A225107 a(n) = (1/4)*(9* 10^(n-1) - 2^(n-1)) + 2^(n-1).
%F A225107 a(n) = 12*a(n-1)-20*a(n-2). G.f.: -3*x*(4*x-1) / ((2*x-1)*(10*x-1)). - _Colin Barker_, May 11 2013
%e A225107 For k=1, there are three one-digit 4th powers: 1^4=9^4=3^4=7^4=1, 2^4=8^4=4^4=6^4=6, 5^4=5.
%t A225107 A225107[n_] := 3*2^(n - 3)*(3*5^n + 5)/5; Array[A225107, 25] (* _Paolo Xausa_, Aug 11 2026 *)
%t A225107 (* Alternative: *)
%t A225107 LinearRecurrence[{12, -20}, {3, 24}, 25] (* _Paolo Xausa_, Aug 11 2026 *)
