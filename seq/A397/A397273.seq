%I A397273 #37 Nov 05 2026 22:59:28
%S A397273 1,2,3,4,5,7,9,11,13,17,19,23,25,27,29,31,35,37,41,43,47,49,53,55,59,
%T A397273 61,67,71,77,79,81,83,89,95,97,101,103,107,109,113,115,119,121,125,
%U A397273 127,131,137,139,149,151,155,157,161,163,167,169,173,175,179,181,187,191,193,197,199,203,209,211
%N A397273 Numbers k such that for every m there is at least one nonnegative integer solution to 2^i - 3^j == m (mod k).
%C A397273 The only even terms are 2 and 4.
%C A397273 Contains all powers of 3, but no other terms divisible by 3.
%C A397273 The least number coprime to 6 that is not a term is 65.
%C A397273 The least prime that is not a term is 73.
%H A397273 Robert Israel, <a href="/A397273/b397273.txt">Table of n, a(n) for n = 1..2000</a>
%e A397273 a(4) = 4 is a term because 2^0 - 3^0 == 0, 2^1 - 3^0 == 1, 2^0 - 3^1 == 2 and 2^2 - 3^0 == 3 (mod 4).
%p A397273 f:= proc(n) local m2,m3,n2,n3,i,j;
%p A397273   m2:= padic:-ordp(n,2); n2:= n/2^m2;
%p A397273   if n2 > 1 then m2:= m2 + NumberTheory:-MultiplicativeOrder(2,n2) fi;
%p A397273   m3:= padic:-ordp(n,3); n3:= n/3^m3;
%p A397273   if n3 > 1 then m3:= m3 + NumberTheory:-MultiplicativeOrder(3,n3) fi;
%p A397273   {$0..n-1} minus {seq(seq(2^i-3^j mod n,i=0..m2),j=0..m3)}
%p A397273 end proc:
%p A397273 select(n -> f(n) = {}, [$1..300]);
%K A397273 nonn,new
%O A397273 1,2
%A A397273 _Robert Israel_, Nov 01 2026
