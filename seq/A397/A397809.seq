%T A397809 27,27,27,30,16,32,32,32,32,36,32,38,32,40,40,32,43,43,43,46,16,48,48,
%U A397809 48,48,48,48,54,48,56,56,48,59,59,59,62,48,64,64,64,64
%N A397809 a(n) is the least building visible from A399633(n) with a(1) = 0.
%C A397809 We can arrange the buildings of A399633 alongside an infinite tree with root 0, and a(n) corresponds to the parent of n > 0.
%C A397809 The orbit of n till 1 gives the indices of the edges of the convex hull of the first n terms of A399633.
%C A397809 This sequence diverges.
%H A397809 Rémy Sigrist, <a href="/A397809/b397809.txt">Table of n, a(n) for n = 1..10000</a>
%H A397809 Rémy Sigrist, <a href="/A397809/a397809.txt">C# program</a>
%F A397809 a(n) = A400134(n, 1) for n > 1.
