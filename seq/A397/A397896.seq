%I A397896 #19 Aug 04 2026 10:18:43
%S A397896 0,1,2,2,1,3,6,4,8,1,10,6,12,7,3,8,16,9,18,2,20,11,22,11,3,13,26,12,
%T A397896 28,3,30,13,32,17,7,14,36,19,38,3,40,21,42,16,9,23,46,17,48,2,50,18,
%U A397896 52,27,11,19,56,29,58,4,60,31,62,21,13,33,66,22
%N A397896 For each positive integer n, let a(n) be the minimum number of nonnegative integers (suffixes) needed so that, for every positive integer m, at least one of those suffixes can be appended to the decimal representation of m to produce a multiple of n. We must prioritize the smallest suffixes when possible.
%C A397896 We can only add one trailing zero.
%F A397896 a(n) = n-1 for all numbers except multiples of 2 and/or 5.
%F A397896 In general, in any base b, a(n) = n-1 except for the multiples of the prime factors of b.
%e A397896 When n=8, we need 4 suffixes: 6,4,2,0:
%e A397896   1 -> 16
%e A397896   2 -> 24
%e A397896   3 -> 32
%e A397896   4 -> 40
%e A397896 We cannot add 104 at the end for all numbers because there are shorter suffixes.
%o A397896 (PARI) a(n) = if (n==1, return(0)); my(k=1, ok=0, v = vector(n-1, i, -1) ); while (!ok, my(m=lift(Mod(k, n))); if (m==0, m=n); if (v[m] == -1, my(f=0); while (eval(concat(Str(k), Str(f))) % n, f++); v[m] = f; if (#select(x->(x==-1), v) == 0, ok = 1);); k++;); #vecsort(v,,8); \\ _Michel Marcus_, Jul 14 2026
%K A397896 nonn,base,new
%O A397896 1,3
%A A397896 _Ali Sada_, Jul 14 2026
%E A397896 a(50) corrected by _Sean A. Irvine_, Aug 03 2026
