%S A397969 0,0,3,107,1271,7865,33451,111723,314835,781977,1761163,3668051,
%T A397969 7165463,13268417,23479011,39956995,65731011,104957393,163232115,
%U A397969 247963867,368814423,538215401,771968123,1089936827,1516842451,2083168425,2826186171,3791112963,5032410295
%N A397969 Number of inequivalent ways to choose 4 squares on an n X n board with no chosen square orthogonally adjacent to another, with equivalence being up to rotations.
%C A397969 Equivalently, a(n) is the number of distinct ways to place 4 nonattacking wazirs on an n X n board, considered up to rotations. A wazir is a (fairy chess) leaper [0,1].
%H A397969 Paolo Xausa, <a href="/A397969/b397969.txt">Table of n, a(n) for n = 1..10000</a>
%H A397969 Janaka Rodrigo, <a href="/A397969/a397969.txt">Python code</a>
%H A397969 Wikipedia, <a href="https://en.wikipedia.org/wiki/Wazir_(chess)">Wazir (chess)</a>.
%H A397969 <a href="/index/Rec#order_12">Index entries for linear recurrences with constant coefficients</a>, signature (6,-12,2,27,-36,0,36,-27,-2,12,-6,1).
%F A397969 a(n) = (n^8-30*n^6+24*n^5+326*n^4-504*n^3-1134*n^2+2784*n-1179)/96, for odd n > 2.
%F A397969 a(n) = (n^8-30*n^6+24*n^5+326*n^4-504*n^3-1128*n^2+2784*n-1248)/96, for even n > 3.
%e A397969 a(3) = 3 since there are three distinct configurations:
%e A397969  X - -   X - X   - X -
%e A397969  - X -   - - -   X - X
%e A397969  X - X   X - X   - X -
%e A397969 Therefore a(3) = 3.
%t A397969 A397969[n_] := If[n < 3, 0, (n^2*(n*(n*(n*(n^3 - 30*n + 24) + 326) - 504) - 1128) - If[OddQ[n], 6*n^2 - 69, 0])/96 + 29*n - 13];
%t A397969 Array[A397969, 30] (* _Paolo Xausa_, Jul 27 2026 *)
%o A397969 (PARI) a(n) = if(n<3, 0, (n^8 - 30*n^6 + 24*n^5 + 326*n^4 - 504*n^3 - 1128*n^2 + 2784*n - 1248 - if(n%2, 6*n^2 - 69))/96) \\ _Andrew Howroyd_, Jul 22 2026
%Y A397969 Cf. A397970, A172227 (rotations counted separately), A239576 (up to rotations and reflections), A277226 (unrestricted placement).
%K A397969 nonn,easy,new
%O A397969 1,3
%A A397969 _Janaka Rodrigo_, Jul 16 2026
