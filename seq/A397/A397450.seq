%S A397450 0,1,1,1,2,2,2,3,3,4,4,4,5,5,5,5,6,7,7,8,8,8,8,8,9,10,10,10,11,11,11,
%T A397450 12,12,13,13,13,14,14,14,15,16,16,16,16,17,17,17,17,17,18,18,19,20,20,
%U A397450 20,20,20,21,21,21,22,22,22,22,23,23,23,24,24,24,24,25,26,27
%N A397450 a(n) is the number of positive integers <= n that are the sum of 2 nonzero squares.
%H A397450 Daniel Suteu, <a href="/A397450/b397450.txt">Table of n, a(n) for n = 1..10000</a>
%H A397450 D. Shanks, <a href="https://doi.org/10.1090/S0025-5718-1964-0159174-9">The second-order term in the asymptotic expansion of B(x)</a>, Mathematics of Computation 18 (1964), pp. 75-86.
%H A397450 Daniel Suteu, <a href="/A397450/a397450.cpp.txt">C++ program (sublinear-time algorithm)</a>.
%H A397450 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Landau-RamanujanConstant.html">Landau-Ramanujan Constant</a>.
%F A397450 a(A000404(n)) = n.
%F A397450 a(n) = A102548(n) - A398671(floor(sqrt(n))).
%F A397450 a(n) = 1/sqrt(log n) * (n*(K + B2/log n) - A*sqrt(2*n)*(1 + 2*C/log n)) + O(n / (log n)^(5/2)), where K = A064533, B2 = A227158, A = A244659 and C = A244662.
%o A397450 (PARI) a(n) = sum(k=1, n, sumdiv(k, d, kronecker(-4, d)) > issquare(k));
%Y A397450 Cf. A000404, A004144, A025426, A102548, A398087, A398671.
%Y A397450 Cf. A064533, A227158, A244659, A244662.
%K A397450 nonn,changed
%O A397450 1,5
%A A397450 _Daniel Suteu_, Aug 06 2026
