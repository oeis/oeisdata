%S A397878 1,2,3,12,7,8,11,19,13,27,18,31,39,22,24,44,26,51,59,48,25,64,35,62,
%T A397878 41,69,41,141,53,46,87,72,98,75,59,84,108,113,69,196,83,91,121,75,51,
%U A397878 132,67,105,131,140,67,113,132,163,148,117,69,269,110,153,208,93,211,262
%N A397878 Number of integers of the form r^k (0 < r < n, k > 0) whose base-n alternating digital root is r and whose number of base-n digits is k.
%C A397878 An integer m has alternating digital root r in base n if r is the unique integer in {0,1,...,n} such that m = r (mod n+1).
%C A397878 If m = (d_k d_{k-1} ... d_1 d_0) in base n, then the alternating digital root of m is the unique integer r in {0,1,...,n} such that r = Sum_{i=0..k} (-1)^i * d_i (mod n+1).
%C A397878 In base n, this sequence counts integers of the form r^k, where 0 < r < n and k > 0, such that the alternating digital root of r^k is r, and the base-n representation of r^k has exactly k digits.
%C A397878 Both the trivial one-digit solutions (k = 1) and the nontrivial solutions (k > 1) are counted.
%C A397878 For example, in base 9, 25 = 5^2 is counted because 25 = 5 (mod 10), and 25 has exactly two digits in base 9.
%e A397878 a(2)=1. The only number of such form is 1.
%e A397878 a(3)=2. The only numbers are 1 and 2.
%e A397878 a(5)=12. The trivial solutions are 1, 2, 3, 4. The nontrivial solutions are 9, 16, 27, 64, 256, 1024, 4096, 16384.
%e A397878 a(10)=13. The trivial solutions are 1, ..., 9. The nontrivial solutions are 9^6, 9^11, 9^16, 9^21.
%o A397878 (Python)
%o A397878 def a(b):
%o A397878     c = 0
%o A397878     for r in range(1, b):
%o A397878         k = 1
%o A397878         while True:
%o A397878             n = r**k
%o A397878             temp, l = n, 0
%o A397878             while temp > 0:
%o A397878                 temp //= b
%o A397878                 l += 1
%o A397878             if l < k:
%o A397878                 break
%o A397878             if n % (b + 1) == r:
%o A397878                 c += 1
%o A397878             k += 1
%o A397878     return c
%o A397878 print([a(b) for b in range(2, 66)])
%Y A397878 Cf. A394570, A396781, A010880.
