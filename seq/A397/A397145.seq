%I A397145 #27 Aug 19 2026 07:26:53
%S A397145 1,1,1,1,2,3,1,4,8,11,0,1,12,18,63,8,18,0,1,36,39,285,104,198,0,57,0,
%T A397145 0,1,144,81,1104,950,1536,0,1104,0,39,81,0,0,1,576,166,3954,6356,
%U A397145 10561,0,14166,0,1599,2694,0,0,247,0,0,0,1,2880,336,13348,37382,68853,1298,136736,0,37382,49554,1260,0,13348,0,0,166,336,0,0,0,1
%N A397145 Number T(n,k) of permutations p of [n] where k is the product of the number of odd weak excedances and the number of even weak excedances of p; triangle T(n,k), n>=0, 0 <= k <= floor(n^2/4), read by rows.
%C A397145 The weak excedance set of a permutation p of [n] is the set of indices i such that p(i) >= i.
%H A397145 Alois P. Heinz, <a href="/A397145/b397145.txt">Rows n = 0..20, flattened</a>
%H A397145 Wikipedia, <a href="https://en.wikipedia.org/wiki/Permutation">Permutation</a>
%F A397145 T(n,floor(n^2/4)) = 1.
%F A397145 Sum_{k=0..floor(n^2/4)} k * T(n,k) = A395245(n).
%e A397145 T(n,0) = 4: 2143, 3142, 4123, 4132.
%e A397145 T(n,1) = 8: 1423, 2413, 3124, 3412, 3421, 4213, 4312, 4321.
%e A397145 T(n,2) = 11: 1243, 1324, 1342, 1432, 2134, 2314, 2341, 2431, 3214, 3241, 4231.
%e A397145 T(n,4) = 1: 1234.
%e A397145 Triangle T(n,k) begins:
%e A397145     1;
%e A397145     1;
%e A397145     1,  1;
%e A397145     2,  3,    1;
%e A397145     4,  8,   11,   0,    1;
%e A397145    12, 18,   63,   8,   18, 0,    1;
%e A397145    36, 39,  285, 104,  198, 0,   57, 0,  0,  1;
%e A397145   144, 81, 1104, 950, 1536, 0, 1104, 0, 39, 81, 0, 0, 1;
%e A397145   ...
%p A397145 b:= proc(s, i, k) option remember; (n-> `if`(n=0, x^(i*k), add(
%p A397145       b(s minus {j}, `if`(irem(n, 2)=1 or j<n, 0, 1)+i,
%p A397145      `if`(irem(n, 2)=0 or j<n, 0, 1)+k), j=s)))(nops(s))
%p A397145     end:
%p A397145 T:= (n, k)-> coeff(b({$1..n}, 0$2), x, k):
%p A397145 seq(seq(T(n,k), k=0..(n^2)/4), n=0..10);
%Y A397145 Columns k=0-1 give: A010551, A178420.
%Y A397145 Row sums give A000142.
%Y A397145 Cf. A002620, A123125, A360288, A360289, A395245.
%K A397145 nonn,tabf
%O A397145 0,5
%A A397145 _Alois P. Heinz_, Jul 15 2026
