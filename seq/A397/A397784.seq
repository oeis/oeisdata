%S A397784 2,3,5,7,19,23,29,41,43,47,53,59,61,67,83,89,179,313,373,379,419,431,
%T A397784 479,613,617,619,673,797,1319,1979,2311,2371,2971,3119,3719,4373,6113,
%U A397784 6131,6173,6197,6719,6737,8311,8317,8971,9719,11719,23117,23173,23197,23719,29717,31379,31973,37313
%N A397784 Primes such that every 2 digit substring is a distinct prime, but the concatenation of the last digit with the first digit is composite.
%C A397784 If the digits are arranged clockwise in a circle then each pair of digits when read clockwise except one will be prime.
%C A397784 Terms greater than 100 are a subsequence of A069488 and also A398710.
%C A397784 In total there are 791 such primes (787 if the first 4 terms are excluded). The largest term is 619737131179.
%C A397784 There are only 10 primes whose first digit also ends a two digit prime: {11,13,17,19,31,37,71,73,79,97}. This limits the size of numbers to at most 12 digits.
%H A397784 Michael S. Branicky, <a href="/A397784/b397784.txt">Table of n, a(n) for n = 1..791</a>
%e A397784 19 is a term since 19 is prime, the wrap-around 91 = 7*13 is composite.
%e A397784 673 is a term since 673, 67, 73 are prime and the wrap-around 36 is composite.
%e A397784 31137173 is a term since 31137173, 31, 11, 13, 37, 71, 17, 73 are distinct primes and the wrap-around 33 is composite.
%t A397784 q[p_]:=AllTrue[FromDigits/@Partition[IntegerDigits[p],2,1],PrimeQ]&&DuplicateFreeQ[FromDigits/@Partition[IntegerDigits[p],2,1]]&&!PrimeQ[FromDigits[Join[Take[IntegerDigits[p],-1],Take[IntegerDigits[p],1]]]];Select[Prime[Range[4000]],q] (* _James C. McMahon_, Aug 08 2026 *)
%o A397784 (Python)
%o A397784 from sympy import isprime, primerange
%o A397784 def afull(): # returns the full sequence
%o A397784     primes = [str(p) for p in primerange(11, 100)]
%o A397784     neighs = {p:set(q for q in primes if q[0] == p[1]) for p in primes}
%o A397784     expand, reach = [(p,) for p in primes], {"2", "3", "5", "7"}
%o A397784     while expand:
%o A397784         t = expand.pop()
%o A397784         used = set(t)
%o A397784         if not isprime(int(t[-1][1]+t[0][0])):
%o A397784             reach.add(t)
%o A397784         for q in neighs[t[-1]]:
%o A397784             if q not in used:
%o A397784                 expand.append(t+(q,))
%o A397784     return sorted(t for q in reach if isprime(t:=int("".join(q[i][0] for i in range(len(q)-1))+q[-1])))
%o A397784 print(afull()[:55]) # _Michael S. Branicky_, Aug 07 2026
