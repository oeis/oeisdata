%I A397739 #49 Aug 17 2026 08:50:38
%S A397739 6,15,21,30,35,42,55,65,66,77,78,85,91,95,102,105,114,115,119,133,138,
%T A397739 143,161,165,174,186,187,195,203,209,210,217,221,222,231,246,247,253,
%U A397739 255,258,259,273,282,285,287,299,301,318,319,323,329,330,341,345,354,357
%N A397739 Squarefree composite numbers k whose second smallest distinct prime factor is smaller than the square of the least prime factor.
%C A397739 Superset of A138109.
%C A397739 Superset of A002110 \ {1,2}.
%C A397739 Proper subset of A120944, squarefree composite numbers.
%H A397739 Michael De Vlieger, <a href="/A397739/b397739.txt">Table of n, a(n) for n = 1..10000</a>
%e A397739 Let lpf = least prime factor and slpf = second least distinct prime factor.
%e A397739 a(1) = 6 since 6 is the smallest squarefree composite number, with slpf(6) < lpf(6)^2, that is, 3 < 4.
%e A397739 The number 10 is not a term since slpf(10) > lpf(10)^2, that is, 5 > 4. The same is true for 14.
%e A397739 a(2) = 15; slpf(15) < lpf(15)^2, that is, 5 < 9.
%e A397739 a(3) = 21; slpf(21) < lpf(21)^2, that is, 7 < 9.
%e A397739 Numbers 22 and 26 both are such that slpf(k) > lpf(k)^2, and are are not in the sequence.
%e A397739 a(4) = 30; slpf(30) < lpf(30)^2, that is, 3 < 4, etc.
%t A397739 s = Select[Range[360], And[SquarefreeQ[#], CompositeQ[#]] &]; Select[s, Log[#1, #2] < 2 & @@ FactorInteger[#][[1 ;; 2, 1]] &]
%Y A397739 Cf. A002110, A020639, A119288, A120944, A138109.
%K A397739 nonn,easy,new
%O A397739 1,1
%A A397739 _Michael De Vlieger_, Aug 13 2026
