%I A397584 #73 Aug 15 2026 21:27:43
%S A397584 11,43,1153,333517
%N A397584 Primes p such that p^2 divides A001008(k), the numerator of the k-th harmonic number H(k), for some k < p-1.
%C A397584 Here H(n) = Sum_{i=1..n} 1/i and its numerator is A001008(n).
%C A397584 The first corresponding values of k are 7, 29, 297 and 292807, resp.
%C A397584 No additional terms were found for 333517 < p < 2000000.
%H A397584 David Nalbandyan, <a href="/A397584/a397584.cc.txt">C++ program</a>
%e A397584 For p = 11, A001008(7) == 0 (mod 11^2).
%e A397584 For p = 43, A001008(29) == 0 (mod 43^2).
%o A397584 (C++) // see Links
%o A397584 (PARI) isok(p) = if (isprime(p), my(s=1); for (k=2, p-2, if (!(s % p^2), return(1)); s+=1/k)); \\ _Michel Marcus_, Aug 02 2026
%o A397584 (PARI) chk() = my(v = readvec("c:/gp/bfiles/b001008.txt")); for (i=1, #v, if (! issquarefree(v[i]), my(f=factor(v[i])); for (k=1, #f~, if ((f[k,2] >= 2) && (f[k,1] != i+1), print(i, f))););); \\ _Michel Marcus_, Aug 02 2026; another program for exploration
%o A397584 (Python)
%o A397584 from sympy import harmonic, isprime
%o A397584 def ok(p): return isprime(p) and any(harmonic(i).numerator%(p*p) == 0 for i in range(1, p-1))
%o A397584 print([k for k in range(1200) if ok(k)]) # _Michael S. Branicky_, Aug 02 2026
%o A397584 (Python)
%o A397584 from gmpy2 import mpq, next_prime
%o A397584 from itertools import islice
%o A397584 def agen(): # generator of terms
%o A397584     k, p, pp, hnums, H = 1, 2, 4, [1], mpq(1, 1)
%o A397584     while True:
%o A397584         for i in range(k+1, p-1):
%o A397584             H += mpq(1, i)
%o A397584             hnums.append(H.numerator)
%o A397584             k += 1
%o A397584         if any(hnumi%pp == 0 for hnumi in hnums):
%o A397584             yield int(p)
%o A397584         p = next_prime(p)
%o A397584         pp = p*p
%o A397584 print(list(islice(agen(), 3))) # _Michael S. Branicky_, Aug 02 2026
%Y A397584 Subsequence of A092194 (divisible by p rather than p^2).
%Y A397584 Cf. A001008/A002805, A322434.
