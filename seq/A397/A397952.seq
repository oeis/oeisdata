%I A397952 #14 Aug 26 2026 11:59:31
%S A397952 0,1,1,2,5,15,47,158,545,1940,7030,25917,96755,365274,1391629,5344385,
%T A397952 20665633,80394281,314422685,1235563322,4875984643,19316320501,
%U A397952 76788144951,306222020733,1224709419623,4911122651176,19741878441040,79538147154161
%N A397952 Number of rooted binary unlabeled simplex time-consistent galled trees with n leaves.
%C A397952 The asymptotic growth of a(n) follows ((0.3846...)*(0.2344...)^(-n))/(2*sqrt(Pi)*n^(3/2)) (p. 31 of Agranat-Tamir et al. 2026).
%C A397952 From _Vaclav Kotesovec_, Aug 26 2026: (Start)
%C A397952 More precise values of the constants listed above are:
%C A397952 0.3835758866628284468560222845325491150486107713399504...
%C A397952 0.2344476055962375639828933429491722745312794637842460... (End)
%H A397952 Vaclav Kotesovec, <a href="/A397952/b397952.txt">Table of n, a(n) for n = 0..1000</a>
%H A397952 Lily Agranat-Tamir, Michael Fuchs, Bernhard Gittenberger, Noah A. Rosenberg, and Karthik V. Seetharaman, <a href="https://doi.org/10.1016/j.aam.2026.103131">Combinatorial comparison of general galled trees, time-consistent galled trees, and simplex time-consistent galled trees</a>, Adv. Appl. Math. 180, 103131 (2026).
%F A397952 G.f. satisfies A(x) = x + (1/2)*A(x)^2 + (1/2)*A(x^2) + (x/2)*((A(x)/(1-A(x)))^2 + A(x^2)/(1-A(x^2))). See eq. 50 of Agranat-Tamir et al. (2026).
%e A397952 For n=3, there is 1 tree with no galls. There is 1 tree with a qualifying 3-node root gall. Hence, a(3)=1+1=2.
%e A397952 For n=4, there are 2 trees with no galls. There is 1 tree from whose root a leaf and a qualifying 3-node gall descend. There is 1 tree with a qualifying 4-node root gall and 1 tree with a qualifying 3-node root gall. Hence, a(4)=2+1+1+1=5.
%t A397952 terms = 28;
%t A397952 A[_] = 0; Do[
%t A397952  A[x_] = x + (1/2)*(A[x]^2 + A[x^2]) + (x/2) ((A[x]/(1 - A[x]))^2 +
%t A397952        A[x^2]/(1 - A[x^2])) + O[x]^terms //
%t A397952    Normal, terms]; CoefficientList[A[x], x]
%Y A397952 Cf. A001190 (rooted binary unlabeled trees with n leaves and 0 galls), A380211 (rooted binary unlabeled time-consistent galled trees with n leaves), A398145 (rooted binary leaf-labeled simplex time-consistent galled trees with n leaves).
%K A397952 nonn,new
%O A397952 0,4
%A A397952 _Noah A Rosenberg_, Aug 13 2026
