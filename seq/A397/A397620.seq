%S A397620 1,91,949,5419,18631,86359,134121,349867,682969,1695421,1931293,
%T A397620 5142631,5195919,12205011,17680819,22366891,25552531,62150179,
%U A397620 49515141,100961389,127280829,175747663,154460089,332023783,290639881,472828629,498120493,726801699,615310111,1608954529
%N A397620 a(n) = Sum_{d | n^3} d^3 * lambda(d) / Sum_{d | n^3} d * lambda(d), where lambda(n) denotes Liouville's function A008836(n).
%C A397620 Compare with A077454(n) = sigma_3(n^3)/sigma(n^3) = Sum_{d | n^3} d^3 / Sum_{d | n^3} d.
%C A397620 For odd m, a_m(n) := Sum_{d | n^m} d^m * lambda(d) / Sum_{d | n^m} d * lambda(d) is an integer for all n >= 1. This is the case m = 3.
%C A397620 No term of the sequence is divisible by a prime q == 2 (mod 3); use the formula for a(p^e) given below and the property that if q is a prime dividing a number of the form N^2 + N + 1, then q = 3 or q == 1 (mod 3).
%F A397620 Multiplicative with a(p^e) = (1 + (-p)^(3*e+1) + p^(6*e+2))/(1 - p + p^2).
%F A397620 Dirichlet g.f.: zeta(s)*zeta(s-6)*zeta(2*s-6)/zeta(s-3) * Product_{p prime} ( 1 + (p + p^5)/p^s - (p^5 + p^6 + p^7)/p^(2*s) ) for Re(s) > 7.
%F A397620 Sum_{k=1..n} a(k) ~ c * Pi^4 * zeta(7) * n^7 / 735, where c = Product_{p prime} (1 + 1/p^2 + 1/p^6 - 1/p^7 - 1/p^8 - 1/p^9) = 1.52324912305937678414824682318108627002262189372464923001316411759841619... - _Vaclav Kotesovec_, Sep 26 2026
%p A397620 with(numtheory):
%p A397620 seq( add( (-1)^bigomega(d)*d^3, d in divisors(n^3)) / add( (-1)^bigomega(d)*d, d in divisors(n^3)), n = 1..30);
%t A397620 Table[Sum[d^3*LiouvilleLambda[d], {d, Divisors[n^3]}] / Sum[d*LiouvilleLambda[d], {d, Divisors[n^3]}], {n, 1, 30}] (* _Vaclav Kotesovec_, Sep 26 2026 *)
%Y A397620 Cf. A000578, A008836, A077454.
