%I A397704 #42 Aug 23 2026 20:02:17
%S A397704 0,1,2,2,3,3,4,4,3,3,4,4,5,5,6,6,4,4,5,5,6,6,7,7,6,6,7,7,8,8,9,9,4,4,
%T A397704 5,5,6,6,7,7,6,6,7,7,8,8,9,9,7,7,8,8,9,9,10,10,9,9,10,10,11,11,12,12,
%U A397704 5,5,6,6,7,7,8,8,7,7,8,8,9,9,10,10,8,8,9,9
%N A397704 a(0) = 0; for n > 0, a(n) = 1 + Sum_{k} a(e_k) where n = Sum_{k} 2^(e_k) is the binary expansion of n.
%C A397704 Equivalently, a(n) counts the number of positive nodes in the binary decomposition tree of n: the root is labeled n; a node labeled x > 0 has children labeled by the elements of S(x); a node labeled 0 is a leaf, where S(x) = {e_k : x = Sum_{k = 1..w} 2^(e_k)} where w = A000120(n).
%C A397704 The sequence has a fractal block structure: the block [2^n, 2^(n+1)-1] is obtained from the first 2^n terms by shifting up by a(n), with a(0) = 0 replaced by 1.
%C A397704 This sequence is the self-referential analog of A063787: both satisfy a block decomposition c(2^n + k) = w(n) + c(k) for 0 < k < 2^n, but A063787 uses the constant weight w(n) = 1, whereas this sequence uses w(n) = a(n). More generally, choosing w(n) = n gives the "sum of bit positions" sequence c(n) = 1 + Sum_{j in S(n)} j; i.e., c(n) = A029931(n) - A000120(n) + 1 for n >= 1.
%C A397704 Equivalently, a(n) is the fixed point of the operator T(f)(n) = 1 + Sum_{j in S(n)} f(j) for n > 0, T(f)(0) = 0, obtained by iterating T starting from f_0 = popcount. Let d(n) be the number of iterations needed to reach a(n), and depth(n) the maximum depth of a positive node of the tree. Then d(n) <= depth(n) for all n, with equality unless n = 3 or every child of n of maximal depth satisfies d < depth. Since a(n) = popcount(n) iff n in {1, 3}, one has d(n) = 0 iff n in {1, 3}. The first exceptions to d(n) = depth(n) are 3, 8-11, 256-271, ...; there are 245 of them below 2^18.
%C A397704 Every positive integer occurs as a value, each with finitely many preimages. Preimages can be doubly exponential: if t in a^(-1)(v-1), then 2^t and 2^t + 1 are in a^(-1)(v); in particular 2^513 is in a^(-1)(5). Also, a(n) = 1 iff n = 1.
%F A397704 a(0) = 0.
%F A397704 a(2^n + k) = a(n) + a(k) for 0 < k < 2^n, n >= 0.
%F A397704 a(2^n) = 1 + a(n) for n >= 0.
%F A397704 a(2k) = a(2k + 1) for k >= 1.
%F A397704 a(2^n - 1) = 1 + Sum_{k=0..n-1} a(k) for n >= 1.
%F A397704 Let A(x) = Sum_{n >= 1} a(n) * x^n. Then A(x) = x/(1-x) + Sum_{i >= 0} a(i) * x^(2^i) (1 - x^(2^i)) / ((1-x)(1 - x^(2^(i+1)))) = x/(1-x) + (1/(1-x)) * Sum_{i >= 0} a(i) * x^(2^i)/(1 + x^(2^i)), hence (1-x) A(x) = x + Sum_{i >= 0} a(i) * x^(2^i)/(1 + x^(2^i)).
%F A397704 Consequently, for n >= 1, a(n) - a(n-1) = [n = 1] + Sum_{i >= 0, 2^i | n} a(i) * (-1)^(n/2^i - 1).
%F A397704 For T(n) = Sum_{k=0..n-1} a(k): T(2^m) = 2^m - 1 + 2^(m-1) * T(m) for m >= 1, and T(n) = T(2^m) + 1 + (n - 2^m) * a(m) + T(n - 2^m) for 2^m < n < 2^(m+1). In particular the mean of a over [0, 2^m) is (a(2^m - 1) + 1)/2 - 2^(-m).
%F A397704 a(n) = Sum_{d >= 0} L_d(n) for n > 0, where L_d(n) is the number of positive nodes at depth d of the binary decomposition tree (L_0 = 1, L_1 = A000120(n) - [n odd]).
%F A397704 For n >= 2, max_{0 <= k <= 2^n - 1} a(k) = a(2^n - 1), attained exactly at k = 2^n - 2 and k = 2^n - 1. For n >= 1, min_{2^n <= k <= 2^(n+1)-1} a(k) = a(n) + 1, attained exactly at k = 2^n and k = 2^n + 1. Equivalently, the multiset {a(k) : 1 <= k < 2^n} is symmetric about (1 + a(2^n - 1))/2, so each block has mean (min + max)/2 = (2*a(n) + 1 + a(2^n - 1))/2.
%F A397704 For v >= 1, |{n >= 1 : a(n) = v}| = A108530(v). Equivalently, with c(0) = 1 and m_1 = 1, m_j = 2*c(j-1) for j >= 2, let c(w) = [x^w] Product_{j=1..w} (1 + x^j)^(m_j); then |a^(-1)(1)| = 1 and |a^(-1)(v)| = 2*c(v-1) for v >= 2.
%e A397704 a(6) = 1 + a(1) + a(2) = 1 + 1 + 2 = 4, because 6 = 2^1 + 2^2.
%e A397704 a(11) = 1 + a(0) + a(1) + a(3) = 1 + 0 + 1 + 2 = 4, because 11 = 2^0 + 2^1 + 2^3.
%e A397704 Triangle begins:
%e A397704   1;
%e A397704   2, 2;
%e A397704   3, 3, 4, 4;
%e A397704   3, 3, 4, 4, 5, 5, 6, 6;
%e A397704   4, 4, 5, 5, 6, 6, 7, 7, 6, 6, 7, 7, 8, 8, 9, 9;
%e A397704   5, 5, 6, 6, 7, 7, 8, 8, 7, 7, 8, 8, 9, 9, 10, 10, ...;
%e A397704 each row is the concatenation of all preceding rows (with a(0) replaced by 1), shifted up by a(n).
%t A397704 a[0] = 0; a[n_] := a[n] = 1 + Sum[a[i]*BitGet[n, i], {i, 0, Floor[Log2[n]]}]
%o A397704 (Python)
%o A397704 def a(n):
%o A397704     if n == 0: return 0
%o A397704     res, c = 1, 0
%o A397704     while n:
%o A397704         if n & 1: res += a(c)
%o A397704         n >>= 1
%o A397704         c += 1
%o A397704     return res
%o A397704 (PARI) a(n) = if (n>0, 1 + sum(k=0, #binary(n)-1, if (bittest(n, k), a(k))), 0); \\ _Michel Marcus_, Aug 09 2026
%Y A397704 Cf. A000120, A070939, A063787, A108530, A029931, A116549 (same construction but a(0)=1).
%K A397704 nonn,base,easy,new
