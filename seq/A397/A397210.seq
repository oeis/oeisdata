%U A397210 755528355833910,7673852816695088,78302057122340063,802279109672503131,8250796633338477013,85140103472343598559,881272386987050912274
%N A397210 Number of rooted unlabeled 7-gonal cacti having n blocks.
%C A397210 The critical value is tau_7 = (2/6)^(1/6) = (1/3)^(1/6).
%C A397210 The radius of convergence rho_7 has no known closed form.
%H A397210 Frédéric G. Speyser, <a href="/A397210/b397210.txt">Table of n, a(n) for n = 0..99</a>
%H A397210 Frederic G. Speyser, <a href="https://github.com/frederic-speyser/non-plane-mgonal-cacti">mgonal_cactus_series.py</a>
%F A397210 G.f. s(x) satisfies s(x) = x + x*(exp(Sum_{i>=1} K_C(x^i)/i) - 1), with K_C(x) = (1/2)*(s(x)^6 + s(x^2)^3).
%t A397210 EulerT[v_List]:=Module[{n=Length[v],c},c=Table[DivisorSum[k,# v[[#]]&]/k,{k,1,n}];Rest[Nest[With[{m=Length[#]},Append[#,(1/m) Sum[k c[[k]] #[[m-k+1]],{k,1,m}]]]&,{1},n]]];truncPow[coeffs_List,e_,maxDeg_]:=Module[{x,deg,p},deg=Min[maxDeg,Length[coeffs]-1];p=Take[coeffs,deg+1].x^Range[0,deg];PadRight[CoefficientList[p^e,x],maxDeg+1]];a[nMax_Integer]:=Prepend[Nest[Module[{gcoeffs,g6,g3,g3sub,hvec},gcoeffs=Prepend[#,1];g6=truncPow[gcoeffs,6,nMax-1];g3=truncPow[gcoeffs,3,Quotient[nMax-1,2]];g3sub=PadRight[Riffle[g3,0],nMax];hvec=(g6+g3sub)/2;EulerT[hvec]]&,ConstantArray[0,nMax],nMax],1];a[25] (* From PARI *) (* _Shenghui Yang_, Aug 16 2026 *)
%o A397210 (Python) # See Links
%o A397210 (PARI) EulerT(v)={Vec(exp(x*Ser(dirmul(v, vector(#v, n, 1/n))))-1, -#v)}
%o A397210 seq(n)={my(v=[]); for(n=1, n, my(g=1+x*Ser(v)); v=EulerT(Vec((g^6 + subst(g^3, x, x^2))/2))); concat([1], v)}
