%U A397275 6,0,5,1,8,6,5,5,6,8,1,5,0,6,3,1,0
%N A397275 Irregular triangle read by rows in which row m lists the full period of triangular numbers modulo m.
%C A397275 All rows are palindromes.
%e A397275 Triangle begins:
%e A397275    1:  0;
%e A397275    2:  0, 1, 1, 0;
%e A397275    3:  0, 1, 0;
%e A397275    4:  0, 1, 3, 2, 2, 3, 1, 0;
%e A397275    5:  0, 1, 3, 1, 0;
%e A397275    6:  0, 1, 3, 0, 4, 3, 3, 4, 0, 3, 1, 0;
%e A397275    7:  0, 1, 3, 6, 3, 1, 0;
%e A397275    8:  0, 1, 3, 6, 2, 7, 5, 4, 4, 5, 7, 2, 6, 3, 1, 0;
%e A397275    9:  0, 1, 3, 6, 1, 6, 3, 1, 0;
%e A397275   10: 0, 1, 3, 6, 0, 5, 1, 8, 6, 5, 5, 6, 8, 1, 5, 0, 6, 3, 1, 0;
%e A397275   ...
%o A397275 (Python)
%o A397275 def a(n: int) -> int:
%o A397275     m = 1
%o A397275     while n > (length := m if m % 2 != 0 else 2 * m):
%o A397275         n -= length
%o A397275         m += 1
%o A397275     k = n - 1
%o A397275     return (k * (k + 1) // 2) % m
%o A397275 print([a(i) for i in range(1, 86)])
