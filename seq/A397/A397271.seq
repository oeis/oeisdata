%T A397271 2,2,9,1,1,1,10,5,0,0,11,0,0,0,12,6,3,3,13,0,0,0,14,7,0,0,15,0,0,0,16,
%U A397271 8,4,4,17,2,2,2,18,9,1,1,19,1,1,1,20,10,5
%N A397271 The value on the left of the rightmost pair of zero bits of n in binary.
%C A397271 Any integer n can be interpreted as a 2-dimensional number (i, j), by using the rightmost series of k 0-bits within n in binary as the separator between i (the higher bits) and j (the lower bits). If k = 1, then j is the number of trailing 1-bits. If k = 2, as with this sequence, then j can contain isolated 0-bits. The values of i are the terms of this sequence.
%H A397271 Paolo Xausa, <a href="/A397271/b397271.txt">Table of n, a(n) for n = 0..10000</a>
%H A397271 Paul Tarau, <a href="http://scholar.google.com/scholar?cluster=284705751770513453">A Groupoid of Isomorphic Data Transformations</a>, Calculemus 2009, 8th International Conference, MKM 2009, pp. 170-185, Springer, LNAI 5625.
%H A397271 Paul Tarau, <a href="https://arxiv.org/abs/0808.2953">Declarative Combinatorics: Isomorphisms, Hylomorphisms and Hereditarily Finite Data Types in Haskell</a>, arXiv:0808.2953 [cs.PL], 2009.
%F A397271 a(8*t + 1) = a(8*t) / 2 = a(4*t) = t, so a(8*t) = 2 * a(4*t) = 2 * t, and a(16*t + 1) = a(8*t).
%F A397271 a(4*t + 3) = a(4*t + 2).
%F A397271 a(16*t + 2) = a(16*t + 1) / 2 = t.
%F A397271 a(A003754(n)) = 0.
%e A397271 a(17) = 2, because 17 = 10001_2, and the value on the left of the rightmost pair of zero bits is 10_2 = 2.
%t A397271 A397271[n_] := BitShiftRight[NestWhile[BitShiftRight, n, !Divisible[#, 4] &], 2];
%t A397271 Array[A397271, 100, 0] (* _Paolo Xausa_, Sep 14 2026 *)
%o A397271 (PARI) a(n) = while(n%4, n>>=1); n>>2;
%Y A397271 Cf. A003754, A025480.
%K A397271 nonn,base,easy,new
%O A397271 0,9
