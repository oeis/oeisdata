%I A397937 #20 Jul 26 2026 16:52:35
%S A397937 0,1,12,85,600,4201,29412,205885,1441200,10088401,70618812,494331685,
%T A397937 3460321800,24222252601,169555768212,1186890377485,8308232642400,
%U A397937 58157628496801,407103399477612,2849723796343285,19948066574403000,139636466020821001,977455262145747012
%N A397937 a(n) = floor(7^n/4).
%C A397937 For n >= 1, the base-7 representation of a(n) consists of the first n digits of the base-7 expansion of 1/4 = 0.151515..._7, i.e., n alternating digits 1,5,1,5,... beginning with 1.
%C A397937 For base 3 the corresponding pair floor(3*3^n/4) and floor(3^n/4) coincide up to an index shift (both give A081251); this happens only for base 3, since 3*b^(n-1) = b^n requires b = 3. In base 7 the two sequences are independent.
%H A397937 Reed L. Rucka, <a href="/A397937/b397937.txt">Table of n, a(n) for n = 0..1000</a>
%H A397937 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (7,1,-7).
%F A397937 a(n) = (7^n + (-1)^n - 2)/4.
%F A397937 a(n) = 7*a(n-1) + 3 + 2*(-1)^n for n >= 1, a(0) = 0.
%F A397937 a(n) = 7*a(n-1) + a(n-2) - 7*a(n-3) for n >= 3.
%F A397937 a(n) + A397936(n) = 7^n - 1 for n >= 0.
%F A397937 a(n) + a(n+1) = 2*7^n - 1 (cf. A198480).
%F A397937 binomial(7^n - 1, a(n)) == (-1)^n (mod 7) for n >= 1 (Lucas: the base-7 digits of a(n) are all 1 or 5, and binomial(6,1) = binomial(6,5) = 6 == -1 (mod 7), so every position contributes a factor -1).
%F A397937 G.f.: x*(1 + 5*x)/((1 - x)*(1 + x)*(1 - 7*x)).
%F A397937 E.g.f.: (exp(-x) - 2*exp(x) + exp(7*x))/4. - _Stefano Spezia_, Jul 17 2026
%e A397937 a(3) = 85 = 151 in base 7; a(4) = 600 = 1515 in base 7.
%p A397937 seq(floor(7^n/4), n=0..20);
%t A397937 Table[Floor[7^n/4], {n, 0, 20}]
%o A397937 (PARI) a(n) = 7^n\4;
%Y A397937 Cf. A198480 (consecutive-term sums), A000420, A397936.
%Y A397937 Cf. A081251, A003463 and A125833 (base-5 analogs).
%K A397937 nonn,easy,base
%O A397937 0,3
%A A397937 _Reed L. Rucka_, Jul 15 2026
