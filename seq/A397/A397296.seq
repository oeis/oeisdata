%I A397296 #72 Sep 16 2026 18:47:41
%S A397296 0,1,2,4,5,8,10,11,16,17,20,22,23,25,27,29,32,34,37,40,41,44,46,47,50,
%T A397296 54,55,58,59,64,68,71,74,80,82,83,88,89,92,94,100,101,103,108,110,113,
%U A397296 116,118,125,128,129,136,137,142,148,149,151,153,160,164
%N A397296 a(n) is the least nonnegative integer which is not equal to F(x,y) for some x,y being earlier terms of the sequence, where F(x,y) = lcm(x,y) + |x-y|.
%C A397296 The sequence is defined greedily from the binary operation F(x,y) = lcm(x,y) + |x-y|.
%C A397296 The values for x and y can be equal, but since F(x,x) = lcm(x,x) + |x-x| = x, this is equivalent to preventing repeated values.
%F A397296 a(n) = mex {1 <= i,j < n: lcm(a(i),a(j)) + |a(i)-a(j)|}, where mex denotes the least nonnegative integer not in the set.
%e A397296 a(1) = 0 since this is the first nonnegative integer.
%e A397296 a(2) = 1 since lcm(0,0) + |0-0] = 0 and 1 is the next nonnegative integer.
%e A397296 a(3) = 2 since no additional values can be generated.
%e A397296 For n=4, using 0,1,2, the value lcm(1,2)+|1-2|=3 is generated, so 3 is skipped and a(4)=4.
%e A397296 For n=5, using 0,1,2,4, the values 0,1,2,3,6,7,... are generated, while 5 is not; hence a(5)=5.
%o A397296 (Python)
%o A397296 from math import lcm
%o A397296 def generate(N):
%o A397296     a = [0, 1]
%o A397296     generated = set()
%o A397296     for x in a:
%o A397296         for y in a:
%o A397296             generated.add(lcm(x, y) + abs(x - y))
%o A397296     while len(a) < N:
%o A397296         m = 0
%o A397296         while m in generated:
%o A397296             m += 1
%o A397296         a.append(m)
%o A397296         for x in a:
%o A397296             generated.add(lcm(m, x) + abs(m - x))
%o A397296     return a
%o A397296 print(generate(70))
