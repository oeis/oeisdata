%o A397315 (Python)
%o A397315 from itertools import combinations
%o A397315 def T(n, k): # (a(n,k), A399580(n,k)): max blackout and number of maximum blackouts, from the definition
%o A397315     P = [(x, y) for x in range(k) for y in range(n)]; S = set(P)
%o A397315     R = set()
%o A397315     for A, B, C in combinations(P, 3):
%o A397315         for a, b, c in ((A, B, C), (B, A, C), (A, C, B)):
%o A397315             if (a[0]-b[0])*(c[0]-b[0]) + (a[1]-b[1])*(c[1]-b[1]) == 0:
%o A397315                 d = (a[0]+c[0]-b[0], a[1]+c[1]-b[1])
%o A397315                 if d in S: R.add(frozenset((a, b, c, d)))
%o A397315     R = list(R)
%o A397315     for m in range(len(P), -1, -1):
%o A397315         cnt = 0
%o A397315         for Sb in combinations(P, m):
%o A397315             B = set(Sb); seen = set(); ok = True
%o A397315             for r in R:
%o A397315                 v = r - B
%o A397315                 if v in seen: ok = False; break
%o A397315                 seen.add(v)
%o A397315             cnt += ok
%o A397315         if cnt: return m, cnt
%o A397315 print([T(n, d-n)[0] for d in range(4, 9) for n in range(2, d-1)]) # antidiagonals 4..8; slow beyond about 20 points
%o A397315 (PARI)
%o A397315 T(n, k) = {my(N=n*k, pt=vector(N, i, [(i-1)\n, (i-1)%n]), R=[], cnt, vis);
%o A397315   for(a=1, N, for(b=1, N, for(c=1, N, if(a!=b && b!=c && a!=c,
%o A397315     my(u=pt[a]-pt[b], v=pt[c]-pt[b]); if(u[1]*v[1]+u[2]*v[2]==0,
%o A397315       my(d=pt[a]+pt[c]-pt[b]); if(d[1]>=0 && d[1]<k && d[2]>=0 && d[2]<n,
%o A397315         my(di=d[1]*n+d[2]+1); R=concat(R, [2^(a-1)+2^(b-1)+2^(c-1)+2^(di-1)])))))));
%o A397315   R=Set(R);
%o A397315   forstep(m=N, 0, -1, cnt=0;
%o A397315     forsubset([N, m], s, my(B=sum(i=1, #s, 2^(s[i]-1)));
%o A397315       vis=vector(#R, i, bitnegimply(R[i], B));
%o A397315       if(#Set(vis)==#R, cnt++));
%o A397315     if(cnt, return([m, cnt])));} \\ [a(n,k), A399580(n,k)]
