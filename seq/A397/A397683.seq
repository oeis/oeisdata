%S A397683 1,0,1,0,0,4,1,1,5,6,1,8,3,0,9,6,4,3,5,1,7,10,1,20,0,5,15,7,5,28,11,5,
%T A397683 9,12,9,14,8,3,11,20,0,40,15,9,24,17,6,11,21,4,23,30,3,52,21,4,27,19,
%U A397683 7,15,36,7,15,20,7,38,33,3,43,32,21,15,41,5,51,26,5,13,19,15
%N A397683 a(n) = f(2*n-1) where f(1)=1 and otherwise f(m) is the number of x, 1 <= x < m, such that gcd(x,m) = gcd(x+1,m) = 1 and ord_m(x) = ord_m(x+1).
%C A397683 The restriction to odd moduli removes only trivial zeros: f(m) = 0 for every even m >= 2, since every unit modulo an even m is odd and therefore x and x+1 cannot both be units.
%C A397683 If p is an odd prime, k >= 2, and f(p) > 0, then f(p^k) >= p^(k-2)*(p-2).
%C A397683 For an odd prime p, let omega denote the Teichmuller lift from U(p) to U(p^2), and let E(p) be the number of x counted by f(p) such that omega(x)+1 = omega(x+1) modulo p^2. Then f(p^2) = (p-2)*f(p) + 2*E(p).
%C A397683 E(p) is odd iff 2^(p-1) = 1 modulo p^2 and 4 divides ord_p(2).
%C A397683 If gcd(r,s) = 1, f(r) > 0, and f(s) > 0, then f(r*s) > 0. Hence f(m) > 0 for every odd m coprime to 21.
%C A397683 Conjecture: for odd m, f(m) = 0 iff m is a power of 3 or a power of 7. This has been verified computationally for m < 20000.
%D A397683 S. D. Cohen, Consecutive primitive roots in a finite field, Proc. Amer. Math. Soc. 93 (1985), 189-197.
%D A397683 S. D. Cohen, Consecutive primitive roots in a finite field II, Proc. Amer. Math. Soc. 94 (1985), 605-611.
%H A397683 Donovan Sneider González May, <a href="/A397683/b397683.txt">Table of n, a(n) for n = 1..5000</a>
%H A397683 N. A. Carella, <a href="https://arxiv.org/abs/2604.13090">Least Consecutive Pair of Primitive Roots</a>, arXiv:2604.13090 [math.GM], 2026.
%H A397683 S. D. Cohen, <a href="https://doi.org/10.1112/S0025579300011050">Pairs of primitive roots</a>, Mathematika 32 (1985), 276-285.
%H A397683 S. D. Cohen, T. Oliveira e Silva and T. Trudgian, <a href="https://arxiv.org/abs/1410.6210">On consecutive primitive elements in a finite field</a>, arXiv:1410.6210 [math.NT], 2014; Bull. London Math. Soc. 47 (2015), 418-426.
%F A397683 For odd primes p and k >= 1, f(p^k) = 0 iff p = 3 or p = 7.
%F A397683 For odd primes p, f(p^2) = (p-2)*f(p) + 2*E(p), where E(p) is defined in the comments.
%e A397683 a(6) = f(11) = 4; the valid residues modulo 11 are x = 3, 4, 6, 7.
%o A397683 (Python)
%o A397683 from math import gcd
%o A397683 def ordmult(a,m):
%o A397683     if gcd(a,m)>1: return 0
%o A397683     y,k=1,0
%o A397683     while True:
%o A397683         k,y=k+1,(y*a)%m
%o A397683         if y==1: return k
%o A397683 def f(m):
%o A397683     if m==1: return 1
%o A397683     return sum(gcd(x,m)==gcd(x+1,m)==1 and ordmult(x,m)==ordmult(x+1,m) for x in range(1,m))
%o A397683 def a(n):
%o A397683     return f(2*n-1)
%o A397683 (PARI) f(m) = if(m==1, 1, sum(x=1, m-1, (gcd(x,m)==1) && (gcd(x+1,m)==1) && (znorder(Mod(x, m))==znorder(Mod(x+1, m)))));
%o A397683 a(n) = f(2*n-1); \\ _Michel Marcus_, Sep 11 2026
