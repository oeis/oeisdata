%S A397961 0,0,0,1,3,11,32,96,270,758,2074,5638,15132,40364,106858,281494,
%T A397961 737803,1926345,5011254,12997088,33615825,86736008,223310086,
%U A397961 573820152,1471898502,3769545810,9639818556,24619129243,62798209003,160005557801,407261305648,1035606959298
%N A397961 Number of rooted binary unlabeled simplex time-consistent galled trees with n leaves and exactly 1 gall.
%H A397961 Vaclav Kotesovec, <a href="/A397961/b397961.txt">Table of n, a(n) for n = 0..2000</a>
%H A397961 Lily Agranat-Tamir, Michael Fuchs, Bernhard Gittenberger, Noah A. Rosenberg, and Karthik V. Seetharaman, <a href="https://doi.org/10.1016/j.aam.2026.103131">Combinatorial comparison of general galled trees, time-consistent galled trees, and simplex time-consistent galled trees</a>, Adv. Appl. Math. 180, 103131 (2026). See Table 3.
%F A397961 G.f.: (x/2) * ( A(x)^2 / (1-A(x))^3 + A(x^2) / ((1-A(x))*(1-A(x^2))) ), where A(x) = x + (1/2)*A(x)^2 + (1/2)*A(x^2) is the g.f. of A001190.
%F A397961 Asymptotically, a(n) ~ (1/(g^3*sqrt(Pi)))*sqrt(n)*r^(-n+1), where g=1.13003... and r=0.40270... (Agranat-Tamir et al. 2026, eq. 35).
%F A397961 r = A240943. - _Vaclav Kotesovec_, Aug 26 2026
%e A397961 For n=3, there is 1 tree with no galls. There is 1 tree from whose root a leaf and a qualifying 3-node gall descend. Hence, a(3)=1. For n=4, there is 1 tree from whose root a leaf and a qualifying 3-node gall descend. There is 1 tree with a qualifying 4-node root gall and 1 tree with a qualifying 3-node root gall. Hence, a(4)=1+1+1+1=3.
%t A397961 terms = 32;
%t A397961 A[_] = 0;
%t A397961 B[_] = 0;
%t A397961 Do[A[x_] =
%t A397961   x + (1/2)*A[x]^2 + (1/2)*A[x^2] + O[x]^terms //
%t A397961    Normal, terms]; CoefficientList[A[x], x];
%t A397961 Do[B[x_] =
%t A397961   x A[x]^2/(2 (1 - A[x])^3) + x A[x^2]/(2 (1 - A[x]) (1 - A[x^2])) +
%t A397961     O[x]^terms // Normal, terms]; CoefficientList[B[x], x]
%Y A397961 Cf. A397952 (number of rooted binary unlabeled simplex time-consistent galled trees with n leaves and no restriction on the number of galls), A397264 (number of rooted binary leaf-labeled simplex time-consistent galled trees with n leaves and exactly one gall).
%Y A397961 Cf. A001190, A240943.
%K A397961 nonn,new
%O A397961 0,5
