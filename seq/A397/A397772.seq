%T A397772 63,47,49,91,94,12,48,39,26,36,130,114,56,115,142,105,93,122,206,93,
%U A397772 55,1,76,28,147,180,238,37,195,169,148,171,257,15,344,247,163,143,87,57
%N A397772 Inverse Möbius transform of A351830.
%C A397772 Corresponds to sequence b in Dong et al. (2026), Theorem 1.3.
%H A397772 Paolo Xausa, <a href="/A397772/b397772.txt">Table of n, a(n) for n = 1..10000</a>
%H A397772 Anji Dong, Katerina Saettone, Kendra Song, and Alexandru Zaharescu, <a href="https://doi.org/10.48550/arXiv.2505.04166">An Equidistribution Result for Differences Associated to Square Pyramidal Numbers II</a>, arXiv:2505.04166 [math.NT], 2025-2026.
%F A397772 a(n) = Sum_{d|n} A351830(d).
%F A397772 (Sum_{n=1..x} a(n)*(1 - n/x)) ~ 2*zeta(5/2)*x^(5/2)/(35*sqrt(3)) (see Theorem 1.3 in Dong et al., 2026). - _Paolo Xausa_, Aug 21 2026
%t A397772 A351830[n_] := A351830[n] = Abs[# - Round[Sqrt[#]]^2] & [n*(n + 1)*(2*n + 1)/6];
%t A397772 A397772[n_] := DivisorSum[n, A351830];
%t A397772 Array[A397772, 100]
%Y A397772 Cf. A351830, A247041.
