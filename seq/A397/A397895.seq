%I A397895 #36 Sep 24 2026 19:55:47
%S A397895 3,3,5,7,19,11,13,31,17,19,43,23,103,83,29,31,67,71,37,79,41,43,137,
%T A397895 47,149,103,53,167,173,59,61,127,131,67,139,71,73,151,233,79,163,83,
%U A397895 257,263,89,367,281,191,97,199,101,103,211,107,109,223,113,347,353,239,487,619,251,127,389,131,401
%N A397895 a(n) is the least prime q such that gcd(q+1, A400109(n)+1) = 2*n.
%C A397895 a(n) = q where (q,p) is the first pair of primes q < p with gcd(q+1,p+1) = 2*n, the pairs being ordered first by increasing p and second by increasing q.
%C A397895 The first term where a(n) differs from A038700(2*n) is a(134) = 2143, where A038700(2*134) = 1607.
%H A397895 Robert Israel, <a href="/A397895/b397895.txt">Table of n, a(n) for n = 1..10000</a>
%e A397895 a(5) = 19 because gcd(19+1, 29+1) = 10 = 2*5.
%p A397895 P:= select(isprime, [seq(i, i=3..1000, 2)]): nP:= nops(P):
%p A397895 V:= Vector(100): count:= 0:
%p A397895 for n from 1 to nP while count < 100 do
%p A397895   for k from 1 to n-1 while count < 10000 do
%p A397895     v:= igcd(P[k]+1, P[n]+1)/2;
%p A397895     if v <= 100 and V[v] = 0 then V[v]:= P[k]; count:= count+1; fi;
%p A397895   od
%p A397895 od:
%p A397895 convert(V, list);
%Y A397895 Cf. A038700, A358127, A400109.
%K A397895 nonn,new
%O A397895 1,1
%A A397895 _Robert Israel_, Sep 18 2026
