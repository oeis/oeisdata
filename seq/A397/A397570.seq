%N A397570 Number of permutations p of [n+3] such that |p(i+1)-p(i)| <> n for all 1 <= i < n+3.
%F A397570 a(n) = A398634(n+3,n).
%F A397570 a(n) = Sum_{k=0..3} (-2)^k * binomial(3,k) * (n+3-k)! for n >= 3.
%o A397570 (PARI) a(n) = my(v=[6, 2, 28]); if(n<3, v[n+1], sum(k=0, 3, (-2)^k*binomial(3, k)*(n+3-k)!));
%Y A397570 Diagonal of A398634.
