%I A397971 #52 Oct 04 2026 18:39:32
%S A397971 1,4,136,5592576,4611686019501162496,
%T A397971 292300327466180583640736966543256603934622482432,
%U A397971 6567001032732413202046506683357268967513289878410907777992428417663518075376954494261885966371330273159017163390976
%N A397971 Number of equivalence classes of maps f: {0,1}^n -> {0,1}^n under conjugation by cyclic rotations of coordinates.
%C A397971 Here {0,1}^n is the set of all binary words of length n. Two maps f,g are equivalent if there exists a cyclic rotation rho of the n coordinates such that g = rho o f o rho^(-1).
%H A397971 Paolo Xausa, <a href="/A397971/b397971.txt">Table of n, a(n) for n = 0..8</a>
%F A397971 a(n) = (1/n) * Sum_{d|n} phi(n/d) * 2^(d*2^n) for n>=1, a(0)=1.
%e A397971 For n = 3, let
%e A397971 f(000)=001, f(001)=000, f(010)=000, f(011)=000,
%e A397971 f(100)=000, f(101)=000, f(110)=000, f(111)=000,
%e A397971 and
%e A397971 g(000)=010, g(001)=000, g(010)=000, g(011)=000,
%e A397971 g(100)=000, g(101)=000, g(110)=000, g(111)=000.
%e A397971 If rho(x_1,x_2,x_3) = (x_2,x_3,x_1), then
%e A397971 g = rho o f o rho^(-1), so f and g are equivalent.
%p A397971 a:= proc(n) uses numtheory; `if`(n=0, 1,
%p A397971       add(phi(n/d)*2^(d*2^n), d=divisors(n))/n)
%p A397971     end:
%p A397971 seq(a(n), n=0..6);  # _Alois P. Heinz_, Oct 02 2026
%t A397971 A397971[n_] := If[n == 0, 1, DivisorSum[n, EulerPhi[n/#]*2^(#*2^n) &]/n];
%t A397971 Array[A397971, 8, 0] (* _Paolo Xausa_, Oct 04 2026 *)
%Y A397971 Cf. A000010, A001372, A057156.
%K A397971 nonn,new
%O A397971 0,2
%A A397971 _Vladeta Jovovic_, Oct 02 2026
