%S A397363 4,108,436,1266,4962,12992,26502,46764,74910,116314,172976,246672,
%T A397363 339584,517160,807580,1219494,1761678,2442516,3278666,4279632,5454442,
%U A397363 6812782,8373984,10150940,12154204,14394456,16881732,19753174,23024390,26710260,30826574,35402548,40458186,46010146
%N A397363 a(n) is the trace of the product of two Hankel n X n matrices M_n and N_n whose M[i,j] and N[i,j] generic elements are respectively (i+j) in base 10 and (i+j) written in base 3 but then read as it were written in base 10.
%C A397363 Remainders mod 12 follow the period 12 cycle (0, 0, 0, 2, 2, 0, 2, 0, 2, 2, 0, 0).
%H A397363 Wikipedia, <a href="https://en.wikipedia.org/wiki/Hankel_matrix">Hankel matrix</a>.
%e A397363 For n = 3:
%e A397363     Matrix M_3          Matrix N_3         Matrix M_3 * N_3
%e A397363   [2    3    4]       [ 2   10   11]      [ 78    101   138]
%e A397363   [3    4    5]       [10   11   12]      [101    134   181]
%e A397363   [4    5    6]       [11   12   20]      [124    167   224]
%e A397363 a(3) = trace of M_3 * N_3 = 78 + 134 + 224 = 436.
%o A397363 (PARI) a(n)=trace(matrix(n,n,i,j,i+j)*matrix(n,n,i,j,fromdigits(digits(i+j,3))));
%Y A397363 Cf. A007089, A398535.
%K A397363 nonn,base,easy
%O A397363 1,1
%A A397363 _Claude H. R. Dequatre_, Aug 01 2026
