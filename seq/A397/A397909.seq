%T A397909 4495130640001,152834441760001,2570609989,389422127,104685162319,
%U A397909 1433835837549769,406852409,911300420785759804800001,4194494712496025039,2020885965037,178365721756162223150467169
%N A397909 Largest prime factor of 1 + (product of first n semiprimes).
%C A397909 Semiprime analog of A002585.
%F A397909 a(n) = A006530(A112141(n) + 1).
%e A397909 a(3) = 31 since 4*6*9 + 1 = 217 = 31*7.
%p A397909 sp:= proc(n) option remember; local k; if n=1 then 4 else for k
%p A397909        from 1+sp(n-1) while not 2=add(i[2], i=ifactors(k)[2]) do od; k fi
%p A397909      end:
%p A397909 b:= proc(n) option remember; `if`(n=0, 1, b(n-1)*sp(n)) end:
%p A397909 a:= n-> max(ifactors(1+b(n))[2][.., 1]):
%p A397909 seq(a(n), n=0..21);  # _Alois P. Heinz_, Oct 09 2026
%Y A397909 Cf. A000040, A001358, A002585, A006530, A112141.
%K A397909 nonn
%O A397909 0,1
