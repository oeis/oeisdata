%N A397829 Number of permutations of [n] such that the lengths of increasing and of decreasing runs are bounded by 3.
%C A397829 Number of permutations of [n] avoiding the consecutive patterns 1234 and 4321.
%H A397829 Alois P. Heinz, <a href="/A397829/b397829.txt">Table of n, a(n) for n = 0..455</a>
%p A397829 b:= proc(u, o, t) option remember; `if`(u+o=0, 1, `if`(t=2, 0,
%p A397829       add(b(u+j-1, o-j, t+1), j=1..o))+add(b(o+j-1, u-j, 1), j=1..u))
%p A397829     end:
%p A397829 a:= n-> `if`(n=0, 1, add(b(j-1, n-j, 0), j=1..n)):
%p A397829 seq(a(n), n=0..22);  # _Alois P. Heinz_, Aug 26 2026
