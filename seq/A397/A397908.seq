%S A397908 1,2,3,5,5,10,9,17,13,14,23,21,25,34,37,29,39,46,43,48,63,50,65,69,63,
%T A397908 75,89,96,117,104,69,127,121,160,97,195,105,164,135,199,137,240,163,
%U A397908 283,181,328,143,242,229,291,193,379,245,336,283,346,249,403,303
%N A397908 a(1) = 1; a(n) = a(n-d(n)) + n - 1 for n > 1, where d(n) = prime(n) - prime(n-1).
%H A397908 James C. McMahon, <a href="/A397908/b397908.txt">Table of n, a(n) for n = 1..10000</a>
%e A397908 a(7) = a(7 - d(6)) + 6 = a(7 - 4) + 6 = a(3) + 6 = 9.
%t A397908 df[n_]:=Prime[n]-Prime[n-1];a[1]=1;a[n_]:=a[n-df[n]]+n-1;Array[a,59] (* _James C. McMahon_, Oct 15 2026 *)
%o A397908 (Python)
%o A397908 from sympy import primerange
%o A397908 def A(N):
%o A397908     ps = list(primerange(2, 20*N + 100))
%o A397908     d = [0] + [ps[i+1] - ps[i] for i in range(N)]
%o A397908     a = [0, 1]
%o A397908     for n in range(1, N):
%o A397908         t = n + 1 - d[n]
%o A397908         a.append((a[t] if t >= 1 else 1) + n)
%o A397908     return a[1:]
%o A397908 print(A(59))
%Y A397908 Cf. A000040, A001223.
%K A397908 nonn
