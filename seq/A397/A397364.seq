%N A397364 Decimal expansion of the number whose continued fraction coefficients are given in A089618.
%C A397364 This constant does not appear to be normal in the continued fraction sense even though its continued fraction coefficients follow the Gauss-Kuzmin distribution by construction. This is because normality requires all blocks of partial quotients (not just the individual terms) to follow the Gauss measure.
%H A397364 Jwalin Bhatt, <a href="/A397364/b397364.txt">Table of n, a(n) for n = 0..10000</a>
%F A397364 Equals lim_{n->oo} A397337(n) / A397401(n).
%e A397364 0.461070495956719519354149869336699...
%o A397364 (Python)
%o A397364 from fractions import Fraction
%o A397364 from sympy import floor, continued_fraction_convergents
%o A397364 from collections import deque
%o A397364 from os.path import commonprefix
%o A397364 def van_der_corput(n):
%o A397364     bits = bin(n)[2:][::-1]
%o A397364     d = Fraction(int(bits, 2), 1 << len(bits))
%o A397364     return int(1 / (2**d - 1))
%o A397364 def reliable_digits_from_cf(coeffs, prec):
%o A397364     frac_lower, frac_upper = deque(continued_fraction_convergents(coeffs+[1]), maxlen=2)
%o A397364     trunc_lower, trunc_upper = floor(frac_lower * 10**prec), floor(frac_upper * 10**prec)
%o A397364     return commonprefix([str(trunc_lower), str(trunc_upper)])
%o A397364 num_coeffs = 180
%o A397364 A089618 = [van_der_corput(i) for i in range(1, num_coeffs)]
%o A397364 num = reliable_digits_from_cf([0]+A089618, prec=200)
%o A397364 A397364 = [int(d) for d in num]
%Y A397364 Cf. A089618, A372869, A392388, A392729, A397337, A397401.
%K A397364 nonn,cons
%O A397364 0,1
