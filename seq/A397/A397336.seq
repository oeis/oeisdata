%N A397336 Number of ternary words with c(1) = n such that all prefixes satisfy c(1) >= c(2), c(1) >= c(3), where c(i) is the number of occurrences of the letter i.
%H A397336 Alois P. Heinz, <a href="/A397336/b397336.txt">Table of n, a(n) for n = 0..500</a>
%e A397336 a(1) = 5: (1), (1,2), (1,3), (1,2,3), (1,3,2).
%p A397336 b:= proc(x, y, z) option remember; `if`(x=0, 1, 0)+
%p A397336       `if`(u=0, 0, `if`(x>0, b(x-1, y, z), 0)+
%p A397336       `if`(y>0 and y>x, b(x, y-1, z), 0)+
%p A397336       `if`(z>0 and z>x, b(x, sort([y, z-1])[]), 0))
%p A397336     end:
%p A397336 a:= n-> b(n$3):
%p A397336 seq(a(n), n=0..19);  # _Alois P. Heinz_, Jul 30 2026
%o A397336 (Python)
%o A397336 from functools import lru_cache
%o A397336 def A397336(n):
%o A397336     @lru_cache(maxsize=None)
%o A397336     def r(a,b,c):
%o A397336         t = 0
%o A397336         if a != n:
%o A397336             t += r(a+1,b,c)
%o A397336         else:
%o A397336             t = 1
%o A397336         if b < a: t += r(a,b+1,c)
%o A397336         if c < a: t += r(a,b,c+1)
%o A397336         return t
%o A397336     return r(0,0,0)
