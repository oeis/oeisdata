%I A397217 #57 Oct 08 2026 23:04:50
%S A397217 2,6,18,46,54,86,126,190,248,266,334,410,494,614,716,826,858,978,1106,
%T A397217 1242,1386,1582,1744,1914,2092,2142,2330,2526,2730,2942,3162,3454,
%U A397217 3692,3938,4192,4454,4526,4798,5078,5366,5662,5966,6278,6686,7016,7354,7700,8054
%N A397217 The smallest number that is n grid steps horizontally or vertically from n in the square spiral as in A316667.
%H A397217 Eric Stolee, <a href="/A397217/b397217.txt">Table of n, a(n) for n = 1..1000</a>
%H A397217 Eric Stolee, <a href="/A397217/a397217_2.txt">Python</a>
%F A397217 a(n) < (2*n - sqrt(n) + 2)^2.
%e A397217 The spiral begins like:
%e A397217   64  37--38--39--40--41--42--43
%e A397217    |   |                       |
%e A397217   63  36  17--18--19--20--21  44
%e A397217    |   |   |               |   |
%e A397217   62  35  16   5---6---7  22  45
%e A397217    |   |   |   |       |   |   |
%e A397217   61  34  15   4   1   8  23  46
%e A397217    |   |   |   |   |   |   |   |
%e A397217   60  33  14   3---2   9  24  47
%e A397217    |   |   |           |   |   |
%e A397217   59  32  13--12--11--10  25  48
%e A397217    |   |                   |   |
%e A397217   58  31--30--29--28--27--26  49
%e A397217    |                           |
%e A397217   57--56--55--54--53--52--51--50
%e A397217 For example, with n=3, the smallest number that is 3 vertical (or horizontal) grid steps away from 3 is 18, so a(3) = 18. In general, a(n) is the smallest number that is n grid steps away from n.
%Y A397217 Cf. A316667, A174344, A392177.
%K A397217 nonn,new
%O A397217 1,1
%A A397217 _Eric Stolee_, Sep 29 2026
