%S A397713 1,1,1,1,2,1,1,2,2,1,1,3,3,3,1,1,3,4,4,3,1,1,3,4,5,4,3,1,1,3,5,6,6,5,
%T A397713 3,1,1,4,5,6,7,6,5,4,1,1,4,6,7,7,7,7,6,4,1,1,4,6,7,8,8,8,7,6,4,1,1,4,
%U A397713 6,8,9,9,9,9,8,6,4,1
%N A397713 Triangle read by rows: T(n,k) is the number of binary digits in binomial(n,k).
%F A397713 T(n,k) = A070939(A007318(n,k)), with 0 <= k <= n.
%e A397713 Pascal's triangle A007318 in binary goes as follows:
%e A397713   0 | 1;
%e A397713   1 | 1, 1;
%e A397713   2 | 1, 10, 1;
%e A397713   3 | 1, 11, 11, 1;
%e A397713   4 | 1, 100, 111, 100, 1;
%e A397713   5 | 1, 101, 1010, 1010, 101, 1;
%e A397713   ...
%e A397713 Then this triangle begins as follows:
%e A397713   0 | 1;
%e A397713   1 | 1, 1;
%e A397713   2 | 1, 2, 1;
%e A397713   3 | 1, 2, 2, 1;
%e A397713   4 | 1, 3, 3, 3, 1;
%e A397713   5 | 1, 3, 4, 4, 3, 1;
%e A397713   ...
%t A397713 T[n_,k_]:=Length[IntegerDigits[Binomial[n,k],2]]; Table[T[n,k],{n,0,11},{k,0,n}]//Flatten (* _Stefano Spezia_, Aug 03 2026 *)
%o A397713 (Python)
%o A397713 import math
%o A397713 n = int(input())
%o A397713 for i in range(n):
%o A397713     for j in range(i+1):
%o A397713         print(math.comb(i,j).bit_length(), end=", ")
%o A397713 (PARI) T(n,k) = #binary(binomial(n,k)); \\ _Michel Marcus_, Aug 06 2026
