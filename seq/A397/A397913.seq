%T A397913 5,8,24,128,1,2,3,4,5,6,15,40,256,1,2,3,4,5,6,8,24,64,512,1,2,3,4,5,6,
%U A397913 7,15,32,128,1024,1,2,3,4,5,6,7,8,24,58,255,2048,1,2,3,4,5,6,7,8,15,32,88,447,4096
%N A397913 Array read by antidiagonals T(x, y): T(x, y), the smallest chip that can reach (x, y) when sufficiently many chips are present in a certain labeled chip-firing game that is described in the comments, x >= 0, y >= 0.
%C A397913 Consider the following labeled chip-firing game on the integer points of the first quadrant (i.e., the set of vertices (x, y) where x and y are nonnegative integers). Place 2^n labeled chips 1, 2, ..., 2^n at (0,0). We can fire a vertex (x,y) where x, y > = 0 if it has at least 2 chips. When we fire a vertex, we send the smaller labeled chip to (x+1, y) and the larger labeled chip to (x, y+1). We continue firing vertices until no vertex can fire.
%C A397913 T(x, y) is the smallest chip that can reach (x, y) when n is sufficiently large.
%F A397913 For every positive integer m, define C(m, a, b) by the initial relations C(m, a, 0) = m for a >= 0 and C(m, -1, b) = 0 for b >= 0, and the recurrence relations C(m, a, b) = floor((C(m, a,b-1)+C(m, a-1,b))/2) (for a>=0 and b>=1).
%F A397913 T(x, y) = min{m >= 1: C(m, x, y) > 0}.
%e A397913 T(0, 1)=2, since chip 1 must go to (1, 0). On the other hand, chip 2 can go to (0, 1) when the pair of chips 1, 2 is fired from (0, 0).
%e A397913 Array begins:
%e A397913   ==================================================
%e A397913   x/y |  0    1    2    3    4    5    6    7    8
%e A397913   ----+---------------------------------------------
%e A397913    0  |  1    2    4    8   16   32   64  128  256
%e A397913    1  |  1    2    3    4    8   15   24   40   64
%e A397913    2  |  1    2    3    4    5    8   15   24   32
%e A397913    3  |  1    2    3    4    5    6    8   15   24
%e A397913    4  |  1    2    3    4    5    6    7    8   15
%o A397913 (Python)
%o A397913 from functools import cache
%o A397913 @cache
%o A397913 def C(m, a, b):
%o A397913     if a == -1:
%o A397913         return 0
%o A397913     if b == 0:
%o A397913         return m
%o A397913     return (C(m, a, b - 1) + C(m, a - 1, b)) // 2
%o A397913 def T(x, y):
%o A397913     lo, hi = y + 1, 2**y
%o A397913     while lo < hi:
%o A397913         m = (lo + hi) // 2
%o A397913         if C(m, x, y) > 0:
%o A397913             hi = m
%o A397913         else:
%o A397913             lo = m + 1
%o A397913     return lo
%o A397913 out_s = ""
%o A397913 for s in range(13):
%o A397913     for y in range(s+1):
%o A397913         out_s = out_s + str(T(s-y, y)) + ", "
%o A397913 print(out_s)
