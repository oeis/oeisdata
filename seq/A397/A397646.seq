%T A397646 656303,1472306,3255931,7113275,15350882,32766801,69193990,144678842,
%U A397646 299629832,614999596,1251467720,2525939041,5058510976,10054985132,19843790825,38894376062
%N A397646 Number of factorizations of (p*q)^n into parts > 1 where neither p nor q are permitted as factors, for any two distinct primes p and q.
%C A397646 The number of factorizations of p^n * q^n depends only on the prime exponents (n, n) and is independent of the choice of distinct primes p and q (such as 2 and 3).
%C A397646 Equivalently, this sequence counts the number of 2D vector partitions of the vector (n, n) into parts drawn from {(i, j) | i >= 0, j >= 0} excluding the elementary vectors (1,0) and (0,1), as well as (0,0).
%C A397646 a(n) is the number of two column nonnegative integer matrices with column sums equal to n and row sums > 1 up to permutation of rows. - _Andrew Howroyd_, Aug 02 2026
%F A397646 a(n) = [x^n y^n] H(x,y) where H(x,y) = Product_{i>=0, j>=0, i+j>1} 1 / (1 - x^i * y^j).
%F A397646 a(n) = T(n,n) - T(n-1,n) - T(n,n-1) + T(n-1,n-1), where T(i,j) = A054225(i+j,i).
%e A397646 a(1) = 1: for 2^1 * 3^1 = 6, the only factorization excluding 2 and 3 as parts is {6}.
%e A397646 a(2) = 3: for 2^2 * 3^2 = 36, the factorizations excluding 2 and 3 as parts are {36}, {4, 9}, and {6, 6}.
%e A397646 a(3) = 8: for 2^3 * 3^3 = 216, the factorizations excluding 2 and 3 as parts are {216}, {4, 54}, {6, 36}, {8, 27}, {9, 24}, {12, 18}, {4, 6, 9}, and {6, 6, 6}.
%e A397646 From _Andrew Howroyd_, Aug 02 2026: (Start)
%e A397646 The corresponding a(3) = 8 nonnegative integer matrices are:
%e A397646   [3 3]  [1 3]  [1 1]  [0 3]  [0 2]  [1 2]  [0 2]  [2 2]
%e A397646          [2 0]  [2 2]  [3 0]  [3 1]  [2 1]  [1 1]  [2 2]
%e A397646                                             [2 0]  [2 2]
%e A397646 (End)
%o A397646 (Python)
%o A397646 import numpy as np
%o A397646 def lista(n):
%o A397646     allowed = [(i, j) for i in range(n + 1) for j in range(n + 1) if (i, j) not in [(0, 0), (1, 0), (0, 1)]]
%o A397646     dp = np.zeros((n + 1, n + 1), dtype=object)
%o A397646     dp[0, 0] = 1
%o A397646     for vec_i, vec_j in allowed:
%o A397646         for x in range(vec_i, n + 1):
%o A397646             for y in range(vec_j, n + 1):
%o A397646                 dp[x, y] += dp[x - vec_i, y - vec_j]
%o A397646     return [int(dp[k, k]) for k in range(0, n + 1)]
%o A397646 print(lista(30))
%Y A397646 Cf. A001055 (multiplicative partitions).
%Y A397646 Cf. A002774 (number of factorizations of (p*q)^n), A054225.
%K A397646 nonn,easy,new
%O A397646 0,3
%A A397646 _Jishnu Babu Ranitha_, Aug 02 2026
