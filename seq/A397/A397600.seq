%N A397600 Number of increasing 3-term arithmetic progressions in an n^d hypercube, array A(n,d) read by antidiagonals.
%H A397600 Paolo Xausa, <a href="/A397600/b397600.txt">Table of n, a(n) for n = 1..11325</a> (first 150 antidiagonals, flattened).
%H A397600 Hiller Alves Fernandes, <a href="https://doi.org/10.5281/zenodo.21708795">Counting 3-Term Arithmetic Progressions in Integer Hypercubes</a>, Zenodo (2026).
%F A397600 A(n,d) = ((x^2 + y^2)^d - n^d)/2, x = floor(n/2) and y = ceiling(n/2).
%e A397600 Array begins:
%e A397600 =====================================================================
%e A397600 n\d | 1   2     3      4        5          6           7
%e A397600 ----+----------------------------------------------------------------
%e A397600   1 | 0   0     0      0        0          0           0
%e A397600   2 | 0   0     0      0        0          0           0
%e A397600   3 | 1   8     49     272      1441       7448        37969
%e A397600   4 | 2   24    224    1920     15872      129024      1040384
%e A397600   5 | 4   72    1036   13968    184084     2405592     31335196
%e A397600   6 | 6   144   2808   51840    940896     16982784    305970048
%e A397600   7 | 9   288   7641   194112   4874409    122011488   3051346041
%e A397600   8 | 12  480   16128  522240   16760832   536739840   17178820608
%e A397600   9 | 16  800   34096  1409600  57898576   2374786400  97374745456
%e A397600   10| 20  1200  62000  3120000  156200000  7812000000  390620000000
%e A397600 ...
%t A397600 A397600[n_, d_] := ((Quotient[n, 2]^2 + Ceiling[n/2]^2)^d - n^d)/2;
%t A397600 Table[A397600[d, n - d + 1], {n, 10}, {d, n}] (* _Paolo Xausa_, Aug 06 2026 *)
%o A397600 (Python)
%o A397600 def T(n, d):
%o A397600     a_val = (n + 1) // 2
%o A397600     b_val = n // 2
%o A397600     return ((a_val**2 + b_val**2)**d - n**d) // 2
%o A397600 for n in range(1, 11):
%o A397600     row = [T(n, d) for d in range(1, 8)]
%o A397600     print(f"n={n:2d} | {row}")
