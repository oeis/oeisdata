%N A397928 Number of nonnegative integer matrices with a total of n rows and columns with each row sum and column sum nonzero and at most 2.
%H A397928 Andrew Howroyd, <a href="/A397928/b397928.txt">Table of n, a(n) for n = 0..400</a>
%F A397928 a(n) = Sum_{k=0..n} k!*(n-k)! [x^n][y^k] sqrt(exp(y*x^2*(3 + (1+y)*x - y*x^2)/(1 - y*x^2))/(1 - y*x^2)).
%e A397928 The a(4) = 13 matrices are:
%e A397928   [1 1]  [0 1]  [1 0]  [0 1]  [2 0]  [0 2]  [1 0]
%e A397928   [1 1]  [1 0]  [0 1]  [2 0]  [0 1]  [1 0]  [0 2]
%e A397928 .
%e A397928   [0 2]  [2 0]  [0 1]  [1 0]  [1 1]  [1 1]
%e A397928   [2 0]  [0 2]  [1 1]  [1 1]  [1 0]  [0 1]
%o A397928 (PARI) seq(n) = {my(v=Vec(sqrt(exp(y*x^2*(3 + (1+y)*x - y*x^2)/(1 - y*x^2) + O(x*x^n))/(1 - y*x^2)) )); vector(#v, i, my(p=v[i]); i--; sum(j=0, i, polcoef(p,j)*j!*(i-j)!))}
%Y A397928 Column k=2 of A397926.
%Y A397928 Cf. A147766 (up to row and column permutations), A397929 (k=3).
%K A397928 nonn,new
%O A397928 0,3
