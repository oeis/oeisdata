%S A397337 1,5,6,71,77,302,379,8640,17659,79276,96935,757821,854756,2467333,
%T A397337 3322089,151961338,307244765,1380940398,1688185163,14886421702,
%U A397337 16574606865,64610242297,81184849162,1201198130565,1282382979727,5048347069746,6330730049473,43032727366584
%N A397337 Numerators of the convergents given by treating A089618 as continued fraction coefficients after the leading 0.
%C A397337 Limit_{n->oo} a(n)^(1/n) seems to approach a value around 3.155.
%H A397337 Jwalin Bhatt, <a href="/A397337/b397337.txt">Table of n, a(n) for n = 1..2001</a>
%H A397337 Wikipedia, <a href="https://en.wikipedia.org/wiki/L%C3%A9vy%27s_constant">Lévy's constant</a>.
%o A397337 (Python)
%o A397337 from fractions import Fraction
%o A397337 from sympy import continued_fraction_convergents
%o A397337 def van_der_corput(n):
%o A397337     bits = bin(n)[2:][::-1]
%o A397337     d = Fraction(int(bits, 2), 1 << len(bits))
%o A397337     return int(1 / (2**d - 1))
%o A397337 coeffs = [0] + [van_der_corput(i) for i in range(1, 30)]
%o A397337 convergent_generator = continued_fraction_convergents(coeffs)
%o A397337 next(convergent_generator)
%o A397337 A397337 = [frac.numerator for frac in convergent_generator]
%Y A397337 Cf. A089618, A390651, A391509, A392258, A397401 (denominators).
%K A397337 nonn,frac
%O A397337 1,2
%A A397337 _Jwalin Bhatt_, Jul 26 2026
