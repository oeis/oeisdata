%T A397693 42,48,49,50,52,55,56,57,60,64,68,69,70,74,77,78,80,84,88,93,94,95,
%U A397693 100,105,106,110,115,119,124,125,126,130,133,140,141,145,152,156
%N A397693 Indices of records in A397887.
%e A397693 For n = 18, the sequence value is A397887(18) = 39. This is a record breaker because 39 is strictly greater than A397887(m) for all m < 18.
%o A397693 (Python)
%o A397693 from sympy import isprime, primepi
%o A397693 def upto(N):
%o A397693     best_sum=-1
%o A397693     record_breakers=[]
%o A397693     for number in range(1,N+1):
%o A397693         sum_value=0
%o A397693         temp=number
%o A397693         while temp>0:
%o A397693             sum_value+=temp
%o A397693             if isprime(temp):
%o A397693                 temp=primepi(temp)
%o A397693             else:
%o A397693                 temp=temp-primepi(temp)-1
%o A397693         if sum_value>best_sum:
%o A397693             record_breakers.append(number)
%o A397693             best_sum=sum_value
%o A397693     return record_breakers
%Y A397693 Cf. A026238, A022447, A025010, A397887.
