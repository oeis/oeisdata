%N A397141 Number of palindromic Carlitz compositions of n with parts in standard order.
%H A397141 Alois P. Heinz, <a href="/A397141/b397141.txt">Table of n, a(n) for n = 0..8269</a>
%H A397141 John Tyler Rascoe, <a href="/A397141/a397141.txt">PARI code</a>.
%e A397141 a(16) = 4: (1,2,1,2,1,2,1,2,1,2,1), (1,2,1,3,2,3,1,2,1), (1,2,3,1,2,1,3,2,1), (1,2,3,4,3,2,1).
%p A397141 b:= proc(n, m, l) option remember; `if`(n<=m+1 and n>0 and n<>l, 1, 0)+
%p A397141       add(`if`(j=l, 0, b(n-2*j, max(m, j), j)), j=1..min(n/2, m+1))
%p A397141     end:
%p A397141 a:= n-> `if`(n=0, 1, b(n, 0$2)):
%p A397141 seq(a(n), n=0..58);  # _Alois P. Heinz_, Aug 25 2026
