%I A397087 #27 Sep 20 2026 18:52:06
%S A397087 1,0,0,0,1,0,2,1,1,1,8,1,27,1,3,3,235,1,744,3,21,5,8260,11,2403,15,
%T A397087 542,19,330567,3,1154540,167,1591,115,22011,27,51591179,379,18027,275,
%U A397087 670433727,15,2435241220,1203,16893,4145,32547984848,339,2137180787,1367,2630989
%N A397087 Number of nonempty subsets S of [n] such that sum(S) == 0 (mod n) and product(S) == 1 (mod n).
%C A397087 Since the product must be congruent to 1 modulo n, all elements of S must be coprime to n (i.e., belong to the multiplicative group modulo n).
%H A397087 Lezhe Gao, <a href="/A397087/b397087.txt">Table of n, a(n) for n = 1..349</a>
%e A397087 For n = 5, the subset {2,3} satisfies 2+3=5 == 0 (mod 5) and 2*3=6 == 1 (mod 5), so a(5)=1.
%e A397087 For n = 7, the subsets {1,2,4} and {2,3,4,5} both satisfy the conditions, hence a(7)=2.
%o A397087 (Python)
%o A397087 from math import gcd
%o A397087 def a(n):
%o A397087     dp = [[0]*n for _ in range(n)]
%o A397087     dp[0][1 % n] = 1
%o A397087     for x in range(1, n+1):
%o A397087         if gcd(x, n) != 1:
%o A397087             continue
%o A397087         ndp = [row[:] for row in dp]
%o A397087         for s in range(n):
%o A397087             for p in range(n):
%o A397087                 if dp[s][p]:
%o A397087                     ns = (s + x) % n
%o A397087                     np = (p * x) % n
%o A397087                     ndp[ns][np] += dp[s][p]
%o A397087         dp = ndp
%o A397087     return dp[0][1 % n] - 1
%K A397087 nonn,new
%O A397087 1,7
%A A397087 _Lezhe Gao_, Sep 08 2026
