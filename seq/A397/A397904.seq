%S A397904 1,2,2,4,3,3,5,2,5,4,2,3,7,2,6,3,6,3,2,3,9,6,4,8,6,3,3,7,5,4,4,8,6,4,
%T A397904 3,8,9,5,5,3,4,7,8,4,6,3,2,8,8,5,5,5,10,4,9,7,7,5,4,11,4,2,10,8,6,6,5,
%U A397904 4,4,10,3,8,9,7,7,5,5,4,4,3,4,9,2,7,8,6
%N A397904 Number of steps starting from the n-th positive integer coprime to 6 until the first repeated value under the fully reduced residue-dependent (7k +- 1)/6 map, or -1 if no value ever repeats.
%C A397904 a(n) is the number of iterations of T, starting from A007310(n), until a value occurs that has already appeared earlier in the same trajectory, where T(k) = (7*k-1)/(2^v_2(7*k-1) * 3^v_3(7*k-1)) if k == 1 (mod 6), and T(k) = (7*k+1)/(2^v_2(7*k+1) * 3^v_3(7*k+1)) if k == 5 (mod 6).
%C A397904 Here A007310(n) = 3*n - 2 + (1+(-1)^n)/2 is the n-th positive integer coprime to 6, and v_p(m) denotes the exponent of the highest power of p dividing m.
%C A397904 The fixed point 1 is an exact cycle of length 1. If a trajectory has preperiod length mu and eventual cycle length lambda, then a(n) = mu + lambda.
%H A397904 Farhad Banazadeh, <a href="/A397904/b397904.txt">Table of n, a(n) for n = 1..10000</a>
%H A397904 Farhad Banazadeh, <a href="https://doi.org/10.5281/zenodo.22829703">Ternary (7k +- 1)/6 Collatz-Type Map with a Single Observed Attractor: Complete (2, 3)-Adic Reduction, Algebraic Cycle Analysis, and Exhaustive Computational Verification up to 10^11</a>, Zenodo, 2026.
%e A397904 For n = 1, A007310(1) = 1 and the orbit is 1, 1.
%e A397904 The first repeated value occurs after 1 iteration, so a(1) = 1.
%e A397904 For n = 2, A007310(2) = 5 and the orbit is 5, 1, 1.
%e A397904 The first repeated value occurs after 2 iterations, so a(2) = 2.
%e A397904 For n = 4, A007310(4) = 11 and the orbit is 11, 13, 5, 1, 1.
%e A397904 The first repeated value occurs after 4 iterations, so a(4) = 4.
%e A397904 For n = 13, A007310(13) = 37 and the orbit is 37, 43, 25, 29, 17, 5, 1, 1.
%e A397904 The first repeated value occurs after 7 iterations, so a(13) = 7.
%e A397904 For n = 29, A007310(29) = 85 and the orbit is 85, 11, 13, 5, 1, 1.
%e A397904 The first repeated value occurs after 5 iterations, so a(29) = 5.
%o A397904 (Python)
%o A397904 def T(k):
%o A397904     y = 7*k + (-1 if k % 6 == 1 else 1)
%o A397904     while y % 2 == 0:
%o A397904         y //= 2
%o A397904     while y % 3 == 0:
%o A397904         y //= 3
%o A397904     return y
%o A397904 def a(n):
%o A397904     k = 3*n - 2 + (1 if n % 2 == 0 else 0)
%o A397904     seen = set()
%o A397904     while k not in seen:
%o A397904         seen.add(k)
%o A397904         k = T(k)
%o A397904     return len(seen)
%Y A397904 Cf. A006666, A007310, A330920, A400174, A400182.
%K A397904 nonn
