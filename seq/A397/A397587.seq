%I A397587 #23 Jul 28 2026 16:19:43
%S A397587 6,72,15,120,2450,63,1800,1326,1225,357,840,99225,5005,3969,2499,3600,
%T A397587 17955,480249,2145,9801,13915,2520,893025,34034,1432809,11583,88209,
%U A397587 59455,28800,51975
%N A397587 Square array read by antidiagonals upwards: T(n, k) is the smallest number v in A001284 with n+1 middle divisors and whose symmetric representation of sigma, SRS(v), consists of 2*k-1 parts, or 0 if no such number exists, n >= 1, k >= 1.
%C A397587 Since every term v in A001284 has at least 2 middle divisors, every SRS(T(n, k)) consists of an odd number of parts.
%C A397587 A number v has at least 2 middle divisors if and only if v is a term in A001284. Therefore, A001284 is the complement of the union of A071561 and of A320137.
%F A397587 Observation: T(n,1) = A128605(n+1) at least for 1 <= n <= 8. - _Omar E. Pol_, Jul 22 2026
%e A397587 Outer row labels 2 ... 8 represent counts of n+1 middle divisors of numbers T(n, k).
%e A397587 Outer column labels 1, 3, 5, 7, 9, 11, 13, 15 represent counts of odd numbers of parts of SRS(T(n, k)).
%e A397587 Complete upper left triangle of 7 antidiagonals of array T(n, k), for 1 <= n <= 7 and 1 <= k <= 7 with incomplete antidiagonal 8 since T(6, 3) > 10^7.
%e A397587 parts-> | 1     3      5      7       9       11      13      15
%e A397587 mid |----------------------------------------------------------------
%e A397587 divs|n\k| 1     2      3      4       5       6       7       8
%e A397587 ---------------------------------------------------------------------
%e A397587 2   | 1 | 6     15     63     357     2499    13915   59455   320045 ...
%e A397587 3   | 2 | 72    2450   1225   3969    9801    88209   159201  ...
%e A397587 4   | 3 | 120   1326   5005   2145    11583   49329   115311  ...
%e A397587 5   | 4 | 1800  99225  480249 1432809 1030225 ...
%e A397587 6   | 5 | 840   17955  34034  196707  62985   142857  509733  ...
%e A397587 7   | 6 | 3600  893025 >10^7  ...
%e A397587 8   | 7 | 2520  51975  205275 1429275 2785875 1623075 ...
%e A397587 9   | 8 | 28800 ...
%e A397587 ...
%t A397587 (* function partsSRS[ ] is defined in A320066 *)
%t A397587 row[n_] := Floor[(Sqrt[8 n+1]-1)/2] (* see A003056 *)
%t A397587 aTriangle[m_] := Map[Table[#(#+i), {i, #-1}]&, Range[2, m]] (* formula from A001284 *)
%t A397587 a001284[n_] := Apply[Union, aTriangle[row[n]]] (* see also A397585 *)
%t A397587 middleDivs[n_] := Select[Divisors[n], Sqrt[n/2]<=#<Sqrt[2n]&] (* see A067742 *)
%t A397587 a397587[s_, {r_, c_}] := Module[{numL=a001284[s], len, list=Table[0, {i, 2, r+1}, {j, c}], v, rv, cv}, len=Length[numL]; For[v=1, v<=len, v++, rv=Length[middleDivs[numL[[v]]]]; cv=Length[partsSRS[numL[[v]]]]; If[rv<=r+1&&cv<=2c-1&&list[[rv-1, (cv+1)/2]]==0, list[[rv-1, (cv+1)/2]]=numL[[v]]]]; list]
%t A397587 (* returns 0's for terms in the array beyond A001284(s) *)
%t A397587 a397587[1432809, {8, 8}] (* includes the complete first 7 antidiagonals; long computation *)
%Y A397587 Cf. A001284, A003056, A067742, A071561, A237270, A237271, A237593, A320066, A320137, A341969, A397585.
%Y A397587 Cf. A128605.
%K A397587 nonn,tabl,more,new
%O A397587 1,1
