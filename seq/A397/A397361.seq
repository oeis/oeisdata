%S A397361 1,3,16,95,540,3619,23958,156480,1110603,7679331,53547109,383006539,
%T A397361 2729398961,19588767547,142468329398,1035107470290,7559010653810,
%U A397361 55476238635860,407344809299641,3000969511825037,22174393867876889,164058392915010584,1216931188205808343
%N A397361 Number of compositions of n^2 into n parts such that every initial segment has an integer average.
%C A397361 a(n) = T(n^2,n), where T(m,k) is the number of compositions of m into k parts in which every initial segment has an integer average (equivalently, i divides the sum of the first i parts for all i); the row sums Sum_{k|m} T(m,k) are A398023.
%C A397361 For prime p, a(p) = A398023(p^2) - 2: the divisors of p^2 are 1, p and p^2, and the compositions of p^2 into 1 part and into p^2 parts are each the unique qualifying one, so A398023(p^2) = 2 + T(p^2,p).
%H A397361 Andrew Howroyd, <a href="/A397361/b397361.txt">Table of n, a(n) for n = 1..500</a>
%F A397361 a(n) = #{0 = b_0 <= b_1 <= ... <= b_n = n*(n-1) : i divides b_i for all i}, via b_i = (a_1 + ... + a_i) - i.
%e A397361 a(2) = 3: the compositions of 4 into 2 parts are (1,3), (2,2), (3,1), with partial averages (1,2), (2,2), (3,2); all three are integers, so all qualify.
%o A397361 (Python)
%o A397361 def a(n):
%o A397361     B = n*n - n
%o A397361     row = [1]*(B+1)
%o A397361     for i in range(1, n):
%o A397361         run = 0; new = [0]*(B+1)
%o A397361         for v in range(B+1):
%o A397361             if v % i == 0: run += row[v]
%o A397361             new[v] = run
%o A397361         row = new
%o A397361     return row[B]
%o A397361 (PARI)
%o A397361 step(u, d) = { my(v=vector(#u), s=0); for(i=1, #u, if((i-1)%d==0, v[i]=s); s+=u[i]); v }
%o A397361 seq(n) = { my(v=vector(n^2+1), r=vector(n)); v[1]=1; for(d=1, n, v=step(v, d); r[d]=v[1+d^2]); r } \\ _Andrew Howroyd_, Jul 22 2026
%Y A397361 Cf. A398023.
%K A397361 nonn,new
%O A397361 1,2
%A A397361 _Oliver Navarro_, Jul 22 2026
%E A397361 a(19) onward from _Andrew Howroyd_, Jul 22 2026
