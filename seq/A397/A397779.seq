%I A397779 #31 Jul 28 2026 09:45:24
%S A397779 0,0,1,0,2,1,1,2,4,1,3,4,3,3,5,3,7,5,4,7,7,4,8,7,7,8,8,7,10,8,8,10,13,
%T A397779 8,11,13,10,11,14,10,14,14,11,14,16,11,15,16,15,15,17,15,17,17,16,17,
%U A397779 20,16,18,20,18,18,21,18,24,21,19,24,23,19,25,23,22,25,24,22,27,24,23
%N A397779 2-adic valuation of the triple factorial of n.
%C A397779 Here n!!! denotes the product of n, n-3, n-6, ..., down to the unique term in {1,2,3}. Unlike the double-factorial case, this sequence does not vanish periodically, since gcd(3,2)=1: every term of the underlying arithmetic progression can contribute to the 2-adic valuation.
%H A397779 James C. McMahon, <a href="/A397779/b397779.txt">Table of n, a(n) for n = 0..10000</a>
%H A397779 Shrey Jha, <a href="https://doi.org/10.5281/zenodo.21285250">p-adic Valuations of Generalized Multifactorials: A Legendre-Type Formula</a>, Zenodo, 2026.
%F A397779 a(n) = A007814(A007661(n)).
%F A397779 a(n) = a(n-3) + A007814(n) for n >= 3. - _Jason Yuen_, Jul 22 2026
%e A397779 a(8) = 4 since 8!!! = 8*5*2 = 80 = 2^4*5.
%p A397779 a:= proc(n) a(n):= `if`(n<2, 0, padic[ordp](n, 2)+a(n-3)) end:
%p A397779 seq(a(n), n=0..78);  # _Alois P. Heinz_, Jul 21 2026
%t A397779 a[n_]:=IntegerExponent[Times@@Range[n, 1, -3],2];Array[a,79,0] (* _James C. McMahon_, Jul 28 2026 *)
%o A397779 (Python)
%o A397779 def a(n): return sum((k&-k).bit_length()-1 for k in range(((n-1)%3+1),n+1,3))
%Y A397779 Cf. A007661, A007814, A397801.
%K A397779 nonn,easy
%O A397779 0,5
%A A397779 _Shrey Jha_, Jul 10 2026
