%I A397866 #21 Sep 12 2026 16:03:18
%S A397866 1,2,3,7,4,6,8,15,5,17,32,14,9,30,16,62,34,13,18,55,29,36,89,93,10,43,
%T A397866 31,80,87,67,58,102,35,45,79,105,19,178,56,213,188,33,37,100,90,293,
%U A397866 70,122,11,97,44,147,288,138,75,127,88,313,68,285,59,63,103,171
%N A397866 a(n) = the index m where A399458(m) = 2n-1. If 2n-1 doesn't appear in A399458, then a(n) = -1.
%C A397866 There is a high probability that all odd numbers appear in A399458, so most likely this sequence is defined for every positive integer.
%H A397866 Michael S. Branicky, <a href="/A397866/b397866.txt">Table of n, a(n) for n = 1..10000</a>
%e A397866 2*9-1 = 17. The number 17 appears at index 5 in A399458 is 5, so a(9) = 5.
%o A397866 (Python) # uses code/imports in A399458()
%o A397866 def agen(): # generator of terms
%o A397866     adict, odd = dict(), 1
%o A397866     for m, t in enumerate(A399458(), 1):
%o A397866         if t&1 and t not in adict:
%o A397866             adict[t] = m
%o A397866             while odd in adict:
%o A397866                 yield adict[odd]
%o A397866                 odd += 2
%o A397866 print(list(islice(agen(), 64))) # _Michael S. Branicky_, Sep 06 2026
%Y A397866 Cf. A399458.
%K A397866 nonn,new
%O A397866 1,2
