%H A397970 <a href="/index/Rec#order_12">Index entries for linear recurrences with constant coefficients</a>, signature (6,-12,2,27,-36,0,36,-27,-2,12,-6,1).
%F A397970 a(n) = (2*n^8 - 108*n^6 + 144*n^5 + 1996*n^4 - 4944*n^3 - 10302*n^2 + 43104*n - 33867 - (-1)^n*3*(6*n^2 - 89) )/192 for n > 2. - _Andrew Howroyd_, Jul 21 2026
%e A397970 a(3) = 1 has only one configuration:
%e A397970   X  -  X
%e A397970   -  -  -
%e A397970   X  -  X
%e A397970 Therefore a(3) = 1.
%t A397970 A397970[n_] := If[n < 3, 0, (2*n*(n*(n*(n*(n*(n^3 - 54*n + 72) + 998) - 2472) - 9*(-1)^n - 5151) + 21552) + 267*(-1)^n - 33867)/192];
