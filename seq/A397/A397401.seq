%I A397401 #19 Aug 03 2026 23:15:12
%S A397401 2,11,13,154,167,655,822,18739,38300,171939,210239,1643612,1853851,
%T A397401 5351314,7205165,329583739,666372643,2995074311,3661446954,
%U A397401 32286649943,35948096897,140130940634,176079037531,2605237466068,2781316503599,10949186976865,13730503480464
%N A397401 Denominators of the convergents given by treating A089618 as continued fraction coefficients after the leading 0.
%C A397401 Limit_{n->oo} a(n)^(1/n) seems to approach a value around 3.155.
%H A397401 Jwalin Bhatt, <a href="/A397401/b397401.txt">Table of n, a(n) for n = 1..2001</a>
%H A397401 Wikipedia, <a href="https://en.wikipedia.org/wiki/L%C3%A9vy%27s_constant">Lévy's constant</a>.
%o A397401 (Python)
%o A397401 from fractions import Fraction
%o A397401 from sympy import continued_fraction_convergents
%o A397401 def van_der_corput(n):
%o A397401     bits = bin(n)[2:][::-1]
%o A397401     d = Fraction(int(bits, 2), 1 << len(bits))
%o A397401     return int(1 / (2**d - 1))
%o A397401 coeffs = [0] + [van_der_corput(i) for i in range(1, 30)]
%o A397401 convergent_generator = continued_fraction_convergents(coeffs)
%o A397401 next(convergent_generator)
%o A397401 A397401 = [frac.denominator for frac in convergent_generator]
%Y A397401 Cf. A089618, A390652, A391510, A392259, A397337 (numerators).
%K A397401 nonn,frac
%O A397401 1,1
%A A397401 _Jwalin Bhatt_, Jul 26 2026
