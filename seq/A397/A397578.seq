%I A397578 #24 Sep 17 2026 22:19:59
%S A397578 4,30,240,55440,122522400
%N A397578 a(n) is the least k such that sigma(k) > sigma(k-1)*n and sigma(k) > sigma(k+1)*n, where sigma(k) = A000203(k) is sum of divisors of k.
%C A397578 Conjecture: a(n) exists for all n.
%e A397578 a(3) = 240 because 240 is the least x such that sigma(x) > sigma(x-1)*3 and sigma(x) > sigma(x+1)*3.
%e A397578 a(4) = 55440 because 55440 is the least x such that sigma(x) > sigma(x-1)*4 and sigma(x) > sigma(x+1)*4.
%t A397578 a[n_]:=Module[{x=1},While[DivisorSigma[1,x] <= DivisorSigma[1,x-1]*n || DivisorSigma[1,x] <= DivisorSigma[1,x+1]*n, x++]; x]; Array[a,4] (* _Stefano Spezia_, Jul 30 2026 *)
%Y A397578 Cf. A000203, A397554.
%K A397578 nonn,hard,more,new
%O A397578 1,1
%A A397578 _Alex Ratushnyak_, Jul 30 2026
