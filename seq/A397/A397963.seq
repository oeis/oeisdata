%U A397963 15,31,63,1,1,1,1,1,1,1,1,9,9,1,1,19,1,1,1,5
%N A397963 Value to the left of the rightmost longest series of 0-bits of n in binary.
%H A397963 Ruud H.G. van Tol, <a href="/A397963/b397963.txt">Table of n, a(n) for n = 0..10000</a>
%e A397963 a(17956) = 35, because 17956 = 100011000100100_2, so the value before the rightmost longest series of 0-bits is 100011_2 = 35.
%o A397963 (PARI) a(n) = my(m=0, r=n, z=0); while(n, if(n%2, z=0, if(m<z++, m=z; r=n\2)); n\=2); r;
