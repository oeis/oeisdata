%T A397843 62713,78337,86190,114793,147390,182497,184110,208537,269790,297073,
%U A397843 364777,401233,428910,479353,490110,609553,698190,755377,807457,857310,942990,974113,1093897,1126590,1156393,1354297,1432590
%N A397843 Numbers k such that sigma(k) = psi(k) + Omega(k)^4.
%C A397843 The sequence is infinite because it contains all numbers of the form 7 * 31 * p^2, where p is any prime.
%C A397843 From _Robert Israel_, Jul 20 2026: (Start)
%C A397843 Another infinite family of terms is all numbers of the form 510 * p^2 for p prime.
%C A397843 Terms not in these two infinite families include 1 and 2744.
%C A397843 Are there infinitely many terms not in the two families? (End)
%e A397843 868 is a term since sigma(868) = 1792 = 1536 + 4^4 = psi(868) + Omega(868)^4.
%p A397843 filter:= proc(k) local F,p,s,w,t;
%p A397843   F:= ifactors(k)[2];
%p A397843   p:= mul((t[1]+1)*t[1]^(t[2]-1),t=F);
%p A397843   s:= mul((t[1]^(t[2]+1)-1)/(t[1]-1),t=F);
%p A397843   w:= add(t[2],t=F);
%p A397843   s = p + w^4
%p A397843 end proc:
%p A397843 select(filter, [$1..2*10^6]); # _Robert Israel_, Jul 20 2026
%o A397843 (PARI) isok(k) = {my(f = factor(k)); sigma(f) == prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) + bigomega(f)^4; } \\ _Amiram Eldar_, Jul 12 2026
%o A397843 (Python)
%o A397843 from math import prod
%o A397843 from sympy import factorint
%o A397843 def ok(n):
%o A397843     f = factorint(n)
%o A397843     sigma = prod((p**(e+1)-1)//(p-1) for p, e in f.items())
%o A397843     Omega = sum(f.values())
%o A397843     psi = prod((p+1)*p**(e-1) for p, e in f.items())
%o A397843     return sigma == psi + Omega**4
%o A397843 # _Michael S. Branicky_, Jul 20 2026
%Y A397843 Cf. A244963 (sigma minus psi), A001222 (Omega), A389546.
%K A397843 nonn,changed
%O A397843 1,2
%A A397843 _S. I. Dimitrov_, Jul 12 2026
