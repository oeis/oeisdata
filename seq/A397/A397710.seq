%I A397710 #34 Aug 12 2026 10:38:32
%S A397710 4,9,12,20,25,28,44,45,49,52,60,63,68,76,84,92,99,116,117,121,124,132,
%T A397710 140,148,153,156,164,169,171,172,175,188,204,207,212,220,228,236,244,
%U A397710 260,261,268,275,276,279,284,289,292,308,315,316,325,332,333,340,348
%N A397710 Composite numbers k such that k = rad(k) * lpf(k), where rad = A007947 and lpf is the least prime factor of k.
%C A397710 Numbers k such that exactly 1 smaller number has the same squarefree kernel, rad(k); that is, numbers k such that A008479(k) = 2. See A397742 for further information about classifying numbers in this way.
%C A397710 Union of A001248 (prime squares) and A366825. Equivalently, numbers that can be written as the product of prime(k)^2 and a prime(k+1)-rough squarefree number for some k.
%C A397710 Without prime squares, this sequence is a proper subset of A332785 (neither squarefree nor powerful).
%H A397710 Michael De Vlieger, <a href="/A397710/b397710.txt">Table of n, a(n) for n = 1..10000</a>
%F A397710 {a(n)} = {A065642(A005117(k)) : k > 1}.
%F A397710 {a(n)} = {k : A398302(k) = 1 and A124010(k,1) = 2}. - _Peter Munn_, Aug 11 2026
%e A397710 Let r = rad(a(n)) and let L = lpf(a(n)).
%e A397710 Table of n, a(n) for n = 1..12:
%e A397710    n  a(n)   r * L
%e A397710   ------------------------------
%e A397710    1    4 =  2 * 2 = 2^2
%e A397710    2    9 =  3 * 3 = 3^2
%e A397710    3   12 =  6 * 2 = 2^2 * 3
%e A397710    4   20 = 10 * 2 = 2^2 * 5
%e A397710    5   25 =  5 * 5 = 5^2
%e A397710    6   28 = 14 * 2 = 2^2 * 7
%e A397710    7   44 = 22 * 2 = 2^2 * 11
%e A397710    8   45 = 15 * 3 = 3^2 * 5
%e A397710    9   49 =  7 * 7 = 7^2
%e A397710   10   52 = 26 * 2 = 2^2 * 13
%e A397710   11   60 = 30 * 2 = 2^2 * 3 * 5
%e A397710   12   63 = 21 * 3 = 3^2 * 7
%p A397710 filter:= proc(n) local F;
%p A397710  F:= sort( ifactors(n)[2],(s,t) -> s[1] < t[1]);
%p A397710  F[..,2] = [2, 1$(nops(F)-1)]
%p A397710 end proc:
%p A397710 select(filter, [$1..1000]); # _Robert Israel_, Jul 08 2026
%t A397710 s = Select[Range[500], First[#1] == 2 && Union[#2] == {1} & @@ TakeDrop[FactorInteger[#][[All, -1]], 1] &]; Union[s, Array[Prime[#]^2 &, PrimePi@ Sqrt[Last[s]] ] ]
%o A397710 (PARI) isok(k) = if(k < 2, 0, my(e = factor(k)[, 2]); e[1] == 2 && (#e == 1 || vecmax(e[2..#e]) == 1)); \\ _Amiram Eldar_, Jul 08 2026
%o A397710 (Python)
%o A397710 from math import prod
%o A397710 from sympy import factorint
%o A397710 def ok(k): return sum((f:=factorint(k)).values())>1 and k == min(f) * prod(f)
%o A397710 print([k for k in range(825) if ok(k)]) # _Michael S. Branicky_, Aug 04 2026
%Y A397710 Cf. A001248, A005117, A007947, A008479, A332785, A366825.
%Y A397710 Row 2 of A284311 (or A285321), sorted. See A397742 for row 3 and further related xrefs.
%Y A397710 See the formula section for the relationships with A065642, A124010, A398302.
%Y A397710 Intersection of A375396 with either A060687 or A398264..
%Y A397710 Subsequence of A067259.
%Y A397710 A397458 is the equivalent sequence with lpf(k) replaced by lpf(k)^2 in the definition.
%K A397710 nonn,easy,changed
%O A397710 1,1
%A A397710 _Michael De Vlieger_ and _Peter Munn_, Jul 07 2026
