%I A397801 #45 Jul 28 2026 09:45:20
%S A397801 0,0,0,1,0,0,1,1,0,2,1,1,1,2,1,2,1,2,3,2,1,3,3,2,2,3,3,5,2,3,4,5,2,4,
%T A397801 4,5,4,4,4,6,4,4,5,6,4,6,5,6,5,6,5,7,5,6,8,7,5,7,8,7,6,7,8,9,6,7,9,9,
%U A397801 6,8,9,9,8,8,9,10,8,8,10,10,8,12,10,10,9,12,10,11,9
%N A397801 3-adic valuation of the quadruple factorial of n.
%C A397801 a(n) is the 3-adic valuation of the quadruple factorial A007662(n) = n!!!! = n*(n-4)*(n-8)*...*r, 1<=r<=4. An explicit Legendre-type closed form for a(n) as a finite sum over prime powers 3^i, counting terms of the arithmetic progression r, r+4, ..., r+4m divisible by 3^i, is given by Theorem 4.1 (see link). For n=4k (a(4), a(8), a(12), ...), this reduces to a(4k) = A007949(k), since 3 does not divide 4 (Theorem 3.1(i)). Cf. A397779, the 2-adic valuation of the triple factorial, from the same family.
%H A397801 James C. McMahon, <a href="/A397801/b397801.txt">Table of n, a(n) for n = 0..10000</a>
%H A397801 Shrey Jha, <a href="https://doi.org/10.5281/zenodo.21285250">p-adic Valuations of Generalized Multifactorials: A Legendre-Type Formula</a>, Zenodo, 2026.
%F A397801 a(n) = A007949(A007662(n)).
%F A397801 a(n) = a(n-4) + A007949(n) for n >= 4. - _Jason Yuen_, Jul 16 2026
%e A397801 a(8) = 0 since 8!!!! = 8*4 = 32 = 32*3^0.
%p A397801 a:= proc(n) a(n):= `if`(n<3, 0, padic[ordp](n, 3)+a(n-4)) end:
%p A397801 seq(a(n), n=0..100);  # _Alois P. Heinz_, Jul 21 2026
%t A397801 a[n_]:=IntegerExponent[Times@@Range[n, 1, -4],3];Array[a,89,0] (* _James C. McMahon_, Jul 28 2026 *)
%o A397801 (Python)
%o A397801 v3 = lambda x: 0 if x % 3 else 1 + v3(x // 3)
%o A397801 a = lambda n: 0 if n < 3 else (1 if n == 3 else a(n - 4) + v3(n))
%o A397801 (PARI) seq(n) = { my(v=vector(n+1)); if(n>=3, v[4]=1); for(n=4, n, v[n+1] = v[n-3] + valuation(n,3)); v } \\ _Andrew Howroyd_, Jul 21 2026
%Y A397801 Cf. A007662, A007949, A397779.
%K A397801 nonn,easy,changed
%O A397801 0,10
%A A397801 _Shrey Jha_, Jul 10 2026
