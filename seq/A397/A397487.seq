%I A397487 #33 Aug 14 2026 23:43:31
%S A397487 54,250,375,686,1029,1715,2662,3993,4394,6591,6655,9317,9826,10985,
%T A397487 13718,14739,15379,20577,24167,24334,24565,34295,34391,36501,48013,
%U A397487 48778,54043,59582,60835,63869,73167,75449,85169,89167,89373,101306,116603,121945,133837,137842
%N A397487 Numbers with ordered prime signature (1,3).
%C A397487 Products of a prime and the cube of a larger prime.
%C A397487 Distinct from A102838, see Example note there.
%C A397487 Proper subset of A332785.
%H A397487 Michael De Vlieger, <a href="/A397487/b397487.txt">Table of n, a(n) for n = 1..10000</a>
%H A397487 <a href="/index/Pri#prime_signature">Index to sequences related to prime signature</a>
%e A397487 Table of n, a(n) for n = 1..12:
%e A397487    n    a(n)
%e A397487   --------------------
%e A397487    1     54 = 2 * 3^3
%e A397487    2    250 = 2 * 5^3
%e A397487    3    375 = 3 * 5^3
%e A397487    4    686 = 2 * 7^3
%e A397487    5   1029 = 3 * 7^3
%e A397487    6   1715 = 5 * 7^3
%e A397487    7   2662 = 2 * 11^3
%e A397487    8   3993 = 3 * 11^3
%e A397487    9   4394 = 2 * 13^3
%e A397487   10   6591 = 3 * 13^3
%e A397487   11   6655 = 5 * 11^3
%e A397487   12   9317 = 7 * 11^3
%p A397487 q:= n-> is([1,3]=sort(ifactors(n)[2])[.., 2]):
%p A397487 select(q, [$1..140000])[];  # _Alois P. Heinz_, Aug 13 2026
%t A397487 With[{nn = 140000},  Union@ Flatten@ Table[If[i == j, Nothing, If[# > nn, Nothing, #] &@ Prime[i]*Prime[j]^3], {i, PrimePi@ Surd[nn, 3]}, {j, i + 1, PrimePi[Surd[nn/Prime[i], 3] ] } ] ]
%o A397487 (Python)
%o A397487 from sympy import primepi, primerange, integer_nthroot
%o A397487 from oeis_sequences.OEISsequences import bisection
%o A397487 def A397487(n):
%o A397487     def f(x): return n+x-sum(primepi(k) if (k:=x//p**3)<p else i for i, p in enumerate(primerange(integer_nthroot(x,3)[0]+1)))
%o A397487     return bisection(f,n,n) # _Chai Wah Wu_, Aug 14 2026
%Y A397487 Cf. A007774, A030078, A065036, A102838, A332785, A397739.
%K A397487 nonn,easy,new
%O A397487 1,1
%A A397487 _Michael De Vlieger_, Aug 09 2026
