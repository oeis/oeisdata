%I A397734 #57 Aug 24 2026 00:25:04
%S A397734 1,1,2,5,8,25,38,147,216,977,1402,7203,10156,58137,80838,508259,
%T A397734 698704,4772897,6498674,47821635,64579284,508397609,681642238,
%U A397734 5708203779,7605025720,67420892721,89318058858,834851382563,1100376445564,10805769537593,14176837311158,145815170899107
%N A397734 a(n) is the number of functions f:[n] -> [n] such that f(i) = f(f(i)) = f(n+1-i) for all i in [n].
%H A397734 Osman Kelekci, <a href="https://doi.org/10.36753/mathenot.1946560">Idempotent rank of the transformations semigroup with palindromic image</a>, Math. Sci. Appl. E-Notes, 14(3) (2026), 162-166.
%F A397734 a(2*k) = Sum_{j=0..k} binomial(k, j) * 2^j * j^(k-j).
%F A397734 a(2*k+1) = Sum_{j=0..k} binomial(k, j) * 2^j * (j^(k-j+1) + (j+1)^(k-j)).
%e A397734 a(3) = 5: 111, 121, 222, 323, 333.
%e A397734 a(4) = 8: 1111, 1221, 1331, 2222, 3333, 4224, 4334, 4444.
%e A397734 a(5) = 25: 11111, 11311, 12121, 12221, 12321, 13331, 14141, 14341, 14441, 22222, 22322, 32323, 33333, 34343, 44344, 44444, 52225, 52325, 52525, 53335, 54345, 54445, 54545, 55355, 55555.
%p A397734 a := proc(n)
%p A397734     local k, j;
%p A397734     k := floor(n / 2);
%p A397734     if n mod 2 = 0 then
%p A397734         return add(binomial(k, j) * 2^j * j^(k - j), j = 0 .. k);
%p A397734     else
%p A397734         return add(binomial(k, j) * 2^j * (j^(k - j + 1) + (j + 1)^(k - j)), j = 0 .. k);
%p A397734     end if;
%p A397734 end proc:
%p A397734 seq(a(n), n=0..31);
%t A397734 a[n_] := Module[{k = Floor[n/2]},
%t A397734   If[EvenQ[n], Sum[Binomial[k, j]*2^j*j^(k - j), {j, 1, k}],
%t A397734    Sum[Binomial[k, j]*2^j*(j^(k - j + 1) + (j + 1)^(k - j)), {j, 0, k}]]]; Array[a,31]
%Y A397734 Cf. A000248 (idempotent), A078707 (palindromic), A275707 (even bisection).
%K A397734 nonn,new
%O A397734 0,3
%A A397734 _Osman Kelekci_, Jul 08 2026
