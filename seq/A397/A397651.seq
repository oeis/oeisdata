%I A397651 #32 Oct 04 2026 15:02:41
%S A397651 0,2,6,5,9,17,11,62,19,73,23,126,51,39,43,1057,47,65537,55,135,75,79,
%T A397651 103,87,139,91,533,119,111,171,1097,231,155,167,151,243,157,313,175,
%U A397651 191,287,279,301,189,183,237,399,543,535,319,365,335,499,303,363,347,317,349,351,467,311,315,441,575
%N A397651 a(n) is the least k such that exactly n distinct values can be obtained by partitioning the binary representation of k into consecutive blocks, and then multiplying the numbers represented by the blocks.
%C A397651 a(n) is the position of the first occurrence of n in A331851.
%C A397651 a(n) <= 2^(n-2) + 1 for n > 3.
%C A397651 If a(n) is even then a(n) is of the form 2^k - 2 for some k as A331851(2*m) = A331851(m) + 1 if k is of the form 2^k-1 else A331851(2*m) = A331851(m). - _David A. Corneth_, Oct 01 2026
%H A397651 Robert Israel, <a href="/A397651/b397651.txt">Table of n, a(n) for n = 1..10000</a>
%H A397651 Michael S. Branicky, <a href="/A397651/a397651_2.py.txt">Python program for OEIS A397651</a>
%H A397651 <a href="/index/Bi#binary">Index entries for sequences related to binary expansion of n</a>
%e A397651 a(6) = 17 because for k = 17 (binary 10001) there are 6 distinct values, namely:
%e A397651    0 (for the cases with a block of 0's),
%e A397651    1 (for blocks 1 and 0001),
%e A397651    2 (for 10 and 001),
%e A397651    4 (for 100 and 01),
%e A397651    8 (for 1000 and 1), and
%e A397651   17 (for one block 10001), and no smaller k works.
%e A397651 a(8) = 62 because for k = 62 (binary 111110) there are 8 distinct values, namely:
%e A397651    0 (when 0 is a block),
%e A397651    2 (for blocks 1, 1, 1, 1, 10),
%e A397651    6 (for blocks 11, 1, 1 and 10),
%e A397651   14 (for blocks 111, 1 and 10),
%e A397651   18 (for blocks 11, 11 and 10),
%e A397651   30 (for blocks 1111 and 10),
%e A397651   42 (for blocks 111 and 110), and
%e A397651   62 (for one block 111110), and no smaller k works.
%p A397651 g:= proc(n) option remember; local R,k;
%p A397651   R:=`union`({n},seq(procname(n mod 2^k) *~ floor(n/2^k), k=1..ilog2(n)));
%p A397651   if not member(0,R) and n+1 <> 2^ilog2(n+1) then R:= R union {0} fi;
%p A397651   R
%p A397651 end proc:
%p A397651 f:= n -> nops(g(n)):
%p A397651 V:= Vector(100): count:= 1:
%p A397651 for i from 1 while count < 100 do
%p A397651   v:= f(i);
%p A397651   if v > 1 and v <= 100 and V[v] = 0 then
%p A397651     V[v]:= i; count:= count+1;
%p A397651   fi;
%p A397651 od:
%p A397651 convert(V,list);
%o A397651 (Python) # see linked program
%Y A397651 Cf. A331851.
%K A397651 nonn,new
%O A397651 1,2
%A A397651 _Robert Israel_, Sep 28 2026
