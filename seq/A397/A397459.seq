%I A397459 #27 Aug 04 2026 21:15:40
%S A397459 16,48,80,81,112,176,208,240,272,304,336,368,405,464,496,528,560,567,
%T A397459 592,624,625,656,688,752,816,848,880,891,912,944,976,1040,1053,1072,
%U A397459 1104,1136,1168,1232,1264,1328,1360,1377,1392,1424,1456,1488,1520,1539,1552,1616
%N A397459 Numbers k of the form lpf(k)^3 * rad(k), where rad = A007947 and lpf is the least prime factor of k.
%C A397459 Numbers of the form lpf(m)^3 * m where m > 1 is squarefree.
%C A397459 Superset of A030514 (fourth power of primes).
%C A397459 {a(n)} \ A030514 is a proper subset of A332785.
%C A397459 Unsorted prime signature of a(n) is 4, followed by omega(a(n))-1 ones, where omega = A001221 is the number of distinct prime factors.
%H A397459 Michael De Vlieger, <a href="/A397459/b397459.txt">Table of n, a(n) for n = 1..10000</a>
%e A397459 Table of n, a(n) for n = 1..12:
%e A397459    n   a(n)
%e A397459   ----------------------
%e A397459    1    16 = 2^4
%e A397459    2    48 = 2^4 * 3
%e A397459    3    80 = 2^4 * 5
%e A397459    4    81 = 3^4
%e A397459    5   112 = 2^4 * 7
%e A397459    6   176 = 2^4 * 11
%e A397459    7   208 = 2^4 * 13
%e A397459    8   240 = 2^4 * 3 * 5
%e A397459    9   272 = 2^4 * 17
%e A397459   10   304 = 2^4 * 19
%e A397459   11   336 = 2^4 * 3 * 7
%e A397459   12   368 = 2^4 * 23
%e A397459 .
%e A397459 1 is not a term since it does not have any prime factors.
%t A397459 nn = 1700; k = 2^3; mm = nn/k; Union@ Map[If[# <= nn, #, Nothing] &[#*FactorInteger[#][[1, 1]]^3] &, Select[Range[2, mm], SquareFreeQ] ]
%o A397459 (Python)
%o A397459 from math import prod
%o A397459 from sympy import factorint
%o A397459 def ok(k): return (lpf:=min((f:=factorint(k)), default=0)) and k == lpf**3 * prod(f)
%o A397459 print([k for k in range(825) if ok(k)]) # _Michael S. Branicky_, Aug 04 2026
%Y A397459 Cf. A005117, A007947, A020639, A030514, A332785.
%K A397459 nonn,easy,new
%O A397459 1,1
