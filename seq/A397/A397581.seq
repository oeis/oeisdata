%S A397581 0,2,7,19,46,104,225,473,973,1983,4015,8093,16265,32627,65371,130881,
%T A397581 261925,524039,1048295,2096837,4193953,8388219,16776787,33553961,
%U A397581 67108349,134217167,268434847,536870253,1073741113,2147482883,4294966475,8589933713,17179868245
%N A397581 Largest m such that one defective in an m-item set and one in a disjoint 6-item set can always be identified in at most n adaptive tests, each returning the number of defectives in a selected subset (0 if no positive m is feasible).
%H A397581 Paolo Xausa, <a href="/A397581/b397581.txt">Table of n, a(n) for n = 2..1000</a>
%H A397581 Fedor Karpelevitch, <a href="https://arxiv.org/abs/2611.09076">Quantitative group testing with a fixed shore: sharp asymptotics and exact formulas</a>, arXiv:2611.09076 [math.CO], 2026.
%H A397581 Fedor Karpelevitch, <a href="https://doi.org/10.5281/zenodo.23996093">Evidence for quantitative group testing with a fixed shore: sharp asymptotics and exact formulas</a>, version 1.0.0, 2026.
%H A397581 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (5,-9,7,-2).
%F A397581 a(n) = 2^n - n*(n-1)/2 - 3 for 2 <= n <= 8.
%F A397581 a(n) = 2^n - n^2 + 7*n - 21 for n >= 9 (Karpelevitch, Theorem 1.2).
%F A397581 From _Jianing Song_, Nov 10 2026: (Start)
%F A397581 a(n) = 5*a(n-1) - 9*a(n-2) + 7*a(n-3) - 2*a(n-4) for n >= 13.
%F A397581 G.f.: x^3*(2 - 3*x + 2*x^2 - 3*x^7 + 8*x^8 - 4*x^9)/((1 - x)^3*(1 - 2*x)).
%F A397581 E.g.f.: exp(2*x) - (x^2 - 6*x + 21)*exp(x) - (x^8 + 12*x^7 + 84*x^6 + 336*x^5 - 10080*x^3 - 70560*x^2 - 262080*x - 403200)/20160. (End)
%t A397581 A397581[n_] := 2^n - If[n < 9, n*(n - 1)/2 + 3, n*(n - 7) + 21];
%t A397581 Array[A397581, 35, 2] (* _Paolo Xausa_, Nov 21 2026 *)
%t A397581 (* Alternative: *)
%t A397581 LinearRecurrence[{5, -9, 7, -2}, {0, 2, 7, 19, 46, 104, 225, 473, 973, 1983, 4015}, 35] (* _Paolo Xausa_, Nov 21 2026 *)
