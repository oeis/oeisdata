%I A397458 #31 Aug 13 2026 20:56:46
%S A397458 8,24,27,40,56,88,104,120,125,135,136,152,168,184,189,232,248,264,280,
%T A397458 296,297,312,328,343,344,351,376,408,424,440,456,459,472,488,513,520,
%U A397458 536,552,568,584,616,621,632,664,680,696,712,728,744,760,776,783,808,824
%N A397458 Numbers k of the form lpf(k)^2 * rad(k), where rad = A007947 and lpf is the least prime factor of k.
%C A397458 Numbers of the form lpf(m)^2 * m where m > 1 is squarefree.
%C A397458 Superset of A030078 (prime cubes).
%C A397458 {a(n)} \ A030078 is a proper subset of A332785 (numbers neither squarefree nor powerful).
%C A397458 Unsorted prime signature of a(n) is 3, followed by omega(a(n))-1 ones, where omega = A001221 is the number of distinct prime factors.
%H A397458 Michael De Vlieger, <a href="/A397458/b397458.txt">Table of n, a(n) for n = 1..10000</a>
%F A397458 {a(n)} = {k : A398302(k) = 1 and A124010(k,1) = 3}. - _Peter Munn_, Aug 12 2026
%e A397458 Table of n, a(n) for n = 1..12:
%e A397458    n   a(n)
%e A397458   ----------------------
%e A397458    1     8 = 2^3
%e A397458    2    24 = 2^3 * 3
%e A397458    3    27 = 3^3
%e A397458    4    40 = 2^3 * 5
%e A397458    5    56 = 2^3 * 7
%e A397458    6    88 = 2^3 * 11
%e A397458    7   104 = 2^3 * 13
%e A397458    8   120 = 2^3 * 3 * 5
%e A397458    9   125 = 5^3
%e A397458   10   135 = 3^3 * 5
%e A397458   11   136 = 2^3 * 17
%e A397458   12   152 = 2^3 * 19
%e A397458 .
%e A397458 1 is not a term since it does not have any prime factors.
%t A397458 nn = 1000; k = 2^2; mm = nn/k; Union@ Map[If[# <= nn, #, Nothing] &[#*FactorInteger[#][[1, 1]]^2] &, Select[Range[2, mm], SquareFreeQ] ]
%o A397458 (Python)
%o A397458 from math import prod
%o A397458 from sympy import factorint
%o A397458 def ok(k): return (lpf:=min((f:=factorint(k)), default=0)) and k == lpf**2 * prod(f)
%o A397458 print([k for k in range(825) if ok(k)]) # _Michael S. Branicky_, Aug 04 2026
%Y A397458 Cf. A005117, A007947, A020639, A030078, A124010, A332785, A398302.
%Y A397458 Intersection of A375396 with either A048109 or A195086.
%Y A397458 Subsequence of A386800.
%Y A397458 Equivalent sequences with other exponents of lpf(k) in the definition: A397710 (1), A397459 (3), A398443 (4).
%K A397458 nonn,easy,new
%O A397458 1,1
