%S A397135 1,0,3,0,19,22,127,264,734,1674,3640,7726,15872,32222,64961,130442,
%T A397135 261475,523570,1047815,2096346,4193451,8387708,16776269,33553438,
%U A397135 67107823,134216640
%N A397135 Number of words of length n in S, such that S is a set containing the word ab and if a word w of the form xy is in S then w* of the form x(k^r)y is in S where k^r is the reversal of some factor k of w with |k| > 1.
%C A397135 Here xy is some factorization of the word w into potentially empty factors x and y.
%H A397135 John Tyler Rascoe, <a href="/A397135/a397135_2.py.txt">Python code</a>.
%e A397135 a(2) = 1: ab.
%e A397135 a(4) = 3: abab, abba, baab.
%e A397135 a(6) = 19: babaab, bbaaab, baabab, baabba, abbaab, baaabb, aabaab, baaaab, baabaa, ababab, ababba, aabbab, abaabb, abbaba, abbbaa, aabbba, bbabba, abbbba, abbabb.
%o A397135 (Python) # see links
%o A397135 (Python)
%o A397135 from itertools import count, islice
%o A397135 def agen(): # generator of terms
%o A397135     S = {2: {"ab"}}
%o A397135     yield 1
%o A397135     for n in count(3):
%o A397135         S[n] = set()
%o A397135         for i in range((n+1)//2, n-1):
%o A397135             for w in S[i]:
%o A397135                 for j in range(len(w)+1):
%o A397135                     x, y = w[:j], w[j:]
%o A397135                     for m in range(2*i-n+1):
%o A397135                         k = w[m:m+n-i]
%o A397135                         S[n].add(x+k[::-1]+y)
%o A397135         yield len(S[n])
%o A397135 print(list(islice(agen(), 15))) # _Michael S. Branicky_, Aug 02 2026
