%S A397827 1,1,1,1,1,1,1,2,2,1,1,3,3,3,1,1,5,20,20,5,1,1,8,216,27,216,8,1,1,13,
%T A397827 3835,2360,2360,3835,13,1,1,21,108528,17162928,3321,17162928,108528,
%U A397827 21,1,1,34,5022446,3683006183285,79784048,79784048,3683006183285,5022446,34,1
%N A397827 Triangle read by rows: T(n,k) is the denominator of R(n,k), where R(n,0) = R(n,n) = 1 and R(n+1,k) = 1/R(n,k-1) + 1/R(n,k).
%C A397827 The second column is R(n,1) = F(n+1)/F(n) for n>=1, so A(n,1) = F(n). By symmetry, A(n,n-1) = F(n). This is the Fibonacci connection to A000045.
%C A397827 The linear index of A(n,k) is m = n*(n+1)/2 + k.
%C A397827 Companion numerator sequence: A393538. This array is not the entrywise reciprocal of Pascal's triangle.
%H A397827 Naveed Javeed, <a href="https://doi.org/10.5281/zenodo.22057245">A Reciprocal-Addition Pascal Triangle: Continued Fractions and Diagonal Limits</a>, Zenodo, 2026.
%H A397827 Naveed Javeed, <a href="https://github.com/najaweed/reciprocal-pascal">Source, exact tests and Lean formalization</a>.
%F A397827 T(n,k) = denominator(R(n,k)), where R(n,0) = R(n,n) = 1 for n>=0, and R(n+1,k) = 1/R(n,k-1) + 1/R(n,k) for n>=1 and 1<=k<=n.
%e A397827 The first rows of R are
%e A397827   [1],
%e A397827   [1,1],
%e A397827   [1,2,1],
%e A397827   [1,3/2,3/2,1],
%e A397827   [1,5/3,4/3,5/3,1];
%e A397827 hence the denominator rows are
%e A397827   [1],
%e A397827   [1,1],
%e A397827   [1,1,1],
%e A397827   [1,2,2,1],
%e A397827   [1,3,3,3,1].
%o A397827 (Python)
%o A397827 from fractions import Fraction
%o A397827 def rows(m):
%o A397827     row = [Fraction(1)]
%o A397827     for _ in range(m + 1):
%o A397827         yield row
%o A397827         inv = [1/x for x in row]
%o A397827         row = [inv[0]] + [inv[k-1] + inv[k] for k in range(1, len(row))] + [inv[-1]]
%o A397827 print([x.denominator for row in rows(9) for x in row])
%Y A397827 Cf. A000045 (Fibonacci numbers), A007318 (Pascal triangle read by rows), A393538 (numerators).
%K A397827 nonn,tabl,frac,new
%O A397827 0,8
%A A397827 _Naveed Javeed_, Aug 24 2026
