%T A397155 17,3,2,5,37,2,11,5,2,5,2,5,2,3,2,3,2,13,2,3,109,7,151,5,2,3,2,5,73,2,
%U A397155 2,19,13,2,2,7,5,3,2,3,97,5,3,19,2,3,19,17,2,7,2,3,109
%N A397155 Least prime p such that n^3 - p is semiprime.
%C A397155 A semiprime is a positive integer that is the product of exactly two primes, not necessarily distinct.
%C A397155 This sequence is motivated by the computational conjecture that for every positive integer cube greater than 1, there exist primes p, q and r, such that n^3 = p*q + r.
%C A397155 Equivalently, a(n) is the least prime r for which there exist primes p and q satisfying n^3 = p*q + r.
%H A397155 James C. McMahon, <a href="/A397155/b397155.txt">Table of n, a(n) for n = 2..10000</a>
%F A397155 a(n) = A398353(n^3).
%e A397155 a(2) = 2 because 8 = 2*3 + 2.
%e A397155 a(3) = 2 because 27 = 5*5 + 2.
%e A397155 a(4) = 2 because 64 = 2*31 + 2.
%e A397155 a(5) = 2 because 125 = 3*41 + 2.
%e A397155 a(6) = 2 because 216 = 2*107 + 2.
%e A397155 a(7) = 2 because 343 = 11*31 + 2.
%e A397155 a(8) = 7 because 512 = 5*101 + 7.
%e A397155 a(9) = 11 because 729 = 2*359 + 11.
%e A397155 a(10) = 7 because 1000 = 3*331 + 7.
%t A397155 a[n_]:=Module[{p=2},While[PrimeOmega[n^3-p]!=2,p=NextPrime[p]];p];Array[a,82,2] (* _James C. McMahon_, Aug 12 2026 *)
%o A397155 (Python)
%o A397155 from sympy import primerange, factorint
%o A397155 def semiprime(n):
%o A397155     return sum(factorint(n).values()) == 2
%o A397155 def a(n):
%o A397155     cube = n**3
%o A397155     for r in primerange(2, cube):
%o A397155         if semiprime(cube - r):
%o A397155             return r
%o A397155 (PARI) a(n) = my(c=n^3); forprime(p=1, c, if ((c>p) && (bigomega(c-p)==2), return(p))); \\ _Michel Marcus_, Aug 05 2026
%Y A397155 Cf. A000040, A001358, A398353.
