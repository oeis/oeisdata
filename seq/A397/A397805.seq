%S A397805 6,12,15,18,21,24,30,35,36,42,45,48,54,55,60,63,65,66,72,75,77,78,84,
%T A397805 85,90,91,95,96,102,105,108,114,115,119,120,126,132,133,135,138,143,
%U A397805 144,147,150,156,161,162,165,168,174,175,180,186,187,189,192,195,198
%N A397805 Composite numbers whose 3rd smallest divisor is less than the square of their least prime factor.
%C A397805 Terms have 2 or more distinct prime factors and the 2nd smallest of these is the specified 3rd smallest divisor.
%C A397805 Superset of A138109.
%C A397805 Arranging the terms in rows according to their squarefree kernel (A007947) we get A395978.
%H A397805 Michael De Vlieger, <a href="/A397805/b397805.txt">Table of n, a(n) for n = 1..10000</a>
%F A397805 {a(n)} = {k in A002808 : A292269(k) < A088377(k)}.
%t A397805 Select[Range[200], If[PrimeNu[#] < 2, False, #2 < #1^2 & @@ FactorInteger[#][[1 ;; 2, 1]] ] &]
%Y A397805 Cf. A002808, A007947, A088377, A292269, A395978, A397739 (squarefree terms), A397962 (complement).
%Y A397805 Subsequence of A119316, A253567.
%Y A397805 A138109 is a subsequence.
%K A397805 nonn,easy,new
%O A397805 1,1
%A A397805 _Peter Munn_ and _Michael De Vlieger_, Aug 13 2026
