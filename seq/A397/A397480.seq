%S A397480 1,1,1,2,1,1,7,1,1,1,1,2,13,1,1,2,17,1,19,1,1,1,1,1,5,1,3,2,1,1,31,4,
%T A397480 1,17,1,1,37,19,1,1,1,1,43,1,1,1,47,1,49,1,1,2,1,1,1,1,19,1,59,1,61,
%U A397480 31,1,8,1,1,67,1,1,1,71,1,73,1,1,38,7,1,79,2,1
%N A397480 a(n) = n/m for the smallest m such that denominator(B_{2m}) = denominator(B_{2n}), where B_k is the k-th Bernoulli number.
%C A397480 The numbers 2m for which a(m) = 1 are A248614 >= 2.
%C A397480 Numbers n such that a(n) = n are A045979.
%C A397480 Numbers n such that a(2n) = n are A119480.
%C A397480 Every term a(2^k) is a power of 2.
%H A397480 Amiram Eldar, <a href="/A397480/b397480.txt">Table of n, a(n) for n = 1..10000</a>
%F A397480 a(n) = 2*n/lambda(denominator(B_{2n})) = 2*n/A002322(A002445(n)) for n >= 1.
%F A397480 a(2^k) = 2^m, where m = 0 for k = 2^n-1 with n = 0, 1, 2, 3, and 4.
%t A397480 a[n_] := 2*n / CarmichaelLambda[Denominator[BernoulliB[2*n]]]; Array[a, 81] (* _Amiram Eldar_, Aug 11 2026 *)
%o A397480 (PARI) den(n) = if(n == 0 || (n > 1 && n % 2), 1, vecprod(select(x -> isprime(x), apply(x -> x + 1, divisors(n))))); \\ A027642
%o A397480 lambda(n) = lcm(znstar(n)[2]); \\ A002322
%o A397480 a(n) = 2*n/lambda(den(2*n)); \\ _Amiram Eldar_, Aug 11 2026
%Y A397480 Cf. A002322, A002445, A027642, A045979 (subsequence), A119480 (subsequence), A248614.
%K A397480 nonn
%O A397480 1,4
