%I A299926 #26 Sep 28 2026 00:02:39
%S A299926 1,4,14,60,252,1212,5880,30904,166976,952456,5587840,34217216,
%T A299926 215204960,1401551376,9360467760,64384034784,453328282624,
%U A299926 3274696185568,24173219998912,182546586425408,1406448980797920,11060842204732544,88619852551618432,723463103122655040,6009275802881204032
%N A299926 a(n) is the number of normal generalized Young tableaux of size n with all rows and columns weakly increasing and all regions skew partitions.
%C A299926 If y is an integer partition of n, a generalized Young tableau of shape y is an array obtained by replacing the dots in the Ferrers diagram of y with positive integers. A tableau is normal if its entries span an initial interval of positive integers.
%H A299926 Vladeta Jovovic, <a href="/A299926/b299926.txt">Table of n, a(n) for n = 1..70</a>
%e A299926 The a(3) = 14 tableaux:
%e A299926   1 2 3   1 2 2   1 1 2   1 1 1
%e A299926   .
%e A299926   1 3   1 2   1 2   1 2   1 1   1 1
%e A299926   2     3     2     1     2     1
%e A299926   .
%e A299926   1   1   1   1
%e A299926   2   2   1   1
%e A299926   3   2   2   1
%p A299926 with(combinat):
%p A299926 R := proc(L)
%p A299926     local i, r;
%p A299926     r := [];
%p A299926     for i to nops(L) do
%p A299926         if i = nops(L) or L[i] > L[i+1] then
%p A299926             r := [op(r), i]
%p A299926         fi
%p A299926     od;
%p A299926     r
%p A299926 end:
%p A299926 remove := proc(L, S)
%p A299926     local M, i;
%p A299926     M := L;
%p A299926     for i in S do
%p A299926         M := subsop(i = M[i]-1, M)
%p A299926     od;
%p A299926     select(x -> x > 0, M)
%p A299926 end:
%p A299926 c := proc(L)
%p A299926     option remember;
%p A299926     local Q, k, S, M, t, s;
%p A299926     if nops(L) = 0 then
%p A299926         return 1
%p A299926     fi;
%p A299926     Q := R(L);
%p A299926     s := 0;
%p A299926     for k to nops(Q) do
%p A299926         for S in choose(Q, k) do
%p A299926             M := remove(L, S);
%p A299926             if nops(M) = 0 then
%p A299926                 t := 1
%p A299926             else
%p A299926                 t := 2*c(M)
%p A299926             fi;
%p A299926             s := s + (-1)^(k+1)*t
%p A299926         od
%p A299926     od;
%p A299926     s
%p A299926 end:
%p A299926 a := n -> add(c(L), L in partition(n)):
%p A299926 seq(a(n), n=1..30); # _Vladeta Jovovic_, Sep 27 2026
%t A299926 undptns[y_]:=DeleteCases[Select[Tuples[Range[0,#]&/@y],OrderedQ[#,GreaterEqual]&],0,{2}];
%t A299926 chn[y_]:=Join[{{{},y}},Join@@Function[c,Append[#,y]&/@chn[c]]/@Take[undptns[y],{2,-2}]];
%t A299926 Table[Sum[Length[chn[y]],{y,IntegerPartitions[n]}],{n,8}]
