%N A238207 Square array T(n,k), n>=0, k>=0, read by antidiagonals, where T(0,k) is A032766(k) and T(n,k) = 3*T(n-1,k) + 2 for n>0.
%C A238207 Permutation of nonnegative integers.
%F A238207 T(n,k) = T(0,k)*3^n + T(n,0) where T(0,k) = A032766(k) and T(n,0) = 3^n - 1 = A024023(n).
%e A238207 Square array begins:
%e A238207      0,    1,    3,     4,     6,     7,     9,    10, ...
%e A238207      2,    5,   11,    14,    20,    23,    29,    32, ...
%e A238207      8,   17,   35,    44,    62,    71,    89,    98, ...
%e A238207     26,   53,  107,   134,   188,   215,   269,   296, ...
%e A238207     80,  161,  323,   404,   566,   647,   809,   890, ...
%e A238207    242,  485,  971,  1214,  1700,  1943,  2429,  2672, ...
%e A238207    728, 1457, 2915,  3644,  5102,  5831,  7289,  8018, ...
%e A238207   2186, 4373, 8747, 10934, 15308, 17495, 21869, 24056, ...
%e A238207   ...
%t A238207 T[0,n_]:=(6n - 1 + (-1)^n)/4; T[n_,0]:=3^n - 1; T[n_,k_]:=T[n,k]=T[0,k]*3^n + T[n,0]; Table[Reverse[Table[T[n-k,k],{k,0,n}]],{n,0,9}]//Flatten (* _Stefano Spezia_, Oct 16 2026 *)
