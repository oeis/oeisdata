%S A160133 1,6,8,13,14,15,16,17,19,20,21,22,23,25,27,29,31,32,33,35,37,40,41,42,
%T A160133 43,44,45,46,47,49,50,51,53,54,55,57,59,61,62,63,64,65,67,69,71,73,74,
%U A160133 75,76,77,79,81,83,85,87,89,90,91,92,93,95,97,99,100,101,103,104,105
%N A160133 Values k such that A001065(x) = k has more than one solution.
%C A160133 Numbers k with A048138(k) >= 2. Numbers k which occur in A001065 more than once. Number 1 and numbers k = A160095(n) with A160095(n+1) - A160095(n) = 0.
%H A160133 Amiram Eldar, <a href="/A160133/b160133.txt">Table of n, a(n) for n = 1..10000</a>
%e A160133 a(3) = 8 as the multiplicity of the value 8 is 2: 8 = A001065(10) = A001065(49).
%t A160133 seq[nmax_] := Module[{v = Table[0, nmax], s}, Do[s = DivisorSigma[1, k] - k; If[s <= nmax, v[[s]]++], {k, 2, nmax^2}]; Position[v, _?(# > 1 &)] // Flatten]; seq[105] (* _Amiram Eldar_, Sep 06 2026 *)
%o A160133 (PARI) {z=105; v=vector(z); for(n=1, z^2, a=sigma(n)-n; if(0<a&&a<=z, v[a]++)); for(j=1, z, if(v[j]>1, print1(j, ",")))} \\ _Klaus Brockhaus_, May 26 2009
%Y A160133 Cf. A001065, A048138, A160095.
%K A160133 nonn,changed
%O A160133 1,2
