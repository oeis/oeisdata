%I A160930 #17 Aug 07 2026 13:27:38
%S A160930 3,6,9,12,15,18,21,24,18,30,33,54,75,96,117,138,159,180,102,123,45,66,
%T A160930 87,108,129,150,171,192,114,135,57,78,99,120,141,162,183,204,126,147,
%U A160930 69,90,111,132,153,174,195,216,138,159,81,102,123,144,165,186,207,228,150
%N A160930 a(n) = n + reversal(n-1) + reversal(n+1).
%H A160930 Chris R. Rehmann, <a href="/A160930/b160930.txt">Table of n, a(n) for n = 1..10000</a>
%e A160930 Let R(k) = the reversal of k. Then
%e A160930 a(8) = 8 + R(7) + R(9) = 8 + 7 + 9 = 24.
%e A160930 a(15) = 15 + R(14) + R(16) = 15 + 41 + 61 = 117.
%e A160930 a(26) = 26 + R(25) + R(27) = 26 + 52 + 72 = 150.
%t A160930 Table[n+IntegerReverse[n-1]+IntegerReverse[n+1],{n,60}] (* Requires Mathematica version 10 or later *) (* _Harvey P. Dale_, Dec 16 2017 *)
%o A160930 (MATLAB)
%o A160930 N = 59; % N < 2^53-1
%o A160930 reversal = @(x) str2num(flip(num2str(x)));
%o A160930 a = arrayfun(@(n) n+reversal(n-1)+reversal(n+1),1:min(N,flintmax-1));
%o A160930 disp(regexprep(num2str(a), ' +', ', ')) % _Chris R. Rehmann_, Aug 07 2026
%o A160930 (Python)
%o A160930 def R(n): return int(str(n)[::-1])
%o A160930 def a(n): return n + R(n-1) + R(n+1)
%o A160930 print([a(n) for n in range(1, 60)]) # _Michael S. Branicky_, Aug 07 2026
%Y A160930 Cf. A004086.
%K A160930 nonn,base
%O A160930 1,1
%A A160930 _Claudio Meller_, May 30 2009
