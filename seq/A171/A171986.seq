%S A171986 1,1,12,11,22,11,24,13,22,31,42,11,24,13,22,31,42,11,24,13,22,31,46,
%T A171986 15,24,33,42,51,62,11,26,15,24,33,42,51,64,13,22,31,42,11,24,13,22,31,
%U A171986 46,15,24,33,42,51,66,15,24,33,42,51,62,11,26,15,24,33,42,51,64,13,22,31
%N A171986 Concatenate distance to previous prime & distance to next prime. If no previous prime, use 0.
%H A171986 Harvey P. Dale, <a href="/A171986/b171986.txt">Table of n, a(n) for n = 1..1000</a>
%e A171986 a(7)=24 as 5 is largest previous prime to 7, distance is 2, & 11 is smallest next prime to 7, distance 4. Concatenate 2 & 4 gives 24.
%t A171986 ccat[n_]:=With[{np=NextPrime[n]-n},(n-NextPrime[n,-1])10^IntegerLength[np]+np]; Join[{1,1},Array[ccat,70,3]] (* _Harvey P. Dale_, Oct 05 2026 *)
%K A171986 nonn,base,changed
%O A171986 1,3
