%U A166707 29171,30261,30271,161051,30471,161161,31571,53361,53371,53471,53571
%N A166707 Totally multiplicative sequence with a(p) = a(p-1) + 10 for prime p.
%H A166707 Andrew Howroyd, <a href="/A166707/b166707.txt">Table of n, a(n) for n = 1..10000</a>
%F A166707 Multiplicative with a(p^e) = (a(p-1)+10)^e. If n = Product p(k)^e(k) then a(n) = Product (a(p(k)-1)+10)^e(k).
%t A166707 f[p_, e_] := (a[p-1] + 10)^e; a[1] = 1; a[n_] := a[n] = Times @@ f @@@ FactorInteger[n]; Array[a, 39] (* _Amiram Eldar_, Nov 10 2026 *)
%o A166707 (PARI) lista(n)={my(a=vector(n)); for(n=1, n, my(f=factor(n)); a[n] = prod(i=1, #f~, my([p,e]=f[i,]); (a[p-1] + 10)^e)); a} \\ _Andrew Howroyd_, Nov 16 2025
%Y A166707 Cf. A166699.
%K A166707 nonn,mult,changed
