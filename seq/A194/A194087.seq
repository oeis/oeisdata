%N A194087 G.f.: eta(q)*eta(q^4)*eta(q^16)*eta(q^64)*eta(q^256)*eta(q^1024)*..., where eta(q) = Product_{m=1..oo} (1 - q^m).
%C A194087 eta(q) = A(q)/A(q^4), where A(q) is the g.f. for this sequence (cf. A010815).
%H A194087 Seiichi Manyama, <a href="/A194087/b194087.txt">Table of n, a(n) for n = 0..10000</a>
%F A194087 A(q) = Product_{n >= 1} (1 - q^n)^(v_4(4*n)), where v_4(n) denotes the 4-adic valuation of n. - _Peter Bala_, Sep 29 2026
%p A194087 with(padic):
%p A194087 seq(coeftayl(series(mul((1 - x^k)^ordp(4*k,4), k = 1..100), x, 101), x = 0, n), n = 0..100); # _Peter Bala_, Sep 29 2026
