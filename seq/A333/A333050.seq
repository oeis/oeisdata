%T A333050 114,115,142,143,156,157,219,220,221,242,289,303,318,319,380,408,423,
%U A333050 424,536,537,559,575,677,678,725,726,842,890,919,920,1064,1087,1107,1169,1327,1328
%N A333050 a(1) = 1; a(n+1) = Sum_{d|n, gcd(d, n/d) = 1} a(d).
%H A333050 Robert Israel, <a href="/A333050/b333050.txt">Table of n, a(n) for n = 1..10000</a>
%p A333050 f:= proc(n) option remember; local F,i,nF;
%p A333050     F:= map(t -> t[1]^t[2],ifactors(n-1)[2]);
%p A333050     nF:= nops(F);
%p A333050     F:= map(s -> mul(F[i],i=s), combinat:-powerset({$1..nF}) );
%p A333050     add(procname(i), i=F)
%p A333050 end proc:
%p A333050 f(1):= 1:
%p A333050 map(f, [$1..100]); # _Robert Israel_, Oct 11 2026
%t A333050 a[1] = 1; a[n_] := a[n] = Sum[If[GCD[(n - 1)/d, d] == 1, a[d], 0], {d, Divisors[n - 1]}]; Table[a[n], {n, 1, 60}]
%Y A333050 Cf. A003238, A325446.
