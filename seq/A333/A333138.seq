%I A333138 #13 Oct 02 2026 23:49:59
%S A333138 17,2,5,1,4,1,5,1,1,3,2,4,2,3,4,11,1,4,4,1,2,5,4,2,3,3,1,8,2,1,3,1,1,
%T A333138 2,1,1,1,1,3,3,5,1,1,2,1,2,1,6,7,2,4,2,1,1,1,8,1,2,4,1,7,2,1,1,1,2,4,
%U A333138 2,3,7,8,1,6,1,4,1,3,5,1,2,1,1,5,3,3,4,1
%N A333138 a(n) is the length of n-th run of increasing terms of A318199.
%C A333138 From _Lien-Hung Su_, Sep 26 2026: (Start)
%C A333138 For every fixed integer r >= 1, there are infinitely many k such that a(k) >= r. Consequently, limsup_{k->oo} a(k) = oo.
%C A333138 For every fixed integer K >= 1, there are infinitely many j such that a(j) = a(j+1) = ... = a(j+K-1) = 1. Consequently, liminf_{k->oo} a(k) = 1. (End)
%H A333138 Lien-Hung Su, <a href="https://doi.org/10.5281/zenodo.22959712">Unbounded Values and Arbitrarily Long Blocks of Ones in a Prime-Generated Run-Length Sequence</a>, Zenodo, 2026.
%t A333138 b[n_]:=Floor[n^(Prime[n]/n)]; a={}; nmax=344;For[i=1,i<=nmax,i++,{For[j=1,b[j+i-1]<=b[j+i],j++],i+=j,AppendTo[a,j]}];a
%Y A333138 Cf. A318199.
%K A333138 nonn,changed
%O A333138 1,1
%A A333138 _Stefano Spezia_, Mar 09 2020
