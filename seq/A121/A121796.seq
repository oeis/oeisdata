%I A121796 #29 Nov 05 2026 13:50:22
%S A121796 1,1,6,22,224,88,984,2320,10896,79296,98064,811728,2506032,14823648,
%T A121796 109131840,59294592,495821952,1228822272,5669754624,5669754624,
%U A121796 5669754624,5669754624,5669754624,5669754624,69265877760,132862000896
%N A121796 Upper-right entry of M(n)*M(n-1)*...*M(1), where M(n) cycles through the 2 X 2 matrices with entries in {0,1,2,3,4} and determinant 1 modulo 5, in cyclic row-wise lexicographic order starting with M(1) = [[0,1],[4,1]].
%H A121796 Meghanto Majumder, <a href="/A121796/b121796.txt">Table of n, a(n) for n = 1..720</a>
%H A121796 Andrzej Kozlowski, <a href="https://forums.wolfram.com/mathgroup/archive/2006/Aug/msg00440.html">Re: too many special linear matrices</a>, Mathematica forum, Aug 17 2006.
%F A121796 From _Meghanto Majumder_, Oct 28 2026: (Start)
%F A121796 a(n+240) = T*a(n+120) - D*a(n), where T = 32743066297458768538836621759215483363787279461642741472805907047907328 and D = 2^152*3^54*7^2*11^2. These constants are the trace and determinant of M(120)*...*M(1).
%F A121796 a(n+120) = -a(n) (mod 5). The sequence modulo 5 has least period 240.
%F A121796 a(120k+19) = a(120k+20) = ... = a(120k+24) for k >= 0.
%F A121796 lim_{n->infinity} a(n)^(1/n) = ((T + sqrt(T^2 - 4*D))/2)^(1/120) = 3.8692429019595844498... .
%F A121796 The o.g.f. is rational with reduced denominator 1 - T*x^120 + D*x^240. (End)
%e A121796 M(1) = [[0,1],[4,1]], M(2) = [[0,1],[4,2]], and M(3) = [[0,1],[4,3]].
%e A121796 M(2)*M(1) = [[4,1],[8,6]] and M(3)*M(2)*M(1) = [[8,6],[40,22]], giving a(1) = 1, a(2) = 1, a(3) = 6.
%t A121796 SL[n_, p_] := Module[{vars = Table[Unique[ a], {n^2}], iters, mat}, iters = Map[{#, 0, p - 1} &, vars]; mat = Partition[vars, n]; Reap[ Do[If[Det[mat, Modulus -> p] == 1, Sow[mat], Continue[]], Evaluate[Sequence @@ iters]]][[2, 1]]]
%t A121796 a0 = SL[2, 5];
%t A121796 M[n_] := a0[[1 + Mod[n, Length[a0]]]]
%t A121796 v[1] = {1, 1}
%t A121796 v[n_] := v[n] = M[n].v[n - 1]
%t A121796 a = Table[Floor[v[n][[1]]], {n, 1, 50}]
%o A121796 (Python)
%o A121796 from itertools import product, cycle, islice
%o A121796 matrices = [(a, b, c, d) for a, b, c, d in product(range(5), repeat=4)
%o A121796             if (a*d - b*c) % 5 == 1]
%o A121796 def a121796():
%o A121796     x, y = 0, 1
%o A121796     for a, b, c, d in cycle(matrices[1:] + matrices[:1]):
%o A121796         x, y = a*x + b*y, c*x + d*y
%o A121796         yield x
%o A121796 print(list(islice(a121796(), 26)))
%o A121796 # _Meghanto Majumder_, Oct 28 2026
