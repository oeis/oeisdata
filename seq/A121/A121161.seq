%S A121161 0,8,94,997,10013,100052,999587,9998539,99998243,1000001596,
%T A121161 10000042120,100000058456,1000000040137,10000000171997,
%U A121161 100000000618648,999999997476931
%N A121161 a(n) is the nearest integer to log(lcm(1,2,3,...,10^n)).
%H A121161 Marc Deléglise and Joël Rivat, <a href="https://doi.org/10.1090/S0025-5718-98-00977-6">Computing psi(x)</a>, Math. Comp. 67 (1998), 1691-1696.
%H A121161 Andrew Granville and Greg Martin, <a href="https://arxiv.org/abs/math/0408319">Prime Number Races</a>, arXiv:math/0408319 [math.NT], 2004 (see page 11).
%F A121161 For asymptotics see A003418.
%F A121161 a(n) = round(Sum_{i=1..PrimePi(10^n)} log(p_i^e_i)), where e_i is the maximum exponent such that p_i^e_i <= 10^n. - _Robert G. Wilson v_, Aug 16 2006 [Corrected by _Ali Ramadhan_, Oct 09 2026]
%F A121161 a(n) = A215259(10^n). - _Ali Ramadhan_, Oct 09 2026
%t A121161 f[n_] := Block[{s = 0, i = 1, j = PrimePi[10^n], m = 10^n}, While[i <= j, p = Prime@i; s = s + N[Floor[ Log[p, m]]Log[p], 12]; i++ ]; Round@s]; Do[ Print[f@n], {n, 0, 8}] (* _Robert G. Wilson v_, Aug 16 2006 *)
%Y A121161 Cf. A003418.
%K A121161 nonn,more
