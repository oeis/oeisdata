%I A035289 #20 Nov 10 2026 23:20:45
%S A035289 0,12,56,192,504,1100,2112,3696,6032,9324,13800,19712,27336,36972,
%T A035289 48944,63600,81312,102476,127512,156864,191000,230412,275616,327152,
%U A035289 385584,451500,525512,608256,700392,802604,915600,1040112,1176896,1326732,1490424,1668800
%N A035289 Number of ways to place a non-attacking white and black knight on n X n chessboard.
%H A035289 Vincenzo Librandi, <a href="/A035289/b035289.txt">Table of n, a(n) for n = 1..1000</a>
%H A035289 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (5,-10,10,-5,1).
%F A035289 a(n) = n^4 - 9*n^2 + 24*n - 16.
%F A035289 G.f.: 4*x^2*(4*x^3-8*x^2+x-3)/(x-1)^5. - _Colin Barker_, Jan 09 2013
%F A035289 From _Elmo R. Oliveira_, Nov 10 2026: (Start)
%F A035289 E.g.f.: exp(x)*(x^4 + 6*x^3 - 2*x^2 + 16*x - 16) + 16.
%F A035289 a(n) = 5*a(n-1) - 10*a(n-2) + 10*a(n-3) - 5*a(n-4) + a(n-5).
%F A035289 a(n) = 2*A172132(n) = (n - 1)*(n + 4)*(n^2 - 3*n + 4). (End)
%e A035289 There are 56 ways of putting 2 distinct knights on 3 X 3 so that neither can capture the other.
%t A035289 CoefficientList[Series[4 x (4 x^3 - 8 x^2 + x - 3)/(x - 1)^5, {x, 0, 50}], x] (* _Vincenzo Librandi_, Oct 20 2013 *)
%o A035289 (Magma) [n^4 - 9*n^2 + 24*n - 16: n in [1..50]]; // _Vincenzo Librandi_, Oct 20 2013
%Y A035289 Cf. A172132.
%K A035289 nonn,easy,changed
%O A035289 1,2
%A A035289 _Erich Friedman_
