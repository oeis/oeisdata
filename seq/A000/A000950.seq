%N A000950 Number of forests with n nodes and height at most 3.
%D A000950 N. J. A. Sloane, A Handbook of Integer Sequences, Academic Press, 1973 (includes this sequence).
%D A000950 N. J. A. Sloane and Simon Plouffe, The Encyclopedia of Integer Sequences, Academic Press, 1995 (includes this sequence).
%H A000950 Alois P. Heinz, <a href="/A000950/b000950.txt">Table of n, a(n) for n = 0..425</a> (terms n = 1..100 from T. D. Noe)
%H A000950 John Riordan, <a href="https://doi.org/10.1016/S0021-9800(68)80033-X">Forests of labeled trees</a>, J. Combin. Theory, 5 (1968), 90-103.
%F A000950 E.g.f.: exp(x*exp(x*exp(x*exp(x)))).
%p A000950 T:= proc(n, h) option remember; `if`(min(n, h)=0, 1, add(
%p A000950       binomial(n-1, j-1)*j*T(j-1, h-1)*T(n-j, h), j=1..n))
%p A000950     end:
%p A000950 a:= n-> T(n,3):
%p A000950 seq(a(n), n=0..22);  # _Alois P. Heinz_, Nov 21 2026
%t A000950 nn = 20; Range[0, nn]! CoefficientList[Series[Exp[x*Exp[x*Exp[x*Exp[x]]]], {x, 0, nn}], x] (* _T. D. Noe_, Jun 21 2012 *)
