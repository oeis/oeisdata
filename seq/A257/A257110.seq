%S A257110 2,3,5,7,11,17,41,43,67,109,179,467,1973,5167,8363,21893,35423,92737,
%T A257110 392837,2692537,11405773,126491971,204668311,331160281,535828591,
%U A257110 1402817467,40730022149,279167724889,8105479075763,145446920496281,28944668049352441
%N A257110 Primes which are not the sums of two consecutive non-Fibonacci numbers.
%C A257110 For p >= 11, p is a term if and only if (p-1)/2 or (p+1)/2 is a Fibonacci number. - _Alper Ferudun_, Oct 17 2026
%e A257110 2, 3, 5, 7, 11 are in this sequence because first 9 sums of two consecutive non-Fibonacci numbers are 10, 13, 16, 19, 21, 23, 26, 29, 31.
%o A257110 (PARI) isfib(n) = issquare(5*n^2+4) || issquare(5*n^2-4);
%o A257110 isok(p) = if(!isprime(p), 0, my(u=(p-1)\2, v); while(u>=4 && isfib(u), u--); if(u<4, 1, v=u+1; while(isfib(v), v++); u+v!=p));
%o A257110 lista(nn) = my(v=List([2, 3, 5, 7])); for(k=4, nn, my(f=fibonacci(k)); foreach([2*f-1, 2*f+1], p, if(isok(p), listput(v, p)))); Vec(Set(v)); \\ _Alper Ferudun_, Oct 17 2026
%Y A257110 Cf. A001690.
