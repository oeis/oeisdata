%N A316746 Stirling transform of (n!)^4.
%H A316746 Alois P. Heinz, <a href="/A316746/b316746.txt">Table of n, a(n) for n = 0..144</a>
%H A316746 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/StirlingTransform.html">Stirling Transform</a>.
%F A316746 a(n) = Sum_{k=0..n} Stirling2(n,k) * (k!)^4.
%F A316746 a(n) ~ n!^4.
%p A316746 b:= proc(n, k) option remember; `if`(n=0,
%p A316746       k!^4, k*b(n-1, k)+b(n-1, k+1))
%p A316746     end:
%p A316746 a:= n-> b(n, 0):
%p A316746 seq(a(n), n=0..13);  # _Alois P. Heinz_, Sep 28 2026
%t A316746 Table[Sum[StirlingS2[n, k]*k!^4, {k, 0, n}], {n, 0, 20}]
