%I A075794 #13 Aug 11 2026 19:45:54
%S A075794 3,5,7,11,13,17,23,29,31,37,47,53,61,67,79,83,101,107,127,131,149,157,
%T A075794 179,191,211,223,233,251,277,281,311,331,347,367,389,401,439,457,479,
%U A075794 499,541,547,587,607,631,653,701,719,757,787,809,839,887,907,947,967
%N A075794 a(n) = the least positive integer k such that phi(k) > phi(1) + ... + phi(n).
%C A075794 It appears that all terms are prime. - _Robert Israel_, Aug 11 2026
%H A075794 Robert Israel, <a href="/A075794/b075794.txt">Table of n, a(n) for n = 1..5000</a>
%e A075794 phi(1) + ... + phi(4) = 6 and k = 11 is the least positive integer such that phi(k) > 6. Hence a(4) = 11.
%p A075794 N:= 10^4: # to use phi(k) for k <= N
%p A075794 V:= map(NumberTheory:-phi,[$1..N]):
%p A075794 S:= ListTools:-PartialSums(V):
%p A075794 m:= S[1]: r:= 1:
%p A075794 for i from 2 while m < N do
%p A075794   v:= V[i];
%p A075794   if v > m then
%p A075794     for j from r while v > S[j] do A[j]:= i od;
%p A075794     r:= j; m:= S[r];
%p A075794   fi
%p A075794 od:
%p A075794 seq(A[i],i=1..r); # _Robert Israel_, Aug 11 2026
%t A075794 s = 0; a = {}; For[i = 1, i <= 100, i++, s = s + EulerPhi[i]; k = 1; While[EulerPhi[k] <= s, k = k + 1]; a = Append[a, k]]; a
%Y A075794 Cf. A000010, A002088.
%K A075794 nonn
%O A075794 1,1
%A A075794 _Joseph L. Pe_, Dec 08 2002
