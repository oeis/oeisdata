%S A075781 2,11,13,31,59,113,313,349,659,821,1493,1571,1733,3209,3323,5569,7331,
%T A075781 7853,10531,13367,17321,21493,21787,25793,30137,31541,36709,39043,
%U A075781 39439,44771,46049,49991,55147,55501,56923,57881,58363,59333,65323,82129,83857,84437,85523,97081
%N A075781 Primes of the form perfect_power(k) + k.
%C A075781 perfect_power(k) is the k-th perfect power, A001597(k).
%H A075781 Amiram Eldar, <a href="/A075781/b075781.txt">Table of n, a(n) for n = 1..10000</a>
%F A075781 a(n) = A001597(A074321(n)) + A074321(n). - _Amiram Eldar_, Oct 12 2026
%e A075781 11 is a term: 11 = perfect_power(3) + 3 = 8 + 3.
%e A075781 31 is a term: 31 = perfect_power(6) + 6 = 25 + 6.
%e A075781 59 is a term: 59 = perfect_power(10) + 10 = 49 + 10.
%t A075781 With[{pow = Select[Range[10^5], # == 1 || GCD @@ FactorInteger[#][[;; , 2]] > 1 &]}, Select[pow + Range[Length[pow]], PrimeQ]] (* _Amiram Eldar_, Oct 12 2026 *)
%o A075781 (PARI) lista(nn) = {vec = vector(nn, i, i); pp = select(i->((ispower(i) || (i==1))), vec); for (i = 1, #pp, if (isprime(pp[i]+i), print1(pp[i]+i, ", ")););} \\ _Michel Marcus_, Oct 03 2013
%Y A075781 Cf. A001597, A074321.
%K A075781 nonn
%O A075781 1,1
