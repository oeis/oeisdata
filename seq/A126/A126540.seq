%U A126540 162731213670657,1618373433642625,16094839928704707,160064344144932989
%N A126540 Number of base 19 n-digit numbers with adjacent digits differing by five or less.
%C A126540 [Empirical] a(base,n)=a(base-1,n)+11^(n-1) for base>=5n-4; a(base,n)=a(base-1,n)+11^(n-1)-2 when base=5n-5
%H A126540 Rafał Wiktorowicz, <a href="/A126371/a126371_1.pdf">Proofs of the conjectured recurrences and generating functions for the adjacent-digits family</a>, 2026.
%H A126540 <a href="/index/Rec#order_09">Index entries for linear recurrences with constant coefficients</a>, signature (12,-12,-88,27,138,-4,-66,-4,8).
%o A126540 (S/R) stvar $[N]:(0..M-1) init $[]:=0 asgn $[]->{*} kill +[i in 0..N-2](($[i]`-$[i+1]`>5)+($[i+1]`-$[i]`>5))
%Y A126540 Cf. Base 19 differing by four or less A126514, three or less A126487, two or less A126406, one or less A126373.
%K A126540 nonn,base,changed
%O A126540 0,2
%A A126540 _R. H. Hardin_, Dec 28 2006
