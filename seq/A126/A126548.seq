%U A126548 411677827262455,4289079592113919,44687156668215307,465595502937636417
%N A126548 Number of base 27 n-digit numbers with adjacent digits differing by five or less.
%C A126548 [Empirical] a(base,n)=a(base-1,n)+11^(n-1) for base>=5n-4; a(base,n)=a(base-1,n)+11^(n-1)-2 when base=5n-5
%H A126548 Rafał Wiktorowicz, <a href="/A126371/a126371_1.pdf">Proofs of the conjectured recurrences and generating functions for the adjacent-digits family</a>, 2026.
%H A126548 <a href="/index/Rec#order_11">Index entries for linear recurrences with constant coefficients</a>, signature (17,-63,-101,450,61,-870,194,582,-201,-117,45).
%o A126548 (S/R) stvar $[N]:(0..M-1) init $[]:=0 asgn $[]->{*} kill +[i in 0..N-2](($[i]`-$[i+1]`>5)+($[i+1]`-$[i]`>5))
%Y A126548 Cf. Base 27 differing by four or less A126522, three or less A126495, two or less A126414, one or less A126381.
%K A126548 nonn,base
%O A126548 0,2
%A A126548 _R. H. Hardin_, Dec 28 2006
