%N A182250 a(0)=2, a(n) = (a(n-1) * n) OR n.
%H A182250 Harvey P. Dale, <a href="/A182250/b182250.txt">Table of n, a(n) for n = 0..449</a>
%F A182250 a(0)=2, a(n)=(a(n-1)*n) OR n, where OR is the bitwise logical inclusive-OR operator.
%t A182250 nxt[{n_,a_}]:={n+1,BitOr[a(n+1),(n+1)]}; NestList[nxt,{0,2},20][[;;,2]] (* _Harvey P. Dale_, Aug 09 2026 *)
%o A182250 (Python)
%o A182250 a=2
%o A182250 for i in range(1,51):
%o A182250     print(a, end=',')
%o A182250     a *= i
%o A182250     a |= i
%K A182250 base,nonn
%O A182250 0,1
