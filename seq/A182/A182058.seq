%I A182058 #45 Sep 09 2026 09:59:14
%S A182058 1,3,5,7,9,13,17,21,25,29,33,37,41,45,49,57,65,73,81,89,97,105,113,
%T A182058 121,129,137,145,153,161,169,177,185,193,201,209,225,241,257,273,289,
%U A182058 305,321,337,353,369,385,401,417,433,449,465,481,497,513,529,545,561,577,593
%N A182058 Number of moves needed to solve the Towers of Hanoi puzzle with 6 pegs and n disks.
%C A182058 See A007664 for further references etc.
%C A182058 The group index m is the largest real root of the quartic equation (x-1)*x*(x+1)*(x+2) - 24*(n+1) = (x^2+x)^2-2*(x^2+x)-24*(n+1) = 0. - _Yoshio Okita_, Aug 29 2026
%D A182058 Paul Cull and E. F. Ecklund, On the Towers of Hanoi and generalized Towers of Hanoi problems. Proceedings of the thirteenth Southeastern conference on combinatorics, graph theory and computing (Boca Raton, Fla., 1982). Congr. Numer. 35 (1982), 229--238. MR0725883(85a:68059).
%H A182058 Yoshio Okita, <a href="/A182058/b182058.txt">Table of n, a(n) for n = 1..10000</a>
%H A182058 Yoshio Okita, <a href="https://drive.google.com/file/d/1p0styfu9paFTqkPKMkE59VpTD_tibd0p/view?usp=sharing">Report1982.pdf</a>, (Unpublished manuscript, 1982).
%H A182058 Yoshio Okita, <a href="https://drive.google.com/file/d/1Qiu9FlsxiMKoc5ko3kblEPKIiakVd20L/view?usp=sharing">Explicit Formulas for the Frame-Stewart Numbers of the Generalized Tower of Hanoi: A Finite Difference Approach, 2026</a>.
%H A182058 <a href="/index/To#Hanoi">Index entries for sequences related to Towers of Hanoi</a>
%F A182058 From _Yoshio Okita_, Aug 29 2026: (Start)
%F A182058 a(n) = (n - (m^4 - 2*m^3 + 11*m^2 - 34*m + 48)/24) * 2^(m-1) + 1, where m = ceiling((sqrt(5 + 4*sqrt(24*n + 25)) - 1) / 2) - 1.
%F A182058 a(n) = A027608(k) + (n - binomial(k+4, 4))* 2^k, where k = m-1 = A127321(n-1), for n >= 1. (End)
%t A182058 A182058[n_] := 2^(# - 1)*(n - #*(#*(#*(# - 2) + 11) - 34)/24 - 2) + 1 & [Ceiling[(Sqrt[4*Sqrt[24*n + 25] + 5] - 1)/2] - 1];
%t A182058 Array[A182058, 100] (* _Paolo Xausa_, Sep 09 2026 *)
%o A182058 (PARI) a(n) = my(m = ceil((sqrt(5 + 4*sqrt(24*n + 25)) - 1) / 2) - 1); (n - (m^4 - 2*m^3 + 11*m^2 - 34*m + 48)/24) * 2^(m-1) + 1; \\ _Michel Marcus_, Aug 29 2026
%Y A182058 Cf. A007664 (4 pegs), A007665 (5 pegs), A027608, A127321.
