%I A289258 #27 Nov 01 2026 09:31:07
%S A289258 3,19,163,1459,8803,78787,370387,478243,2869459,3028867,6381667,
%T A289258 18173203,25828003,28441747,30001267,38290003,38316259,40417219,
%U A289258 42633379,86093443,109039219,154968019,171605683,180008083,190008019,232426099,242506387,243860707,244000243,344846323
%N A289258 Prime factors of numbers in A289257.
%C A289258 Kalmynin conjectures that this sequence is infinite.
%C A289258 The terms 17497, 52489, 164617 that are == 1 (mod 8) were wrong.
%C A289258 Primes p such that p == 3 (mod 8) and every prime factor of (p - 1)/2 is also a term. See theorem 7 of Kalmynin, 2016.
%H A289258 Andrew Howroyd, <a href="/A289258/b289258.txt">Table of n, a(n) for n = 1..10000</a>
%H A289258 Alexander Kalmynin, <a href="https://arxiv.org/abs/1611.00417">On Novák numbers</a>, arXiv:1611.00417 [math.NT], 2016-2017. See Theorem 7 p. 11.
%o A289258 (PARI) isokrec(p) = {if(p%8!=3,return(0)); foreach(factor((p-1)/2)[,1], q, if(!self()(q), return(0))); 1}
%o A289258 isok(p)=isprime(p) && isokrec(p) \\ _Andrew Howroyd_, Oct 30 2026
%o A289258 (PARI)
%o A289258 G(p,S,lim)=concat(vector(logint(lim,p), i, my(t=lim\p^i); p^i*select(x->x<=t,S)))
%o A289258 lista(lim)={ my(xl=(lim-1)\2, L=List([3]), S=[1], k=0); while(k<#L, k++; my(p=L[k]); if(p<=xl, my(N=G(p,S,xl)); S=concat(S,N); foreach(N, x, my(q=2*x+1); if(q%8==3 && isprime(q), listput(L,q))))); Set(L) } \\ _Andrew Howroyd_, Oct 30 2026
%Y A289258 Cf. A006521, A057719, A124240, A289257.
%K A289258 nonn,changed
%O A289258 1,1
%A A289258 _Michel Marcus_, Jun 29 2017
%E A289258 Corrected and extended by _Bill McEachen_, Oct 30 2026
%E A289258 a(9) onward from _Andrew Howroyd_, Oct 30 2026
