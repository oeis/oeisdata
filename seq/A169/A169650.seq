%I A169650 #19 Aug 22 2026 00:03:25
%S A169650 3,7,23,79,263,847,2663,8239,25223,76687,232103,700399,2109383,
%T A169650 6344527,19066343,57264559,171924743,516036367,1548633383,4646948719,
%U A169650 13942943303,41833024207,125507461223,376539160879,1129651037063,3389020220047,10167194877863,30501853069039
%N A169650 a(n) = 3*a(n-1) + 2^n - 6, with a(1) = 3.
%H A169650 Todd Silvestri, <a href="/A169650/b169650.txt">Table of n, a(n) for n = 1..2095</a>
%H A169650 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (6,-11,6).
%F A169650 a(n) = 4*3^(n-1) - 2^(n+1) + 3. - _Todd Silvestri_, Dec 15 2014
%F A169650 From _Elmo R. Oliveira_, Aug 21 2026: (Start)
%F A169650 G.f.: x*(3 - 11*x + 14*x^2)/((1 - x)*(1 - 2*x)*(1 - 3*x)).
%F A169650 E.g.f.: (-7 + 9*exp(x) - 6*exp(2*x) + 4*exp(3*x))/3.
%F A169650 a(n) = 6*a(n-1) - 11*a(n-2) + 6*a(n-3) for n > 3. (End)
%p A169650 a:=n->if n=1 then 3 else 3*a(n-1)+2^n-6; fi;
%t A169650 a[n_Integer/;n>=1]:=4*3^(n-1)-2^(n+1)+3 (* _Todd Silvestri_, Dec 15 2014 *)
%t A169650 (* Alternative: *)
%t A169650 RecurrenceTable[{a[1]==3,a[n]==3a[n-1]+2^n-6},a,{n,30}] (* _Harvey P. Dale_, Jan 22 2018 *)
%o A169650 (PARI) a(n)=4*3^n/3-2*2^n+3 \\ _Charles R Greathouse IV_, May 30 2026
%Y A169650 Apart from offset, equals A145563 + 3. Arises in analyzing A169648.
%K A169650 nonn,easy
%O A169650 1,1
