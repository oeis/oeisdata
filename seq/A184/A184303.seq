%o A184303 (PARI) T(n,k) = {my(m=n^3*k^2); polcoef(prod(j=1, n, sum(d=0, k, x^(j^3*d^2), O(x^(m+1)))), m)} \\ _Andrew Howroyd_, Oct 18 2026
%o A184303 (PARI) \\ dynamic programming (slightly less memory)
%o A184303 T(n,k) = { my(m=sum(j=1,n,j^3*k^2), M=Map()); mapput(M,n^3*k^2,1); forstep(j=n, 1, -1, m-=j^3*k^2; my(L=Mat(M), v=vector(k+1,i,j^3*(i-1)^2)); M=Map(); for(i=1, matsize(L)[1], my([r,q]=L[i,]); foreach(v, d, my(t=r-d,z); if(t<0, break); if(t<=m, mapput(M,t,if(mapisdefined(M,t,&z),z+q,q))) ))); mapget(M,0) } \\ _Andrew Howroyd_, Oct 18 2026
