%I A122442 #22 Sep 01 2026 00:36:49
%S A122442 2,5,3,11,7,39,287,231,191,127,359,511,239,159,639,283,991,251,167,
%T A122442 111,1695,1307,871,927,671,155,103,1639,91,3431,3399,2287,71,6395,47,
%U A122442 31,2047,27,1819,17691,6887,4591,13439,6383,4255,7963,7527,12399,7279,1583
%N A122442 Least k such that the Collatz (3x+1) iteration starting with k has "dropping time" A122437(n).
%C A122442 With a(2) changed to 1, each term is the minimal residue-class-id of order (n-1), and each term covers all start values >= 1 that are congruent to a(n) mod floor(log(3^(n-1))/log(2)+1). - _Ruud H.G. van Tol_, Aug 26 2026
%H A122442 T. D. Noe, <a href="/A122442/b122442.txt">Table of n, a(n) for n = 1..130</a>
%t A122442 With[{s = 1 + Log2[3]}, {2}~Join~Table[(k = 3; While[-1 + Length@ NestWhileList[If[EvenQ[#], #/2, 3 # + 1] &, k, # >= k &] != m, k += 2]; k), {m, Array[Floor[1 + s*#] &, 50]}] ] (* _Michael De Vlieger_, Apr 19 2024 *)
%o A122442 (PARI) first_slow(N) = { my(a=List([[0, 1, 0]]), p0=#a, p1=#a, v=vector(N)); for(p3=0, N-2, my(p2=logint(3^p3, 2)+1, m=if(logint(3^(p3+1), 2)>p2, 2, 1)); for(p=p0, p1, my(s=a[p][1]); for(i=0, if(s, valuation(s,2)-1, 0), my(t=[(a[p][1]+(1<<i))<<m, p2+m, p3+1], r=0, v2); listput(~a, t); for(j=1, t[2], r=if(bittest(t[1], t[2]-j), 3*r+1, r)/2); v2=-r*(2^t[2])/(3^t[3])%(2^t[2]); if(!v[t[3]+1] || v[t[3]+1]>v2, v[t[3]+1]=v2))); p0=p1+1; p1=#a); v[1]=2; v[2]=5; v; } \\ _Ruud H.G. van Tol_, Aug 26 2026
%o A122442 (PARI) first(N) = { my(v=Vec([2, 5], N), c=2); for(i=0, oo, c<N || break; my(t=i*4+3, x=t, p2=0, p3=0); until(x<t, if(x%2, p3++; x=(x*3+1)/2, x/=2); p2++); if(p3<N && !v[p3+1] && t<2^p2, v[p3+1]=t; c++)); v; } \\ _Ruud H.G. van Tol_, Aug 26 2026
%Y A122442 Cf. A122437 (allowable "dropping times" of the Collatz iteration).
%Y A122442 Cf. A020914, A060412, A243115.
%K A122442 nonn,changed
%O A122442 1,1
%A A122442 _T. D. Noe_, Sep 06 2006
