%I A122442 #54 Oct 06 2026 17:24:59
%S A122442 2,5,3,11,7,39,287,231,191,127,359,511,239,159,639,283,991,251,167,
%T A122442 111,1695,1307,871,927,671,155,103,1639,91,3431,3399,2287,71,6395,47,
%U A122442 31,2047,27,1819,17691,6887,4591,13439,6383,4255,7963,7527,12399,7279,1583
%N A122442 Least k such that the Collatz (3x+1) iteration starting with k has "dropping time" A122437(n).
%C A122442 With offset 0, and then a(1) changed from 5 to 1, each term is the minimal residue-class-id of order n, and each term covers all start values >= 1 that are congruent to a(n) mod 2^floor(n*log_2(3)+1). - _Ruud H.G. van Tol_, Aug 26 2026
%H A122442 T. D. Noe, <a href="/A122442/b122442.txt">Table of n, a(n) for n = 1..130</a>
%H A122442 Ruud H.G. van Tol, <a href="/A122442/a122442_2.pdf">Collatz, but stop at the drop</a> (Draft R_32, 2026).
%H A122442 Ruud H.G. van Tol, Python script <a href="/A122442/a122442.py.txt">pv.py</a>, as mentioned in the paper.
%F A122442 a(n) = A177789(n-1,1) for n>2. - _V. Barbera_, Sep 02 2026
%t A122442 With[{s = 1 + Log2[3]}, {2}~Join~Table[(k = 3; While[-1 + Length@ NestWhileList[If[EvenQ[#], #/2, 3 # + 1] &, k, # >= k &] != m, k += 2]; k), {m, Array[Floor[1 + s*#] &, 50]}] ] (* _Michael De Vlieger_, Apr 19 2024 *)
%o A122442 (PARI) first(N, D=0)= { my(merge(~v, x)=my(n=0); for(o=1, #v, if(x[o] && (!v[o] || x[o]<v[o]), n+=!v[o]; v[o]=x[o])); n, v=Vec([2, 5], N), c=2, w=[[0, 0, 0]], m=2^18); for(j=0, 17, my(r=List(), x=vector(N), h=2^j); foreach(w, e, foreach([[e[1], e[2]], [e[1]+h, e[2]+3^e[3]]], f, my(y=f[2], p3=e[3]); if(y%2, p3++; y=(y*3+1)/2, y/=2); if(3^p3>2*h, listput(~r, [f[1], y, p3]), p3<N && f[1]>1 && (!x[p3+1] || f[1]<x[p3+1]) && x[p3+1]=f[1]))); w=Vec(r); c+=merge(~v, x)); w=vecsort(w, 1); c<N && parfor(s=0, +oo, my(u=vector(N)); foreach(w, e, my(t=s*m+e[1], y=s*3^e[3]+e[2], p3=e[3]); until(y<t, if(y%2, p3++; y=(y*3+1)/2, y/=2)); p3<N && !u[p3+1] && u[p3+1]=t); u, x, c+=merge(~v, x); D&&print1(c, strchr(13)); c==N && vecmax(v)<s*m && break); v } \\ Ruud H.G. van Tol, Aug 26 2026; improved on Sep 30 2026, can do 200 well within 1 minute.
%o A122442 (PARI) collatzoddstoppingtime(x)={my(xt=x, ans=0); while(x<=xt, if(xt%2, ans++; xt*=3; xt++); xt>>=1); ans;};
%o A122442 list(n) = {my(ans=vector(n), x=27, ni=0, t=List([2, 5, 3, 11, 7, 39]), d=List([4, 16, 16, 8, 20, 12, 8, 16, 28, 4, 8, 24, 16, 16, 8, 8, 12, 4, 28]), di=0); while(ni<n && ni<6, ans[ni+1]=t[ni+1]; ni++); while(ni<n, my(m=collatzoddstoppingtime(x)+1); if(m<=n, if(ans[m]==0, ans[m]=x; ni++)); x+=d[di+1]; di=(di+1)%19) ; ans;} \\ _V. Barbera_, Sep 30 2026
