%S A398584 1,1,6,89024113128,
%T A398584 9408848586902307808986262958744983265081774626292935119526302968396808504756937215293663972426537777995881088887464
%N A398584 Number of linear extensions of the poset of permutations of {1,2,...,n} with respect to the weak (Bruhat) order.
%D A398584 Richard P. Stanley, Enumerative Combinatorics Volume 1 2nd edition, Cambridge, 2011, pages 457-459.
%e A398584 For n = 3, the poset of permutations is
%e A398584     321
%e A398584    /   \
%e A398584   312 231
%e A398584   |     |
%e A398584   132 213
%e A398584    \   /
%e A398584     123
%e A398584 The a(3) = 6 linear extensions are
%e A398584   123, 132, 213, 312, 231, 321
%e A398584   123, 132, 312, 213, 231, 321
%e A398584   123, 213, 132, 312, 231, 321
%e A398584   123, 213, 132, 231, 312, 321
%e A398584   123, 213, 231, 132, 312, 321
%e A398584   123, 132, 213, 231, 312, 321
%o A398584 (SageMath)
%o A398584 def a(n):
%o A398584     S_n=posets.SymmetricGroupWeakOrderPoset(n)
%o A398584     return len(S_n.linear_extensions())
%K A398584 nonn
%O A398584 1,3
%A A398584 _Félix Reutenauer_, Aug 03 2026
