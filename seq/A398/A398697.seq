%I A398697 #20 Aug 13 2026 21:39:19
%S A398697 0,2,30,332,3660,40262,442890,4871792,53589720,589486922,6484356150,
%T A398697 71327917652,784607094180,8630678035982,94937458395810,
%U A398697 1044312042353912,11487432465893040,126361757124823442,1389979328373057870,15289772612103636572,168187498733140002300
%N A398697 a(n) = floor(11^n/4).
%C A398697 For n >= 1, the base-11 representation of a(n) consists of the first n digits of the base-11 expansion of 1/4 = 0.282828..._11, i.e., n alternating digits 2,8,2,8,... beginning with 2.
%C A398697 Base-11 analog of A397937 (base 7) and A003463 (base 5); see A397936 for the classification over odd b by b mod 4, and A398696 for the refinement of the Lucas congruence by b mod 8.
%H A398697 Reed L. Rucka, <a href="/A398697/b398697.txt">Table of n, a(n) for n = 0..950</a>
%H A398697 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (11,1,-11).
%F A398697 a(n) = (11^n + (-1)^n - 2)/4.
%F A398697 a(n) = 11*a(n-1) + 5 + 3*(-1)^n for n >= 1, a(0) = 0.
%F A398697 a(n) = 11*a(n-1) + a(n-2) - 11*a(n-3) for n >= 3.
%F A398697 a(n) + A398696(n) = 11^n - 1 for n >= 0 (cf. A024127).
%F A398697 a(n) + a(n+1) = A199019(n).
%F A398697 binomial(11^n - 1, a(n)) == 1 (mod 11) for n >= 1 (Lucas: the base-11 digits of a(n) are all 2 or 8, and binomial(10,2) = binomial(10,8) = 45 == 1 (mod 11), so every position contributes a factor 1).
%F A398697 G.f.: 2*x*(1 + 4*x)/((1 - x)*(1 + x)*(1 - 11*x)).
%F A398697 E.g.f.: (exp(-x) - 2*exp(x) + exp(11*x))/4.
%e A398697 a(3) = 332 = 282 in base 11; a(4) = 3660 = 2828 in base 11.
%p A398697 seq(floor(11^n/4), n=0..20);
%t A398697 Table[Floor[11^n/4], {n, 0, 20}]
%o A398697 (PARI) a(n) = 11^n\4;
%Y A398697 Cf. A397937 (base-7 analog), A003463 (base-5 analog), A125833, A081251 (base 3), A001020 (powers of 11), A398696 (complement within 11^n - 1), A024127 (11^n - 1), A199019 (consecutive-term sums).
%K A398697 nonn,easy,base
%O A398697 0,2
%A A398697 _Reed L. Rucka_, Aug 07 2026
