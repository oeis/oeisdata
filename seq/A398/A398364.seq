%S A398364 1,1,1,1,1,1,1,3,7,13,21,31,43,57,79,121,201,343,577,939,1471,2241,
%T A398364 3383,5157,8029,12771,20581,33223,53257,84499,132921,208271,326763,
%U A398364 515257,817419,1302673,2079583,3316885,5277979,8378541,13282277,21056967,33423013,53142735,84626449
%N A398364 a(n) = Sum_{k=0..floor(n/7)} binomial(2*k,k) * binomial(n-5*k,2*k).
%C A398364 Number of lattice paths from (0,0) to (n,n) using steps (7-r,r), (r,7-r), and (1,1), for any fixed r in {0,1,2,3}.
%H A398364 Paolo Xausa, <a href="/A398364/b398364.txt">Table of n, a(n) for n = 0..1000</a>
%F A398364 a(n) = Sum_{k=0..floor(n/7)} multinomial(n-5*k; k, k, n-7*k).
%F A398364 G.f.: 1/sqrt((1-x)^2 - 4*x^7).
%t A398364 A398364[n_] := Sum[Multinomial[k, k, n - 7*k], {k, 0, n/7}];
%t A398364 Array[A398364, 50, 0] (* _Paolo Xausa_, Jul 27 2026 *)
%t A398364 (* Alternative: *)
%t A398364 Module[{x}, CoefficientList[Series[1/Sqrt[x*(x - 4*x^6 - 2) + 1], {x, 0, 49}], x]] (* _Paolo Xausa_, Jul 27 2026 *)
%t A398364 (* Alternative: *)
%t A398364 Table[Sum[Binomial[2k,k]Binomial[n-5k,2k],{k,0,Floor[n/7]}],{n,0,50}] (* _Harvey P. Dale_, Aug 03 2026 *)
%o A398364 (PARI) a(n) = sum(k=0, n\7, binomial(2*k, k)*binomial(n-5*k, 2*k));
%Y A398364 Cf. A001850, A002426, A098479, A098482, A387599, A393251, A398365.
%K A398364 nonn
%O A398364 0,8
