%S A398790 1,2,5,11,26,60,139,322,746,1728,4003,9273,21481,49761,115272,267029,
%T A398790 618576,1432939,3319421,7689480,17812776,41263517,95587450,221429516,
%U A398790 512944226,1188241675,2752576609,6376377927,14770958721,34217109468,79264359373,183616873678,425350770081
%N A398790 Number of ways to tile a 1 X n strip using tiles of length 1 or 2, each tile colored red or blue, such that no two red tiles are adjacent.
%H A398790 Paolo Xausa, <a href="/A398790/b398790.txt">Table of n, a(n) for n = 0..1000</a>
%H A398790 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (1,2,2,1).
%F A398790 a(n) = a(n-1) + 2*a(n-2) + 2*a(n-3) + a(n-4) for n >= 4, with a(0)=1, a(1)=2, a(2)=5, a(3)=11.
%F A398790 G.f.: (1 + x + x^2)/(1 - x - 2*x^2 - 2*x^3 - x^4).
%e A398790 For n=1: two tilings -- a single red tile, or a single blue tile. a(1) = 2.
%e A398790 For n=2: five tilings -- using either two size-1 tiles (BB, BR, RB -- RR excluded) or one size-2 tile (red or blue). a(2) = 5.
%t A398790 LinearRecurrence[{1, 2, 2, 1}, {1, 2, 5, 11}, 35] (* _Paolo Xausa_, Aug 17 2026 *)
%o A398790 (Python)
%o A398790 def a(n):
%o A398790     dp = {0: {-1: 1}}
%o A398790     for i in range(n+1):
%o A398790         if i not in dp:
%o A398790             continue
%o A398790         for last_color, cnt in dp[i].items():
%o A398790             for size in (1, 2):
%o A398790                 ni = i + size
%o A398790                 if ni > n:
%o A398790                     continue
%o A398790                 for color in (0, 1):
%o A398790                     if color == 1 and last_color == 1:
%o A398790                         continue
%o A398790                     dp.setdefault(ni, {})
%o A398790                     dp[ni][color] = dp[ni].get(color, 0) + cnt
%o A398790     return sum(dp.get(n, {}).values())
%o A398790 print([a(n) for n in range(1, 33)])
%K A398790 nonn,easy
%O A398790 0,2
