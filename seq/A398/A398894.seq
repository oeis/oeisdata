%I A398894 #67 Aug 20 2026 18:06:17
%S A398894 1,3,5,19,49,301,361,2941,6721,22681,25201,304921,332641,4684681,
%T A398894 5045041,5405401,11531521,208288081,220540321,4423058641,4655851201,
%U A398894 4888643761,5121436321,123147264241,128501493121,669278610001,696049754401,2168462696401
%N A398894 Minimum value of k such that there exists a subset S of {1, ..., k} of size n for which the average of every nonempty subset of S is an integer.
%C A398894 For a set of n distinct positive integers (that satisfies the condition on subset averages), the difference between any two distinct elements is divisible by k for all k < n (this is because if m is an element of the set, the sum of any subset that does not include m is divisible by k, and m can replace any other element in the sum).
%C A398894 Therefore, the difference between any two distinct elements is a multiple of L(n-1), where L(n) = lcm({1,2, ..., n}) = A003418(n).
%C A398894 The least set with this property is an arithmetic progression with the initial term 1 and common difference L(n-1): S(n) = {1, L(n-1)+1, 2*L(n-1)+1, ..., (n-1)*L(n-1)+1}.
%C A398894 To prove that S(n) satisfies the condition on subset averages, consider first any subset of size k < n. Its sum is k + m * L(n-1) for some m, which is divisible by k.
%C A398894 The total sum is n + ((n-1)*n/2) * L(n-1), which is divisible by n for all n >= 3.
%C A398894 Therefore, a(n) = (n-1)*L(n-1) + 1 for n >= 3.
%F A398894 a(n) = (n-1)*A003418(n-1) + 1 = A081528(n-1) + 1 for n >= 3.
%e A398894 For n = 3 the set is {1, 3, 5}: the averages (1+3)/2 = 2, (1+5)/2 = 3, (3+5)/2 = 4, and (1+3+5)/3 = 3 are all integers.
%t A398894 a[n_] := 1 + (n-1) * LCM @@ Range[n-1]; a[1] = 1; a[2] = 3; Array[a, 28] (* _Amiram Eldar_, Aug 15 2026 *)
%Y A398894 Cf. A051293, A003418, A081528.
%K A398894 nonn,easy
%O A398894 1,2
