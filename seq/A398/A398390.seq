%I A398390 #18 Sep 01 2026 22:43:21
%S A398390 1,4,16,49,133,316,689,1385,2621,4697,8057,13289,21210,32865,49641,
%T A398390 73266,105954,150405,209986,288730,391558,524278,693850,908386,
%U A398390 1177463,1512122,1925234,2431499,3047867,3793538,4690443,5763243,7039875,8551551,10333371,12424323
%N A398390 Number of factorizations of (p*q*r*s)^n into squarefree factors > 1 where none of p, q, r, or s are permitted as factors, for any four distinct primes p, q, r, and s.
%C A398390 Equivalently, the number of 4-column binary matrices with column sums equal to n and row sums in {2, 3, 4}, up to row permutations.
%C A398390 Only parts corresponding to multi-prime squarefree factors (weight >= 2) are permitted.
%D A398390 P. A. MacMahon, Combinatory Analysis, Cambridge Univ. Press, London and New York, Vol. 1, 1915 and Vol. 2, 1916.
%F A398390 G.f.: [w^n x^n y^n z^n] Product_{(i,j,k,l) in {0,1}^4, i+j+k+l >= 2} 1 / (1 - w^i * x^j * y^k * z^l).
%e A398390 a(1) = 4: The 4 factorizations of p*q*r*s into squarefree parts excluding standalone primes are {p*q*r*s}, {p*q, r*s}, {p*r, q*s}, and {p*s, q*r}.
%e A398390 a(2) = 16: There are 16 such factorizations of p^2*q^2*r^2*s^2.
%t A398390 a[n_] := Module[{dp}, dp = Array[0 &, {n+1, n+1, n+1, n+1}]; dp[[1, 1, 1, 1]] = 1; Do[If[i+j+k+l >= 2, Do[dp[[x+1, y+1, z+1, w+1]] += dp[[x-i+1, y-j+1, z-k+1, w-l+1]], {x, i, n}, {y, j, n}, {z, k, n}, {w, l, n}]], {i, 0, 1}, {j, 0, 1}, {k, 0, 1}, {l, 0, 1}]; dp[[n+1, n+1, n+1, n+1]]];
%t A398390 Table[a[n], {n, 0, 35}]
%o A398390 (Python)
%o A398390 def lista(limit):
%o A398390     m = limit + 1
%o A398390     m2, m3 = m * m, m * m * m
%o A398390     dp = [0] * (m * m * m * m)
%o A398390     dp[0] = 1
%o A398390     allowed = [(i, j, k, l) for i in (0, 1) for j in (0, 1) for k in (0, 1) for l in (0, 1) if i+j+k+l >= 2]
%o A398390     for c1, c2, c3, c4 in allowed:
%o A398390         shift = c1 * m3 + c2 * m2 + c3 * m + c4
%o A398390         for i1 in range(c1, m):
%o A398390             for i2 in range(c2, m):
%o A398390                 for i3 in range(c3, m):
%o A398390                     for i4 in range(c4, m):
%o A398390                         idx = i1 * m3 + i2 * m2 + i3 * m + i4
%o A398390                         dp[idx] += dp[idx - shift]
%o A398390     return [dp[k * m3 + k * m2 + k * m + k] for k in range(m)]
%o A398390 print(lista(35))
%Y A398390 Cf. A011863, A050320, A175707, A398816.
%K A398390 nonn,new
%O A398390 0,2
