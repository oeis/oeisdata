%I A398777 #24 Nov 11 2026 19:47:17
%S A398777 1,2,2,12,54,1027,29560,2014823,235589661,53333331941,21654833294932,
%T A398777 16458038332117501,22838111213339505597,58706564779396873219538,
%U A398777 277253303760334876242238366,2417153004535038267841233213529,38797383339515086800707589069373888
%N A398777 Number of ways to tile an n X n board having a black border with the 1 X 1 tiles bbbb, bbww, wbbw, bwwb, wwbb (colors read clockwise around each tile), up to rotations and reflections of the board.
%C A398777 This is a reduced version of A086832 with the reflections and rotations not counted as unique. Number of orbits of the tilings counted by A086832 under the dihedral group of order 8 acting on the board.
%C A398777 Equivalently, the number of n X n binary matrices in which every maximal run of 1's in every row and every column has even length, up to rotations and reflections.
%H A398777 Jeff Sponaugle, <a href="/A398777/b398777.txt">Table of n, a(n) for n = 1..30</a>
%H A398777 Ruud H.G. van Tol, <a href="/A398777/a398777_1.gp.txt">a398777.gp</a> Parallel PARI/GP code, also for A086832.
%F A398777 a(n) = (A086832(n) + 2*R90(n) + R180(n) + 2*V(n) + 2*D(n))/8 (Burnside), where R90, R180, V and D count the tilings invariant under a quarter turn, a half turn, a reflection in a vertical line and a reflection in a diagonal, respectively.
%F A398777 For odd n, V(n) = A220614(n, (n-1)/2): the middle column of a mirror-symmetric tiling has no two-colored tiles.
%e A398777 a(3) = 2: the empty tiling (all bbbb) and the tiling with one 2 X 2 block of two-colored tiles in a corner (the four corners are equivalent).
%o A398777 (Python)
%o A398777 def a(n):  # tilings of A086832 up to rotations and reflections, by listing them all
%o A398777     rows = [x | x << 1 for x in range(1 << n - 1) if not x & x << 1]  # rows = disjoint horizontal dominoes
%o A398777     mats = []
%o A398777     def rec(m, s):  # s = set of columns whose current vertical run of 1's has odd length
%o A398777         if len(m) == n:
%o A398777             if s == 0: mats.append(tuple(tuple(r >> j & 1 for j in range(n)) for r in m))
%o A398777             return
%o A398777         for r in rows:
%o A398777             if r & s == s: rec(m + [r], r ^ s)
%o A398777     rec([], 0)
%o A398777     seen, c = set(), 0
%o A398777     for g in mats:
%o A398777         if g in seen: continue
%o A398777         c += 1
%o A398777         for _ in range(4):
%o A398777             g = tuple(zip(*g[::-1]))  # quarter turn
%o A398777             seen.update((g, tuple(row[::-1] for row in g)))
%o A398777     return c
%o A398777 print([a(n) for n in range(1, 8)])
%o A398777 (PARI) \\ See Links. _Ruud H.G. van Tol_, Nov 04 2026
%Y A398777 Cf. A086832 (all tilings), A220614.
%K A398777 nonn,new
%O A398777 1,2
