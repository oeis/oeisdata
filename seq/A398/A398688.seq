%S A398688 1,1,2,4,10,24,64,168,466,1286,3664,10436,30320,88244,260212,769264,
%T A398688 2294938,6865310,20673432,62420724,189409712,576182092,1759530108,
%U A398688 5385437668,16534458136,50868423676,156895028444,484805172468,1501231924756,4656310306444
%N A398688 Number of involutive Baxter permutations of length n.
%C A398688 Equivalently, the Baxter permutations of length n fixed by a reflection of the permutation matrix in a diagonal. The two diagonal reflections are conjugate in D4 and so fix equally many.
%H A398688 Meghanto Majumder, <a href="/A398688/b398688.txt">Table of n, a(n) for n = 0..500</a>
%H A398688 Nicolas Bonichon, Mireille Bousquet-Mélou, and Éric Fusy, <a href="https://www.mat.univie.ac.at/~slc/wpapers/s61Abobofu.html">Baxter permutations and plane bipolar orientations</a>, Sem. Lothar. Combin. 61A (2009/10), Art. B61Ah, 29 pp.
%H A398688 Éric Fusy, <a href="https://arxiv.org/abs/1010.3850">Bijective counting of involutive Baxter permutations</a>, arXiv:1010.3850 [math.CO], 2010-2011.
%F A398688 From Fusy's Theorem 1 and the Lindstrom-Gessel-Viennot computation opening his Section 4 (both on p. 5): a(m) = Sum_{n=0..floor(m/2)} Sum_{k=0..n+p} Sum_{r=0..n} binomial(p+r, r) * det(N(A_i -> B_j))_{i,j=1..3}, where p = m - 2*n, A_1 = (-1,1), A_2 = (0,0), A_3 = (0,-1), B_1 = (k-1, n+p-k), B_2 = (k, n+p-k-1), B_3 = (k+r, n-k-r-1), and N(A -> B) is the number of East/North lattice paths from A to B. The parameters count fixed points (p), non-fixed points (2n), descents not crossing the diagonal (2k) and descents crossing it (r). Fusy's Theorem 2 evaluates the same determinant into closed form.
%F A398688 For even m: (m+6)*(m+7)*(14*m+53)*a(m+6) = 2*(42*m^3 + 523*m^2 + 2059*m + 2538)*a(m+4) + (m+3)*(658*m^2 + 6243*m + 14150)*a(m+2) + 28*(m+1)*(m+3)*(14*m+81)*a(m). Obtained by creative telescoping applied to the summand of Fusy's Theorem 2, eliminating r, k and n in turn.
%F A398688 G.f. for the even-indexed terms: Sum_{M>=0} a(2*M)*x^M = sqrt((1 - 3*x - sqrt(1 - 10*x - 7*x^2))/(2*x*(1 + 4*x))), the algebraic function G satisfying 1 + (3*x - 1)*G^2 + (x + 4*x^2)*G^4 = 0.
%F A398688 The number of these of length 2n having no fixed point is 3*2^(n-1)*binomial(2*n, n)/((n+1)*(n+2)) for n >= 1 (Fusy, Theorem 6; found by Bousquet-Melou using generating functions, announced in Bonichon, Bousquet-Melou and Fusy).
%F A398688 a(n) ~ sqrt(508 + 335*sqrt(2)) * (5 + 4*sqrt(2))^(n/2) / (sqrt(Pi) * 7^(3/2) * n^(3/2)). - _Vaclav Kotesovec_, Aug 08 2026
%F A398688 Recurrence: (n-1)*n*(n+1)*(n+3)*(14490*n^5 - 340701*n^4 + 3066901*n^3 - 13187913*n^2 + 27069185*n - 21178410)*a(n) = (n-1)*(188370*n^8 - 4863813*n^7 + 49769971*n^6 - 255269060*n^5 + 671270036*n^4 - 759015265*n^3 - 31288161*n^2 + 557118954*n - 114247800)*a(n-2) + (188370*n^9 - 1139883*n^8 - 54459536*n^7 + 939883761*n^6 - 6631243796*n^5 + 25082779383*n^4 - 53610076784*n^3 + 62458603179*n^2 - 34118388414*n + 5170354200)*a(n-4) - (n-5)*(5057010*n^8 - 148377309*n^7 + 1812470695*n^6 - 11955098188*n^5 + 46074634100*n^4 - 104354857481*n^3 + 131218702755*n^2 - 77587555662*n + 12184635600)*a(n-6) - 4*(n-7)*(n-5)*(2072070*n^7 - 55936263*n^6 + 599736845*n^5 - 3258385746*n^4 + 9454213744*n^3 - 14080920723*n^2 + 9245157309*n - 1546492500)*a(n-8) - 224*(n-9)^2*(n-7)*(n-5)*(14490*n^5 - 195801*n^4 + 920893*n^3 - 1804131*n^2 + 1377113*n - 244020)*a(n-10). - _Vaclav Kotesovec_, Aug 10 2026
%e A398688 Of the 26 involutions of length 5 (A000085(5)), a(5) = 24 are Baxter; the exceptions are 35142 and 42513.
%o A398688 (PARI)
%o A398688 nw(ax,ay,bx,by) = my(dx=bx-ax, dy=by-ay); if(dx<0 || dy<0, 0, binomial(dx+dy, dx));
%o A398688 lgv(n,k,p,r) = my(A=[[-1,1],[0,0],[0,-1]], B=[[k-1,n+p-k],[k,n+p-k-1],[k+r,n-k-r-1]]); binomial(p+r,r) * matdet(matrix(3,3,i,j, nw(A[i][1],A[i][2],B[j][1],B[j][2])));
%o A398688 a(m) = sum(n=0, m\2, my(p=m-2*n); sum(k=0, n+p, sum(r=0, n, lgv(n,k,p,r))));
%o A398688 vector(29, m, a(m))
%o A398688 (PARI)
%o A398688 \\ Fast implementation of the above program:
%o A398688 \\ Same sum with the bounds collapsed and binomials made incremental;
%o A398688 \\ Expanding the determinant along its third column, that column is C(n-1,k+r+1),
%o A398688 \\ C(n-1,k+r), C(n,k+r), all zero once k+r > n,
%o A398688 \\ so k runs to n, not n+p, and r to n-k, not n.
%o A398688 cb(a, b) = if (b < 0 || a < 0 || b > a, 0, binomial(a, b));
%o A398688 a(m) = {
%o A398688   my(total = 0, p, M0, M1, c1m, c1, c1p, c0m, c0, X, Y, Z, b1, b2, b3, w, j);
%o A398688   for (n = 0, m \ 2,
%o A398688     p  = m - 2*n;
%o A398688     M0 = m - n;        \\ = n + p
%o A398688     M1 = m - n - 1;    \\ = n + p - 1
%o A398688     \\ k = 0: seed the five (n,p,k)-binomials
%o A398688     c1m = 0;              \\ C(M1, k-1)
%o A398688     c1  = cb(M1, 0);      \\ C(M1, k)
%o A398688     c1p = cb(M1, 1);      \\ C(M1, k+1)
%o A398688     c0m = 0;              \\ C(M0, k-1)
%o A398688     c0  = cb(M0, 0);      \\ C(M0, k)
%o A398688     for (k = 0, n,
%o A398688       X = c1m*c0 - c1*c0m;
%o A398688       Y = c1 *c0 - c1p*c0m;
%o A398688       Z = c1 *c1 - c1p*c1m;
%o A398688       if (X || Y || Z,
%o A398688         \\ third column, indexed by j = k+r; note C(n-1,j+1) is next step's C(n-1,j)
%o A398688         j  = k;
%o A398688         b2 = cb(n-1, k);        \\ C(n-1, j)
%o A398688         b3 = cb(n,   k);        \\ C(n,   j)
%o A398688         w  = 1;                 \\ C(p+r, r)
%o A398688         for (r = 0, n - k,
%o A398688           b1 = if (b2, b2*(n-1-j)/(j+1), 0);        \\ C(n-1, j+1)
%o A398688           total += (b1*X - b2*Y + b3*Z) * w;
%o A398688           b2 = b1;
%o A398688           b3 = if (b3, b3*(n-j)/(j+1), 0);          \\ C(n, j+1)
%o A398688           w  = w*(p+r+1)/(r+1);                     \\ C(p+r+1, r+1)
%o A398688           j++));
%o A398688       \\ advance the (n,p,k) binomials to k+1
%o A398688       c1m = c1;  c1 = c1p;  c1p = if (c1p, c1p*(M1-k-1)/(k+2), cb(M1, k+2));
%o A398688       c0m = c0;  c0 = if (c0, c0*(M0-k)/(k+1), cb(M0, k+1))));
%o A398688   total;
%o A398688 }
%Y A398688 Cf. A001181 (Baxter permutations), A383372 (fixed by the half-turn), A151374 (fixed by a quarter-turn), A000085 (all involutions).
%K A398688 nonn,new
%O A398688 0,3
%A A398688 _Meghanto Majumder_, Aug 06 2026
