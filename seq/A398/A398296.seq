%U A398296 1304586832923008718111216,299475987331552683273026520,69443685228680778854248027200,16242226523194054384514962224000
%N A398296 Diagonal of rational function 1/(1 - (1 + x*y*z*w)*(x*(1 + x*y*z*w) + y + z + w)).
%C A398296 For integers s >= 1, t >= 0 and e_1, ... ,e_s >= 0 with e_1 + ... + e_s = t, [x_1^n*  ... *x_s^n] 1/(1 - Sum_{i=1..s} x_i * (1 + x_1* ... *x_s)^e_i) = Sum_{k=0..n} (s*k)!/k!^s * binomial(t*k,n-k). For s=4, t=5, (e_1,e_2,e_3,e_4)=(2,1,1,1), and (x_1,x_2,x_3,x_4)=(x,y,z,w), this gives a(n) = [x^n*y^n*z^n*w^n] 1/(1 - (1 + x*y*z*w)*(x*(1 + x*y*z*w) + y + z + w)).
%F A398296 a(n) = Sum_{k=0..n} (4*k)!/k!^4 * binomial(5*k,n-k).
%o A398296 (PARI) a(n, s=4, t=5) = sum(k=0, n, (s*k)!/k!^s*binomial(t*k, n-k));
%Y A398296 Cf. A360090, A361814.
%K A398296 nonn
