%U A398797 25917127,27968407,29269231,31675687,32966431,33886231,37911967,39003847,40274431,40636807,43345447,45321487,47823847,48358231,49247431
%N A398797 Numbers k such that psi(k) = phi(k) + tau(k)^8.
%C A398797 Contains all numbers of the form p*(2^15-p), where p and 2^15-p are both prime. Are there any other terms that are not of this form?
%e A398797 622231 is a term since psi(622231) = 655000 = 589464 + 4^8 = phi(622231) + tau(622231)^8.
%o A398797 (PARI) isok(k) = {my(f = factor(k)); prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) - eulerphi(f) == numdiv(f)^8; } \\ _Amiram Eldar_, Sep 09 2026
%Y A398797 Cf. A000005, A000010, A001615, A398971, A399539, A399540, A399541, A398648.
