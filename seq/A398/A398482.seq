%N A398482 Triangle read by rows: T(n, k) = n^k * (1 + n)^(n - k).
%H A398482 Paolo Xausa, <a href="/A398482/b398482.txt">Table of n, a(n) for n = 0..11475</a> (rows 0..150 of triangle, flattened).
%F A398482 T(n, k) = n^k * hypergeom([1, k - n], [1], -n).
%e A398482 Triangle starts:
%e A398482   [0]        1;
%e A398482   [1]        2,       1;
%e A398482   [2]        9,       6,       4;
%e A398482   [3]       64,      48,      36,      27;
%e A398482   [4]      625,     500,     400,     320,     256;
%e A398482   [5]     7776,    6480,    5400,    4500,    3750,    3125;
%e A398482   [6]   117649,  100842,   86436,   74088,   63504,   54432,  46656;
%e A398482   [7]  2097152, 1835008, 1605632, 1404928, 1229312, 1075648, 941192, 823543;
%p A398482 T := (n, k) -> n^k * hypergeom([1, k - n], [1], -n):
%p A398482 for n from 0 to 7 do seq(simplify(T(n, k)), k = 0..n) od;
%t A398482 A398482[n_, k_] := If[n == k == 0, 1, n^k*(n + 1)^(n - k)];
%t A398482 Table[A398482[n, k], {n, 0, 10}, {k, 0, n}] (* _Paolo Xausa_, Aug 10 2026 *)
%Y A398482 Column 0 as 0-based A000169, that is (n + 1)^n.
