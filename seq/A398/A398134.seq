%p A398134 # Using function 'binomial_matrix' from A399000.
%p A398134 BM := binomial_matrix(n -> bernoulli(n, 1)):
%p A398134 M := Matrix(8, 8, (n, k) -> BM(n-1, k-1));
%p A398134 seq(seq(denom(BM(n-k, k)), k = 0..n), n = 0..10);
%t A398134 (* Uses the function 'binomialMatrix' from A399000. *)
%t A398134 bM = binomialMatrix[BernoulliB[#, 1] &];
%t A398134 Table[bM[n, k] // Denominator, {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398134 (Python)  # Uses function 'binomial_matrix' from A399000.
%o A398134 from sympy import bernoulli
%o A398134 M = binomial_matrix(bernoulli)
%o A398134 for n in range(9): print([M(n, k).denominator for k in range(9)])
