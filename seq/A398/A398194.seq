%I A398194 #24 Aug 27 2026 00:50:33
%S A398194 1,3,5,2,4,6,8,10,12,9,7,18,15,13,11,14,16,19,17,34,32,29,27,24,22,20,
%T A398194 23,21,40,38,35,33,30,28,25,46,44,41,39,36,61,59,31,54,52,26,47,45,42,
%U A398194 69,67,37,62,60,58,55,53,51,48,50,79,49,78,76,43,70,68,66,63,65,98,64,97,95,93,56,87
%N A398194 Squares visited by a "Civet" (Knight + Dabbaba + Fers) moving on a spirally numbered board always to the lowest available unvisited square.
%C A398194 Board is numbered with the square spiral, with initial square labeled 1:
%C A398194 .
%C A398194   17--16--15--14--13
%C A398194    |               |
%C A398194   18   5---4---3  12
%C A398194    |   |       |   |
%C A398194   19   6   1---2  11
%C A398194    |   |           |
%C A398194   20   7---8---9--10
%C A398194    |
%C A398194   21--22--23--24--25--
%C A398194 .
%H A398194 Jens Ahlström, <a href="/A398194/b398194.txt">Table of n, a(n) for n = 1..10000</a>
%H A398194 Brad Spellman, <a href="https://www.bradspellman.com/q40/">Quest for Zero</a>
%e A398194 At step 4 square 2 is visited after which square 4 is the lowest available unvisited square, so a(5) = 4.
%o A398194 (Python)
%o A398194 def to_n(x, y):
%o A398194     if x == 0 and y == 0:
%o A398194         return 1
%o A398194     m = max(abs(x), abs(y))
%o A398194     inner = (2 * m - 1) ** 2
%o A398194     if x == m and y != -m:
%o A398194         return inner + (m + y)
%o A398194     elif y == m:
%o A398194         return inner + 2 * m + (m - x)
%o A398194     elif x == -m:
%o A398194         return inner + 4 * m + (m - y)
%o A398194     elif y == -m:
%o A398194         return inner + 6 * m + (x + m)
%o A398194     return 1
%o A398194 F = [(1,1), (-1,1), (1,-1), (-1,-1)]
%o A398194 D = [(2,0), (-2,0), (0,2), (0,-2)]
%o A398194 N = [(1,2), (2,1), (-1,2), (-2,1), (1,-2), (2,-1), (-1,-2), (-2,-1)]
%o A398194 moves = N + D + F
%o A398194 visited = set([1])
%o A398194 seq = [1]
%o A398194 current_x, current_y = 0, 0
%o A398194 for _ in range(76):
%o A398194     best_n = float('inf')
%o A398194     next_x, next_y = None, None
%o A398194     for dx, dy in moves:
%o A398194         tx, ty = current_x + dx, current_y + dy
%o A398194         tn = to_n(tx, ty)
%o A398194         if tn not in visited and tn < best_n:
%o A398194             best_n, next_x, next_y = tn, tx, ty
%o A398194     if next_x is None: break
%o A398194     visited.add(best_n)
%o A398194     seq.append(best_n)
%o A398194     current_x, current_y = next_x, next_y
%o A398194 print(seq)
%Y A398194 Cf. A316667 (Knight), A316884 (Fers), A317467 (Alfil), A399158 (Dabbaba), A000027 (Wazir), A396103 (Spider), A398779 (Alfil + Knight), A398717 (Priest), A398965 (Carpenter), A399160 (Fers + Alfil), A399167 (Leopard), A005408 (Kirin), A399315 (Squirrel).
%K A398194 nonn,new
%O A398194 1,2
