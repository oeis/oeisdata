%I A398443 #11 Aug 14 2026 09:49:41
%S A398443 32,96,160,224,243,352,416,480,544,608,672,736,928,992,1056,1120,1184,
%T A398443 1215,1248,1312,1376,1504,1632,1696,1701,1760,1824,1888,1952,2080,
%U A398443 2144,2208,2272,2336,2464,2528,2656,2673,2720,2784,2848,2912,2976,3040,3104,3125,3159
%N A398443 Numbers k of the form lpf(k)^4 * rad(k), where rad = A007947, and lpf is the least prime factor.
%C A398443 Superset of A050997 (p^5 for prime p).
%C A398443 Unsorted prime signature {5} followed by zero or more 1's.
%C A398443 Smallest number k of this form k with j > 0 distinct prime factors, is 2^4 * A002110(j).
%H A398443 Michael De Vlieger, <a href="/A398443/b398443.txt">Table of n, a(n) for n = 1..10000</a>
%F A398443 {a(n)} = {k : A398302(k) = 1 and A124010(k,1) = 5}. - _Peter Munn_, Aug 14 2026
%e A398443 Table of n, a(n) for select n:
%e A398443      n      a(n)
%e A398443   -----------------------------------------
%e A398443      1       32 = 2^5
%e A398443      2       96 = 2^5 * 3
%e A398443      3      160 = 2^5 * 5
%e A398443      4      224 = 2^5 * 7
%e A398443      5      243 = 3^5
%e A398443      6      352 = 2^5 * 11
%e A398443      7      416 = 2^5 * 13
%e A398443      8      480 = 2^5 * 3 * 5
%e A398443     11      672 = 2^5 * 3 * 7
%e A398443     50     3360 = 2^5 * 3 * 5 * 7
%e A398443    520    36960 = 2^5 * 3 * 5 * 7 * 11
%e A398443   6736   480480 = 2^5 * 3 * 5 * 7 * 11 * 13
%t A398443 nn = 3200; Set[{k, m}, {1, 4}]; mm = nn/Prime[k]^m; Union@ Map[If[# <= nn, #, Nothing] &[#*FactorInteger[#][[k, 1]]^m] &, Select[Range[2, mm], SquareFreeQ] ]
%Y A398443 Cf. A002110, A005117, A007947, A050997, A124010, A398302.
%Y A398443 Intersection of A195088 and A375396.
%Y A398443 Subsequence of A386808.
%Y A398443 See A397458 for a list of equivalent sequences with other exponents of lpf(k) in the definition.
%K A398443 nonn,easy
%O A398443 1,1
%A A398443 _Michael De Vlieger_, Aug 06 2026
