%I A398156 #7 Aug 03 2026 21:16:33
%S A398156 74,164,4822,16609,743325,1640565,47757783,160673087,2960799523,
%T A398156 23018638268,150260425527,30045984061852,30045984061852,
%U A398156 259607904633050,5774724907212535,38436930563153321,253557467112215334,3772379064769493453,22544334398750634909,4727917761688085371766
%N A398156 a(n) is the least positive integer m such that (1 + 1/m)^m and e agree in their first n digits after the decimal point, without rounding.
%C A398156 Since (1 + 1/m)^m increases monotonically to e as m tends to infinity, a(n) is well-defined.
%C A398156 The sequence is nondecreasing.
%C A398156 a(n + 1) = a(n) if and only if the (n + 1)-st digit after the decimal point of e is 0. For example, a(12) = a(13) because the 13th digit after the decimal point of e is 0.
%C A398156 The sequence is related to A247784: a(n) is the least m such that e - (1 + 1/m)^m <= frac(10^n*e)/10^n.
%C A398156 a(n + 1) = a(n) iff n + 1 is in A053659.
%H A398156 Felix Huber, <a href="/A398156/b398156.txt">Table of n, a(n) for n = 1..995</a>
%H A398156 Felix Huber, <a href="/A398156/a398156.txt">Proof that a(n + 1) = a(n) iff the (n + 1)-st digit after the decimal point of e is 0</a>
%F A398156 a(n) = min{m >= 1 : floor(10^n*(1 + 1/m)^m) = floor(10^n*e)}.
%F A398156 a(n) = e*10^n/(2*frac(10^n*e)) + O(1).
%F A398156 Limit_{n -> infinity} a(n)*frac(10^n*e)/10^n = e/2.
%F A398156 a(n + 1) = a(n) <=> floor(10^(n + 1)*e) = 10*floor(10^n*e).
%e A398156 a(1) = 74 because (1 + 1/73)^73 = 2.699894... does not have the same first digit after the decimal point as e = 2.718281..., while (1 + 1/74)^74 = 2.700139... does.
%e A398156 a(2) = 164 because (1 + 1/163)^163 = 2.709990... does not have the same first two digits after the decimal point as e, while (1 + 1/164)^164 = 2.710040... does.
%p A398156 A398156 := proc(n)
%p A398156     local d, f, h, l, m, q, s, u;
%p A398156     d := Digits;
%p A398156     Digits := 2*n + 30;
%p A398156     q := floor(evalf(10^n*exp(1))); s := evalf(ln(q) - n*ln(10));
%p A398156     f := proc(m)
%p A398156         local k, r, t;
%p A398156         t := 1; k := 2; r := 1/(2*m);
%p A398156         while abs(r) > 10^(-2*n - 20) do t := t + (-1)^(k - 1)/(k*m^(k - 1)); k := k + 1; r := 1/(k*m^(k - 1)) od;
%p A398156         evalf(t)
%p A398156     end proc;
%p A398156     u := evalf(exp(1) - q/10^n); m := max(1, floor(exp(1)/(2*u))); l := max(1, iquo(m, 2)); h := 2*m;
%p A398156     while f(l) >= s and l > 1 do h := l; l := max(1, iquo(l, 2)) od;
%p A398156     while f(h) < s do l := h; h := 2*h od;
%p A398156     while l + 1 < h do m := iquo(l + h, 2); if f(m) >= s then h := m else l := m fi od;
%p A398156     Digits := d;
%p A398156     h
%p A398156 end proc;
%p A398156 seq(A398156(n), n = 1 .. 20);
%Y A398156 Cf. A001113, A053659, A247784, A398155, A398158.
%K A398156 nonn,base
%O A398156 1,1
%A A398156 _Felix Huber_, Jul 27 2026
