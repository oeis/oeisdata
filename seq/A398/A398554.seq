%I A398554 #36 Nov 03 2026 17:41:23
%S A398554 139,887,1583,4871,7019,8059,15823,39119,48299,57487,81671,93491,
%T A398554 207743,213223,304439,417023,451303,467531,541391,722147,860759,
%U A398554 1165951,1213943,1483019,1571959,1627643,1821871,1937063,2370947,2414219,2721811,3253571,3571307,3662539,3700979,4259159,4459519
%N A398554 Prime values of (square of perimeter) - hypotenuse for primitive Pythagorean triples.
%C A398554 Primes that can be written as (2*m^2 + 2*m*n)^2 - (m^2+n^2) where m and n are coprime and of opposite parities.
%C A398554 Primes (if any) that correspond to more than one primitive Pythagorean triples would be listed several times, one for each such triple.
%H A398554 Robert Israel, <a href="/A398554/b398554.txt">Table of n, a(n) for n = 1..10000</a>
%e A398554 a(3) = 1583 is a term because the primitive Pythagorean triple (8,15,17) has perimeter 40, hypotenuse 17, and 40^2 - 17 = 1583 which is prime.
%p A398554 N:= 10^7: # for terms <= N
%p A398554 R:= NULL:
%p A398554 for m from 1 while 4*m^4 + 8*m^3 + 3*m^2-1 <= N do
%p A398554   for n from (m mod 2) + 1 by 2 to m-1 do
%p A398554     if igcd(m,n) > 1 then next fi;
%p A398554     v:= (2*m^2 + 2*m*n)^2 - (m^2+n^2);
%p A398554     if v > N then break fi;
%p A398554     if isprime(v) then R:= R, v fi
%p A398554 od od:
%p A398554 sort([R]);
%Y A398554 Cf. A401513, A401514, A401515.
%K A398554 nonn,new
%O A398554 1,1
%A A398554 _Will Gosnell_ and _Robert Israel_, Oct 27 2026
