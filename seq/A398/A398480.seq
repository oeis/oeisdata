%N A398480 Triangle read by rows: T(n, k) = Sum_{i=0..n-k} RisingFactorial(i + 1, n - i - k) * n^(n - i).
%F A398480 T(n, k) = n^k * hypergeom([1, k - n], [], -n) for n >= 1.
%F A398480 T(n, k) = n^n * exp(1/n) * Gamma(n - k + 1, 1/n) for n >= 1.
%e A398480 Triangle starts:
%e A398480   [0]          1;
%e A398480   [1]          2,         1;
%e A398480   [2]         13,         6,         4;
%e A398480   [3]        226,        75,        36,       27;
%e A398480   [4]       7889,      1972,       656,      320,     256;
%e A398480   [5]     458026,     91605,     22900,     7625,    3750,    3125;
%e A398480   [6]   39684637,   6614106,   1322820,   330696,  110160,   54432,  46656;
%e A398480   [7] 4788052298, 684007471, 114001244, 22800239, 5699974, 1899191, 941192, 823543;
%p A398480 A398480 := (n, k) -> add(pochhammer(i+1, n-i-k) * n^(n-i), i = 0..n-k):
%p A398480 seq(print(seq(A398480(n, k), k = 0..n)), n = 0..8);
%t A398480 T[0, 0] := 1; T[n_, k_] := n^k HypergeometricPFQ[{1, k - n}, {}, -n]
%t A398480 Table[T[n, k], {n, 0, 7}, {k, 0, n}] // MatrixForm
%o A398480 (Python)
%o A398480 from sympy import rf  # rising_factorial
%o A398480 def A398480(n, k): return sum(rf(i+1, n-i-k) * n**(n-i) for i in range(n-k+1))
%o A398480 TA398480 = [[A398480(n, k) for k in range(n+1)] for n in range(8)]
%o A398480 for row in TA398480: print(row)
%Y A398480 Cf. A277452 (column 0), A000312 (main diagonal), A055541 (subdiagonal), A398481 (row sums).
