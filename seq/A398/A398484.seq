%p A398484 T := (n, k) -> add(pochhammer(j + 1, n - k - j) * n^(k - n + j), j = 0..n-k):
%p A398484 seq(print(seq(numer(T(n, k)), k = 0..n)), n = 0..9);
%t A398484 T[n_, k_] := Sum[Product[(n - k - j + 1) / n, {j, 1, m}], {m, 0, n - k}]
%t A398484 Table[Print[Table[Numerator[T[n, k]], {k, 0, n}] // InputForm], {n, 0, 8}]
%t A398484 (* Alternative: continuous form for x > 0 *)
%t A398484 Q[0, 0] = 1; Q[x_, y_] := Integrate[Exp[-t] * (1 + t/x)^(x - y), {t, 0, Infinity}]
%t A398484 (* Alternative: expansion of the tree function *)
%t A398484 treeT[z_] := -ProductLog[-z]; Q[0, 0] = 1;
%t A398484 Q[n_, k_] := ((n-k)! / n^(n-k)) SeriesCoefficient[treeT[z]^k / (1 - treeT[z])^2, {z, 0, n}]
%o A398484 (SageMath)
%o A398484 def T(n, k):
%o A398484     return sum(rising_factorial(i + 1, n - k - i) * QQ(n)**(k - n + i)
%o A398484     for i in range(n - k + 1))
%o A398484 T_table = [[T(n, k) for k in range(n + 1)] for n in range(10)]
%o A398484 for row in T_table: print([r.numerator() for r in row])
%o A398484 (Python)
%o A398484 from functools import cache
%o A398484 from fractions import Fraction as frac
%o A398484 @cache
%o A398484 def Q(n: int, k: int) -> frac:
%o A398484     if k == n: return frac(1)
%o A398484     return frac(1) + Q(n, k + 1) * frac(n - k, n)
%o A398484 for n in range(10): print(", ".join(f"{Q(n, k)}" for k in range(n + 1)))
