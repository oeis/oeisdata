%T A398969 1731369577,1755142907,1797780123,4275422833,4334128403,5971458337,
%U A398969 6053452067
%N A398969 Numbers k such that sigma(k) = psi(k) + tau(k)^7.
%C A398969 Includes p * q * r^2 for distinct primes p,q,r such that (p + 1) * (q + 1) = 35831808. For example p = 8191 and q = 4373.
%e A398969 14155749 is a term since sigma(14155749) = 20971520 = 18874368 + 8^7 = psi(14155749) + tau(9953260)^7.
%o A398969 (PARI) isok(k) = {my(f = factor(k)); sigma(f) - prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) == numdiv(f)^7; } \\ _Amiram Eldar_, Aug 15 2026
%o A398969 (Python)
%o A398969 from math import prod
%o A398969 from sympy import factorint
%o A398969 def ok(n):
%o A398969     f = factorint(n)
%o A398969     sigma = prod((p**(e+1)-1)//(p-1) for p, e in f.items())
%o A398969     psi = prod((p+1)*p**(e-1) for p, e in f.items())
%o A398969     tau = prod(e+1 for e in f.values())
%o A398969     return sigma == psi + tau**7
%o A398969 # _Michael S. Branicky_, Aug 15 2026
%Y A398969 Cf. A000005 (tau), A000203 (sigma), A001615 (psi), A387953, A390296, A390297, A389546, A390420, A398968.
