%I A398583 #15 Aug 11 2026 19:01:02
%S A398583 1,3,710,21053343141,2646693125139304345,
%T A398583 4427007044615115050034854648525685871587
%N A398583 Earliest sequence of numbers k such that k * sin(k) is positive and decreases monotonically toward 0.
%C A398583 This is the subsequence of A337249 with successive positive lows for k * sin(k), and the Python code here therefore uses the A337249 Python code.
%C A398583 This sequence is infinite iff the sequence k * sin(k) accumulates on the positive side of 0, which is an open question. If k * sin(k) is dense on the real line, or if the irrationality measure of Pi exceeds 2, then the sequence is infinite.
%H A398583 Sean A. Irvine, <a href="/A398583/b398583.txt">Table of n, a(n) for n = 1..8</a>
%H A398583 Per Alexandersson, question on MathStackExchange, <a href="https://math.stackexchange.com/questions/221018">Is n * sin(n) dense on the real line?</a>
%H A398583 Hagen von Eitzen, answer on Mathematics StackExchange, <a href="https://math.stackexchange.com/a/1309328">Accumulation points of {n * sin(n)}</a>
%e A398583 1 * sin(1) ~ 0.841, 3 * sin(3) ~ 0.423, 710 * sin(710) ~ 0.043.
%o A398583 (Python)
%o A398583 import mpmath as mp
%o A398583 digits = 200
%o A398583 K = 10 ** digits
%o A398583 mp.mp.dps = max(80, 4 * digits)
%o A398583 out = {1}
%o A398583 pold, qold = 0, 1
%o A398583 p, q = 1, 0
%o A398583 x = mp.pi
%o A398583 while p < K:
%o A398583     a = int(mp.floor(x))
%o A398583     pold, p = p, a * p + pold
%o A398583     qold, q = q, a * q + qold
%o A398583     err = p - q * mp.pi
%o A398583     tmax = mp.sqrt(2 / abs(p * err))
%o A398583     for t in range(1, int(tmax) + 1):
%o A398583         k = t * p
%o A398583         if 0 < k * mp.sin(k) < 1 and k < K:
%o A398583             out.add(k)
%o A398583     x = 1 / (x - a)
%o A398583 subseq = []
%o A398583 min_val = 1
%o A398583 for k in sorted(out):
%o A398583     val = k * mp.sin(k)
%o A398583     if val < min_val:
%o A398583         subseq.append(k)
%o A398583         min_val = val
%o A398583 print(subseq)
%Y A398583 Subsequence of A337249 and A046946.
%K A398583 nonn,new
%O A398583 1,2
%A A398583 _Matt Frank_, Aug 03 2026
