%I A398846 #7 Sep 18 2026 06:25:58
%S A398846 0,0,3,8,14,22,32,44,58,73,90,110,131,153,178,205,233,263,295,329,365,
%T A398846 402,441,483,526,570,617,666,716,768,822,878,936,995,1056,1120,1185,
%U A398846 1251,1320,1391,1463,1537,1613,1691,1771,1852,1935,2021,2108,2196,2287
%N A398846 Lower (1/3, 1/2)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398846 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398846 <a href="/index/Rec#order_7">Index entries for linear recurrences with constant coefficients</a>, signature (2,-2,3,-3,2,-2,1).
%F A398846 a(n) = 2*a(n-1) - 2*a(n-2) + 3*a(n-3) - 3*a(n-4) + 2*a(n-5) - 2*a(n-6) + a(n-7);  (a(0), ..., a(6)) =  (0, 0, 3, 8, 14, 22, 32).
%F A398846 G.f.: -(x^2 *(3 + 2*x + 4*x^2 + x^3 + x^4)/((-1 + x)^3 *(1 + x + 2*x^2 + x^3 + x^4))).
%F A398846 a(n) = floor(n*(11*n-1)/12). (n+1)*a(n) +2*a(n-1) +(n-1)*a(n-2) +(-n-5)*a(n-3) -2*a(n-4) +(-n-3)*a(n-5) +2*(-25*n+72)=0. - _R. J. Mathar_, Sep 18 2026
%t A398846 z = 60;
%t A398846 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398846 r =1/3; s = 1/2;
%t A398846 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398846 Table[u[n], {n, 0, z}]
%Y A398846 Cf. A000217, A000326, A398844, A398847.
%K A398846 nonn,easy,new
%O A398846 0,3
%A A398846 _Clark Kimberling_, Sep 16 2026
