%S A398619 1,-1,-2,4,-3,-4,12,-8,-10,28,-18,-24,60,-38,-48,120,-75,-92,228,-140,
%T A398619 -172,416,-252,-304,732,-439,-524,1252,-744,-884,2088,-1232,-1450,
%U A398619 3408,-1998,-2336,5460,-3182,-3704,8600,-4986,-5772,13344,-7700,-8872,20424,-11736,-13472,30876,-17673,-20206
%N A398619 Expansion of eta(q) * eta(q^2) * eta(q^6) / eta(q^3)^3 in powers of q.
%C A398619 Sequence is 2-convolutive; that is, the generating function A(x) satisfies A(x) + A(-x) = 2*A(x^2)^2.
%H A398619 Shane Chern, Dennis Eichhorn, Shishuo Fu, and James A. Sellers, <a href="https://arxiv.org/abs/2608.01136">Convolutive sequences, II: Parametrizations</a>, arXiv:2608.01136 [math.CO], 2026.
%F A398619 Expansion of eta(q) * eta(q^2) * eta(q^6) / eta(q^3)^3 in powers of q.
%e A398619 G.f. = 1 - q - 2*q^2 + 4*q^3 - 3*q^4 - 4*q^5 + 12*q^6 - 8*q^7 - 10*q^8 + ...
%p A398619 with(QDifferenceEquations);  series(expand(QPochhammer(q, q, 100)*QPochhammer(q^2, q^2, 100)*QPochhammer(q^6, q^6, 100)/QPochhammer(q^3,q^3,100)^3), q, 100);
%t A398619 nmax = 50; CoefficientList[Series[Product[(1 - x^k) * (1 - x^(2*k)) * (1 - x^(6*k)) / (1 - x^(3*k))^3, {k, 1, nmax}], {x, 0, nmax}], x] (* _Vaclav Kotesovec_, Aug 04 2026 *)
%Y A398619 Cf. A261326, A398620.
%K A398619 sign
%O A398619 0,3
%A A398619 _James Sellers_, Aug 04 2026
