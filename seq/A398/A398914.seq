%N A398914 a(n) = n * (n + 2) * binomial(2*n + 1, n + 1).
%H A398914 Paolo Xausa, <a href="/A398914/b398914.txt">Table of n, a(n) for n = 0..1000</a>
%F A398914 a(n) = n! * [x^n] 9*x*hypergeom([5/2, 4], [3, 3], 4*x).
%F A398914 a(n) ~ 2^(2*n+1)*n^(3/2)/sqrt(Pi). - _Stefano Spezia_, Aug 14 2026
%F A398914 D-finite with recurrence: (n-1)*(n+1)^2*a(n) - (4*n^3+10*n^2+4*n)*a(n-1) = 0, a(0)=0, a(1)=9. - _Georg Fischer_, Aug 16 2026
%p A398914 egf := 9*x*hypergeom([5/2, 4], [3, 3], 4*x): ser := series(egf, x, 24):
%p A398914 seq(n!*coeff(ser, x, n), n = 0..23);
%t A398914 A398914[n_] := n*(n + 2)*Binomial[2*n + 1, n + 1];
