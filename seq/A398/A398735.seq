%S A398735 1,2,20,272,4752,102564,2647172,79630840,2737115736,105855625356,
%T A398735 4549913913612,215186948604352,11105856011804400,621128830609382764,
%U A398735 37421467303433367492,2416239894702004155400,166454962311845075062128,12186617916204403365981900
%N A398735 a(0) = 1; a(n) = Sum_{k=1..n} binomial(3*n-1,k) * a(n-k).
%F A398735 G.f. A(x) satisfies A(x) = (1-2*x) * (2*A(x/(1+x)^3) - 1).
%F A398735 a(n) is even for n > 0.
%p A398735 a:= proc(n) option remember; `if`(n=0, 1,
%p A398735       add(binomial(3*n-1,k) * a(n-k),k=1..n))
%p A398735     end:
%p A398735 seq(a(n), n=0..17);  # _Alois P. Heinz_, Nov 02 2026
%o A398735 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(3*i-1, j)*v[i-j+1])); v;
%Y A398735 Cf. A398734, A398736, A398737.
%Y A398735 Cf. A401682.
