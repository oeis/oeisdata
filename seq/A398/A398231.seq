%I A398231 #7 Aug 04 2026 18:42:34
%S A398231 0,0,0,0,0,1,2,3,4,7,3,13,7,19,31,21,18,16,14,37,30,33,35,59,50,61,50,
%T A398231 48,39,75,56,45,49,62,79,141,77,65,89,95,73,116,71,104,102,97,54,80,
%U A398231 57,100,99,109,63,100,90,161,175,135,85,138,71,84,93,105,89,157
%N A398231 a(n) is the number of distinct unordered pairwise sums with repetition of the distinct trinomial coefficient values of order n that have more than one representation.
%C A398231 Let B(n) be the set of distinct coefficients in the expansion of (x + y + z)^n, that is, B(n) = {multinomial(n; i, j, k) : i, j, k >= 0 and i + j + k = n}. Thus |B(n)| = A086753(n).
%C A398231 For an integer t, let r_n(t) = |{(x, y) : x, y in B(n), x <= y and x + y = t}|.
%C A398231 Thus a(n) is the number of distinct pairwise sums t having at least two unordered representations with repetition as x + y with x, y in B(n).
%C A398231 A398230(n) counts the total collision excess among these pairwise sums. Hence a(n) <= A398230(n), with equality if and only if no pairwise sum has more than two representations.
%C A398231 For n >= 6, a(n) > 0 since multinomial(n; n - 6, 6, 0) + multinomial(n; n - 6, 3, 3) = multinomial(n; n - 6, 5, 1) + multinomial(n; n - 6, 4, 2), which follows from 1 + 20 = 6 + 15 in row 6 of Pascal's triangle. Together with the collision 10 + 30 = 20 + 20 for n = 5 and direct inspection for 0 <= n <= 4, this shows that a(n) = 0 if and only if 0 <= n <= 4.
%C A398231 Every additive relation among binomial coefficients in row r of Pascal's triangle induces an additive relation among trinomial coefficients of order n for every n >= r, since multinomial(n; n - r, r - k, k) = binomial(n, r)*binomial(r, k).
%C A398231 For odd n = 2*s + 1, a four-term identity gives floor((s - 1)/2) distinct genuine collision sums, and hence a(n) >= floor((n - 3)/4) for odd n >= 7. See the Huber link for a proof.
%C A398231 Using embedded Pascal-row collisions with r = d^2 - 4 gives a(n) >= ceiling((floor(sqrt(n + 4)) - 3)/2) for n >= 12. See the Huber link for a proof.
%C A398231 Direct computation shows that the first pairwise sum having three representations occurs at n = 11: 2310 + 11550 = 4620 + 9240 = 6930 + 6930.
%H A398231 Felix Huber, <a href="/A398231/b398231.txt">Table of n, a(n) for n = 0..242</a>
%H A398231 Felix Huber, <a href="/A398231/a398231.txt">Proofs and lower bounds for A398230 and A398231</a>
%F A398231 a(n) = |{t : r_n(t) >= 2}|, where r_n(t) = |{(x, y) : x, y in B(n), x <= y and x + y = t}|.
%F A398231 a(n) = A398230(n) - Sum_t max(r_n(t) - 2, 0).
%F A398231 a(n) = A398237(n, 3) for n >= 3.
%F A398231 a(n) >= floor((n - 3)/4) for odd n >= 7.
%F A398231 a(n) >= ceiling((floor(sqrt(n + 4)) - 3)/2) for n >= 12.
%e A398231 For n = 5, B(5) = {1, 5, 10, 20, 30}. The sum 40 has the two representations 10 + 30 and 20 + 20, while every other unordered pairwise sum has only one representation. Hence a(5) = 1.
%p A398231 A398231 := proc(n) option remember;
%p A398231     local a, i, j, l, m, r, s, t;
%p A398231     t := table();
%p A398231     for i from iquo(n + 2, 3) to n do
%p A398231         for j from iquo(n - i + 1, 2) to min(i, n - i) do
%p A398231             t[binomial(n, i)*binomial(n - i, j)] := 1
%p A398231         end do
%p A398231     end do;
%p A398231     l := [indices(t, 'nolist')];
%p A398231     m := nops(l);
%p A398231     s := table();
%p A398231     a := 0;
%p A398231     for i to m do
%p A398231         for j from i to m do
%p A398231             r := l[i] + l[j];
%p A398231             if assigned(s[r]) then
%p A398231                 if s[r] = 1 then
%p A398231                     a := a + 1;
%p A398231                     s[r] := 2
%p A398231                 end if
%p A398231             else
%p A398231                 s[r] := 1
%p A398231             end if
%p A398231         end do
%p A398231     end do;
%p A398231     a
%p A398231 end proc:
%p A398231 seq(A398231(n), n = 0 .. 65);
%Y A398231 Cf. A046816, A086753, A394957, A398230, A398232, A398233, A398237, A398238, A398263, A398265, A398429.
%K A398231 nonn,new
%O A398231 0,7
%A A398231 _Felix Huber_, Jul 29 2026
