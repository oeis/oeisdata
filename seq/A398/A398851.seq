%I A398851 #11 Sep 21 2026 00:54:03
%S A398851 0,0,1,1,3,5,7,10,13,17,21,26,31,37,44,50,58,66,74,83,92,102,112,123,
%T A398851 134,146,159,171,185,199,213,228,243,259,275,292,309,327,346,364,384,
%U A398851 404,424,445,466,488,510,533,556,580,605,629,655,681,707,734,761
%N A398851 Upper (-1/2, 1/3)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398851 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398851 <a href="/index/Rec#order_11">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1,-1,2,-1,1,-2,1).
%F A398851 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5) - a(n-6) + 2*a(n-7) - a(n-8) + a(n-9) - 2*a(n-10) + a(n-11); (a(0), ..., a(10)) = (0, 0, 1, 1, 3, 5, 7, 10, 13, 17, 21).
%t A398851 z = 60;
%t A398851 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398851 r =-1/2; s = 1/3;
%t A398851 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398851 Table[v[n], {n, 0, z}]
%Y A398851 Cf. A000217, A000326, A398850.
%K A398851 nonn,easy,new
%O A398851 0,5
%A A398851 _Clark Kimberling_, Sep 18 2026
