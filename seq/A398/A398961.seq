%t A398961 For [ r=1, r < 40, r = r+2,
%t A398961     For [ c=1 , c <= r , c = c+2,
%t A398961         If [ c ==1,
%t A398961             tz = z/(1-z^2)^2,
%t A398961             If [ c == 3,
