%I A398141 #37 Sep 08 2026 19:49:11
%S A398141 0,1,2,3,5,11,156167,364863,1406923,3699739,5992555,122925461,
%T A398141 3083975227,2685575996367
%N A398141 Numbers k such that (sin(k))^k sets a new record low.
%C A398141 (sin(0))^0 is interpreted as limit of (sin(x))^x as x -> 0.
%C A398141 Unlike A382815, the terms are not confined to numerators of odd-denominator convergents and semiconvergents of Pi/2.
%C A398141 Conjecture: every term after 0 is either the numerator of a convergent (A096456) or semiconvergent of Pi/2, or else p + 2p', where p/q and p'/q' are consecutive convergents of Pi/2. Of the 13 terms after 0, 7 are convergents, 4 are semiconvergents, and 2 are of the last form: 364863 = 260515 + 2*52174 and 5992555 = 4846147 + 2*573204.
%e A398141 The first few values of (sin(k))^k are:
%e A398141   sin(0)^0   =  1
%e A398141   sin(1)^1   =  0.841470984807896
%e A398141   sin(2)^2   =  0.826821810431805
%e A398141   sin(3)^3   =  0.002810384734461
%e A398141   sin(4)^4   =  0.328042581863883
%e A398141   sin(5)^5   = -0.81081460609467
%e A398141   sin(6)^6   =  0.000475886020687
%e A398141   sin(7)^7   =  0.052831820502919
%e A398141   sin(8)^8   =  0.917970288581835
%e A398141   sin(9)^9   =  0.000342924768404
%e A398141   sin(10)^10 =  0.002270688337734
%e A398141   sin(11)^11 = -0.99989227733272
%e A398141 and the record low points are at k = 0, 1, 2, 3, 5, 11, ...
%t A398141 Module[{x, y, runningMin = 1.1, positions = {}},
%t A398141   x = Range[0, 10^6];
%t A398141   y = Join[{1}, Sin[#]^# &[Range[10^5]]];
%t A398141   Do[If[y[[i]] < runningMin, runningMin = y[[i]]; AppendTo[positions, x[[i]]]; ], {i, Length[y]}];
%t A398141   positions
%t A398141 ]
%o A398141 (Python)
%o A398141 from mpmath import iv
%o A398141 running_min, A398141 = 2, []
%o A398141 for i in range(100):
%o A398141     while True:
%o A398141         x = iv.sin(i)**i
%o A398141         if (comparison:=x<running_min) is None:
%o A398141             iv.dps += 1
%o A398141             running_min = iv.sin(A398141[-1])**A398141[-1]
%o A398141         else: break
%o A398141     if comparison:
%o A398141         A398141.append(i)
%o A398141         print(i)
%o A398141         running_min = x
%o A398141 print(A398141)
%Y A398141 Cf. A096456, A382815, A383229, A383540, A399200.
%K A398141 nonn,more,new
%O A398141 1,3
%A A398141 _Jwalin Bhatt_, Aug 25 2026
