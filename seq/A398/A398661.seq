%I A398661 #6 Aug 24 2026 00:09:58
%S A398661 0,1,6,17,35,62,101,154,222,307,412,539,689,864,1067,1300,1564,1861,
%T A398661 2194,2565,2975,3426,3921,4462,5050,5687,6376,7119,7917,8772,9687,
%U A398661 10664,11704,12809,13982,15225,16539,17926,19389,20930,22550,24251,26036,27907
%N A398661 Lower (1/2, 1) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398661 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398661 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398661 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) =  (0, 1, 6, 17, 35, 62).
%F A398661 G.f.: x*(1 + 2*x + x^3)/((-1 + x)^4 *(1 + x^2)).
%F A398661 E.g.f.: (exp(x)*(4*x^3 + 21*x^2 + 18*x - 3) + 3*cos(x) - 3*sin(x))/12. - _Stefano Spezia_, Aug 22 2026
%t A398661 z = 60;
%t A398661 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398661 r = 1/2; s = 1;
%t A398661 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398661 Table[u[n], {n, 0, z}]
%Y A398661 Cf. A000217, A000330, A398662.
%K A398661 nonn,easy,new
%O A398661 0,3
%A A398661 _Clark Kimberling_, Aug 22 2026
