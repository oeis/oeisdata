%I A398761 #15 Nov 07 2026 23:06:37
%S A398761 0,1,2,3,4,-3,-2,-1,6,5,12,11,10,9,8,7,14,13,20,19,18,17,16,15,22,21,
%T A398761 28,-21,-14,-7,-6,-5,-4,-11,-10,-9,-8,-15,-16,-17,-18,-19,-12,-13,-20,
%U A398761 -27,-26,23,24,25,-24,-23,-22,27,26,33,32,31,30,29,36,35,34
%N A398761 a(0) = 0; for n >= 1, a(n) minimizes |a(n)| among integers not in a(0), ..., a(n-1) with |a(n) - a(n-1)| = 7^j for an integer j >= 0, choosing the positive value in a tie.
%C A398761 This sequence is a variant of A377091, based on powers of 7 instead of squares.
%C A398761 It appears that every integer occurs. Gujord (see Links) gives a proposed computer-assisted proof, developed with AI assistance with a Lean formalization of the coverage theorem. The proof has not received independent human mathematical review.
%C A398761 If this proof is correct, then for k >= 6 every integer x with |x| <= (7^k-1)/2 - 37 occurs among a(0), ..., a(7^k).
%H A398761 Roger Gujord, <a href="https://doi.org/10.5281/zenodo.23912682">The base-seven Heraclitus transform: manuscript and reproducible proof package</a>, version 1.0.0 (2026).
%H A398761 Roger Gujord, <a href="https://github.com/gujord/heraclitus-base7">Source code, Lean proofs and certificates</a>.
%t A398761 A398761list[nmax_] := Module[{s, a, u = 1}, s[_] := False; NestList[(While[s[u] && s[-u], u++]; a = u; While[s[a] || !IntegerQ[Log[7, Abs[# - a]]], a = Boole[a < 0] - a]; s[a] = True; a) &, 0, nmax]];
%t A398761 A398761list[100] (* _Paolo Xausa_, Nov 07 2026 *)
%Y A398761 Cf. A377090, A377091, A379719.
%K A398761 sign,new
