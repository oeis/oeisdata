%I A398538 #13 Aug 10 2026 17:42:58
%S A398538 1,1,2,10,35,91,260,820,2501,7381,22022,66430,199655,597871,1792520,
%T A398538 5380840,16145801,48427561,145272842,435848050,1307573675,3922632451,
%U A398538 11767808780,35303692060,105911341901,317733228541,953198888462,2859599056870,8578799562095
%N A398538 Number of n-tuples (a_1, ..., a_n) in (Z/3Z)^n such that M(a_1)*M(a_2)*...*M(a_n) = -I, where M(a) = [a, -1; 1, 0].
%C A398538 For n >= 3, a(n) counts the tame frieze patterns of width n-3 over Z/3Z, the n-tuple being the quiddity cycle.
%C A398538 This is the case q = 3 of the same count over Z/qZ. The case q = 2 gives A001045.
%H A398538 S. Benzaira, I. Short, M. van Son, and A. Zabolotskii, <a href="https://arxiv.org/abs/2410.23400">Enumerating tame friezes over Z/nZ</a>, arXiv:2410.23400 [math.CO], 2024.
%H A398538 Vico Bonfioli, <a href="https://doi.org/10.5281/zenodo.21730517">Friezes over finite commutative rings: tame rigidity, the regular dichotomy, and the singular locus of the monodromy variety</a>, Zenodo, 2026.
%H A398538 S. Morier-Genoud, <a href="https://doi.org/10.5802/alco.140">Counting Coxeter's friezes over a finite field via moduli spaces</a>, Algebraic Combinatorics 4 (2021), 225-240.
%H A398538 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (2,0,6,9).
%F A398538 G.f.: x^2*(1-x)/((1+x)*(1-3*x)*(1+3*x^2)).
%F A398538 a(n) = 2*a(n-1) + 6*a(n-3) + 9*a(n-4) for n >= 6.
%F A398538 a(n) = (3^(n-1) + (-1)^n)/8 + b(n), where b(n) = 0 for n odd, b(n) = -3^(n/2-1)/2 for n == 0 (mod 4), and b(n) = 3^(n/2-1)/2 for n == 2 (mod 4).
%F A398538 a(2*k+1) = (9^k - 1)/8 = A002452(k) for k >= 1.
%F A398538 E.g.f.: (-4*cos(sqrt(3)*x) + 3*cosh(x) + cosh(3*x) - 3*sinh(x) + sinh(3*x))/24. - _Stefano Spezia_, Aug 01 2026
%e A398538 a(2) = 1: the only pair is (0,0), since M(0)^2 = -I.
%e A398538 a(3) = 1: the only triple is (1,1,1).
%e A398538 a(4) = 2: the tuples are (1,2,1,2) and (2,1,2,1).
%t A398538 LinearRecurrence[{2, 0, 6, 9}, {1, 1, 2, 10}, 29]
%o A398538 (PARI) my(N=30); Vec(x^2*(1-x)/((1+x)*(1-3*x)*(1+3*x^2)) + O(x^(N+1)))
%o A398538 (Python)
%o A398538 from itertools import product
%o A398538 def terms(nmax, q=3):
%o A398538     r = []
%o A398538     for n in range(2, nmax+1):
%o A398538         c = 0
%o A398538         for t in product(range(q), repeat=n):
%o A398538             M = [1,0,0,1]
%o A398538             for a in t: M = [(M[0]*a+M[1])%q, -M[0]%q, (M[2]*a+M[3])%q, -M[2]%q]
%o A398538             if M == [q-1,0,0,q-1]: c += 1
%o A398538         r.append(c)
%o A398538     return r
%o A398538 print(terms(12))
%Y A398538 Cf. A001045, A002452.
%K A398538 nonn,easy,new
%O A398538 2,3
%A A398538 _Vico Bonfioli_, Aug 01 2026
