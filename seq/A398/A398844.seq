%I A398844 #6 Sep 17 2026 08:33:24
%S A398844 0,0,3,7,12,19,27,37,48,61,75,91,109,127,148,170,193,218,244,272,301,
%T A398844 332,364,398,434,470,509,549,590,633,677,723,770,819,869,921,975,1029,
%U A398844 1086,1144,1203,1264,1326,1390,1455,1522,1590,1660,1732,1804,1879,1955
%N A398844 Lower (1/2, 1/3)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398844 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398844 <a href="/index/Rec#order_11">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1,-1,2,-1 1,-2,1).
%F A398844 G.f. -x^2*(3+x+x^2-x^3+x^5+2*x^6+2*x^7) / ( (x^2+1)*(1+x+x^2)*(x^4-x^2+1)*(x-1)^3 ). - _R. J. Mathar_, Sep 17 2026
%e A398844 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5) - a(n-6) + 2*a(n-7) - a(n-8) + a(n-9) - 2*a(n-10) + a(n-11);  (a(0), ..., a(10)) =  (0, 0, 3, 7, 12, 19, 27, 37, 48, 61, 75).
%p A398844 A398844 := proc(n)
%p A398844     n*(9*n+1)/12 ; floor(%) ;
%p A398844 end proc:
%p A398844 seq(A398844(n),n=0..100) ; # _R. J. Mathar_, Sep 17 2026
%t A398844 z = 60;
%t A398844 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398844 r =1/2; s = 1/3;
%t A398844 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398844 Table[u[n], {n, 0, z}]
%Y A398844 Cf. A000217, A000326, A398845.
%K A398844 nonn,easy,new
%O A398844 0,3
%A A398844 _Clark Kimberling_, Sep 15 2026
