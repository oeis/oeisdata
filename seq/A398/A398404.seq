%U A398404 435937956386,6002457427468,26445711460289,152458816047752,858479855518880,5640204356402928,37438065008672479
%N A398404 Self-convolution of the number of partitions of [n] with distinct block sizes.
%H A398404 Alois P. Heinz, <a href="/A398404/b398404.txt">Table of n, a(n) for n = 0..697</a>
%F A398404 G.f.: (Sum_{j>=0} A007837(j)*x^j)^2.
%F A398404 a(n) = Sum_{j=0..n} A007837(j) * A007837(n-j).
%p A398404 b:= proc(n, i) option remember; `if`(i*(i+1)/2<n, 0, `if`(n=0, 1,
%p A398404       b(n, i-1)+b(n-i, min(n-i, i-1))*binomial(n, i)))
%p A398404     end:
%p A398404 a:= n-> add(b(j$2)*b(n-j$2), j=0..n):
%p A398404 seq(a(n), n=0..26);
%Y A398404 Self-convolution of A007837.
%Y A398404 Cf. A014322, A032312, A320567.
%K A398404 nonn,new
