%I A398852 #10 Sep 21 2026 00:48:09
%S A398852 0,1,6,15,27,42,61,84,110,139,172,209,249,292,339,390,444,501,562,627,
%T A398852 695,766,841,920,1002,1087,1176,1269,1365,1464,1567,1674,1784,1897,
%U A398852 2014,2135,2259,2386,2517,2652,2790,2931,3076,3225,3377,3532,3691,3854,4020
%N A398852 Lower (1/2, 1)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398852 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398852 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients, signature (3,-4,4,-3,1)</a>
%F A398852 a(n) = 3*a(n-1) - 4*a(n-2) + 4*a(n-3) - 3*a(n-4) + a(n-5), (a(0), ..., a(4)) = (0, 1, 6, 15, 27).
%F A398852 G.f.: -(x*(1 + 3*x + x^2 + 2*x^3)/((-1 + x)^3 *(1 + x^2))).
%F A398852 E.g.f.: (-exp(x)*(1 - 6*x - 7*x^2) + cos(x) - sin(x))/4. - _Stefano Spezia_, Sep 19 2026
%t A398852 z = 60;
%t A398852 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398852 r =1/2; s = 1;
%t A398852 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398852 Table[u[n], {n, 0, z}]
%Y A398852 Cf. A000217, A000326, A398853.
%K A398852 nonn,easy,new
%O A398852 0,3
%A A398852 _Clark Kimberling_, Sep 18 2026
