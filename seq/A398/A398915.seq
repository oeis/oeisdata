%N A398915 Antidiagonal sums of the binomial matrix of the Catalan numbers (A399000).
%p A398915 # Using the function 'binomial_matrix' from A399000.
%p A398915 BM := binomial_matrix(n -> binomial(2*n, n) / (n + 1)):
%p A398915 seq(add(BM(n-k, k), k = 0..n), n = 0..26);
