%I A398856 #4 Sep 23 2026 01:32:01
%S A398856 0,1,7,16,28,45,65,88,116,147,181,220,262,307,357,410,466,527,591,658,
%T A398856 730,805,883,966,1052,1141,1235,1332,1432,1537,1645,1756,1872,1991,
%U A398856 2113,2240,2370,2503,2641,2782,2926,3075,3227,3382,3542,3705,3871,4042,4216
%N A398856 Lower (2/3, 1)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398856 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398856 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398856 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 1, 7, 16, 28).
%F A398856 G.f.: -x*(1 + 5*x + 3*x^2 + 2*x^3)/((-1 + x)^3 *(1 + x + x^2)).
%t A398856 z = 60;
%t A398856 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398856 r =2/3; s = 1;
%t A398856 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398856 Table[u[n], {n, 0, z}]
%Y A398856 Cf. A000217, A000326, A398857.
%K A398856 nonn,easy,new
%O A398856 0,3
%A A398856 _Clark Kimberling_, Sep 21 2026
