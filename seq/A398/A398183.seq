%T A398183 19,5,7,31,11,11,7,5,7,13,11,11,7,17,11,13,11,13,31,11,13,7,5,7,7,5,7,
%U A398183 7,11,11,19,17,17,31,17,19,7,23,11,13,5,7,19,17,13,13
%N A398183 a(n) = second-smallest prime p <= n such that 2n - p is also prime, or 0 if fewer than two such primes exist.
%C A398183 Analog of A020481 (least prime in a Goldbach partition) for the second-smallest prime.
%C A398183 a(n) = 0 only for n = 3, 4, 6 (i.e., 2n = 6, 8, 12) among 2n <= 10^7; conjecturally these are the only even numbers with fewer than two Goldbach partitions.
%C A398183 The record values 5, 7, 11, 13, 19, 31, 37, 61, ... = A398451 grow without bound; the record 19 occurs at 2n = 38 and 31 at 2n = 68.
%H A398183 Paolo Xausa, <a href="/A398183/b398183.txt">Table of n, a(n) for n = 3..10000</a>
%e A398183 a(19) = 19 because the Goldbach partitions of 38 are 7 + 31 and 19 + 19; the second-smallest prime used is 19.
%t A398183 A398183[n_] := Module[{c = 0, p = 0}, While[c < 2 && (p = NextPrime[p]) <= n, If[PrimeQ[2*n - p], c++]]; If[c < 2, 0, p]];
%t A398183 Array[A398183, 100, 3] (* _Paolo Xausa_, Jul 30 2026 *)
%o A398183 (Python)
%o A398183 from sympy import isprime
%o A398183 def a(n):
%o A398183     hits = [p for p in range(3, n + 1) if isprime(p) and isprime(2*n - p)]
%o A398183     return hits[1] if len(hits) > 1 else 0
%o A398183 print([a(n) for n in range(3, 77)])
%o A398183 (Python)
%o A398183 from sympy import primerange, isprime
%o A398183 def A398183(n):
%o A398183     c = 0
%o A398183     for p in primerange(n+1):
%o A398183         if isprime(2*n-p):
%o A398183             if c:
%o A398183                 return p
%o A398183             c += 1
%o A398183     return 0 # _Chai Wah Wu_, Jul 30 2026
