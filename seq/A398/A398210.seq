%S A398210 6,3,9,2,1,1,8,4,7,5,6,9,0,7,0,3,6,7,4,2,8,2,5,3,5,2,9,6,1,4,8,0,2,4,
%T A398210 5,9,0,8,0,7,9,0,2,7,7,4,6,1,5,8,3,4,6,8,4,7,6,0,0,2,9,5,5,7,7,8,7,9,
%U A398210 8,8,5,6,9,9,3,9,7,4,7,6,2,7,7,5,6,3,1,5,7,2
%N A398210 Decimal expansion of the volume of a canonical (dual-uniform) octagonal trapezohedron with unit short edge length.
%C A398210 The octagonal trapezohedron is the dual polyhedron of the octagonal antiprism.
%H A398210 Paolo Xausa, <a href="/A398210/b398210.txt">Table of n, a(n) for n = 2..10000</a>
%H A398210 David I. McCooey, <a href="https://dmccooey.com/polyhedra/OctagonalTrapezohedron.html">Octagonal Trapezohedron</a>.
%H A398210 Polytope Wiki, <a href="https://polytope.miraheze.org/wiki/Octagonal_antitegum">Octagonal antitegum</a>.
%H A398210 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Trapezohedron.html">Trapezohedron</a>.
%H A398210 <a href="/index/Al#algebraic_08">Index entries for algebraic numbers, degree 8</a>.
%F A398210 Equals (4/3)*(r + 1)*(2 - r)^(-3/2), where r = sqrt(sqrt(2) + 2) = 2*cos(Pi/8) = A179260.
%F A398210 Equals the largest root of 6561*x^8 - 26827200*x^6 + 79646976*x^4 - 2138112*x^2 + 8192.
%e A398210 63.921184756907036742825352961480245908079027746158...
%t A398210 First[RealDigits[4/3*(# + 1)/(2 - #)^(3/2) & [Sqrt[Sqrt[2] + 2]], 10, 100]]
%t A398210 (* Alternative: *)
%t A398210 First[RealDigits[PolyhedronData[{"Trapezohedron", 8}, "Volume"], 10, 100]]
%Y A398210 Cf. A398211 (surface area), A398212 (inradius), A398213 (midradius), A398214 (height).
%Y A398210 Cf. A398215 (long edge).
%Y A398210 Cf. A398216 (small face angle), A398217 (large face angle), A398218 (dihedral angle).
%Y A398210 Cf. A394534 (volume of the dual).
%Y A398210 Cf. A179260.
%K A398210 nonn,cons,easy,new
%O A398210 2,1
%A A398210 _Paolo Xausa_, Jul 25 2026
