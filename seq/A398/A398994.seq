%p A398994 BM := binomial_matrix(n -> simplify(hypergeom([-n, n+1], [2], -1))):
%p A398994 M := Matrix(8, 8, (n, k) -> BM(n-1, k-1));
%p A398994 seq(seq(BM(n-k, k), k = 0..n), n = 0..9);
%t A398994 (* Using function 'binomialMatrix' from A399000. *)
%t A398994 bM = binomialMatrix[HypergeometricPFQ[{-#, # + 1}, {2}, -1] &];
%t A398994 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398994 (Python)  # Using function binomial_matrix from A399000.
%o A398994 from mpmath import hyp2f1
%o A398994 def sch(n) -> int: return int(hyp2f1(-n, n+1, 2, -1))
%o A398994 M = binomial_matrix(sch)
%o A398994 for n in range(9): print([M(n, k) for k in range(9)])
