%N A398978 Expansion of e.g.f. 1/(1 - sin(x) - sin(x)^2).
%F A398978 a(n) = Sum_{k=0..floor(n/2)} (-1)^k * (n-2*k)! * A000045(n-2*k+1) * A136630(n,n-2*k).
%F A398978 a(0) = 1; a(n) = Sum_{k=0..floor((n-1)/2)} (-1)^k * binomial(n,2*k+1) * a(n-2*k-1) + 2 * Sum_{k=1..floor(n/2)} (-4)^(k-1) * binomial(n,2*k) * a(n-2*k).
%F A398978 a(n) ~ n! * sqrt(2/(5*(sqrt(5) - 1))) / arcsin((sqrt(5) - 1)/2)^(n+1). - _Vaclav Kotesovec_, Aug 16 2026
%t A398978 nmax = 20; CoefficientList[Series[1/(1 - Sin[x] - Sin[x]^2), {x, 0, nmax}], x] * Range[0, nmax]! (* _Vaclav Kotesovec_, Aug 16 2026 *)
%o A398978 (PARI) my(N=30, x='x+O('x^N)); Vec(serlaplace(1/(1-sin(x)-sin(x)^2)))
%Y A398978 Cf. A000045, A002969, A029585, A136630.
%K A398978 nonn,easy
%O A398978 0,3
