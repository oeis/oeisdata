%I A398730 #4 Aug 29 2026 17:19:54
%S A398730 0,0,0,1,5,13,25,42,66,98,138,187,247,319,403,500,612,740,884,1045,
%T A398730 1225,1425,1645,1886,2150,2438,2750,3087,3451,3843,4263,4712,5192,
%U A398730 5704,6248,6825,7437,8085,8769,9490,10250,11050,11890,12771,13695,14663,15675
%N A398730 Upper (-1, 1/2) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398730 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398730 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398730 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) =  (0, 3, 16, 45, 95, 172).
%F A398730 G.f.: x^3 *(1 + x)/((-1 + x)^4 (1 + x^2)).
%t A398730 z = 60;
%t A398730 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398730 r =-1; s = 1/2;
%t A398730 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398730 Table[v[n], {n, 0, z}]
%Y A398730 Cf. A000217, A000330, A398729.
%K A398730 nonn,easy,new
%O A398730 0,5
%A A398730 _Clark Kimberling_, Aug 27 2026
