%I A398205 #4 Aug 11 2026 01:05:31
%S A398205 0,1,3,7,13,20,29,40,52,66,82,99,118,139,161,185,211,238,267,298,330,
%T A398205 364,400,437,476,517,559,603,649,696,745,796,848,902,958,1015,1074,
%U A398205 1135,1197,1261,1327,1394,1463,1534,1606,1680,1756,1833,1912,1993,2075
%N A398205 Upper (-1/3,1) midsequence of triangular numbers (A000217) and squares (A000290); see Comments.
%C A398205 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A397972 for a guide to related sequences.
%H A398205 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398205 a(n) = 2 a(n-1) - a(n-2) + a(n-3) - 2 a(n-4) + a(n-5), with (a(0), ..., a(4)) =  (0, 1, 3, 7, 13).
%F A398205 G.f.: (x*(-1 - x - 2*x^2 - x^3))/((-1 + x)^3*(1 + x + x^2)).
%t A398205 z = 60;
%t A398205 f[n_] := (n^2 + n)/2; g[n_] := n^2; r = -1/3; s = 1;
%t A398205 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]]
%t A398205 Table[v[n], {n, 0, z}]
%Y A398205 Cf. A000217, A000290, A398204.
%K A398205 nonn,easy,new
%O A398205 0,3
%A A398205 _Clark Kimberling_, Aug 09 2026
