%I A398580 #34 Sep 14 2026 17:53:27
%S A398580 1,1,0,1,4,6,4,1,1,9,36,76,78,28,2,1,16,120,516,1278,1668,998,204,11,
%T A398580 1,25,300,2148,9498,25052,36698,26700,8242,840,32,1,36,630,6768,47331,
%U A398580 215448,620210,1073076,1035097,496436,98950,5664,50
%N A398580 Triangle read by rows: T(n,k) is the number of k-element subsets of the n X n grid with no three collinear points, 0 <= k <= 2n.
%C A398580 Subsets are counted as sets of grid points; rotations and reflections are counted separately, as in A000755.
%C A398580 T(n,k) is the number of faces of size k of the independence complex of the 3-uniform hypergraph whose hyperedges are the collinear triples of the n X n grid (A000938(n) triples).
%H A398580 Sean A. Irvine, <a href="/A398580/b398580.txt">Table of n, a(n) for n = 1..80</a> (rows 1..8 flattened, terms 1..63 from Aleksei Kudriashov)
%F A398580 T(n,k) = binomial(n^2, k) for 0 <= k <= 2.
%F A398580 T(n,3) = binomial(n^2, 3) - A000938(n).
%F A398580 T(n,2n) = A000755(n).
%e A398580 Triangle begins:
%e A398580   1, 1, 0;
%e A398580   1, 4, 6, 4, 1;
%e A398580   1, 9, 36, 76, 78, 28, 2;
%e A398580   1, 16, 120, 516, 1278, 1668, 998, 204, 11;
%e A398580   1, 25, 300, 2148, 9498, 25052, 36698, 26700, 8242, 840, 32;
%e A398580   ...
%e A398580 T(3,3) = 76: of the binomial(9,3) = 84 triples of points of the 3 X 3 grid, A000938(3) = 8 are collinear. T(3,6) = 2: the two 6-point no-three-in-line configurations of the 3 X 3 grid (A000755(3) = 2).
%o A398580 (Python)
%o A398580 def row(n): # T(n,0..2n)
%o A398580     N = n*n; P = [divmod(i, n) for i in range(N)]
%o A398580     L = [[sum(1 << k for k in range(N) if k != i and k != j and (P[k][0]-P[i][0])*(P[j][1]-P[i][1]) == (P[k][1]-P[i][1])*(P[j][0]-P[i][0])) for j in range(N)] for i in range(N)]
%o A398580     T = [0]*(2*n+1)
%o A398580     def dfs(start, chosen, F): # F = cells collinear with two chosen cells
%o A398580         T[len(chosen)] += 1
%o A398580         for c in range(start, N):
%o A398580             if not F >> c & 1:
%o A398580                 G = F
%o A398580                 for s in chosen: G |= L[s][c]
%o A398580                 dfs(c+1, chosen + [c], G)
%o A398580     dfs(0, [], 0); return T
%o A398580 print([row(n) for n in range(1, 6)]) # rows 1..5
%Y A398580 Cf. A398172 (row sums), A398184, A000755 (right edge), A000938, A000769, A005408 (row lengths).
%K A398580 nonn,tabf,new
%O A398580 1,5
%A A398580 _Aleksei Kudriashov_, Sep 10 2026
