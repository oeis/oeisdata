%I A398230 #9 Aug 05 2026 19:38:48
%S A398230 0,0,0,0,0,1,2,3,4,7,3,14,7,19,33,22,20,17,17,37,34,35,35,64,56,65,54,
%T A398230 55,42,75,60,49,50,65,80,152,80,71,97,100,75,127,75,105,108,104,58,82,
%U A398230 59,101,105,110,63,103,92,167,188,142,89,143,71,86,95,107,89
%N A398230 a(n) is the total collision excess among unordered pairwise sums with repetition of the distinct trinomial coefficient values of order n.
%C A398230 Let B(n) be the set of distinct coefficients in the expansion of (x + y + z)^n, that is, B(n) = {multinomial(n; i, j, k) : i, j, k >= 0 and i + j + k = n}. Thus |B(n)| = A086753(n).
%C A398230 For an integer t, let r_n(t) = |{(x, y) : x, y in B(n), x <= y and x + y = t}|.
%C A398230 Thus a(n) is the total collision excess among the unordered pairwise sums with repetition of elements of B(n). A sum t having r_n(t) representations contributes r_n(t) - 1 to a(n).
%C A398230 A398231(n) counts the distinct pairwise sums having at least two representations. Hence a(n) >= A398231(n), with equality if and only if no pairwise sum has more than two representations.
%C A398230 For n >= 6, a(n) > 0 since multinomial(n; n - 6, 6, 0) + multinomial(n; n - 6, 3, 3) = multinomial(n; n - 6, 5, 1) + multinomial(n; n - 6, 4, 2), which follows from 1 + 20 = 6 + 15 in row 6 of Pascal's triangle. Together with the collision 10 + 30 = 20 + 20 for n = 5 and direct inspection for 0 <= n <= 4, this shows that a(n) = 0 if and only if 0 <= n <= 4.
%C A398230 Every additive relation among binomial coefficients in row r of Pascal's triangle induces an additive relation among trinomial coefficients of order n for every n >= r, since multinomial(n; n - r, r - k, k) = binomial(n, r)*binomial(r, k).
%C A398230 For odd n = 2*s + 1, a four-term identity gives floor((s - 1)/2) distinct genuine collision sums, and hence a(n) >= floor((n - 3)/4) for odd n >= 7. See the Huber link for a proof.
%C A398230 Using embedded Pascal-row collisions with r = d^2 - 4 gives a(n) >= ceiling((floor(sqrt(n + 4)) - 3)/2) for n >= 12. See the Huber link for a proof.
%C A398230 Direct computation shows that the first pairwise sum having three representations occurs at n = 11: 2310 + 11550 = 4620 + 9240 = 6930 + 6930.
%H A398230 Felix Huber, <a href="/A398230/b398230.txt">Table of n, a(n) for n = 0..200</a>
%H A398230 Felix Huber, <a href="/A398230/a398230.txt">Proofs and lower bounds for A398230 and A398231</a>
%F A398230 a(n) = binomial(A086753(n) + 1, 2) - |{x + y : x, y in B(n), x <= y}|.
%F A398230 a(n) = Sum_t max(r_n(t) - 1, 0), where r_n(t) = |{(x, y) : x, y in B(n), x <= y and x + y = t}|.
%F A398230 a(n) = A398231(n) + Sum_t max(r_n(t) - 2, 0).
%F A398230 a(n) = A398232(n, 3) for n >= 3.
%F A398230 a(n) >= floor((n - 3)/4) for odd n >= 7.
%F A398230 a(n) >= ceiling((floor(sqrt(n + 4)) - 3)/2) for n >= 12.
%e A398230 For n = 5, B(5) = {1, 5, 10, 20, 30}. There are binomial(5 + 1, 2) = 15 unordered pairs with repetition. Their sums are all distinct except for 10 + 30 = 20 + 20 = 40. Hence there are 14 distinct pairwise sums and a(5) = 15 - 14 = 1.
%p A398230 A398230 := proc(n) option remember;
%p A398230     local i, j, k, l, m, r, s, t;
%p A398230     t := table();
%p A398230     for i from iquo(n + 2, 3) to n do
%p A398230         for j from iquo(n - i + 1, 2) to min(i, n - i) do
%p A398230             t[binomial(n, i)*binomial(n - i, j)] := 1
%p A398230         end do
%p A398230     end do;
%p A398230     l := [indices(t, 'nolist')];
%p A398230     m := nops(l);
%p A398230     s := table();
%p A398230     for r to m do
%p A398230         for k from r to m do
%p A398230             s[l[r] + l[k]] := 1
%p A398230         end do
%p A398230     end do;
%p A398230     binomial(m + 1, 2) - numelems(s)
%p A398230 end proc:
%p A398230 seq(A398230(n), n = 0 .. 64);
%Y A398230 Cf. A046816, A086753, A394957, A398231, A398232, A398233, A398237, A398238, A398263, A398265, A398429.
%K A398230 nonn
%O A398230 0,7
