%I A398859 #4 Sep 23 2026 01:31:48
%S A398859 0,3,9,20,36,55,79,108,140,177,219,264,314,369,427,490,558,629,705,
%T A398859 786,870,959,1053,1150,1252,1359,1469,1584,1704,1827,1955,2088,2224,
%U A398859 2365,2511,2660,2814,2973,3135,3302,3474,3649,3829,4014,4202,4395,4593,4794
%N A398859 Upper (4/3, 1)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398859 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398859 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398859 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 3, 9, 20, 36).
%F A398859 G.f.: x*(-3 - 3*x - 5*x^2 - 2*x^3)/((-1 + x)^3 *(1 + x + x^2)).
%t A398859 z = 60;
%t A398859 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398859 r =4/3; s = 1;
%t A398859 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398859 Table[v[n], {n, 0, z}]
%Y A398859 Cf. A000217, A000326, A398858.
%K A398859 nonn,easy,new
%O A398859 0,2
%A A398859 _Clark Kimberling_, Sep 21 2026
