%S A398347 1,2,4,8,14,26,46,79,132,217,353,565,895,1400,2169,3330,5069,7657,
%T A398347 11484,17105,25320,37258,54519,79359,114946,165706,237814,339849,
%U A398347 483694,685752,968625,1363317,1912311,2673605,3726221,5177542,7173169,9910014,13653907,18762814
%N A398347 Number of S_3-symmetric 3-dimensional vector partitions of (n, n, n) into strictly distinct parts.
%C A398347 Counts 3-dimensional vector partitions of (n, n, n) into strictly distinct parts with nonnegative components (not all zero) that are invariant under all 6 permutations of the 3 coordinate axes.
%C A398347 This sequence is the strict (Fermi-Dirac) counterpart to A400544. Because the partition must be completely symmetric, the parts must be formed by taking unions of strictly distinct, complete permutation orbits.
%C A398347 The generating function is formed by the product of (1 + x^w)^c(w), where w is the coordinate weight of the orbit and c(w) is the number of available S_3 orbits of weight w (given by A400564).
%D A398347 P. A. MacMahon, Combinatory Analysis, Cambridge Univ. Press, London and New York, Vol. 1, 1915 and Vol. 2, 1916.
%H A398347 Jishnu Babu Ranitha, <a href="/A398347/b398347.txt">Table of n, a(n) for n = 0..10000</a>
%F A398347 G.f.: Product_{w>=1} (1 + x^w)^A400564(w).
%F A398347 a(n) = (1/n) * Sum_{k=1..n} b(k) * a(n - k) for n >= 1 with a(0) = 1, where b(k) = Sum_{d|k} (-1)^(k/d - 1) * d * A400564(d).
%e A398347 a(0) = 1: the empty partition.
%e A398347 a(1) = 2: {(1,1,1)} and {(1,0,0), (0,1,0), (0,0,1)}.
%e A398347 a(2) = 4:
%e A398347   {(2,2,2)},
%e A398347   {(1,1,0), (1,0,1), (0,1,1)},
%e A398347   {(2,0,0), (0,2,0), (0,0,2)}, and
%e A398347   {(1,1,1), (1,0,0), (0,1,0), (0,0,1)}.
%e A398347 (Note: the partition {(1,1,1), (1,1,1)} from A400544 is excluded because parts must be strictly distinct).
%e A398347 a(3) = 8: the 8 partitions formed by distinct complete orbits are:
%e A398347 - 1 orbit of weight 3 (2 partitions):
%e A398347     {(3,3,3)},
%e A398347     {(3,0,0), (0,3,0), (0,0,3)};
%e A398347 - 2 orbits of weights 1 + 2 (6 partitions):
%e A398347     {(1,1,1)} combined with each of the 3 weight-2 orbits,
%e A398347     {(1,0,0), (0,1,0), (0,0,1)} combined with each of the 3 weight-2 orbits.
%t A398347 c[w_] := 2 + Floor[w/2] - Boole[Divisible[w, 3]] + If[EvenQ[w], Round[w^2/48], 0];
%t A398347 CoefficientList[Series[Product[(1 + x^w)^c[w], {w, 1, 40}], {x, 0, 40}], x]
%o A398347 (Python)
%o A398347 def c(w):
%o A398347     ans = 2 + w // 2
%o A398347     if w % 3 == 0: ans -= 1
%o A398347     if w % 2 == 0: ans += round(w**2 / 48)
%o A398347     return ans
%o A398347 def lista(limit):
%o A398347     dp = [1] + [0] * limit
%o A398347     for w in range(1, limit + 1):
%o A398347         cw = c(w)
%o A398347         for _ in range(cw):
%o A398347             for i in range(limit, w - 1, -1):
%o A398347                 dp[i] += dp[i - w]
%o A398347     return dp
%o A398347 print(lista(39))
%Y A398347 Cf. A400544 (unrestricted counterpart), A400564 (orbit generator exponents).
%Y A398347 Cf. A000009 (1D strict), A399578 (2D strict self-conjugate).
%K A398347 nonn,easy,new
%O A398347 0,2
