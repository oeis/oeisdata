%I A398802 #10 Aug 17 2026 10:47:10
%S A398802 54,250,270,375,378,594,686,702,918,1026,1029,1242,1566,1674,1715,
%T A398802 1750,1890,1998,2214,2322,2538,2625,2662,2750,2862,2970,3186,3250,
%U A398802 3294,3510,3618,3834,3942,3993,4125,4158,4250,4266,4394,4482,4590,4750,4806,4875,4914,5130
%N A398802 Numbers k of the form q(k)^2 * rad(k), where rad = A007947, and q(k) the second smallest distinct prime factor of k.
%C A398802 Terms have at least 2 distinct prime factors.
%C A398802 Squarefree kernels are in A120944.
%C A398802 Unsorted prime signature {1,3} followed by zero or more 1's.
%C A398802 Superset of A397487.
%C A398802 Smallest term with j > 1 distinct prime factors is 3^2 * A002110(j).
%H A398802 Michael De Vlieger, <a href="/A398802/b398802.txt">Table of n, a(n) for n = 1..10000</a>
%e A398802 Table of n, a(n) for select n:
%e A398802      n      a(n)
%e A398802   -----------------------------------------
%e A398802      1       54 = 2 * 3^3
%e A398802      2      250 = 2 * 5^3
%e A398802      3      270 = 2 * 3^3 * 5
%e A398802      4      375 = 3 * 5^3
%e A398802      5      378 = 2 * 3^3 * 7
%e A398802      6      594 = 2 * 3^3 * 11
%e A398802      7      686 = 2 * 7^3
%e A398802      8      702 = 2 * 3^3 * 13
%e A398802      9      918 = 2 * 3^3 * 17
%e A398802     17     1890 = 2 * 3^3 * 5 * 7
%e A398802    179    20790 = 2 * 3^3 * 5 * 7 * 11
%e A398802   2277   270270 = 2 * 3^3 * 5 * 7 * 11 * 13
%t A398802 nn = 5200; Set[{s, t}, {{2}, {2}}]; om = Max[s]; Union@ Map[If[# <= nn, #, Nothing] &[  #*Inner[#1^#2 &, FactorInteger[#][[s, 1]], t, Times] ] &, Select[Select[Range[2, nn], SquareFreeQ], PrimeNu[#] >= om &] ]
%o A398802 (Python)
%o A398802 from math import prod
%o A398802 from sympy import factorint
%o A398802 def ok(k):
%o A398802     f = factorint(k)
%o A398802     lpf = min(f, default=0)
%o A398802     q = min(set(f)-{lpf}, default=0)
%o A398802     return q and k == q**2 * prod(f)
%o A398802 print([k for k in range(5131) if ok(k)]) # _Michael S. Branicky_, Aug 13 2026
%Y A398802 Cf. A005117, A007947, A119288, A120944, A126706, A332785, A397487.
%K A398802 nonn,easy
%O A398802 1,1
