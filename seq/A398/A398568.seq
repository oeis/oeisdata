%S A398568 10,12,14,15,16,18,21,25,27,35,49,302,362,382,453,524,543,573,605,655,
%T A398568 706,726,746,755,766,786,847,905,917,955,968,1057,1059,1089,1119,1149,
%U A398568 1179,1252,1267,1337,1454,1514,1565,1574,1594,1765,1838,1858,1865,1878,1915,2101
%N A398568 Nonpalindromic composite numbers all of whose proper divisors are palindromic.
%C A398568 Since there is "composite" numbers in the name, the nonpalindromic primes in A334321 are not present, although 1 is their only proper divisor and it is palindromic.
%C A398568 No term is a multiple of 32 as any such number has proper divisor 16 which is no palindrome and so not in the sequence. More generally if a number k has a nonpalindromic proper divisor then no term is a multiple of k. - _David A. Corneth_, Aug 09 2026
%C A398568 In fact, no term other than 16 itself is a multiple of 16 as any such number has proper divisor 16, which is no palindrome. Corollary: No term is a multiple of another term. - _Ivan N. Ianakiev_, Aug 17 2026
%H A398568 David A. Corneth, <a href="/A398568/b398568.txt">Table of n, a(n) for n = 1..10000</a>
%H A398568 David A. Corneth, <a href="/A398568/a398568_1.gp.txt">PARI program</a>
%e A398568 955 = 5*191 is not a palindrome, its proper divisors are {1,5,191}, so 955 is a term.
%e A398568 10329 = 3*11*313 is not a palindrome, its proper divisors are {1, 3, 11, 33, 313, 939, 3443}, so 10329 is a term.
%t A398568 q[k_] := !PalindromeQ[k] && CompositeQ[k] && AllTrue[Divisors[k], # == k || PalindromeQ[#] &]; Select[Range[2101], q] (* _Amiram Eldar_, Aug 03 2026 *)
%o A398568 (PARI) \\ See Corneth link
%o A398568 (Python)
%o A398568 from sympy.ntheory import divisors, is_palindromic, isprime, primefactors
%o A398568 def ok(k): return not is_palindromic(k) and not isprime(k) and all(is_palindromic(p) for p in primefactors(k)) and all(is_palindromic(d) for d in divisors(k)[:-1])
%o A398568 print([k for k in range(2102) if ok(k)]) # _Michael S. Branicky_, Aug 09 2026
%o A398568 (Python) # faster for initial segment of sequence; uses ok/imports above
%o A398568 import heapq
%o A398568 from sympy import nextprime
%o A398568 def agen(LIM): # generator of terms <= LIM
%o A398568     v, oldv, h, heaps, palprimes, nextp = 1, 0, [1], {1}, [2], 3
%o A398568     while v <= LIM and h:
%o A398568         v = heapq.heappop(h)
%o A398568         if v != oldv:
%o A398568             if ok(v): yield v
%o A398568             oldv = v
%o A398568             while nextp <= v:
%o A398568                 if is_palindromic(nextp):
%o A398568                     palprimes.append(nextp)
%o A398568                     heapq.heappush(h, nextp); heaps.add(nextp)
%o A398568                 nextp = nextprime(nextp)
%o A398568             for p in palprimes:
%o A398568                 if (m:=v*p) <= LIM and m not in heaps:
%o A398568                     heapq.heappush(h, m); heaps.add(m)
%o A398568         heaps.discard(v)
%o A398568 print(list(agen(2101))) # _Michael S. Branicky_, Aug 09 2026
