%I A398705 #7 Aug 10 2026 05:06:11
%S A398705 1,2,3,4,10,2,42,8,36,15,165,4,52,84,21,240,2040,12,684,20,420,4620,
%T A398705 106260,24,600,1560,7020,630,9135,84,13020,480,2640,22440,10472,420,
%U A398705 2590,11970,155610,1560,63960,280,12040,9240,1155,159390,7491330,720,35280,2800,23800,12376
%N A398705 a(n) = denominator(Sum_{k=1..n} beta(floor(n/k))/floor(n/k)), where beta(n) = A206369(n) is the alternating sum of divisors of n.
%H A398705 Amiram Eldar, <a href="/A398705/b398705.txt">Table of n, a(n) for n = 1..10000</a>
%H A398705 Jing Ma and Huayan Sun, <a href="https://doi.org/10.1007/s11139-022-00588-y">On a sum involving certain arithmetic functions and the integral part function</a>, The Ramanujan Journal, Vol. 60, No. 4 (2023), pp. 1025-1032; <a href="https://doi.org/10.1007/s11139-026-01336-2">Correction</a>, ibid., Vol. 69 (2026); <a href="https://arxiv.org/abs/2109.02924">arXiv preprint</a>, arXiv:2109.02924 [math.NT], 2021; <a href="https://www.researchgate.net/publication/361229857">ResearchGate link</a>. See Theorem 1, p. 1027.
%e A398705 Fractions begin with 1, 3/2, 8/3, 13/4, 43/10, 9/2, 253/42, 51/8, 277/36, 118/15, 1547/165, 37/4, ...
%t A398705 f[p_, e_] := Sum[(-1)^(e - k)*p^k, {k, 0, e}];
%t A398705 r[n_] := r[n] = (Times @@ f @@@ FactorInteger[n])/n; r[1] = 1;
%t A398705 a[n_] := Denominator[Sum[r[Floor[n/k]], {k, 1, n}]]; Array[a, 52]
%o A398705 (PARI) beta(n) = my(f = factor(n)); prod(i = 1, #f~, sum(e = 0, f[i, 2], (-1)^(f[i, 2]-e) * f[i, 1]^e));
%o A398705 a(n) = denominator(sum(k = 1, n, beta(n\k)/(n\k)));
%Y A398705 Cf. A206369, A294650, A398699, A398704 (numerators), A398706.
%K A398705 nonn,frac,easy,new
%O A398705 1,2
%A A398705 _Amiram Eldar_, Aug 07 2026
