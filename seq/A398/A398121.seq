%I A398121 #12 Jul 26 2026 17:48:02
%S A398121 2,2,2,4,1,4,4,4,6,6,2,3,2,2,4,2,3,6,3,3,4,6,3,7,4,5,5,5,2,7,4,4,4,5,
%T A398121 4,5,6,4,3,12,3,7,3,5,6,6,4,5,7,4,8,5,2,9,6,7,8,6,5
%N A398121 a(n) is the maximum length of a cycle under iteration of x -> s(x^n) on the positive integers, where s is the decimal digit sum; a fixed point counts as a cycle of length 1.
%C A398121 For each n, all cycles of the map are contained in the finite interval {1, ..., 9*n*D(n)}, where D(n) is the largest positive integer D such that 10^(D-1) <= 9*n*D. Thus a(n) is obtained by an exhaustive computation with exact integer arithmetic.
%C A398121 For n = 6, all cycles are fixed points (1), (18), (45), (54), (64), so a(6) = 1. Among 2 <= n <= 60, the largest value is a(41) = 12, attained by the cycle (302, 443, 437, 452, 473, 533, 491, 425, 482, 416, 509, 470).
%C A398121 The cycles for 2 <= n <= 10 were classified in the joint work of M. A. C. Alcântara and M. V. P. Alcântara. The complete census through n = 60 is given in the later work of M. V. P. Alcântara.
%H A398121 M. A. C. Alcântara and M. V. P. Alcântara, <a href="https://doi.org/10.5281/zenodo.19240836">Dynamics of the Digit Sum of Integer Powers: Cycle Structure and Finite Search</a>, Zenodo, Version 3, 2026.
%H A398121 M. V. P. Alcântara, <a href="https://doi.org/10.5281/zenodo.21348126">Digit-Sum Maps of Polynomial Generators over Arbitrary Bases: Global Descent, Cycle Localization and Arithmetic Basins</a>, Zenodo, 2026.
%F A398121 a(n) = max{|C| : C is a cycle of x -> s(x^n)}.
%F A398121 a(n) = 1 if and only if A398120(n) = 0, for n >= 2.
%F A398121 Every cycle of x -> s(x^n) is contained in {1, ..., 9*n*D(n)}, where D(n) = max{D >= 1: 10^(D-1) <= 9*n*D}.
%e A398121 a(2) = 2 because the longest cycle is the 2-cycle (13, 16).
%e A398121 a(5) = 4 because (7, 22, 25, 40) is a 4-cycle, while all other cycles have length at most 2.
%e A398121 a(6) = 1 because all five cycles are fixed points: (1), (18), (45), (54), and (64).
%e A398121 a(7) = 4 because (36, 54, 63, 72) is a 4-cycle and no longer cycle occurs.
%o A398121 (Python)
%o A398121 def s(m):
%o A398121     t = 0
%o A398121     while m:
%o A398121         t += m % 10
%o A398121         m //= 10
%o A398121     return t
%o A398121 def a(n):
%o A398121     D = 1
%o A398121     while 10**(D - 1) <= 9*n*D:
%o A398121         D += 1
%o A398121     D -= 1
%o A398121     B = 9*n*D
%o A398121     max_length = 1
%o A398121     for x0 in range(1, B + 1):
%o A398121         seen = {}
%o A398121         orbit = []
%o A398121         x = x0
%o A398121         while x not in seen:
%o A398121             seen[x] = len(orbit)
%o A398121             orbit.append(x)
%o A398121             x = s(x**n)
%o A398121         cycle_length = len(orbit) - seen[x]
%o A398121         if cycle_length > max_length:
%o A398121             max_length = cycle_length
%o A398121     return max_length
%Y A398121 Cf. A007953, A004159, A046000, A046471, A056527, A056529, A061905, A152147, A398119 (total number of cycles), A398120 (number of cycles of length at least 2).
