%S A398227 0,1,16,17,23,24,26,27,28,34,35,37,38,39,41,42,43,44,45,46,52,53,55,
%T A398227 56,57,59,60,61,62,63,64,66,67,68,69,70,71,72,73,74,75,81,82,84,85,86,
%U A398227 88,89,90,91,92,93,95,96,97,98,99,100,101,102,103,104,106,107,108,109
%N A398227 Nonnegative numbers that are not the sum of two Lucas numbers.
%C A398227 The sequence of Lucas numbers used is A000032 (including 2).
%C A398227 The sequence excludes the sum of two Lucas numbers, even if they are equal.
%C A398227 It differs from A054770 by including 2 as a valid addend and the sum of two identical Lucas numbers (A000032(i) + A000032(i)) is also allowed. Therefore, numbers formed by those valid additions are excluded from this sequence.
%C A398227 The sequence tends to become denser for high n, due to the decreasing density of Lucas numbers.
%e A398227 0 is a term because 0 cannot be written as the sum of two Lucas numbers.
%e A398227 16 is a term because no two Lucas numbers add up to 16. The closest combinations are 11 + 4 = 15 and 11 + 7 = 18.
%e A398227 2 is not a term because 2 = 1 + 1 and 1 is a Lucas number in A000032.
%t A398227 ln=LucasL[Range[0, 10]];Complement[Range[0,Max[ln]],Select[Total/@Tuples[ln,2],#<Max[ln]&]] (* _James C. McMahon_, Aug 07 2026 *)
%o A398227 (Python)
%o A398227 from sympy import lucas
%o A398227 from itertools import combinations_with_replacement
%o A398227 lucas_seq = [lucas(i) for i in range(30)]
%o A398227 sums = {a + b for a, b in combinations_with_replacement(lucas_seq, 2)}
%o A398227 print([n for n in range(105) if n not in sums])
%Y A398227 Cf. A054770, A059390, A000032.
%K A398227 nonn,new
%O A398227 1,3
