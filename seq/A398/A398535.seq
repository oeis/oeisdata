%I A398535 #17 Aug 13 2026 12:46:16
%S A398535 32,1542,17616,105800,438600,1426782,3910592,9434016,20617200,
%T A398535 41642150,78866832,141582792,242931416,400993950,640070400,992162432,
%U A398535 1498675392,2212354566,3199470800,4542270600,6341705832,8720458142,11826273216,15835620000,20957690000
%N A398535 a(n) is the trace of the product of two Hankel n X n matrices M_n and N_n whose M[i,j] generic elements are respectively (i+j)^2 and (i+j)^3.
%C A398535 Remainders mod 3 follow the period 3 cycle (2, 0, 0).
%H A398535 Paolo Xausa, <a href="/A398535/b398535.txt">Table of n, a(n) for n = 1..10000</a>
%H A398535 Wikipedia, <a href="https://en.wikipedia.org/wiki/Hankel_matrix">Hankel matrix</a>.
%F A398535 a(n) = (1/6)*n^2*(n + 1)^2*(18*n^3 + 26*n^2 + 5*n - 1).
%e A398535 For n = 2:
%e A398535     Matrix M_2       Matrix N_2      Matrix M_2*N_2.
%e A398535      [4   9]          [8   27]         [275    684]
%e A398535      [9  16]          [27  64]         [504   1267]
%e A398535 a(2) = trace of  M_2*N_2 = 275 + 1267 = 1542.
%t A398535 A398535[n_] := n^2*(n + 1)^2*(n*(2*n*(9*n + 13) + 5) - 1)/6;
%t A398535 Array[A398535, 30] (* _Paolo Xausa_, Aug 13 2026 *)
%o A398535 (PARI) a(n)=trace(matrix(n,n,i,j,(i+j)^2)*matrix(n,n,i,j,(i+j)^3));
