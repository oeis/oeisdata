%S A398810 1,6,11,26,21,56,31,96,81,116,51,216,61,176,191,321,81,376,91,446,301,
%T A398810 296,111,731,281,356,491,706,141,896,151,1002,521,476,491,1371,181,
%U A398810 536,631,1471,201,1406,211,1226,1261,656,231,2287,601,1476,851,1486,261,2141,911,2351,961,836,291,3151
%N A398810 Number of integer 5-tuples, all entries > 0, such that the k-th component is <= q_k for some factorization n = q_1*q_2*q_3*q_4*q_5.
%C A398810 Five-dimensional analog of A138808 (d=2) and A283626 (d=3).
%C A398810 a(n) >= 5*n - 4, with equality iff n is 1 or a prime.
%H A398810 Soslan Daurov, <a href="/A398810/b398810.txt">Table of n, a(n) for n = 1..120</a>
%H A398810 Soslan Daurov and Anton Kretov, <a href="https://doi.org/10.24108/preprints-3116072">Structural units of different-dimensional numbers</a>, Preprints, 2026. In Russian.
%F A398810 For n = p^e with p prime the generating function is (1-x)^4/(1-p*x)^5.
%F A398810 a(p) = 5*p - 4 for prime p.
%e A398810 a(3) = 5*3-4: the factorizations 3 = 3*1*1*1*1 (and permutations) cover 11 lattice points in total.
%o A398810 (Python)
%o A398810 from functools import lru_cache
%o A398810 def A(n, d):
%o A398810     ds = tuple(x for x in range(1, n+1) if n % x == 0)
%o A398810     W = {}; p = 0
%o A398810     for x in ds: W[x] = x - p; p = x
%o A398810     @lru_cache(None)
%o A398810     def step(T, e):
%o A398810         return frozenset(m//a for m in T for a in ds if m % a == 0 and a >= e)
%o A398810     @lru_cache(None)
%o A398810     def H(t, T):
%o A398810         if t == 0: return 1 if 1 in T else 0
%o A398810         s = 0
%o A398810         for e in ds:
%o A398810             u = step(T, e)
%o A398810             if u: s += W[e]*H(t-1, u)
%o A398810         return s
%o A398810     return H(d, frozenset({n}))
%o A398810 print([A(n, 5) for n in range(1, 61)])
%Y A398810 Cf. A061200, A061203, A138808, A283626.
%K A398810 nonn,new
%O A398810 1,2
%A A398810 _Soslan Daurov_, Aug 10 2026
