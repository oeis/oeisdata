%I A398544 #28 Sep 14 2026 14:55:17
%S A398544 54,57,177,2169,8361,94932,131361,524649,8389137,536871753,1221074418,
%T A398544 1996813914,2147484609,137438954841,2199023257233,8796093024057,
%U A398544 19073488804224,36314872537968,140737488357537,232630924325880,9007199254743801,576460752303426969,2305843009213697673
%N A398544 Numbers of the form p^q + q^p divisible by 3, where p and q are primes.
%C A398544 Subsequence of A056824 and supersequence of A097058(k), k>2.
%C A398544 The terms can be classified:
%C A398544 (a) p=3 or p=q: 3^3+3^3=54 is the only term.
%C A398544 (b) p=2 and q>3: all terms in A097058(k), k>2.
%C A398544    Confirmation:
%C A398544    2 == -1 (mod 3) => 2^q == (-1)^q == -1 (mod 3),
%C A398544    q == r (mod 3) with r = +-1 => q^2 == r^2 == 1 (mod 3)
%C A398544    => 2^q + q^2 == 0 (mod 3).
%C A398544 (c) p>3, q>p, all terms such that p+q is divisible by 3.
%C A398544    Confirmation:
%C A398544    p == r (mod 3) with r = +-1 => p^q == r^q == r (mod 3)
%C A398544    p^q == p (mod 3) and q^p == q (mod 3)
%C A398544    => (p^q + q^p) == (p+q) (mod 3)
%C A398544 The terms in class (b) are odd and the others are even.
%e A398544 a(1) = 3^3 + 3^3 = 54,    class (a).
%e A398544 a(2) = 2^3 + 3^2 = 57,    class (b).
%e A398544 a(6) = 5^7 + 7^5 = 94932, class (c).
%t A398544 nMax=10^19; lim=PrimePi[Log[2, nMax]]; Select[Union[First[#]^Last[#] + Last[#]^First[#]&/@ Tuples[Prime[Range[lim]], {2}]], #<=nMax&&Divisible[#,3]&] (* _James C. McMahon_, Sep 14 2026 *)
%o A398544 (Maxima)
%o A398544 block(kmax:10^17, prim[1]:2, j:1, primax : log(kmax) / log(2), sum:[54],
%o A398544 while prim[j]<primax do (prim[j+1]:next_prime(prim[j]), j:j+1), jmax:j-1,
%o A398544 for j1 from 1 thru jmax do (p : prim[j1], j2 : j1, su : 0,
%o A398544   while su < kmax do (j2 : j2 + 1, q : prim[j2], su : p ^ q + q ^ p,
%o A398544     if su < kmax then if mod(su,3)=0 then sum: append(sum,[su]))),
%o A398544 sum:sort(sum));
%Y A398544 Intersection of A173056 and A008585.
%Y A398544 Cf. A056824, A097058, A056824.
%K A398544 nonn,new
%O A398544 1,1
%A A398544 _Gerhard Kirchner_, Sep 04 2026
