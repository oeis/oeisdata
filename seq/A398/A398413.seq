%t A398413 a = Compile[{{n, _Integer}}, Block[{c = 0, r = 1, m = 2, p = Prime[n]}, While[ m < p, r = Mod[r*m, p]; If[r + 1 == p && Mod[p, m] != 1, c++]; m++]; c]]; Array[a, 105]
