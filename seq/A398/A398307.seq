%I A398307 #11 Jul 31 2026 01:24:48
%S A398307 1,2,4,6,11,13,18,21,25,33,46,170,187,196,288,320,334,424,433,437,455,
%T A398307 505,514,523,530,541
%N A398307 Indices of zero terms in the Van Eck-like sequence A398259 whose lookup key is the decimal digit sum of the previous term.
%C A398307 There are no further terms between 541 and 10^6. It is conjectured this list is complete.
%o A398307 (Python)
%o A398307 def A398307_upto(N):
%o A398307     if N <= 0:
%o A398307         return []
%o A398307     c = [0]
%o A398307     last = {}
%o A398307     zeros = [1]
%o A398307     for ii in range(N - 1):
%o A398307         s = sum(int(d) for d in str(c[ii]))
%o A398307         new = ii - last[s] if s in last else 0
%o A398307         last[c[ii]] = ii
%o A398307         c.append(new)
%o A398307         if new == 0:
%o A398307             zeros.append(ii + 2)
%o A398307     return zeros
%Y A398307 Cf. A181391, A398259.
%K A398307 nonn,base,more
%O A398307 1,2
%A A398307 _Bence Bernáth_, Jul 25 2026
