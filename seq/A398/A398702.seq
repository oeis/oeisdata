%I A398702 #8 Aug 10 2026 05:06:02
%S A398702 1,2,3,1,10,6,42,1,3,3,165,6,78,21,105,15,510,1,19,30,3,2310,53130,6,
%T A398702 15,390,390,70,2030,7,1085,6,110,1870,6545,105,3885,3990,25935,65,533,
%U A398702 1,301,385,2310,5313,249711,30,210,210,3570,46410,2459730,273,2730,1155,43890,212135
%N A398702 a(n) = denominator(Sum_{k=1..n} psi(floor(n/k))/floor(n/k)), where psi the Dedekind psi function (A001615).
%H A398702 Amiram Eldar, <a href="/A398702/b398702.txt">Table of n, a(n) for n = 1..10000</a>
%H A398702 Jing Ma and Huayan Sun, <a href="https://doi.org/10.1007/s11139-022-00588-y">On a sum involving certain arithmetic functions and the integral part function</a>, The Ramanujan Journal, Vol. 60, No. 4 (2023), pp. 1025-1032; <a href="https://doi.org/10.1007/s11139-026-01336-2">Correction</a>, ibid., Vol. 69 (2026); <a href="https://arxiv.org/abs/2109.02924">arXiv preprint</a>, arXiv:2109.02924 [math.NT], 2021; <a href="https://www.researchgate.net/publication/361229857">ResearchGate link</a>. See Theorem 1, p. 1027.
%e A398702 Fractions begin with 1, 5/2, 10/3, 5, 57/10, 47/6, 335/42, 10, 32/3, 37/3, 2083/165, 95/6, ...
%t A398702 f[n_] := f[n] = Times @@ (1 + 1/FactorInteger[n][[;;, 1]]); f[1] = 1;
%t A398702 a[n_] := Denominator[Sum[f[Floor[n/k]], {k, 1, n}]]; Array[a, 60]
%o A398702 (PARI) f(n) = {my(p = factor(n)[,1]); prod(i = 1, #p, 1 + 1/p[i]);}
%o A398702 a(n) = denominator(sum(k = 1, n, f(n\k)));
%Y A398702 Cf. A001615, A332881, A398699, A398701 (numerators), A398703.
%K A398702 nonn,frac,easy
%O A398702 1,2
%A A398702 _Amiram Eldar_, Aug 07 2026
