%N A398807 Expansion of (Sum_{k>=0} binomial(5*k+1,k) * x^k)^4.
%F A398807 a(n) = Sum_{i,j,k,l >= 0 and i+j+k+l=n} binomial(5*i+1,i) * binomial(5*j+1,j) * binomial(5*k+1,k) * binomial(5*l+1,l).
%F A398807 G.f.: B(x)^4 where B(x) is the g.f. of A079589.
%F A398807 a(n) = Sum_{k=0..n} 4^k * binomial(k+2,2) * binomial(5*n+7,n-k).
%F A398807 a(n) = Sum_{k=0..n} 5^k * binomial(k+2,2) * binomial(5*n+4-k,n-k).
%F A398807 a(0) = 1; a(n) = (1/n) * Sum_{k=0..n-1} (5*k+24) * 4^k * binomial(k+3,3) * binomial(5*n+7,n-1-k).
%F A398807 a(0) = 1; a(n) = (1/n) * Sum_{k=0..n-1} (4*k+24) * 5^k * binomial(k+3,3) * binomial(5*n+3-k,n-1-k).
%o A398807 (PARI) a(n) = sum(k=0, n, 4^k*binomial(k+2, 2)*binomial(5*n+7, n-k));
