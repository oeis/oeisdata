%I A398690 #21 Aug 08 2026 03:23:53
%S A398690 1,1,1,1,2,1,1,7,7,1,1,16,46,16,1,1,37,218,218,37,1,1,78,911,1924,911,
%T A398690 78,1,1,163,3473,13771,13771,3473,163,1,1,332,12532,85684,157462,
%U A398690 85684,12532,332,1,1,673,43596,486732,1500614,1500614,486732,43596,673,1
%N A398690 Triangle of polynomials related to Verlinde numbers.
%C A398690 We consider a simplified version of the table A107735, namely
%C A398690 A(n, k) = (1/(2*k+1)) * Sum_{j=0..2k} (-1)^(n*j) * sin((2*j+1)*2*Pi / (8*k+4))^(-n+2).
%C A398690 Define f_n as the generating series of a row, where f_n = Sum_{k>=0} A(n + 3, k)*z^k. This series is a rational function of the form r_n / (1-z)^(n+1) for some polynomial r_n, and the T(n, k) are the coefficients of these polynomials.
%C A398690 Conjecture: The polynomials are palindromic.
%C A398690 The row sums seems to be A000831.
%e A398690 The first few rows are:
%e A398690   1;
%e A398690   1,  1;
%e A398690   1,  2,   1;
%e A398690   1,  7,   7,    1;
%e A398690   1, 16,  46,   16,   1;
%e A398690   1, 37, 218,  218,  37,  1;
%e A398690   1, 78, 911, 1924, 911, 78, 1;
%o A398690 (SageMath)
%o A398690 R = LazyPowerSeriesRing(ZZ, 'z')
%o A398690 z = R.gen()
%o A398690 def SIN(k, n):
%o A398690     enk = E(n)**k
%o A398690     return (enk - ~enk)/E(4)/2
%o A398690 def A(n, k):
%o A398690     return QQ(sum((-1)**(n*j) * SIN(2*j+1, 8*k+4)**(-n+2)
%o A398690               for j in range(2*k+1))) / (2*k+1)
%o A398690 def row(n):
%o A398690     f = R([A(n+3, k) for k in range(n+1)])
%o A398690     return (f*(1-z)**(n+1))[:n+1]
%Y A398690 Cf. A000831, A107735.
%K A398690 nonn,tabl,new
%O A398690 0,5
%A A398690 _F. Chapoton_, Aug 06 2026
