%I A398651 #14 Aug 12 2026 10:37:50
%S A398651 0,1,5,13,25,42,66,98,138,187,247,319,403,500,612,740,884,1045,1225,
%T A398651 1425,1645,1886,2150,2438,2750,3087,3451,3843,4263,4712,5192,5704,
%U A398651 6248,6825,7437,8085,8769,9490,10250,11050,11890,12771,13695,14663,15675,16732
%N A398651 Lower (1, 1/2)-midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398651 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical.
%C A398651 Guide to (h,k)-midsequences of triangular numbers and tetrahedral numbers:
%C A398651 (h,k)=(1,1):  A007290 (lower and upper)
%C A398651 (h,k)=(2,6):  A035006 (lower and upper)
%C A398651 (h,k)=(2,3):  A160378 (lower and upper)
%C A398651 (h,k)=(1,2):  A016061 (lower and upper)
%C A398651 (h,k)=(4,6):  A163815 (lower and upper)
%C A398651 (h,k)=(2,1):  A051925 (lower and upper)
%C A398651 (h,k)=(-1,6):  A135713 (lower and upper)
%C A398651 (h,k)=(1,1/2): A398651 (lower), A398652 (upper)
%C A398651 (h,k)=(1,1/2): A398651 (lower), A398652 (upper)
%C A398651 (h,k)=(1,1/3): A398653 (lower), A398654 (upper)
%C A398651 (h,k)=(1,2/3): A398655 (lower), A398656 (upper)
%C A398651 (h,k)=(1,3/2): A398657 (lower), A398658 (upper)
%C A398651 (h,k)=(1,6/5): A398659 (lower), A398660 (upper)
%C A398651 (h,k)=(3/2,1): A398661 (lower), A398662 (upper)
%C A398651 (h,k)=(1/2,2): A398663 (lower), A398664 (upper)
%C A398651 (h,k)=(1/2,3): A398727 (lower), A398723 (upper)
%C A398651 (h,k)=(-1,1/2): A398729 (lower), A398730 (upper)
%H A398651 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398651 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) = (0, 1, 5, 13, 25, 42).
%F A398651 G.f.: x*(1 + x)/((-1 + x)^4*(1 + x^2)).
%F A398651 a(n)+a(n-2) = A000330(n). - _R. J. Mathar_, Aug 12 2026
%t A398651 z = 60;
%t A398651 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398651 r = 1; s = 1/2;
%t A398651 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398651 Table[u[n], {n, 0, z}]
%Y A398651 Cf. A000217, A000330, A398652.
%K A398651 nonn,easy,new
%O A398651 0,3
%A A398651 _Clark Kimberling_, Aug 09 2026
