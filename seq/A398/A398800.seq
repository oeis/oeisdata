%I A398800 #31 Aug 13 2026 15:29:06
%S A398800 120,212,221,320,480,692,764,1136,1211,1224,1280,1600,1618,1829,1886,
%T A398800 1920,2088,2117,2264,2572,2668,2773,2880,3000,3362,3466,3473,4194,
%U A398800 4344,4703,4743,4748,4766,4777,5004,5008,5024,5316,5364,5378,5392,5522,5634,5728,5796,5890,5909
%N A398800 Numbers k such that there is a 4 element set of positive integers whose largest element is k and such that the sum of any two distinct elements is a perfect power.
%C A398800 Numbers k such that A398602(k) >= 4.
%H A398800 Amiram Eldar, <a href="/A398800/b398800.txt">Table of n, a(n) for n = 1..10000</a>
%e A398800 120 is a term since the sum of any two distinct elements in {1, 8, 24, 120} is a perfect power: 1 + 8 = 9 = 3^2, 1 + 24 = 25 = 5^2, 1 + 120 = 121 = 11^2, 8 + 24 = 32 = 2^5, 8 + 120 = 128 = 2^7, and 24 + 120 = 144 = 12^2.
%e A398800 k = 763442 is an example for a term for which A398602(k) = 5: [7442, 28658, 148583, 177458, 763442].
%t A398800 powQ[n_] := powQ[n] = n == 1 || GCD @@ FactorInteger[n][[;; , 2]] > 1;
%t A398800 q[k_] := Module[{v = Select[Range[k - 1], powQ[k + #] &], g}, If[Length[v] == 0, False, g = Graph[v, Flatten[Table[If[i < j && powQ[i + j], i <-> j, Nothing], {i, v}, {j, v}]]]; 1 + Length[FindClique[g][[1]]]] >= 4]; Select[Range[6000], q] (* _Amiram Eldar_, Aug 09 2026 *)
%Y A398800 Cf. A001597, A398602.
%K A398800 nonn
%O A398800 1,1
%A A398800 _Nadav Mizrahi_, Aug 09 2026
