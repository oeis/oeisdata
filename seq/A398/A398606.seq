%I A398606 #22 Sep 05 2026 05:30:20
%S A398606 6,20,24,48,54,56,70,72,84,88,90,96,108,126,132,135,156,160,190,192,
%T A398606 196,198,200,204,216,224,228,230,234,252,273,276,288,300,304,306,308,
%U A398606 315,320,342,348,350,352,364,372,374,384,396,414,416,432,444,448,450,459,464,468,476,486,492,495,500
%N A398606 Primitive terms of A348713.
%C A398606 A term m of A348713 is called primitive if there is no smaller term d of A348713 such that m = k*d with gcd(k,d)=1.
%C A398606 Indeed, when m is a term of A348713 and gcd(k,m) = 1, then k*m is also a term of A348713.
%C A398606 The least two odd terms are 135 and 273.
%H A398606 Amiram Eldar, <a href="/A398606/b398606.txt">Table of n, a(n) for n = 1..2868</a> (terms <= 45000, calculated from the b-file at A348713)
%e A398606 24 = 4*6 with 6 a term of A348713, but as gcd(4,6) = 2 <> 1, then 24 is a term.
%e A398606 42 = 7*6 with 6 a term of A348713, but as gcd(7,6) = 1, then 42 is not a primitive term.
%e A398606 88 is another term since there is no smaller term d of A348713 such that 88 = k*d with gcd(k,d)=1.
%t A398606 q[n_] := q[n] = Module[{d = Divisors[n], nd, m, s, subs, ans = False}, nd = Length[d]; m = Plus @@ d/nd; subs = Subsets[d]; Do[s = subs[[k]]; If[0 < Length[s] < nd && Mean[s] == m, ans = True; Break[]], {k, 1, Length[subs]}]; ans]; primQ[n_] := q[n] && AllTrue[Select[Divisors[n], # < n && CoprimeQ[#, n/#] &], !q[#] &]; Select[Range[400], primQ] (* _Amiram Eldar_, Sep 02 2026 *)
%Y A398606 Subsequence of A348713.
%K A398606 nonn,new
%O A398606 1,1
%A A398606 _Bernard Schott_, Sep 02 2026
