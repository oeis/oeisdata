%N A398632 Number of permutations p of [n+5] such that |p(i+1)-p(i)| <> n for all 1 <= i < n+5.
%F A398632 a(n) = A398634(n+5,n).
%F A398632 a(n) = Sum_{k=0..5} (-2)^k * binomial(5,k) * (n+5-k)! for n >= 5.
%o A398632 (PARI) a(n) = my(v=[120, 90, 952, 9936, 108576]); if(n<5, v[n+1], sum(k=0, 5, (-2)^k*binomial(5, k)*(n+5-k)!));
%Y A398632 Diagonal of A398634.
