%U A398331 452718184190044920,10448702916034562550,250577203347521575602,6239188857841443426972,161153626386067127915436
%N A398331 One-half of the number of permutations p of [n] having exactly five runs of adjacent entries differing by 1.
%C A398331 A run is a maximal contiguous block p(i),p(i+1),...,p(j), with j>i, such that |p(h+1)-p(h)|=1 for every i<=h<j.
%H A398331 Seiichi Manyama, <a href="/A398331/b398331.txt">Table of n, a(n) for n = 10..450</a>
%F A398331 a(n) = A398328(n,5)/2.
%F A398331 G.f.: (1/(1-x)^15) * Sum_{k>=0} k! * ((1+x)^4*binomial(k+1,1)^2 - 16*(1+x)^3*binomial(k+2,2)^2 + 144*(1+x)^2*binomial(k+3,3)^2 - 768*(1+x)*binomial(k+4,4)^2 + 1920*binomial(k+5,5)^2) * (x*(1-x)/(1+x))^(k+10).
%o A398331 (PARI) my(N=20, x='x+O('x^N)); Vec(sum(k=0, N, k!*((1+x)^4*binomial(k+1, 1)^2-16*(1+x)^3*binomial(k+2, 2)^2+144*(1+x)^2*binomial(k+3, 3)^2-768*(1+x)*binomial(k+4, 4)^2+1920*binomial(k+5, 5)^2)*(x*(1-x)/(1+x))^(k+10))/(1-x)^15)
%Y A398331 Cf. A398328.
%K A398331 nonn,new
%O A398331 10,1
%A A398331 _Seiichi Manyama_, Sep 01 2026
