%I A398532 #13 Aug 06 2026 04:54:48
%S A398532 1,3,8,3,43,9,253,6,22,118,1547,53,271,230,263,187,7093,41,871,151,
%T A398532 1781,41243,1028389,107,98,7937,8537,1541,47809,487,81022,731,8629,
%U A398532 151213,37952,968,113818,119347,824983,6056,260893,1132,51221,39544,16657,327644,16023738,363,8053,8167
%N A398532 a(n) = numerator(Sum_{k=1..n} phi(floor(n/k))/floor(n/k)), where phi is the Euler totient function.
%H A398532 Amiram Eldar, <a href="/A398532/b398532.txt">Table of n, a(n) for n = 1..10000</a>
%H A398532 Olivier Bordellès, Lixia Dai, Randell Heyman, Hao Pan, and Igor E. Shparlinski, <a href="https://doi.org/10.1016/j.jnt.2019.01.006">On a sum involving the Euler function</a>, Journal of Number Theory, Vol. 202 (2019), pp. 278-297.
%H A398532 Shane Chern, <a href="https://doi.org/10.1017/S0004972719000066">Note on sums involving the Euler function</a>, Bulletin of the Australian Mathematical Society, Vol. 100, No. 2 (2019), pp. 194-200.
%H A398532 Jing Ma and Huayan Sun, <a href="https://doi.org/10.1007/s11139-022-00588-y">On a sum involving certain arithmetic functions and the integral part function</a>, The Ramanujan Journal, Vol. 60 (2023), pp. 1025-1032; <a href="https://doi.org/10.1007/s11139-026-01336-2">Correction</a>, ibid., Vol. 69 (2026); <a href="https://arxiv.org/abs/2109.02924">arXiv preprint</a>, arXiv:2109.02924 [math.NT], 2021; <a href="https://www.researchgate.net/publication/361229857">ResearchGate link</a>. See Theorem 1, p. 1027.
%H A398532 Jie Wu, <a href="https://doi.org/10.1007/s10998-019-00300-6">Note on a paper by Bordellès, Dai, Heyman, Pan and Shparlinski</a>, Periodica Mathematica Hungarica, Vol. 80, (2020), pp. 95-102.
%H A398532 Guang-Liang Zhou and Ya-Fang Feng, <a href="https://doi.org/10.1216/rmj.2024.54.623">Distribution of the Primes Represented by floor(x/n) in Short Intervals</a>, Rocky Mountain Journal of Mathematics, Vol. 54, No. 2 (2024), pp. 623-629.
%F A398532 a(n)/A398533(n) = c * n + O(n^(1/2)), where c = 0.788385... = A398534 (Bordellès et al., 2019).
%F A398532 The error term was further improved to O(n^(131/416)*log(n)^(26947/8320)) (Chern, 2019), O(n^(1/3)*log(n)) (Wu, 2020; Ma and Sun, 2021).
%e A398532 Fractions begin with 1, 3/2, 8/3, 3, 43/10, 9/2, 253/42, 6, 22/3, 118/15, 1547/165, 53/6, ...
%t A398532 a[n_] := Numerator[Sum[(EulerPhi[#]/# &)@ Floor[n/k], {k, 1, n}]]; Array[a, 50]
%o A398532 (PARI) a(n) = numerator(sum(k = 1, n, eulerphi(n\k)/(n\k)));
%Y A398532 Cf. A000010, A317625, A398533 (denominators), A398534.
%K A398532 nonn,frac,easy,changed
%O A398532 1,2
%A A398532 _Amiram Eldar_, Aug 01 2026
