%I A398897 #38 Sep 26 2026 00:26:10
%S A398897 1,2,12,168,7548,315980,15709200,7515313080,6626184180
%N A398897 a(n) is the least k such that there are exactly n primes p such that (k/p)^2 + 1 is prime.
%C A398897 a(n) is the least k such that A359249(k) = n.
%C A398897 Of course, p must divide k in order for (k/p)^2 + 1 to be an integer.
%C A398897 For n <= 6, a(n) is in A400135, but this is not required (and is not true for n=7).
%e A398897 a(3) = 168 because 168 has prime factors 2, 3, 7 with (168/2)^2 + 1 = 7057, (168/3)^2 + 1 = 3137 and (168/7)^2 + 1 = 577 all prime, and no smaller number works.
%p A398897 f:= n -> nops(select(p -> isprime((n/p)^2+1), NumberTheory:-PrimeFactors(n))):
%p A398897 V:= Array(0..6): count:= 0:
%p A398897 for n from 1 while count < 7 do
%p A398897   v:= f(n);
%p A398897   if v <= 6 and V[v] = 0 then V[v]:= n; count:= count+1 fi
%p A398897 od:
%p A398897 convert(V,list);
%o A398897 (Python)
%o A398897 from itertools import count, islice
%o A398897 from sympy import factorint, isprime
%o A398897 def f(k): return sum(1 for p in factorint(k) if isprime((k//p)**2 + 1))
%o A398897 def agen(): # generator of terms
%o A398897     adict, n = dict(), 0
%o A398897     for k in count(1):
%o A398897         v = f(k)
%o A398897         if v not in adict:
%o A398897             adict[v] = k
%o A398897             while n in adict:
%o A398897                 yield adict[n]
%o A398897                 n += 1
%o A398897 print(list(islice(agen(), 6))) # _Michael S. Branicky_, Sep 20 2026
%Y A398897 Cf. A359249, A400135.
%K A398897 nonn,more,new
%O A398897 0,2
%A A398897 _Robert Israel_, Sep 19 2026
%E A398897 a(7)-a(8) from _David A. Corneth_, Sep 20 2026
