%I A398118 #42 Sep 26 2026 05:37:57
%S A398118 5,8,28,29,31,54,55,257,260,283,512,3126,3129,3152,3153,3164,3381,
%T A398118 3416,3435,3665,6250,46657,46660,46661,46683,46912,49781,49782,50064,
%U A398118 93312,93344,93367,96446,823544,823545,823547,823570,823799,870199,923362,1647086
%N A398118 Numbers that are Münchhausen numbers in at least one base b with 2 <= b <= n-2.
%C A398118 A positive integer n is a Münchhausen number in base b if the sum of its base-b digits each raised to its own power equals n (with the convention that 0^0 = 1).
%C A398118 This sequence lists those n that satisfy the condition for at least one base b in the range 2 <= b <= n-2.
%C A398118 The range is chosen by analogy with the strictly non-palindromic numbers (A016038). It is easy to prove that 5 is the unique term that works with base exactly n-2.
%C A398118 There is an infinite parametric family of two-digit solutions of the form n = 1 + k^k (k >= 2), which appear in base b = 1 + k^k - k. The first few members are 5, 28, 257, 3126, ...
%C A398118 28 is Münchhausen in two different admissible bases (9 and 25).
%C A398118 257 is Münchhausen in two different admissible bases (64 and 253).
%C A398118 283 is Münchhausen in two different admissible bases (70 and 93).
%H A398118 Daan van Berkel, <a href="https://arxiv.org/abs/0911.3038">On a curious property of 3435</a>, arXiv:0911.3038 [math.HO], 2009.
%H A398118 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/MuenchhausenNumber.html">Münchhausen Number</a>
%H A398118 Wikipedia, <a href="https://en.wikipedia.org/wiki/Perfect_digit-to-digit_invariant">Perfect digit-to-digit invariant</a>
%e A398118 5 = 12 in base 3 and 1^1 + 2^2 = 5.
%e A398118 28 = 31 in base 9 and 3^3 + 1^1 = 28; also 28 = 13 in base 25 and 1^1 + 3^3 = 28.
%e A398118 257 = 41 in base 64 and 4^4 + 1^1 = 257; also 257 = 14 in base 253 and 1^1 + 4^4 = 257.
%t A398118 pow[d_] := If[d == 0, 1, d^d];
%t A398118 Select[Range[4, 600], Function[n, AnyTrue[Range[2, n-2], Total[pow /@ IntegerDigits[n, #]] == n &]]]
%o A398118 (Python)
%o A398118 POW = [1] + [d**d for d in range(1, 40)]
%o A398118 def is_munch(n, b):
%o A398118     s = 0
%o A398118     t = n
%o A398118     while t:
%o A398118         d = t % b
%o A398118         if d >= len(POW):
%o A398118             return False
%o A398118         s += POW[d]
%o A398118         if s > n:
%o A398118             return False
%o A398118         t //= b
%o A398118     return s == n
%o A398118 print([n for n in range(4, 600) if any(is_munch(n, b) for b in range(2, n - 1))])
%Y A398118 Cf. A166623, A046253.
%K A398118 nonn,base,more,new
