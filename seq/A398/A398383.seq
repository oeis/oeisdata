%I A398383 #10 Aug 09 2026 17:29:20
%S A398383 5,632,60836,5490624,483661630,42095664992,3638993792712,
%T A398383 313252741332480,26890281083038145,2303830432872839632,
%U A398383 197102971744817470700,16845264361597484796672,1438503960471586211357926,122763357209259346551214784,10471440354007200238589749336
%N A398383 a(n) = c_6a(n)/n^2, where c_6a(n) are the Fourier coefficients of the level-2 K3 meromorphic modular form C_6a defined below.
%C A398383 Bönisch, Duhr and Maggio introduced C_6a and conjectured that it is magnetic of depth 2. Shvets proved the stronger denominator-one statement a(n) in Z for every n >= 1.
%C A398383 The form is, up to scaling, the canonical level-2 CM form of discriminant -8: f_{3,-8,0,1,1} = -64*C_6a.
%C A398383 If n = 2^r*m with m odd, then 2^(3*r) divides a(n). In fact, the stronger estimate v_2(c_6a(2^r*m)) >= 5*r holds.
%C A398383 All terms are positive; this also follows from the nonnegative-coefficient expansion in the Formula section.
%H A398383 Kilian Bönisch, Claude Duhr and Sara Maggio, <a href="https://arxiv.org/abs/2404.04085">Some conjectures around magnetic modular forms</a>, arXiv:2404.04085 [math.NT], 2024.
%H A398383 Alex Shvets, <a href="https://arxiv.org/abs/2607.19427">Integral magneticity of the level-two K3 packet: CM theta lifts and a 2-isogeny trace contraction</a>, arXiv:2607.19427 [math.NT], 2026.
%F A398383 a(n) = (1/n^2)*[q^n] B(q)*(5 + 22*u(q) + 5*u(q)^2)/(1 - u(q))^3, where B(q) = Sum_{k>=1} k^5*q^k/(1 - q^(2*k)) = Sum_{n>=1} A096960(n)*q^n, and u(q) = 64*q*Product_{m>=1} (1 + q^m)^24.
%F A398383 Sum_{n>=1} n^2*a(n)*q^n = C_6a(q).
%F A398383 (5 + 22*u + 5*u^2)/(1 - u)^3 = Sum_{j>=0} (16*j^2 + 16*j + 5)*u^j.
%F A398383 a(n) ~ exp(Pi*sqrt(2)*n) / 8. - _Vaclav Kotesovec_, Jul 28 2026
%e A398383 The coefficient of q^2 in C_6a is c_6a(2) = 2528, hence a(2) = 2528/2^2 = 632. Similarly, a(3) = 547524/3^2 = 60836.
%t A398383 nn = 20;
%t A398383 tt = Series[q*Product[(1 + q^m)^24, {m, 1, nn}], {q, 0, nn}];
%t A398383 uu = 64*tt;
%t A398383 bb = Series[Sum[m^5*q^m/(1 - q^(2*m)), {m, 1, nn}], {q, 0, nn}];
%t A398383 cc = Normal@Series[bb*(5 + 22*uu + 5*uu^2)/(1 - uu)^3, {q, 0, nn}];
%t A398383 Table[Coefficient[cc, q, n]/n^2, {n, 1, nn}]
%o A398383 (SageMath)
%o A398383 N = 20
%o A398383 R.<q> = PowerSeriesRing(QQ, default_prec=N+1)
%o A398383 t = q*prod((1+q^m)^24 for m in range(1,N+1))
%o A398383 u = 64*t
%o A398383 B = sum(m^5*q^m/(1-q^(2*m)) for m in range(1,N+1))
%o A398383 C6a = B*(5+22*u+5*u^2)/(1-u)^3
%o A398383 [C6a[n]/n^2 for n in range(1,N+1)]
%Y A398383 Cf. A096960, A398186 (weight-4 companion arising from the same level-2 K3 packet).
%K A398383 nonn
%O A398383 1,1
%A A398383 _Alex Shvets_, Jul 27 2026
