%I A398874 #22 Aug 24 2026 23:27:53
%S A398874 3,6,11,19,33,56,97,168,295,521,933,1680,3057,5595,10315,19115,35625,
%T A398874 66667,125303,236316,447187,848615,1614765,3079785,5886981,11274972,
%U A398874 21633971,41579365,80037549,154286000,297808117,575545914,1113584697,2156909895,4181941899
%N A398874 Number of recursive calls made by the binary Fredricksen-Kessler-Maiorana (FKM) recursive generator when generating a de Bruijn sequence of order n.
%C A398874 Essentialy a(n) is a double partial sum of the number of binary Lyndon words of length n, equivalently the number of monic irreducible polynomials of degree n over GF(2).
%C A398874 The connection with de Bruijn sequences follows from the Fredricksen-Kessler-Maiorana theorem: lexicographically minimal binary de Bruijn sequences are obtained from Lyndon words whose lengths divide n.
%C A398874 The count of recursive calls includes every invocation of the recursive procedure, including terminal calls with t > n.
%C A398874 More precisely, let db(t,p) be the standard FKM recursion, initialized by db(1,1), with alphabet {0,1}. Then a(n) is the total number of invocations of db before the computation terminates.
%H A398874 Gal Amram, Amir Rubin, Yotam Svoray and Gera Weiss, <a href="https://arxiv.org/abs/1805.02405">De Bruijn Sequences: From Games to Shift-Rules to a Proof of the Fredricksen-Kessler-Maiorana Theorem</a>, arXiv:1805.02405 [cs.DM], 2020.
%H A398874 Tomasz Kociumaka, Jakub Radoszewski and Wojciech Rytter, <a href="https://arxiv.org/abs/1510.02637">Efficient Ranking of Lyndon Words and Decoding Lexicographically Minimal de Bruijn Sequence</a>, arXiv:1510.02637 [cs.DS], 2023.
%F A398874 a(n) = 1 + Sum_{k=1..n} A062692(k).
%F A398874 a(n) = 1 + Sum_{k=1..n} (n-k+1)*A001037(k).
%F A398874 a(n) = 1 + Sum_{k=1..n} (n-k+1)*(1/k)*Sum_{d|k} mu(d)*2^(k/d).
%F A398874 a(1)=3 and a(2) = 6 and a(n) = 2*a(n-1)-a(n-2) + A001037(n) for n>=3.
%F A398874 a(p^e) = 2*a((p^e)-1)-a((p^e)-2) + (2^(p^e)-2^(p^(e-1)))/(p^e) for p prime.
%F A398874 a(n) ~ 2^(n+2)/n.
%o A398874 (Python)
%o A398874 def a(n):
%o A398874     k = 2
%o A398874     a = [0]*(k*n)
%o A398874     calls = [0]
%o A398874     def db(t, p):
%o A398874         calls[0] += 1
%o A398874         if t > n: return
%o A398874         a[t] = a[t-p]
%o A398874         db(t+1, p)
%o A398874         for j in range(a[t-p]+1, k):
%o A398874             a[t] = j
%o A398874             db(t+1, t)
%o A398874     db(1,1)
%o A398874     return calls[0]
%Y A398874 Cf. A000040, A001037, A001036, A062692.
%K A398874 nonn,new
%O A398874 1,1
