%I A398752 #13 Nov 25 2026 20:20:55
%S A398752 18,24,28,40,44,45,48,50,52,54,60,63,68,75,76,80,84,88,92,96,98,99,
%T A398752 104,112,116,117,120,124,126,135,136,140,147,148,150,152,153,160,162,
%U A398752 164,168,171,172,175,176,180,184,188,189,192,198,204,207,208,212,220,224
%N A398752 Numbers that are neither squarefree, powerful, or oblong.
%H A398752 Michael De Vlieger, <a href="/A398752/b398752.txt">Table of n, a(n) for n = 1..10000</a>
%F A398752 {a(n)} = A332785 \ A002378 = A332785 \ A398749.
%e A398752 Let s = A332785.
%e A398752 Table of n, a(n) for n = 1..12:
%e A398752    n           a(n)
%e A398752   ------------------------------
%e A398752    1     s(2) = 18 = 2 * 3^2
%e A398752    2     s(4) = 24 = 2^3 * 3
%e A398752    3     s(5) = 28 = 2^2 * 7
%e A398752    4     s(6) = 40 = 2^3 * 5
%e A398752    5     s(7) = 44 = 2^2 * 11
%e A398752    6     s(8) = 45 = 3^2 * 5
%e A398752    7     s(9) = 48 = 2^4 * 3
%e A398752    8    s(10) = 50 = 2 * 5^2
%e A398752    9    s(11) = 52 = 2^2 * 13
%e A398752   10    s(12) = 54 = 2 * 3^3
%e A398752   11    s(14) = 60 = 2^2 * 3 * 5
%e A398752   12    s(15) = 63 = 3^2 * 7
%e A398752 .
%e A398752 s(1) = 12 is not in the sequence since 12 = 3*4.
%e A398752 s(3) = 20 is not a term since 20 = 4*5.
%e A398752 s(13) = 56 is not a term since 56 = 7*8.
%t A398752 oblongQ[x_] := IntegerQ@ Sqrt[4*x + 1]; fQ[x_] := And[! SquareFreeQ[x], Min@ FactorInteger[x][[;; , -1]] == 1]; Select[Range[240], And[fQ[#], ! oblongQ[#]] &]
%o A398752 (PARI)
%o A398752 A005369(n) = if( n<0, 0, issquare(4*n + 1));
%o A398752 is_A398752(k) = (!issquarefree(k) && !ispowerful(k) && !A005369(k)); \\ _Antti Karttunen_, Nov 25 2026
%Y A398752 Cf. A002378, A005369, A332785, A398749.
%K A398752 nonn,easy,new
%O A398752 1,1
