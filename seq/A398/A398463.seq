%N A398463 Multiplicative with a(p^e) = e^2 * p^e.
%H A398463 Vaclav Kotesovec, <a href="/A398463/b398463.txt">Table of n, a(n) for n = 1..10000</a>
%F A398463 Dirichlet g.f.: zeta(s-1) * Product_{primes p} (1 + (3*p^s - p)/(p^(s - 2)*(p^s - p)^2)).
%F A398463 Sum_{k=1..n} a(k) ~ c*n^2/2, where c = Product_{primes p} (1 + (3*p-1)/(p*(p-1)^2)) = 8.1884047438269854496732670996438853946140108519601349232818613803802052838...
%F A398463 a(n) = A360969(n) * n = A005361(n)^2 * n. - _Amiram Eldar_, Oct 02 2026
%p A398463 a:= n-> n*mul(i, i=ifactors(n)[2][.., 2])^2:
%p A398463 seq(a(n), n=1..65);  # _Alois P. Heinz_, Oct 04 2026
%t A398463 f[p_, e_]:=e^2*p^e; a[1]=1; a[n_]:=Times@@f@@@FactorInteger[n]; Array[a, 100]
%o A398463 (PARI) for(n=1, 100, print1(direuler(p=2, n, (p*X*(p*X*(p*X-4)+2)-1)/(p*X-1)^3)[n], ", "))
%o A398463 (PARI) a(n) = vecprod(factor(n)[, 2])^2 * n; \\ _Amiram Eldar_, Oct 02 2026
