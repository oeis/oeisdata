%S A398493 0,0,1441,15872,184084,940896,4874409,16760832,57898576,156200000,
%T A398493 422217625,967334400,2218340916,4519335072,9211796209,17179344896,
%U A398493 32047960384,55787605632,97130884401,159998400000,263589440500,414996216800,653427239641,990673846272
%N A398493 Number of increasing 3-term arithmetic progressions in an n^5 hypercube.
%C A398493 Each term in the arithmetic progression is a 5-dimensional coordinate vector. Vectors are compared lexicographically.
%H A398493 Paolo Xausa, <a href="/A398493/b398493.txt">Table of n, a(n) for n = 1..10000</a>
%H A398493 Hiller Alves Fernandes, <a href="https://doi.org/10.5281/zenodo.21708794">Counting 3-Term Arithmetic Progressions in Integer Hypercubes</a>, Zenodo (2026).
%F A398493 If n even: a(n) = (n^10 - 32*n^5)/64.
%F A398493 If n odd: a(n) = ((n^2+1)^5 - 32*n^5)/64.
%t A398493 A398493[n_] := ((n^2 + Boole[OddQ[n]])^5 - 32*n^5)/64;
%t A398493 Array[A398493, 25] (* _Paolo Xausa_, Aug 10 2026 *)
%o A398493 (Python)
%o A398493 def a(n, d=5):
%o A398493     if n % 2 == 0:
%o A398493         return (n**10 - 32*n**5) // 64
%o A398493     else:
%o A398493         return ((n**2 + 1)**5 - 32*n**5) // 64
%o A398493 terms = [a(n) for n in range(1, 31)]
%o A398493 print(terms)
%Y A398493 Column 5 of A397600.
