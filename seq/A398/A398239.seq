%S A398239 1,16,496125,375297659043840,5885897714143664700439342125,
%T A398239 36939045170346949681155330481716034613142893328,
%U A398239 6534202633010670269867215767933610134885933112751212836999944975789165
%N A398239 Number of spanning trees in the graph whose nodes are the integer lattice points (x,y) with 0 <= x,y < n, and with an edge between two nodes if there is no other integer lattice point on the line segment between them.
%H A398239 Andrew Howroyd, <a href="/A398239/b398239.txt">Table of n, a(n) for n = 1..20</a>
%o A398239 (PARI)
%o A398239 SpanningTreeCount(M) = {my(n=#M); abs(matdet((matdiagonal(vecsum(Vec(M))) - M)[2..n, 2..n])) }
%o A398239 AdjG(n,m) = {matrix(n*m , n*m, i, j, i--; j--; my(ix=i%m, iy=i\m, jx=j%m, jy=j\m); gcd(ix-jx,iy-jy)==1)}
%o A398239 a(n) = SpanningTreeCount(AdjG(n,n))
%Y A398239 Main diagonal of A360062.
%Y A398239 Cf. A396634.
%K A398239 nonn,new
