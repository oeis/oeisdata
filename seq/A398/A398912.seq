%I A398912 #19 Aug 15 2026 16:18:37
%S A398912 1,0,1,0,1,3,0,9,8,10,0,96,80,45,35,0,1250,1000,525,224,126,0,19440,
%T A398912 15120,7560,3024,1050,462,0,352947,268912,129654,49392,16170,4752,
%U A398912 1716,0,7340032,5505024,2580480,946176,295680,82368,21021,6435
%N A398912 Triangle read by rows: Number of functions f: [n] -> [n] where the longest nondecreasing initial run has length k.
%H A398912 Paolo Xausa, <a href="/A398912/b398912.txt">Table of n, a(n) for n = 0..11475</a> (rows 0..150 of triangle, flattened).
%F A398912 T(n, k) = k * binomial(n + k - 1, k + 1) * n^(n - k - 1) if 0 <= k < n, binomial(2 * n - 1, n) if k = n.
%e A398912 Triangle starts:
%e A398912   [0] 1;
%e A398912   [1] 0,      1;
%e A398912   [2] 0,      1,      3;
%e A398912   [3] 0,      9,      8,     10;
%e A398912   [4] 0,     96,     80,     45,    35;
%e A398912   [5] 0,   1250,   1000,    525,   224,   126;
%e A398912   [6] 0,  19440,  15120,   7560,  3024,  1050,  462;
%e A398912   [7] 0, 352947, 268912, 129654, 49392, 16170, 4752, 1716;
%e A398912 .
%e A398912 Classifying the endomorphisms for n = 3:
%e A398912   T(3,1) =  9 -> 2|11, 2|12, 2|13, 3|11, 3|12, 3|13, 3|21, 3|22, 3|23,
%e A398912   T(3,2) =  8 -> 12|1, 22|1, 13|1, 23|1, 33|1, 13|2, 23|2, 33|2,
%e A398912   T(3,3) = 10 -> 111|, 112|, 113|, 122|, 123|, 133|, 222|, 223|, 233|, 333|.
%p A398912 T := (n, k) -> ifelse(k = n, binomial(2 * n - 1, n), k * binomial(n + k - 1, k + 1) * (n ^ (n - k - 1))):
%t A398912 A398912[n_, k_] := If[n == k, Binomial[2*n - 1, n], k*Binomial[n + k - 1, k + 1]*n^(n - k - 1)];
%t A398912 Table[A398912[n, k], {n, 0, 10}, {k, 0, n}] (* _Paolo Xausa_, Aug 15 2026 *)
%o A398912 (Python)
%o A398912 def Trow(n: int) -> list[int]:
%o A398912     if n == 0: return [1]
%o A398912     if n == 1: return [0, 1]
%o A398912     row = [0] * (n + 1)
%o A398912     binom = n * (n - 1) // 2
%o A398912     power = n ** (n - 2)
%o A398912     for k in range(1, n):
%o A398912         row[k] = k * binom * power
%o A398912         if k == n - 1:
%o A398912             row[n] = binom * (2 * n - 1) // (n - 1)
%o A398912         binom = binom * (n + k) // (k + 2)
%o A398912         power //= n
%o A398912     return row
%o A398912 for n in range(8): print(Trow(n))
%Y A398912 Cf. |A070896| and A081131 (column 1), A001700 and A088218 (main diagonal), A110609 (column n-1), A398914 (column n-2), A000312 (row sums).
