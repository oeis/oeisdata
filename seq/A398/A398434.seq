%I A398434 #5 Aug 31 2026 18:24:52
%S A398434 1,2,2,3,2,3,2,4,3,4,2,4,2,4,3,5,2,5,2,5,4,4,2,5,3,4,4,5,2,5,2,6,4,4,
%T A398434 4,6,2,4,4,6,2,6,2,6,4,4,2,7,3,6,4,6,2,6,4,6,4,4,2,7,2,4,5,7,4,6,2,6,
%U A398434 4,7,2,8,2,4,5,6,4,6,2,7,5,4,2,8,4,4,4,7
%N A398434 a(n) is the maximum cardinality of a Sidon subset of the set of positive divisors of n.
%C A398434 Let D(n) be the set of positive divisors of n. A finite set S of integers is a Sidon set if all sums x + y with x, y in S and x <= y are distinct.
%C A398434 Equivalently, a finite set of integers is a Sidon set if all its positive differences x - y with x > y are distinct.
%C A398434 a(n) <= A000005(n), with equality if and only if D(n) is a Sidon set, or equivalently if and only if A398435(n) = 0.
%C A398434 The indices n for which a(n) < A000005(n) are precisely the multiples of terms of A398433.
%H A398434 Felix Huber, <a href="/A398434/b398434.txt">Table of n, a(n) for n = 1..5000</a>
%F A398434 a(p^k) = k + 1 for every prime p and k >= 0.
%F A398434 For distinct primes p < q, a(p*q) = 3 if q = 2*p - 1, and a(p*q) = 4 otherwise.
%F A398434 a(n) <= A000005(n) - A398577(n) + 1.
%e A398434 The positive divisors of 6 are {1, 2, 3, 6}. This set is not Sidon since 1 + 3 = 2 + 2, but {1, 2, 6} is a Sidon set. Hence a(6) = 3.
%e A398434 The positive divisors of 12 are {1, 2, 3, 4, 6, 12}. The subset {1, 2, 4, 12} is Sidon, and no five-element subset is Sidon. Hence a(12) = 4.
%p A398434 A398434 := proc(n) option remember;
%p A398434     local b, d, m, r;
%p A398434     d := sort([op(NumberTheory:-Divisors(n))]);
%p A398434     m := nops(d);
%p A398434     b := 0;
%p A398434     r := proc(p, c, u, k)
%p A398434         local i, q, v, x;
%p A398434         if k + m - p + 1 <= b then
%p A398434             return NULL
%p A398434         end if;
%p A398434         if k > b then
%p A398434             b := k
%p A398434         end if;
%p A398434         for i from p to m do
%p A398434             if k + m - i + 1 <= b then
%p A398434                 return NULL
%p A398434             end if;
%p A398434             x := d[i];
%p A398434             v := {2*x, seq(x + c[q], q = 1 .. k)};
%p A398434             if (u intersect v) = {} then
%p A398434                 r(i + 1, [op(c), x], u union v, k + 1)
%p A398434             end if
%p A398434         end do;
%p A398434         return NULL
%p A398434     end proc;
%p A398434     r(1, [], {}, 0);
%p A398434     return b
%p A398434 end proc:
%p A398434 seq(A398434(n), n = 1 .. 88);
%Y A398434 Cf. A000005, A398429, A398433, A398435, A398577.
%K A398434 nonn,new
%O A398434 1,2
%A A398434 _Felix Huber_, Aug 25 2026
