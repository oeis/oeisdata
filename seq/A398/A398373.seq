%S A398373 1,1,1,4,4,3,27,27,18,10,256,256,160,80,35,3125,3125,1875,875,350,126,
%T A398373 46656,46656,27216,12096,4536,1512,462,823543,823543,470596,201684,
%U A398373 72030,22638,6468,1716,16777216,16777216,9437184,3932160,1351680,405504,109824,27456,6435
%N A398373 Triangle read by rows: T(n, k) = binomial(n + k - 1, k) * n^(n - k).
%C A398373 For a combinatorial interpretation, consider [n] = {1, 2, ..., n}. T(n, k) is the number of functions f: [n] -> [n] whose restriction to a fixed k-element ordered subset (say {1, ..., k}) is monotone (order-preserving, i.e., f(1) <= f(2) <= ... <= f(k)), with no constraint on the mapping of the remaining n - k elements.
%C A398373 This also immediately explains the two edge cases: T(n, 0) = n^n (no condition) and T(n, n) = binomial(2*n - 1, n) (full nondecreasing monotonicity).
%H A398373 Paolo Xausa, <a href="/A398373/b398373.txt">Table of n, a(n) for n = 0..11475</a> (rows 0..150 of triangle, flattened).
%F A398373 T(n, k + 1) = T(n, k) * (n + k) / (n * (k + 1)) starting with T(n, 0) = n^n.
%e A398373 Triangle starts:
%e A398373   [0]        1;
%e A398373   [1]        1,        1;
%e A398373   [2]        4,        4,       3;
%e A398373   [3]       27,       27,      18,      10;
%e A398373   [4]      256,      256,     160,      80,      35;
%e A398373   [5]     3125,     3125,    1875,     875,     350,    126;
%e A398373   [6]    46656,    46656,   27216,   12096,    4536,   1512,    462;
%e A398373   [7]   823543,   823543,  470596,  201684,   72030,  22638,   6468,  1716;
%e A398373   [8] 16777216, 16777216, 9437184, 3932160, 1351680, 405504, 109824, 27456, 6435;
%p A398373 T := (n, k) -> binomial(n + k - 1, k) * n^(n - k):
%t A398373 A398373[n_, k_] := If[n == 0, 1, Binomial[n + k - 1, k] * n^(n - k)];
%t A398373 Table[A398373[n, k], {n, 0, 10}, {k, 0, n}] (* _Paolo Xausa_, Aug 06 2026 *)
%o A398373 (Python)
%o A398373 def A398373_triangle(rows: int) -> list[list[int]]:
%o A398373     triangle = []
%o A398373     if rows > 0: triangle.append([1])
%o A398373     for n in range(1, rows):
%o A398373         val = n ** n
%o A398373         row = [val]
%o A398373         for k in range(n):
%o A398373             val = val * (n + k) // (n * (k + 1))
%o A398373             row.append(val)
%o A398373         triangle.append(row)
%o A398373     return triangle
%o A398373 for row in A398373_triangle(9): print(row)
