%U A398333 9,6,13,4,21,6,12,3,22,8,21,9,8,11,13,8,24,8,10,10,26,11,11,11,14,7,27,5
%N A398333 Number of integers r, 1<=r<n, such that L(n*r) < L(n*r+1) where L(x) is the largest divisor of x <= the square root of x.
%H A398333 Srikanth Cherukupally, <a href="/A398333/b398333.txt">Table of n, a(n) for n = 1..1000</a>
%H A398333 Srikanth Cherukupally, <a href="https://arxiv.org/abs/2609.08596">A problem on the largest divisor d of N with d <= sqrt(N)</a>, arXiv:2609.08596 [math.NT], 2026.
%e A398333 a(7) = 3 as there are 3 values of r such that L(7*r) < L(7*r+1). For r = 1, L(7) = 1 and L(8) = 2. For r = 2, L(14) = 2 and L(15) = 3. For r = 5, L(35) = 5 and L(36) = 6.
%o A398333 (Python)
%o A398333 from sympy import divisors
%o A398333 def a(n):
%o A398333     r = 1
%o A398333     total_r = 0
%o A398333     while r <= n-1:
%o A398333         # compute largest div for n*r
%o A398333         set_a = divisors(n*r)
%o A398333         a = set_a[(len(set_a)-1)//2]
%o A398333         set_b = divisors(n*r+1)
%o A398333         b = set_b[(len(set_b)-1)//2]
%o A398333         if a<b:
%o A398333             total_r += 1
%o A398333         r += 1
%o A398333     n += 1
%o A398333     return total_r
%o A398333 (PARI) L(n) = if(n<2, 1, my(d=divisors(n)); d[(length(d)+1)\2]); \\ A033676
%o A398333 a(n) = sum(r=1, n, L(n*r) < L(n*r+1)); \\ _Michel Marcus_, Sep 17 2026
%Y A398333 Cf. A033676 (L(x)).
%K A398333 nonn,new
