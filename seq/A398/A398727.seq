%I A398727 #5 Aug 27 2026 00:55:05
%S A398727 0,3,16,45,95,172,283,434,630,877,1182,1551,1989,2502,3097,3780,4556,
%T A398727 5431,6412,7505,8715,10048,11511,13110,14850,16737,18778,20979,23345,
%U A398727 25882,28597,31496,34584,37867,41352,45045,48951,53076,57427,62010,66830,71893
%N A398727 Lower (1/2, 3) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398727 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398727 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398727 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) =  (0, 3, 16, 45, 95, 172).
%F A398727 G.f.: x*(3 + 4*x + 2*x^2 + 3*x^3)/((-1 + x)^4 *(1 + x^2)).
%t A398727 z = 60;
%t A398727 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398727 r = 1/2; s = 3;
%t A398727 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398727 Table[u[n], {n, 0, z}]
%Y A398727 Cf. A000217, A000330, A398728.
%K A398727 nonn,easy,new
%O A398727 0,2
%A A398727 _Clark Kimberling_, Aug 25 2026
