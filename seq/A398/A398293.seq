%U A398293 1144517546430916482569472,259756587858140283025644984,59551464786169894941177496512,13770837957174825038804010336960
%N A398293 Diagonal of rational function 1/(1 - (1 + x*y*z*w)*(x + y) - z - w).
%C A398293 For integers s >= 1, t >= 0 and e_1, ... ,e_s >= 0 with e_1 + ... + e_s = t, [x_1^n*  ... *x_s^n] 1/(1 - Sum_{i=1..s} x_i * (1 + x_1* ... *x_s)^e_i) = Sum_{k=0..n} (s*k)!/k!^s * binomial(t*k,n-k). For s=4, t=2, (e_1,e_2,e_3,e_4)=(1,1,0,0), and (x_1,x_2,x_3,x_4)=(x,y,z,w), this gives a(n) = [x^n*y^n*z^n*w^n] 1/(1 - (1 + x*y*z*w)*(x + y) - z - w).
%F A398293 a(n) = Sum_{k=0..n} (4*k)!/k!^4 * binomial(2*k,n-k).
%o A398293 (PARI) a(n, s=4, t=2) = sum(k=0, n, (s*k)!/k!^s*binomial(t*k, n-k));
%Y A398293 Cf. A002478, A137635, A398290.
%K A398293 nonn,new
