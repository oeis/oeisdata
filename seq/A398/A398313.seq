%U A398313 907145715464562,12358537460028381,175096034206311176,2575166011068906169,39248862657941272512
%N A398313 G.f. A(x) satisfies: A(x) = 1 + x * A(x/(1 - x)^2) / (1 - 2*x).
%F A398313 a(0) = a(1) = 1; a(n) = 2 * a(n-1) + Sum_{k=1..n-1} binomial(n+k-2,n-k-1) * a(k) for n >= 2.
%t A398313 nmax = 22; A[_] = 0; Do[A[x_] = 1 + x A[x/(1 - x)^2]/(1 - 2 x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A398313 (* Alternative: *)
%t A398313 a[0] = a[1] = 1; a[n_] := a[n] = 2 a[n - 1] + Sum[Binomial[n + k - 2, n - k - 1] a[k], {k, 1, n - 1}]; Table[a[n], {n, 0, 22}]
%Y A398313 Cf. A005493, A125273.
