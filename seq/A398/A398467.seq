%U A398467 4058296,4093736,4135624,4136460,4153740,4161736,4203112,4322892,4373500,4526412,4555932,4659972,4800740,4831692,4913260,5025460,5059540
%N A398467 Numbers k such that sigma(k) = psi(k) + Omega(k)^8.
%C A398467 The sequence is infinite because it contains all numbers of the form 7 * 8191 * p^2, where p is any prime.
%e A398467 229348 is a term since sigma(229348) = 458752 = 393216 + 4^8 = psi(229348) + Omega(229348)^8.
%o A398467 (PARI) isok(k) = {my(f = factor(k)); sigma(f) == prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) + bigomega(f)^8; } \\ _Amiram Eldar_, Jul 30 2026
%o A398467 (Python)
%o A398467 from math import prod
%o A398467 from sympy import factorint
%o A398467 def ok(n):
%o A398467     f = factorint(n)
%o A398467     sigma = prod((p**(e+1)-1)//(p-1) for p, e in f.items())
%o A398467     Omega = sum(f.values())
%o A398467     psi = prod((p+1)*p**(e-1) for p, e in f.items())
%o A398467     return sigma == psi + Omega**8
%o A398467 # _Michael S. Branicky_, Aug 02 2026
%Y A398467 Cf. A244963 (sigma minus psi), A001222 (Omega), A397843, A398159, A398160, A398401.
