%S A398208 0,2,0,0,0,5,0,3,0,13,0,53,17,227,11,23,7,3413,29,61,19,37,2957,149,
%T A398208 331,101,197,67,131,43,89,173,59,709,229,79,157,307,613,211,409,139,
%U A398208 271,541,191,367,127,1453,499,997,359,641,239,439,877,1709,569,1151
%N A398208 Least prime with exactly n steps in the Collatz (3x+1) problem, or 0 if there is no such prime.
%C A398208 a(n) is the smallest prime in row n of A127824, the numbers that take exactly n steps (A006577) to reach 1.
%H A398208 Sean A. Irvine, <a href="/A398208/b398208.txt">Table of n, a(n) for n = 0..74</a>
%e A398208 a(5) = 5: the numbers with exactly 5 steps are 5 and 32, and 5 is prime.
%e A398208 a(6) = 0: the numbers with exactly 6 steps are 10 and 64, neither of which is prime.
%e A398208 a(7) = 3: the numbers with exactly 7 steps are 3, 20, 21 and 128, and 3 is the only prime among them.
%o A398208 (Python)
%o A398208 from sympy import isprime
%o A398208 def A(N):
%o A398208     row, res = {1}, []
%o A398208     for n in range(N+1):
%o A398208         p = [x for x in row if isprime(x)]
%o A398208         res.append(min(p) if p else 0)
%o A398208         row = {2*x for x in row} | {(x-1)//3 for x in row if x % 6 == 4 and x > 4}
%o A398208     return res
%o A398208 print(A(57))
%Y A398208 Cf. A006577, A127824.
%K A398208 nonn,new
%O A398208 0,2
