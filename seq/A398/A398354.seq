%T A398354 3,2,9,4,3,5,3,3,4,3,2,10,3,5,2,5,5,4,2,4,2,11,5,4,5,5,5,4,3,3,4,4,12,
%U A398354 4,4,5,7,2,7,2,6,5,3,2,13,6,6,6,5,5,5,4,4,5,4,4,5
%N A398354 Triangle read by rows: T(n,k) is the number of distinct entries q of the n X n multiplication table whose remainder upon division by n is k, for 0 <= k < n.
%C A398354 This is the positive-indexed distinct-product analog of A095026, which counts ordered factor pairs in the zero-based n X n multiplication table.
%H A398354 Frédéric D. W. Heidenthal-König, <a href="https://doi.org/10.5281/zenodo.19102497">The Support of the Euclidean Decomposition of the Multiplication Table</a>, Zenodo, 2026.
%H A398354 Frédéric D. W. Heidenthal-König, <a href="https://doi.org/10.5281/zenodo.19273836">Euclidean Transport of Multiplication</a>, Zenodo, 2026.
%F A398354 T(n,k) = #{q in {i*j: 1 <= i, j <= n}: q mod n = k}.
%F A398354 Equivalently, T(n,k) = Sum_{1 <= q <= n^2, q mod n = k} A394016(n,q).
%F A398354 Sum_{k = 0..n-1} T(n,k) = A027424(n).
%F A398354 Sum_{k = 0..n-1} k*T(n,k) = A398138(n).
%F A398354 T(n,0) = n.
%e A398354 Rows for n = 1 to 12:
%e A398354   n=1:   1;
%e A398354   n=2:   2, 1;
%e A398354   n=3:   3, 2, 1;
%e A398354   n=4:   4, 2, 2, 1;
%e A398354   n=5:   5, 3, 2, 2, 2;
%e A398354   n=6:   6, 2, 3, 3, 3, 1;
%e A398354   n=7:   7, 4, 4, 3, 3, 2, 2;
%e A398354   n=8:   8, 4, 4, 2, 5, 2, 3, 2;
%e A398354   n=9:   9, 4, 3, 5, 3, 3, 4, 3, 2;
%e A398354   n=10: 10, 3, 5, 2, 5, 5, 4, 2, 4, 2;
%e A398354   n=11: 11, 5, 4, 5, 5, 5, 4, 3, 3, 4, 4;
%e A398354   n=12: 12, 4, 4, 5, 7, 2, 7, 2, 6, 5, 3, 2;
%e A398354   ...
%o A398354 (Python)
%o A398354 def row(n):
%o A398354     products = set()
%o A398354     for i in range(1, n + 1):
%o A398354         for j in range(1, n + 1):
%o A398354             products.add(i * j)
%o A398354     counts = [0] * n
%o A398354     for q in products:
%o A398354         counts[q % n] += 1
%o A398354     return counts
%o A398354 terms = []
%o A398354 for n in range(1, 14):
%o A398354     terms.extend(row(n))
%o A398354 print(terms)
%o A398354 (PARI) row(n) = my(s=setbinop((x,y)->x*y, [1..n])); vector(n, m, #select(x->((x % n)==(m-1)), s)); \\ _Michel Marcus_, Jul 27 2026
%Y A398354 Row sums give A027424.
%Y A398354 Cf. A095026, A394016, A397038, A398138.
%K A398354 nonn,tabl
%O A398354 1,2
