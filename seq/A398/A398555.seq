%U A398555 23264296,23436056,23793540,23861816,24396856,24405060,24539416,24666540,24943592,25018696,25110060,25222696,25267432,25349772,25766456,25921816
%N A398555 Numbers k such that sigma(k) = psi(k) + Omega(k)^9.
%C A398555 The sequence is infinite because it contains all numbers of the form 31 * 8191 * p^2, where p is any prime such that gcd(p, 31 * 8191) = 1.
%e A398555 1015684 is a term since sigma(1015684) = 1835008 = 1572864 + 4^9 = psi(1015684) + Omega(1015684)^9.
%o A398555 (PARI) isok(k) = {my(f = factor(k)); sigma(f) == prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) + bigomega(f)^9; } \\ _Amiram Eldar_, Aug 02 2026
%o A398555 (Python)
%o A398555 from math import prod
%o A398555 from sympy import factorint
%o A398555 def ok(n):
%o A398555     f = factorint(n)
%o A398555     sigma = prod((p**(e+1)-1)//(p-1) for p, e in f.items())
%o A398555     Omega = sum(f.values())
%o A398555     psi = prod((p+1)*p**(e-1) for p, e in f.items())
%o A398555     return sigma == psi + Omega**9
%o A398555 # _Michael S. Branicky_, Aug 02 2026
%Y A398555 Cf. A244963 (sigma minus psi), A001222 (Omega), A397843, A398159, A398160, A398401, A398467.
