%I A398729 #4 Aug 29 2026 17:20:00
%S A398729 0,-1,-1,1,5,12,24,42,66,97,137,187,247,318,402,500,612,739,883,1045,
%T A398729 1225,1424,1644,1886,2150,2437,2749,3087,3451,3842,4262,4712,5192,
%U A398729 5703,6247,6825,7437,8084,8768,9490,10250,11049,11889,12771,13695,14662,15674
%N A398729 Lower (-1, 1/2) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398729 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398729 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398729 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) =  (0, 3, 16, 45, 95, 172).
%F A398729 G.f.: x^3 *(1 + x)/((-1 + x)^4 (1 + x^2)).
%t A398729 z = 60;
%t A398729 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398729 r =-1; s = 1/2;
%t A398729 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398729 Table[u[n], {n, 0, z}]
%Y A398729 Cf. A000217, A000330, A398730.
%K A398729 easy,sign,new
%O A398729 0,5
%A A398729 _Clark Kimberling_, Aug 27 2026
