%U A398291 446428999302054804,12741849611590567176,365470576668237325920,10527874040850505847226,304420787580511086782004
%N A398291 Diagonal of rational function 1/(1 - (1 + x*y*z)*(x*(1 + x*y*z) + y + z)).
%C A398291 For integers s >= 1, t >= 0 and e_1, ... ,e_s >= 0 with e_1 + ... + e_s = t, [x_1^n*  ... *x_s^n] 1/(1 - Sum_{i=1..s} x_i * (1 + x_1* ... *x_s)^e_i) = Sum_{k=0..n} (s*k)!/k!^s * binomial(t*k,n-k). For s=3, t=4, (e_1,e_2,e_3)=(2,1,1), and (x_1,x_2,x_3)=(x,y,z), this gives a(n) = [x^n*y^n*z^n] 1/(1 - (1 + x*y*z)*(x*(1 + x*y*z) + y + z)).
%F A398291 a(n) = Sum_{k=0..n} (3*k)!/k!^3 * binomial(4*k,n-k).
%o A398291 (PARI) a(n, s=3, t=4) = sum(k=0, n, (s*k)!/k!^s*binomial(t*k, n-k));
%Y A398291 Cf. A099235, A361813, A398295.
%K A398291 nonn,new
