%S A398120 1,1,1,3,0,5,2,3,2,3,1,5,2,1,4,6,2,7,4,3,3,7,4,7,5,4,8,4,5,4,3,3,4,7,
%T A398120 1,9,4,3,5,8,1,6,4,4,5,4,2,5,5,2,7,6,1,10,7,2,7,6,2,9,4,6,4,9,2,8,4,3,
%U A398120 6,7,2,10,3,4,5,6,4,7,5,4,5,11,4,13,3,5
%N A398120 a(n) is the number of distinct cycles of length at least 2 under iteration of x -> s(x^n) on the positive integers, where s is the decimal digit sum.
%C A398120 Cycles are identified up to cyclic rotation. For each n, all cycles of the map are contained in the finite interval {1, ..., 9*n*D(n)}, where D(n) is the largest positive integer D such that 10^(D-1) <= 9*n*D. Thus a(n) is obtained by an exhaustive computation with exact integer arithmetic.
%H A398120 M. A. C. Alcântara and M. V. P. Alcântara, <a href="https://doi.org/10.5281/zenodo.19240836">Dynamics of the Digit Sum of Integer Powers: Cycle Structure and Finite Search</a>, Zenodo, Version 3, 2026.
%H A398120 M. V. P. Alcântara, <a href="https://doi.org/10.5281/zenodo.21348126">Digit-Sum Maps of Polynomial Generators over Arbitrary Bases: Global Descent, Cycle Localization and Arithmetic Basins</a>, Zenodo, 2026.
%F A398120 a(n) = A398119(n) - A046471(n) - 1, for n >= 2.
%F A398120 Every cycle of x -> s(x^n) is contained in {1, ..., 9*n*D(n)}, where D(n) = max{D >= 1: 10^(D-1) <= 9*n*D}.
%e A398120 a(2) = 1 because the cycles are (1), (9), and (13, 16), and only (13, 16) has length at least 2.
%e A398120 a(5) = 3 because the cycles of length at least 2 are (23, 29), (31, 34), and the 4-cycle (7, 22, 25, 40).
%e A398120 a(6) = 0 because all five cycles of x -> s(x^6) are fixed points.
%e A398120 a(7) = 5: the nontrivial cycles are (38, 47), (44, 62), (46, 55), (56, 65), and (36, 54, 63, 72).
%o A398120 (Python)
%o A398120 def s(m):
%o A398120     t = 0
%o A398120     while m:
%o A398120         t += m % 10
%o A398120         m //= 10
%o A398120     return t
%o A398120 def a(n):
%o A398120     D = 1
%o A398120     while 10**(D - 1) <= 9*n*D:
%o A398120         D += 1
%o A398120     D -= 1
%o A398120     B = 9*n*D
%o A398120     cycles = set()
%o A398120     for x0 in range(1, B + 1):
%o A398120         seen = {}
%o A398120         orbit = []
%o A398120         x = x0
%o A398120         while x not in seen:
%o A398120             seen[x] = len(orbit)
%o A398120             orbit.append(x)
%o A398120             x = s(x**n)
%o A398120         c = orbit[seen[x]:]
%o A398120         if len(c) > 1:
%o A398120             i = c.index(min(c))
%o A398120             cycles.add(tuple(c[i:] + c[:i]))
%o A398120     return len(cycles)
%Y A398120 Cf. A007953, A004159, A046471, A056527, A056529, A061905, A152147, A398119 (total number of cycles), A398121 (maximum cycle length).
