%I A398850 #11 Sep 21 2026 00:54:12
%S A398850 0,-1,0,1,2,4,6,9,12,16,20,25,31,36,43,50,57,65,73,82,91,101,111,122,
%T A398850 134,145,158,171,184,198,212,227,242,258,274,291,309,326,345,364,383,
%U A398850 403,423,444,465,487,509,532,556,579,604,629,654,680,706,733,760
%N A398850 Lower (-1/2, 1/3)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398850 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398850 <a href="/index/Rec#order_11">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1,-1,2,-1,1,-2,1).
%F A398850 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5) - a(n-6) + 2*a(n-7) - a(n-8) + a(n-9) - 2*a(n-10) + a(n-11); (a(0), ..., a(10)) = (0, -1, 0, 1, 2, 4, 6, 9, 12, 16, 20).
%t A398850 z = 60;
%t A398850 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398850 r = -1/2; s = 1/3;
%t A398850 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398850 Table[u[n], {n, 0, z}]
%Y A398850 Cf. A000217, A000326, A398851.
%K A398850 easy,sign,new
%O A398850 0,5
%A A398850 _Clark Kimberling_, Sep 18 2026
