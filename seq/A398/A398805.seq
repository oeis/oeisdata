%I A398805 #16 Nov 02 2026 21:19:21
%S A398805 1,3,9,24,66,174,462,1206,3162,8250,21552,56166,146508,381792,995226,
%T A398805 2593506,6759228,17613786,45901572,119614254,311705874,812268264,
%U A398805 2116687542,5515833000,14373631866,37455949062,97605770688
%N A398805 Number of length-n overlap-free ternary words.
%C A398805 A word is overlap-free if it has no block of the form axaxa, where a is a single letter and x is a possibly empty word.
%H A398805 A. M. Shur, <a href="https://doi.org/10.1016/j.cosrev.2012.09.001">Growth properties of power-free languages</a>, Computer Science Review 6 (2012), 187-208.
%F A398805 It is known (see Table A.2 in Shur) that a(n) grows asymptotically like alpha^n, where alpha is approximately 2.605879.
%o A398805 (Python)
%o A398805 from itertools import islice
%o A398805 def iof(w): # incrementally overlap-free
%o A398805     for L in range((len(w)-3)//2+1): # length of x in axaxa
%o A398805         if w[-3-2*L] == w[-2-L] == w[-1] and w[-2-2*L:-2-L] == w[-1-L:-1]:
%o A398805             return False
%o A398805     return True
%o A398805 def agen(): # generator of terms
%o A398805     s = {"0"}
%o A398805     yield 1
%o A398805     while True:
%o A398805         yield 3*len(s)
%o A398805         s = {w+c for w in s for c in "012" if iof(w+c)}
%o A398805 print(list(islice(agen(), 17))) # _Michael S. Branicky_, Aug 09 2026
%K A398805 nonn,more,changed
%O A398805 0,2
%A A398805 _Jeffrey Shallit_, Aug 09 2026
%E A398805 a(17)-a(21) from _Michael S. Branicky_, Aug 09 2026
