%T A398065 1100,1331,1342,1618,1918,2243,2594,2972,2986,3421,3436,3932,4460,
%U A398065 5021,5616,6246,6264,6967,7708,8488,8508,9369,9390,10336,11326,12361,12384,13512,14688,15913,17188,18514,18540,19971,21456,22996
%N A398065 Partial sums of A069268: a(n) = Sum_{k=1..n} gcd(k!, k*(k+1)/2).
%F A398065 a(n) = binomial(n+2,3) - (1/2)*Sum_{odd primes p, 3 <= p <= n+1} (p-1)^2.
%F A398065 a(n) = a(n-1) + A069268(n) for n >= 2, with a(1) = 1.
%e A398065 For n=4, odd primes p with 3 <= p <= 5 are {3,5}; a(4) = binomial(6,3) - (1/2)*((3-1)^2+(5-1)^2) = 20 - (1/2)*(4+16) = 10.
%t A398065 a[n_] := Sum[GCD[k!, k*(k+1)/2], {k, 1, n}]; Array[a, 55] (* _Stefano Spezia_, Sep 28 2026 *)
%o A398065 (Python) from math import gcd, factorial; a = lambda n: sum(gcd(factorial(k), k*(k+1)//2) for k in range(1, n+1))
%o A398065 (Python)
%o A398065 from math import comb
%o A398065 from sympy import primerange
%o A398065 def A398065(n): return comb(n+2,3)-(sum((i-1)**2 for i in primerange(3,n+2))>>1) # _Chai Wah Wu_, Oct 13 2026
%o A398065 (PARI) a(n) = sum(k=1, n, gcd(k!, k*(k+1)/2)); \\ _Michel Marcus_, Oct 04 2026
