%S A398218 2,3,9,7,5,6,6,9,3,4,1,8,0,0,5,5,5,4,6,2,7,3,9,5,8,1,0,5,8,3,0,0,6,5,
%T A398218 8,1,8,0,2,9,3,6,7,7,3,7,0,6,2,4,9,0,6,3,1,5,9,5,6,3,1,4,4,0,7,6,2,7,
%U A398218 3,0,9,3,1,5,5,4,8,6,8,1,6,7,9,2,6,9,7,1,2,8
%N A398218 Decimal expansion of the dihedral angle, in radians, between any two adjacent faces in a canonical (dual-uniform) octagonal trapezohedron.
%C A398218 The octagonal trapezohedron is the dual polyhedron of the octagonal antiprism.
%H A398218 Paolo Xausa, <a href="/A398218/b398218.txt">Table of n, a(n) for n = 1..10000</a>
%H A398218 David I. McCooey, <a href="https://dmccooey.com/polyhedra/OctagonalTrapezohedron.html">Octagonal Trapezohedron</a>.
%H A398218 Polytope Wiki, <a href="https://polytope.miraheze.org/wiki/Octagonal_antitegum">Octagonal antitegum</a>.
%H A398218 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Trapezohedron.html">Trapezohedron</a>.
%F A398218 Equals arccos((5 - 6*r - 2*sqrt(130 + 79*r))/47), where r = sqrt(2) = A002193.
%F A398218 Equals arccos(c), where c = -0.7357... is the smallest root of 47*x^4 - 20*x^3 - 22*x^2 + 12*x - 1.
%e A398218 2.397566934180055546273958105830065818029367737062...
%t A398218 First[RealDigits[ArcCos[(5 - 6*Sqrt[2] - 2*Sqrt[130 + 79*Sqrt[2]])/47], 10, 100]]
%t A398218 (* Alternative: *)
%t A398218 First[RealDigits[First[PolyhedronData[{"Trapezohedron", 8}, "DihedralAngles"]], 10, 100]]
%Y A398218 Cf. A398210 (volume), A398211 (surface area), A398212 (inradius), A398213 (midradius), A398214 (height).
%Y A398218 Cf. A398215 (long edge).
%Y A398218 Cf. A398216 (small face angle), A398217 (large face angle).
%Y A398218 Cf. A387320, A387323 (dihedral angles of the dual).
%Y A398218 Cf. A002193.
%K A398218 nonn,cons,easy,new
%O A398218 1,1
