%I A398731 #14 Nov 09 2026 17:25:04
%S A398731 0,3,1,15,13,17,57,63,103,255,337,365,455,537,637,727,773,799,809,845,
%T A398731 881,935,1017,297,309,369,377,381,639,647,761,921,1001,1023,1073,1111,
%U A398731 1149,1157,1183,1229,1305,1495,1529,1541,1567,1613,1773,1791,1853,1929,2073
%N A398731 Irregular triangle read by rows in which row n gives the congruences (mod 2^floor(1+n*log_2(5))) that have an admissible sequence of order n; related to 5x+1 problem.
%C A398731 Similar to A177789, but for the 5x+1 problem. The length of row n is A174795(n).
%H A398731 V. Barbera, <a href="/A398731/b398731.txt">Table of n, a(n) for n = 0..17184</a> (rows n = 0..9, flattened).
%e A398731 Triangle begins:
%e A398731    0;
%e A398731    3;
%e A398731    1, 15;
%e A398731    13, 17, 57, 63, 103;
%e A398731    255, 337, 365, 455, 537, 637, 727, 773, 799, 809, 845, 881, 935, 1017;
%e A398731    ...
%o A398731 (PARI) row(n, q=5) = {if(n<1, [0], my(r=[1], d=floor(log(q)/log(2)), km=d+1); for(m=1, n-1, my(s=[], c=if(q^(m+1)<2^(km+d), d, d+1)); for(i=1, #r, my(dm=km, t=r[i], e); for(j=1, m-1, t-=q^(m-j); e=valuation(t,2); t/=2^e; dm-=e); s=concat(s, vector(dm-1, j, q*r[i]+2^(km-dm+j)))); km=km+c; r=s); vecsort(apply(x->((-x)*lift(Mod(1/q^n, 2^km)))%2^km, r)));}
%Y A398731 Cf. A174795, A177789.
%K A398731 nonn,tabf,new
%O A398731 0,2
%A A398731 _V. Barbera_, Nov 02 2026
