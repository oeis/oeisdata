%T A398207 880486650426913306,29646326148294144144284,
%U A398207 3508136402017653657723926734,1484357979543202722364592922419542,2274999558614488182213943463035941286432,12756884190336017667888956095321763408834505910
%N A398207 Number of digraphs on n unlabeled nodes with distinguished nodes r and t (r = t if n = 1, else r != t) such that every node is reachable from r and t is reachable from every node, counted up to isomorphism fixing r and t.
%C A398207 Single-entry single-exit control-flow graphs up to isomorphism preserving entry and exit; self-loops disallowed.
%C A398207 The acyclic analog is A345258; the version with unpointed global source and sink is A350794.
%D A398207 R. W. Robinson, Counting digraphs with restrictions on the strong components, in T.-H. Ku (ed.), Combinatorics and Graph Theory '95, World Scientific, Singapore, 1995, pp. 343-354.
%F A398207 DPt(S) - Pt(S)^2 + Euler(S)*(Pt(S)exp(-S) X Pt(S)exp(-S) X D) in Robinson's cycle-index algebra: his Eqn 20 (the initially-finally connected identity of A049531) with each endpoint factor S replaced by its vertex-pointed version (Pt = one marked fixed point, DPt = ordered pair of distinct marked fixed points); a(1) = 1 separately.
%o A398207 (PARI) \\ Uses the library in the PARI link of A350794.
%o A398207 Point2CIData(S)={vector(#S, i, my(v=S[i], xi=0); forpart(p=i-1, xi++; my(k=#select(t->t==1, Vec(p))); v[xi]*=k*(k-1)); v)}
%o A398207 PointedInitFinally(graphs, a1, yf=e->2)={my(E=InvGgfCIData(graphs, yf), S=-LogCIData(E), Pt=PointCIData(S), PtE=MulCIData(Pt, E), big=MulGgfCIData(graphs, MulGgfCIData(PtE, PtE, yf), yf)); a1*x + UnlabeledOgf(Point2CIData(S)) - UnlabeledOgf(Pt)^2 + EulerMTS(UnlabeledOgf(S))*UnlabeledOgf(big)}
%o A398207 A398207seq(n)={Vec(PointedInitFinally(GraphCIData(n, DigraphEdges), 1))}
%o A398207 A398207seq(14)
%Y A398207 Cf. A350794, A345258, A165950, A049531.
%K A398207 nonn
%O A398207 1,2
%A A398207 _Gregory Morse_, Jul 23 2026
