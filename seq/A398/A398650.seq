%I A398650 #18 Aug 12 2026 22:45:26
%S A398650 0,2,18,151,1778,23785,412584,7948643,184938622,5411327781,
%T A398650 168882517640,6286462345999,259001856384798,11184535471062017,
%U A398650 527747972150347396,28068908820845468715,1661097596462417183054,101597486061753202791253,6824265828185707250439072
%N A398650 Number of composite numbers less than the n-th primorial that have a common factor greater than 1 with the (n-1)-th primorial.
%F A398650 a(n) = A065898(n) - A398562(n).
%F A398650 a(n) = A002110(n) - A005867(n) - A005867(n-1) - n + 1.
%F A398650 a(n) = A053144(n-1) * A000040(n) - n + 1 for n>1.
%o A398650 (PARI) list(n) = {my(ans=List(), A002110=2, A005867=1, temp=0, i=0); if(n>1, while(i < n-1, i++; listput(ans,temp); A002110*=prime(i+1); temp=A005867; A005867*=(prime(i+1)-1); temp=A002110-A005867-temp-i)); listput(ans,temp); ans;}
%o A398650 (PARI) a(n) = {if(n < 2, 0, my(g=vecprod(primes(n-1))); sum(k=2, g*prime(n), !isprime(k)&&gcd(k, g)!=1))}
%Y A398650 Cf. A000040, A000849, A002110, A005867, A053144, A065898, A066264, A072236, A398562.
%K A398650 nonn
%O A398650 1,2
%A A398650 _V. Barbera_, Aug 05 2026
