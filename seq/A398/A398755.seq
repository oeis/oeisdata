%S A398755 0,6,5,4,3,2,1,10,11,9,10,8,9,7,8,9,9,7,8,8,6,7,7,6,19,6,6,5,18,5,5,
%T A398755 17,47,17,4,4,16,46,16,14,18,3,15,45,15,13,17,14,2,14,44,14,12,16,13,
%U A398755 11,59,13,43,13,11,15,12,11,27,58,12,42,12,10,14,42,10,10
%N A398755 Number of steps to reach 1 starting from n when the function f(x) = x/7 if 7 divides x, and x+ceiling(x/7) otherwise is iterated, or -1 if 1 is never reached.
%C A398755 Here we set k=7. As 7 is not a term in A368136, the iteration used here has no loops for starting values up to 7*7=49, apart from the loop containing 1. [Edited by _Jianing Song_, Sep 11 2026]
%C A398755 It is not known if there exists n such that a(n) = -1 (either by iteration reaching a non-elementary loop which implies n>7*7, or by iteration growing without bound).
%H A398755 Giuseppe Ciacco, <a href="/A398755/b398755.txt">Table of n, a(n) for n = 1..10000</a>
%H A398755 Walter Carnielli, <a href="https://www.math.nthu.edu.tw/~amen/2015/AMEN(150711).pdf">Some natural generalizations of the Collatz Problem</a>, Applied Mathematics E-Notes 15 (2015): 207-215.
%e A398755 For n = 11, the following trajectory is obtained: 11, 13, 15, 18, 21, 3, 4, 5, 6, 7, 1 which requires 10 steps to reach 1, therefore a(11) = 10.
%t A398755 A398755[n_] := Length[NestWhileList[If[Divisible[#, 7], #/7, # + Quotient[#, 7] + 1] &, n, # > 1 &]] - 1;
%t A398755 Array[A398755, 100] (* _Paolo Xausa_, Sep 18 2026 *)
%o A398755 (Python)
%o A398755 def a(n, C = 7):
%o A398755     s = 0
%o A398755     while n > 1:
%o A398755         d, r = divmod(n, C)
%o A398755         n = n + 1 + d if r else d
%o A398755         s += 1
%o A398755     return s
%o A398755 print([a(n) for n in range(1, 75)])
%Y A398755 Cf. A006666, A368136, A370350 (for k=5).
%K A398755 nonn,easy,look,new
%O A398755 1,2
%A A398755 _Giuseppe Ciacco_, Sep 08 2026
