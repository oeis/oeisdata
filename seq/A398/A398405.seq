%I A398405 #16 Sep 28 2026 00:02:49
%S A398405 1,1,4,44,587,28176,626483,88436715,3738967365,764019558023,
%T A398405 79263215919540,99095500272972108,9505024329648246447
%N A398405 Number of maximal chains in the subgroup lattice of S_n.
%C A398405 A maximal chain is a chain e = H_0 < H_1 < ... < H_r = S_n such that H_{i-1} is a maximal subgroup of H_i for every i.
%H A398405 L. Naughton and G. Pfeiffer, <a href="https://cs.uwaterloo.ca/journals/JIS/VOL16/Naughton/naughton2.html">Integer Sequences Realized by the Subgroup Pattern of the Symmetric Group</a>
%H A398405 M. Tarnauceanu, <a href="https://www.oldcitypublishing.com/journals/mvlsc-home/mvlsc-issue-contents/mvlsc-volume-21-number-1-2-2013/mvlsc-21-1-2-p-201-213/">On the Number of Fuzzy Subgroups of Finite Symmetric Groups</a>
%o A398405 (GAP)
%o A398405 if LoadPackage("tomlib") = fail then
%o A398405     Error("TomLib is required.");
%o A398405 fi;
%o A398405 MaxChainsTom := function(tom)
%o A398405     local ord, memo, f, top;
%o A398405     ord := OrdersTom(tom);
%o A398405     memo := List([1..Length(ord)], i -> fail);
%o A398405     f := function(i)
%o A398405         local z, pos, mult, j, s;
%o A398405         if memo[i] <> fail then
%o A398405             return memo[i];
%o A398405         fi;
%o A398405         if ord[i] = 1 then
%o A398405             memo[i] := 1;
%o A398405             return 1;
%o A398405         fi;
%o A398405         z := MaximalSubgroupsTom(tom, i);
%o A398405         pos := z[1];
%o A398405         mult := z[2];
%o A398405         s := 0;
%o A398405         for j in [1..Length(pos)] do
%o A398405             s := s + mult[j] * f(pos[j]);
%o A398405         od;
%o A398405         memo[i] := s;
%o A398405         return s;
%o A398405     end;
%o A398405     top := Position(ord, Maximum(ord));
%o A398405     return f(top);
%o A398405 end;
%o A398405 Print("1\n1\n4\n");
%o A398405 for n in [4..13] do
%o A398405     tom := TableOfMarks(Concatenation("S", String(n)));
%o A398405     Print(MaxChainsTom(tom), "\n");
%o A398405 od;
%Y A398405 Cf. A066115, A218923, A218927, A290138.
%K A398405 nonn,more,new
%O A398405 1,3
%A A398405 _Vladeta Jovovic_, Sep 27 2026
