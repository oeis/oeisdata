%I A398656 #4 Aug 16 2026 16:28:23
%S A398656 0,2,7,16,30,52,82,122,172,235,312,404,512,637,782,947,1134,1343,1577,
%T A398656 1837,2124,2439,2783,3159,3567,4009,4485,4998,5549,6139,6769,7440,
%U A398656 8155,8914,9719,10570,11470,12420,13421,14474,15580,16742,17960,19236,20570
%N A398656 Upper (1, 2/3) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398656 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398656 <a href="/index/Rec#order_10">Index entries for linear recurrences with constant coefficients</a>, signature (4,-6,3,3,-6,3,3,-6,4,-1).
%F A398656 a(n) = 4*a(n-1) - 6*a(n-2) + 3*a(n-3) + 3*a(n-4) - 6*a(n-5) + 3*a(n-6) + 3*a(n-7) - 6*a(n-8) + 4*a(n-9) - a(n-10) , with (a(0), ..., a(9)) =  (0, 2, 7, 16, 30, 52, 82, 122, 172, 235).
%t A398656 z = 60;
%t A398656 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398656 r = 1; s = 2/3;
%t A398656 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398656 Table[v[n], {n, 0, z}]
%Y A398656 Cf. A000217, A000330, A398655.
%K A398656 nonn,easy
%O A398656 0,2
%A A398656 _Clark Kimberling_, Aug 11 2026
