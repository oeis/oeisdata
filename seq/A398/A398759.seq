%N A398759 a(0) = 1; a(n) = Sum_{k=1..n} binomial(2*n-2,k) * a(n-k).
%F A398759 G.f. A(x) satisfies A(x) = (1-x^2) * (2*A(x/(1+x)^2) - 1).
%o A398759 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(2*i-2, j)*v[i-j+1])); v;
