%U A398133 -1,0,665,31,-1,-4,-1,0,-1,4,-1,-1,5,11,71,1,4,4,1,1,-4,4,-1,5,0
%N A398133 The binomial matrix of the Bernoulli numbers, square array read by ascending antidiagonals, the numerators.
%C A398133 See the comments and links in A399000.
%H A398133 Peter Luschny, <a href="https://github.com/PeterLuschny/Gists/blob/main/GnomonicExpansionAndBinomialMatrices.ipynb">Gnomonic Expansion and Binomial Matrices</a>, a Python notebook.
%F A398133 A(n, n) = numerator(B(n)), B(n) the Bernoulli numbers where B(n) = B(n, 1).
%F A398133 R(n, k) = Sum_{m=0..d} binomial(d, m) * s^(d - m) * B(p + m), where d = abs(n - k), p = min(n, k), s = 1 if k <= n, otherwise -1.
%F A398133 A(n, k) = numerator(R(n, k)).
%e A398133 Matrix of rational values starts:
%e A398133        1,  -1/2,    1/6,      0,  -1/30,     0,   1/42,      0, ...
%e A398133      3/2,   1/2,   -1/3,    1/6,  -1/30, -1/30,   1/42,   1/42, ...
%e A398133     13/6,   2/3,    1/6,   -1/6,   2/15, -1/15, -1/105,   1/21, ...
%e A398133        3,   5/6,    1/6,      0,  -1/30,  1/15, -8/105,  4/105, ...
%e A398133   119/30, 29/30,   2/15,  -1/30,  -1/30,  1/30, -1/105, -4/105, ...
%e A398133        5, 31/30,   1/15,  -1/15,  -1/30,     0,   1/42,  -1/21, ...
%e A398133   253/42, 43/42, -1/105, -8/105, -1/105,  1/42,   1/42,  -1/42, ...
%e A398133        7, 41/42,  -1/21, -4/105,  4/105,  1/21,   1/42,      0, ...
%e A398133   239/30, 29/30, -1/105,  4/105,  8/105, 4/105, -1/105,  -1/30, ...
%e A398133 .
%e A398133 Numerators read by antidiagonals:
%e A398133      1;
%e A398133      3, -1;
%e A398133     13,  1,  1;
%e A398133      3,  2, -1,  0;
%e A398133    119,  5,  1,  1, -1;
%e A398133      5, 29,  1, -1, -1,  0;
%e A398133    253, 31,  2,  0,  2, -1,  1;
%e A398133      7, 43,  1, -1, -1, -1,  1, 0;
%e A398133    239, 41, -1, -1, -1,  1, -1, 1, -1;
%p A398133 # Numerators of the matrix. Uses the function 'binomial_matrix' from A399000.
%p A398133 BM := binomial_matrix(n -> bernoulli(n, 1)):
%p A398133 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A398133 seq(seq(numer(BM(n-k, k)), k = 0..n), n = 0..11);
%t A398133 (* Uses the function 'binomialMatrix' from A399000. *)
%t A398133 bM = binomialMatrix[BernoulliB[#, 1] &];
%t A398133 Table[bM[n, k] // Numerator, {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398133 (Python)  # Uses function 'binomial_matrix' from A399000.
%o A398133 from sympy import bernoulli
%o A398133 M = binomial_matrix(bernoulli)
%o A398133 for n in range(9): print([M(n, k).numerator for k in range(9)])
