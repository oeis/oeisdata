%I A398728 #4 Aug 27 2026 00:55:01
%S A398728 0,4,17,45,95,173,284,434,630,878,1183,1551,1989,2503,3098,3780,4556,
%T A398728 5432,6413,7505,8715,10049,11512,13110,14850,16738,18779,20979,23345,
%U A398728 25883,28598,31496,34584,37868,41353,45045,48951,53077,57428,62010,66830,71894
%N A398728 Upper (1/2, 3) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398728 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t).
%H A398728 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398728 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) =  (0, 4, 17, 45, 95, 173).
%F A398728 G.f.: x*(4 + x + 5*x^2 + 2*x^3)/((-1 + x)^4 *(1 + x^2)). See A398651 for a guide to related sequences.
%t A398728 z = 60;
%t A398728 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398728 r = 1/2; s = 3;
%t A398728 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398728 Table[v[n], {n, 0, z}]
%Y A398728 Cf. A000217, A000330, A398727.
%K A398728 nonn,easy,new
%O A398728 0,2
%A A398728 _Clark Kimberling_, Aug 25 2026
