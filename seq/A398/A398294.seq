%U A398294 1195966930570261680806208,272473320688827331192698264,62706211062171870422700049824,14555904087797091025874820952848
%N A398294 Diagonal of rational function 1/(1 - (1 + x*y*z*w)*(x + y + z) - w).
%C A398294 For integers s >= 1, t >= 0 and e_1, ... ,e_s >= 0 with e_1 + ... + e_s = t, [x_1^n*  ... *x_s^n] 1/(1 - Sum_{i=1..s} x_i * (1 + x_1* ... *x_s)^e_i) = Sum_{k=0..n} (s*k)!/k!^s * binomial(t*k,n-k). For s=4, t=3, (e_1,e_2,e_3,e_4)=(1,1,1,0), and (x_1,x_2,x_3,x_4)=(x,y,z,w), this gives a(n) = [x^n*y^n*z^n*w^n] 1/(1 - (1 + x*y*z*w)*(x + y + z) - w).
%F A398294 a(n) = Sum_{k=0..n} (4*k)!/k!^4 * binomial(3*k,n-k).
%o A398294 (PARI) a(n, s=4, t=3) = sum(k=0, n, (s*k)!/k!^s*binomial(t*k, n-k));
%Y A398294 Cf. A099234, A361728, A361812.
%K A398294 nonn
