%I A398192 #11 Aug 04 2026 15:01:46
%S A398192 1,2,1,10,6,2,78,51,24,6,824,568,312,120,24,10970,7845,4720,2220,720,
%T A398192 120,176112,129456,82800,43920,18000,5040,720,3309110,2485567,1662024,
%U A398192 956130,451920,163800,40320,5040,71219584,54442368,37665152,22985088,11975040,5093760,1653120,362880,40320
%N A398192 Triangle read by rows: T(n, k) = n! * Sum_{j=0..n-k} n^j / j!.
%H A398192 Peter Luschny, <a href="/A398192/b398192.txt">Rows n = 0..140, flattened</a>.
%F A398192 T(n, k) = Sum_{j=k..n} A398136(n, j).
%F A398192 T(n, k) * (n - k)! / n! = A398484(n, k) * n^(n - k).
%F A398192 T(n, k) = n! [z^n] T(z)^k / (1 - T(z))^2, where T(z) = -W(-z) is the tree function and W Lambert's function. (EGF)
%e A398192 Triangle starts:
%e A398192   [0]        1;
%e A398192   [1]        2,       1;
%e A398192   [2]       10,       6,       2;
%e A398192   [3]       78,      51,      24,      6;
%e A398192   [4]      824,     568,     312,    120,     24;
%e A398192   [5]    10970,    7845,    4720,   2220,    720,    120;
%e A398192   [6]   176112,  129456,   82800,  43920,  18000,   5040,   720;
%e A398192   [7]  3309110, 2485567, 1662024, 956130, 451920, 163800, 40320, 5040;
%p A398192 T := (n, k) -> n! * add(n^j / j!, j = 0..n-k);
%p A398192 seq(seq(T(n, k), k = 0..n), n = 0..8);
%t A398192 treeT[z_] := -ProductLog[-z]; V[0, 0]= 1;
%t A398192 T[n_, k_] := n! SeriesCoefficient[treeT[z]^k / (1 - treeT[z])^2, {z, 0, n}]
%t A398192 Table[Table[T[n, k], {k, 0, n}], {n, 0, 7}] // TableForm
%o A398192 (Python)
%o A398192 from math import factorial
%o A398192 def T(n, k):
%o A398192     s = t = factorial(n)
%o A398192     for d in range(1, n - k + 1):
%o A398192         t = (t * n) // d
%o A398192         s += t
%o A398192     return s
%o A398192 Ttable = [[T(n, k) for k in range(n + 1)] for n in range(10)]
%o A398192 for row in Ttable: print(row)
%Y A398192 Cf. A063170 (column 0), A089901 (row sums), A398136, A398484.
%K A398192 nonn,tabl,new
%O A398192 0,2
%A A398192 _Peter Luschny_, Aug 03 2026
