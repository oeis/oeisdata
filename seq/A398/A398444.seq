%I A398444 #10 Aug 06 2026 06:38:13
%S A398444 36,100,180,196,225,252,396,441,468,484,612,676,684,700,828,1044,1089,
%T A398444 1100,1116,1156,1225,1260,1300,1332,1444,1476,1521,1548,1575,1692,
%U A398444 1700,1900,1908,1980,2116,2124,2156,2196,2300,2340,2412,2475,2548,2556,2601,2628,2772
%N A398444 Numbers k of the form lpf(k) * slpf(k) * rad(k), where rad = A007947, lpf is the least prime factor, and slpf the second smallest distinct prime factor of k.
%C A398444 Superset of A085986 (squares of squarefree semiprimes).
%C A398444 Terms have at least 2 distinct prime factors, therefore, rad(a(n)) is in A120944.
%C A398444 Unsorted prime signature of a(n) is {2,2}, followed by omega(a(n))-2 ones, where omega = A001221 is the number of distinct prime factors.
%C A398444 Smallest term with m distinct prime factors, with m >= 2, is 6*A002110(m).
%H A398444 Michael De Vlieger, <a href="/A398444/b398444.txt">Table of n, a(n) for n = 1..10000</a>
%e A398444 Table of n, a(n) for select n:
%e A398444    n    a(n)
%e A398444   ------------------------------
%e A398444    1     36 = 2^2 * 3^2
%e A398444    2    100 = 2^2 * 5^2
%e A398444    3    180 = 2^2 * 3^2 * 5
%e A398444    4    196 = 2^2 * 7^2
%e A398444    5    225 = 3^2 * 5^2
%e A398444    6    252 = 2^2 * 3^2 * 7
%e A398444    7    396 = 2^2 * 3^2 * 11
%e A398444    8    441 = 3^2 * 7^2
%e A398444    9    468 = 2^2 * 3^2 * 13
%e A398444   10    484 = 2^2 * 11^2
%e A398444   11    612 = 2^2 * 3^2 * 17
%e A398444   22   1260 = 2^2 * 3^2 * 5 * 7
%t A398444 nn = 2800; k = 2*3; mm = nn/k; Union@ Map[If[# <= nn, #, Nothing] &[#*Times @@ FactorInteger[#][[1 ;; 2, 1]] ] &, Select[Range[mm], And[SquareFreeQ[#], CompositeQ[#] ] &] ]
%o A398444 (Python)
%o A398444 from math import prod
%o A398444 from sympy import factorint
%o A398444 def ok(k):
%o A398444     f = factorint(k)
%o A398444     lpf = min(f, default=0)
%o A398444     slpf = min(set(f)-{lpf}, default=0)
%o A398444     return slpf and k == lpf * slpf * prod(f)
%o A398444 print([k for k in range(2800) if ok(k)]) # _Michael S. Branicky_, Aug 02 2026
%Y A398444 Cf. A005117, A006881, A007947, A020639, A085986, A119288, A120944, A332785.
%K A398444 nonn,easy,new
%O A398444 1,1
%A A398444 _Michael De Vlieger_, Jul 31 2026
