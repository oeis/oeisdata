%I A398933 #29 Aug 26 2026 14:29:12
%S A398933 2,4,9,14,21,29,39,49,62,75,90,106,124,142,163,184,207,231,257,283,
%T A398933 312,341,372,404,438,472,509,546,585,625,667,709,754,799,846,894,944,
%U A398933 994,1047,1100,1155,1211,1269,1327,1388,1449,1512,1576,1642,1708,1777,1846,1917,1989
%N A398933 Partial sums of A398929.
%H A398933 Paolo Xausa, <a href="/A398933/b398933.txt">Table of n, a(n) for n = 1..10000</a>
%F A398933 a(n) = n*(n+1)/2 + (3*q^2 - q)/2 + q*r + (2*n+1 - (-1)^n)/4, where q = floor(n/3) and r = n - 3*q.
%e A398933 a(3) = A398929(1) + A398929(2) + A398929(3) = 2 + 2 + 5 = 9.
%t A398933 A398929[n_] := n + Quotient[n, 3] + Mod[n, 2];
%t A398933 Accumulate[Array[A398929, 100]] (* _Paolo Xausa_, Aug 25 2026 *)
%o A398933 (Python)
%o A398933 def a(n):
%o A398933     q, r = divmod(n, 3)
%o A398933     return n*(n+1)//2 + (3*q*q - q)//2 + q*r + (2*n + 1 - (-1)**n)//4
%o A398933 print([a(n) for n in range(1, 101)])
