%U A398873 1298062765839094651309,263505730418082766656323,122529974105070232494098828,4043486597118708405665944097,2405873910765591631772795554547
%N A398873 a(n) = numerator(1 + 2*(4^n - 1)*zeta(2*n)/Pi^(2*n)).
%C A398873 For n > 0, the denominators are given by A036279.
%C A398873 (a(4*k)/A036279(4*k))*((4*k - 1)!/2^(4*k))*binomial(n,4*k) is the maximum number of directed cycles of length 4*k in an n-vertex tournament (see Fang and Huang on page 3).
%H A398873 Yijia Fang and Hao Huang, <a href="https://arxiv.org/abs/2608.06238">Maximizing directed cycles in tournaments</a>, arXiv:2608.06238 [math.CO], 2026.
%F A398873 a(n) = numerator(1 + 2*Sum_{k>0} (2/((2*k - 1)*Pi))^(2*n)).
%F A398873 Limit_{n->1} a(n)/A036279(n) = 1.
%t A398873 a[n_]:=Numerator[1+2*(4^n-1)*Zeta[2*n]/Pi^(2*n)]; Array[a,19,0]
%Y A398873 Cf. A000302, A001025, A002432, A024036, A036279, A046988.
