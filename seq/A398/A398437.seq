%S A398437 3,3,3,3,3,3,3,3,8,3,7,11,3,7,11,7,3,6,15,9,3,5,17,25,3,6,7,8,19,3,19,
%T A398437 9,13,5,22,19,11,3,7,12,16,3,13,16,3,7,5,7,6,23,19,28,17,34,33,15,11,
%U A398437 14,4,11,11,17,27,3,17,24,27,3,28,15,4,35,21,29,15
%N A398437 Least value of x+y for 0<x<y such that (x^p+y^p)/(x+y) is prime, where p=prime(n), n>1; -1, if no such pair exists.
%H A398437 Robert Israel, <a href="/A398437/b398437.txt">Table of n, a(n) for n = 2..478</a>
%H A398437 Jean-Marc Rebert, <a href="/A398437/a398437_1.txt">Data file showing a(n), x, and y values through a(100)</a>
%e A398437 a(2) = 1 + 2 = 3, because prime(2) = 3 and (1^3 + 2^3)/(1 + 2) = 3 is prime.
%e A398437 a(10) = 1 + 7 = 8, because prime(10) = 29 and (1^29 + 7^29)/(1 + 7) = 402488219476647465854701 is prime.
%e A398437 And no lesser x + y have this property.
%p A398437 f:= proc(n) local p,x,s,y,v;
%p A398437   p:= ithprime(n);
%p A398437   for s from 3 do
%p A398437     for x from 1 while 2*x < s do
%p A398437       y:= s-x;
%p A398437       v:= (x^p+y^p)/(x+y);
%p A398437       if isprime(v) then return s fi
%p A398437   od od;
%p A398437 end proc:
%p A398437 map(f, [$2..100]); # _Robert Israel_, Nov 17 2026
%Y A398437 Cf. A000040, A000978, A057173.
%K A398437 nonn,changed
%O A398437 2,1
