%p A398989 # Using function 'binomial_matrix' from A399000.
%p A398989 A000262 := n -> add(abs(Stirling1(n, k))*combinat:-bell(k), k = 0..n):
%p A398989 BM := binomial_matrix(A000262): M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A398989 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%t A398989 (* Using function 'binomialMatrix' from A399000. *)
%t A398989 bM = binomialMatrix[#! LaguerreL[#, -1, -1] &];
%t A398989 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398989 (Python)  # Using function binomial_matrix from A399000.
%o A398989 from mpmath import laguerre, factorial
%o A398989 M = binomial_matrix(lambda n: int(factorial(n)*laguerre(n, -1, -1)))
%o A398989 for n in range(9): print([M(n, k) for k in range(8)])
