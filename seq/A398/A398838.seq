%I A398838 #4 Sep 14 2026 16:02:03
%S A398838 0,2,9,22,39,61,89,121,158,201,248,300,358,420,487,560,637,719,807,
%T A398838 899,996,1099,1206,1318,1436,1558,1685,1818,1955,2097,2245,2397,2554,
%U A398838 2717,2884,3056,3234,3416,3603,3796,3993,4195,4403,4615,4832,5055,5282,55148
%N A398838 Lower (1, 4/3)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398838 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398838 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398838 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 2, 9, 22, 39).
%F A398838 G.f.: x*(-3 - 4*x - 5*x^2 - 3*x^3)/((-1 + x)^3 *(1 + x + x^2)).
%t A398838 z = 60;
%t A398838 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398838 r =1; s = 4/3;
%t A398838 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398838 Table[u[n], {n, 0, z}]
%Y A398838 Cf. A000217, A000326, A398839.
%K A398838 nonn,easy,new
%O A398838 0,2
%A A398838 _Clark Kimberling_, Sep 10 2026
