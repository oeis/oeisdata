%I A398841 #4 Sep 14 2026 16:02:17
%S A398841 0,3,11,24,43,68,98,133,174,221,273,330,393,462,536,615,700,791,887,
%T A398841 988,1095,1208,1326,1449,1578,1713,1853,1998,2149,2306,2468,2635,2808,
%U A398841 2987,3171,3360,3555,3756,3962,4173,4390,4613,4841,5074,5313,5558,5808,6063
%N A398841 Upper (1, 3/2)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398841 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398841 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (3,-4,4,-3,1).
%F A398841 a(n) = 3*a(n-1) - 4*a(n-2) + 4*a(n-3) - 3*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 3, 11, 24, 43).
%F A398841 G.f.: -(x*(3 + 2*x + 3*x^2 + 3*x^3)/((-1 + x)^3 *(1 + x^2))).
%t A398841 z = 60;
%t A398841 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398841 r =1; s = 3/2;
%t A398841 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398841 Table[v[n], {n, 0, z}]
%Y A398841 Cf. A000217, A000326, A398840.
%K A398841 nonn,easy,new
%O A398841 0,2
%A A398841 _Clark Kimberling_, Sep 10 2026
