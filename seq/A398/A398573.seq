%I A398573 #43 Aug 08 2026 22:07:43
%S A398573 1,3,27,95,1395,4893,34223,118071,3239235,11036465,74858421,252840393,
%T A398573 3404549239,11427621345,76524853335,255667065703,13640703194979,
%U A398573 45409004206713,301869622051865,1002018733320885,13287963263702589,44004429260388707,291153812452557273,962307808837601025
%N A398573 Numerators of the coefficients in the expansion of (1 - x - x^2)^(-3/2).
%C A398573 The sequence represents the numerators of the fractional convolution of order 1/2 for the Fibonacci sequence (A000045).
%H A398573 T. M. Brown, D. Dmytryshyn, and A. M. Stokolos, <a href="https://doi.org/10.13140/RG.2.2.14770.77760">Convolutions of linear recurrent sequences and Gegenbauer polynomials</a>, Preprint, 2026.
%F A398573 a(n) = numerator([x^n] (1 - x - x^2)^(-3/2)).
%F A398573 a(n) = 2^A005187(n) * [x^n] (1 - x - x^2)^(-3/2).
%F A398573 a(n) = 2^A005187(n) * Sum_{k=0..floor(n/2)} binomial(n-k, k) * binomial(n-k-1/2, 1/2).
%F A398573 a(n) = 2^A005187(n) * x(n), where x(n) = (2*n + 1) / (2*n) * x(n-1) + (n+1) / n * x(n-2) with x(0) = 1, x(1) = 3/2.
%F A398573 a(n) = 2^A005187(n) * (-I)^n * GegenbauerC(n, 3/2, I/2).
%e A398573 (1 - x - x^2)^(-3/2) = 1 + 3/2*x + 27/8*x^2 + 95/16*x^3 + 1395/128*x^4 + ...
%p A398573 A005187 := proc(n) options operator, arrow: 2*n-add(i, i in convert(n, base, 2)) end proc: N := 25: for n from 0 to N do x_n[n] := (-I)^n*GegenbauerC(n, 3/2, I*(1/2)): a_n[n] := simplify(2^A005187(n)*x_n[n]): end do: seq(a_n[k], k = 0 .. N);
%Y A398573 Cf. A005187, A046161.
%K A398573 nonn,easy,frac,new
%O A398573 0,2
%A A398573 _Dmytro Dmytryshyn_, Aug 03 2026
