%I A398813 #23 Aug 19 2026 16:06:13
%S A398813 1,2,4,12,48,1728,454164480
%N A398813 Smallest number requiring n iterations of the multiplicative partition function A001055 to reach 1.
%C A398813 The multiplicative partition persistence of an integer x is the number of iterations of A001055 required to reach 1. This sequence lists the minimal integer for each persistence level n = 0, 1, 2, ...
%C A398813 The value of A001055(x) depends only on the prime exponents of x. Therefore, all terms are in A025487.
%C A398813 a(7) > 2*10^14 (if it exists). - _Pontus von Brömssen_, Aug 11 2026
%H A398813 Jishnu Babu Ranitha, <a href="/A398813/a398813.txt">A398813_persistence_search.txt</a>
%e A398813 Trajectories of the terms:
%e A398813 a(0) = 1 (0 steps).
%e A398813 a(1) = 2 -> 1 (1 step).
%e A398813 a(2) = 4 -> 2 -> 1 (2 steps).
%e A398813 a(3) = 12 -> 4 -> 2 -> 1 (3 steps).
%e A398813 a(4) = 48 -> 12 -> 4 -> 2 -> 1 (4 steps).
%e A398813 a(5) = 1728 -> 162 -> 12 -> 4 -> 2 -> 1 (5 steps).
%e A398813 a(6) = 454164480 -> 706992 -> 592 -> 12 -> 4 -> 2 -> 1 (6 steps).
%o A398813 (Python)
%o A398813 from sympy import factorint
%o A398813 from sympy.utilities.iterables import multiset_partitions
%o A398813 def mP(n): return sum(1 for _ in multiset_partitions(factorint(n, multiple=True))) if n > 1 else 1
%o A398813 def persistence(n): return 0 if n <= 1 else 1 + persistence(mP(n))
%o A398813 def lista(terms):
%o A398813     recs = {}
%o A398813     for n in range(1, 2000):
%o A398813         p = persistence(n)
%o A398813         if p not in recs: recs[p] = n
%o A398813     return [recs[i] for i in range(terms)]
%o A398813 print(lista(6)) # Computes a(0) through a(5)
%Y A398813 Subsequence of A025487.
%Y A398813 Cf. A001055, A003001, A006050, A330991 (numbers requiring exactly 2 steps).
%K A398813 nonn,hard,more,new
%O A398813 0,2
