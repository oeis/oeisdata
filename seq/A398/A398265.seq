%I A398265 #4 Aug 18 2026 18:04:28
%S A398265 1,6,8,24,42,1,68,6,128,19,1,198,40,7,336,89,14,2,557,156,32,7,1,781,
%T A398265 282,88,23,4,1119,398,159,49,15,2,1623,571,255,109,35,10,2,2311,825,
%U A398265 380,178,76,28,6,1,3321,1213,556,270,136,64,23,6,4809,1807,844,406,205,100,55,25,5
%N A398265 Irregular triangle read by rows: T(n, k) is the number of distinct unordered pairwise sums with repetition of the distinct multinomial coefficient values of order n having at least k representations, 2 <= k <= A398263(n).
%C A398265 Let B(n) be the set of distinct numbers n!/(p_1!*...*p_r!), where (p_1, ..., p_r) ranges over the partitions of n. For an integer s, let r_n(s) = |{(x, y) : x, y in B(n), x <= y and x + y = s}|.
%C A398265 Thus T(n, k) = |{s : r_n(s) >= k}|.
%C A398265 The rows are weakly decreasing, since every sum having at least k + 1 representations also has at least k representations.
%C A398265 Appending a part 1 to every partition of n shows that (n + 1)*B(n) is a subset of B(n + 1). Hence T(n + 1, k) >= T(n, k) whenever 2 <= k <= A398263(n).
%C A398265 The first entry in row n is A398238(n), the row sum is A398233(n), and A398263(n) is the largest k for which T(n, k) > 0.
%C A398265 A sum having r representations contributes 1 to T(n, 2), ..., T(n, r), and therefore contributes r - 1 to the row sum.
%C A398265 The weighted row sum Sum_{k = 2 .. A398263(n)} (k - 1)*T(n, k) equals Sum_s binomial(r_n(s), 2), the number of pairs of distinct unordered representations of the same sum.
%C A398265 For q >= 3, let N(q) = Sum_{p prime, p <= q} p*floor(log(q)/log(p)). The set B(N(q)) contains an arithmetic progression of length q. Its pairwise sums give T(n, k) >= 2*q - 4*k + 3 whenever n >= N(q) and 2 <= k <= ceiling(q/2).
%C A398265 More strongly, for n >= N(q) + q, the set B(n) contains n - N(q) - q + 1 scaled copies of this progression whose internal pair-sum intervals are disjoint. Hence T(n, k) >= (n - N(q) - q + 1)*(2*q - 4*k + 3). See the Huber link for proofs.
%C A398265 A398230 and A398231 give the corresponding collision statistics for trinomial coefficients, A398232 and A398237 are the associated triangles by number of variables, A398233 and A398238 are respectively the row sums and first entries of this triangle, and A398263 gives the maximum representation multiplicity.
%H A398265 Felix Huber, <a href="https://arxiv.org/abs/2608.02667">Large Sidon Subsets and Pair-Sum Multiplicities of Distinct Multinomial Coefficients</a>, arXiv:2608.02667 [math.CO], 2026.
%H A398265 Felix Huber, <a href="/A398265/a398265.txt">Representation multiplicities and the cumulative multiplicity profile for A398263 and A398265</a>.
%F A398265 T(n, k) = |{s : r_n(s) >= k}|, where r_n(s) = |{(x, y) : x, y in B(n), x <= y and x + y = s}|.
%F A398265 T(n, 2) = A398238(n).
%F A398265 Sum_{k = 2 .. A398263(n)} T(n, k) = A398233(n).
%F A398265 A398263(n) = max{k : T(n, k) > 0}.
%F A398265 T(n, k + 1) <= T(n, k) for 2 <= k < A398263(n).
%F A398265 T(n + 1, k) >= T(n, k) for n >= 5 and 2 <= k <= A398263(n).
%F A398265 Sum_{k = 2 .. A398263(n)} (k - 1)*T(n, k) = Sum_s binomial(r_n(s), 2).
%F A398265 T(n, k) >= 2*q - 4*k + 3 whenever n >= N(q), q >= 3, and 2 <= k <= ceiling(q/2), where N(q) = Sum_{p prime, p <= q} p*floor(log(q)/log(p)).
%F A398265 T(n, k) >= (n - N(q) - q + 1)*(2*q - 4*k + 3) whenever n >= N(q) + q, q >= 3, and 2 <= k <= ceiling(q/2).
%e A398265 The irregular triangle begins:
%e A398265   n\k |      2      3      4      5      6      7      8      9     10
%e A398265   ----+----------------------------------------------------------------
%e A398265    5  |      1
%e A398265    6  |      6
%e A398265    7  |      8
%e A398265    8  |     24
%e A398265    9  |     42      1
%e A398265   10  |     68      6
%e A398265   11  |    128     19      1
%e A398265   12  |    198     40      7
%e A398265   13  |    336     89     14      2
%e A398265   14  |    557    156     32      7      1
%e A398265   15  |    781    282     88     23      4
%e A398265   16  |   1119    398    159     49     15      2
%e A398265   17  |   1623    571    255    109     35     10      2
%e A398265   18  |   2311    825    380    178     76     28      6      1
%e A398265   19  |   3321   1213    556    270    136     64     23      6
%e A398265   20  |   4809   1807    844    406    205    100     55     25      5
%e A398265 T(9, 3) = 1, since B(9) = {1, 9, 36, 72, 84, 126, 252, 504, 630, 756, 1260, 1512, 1680, 2520, 3024, 3780, 5040, 7560, 10080, 15120, 22680, 30240, 45360, 60480, 90720, 181440, 362880}, and 1764 is the only pairwise sum of elements of B(9) having at least 3 unordered representations: 1764 = 84 + 1680 = 252 + 1512 = 504 + 1260.
%p A398265 r := proc(n) option remember;
%p A398265     local a, b, c, i, j, k, l, m, q, s, t, u;
%p A398265     t := table();
%p A398265     b := proc(v, p, d)
%p A398265         local i;
%p A398265         if v = 0 then
%p A398265             t[n!/d] := 1;
%p A398265             return
%p A398265         end if;
%p A398265         for i from min(p, v) by -1 to 1 do
%p A398265             b(v - i, i, d*i!)
%p A398265         end do
%p A398265     end proc;
%p A398265     b(n, n, 1);
%p A398265     l := [indices(t, 'nolist')];
%p A398265     m := nops(l);
%p A398265     s := table();
%p A398265     for i to m do
%p A398265         for j from i to m do
%p A398265             u := l[i] + l[j];
%p A398265             if assigned(s[u]) then
%p A398265                 s[u] := s[u] + 1
%p A398265             else
%p A398265                 s[u] := 1
%p A398265             end if
%p A398265         end do
%p A398265     end do;
%p A398265     q := [indices(s, 'nolist')];
%p A398265     a := max(seq(s[q[i]], i = 1 .. nops(q)));
%p A398265     c := Array(1 .. a - 1, 'fill' = 0);
%p A398265     for i to nops(q) do
%p A398265         for k to s[q[i]] - 1 do
%p A398265             c[k] := c[k] + 1
%p A398265         end do
%p A398265     end do;
%p A398265     [seq(c[k], k = 1 .. a - 1)]
%p A398265 end proc:
%p A398265 T := proc(n, k) option remember;
%p A398265     r(n)[k - 1]
%p A398265 end proc:
%p A398265 seq(seq(T(n, k), k = 2 .. nops(r(n)) + 1), n = 5 .. 20);
%Y A398265 Cf. A070289, A210237, A398230, A398231, A398232, A398233, A398237, A398238, A398263, A398429.
%K A398265 nonn,tabf
%O A398265 5,2
