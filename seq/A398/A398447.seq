%I A398447 #35 Aug 09 2026 18:43:57
%S A398447 3,7,15,27,47,71,155,447,703,1407,2111,7279,10087,22559,35655,75007,
%T A398447 206847,381727,1027431,1126015,2252031,8088063,13421671,26716671,
%U A398447 63728127,95592191,217740015,363861375,656055295,1827397567,2788008987,6273020223,12235060455
%N A398447 Least odd integer between 2^n and 2^(n+1)-1 with maximum dropping time under the Collatz map A014682.
%C A398447 The dropping time of n under A014682 is given by A126241.
%C A398447 Only odd integers are considered, since every even integer has the same dropping time as its half.
%H A398447 Kazunobu Hikawa and Kazuo Nakanishi, <a href="https://doi.org/10.13140/RG.2.2.12065.06240">Parity Vector Analysis in the Study of the Collatz Conjecture</a>, ResearchGate preprint, January 2026.
%H A398447 Kazunobu Hikawa, <a href="/A398447/a398447_1.py.txt">Python program</a>.
%e A398447 For n = 1, the interval is [2,4), containing 2 and 3.
%e A398447 Their dropping times are G(2)=1 and G(3)=4.
%e A398447 Hence M(1)=4 and a(1)=3.
%e A398447 For n = 2, the interval is [4,8), containing 4, 5, 6, and 7.
%e A398447 Their dropping times are G(4)=1, G(5)=2, G(6)=1, and G(7)=7.
%e A398447 Hence M(2)=7 and a(2)=7.
%o A398447 (Python)
%o A398447 def step(n):
%o A398447     return n // 2 if n % 2 == 0 else (3*n + 1) // 2
%o A398447 def dropping_time(n):
%o A398447     m = n
%o A398447     g = 0
%o A398447     while m >= n:
%o A398447         m = step(m)
%o A398447         g += 1
%o A398447     return g
%o A398447 def a(n):
%o A398447     lo = 1 << n
%o A398447     hi = 1 << (n + 1)
%o A398447     best_n = None
%o A398447     best_g = -1
%o A398447     for m in range(lo + 1, hi, 2):
%o A398447         g = dropping_time(m)
%o A398447         if g > best_g:
%o A398447             best_g = g
%o A398447             best_n = m
%o A398447     return best_n
%o A398447 print([a(n) for n in range(1, 11)])
%Y A398447 Cf. A014682, A126241, A398473.
%K A398447 nonn,easy,new
%O A398447 1,1
%A A398447 _Kazunobu Hikawa_, Jul 29 2026
