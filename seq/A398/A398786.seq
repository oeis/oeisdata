%I A398786 #43 Oct 02 2026 16:07:58
%S A398786 1,1,1,2,6,9,25,59,194,480,846,1623,5046,9244,42039,143655,245396,
%T A398786 427073,985248,4805090,19234681,47271270,63010185,223465561,928167756
%N A398786 a(n) is the number of times n appears in A091508.
%F A398786 For all m>n!, A091508(m)>n, and A091508(n!)=n, which means a brute-force check would require checking up to the n!-th term of A091508 to account for each index whose term in A091508 is n.
%F A398786 a(n) <= A066843(n) = Product_{k=2..n} A000005(k), where A000005(j) = number of divisors of j. a(n) = A066843(n) only when n=1.
%F A398786 Conjecture: a(n) >= Product_{k=2..n} (A000005(k) - 1).
%e A398786 a(4) = 2 because there are two initial values for the recursive function defined for the sequence A091508 that take four steps to get "boring." In particular, A091508(12) = A091508(24) = 4, and, since 24 = 4! is the last time a number takes four steps, there are no others.
%o A398786 (Python)
%o A398786 from math import gcd
%o A398786 from sympy import divisors
%o A398786 def A398786(n,t=1):
%o A398786     if n == 1: return 1
%o A398786     return (A398786(n-1,t-n) if t > n+1 and gcd(t,n) == 1 else 0) + sum(A398786(n-1,n//d*t) for d in divisors(n,proper=True,generator=True) if gcd(t,d) == 1) # _Pontus von Brömssen_, Oct 02 2026
%Y A398786 Cf. A091508, A394797, A394973.
%K A398786 nonn,more,new
%O A398786 1,4
