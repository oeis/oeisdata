%T A398136 46656,46656,38880,25920,12960,4320,720,823543,823543,705894,504210,
%U A398136 288120,123480,35280,5040,16777216,16777216,14680064,11010048,6881280,3440640,1290240,322560,40320
%N A398136 Triangle read by rows: T(n, k) = n! * n^(n - k) / (n - k)!.
%C A398136 For a combinatorial interpretation, consider [n] = {1,2,...,n}. T(n, k) is the number of functions f: [n] -> [n] whose restriction to a fixed k-element subset (say {1,...,k}) is injective, with no constraint on the mapping of the remaining n - k elements. This also immediately explains the two edge cases: T(n, 0) = n^n (no condition) and T(n, n) = n! (full injectivity -> permutations).
%H A398136 Peter Luschny, <a href="/A398136/b398136.txt"> Rows n = 0..140, flattened</a>.
%F A398136 T(n, k) = (n)_{k} * n^(n - k) where (n)_{k} denotes the falling factorial.
%F A398136 T(n, k) = n! * [z^n] (T(z)^k / (1 - T(z))), where T(z) = -W(-z) is the tree function and W Lambert's function. (E.g.f.)
%F A398136 T(n, k) = [x^k] x^n * exp(n/x) * Gamma(n+1, n/x). (Row-O.g.f.)
%e A398136 Triangle starts:
%e A398136   [0]       1;
%e A398136   [1]       1,      1;
%e A398136   [2]       4,      4,      2;
%e A398136   [3]      27,     27,     18,      6;
%e A398136   [4]     256,    256,    192,     96,     24;
%e A398136   [5]    3125,   3125,   2500,   1500,    600,    120;
%e A398136   [6]   46656,  46656,  38880,  25920,  12960,   4320,   720;
%e A398136   [7]  823543, 823543, 705894, 504210, 288120, 123480, 35280, 5040;
%p A398136 T := (n, k) -> n!*n^(n - k)/(n - k)!: seq(seq(T(n, k), k = 0..n), n = 0..8);
%p A398136 # Alternative:
%p A398136 row_ogf := n -> x^n*exp(n/x)*GAMMA(n+1, n/x):
%p A398136 row := n -> seq(coeff(expand(row_ogf(n)), x, k), k = 0..n):
%t A398136 treeT[z_] := -ProductLog[-z];
%t A398136 T[n_, k_] := n! SeriesCoefficient[treeT[z]^k / (1 - treeT[z]), {z, 0, n}]
%t A398136 Table[Table[T[n, k], {k, 0, n}], {n, 0, 8}] // Flatten
%o A398136 (Python)
%o A398136 from math import factorial
%o A398136 def T(n, k):
%o A398136     r = factorial(n)
%o A398136     for i in range(1, n - k + 1):
%o A398136         r = (r * n) // i
%o A398136     return r
%o A398136 Ttable = [[T(n, k) for k in range(n + 1)] for n in range(8)]
%o A398136 for row in Ttable: print(row)
%Y A398136 Cf. A000312 (column 0), A000142 (main diagonal), A063170 (row sums).
%K A398136 nonn,tabl,new
%O A398136 0,4
