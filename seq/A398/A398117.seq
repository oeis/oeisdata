%I A398117 #24 Nov 04 2026 16:42:35
%S A398117 1,2,1,7,4,1,26,18,6,1,101,80,33,8,1,404,355,170,52,10,1,1645,1576,
%T A398117 846,304,75,12,1,6784,6996,4122,1674,490,102,14,1,28243,31056,19792,
%U A398117 8872,2955,736,133,16,1,118442,137861,94026,45780,16912,4821,1050,168,18,1,499601,611980,443085,231616,93275,29616,7420,1440,207,20,1
%N A398117 Triangle read by rows: T(n,k) = [x^(n-k)] ((1-x^2)^2 - 4*x)^(-(k+1)/2) for 0 <= k <= n.
%H A398117 Dmytro Dmytryshyn, <a href="https://doi.org/10.13140/RG.2.2.32268.68489">A Method of Non-Stationary Recurrence Relations for Computing Convolutions of Higher and Fractional Orders</a>, 2026.
%F A398117 T(n,k) = ((4*n - 2*k - 2)*T(n-1,k) + (2*n - 2)*T(n-2,k) - (n + k - 2)*T(n-4,k)) / (n - k) with T(n,n)=1 and T(n,k)=0 for k > n.
%e A398117 The triangle T(n,k) (with n >= 0, 0 <= k <= n) begins:
%e A398117          k = 0    k = 1    k = 2    k = 3    k = 4    k = 5
%e A398117   n = 0:     1
%e A398117   n = 1:     2,       1
%e A398117   n = 2:     7,       4,       1
%e A398117   n = 3:    26,      18,       6,       1
%e A398117   n = 4:   101,      80,      33,       8,       1
%e A398117   n = 5:   404,     355,     170,      52,      10,       1
%e A398117   ...
%p A398117 G := proc (x, k) options operator, arrow; 1/((1-x^2)^2-4*x)^((1/2)*k+1/2) end proc: T := proc (n, k) local ser: ser := series(G(x, k), x = 0, n+1): coeff(ser, x, n) end proc: for n from 0 to 10 do for k from 0 to n do printf("%d, ", T(n-k, k)) end end;
%Y A398117 Column k=0 is A349713.
%Y A398117 Antidiagonal sums are A104684.
%Y A398117 Main diagonal is A000012.
%K A398117 nonn,tabl,easy,new
%O A398117 0,2
%A A398117 _Dmytro Dmytryshyn_, Oct 25 2026
