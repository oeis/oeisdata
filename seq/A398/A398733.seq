%I A398733 #16 Nov 11 2026 17:07:34
%S A398733 1,1,3,10,33,156,598,2901,14747,68684,316865,1766359,10337063,
%T A398733 57929324,309634115,1668681754,8962200945,48788284513,343717228017,
%U A398733 2197580622680,13903816711767,88163139587825,532195504417876
%N A398733 Number of perfect matchings in the graph on 2n vertices (0..2n-1) with i and j adjacent if and only if |i-j| is a Fibonacci number.
%C A398733 Equivalently, a(n) is the number of ways to partition {0,...,2n-1} into n pairs such that the two elements of each pair differ by a Fibonacci number.
%D A398733 Anshika Srivastava, Fractional Chromatic Numbers and Chromatic Numbers for the Fibonacci Distance Graphs, The Fibonacci Quarterly, 63(2) (2025), 456-468.
%e A398733 a(2) = 3: on vertices 0..3 every difference 1, 2, 3 is a Fibonacci number, so the graph is K_4, which has 3 perfect matchings: {01,23}, {02,13}, {03,12}.
%e A398733 a(3) = 10: on vertices 0..5 the only differences that are not Fibonacci numbers are 4 (pairs 0-4 and 1-5). K_6 has 15 perfect matchings; 3 use pair 0-4, 3 use pair 1-5, and 1 uses both, so a(3) = 15 - 3 - 3 + 1 = 10.
%o A398733 (Python)
%o A398733 def a(n):
%o A398733     N = 2*n
%o A398733     F = [1, 2]
%o A398733     while F[-1] + F[-2] < N: F.append(F[-1] + F[-2])
%o A398733     F = [d for d in F if d < N]
%o A398733     cur = {0: 1}  # bitmask of already-matched vertices at offsets >= current vertex
%o A398733     for i in range(N):
%o A398733         nxt = {}
%o A398733         for s, c in cur.items():
%o A398733             if s & 1:
%o A398733                 nxt[s >> 1] = nxt.get(s >> 1, 0) + c
%o A398733                 continue
%o A398733             for d in F:
%o A398733                 if i + d >= N: break
%o A398733                 if not (s >> d) & 1:
%o A398733                     t = (s | (1 << d)) >> 1
%o A398733                     nxt[t] = nxt.get(t, 0) + c
%o A398733         cur = nxt
%o A398733     return cur.get(0, 0)
%o A398733 print([a(n) for n in range(13)])
%Y A398733 Cf. A000045, A006190.
