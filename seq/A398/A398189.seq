%I A398189 #19 Aug 04 2026 01:11:24
%S A398189 0,1,0,1,0,0,1,0,2,0,3,1,1,0,0,1,0,2,0,1,0,4,3,3,1,1,0,0,1,0,2,0,1,0,
%T A398189 3,0,7,4,4,3,3,1,1,0,0,1,0,2,0,1,0,3,0,1,0,8,7,7,4,4,3,3,1,1,0,0,1,0,
%U A398189 2,0,1,0,3,0,1,0,2,0,10,8,8,7,7,4,4,3,3,1,1,0,0
%N A398189 Table read by rows: T(n, k) = v2(A398187(n, k)) where v2(m) is the 2-adic valuation of m.
%C A398189 If k = 0, then v2(A398187(n, 0)) = 1 if n is odd and otherwise equals n - A000120(n) (see the comments in A063170).
%C A398189 We conjecture that:
%C A398189   T(n, k) =
%C A398189     = v2((n - k)!), if n is even;
%C A398189     = 1, if n is odd and k = 0;
%C A398189     = 0, if n is odd and k is odd;
%C A398189     = v2(k + 2), if n is odd, k is even, and not k == 14 mod 16.
%C A398189 All other cases arise when n is odd, k is even, and k == 14 mod 16. No simple formula is known.
%H A398189 T. Amdeberhan, D. Callan and V. Moll, <a href="https://math.colgate.edu/~integers/n21/n21.Abstract.html">Valuations and combinatorics of truncated exponential sums</a>, Integers 13 (2013), #A21.
%e A398189 Triangle starts:
%e A398189   [ 0]  0;
%e A398189   [ 1]  1, 0;
%e A398189   [ 2]  1, 0, 0;
%e A398189   [ 3]  1, 0, 2, 0;
%e A398189   [ 4]  3, 1, 1, 0, 0;
%e A398189   [ 5]  1, 0, 2, 0, 1, 0;
%e A398189   [ 6]  4, 3, 3, 1, 1, 0, 0;
%e A398189   [ 7]  1, 0, 2, 0, 1, 0, 3, 0;
%e A398189   [ 8]  7, 4, 4, 3, 3, 1, 1, 0, 0;
%e A398189   [ 9]  1, 0, 2, 0, 1, 0, 3, 0, 1, 0;
%e A398189   [10]  8, 7, 7, 4, 4, 3, 3, 1, 1, 0, 0;
%e A398189   [11]  1, 0, 2, 0, 1, 0, 3, 0, 1, 0, 2, 0;
%e A398189   [12] 10, 8, 8, 7, 7, 4, 4, 3, 3, 1, 1, 0, 0;
%p A398189 v2 := n -> padic:-ordp(n, 2):
%p A398189 A := (n, k) -> local j; add(((n-k)! / j!) * n^j, j = 0..n-k):
%p A398189 T := (n, k) -> v2(A(n, k)):
%p A398189 seq(seq(T(n, k), k = 0..n), n = 0..12);
%o A398189 (Python)
%o A398189 A398187_row = Trow  # use function Trow from A398187.
%o A398189 def v2(n: int) -> int: return (~n & (n - 1)).bit_length()
%o A398189 for n in range(13): print([v2(k) for k in A398187_row(n)])
%Y A398189 Cf. A398187, A063170, A000120.
