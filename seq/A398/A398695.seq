%I A398695 #39 Oct 08 2026 09:43:37
%S A398695 1,3,6,8,11,13,16,18,20,23,25,29,31,34,36,39,42,44,47,49,52,54,57,59,
%T A398695 61,64,66,69,71,74,76,78,80,83,85,88,90,93,95,97,101,103,106,108,111,
%U A398695 113,116,118,120,123,125,130,132,135,137,140,142,145,147,149,152,154,158,161,163,166,168
%N A398695 Numbers k >= 2 such that the greedy prime-sum remainder of k is 1.
%C A398695 Let S(m)=A007504(m) be the sum of the first m primes. For an integer n >= 2, greedily subtract the largest S(m) not exceeding the current remainder, starting with R = n, until R < 2. The final remainder is 0 or 1. This sequence lists the integers n with final remainder 1.
%e A398695 For k = 8: the largest sum of the first m primes not exceeding 8 is 5, leaving a remainder of 3. The largest sum not exceeding 3 is 2, leaving a remainder of 1. Since the remainder is 1, k = 8 is a term.
%e A398695 For k = 9: the largest sum not exceeding 9 is 5, remainder 4; largest sum not exceeding 4 is 2, remainder 2; largest sum not exceeding 2 is 2, remainder 0. Since the remainder is 0, k = 9 is not a term.
%p A398695 # greedily subtract largest prime sum from n
%p A398695 A007504rem := proc(n)
%p A398695     local i ;
%p A398695     for i from 0 do
%p A398695         if A007504(i) > n then
%p A398695             return n-A007504(i-1) ;
%p A398695         end if;
%p A398695     end do:
%p A398695 end proc:
%p A398695 # iteratively greedily subtract largest prime sum from n until 0 or 1
%p A398695 A398695rem := proc(n)
%p A398695     local rem;
%p A398695     rem := n ;
%p A398695     while rem >=2 do
%p A398695         rem := A007504rem(rem) ;
%p A398695     end do:
%p A398695     rem ;
%p A398695 end proc:
%p A398695 for n from 1 to 200 do
%p A398695     if A398695rem(n) = 1 then
%p A398695         printf("%d,",n) ;
%p A398695     end if;
%p A398695 end do: # _R. J. Mathar_, Oct 08 2026
%o A398695 (Python)
%o A398695 from sympy import primerange, oo
%o A398695 def generate_terms(num_terms):
%o A398695     gen = primerange(oo)
%o A398695     S = [0]
%o A398695     result = []
%o A398695     current_val = 1
%o A398695     while len(result) < num_terms:
%o A398695         while S[-1] < current_val:
%o A398695             p = next(gen)
%o A398695             S.append(S[-1] + p)
%o A398695         R = current_val
%o A398695         while R >= 2:
%o A398695             k = len(S) - 1
%o A398695             while S[k] > R:
%o A398695                 k -= 1
%o A398695             R -= S[k]
%o A398695         if R == 1:
%o A398695             result.append(current_val)
%o A398695         current_val += 1
%o A398695     return result
%o A398695 print(generate_terms(67))
%Y A398695 Cf. A007504, A014417, A003622.
