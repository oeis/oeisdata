%p A398999 # Using function 'binomial_matrix' from A399000.
%p A398999 BM := binomial_matrix(n -> factorial(n)):
%p A398999 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A398999 seq(seq(BM(n-k, k), k = 0..n), n = 0..9);
%t A398999 (* Uses the function 'binomialMatrix' from A399000. *)
%t A398999 bM = binomialMatrix[Factorial];
%t A398999 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398999 (Python)  # Using function 'binomial_matrix' from A399000.
%o A398999 from math import factorial
%o A398999 M = binomial_matrix(lambda n: factorial(n) )
%o A398999 for n in range(9): print([M(n, k) for k in range(8)])
