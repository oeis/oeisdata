%I A398448 #56 Nov 04 2026 21:00:39
%S A398448 43,168,620,2220,7736,26208,86824,282976,909712,2888832,9076736,
%T A398448 28261568,87298816,267758592,816081792,2473247232,7457388288,
%U A398448 22381914112,66892641280,199153118208,590827808768,1747112239104,5150792665088,15143153491968,44405120585728
%N A398448 Number of largest sets S of points of the 3 X n grid as in A401223 that contain the top and bottom points of some column.
%C A398448 The other sets in A401223 have two columns with two points each, with row pairs {1,2} and {2,3}. There are 4*(n-1)*(3*n+2)*3^(n-5) of them for n >= 4.
%H A398448 Arjun Pemmasani, <a href="/A398448/b398448.txt">Table of n, a(n) for n = 3..1000</a>
%H A398448 Peter Kagey, <a href="https://peterkagey.com/problems/001/">Open Problem Collection, Problem 001</a>.
%H A398448 Arjun Pemmasani, <a href="https://github.com/apemm/Kagey-Problems/blob/main/kagey-problems/problem001/jis/pemmasani.pdf">Maximum Blackouts That Keep Every Lattice Rectangle Identifiable</a>, preprint, 2026.
%H A398448 Arjun Pemmasani, <a href="https://github.com/apemm/Kagey-Problems/tree/main/kagey-problems/problem001">Solvers, exhaustive verification, and pre-registration ledger for Problem 001</a> (GitHub repository).
%H A398448 <a href="/index/Rec#order_12">Index entries for linear recurrences with constant coefficients</a>, signature (6,-12,20,-36,0,0,0,144,160,192,192,64).
%F A398448 G.f.: x^3*(43 - 90*x + 128*x^2 - 344*x^3 + 44*x^4 + 80*x^5 + 328*x^6 + 1728*x^7 + 1888*x^8 + 2208*x^9 + 2016*x^10 + 640*x^11)/((1-2*x-2*x^2)^3*(1+2*x^2)^3).
%F A398448 a(n) = 6*a(n-1) - 12*a(n-2) + 20*a(n-3) - 36*a(n-4) + 144*a(n-8) + 160*a(n-9) + 192*a(n-10) + 192*a(n-11) + 64*a(n-12) for n >= 15.
%F A398448 a(n) = A401223(n) - 4*(n-1)*(3*n+2)*3^(n-5) for n >= 4.
%F A398448 a(n) = p(n)*(1+sqrt(3))^n + p'(n)*(1-sqrt(3))^n + (-2)^floor(n/2)*t(n), where 432*p(n) = (19+11*sqrt(3))*n^2 + (61+41*sqrt(3))*n + 104 + 28*sqrt(3), p' is p with sqrt(3) replaced by -sqrt(3), t(n) = (2*n^2+41*n-104)/216 for even n and t(n) = (7*n^2-32*n-175)/432 for odd n.
%F A398448 a(n) ~ ((19+11*sqrt(3))/432)*n^2*(1+sqrt(3))^n.
%o A398448 (PARI) my(x='x+O('x^30)); Vec(x^3*(43 - 90*x + 128*x^2 - 344*x^3 + 44*x^4 + 80*x^5 + 328*x^6 + 1728*x^7 + 1888*x^8 + 2208*x^9 + 2016*x^10 + 640*x^11)/((1-2*x-2*x^2)^3*(1+2*x^2)^3))
%Y A398448 Cf. A399580, A401223.
%K A398448 nonn,easy,new
%O A398448 3,1
%A A398448 _Arjun Pemmasani_, Oct 30 2026
