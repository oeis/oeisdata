%I A398337 #39 Sep 13 2026 00:02:51
%S A398337 1,2,1,2,1,4,1,2,1,1,1,4,2,1,1,6,1,2,1,1,1,1,1,1,2,2,1,1,1,4,1,2,3,2,
%T A398337 1,4,1,1,1
%N A398337 a(n) is the largest k < n such that gpf(2^(k*n) - 1) = gpf(2^n - 1), for n > 1.
%C A398337 The largest k < n such that A005420(k*n) = A005420(n).
%C A398337 Is it provable that every possible k is less than n?
%C A398337 _Amiram Eldar_ verified that a(221) >= 8, where 221 = 13*17.
%C A398337 Problem: is this sequence unbounded?
%C A398337 Numbers m such that a(m) > 1 are A337431 together with 109, for which apparently a(109) = 3.
%C A398337 It was found that a(109) >= 3.
%H A398337 Thomas Ordowski and Amiram Eldar, <a href="/A398337/a398337.txt">Table of n, a(n), and all possible k < n for n = 1..40</a>.
%e A398337 a(17) = 6 because all possible numbers k < 17 such that gpf(2^(k*17)-1) = gpf(2^17-1) are 1, 2, 3, 4, and 6.
%t A398337 f[n_] := f[n] = FactorInteger[2^n - 1][[-1, 1]];
%t A398337 a[n_] := Module[{p = f[n], k = n - 1}, While[f[k*n] != p, k--]; k]; Array[a, 17, 2] (* _Amiram Eldar_, Sep 01 2026 *)
%Y A398337 Cf. A005420, A066678, A067005, A291855, A337431.
%K A398337 nonn,more,new
%O A398337 2,2
%A A398337 _Thomas Ordowski_, Sep 01 2026
%E A398337 a(18)-a(40) from _Amiram Eldar_, Sep 01 2026
