%S A398635 1,4,16,24,32,72,72,64,160,152,128,280,208,224,488,320,344,576,456,
%T A398635 496,872,608,568,1088,848,752,1384,960,912,1896,1144,1176,2008,1400,
%U A398635 1656,2376,1648,1656,2792,2152,1864,3512,2128,2216
%N A398635 Number of interior lattice points of [0,2n]^2 visible from all four vertices.
%C A398635 The analogous count for a square of odd integer side length is 0.
%F A398635 a(n) = Sum_{1 <= x,y < 2n} [gcd(x*(2n-x), y*(2n-y)) = 1].
%F A398635 a(n) = Sum_{d >= 1} mu(d)*c_{2n}(d)^2, where c_N(d) = #{x: 1 <= x < N and d divides x*(N-x)}.
%e A398635 For n=2, the qualifying points are (1,1), (1,3), (3,1), and (3,3), so a(2)=4.
%t A398635 a[n_] := Sum[Boole[CoprimeQ[x*(2*n-x), y*(2*n-y)]], {x, 1, 2*n-1}, {y, 1, 2*n-1}]
%Y A398635 Cf. A049691 and A300778 (visibility from one corner), and A339400.
%K A398635 nonn,new
%O A398635 1,2
%A A398635 _Alper Ferudun_, Aug 05 2026
