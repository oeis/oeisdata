%I A398804 #25 Sep 01 2026 00:52:51
%S A398804 16,24,50,81,98,120,135,168,176,189,208,264,272,304,312,350,363,368,
%T A398804 408,456,464,496,507,550,552,592,625,650,656,688,696,735,744,752,840,
%U A398804 848,850,867,875,888,944,950,976,984,1032,1072,1078,1083,1128,1136,1150,1168
%N A398804 Numbers k such that A008479(k) = 4.
%C A398804 Numbers k such that exactly 3 other numbers m < k share the squarefree kernel A007947(k) = rad(k). See A397742 for further information about classifying numbers in this way.
%C A398804 Superset of A030514 (fourth powers of primes).
%C A398804 This sequence without A030514 is in A332785 (neither squarefree nor powerful).
%C A398804 In the following partition description, p, q, r are primes with p < q < r when they occur together. Let m = rad(k). Let S be the set of the 3 smaller numbers that share the squarefree kernel, m.
%C A398804 We may partition this sequence into 4 blocks as follows:
%C A398804   A. Numbers k of the form m*p^3 (in A397459),
%C A398804      with S = {m, m*p, m*p^2}.
%C A398804      Includes A030514 (fourth powers of primes).
%C A398804   B. Numbers k of the form m*q,
%C A398804      with S = {m, m*p, m*p^2} (in A398442).
%C A398804   C. Numbers k of the form m*p^2 (in A397458),
%C A398804      with S = {m, m*p, m*q}.
%C A398804   D. Numbers k of the form m*r (in A398864),
%C A398804      with S = {m, m*p, m*q}.
%C A398804 Each squarefree number A005117(j) occurs as m = rad(k) for exactly one term k, specifically for k = A284311(4, j-1). So every squarefree number m corresponds to a set S in exactly one of the blocks.
%C A398804 Smallest term k with j >= 2 distinct prime factors is 3*A002110(j).
%H A398804 Michael De Vlieger, <a href="/A398804/b398804.txt">Table of n, a(n) for n = 1..10000</a>
%F A398804 {a(n)} = {A065642(A397742(j)) : j >= 1} = {A065642^3(A005117(j)) : j > 1}..
%e A398804 Table of n, a(n) for select n:
%e A398804       n   block       a(n)
%e A398804   --------------------------------------------------------
%e A398804       1   A            16   2^4
%e A398804       2   C            24   2^3 * 3
%e A398804       3   B            50   2 * 5^2
%e A398804       4   A            81   3^4
%e A398804       5   B            98   2 * 7^2
%e A398804       6   C           120   2^3 * 3 * 5
%e A398804       7   C           135   3^3 * 5
%e A398804       9   A           176   2^4 * 11
%e A398804      16   B           350   2 * 5^2 * 7
%e A398804      17   B           363   3 * 11^2
%e A398804      32   D           735   3 * 5 * 7^2
%e A398804      35   C           840   2^3 * 3 * 5 * 7
%e A398804     392   C          9240   2^3 * 3 * 5 * 7 * 11
%e A398804    5063   C        120120   2^3 * 3 * 5 * 7 * 11 * 13
%e A398804   86248   C       2042040   2^3 * 3 * 5 * 7 * 11 * 13 * 17
%t A398804 rad[x_] := Times @@ FactorInteger[x][[All, 1]]; Select[Range[1200], Function[{k, r}, Count[Range[k], _?(rad[#] == r &)] == 4] @@ {#, rad[#]} &]
%Y A398804 Cf. A005117, A007947, A008479, A030514, A065642, A332785, A397458, A397459, A398442, A398864.
%Y A398804 Row 4 of A284311 (or A285321), sorted. See A397742 for row 3 and further related xrefs.
