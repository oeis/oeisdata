%U A398268 129242821411,129242880460,376852780460,785262880460,1443011430611,1443011591662,3044579693038,5474579693038,9100487896163
%N A398268 Sum of fifth powers of A069268: a(n) = Sum_{k=1..n} gcd(k!, k*(k+1)/2)^5.
%C A398268 A069268(k) = k*(k+1)/2 unless k+1 is an odd prime p, in which case A069268(k) = (p-1)/2. Hence each odd prime p <= n+1 lowers a(n) below the sum of fifth powers of triangular numbers by ((p-1)/2)^5*(p^5-1).
%F A398268 a(n) = Sum_{k=1..n} (k*(k+1)/2)^5 - Sum_{p odd prime, p <= n+1} ((p-1)/2)^5*(p^5-1).
%F A398268 a(n) = a(n-1) + A069268(n)^5 for n >= 2.
%F A398268 a(n) ~ n^11/352.
%e A398268 a(4) = 1^5 + 1^5 + 6^5 + 2^5 = 7810.
%t A398268 Accumulate[Table[GCD[k!, k*(k+1)/2]^5, {k, 25}]]
%o A398268 (PARI) a(n) = sum(k=1, n, gcd(k!, k*(k+1)/2)^5);
%o A398268 (Python)
%o A398268 from math import gcd, factorial
%o A398268 def a(n): return sum(gcd(factorial(k), k*(k+1)//2)**5 for k in range(1, n+1))
%o A398268 (Python)
%o A398268 from sympy import primerange
%o A398268 def A398268(n): return n*(n**2*(n**2*(n*(n*(n*(n*(n*(63*(n+11))+3080)+6930)+7887)+3465)-462)+616)-96)//693-sum((p-1)**5*(p**5-1) for p in primerange(3,n+2))>>5 # _Chai Wah Wu_, Oct 15 2026
