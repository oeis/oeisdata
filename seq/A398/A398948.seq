%T A398948 15162,15870,16170,17745,18590,19074,19110,20230,22218,22542,23826,
%U A398948 24990,25230,25270,26026,27885,27930,28158,28830,30345,31790,33810,34914,35322,36822,37030,37570
%N A398948 Numbers k of the form q(k) * rad(k), where rad = A007947, and q(k) the fourth smallest distinct prime factor of k.
%C A398948 Terms have at least 4 distinct prime factors.
%C A398948 Superset of A398947.
%C A398948 There exist at least 4 numbers j < a(n) such that rad(j) = rad(a(n)). For a(71) = 65065, these j are {5005, 25025, 35035, 55055}.
%C A398948 Smallest term with j >= 4 distinct prime factors is 7 * A002110(j).
%H A398948 Michael De Vlieger, <a href="/A398948/b398948.txt">Table of n, a(n) for n = 1..10000</a>
%e A398948 Table of n, a(n) for select n:
%e A398948      n       a(n)
%e A398948   ------------------------------------------------
%e A398948      1      1470 = 2 * 3 * 5 * 7^2
%e A398948      2      3630 = 2 * 3 * 5 * 11^2
%e A398948      3      5070 = 2 * 3 * 5 * 13^2
%e A398948      4      5082 = 2 * 3 * 7 * 11^2
%e A398948      5      7098 = 2 * 3 * 7 * 13^2
%e A398948      6      8470 = 2 * 5 * 7 * 11^2
%e A398948      7      8670 = 2 * 3 * 5 * 17^2
%e A398948      9     11154 = 2 * 3 * 11 * 13^2
%e A398948     15     16170 = 2 * 3 * 5 * 7^2 * 11
%e A398948     71     65065 = 5 * 7 * 11 * 13^2
%e A398948    241    210210 = 2 * 3 * 5 * 7^2 * 11 * 13
%e A398948   4470   3573570 = 2 * 3 * 5 * 7^2 * 11 * 13 * 17
%t A398948 nn = 40000; Union@ Map[If[# <= nn, #, Nothing] &[#*FactorInteger[#][[4, 1]] ] &, Select[Select[Range[2, nn], SquareFreeQ], PrimeNu[#] >= 4 &] ]
%Y A398948 Cf. A007947, A350352, A398442, A398947.
