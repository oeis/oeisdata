%o A398547 (Python)
%o A398547 def H(b, c, d):
%o A398547     if not b:
%o A398547         return d + 1
%o A398547     elif not d:
%o A398547         if b == 1:
%o A398547             return c
%o A398547         elif b == 2:
%o A398547             return 0
%o A398547         else:
%o A398547             return 1
%o A398547     else:
%o A398547         return H(b-1, c, H(b, c, d-1))
%o A398547 def generate_sequence(max_shell: int):
%o A398547     n = 0
%o A398547     for s in range(max_shell):
%o A398547         for x in range(s + 1):
%o A398547             for y in range(s - x + 1):
%o A398547                 z = s - x - y
%o A398547                 print(H(x, y, z), end=", ")
%o A398547                 n = n + 1
%o A398547 generate_sequence(max_shell=10)
