%I A398225 #17 Aug 05 2026 00:58:30
%S A398225 96,160,192,224,288,320,352,384,416,448,480,486,544,576,608,640,672,
%T A398225 704,736,768,800,832,864,896,928,960,972,992,1056,1088,1120,1152,1184,
%U A398225 1215,1216,1248,1280,1312,1344,1376,1408,1440,1458,1472,1504,1536,1568,1600,1632
%N A398225 Numbers that are neither 5-free nor 5-full.
%C A398225 Smallest powerful number (in A001694) is a(5) = 288 = 2^5 * 3^2.
%C A398225 Smallest cubefull number (in A036966) is a(23) = 864 = 2^5 * 3^3.
%C A398225 Smallest biquadratefull number (in A036967) is a(81) = 2592 = 2^5 * 3^4.
%H A398225 Michael De Vlieger, <a href="/A398225/b398225.txt">Table of n, a(n) for n = 1..10000</a>
%F A398225 Sum_{n>=1} 1/a(n)^s = 1 + zeta(s) - zeta(s)/zeta(5*s) - Product_{p prime}(1 + 1/(p^(4*s)*(p^s-1))), s > 1. - _Amiram Eldar_, Aug 05 2026
%e A398225 Table of n, a(n) for select n:
%e A398225    n    a(n)
%e A398225   --------------------------
%e A398225    1     96 = 2^5 *  3
%e A398225    2    160 = 2^5 *  5
%e A398225    3    192 = 2^6 *  3
%e A398225    4    224 = 2^5 *  7
%e A398225    5    288 = 2^5 *  3^2
%e A398225    6    320 = 2^6 *  5
%e A398225    7    352 = 2^5 * 11
%e A398225   11    480 = 2^5 *  3   * 5
%e A398225   12    486 = 2   *  3^5
%e A398225   23    864 = 2^5 *  3^3
%e A398225   34   1215 = 3^5 *  5
%e A398225   81   2592 = 2^5 *  3^4
%p A398225 filter:= proc(n) local L,a,b,t; L:= ifactors(n)[2][..,2];
%p A398225    a:= false; b:= false;
%p A398225    for t in L do
%p A398225      if t < 5 then a:= true else b:= true fi;
%p A398225      if a and b then return true fi
%p A398225    od;
%p A398225    false
%p A398225 end proc:
%p A398225 select(filter, [$1..2000]); # _Robert Israel_, Jul 27 2026
%t A398225 Select[Range[1650], And[#1 < 5, #2 > 4] & @@ MinMax@ Union[FactorInteger[#][[All, -1]] ] &]
%o A398225 (PARI) isok(k) = if(k < 2, 0, my(e = factor(k)[,2]); vecmin(e) < 5 && vecmax(e) > 4); \\ _Amiram Eldar_, Jul 27 2026
%o A398225 (Python)
%o A398225 from math import gcd
%o A398225 from sympy import mobius, integer_nthroot
%o A398225 from oeis_sequences.OEISsequences import bisection, is_squarefree
%o A398225 def A398225(n):
%o A398225     def f(x):
%o A398225         c = n-1+sum(mobius(k)*(x//k**5) for k in range(1, integer_nthroot(x,5)[0]+1))
%o A398225         for a9 in range(1,integer_nthroot(x,9)[0]+1):
%o A398225             if is_squarefree(a9):
%o A398225                 for b8 in range(1,integer_nthroot(a8:=x//a9**9,8)[0]+1):
%o A398225                     if gcd(a9,b8)==1 and is_squarefree(b8):
%o A398225                         for b7 in range(1,integer_nthroot(a7:=a8//b8**8,7)[0]+1):
%o A398225                             if gcd(b8,b7)==1 and gcd(a9,b7)==1 and is_squarefree(b7):
%o A398225                                 for b6 in range(1,integer_nthroot(a6:=a7//b7**7,6)[0]+1):
%o A398225                                     if gcd(b7,b6)==1 and gcd(b8,b6)==1 and gcd(a9,b6)==1 and is_squarefree(b6):
%o A398225                                         c += integer_nthroot(a6//b6**6,5)[0]
%o A398225         return c
%o A398225     return bisection(f,n,n) # _Chai Wah Wu_, Aug 03 2026
%Y A398225 Cf. A001694, A036966, A036967, A069492, A332785, A362148, A391115.
%K A398225 nonn,easy
%O A398225 1,1
