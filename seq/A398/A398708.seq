%T A398708 8,3,2,9,5,0,7,4,1,7,0,5,0,6,8,6,5,2,3,3,3,5,1,2,6,7,0,9,4,5,9,1,3,2,
%U A398708 7,1,8,3,9,9,9,4,2,4,2,2,5,1,6,5,6,0,8,0,0,8,3,6,7,8,1,4,5,6,4,8,4,1,9,3,4
%N A398708 Decimal expansion of Sum_{k>=1} lambda(k)/(k*(k+1)), where lambda is the Liouville function (A008836).
%C A398708 This constant appears in the asymptotic formula for A332510.
%H A398708 Wen Guang Zhai, <a href="https://doi.org/10.1007/s10114-024-2129-y">On Some Sums Involving Small Arithmetic Functions</a>, Acta Mathematica Sinica, English Series, Vol. 40 (2024), pp. 2497-2518; <a href="https://arxiv.org/abs/2607.17474">arXiv preprint</a>, arXiv:2607.17474 [math.NT], 2026.
%F A398708 Equals Sum_{k>=1} 1/A002378(A028260(k)) - Sum_{k>=1} 1/A002378(A026424(k)) (the sum of reciprocals of oblong numbers whose indices have an even number of prime factors, counted with multiplicity, minus the corresponding sum for an odd number of prime factors).
%F A398708 Note that the sum of these two sums is 1, and therefore Sum_{k>=1} 1/A002378(A028260(k)) = (1 + c)/2 = 0.6313516884..., and Sum_{k>=1} 1/A002378(A026424(k)) = (1 - c)/2 = 0.3686483115..., where c is this constant.
%F A398708 Equals 1/2 + Sum_{k>=2} (-1)^k * (D(k) - 1), where D(s) = zeta(2*s)/zeta(s) is the Dirichlet g.f. of lambda.
%e A398708 0.262703376808725864539470731148331483295074170506865...
%o A398708 (PARI) suminf(k = 2, (-1)^k * (zeta(2*k)/zeta(k)  - 1)) + 1/2
%Y A398708 Cf. A002378, A008836, A026424, A028260, A332510.
%K A398708 nonn,cons,new
%O A398708 0,1
%A A398708 _Amiram Eldar_, Aug 07 2026
