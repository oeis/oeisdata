%I A398925 #35 Oct 13 2026 14:59:05
%S A398925 875,1197,1700,1988,2775,3185,3650,3875,4235,4473,4556,4557,4828,5252,
%T A398925 5375,5439,5475,5564,5978,6111,6321,6350,6566,7100,7154,7276,7595,
%U A398925 7742,8636,8967,9027,9452,9656,9950,10136,10431,10478,10535,10731,10829,11084,11228,11858
%N A398925 Nonsquarefree m, with 2*m being in the range of reduced totient function (A002322), such that there exists no k such that A046073(k) = m.
%C A398925 Npnsquarefree m that is a term in A396684 but not a term in A400855.
%H A398925 Jianing Song, <a href="/A398925/b398925.txt">Table of n, a(n) for n = 1..1000</a>
%H A398925 Jianing Song, <a href="/A400852/a400852_2.txt">PARI program for A400852</a>.
%e A398925 875 is a term: If the number of squares in (Z/kZ)* is 875, then (Z/kZ)* is of the form either (C_2)^r X C_1750 or (C_2)^r X C_10 X C_350, and both cases are impossible.
%e A398925 1197 is a term: If the number of squares in (Z/kZ)* is 1197, then (Z/kZ)* is of the form either (C_2)^r X C_2394 or (C_2)^r X C_6 X C_798, and both cases are impossible.
%o A398925 (PARI)
%o A398925 v(n) = select(x->A046073(x)==n, divisors(A079612(2*n))); \\ Gives the list of k such that A046073(k) = n; see A046073 and A079612 for their PARI programs. Warning: This is very inefficient since A079612(2*n) can easily have tens of millions of divisors. For squarefree n, it is much more advised to use multgp() given in the link of the PARI program for A400852.
%o A398925 isA398925(n,first_search=10) = {
%o A398925   if(!issquarefree(n) && is(2*n) && #multgp(n)==0, \\ See _Charles R Greathouse IV_'s second program in A002174. Check if the multiplicative groups of squares modulo k can be cyclic of order n, using multgp() in the PARI program for A400852
%o A398925     for(k=1, n*first_search, if(A046073(k)==n, return(0))); \\ do a naive search to see if a small solution is available
%o A398925     return(v(n)==[]),
%o A398925     return(0)
%o A398925   );
%o A398925 };
%Y A398925 Cf. A399566, A400855, A046073, A396684, A002322.
%K A398925 nonn
%O A398925 1,1
%A A398925 _Jianing Song_, Oct 12 2026
