%S A398436 4,9,25,77,323,713,871,2021,2291,3127,3977,4331,4699,5329,6889,11639,
%T A398436 14933,15251,16999,19321,19519,21079,26219,29929,34547,45173,58447,
%U A398436 63169,68021,69133,72463,80543,83371,86519,92747,102821,104813,106529,130901,140141
%N A398436 a(n) is the smallest composite number c greater than all previous terms such that the product of the previous terms plus c is prime.
%C A398436 a(1) = 4 since the empty product is 1 and 1 + 4 = 5 is a prime.
%H A398436 Chai Wah Wu, <a href="/A398436/b398436.txt">Table of n, a(n) for n = 1..179</a>
%e A398436 4 + 9 = 13 (a prime).
%e A398436 4 * 9 + 25 = 61 (a prime).
%e A398436 4 * 9 * 25 * 77 * 323 * 713 + 871 = 15959721571 (a prime).
%e A398436 4 * 9 * 25 * 77 * 323 * 713 * 871 * 2021 + 2291 = 28093752710725991 (a prime).
%p A398436 x := 1: for i from 4 to 150000 do if isprime(i) then next; end if; if isprime(x+i) then x := x*i; printf("%d, ", i); end if; end do;
%t A398436 x = 1; c = {}; For[i = 4, i < 150000, i++, If[PrimeQ[i], Continue[]]; If[PrimeQ[x + i], x *= i; c = Append[c, i]]]; c
%o A398436 (PARI) \\ If it overflows, increase PARI stack to ~ 16 MB with allocatemem()
%o A398436 my(x=1); forcomposite(c=4, 150000, if(isprime(x+c), x*=c;print1(c, ", ")))
%o A398436 (Python)
%o A398436 from itertools import islice
%o A398436 from sympy import nextprime, isprime
%o A398436 def A398436_gen(): # generator of terms
%o A398436     a, c = 4, 4
%o A398436     yield a
%o A398436     while True:
%o A398436         m = nextprime(a+c)
%o A398436         while isprime(m-c):
%o A398436             m = nextprime(m)
%o A398436         yield m-c
%o A398436         a, c = m-c, c*(m-c)
%o A398436 A398436_list = list(islice(A398436_gen(),40)) # _Chai Wah Wu_, Sep 29 2026
