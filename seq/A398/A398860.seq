%I A398860 #5 Sep 24 2026 08:15:12
%S A398860 0,2,9,21,37,57,82,112,146,184,227,275,327,383,444,510,580,654,733,
%T A398860 817,905,997,1094,1196,1302,1412,1527,1647,1771,1899,2032,2170,2312,
%U A398860 2458,2609,2765,2925,3089,3258,3432,3610,3792,3979,4171,4367,4567,4772,4982
%N A398860 Lower (3/2, 1)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398860 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398860 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398860 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 2, 9, 21, 37).
%F A398860 G.f.: -x*(2 + 3*x + 2*x^2 + 2*x^3)/((-1 + x)^3 *(1 + x^2)).
%F A398860 a(n) = floor(n*(9*n+1)/4). 2*a(n) +2*a(n-2) +(-9*n^2+17*n-16)=0. - _R. J. Mathar_, Sep 24 2026
%t A398860 z = 60;
%t A398860 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398860 r =3/2; s = 1;
%t A398860 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398860 Table[u[n], {n, 0, z}]
%Y A398860 Cf. A000217, A000326, A398861.
%K A398860 nonn,easy,new
%O A398860 0,2
%A A398860 _Clark Kimberling_, Sep 23 2026
