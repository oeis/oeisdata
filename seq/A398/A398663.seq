%I A398663 #6 Aug 31 2026 00:01:48
%S A398663 0,2,9,23,45,77,122,182,258,352,467,605,767,955,1172,1420,1700,2014,
%T A398663 2365,2755,3185,3657,4174,4738,5350,6012,6727,7497,8323,9207,10152,
%U A398663 11160,12232,13370,14577,15855,17205,18629,20130,21710,23370,25112,26939,28853
%N A398663 Lower (3/2, 1) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398663 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398663 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398663 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) =  (0, 2, 9, 23, 45, 77).
%F A398663 G.f.: x*(2 + x + x^2)/((-1 + x)^4 *(1 + x^2)).
%t A398663 z = 60;
%t A398663 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398663 r = 3/2; s = 1;
%t A398663 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398663 Table[u[n], {n, 0, z}]
%Y A398663 Cf. A000217, A000330, A398664.
%K A398663 nonn,easy,new
%O A398663 0,2
%A A398663 _Clark Kimberling_, Aug 24 2026
