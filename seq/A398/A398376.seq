%T A398376 6462,10546,13904,22391,29484,47042,61842,97833,128480,201988,264944,
%U A398376 414294,542948,845540,1107184,1718270,2248529,3480402,4551770,7030066,9190028,14170027,18516406,28511482,37245576,57291048
%N A398376 Number of congruence classes of nonsingular n X n matrices over GF(2).
%C A398376 Congruence classes are equivalence classes of (~) where A ~ B iff A = P^T*B*P for some P, and P^T is the transpose of P.
%C A398376 Also the number of similarity classes of nonsingular n X n matrices over GF(2) which are closed under inversion.
%H A398376 R. Gow, <a href="https://doi.org/10.1016/0024-3795(81)90097-5">The number of equivalence classes of nondegenerate bilinear and sesquilinear forms over a finite field</a>, Linear Algebra and its Applications, 41 (1981), 175-181.
%F A398376 G.f.: Product_{k >= 1} (1 + x^k) / (1 - 2*x^(2*k)).
%F A398376 a(n) = f(n, n) where f(k, m) = f(k-1, m) + f(k-1, m-k) + 2*f(k, m-2*k), f(k, m) = 0 for m < 0, f(0, 0) = 1, f(0, m) = 0 for m > 0.
%e A398376 The a(2) = 3 congruence classes have representatives:
%e A398376    [1, 0]   [0, 1]    [1, 1]
%e A398376    [0, 1]   [1, 0]    [0, 1]
%t A398376 nmax=44; CoefficientList[Series[Product[(1 + x^k) / (1 - 2*x^(2*k)),{k,nmax}],{x,0,nmax}],x] (* _Stefano Spezia_, Aug 27 2026 *)
%o A398376 (Haskell)
%o A398376 a n = f n n
%o A398376 f 0 0 = 1
%o A398376 f 0 m = 0
%o A398376 f k m | m < 0 = 0
%o A398376 f k m = f (k - 1) m + f (k - 1) (m - k) + 2 * f k (m - 2*k)
%o A398376 (Python)
%o A398376 def a(n):
%o A398376   p, c = [1] + [0] * n, [0] * (n + 1)
%o A398376   for k in range(1, n + 1):
%o A398376     for m in range(n + 1):
%o A398376       c[m] = p[m]
%o A398376       if m >= k: c[m] += p[m - k]
%o A398376       if m >= 2*k: c[m] += 2*c[m - 2*k]
%o A398376     p, c = c, p
%o A398376   return p[n]
%o A398376 (PARI) seq(n) = my(A=1+O(x*x^n)); Vec(prod(k=1, n, 1 + x^k, A)/prod(k=1, n\2, 1 - 2*x^(2*k), A)) \\ _Andrew Howroyd_, Aug 27 2026
%Y A398376 Cf. A002884.
%K A398376 nonn,new
%O A398376 0,3
