%T A398449 563673017,178476019,13,43787,105167,35148847,1224631103,
%U A398449 6967542873623,5233016291,17,977,95597,101992903,3200139269861,387184211,229455849698923,8461451,19,41737
%N A398449 Triangle read by rows: T(n,k), (1 <= k <= n), equals the largest prime factor of prime(n)^prime(k) + prime(k)^prime(n).
%e A398449 prime(1)^prime(1) + prime(1)^prime(1) = 2^2 + 2^2 = 4 = 2^2. So T(1,1) = A006530(4) = 2.
%e A398449 prime(2)^prime(1) + prime(1)^prime(2) = 3^2 + 2^3 = 17. So T(2,1) = A006530(17) = 17.
%e A398449 prime(2)^prime(2) + prime(2)^prime(2) = 3^3 + 3^3 = 54 = 2 * 3^3. So T(2,2) = A006530(54) = 3.
%e A398449 Table begins:
%e A398449  2;
%e A398449  17, 3;
%e A398449  19, 23, 5;
%e A398449  59, 23, 293, 7;
%e A398449 ...
%o A398449 (PARI) g(p,q)=p^q+q^p
%o A398449 T(n,k)=if(n==k, return(prime(n)));my(p=prime(n),q=prime(k),m=factor(g(p,q)),x=vecmax(m~[1,]));x
%Y A398449 Cf. A006530, A173056, A398544.
