%S A398965 1,10,3,5,2,6,9,4,7,18,15,12,27,24,11,8,19,16,14,29,31,33,30,28,13,34,
%T A398965 17,40,21,23,20,39,36,61,32,55,53,26,47,22,41,43,45,42,69,38,35,37,62,
%U A398965 60,58,89,54,52,25,46,44,71,73,75,72,70,68,66,63,65,67,64,97,95,93,56,59,57,88,86,51
%N A398965 Squares visited by a "Carpenter" (Dabbaba + Knight) moving on a spirally numbered board always to the lowest available unvisited square.
%C A398965 Board is numbered with the square spiral, with initial square labeled 1:
%C A398965 .
%C A398965   17--16--15--14--13
%C A398965    |               |
%C A398965   18   5---4---3  12
%C A398965    |   |       |   |
%C A398965   19   6   1---2  11
%C A398965    |   |           |
%C A398965   20   7---8---9--10
%C A398965    |
%C A398965   21--22--23--24--25--
%C A398965 .
%C A398965 This sequence is finite: At step 253925076, square 259115490 is visited, after which there are no unvisited squares within one move.
%H A398965 Piececlopedia, <a href="https://www.chessvariants.com/piececlopedia.dir/carpentr.html">Carpenter</a>.
%H A398965 Wikipedia, <a href="https://en.wikipedia.org/wiki/List_of_fairy_chess_pieces">List of fairy chess pieces</a>.
%e A398965 At step 3 square 3 is visited after which square 5 is the lowest available unvisited square, so a(4) = 5.
%o A398965 (Python)
%o A398965 def to_n(x, y):
%o A398965     if x == 0 and y == 0:
%o A398965         return 1
%o A398965     m = max(abs(x), abs(y))
%o A398965     inner = (2 * m - 1) ** 2
%o A398965     if x == m and y != -m:
%o A398965         return inner + (m + y)
%o A398965     elif y == m:
%o A398965         return inner + 2 * m + (m - x)
%o A398965     elif x == -m:
%o A398965         return inner + 4 * m + (m - y)
%o A398965     elif y == -m:
%o A398965         return inner + 6 * m + (x + m)
%o A398965     return 1
%o A398965 # Moves: Dabbaba (D) + Knight (N)
%o A398965 moves = [(2,0), (-2,0), (0,-2), (0,2),
%o A398965          (1,2), (2,1), (-1,2), (-2,1), (1,-2), (2,-1), (-1,-2), (-2,-1)]
%o A398965 visited = set([1])
%o A398965 seq = [1]
%o A398965 current_x, current_y = 0, 0
%o A398965 for _ in range(76):
%o A398965     best_n = float('inf')
%o A398965     next_x, next_y = None, None
%o A398965     for dx, dy in moves:
%o A398965         tx, ty = current_x + dx, current_y + dy
%o A398965         tn = to_n(tx, ty)
%o A398965         if tn not in visited and tn < best_n:
%o A398965             best_n, next_x, next_y = tn, tx, ty
%o A398965     if next_x is None: break
%o A398965     visited.add(best_n)
%o A398965     seq.append(best_n)
%o A398965     current_x, current_y = next_x, next_y
%o A398965 print(seq)
%Y A398965 Cf. A316667 (Knight), A396103 (Spider), A398779 (Alfil + Knight), A398717 (Priest), A316884 (Fers), A317467 (Alfil).
