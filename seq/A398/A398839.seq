%I A398839 #4 Sep 14 2026 16:02:07
%S A398839 0,3,10,22,40,62,89,122,159,201,249,301,358,421,488,560,638,720,807,
%T A398839 900,997,1099,1207,1319,1436,1559,1686,1818,1956,2098,2245,2398,2555,
%U A398839 2717,2885,3057,3234,3417,3604,3796,3994,4196,4403,4616,4833,5055,5283,5515
%N A398839 Upper (1, 4/3)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398839 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398839 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398839 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 3, 10, 22, 40).
%F A398839 G.f.: x*(-3 - 4*x - 5*x^2 - 3*x^3)/((-1 + x)^3 *(1 + x + x^2)).
%t A398839 z = 60;
%t A398839 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398839 r =1; s = 4/3;
%t A398839 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398839 Table[v[n], {n, 0, z}]
%Y A398839 Cf. A000217, A000326, A398838.
%K A398839 nonn,easy,new
%O A398839 0,2
%A A398839 _Clark Kimberling_, Sep 10 2026
