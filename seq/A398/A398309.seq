%I A398309 #14 Aug 04 2026 16:42:40
%S A398309 1,0,3,0,6,12,36,96,264,720,1968,5376,14688,40128,109632,299520,
%T A398309 818304,2235648,6107904,16687104,45590016,124554240,340288512,
%U A398309 929685504,2539948032,6939267072,18958430208,51795394560,141507649536,386606088192,1056227475456,2885667127296
%N A398309 Number of indecomposable closed walks of length n on the Petersen graph based at a vertex.
%C A398309 An indecomposable (first-return) closed walk returns to its starting vertex exactly once, on the final step.
%C A398309 a(3) = 0 because the Petersen graph has girth 5.
%C A398309 Petersen-graph analog of A328778.
%H A398309 Vincent Gonzalez, <a href="/A398309/b398309.txt">Table of n, a(n) for n = 0..200</a>
%H A398309 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (2,2).
%F A398309 G.f.: 2 - 1/f(x), where f(x) is the g.f. for A091000 (closed walks on the Petersen graph); f(x) = (1/10)*(1/(1-3*x) + 5/(1-x) + 4/(1+2*x)).
%F A398309 G.f.: (1 - 2*x + x^2 - 6*x^3)/(1 - 2*x - 2*x^2).
%F A398309 a(n) = 2*a(n-1) + 2*a(n-2) for n > 3.
%F A398309 a(n) = A091000(n) - Sum_{k=1..n-1} a(k)*A091000(n-k) for n > 0.
%F A398309 E.g.f.: (exp(x)*(9*cosh(sqrt(3)*x) - 5*sqrt(3)*sinh(sqrt(3)*x)) - 7 + 6*x)/2. - _Stefano Spezia_, Jul 28 2026
%e A398309 a(2) = 3: from a fixed vertex, each of the 3 incident edges gives one length-2 out-and-back walk that first returns at step 2.
%t A398309 nn = 40;
%t A398309 f = (1/10) (1/(1 - 3 x) + 5/(1 - x) + 4/(1 + 2 x));
%t A398309 CoefficientList[Series[2 - 1/f, {x, 0, nn}], x]
%o A398309 (PARI) Vec((1 - 2*x + x^2 - 6*x^3)/(1 - 2*x - 2*x^2) + O(x^32))
%o A398309 (Python)
%o A398309 a=[1,0,3,0]
%o A398309 for n in range(4,32): a.append(2*a[-1]+2*a[-2])
%o A398309 print(a)
%Y A398309 Cf. A091000, A328778, A398262.
%K A398309 nonn,walk,easy
%O A398309 0,3
%A A398309 _Vincent Gonzalez_, Jul 25 2026
