%T A398037 2,3,1,2,2,2,1,2,1,3,3,2,1,4,2,3,2,3,1,2,2,2,2,2,1,2,1,2,3,2,2,2,1,3,
%U A398037 2,2,1,3,1,2,3,3,2,2,1,4,2,2,1,2,2,2,2
%N A398037 Multiplicative partition persistence of n: number of iterations of the multiplicative partition function A001055 required to reach 1.
%C A398037 The value of a(n) depends only on the prime signature of n (A025487).
%F A398037 a(1) = 0; for n > 1, a(n) = 1 + a(A001055(n)).
%e A398037 a(12) = 3 because the trajectory is 12 -> 4 -> 2 -> 1, requiring exactly 3 steps.
%e A398037 a(48) = 4 because the trajectory is 48 -> 12 -> 4 -> 2 -> 1, requiring exactly 4 steps.
%o A398037 (Python)
%o A398037 from sympy import factorint
%o A398037 from sympy.utilities.iterables import multiset_partitions
%o A398037 def mP(n):
%o A398037     if n <= 1: return 1
%o A398037     return sum(1 for _ in multiset_partitions(factorint(n, multiple=True)))
%o A398037 def persistence(n):
%o A398037     if n <= 1: return 0
%o A398037     return 1 + persistence(mP(n))
%o A398037 def lista(limit):
%o A398037     return [persistence(n) for n in range(1, limit + 1)]
%o A398037 print(lista(90))
%Y A398037 Cf. A001055, A025487, A330991 (persistence 2), A398813 (record setters), A398817 (persistence 3).
