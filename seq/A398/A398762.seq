%I A398762 #12 Nov 10 2026 15:30:14
%S A398762 1,3,2,8,7,3,21,22,12,4,55,67,43,18,5,144,200,147,72,25,6,377,588,486,
%T A398762 271,110,33,7,987,1708,1566,976,450,158,42,8,2584,4913,4944,3398,1746,
%U A398762 696,217,52,9,6765,14018,15351,11516,6505,2886,1022,288,63,10,17711,39725,47009,38179,23465,11425,4501,1442,372,75,11
%N A398762 Array read by antidiagonals: T(n,k) is the coefficient of x^n in (-1 + ((1 - x)^2 / (1 - 3*x + x^2))^(k+1)) / x for n >= 0, k >= 0.
%C A398762 Column k is the p-INVERT transform of the positive integers for p(S) = (1 - S)^(k+1).
%H A398762 Dmytro Dmytryshyn, <a href="https://doi.org/10.13140/RG.2.2.32268.68489">A Method of Non-Stationary Recurrence Relations for Computing Convolutions of Higher and Fractional Orders</a>, 2026.
%F A398762 G.f. for column k: (-1 + ((1 - x)^2 / (1 - 3*x + x^2))^(k+1)) / x.
%F A398762 G.f. for column k: (hypergeom([1+k, 1], [1], x/(1-x)^2) - 1) / x.
%F A398762 T(n,k) = ((4*n + 1 + k)*T(n-1,k) - (4*n - 5 - k)*T(n-2,k) + (n-2)*T(n-3,k)) / (n+1) for n >= 1, k >= 0, T(0,k) = 1 + k, T(-1,k) = 1, T(-2,k) = 0.
%e A398762 The array T(n,k) (with n >= 0, k >= 0) begins:
%e A398762          k = 0     k = 1     k = 2     k = 3    k = 4    k = 5    k = 6
%e A398762 ================================================================================
%e A398762 n = 0:       1,        2,        3,        4,       5,       6,       7
%e A398762 n = 1:       3,        7,       12,       18,      25,      33,      42
%e A398762 n = 2:       8,       22,       43,       72,     110,     158,     217
%e A398762 n = 3:      21,       67,      147,      271,     450,     696,    1022
%e A398762 n = 4:      55,      200,      486,      976,    1746,    2886,    4501
%e A398762 n = 5:     144,      588,     1566,     3398,    6505,   11425,   18830
%p A398762 T := proc (n, k) local x, G, S: G := (-1+((1-x)^2/(1-3*x+x^2))^(1+k))/x: S := series(G, x = 0, n+2): return coeff(S, x, n) end proc: out_list := 1: max_diag := 10: for d to max_diag do for k from 0 to d do n := d-k: out_list := [op(out_list), T(n, k)] end do: end do: StringTools:-Join(map(convert, out_list, string), ", ");
%Y A398762 Columns k=0..5 give A001906, A290917, A290918, A290919, A290920, A290921.
%Y A398762 Main diagonal gives A378565.
%K A398762 nonn,easy,tabl,new
%O A398762 0,2
%A A398762 _Dmytro Dmytryshyn_, Nov 03 2026
