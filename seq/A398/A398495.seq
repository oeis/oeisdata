%N A398495 Numbers k such that 2*PrimePi(k) = Sum_{d|k} PrimePi(d), where PrimePi = A000720.
%C A398495 PrimePi-perfect numbers by definition in A066218.
%H A398495 Žiga Pirc, <a href="/A398495/b398495.txt">Table of n, a(n) for n = 1..50</a>
%e A398495 PrimePi(188) = 42. PrimePi(1) + PrimePi(2) + PrimePi(4) + PrimePi(47) + PrimePi(94) = 0 + 1 + 2 + 15 + 24 = 42.
%t A398495 pi[n_] := pi[n] = PrimePi[n]; q[k_] := 2*pi[k] == DivisorSum[k, pi[#] &]; Select[Range[10^5], q] (* _Amiram Eldar_, Jul 31 2026 *)
%o A398495 (PARI) isok(n) = sumdiv(n, d, primepi(d)) == 2*primepi(n)
