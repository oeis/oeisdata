%I A398667 #16 Aug 12 2026 21:35:31
%S A398667 3,1,5,8,2,1,1,4,7,1,1,5,7,2
%N A398667 Initial digit of the decimal expansion of 5^(5^(5^n)).
%H A398667 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/BenfordsLaw.html">Benford's Law</a>
%H A398667 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/PowerTower.html">Power Tower</a>
%e A398667 a(0) = 3, since 5^(5^(5^0)) = 5^5 = 3125.
%e A398667 a(1) = 1, since 5^(5^(5^1)) = 5^3125 = 191101259...
%e A398667 a(5) = 1, since 5^(5^(5^5)) = 11110288... (see A241294)
%t A398667 f[base_, exp_] := IntegerPart[10^FractionalPart[N[exp*Log10[base], Floor[Log10[exp]] + 3]]];
%t A398667 Table[f[5, 5^(5^n)], {n, 0, 13}]
%o A398667 (Python)
%o A398667 import mpmath as mp
%o A398667 def a(n):
%o A398667     if n==0:return 3
%o A398667     e=5**n
%o A398667     E=5**e
%o A398667     mp.mp.dps=int(e*mp.log10(5))+40
%o A398667     x=mp.mpf(E)*mp.log10(5)
%o A398667     f=x-mp.floor(x)
%o A398667     return int(mp.floor(mp.power(10, f)))
%o A398667 n=0
%o A398667 while True:
%o A398667     print(f"a({n}) = {a(n)}")
%o A398667     n+=1
%Y A398667 Cf. A000030, A111395, A241294, A395745, A395747.
%K A398667 nonn,base,more,hard
%O A398667 0,1
%A A398667 _Allam Assal_, Aug 05 2026
