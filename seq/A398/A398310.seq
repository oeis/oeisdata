%I A398310 #17 Aug 07 2026 22:22:34
%S A398310 1,0,5,10,40,160,740,3360,15540,71560,330340,1523760,7031140,32439960,
%T A398310 149677940,690600160,3186390740,14701784360,67833089540,312977372560,
%U A398310 1444057094340,6662784344760,30741649125140,141839947280960,654440191301940,3019544010361160
%N A398310 Number of indecomposable closed walks of length n on the regular icosahedron based at a vertex.
%C A398310 An indecomposable (or first-return) closed walk returns to its starting vertex exactly once.
%H A398310 Vincent Gonzalez, <a href="/A398310/b398310.txt">Table of n, a(n) for n = 0..200</a>
%H A398310 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (4,5,-10).
%F A398310 G.f.: 2 - 1/f(x), where f(x) is the g.f. for A054884.
%F A398310 G.f.: (1 - 4*x - 25*x^4)/(1 - 4*x - 5*x^2 + 10*x^3).
%F A398310 a(n) = 4*a(n-1) + 5*a(n-2) - 10*a(n-3) for n > 4.
%e A398310 a(2) = 5: from a fixed vertex, each of the 5 incident edges gives one length-2 out-and-back walk that first returns at step 2.
%t A398310 nn = 40;
%t A398310 f = (1/12) (1/(1 - 5 x) + 6/(1 - 5 x^2) + 5/(1 + x));
%t A398310 CoefficientList[Series[2 - 1/f, {x, 0, nn}], x]
%o A398310 (PARI) Vec((1 - 4*x - 25*x^4)/(1 - 4*x - 5*x^2 + 10*x^3) + O(x^25))
%o A398310 (Python)
%o A398310 a=[1,0,5,10,40]
%o A398310 for n in range(5,25): a.append(4*a[-1]+5*a[-2]-10*a[-3])
%o A398310 print(a)
%Y A398310 Cf. A054884, A328778, A398262, A091000.
%K A398310 nonn,walk,easy,new
%O A398310 0,3
%A A398310 _Vincent Gonzalez_, Jul 25 2026
