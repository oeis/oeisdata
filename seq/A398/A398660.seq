%I A398660 #6 Aug 24 2026 00:09:53
%S A398660 0,3,9,23,46,81,131,196,281,387,517,674,858,1074,1323,1608,1932,2295,
%T A398660 2702,3154,3654,4205,4807,5465,6180,6955,7793,8694,9663,10701,11811,
%U A398660 12996,14256,15596,17017,18522,20114,21793,23564,25428,27388,29447,31605,33867
%N A398660 Upper (1, 6/5) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398660 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398660 <a href="/index/Rec#order_08">Index entries for linear recurrences with constant coefficients</a>, signature (3,-3,1,0,1,-3,3,-1).
%F A398660 a(n) = 3*a(n-1) - 3*a(n-2) + a(n-3) + a(n-5) - 3*a(n-6) + 3(n-7) - a(n-8), with (a(0), ..., a(7)) =  (0, 3, 9, 23, 46, 81, 131, 196).
%F A398660 G.f.: x*(3 + 5*x^2 + x^3 + 3*x^4)/((1 - x)^4*(1 + x + x^2 + x^3 + x^4)). - _Stefano Spezia_, Aug 22 2026
%t A398660 z = 60;
%t A398660 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398660 r = 1; s = 6/5;
%t A398660 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398660 Table[v[n], {n, 0, z}]
%Y A398660 Cf. A000217, A000330, A398659.
%K A398660 nonn,easy,new
%O A398660 0,2
%A A398660 _Clark Kimberling_, Aug 22 2026
