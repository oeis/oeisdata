%e A398996   [9] 16796, 3432, 704, 145, 30, 12, 11, 10, 14, 0;
%p A398996 # Using function 'binomial_matrix' from A399000.
%p A398996 motzkin := n -> simplify((-1)^n*hypergeom([-n, 3/2], [3], 4)):
%p A398996 BM := binomial_matrix(motzkin):
%p A398996 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A398996 seq(seq(BM(n-k, k), k = 0..n), n = 0..9);
%t A398996 (* Using function 'binomialMatrix' from A399000. *)
%t A398996 bM = binomialMatrix[HypergeometricPFQ[{-#/2, (1 - #)/2}, {2}, 4] &];
%t A398996 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398996 (Python)  # Using function binomial_matrix from A399000.
%o A398996 from mpmath import hyp2f1
%o A398996 def mot(n: int) -> int: return int((-1)**n * hyp2f1(-n, (3, 2), 3, 4))
%o A398996 M = binomial_matrix(mot)
%o A398996 for n in range(9): print([M(n, k) for k in range(9)])
