%I A398717 #26 Aug 16 2026 04:10:22
%S A398717 1,3,6,4,2,5,8,11,9,12,14,29,10,23,7,18,15,32,30,33,13,28,25,27,24,45,
%T A398717 20,22,19,16,34,17,35,38,36,39,66,63,37,62,95,58,55,31,54,85,26,47,76,
%U A398717 21,40,67,64,97,60,93,56,59,92,89,57,88,53,84,49,51,48,77,44,41,68,103,65,98,61,94,135,90,129,86,52
%N A398717 Squares visited by a "Priest" (Fers + Knight) moving on a spirally numbered board always to the lowest available unvisited square.
%C A398717 Board is numbered with the square spiral, with initial square labeled 1:
%C A398717 .
%C A398717   17--16--15--14--13
%C A398717    |               |
%C A398717   18   5---4---3  12
%C A398717    |   |       |   |
%C A398717   19   6   1---2  11
%C A398717    |   |           |
%C A398717   20   7---8---9--10
%C A398717    |
%C A398717   21--22--23--24--25
%C A398717 .
%C A398717 This sequence is finite: At step 1051, square 858 is visited, after which there are no unvisited squares within one move.
%H A398717 Jens Ahlström, <a href="/A398717/b398717.txt">Table of n, a(n) for n = 1..1051</a>
%H A398717 Stephen Emmerson and Geoff Foster, <a href="https://www.theproblemist.org/dloads/Glossary.pdf">A glossary of fairy chess definitions</a>, British Chess Problem Society, 2018.
%e A398717 At step 2 square 3 is visited after which square 6 is the lowest available unvisited square, so a(3) = 6.
%t A398717 ToN[{x_, y_}] := Module[{m = Max[Abs[x], Abs[y]], inner},
%t A398717   If[m == 0, Return[1]];
%t A398717   inner = (2m - 1)^2;
%t A398717   If[x == m && y != -m, inner + m + y,
%t A398717   If[y == m, inner + 2m + m - x,
%t A398717   If[x == -m, inner + 4m + m - y,
%t A398717   inner + 6m + x + m]]]
%t A398717 ]
%t A398717 moves = {{1, 1}, {-1, 1}, {1, -1}, {-1, -1}, {1, 2}, {2, 1}, {-1, 2}, {-2, 1}, {1, -2}, {2, -1}, {-1, -2}, {-2, -1}};
%t A398717 seq = {1};
%t A398717 visited = {1};
%t A398717 curr = {0, 0};
%t A398717 Do[
%t A398717   validMoves = Select[Map[curr + # &, moves], !MemberQ[visited, ToN[#]] &];
%t A398717   If[Length[validMoves] == 0, Break[]];
%t A398717   nextMove = First[SortBy[validMoves, ToN]];
%t A398717   AppendTo[seq, ToN[nextMove]];
%t A398717   AppendTo[visited, ToN[nextMove]];
%t A398717   curr = nextMove,
%t A398717   {1050}
%t A398717 ];
%t A398717 seq
%o A398717 (Python)
%o A398717 def to_n(x, y):
%o A398717     if x == 0 and y == 0:
%o A398717         return 1
%o A398717     m = max(abs(x), abs(y))
%o A398717     inner = (2 * m - 1) ** 2
%o A398717     if x == m and y != -m:
%o A398717         return inner + (m + y)
%o A398717     elif y == m:
%o A398717         return inner + 2 * m + (m - x)
%o A398717     elif x == -m:
%o A398717         return inner + 4 * m + (m - y)
%o A398717     elif y == -m:
%o A398717         return inner + 6 * m + (x + m)
%o A398717     return 1
%o A398717 # Moves: Fers (F) + Knight (N)
%o A398717 moves = [(1,1), (-1,1), (1,-1), (-1,-1),
%o A398717          (1,2), (2,1), (-1,2), (-2,1), (1,-2), (2,-1), (-1,-2), (-2,-1)]
%o A398717 visited = set([1])
%o A398717 seq = [1]
%o A398717 current_x, current_y = 0, 0
%o A398717 for _ in range(1050):
%o A398717     best_n = float('inf')
%o A398717     next_x, next_y = None, None
%o A398717     for dx, dy in moves:
%o A398717         tx, ty = current_x + dx, current_y + dy
%o A398717         tn = to_n(tx, ty)
%o A398717         if tn not in visited and tn < best_n:
%o A398717             best_n, next_x, next_y = tn, tx, ty
%o A398717     if next_x is None: break
%o A398717     visited.add(best_n)
%o A398717     seq.append(best_n)
%o A398717     current_x, current_y = next_x, next_y
%o A398717 print(seq)
%Y A398717 Cf. A316667, A398779, A308385, A316884.
%K A398717 nonn,fini
%O A398717 1,2
%A A398717 _Jens Ahlström_, Aug 07 2026
