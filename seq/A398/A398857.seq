%I A398857 #4 Sep 23 2026 01:31:57
%S A398857 0,2,7,16,29,45,65,89,116,147,182,220,262,308,357,410,467,527,591,659,
%T A398857 730,805,884,966,1052,1142,1235,1332,1433,1537,1645,1757,1872,1991,
%U A398857 2114,2240,2370,2504,2641,2782,2927,3075,3227,3383,3542,3705,3872,4042,4216
%N A398857 Upper (2/3, 1)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398857 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398857 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398857 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 2, 7, 16, 29).
%F A398857 G.f.: x*(-2 - 3*x - 4*x^2 - 2*x^3)/((-1 + x)^3 *(1 + x + x^2)).
%t A398857 z = 60;
%t A398857 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398857 r =2/3; s = 1;
%t A398857 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398857 Table[v[n], {n, 0, z}]
%Y A398857 Cf. A000217, A000326, A398856.
%K A398857 nonn,easy,new
%O A398857 0,2
%A A398857 _Clark Kimberling_, Sep 21 2026
