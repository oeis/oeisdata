%I A398779 #33 Aug 16 2026 10:28:34
%S A398779 1,10,3,6,9,4,7,2,5,8,11,14,28,13,34,12,15,18,35,38,19,16,33,29,32,54,
%T A398779 27,24,45,20,23,44,41,22,40,17,61,36,39,66,63,67,64,97,37,62,95,31,60,
%U A398779 30,53,25,46,21,69,42,73,108,43,70,105,148,65,98,139,59,55,58,88,57,94
%N A398779 Squares visited by a "(1,2)+(2,2)Leaper" (Knight + Alfil) moving on a spirally numbered board always to the lowest available unvisited square.
%C A398779 Board is numbered with the square spiral, with initial square labeled 1:
%C A398779 .
%C A398779   17--16--15--14--13  30
%C A398779    |               |   |
%C A398779   18   5---4---3  12  29
%C A398779    |   |       |   |   |
%C A398779   19   6   1---2  11  28
%C A398779    |   |           |   |
%C A398779   20   7---8---9--10  27
%C A398779    |                   |
%C A398779   21--22--23--24--25--26
%C A398779 .
%C A398779 This sequence is finite: At step 59677, square 57552 is visited, after which there are no unvisited squares within one move.
%H A398779 Jens Ahlström, <a href="/A398779/b398779.txt">Table of n, a(n) for n = 1..59677</a>
%H A398779 Chessvariants, <a href="https://www.chessvariants.com/large.dir/contest84/outbackchess.html">Outback Chess</a>.
%H A398779 Stephen Emmerson and Geoff Foster, <a href="https://www.theproblemist.org/dloads/Glossary.pdf">A glossary of fairy chess definitions</a>, British Chess Problem Society, 2018.
%H A398779 Wikipedia, <a href="https://en.wikipedia.org/wiki/List_of_fairy_chess_pieces">List of fairy chess pieces</a>.
%e A398779 At step 12 square 14 is visited after which square 28 is the lowest available unvisited square, so a(13) = 28.
%o A398779 (Python)
%o A398779 def to_n(x, y):
%o A398779     if x == 0 and y == 0:
%o A398779         return 1
%o A398779     m = max(abs(x), abs(y))
%o A398779     inner = (2 * m - 1) ** 2
%o A398779     if x == m and y != -m:
%o A398779         return inner + (m + y)
%o A398779     elif y == m:
%o A398779         return inner + 2 * m + (m - x)
%o A398779     elif x == -m:
%o A398779         return inner + 4 * m + (m - y)
%o A398779     elif y == -m:
%o A398779         return inner + 6 * m + (x + m)
%o A398779     return 1
%o A398779 # Moves: Alfil (A) + Knight (N)
%o A398779 moves = [(2,2), (-2,2), (2,-2), (-2,-2),
%o A398779          (1,2), (2,1), (-1,2), (-2,1), (1,-2), (2,-1), (-1,-2), (-2,-1)]
%o A398779 visited = set([1])
%o A398779 seq = [1]
%o A398779 current_x, current_y = 0, 0
%o A398779 for _ in range(60000):
%o A398779     best_n = float('inf')
%o A398779     next_x, next_y = None, None
%o A398779     for dx, dy in moves:
%o A398779         tx, ty = current_x + dx, current_y + dy
%o A398779         tn = to_n(tx, ty)
%o A398779         if tn not in visited and tn < best_n:
%o A398779             best_n, next_x, next_y = tn, tx, ty
%o A398779     if next_x is None: break
%o A398779     visited.add(best_n)
%o A398779     seq.append(best_n)
%o A398779     current_x, current_y = next_x, next_y
%o A398779 print(len(seq))
%o A398779 print(seq[:71])
