%I A398348 #12 Jul 30 2026 23:11:42
%S A398348 2,22,111618,6005363762644688,7089215977519836239803174210135872,
%T A398348 10157435539019790383692007859901914095646506996125324171134976,
%U A398348 1088311342166085622233936968206241145831703735739730233097607678331567012135585582014904030597687296
%N A398348 Number of toroidal n X n X n binary arrays, allowing rotation and/or reflection of the layers along each axis as well as all permutations of the axes.
%H A398348 Carlo Mitchener, <a href="/A398348/b398348.txt">Table of n, a(n) for n = 1..14</a>
%F A398348 By Burnside's lemma a(n) = (1/|G|)*Sum_{g in G} 2^c(g), where |G| = 48*n^3 and c(g) is the number of cycles of g acting on the n^3 cells.
%e A398348 a(2) = 22: the 2^8 = 256 binary 2 X 2 X 2 arrays fall into 22 orbits.
%e A398348 a(2) = 22 = A000616(3), the number of irreducible Boolean functions of 3 variables: at n = 2 the group complements any subset of the three coordinates and permutes them.
%o A398348 (Python)
%o A398348 from itertools import permutations, product
%o A398348 def a(n):
%o A398348     total = 0
%o A398348     for p in permutations(range(3)):
%o A398348         for eps in product((1, -1), repeat=3):
%o A398348             for s in product(range(n), repeat=3):
%o A398348                 seen = [False] * n**3
%o A398348                 c = 0
%o A398348                 for start in range(n**3):
%o A398348                     if seen[start]:
%o A398348                         continue
%o A398348                     c += 1
%o A398348                     cur = start
%o A398348                     while not seen[cur]:
%o A398348                         seen[cur] = True
%o A398348                         x = (cur // n**2, cur // n % n, cur % n)
%o A398348                         cur = sum(((eps[t] * x[p[t]] + s[t]) % n) * n**(2 - t) for t in range(3))
%o A398348                 total += 2**c
%o A398348     return total // (48 * n**3)
%Y A398348 Cf. A000616, A255016 (the two-dimensional case).
%K A398348 nonn
%O A398348 1,1
%A A398348 _Carlo Mitchener_, Jul 26 2026
