%T A398427 398401985436,7505769922560,142944825938348,2747467762237440,
%U A398427 53226555929916936,1038260465660067840,20375109907519622310,401981879426224226304,7968430330000911208620
%N A398427 Expansion of (1/x) * Series_Reversion( x * (1-4*x)^(3/2) ).
%H A398427 Wikipedia, <a href="https://en.wikipedia.org/wiki/Fuss-Catalan_number">Fuss-Catalan number</a>.
%F A398427 G.f. A(x) satisfies A(x) = 1/(1 - 4*x*A(x))^(3/2).
%F A398427 G.f. A(x) satisfies A(x) = (1 + 4*x*A(x)^(5/3))^(3/2).
%F A398427 G.f. A(x) satisfies A(x) = 1/A(-x*A(x)^(8/3)).
%F A398427 G.f.: B(x)^3 where B(x) is the g.f. of A245112.
%F A398427 a(n) = 4^n * binomial(5*n/2 + 1/2,n)/(n+1).
%o A398427 (PARI) my(N=20, x='x+O('x^N)); Vec(serreverse(x*(1-4*x)^(3/2))/x)
%o A398427 (PARI) apr(n, p, r) = r*binomial(n*p+r, n)/(n*p+r);
%o A398427 a(n) = 4^n*apr(n, 5/2, 3/2);
%Y A398427 Cf. A214553, A245112.
%Y A398427 Cf. A078531, A399165.
%K A398427 nonn,easy,new
%O A398427 0,2
