%S A398765 0,1,1,1,2,1,2,2,1,2,2,2,3,2,1,3,4,2,2,3,0,3,2,2,2,3,2,3,3,2,3,4,2,4,
%T A398765 2,3,2,4,1,3,4,3,3,4,0,3,3,3,3,2,1,4,2,2,0,3,1,4,2,3,4,4,2,4,2,4,3,5,
%U A398765 1,2,2,5,4,3,3,5,2,4,1,3,1,4,3,3,1,4,2,5,2,2,1,4,1,5,0,4,4,3,3,3,4,5,2
%N A398765 a(n) = number of ways that n can be written as x + y, where x >= y, and x * y is in A025487.
%C A398765 Also: a(n) = number of ways that n can be written as x + y, where x >= y, and x * y is in A077569.
%H A398765 Zhicheng Wei, <a href="/A398765/b398765.txt">Table of n, a(n) for n = 1..10000</a>
%e A398765 a(5) = 2 because 5 can be written as 4 + 1 or 3 + 2, where 4 * 1 = 4 and 3 * 2 = 6, both 4 and 6 are in A025487.
%t A398765 fQ[x_] := Or[x == 1, Times @@ MapIndexed[Prime[First[#2]]^#1 &, ReverseSort[FactorInteger[x][[;; , -1]] ] ] == x]; Array[Count[IntegerPartitions[#, {2}], _?(fQ[Times @@ #] &)] &, 105] (* _Michael De Vlieger_, Nov 09 2026 *)
%o A398765 (PARI)
%o A398765 isA025487(n)=my(k=valuation(n, 2), t); n>>=k; forprime(p=3, default(primelimit), t=valuation(n, p); if(t>k, return(0), k=t); if(k, n/=p^k, return(n==1)))
%o A398765 a(n)=sum(k=1,n/2,isA025487(k*(n-k)))
%Y A398765 Cf. A025487, A077569.
%K A398765 nonn,new
%O A398765 1,5
%A A398765 _Zhicheng Wei_, Nov 03 2026
