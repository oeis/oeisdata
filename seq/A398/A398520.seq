%I A398520 #9 Aug 03 2026 03:08:25
%S A398520 1,3,4,7,7,11,10,15,15,17,16,25,22,24,24,30,28,35,32,39,36,36,35,52,
%T A398520 47,46,46,51,48,58,53,63,60,59,57,74,68,68,65,78,73,81,76,81,80,78,77,
%U A398520 103,95,95,91,93,90,103,97,108,101,99,98,127,118,116,114,125,118,122,117,121,118,124
%N A398520 a(n) = Sum_{k=1..n} tau(floor(n/k)), where tau(n) = A000005(n) is the number of divisors of n.
%H A398520 Amiram Eldar, <a href="/A398520/b398520.txt">Table of n, a(n) for n = 1..10000</a>
%H A398520 Olivier Bordellès, <a href="https://doi.org/10.1142/S1793042122501056">On certain sums of number theory</a>, International Journal of Number Theory, Vol. 18, No. 9  (2022), pp. 2053-2074; <a href="https://arxiv.org/abs/2009.05751v2">arXiv preprint</a>, arXiv:2009.05751 [math.NT], 2020.
%H A398520 Ling Li, <a href="https://arxiv.org/abs/2604.20400">On the Hyperbolic Fractional Sum of the Divisor Function</a>, arXiv:2604.20400 [math.NT], 2026.
%H A398520 Kui Liu, Jie Wu, and Zhishan Yang, <a href="https://doi.org/10.1142/S179304212450043X">On some sums involving the integral part function</a>, International Journal of Number Theory, Vol. 20, No. 3 (2024), pp. 831-847; <a href="https://arxiv.org/abs/2109.01382">arXiv preprint</a>, arXiv:2109.01382 [math.NT], 2021.
%H A398520 Jing Ma and Huayan Sun, <a href="https://doi.org/10.1007/s10998-020-00378-3">On a sum involving the divisor function</a>, Periodica Mathematica Hungarica, Vol. 83, No. 2 (2021), pp. 185-191.
%H A398520 Joshua Stucky, <a href="https://doi.org/10.1016/j.jnt.2021.09.015">The fractional sum of small arithmetic functions</a>, Journal of Number Theory, Vol. 238 (2022), pp. 731-739; <a href="https://arxiv.org/abs/2106.14142">arXiv preprint</a>, arXiv:2106.14142 [math.NT], 2021.
%H A398520 Wei Zhang, <a href="https://doi.org/10.1016/j.jnt.2023.10.011">On a variant of the prime number theorem</a>, Journal of Number Theory, Vol. 257 (2024), pp. 163-185; <a href="https://arxiv.org/abs/2303.12347">arXiv preprint</a>, arXiv:2303.12347 [math.NT], 2023.
%F A398520 a(n) = c * n + O(n^(11/23 + eps)), for any eps > 0, where c = 1.88077... = A398521 (Ma and Sun, 2021).
%F A398520 The exponent in the error term was further improved to 19/40 + eps (Bordellès, 2022), 5/11 + eps (Stucky, 2022), 9/19 + eps (Liu et al., 2024), and 92/195 + eps (Zhang, 2024).
%t A398520 a[n_] := Sum[DivisorSigma[0, Floor[n/k]], {k, 1, n}]; Array[a, 70]
%o A398520 (PARI) a(n) = sum(k = 1, n, numdiv(n\k));
%Y A398520 Cf. A000005, A006218, A398521.
%K A398520 nonn,easy
%O A398520 1,2
%A A398520 _Amiram Eldar_, Aug 01 2026
