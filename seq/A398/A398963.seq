%T A398963 26292390,31881290,34298772,36133308,44354037,46664228,47833155,
%U A398963 51163376,54706928,55957912,56241688,60014576,60283376,76120101
%N A398963 Numbers k such that psi(k) = phi(k) + Omega(k)^10.
%C A398963 The Python program available in the linked GitHub repository computes the solutions to the equation psi(k) = phi(k) + Omega(k)^m for arbitrary positive integer values of m. For this sequence, use m = 10.
%H A398963 S. I. Dimitrov, <a href="https://github.com/Stoyan16/Numbers-k-such-that-psi-k-phi-k-Omega-k-6/blob/main/A401783">Python program</a> (GitHub).
%e A398963 1527 is a term since psi(1527) = 2040 = 1016 + 2^10 = phi(1527) + Omega(1527)^10.
%o A398963 (PARI) isok(k) = {my(f = factor(k)); prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) - eulerphi(f) == bigomega(f)^10; } \\ _Amiram Eldar_, Nov 27 2026
%Y A398963 Cf. A000010, A001222, A001615, A401783, A402098, A402099, A402100.
