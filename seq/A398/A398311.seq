%N A398311 G.f. A(x) satisfies: A(x) = 1 + x * A(x/(1 - 2*x)^2) / (1 - x).
%F A398311 a(n) = 1 + Sum_{k=1..n-1} Sum_{j=0..n-k-1} binomial(j+2*k-1,j) * 2^j * a(k).
%t A398311 nmax = 22; A[_] = 0; Do[A[x_] = 1 + x A[x/(1 - 2 x)^2]/(1 - x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A398311 (* Alternative: *)
%t A398311 a[n_] := a[n] = 1 + Sum[Sum[Binomial[j + 2 k - 1, j] 2^j a[k], {j, 0, n - k - 1}], {k, 1, n - 1}]; Table[a[n], {n, 0, 22}]
%Y A398311 Cf. A007405, A125273.
