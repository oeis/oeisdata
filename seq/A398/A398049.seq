%I A398049 #6 Jul 31 2026 05:34:31
%S A398049 0,2,7,14,24,37,52,70,91,115,142,171,203,238,275,315,358,404,453,504,
%T A398049 558,615,674,736,801,869,940,1013,1089,1168,1249,1333,1420,1510,1603,
%U A398049 1698,1796,1897,2000,2106,2215,2327,2442,2559,2679,2802,2927,3055,3186
%N A398049 Upper (3/4,1) midsequence of triangular numbers (A000217) and squares (A000290); see Comments.
%C A398049 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A397972 for a guide to related sequences.
%H A398049 <a href="/index/Rec#order_09">Index entries for linear recurrences with constant coefficients</a>, signature (3,-4,4,-4,4,-4,4,-3,1).
%F A398049 a(n) = 3*a(n-1) - 4*a(n-2) + 4*a(n-3) - 4*a(n-4) + 4*a(n-5) - 4*a(n-6) + 4*a(n-7) - 3*a(n-8) + a(n-9), with (a(0), ... a(8)) =  (0, 2, 7, 14, 24, 37, 52, 70, 91).
%t A398049 z = 60;
%t A398049 f[n_] := (n^2 + n)/2; g[n_] := n^2; r = 3/4; s = 1;
%t A398049 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]]
%t A398049 Table[v[n], {n, 0, z}]
%Y A398049 Cf. A000217, A000290, A398047, A398048.
%K A398049 nonn,easy,new
%O A398049 0,2
%A A398049 _Clark Kimberling_, Jul 26 2026
