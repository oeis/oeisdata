%p A398997 # Using function 'binomial_matrix' from A399000.
%p A398997 BM := binomial_matrix(n -> simplify(hypergeom([-n/2, (1-n)/2],[], 2))):
%p A398997 M := Matrix(8, 8, (n, k) -> BM(n-1, k-1));
%p A398997 seq(seq(BM(n-k, k), k = 0..n), n = 0..9);
%t A398997 (* Uses the function 'binomialMatrix' from A399000. *)
%t A398997 bM = binomialMatrix[HypergeometricPFQ[{-#/2, (1-#)/2}, {}, 2] &];
%t A398997 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398997 (Python)  # Using function binomial_matrix from A399000.
%o A398997 from mpmath import hyp2f0
%o A398997 def inv(n) -> int: return int(hyp2f0((-n,2), (1-n,2), 2))
%o A398997 M = binomial_matrix(inv)
%o A398997 for n in range(9): print([M(n, k) for k in range(9)])
