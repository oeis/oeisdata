%S A398826 1,1,1,1,2,2,3,5,7,9,5,11,6,23,27,37,8,58,9,90,72,84,11,186,52,136,
%T A398826 150,391,14,638,15,709,270,297,321,1845,18,411,441,3319,20,4417,21,
%U A398826 3009,3331,720,23,12690,200,5427,972,6510,26,19805,1215,24699,1350,1425
%N A398826 Number of partitions of n where the largest part is equal to the number of divisors of n.
%H A398826 Alois P. Heinz, <a href="/A398826/b398826.txt">Table of n, a(n) for n = 1..10000</a>
%F A398826 a(n) = A008284(n,A000005(n)). - _Alois P. Heinz_, Aug 11 2026
%e A398826 a(6) = 2. The number 6 has 4 divisors (1, 2, 3, 6). The partitions of 6 with the largest part equal to 4 are [4, 2] and [4, 1, 1].
%e A398826 a(12) = 11. The number 12 has 6 divisors (1, 2, 3, 4, 6, 12). The partitions of 12 with the largest part equal to 6 are [6, 6], [6, 5, 1], [6, 4, 2], [6, 4, 1, 1], [6, 3, 3], [6, 3, 2, 1], [6, 3, 1, 1, 1], [6, 2, 2, 2], [6, 2, 2, 1, 1], [6, 2, 1, 1, 1, 1] and [6, 1, 1, 1, 1, 1, 1].
%p A398826 b:= proc(n, i) option remember; `if`(n=0, 1,
%p A398826       `if`(i<1, 0, b(n, i-1)+b(n-i, min(n-i, i))))
%p A398826     end:
%p A398826 a:= n-> (t-> b(n-t, t))(numtheory[tau](n)):
%p A398826 seq(a(n), n=1..58);  # _Alois P. Heinz_, Aug 11 2026
%t A398826 a[n_]:=Length[Select[IntegerPartitions[n],#[[1]]==DivisorSigma[0,n]&]];Array[a,58] (* _James C. McMahon_, Aug 19 2026 *)
%o A398826 (Python)
%o A398826 def count_divisors(n):
%o A398826     return sum(1 for i in range(1, n + 1) if n % i == 0)
%o A398826 def a(n):
%o A398826     max_p = count_divisors(n)
%o A398826     if max_p > n or max_p <= 0: return 0
%o A398826     rem = n - max_p
%o A398826     memo = {}
%o A398826     def count(r, m):
%o A398826         if r == 0: return 1
%o A398826         if r < 0 or m <= 0: return 0
%o A398826         if (r, m) in memo: return memo[(r, m)]
%o A398826         return count(r - m, m) + count(r, m - 1)
%o A398826     return count(rem, max_p)
%o A398826 print([a(n) for n in range(1, 59)])
%o A398826 (PARI) a(n) = my(nb=0, d=numdiv(n)); forpart(p=n, if (vecmax(p) == d, nb++)); nb; \\ _Michel Marcus_, Aug 11 2026
