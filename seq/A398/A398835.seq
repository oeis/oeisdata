%I A398835 #16 Nov 10 2026 20:57:36
%S A398835 1,3,7,9,11,13,17,19,21,23,27,29,31,33,37,41,43,47,49,51,53,57,59,61,
%T A398835 63,67,69,71,73,77,79,81,83,87,89,91,93,97,99,101,103,107,109,111,113,
%U A398835 119,121,123,127,129,131,133,137,139,141,143,147,149,151,153,157
%N A398835 Numbers k such that (3^k - 1)/2 is squarefree.
%C A398835 See A398834 for a guide to related sequences.
%e A398835 Let p(k) = (x^k - y^k)/(x - y) = (3^k - 1)/2. Then the first five squarefree values of p(k) are 1, 13, 1093, 9841 = 13*757, 88573 = 23*3851.
%t A398835 {x, y} = {3, 1}; p[n_] := p[n] = (x^n - y^n)/(x - y);
%t A398835 f[n_] := f[n] = FactorInteger[p[n]]; Table[f[n], {n, 1, 10}] // Column
%t A398835 Table[Length[f[n]], {n, 1, 100}];
%t A398835 Position[Map[SquareFreeQ, Table[p[n], {n, 1, 150}]], True] // Flatten
%Y A398835 Cf. A003462, A398834.
%K A398835 nonn,easy,new
%O A398835 1,2
%A A398835 _Clark Kimberling_, Oct 22 2026
