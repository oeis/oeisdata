%I A398471 #10 Aug 05 2026 22:08:32
%S A398471 1,2,3,5,8,13,22,37,61,100,162,260,416,663,1053,1664,2617,4102,6416,
%T A398471 10029,15684,24561,38531,60560,95334,150238,236878,373449,588441,
%U A398471 926449,1457335,2290726,3599062,5654352,8886976,13979961,22020411,34743031,54922083,87002496,138116136
%N A398471 Number of terms in n-th generation of iterated RUNS sequence (A306211).
%C A398471 Let S_0 = [1] and S_{n+1} = S_n concatenated with RUNS(S_n), where RUNS(S) is the list of lengths of maximal runs of consecutive equal symbols in S. This is the iterated RUNS sequence A306211. Then, a(n) = |S_n|, the number of terms in generation n.
%C A398471 The average run length in generation n is a(n) / #runs(S_n) appears to oscillate with decreasing amplitude around sqrt(3) = 1.732050808..., suggesting a possible attractor for the run-length dynamics.
%C A398471 Problem 2026.3 in Sloane's REU 2026 seminar asks whether the maximum term of the iterated RUNS sequence remains bounded by 5 (see A395949, A395724).
%D A398471 N. J. A. Sloane, "Interesting Unsolved Integer Sequences", REU Seminar, DIMACS, Rutgers University, June 2026.
%H A398471 Sean A. Irvine, <a href="/A398471/b398471.txt">Table of n, a(n) for n = 0..50</a>
%F A398471 a(0) = 1; a(n+1) = a(n) + #runs(S_n).
%e A398471 a(2) = 3 because S_2 = [1, 1, 2] has length 3.
%e A398471 a(40) = 138116136 because S_40 has 138116136 terms.
%o A398471 (Python)
%o A398471 def runs(seq):
%o A398471     if not seq: return []
%o A398471     r, c = [], 1
%o A398471     for i in range(1, len(seq)):
%o A398471         if seq[i] == seq[i-1]: c += 1
%o A398471         else: r.append(c); c = 1
%o A398471     r.append(c); return r
%o A398471 def A306211_lengths(max_gen=40):
%o A398471     S = [1]
%o A398471     for _ in range(max_gen + 1):
%o A398471         yield len(S)
%o A398471         S += runs(S)
%Y A398471 Cf. A306211 (iterated RUNS sequence), A395949 (reign of the maximum), A395724 (maximum run length), A000002 (Kolakoski), A001462 (Golomb).
%K A398471 nonn,hard,new
%O A398471 0,2
