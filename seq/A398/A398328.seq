%U A398328 1239972,589204,102866,2562,5296790,13091870,13293500,6663580,1480750,90310
%N A398328 Irregular triangle read by rows: T(n,k) is the number of permutations p of [n] having exactly k runs of consecutive integers in either direction (n >= 0, 0 <= k <= floor(n/2)).
%C A398328 A run is a maximal contiguous block p(i),p(i+1),...,p(j), with j>i, such that |p(h+1)-p(h)|=1 for every i<=h<j.
%H A398328 Seiichi Manyama, <a href="/A398328/b398328.txt">Rows n = 0..150, flattened</a>
%F A398328 For n >= 2, T(n,k) = 2 * A010030(n,floor(n/2)-k).
%F A398328 G.f.: Sum_{n>=0} Sum_{k=0..floor(n/2)} T(n,k)*x^n*y^k = Sum_{j>=0} j! * ( ((1-y)*(2*x^2-x^3)-x)/((1-y)*x^2-1) )^j.
%e A398328 Irregular triangle begins:
%e A398328      1;
%e A398328      1
%e A398328      0,     2;
%e A398328      0,     6;
%e A398328      2,    16,     6;
%e A398328     14,    56,    50;
%e A398328     90,   286,   310,   34;
%e A398328    646,  1866,  2010,  518;
%e A398328   5242, 14300, 14976, 5540, 262;
%e A398328   ...
%Y A398328 Row sums give A000142.
%Y A398328 Columns k=0..5 give A002464, 2*A000239, 2*A000544, 2*A001282, 2*A398330, 2*A398331.
%Y A398328 Cf. A010030.
%K A398328 nonn,tabf,new
