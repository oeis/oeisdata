%N A398478 a(n) = Sum_{j=0..n} binomial(n + j, j) * n^(n - j) / (j + 1). Row sums of A398477.
%p A398478 a := n -> add(binomial(n + j, j) * n^(n - j) / (j + 1), j = 0..n);
%o A398478 (Python)
%o A398478 def A398478(n: int) -> int:
%o A398478     u = 0; t = 1
%o A398478     for _ in range(n): t *= n
%o A398478     for k in range(1, n + 1):
%o A398478         u += t
%o A398478         t = t * (n + k) // (n * (k + 1))
%o A398478     return u + t
%o A398478 print([A398478(n) for n in range(20)])
