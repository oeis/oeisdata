%S A398393 0,0,0,7,89,723,3773,14914,47982,132930,327630,736545,1535695,3008957,
%T A398393 5593539,9942548,16999948,28099764,45081132,70436235,107477685,
%U A398393 160549015,235258265,338766582,480103514,670550998,924057498,1257736389,1692397707,2253181665,2970228415,3879469160
%N A398393 a(n) is the number of inequivalent placements of 4 nonattacking rooks on an n X n board, up to rotations and reflections.
%C A398393 In other words, a(n) is the number of inequivalent ways to choose 4 squares on an n X n board with no two squares in the same row or column, with equivalence being up to rotations and reflections.
%H A398393 Janaka Rodrigo, <a href="/A398393/b398393.txt">Table of n, a(n) for n = 1..1000</a>
%H A398393 Janaka Rodrigo, <a href="/A398393/a398393.txt">Python code for A398393</a>.
%H A398393 <a href="/index/Rec#order_13">Index entries for linear recurrences with constant coefficients</a>, signature (5,-6,-10,29,-9,-36,36,9,-29,10,6,-5,1).
%F A398393 a(n) = 3*(binomial(n,4))^2 + (binomial(k,2))^2 + (1/2)*(binomial(k,2)) + (5/2)*(binomial(n,4)), where k = floor(n/2).
%e A398393 n = 4 has following configurations:
%e A398393   - - - X   - - X -   - - - X   - - X -   - X - -   - - X -   - X - -
%e A398393   - - X -   - - - X   - X - -   - X - -   - - X -   - - - X   - - - X
%e A398393   - X - -   - X - -   - - X -   - - - X   - - - X   X - - -   X - - -
%e A398393   X - - -   X - - -   X - - -   X - - -   X - - -   - X - -   - - X -
%e A398393 Therefore a(4) = 7.
%t A398393 LinearRecurrence[{5,-6,-10,29,-9,-36,36,9,-29,10,6,-5,1},{0,0,0,7,89,723,3773,14914, 47982,132930,327630,736545,1535695},32] (* _Stefano Spezia_, Jul 28 2026 *)
