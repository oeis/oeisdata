%p A398991 # Using function 'binomial_matrix' from A399000.
%p A398991 BM := binomial_matrix(n -> add(combinat:-eulerian1(n, k)*2^k, k = 0..n)):
%p A398991 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A398991 seq(seq(BM(n-k, k), k = 0..n), n = 0..9);
%t A398991 (* Using function 'binomialMatrix' from A399000. *)
%t A398991 bM = binomialMatrix[Sum[k! StirlingS2[#, k], {k, 0, #}] &];
%t A398991 Table[bM[n, k], {n, 0, 7}, {k, 0, 7}] // MatrixForm
%o A398991 (Python)  # Using function binomial_matrix from A399000.
%o A398991 from math import factorial
%o A398991 from sympy.functions.combinatorial.numbers import stirling
%o A398991 def fubini(n: int): return sum(factorial(k)*stirling(n, k) for k in range(n+1))
%o A398991 M = binomial_matrix(fubini)
%o A398991 for n in range(9): print([M(n, k) for k in range(8)])
