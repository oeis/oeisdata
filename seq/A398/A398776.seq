%N A398776 Square array read by antidiagonals downwards: A(n,k) = least m >= 1 such that k divides prime(n+1) + prime(n+2) + ... + prime(n+m), for n >= 0, k >= 1.
%H A398776 Seiichi Manyama, <a href="/A398776/b398776.txt">Antidiagonals n = 0..139, flattened</a>
%H A398776 Thomas F. Bloom, <a href="https://www.erdosproblems.com/427">Erdős Problem 427</a>, Erdős Problems.
%F A398776 A(n,1) = 1.
%F A398776 A(n,2) = 2 for n >= 1.
%e A398776 Square array begins:
%e A398776   1, 1, 10, 5, 2, 57,  5, ...
%e A398776   1, 2,  1, 2, 3, 16,  6, ...
%e A398776   1, 2,  2, 2, 1,  2, 19, ...
%e A398776   1, 2,  2, 4, 6,  2,  1, ...
%e A398776   1, 2,  2, 2, 4,  2,  6, ...
%e A398776   1, 2,  2, 4, 2,  2,  3, ...
%e A398776   1, 2,  2, 2, 8,  2,  5, ...
%e A398776   1, 2,  2, 6, 6,  2,  2, ...
%e A398776   ...
%o A398776 (PARI) a(n, k) = my(m=0, s=0); until(s%k==0, m++; s+=prime(n+m)); m;
%Y A398776 Row n=0 is A053050.
