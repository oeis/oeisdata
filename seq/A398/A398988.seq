%p A398988 # Using function 'binomial_matrix' from A399000.
%p A398988 BM := binomial_matrix(n -> n^n):
%p A398988 M := Matrix(8, 8, (n, k) -> BM(n-1, k-1));
%p A398988 seq(seq(BM(n-k, k), k = 0..n), n = 0..8);
%t A398988 (* Using function 'binomialMatrix' from A399000. *)
%t A398988 bM = binomialMatrix[If[# == 0, 1, Power[#, #]] &];
%t A398988 Table[bM[n, k], {n, 0, 7}, {k, 0, 7}] // MatrixForm
%o A398988 (Python)  # Using function binomial_matrix from A399000.
%o A398988 M = binomial_matrix(lambda n: n**n)
%o A398988 for n in range(9): print([M(n, k) for k in range(8)])
