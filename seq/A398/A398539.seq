%e A398539 Antidiagonals s = n + m:
%e A398539 s = 2: T(1, 1) = 561
%e A398539 s = 3: T(1, 2) = 1105, T(2, 1) = 4
%e A398539 s = 4: T(1, 3) = 1729, T(2, 2) = 6, T(3, 1) = 9
%e A398539 s = 5: T(1, 4) = 2465, T(2, 3) = 8, T(3, 2) = 15, T(4, 1) = 6
%e A398539 s = 6: T(1, 5) = 2821, T(2, 4) = 10, T(3, 3) = 21, T(4, 2) = 8, T(5, 1) = 25
%e A398539 s = 7: T(1, 6) = 6601, T(2, 5) = 12, T(3, 4) = 33, T(4, 3) = 12, T(5, 2) = 65, T(6, 1) = 8
%o A398539 (Python)
%o A398539 from sympy import isprime, reduced_totient
%o A398539 def is_knodel(k, n):
%o A398539     return k > n and not isprime(k) and (k - n) % reduced_totient(k) == 0
%o A398539 def T(m, n):
%o A398539     """Return the m-th n-Knodel number."""
%o A398539     c, k = 0, n + 1
%o A398539     while True:
%o A398539         if is_knodel(k, n):
%o A398539             c += 1
%o A398539             if c == m:
%o A398539                 return k
%o A398539         k += 1
%o A398539 def a(d):
%o A398539     """Generate terms read by antidiagonals: m + n = 2 .. d + 1."""
%o A398539     return [T(s - n, n) for s in range(2, d + 2) for n in range(1, s)]
%Y A398539 Cf. A002322 (Carmichael's lambda function).
