%I A398596 #33 Sep 09 2026 16:52:51
%S A398596 2,12,30,32,41,50,56,68,84,96,98,110,114,117,122,124,126,128,132,135,
%T A398596 144,161,170,171,182,188,200,204,226,240,243,252,269,270,275,276,281,
%U A398596 288,290,294,296,299,306,318,321,330,332,333,338,341
%N A398596 Exponents e for which there is a unique integer k > 1 such that S(k^e) = k, where S(n) is the sum of digits of n.
%C A398596 The base-10 digit sum equation S(k^e) = k generalizes Dudeney numbers (where e = 3). A solitaire exponent e is an exponent with exactly one nontrivial base k > 1.
%C A398596 For a given exponent e, candidate bases k > 1 are bounded above by 9d, where d is the number of digits of k^e, satisfying (9d)^e >= 10^(d-1).
%H A398596 Dieter Renz, <a href="/A398596/b398596.txt">Table of n, a(n) for n = 1..661</a>
%e A398596 For e = 2: k = 9 is the unique solution since S(9^2) = S(81) = 9.
%e A398596 For e = 12: k = 108 is the unique solution since S(108^12) = 108.
%o A398596 (Python)
%o A398596 def ok(e):
%o A398596     d, lim, c = 1, 1, 0
%o A398596     while lim < e*9*d: d, lim = d+1, lim*10
%o A398596     for k in range(2, lim+1):
%o A398596         if sum(map(int, str(k**e))) == k:
%o A398596             if c: return False # more than one
%o A398596             c += 1
%o A398596     return c == 1
%o A398596 # _Michael S. Branicky_, Sep 02 2026
%Y A398596 Cf. A061209 (Dudeney numbers), A133509 (exponents e with no solutions k > 1), A003101.
