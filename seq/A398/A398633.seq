%N A398633 a(0) = 1; a(n) = Sum_{k=0..n-1} (-1)^(n-k-1) * binomial(n,k) * (k+1)^(k*(n-k)) * a(k).
%F A398633 1 = Sum_{n>=0} a(n) * x^n / (1 + (n+1)^n * x)^(n+1).
%F A398633 1 = Sum_{n>=0} a(n) * exp(-(n+1)^n*x) * x^n / n!.
%t A398633 a[0] = 1; a[n_] := a[n] = Sum[(-1)^(n - k - 1) Binomial[n, k] (k + 1)^(k (n - k)) a[k], {k, 0, n - 1}]; Table[a[n], {n, 0, 12}]
