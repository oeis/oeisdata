%I A398864 #15 Aug 20 2026 06:56:49
%S A398864 150,294,490,726,735,1014,1050,1210,1650,1690,1694,1734,1815,1950,
%T A398864 2166,2366,2535,2541,2550,2850,2890,3174,3234,3450,3549,3610,3718,
%U A398864 3822,4046,4235,4335,4350,4650,4998,5046,5054,5290,5390,5415,5550,5577,5586,5766,5915,6069
%N A398864 Numbers k of the form q(k) * rad(k), where rad = A007947, and q(k) the third smallest distinct prime factor of k.
%C A398864 Terms have at least 3 distinct prime factors, squarefree kernels are in A350352.
%C A398864 There exist at least 3 numbers j < a(n) such that rad(j) = rad(a(n)). For a(5) = 735, these j are {105, 315, 525}.
%C A398864 Smallest term with j >= 3 distinct prime factors is 5 * A002110(j).
%H A398864 Michael De Vlieger, <a href="/A398864/b398864.txt">Table of n, a(n) for n = 1..10000</a>
%e A398864 Table of n, a(n) for select n:
%e A398864      n      a(n)
%e A398864   ------------------------------------------------
%e A398864       1       150 = 2 * 3 * 5^2
%e A398864       2       294 = 2 * 3 * 7^2
%e A398864       3       490 = 2 * 5 * 7^2
%e A398864       4       726 = 2 * 3 * 11^2
%e A398864       5       735 = 3 * 5 * 7^2
%e A398864       6      1014 = 2 * 3 * 13^2
%e A398864       7      1050 = 2 * 3 * 5^2 * 7
%e A398864       8      1210 = 2 * 5 * 11^2
%e A398864       9      1650 = 2 * 3 * 5^2 * 11
%e A398864      83     11550 = 2 * 3 * 5^2 * 7 * 11
%e A398864    1070    150150 = 2 * 3 * 5^2 * 7 * 11 * 13
%e A398864   18079   2552550 = 2 * 3 * 5^2 * 7 * 11 * 13 * 17
%t A398864 nn = 6500; Union@ Map[If[# <= nn, #, Nothing] &[#*FactorInteger[#][[3, 1]] ] &, Select[Select[Range[2, nn], SquareFreeQ], PrimeNu[#] >= 3 &] ]
%o A398864 (Python)
%o A398864 from math import prod
%o A398864 from sympy import factorint
%o A398864 def ok(k):
%o A398864     f = factorint(k)
%o A398864     q = 0 if len(f) < 3 else sorted(f)[2]
%o A398864     return q and k == q * prod(f)
%o A398864 print([k for k in range(6070) if ok(k)]) # _Michael S. Branicky_, Aug 14 2026
%Y A398864 Cf. A007947, A350352, A398442.
%K A398864 nonn,easy,new
%O A398864 1,1
%A A398864 _Michael De Vlieger_, Aug 11 2026
