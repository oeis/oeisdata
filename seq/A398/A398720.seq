%I A398720 #66 Aug 20 2026 19:31:03
%S A398720 1,1,1,0,1,1,0,9,6,1,0,36,96,246,96,36,0,1,1,0,100,600,4150,12840,
%T A398720 20700,17000,7825,2200,120,1,0,225,2400,31500,239040,1219980,3722400,
%U A398720 7169670,8784000,7169670,3722400,1219980,239040,31500,2400,225,0,1
%N A398720 Triangle read by rows: T(n,k) in which the n-th row lists the weight distribution of square Single Parity Check Product (SPCP) [(n+1)^2, n^2, 4] code, 0 <= k <= n*floor(n/2).
%C A398720 These codes may also be known as direct product, row-column, rectangular, or vertical redundancy check + longitudinal redundancy check (VRC+LRC) codes.
%C A398720 T(n,k) is the number of n X n matrices with exactly 2k 1's such that there are an even number of 1's in every row and column.
%D A398720 C. Leung, Evaluation of the Error Probability of Single Parity-Check Codes, IEEE Transactions on Communications Vol. COM-31, NO. 2, Feb 1983, pp. 250-253.
%D A398720 F. J. MacWilliams and N. J. A. Sloane The Theory of Error Correcting Codes, Elsevier/North Holland 1977, p. 21.
%H A398720 Andrew Howroyd, <a href="/A398720/b398720.txt">Table of n, a(n) for n = 0..1405</a> (rows 0..20)
%H A398720 A. M. Patel and S. J. Hong, <a href="/A397935/a397935.pdf">Optimal Rectangular Code for High Density Magnetic Tapes</a>.
%H A398720 G. Gordon Thompson, <a href="/A396317/a396317_2.pdf">Probability of Undetected Error for some Some Simple Product Codes</a>, MS Thesis, UT Arlington TX, May 1984.
%F A398720 T(n, 0) = 1; T(n, 1) = 0.
%F A398720 T(n, n^2/2-k) = T(n, k) for n even.
%F A398720 Conjecture: T(n, n*(n-1)/2) = n! for n odd.
%e A398720 The triangle begins:
%e A398720   1;
%e A398720   1;
%e A398720   1, 0, 1;
%e A398720   1, 0, 9, 6;
%e A398720   1, 0, 36, 96, 246, 96, 36, 0, 1;
%e A398720   1, 0, 100, 600, 4150, 12840, 20700, 17000, 7825, 2200, 120;
%e A398720   1, 0, 225, 2400, 31500, 239040, 1219980, 3722400, 7169670, 8784000, 7169670, 3722400, 1219980, 239040, 31500, 2400, 225, 0, 1;
%o A398720 (PARI)
%o A398720 MkM(n,x='x)={my(M=matrix(n+1,n+1)); for(i=0, n, for(k=0, n\2, for(j=0, 2*k, if(j<=i&&2*k-j<=n-i, M[1+i,1+i-j+2*k-j] += binomial(i,j)*binomial(n-i,2*k-j)*x^k)))); M}
%o A398720 row(n)=Vecrev((MkM(n,'x)^n)[1,1]) \\ _Andrew Howroyd_, Aug 14 2026
%Y A398720 Row sums are A002416(n-1).
%Y A398720 Columns k=0..7 are A000012, A000004, A000537(n-1), A179058, A396317, A396321, A393842, A397935.
%Y A398720 Cf. A093353, A340312.
%K A398720 nonn,tabf,new
%O A398720 0,8
%A A398720 _G. Gordon Thompson_, Aug 07 2026
