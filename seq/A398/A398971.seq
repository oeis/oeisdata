%N A398971 Numbers k such that psi(k) = phi(k) + tau(k)^3.
%C A398971 a(21) > 1.5*10^10, if it exists. - _Amiram Eldar_, Aug 16 2026
%e A398971 87 is a term since psi(87) = 120 = 56 + 4^3 = phi(87) + tau(87)^3.
%o A398971 (PARI) isok(k) = {my(f = factor(k)); prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) - eulerphi(f) == numdiv(f)^3; } \\ _Amiram Eldar_, Aug 15 2026
%o A398971 (Python)
%o A398971 from math import prod
%o A398971 from sympy import factorint
%o A398971 def ok(n):
%o A398971     f = factorint(n)
%o A398971     phi = prod((p-1)*p**(e-1) for p, e in f.items())
%o A398971     psi = prod((p+1)*p**(e-1) for p, e in f.items())
%o A398971     tau = prod(e+1 for e in f.values())
%o A398971     return psi == phi + tau**3
%o A398971 print([k for k in range(10**6) if ok(k)]) # _Michael S. Branicky_, Aug 15 2026
