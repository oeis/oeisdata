%I A398536 #12 Aug 12 2026 22:12:36
%S A398536 1,20,819,69904,10172525,2238976116,692352720199,285942833483840,
%T A398536 151970818238211609,101010101010101010100,82081105631730092455931,
%U A398536 80052769211806164721787280,92279361920609501281366280389,124109909515305617548415575609364
%N A398536 a(n) is the trace of the Hankel n X n matrix M_n whose M_n(i,j) generic element is n^(i+j).
%C A398536 Remainders mod 3 follow the period 3 cycle (1, 2, 0).
%H A398536 Wikipedia, <a href="https://en.wikipedia.org/wiki/Hankel_matrix">Hankel matrix</a>.
%F A398536 For n>1, a(n) = A174964(n) - 1 = (1 - n^(2*n + 2))/(1 - n^2) - 1.
%e A398536 For n = 3:
%e A398536       Matrix M_3
%e A398536   [ 9     27     81]
%e A398536   [27     81    243]
%e A398536   [81    243    729]
%e A398536 Trace of M_3 = 9 + 81 + 729 = 819.
%o A398536 (PARI) a(n)=trace(matrix(n,n,i,j,n^(i+j)))
%Y A398536 Cf. A174964.
%K A398536 nonn,easy,new
%O A398536 1,2
%A A398536 _Claude H. R. Dequatre_, Aug 01 2026
