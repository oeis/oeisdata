%I A398146 #28 Jul 29 2026 16:21:25
%S A398146 1,10,77,530,3428,21310,128879,763850,4457755,25698900,146693256,
%T A398146 830516460,4669772957,26103219530,145175559433,803853299110,
%U A398146 4433793155884,24371446865450,133553517518635,729850112423050,3978621959491511,21639760387133160,117457244161277712,636341883001376280
%N A398146 Expansion of generating function x / (1 - 5*x - x^2)^2.
%C A398146 The self-convolution (convolution order s=1) of the sequence A052918.
%H A398146 Paolo Xausa, <a href="/A398146/b398146.txt">Table of n, a(n) for n = 1..1000</a>
%H A398146 T. M. Brown, D. Dmytryshyn, and A. M. Stokolos, <a href="https://doi.org/10.13140/RG.2.2.14770.77760">Convolutions of linear recurrent sequences and Gegenbauer polynomials</a>, Preprint, 2026.
%H A398146 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,-23,-10,-1).
%F A398146 a(n) = 10*a(n-1)-23*a(n-2)-10*a(n-3)-a(n-4) for n >= 5, a(1) = 1, a(2) = 10, a(3) = 77, a(4) = 530.
%F A398146 a(n) = (5*n*a(n-1)+(n+1)*a(n-2))/(n-1) for n >= 3, a(1) = 1, a(2) = 10.
%F A398146 a(n) = Sum_{j=0..n-1} b(j+1)*b(n-j), where b(j) = A052918(j).
%F A398146 a(n) = (-I)^(n-1) GegenbauerC(n-1,2,I*5/2), where GegenbauerC(n,m,x) is the Gegenbauer polynomial.
%F A398146 a(n) = (n*(r1^(n+2)-r2^(n+2))+(n+2)*(r1^n-r2^n))/29^(3/2),wherer1 = (5+sqrt(29))/2 and r2 = (5-sqrt(29))/2.
%F A398146 a(n) = (n*A052918(n+2)+(n+2)*A052918(n))/29.
%F A398146 a(n) = Sum_{j=0..floor((n-1)/2)} (n-j)*binomial(n-1-j,j)*5^(n-1-2*j).
%F A398146 G.f.: x/(1-5*x-x^2)^2.
%F A398146 E.g.f.: exp(5*x/2)*((27*x/29)*cosh(sqrt(29)*x/2)+(4*sqrt(29)/841+5*sqrt(29)*x/29)*sinh(sqrt(29)*x/2)).
%p A398146 G := proc (n) option remember: if n = 0 then return 0 end if: if n = 1 then return 1 end if: return 5*(n)*G(n-1)/(n-1)+ (n+1)*G(n-2)/(n-1) end proc: N:=20: seq(G(k), k = 1 .. N);
%t A398146 LinearRecurrence[{10, -23, -10, -1}, {1, 10, 77, 530}, 25] (* _Paolo Xausa_, Jul 29 2026 *)
%Y A398146 Cf. A052918, A006190, A395431, A395902.
