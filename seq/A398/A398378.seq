%I A398378 #47 Sep 29 2026 13:07:33
%S A398378 202,706,11065,12055,12091,14017,14026,14046,14058,14085,15018,16015,
%T A398378 16078,16098,17056,17086,18022,18058,18069,18085,19066,21055,21066,
%U A398378 21078,22054,22081,23089,23098,24096,25015,25064,25078,26014,26096,27045,27049,27085,28039
%N A398378 Cyclops Smith numbers.
%C A398378 Cyclops numbers (A134808) that are also Smith numbers (A006753). Equivalently, composite numbers with an odd number of decimal digits and exactly one digit 0, in the central position, such that the sum of their digits equals the sum of the digits of their prime factors, counted with multiplicity.
%D A398378 Shyam Sunder Gupta, "Smith Numbers", in Exploring the Beauty of Fascinating Numbers, Springer, 2025, pp. 127-157.
%D A398378 Albert Wilansky, "Smith numbers", Two-Year College Mathematics Journal, 13 (1982), 21.
%H A398378 Robert Israel, <a href="/A398378/b398378.txt">Table of n, a(n) for n = 1..10000</a>
%e A398378 11065 = 5*2213 is a term since it is a Cyclops number and 1+1+0+6+5 = 5 + (2+2+1+3) = 13.
%p A398378 filter:= proc(n) local t;
%p A398378    if isprime(n) then return false fi;
%p A398378    convert(convert(n,base,10),`+`) = add(t[2]*convert(convert(t[1],base,10),`+`),t=ifactors(n)[2])
%p A398378 end proc:
%p A398378 cyc:= proc(k,d) local L,i; L:= convert(9^(2*d)+k,base,9); add((L[i]+1)*10^(i-1),i=1..d) +
%p A398378 add((L[i]+1)*10^i, i=d+1..2*d) end proc:
%p A398378 select(filter, [seq(seq(cyc(k,m),k=0..9^(2*m)-1),m=1..2)]); # _Robert Israel_, Sep 29 2026
%t A398378 cycQ[n_]:=Module[{idn=IntegerDigits[n], len=IntegerLength[n]}, OddQ[len] && DigitCount[ n, 10, 0]==1&&idn[[(len+1)/2]]==0];smQ[n_] := !PrimeQ@ n && n>1 && Plus @@ Flatten[ IntegerDigits@ Table[ #[[1]], {#[[2]] }] & /@ FactorInteger@ n] == Plus @@ IntegerDigits@ n;Select[Range[28039],cycQ[#]&&smQ[#]&] (* _James C. McMahon_, Sep 29 2026 *)
%o A398378 (Python)
%o A398378 from itertools import product,count,islice
%o A398378 from sympy import factorint
%o A398378 def ds(n):
%o A398378     return sum(map(int,str(n)))
%o A398378 def a():
%o A398378     for k in count(1):
%o A398378         for d in product('123456789',repeat=2*k):
%o A398378             n=int(''.join(d[:k])+'0'+''.join(d[k:]))
%o A398378             f=factorint(n)
%o A398378             if sum(f.values())>1 and ds(n)==sum(e*ds(p) for p,e in f.items()):
%o A398378                 yield n
%o A398378 print(list(islice(a(),150)))
%Y A398378 Intersection of A134808 and A006753.
%Y A398378 Subsequence of A160712.
%K A398378 base,easy,nonn,new
%O A398378 1,1
%A A398378 _Ronie P. Dario_, Sep 20 2026
