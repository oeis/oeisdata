%I A398445 #16 Aug 27 2026 00:32:37
%S A398445 1,0,1,1,2,8,1860,16892994
%N A398445 Number of idempotent Latin squares of order n up to simultaneous row, column and symbol permutation combined with the six conjugate (parastrophe) operations.
%C A398445 A Latin square of order n on the symbols 0..n-1 is idempotent if the cell in row i, column i contains i for every i.
%C A398445 Regard such a square as its set of n^2 triples (r, c, L(r,c)). The six permutations of the three coordinates give the six conjugates, or parastrophes, of L.
%C A398445 Every conjugate of an idempotent Latin square is again idempotent, because the diagonal triples (i,i,i) are unchanged by any permutation of the coordinates.
%C A398445 Conjugation commutes with relabeling rows, columns and symbols by a single permutation, so the two together give an action of S_n X S_3, and a(n) is the number of orbits.
%F A398445 a(n) = (1/(6*n!)) * Sum_{g in S_n X S_3} F(g), where F(g) is the number of idempotent Latin squares of order n fixed by g; F(identity) = A395689(n).
%e A398445 a(5) = 2: the four isomorphism classes of order 5 merge under conjugation into two orbits, one containing three of the classes and one containing the fourth.
%o A398445 (Python)
%o A398445 from itertools import permutations
%o A398445 def A398445(n):
%o A398445     def squares():
%o A398445         L = [[i if i == j else -1 for j in range(n)] for i in range(n)]
%o A398445         out = []
%o A398445         def rec(k):
%o A398445             if k == n * n:
%o A398445                 out.append(tuple(tuple(r) for r in L))
%o A398445                 return
%o A398445             i, j = divmod(k, n)
%o A398445             if L[i][j] != -1:
%o A398445                 rec(k + 1)
%o A398445                 return
%o A398445             for s in range(n):
%o A398445                 if s not in L[i] and all(L[r][j] != s for r in range(n)):
%o A398445                     L[i][j] = s
%o A398445                     rec(k + 1)
%o A398445                     L[i][j] = -1
%o A398445         rec(0)
%o A398445         return out
%o A398445     def canon(sq):
%o A398445         best = None
%o A398445         for p in permutations(range(n)):
%o A398445             q = [0] * n
%o A398445             for i in range(n):
%o A398445                 q[p[i]] = i
%o A398445             m = tuple(tuple(p[sq[q[i]][q[j]]] for j in range(n)) for i in range(n))
%o A398445             if best is None or m < best:
%o A398445                 best = m
%o A398445         return best
%o A398445     def conjugates(sq):
%o A398445         out = []
%o A398445         for rp in permutations(range(3)):
%o A398445             C = [[0] * n for _ in range(n)]
%o A398445             for r in range(n):
%o A398445                 for c in range(n):
%o A398445                     t = (r, c, sq[r][c])
%o A398445                     C[t[rp[0]]][t[rp[1]]] = t[rp[2]]
%o A398445             out.append(tuple(tuple(row) for row in C))
%o A398445         return out
%o A398445     return len({min(canon(c) for c in conjugates(s)) for s in squares()})
%o A398445 print([A398445(n) for n in range(1, 6)])
%Y A398445 Cf. A003090, A395689, A395690.
%K A398445 nonn,new
