%N A398974 Number of 0's in the binary expansion of n^3.
%H A398974 Michael B. Porter, <a href="/A398974/b398974.txt">Table of n, a(n) for n = 0..10000</a>
%F A398974 a(n) = A023416(A000578(n)).
%e A398974 For n=3, n^3 = 27 = 11011 binary, which has one zero, so a(3)=1.
%t A398974 a[n_]:=Count[IntegerDigits[n^3, 2], 0]; Array[a,94,0] (* _Stefano Spezia_, Sep 19 2026 *)
%o A398974 (PARI) {a(n) = if(n==0,1,#select(x -> x == 0, binary(n^3)))}
