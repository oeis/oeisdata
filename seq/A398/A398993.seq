%p A398993 # Using function 'binomial_matrix' from A399000.
%p A398993 BM := binomial_matrix(n -> combinat:-bell(n)):
%p A398993 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A398993 seq(seq(BM(n-k, k), k = 0..n), n = 0..9);
%t A398993 (* Using function 'binomialMatrix' from A399000. *)
%t A398993 bM = binomialMatrix[BellB];
%t A398993 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398993 (Python)  # Using function binomial_matrix from A399000.
%o A398993 from mpmath import bell
%o A398993 M = binomial_matrix(lambda n: int(bell(n)))
%o A398993 for n in range(9): print([M(n, k) for k in range(9)])
