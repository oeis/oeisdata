%U A398556 132269340,133248584,134004040,139775384,140342216,140888216,142766340,145747096,146428216,146640296,147019576,147387592,147521176
%N A398556 Numbers k such that sigma(k) = psi(k) + Omega(k)^10.
%C A398556 The sequence is infinite because it contains all numbers of the form 7 * 131071 * p^2, where p is any prime such that gcd(p, 7 * 131071) = 1.
%C A398556 Another infinite family of terms is all numbers of the form 127 * 8191 * p^2 for p prime.
%e A398556 3669988 is a term since sigma(3669988) = 7340032 = 6291456 + 4^10 = psi(3669988) + Omega(3669988)^10.
%o A398556 (PARI) isok(k) = {my(f = factor(k)); sigma(f) == prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) + bigomega(f)^10; } \\ _Amiram Eldar_, Aug 02 2026
%o A398556 (Python)
%o A398556 from math import prod
%o A398556 from sympy import factorint
%o A398556 def ok(n):
%o A398556     f = factorint(n)
%o A398556     sigma = prod((p**(e+1)-1)//(p-1) for p, e in f.items())
%o A398556     Omega = sum(f.values())
%o A398556     psi = prod((p+1)*p**(e-1) for p, e in f.items())
%o A398556     return sigma == psi + Omega**10
%o A398556 # _Michael S. Branicky_, Aug 02 2026
%Y A398556 Cf. A244963 (sigma minus psi), A001222 (Omega), A397843, A398159, A398160, A398401, A398467, A398555.
%K A398556 nonn
