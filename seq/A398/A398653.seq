%I A398653 #4 Aug 14 2026 00:52:59
%S A398653 0,1,4,10,20,33,51,74,104,140,183,234,294,364,443,533,634,748,874,
%T A398653 1013,1166,1334,1518,1717,1933,2166,2418,2688,2977,3286,3616,3968,
%U A398653 4341,4737,5156,5600,6068,6561,7080,7626,8200,8801,9431,10090,10780,11500,12251
%N A398653 Lower (1, 1/3) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398653 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398653 <a href="/index/Rec#order_10">Index entries for linear recurrences with constant coefficients</a>, signature (4,-6,3,3,-6,3,3,-6,4,-1).
%F A398653 a(n) = 4*a(n-1) - 6*a(n-2) + 3*a(n-3) + 3*a(n-4) - 6*a(n-5) + 3*a(n-6) + 3*a(n-7) - 6*a(n-8) + 4*a(n-9) - a(n-10) , with (a(0), ..., a(9)) =  (0, 1, 4, 10, 20, 33, 51, 74, 104, 140).
%t A398653 z = 60;
%t A398653 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398653 r = 1; s = 1/3;
%t A398653 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398653 Table[u[n], {n, 0, z}]
%Y A398653 Cf. A000217, A000330, A398654.
%K A398653 nonn,easy,new
%O A398653 0,3
%A A398653 _Clark Kimberling_, Aug 10 2026
