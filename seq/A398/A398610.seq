%T A398610 5,5,1,6,3,0,1,4,0,9,1,1,8,8,6,5,8,3,6,7,9,2,5,6,6,3,8,4,2,4,8,6,8,2,
%U A398610 3,4,7,7,2,5,9,9,2,5,9,7,9,9,4,1,6,9,9,2,3,0
%N A398610 Decimal expansion of the volume of a canonical (dual-uniform) 9-gonal trapezohedron with unit short edge length.
%C A398610 The 9-gonal trapezohedron is the dual polyhedron of the 9-gonal antiprism.
%H A398610 Paolo Xausa, <a href="/A398610/b398610.txt">Table of n, a(n) for n = 3..10000</a>
%H A398610 Polytope Wiki, <a href="https://polytope.miraheze.org/wiki/Enneagonal_antitegum">Enneagonal antitegum</a>.
%H A398610 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Trapezohedron.html">Trapezohedron</a>.
%H A398610 <a href="/index/Al#algebraic_03">Index entries for algebraic numbers, degree 3</a>.
%F A398610 Equals (3*(1 + 2*c)*cot(Pi/18)*csc(Pi/18)^2)/(8*sqrt(2*(1 + c))), where c = cos(Pi/9) = A019879.
%F A398610 Equals the largest root of 8*x^3 - 828*x^2 + 324*x - 27.
%e A398610 103.107523624293734537224174708557555163014091...
%t A398610 First[RealDigits[Root[8*#^3 - 828*#^2 + 324*# - 27 &, 3], 10, 100]]
%t A398610 (* Alternative: *)
%t A398610 First[RealDigits[PolyhedronData[{"Trapezohedron", 9}, "Volume"], 10, 100]]
%Y A398610 Cf. A398611 (surface area), A398612 (inradius), A398613 (midradius), A398614 (height).
%Y A398610 Cf. A398615 (long edge).
%Y A398610 Cf. A398616 (small face angle), A398617 (large face angle), A398618 (dihedral angle).
%Y A398610 Cf. A395164 (volume of the dual).
%Y A398610 Cf. A019879.
%K A398610 nonn,cons,easy,new
%O A398610 3,3
%A A398610 _Paolo Xausa_, Aug 05 2026
