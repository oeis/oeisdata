%U A398190 4675318111318772736,344246326561085376512,27214917679437067008000,2299208907815276559826944,206724391388579438063550464,19708999373881407743899140096
%N A398190 a(n) = exp(2 * n) * Gamma(1 + n, 2 * n). Central terms of A398187.
%F A398190 a(n) = n! * Sum_{j=0..n} (2*n)^j / j!.
%F A398190 a(n) ~ 2^(n+1) * n^n. - _Vaclav Kotesovec_, Jul 29 2026
%t A398190 a[n_] := Exp[2 n] * Gamma[1 + n, 2 n]
%o A398190 (Python)
%o A398190 from math import factorial
%o A398190 def a(n: int) -> int:
%o A398190     term = factorial(n)
%o A398190     total = term
%o A398190     n2 = 2 * n
%o A398190     for j in range(1, n + 1):
%o A398190         term = (term * n2) // j
%o A398190         total += term
%o A398190     return total
%o A398190 A = [a(n) for n in range(19)]; print(A)
%Y A398190 Cf. A398187.
%K A398190 nonn
%O A398190 0,2
%A A398190 _Peter Luschny_, Jul 28 2026
