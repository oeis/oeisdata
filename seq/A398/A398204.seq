%I A398204 #4 Aug 11 2026 01:05:34
%S A398204 0,0,3,7,12,20,29,39,52,66,81,99,118,138,161,185,210,238,267,297,330,
%T A398204 364,399,437,476,516,559,603,648,696,745,795,848,902,957,1015,1074,
%U A398204 1134,1197,1261,1326,1394,1463,1533,1606,1680,1755,1833,1912,1992,2075
%N A398204 Lower (-1/3,1) midsequence of triangular numbers (A000217) and squares (A000290); see Comments.
%C A398204 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A397972 for a guide to related sequences.
%H A398204 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398204 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), with (a(0), ..., a(4)) =  (0, 0, 3, 7, 12).
%F A398204 G.f.: -((x^2*(3 + x + x^2))/((-1 + x)^3*(1 + x + x^2))).
%t A398204 z = 60;
%t A398204 f[n_] := (n^2 + n)/2; g[n_] := n^2; r = -1/3; s = 1;
%t A398204 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]]
%t A398204 Table[u[n], {n, 0, z}]
%Y A398204 Cf. A000217, A000290, A398205.
%K A398204 nonn,easy,new
%O A398204 0,3
%A A398204 _Clark Kimberling_, Aug 09 2026
