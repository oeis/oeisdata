%I A398655 #4 Aug 16 2026 16:28:27
%S A398655 0,1,6,15,30,51,81,121,172,235,311,403,511,637,781,946,1133,1343,1577,
%T A398655 1836,2123,2438,2783,3158,3566,4008,4485,4998,5548,6138,6768,7440,
%U A398655 8154,8913,9718,10570,11470,12419,13420,14473,15580,16741,17959,19235,20570
%N A398655 Lower (1, 2/3) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398655 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398655 <a href="/index/Rec#order_10">Index entries for linear recurrences with constant coefficients</a>, signature (4,-6,3,3,-6,3,3,-6,4,-1).
%F A398655 a(n) = 4*a(n-1) - 6*a(n-2) + 3*a(n-3) + 3*a(n-4) - 6*a(n-5) + 3*a(n-6) + 3*a(n-7) - 6*a(n-8) + 4*a(n-9) - a(n-10) , with (a(0), ..., a(9)) =  (0, 1, 6, 15, 30, 51, 81, 121, 172, 235).
%t A398655 z = 60;
%t A398655 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398655 r = 1; s = 2/3;
%t A398655 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398655 Table[u[n], {n, 0, z}]
%Y A398655 Cf. A000217, A000330, A398656.
%K A398655 nonn,easy,new
%O A398655 0,3
%A A398655 _Clark Kimberling_, Aug 11 2026
