%I A398400 #13 Aug 04 2026 17:06:56
%S A398400 0,2,0,2,6,5,9,39,16,4,114,6,66,88,73,28,39,2,82,10,59,11,23,114,27,
%T A398400 43,151,23,167,25,31,100,101,63,174,147,316,31,2,31,43,131,421,22,79,
%U A398400 57,69,1091,196,142,48,306,171,82,98,270,432,169,688,615,171,8,566
%N A398400 a(n) is the least k such that the concatenation of prime(n+1), prime(n+2),..., prime(n+k) is a multiple of prime(n) or 0 if no such k exists.
%H A398400 Paolo P. Lava, <a href="/A398400/b398400.txt">Table of n, a(n) for n = 1..1000</a>
%e A398400 a(1) = 0 because any concatenation of prime numbers will always result in an odd number that is not a multiple of 2;
%e A398400 a(2) = 2 -> concatenation of 5 and 7 is 57 and 57/3 = 19;
%e A398400 a(3) = 0 because any concatenation of prime numbers will never end in 0 or 5 and cannot be a multiple of 5;
%e A398400 a(4) = 2 -> concatenation of 11 and 13 is 1113 and 1113/7 = 159;
%e A398400 a(5) = 6 -> concatenation of 13, 17, 19, 23, 29, 31 is 131719232931 and 131719232931/11 = 11974475721; etc.
%p A398400 P:=proc(q) local a,b,c,d,k,t; a:=ithprime(q); b:=nextprime(a); c:=b; d:=b; t:=1;
%p A398400 for k from 1 do if frac(c/a)=0 then t; break; else d:=nextprime(d); c:=c*10^length(d)+d;
%p A398400 t:=t+1; fi; od; end: 0,2,0,seq(P(n),n=4..60);
%o A398400 (PARI) a(n) = if(n == 1 || n == 3, return(0)); my(m = prime(n), q = nextprime(m+1), start = nextprime(q+1), c = q%m, res = 1); forprime(p = start, oo, res++; c = lift(Mod(c, m)*Mod(10, m)^#Str(p) + Mod(p, m)); if(c == 0, return(res))) \\ _David A. Corneth_, Jul 28 2026
%Y A398400 Cf. A069862.
%K A398400 nonn,base,easy
%O A398400 1,2
%A A398400 _Paolo P. Lava_, Jul 28 2026
