%N A398131 Next prime after the n-th semiprime.
%H A398131 Paolo Xausa, <a href="/A398131/b398131.txt">Table of n, a(n) for n = 1..10000</a>
%F A398131 a(n) = A151800(A001358(n)).
%e A398131 a(1) = 5 since the 1st semiprime is 4 and the smallest prime greater than 4 is 5.
%e A398131 a(3) = 11 since the 3rd semiprime is 9 and the smallest prime greater than 9 is 11.
%e A398131 a(4) = 11 since the 4th semiprime is 10 and the smallest prime greater than 10 is 11.
%p A398131 map(nextprime,select(t -> NumberTheory:-Omega(t)=2, [$1..1000])); # _Robert Israel_, Aug 25 2026
%t A398131 NextPrime[Select[Range[250], PrimeOmega[#] == 2 &]] (* _Paolo Xausa_, Aug 25 2026 *)
