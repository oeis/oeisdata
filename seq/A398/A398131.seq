%S A398131 5,7,11,11,17,17,23,23,29,29,37,37,37,41,41,47,53,53,59,59,59,67,67,
%T A398131 71,79,79,83,89,89,89,97,97,97,97,107,113,127,127,127,127,127,127,131,
%U A398131 137,137,149,149,149,149,149,157,163,163,163,167,173,179,179,191,191,191,197,211,211,211,211,211,211,223
%N A398131 Next prime after the n-th semiprime.
%H A398131 Paolo Xausa, <a href="/A398131/b398131.txt">Table of n, a(n) for n = 1..10000</a>
%F A398131 a(n) = A151800(A001358(n)).
%e A398131 a(1) = 5 since the 1st semiprime is 4 and the smallest prime greater than 4 is 5.
%e A398131 a(3) = 11 since the 3rd semiprime is 9 and the smallest prime greater than 9 is 11.
%e A398131 a(4) = 11 since the 4th semiprime is 10 and the smallest prime greater than 10 is 11.
%p A398131 map(nextprime,select(t -> NumberTheory:-Omega(t)=2, [$1..1000])); # _Robert Israel_, Aug 25 2026
%t A398131 NextPrime[Select[Range[250], PrimeOmega[#] == 2 &]] (* _Paolo Xausa_, Aug 25 2026 *)
%o A398131 (Python)
%o A398131 from math import isqrt
%o A398131 from sympy import primepi, primerange, nextprime
%o A398131 from oeis_sequences.OEISsequences import bisection
%o A398131 def A398131(n):
%o A398131     def f(x): return int(n+x+((t:=primepi(s:=isqrt(x)))*(t-1)>>1)-sum(primepi(x//p) for p in primerange(s+1)))
%o A398131     return nextprime(bisection(f,n,n)) # _Chai Wah Wu_, Sep 09 2026
%Y A398131 Cf. A000040, A001358, A151800.
%K A398131 nonn,changed
