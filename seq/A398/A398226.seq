%T A398226 37,41,43,47,48,49,53,59,61,62,65,67,69,70,71,72,73,77,79,83,85,87,89,
%U A398226 90,91,97,101,103,104,107,109,113,115,119,121,125,127
%N A398226 Increasing greedy sequence starting with a(1) = 1 whose equally spaced triples are coprime.
%C A398226 All numbers in A166684 must be in this sequence.
%e A398226 a(6) = 7. This is because if a(6) were to equal 6, a(2), a(4), and a(6) would share a common factor of 2.
%o A398226 (Python)
%o A398226 from math import gcd
%o A398226 def valid(seq, x):
%o A398226     new_index = len(seq)
%o A398226     temp = seq + [x]
%o A398226     for k in range(1, (new_index)//2 + 1):
%o A398226         i = new_index - 2*k
%o A398226         if i >= 0:
%o A398226             a, b, c = temp[i], temp[i+k], temp[new_index]
%o A398226             if gcd(gcd(a, b), c) != 1:
%o A398226                 return False
%o A398226     return True
%o A398226 def generate_sequence(n):
%o A398226     seq = [1]
%o A398226     candidate = 2
%o A398226     while len(seq) < n:
%o A398226         if valid(seq, candidate):
%o A398226             seq.append(candidate)
%o A398226         candidate += 1
%o A398226     return seq
%o A398226 sequence = generate_sequence(100)
%o A398226 print(sequence)
%Y A398226 Cf. A000452, A003278, A166684.
%K A398226 nonn
