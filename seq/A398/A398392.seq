%S A398392 0,0,0,9,153,1371,7371,29478,95334,264810,653610,1470615,3067815,
%T A398392 6012909,11180253,19875996,33987996,56184228,90142884,140848245,
%U A398392 214925445,321061455,470472255,677480034,960143778,1341027246,1848027246,2515370403,3384676659,4506226305
%N A398392 a(n) is the number of inequivalent placements of 4 nonattacking rooks on an n X n board, up to rotations.
%C A398392 In other words, a(n) is the number of inequivalent ways to choose 4 squares on an n X n board with no two squares in the same row or column, with equivalence being up to rotations.
%H A398392 Janaka Rodrigo, <a href="/A398392/b398392.txt">Table of n, a(n) for n = 1..1000</a>
%H A398392 Janaka Rodrigo, <a href="/A398392/a398392.txt">Python code</a>.
%H A398392 <a href="/index/Rec#order_13">Index entries for linear recurrences with constant coefficients</a>, signature (5,-6,-10,29,-9,-36,36,9,-29,10,6,-5,1).
%F A398392 a(n) = (1/4)*(24*(binomial(n,4))^2 + 2*k*(k-1) + 2*(k^2)*(k-1)^2), for n >= 4, where k = floor(n/2).
%e A398392 n = 4 has following configurations:
%e A398392   - - - X   - - X -   - - - X   - - X -   - X - -   - X - -   - - X -   - X - -   - - X -
%e A398392   - - X -   - - - X   - X - -   - X - -   - - - X   - - X -   - - - X   - - - X   X - - -
%e A398392   - X - -   - X - -   - - X -   - - - X   - - X -   - - - X   X - - -   X - - -   - - - X
%e A398392   X - - -   X - - -   X - - -   X - - -   X - - -   X - - -   - X - -   - - X -   - X - -
%e A398392 Therefore a(4) = 9.
%t A398392 LinearRecurrence[{5,-6,-10,29,-9,-36,36,9,-29,10,6,-5,1},{0,0,0,9,153,1371,7371,29478, 95334,264810,653610,1470615,3067815},30] (* _Stefano Spezia_, Jul 28 2026 *)
