%I A398664 #4 Aug 25 2026 01:33:10
%S A398664 0,3,10,23,45,78,123,182,258,353,468,605,767,956,1173,1420,1700,2015,
%T A398664 2366,2755,3185,3658,4175,4738,5350,6013,6728,7497,8323,9208,10153,
%U A398664 11160,12232,13371,14578,15855,17205,18630,20131,21710,23370,25113,26940,28853
%N A398664 Upper (3/2, 1) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398664 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398664 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398664 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) =  (0, 3, 10, 23, 45, 78).
%F A398664 G.f.: -(x (-3 + 2*x - 4*x^2 + x^3)/((-1 + x)^4 *(1 + x^2))).
%t A398664 z = 60;
%t A398664 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398664 r = 3/2; s = 1;
%t A398664 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398664 Table[v[n], {n, 0, z}]
%Y A398664 Cf. A000217, A000330, A398663.
%K A398664 nonn,easy,new
%O A398664 0,2
%A A398664 _Clark Kimberling_, Aug 24 2026
