%I A398657 #4 Aug 16 2026 16:28:20
%S A398657 0,2,10,27,55,97,157,238,342,472,632,825,1053,1319,1627,1980,2380,
%T A398657 2830,3334,3895,4515,5197,5945,6762,7650,8612,9652,10773,11977,13267,
%U A398657 14647,16120,17688,19354,21122,22995,24975,27065,29269,31590,34030,36592,39280
%N A398657 Lower (1, 3/2) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398657 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398657 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398657 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6) , with (a(0), ..., a(5)) =  (0, 2, 10, 27, 55, 97).
%t A398657 z = 60;
%t A398657 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398657 r = 1; s = 3/2;
%t A398657 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398657 Table[u[n], {n, 0, z}]
%Y A398657 Cf. A000217, A000330, A398658.
%K A398657 nonn,easy,new
%O A398657 0,2
%A A398657 _Clark Kimberling_, Aug 11 2026
