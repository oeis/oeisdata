%T A398301 432,450,486,512,576,600,648,750,864,900,972,1024,1152,1200,1296,1350,
%U A398301 1458,1470,1500,1728,1800,1944,2048,2250,2304,2400,2592,2700,2916,2940,3000
%N A398301 Numbers k in A055932 such that k/rad(k) != m/rad(m) for m < k, where rad = A007947.
%H A398301 Michael De Vlieger, <a href="/A398301/b398301.txt">Table of n, a(n) for n = 1..10000</a>
%F A398301 a(n) = A398314(A397500(n)).
%e A398301 Let s = A055932 and t = A397500.
%e A398301 Table of n, t(n), a(n) for n = 1..14:
%e A398301    n  t(n)                    a(n)
%e A398301   ---------------------------------------------
%e A398301    1    1 = 1          s(1) =   1 = 1
%e A398301    2    2 = 2          s(3) =   4 = 2^2
%e A398301    3    4 = 2^2        s(5) =   8 = 2^3
%e A398301    4    8 = 2^3        s(7) =  16 = 2^4
%e A398301    5    3 = 3          s(8) =  18 = 2 * 3^2
%e A398301    6   16 = 2^4       s(11) =  32 = 2^5
%e A398301    7    6 = 2 * 3     s(12) =  36 = 2^2 * 3^2
%e A398301    8    9 = 3^2       s(14) =  54 = 2 * 3^3
%e A398301    9   32 = 2^5       s(16) =  64 = 2^6
%e A398301   10   12 = 2^2 * 3   s(17) =  72 = 2^3 * 3^2
%e A398301   11   18 = 2 * 3^2   s(20) = 108 = 2^2 * 3^3
%e A398301   12   64 = 2^6       s(22) = 128 = 2^7
%e A398301   13   24 = 2^3 * 3   s(23) = 144 = 2^4 * 3^2
%e A398301   14    5 = 5         s(24) = 150 = 2 * 3 * 5^2
%t A398301 (* First, load the Mathematica function f055932 from links at A397499, then: *)
%t A398301 rad[x_] := Times @@ FactorInteger[x][[All, 1]]; DeleteDuplicatesBy[Union@ Flatten@ f055932[5], #/rad[#] &]
