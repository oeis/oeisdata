%S A398187 1,2,1,10,3,1,78,17,4,1,824,142,26,5,1,10970,1569,236,37,6,1,176112,
%T A398187 21576,2760,366,50,7,1,3309110,355081,39572,4553,538,65,8,1,71219584,
%U A398187 6805296,672592,68408,7128,758,82,9,1,1727242866,148869153,13227804,1206405,112494,10689,1032,101,10,1
%N A398187 Triangle read by rows: T(n, k) = Sum_{j=0..n-k} ((n - k)! / j!) * n^j.
%C A398187 The sums may be referred to as generalized Schenker sums, since they reduce to A063170 when k = 0. For the relation to the generalized Ramanujan Q-function see A398484.
%C A398187 Define Y_{n, k} as the discrete random variable representing the number of items drawn uniformly at random with replacement from n bins until the first collision occurs, where a collision is defined as drawing an item that matches a bin already occupied. Assume that k bins are preoccupied, where 0 <= k <= n. The expected stopping time, that is, the average number of items drawn until this first collision occurs, is given by
%C A398187   E[Y_{n, k}] = Sum_{m=0..n-k} Product_{j=1..m} (1 - (k + j - 1) / n ) = T(n, k) / n^(n - k).
%C A398187   This formula generalizes the expected value for the classic birthday problem, which is the case when k = 0, corresponding to the expected number of people that must be considered before two people are found to share the same birthday, assuming birthdays are independent and uniformly distributed over the n possible days.
%D A398187 D. E. Knuth, The Art of Computer Programming, Vol. 1, Section 1.2.11.3.
%D A398187 Srinivasa Ramanujan, "Question 294." (1911) 3, 128; "On question 294." (1912) 4, 151-152. Journal of the Indian Mathematical Society.
%H A398187 Peter Luschny, <a href="/A398187/b398187.txt">Rows n = 0..140, flattened</a>.
%H A398187 H. Bergeron, E. M. F. Curado, J. P. Gazeau and L. M. C. S. Rodrigues, <a href="https://arxiv.org/abs/1309.6910">A note about combinatorial sequences and Incomplete Gamma function</a>, arXiv:1309.6910 [math.CO], 2013.
%H A398187 David Brink, <a href="https://doi:10.1007/s11139-011-9343-9">A (probably) exact solution to the Birthday Problem</a>, Ramanujan Journal, pp 223-238, (2012).
%H A398187 R. M. Corless, G. H. Gonnet, D. E. G. Hare, D. J. Jeffrey, and D. E. Knuth, <a href="https://web.archive.org/web/20160807085528/http://www.apmaths.uwo.ca/~rcorless/frames/PAPERS/LambertW/LambertW.ps">On the Lambert W Function</a>, Advances in Computational Mathematics, (5), 1996, pp. 329-359.
%H A398187 Digital Library of Mathematical Functions, <a href="https://dlmf.nist.gov/8.4">Incomplete Gamma Functions, Special Values</a>, Release 1.2.7, [8.4.9 and 8.4.11].
%H A398187 P. Flajolet, P. J. Grabner, P. Kirschenhofer and H. Prodinger, <a href="https://doi.org/10.1016/0377-0427(93)E0258-N">On Ramanujan's Q-Function</a>, Journal of Computational and Applied Mathematics 58 (1995), 103-116.
%H A398187 Helmut Prodinger, <a href="https://doi.org/10.37236/3309">An identity conjectured by Lacasse via the tree function</a>, Electronic Journal of Combinatorics, 20(3) (2013), #P7.
%H A398187 J. Riordan and N. J. A. Sloane, <a href="https://doi.org/10.1017/S1446788700007527">Enumeration of rooted trees by total height</a>, J. Austral. Math. Soc., vol. 10 pp. 278-282, 1969.
%F A398187 T(n, k) = HypergeometricU[-(n-k), -(n-k), n]. (Tricomi/Kummer)
%F A398187 Note that the analytic expression in k does not require k >= 0. For instance, for k = -1 the formula becomes U(-1-n, -1-n, n), is defined for n >= -1, and yields A217701.
%F A398187 T(n, k) = (n - k)! * [x^(n-k)] (exp(n*x) / (1 - x)). (EGF)
%F A398187 E[Y_{n, k}] = ((n - k)! / n^(n-k)) * [x^(n-k)] (exp(n*x) / (1 - x)).
%F A398187 T(n, k) = Integral_{t=0..oo} exp(-t) * (n + t)^(n - k) dt.
%F A398187 T(n, k) = exp(n) * Gamma(n - k + 1, n).
%F A398187 T(n, k) = n^(n - k) * hypergeom([k - n, 1], [], -1/n) for n >= 1.
%F A398187 T(n, k) = Sum_{j=0..n-k+1} RisingFactorial(j+1, n-k-j) * n^j.
%F A398187 T(n, k) = Sum_{j=0..m} binomial(m, j) * D(j) * (n + 1)^(m - j) where m = n - k and D are the derangement number A000166.
%F A398187 T(n, k) = perm(n - k, n + 1) where perm(m, d) denotes the permanent of the m X m matrix with all diagonal entries equal to d and all off-diagonal entries equal to 1.
%F A398187 T(n, k) = (n - k) * T(n, k+1) + n^(n - k) for 0 <= k < n and T(n, n) = 1.
%F A398187 T(k + m, k) = exp(k + m) * Gamma(m + 1, k + m).
%F A398187 T(k + m, k) = m! * [z^m] (exp(k*T(z)) / (1 - T(z))^2), where T(z) = -W(-z) is the tree function and W Lambert's function.
%e A398187 Triangle starts:
%e A398187   [0] [       1]
%e A398187   [1] [       2,       1]
%e A398187   [2] [      10,       3,      1]
%e A398187   [3] [      78,      17,      4,     1]
%e A398187   [4] [     824,     142,     26,     5,    1]
%e A398187   [5] [   10970,    1569,    236,    37,    6,   1]
%e A398187   [6] [  176112,   21576,   2760,   366,   50,   7,  1]
%e A398187   [7] [ 3309110,  355081,  39572,  4553,  538,  65,  8, 1]
%e A398187   [8] [71219584, 6805296, 672592, 68408, 7128, 758, 82, 9, 1]
%e A398187 .
%e A398187 If n = 4 and k = 1 then m = n - k = 3, d = n + 1 = 5, and T(4, 1) is the permanent of the matrix M = [[5, 1, 1], [1, 5, 1], [1, 1, 5]] where perm(A) = Sum_{sigma in S3} Product_{j=1..3} a(j, sigma(j)). Using the formula perm(m, d) = Sum_{j=0..m} binomial(m, j)* D(m - j)*d^j with D(n) the derangements, we get 2 + 15 + 0 + 125 = 142.
%p A398187 T := (n, k) -> local j; add(((n-k)!/j!) * n^j, j = 0..n-k):
%p A398187 # Alternative:
%p A398187 T := (n, k) -> exp(n) * GAMMA(n - k + 1, n):
%p A398187 seq(print(seq(simplify(T(n, k)), k = 0..n)), n = 0..9);
%t A398187 T[n_Integer, k_Integer] := HypergeometricU[k-n, k-n, n]
%t A398187 (* Alternative: efficiently using elementary means *)
%t A398187 T[n_Integer, k_Integer] := Module[{m = n - k},
%t A398187   If[m < 0, Return[0]]; If[m == 0, Return[1]];
%t A398187   Fold[#1 * n + #2 &, 1, FoldList[Times, Range[m, 1, -1]]]]
%t A398187 Table[T[n, k], {n, 0, 8}, {k, 0, n}] // TableForm
%t A398187 (* Alternative: row n *)
%t A398187 Trow[n_] := Module[{c = CoefficientList[Series[Exp[n x] / (1 - x), {x, 0, n}], x]}, Reverse[Table[m! c[[m + 1]], {m, 0, n}]]];
%t A398187 Table[Trow[n], {n, 0, 9}] // TableForm
%t A398187 (* Alternative: column k, 0-indexed -> T(k,k), ..., T(k+len-1,k) *)
%t A398187 (* Works also for negative k, for example k = -1 yields A217701. *)
%t A398187 treeT[z_] := -ProductLog[-z]
%t A398187 column[k_][m_] := m! SeriesCoefficient[Exp[k*treeT[z]]/(1 - treeT[z])^2, {z, 0, m}]
%t A398187 Tcol[k_, len_] := Table[column[k][m], {m, 0, len - 1}]
%o A398187 (SageMath)
%o A398187 def T(n, k): return sum(rising_factorial(i+1, n-k-i) * n^i for i in range(n-k+1))
%o A398187 T = [[T(n, k) for k in range(n+1)] for n in range(10)]
%o A398187 for row in T: print(row)
%o A398187 (Python)
%o A398187 def T(n: int, k: int) -> int:
%o A398187     m = n - k
%o A398187     if m == 0: return 1
%o A398187     v = 1; F = 1
%o A398187     for s in range(1, m + 1):
%o A398187         F *= (m - s + 1)
%o A398187         v = v * n + F
%o A398187     return v
%o A398187 print([[T(n, k) for k in range(n+1)] for n in range(9)])
%o A398187 (Python)
%o A398187 def Trow(n):  # horizontal recurrence
%o A398187     T = [0] * (n + 1)
%o A398187     T[n] = 1; power = 1
%o A398187     for k in range(n - 1, -1, -1):
%o A398187         power *= n  # power = n^(n-k)
%o A398187         T[k] = (n - k) * T[k + 1] + power
%o A398187     return T
%Y A398187 Cf. A063170 (column 0), A001865 (column 1), A001863 (column 2), A129137 (column 3), A398191 (column 4), A398188 (row sums), A398190 (central terms), A398189 (2-adic valuation).
%Y A398187 Cf. A000166, A217701 (column -1), A063169, A090878/A036505, A398484.
