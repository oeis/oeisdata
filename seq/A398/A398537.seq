%T A398537 184289936006234458,120508805959476451901,96575983018429159702260,
%U A398537 93073061645620510405290481,106184796642202631069029624390,141526562904597794123602655350525,217893238913860187092206070732937776
%N A398537 a(n) is the permanent of the symmetric tridiagonal Toeplitz n X n matrix M_n where M_n(j,k) = n^2+1 for j = k, M_n(j,k) = n for abs(j-k) = 1, M_n(j,k) = 0 otherwise.
%H A398537 Wikipedia, <a href="https://en.wikipedia.org/wiki/Toeplitz_matrix">Toeplitz matrix</a>.
%F A398537 a(n) = Sum_{k=0..floor(n/2)} binomial(n-k,k)*(n^2+1)^(n-2*k)*n^(2*k).
%F A398537 a(n) = (1 + n^2)^n*hypergeom([(1-n)/2, -n/2], [-n], -4*n^2/(1+n^2)^2).
%e A398537 a(5) = 13687726:
%e A398537   [26  5  0  0  0]
%e A398537   [ 5 26  5  0  0]
%e A398537   [ 0  5 26  5  0]
%e A398537   [ 0  0  5 26  5]
%e A398537   [ 0  0  0  5 26]
%t A398537 M[j_,k_,n_]:=If[j==k,n^2+1,If[Abs[j-k]==1,n,0]]; a[0]=1;a[n_]:=Permanent[Table[M[j,k,n],{j,n},{k,n}]]; Array[a,16,0]
%t A398537 (* Alternative: *)
%t A398537 Unprotect[Power]; Power[0,0]:=1; Protect[Power]; a[n_]:=Sum[Binomial[n-k,k]*(n^2+1)^(n-2k)*n^(2*k),{k,0,Floor[n/2]}]; Array[a,16,0]
%t A398537 (* Alternative: *)
%t A398537 a[n_]:=(1+n^2)^n*Hypergeometric2F1[(1-n)/2,-n/2,-n,-4*n^2/(1+n^2)^2]; Array[a,16,0]
%Y A398537 Cf. A174964, A368888, A386975.
%K A398537 nonn,new
