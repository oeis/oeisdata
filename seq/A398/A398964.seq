%T A398964 441,484,529,720,725,676,1215,980,841,900,961,1280,1089,1156,1225,
%U A398964 2700,1369,1444,1521,2000,1681,1764,1849,2420,3375,2116,2209,2880,2695,2900,2601,3380,2809,4860,3025,3920,3249,3364,3481,4500
%N A398964 Number of solutions of x^3 + y^3 = z^2 in (Z/nZ)^3.
%F A398964 Multiplicative with a(p) = p^2 for every prime p.
%F A398964 For primes p >= 5 and k >= 2, a(p^k) = p^(2k-2)*(p^2 + p - 1).
%F A398964 For every prime p and k >= 7, a(p^k) = p^2*a(p^(k-1)) + p^11*a(p^(k-6)) - p^13*a(p^(k-7)).
%F A398964 a(2^k) = [x^k] (1 + 4*x^2 - 1024*x^6)/((1 - 4*x)*(1 - 2048*x^6)).
%F A398964 a(3^k) = [x^k] (1 + 54*x^2 - 59049*x^6)/((1 - 9*x)*(1 - 177147*x^6)).
%F A398964 a(n) = n^2 exactly when n is squarefree.
%e A398964 a(2) = 4: the solutions (x,y,z) in (Z/2Z)^3 of x^3+y^3=z^2 are (0,0,0), (1,1,0), (0,1,1), (1,0,1).
%o A398964 (Python)
%o A398964 def a(n):
%o A398964     cubes=[(x*x*x)%n for x in range(n)]
%o A398964     sq=[0]*n
%o A398964     for z in range(n): sq[(z*z)%n]+=1
%o A398964     from collections import Counter
%o A398964     C=Counter()
%o A398964     for cx in cubes:
%o A398964         for cy in cubes: C[(cx+cy)%n]+=1
%o A398964     return sum(cnt*sq[v] for v,cnt in C.items())
%o A398964 print([a(n) for n in range(1,61)])
%Y A398964 Cf. A099426, A115075, A351600.
%K A398964 nonn,mult,new
%O A398964 1,2
