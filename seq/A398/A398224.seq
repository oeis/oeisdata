%S A398224 24,120,168,360,735,840,1224,1680,1848,3480,3720,4095,4488,5040,5775,
%T A398224 6560,6888,7224,8280,9801,10050,10200,10608,10692,11880,12320,13923,
%U A398224 14175,15624,17160,18768,19320,22800,24024,28560,30975,31212,32040,32760,33516,36480,41208,48749,51300
%N A398224 Numbers k such that there is a square bigger than k among divisors of triangular(k), and a triangular number bigger than k among divisors of k^2.
%o A398224 (Python)
%o A398224 from sympy import integer_nthroot, divisors
%o A398224 from sympy.ntheory.primetest import is_square
%o A398224 def istri(n): return integer_nthroot(8*n+1, 2)[1]
%o A398224 def isok(n):
%o A398224     s = n*n
%o A398224     t = n*(n+1)//2
%o A398224     c=0
%o A398224     for x in divisors(s):
%o A398224         if x>n and istri(x):
%o A398224             c=1
%o A398224             break
%o A398224     if c==0: return False
%o A398224     for x in divisors(t):
%o A398224         if x>n and is_square(x):
%o A398224             return True
%o A398224     return False
%o A398224 print([n for n in range(60000) if isok(n)])
%Y A398224 Cf. A000217, A000290.
%K A398224 nonn,new
%O A398224 1,1
