%I A398701 #7 Aug 10 2026 05:05:57
%S A398701 1,5,10,5,57,47,335,10,32,37,2083,95,1241,361,1849,293,10247,23,438,
%T A398701 769,76,60607,1415591,187,466,12503,12653,2399,70221,267,40986,241,
%U A398701 4427,77489,268764,4796,177557,186763,1207922,3242,26704,53,15874,20952,126211,294920,13975123,1841
%N A398701 a(n) = numerator(Sum_{k=1..n} psi(floor(n/k))/floor(n/k)), where psi the Dedekind psi function (A001615).
%H A398701 Amiram Eldar, <a href="/A398701/b398701.txt">Table of n, a(n) for n = 1..10000</a>
%H A398701 Jing Ma and Huayan Sun, <a href="https://doi.org/10.1007/s11139-022-00588-y">On a sum involving certain arithmetic functions and the integral part function</a>, The Ramanujan Journal, Vol. 60, No. 4 (2023), pp. 1025-1032; <a href="https://doi.org/10.1007/s11139-026-01336-2">Correction</a>, ibid., Vol. 69 (2026); <a href="https://arxiv.org/abs/2109.02924">arXiv preprint</a>, arXiv:2109.02924 [math.NT], 2021; <a href="https://www.researchgate.net/publication/361229857">ResearchGate link</a>. See Theorem 1, p. 1027.
%F A398701 a(n)/A398702(n) = c * n + O(n^(1/3)*log(n)), where c = 1.231799... = A398703 (Ma and Sun, 2023).
%e A398701 Fractions begin with 1, 5/2, 10/3, 5, 57/10, 47/6, 335/42, 10, 32/3, 37/3, 2083/165, 95/6, ...
%t A398701 f[n_] := f[n] = Times @@ (1 + 1/FactorInteger[n][[;;, 1]]); f[1] = 1;
%t A398701 a[n_] := Numerator[Sum[f[Floor[n/k]], {k, 1, n}]]; Array[a, 48]
%o A398701 (PARI) f(n) = {my(p = factor(n)[,1]); prod(i = 1, #p, 1 + 1/p[i]);}
%o A398701 a(n) = numerator(sum(k = 1, n, f(n\k)));
%Y A398701 Cf. A001615, A332880, A398698, A398702 (denominators), A398703.
%K A398701 nonn,frac,easy,new
%O A398701 1,2
%A A398701 _Amiram Eldar_, Aug 07 2026
