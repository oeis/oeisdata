%I A398158 #4 Aug 03 2026 19:25:29
%S A398158 11,29,31,37,41,43,44,54,57,78,79,99,121,128,143,158,163,166,168,179,
%T A398158 186,189,198,207,213,244,283,290,306,330,359,360,387,390,398,413,417,
%U A398158 458,459,464,486,492,495,500,522,526,528,532,544,548,552,556,593,600,601
%N A398158 Numbers k such that A398155(k + 1) = A398155(k).
%C A398158 The terms are the positions of the plateaus in A398155, i.e., the values k for which the same regular polygon determines both the first k and the first k + 1 digits after the decimal point of Pi using the classical inscribed and circumscribed polygonal bounds.
%C A398158 Unlike the analogous sequence associated with A398156, these plateau positions are not determined by the positions of a single digit in the decimal expansion of Pi.
%C A398158 Some terms are positions of zeros in the decimal expansion of Pi (A037008), for example 121, 128, 207, 330, 360, and 398, but there is no direct equivalence.
%e A398158 11 is a term because A398155(11) = A398155(12) = 7070162.
%e A398158 29 is a term because A398155(29) = A398155(30) = 4559690838310382.
%p A398158 A398158 := proc(n) option remember;
%p A398158     local k;
%p A398158     if n = 1 then return 11 end if;
%p A398158     for k from A398158(n - 1) + 1 do
%p A398158         if A398155(k + 1) = A398155(k) then
%p A398158             return k
%p A398158         end if
%p A398158     end do
%p A398158 end proc:
%p A398158 seq(A398158(n), n = 1 .. 55);
%Y A398158 Cf. A398155, A398156.
%K A398158 nonn,new
%O A398158 1,1
%A A398158 _Felix Huber_, Jul 27 2026
