%I A398654 #4 Aug 16 2026 16:28:31
%S A398654 0,2,5,11,20,34,52,75,104,140,184,235,295,364,444,534,635,748,874,
%T A398654 1014,1167,1335,1518,1718,1934,2167,2418,2688,2978,3287,3617,3968,
%U A398654 4342,4738,5157,5600,6068,6562,7081,7627,8200,8802,9432,10091,10780,11500,12252
%N A398654 Upper (1, 1/3) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398654 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398654 <a href="/index/Rec#order_10">Index entries for linear recurrences with constant coefficients</a>, signature (4,-6,3,3,-6,3,3,-6,4,-1).
%F A398654 a(n) = 4*a(n-1) - 6*a(n-2) + 3*a(n-3) + 3*a(n-4) - 6*a(n-5) + 3*a(n-6) + 3*a(n-7) - 6*a(n-8) + 4*a(n-9) - a(n-10) , with (a(0), ..., a(9)) =  (0, 2, 5, 11, 20, 34, 52, 75, 104, 140).
%t A398654 z = 60;
%t A398654 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398654 r = 1; s = 1/3;
%t A398654 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398654 Table[v[n], {n, 0, z}]
%Y A398654 Cf. A000217, A000330, A398653.
%K A398654 nonn,easy
%O A398654 0,2
%A A398654 _Clark Kimberling_, Aug 11 2026
