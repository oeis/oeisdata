%I A398577 #8 Aug 31 2026 18:03:54
%S A398577 1,1,1,1,1,2,1,1,1,1,1,2,1,1,2,1,1,2,1,2,1,1,1,2,1,1,1,2,1,2,1,1,1,1,
%T A398577 1,2,1,1,1,2,1,2,1,1,2,1,1,2,1,1,1,1,1,2,1,2,1,1,1,3,1,1,2,1,1,2,1,1,
%U A398577 1,2,1,3,1,1,2,1,1,2,1,2,1,1,1,3,1,1,1,2
%N A398577 a(n) is the maximum number of unordered representations of an integer as a sum of two positive divisors of n.
%C A398577 Let D(n) be the set of positive divisors of n. Then a(n) = 1 if and only if D(n) is a Sidon set.
%C A398577 This sequence is unbounded. Indeed, if L = lcm(1, 2, ..., 2*k - 1), then the integer 2*k has the k representations j + (2*k - j), 1 <= j <= k, as a sum of two divisors of L.
%C A398577 This sequence is distinct from A250068. For example, the positive divisors of 35 have pairwise distinct unordered sums, so a(35) = 1, while A250068(35) = 2.
%H A398577 Felix Huber, <a href="/A398577/b398577.txt">Table of n, a(n) for n = 1..10000</a>
%F A398577 a(n) = max_s #{d | n: d <= s - d and s - d | n}.
%F A398577 1 <= a(n) <= ceiling(A000005(n)/2).
%F A398577 a(m*n) >= a(n) for all positive integers m and n.
%F A398577 a(p^k) = 1 for every prime p and k >= 0.
%F A398577 For primes p < q, a(p*q) = 2 if q = 2*p - 1, and a(p*q) = 1 otherwise.
%F A398577 a(lcm(1, 2, ..., 2*k - 1)) >= k.
%F A398577 a(n) = 1 if and only if A398434(n) = A000005(n), equivalently A398435(n) = 0.
%F A398577 a(n) > 1 if and only if n is divisible by a term of A398433.
%F A398577 a(n) <= A398435(n) + 1.
%F A398577 a(n) <= A000005(n) - A398434(n) + 1.
%e A398577 a(6) = 2 since 4 = 1 + 3 = 2 + 2, and no sum of two divisors of 6 has more than two representations.
%e A398577 a(60) = 3 since 6 = 1 + 5 = 2 + 4 = 3 + 3, and no sum of two divisors of 60 has more than three representations.
%p A398577 A398577 := proc(n) option remember;
%p A398577     local c, d, i, j, m, s;
%p A398577     d := sort([op(NumberTheory:-Divisors(n))]);
%p A398577     c := table();
%p A398577     m := 0;
%p A398577     for i to nops(d) do
%p A398577         for j from i to nops(d) do
%p A398577             s := d[i] + d[j];
%p A398577             if assigned(c[s]) then
%p A398577                 c[s] := c[s] + 1
%p A398577             else
%p A398577                 c[s] := 1
%p A398577             end if;
%p A398577             if c[s] > m then
%p A398577                 m := c[s]
%p A398577             end if
%p A398577         end do
%p A398577     end do;
%p A398577     return m
%p A398577 end proc:
%p A398577 seq(A398577(n), n = 1 .. 88);
%Y A398577 Cf. A000005, A001221, A250068, A398433, A398434, A398435.
%K A398577 nonn,easy,new
%O A398577 1,6
%A A398577 _Felix Huber_, Aug 24 2026
