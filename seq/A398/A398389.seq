%S A398389 8,12,14,16,20,22,24,26,28,30,32,36,38,40,42,44,46,48,50,52,54,56,58,
%T A398389 60,62,64,68,70,72,74,76,78,80,82,84,86,88,90,92,94,96,98,100,102,104,
%U A398389 106,108,110,112,114,116,118,120,122,124,126,128,132,134,136,138,140,142,144,146,148,150
%N A398389 Even positive numbers m such that m - 2^k is composite for all k > 0 with 2^k < m.
%C A398389 Equivalently, numbers m > 2 that have not representation of the form m = p+2^k, with p = 2 and k > 0 (A052548).
%C A398389 Subsequence of even terms of A397305; differs from A397305 at a(57) = 128 while A397305(57) = 127.
%D A398389 Equals (A299174 \ {2}) \ (A052548 \ {3}).
%D A398389 Equals A397305 \ (A006285 \ {1}).
%e A398389 30 is a term as 30-2, 30-4, 30-8, 30-16, i.e., 28, 26, 22 and 14 are all composites.
%t A398389 q[m_] := Module[{i = 2}, While[i < m && CompositeQ[m-i], i *= 2]; i >= m]; Select[Range[4, 150, 2], q] (* _Amiram Eldar_, Jul 28 2026 *)
%o A398389 (PARI) isok(m) = if (!(m%2) && (m>2), #select(isprime, vector(logint(m, 2), i, m - 2^i)) == 0); \\ _Michel Marcus_, Jul 28 2026
%Y A398389 Cf. A000079, A002808, A006285, A052548, A299174, A397305.
%K A398389 nonn
%O A398389 1,1
%A A398389 _Bernard Schott_, Jul 28 2026
