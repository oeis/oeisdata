%N A398913 Table read by rows: the number of functions f: [n] -> [n] where the longest initial run of strictly increasing values has length k.
%H A398913 Paolo Xausa, <a href="/A398913/b398913.txt">Table of n, a(n) for n = 0..11475</a> (rows 0..150 of triangle, flattened).
%F A398913 T(n, k) = k * binomial(n + 1, k + 1) * n^(n - k - 1) for k < n, T(n, n) = 1.
%e A398913 Triangle starts:
%e A398913   [0] [1]
%e A398913   [1] [0,      1]
%e A398913   [2] [0,      3,     1]
%e A398913   [3] [0,     18,     8,     1]
%e A398913   [4] [0,    160,    80,     15,    1]
%e A398913   [5] [0,   1875,   1000,   225,    24,  1]
%e A398913   [6] [0,  27216,  15120,  3780,   504,  35,  1]
%e A398913   [7] [0, 470596, 268912, 72030, 10976, 980, 48, 1]
%e A398913 .
%e A398913 Classifying the endomorphisms for n = 3:
%e A398913   T(3, 1) = 18 -> 111, 112, 113, 211, 212, 213, 221, 222, 223,
%e A398913                   311, 312, 313, 321, 322, 323, 331, 332, 333;
%e A398913   T(3, 2) = 8 -> 121, 122, 131, 132, 133, 231, 232, 233;
%e A398913   T(3, 3) = 1 -> 123.
%t A398913 A398913[n_, k_] := If[n == k, 1, k*Binomial[n + 1, k + 1]*n^(n - k - 1)];
%t A398913 Table[A398913[n, k], {n, 0, 10}, {k, 0, n}] (* _Paolo Xausa_, Aug 15 2026 *)
%o A398913 (Python)
%o A398913 from math import comb as binomial
%o A398913 def T(n: int, k: int) -> int:
%o A398913     if k == n: return 1
%o A398913     return k * binomial(n + 1, k + 1) * n ** (n - k - 1)
