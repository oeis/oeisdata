%I A398750 #16 Nov 14 2026 09:27:39
%S A398750 12,20,56,72,90,132,156,240,272,306,342,380,420,552,600,650,702,756,
%T A398750 812,992,1056,1260,1332,1560,1640,1892,1980,2070,2256,2352,2450,2550,
%U A398750 2652,2756,2862,2970,3080,3192,3540,3660,3906,4032,4160,4556,4692,5112,5256,5550
%N A398750 Nonsquarefree oblong numbers.
%C A398750 No oblong number n*(n + 1) > 2 is a prime power, since n and n + 1 are coprime. Hence the terms are exactly the oblong numbers in A126706 (neither squarefree nor prime powers). Also, n*(n + 1) is squarefree if and only if both n and n + 1 are squarefree, so A229882 and this sequence are complementary in A002378 \ {0}. A398749 is the subsequence of powerful terms.
%C A398750 The relative asymptotic density of this sequence within the oblong numbers is 1 - Product_{p prime} (1 - 2/p^2) = 1 - A065474 = 0.67736590106075532942... . - _Amiram Eldar_, Nov 13 2026
%H A398750 Michael De Vlieger, <a href="/A398750/b398750.txt">Table of n, a(n) for n = 1..10000</a>
%F A398750 Intersection of A002378 and A013929.
%F A398750 {a(n)} = A002378 \ A229882 \ {0}.
%F A398750 a(n) = m*(m + 1), where m runs through the positive integers not in A007674, that is, those for which m or m + 1 is in A013929.
%e A398750 Table of n, a(n) for n = 1..12, where a(n) = m*(m + 1) and the parentheses show the prime factorizations of m and m + 1:
%e A398750    n  a(n) =  m * (m+1)   factorizations
%e A398750    1    12 =  3 *  4    = (3)     * (2^2)
%e A398750    2    20 =  4 *  5    = (2^2)   * (5)
%e A398750    3    56 =  7 *  8    = (7)     * (2^3)
%e A398750    4    72 =  8 *  9    = (2^3)   * (3^2)
%e A398750    5    90 =  9 * 10    = (3^2)   * (2*5)
%e A398750    6   132 = 11 * 12    = (11)    * (2^2*3)
%e A398750    7   156 = 12 * 13    = (2^2*3) * (13)
%e A398750    8   240 = 15 * 16    = (3*5)   * (2^4)
%e A398750    9   272 = 16 * 17    = (2^4)   * (17)
%e A398750   10   306 = 17 * 18    = (17)    * (2*3^2)
%e A398750   11   342 = 18 * 19    = (2*3^2) * (19)
%e A398750   12   380 = 19 * 20    = (19)    * (2^2*5)
%t A398750 Select[Array[#*(# + 1) &, 120], Not @* SquareFreeQ]
%Y A398750 Cf. A002378, A007674, A013929, A065474, A126706, A229882, A398749.
%K A398750 nonn,easy,new
%O A398750 1,1
