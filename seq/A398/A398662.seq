%I A398662 #4 Aug 25 2026 01:33:14
%S A398662 0,2,7,17,35,63,102,154,222,308,413,539,689,865,1068,1300,1564,1862,
%T A398662 2195,2565,2975,3427,3922,4462,5050,5688,6377,7119,7917,8773,9688,
%U A398662 10664,11704,12810,13983,15225,16539,17927,19390,20930,22550,24252,26037,27907
%N A398662 Upper (1/2, 1) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398662 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398662 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398662 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) =  (0, 2, 7, 17, 35, 6).
%F A398662 G.f.: x*(2 - x + 3*x^2)/((-1 + x)^4 *(1 + x^2)).
%t A398662 z = 60;
%t A398662 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398662 r = 1/2; s = 1;
%t A398662 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398662 Table[v[n], {n, 0, z}]
%Y A398662 Cf. A000217, A000330, A398661.
%K A398662 nonn,easy,new
%O A398662 0,2
%A A398662 _Clark Kimberling_, Aug 24 2026
