%I A398433 #9 Aug 31 2026 17:54:37
%S A398433 6,15,20,28,63,70,88,91,99,110,130,153,190,208,231,266,272,286,304,
%T A398433 325,351,357,368,385,399,429,483,494,496,506,513,561,595,627,646,663,
%U A398433 682,703,715,725,741,748,759,783,836,850,861,884,897,928,935,946,962,969,1015
%N A398433 Numbers k such that the set of positive divisors of k is not a Sidon set, but the set of positive divisors of every proper divisor of k is a Sidon set.
%C A398433 Let D(n) be the set of positive divisors of n. A finite set S of integers is a Sidon set if all sums x + y with x, y in S and x <= y are distinct.
%C A398433 If n divides m, then D(n) is a subset of D(m). Therefore the property that D(n) is not a Sidon set is closed under taking multiples, and the terms are precisely the minimal elements under divisibility having this property.
%C A398433 Equivalently, the terms are the divisibility-minimal indices n such that A398434(n) < A000005(n), equivalently A398435(n) > 0, or equivalently A398577(n) > 1.
%C A398433 For distinct primes p < q with q = 2*p - 1, p*q is a term, since 1 + q = p + p. Conversely, these are precisely the terms of this sequence having exactly four positive divisors; they form A129521.
%C A398433 A nontrivial collision among pairwise sums has either the form a + c = 2*b for three distinct divisors, or the form a + b = c + d for four distinct divisors.
%H A398433 Felix Huber, <a href="/A398433/b398433.txt">Table of n, a(n) for n = 1..10000</a>.
%e A398433 6 is a term since D(6) = {1, 2, 3, 6} is not a Sidon set: the sum 4 has the two representations 1 + 3 and 2 + 2. The proper divisors of 6 are 1, 2 and 3, and their divisor sets {1}, {1, 2} and {1, 3} are all Sidon sets.
%e A398433 12 is not a term. Although D(12) is not a Sidon set, 6 is a proper divisor of 12 and D(6) is already not a Sidon set.
%p A398433 s := proc(n)
%p A398433     local d, i, j, u;
%p A398433     d := sort([op(NumberTheory:-Divisors(n))]);
%p A398433     u := {};
%p A398433     for i to nops(d) do
%p A398433         for j from i to nops(d) do
%p A398433             if member(d[i] + d[j], u) then
%p A398433                 return false
%p A398433             end if;
%p A398433             u := u union {d[i] + d[j]}
%p A398433         end do
%p A398433     end do;
%p A398433     return true
%p A398433 end proc:
%p A398433 p := proc(n)
%p A398433     local d;
%p A398433     if s(n) then
%p A398433         return false
%p A398433     end if;
%p A398433     for d in NumberTheory:-Divisors(n) do
%p A398433         if d < n and not s(d) then
%p A398433             return false
%p A398433         end if
%p A398433     end do;
%p A398433     return true
%p A398433 end proc:
%p A398433 A398433 := proc(n) option remember;
%p A398433     local k;
%p A398433     if n = 1 then
%p A398433         return 6
%p A398433     end if;
%p A398433     for k from A398433(n - 1) + 1 do
%p A398433         if p(k) then
%p A398433             return k
%p A398433         end if
%p A398433     end do
%p A398433 end proc:
%p A398433 seq(A398433(n), n = 1 .. 55);
%Y A398433 Cf. A000005, A091011, A119357, A119425, A129521, A398434, A398435, A398577.
%K A398433 nonn,new
%O A398433 1,1
%A A398433 _Felix Huber_, Aug 24 2026
