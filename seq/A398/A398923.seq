%S A398923 0,0,0,1,3,7,13,23,35,53,73,103,133,175,219,278,334,414,486,586,682,
%T A398923 802,912,1072,1206,1380,1548,1760,1942,2202,2412,2696,2956,3268,3548,
%U A398923 3943,4249,4645,5017,5487,5867,6403,6823,7385,7903,8497,9003,9741,10299
%N A398923 Number of distinct acute lattice trapezia of area at most n/2 with horizontal base.
%C A398923 The vertices of these trapezia form the pattern 1221.
%C A398923 a(n) is also the number of skew lattice trapezia of area at most n/2 whose vertices form the pattern 1212.
%C A398923 a(n) is also the number of solutions to the Diophantine inequality a*(b+2c+d) <= n, with a,b,c,d >= 1.
%F A398923 a(n) ~ zeta(3)/12*n^3
%e A398923 a(5) = 3: One trapezium of area 2 with vertices {(0,0), (1,1), (2,1), (3,0)}, and two trapezia of area 5/2 with vertices {(0,0), (1,1), (2,1), (4,0)} and {(0,0), (2,1), (3,1), (4,0)}.
%t A398923 a[n_] := Sum[(w-t-1)Floor[n/(w+t)], {w, 3, n-1}, {t, Min[w-2, n-w]}]; Array[a, 50]
%Y A398923 Partial sums of A398922.
%K A398923 nonn,new
%O A398923 1,5
