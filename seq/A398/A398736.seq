%N A398736 a(0) = 1; a(n) = Sum_{k=1..n} binomial(4*n-1,k) * a(n-k).
%F A398736 G.f. A(x) satisfies A(x) = (1-3*x) * (2*A(x/(1+x)^4) - 1).
%F A398736 3|a(n) for n > 0.
%o A398736 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(4*i-1, j)*v[i-j+1])); v;
