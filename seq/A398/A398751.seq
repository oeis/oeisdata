%I A398751 #18 Nov 25 2026 20:20:46
%S A398751 12,20,56,90,132,156,240,272,306,342,380,420,552,600,650,702,756,812,
%T A398751 992,1056,1260,1332,1560,1640,1892,1980,2070,2256,2352,2450,2550,2652,
%U A398751 2756,2862,2970,3080,3192,3540,3660,3906,4032,4160,4556,4692,5112,5256,5550,5700
%N A398751 Nonsquarefree oblong numbers that are not also Achilles numbers.
%C A398751 Oblong numbers that are neither squarefree nor powerful.
%C A398751 Intersection of A002378 and A332785.
%C A398751 An oblong number is powerful if and only if it is an Achilles number, since no oblong number is a perfect power.
%H A398751 Michael De Vlieger, <a href="/A398751/b398751.txt">Table of n, a(n) for n = 1..10000</a>
%F A398751 {a(n)} = A398750 \ A398749.
%F A398751 {a(n)} = A002378 \ U({0}, A229882, A398749).
%e A398751 72 = 8*9 = (2^3) * (3^2) is not a term because it is powerful (an Achilles number).
%e A398751 Table of n, a(n) for selected n:
%e A398751    n    a(n) = m * (m+1)
%e A398751   ---------------------------------------
%e A398751    1     12 =  3 *  4 = (3) * (2^2)
%e A398751    2     20 =  4 *  5 = (2^2) * (5)
%e A398751    3     56 =  7 *  8 = (7) * (2^3)
%e A398751    4     90 =  9 * 10 = (3^2) * (2 * 5)
%e A398751    5    132 = 11 * 12 = (11) * (2^2 * 3)
%e A398751    6    156 = 12 * 13 = (2^2 * 3) * (13)
%e A398751    7    240 = 15 * 16 = (3 * 5) * (2^4)
%e A398751    8    272 = 16 * 17 = (2^4) * (17)
%e A398751    9    306 = 17 * 18 = (17) * (2 * 3^2)
%e A398751   10    342 = 18 * 19 = (2 * 3^2) * (19)
%e A398751   14    600 = 24 * 25 = (2^3 * 3) * (5^2)
%e A398751   51   6480 = 80 * 81 = (2^4 * 5) * (3^4)
%t A398751 fQ[x_] := And[! SquareFreeQ[x], Min@ FactorInteger[x][[;; , -1]] == 1]; Select[Array[#*(# + 1) &, 120], fQ]
%o A398751 (PARI)
%o A398751 A005369(n) = if( n<0, 0, issquare(4*n + 1));
%o A398751 A389905(m) = (!issquarefree(m) && !ispowerful(m));
%o A398751 is_A398751(k) = (A005369(k) && A389905(k)); \\ _Antti Karttunen_, Nov 25 2026
%Y A398751 Cf. A002378, A052486, A229882, A332785, A398749, A398750.
%K A398751 nonn,easy,new
%O A398751 1,1
%A A398751 _Michael De Vlieger_ and _Charles Kusniec_, Nov 16 2026
