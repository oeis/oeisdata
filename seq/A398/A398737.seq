%U A398737 8943634910506356648,845571594043453495936,86029155716423782189296,9371992484432548340049216,1088469327353923208065957712,134255309295232973890444607352
%N A398737 a(0) = 1; a(n) = Sum_{k=1..n} binomial(5*n-1,k) * a(n-k).
%F A398737 G.f. A(x) satisfies A(x) = (1-4*x) * (2*A(x/(1+x)^5) - 1).
%F A398737 4|a(n) for n > 0.
%o A398737 (PARI) a_vector(n) = my(v=vector(n+1)); v[1]=1; for(i=1, n, v[i+1]=sum(j=1, i, binomial(5*i-1, j)*v[i-j+1])); v;
%Y A398737 Cf. A398734, A398735, A398736.
%K A398737 nonn,new
