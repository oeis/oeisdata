%N A398998 The binomial matrix of the Euler secant numbers. Square array read by ascending antidiagonals.
%C A398998 See the comments and links in A399000.
%H A398998 Peter Luschny, <a href="https://github.com/PeterLuschny/Gists/blob/main/GnomonicExpansionAndBinomialMatrices.ipynb">Gnomonic Expansion and Binomial Matrices</a>, a Python notebook.
%F A398998 A(n, n) = E(n), the Euler numbers.
%F A398998 A(n, k) = Sum_{m=0..d} binomial(d, m) * s^(d - m) * E(p + m), where d = abs(n - k), p = min(n, k), s = 1 if k <= n, otherwise -1.
%e A398998 The triangle of antidiagonals:
%e A398998   [0]    1;
%e A398998   [1]    1,   -1;
%e A398998   [2]    0,    0,    0;
%e A398998   [3]   -2,   -1,   -1,   2;
%e A398998   [4]    0,   -2,   -1,   2,  0;
%e A398998   [5]   16,    2,   -1,   1,  2, -16;
%e A398998   [6]    0,   16,    4,   0,  4, -16,   0;
%e A398998   [7] -272,  -16,   14,   5,  5, -14, -16, 272;
%e A398998   [8]    0, -272,  -32,  10,  5, -10, -32, 272,   0;
%e A398998   [9] 7936,  272, -256, -46,  5,  -5, -46, 256, 272, -7936;
%e A398998 .
%e A398998 The array starts:
%e A398998   [0]    1,   -1,    0,    2,    0,  -16,    0,  272, ...
%e A398998   [1]    1,    0,   -1,    2,    2,  -16,  -16,  272, ...
%e A398998   [2]    0,   -1,   -1,    1,    4,  -14,  -32,  256, ...
%e A398998   [3]   -2,   -2,   -1,    0,    5,  -10,  -46,  224, ...
%e A398998   [4]    0,    2,    4,    5,    5,   -5,  -56,  178, ...
%e A398998   [5]   16,   16,   14,   10,    5,    0,  -61,  122, ...
%e A398998   [6]    0,  -16,  -32,  -46,  -56,  -61,  -61,   61, ...
%e A398998   [7] -272, -272, -256, -224, -178, -122,  -61,    0, ...
%e A398998   [8]    0,  272,  544,  800, 1024, 1202, 1324, 1385, ...
%p A398998 # Using function 'binomial_matrix' from A399000.
%p A398998 BM := binomial_matrix(n -> euler(n)):
%p A398998 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A398998 seq(seq(BM(n-k, k), k = 0..n), n = 0..9);
%t A398998 (* Using function 'binomialMatrix' from A399000. *)
%t A398998 bM = binomialMatrix[EulerE];
%t A398998 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398998 (Python)  # Using function binomial_matrix from A399000.
%o A398998 from sympy import euler
%o A398998 M = binomial_matrix(euler)
%o A398998 for n in range(9): print([M(n, k) for k in range(9)])
