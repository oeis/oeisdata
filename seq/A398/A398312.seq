%U A398312 1148827468464178,15998272015730033,231567226925798837,3477580373132012388,54094893469221057895
%N A398312 G.f. A(x) satisfies: A(x) = 1 + x * A(x/(1 - 2*x)) / (1 - x)^2.
%F A398312 a(0) = a(1) = 1, a(2) = 3; a(n) = 2 * a(n-1) - a(n-2) + Sum_{k=1..n-1} binomial(n-2,k-1) * 2^(n-k-1) * a(k) for n >= 3.
%t A398312 nmax = 22; A[_] = 0; Do[A[x_] = 1 + x A[x/(1 - 2 x)]/(1 - x)^2 + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%t A398312 (* Alternative: *)
%t A398312 a[0] = a[1] = 1; a[2] = 3; a[n_] := a[n] = 2 a[n - 1] - a[n - 2] + Sum[Binomial[n - 2, k - 1] 2^(n - k - 1) a[k], {k, 1, n - 1}]; Table[a[n], {n, 0, 22}]
%Y A398312 Cf. A007405, A040027.
%K A398312 nonn,new
