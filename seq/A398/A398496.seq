%U A398496 8,3,6,1,12,1,7,2,1,2,5,2,8,1,5,3,12,2,6
%N A398496 a(n) is the least k > 0 such that k*n is a factorial base Niven number.
%C A398496 The sequence is well defined as factorial numbers are factorial base Niven numbers and each positive integer divides infinitely many factorial numbers.
%H A398496 Rémy Sigrist, <a href="/A398496/b398496.txt">Table of n, a(n) for n = 1..100000</a>
%H A398496 <a href="/index/Fa#facbase">Index entries for sequences related to factorial base representation</a>
%F A398496 a(n) = A398431(n) / n.
%e A398496 a(42) = A398431(42) / 42 = 126 / 42 = 3.
%o A398496 (PARI) a(n) = { for (k = 1, oo, my (r = k*n, s = 0); for (p = 2, oo, if (r==0, if ((k*n) % s==0, return (k), break;), s += r % p; r \= p;););); }
%Y A398496 Cf. A118363, A144261, A398431.
%K A398496 nonn,base
%O A398496 1,3
