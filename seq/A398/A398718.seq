%U A398718 1180319579174394003547,487150768978962426558786,285980446374218229390696015,238452384309842968801513686085,282096451953391712697800717330508
%N A398718 Number of right-Euclidean relations on an n-element labeled set.
%C A398718 A relation R is right-Euclidean if xRy and xRz imply yRz for all x, y, z.
%H A398718 Alois P. Heinz, <a href="/A398718/b398718.txt">Table of n, a(n) for n = 0..113</a>
%F A398718 E.g.f.: exp(x + Sum_{k>=1} x^k*exp((2^k-1)*x)/k!).
%F A398718 Binomial transform of A398475.
%e A398718 For n = 2, the 7 right-Euclidean relations are {}, {(1,1)}, {(2,2)}, {(1,1),(2,1)}, {(1,2),(2,2)}, {(1,1),(2,2)}, and {(1,1),(1,2),(2,1),(2,2)}.
%p A398718 b:= proc(n) b(n):= add(binomial(n, k)*(2^k-1)^(n-k), k=0..n) end:
%p A398718 g:= proc(n) option remember; `if`(n=0, 1,
%p A398718       add(binomial(n-1, j-1)*b(j)*g(n-j), j=1..n))
%p A398718     end:
%p A398718 a:= n-> add(g(j)*binomial(n,j), j=0..n):
%p A398718 seq(a(n), n=0..19);  # _Alois P. Heinz_, Sep 21 2026
%Y A398718 Cf. A001831, A398475.
%K A398718 nonn,new
%O A398718 0,2
