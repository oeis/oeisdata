%I A398774 #39 Nov 12 2026 20:52:22
%S A398774 1,2,3,6,9,11,13,15,17,21,24,28,32,35,39,42,46,49,52,56,59,62,65,68,
%T A398774 72,75,78,81,84,87,90,94,99,105,110,115,119,124,129,134,138,143,147,
%U A398774 152,156,161,165,170,174,180,184,188,193,197,201,206,210,214,219,223,227,231,236,240
%N A398774 Number of decimal digits in the sequence S = (n, 2*n, 3*n, ..., n^2).
%H A398774 Michael S. Branicky, <a href="/A398774/b398774.txt">Table of n, a(n) for n = 1..10000</a>
%F A398774 a(n) ~ 2*n*log(n).
%F A398774 a(n) = n + Sum_{i=1..n} floor(log_10(i*n)).
%e A398774 a(5) = 9 since the sequence S is (5, 2*5, 3*5, 4*5, 5*5) = (5, 10, 15, 20, 25); the number of decimal digits in each of these terms is (1, 2, 2, 2, 2) and 1 + 2 + 2 + 2 + 2 = 9.
%t A398774 a[n_]:=Total[IntegerLength[Range[n]*n]];Array[a,64] (* _James C. McMahon_, Nov 12 2026 *)
%o A398774 (JavaScript)
%o A398774 function a(n) {
%o A398774     let s = 0;
%o A398774     for (let i = 1; i <= n; i++) {
%o A398774         s += String(n * i).length;
%o A398774     }
%o A398774     return s;
%o A398774 }
%o A398774 (PARI) a(n) = sum(k=1, n, #digits(k*n)); \\ _Michel Marcus_, Nov 05 2026
%o A398774 (Python)
%o A398774 def a(n): return sum(len(str(i*n)) for i in range(1, n+1))
%o A398774 print([a(n) for n in range(1, 65)]) # _Michael S. Branicky_, Nov 05 2026
