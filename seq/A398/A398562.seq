%S A398562 0,0,1,12,188,2996,55594,1105017,25870716,757995652,23649329479,
%T A398562 874787038066,35833490333316,1535628110211272,71744081910331155,
%U A398562 3778011477285853123,221593785190284764121,13439632824601467231190,894489142948614412720604
%N A398562 Number of composite numbers less than the n-th primorial that are relatively prime to the (n-1)-th primorial.
%F A398562 a(n) = prime(n)*A005867(n-1) + n - 2 - A000849(n). - _Andrew Howroyd_, Aug 02 2026
%F A398562 a(n) = A005867(n) - A072236(n-1) + A066264(n-1).
%e A398562 Among the numbers smaller than 2*3*5, only 25 is the composite number that shares no factors with 6; therefore, a(3) = 1.
%e A398562 Among the numbers smaller than 2*3*5*7, the numbers 49, 77, 91, 121, 119, 133, 143, 161, 169, 187, 203 and 209 are composite numbers that share no factors with 30; therefore, a(4) = 12.
%o A398562 (PARI) a(n) = {if(n < 2, 0, my(g=vecprod(primes(n-1))); sum(k=2, g*prime(n), !isprime(k)&&gcd(k, g)==1))}
%Y A398562 Cf. A000849, A002110, A005867, A065898, A066264, A072236.
%K A398562 nonn,more
%O A398562 1,4
%A A398562 _V. Barbera_, Aug 02 2026
%E A398562 a(10)-a(19) using A000849 added by _Andrew Howroyd_, Aug 02 2026
