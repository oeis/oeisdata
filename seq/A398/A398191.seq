%S A398191 1,6,50,538,7128,112494,2063920,43210290,1017334656,26619931414,
%T A398191 766674644736,24108024415050,822014344084480,30214031263140222,
%U A398191 1191060605972293632,50132179806154814434,2244126307920949248000,106465127520583569432870,5336287028486793661579264
%N A398191 a(n) = n! * Sum_{j=0..n} (n + 4)^j / j!. Column 4 of A398187.
%C A398191 See formulas and references in A398187.
%F A398191 a(n) = U(-n, -n, n + 4) where U is Kummer's hypergeometric function.
%F A398191 a(n) = exp(n + 4)*Gamma(n + 1, n + 4).
%p A398191 a := n -> KummerU(-n, -n, n + 4): seq(simplify(a(n)), n = 0..18);
%t A398191 a[n_Integer] := Module[{m = n + 4}, If[n == 0, Return[1]]; Fold[#1 * m + #2 &, 1, FoldList[Times, Range[n, 1, -1]]]]; Table[a[n], {n, 0, 18}]
%t A398191 (* Alternative: applying Lagrange Inversion to W(-z) *)
%t A398191 A398191List[len_Integer] := If[len <= 0, {}, Prepend[Table[(n - 1)! (-1)^(n + 1) 2 SeriesCoefficient[(2 w + 3)/(1 + w)^3 Exp[-(n + 4) w], {w, 0, n - 1}],  {n, 1, len - 1} ], 1]]; A398191List[20]
%o A398191 (Python)
%o A398191 def a(n: int) -> int:
%o A398191     if n == 0: return 1
%o A398191     x = n + 4; v = 1; F = 1
%o A398191     for k in range(1, n + 1):
%o A398191         F *= (n - k + 1)
%o A398191         v = v * x + F
%o A398191     return v
%o A398191 A = [a(n) for n in range(19)]; print(A)
%Y A398191 Cf. A398187.
%K A398191 nonn,new
%O A398191 0,2
