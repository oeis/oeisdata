%U A398939 0,4,9,2,1,2,4,6,2,8,3,4,6,7,4,2,4,8,8,5,4,4
%N A398939 Decimal expansion of the surface area of a canonical (dual-uniform) 10-gonal trapezohedron with unit short edge length.
%C A398939 The 10-gonal trapezohedron is the dual polyhedron of the 10-gonal antiprism.
%H A398939 Paolo Xausa, <a href="/A398939/b398939.txt">Table of n, a(n) for n = 3..10000</a>
%H A398939 Polytope Wiki, <a href="https://polytope.miraheze.org/wiki/Decagonal_antitegum">Decagonal antitegum</a>.
%H A398939 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Trapezohedron.html">Trapezohedron</a>.
%H A398939 <a href="/index/Al#algebraic_08">Index entries for algebraic numbers, degree 8</a>.
%F A398939 Equals (10*csc(Pi/20)^2)*sqrt(4*cos(Pi/10) - 2*cos(Pi/5) + 1)/4 = (10*csc(Pi/20)^2)*sqrt(4*A019881 - A001622 + 1)/4.
%F A398939 Equals 5*sqrt(338 + 146*sqrt(5) + 4*sqrt(13850 + 6190*sqrt(5))).
%F A398939 Equals the largest real root of x^8 - 33800*x^6 + 18190000*x^4 + 698000000*x^2 + 4100000000.
%e A398939 182.35224002977038805714642334064313205503052754719...
%t A398939 First[RealDigits[10*Csc[Pi/20]^2*Sqrt[4*Cos[Pi/10] - 2*Cos[Pi/5] + 1]/4, 10, 100]]
%t A398939 (* Alternative: *)
%t A398939 First[RealDigits[PolyhedronData[{"Trapezohedron", 10}, "SurfaceArea"], 10, 100]]
%Y A398939 Cf. A398938 (volume), A398940 (inradius), A398941 (midradius), A398942 (height).
%Y A398939 Cf. A398943 (long edge).
%Y A398939 Cf. A398944 (small face angle), A398945 (large face angle), A398946 (dihedral angle).
%Y A398939 Cf. A395805 (surface area of the dual).
%Y A398939 Cf. A001622, A019881.
%K A398939 nonn,cons,easy,new
%O A398939 3,2
