%I A398858 #4 Sep 23 2026 01:31:53
%S A398858 0,2,9,20,35,55,79,107,140,177,218,264,314,368,427,490,557,629,705,
%T A398858 785,870,959,1052,1150,1252,1358,1469,1584,1703,1827,1955,2087,2224,
%U A398858 2365,2510,2660,2814,2972,3135,3302,3473,3649,3829,4013,4202,4395,4592,4794
%N A398858 Lower (4/3, 1)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398858 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398858 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398858 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 2, 9, 20, 35).
%F A398858 G.f.: -(x*(2 + 5*x + 4*x^2 + 2*x^3)/((-1 + x)^3 *(1 + x + x^2)).
%t A398858 z = 60;
%t A398858 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398858 r =4/3; s = 1;
%t A398858 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398858 Table[u[n], {n, 0, z}]
%Y A398858 Cf. A000217, A000326, A398859.
%K A398858 nonn,easy,new
%O A398858 0,2
%A A398858 _Clark Kimberling_, Sep 21 2026
