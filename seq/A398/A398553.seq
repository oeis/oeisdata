%S A398553 1,1,16,131,1148,8914,66514,464585,3097802,19720543,120661360,
%T A398553 711550763,4059293088,22459454626,120818856224,633193241692,
%U A398553 3238955718355,16196940334486,79294400862401,380527125037185,1792090246210107,8291120159766842,37718291778501841
%N A398553 Number of factorizations of (p*q*r)^n into parts > 1 where none of p, q, or r are permitted as factors, for any three distinct primes p, q, and r.
%C A398553 The number of factorizations of p^n * q^n * r^n depends only on the prime exponents (n, n, n) and is independent of the choice of distinct primes p, q, and r (such as 2, 3, and 5).
%C A398553 Equivalently, this sequence counts the number of 3D vector partitions of the vector (n, n, n) into parts drawn from {(i, j, k) | i >= 0, j >= 0, k >= 0} excluding the elementary basis vectors (1,0,0), (0,1,0), and (0,0,1), as well as (0,0,0).
%C A398553 This represents the 3D extension of A397646 to three prime factors.
%F A398553 a(n) = [x^n y^n z^n] H_3(x,y,z) where H_3(x,y,z) = Product_{i>=0, j>=0, k>=0, i+j+k>1} 1 / (1 - x^i * y^j * z^k).
%e A398553 a(1) = 1: for 2^1 * 3^1 * 5^1 = 30, the only factorization excluding 2, 3, and 5 as parts is {30}.
%e A398553 a(2) = 16: for 2^2 * 3^2 * 5^2 = 900, there are 16 factorizations excluding 2, 3, and 5 as parts.
%o A398553 (Python)
%o A398553 import numpy as np
%o A398553 def lista(n):
%o A398553     allowed = [(i, j, k) for i in range(n + 1) for j in range(n + 1) for k in range(n + 1) if (i, j, k) not in [(0, 0, 0), (1, 0, 0), (0, 1, 0), (0, 0, 1)]]
%o A398553     dp = np.zeros((n + 1, n + 1, n + 1), dtype=object)
%o A398553     dp[0, 0, 0] = 1
%o A398553     for vi, vj, vk in allowed:
%o A398553         for x in range(vi, n + 1):
%o A398553             for y in range(vj, n + 1):
%o A398553                 for z in range(vk, n + 1):
%o A398553                     dp[x, y, z] += dp[x - vi, y - vj, z - vk]
%o A398553     return [int(dp[m, m, m]) for m in range(0, n + 1)]
%o A398553 print(lista(22))
%Y A398553 Cf. A001055, A397646.
%K A398553 nonn,easy
%O A398553 0,3
