%p A398987 # Using function 'binomial_matrix' from A399000.
%p A398987 BM := binomial_matrix(n -> combinat:-fibonacci(n+1)+combinat:-fibonacci(n-1)):
%p A398987 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A398987 seq(seq(BM(n-k, k), k = 0..n), n = 0..10);
%t A398987 (* Using function 'binomialMatrix' from A399000. *)
%t A398987 bM = binomialMatrix[LucasL];
%t A398987 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398987 (Python)  # Using function binomial_matrix from A399000.
%o A398987 from mpmath import hyp2f1
%o A398987 def lucas(n) -> int: return int(2**(1-n)*hyp2f1((-n,2),(1-n,2),(1,2),5))
%o A398987 M = binomial_matrix(lucas)
%o A398987 for n in range(9): print([M(n, k) for k in range(9)])
