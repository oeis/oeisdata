%S A398956 29,137,191,245,407,461,515,569,677,731,785,893,947,1055,1163,1217,
%T A398956 1271,1379,1433,1487,1541,1649,1757,1811,1919,1973,2027,2135,2243,
%U A398956 2297,2405,2459,2513,2567,2675,2729,2783,2891,2945,2999,3161,3215,3269,3323,3377,3431,3485
%N A398956 Starts of runs of 26 consecutive odd numbers that are all cubefree.
%C A398956 26 is the largest possible length of such runs: one number in each run of 27 consecutive odd numbers is divisible by 27 = 3^3, and thus it is not cubefree.
%C A398956 The asymptotic density of this sequence is (1/2) * Product_{p prime >= 3} (1 - 26/p^3) = 0.012928006992878505468... .
%H A398956 Amiram Eldar, <a href="/A398956/b398956.txt">Table of n, a(n) for n = 1..10000</a>
%F A398956 a(n) == 29 (mod 54).
%t A398956 cubefreeQ[k_] := cubefreeQ[k] = Max @ FactorInteger[k][[;; , 2]] < 3;
%t A398956 Select[54*Range[0, 64] + 29, And @@ cubefreeQ /@ (# + Range[0, 50, 2]) &]
%o A398956 (PARI) iscubefree(k) = if(k == 1, 1, vecmax(factor(k)[, 2]) < 3);
%o A398956 isok(k) = if(k % 54 != 29, 0, forstep(i = 0, 50, 2, if(!iscubefree(k + i), return(0))); 1);
%Y A398956 Subsequence of A004709, A281546, and A381822.
%Y A398956 Similar sequences: A007675, A398951, A398953.
%K A398956 nonn,easy,new
%O A398956 1,1
%A A398956 _Amiram Eldar_, Aug 15 2026
