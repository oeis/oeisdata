%I A398866 #20 Aug 14 2026 11:19:55
%S A398866 0,1,8,132,5032,447520,91991724,43160128088,45662379654224,
%T A398866 107770496917647456,562127478241724899540,6427352036663258102311624,
%U A398866 159964271153235601780786802616,8612502510856677538010238593189072,997705184496706358496266298732104488316
%N A398866 Sum of 2^(in-degree of v) over nodes v in all acyclic digraphs on n labeled nodes.
%C A398866 a(n) is the number of triples (D,v,S), where D is an acyclic digraph on n labeled nodes, v is a node of D, and S is a subset of the in-neighbors of v.
%C A398866 This is also the sum of the numbers of free parameters over all Bayesian network structures on n labeled binary variables.
%C A398866 a(0) = 0 because the inner sum over the unique acyclic digraph on no nodes is empty.
%D A398866 D. Koller and N. Friedman, Probabilistic Graphical Models: Principles and Techniques, MIT Press, 2009.
%D A398866 R. W. Robinson, Counting labeled acyclic digraphs, pp. 239-273 of F. Harary, editor, New Directions in the Theory of Graphs. Academic Press, NY, 1973.
%F A398866 a(0) = 0; for n >= 1, a(n) = Sum_{k=1..n} (-1)^(k+1)*binomial(n,k)*(k*2^(k*(n-k))*A003024(n-k) + 3^k*2^(k*(n-k-1))*a(n-k)).
%F A398866 a(n) = n!*2^binomial(n,2)*[x^n] x*E(-x/2)/(E(-x)*E(-3*x/2)), where E(x) = Sum_{k>=0} x^k/(k!*2^binomial(k,2)).
%F A398866 n*A003024(n) <= a(n) <= (2^n - 1)*A003024(n).
%F A398866 From _Vaclav Kotesovec_, Aug 12 2026: (Start)
%F A398866 a(n) ~ c * d^n * n! * 2^(n*(n-1)/2), where
%F A398866 d = 3/(2*p) = 1.008011307222687792954271886274759...
%F A398866 c = 2*p*E(-p/3)/(3*M*E(-2*p/3)) = 4.15070748582736253733827899389...
%F A398866 p = A245654 = 1.4880785455997102946562460315823576618935161526...
%F A398866 E(-p/3) = 0.5629809116279431466527040621186311320813173597607...
%F A398866 E(-2*p/3) = 0.2342718766630675647084786899388679467356345229944...
%F A398866 M = A245655 = Sum_{j>=1} (-1)^(j+1)*p^j/((j-1)!*2^(j*(j-1)/2)) = 0.57436237330931147691667... (see A003024).
%F A398866 a(n)/A003024(n) ~ p * E(-p/3) * 3^(n-1) / (2^(n-1) * E(-2*p/3)). (End)
%t A398866 Table[n!*2^(n*(n-1)/2) * SeriesCoefficient[x*Sum[(-1)^k*x^k / (k!*2^(k*(k+1)/2)), {k, 0, n}] / (Sum[(-1)^k*x^k / (k!*2^(k*(k-1)/2)), {k, 0, n}] * Sum[(-1)^k*3^k*x^k / (k!*2^(k*(k+1)/2)), {k, 0, n}]), {x, 0, n}], {n, 0, 15}] (* _Vaclav Kotesovec_, Aug 12 2026 *)
%o A398866 (Python)
%o A398866 from math import comb
%o A398866 def a(n):
%o A398866     d = [1] + [0]*n
%o A398866     A = [0]*(n+1)
%o A398866     for m in range(1, n+1):
%o A398866         d[m] = sum((-1)**(k+1)*comb(m,k)*2**(k*(m-k))*d[m-k] for k in range(1, m+1))
%o A398866         A[m] = sum((-1)**(k+1)*comb(m,k)*(k*2**(k*(m-k))*d[m-k] + (3**k*2**(k*(m-k-1))*A[m-k] if k < m else 0)) for k in range(1, m+1))
%o A398866     return A[n]
%o A398866 print([a(n) for n in range(15)])
%o A398866 (PARI)
%o A398866 E(n,c) = sum(k=0, n, c^k*x^k/(k!*2^binomial(k,2)), O(x*x^n))
%o A398866 seq(n) = {my(g=x*E(n,-1/2)/(E(n,-1)*E(n,-3/2))); vector(n+1,k, k--; 2^binomial(k,2)*k!*polcoef(g,k))} \\ _Andrew Howroyd_, Aug 11 2026
%Y A398866 Cf. A003024, A081064, A397711, A397712.
%Y A398866 Cf. A245654, A245655.
%K A398866 nonn,new
%O A398866 0,3
%A A398866 _Kateryna Antoniuk_, Aug 11 2026
