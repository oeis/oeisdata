%I A398861 #5 Sep 24 2026 08:20:42
%S A398861 0,3,10,21,37,58,83,112,146,185,228,275,327,384,445,510,580,655,734,
%T A398861 817,905,998,1095,1196,1302,1413,1528,1647,1771,1900,2033,2170,2312,
%U A398861 2459,2610,2765,2925,3090,3259,3432,3610,3793,3980,4171,4367,4568,4773,4982
%N A398861 Upper (3/2, 1)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398861 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398861 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398861 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 3, 10, 21, 37).
%F A398861 G.f.: -x *(3 + x + 3 *x^2 + 2 *x^3)/((-1 + x)^3 *(1 + x^2)).
%F A398861 a(n) = ceiling(n*(9*n+1)/4). 2*a(n) +2*a(n-2) +(-9*n^2+17*n-18)=0. - _R. J. Mathar_, Sep 24 2026
%t A398861 z = 60;
%t A398861 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398861 r =3/2; s = 1;
%t A398861 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398861 Table[v[n], {n, 0, z}]
%Y A398861 Cf. A000217, A000326, A398860.
%K A398861 nonn,easy,new
%O A398861 0,2
%A A398861 _Clark Kimberling_, Sep 23 2026
