%p A398990 # Using function 'binomial_matrix' from A399000.
%p A398990 BM := binomial_matrix(combinat:-numbpart):
%p A398990 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A398990 seq(seq(BM(n-k, k), k = 0..n), n = 0..9);
%t A398990 (* Using function 'binomialMatrix' from A399000. *)
%t A398990 bM = binomialMatrix[PartitionsP];
%t A398990 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398990 (Python)  # Using function binomial_matrix from A399000.
%o A398990 from sympy.functions.combinatorial.numbers import partition
%o A398990 M = binomial_matrix(partition)
%o A398990 for n in range(8): print([M(n, k) for k in range(8)])
