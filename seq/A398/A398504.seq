%t A398504 (* A377091list is defined at A377091 *)
%t A398504 Table[Count[Select[Split[Sort[#[[;; n]]], #2 - # == 1 &], FreeQ[0]], _?NonNegative, {2}], {n, Length[#]}] & [A377091list[100]] (* _Paolo Xausa_, Aug 03 2026 *)
