%U A398970 1420379065,1462110625,1976295241,4471099129,4835661481,4929797809,7199034625,18390744505,18619575625,27575491825,38647202761
%N A398970 Weak Carmichael numbers of the form (6*m+1)*(12*m+1)*(18*m+1) where exactly one linear factor is composite.
%C A398970 This sequence is a superset of A242980 since it does not impose the square-freeness constraint.
%o A398970 (Magma) [ N where N := (6*m+1)*(12*m+1)*(18*m+1) : m in [1..10000] | #[x : x in [6*m+1,12*m+1,18*m+1] | not IsPrime(x)] eq 1 and &and[((6*m+1)*(12*m+1)*(18*m+1)-1) mod (p-1) eq 0 : p in PrimeDivisors((6*m+1)*(12*m+1)*(18*m+1))] ][1..25];
%Y A398970 Cf. A242980, A221742, A225498.
%K A398970 nonn,new
%O A398970 1,1
%A A398970 _Sebastian Ding_, Aug 15 2026
