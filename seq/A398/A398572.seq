%I A398572 #15 Aug 10 2026 16:21:21
%S A398572 0,1,1,2,1,2,1,2,2,2,1,3,1,2,2,3,1,3,1,3,2,2,1,3,2,2,2,3,1,3,1,2,2,2,
%T A398572 2,4,1,2,2,3,1,3,1,3,3,2,1,4,2,3,2,3,1,3,2,3,2,2,1,4,1,2,3,3,2,3,1,3,
%U A398572 2,3,1,4,1,2,3,3,2,3,1,4,3,2,1,4,2,2,2
%N A398572 a(n) = A001222(A000026(n)).
%C A398572 a(n) is the number of prime factors, counted with multiplicity, of the multiplicative projection of n.
%C A398572 This is also the level-2 Omega function bigomega_2, introduced by Bildhauser et al. (see links).
%C A398572 First differs from A106490 at n = 256, where a(256) = 4 while A106490(256) = 3.
%H A398572 Tymofii Kasian, <a href="/A398572/b398572.txt">Table of n, a(n) for n = 1..10000</a>
%H A398572 K. Bildhauser, J. Erickson, C. Tacoma, and R. Gillman, <a href="https://doi.org/10.2140/involve.2009.2.65">Divisor concepts for mosaics of integers</a>, Involve 2 (2009), 65-78.
%F A398572 Additive with a(p^e) = 1 + Omega(e).
%F A398572 a(n) = A001221(n) + A001222(A005361(n)).
%F A398572 a(n) = A001222(A007947(n) * A005361(n)).
%F A398572 a(m*n) = a(m) + a(n) if gcd(m,n) = 1.
%t A398572 f[p_, e_] := 1 + PrimeOmega[e]; a[1] = 0; a[n_] := Plus @@ f @@@ FactorInteger[n]; Array[a, 100] (* _Amiram Eldar_, Aug 03 2026 *)
%o A398572 (PARI) a(n) = my(f=factor(n)); bigomega(factorback(f[, 1])*factorback(f[, 2]));
%Y A398572 Cf. A000026, A001221, A001222, A005361, A007947, A106490, A395681.
%K A398572 nonn,easy,new
%O A398572 1,4
%A A398572 _Tymofii Kasian_, Aug 03 2026
