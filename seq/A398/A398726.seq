%T A398726 5255341289,74546457558,1124601946481,18185555928736,310570384717725,
%U A398726 5635383968297326,107513201801553917,2164395934638356424,45598443827918331449,1008832055178339744430
%N A398726 Sum of the distinct cycle sizes over all permutations of [n].
%H A398726 Alois P. Heinz, <a href="/A398726/b398726.txt">Table of n, a(n) for n = 0..448</a>
%H A398726 Wikipedia, <a href="https://en.wikipedia.org/wiki/Permutation">Permutation</a>
%F A398726 a(n) = Sum_{k=1..n} k * A293211(n,k).
%F A398726 a(n) mod 2 = A059841(n) for n>=2.
%F A398726 Conjecture: a(n) ~ n * n!. - _Vaclav Kotesovec_, Aug 14 2026
%e A398726 a(3) = 16 = 2*3 + 3*(1+2) + 1: (123), (132), (1)(23), (13)(2), (12)(3), (1)(2)(3).
%p A398726 T:=(n, k)-> n!*add((-1)^(j+1)*(1/k)^j/j!, j=1..floor(n/k)):
%p A398726 a:= n-> add(T(n, k)*k, k=1..n):
%p A398726 seq(a(n), n=0..21);
%Y A398726 Cf. A001563 (the same for all cycle sizes), A014153, A059841, A132961, A293211, A350175.
%K A398726 nonn,new
%O A398726 0,3
