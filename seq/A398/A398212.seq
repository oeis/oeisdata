%T A398212 1,8,6,3,8,7,7,0,0,1,3,5,1,6,3,0,3,2,6,7,9,9,6,9,5,2,2,3,1,8,0,3,4,6,
%U A398212 3,6,4,5,9,8,5,8,2,1,2,0,4,0,2,6,2,9,1,0,1,9
%N A398212 Decimal expansion of the inradius of a canonical (dual-uniform) octagonal trapezohedron with unit short edge length.
%C A398212 The octagonal trapezohedron is the dual polyhedron of the octagonal antiprism.
%H A398212 Paolo Xausa, <a href="/A398212/b398212.txt">Table of n, a(n) for n = 1..10000</a>
%H A398212 David I. McCooey, <a href="https://dmccooey.com/polyhedra/OctagonalTrapezohedron.html">Octagonal Trapezohedron</a>.
%H A398212 Polytope Wiki, <a href="https://polytope.miraheze.org/wiki/Octagonal_antitegum">Octagonal antitegum</a>.
%H A398212 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Trapezohedron.html">Trapezohedron</a>.
%H A398212 <a href="/index/Al#algebraic_08">Index entries for algebraic numbers, degree 8</a>.
%F A398212 Equals sin(Pi/8)*sqrt((3 - 2*cos(Pi/8))*(4 - sec(Pi/16)^2))/(2*(sqrt(2) + 8 - 10*cos(Pi/8))).
%F A398212 Equals the largest real root of 24064*x^8 - 101376*x^6 + 15040*x^4 + 96*x^2 - 1.
%e A398212 2.0145787773423723855626266440796321863877001351630...
%t A398212 First[RealDigits[Root[24064*#^8 - 101376*#^6 + 15040*#^4 + 96*#^2 - 1 &, 6], 10, 100]]
%t A398212 (* Alternative: *)
%t A398212 First[RealDigits[PolyhedronData[{"Trapezohedron", 8}, "Inradius"], 10, 100]]
%Y A398212 Cf. A398210 (volume), A398211 (surface area), A398213 (midradius), A398214 (height).
%Y A398212 Cf. A398215 (long edge).
%Y A398212 Cf. A398216 (small face angle), A398217 (large face angle), A398218 (dihedral angle).
%K A398212 nonn,cons,easy
%O A398212 1,1
%A A398212 _Paolo Xausa_, Jul 27 2026
