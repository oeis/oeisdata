%S A398607 1,1,12,115,862,6209,42049,269340,1643785,9609664,54051758,293569746,
%T A398607 1544500474,7892025951,39256178623,190464794529,902957324152,
%U A398607 4189235957651,19046346435376,84962667843416,372271768977667,1603750182546369,6799025614333125
%N A398607 Number of partitions of the 3-dimensional vector (n, n, n) into strictly distinct parts with nonnegative components, excluding elementary basis vectors (1,0,0), (0,1,0), and (0,0,1).
%C A398607 Also the number of factorizations of (p*q*r)^n into strictly distinct parts > 1 where none of p, q, or r are permitted as standalone factors, for any three distinct primes p, q, and r. The sequence depends only on the prime exponents (n, n, n) and is independent of the choice of distinct primes p, q, and r.
%C A398607 a(0) = 1 corresponds to the empty partition.
%C A398607 a(1) = 1 since the only valid partition of (1,1,1) avoiding the elementary basis vectors is {(1,1,1)} itself.
%C A398607 This sequence is the 3-dimensional strict prime-free diagonal.
%D A398607 P. A. MacMahon, Combinatory Analysis, Cambridge Univ. Press, London and New York, Vol. 1, 1915 and Vol. 2, 1916.
%F A398607 G.f.: [x^n y^n z^n] Product_{i>=0, j>=0, k>=0, i+j+k>1} (1 + x^i * y^j * z^k).
%e A398607 a(1) = 1: for p*q*r, the only strictly distinct factorization avoiding p, q, and r as standalone factors is {p*q*r}.
%e A398607 a(2) = 12: there are 12 strictly distinct factorizations of p^2 * q^2 * r^2 avoiding standalone primes.
%t A398607 a[n_] := Module[{dp}, dp = ConstantArray[0, {n + 1, n + 1, n + 1}]; dp[[1, 1, 1]] = 1; Do[If[i + j + k > 1, Do[dp[[x + 1, y + 1, z + 1]] += dp[[x - i + 1, y - j + 1, z - k + 1]], {x, n, i, -1}, {y, n, j, -1}, {z, n, k, -1}]], {i, 0, n}, {j, 0, n}, {k, 0, n}]; dp[[n + 1, n + 1, n + 1]]];
%t A398607 Table[a[n], {n, 0, 22}]
%o A398607 (Python)
%o A398607 def lista(n_max):
%o A398607     m = n_max + 1
%o A398607     dp = [[[0] * m for _ in range(m)] for _ in range(m)]
%o A398607     dp[0][0][0] = 1
%o A398607     for c1 in range(m):
%o A398607         for c2 in range(m):
%o A398607             for c3 in range(m):
%o A398607                 if c1 + c2 + c3 <= 1: continue
%o A398607                 for i1 in range(m - 1, c1 - 1, -1):
%o A398607                     for i2 in range(m - 1, c2 - 1, -1):
%o A398607                         for i3 in range(m - 1, c3 - 1, -1):
%o A398607                             dp[i1][i2][i3] += dp[i1 - c1][i2 - c2][i3 - c3]
%o A398607     return [dp[n][n][n] for n in range(m)]
%o A398607 print(lista(30))
%Y A398607 Cf. A000009, A001055, A219554, A219560, A219561, A219585, A219678, A398553.
%Y A398607 2-dimensional analog: A398329.
%Y A398607 4-dimensional analog: A399303.
