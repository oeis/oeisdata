%N A398188 a(n) = Sum_{k=0..n} A398187(n, k).
%F A398188 a(n) ~ sqrt(Pi/2) * n^(n + 1/2). - _Vaclav Kotesovec_, Jul 24 2026
%t A398188 A398187RowSums[Nmax_] := Module[{T, biEGF, poly, coeffs},
%t A398188   T[n_, k_] := (n - k)! * SeriesCoefficient[Exp[n * x] / (1 - x), {x, 0, n - k}];
%t A398188   biEGF[N_, z_, y_] := Sum[T[n, n - m] * z^n * y^m, {n, 0, N}, {m, 0, n}];
%t A398188   poly = biEGF[Nmax, z, y];
%t A398188   coeffs = CoefficientList[poly, z];
%t A398188   (# /. y -> 1) & /@ coeffs ]
%t A398188 A398187RowSums[19]
%t A398188 (* Alternative: *)
%t A398188 Join[{1}, Table[Sum[n^k + E^n k Gamma[k, n], {k, 0, n}], {n, 1, 20}]] (* _Vaclav Kotesovec_, Jul 24 2026 *)
%o A398188 (SageMath)
%o A398188 def T(n, k): return sum(falling_factorial(n-k,j) * n^(n-k-j) for j in range(n-k+1))
%o A398188 T = [[T(n, k) for k in range(n+1)] for n in range(20)]
%o A398188 print([sum(row) for row in T])
