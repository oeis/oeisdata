%I A398303 #6 Jul 29 2026 15:01:50
%S A398303 1,2,4,6,8,9,12,14,16,18,21,24,26,28,32,35,36,39,42,44,45,48,50,52,56,
%T A398303 60,64,70,72,75,78,84,88,90,96,98,100,102,104,108,112,116,120,124,128,
%U A398303 140,144,147,150,155,156,165,168,175,176,180,192,194,196,198
%N A398303 Numbers that are divisible by the sum of the digits of their canonical snowball representation.
%C A398303 See A397794 for the definition of the canonical snowball representation of a number.
%C A398303 This sequence is infinite as it contains the powers of 2.
%H A398303 Rémy Sigrist, <a href="/A398303/b398303.txt">Table of n, a(n) for n = 1..10000</a>
%e A398303 The first terms are:
%e A398303   n   a(n)  snowball(a(n))
%e A398303   --  ----  --------------
%e A398303    1     1               1
%e A398303    2     2              10
%e A398303    3     4             100
%e A398303    4     6             110
%e A398303    5     8            1000
%e A398303    6     9             111
%e A398303    7    12            1100
%e A398303    8    14            1010
%e A398303    9    16           10000
%e A398303   10    18            1110
%e A398303   11    21            1011
%e A398303   12    24           11000
%e A398303   13    26           10010
%e A398303   14    28           10100
%e A398303   15    32          100000
%o A398303 (PARI) is(n) = { my (r = n, b = 2, s = 0, d); while (r, d = r % b; r \= b; s += d; b = 2+d; ); return (n % s == 0); }
%Y A398303 Cf. A118363, A398006, A397794.
%K A398303 nonn,base,new
%O A398303 1,2
%A A398303 _Rémy Sigrist_, Jul 25 2026
