%e A398949 8 is a term since 8! = 40320, its reversed digits are (0)2304, and 8 divides 2304.
%t A398949 Select[Range[10000],Mod[IntegerReverse[#!],#]==0 &] (* _Stefano Spezia_, Aug 15 2026 *)
%o A398949 (Python)
%o A398949 import math,sys
%o A398949 sys.set_int_max_str_digits(0)
%o A398949 def ok(n): return int(str(math.factorial(n))[::-1])%n == 0
%o A398949 print([k for k in range(1, 3001) if ok(k)]) # edited by _Michael S. Branicky_, Aug 15 2026
