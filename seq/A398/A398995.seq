%N A398995 The binomial matrix of the Pell numbers. Square array read by ascending antidiagonals.
%C A398995 See the comments and links in A399000.
%H A398995 Peter Luschny, <a href="https://github.com/PeterLuschny/Gists/blob/main/GnomonicExpansionAndBinomialMatrices.ipynb">Gnomonic Expansion and Binomial Matrices</a>, a Python notebook.
%H A398995 Wikipedia, <a href="https://en.wikipedia.org/wiki/Pell_number">Pell number</a>.
%F A398995 A(n, n) = P(n), the Pell numbers, P(n) = A000129(n+1). We follow the definition that the Pell numbers are the denominators of the closest rational approximation to the square root of 2, starting with (1/1, 3/2, 7/5, ...), see Wikipedia.
%F A398995 A(n, k) = Sum_{m=0..d} binomial(d, m) * s^(d - m) * P(p + m), where d = abs(n - k), p = min(n, k), s = 1 if k <= n, otherwise -1.
%e A398995 Array starts:
%e A398995   [0]     1,     1,    2,    2,    4,    4,    8,    8, ...
%e A398995   [1]     3,     2,    3,    4,    6,    8,   12,   16, ...
%e A398995   [2]    10,     7,    5,    7,   10,   14,   20,   28, ...
%e A398995   [3]    34,    24,   17,   12,   17,   24,   34,   48, ...
%e A398995   [4]   116,    82,   58,   41,   29,   41,   58,   82, ...
%e A398995   [5]   396,   280,  198,  140,   99,   70,   99,  140, ...
%e A398995   [6]  1352,   956,  676,  478,  338,  239,  169,  239, ...
%e A398995   [7]  4616,  3264, 2308, 1632, 1154,  816,  577,  408, ...
%e A398995   [8] 15760, 11144, 7880, 5572, 3940, 2786, 1970, 1393, ...
%e A398995 .
%e A398995 Seen as a triangle:
%e A398995   [0]     1;
%e A398995   [1]     3,    1;
%e A398995   [2]    10,    2,   2;
%e A398995   [3]    34,    7,   3,   2;
%e A398995   [4]   116,   24,   5,   4,  4;
%e A398995   [5]   396,   82,  17,   7,  6,  4;
%e A398995   [6]  1352,  280,  58,  12, 10,  8,  8;
%e A398995   [7]  4616,  956, 198,  41, 17, 14, 12,  8;
%e A398995   [8] 15760, 3264, 676, 140, 29, 24, 20, 16, 16;
%p A398995 # Using function 'binomial_matrix' from A399000.
%p A398995 BM := binomial_matrix(n -> simplify(2^n*hypergeom([-n/2, (1-n)/2], [-n], -1))):
%p A398995 M := Matrix(9, 9, (n, k) -> BM(n-1, k-1));
%p A398995 seq(seq(BM(n-k, k), k = 0..n), n = 0..9);
%t A398995 (* Using function 'binomialMatrix' from A399000. *)
%t A398995 bM = binomialMatrix[2^# HypergeometricPFQ[{-#/2, (1 - #)/2}, {-#}, -1] &];
%t A398995 Table[bM[n, k], {n, 0, 8}, {k, 0, 8}] // MatrixForm
%o A398995 (Python)  # Using function binomial_matrix from A399000.
%o A398995 from mpmath import hyp2f1
%o A398995 def pell(n) -> int: return int((2**n)*hyp2f1((-n,2),(1-n,2),-n,-1))
%o A398995 M = binomial_matrix(pell)
%o A398995 for n in range(9): print([M(n, k) for k in range(9)])
