%S A398365 1,1,1,1,1,1,1,1,3,7,13,21,31,43,57,73,97,141,223,367,603,967,1501,
%T A398365 2253,3297,4773,6947,10291,15583,24027,37393,58177,89851,137343,
%U A398365 207957,313013,470557,709561,1076103,1642087,2517385,3867109,5937303,9094935,13891919,21168259
%N A398365 a(n) = Sum_{k=0..floor(n/8)} binomial(2*k,k) * binomial(n-6*k,2*k).
%C A398365 Number of lattice paths from (0,0) to (n,n) using steps (8-r,r), (r,8-r), and (1,1), for any fixed r in {0,1,2,3}.
%H A398365 Paolo Xausa, <a href="/A398365/b398365.txt">Table of n, a(n) for n = 0..1000</a>
%F A398365 a(n) = Sum_{k=0..floor(n/8)} multinomial(n-6*k; k, k, n-8*k).
%F A398365 G.f.: 1/sqrt((1+x) * (1-2*x+2*x^2-2*x^3) * (1-x+2*x^4)).
%t A398365 A398365[n_] := Sum[Multinomial[k, k, n - 8*k], {k, 0, n/8}];
%t A398365 Array[A398365, 50, 0] (* _Paolo Xausa_, Jul 27 2026 *)
%t A398365 (* Alternative: *)
%t A398365 Module[{x}, CoefficientList[Series[1/Sqrt[x*(x - 4*x^7 - 2) + 1], {x, 0, 49}], x]] (* _Paolo Xausa_, Jul 27 2026 *)
%o A398365 (PARI) a(n) = sum(k=0, n\8, binomial(2*k, k)*binomial(n-6*k, 2*k));
%Y A398365 Cf. A001850, A002426, A098479, A098482, A387599, A393251, A398364.
%K A398365 nonn
