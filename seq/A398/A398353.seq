%I A398353 #23 Aug 11 2026 19:55:28
%S A398353 0,0,0,0,0,2,3,2,3,0,2,2,3,5,5,2,2,3,5,5,7,7,2,2,3,5,2,2,3,5,5,7,7,13,
%T A398353 2,2,2,3,5,2,2,3,5,5,7,7,13,2,3,11,2,3,2,3,17,5,2,3,2,2,3,5,5,2,3,11,
%U A398353 2,3,7,5,2,3,11,5,13,2,3,13,2,3,7,5,37,2,3,17
%N A398353 Least prime p such that n - p is semiprime or 0 if no such prime exists.
%C A398353 It appears that the only n for which no such prime exists are 1, 2, 3, 4, 5, and 10. Verified up to 10^9.
%e A398353 a(1)..a(5) = 0.
%e A398353 a(6) = 2 because 6 = 2*2 + 2.
%e A398353 a(7) = 3 because 7 = 2*2 + 3.
%p A398353 f:= proc(n) local p;
%p A398353   p:= 1;
%p A398353   do
%p A398353    p:= nextprime(p);
%p A398353    if n-p < 4 then return 0 fi;
%p A398353    if NumberTheory:-Omega(n-p) = 2 then return p fi;
%p A398353  od;
%p A398353 end proc:
%p A398353 map(f, [$1..100]); # _Robert Israel_, Jul 27 2026
%o A398353 (Python)
%o A398353 from sympy import primerange, factorint
%o A398353 def semiprime(n):
%o A398353     return n > 0 and sum(factorint(n).values()) == 2
%o A398353 def a(n):
%o A398353     for r in primerange(2, n):
%o A398353         if semiprime(n - r):
%o A398353             return r
%o A398353     return 0
%o A398353 (PARI) a(n) = forprime(p=1, n, if ((n>p) && (bigomega(n-p)==2), return(p))); \\ _Michel Marcus_, Jul 27 2026
%Y A398353 Cf. A000040, A103274, A001358.
%K A398353 nonn,easy
%O A398353 1,6
%A A398353 _Najeem Ziauddin_, Jul 26 2026
