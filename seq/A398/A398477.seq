%I A398477 #22 Aug 11 2026 09:33:15
%S A398477 1,1,1,4,3,2,27,18,10,5,256,160,80,35,14,3125,1875,875,350,126,42,
%T A398477 46656,27216,12096,4536,1512,462,132,823543,470596,201684,72030,22638,
%U A398477 6468,1716,429,16777216,9437184,3932160,1351680,405504,109824,27456,6435,1430
%N A398477 Triangle read by rows: T(n, k + 1) = T(n, k) * (n + k) / (n * (k + 1)) for k <= n, starting at T(n, 0) = n^n, (row recurrence).
%H A398477 Peter Luschny, <a href="/A398477/b398477.txt">Rows n = 0..140, flattened</a>.
%H A398477 Peter Luschny, <a href="/A398477/a398477.txt">Illustrating A398477</a>.
%F A398477 T(n, k) = n^n * Product_{j=1..k} (n + j) / (n + n*j).
%F A398477 T(n, k) = n^(n - k) * (n + k)! / ((k + 1)! * n!).
%F A398477 T(n, k) = binomial(n + k, k + 1) * n^(n - k - 1) for n >= 1, T(0, 0) = 1.
%e A398477 Triangle starts:
%e A398477   [0]         1;
%e A398477   [1]         1,       1;
%e A398477   [2]         4,       3,       2;
%e A398477   [3]        27,      18,      10,       5;
%e A398477   [4]       256,     160,      80,      35,     14;
%e A398477   [5]      3125,    1875,     875,     350,    126,     42;
%e A398477   [6]     46656,   27216,   12096,    4536,   1512,    462,   132;
%e A398477   [7]    823543,  470596,  201684,   72030,  22638,   6468,  1716,  429;
%e A398477   [8]  16777216, 9437184, 3932160, 1351680, 405504, 109824, 27456, 6435, 1430;
%p A398477 T := (n, k) -> local j; n^n * mul((n + j) / (n + n*j), j = 1..k):
%t A398477 A398477[n_, k_] := If[n == k == 0, 1, Binomial[n + k, k + 1]*n^(n - k - 1)];
%t A398477 Table[A398477[n, k], {n, 0, 10}, {k, 0, n}] (* _Paolo Xausa_, Aug 10 2026 *)
%t A398477 (* Alternative: *)
%t A398477 A398477row[n_] := If[n == 0, {1}, FoldList[#*(n + #2)/(n*(#2 + 1)) &, n^n, Range[n]]];
%t A398477 Array[A398477row, 11, 0] (* _Paolo Xausa_, Aug 10 2026 *)
%o A398477 (Python)
%o A398477 def row(n: int) -> list[int]:
%o A398477     if n == 0: return [1]
%o A398477     t = 1
%o A398477     for _ in range(n): t *= n
%o A398477     r = [t]
%o A398477     for k in range(1, n + 1):
%o A398477         t = t * (n + k) // (n * (k + 1))
%o A398477         r.append(t)
%o A398477     return r
%o A398477 for n in range(9): print(row(n))
%Y A398477 Cf. A000312 (column 0), A000108 (main diagonal), A398478 (row sums), A398479 (central terms), A398373.
