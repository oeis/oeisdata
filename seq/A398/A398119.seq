%I A398119 #23 Aug 21 2026 22:30:08
%S A398119 3,7,7,8,5,14,6,7,9,7,3,17,8,9,11,11,5,17,8,7,11,11,8,21,10,7,15,10,7,
%T A398119 15,5,11,8,13,4,18,7,6,12,10,6,16,10,8,14,13,7,17,7,6,12,11,7,13,9,9,
%U A398119 11,11,7,15,7,10,9,14,6,17,6,9,10,10,5,16,8,10,9
%N A398119 a(n) is the number of distinct cycles under iteration of x -> s(x^n) on the positive integers, where s is the decimal digit sum and fixed points are counted as cycles of length 1.
%C A398119 Cycles are identified up to cyclic rotation. For each n, all cycles of the map are contained in the finite interval {1, ..., 9*n*D(n)}, where D(n) is the largest positive integer D such that 10^(D-1) <= 9*n*D. Thus a(n) is obtained by an exhaustive computation with exact integer arithmetic.
%C A398119 For every exponent n with 2 <= n <= 500 except for n = 6, there is at least one cycle of length at least 2.
%H A398119 Helmuth Haslacher, <a href="/A398119/b398119.txt">Table of n, a(n) for n = 2..500</a>
%H A398119 M. A. C. Alcântara and M. V. P. Alcântara, <a href="https://doi.org/10.5281/zenodo.19240836">Dynamics of the Digit Sum of Integer Powers: Cycle Structure and Finite Search</a>, Zenodo, Version 3, 2026.
%H A398119 M. V. P. Alcântara, <a href="https://doi.org/10.5281/zenodo.21348126">Digit-Sum Maps of Polynomial Generators over Arbitrary Bases: Global Descent, Cycle Localization and Arithmetic Basins</a>, Zenodo, 2026.
%F A398119 a(n) = A398120(n) + A046471(n) + 1.
%e A398119 a(2) = 3 because the cycles are the fixed points (1) and (9), and the 2-cycle (13, 16). See A056527 and A056529.
%e A398119 a(5) = 8 because the cycles are the fixed points (1), (28), (35), (36), and (46), the 2-cycles (23, 29) and (31, 34), and the 4-cycle (7, 22, 25, 40).
%e A398119 a(6) = 5 because all cycles are fixed points: (1), (18), (45), (54), and (64).
%o A398119 (Python)
%o A398119 def s(m):
%o A398119     t = 0
%o A398119     while m:
%o A398119         t += m % 10
%o A398119         m //= 10
%o A398119     return t
%o A398119 def a(n):
%o A398119     D = 1
%o A398119     while 10**(D - 1) <= 9*n*D:
%o A398119         D += 1
%o A398119     D -= 1
%o A398119     B = 9*n*D
%o A398119     cycles = set()
%o A398119     for x0 in range(1, B + 1):
%o A398119         seen = {}
%o A398119         orbit = []
%o A398119         x = x0
%o A398119         while x not in seen:
%o A398119             seen[x] = len(orbit)
%o A398119             orbit.append(x)
%o A398119             x = s(x**n)
%o A398119         c = orbit[seen[x]:]
%o A398119         i = c.index(min(c))
%o A398119         cycles.add(tuple(c[i:] + c[:i]))
%o A398119     return len(cycles)
%Y A398119 Cf. A007953, A004159, A046000, A046471, A056527, A056529, A061905, A152147, A398120 (number of cycles of length at least 2), A398121 (maximum cycle length).
