%I A398332 #31 Sep 24 2026 22:08:02
%S A398332 2,6,10,16,24,32,40,52,64
%N A398332 Largest value M such that all integers 1 through M can be expressed as b_i, b_i + b_j, or b_j - b_i for some set of n positive integers (the 2-postage stamp problem with subtraction).
%C A398332 Given a set B = {b_1, b_2, ..., b_n} of n positive integers, let S(B) be the set of all integers of the form b_i, b_i + b_j, or |b_j - b_i| (1 <= i <= j <= n).
%C A398332 a(n) is the maximum integer M such that {1, 2, ..., M} is a subset of S(B).
%C A398332 This is the signed (additive-subtractive) generalization of the classical 2-postage stamp problem (A001212).
%C A398332 Because subtraction is permitted, a(n) is strictly greater than the classical 2-stamp bound A001212(n) for all n >= 2.
%C A398332 Asymptotically, (1/2)*n^2 <= a(n) <= n*(n+1).
%H A398332 Hans Rohrbach, <a href="https://doi.org/10.1007/BF01160061">Ein Beitrag zur additiven Zahlentheorie</a>, Math. Z., 42 (1937), 1-30.
%F A398332 a(n) >= floor((n^2 + 6*n + 1) / 4).
%F A398332 a(n) >= floor((n^2 + 2*n) / 2) for n >= 33.
%F A398332 a(n) <= n*(n + 1).
%e A398332 For n = 1: B = {1}. S(B) covers 1..2, so a(1) = 2.
%e A398332 For n = 2: B = {2, 3}. S(B) covers 1..6, so a(2) = 6.
%e A398332 For n = 3 (Solution 1): B = {2, 4, 5}. S(B) covers 1..10, so a(3) = 10.
%e A398332 For n = 3 (Solution 2): B = {3, 4, 5}. S(B) covers 1..10, so a(3) = 10.
%e A398332 For n = 4 (Solution 1): B = {1, 2, 8, 13}. S(B) covers 1..16, so a(4) = 16.
%e A398332 For n = 4 (Solution 2): B = {3, 6, 7, 8}. S(B) covers 1..16, so a(4) = 16.
%e A398332 For n = 4 (Solution 3): B = {4, 6, 7, 9}. S(B) covers 1..16, so a(4) = 16.
%e A398332 For n = 5: B = {4, 8, 10, 11, 13}. S(B) covers 1..24, so a(5) = 24.
%o A398332 (Python)
%o A398332 from itertools import combinations
%o A398332 def a(n):
%o A398332     if n == 1:
%o A398332         return 2
%o A398332     max_elem = n * (n + 1)
%o A398332     best = 0
%o A398332     for A in combinations(range(1, max_elem + 1), n):
%o A398332         if 2 * A[-1] <= best:
%o A398332             continue
%o A398332         seen = set(A)
%o A398332         for i in range(n):
%o A398332             for j in range(i, n):
%o A398332                 seen.add(A[i] + A[j])
%o A398332                 seen.add(A[j] - A[i])
%o A398332         m = 0
%o A398332         while (m + 1) in seen:
%o A398332             m += 1
%o A398332         if m > best:
%o A398332             best = m
%o A398332     return best
%o A398332 print([a(n) for n in range(1, 4)])
%Y A398332 Cf. A001212, A014616.
%K A398332 nonn,hard,more,new
%O A398332 1,1
