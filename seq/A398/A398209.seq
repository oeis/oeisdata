%T A398209 1,1,7,6,4,4,3,2,2,1,1,8,6,5,5,3,3,2,2,1,1,9,6,6,4,5,3,3,2,2,1,1,10,8,
%U A398209 7,5,6,5,3,3,2,2,1,1,11,8,8,5,6,5,4,3,3,2,2,1,1
%N A398209 Triangle read by rows: For n >= 1, T(n,k) is the number of distinct entries q of the n X n multiplication table such that floor(q/n) = k, for 0 <= k <= n, with T(0,0) = 0.
%C A398209 This is the positive-indexed distinct-product analog of A393470, which counts ordered factor pairs in the zero-based n X n multiplication table.
%H A398209 Frédéric D. W. Heidenthal-König, <a href="https://doi.org/10.5281/zenodo.18960358">Euclidean Decomposition of the Multiplication Table</a>, Zenodo, 2026.
%H A398209 Frédéric D. W. Heidenthal-König, <a href="https://doi.org/10.5281/zenodo.19102497">The Support of the Euclidean Decomposition of the Multiplication Table</a>, Zenodo, 2026.
%F A398209 T(0,0) = 0.
%F A398209 For n >= 1 and 0 <= k <= n,
%F A398209 T(n,k) = #{q in {i*j: 1 <= i, j <= n}: floor(q/n) = k}.
%F A398209 Equivalently, T(n,k) = #{q in {i*j: 1 <= i, j <= n}: k*n <= q < (k+1)*n}.
%F A398209 T(n,k) = Sum_{q = max(1, k*n)..min(n^2, (k+1)*n-1)} A394016(n,q).
%F A398209 For n >= 1,
%F A398209 Sum_{k = 0..n} T(n,k) = A027424(n).
%F A398209 Sum_{k = 0..n} k*T(n,k) = A397038(n).
%F A398209 T(n,0) = n-1 and T(n,n) = 1.
%e A398209 Rows for n = 0 to 12:
%e A398209   n=0:   0;
%e A398209   n=1:   0, 1;
%e A398209   n=2:   1, 1, 1;
%e A398209   n=3:   2, 2, 1, 1;
%e A398209   n=4:   3, 2, 2, 1, 1;
%e A398209   n=5:   4, 4, 2, 2, 1, 1;
%e A398209   n=6:   5, 4, 3, 2, 2, 1, 1;
%e A398209   n=7:   6, 5, 5, 3, 2, 2, 1, 1;
%e A398209   n=8:   7, 6, 4, 4, 3, 2, 2, 1, 1;
%e A398209   n=9:   8, 6, 5, 5, 3, 3, 2, 2, 1, 1;
%e A398209   n=10:  9, 6, 6, 4, 5, 3, 3, 2, 2, 1, 1;
%e A398209   n=11: 10, 8, 7, 5, 6, 5, 3, 3, 2, 2, 1, 1;
%e A398209   n=12: 11, 8, 8, 5, 6, 5, 4, 3, 3, 2, 2, 1, 1;
%e A398209   ...
%o A398209 (Python)
%o A398209 def row(n):
%o A398209     products = set()
%o A398209     for i in range(1, n + 1):
%o A398209         for j in range(1, n + 1):
%o A398209             products.add(i * j)
%o A398209     counts = [0] * (n + 1)
%o A398209     for k in products:
%o A398209         q = k // n
%o A398209         counts[q] += 1
%o A398209     return counts
%o A398209 terms = []
%o A398209 for n in range(13):
%o A398209     terms.extend(row(n))
%o A398209 print(terms)
%o A398209 (PARI) row(n) = if (n==0, [0], vector(n+1, k, #select(x->((x\n)==(k-1)), setbinop((x,y)->x*y, [1..n])))); \\ _Michel Marcus_, Jul 23 2026
%Y A398209 Row sums give A027424.
%Y A398209 Cf. A393470, A394016, A397038.
