%I A398238 #6 Aug 13 2026 23:30:20
%S A398238 0,0,0,0,1,6,8,24,42,68,128,198,336,557,781,1119,1623,2311,3321,4809,
%T A398238 6718,9447,13163,18181,24257,33746,45374,61232,82409,110936,143957,
%U A398238 188832,244412,322327,420243,548684,699902,909162,1165123,1488752,1892296,2418259,3050891,3878184,4875916
%N A398238 a(n) is the number of distinct unordered pairwise sums with repetition of the distinct multinomial coefficient values of order n having more than one representation.
%C A398238 Let B(n) be the set of distinct numbers n!/(p_1!*...*p_r!), where (p_1, ..., p_r) ranges over the partitions of n.
%C A398238 Since the number r of parts is unrestricted, B(n) contains all distinct multinomial coefficient values of order n, independently of the number of variables.
%C A398238 Thus a(n) is the number of distinct unordered pairwise sums with repetition of elements of B(n) having more than one representation.
%C A398238 For n >= 3, a(n) is the common value of the last three entries in row n of A398237.
%C A398238 For n >= 5, a(n) is the first entry in row n of A398265.
%C A398238 Appending a part 1 to every partition of n shows that (n + 1)*B(n) is a subset of B(n + 1). Since every colliding sum retains its representations after scaling, a(n + 1) >= a(n).
%C A398238 In fact, a(n + 1) > a(n) for n >= 5. For n >= 45, let u = (n + 1)!/(12*(n - 4)!), v = (n + 1)!/(4*(n - 4)!), and w = (n + 1)!/(6*(n - 4)!). Then v and w belong to the embedded copy (n + 1)*B(n), whereas u does not, and u + v = 2*w turns a previously uniquely represented sum into a colliding sum. The cases 5 <= n <= 44 are verified directly. See the Huber link for a proof.
%C A398238 A398233(n) counts the total collision excess among the same pairwise sums, whereas a(n) counts the distinct sums having more than one representation. Hence a(n) <= A398233(n), with equality if and only if no pairwise sum has more than two representations.
%C A398238 The sequences are equal for 1 <= n <= 8. The first sum having three representations occurs at n = 9: 84 + 1680 = 252 + 1512 = 504 + 1260. Embedding this identity into every higher order shows that a(n) < A398233(n) for n >= 9.
%C A398238 A398230 and A398231 give the corresponding collision statistics for trinomial coefficients, A398232 and A398237 are the associated triangles by number of variables, A398233 and this sequence are the corresponding diagonal sequences for all multinomial coefficient values, A398263 gives the maximum representation multiplicity, and A398265 records the complete cumulative multiplicity distribution.
%C A398238 For odd n >= 7, the trinomial collision family gives a(n) >= floor((n - 3)/4). For even n, append a part 1 to every indexing partition of the corresponding family for n - 1; this multiplies every coefficient and collision sum by n and preserves the number of distinct colliding sums. Hence the same bound holds for all n >= 7.
%C A398238 For q >= 3, let N(q) = Sum_{p prime, p <= q} p*floor(log(q)/log(p)). The set B(N(q)) contains an arithmetic progression of length q. Moreover, for n >= N(q) + q, the set B(n) contains n - N(q) - q + 1 scaled copies whose internal pair-sum intervals are disjoint. Hence a(n) >= (n - N(q) - q + 1)*(2*q - 5). See the Huber link for a proof.
%H A398238 Felix Huber, <a href="/A398238/a398238.txt">Arithmetic-progression lower bounds for A398233, A398238, and A398263</a>.
%H A398238 Felix Huber, <a href="https://arxiv.org/abs/2608.02667">Large Sidon Subsets and Pair-Sum Multiplicities of Distinct Multinomial Coefficients</a>, arXiv:2608.02667 [math.CO], 2026.
%H A398238 Felix Huber, <a href="/A398238/a398238_1.txt">Strict monotonicity of A398233 and A398238</a>.
%F A398238 a(n) = |{s : r_n(s) >= 2}|, where r_n(s) = |{(x, y) : x, y in B(n), x <= y and x + y = s}| and B(n) = {A210237(n, j) : 1 <= j <= A070289(n)}.
%F A398238 a(n) = A398233(n) - Sum_s max(r_n(s) - 2, 0).
%F A398238 a(n) = A398237(n, n).
%F A398238 a(n) = A398237(n, n - 1) = A398237(n, n - 2) for n >= 3.
%F A398238 a(n) = A398265(n, 2) for n >= 5.
%F A398238 a(n) >= A398231(n) for n >= 3.
%F A398238 a(n) <= A398233(n) - A398263(n) + 2.
%F A398238 a(n) > 0 if and only if n >= 5.
%F A398238 a(n) >= floor((n - 3)/4) for n >= 7.
%F A398238 a(n) < A398233(n) for n >= 9.
%F A398238 a(n + 1) > a(n) for n >= 5.
%F A398238 a(n) >= 2*q - 5 whenever n >= N(q) and q >= 3, where N(q) = Sum_{p prime, p <= q} p*floor(log(q)/log(p)).
%F A398238 a(n) >= (n - N(q) - q + 1)*(2*q - 5) whenever n >= N(q) + q and q >= 3.
%F A398238 liminf_{n -> infinity} a(n)/(n^(3/2)*sqrt(log(n))) >= 4/(3*sqrt(3)).
%e A398238 a(6) = 6, since B(6) = {1, 6, 15, 20, 30, 60, 90, 120, 180, 360, 720} has exactly the following 6 distinct pairwise sums with more than one representation: 1 + 20 = 6 + 15, 30 + 90 = 60 + 60, 30 + 120 = 60 + 90, 60 + 120 = 90 + 90, 30 + 180 = 90 + 120, and 60 + 180 = 120 + 120.
%p A398238 A398238 := proc(n) option remember;
%p A398238     local a, b, i, j, l, m, r, s, t;
%p A398238     t := table();
%p A398238     b := proc(r, p, d)
%p A398238         local i;
%p A398238         if r = 0 then
%p A398238             t[n!/d] := 1;
%p A398238             return
%p A398238         end if;
%p A398238         for i from min(p, r) by -1 to 1 do
%p A398238             b(r - i, i, d*i!)
%p A398238         end do
%p A398238     end proc;
%p A398238     b(n, n, 1);
%p A398238     l := [indices(t, 'nolist')];
%p A398238     m := nops(l);
%p A398238     s := table();
%p A398238     a := 0;
%p A398238     for i to m do
%p A398238         for j from i to m do
%p A398238             r := l[i] + l[j];
%p A398238             if assigned(s[r]) then
%p A398238                 if s[r] = 1 then
%p A398238                     a := a + 1;
%p A398238                     s[r] := 2
%p A398238                 end if
%p A398238             else
%p A398238                 s[r] := 1
%p A398238             end if
%p A398238         end do
%p A398238     end do;
%p A398238     a
%p A398238 end proc:
%p A398238 seq(A398238(n), n = 1 .. 26);
%Y A398238 Cf. A070289, A210237, A398230, A398231, A398232, A398233, A398237, A398263, A398265, A398429.
%K A398238 nonn,new
