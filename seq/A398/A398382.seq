%S A398382 1,3,10,46,208,1565,32406,147513,13916720,792200983,45095576120,
%T A398382 53199361910278,5019001270391170,13786116561518113,
%U A398382 74037439465651731888,397613237793952441563595,9720917116241376975912156114,237658660725485089087795775523880
%N A398382 Index of the first occurrence of n in A398367.
%C A398382 This sequence is well-defined because every positive integer occurs in A398367.
%H A398382 Andrew R. Epstein, <a href="/A398382/b398382.txt">Table of n, a(n) for n = 1..96</a>
%H A398382 Andrew R. Epstein, <a href="/A398382/a398382.txt">C++ program</a>
%F A398382 a(n) = min { k >= 1 : A398367(k) = n }.
%e A398382 a(4)=46 because A398367(46)=4 and A398367(k)<4 for 1<=k<46.
%o A398382 (Python)
%o A398382 from itertools import islice
%o A398382 def a():
%o A398382     cells = [0]
%o A398382     p = 0
%o A398382     n = 0
%o A398382     record = 0
%o A398382     while True:
%o A398382         n += 1
%o A398382         cells.append(0)
%o A398382         cells[p] += 1
%o A398382         value = cells[p]
%o A398382         p = (p - value) % len(cells)
%o A398382         if value > record:
%o A398382             record = value
%o A398382             yield n
%o A398382 print(list(islice(a(), 9)))
