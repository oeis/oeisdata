%I A398155 #8 Aug 03 2026 19:10:56
%S A398155 14,57,160,1187,1396,5463,14924,40154,158732,1006284,7070162,7070162,
%T A398155 39096822,39946593,147210575,409821524,2592846884,4385639010,
%U A398155 16633376325,44214947590,170240674284,427259597452,1249806522623,4093737491249,24862201906393,39695856344201
%N A398155 a(n) is the least integer m >= 3 such that m*sin(Pi/m) and m*tan(Pi/m) agree in their first n digits after the decimal point, without rounding.
%C A398155 For a unit circle, m*sin(Pi/m) is half the perimeter of the regular inscribed m-gon, while m*tan(Pi/m) is half the perimeter of the regular circumscribed m-gon.
%C A398155 Since m*sin(Pi/m) < Pi < m*tan(Pi/m), a(n) is the least number of sides for which the classical polygonal lower and upper bounds for Pi determine its first n digits after the decimal point.
%C A398155 The sequence is nondecreasing.
%C A398155 Equal consecutive terms may occur; for example, a(11) = a(12) = 7070162.
%C A398155 Using m*sin(Pi/m) = Pi - Pi^3/(6*m^2) + O(m^(-4)) and m*tan(Pi/m) = Pi + Pi^3/(3*m^2) + O(m^(-4)) gives the stated asymptotic formula and shows that the general scale of growth is 10^(n/2), modified by the position of Pi within the corresponding decimal interval.
%C A398155 Unlike the analogous sequence for e (A398156), repetitions a(n + 1) = a(n) are not determined solely by the (n + 1)-st digit of Pi; they occur when both polygonal approximations for m = a(n) already lie in the finer decimal interval corresponding to n + 1 digits.
%H A398155 Felix Huber, <a href="/A398155/b398155.txt">Table of n, a(n) for n = 1..1000</a>
%H A398155 Felix Huber, <a href="/A398155/a398155.txt">Proof of well-definedness, monotonicity, and the asymptotic formula</a>
%F A398155 a(n) = min{m >= 3 : floor(10^n*m*sin(Pi/m)) = floor(10^n*m*tan(Pi/m))}.
%F A398155 a(n) = min{m >= 3 : floor(10^n*m*sin(Pi/m)) = floor(10^n*Pi) = floor(10^n*m*tan(Pi/m))}.
%F A398155 a(n) ~ Pi^(3/2)*10^(n/2)/sqrt(min(6*frac(10^n*Pi), 3*(1 - frac(10^n*Pi)))).
%F A398155 Limit_{n -> infinity} a(n)*10^(-n/2)*sqrt(min(6*frac(10^n*Pi), 3*(1 - frac(10^n*Pi)))) = Pi^(3/2).
%F A398155 a(n + 1) = a(n) <=> Pi - a(n)*sin(Pi/a(n)) <= frac(10^(n + 1)*Pi)/10^(n + 1) and a(n)*tan(Pi/a(n)) - Pi < (1 - frac(10^(n + 1)*Pi))/10^(n + 1).
%e A398155 a(1) = 14 because for m = 13, m*sin(Pi/m) = 3.111103... and m*tan(Pi/m) = 3.204212..., whose first digits after the decimal point do not agree, while for m = 14 the two values are 3.115293... and 3.195408..., so both begin with 3.1.
%e A398155 a(2) = 57 because for m = 56, m*sin(Pi/m) = 3.139945... and m*tan(Pi/m) = 3.144892..., whose first two digits after the decimal point do not agree, while for m = 57 the two values are 3.140002... and 3.144777..., so both begin with 3.14.
%p A398155 A398155 := proc(n) option remember;
%p A398155     local d, f, h, l, m, q;
%p A398155     d := Digits;
%p A398155     Digits := 2*n + 30;
%p A398155     q := floor(evalf(10^n*Pi));
%p A398155     f := m -> evalf(10^n*m*sin(Pi/m)) >= q and evalf(10^n*m*tan(Pi/m)) < q + 1;
%p A398155     l := 2;
%p A398155     h := 3;
%p A398155     while not f(h) do h := 2*h end do;
%p A398155     while l + 1 < h do
%p A398155         m := iquo(l + h, 2);
%p A398155         if f(m) then h := m else l := m end if
%p A398155     end do;
%p A398155     Digits := d;
%p A398155     h
%p A398155 end proc:
%p A398155 seq(A398155(n), n = 1 .. 26);
%Y A398155 Cf. A000796, A014976, A121501, A121506, A398156, A398158.
%K A398155 nonn,base
%O A398155 1,1
%A A398155 _Felix Huber_, Jul 27 2026
