%I A398842 #6 Sep 18 2026 06:13:04
%S A398842 0,-1,1,6,13,22,34,49,66,85,107,132,159,188,220,255,292,331,373,418,
%T A398842 465,514,566,621,678,737,799,864,931,1000,1072,1147,1224,1303,1385,
%U A398842 1470,1557,1646,1738,1833,1930,2029,2131,2236,2343,2452,2564,2679,2796,2915
%N A398842 Lower (-2, 3/2)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398842 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398842 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (3,-4,4,-3,1).
%F A398842 a(n) = 3*a(n-1) - 4*a(n-2) + 4*a(n-3) - 3*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, -1, 1, 6, 13).
%F A398842 G.f.: x*(1 - 4 x + x^2 - 3 x^3)/((-1 + x)^3 *(1 + x^2)).
%F A398842 a(n) = floor(n*(5*n-7)/4). 2*a(n) +2*a(n-2) +(-5*n^2+17*n-16)=0.
%t A398842 z = 60;
%t A398842 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398842 r =-2; s = 3/2;
%t A398842 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398842 Table[u[n], {n, 0, z}]
%Y A398842 Cf. A000217, A000326, A398843.
%K A398842 easy,sign,new
%O A398842 0,4
%A A398842 _Clark Kimberling_, Sep 10 2026
