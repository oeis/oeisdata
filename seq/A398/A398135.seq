%N A398135 Triangle read by rows: The coefficients of the tree polynomials. T(n, k) = [y^k] [z^n] n! * (1 - T(z))^(-y) where T(z) = Sum_{n>=1} n^(n-1) * z^n / n!.
%H A398135 Donald E. Knuth and B. Pittel, <a href="https://www.jstor.org/stable/2046947">A recurrence related to trees</a>, Proceedings of the American Mathematical Society, 105(2):335-349, 1989.
%H A398135 Donald E. Knuth and Arnold Schönhage, <a href="https://doi.org/10.1016/0304-3975(78)90009-9">The expected linearity of a simple equivalence algorithm</a>, Theoretical Computer Science, Volume 6, Issue 3, 1978, pp 281-315.
%F A398135 Recurrence: T(0, 0) = 1; T(n, 0) = 0 for n >= 1; T(n, k) = 0 for k < 0 or k > n.
%F A398135 T(n, k) = (1/n) * Sum_{m=1..n} binomial(n, m) * U(m) * T(n - m, k - 1) where U(m) = (m - 1)! * Sum_{j=0..m-1} m^j * (m - 1)^2 / j!.
%e A398135 Triangle starts:
%e A398135   [0]  1;
%e A398135   [1]  0,       1;
%e A398135   [2]  0,       3,       1;
%e A398135   [3]  0,      17,       9,       1;
%e A398135   [4]  0,     142,      95,      18,      1;
%e A398135   [5]  0,    1569,    1220,     305,     30,     1;
%e A398135   [6]  0,   21576,   18694,    5595,    745,    45,    1;
%e A398135   [7]  0,  355081,  334369,  113974,  18515,  1540,   63,  1;
%e A398135   [8]  0, 6805296, 6852460, 2581964, 484729, 49840, 2842, 84, 1;
%t A398135 T[n_, k_] := Coefficient[ Expand[
%t A398135    n! SeriesCoefficient[ (1 + LambertW[-z])^(-y), {z, 0, n} ] ], y, k ];
%t A398135 Table[Table[T[n, k], {k, 0, n}], {n, 0, 8}] // TableForm
%o A398135 (Python)
%o A398135 def U(m: int) -> int:
%o A398135     total = 0
%o A398135     term = factorial(m - 1)  # m^0 / 0! * (m-1)!
%o A398135     for i in range(m):
%o A398135         total += term * (m - i) ** 2
%o A398135         term = (term * m) // (i + 1)
%o A398135     return total
%o A398135 def tree_polys(max_n: int) -> list[list[int]]:
%o A398135     u = [0] + [U(m) for m in range(1, max_n + 1)]
%o A398135     triangle = [[1]]
%o A398135     for n in range(1, max_n + 1):
%o A398135         row = [0] * (n + 1)
%o A398135         c = n
%o A398135         for m in range(1, n + 1):
%o A398135             weight = c * u[m]
%o A398135             prev_row = triangle[n - m]
%o A398135             for k, val in enumerate(prev_row):
%o A398135                 row[k + 1] += weight * val
%o A398135             c = c * (n - m) // (m + 1)
%o A398135         triangle.append([val // n for val in row])
%o A398135     return triangle
%o A398135 A398135 = tree_polys(8)
%o A398135 for row in A398135: print(row)
%Y A398135 Variant: A060281 (misses the constant terms of the polynomials).
%Y A398135 Cf. A001865 (column 1), A045943 (subdiagonal), A000312 (row sums).
