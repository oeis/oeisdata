%I A398659 #4 Aug 22 2026 00:53:27
%S A398659 0,2,9,22,46,81,130,196,280,387,517,673,858,1073,1323,1608,1931,2295,
%T A398659 2701,3154,3654,4204,4807,5464,6180,6955,7792,8694,9662,10701,11811,
%U A398659 12995,14256,15595,17017,18522,20113,21793,23563,25428,27388,29446,31605,33866
%N A398659 Lower (1, 6/5) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398659 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398659 <a href="/index/Rec#order_08">Index entries for linear recurrences with constant coefficients</a>, signature (3,-3,1,0,1,-3,3,-1).
%F A398659 a(n) = 3*a(n-1) - 3*a(n-2) + a(n-3) + a(n-5) - 3*a(n-6) + 3(n-7) - a(n-8), with (a(0), ..., a(7)) =  (0, 2, 9, 22, 46, 81, 130, 196).
%t A398659 z = 60;
%t A398659 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398659 r = 1; s = 6/5;
%t A398659 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398659 Table[u[n], {n, 0, z}]
%Y A398659 Cf. A000217, A000330, A398660.
%K A398659 nonn,easy
%O A398659 0,2
%A A398659 _Clark Kimberling_, Aug 21 2026
