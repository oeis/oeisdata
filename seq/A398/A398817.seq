%I A398817 #21 Aug 25 2026 17:16:33
%S A398817 12,18,20,28,36,44,45,50,52,63,68,72,75,76,92,98,99,100,108,116,117,
%T A398817 120,124,128,147,148,153,164,168,171,172,175,180,188,192,196,200,207,
%U A398817 210,212,225,236,240,242,244,245,252,256,261,264,268,270,275,279,280
%N A398817 Numbers with multiplicative partition persistence 3.
%C A398817 The multiplicative partition persistence of an integer is the number of times the multiplicative partition function A001055 must be applied to reach 1. See A398037.
%C A398817 All terms are composite.
%C A398817 Equivalently, numbers k such that A001055(A001055(k)) is prime.
%e A398817 12 is a term; A001055(12) = 4 (which is in A330991). The trajectory is 12 -> 4 -> 2 -> 1, requiring exactly 3 steps.
%e A398817 36 is a term; A001055(36) = 9 (which is in A330991). The trajectory is 36 -> 9 -> 2 -> 1, requiring exactly 3 steps.
%o A398817 (Python)
%o A398817 from sympy import isprime
%o A398817 def mP(n):
%o A398817     if n <= 1: return 1
%o A398817     def count_mP(num, min_factor):
%o A398817         if num == 1: return 1
%o A398817         res = 0
%o A398817         for d in range(min_factor, num + 1):
%o A398817             if num % d == 0:
%o A398817                 res += count_mP(num // d, d)
%o A398817         return res
%o A398817     return count_mP(n, 2)
%o A398817 def lista(limit):
%o A398817     res = []
%o A398817     for x in range(4, limit + 1):
%o A398817         if not isprime(x):
%o A398817             m1 = mP(x)
%o A398817             if m1 > 1 and not isprime(m1):
%o A398817                 if isprime(mP(m1)):
%o A398817                     res.append(x)
%o A398817     return res
%o A398817 print(lista(285))
%Y A398817 Cf. A001055, A330991, A398037, A398813.
