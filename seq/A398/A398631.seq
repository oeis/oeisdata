%N A398631 Number of permutations p of [n+4] such that |p(i+1)-p(i)| <> n for all 1 <= i < n+4.
%F A398631 a(n) = A398634(n+4,n).
%F A398631 a(n) = Sum_{k=0..4} (-2)^k * binomial(4,k) * (n+4-k)! for n >= 4.
%o A398631 (PARI) a(n) = my(v=[24, 14, 152, 1392]); if(n<4, v[n+1], sum(k=0, 4, (-2)^k*binomial(4, k)*(n+4-k)!));
%Y A398631 Diagonal of A398634.
