%I A398652 #5 Aug 11 2026 01:05:20
%S A398652 0,2,6,13,25,43,67,98,138,188,248,319,403,501,613,740,884,1046,1226,
%T A398652 1425,1645,1887,2151,2438,2750,3088,3452,3843,4263,4713,5193,5704,
%U A398652 6248,6826,7438,8085,8769,9491,10251,11050,11890,12772,13696,14663,15675,16733
%N A398652 Upper (1, 1/2)-midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398652 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398652 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398652 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) =  (0, 2, 6, 13, 25, 43).
%F A398652 G.f.: -((x*(-2 + 2*x - 3*x^2 + x^3))/((-1 + x)^4 *(1 + x^2))).
%t A398652 z = 60;
%t A398652 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398652 r = 1; s = 1/2;
%t A398652 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398652 Table[v[n], {n, 0, z}]
%Y A398652 Cf. A000217, A000330, A398651.
%K A398652 nonn,easy,new
%O A398652 0,2
%A A398652 _Clark Kimberling_, Aug 09 2026
