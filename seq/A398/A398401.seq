%U A398401 846940,911812,1205982,1233522,1320390,1339290,1345806,1385874,1441935,1450746,1484865,1504206,1538874,1557882,1684287,1727217,1786365
%N A398401 Numbers k such that sigma(k) = psi(k) + Omega(k)^7.
%C A398401 The sequence is infinite because it contains all numbers of the form 133998 * p^2, where p is any prime such that gcd(p, 133998) = 1.
%e A398401 472284 is a term since sigma(472284) = 1224720 = 944784 + 6^7 = psi(472284) + Omega(472284)^7.
%o A398401 (PARI) isok(k) = {my(f = factor(k)); sigma(f) == prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) + bigomega(f)^7; } \\ _Amiram Eldar_, Jul 28 2026
%Y A398401 Cf. A244963 (sigma minus psi), A001222 (Omega), A397842, A397843, A398159, A398160.
%K A398401 nonn,new
%O A398401 1,2
