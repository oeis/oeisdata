%N A398401 Numbers k such that sigma(k) = psi(k) + Omega(k)^7.
%C A398401 The sequence is infinite because it contains all numbers of the form 133998 * p^2, where p is any prime such that gcd(p, 133998) = 1.
%F A398401 Union of { 1, 472284, 535992, 548232, 586840, 595240, 598136, 615944, 644776, 668536, 683944, 692392, 1205982, 1233522, 1441935, 1484865, 1684287, 1727217, 2976372, 3667750, 3720250, 4005375, 4124625, 4962125, 5174125, 5229625, 5293375, 7327166, 7545314, 9725765, 18093614, 19386015, 19504474, 20223214, 22644303, 25042765, 27582313, 42399190, 44501954, 46585066, 47680665, 49414954, 55462857, 60454465, 61191415, 65878417, 70884942, 78720490, 91568842, 110658865, 120587137, 377708074, 384995922, 467722615, 486232282, 525684687, 539083617, 557544365, 581364685, 594763615, 640319977, 842522494, 872587018, 967433433, 1043310565, 1913517166, 1957618714, 2142600207, 2272454765, 2394959065, 25460031138, 29943558634, 62293205290, 64459925474, 69064205865, 109265059990, 126338808318, 140986786094, 151057270815 } and infinite series { m*p^2 | p is prime not dividing m } for m in { 133998, 137058, 146710, 148810, 149534, 153986, 160215, 161194, 164985, 167134, 170986, 173098, 187143, 191913, 198485, 206965, 209185, 211735, 227953 }. - _Max Alekseyev_, Oct 11 2026
%e A398401 472284 is a term since sigma(472284) = 1224720 = 944784 + 6^7 = psi(472284) + Omega(472284)^7.
%o A398401 (PARI) isok(k) = {my(f = factor(k)); sigma(f) == prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) + bigomega(f)^7; } \\ _Amiram Eldar_, Jul 28 2026
%o A398401 (Python)
%o A398401 from math import prod
%o A398401 from sympy import factorint
%o A398401 def ok(n):
%o A398401     f = factorint(n)
%o A398401     sigma = prod((p**(e+1)-1)//(p-1) for p, e in f.items())
%o A398401     Omega = sum(f.values())
%o A398401     psi = prod((p+1)*p**(e-1) for p, e in f.items())
%o A398401     return sigma == psi + Omega**7
