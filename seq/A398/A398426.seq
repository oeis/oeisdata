%I A398426 #31 Sep 24 2026 17:45:00
%S A398426 2,44,46,106,272,1856,7480
%N A398426 Indices of primes in A400201.
%C A398426 a(8) > 10000.
%e A398426 2 is a term since A400201(2) = 131 is prime.
%t A398426 lst = NestList[FromDigits@Join[#, {Mod[Last@# + 2, 10]}, Reverse@#] &@ Take[#, Ceiling[Length[#]/2]] &@IntegerDigits[#] &, 1, 10000]; Pick[Range[Length@lst], ParallelMap[If[PrimeQ[#], 1, 0] &, lst], 1]
%K A398426 nonn,base,hard,more,new
%O A398426 1,1
