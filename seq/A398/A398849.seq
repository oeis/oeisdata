%I A398849 #8 Sep 18 2026 04:27:06
%S A398849 0,1,2,4,8,13,19,26,34,44,55,66,79,94,109,125,143,162,182,203,225,249,
%T A398849 274,299,326,355,384,414,446,479,513,548,584,622,661,700,741,784,827,
%U A398849 871,917,964,1012,1061,1111,1163,1216,1269,1324,1381,1438,1496,1556
%N A398849 Upper (-1/3, 1/2)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398849 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398849 <a href="/index/Rec#order_07">Index entries for linear recurrences with constant coefficients</a>, signature (2,-2,3,-3,2,-2,1).
%F A398849 a(n) = 2*a(n-1) - a(n-2) + 3*a(n-3) - 3*a(n-4) + 2*a(n-5) - 2*a(n-6) + a(n-7);  (a(0), ..., a(7)) =  (0, 1, 2, 4, 8, 13, 19).
%F A398849 G.f.: (x*(-1 - 2*x^2 - x^3 - 2*x^4 - x^5))/((-1 + x)^3 *(1 + x + 2*x^2 + x^3 + x^4)).
%F A398849 a(n) = ceiling( n*(7*n-5)/12 ).
%t A398849 z = 60;
%t A398849 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398849 r =-1/3; s = 1/2;
%t A398849 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398849 Table[v[n], {n, 0, z}]
%Y A398849 Cf. A000217, A000326, A398846, A398848.
%K A398849 nonn,easy,new
%O A398849 0,3
%A A398849 _Clark Kimberling_, Sep 17 2026
