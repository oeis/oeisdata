%T A398551 54,56,58,62,64,66,68,72,78,80,82,86,88,92,96,98,108,110,118,122,124,
%U A398551 128,138,140,148,152,170,182,188,208,212,218,222,232,238,266,268,272,282,292,296,328,332,358,362,392,482,512,628
%N A398551 Even numbers that are not sums of two isolated primes.
%C A398551 An isolated prime is a prime p such that neither p-2 nor p+2 is prime (A007510).
%C A398551 628 is the conjectured to be the last term.
%e A398551 2 is a term because it is not the sum of two isolated primes.
%e A398551 46 is not a term because it is the sum of two isolated primes: 46 = 23 + 23.
%o A398551 (Python)
%o A398551 from sympy import isprime
%o A398551 def is_isolated_prime(p):
%o A398551     return isprime(p) and not isprime(p-2) and not isprime(p+2)
%o A398551 def A_sequence(limit):
%o A398551     isolated = [p for p in range(2, limit+1) if is_isolated_prime(p)]
%o A398551     sums = set()
%o A398551     for i in range(len(isolated)):
%o A398551         for j in range(i, len(isolated)):
%o A398551             s = isolated[i] + isolated[j]
%o A398551             if s > limit:
%o A398551                 break
%o A398551             sums.add(s)
%o A398551     return [n for n in range(2, limit+1, 2) if n not in sums]
%o A398551 print(A_sequence(170000))
%Y A398551 Cf. A007510, A374591 (complement within positive even numbers A299174), A007534.
%K A398551 nonn,new
%O A398551 1,1
