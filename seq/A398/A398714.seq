%S A398714 56,95,1011,1021,1051,1061,1081,1091,1101,1201,1501,1601,1801,1901,
%T A398714 5596,5656,5866,5986,9595,9655,9865,9985,10011,10021,10051,10061,
%U A398714 10081,10091,10111,10121,10151,10161,10181,10191,11001,11101,12001,12101,15001,15101,16001,16101,18001,18101,19001,19101
%N A398714 Integers that need one iteration of 180-degree Rotate and Add to reach a strobogrammatic number (7-segment calculator-style numerals).
%C A398714 Let R(k) denote the integer obtained by rotating the decimal representation of k by 180 degrees using 7-segment calculator-style numerals, with digit map 0 -> 0, 1 -> 1, 2 -> 2, 5 -> 5, 6 -> 9, 8 -> 8, 9 -> 6, and reversing the order of the digits. R(k) is defined here only when every digit of k is in {0,1,2,5,6,8,9} and k does not end in 0, so that the rotated representation has no leading zero.
%C A398714 The sequence consists of the positive integers k that are not strobogrammatic, but for which k + R(k) is strobogrammatic in the sense of A018846.
%C A398714 The sequence is infinite. For every m >= 3, 10^m + 11 is a term. Its rotation is 1110^(m-1) + 1, and their sum is 2110^(m-1) + 12, whose decimal representation is 21 followed by m-3 zeros followed by 12 and is strobogrammatic.
%C A398714 If k is a term, then R(k) is also a term, since k + R(k) = R(k) + R(R(k)).
%C A398714 This is a rotational analog of the Reverse and Add sequence A065206.
%H A398714 <a href="/index/Res#RAA">Index entries for sequences related to Reverse and Add</a>.
%e A398714 56 is a term because R(56) = 95 and 56 + 95 = 151 is strobogrammatic.
%e A398714 95 is also a term because R(95) = 56 and 95 + 56 = 151.
%e A398714 101 is not a term because it is already strobogrammatic, so zero iterations are needed.
%e A398714 10 is not considered rotatable under the stated convention, because its 180-degree rotation would have a leading zero.
%o A398714 (Python)
%o A398714 rot = {
%o A398714     "0": "0",
%o A398714     "1": "1",
%o A398714     "2": "2",
%o A398714     "5": "5",
%o A398714     "6": "9",
%o A398714     "8": "8",
%o A398714     "9": "6"
%o A398714 }
%o A398714 def R(n):
%o A398714     s = str(n)
%o A398714     if s[-1] == "0" or any(c not in rot for c in s):
%o A398714         return None
%o A398714     return int("".join(rot[c] for c in reversed(s)))
%o A398714 def is_strobogrammatic(n):
%o A398714     r = R(n)
%o A398714     return r is not None and r == n
%o A398714 def is_term(n):
%o A398714     r = R(n)
%o A398714     return (r is not None
%o A398714     and not is_strobogrammatic(n)
%o A398714     and is_strobogrammatic(n + r))
%o A398714 def terms(limit):
%o A398714     return [n for n in range(1, limit + 1) if is_term(n)]
%o A398714 print(terms(20000))
%o A398714 (PARI)
%o A398714 R(n)=my(d=Vecrev(digits(n))); if((#d && d[1]==0)|| #select(x->x==3||x==4||x==7, d), -1, fromdigits([if(t==9||t==6, 15-t, t) | t<-d]))
%o A398714 isok(n,k=1)={while(k>=0, my(r=R(n)); if(r<0, break); if(r==n, return(k==0)); n+=r; k--); return(0)} \\ _Andrew Howroyd_, Aug 07 2026
%Y A398714 Cf. A018846 (strobogrammatic numbers using calculator-style numerals), A065206 (numbers needing one iteration of Reverse and Add to reach a palindrome).
%K A398714 nonn,base
%O A398714 1,1
