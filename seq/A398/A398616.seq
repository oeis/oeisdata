%T A398616 2,9,6,6,0,2,8,5,6,4,7,0,7,1,0,4,6,4,7,5,7,7,5,1,0,1,6,8,7,4,3,9,8,4,
%U A398616 3,1,5,7,7,5,4,1,9,8,8,9,6,3,7,9,8,2,5,3,5,4
%N A398616 Decimal expansion of the small face angle, in radians, of a canonical (dual-uniform) 9-gonal trapezohedron.
%C A398616 The 9-gonal trapezohedron is the dual polyhedron of the 9-gonal antiprism.
%C A398616 Its faces are kites with one acute angle (this constant) and three obtuse angles (A398617).
%H A398616 Paolo Xausa, <a href="/A398616/b398616.txt">Table of n, a(n) for n = 0..10000</a>
%H A398616 Polytope Wiki, <a href="https://polytope.miraheze.org/wiki/Enneagonal_antitegum">Enneagonal antitegum</a>.
%H A398616 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Trapezohedron.html">Trapezohedron</a>.
%F A398616 Equals arccos(3*(1/2 - cos(Pi/9) + cos(2*Pi/9))) = arccos(3*(1/2 - A019879 + A019859)).
%F A398616 Equals arccos(c), where c = 0.979055... is the second largest root of 8*x^3 - 36*x^2 + 27.
%e A398616 0.2050271024104247936704008773598588296602856470710...
%t A398616 First[RealDigits[ArcCos[3*(1/2 - Cos[Pi/9] + Cos[2*Pi/9])], 10, 100]]
%Y A398616 Cf. A398610 (volume), A398611 (surface area), A398612 (inradius), A398613 (midradius), A398614 (height).
%Y A398616 Cf. A398615 (long edge).
%Y A398616 Cf. A398617 (large face angle), A398618 (dihedral angle).
%Y A398616 Cf. A019859, A019879.
%K A398616 nonn,cons,easy
%O A398616 0,1
