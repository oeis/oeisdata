%T A398179 2,6,1,2,3,8,0,6,1,2,5,1,0,9,3,5,2,4,0,5,2,11,3,1,0,12,1,2,5,7,2,2,1,
%U A398179 2,1,6,0,10,1,2,5,4,1,4,1,9,6,1,0,17,1,2
%N A398179 Number of cubic symmetric graphs on 2n vertices.
%C A398179 Graphs are simple and undirected, and are counted up to isomorphism. Here "symmetric" means vertex- and edge-transitive, equivalently arc-transitive for odd valency.
%C A398179 Both connected and disconnected graphs are included. Every such graph is a disjoint union of isomorphic connected cubic symmetric graphs.
%C A398179 The counts through n = 5000 are obtained from Conder's complete census of connected cubic symmetric graphs on at most 10000 vertices.
%H A398179 Eric W. Weisstein, <a href="/A398179/b398179.txt">Table of n, a(n) for n = 1..5000</a>
%H A398179 Marston Conder, <a href="https://www.math.auckland.ac.nz/~conder/symmcubic10000list.txt">Trivalent (cubic) symmetric graphs on up to 10000 vertices</a>.
%H A398179 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/CubicSymmetricGraph.html">Cubic Symmetric Graph</a>.
%H A398179 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/SymmetricGraph.html">Symmetric Graph</a>.
%F A398179 a(n) = Sum_{d|n} A059282(d) = A059282(n) + A385181(n).
%e A398179 a(4) = 2: the cube graph and the disjoint union of two copies of K_4.
%t A398179 Module[{c},
%t A398179 	c = Lookup[Counts[StringCases[Import["https://www.math.auckland.ac.nz/~conder/symmcubic10000list.txt", "Text"], StartOfLine ~~ "C" ~~ v : DigitCharacter .. ~~ "." :> FromDigits[v]/2]], Range[5000], 0];
%t A398179 	Table[Total[c[[Divisors[n]]]], {n, 5000}]
%t A398179 ]
%Y A398179 Cf. A059282 (connected).
%Y A398179 Cf. A385181 (disconnected).
%K A398179 nonn,more,new
%O A398179 1,4
%A A398179 _Eric W. Weisstein_, Oct 29 2026
