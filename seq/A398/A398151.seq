%T A398151 8667,9153,10287,11097,12717,13203,13527,14013,15633,15957,18063,
%U A398151 18387,18873,19683,20817,21303,22437,22923,23733,24867,25353,25677,27297,28107,28593,29727
%N A398151 Composite numbers k such that A000005(k) divides k^2 + 1.
%H A398151 Michael S. Branicky, <a href="/A398151/b398151.txt">Table of n, a(n) for n = 1..10000</a>
%e A398151 For k = 567: (567^2 + 1) == 0 mod A000005(567), thus k = 567 is a term.
%t A398151 q[k_] := CompositeQ[k] && Divisible[k^2 + 1, DivisorSigma[0, k]]; Select[Range[30000], q] (* _Amiram Eldar_, Jul 22 2026 *)
%o A398151 (PARI) isok(k) = if ((k>1) && !isprime(k), (k^2+1) % numdiv(k) == 0); \\ _Michel Marcus_, Jul 22 2026
%o A398151 (Python)
%o A398151 from sympy import divisor_count
%o A398151 def ok(k): return (dc:=divisor_count(k))>2 and (k**2+1)%dc == 0
%o A398151 print([k for k in range(1, 30000) if ok(k)]) # _Michael S. Branicky_, Jul 22 2026
%Y A398151 Cf. A000005, A002522, A002808.
%K A398151 nonn,new
%O A398151 1,1
