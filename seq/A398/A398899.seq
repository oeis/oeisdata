%U A398899 129,133,134,135,140,141,142,145,147,148,153,158,164,166,169,170
%N A398899 Numbers k such that Omega(k) = Omega(k/d + d) for some divisor d of k and Omega = A001222.
%e A398899 2 is a term because Omega(2) = Omega(2/1 + 1) = Omega(3) = 1.
%t A398899 q[k_] := With[{om = PrimeOmega[k]}, AnyTrue[Divisors[k], PrimeOmega[# + k/#] == om &]]; Select[Range[170], q] (* _Amiram Eldar_, Oct 13 2026 *)
%o A398899 (Magma) [k: k in [1..170] | not #[d: d in Divisors(k) | (k eq 1 select 0 else &+[p[2]: p in Factorization(k)]) eq (((k div d)+d) eq 1 select 0 else &+[p[2]: p in Factorization(((k div d)+d))])] eq 0];
%o A398899 (PARI) isok(k) = my(f=factor(k), o=bigomega(f)); fordiv(f, d, if (bigomega(k/d+d) == o, return(1))); \\ _Michel Marcus_, Oct 04 2026
%o A398899 (Python)
%o A398899 from sympy import divisors, primeomega as Omega
%o A398899 def ok(k): Wk = Omega(k); return any(Omega(k//d + d) == Wk for d in divisors(k, generator=True))
%o A398899 print([k for k in range(1, 171) if ok(k)]) # _Michael S. Branicky_, Oct 13 2026
