%I A398374 #90 Aug 20 2026 03:44:07
%S A398374 1,1,2,4,16,32,128,768,6144,12288,49152,294912,2359296,23592960,
%T A398374 283115520,3963617280,63417876480,126835752960,507343011840,
%U A398374 3044058071040,24352464568320,243524645683200,2922295748198400,40912140474777600,654594247596441600,11782696456735948800,235653929134718976000
%N A398374 Number of permutations that give the maximum number of comparisons for sorting n elements by binary insertions.
%C A398374 The maximum number of comparisons for sorting n elements by binary insertion is A001855(n).
%H A398374 Alois P. Heinz, <a href="/A398374/b398374.txt">Table of n, a(n) for n = 0..504</a> (first 41 terms from Alexander Krivilev)
%H A398374 Alexander Krivilev, <a href="/A398374/a398374_1.jpg">Plot of a(n) for n = 0..64.</a>
%H A398374 A. V. Krivilev and E. O. Gavrichenko, <a href="https://journals.rcsi.science/0132-3474/article/view/437980">Analysis of the Binary Insertion Sort Algorithm and Its Modification Based on Comparison Forests</a>, Programming / Programming and computer software. 2026;1:40-59. (In Russian)
%F A398374 a(n) = a(n-1)*(2*n - 2^ceiling(log_2(n))) for n >= 1, a(0) = 1.
%F A398374 a(n) = a(n-1)*A152423(n). - _Jason Yuen_, Jul 30 2026
%e A398374 For n = 3, there are 6 permutations in total. Among them, a(3) = 4 permutations require the maximum number of comparisons, namely 3, when sorted using binary search: <1,2,3>, <1,3,2>, <2,1,3>, and <3,1,2>. The remaining permutations, <2,3,1> and <3,2,1>, require only 2 comparisons. This is the third row of the triangle in A395685.
%p A398374 a:= proc(n) option remember; `if`(n=0, 1,
%p A398374       a(n-1)*(2*n-2^ceil(log[2](n))))
%p A398374     end:
%p A398374 seq(a(n), n=0..26);  # _Alois P. Heinz_, Jul 28 2026
%t A398374 a[0]=1; a[n_/;n>0]:=a[n]=a[n-1](2*n-2^Ceiling[Log2[n]]);
%t A398374 Table[a[n], {n, 0, 30}]
%Y A398374 Column k=0 of A395685.
%Y A398374 Cf. A001855, A152423, A029837, A375959.
%K A398374 nonn,easy,changed
%O A398374 0,3
%A A398374 _Alexander Krivilev_, Jul 27 2026
