%I A398144 #31 Aug 13 2026 00:57:53
%S A398144 1,2,5,6,11,14,21,24,29,34,43,50,61,68,77,86,99,110,125,138,149,162,
%T A398144 179,194,211,226,245,266,285,306,329,352,369,388,409,434,459,482,507,
%U A398144 534,561,590,621,650,681,708,741,774,809,846,875,914,949,990,1021,1064,1097
%N A398144 a(n) is the number of pairs (i,j) with mu(i) = mu(j), 1 <= i,j <= n, where mu = A008683 (Moebius function).
%H A398144 Alois P. Heinz, <a href="/A398144/b398144.txt">Table of n, a(n) for n = 1..10000</a>
%F A398144 a(n) = A057627(n)^2 + A070548(n)^2 + A070549(n)^2.
%F A398144 a(n) = a(n-1) + 1 + 2 * A124579(n), a(0) = 0. - _Alois P. Heinz_, Aug 05 2026
%F A398144 a(n) = n*(n-2*A013928(n+1))+(A002321(n)^2+3*A013928(n+1)^2)/2 - _Chai Wah Wu_, Aug 12 2026
%p A398144 with(numtheory):
%p A398144 b:= proc(n) b(n):= `if`(n<1, 0, b(n-1)+x^mobius(n)) end:
%p A398144 a:= proc(n) a(n):= `if`(n<1, 0, a(n-1)+1+2*coeff(b(n-1), x, mobius(n))) end:
%p A398144 seq(a(n), n=1..57);  # _Alois P. Heinz_, Aug 05 2026
%t A398144 a[n_]:=Sum[Sum[Boole[MoebiusMu[i]==MoebiusMu[j]],{j,n}],{i,n}]; Array[a,57] (* _Stefano Spezia_, Jul 29 2026 *)
%o A398144 (PARI) a(n) = sum(i=1, n, sum(j=1, n, moebius(i)==moebius(j))); \\ _Michel Marcus_, Jul 29 2026
%o A398144 (PARI) lista(n) = {my(c=vector(3), s=0, a=vector(n)); for(n=1, n, my(k=2+moebius(n)); c[k]++; s+=2*c[k]-1; a[n]=s); a} \\ _Andrew Howroyd_, Aug 05 2026
%o A398144 (Python)
%o A398144 # uses Python code from A002321 and A013928
%o A398144 def A398144(n): return n*(n-((m:=A013928(n+1))<<1))+(A002321(n)**2+3*m**2>>1) # _Chai Wah Wu_, Aug 12 2026
%Y A398144 Cf. A008683, A057627, A070548, A070549, A124579.
%K A398144 nonn,easy
%O A398144 1,2
