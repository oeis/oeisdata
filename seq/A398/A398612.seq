%T A398612 6,3,5,1,5,6,5,6,5,4,8,8,6,7,1,2,6,9,5,4,7,0,2,0,3,8,6,6,3,9,1,0,0,9,
%U A398612 4,1,7,0,1,7,0,7,9,8,9,7,6,1,4,7,1,9,9,5,0,8
%N A398612 Decimal expansion of the inradius of a canonical (dual-uniform) 9-gonal trapezohedron with unit short edge length.
%C A398612 The 9-gonal trapezohedron is the dual polyhedron of the 9-gonal antiprism.
%H A398612 Paolo Xausa, <a href="/A398612/b398612.txt">Table of n, a(n) for n = 1..10000</a>
%H A398612 Polytope Wiki, <a href="https://polytope.miraheze.org/wiki/Enneagonal_antitegum">Enneagonal antitegum</a>.
%H A398612 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Trapezohedron.html">Trapezohedron</a>.
%H A398612 <a href="/index/Al#algebraic_06">Index entries for algebraic numbers, degree 6</a>.
%F A398612 Equals s*sqrt((3 - 2*c)*(4 - sec(Pi/18)^2))/(4*(4 - 5*c + cos(2*Pi/9))), where s = sin(Pi/9) = A019829 and c = cos(Pi/9) = A019879.
%F A398612 Equals the largest real root of 1088*x^6 - 5808*x^4 + 72*x^2 + 1.
%e A398612 2.307764545394549014073051081141062635156565488671...
%t A398612 First[RealDigits[Root[1088*#^6 - 5808*#^4 + 72*#^2 + 1 &, 4], 10, 100]]
%t A398612 (* Alternative: *)
%t A398612 First[RealDigits[PolyhedronData[{"Trapezohedron", 9}, "Inradius"], 10, 100]]
%Y A398612 Cf. A398610 (volume), A398611 (surface area), A398613 (midradius), A398614 (height).
%Y A398612 Cf. A398615 (long edge).
%Y A398612 Cf. A398616 (small face angle), A398617 (large face angle), A398618 (dihedral angle).
%Y A398612 Cf. A019829, A019879.
%K A398612 nonn,cons,easy
%O A398612 1,1
