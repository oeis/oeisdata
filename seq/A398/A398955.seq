%I A398955 #9 Aug 15 2026 07:53:57
%S A398955 1,2,3,4,5,9,10,11,12,13,17,18,19,20,21,28,29,33,34,35,36,37,41,42,43,
%T A398955 44,45,49,50,51,57,58,59,60,61,65,66,67,68,69,73,74,75,76,77,82,83,84,
%U A398955 85,89,90,91,92,93,97,98,99,100,101,105,109,113,114,115,116,117
%N A398955 Numbers k such that k, k+1, and k+2 are all cubefree.
%C A398955 The odd terms are also odd numbers k such that k*(k+1)*(k+3) is cubefree.
%C A398955 The asymptotic density of this sequence is Product_{p prime} (1 - 3/p^3) = 0.534566... (A389137).
%H A398955 Amiram Eldar, <a href="/A398955/b398955.txt">Table of n, a(n) for n = 1..10000</a>
%F A398955 1 <= a(n) mod 8 <= 5 for all n.
%e A398955 1 is a term since 1, 2, and 3 are cubefree numbers.
%e A398955 6 is not a term since 6+2 = 8 = 2^3 is not cubefree.
%t A398955 cubefreeQ[k_] := cubefreeQ[k] = Max @ FactorInteger[k][[;; , 2]] < 3;
%t A398955 Select[Range[120], 0 < Mod[#, 8] < 6 && And @@ cubefreeQ /@ (# + {0, 1, 2}) &]
%o A398955 (PARI) iscubefree(k) = if(k == 1, 1, vecmax(factor(k)[, 2]) < 3);
%o A398955 isok(k) = my(r = k % 8); if(!r || r > 5, 0 , iscubefree(k) && iscubefree(k+1) && iscubefree(k+2));
%Y A398955 Subsequence of A004709, A047603, and A340152.
%Y A398955 A328016 is a subsequence.
%Y A398955 Cf. A389137.
%K A398955 nonn,easy,new
%O A398955 1,2
%A A398955 _Amiram Eldar_, Aug 15 2026
