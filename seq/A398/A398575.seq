%S A398575 1,1,4,14,80,504,3659,28254,230200,1940896,16830963,149199518,
%T A398575 1347100491,12351762351,114762662456,1078567023868,10238839086876,
%U A398575 98062328327894,946624749441626,9202813850452962,90038222915138467,886005062314860152,8764423099912481148,87114874702825106136
%N A398575 Number of unlabeled 7-gonal cacti having n blocks.
%C A398575 For m=7 (odd), this reduces to a(n) = [x^n](g1(x) + (3/7)*x*(g7(x) - g1(x)^7)), where g1(x) = R(x) and g7(x) = R(x^7), R(x) the rooted series of A397210.
%H A398575 Frédéric G. Speyser, <a href="/A398575/b398575.txt">Table of n, a(n) for n = 1..51</a>
%H A398575 Frederic G. Speyser, <a href="https://github.com/frederic-speyser/non-plane-mgonal-cacti">verify_pari_dissymmetry_odd_m.gp</a>, independent verification of the PROG formula above.
%F A398575 G.f.: G(x) = T_Cm(x) + T_S(x) - T_{S-Cm}(x), via the dissymmetry theorem applied to the rooted series s(x) of the companion sequence.
%o A398575 (Python) # See Links
%o A398575 (PARI) EulerT(v)={Vec(exp(x*Ser(dirmul(v, vector(#v, n, 1/n))))-1, -#v)}
%o A398575 R(n)={my(v=[]); for(n=1, n, my(g=1+x*Ser(v)); v=EulerT(Vec((g^6 + subst(g^3, x, x^2))/2))); concat([1], v)}
%o A398575 seq(n)={my(p=Ser(R(n))); my(g1=p+O(x*x^n)); my(g7=subst(p+O(x*x^(n\7)), x, x^7)); Vec(g1 + 3*x*(g7-g1^7)/7)}
%Y A398575 Column k=7 of A332649.
%Y A398575 Cf. A397210.
%K A398575 nonn,new
%O A398575 1,3
%A A398575 _Frédéric G. Speyser_, Aug 03 2026
