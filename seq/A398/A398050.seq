%I A398050 #6 Jul 31 2026 05:34:24
%S A398050 0,1,3,7,13,20,28,37,48,61,75,90,106,124,144,165,187,210,235,262,290,
%T A398050 319,349,381,415,450,486,523,562,603,645,688,732,778,826,875,925,976,
%U A398050 1029,1084,1140,1197,1255,1315,1377,1440,1504,1569,1636,1705,1775,1846
%N A398050 Lower (1,1/5) midsequence of triangular numbers (A000217) and squares (A000290); see Comments.
%C A398050 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A397972 for a guide to related sequences.
%H A398050 <a href="/index/Rec#order_07">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,0,0,1,-2,1).
%F A398050 a(n) = 2*a(n-1) - a(n-2) + a(n-5) - 2*a(n-6) + a(n-7), with (a(0), ... a(6)) =  (0, 1, 3, 7, 13, 20, 28).
%F A398050 G.f.: -(x*(1 + x + 2*x^2 + 2*x^3 + x^4))/((-1 + x)^3*(1 + x + x^2 + x^3 + x^4)).
%t A398050 z = 60;
%t A398050 f[n_] := (n^2 + n)/2; g[n_] := n^2; r = 1; s = 1/5;
%t A398050 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]]
%t A398050 Table[u[n], {n, 0, z}]
%Y A398050 Cf. A000217, A000290, A398051, A398052.
%K A398050 nonn,easy,new
%O A398050 0,3
%A A398050 _Clark Kimberling_, Jul 26 2026
