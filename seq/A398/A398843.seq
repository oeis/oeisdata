%I A398843 #4 Sep 17 2026 00:53:11
%S A398843 0,0,2,6,13,23,35,49,66,86,108,132,159,189,221,255,292,332,374,418,
%T A398843 465,515,567,621,678,738,800,864,931,1001,1073,1147,1224,1304,1386,
%U A398843 1470,1557,1647,1739,1833,1930,2030,2132,2236,2343,2453,2565,2679,2796,2916
%N A398843 Upper (-2, 3/2)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398843 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398843 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (3,-4,4,-3,1).
%F A398843 a(n) = 3*a(n-1) - 4*a(n-2) + 4*a(n-3) - 3*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 0, 2, 6, 13).
%F A398843 G.f.: x*(1 - 4 x + x^2 - 3 x^3)/((-1 + x)^3 *(1 + x^2)).
%t A398843 z = 60;
%t A398843 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398843 r =-2; s = 3/2;
%t A398843 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398843 Table[v[n], {n, 0, z}]
%Y A398843 Cf. A000217, A000326, A398842.
%K A398843 nonn,easy,new
%O A398843 0,3
%A A398843 _Clark Kimberling_, Sep 15 2026
