%I A398647 #44 Sep 19 2026 17:34:41
%S A398647 100,111,122,133,144,155,166,177,188,199,200,212,224,236,248,300,313,
%T A398647 326,339,400,414,428,500,515,600,616,700,717,800,818,900,919,1000,
%U A398647 1100,1200,1300,1400,1500,1600,1700,1800,1900,2000,2100,2200,2300,2400,2500,2510,2600,2612,2700
%N A398647 Numbers that can be obtained by concatenating the decimal representations of x, y, and x*y for x >= 1 and y >= 0.
%C A398647 The multiplication analog of A398649, which concatenates x, y, and x+y.
%C A398647 For single-digit x and y the term is the concatenation of k = 10*x + y and the product of its digits, so the 90 terms with 1 <= x <= 9 and 0 <= y <= 9 form a subsequence of A302575.
%C A398647 A term may arise from more than one pair (x, y); the smallest such is 11111, from x = 1, y = 11 and x = 11, y = 1.
%C A398647 Unlike the other analogs, where a term has at most two representations, some terms here have three; the smallest is 26501300 = concat(2, 650, 1300) = concat(26, 50, 1300) = concat(265013, 0, 0).
%C A398647 There are 32 three-digit terms.
%F A398647 If y has q digits and x*y has r digits, then the term formed from (x, y) is x*10^(q + r) + y*10^r + x*y.
%e A398647 100 is a term because it is the concatenation of x = 1, y = 0 and x*y = 0.
%e A398647 111 is a term because it is the concatenation of x = 1, y = 1 and x*y = 1.
%e A398647 11111 is a term because it can be formed by x = 1, y = 11 or x = 11, y = 1.
%t A398647 f[x_, y_] := FromDigits[Join @@ IntegerDigits /@ {x, y, x*y}];
%t A398647 nn = 3000; Union@Reap[x = 1; While[FromDigits[Join @@ IntegerDigits /@ {x, 0, 0}] <= nn, y = 0; While[(v = f[x, y]) <= nn, Sow[v]; y++]; x++]][[2, 1]]
%o A398647 (Python)
%o A398647 def aupto(limit):
%o A398647     terms = set()
%o A398647     x = 1
%o A398647     while int(f"{x}00") <= limit:
%o A398647         y = 0
%o A398647         while True:
%o A398647             v = int(f"{x}{y}{x * y}")
%o A398647             if v > limit:
%o A398647                 break
%o A398647             terms.add(v)
%o A398647             y += 1
%o A398647         x += 1
%o A398647     return sorted(terms)
%o A398647 print(aupto(3000))
%Y A398647 Cf. A398649, A398566, A302575.
%K A398647 nonn,base,new
%O A398647 1,1
%A A398647 _Jakub Mráček_, Sep 13 2026
