%S A398222 1,54,6675,1475880,513778545,260240758470,181409620346955,
%T A398222 166891337000388000,196121724505994912625,286835510574819596139750,
%U A398222 511163927804287641506497875,1090684013819966468557864209000,2745737847093424321150900152890625,8053847166331135556579603957389593750
%N A398222 a(n) = Sum_{j=1..n} c(n,j)^2 * (2j-1)! * (2j-1), where c(n,j) = (2n)!/((n-j)! * (2j)! * 2^(n-j)).
%H A398222 Rongzhen Dai, <a href="https://doi.org/10.5281/zenodo.21287018">A deviation-cumulant scaling theorem for the Fisher-Wasserstein gap along phi^(2n) Gibbs families</a>, Zenodo, 2026.
%F A398222 a(n) = Sum_{j=1..n} c(n,j)^2 * (2j-1)! * (2j-1) with c(n,j) = (2n)!/((n-j)! * (2j)! * 2^(n-j)).
%F A398222 a(n) ~ 2^(4*n + 1/2) * n^(2*n) / exp(2*n) as n -> oo.
%F A398222 Recurrence: n*(2*n - 3)^2*(12*n^3 - 80*n^2 + 174*n - 123)*a(n) = (2*n - 1)^2*(288*n^6 - 2832*n^5 + 11164*n^4 - 22500*n^3 + 24322*n^2 - 13249*n + 2790)*a(n-1) - (2*n - 3)^3*(2*n - 1)^2*(216*n^5 - 1884*n^4 + 6292*n^3 - 9984*n^2 + 7447*n - 2052)*a(n-2) + (n-2)*(2*n - 5)^2*(2*n - 3)^2*(2*n - 1)^2*(4*n - 11)*(4*n - 9)*(12*n^3 - 44*n^2 + 50*n - 17)*a(n-3).
%t A398222 Table[((4*n)!/(2*n)! - (2*n)!^2/n!^2 - (2*n)!^2 * HypergeometricPFQ[{1, 1, 1-n, 1-n}, {3/2, 2, 2}, 1]/(n-1)!^2) / 2^(2*n), {n, 1, 15}] (* _Vaclav Kotesovec_, Jul 24 2026 *)
%o A398222 (Python)
%o A398222 from math import factorial
%o A398222 def c(n, j): return factorial(2*n)//(factorial(n-j)*factorial(2*j)*2**(n-j))
%o A398222 def a(n): return sum(c(n, j)**2*factorial(2*j-1)*(2*j-1) for j in range(1, n+1))
%K A398222 nonn,easy
%O A398222 1,2
%A A398222 _Rongzhen Dai_, Jul 23 2026
