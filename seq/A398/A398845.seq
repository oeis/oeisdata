%I A398845 #9 Sep 18 2026 06:17:45
%S A398845 0,1,4,7,13,20,28,38,49,62,76,92,109,128,149,170,194,219,245,273,302,
%T A398845 333,365,399,434,471,510,549,591,634,678,724,771,820,870,922,975,1030,
%U A398845 1087,1144,1204,1265,1327,1391,1456,1523,1591,1661,1732,1805,1880,1955
%N A398845 Upper (1/2, 1/3)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398845 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398845 <a href="/index/Rec#order_11">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1,-1,2,-1,1,-2,1).
%F A398845 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5) - a(n-6) + 2*a(n-7) - a(n-8) + a(n-9) - 2*a(n-10) + a(n-11);  (a(0), ..., a(10)) =  (0, 1, 4, 7, 13, 20, 28, 38, 49, 62, 76).
%F A398845 a(n) = ceiling( n*(9*n+1)/12). G.f.: -x*(1+2*x+2*x^3-x^4+x^5+x^9+2*x^7+x^8) / ( (1+x+x^2)*(x^2+1)*(x^4-x^2+1)*(x-1)^3 ). - _R. J. Mathar_, Sep 18 2026
%t A398845 z = 60;
%t A398845 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398845 r =1/2; s = 1/3;
%t A398845 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398845 Table[v[n], {n, 0, z}]
%Y A398845 Cf. A000217, A000326, A398844.
%K A398845 nonn,easy,new
%O A398845 0,3
%A A398845 _Clark Kimberling_, Sep 16 2026
