%I A398524 #11 Aug 06 2026 03:51:43
%S A398524 1,2,3,3,5,6,7,6,7,10,11,10,12,13,15,13,15,15,17,18,20,21,22,19,21,24,
%T A398524 24,24,26,29,30,27,29,31,33,30,32,34,36,35,37,39,40,39,41,43,44,39,40,
%U A398524 43,46,47,49,47,50,48,51,53,54,53,55,56,57,54,58,60,61,61,63,66
%N A398524 a(n) = Sum_{k=1..n} mu(floor(n/k))^2, where mu = A008683 is the Möbius function.
%C A398524 a(n) is the number of values of k in the range [1, n] for which floor(n/k) is squarefree.
%H A398524 Amiram Eldar, <a href="/A398524/b398524.txt">Table of n, a(n) for n = 1..10000</a>
%H A398524 Olivier Bordellès, <a href="https://doi.org/10.1142/S1793042122501056">On certain sums of number theory</a>, International Journal of Number Theory, Vol. 18, No. 9  (2022), pp. 2053-2074; <a href="https://arxiv.org/abs/2009.05751v2">arXiv preprint</a>, arXiv:2009.05751 [math.NT], 2020.
%H A398524 Kui Liu, Jie Wu, and Zhishan Yang, <a href="https://doi.org/10.1142/S179304212450043X">On some sums involving the integral part function</a>, International Journal of Number Theory, Vol. 20, No. 3 (2024), pp. 831-847; <a href="https://arxiv.org/abs/2109.01382">arXiv preprint</a>, arXiv:2109.01382 [math.NT], 2021.
%H A398524 Joshua Stucky, <a href="https://doi.org/10.1016/j.jnt.2021.09.015">The fractional sum of small arithmetic functions</a>, Journal of Number Theory, Vol. 238 (2022), pp. 731-739; <a href="https://arxiv.org/abs/2106.14142">arXiv preprint</a>, arXiv:2106.14142 [math.NT], 2021.
%H A398524 Wei Zhang, <a href="https://doi.org/10.1007/s10986-023-09611-1">On general sums involving the floor function with applications to k-free numbers</a>, Lithuanian Mathematical Journal, Vol. 63 (2023), pp. 547-556; <a href="https://arxiv.org/abs/2112.06156">arXiv preprint</a>, arXiv:2112.06156 [math.NT], 2021-2023.
%F A398524 a(n) = c * n + O(n^(3/5 + eps)), for any eps > 0, where c = 0.891810... = A398525 (Stucky, 2022).
%F A398524 The exponent in the error term was further improved to 1919/4268 + eps (Bordellès, 2022), 2/5 + eps (Liu et al., 2024), and 152/401 + eps (Zhang, 2023).
%t A398524 a[n_] := Sum[MoebiusMu[Floor[n/k]]^2, {k, 1, n}]; Array[a, 70]
%o A398524 (PARI) a(n) = sum(k = 1, n, issquarefree(n\k));
%Y A398524 Cf. A005117, A008683, A008966, A398525.
%K A398524 nonn,easy
%O A398524 1,2
%A A398524 _Amiram Eldar_, Aug 01 2026
