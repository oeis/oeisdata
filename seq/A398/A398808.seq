%I A398808 #29 Aug 20 2026 00:09:55
%S A398808 1,6,81,1392,26874,555660,12020778,268529904,6144053553,143212055766,
%T A398808 3387948944913,81123449546880,1962120667472784,47862747799761888,
%U A398808 1176064743384542736,29080543505336982144,723048610733223389946,18065218662820164577500,453308819571480290636250
%N A398808 a(n) = 27^n * [z^n] 2F1(1/3, 1/3; 1; z)^2.
%C A398808 This is the (e,d) = (3,2) member of the equianharmonic symmetric-power family. It is the self-convolution of A276018, hence all terms are integers.
%C A398808 The exponent 3 is uniformly optimal in both prime classes, and the inert orbit length 2 is minimal: v_7(a(7)-a(1))=3; also a(5) != a(1) (mod 5), while v_5(a(25)-a(1))=3.
%H A398808 Z.-X. Mao and J.-F. Tian, <a href="https://arxiv.org/abs/2601.09154">Recurrence relations and applications for the Maclaurin coefficients of squared and cubic hypergeometric functions</a>, arXiv:2601.09154 [math.CA], 2026.
%H A398808 Alex Shvets, <a href="https://doi.org/10.5281/zenodo.21866269">Frobenius-Orbit Completion of Maximal Two-Cusp Symmetric-Power Supercongruence Ladders and Ramified Endpoint Laws</a>, Zenodo, Version 16.4, 2026.
%F A398808 G.f.: G(x) = Sum_{n>=0} a(n)*x^n = 2F1(1/3,1/3;1;27*x)^2.
%F A398808 a(n) = 27^n*Sum_{k=0..n} ((1/3)_k)^2*((1/3)_(n-k))^2/(k!^2*(n-k)!^2), where (x)_j denotes the rising factorial.
%F A398808 a(n) = Sum_{k=0..n} A276018(k)*A276018(n-k).
%F A398808 n^3*a(n) = 6*(3n-2)*(3n^2-4n+2)*a(n-1) - 27*(3n-4)^3*a(n-2), n >= 2, with a(0)=1 and a(1)=6.
%F A398808 (theta^3 - 6*x*(3*theta+1)*(3*theta^2+2*theta+1) + 27*x^2*(3*theta+2)^3)*G(x) = 0 where theta=x*d/dx and G(x) is the g.f.
%F A398808 Sum_{n>=0} (-1)^n*a(n)*t_3(tau)^n = eta(tau)^6/eta(3*tau)^2 where t_3(tau) = (eta(3*tau)/eta(tau))^12.
%F A398808 a(m*p^(f*r)) == a(m*p^(f*(r-1))) (mod p^(3*(r+floor(v_p(m)/f)))) for every prime p >= 5, and m,r >= 1, where f = ord_3(p), so f=1 if p == 1 (mod 3) and f=2 if p == 2 (mod 3).
%F A398808 a(n) ~ (Gamma(1/3) * 3^(3*n+1) / (2*Pi^2 * n^(4/3))) * (1 - 16*Pi^4 / (3*Gamma(1/3)^8 * n^(1/3))). - _Vaclav Kotesovec_, Aug 10 2026
%e A398808 Writing b=A276018, a(2) = b(0)*b(2) + b(1)^2 + b(2)*b(0) = 36 + 9 + 36 = 81.
%e A398808 Equivalently, 2F1(1/3,1/3;1;27*x)^2 = 1 + 6*x + 81*x^2 + 1392*x^3 + ...
%p A398808 a := proc(n)
%p A398808 option remember;
%p A398808 if n = 0 then
%p A398808     1
%p A398808 elif n = 1 then
%p A398808     6
%p A398808 else
%p A398808     (6*(3*n-2)*(3*n^2-4*n+2)*a(n-1)
%p A398808      -27*(3*n-4)^3*a(n-2))/n^3
%p A398808 end if
%p A398808 end proc:
%p A398808 seq(a(n),n=0..18);
%t A398808 CoefficientList[Normal[Series[Hypergeometric2F1[1/3,1/3,1,27*x]^2, {x,0,18}]], x]
%o A398808 (Python)
%o A398808 def A(N):
%o A398808     a = [1]*(N + 1)
%o A398808     if N >= 1:
%o A398808         a[1] = 6
%o A398808     for n in range(2, N + 1):
%o A398808         num = (6*(3*n-2)*(3*n*n-4*n+2)*a[n-1]
%o A398808                - 27*(3*n-4)**3*a[n-2])
%o A398808         a[n], rem = divmod(num, n**3)
%o A398808         assert rem == 0
%o A398808     return a
%o A398808 (PARI) a(n) = my(z='z+O('z^(n+1))); polcoef(27^n*hypergeom([1/3, 1/3], 1, z)^2, n); \\ _Michel Marcus_, Aug 10 2026
%o A398808 (PARI) my(x='x+O('x^25)); Vec(hypergeom([1/3,1/3],[1],27*x)^2) \\ _Joerg Arndt_, Aug 10 2026
%Y A398808 Cf. A276018 (d=1; the present sequence is its self-convolution), A395287 (d=3), A002897 (lemniscatic d=2 analog), and A395125 (cubic Belyi pullback).
%K A398808 nonn,easy,new
%O A398808 0,2
%A A398808 _Alex Shvets_, Aug 09 2026
