%S A398371 1,0,1,3,-2,1,5,19,-3,1,1,41,7,-4,1,7,5,101,229,-5,1,1,41,7,887,41,-6,
%T A398371 1,1,107,43,2159,671,457,-7,1,1,1,187,403,527,6259,641,-8,1,11,83,173,
%U A398371 3433,9517,391387,68417,12053,-9,1,1,5,29,8593,161,75067,75001,20527,2087,-10
%N A398371 Triangle of numerators of coefficients of the polynomials generating the rows in A398004.
%C A398371 The n-th row of the symmetric array corresponding to A398004 is given by a polynomial of degree n. The leading terms are the reciprocals A001710. Here, the coefficients of the n-th row of coefficients appears to start with 1 and end with -n (except for n=1).
%C A398371 For the denominator sequence, A398372, note that the first entry of each row corresponds to A001710, and the last appears to always be 1.
%C A398371 The k-th row polynomial of degree n, denoted A(n,k), fulfills the identity A(n,k) = A(n,k-1) + A(n-1,k) + n + k and A(k,1)=A(1,k)=k. Furthermore, A(k,n)=A(n,k).
%C A398371 The leading terms are the reciprocals of A001710.
%e A398371 The first few polynomials are
%e A398371   A(n,1) = n,
%e A398371   A(n,2) = n^2 + 3*n - 2,
%e A398371   A(n,3) = (1/3)*n^3 + (5/2)*n^2 + (19/6)*n - 3,
%e A398371   A(n,4) = (1/12)*n^4 + n^3 + (41/12)*n^2 + (7/2)*n - 4,
%e A398371   A(n,5) = (1/60)*n^5 + (7/24)*n^4 + (5/3)*n^3 + (101/24)*n^2 + (229/60)*n - 5,
%e A398371   ...
%e A398371 The next leading terms are (1/360)*n^6, (1/2520)*n^7, (1/20160)*n^8.
%e A398371 Numerators of the coefficients of first rows of A398004, starting and descending from the leading term:
%e A398371   1  0
%e A398371   1  3  -2
%e A398371   1  5  19  -3
%e A398371   1  1  41   7   -4
%e A398371   1  7   5 101  229   -5
%e A398371   1  1  41   7  887   41     -6
%e A398371   1  1 107  43 2159  671    457    -7
%e A398371   1  1   1 187  403  527   6259   641    -8
%e A398371   1 11  83 173 3433 9517 391387 68417 12053   -9
%e A398371   1  1   5  29 8593  161  75067 75001 20527 2087 -10   ...
%o A398371 (Python)
%o A398371 from sympy import Symbol, expand, Poly, summation
%o A398371 def compute_polynomial_triangle(max_k):
%o A398371     n = Symbol('n')
%o A398371     i = Symbol('i')
%o A398371     table = {}
%o A398371     table[1] = Poly(n, n)
%o A398371     for k in range(2, max_k + 1):
%o A398371         prev = table[k-1]
%o A398371         S = Poly(
%o A398371             summation(prev.as_expr().subs(n, i), (i, 2, n)),
%o A398371             n
%o A398371         )
%o A398371         table[k] = Poly(
%o A398371             expand(S.as_expr() + (n*(n+1))/2 - 1 + k*(n-1) + k),
%o A398371             n
%o A398371 )
%o A398371     return table
%o A398371 def generate(n):
%o A398371     table = compute_polynomial_triangle(n)
%o A398371     nums = []
%o A398371     for k in sorted(table.keys()):
%o A398371         poly = table[k]
%o A398371         coeffs = poly.all_coeffs()
%o A398371         for c in coeffs:
%o A398371             k, d = c.as_numer_denom()
%o A398371             nums.append(k)
%o A398371     return nums
%Y A398371 Cf. A398004, A398372 (denominators).
%K A398371 tabf,easy,frac,sign
%O A398371 1,4
