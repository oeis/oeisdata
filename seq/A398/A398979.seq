%S A398979 1,0,0,0,1,0,1,1,3,0,4,3,5,5,8,5,15,11,12,19,25,20,34,36,41,47,60,60,
%T A398979 87,90,94,126,150,145,188,209,242,278,313,341,418,464,505,598,684,719,
%U A398979 861,966,1072,1205,1344,1506,1739,1910,2098,2376,2691,2930,3307,3684
%N A398979 Number of strict partitions of n such that if k is the number of parts then no part is divisible by k.
%F A398979 G.f.: Sum_{i>=0} Sum_{j=0..i} (-1)^(j) * q^((j^2 - j + i^2 + i)/2)/( (q;q)_{i-j} * (q^i;q^i)_j ) where (a;b)_j = Product_{k=0..j-1} (1 - a*b^k).
%e A398979 a(12) = 5: (11,1), (9,3), (7,5), (7,4,1), (6,3,2,1).
%o A398979 (PARI)
%o A398979 qs(a,b,i) = {if(i<1,1,prod(k=0,i-1, 1-a*b^k))}
%o A398979 D_q(N) = {my(q='q+O('q^(N+1))); Vec(sum(i=0,N, sum(j=0,i, (-1)^(j) * q^((j^2 - j + i^2 + i)/2)/( qs(q,q,i-j)* qs(q^i,q^i,j)))))}
%Y A398979 Cf. A000009, A240855, A240861, A399879.
%K A398979 nonn,easy,new
%O A398979 0,9
