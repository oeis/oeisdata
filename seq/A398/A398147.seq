%I A398147 #34 Jul 29 2026 16:21:02
%S A398147 1,10,73,470,2828,16310,91371,501150,2704755,14413900,76030744,
%T A398147 397678540,2065389557,10662468530,54759921917,279968785890,
%U A398147 1425729262884,7235072160450,36600959443615,184639969946950,929098786833511,4664483202043160,23368963515952688,116854936602749720,583303084330372713
%N A398147 Expansion of generating function x/(1-5*x+x^2)^2.
%C A398147 The self-convolution (convolution order s=1) of the sequence A004254.
%H A398147 Paolo Xausa, <a href="/A398147/b398147.txt">Table of n, a(n) for n = 1..1000</a>
%H A398147 T. M. Brown, D. Dmytryshyn, and A. M. Stokolos, <a href="https://doi.org/10.13140/RG.2.2.14770.77760">Convolutions of linear recurrent sequences and Gegenbauer polynomials</a>, Preprint, 2026.
%H A398147 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,-27,10,-1).
%F A398147 a(n) = 10*a(n-1)-27*a(n-2)+10*a(n-3)-a(n-4) for n >= 5, a(1) = 1, a(2) = 10, a(3) = 73, a(4) = 470.
%F A398147 a(n) = (5*n*a(n-1)-(n+1)*a(n-2))/(n-1) for n >= 3, a(1) = 1, a(2) = 10.
%F A398147 a(n) = Sum_{j=0..n-1} b(j+1)*b(n-j), where b(j) = A004254(j).
%F A398147 a(n) = GegenbauerC(n-1,2,5/2), where GegenbauerC(n,m,x) is the Gegenbauer polynomial.
%F A398147 a(n) = (n*(r1^(n+2)-r2^(n+2))-(n+2)*(r1^n-r2^n))/21^(3/2), where r1 = (5+sqrt(21))/2 and r2 = (5-sqrt(21))/2.
%F A398147 a(n) = (n*A004254(n+2)-(n+2)*A004254(n))/21.
%F A398147 a(n) = Sum_{j=0..floor((n-1)/2)} (n-j)*binomial(n-1-j, j)*(-1)^j*5^(n-1-2*j).
%F A398147 G.f.: x/(1-5*x+x^2)^2.
%F A398147 E.g.f.: exp(5*x/2)*((23*x/21)*cosh(sqrt(21)*x/2)+(5*sqrt(21)*x/21- 4*sqrt(21)/441)*sinh(sqrt(21)*x/2)).
%p A398147 G := proc (n) option remember: if n = 0 then return 0 end if: if n = 1 then return 1 end if: return 5*(n)*G(n-1)/(n-1)-(n+1)*G(n-2)/(n-1) end proc: N:=20: seq(G(k), k = 1 .. N);
%t A398147 LinearRecurrence[{10, -27, 10, -1}, {1, 10, 73, 470}, 25] (* _Paolo Xausa_, Jul 29 2026 *)
%Y A398147 Cf. A004254, A006190, A395431, A395902.
