%U A398261 165,176,187,198,209,220,231,242,253,264,275,286,297,308,319,330,341,352,363,374,385
%N A398261 Irregular triangular array read by rows: the first row is 1, 2. Thereafter, if the last entry of the previous row has greatest prime factor p, the next row is formed from the p smallest unused positive multiples of p.
%H A398261 Michael De Vlieger, <a href="/A398261/b398261.txt">Table of n, a(n) for n = 1..31998</a> (rows n = 1..40, flattened)
%H A398261 Michael De Vlieger, <a href="/A398261/a398261.png">Log log scatterplot of a(n)</a>, n = 1..1347578 (rows 1..60).
%H A398261 Michael De Vlieger, <a href="/A398261/a398261_1.png">Plot prime(i)^m | a(n) at (x,y) = (n,i)</a>, n = 1..2048, 8X vertical exaggeration, with a color function representing m = 1 in black, m = 2 in red, m = 3 in orange, ..., m = 9 in magenta.
%e A398261 Triangle begins:
%e A398261     1,   2;
%e A398261     4,   6;
%e A398261     3,   9,  12;
%e A398261    15,  18,  21;
%e A398261     7,  14,  28,  35,  42,  49,  56;
%e A398261    63,  70,  77,  84,  91,  98, 105;
%e A398261   112, 119, 126, 133, 140, 147, 154;
%e A398261    11,  22,  33,  44,  55,  66,  88,  99, 110, 121, 132;
%e A398261   ...
%t A398261 nn = 10; c[_] = False; m[_] = 1; s = {{1, 2}}; k = s[[-1, -1]]; i = Length[s]; Map[Set[c[#], True] &, Flatten[s]]; s~Join~Reap[Do[w = {}; g = FactorInteger[k][[-1, 1]]; Do[While[c[m[g]*g], m[g]++]; AppendTo[w, m[g]*g]; Set[c[m[g]*g], True]; k = w[[-1]], {j, g}]; Sow[w], {n, i + 1, nn}]][[-1, 1]] (* _Michael De Vlieger_, Jul 25 2026 *)
%o A398261 (PARI) A398261_first(N)={my(a=1, p=1, count=2, S=[]); vector(N, j, count || a = count = p = vecmax(factor(a)[,1]); while(setsearch(S, a), a+=p); count--; S=setunion(S, [a]); a)+print("Least unused numbers: ", setminus([1..25], S))} \\ _M. F. Hasler_, Jul 25 2026
