%I A398854 #11 Sep 21 2026 00:48:36
%S A398854 0,1,6,14,25,40,58,79,104,132,163,198,236,277,322,370,421,476,534,595,
%T A398854 660,728,799,874,952,1033,1118,1206,1297,1392,1490,1591,1696,1804,
%U A398854 1915,2030,2148,2269,2394,2522,2653,2788,2926,3067,3212,3360,3511,3666,3824
%N A398854 Lower (1/3, 1)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398854 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398854 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients, signature (2,-1,1,-2,1)</a>
%F A398854 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) = (0, 1, 6, 14, 25).
%F A398854 G.f.: -x*(1 + 4*x + 3*x^2 + 2*x^3)/((-1 + x)^3 *(1 + x + x^2)).
%F A398854 E.g.f.: exp(-x/2)*(-exp(3*x/2) + 12*exp(3*x/2)*x + 15*exp(3*x/2)*x^2 + cos(sqrt(3)*x/2) - sqrt(3)*sin(sqrt(3)*x/2))/9. - _Stefano Spezia_, Sep 19 2026
%t A398854 z = 60;
%t A398854 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398854 r = 1/3; s = 1;
%t A398854 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398854 Table[u[n], {n, 0, z}]
%Y A398854 Cf. A000217, A000326, A398855.
%K A398854 nonn,easy,new
%O A398854 0,3
%A A398854 _Clark Kimberling_, Sep 18 2026
