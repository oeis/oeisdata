%S A398618 2,4,7,3,0,6,4,2,5,4,0,8,5,3,2,7,8,1,3,7,3,4,4,7,9,5,4,0,3,4,0,0,4,0,
%T A398618 5,3,2,7,3,7,4,6,6,2,8,2,3,5,1,4,3,1,5,1,5,6,4,1,5,7,4,8,9,7,4,7,3,8,
%U A398618 4,9,6,0,4,1,5,9,7,7,0,5,2,0,6,6,8,5,8,2,8,5
%N A398618 Decimal expansion of the dihedral angle, in radians, between any two adjacent faces in a canonical (dual-uniform) 9-gonal trapezohedron.
%C A398618 The 9-gonal trapezohedron is the dual polyhedron of the 9-gonal antiprism.
%H A398618 Paolo Xausa, <a href="/A398618/b398618.txt">Table of n, a(n) for n = 1..10000</a>
%H A398618 Polytope Wiki, <a href="https://polytope.miraheze.org/wiki/Enneagonal_antitegum">Enneagonal antitegum</a>.
%H A398618 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Trapezohedron.html">Trapezohedron</a>.
%F A398618 Equals arccos(1 + 2/(2*cos(Pi/9) - 3)) = arccos(1 + 2/(2*A019879 - 3)).
%F A398618 Equals arccos(c), where c = -0.78473... is the smallest root of 17*x^3 - 3*x^2 - 9*x + 3.
%e A398618 2.4730642540853278137344795403400405327374662823514...
%t A398618 First[RealDigits[ArcCos[1 + 2/(2*Cos[Pi/9] - 3)], 10, 100]]
%t A398618 (* Alternative: *)
%t A398618 First[RealDigits[First[PolyhedronData[{"Trapezohedron", 9}, "DihedralAngles"]], 10, 100]]
%Y A398618 Cf. A398610 (volume), A398611 (surface area), A398612 (inradius), A398613 (midradius), A398614 (height).
%Y A398618 Cf. A398615 (long edge).
%Y A398618 Cf. A398616 (small face angle), A398617 (large face angle).
%Y A398618 Cf. A395169, A395170 (dihedral angles of the dual).
%Y A398618 Cf. A019879.
%K A398618 nonn,cons,easy,new
%O A398618 1,1
