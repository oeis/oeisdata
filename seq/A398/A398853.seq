%I A398853 #10 Sep 21 2026 00:48:15
%S A398853 0,2,7,15,27,43,62,84,110,140,173,209,249,293,340,390,444,502,563,627,
%T A398853 695,767,842,920,1002,1088,1177,1269,1365,1465,1568,1674,1784,1898,
%U A398853 2015,2135,2259,2387,2518,2652,2790,2932,3077,3225,3377,3533,3692,3854,4020
%N A398853 Upper (1/2, 1)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398853 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398853 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients, signature (3,-4,4,-3,1)</a>
%F A398853 a(n) = 3*a(n-1) - 4*a(n-2) + 4*a(n-3) - 3*a(n-4) + a(n-5), (a(0), ..., a(4)) = (0, 2, 7, 15, 27).
%F A398853 G.f.: -(x (2 + x + 2*x^2 + 2*x^3)/((-1 + x)^3 *(1 + x^2))).
%F A398853 E.g.f.: (exp(x)*(1 + 6*x + 7*x^2) - cos(x) + sin(x))/4. - _Stefano Spezia_, Sep 19 2026
%t A398853 z = 60;
%t A398853 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398853 r = 1/2; s = 1;
%t A398853 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398853 Table[v[n], {n, 0, z}]
%Y A398853 Cf. A000217, A000326, A398852.
%K A398853 nonn,easy,new
%O A398853 0,2
%A A398853 _Clark Kimberling_, Sep 18 2026
