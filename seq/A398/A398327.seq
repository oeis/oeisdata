%I A398327 #18 Sep 04 2026 16:42:53
%S A398327 0,1,2,4,5,8,10,11,20,32,40,131,257,263,350,448,634,725,803,832,1769,
%T A398327 2363,2548,3544,4508,4904,5494,10114,23135,33755,40661,49354,65968
%N A398327 Numbers k such that (10*4^k - 1)/3 is prime.
%C A398327 Also numbers k such that A072197(k) is prime.
%C A398327 For k > 1, k = 2, 4, or 5 (mod 6) since:
%C A398327   - If k > 0 and k = 0 (mod 3), 10*4^k - 1 is divisible by 9, so (10*4^k - 1)/3 is a multiple of 3.
%C A398327   - If k > 1 and k = 1 (mod 6), 10*4^k - 1 is divisible by 13, so (10*4^k - 1)/3 is a multiple of 13.
%e A398327 1 is a term since (10*4^1 - 1)/3 = 39/3 = 13, prime.
%e A398327 2 is a term since (10*4^2 - 1)/3 = 159/3 = 53, prime.
%e A398327 3 is not a term since (10*4^3 - 1)/3 = 639/3 = 213 = 3 * 71, composite.
%o A398327 (Python)
%o A398327 from gmpy2 import mpz, is_prime
%o A398327 def ok(k):
%o A398327     if k > 1 and k % 6 not in (2, 4, 5):
%o A398327         return False
%o A398327     return is_prime(((mpz(10) << (2 * k)) - 1) // 3)
%o A398327 print([k for k in range(3000) if ok(k)]) # edited by _Michael S. Branicky_, Aug 30 2026
%Y A398327 Cf. A083584, A002450, A001045, A072197, A153894, A052549.
%K A398327 nonn,hard,more,new
