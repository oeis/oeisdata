%I A398665 #5 Aug 27 2026 00:55:15
%S A398665 0,2,11,31,65,117,192,294,426,592,797,1045,1339,1683,2082,2540,3060,
%T A398665 3646,4303,5035,5845,6737,7716,8786,9950,11212,12577,14049,15631,
%U A398665 17327,19142,21080,23144,25338,27667,30135,32745,35501,38408,41470,44690,48072,51621
%N A398665 Lower (1/2, 2) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398665 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398665 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398665 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) =  (0, 2, 11, 31, 65, 117).
%F A398665 G.f.: x*(2 + 3*x + x^2 + 2*x^3)/((-1 + x)^4 *(1 + x^2)).
%t A398665 z = 60;
%t A398665 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398665 r = 1/2; s = 2;
%t A398665 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398665 Table[u[n], {n, 0, z}]
%Y A398665 Cf. A000217, A000330, A398666.
%K A398665 nonn,easy,new
%O A398665 0,2
%A A398665 _Clark Kimberling_, Aug 25 2026
