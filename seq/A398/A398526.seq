%I A398526 #8 Aug 03 2026 03:08:04
%S A398526 1,2,3,4,5,6,7,7,9,10,11,12,13,14,15,14,16,18,19,20,21,22,23,22,24,25,
%T A398526 26,28,29,30,31,29,31,33,34,36,37,38,39,38,40,41,42,43,45,46,47,44,46,
%U A398526 48,50,51,52,52,54,54,56,57,58,59,60,61,63,60,62,64,65,67,68,69
%N A398526 a(n) = Sum_{k=1..n} A212793(floor(n/k)).
%C A398526 a(n) is the number of values of k in the range [1, n] for which floor(n/k) is cubefree.
%H A398526 Amiram Eldar, <a href="/A398526/b398526.txt">Table of n, a(n) for n = 1..10000</a>
%H A398526 Joshua Stucky, <a href="https://doi.org/10.1016/j.jnt.2021.09.015">The fractional sum of small arithmetic functions</a>, Journal of Number Theory, Vol. 238 (2022), pp. 731-739; <a href="https://arxiv.org/abs/2106.14142">arXiv preprint</a>, arXiv:2106.14142 [math.NT], 2021.
%H A398526 Wei Zhang, <a href="https://doi.org/10.1007/s10986-023-09611-1">On general sums involving the floor function with applications to k-free numbers</a>, Lithuanian Mathematical Journal, Vol. 63 (2023), pp. 547-556; <a href="https://arxiv.org/abs/2112.06156">arXiv preprint</a>, arXiv:2112.06156 [math.NT], 2021-2023.
%F A398526 a(n) >= A398524(n).
%F A398526 a(n) = c * n + O(n^(1/2 + eps)), for any eps > 0, where c = 0.974129... = A398527 (Stucky, 2022).
%F A398526 The error term was further improved to O(n^(1/3)*log(n)) (Zhang, 2023).
%t A398526 cubeFreeQ[n_] := cubeFreeQ[n] = Boole[Max[FactorInteger[n][[;;, 2]]] < 3];
%t A398526 a[n_] := Sum[cubeFreeQ[Floor[n/k]], {k, 1, n}]; Array[a, 70]
%o A398526 (PARI) iscubefree(n) = #select(e -> e > 2, factor(n)[, 2]) == 0;
%o A398526 a(n) = sum(k = 1, n, iscubefree(n\k));
%Y A398526 Cf. A004709, A212793, A398524, A398527.
%K A398526 nonn,easy,new
%O A398526 1,2
%A A398526 _Amiram Eldar_, Aug 01 2026
