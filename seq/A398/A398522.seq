%I A398522 #9 Aug 03 2026 03:09:15
%S A398522 1,4,5,11,9,18,13,26,23,26,21,48,34,37,35,54,43,63,49,70,56,53,48,109,
%T A398522 83,74,72,86,72,105,82,119,102,93,85,150,118,112,98,147,121,145,122,
%U A398522 137,131,119,114,223,179,170,150,153,139,187,158,200,165,153,148,265,215,200,191,238
%N A398522 a(n) = Sum_{k=1..n} tau_3(floor(n/k)), where tau_3 = A007425 is the 3rd Piltz function.
%H A398522 Amiram Eldar, <a href="/A398522/b398522.txt">Table of n, a(n) for n = 1..10000</a>
%H A398522 Olivier Bordellès, <a href="https://doi.org/10.1142/S1793042122501056">On certain sums of number theory</a>, International Journal of Number Theory, Vol. 18, No. 9  (2022), pp. 2053-2074; <a href="https://arxiv.org/abs/2009.05751v2">arXiv preprint</a>, arXiv:2009.05751 [math.NT], 2020.
%H A398522 Kui Liu, Jie Wu, and Zhishan Yang, <a href="https://doi.org/10.1142/S179304212450043X">On some sums involving the integral part function</a>, International Journal of Number Theory, Vol. 20, No. 3 (2024), pp. 831-847; <a href="https://arxiv.org/abs/2109.01382">arXiv preprint</a>, arXiv:2109.01382 [math.NT], 2021.
%H A398522 Wei Zhang, <a href="https://doi.org/10.1142/S1793042123500665">On fractional sums of the divisor functions</a>, International Journal of Number Theory, Vol. 19, No. 6 (2023), pp. 1379-1386; <a href="https://arxiv.org/abs/2207.00923">arXiv preprint</a>, arXiv:2207.00923 [math.NT], 2022-2023.
%H A398522 Wei Zhang, <a href="https://doi.org/10.1016/j.jnt.2023.10.011">On a variant of the prime number theorem</a>, Journal of Number Theory, Vol. 257 (2024), pp. 163-185; <a href="https://arxiv.org/abs/2303.12347">arXiv preprint</a>, arXiv:2303.12347 [math.NT], 2023.
%F A398522 a(n) = c * n + O(n^(283/574 + eps)), for any eps > 0, where c = 3.40282... = A398523 (Bordellès, 2022).
%F A398522 The exponent in the error term was further improved to 14/29 + eps (Liu et al., 2024), 9/19 + eps (Zhang, 2023), and 92/195 + eps (Zhang, 2024).
%t A398522 f[p_, e_] := (e+1)*(e+2)/2; tau3[1] = 1; tau3[n_] := tau3[n] = Times @@ f @@@ FactorInteger[n];
%t A398522 a[n_] := Sum[tau3[Floor[n/k]], {k, 1, n}]; Array[a, 64]
%o A398522 (PARI) tau3(n) = vecprod(apply(e -> (e+1)*(e+2)/2, factor(n)[, 2]));
%o A398522 a(n) = sum(k = 1, n, tau3(n\k));
%Y A398522 Cf. A007425, A398523.
%K A398522 nonn,easy
%O A398522 1,2
%A A398522 _Amiram Eldar_, Aug 01 2026
