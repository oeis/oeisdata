%I A398343 #28 Sep 16 2026 17:19:56
%S A398343 1,2,3,6,5,4,4,4,4,7,6,6,10,15,5,8,8,10,9,7,12,8,14,6,10,8,11,13,12,9,
%T A398343 7,18,6,11,14,14,8,25,24,22,9,11,9,16,21,8,12,11,16,12,8,14,16,20,26,
%U A398343 15,20,22,10,14,25,33,11,13,12,9,19,8,12,24,21,14,30
%N A398343 a(n) = (Sum_{d|k} rad(d)) / rad(k), where k = A398342(n) and rad = A007947.
%C A398343 Conjecture: For each term m, m appears only a finite amount of times in the sequence.
%H A398343 David A. Corneth, <a href="/A398343/b398343.txt">Table of n, a(n) for n = 1..4032</a> (first 1200 terms from Žiga Pirc)
%F A398343 a(n) = Sum_{d|A398342(n)} rad(d) / rad(A398342(n)).
%e A398343 a(3) = 3, rad(A398342(3)) = rad(20) = 10. Sum of radicals of 20 is 30, so 30/10 = 3.
%t A398343 f[p_, e_] := (1 + e*p)/p; s[1] = 1; s[k_] := Times @@ f @@@ FactorInteger[k]; Select[Array[s, 20000], IntegerQ] (* _Amiram Eldar_, Sep 05 2026 *)
%Y A398343 Cf. A398342, A007947, A191750, A054030.
%K A398343 nonn,new
%O A398343 1,2
%A A398343 _Žiga Pirc_, Sep 02 2026
