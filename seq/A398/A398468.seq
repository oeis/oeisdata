%I A398468 #7 Aug 02 2026 17:36:39
%S A398468 97,21601,45053,56501,104021,345601,426941,437401,1351421,2160001,
%T A398468 2613601,3936727,4409677,4608701,5326901,5880727,6393941,6566741,
%U A398468 8323253,9077401,9750581,10233341,13392343,22018301,23380183,26791253,30060757,32016601,32685463,37117781,43580501,46310741,46704601
%N A398468 Primes of the form prime(k+1)^3-prime(k)^3-1.
%C A398468 Sequence A176135 sorted in increasing order.
%C A398468 If a prime p is equal to prime(k+1)^3-prime(k)^3-1 for more than one k, it would be listed more than once (but it seems unlikely that such terms occur).
%H A398468 Robert Israel, <a href="/A398468/b398468.txt">Table of n, a(n) for n = 1..10000</a>
%e A398468 a(1) = prime(2)^3 - prime(1)^3 - 1 = 5^3 - 3^3 - 1 = 97.
%e A398468 a(2) = prime(17)^3 - prime(16)^3 - 1 = 61^3 - 59^3 - 1 = 21601.
%e A398468 a(3) = prime(15)^3 - prime(14)^3 - 1 = 53^3 - 47^3 - 1 = 45053.
%e A398468 a(4) = prime(16)^3 - prime(15)^3 - 1 = 59^3 - 53^3 - 1 = 56501.
%p A398468 N:= 10^8: # for terms <= N
%p A398468 M:= ceil(fsolve(6*p^2 + 12*p + 7 = N, p=0..N)):
%p A398468 P:= select(isprime,[seq(i,i=3..M,2)]):
%p A398468 sort(select(t -> t <= N and isprime(t), [seq(P[i+1]^3 - P[i]^3-1,i=1..nops(P)-1)]));
%Y A398468 Cf. A000040, A176135.
%K A398468 nonn
%O A398468 1,1
%A A398468 _Robert Israel_, Jul 30 2026
