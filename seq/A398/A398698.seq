%I A398698 #10 Aug 10 2026 05:05:44
%S A398698 1,5,10,21,57,47,335,85,397,37,2083,197,2521,1465,1849,4943,42263,847,
%T A398698 16015,1571,307,122369,2857747,263,6413,50987,231329,11078,321577,
%U A398698 1075,165029,4027,36571,316501,2182837,59617,545621,285797,7342627,26781,1093211,431,129099,171921,191896
%N A398698 a(n) = numerator(Sum_{k=1..n} sigma(floor(n/k))/floor(n/k)), where sigma(n) = A000203(n) is the sum of divisors of n.
%H A398698 Amiram Eldar, <a href="/A398698/b398698.txt">Table of n, a(n) for n = 1..10000</a>
%H A398698 Jing Ma and Huayan Sun, <a href="https://doi.org/10.1007/s11139-022-00588-y">On a sum involving certain arithmetic functions and the integral part function</a>, The Ramanujan Journal, Vol. 60, No. 4 (2023), pp. 1025-1032; <a href="https://doi.org/10.1007/s11139-026-01336-2">Correction</a>, ibid., Vol. 69 (2026); <a href="https://arxiv.org/abs/2109.02924">arXiv preprint</a>, arXiv:2109.02924 [math.NT], 2021; <a href="https://www.researchgate.net/publication/361229857">ResearchGate link</a>. See Theorem 1, p. 1027.
%F A398698 a(n)/A398699(n) = c * n + O(n^(1/3)*log(n)), where c = 1.26113... = A398700 (Ma and Sun, 2023).
%e A398698 Fractions begin with 1, 5/2, 10/3, 21/4, 57/10, 47/6, 335/42, 85/8, 397/36, 37/3, 2083/165, 197/12, ...
%t A398698 a[n_] := Numerator[Sum[DivisorSigma[-1, Floor[n/k]], {k, 1, n}]]; Array[a, 45]
%o A398698 (PARI) a(n) = numerator(sum(k = 1, n, sigma(n\k, -1)));
%Y A398698 Cf. A000203, A017665, A398532, A398699 (denominators), A398700.
%K A398698 nonn,frac,easy,new
%O A398698 1,2
%A A398698 _Amiram Eldar_, Aug 07 2026
