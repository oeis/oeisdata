%I A398598 #20 Nov 01 2026 13:29:36
%S A398598 3,6,22,64,202,618,1914,5898,18214,56194,173446,535242,1651878,
%T A398598 5097834,15732694,48552970,149841046,462428586,1427115414,4404263082,
%U A398598 13592130646,41947082794,129454162006,399512393898,1232947270230,3805035792042,11742835877206,36239920382122
%N A398598 a(n) is the number of distinct paths of length n which begin and end on an odd number on the graph shown in the comments.
%C A398598 A step is defined as a movement from one number to another.
%C A398598      2---3---4
%C A398598       \ / \ /
%C A398598    0---1---5---6
%H A398598 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (1,6,2,-2).
%F A398598 G.f.: -(2*x^2-3*x-3)/((x+1)*(2*x^3-4*x^2-2*x+1)).
%F A398598 a(n) + a(n+1) = A091140(n+3).
%e A398598 For n=2, the 22 paths are 121, 123, 131, 135, 151, 153, 101, 313, 315, 321, 323, 343, 345, 351, 353, 513, 515, 531, 535, 543, 545, and 565.
%o A398598 (PARI) seq(n)={my(M=matrix(7,7,i,j,abs(i-j)==1||(i%2==0&&j%2==0&&i!=j)), u=vector(7,i,i%2==0)); vector(n+1,n,u*M^(n-1)*u~) } \\ _Andrew Howroyd_, Sep 28 2026
%Y A398598 Cf. A091140.
%K A398598 nonn,easy,new
%O A398598 0,1
%A A398598 _Robert J. Boyd_, Sep 27 2026
