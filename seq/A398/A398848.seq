%I A398848 #9 Sep 18 2026 08:54:36
%S A398848 0,0,1,4,7,12,18,25,34,43,54,66,79,93,108,125,142,161,181,202,225,248,
%T A398848 273,299,326,354,383,414,445,478,512,547,584,621,660,700,741,783,826,
%U A398848 871,916,963,1011,1060,1111,1162,1215,1269,1324,1380,1437,1496,1555
%N A398848 Lower (-1/3, 1/2)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398848 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398848 <a href="/index/Rec#order_11">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1,-1,2,-1,1,-2,1).
%F A398848 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5) - a(n-6) + 2*a(n-7) - a(n-8) + a(n-9) - 2*a(n-10) + a(n-11);  (a(0), ..., a(10)) =  (0, 0, 1, 4, 7, 12, 18, 25, 34, 43, 54).
%F A398848 a(n) = floor( n*(7*n-5)/12 ).
%F A398848 G.f.: -x^2*(1+2*x+x^3-x^4+x^5+x^7+x^6+x^8) / ( (1+x+x^2)*(x^2+1)*(x^4-x^2+1)*(x-1)^3 ).
%t A398848 z = 60;
%t A398848 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398848 r =-1/3; s = 1/2;
%t A398848 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398848 Table[u[n], {n, 0, z}]
%Y A398848 Cf. A000217, A000326, A398847, A398849.
%K A398848 nonn,easy,new
%O A398848 0,4
%A A398848 _Clark Kimberling_, Sep 17 2026
