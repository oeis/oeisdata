%S A398871 0,0,2,30,828,49900,6802110,2103962070,1467394528824,2287260323223480,
%T A398871 7896153221662717530,59870186079704761896850,
%U A398871 989601334793592919037055108,35425824084121006833908228407140,2730883915591895554663314383259246774,451059849564882642649626869575039818792750
%N A398871 Total number of nodes with in-degree 1 in all acyclic digraphs on n labeled nodes.
%C A398871 a(n) is the total number of nodes having exactly one parent, summed over all A003024(n) acyclic digraphs on n labeled nodes.
%D A398871 R. W. Robinson, Counting labeled acyclic digraphs, pp. 239-273 of F. Harary, editor, New Directions in the Theory of Graphs. Academic Press, NY, 1973.
%F A398871 a(0) = a(1) = 0; for n >= 2, a(n) = Sum_{k=1..n-1} (-1)^(k+1)*binomial(n,k)*2^(k*(n-k-1))*(k*(n-k)*2^(n-k-1)*A003024(n-k-1) + a(n-k)).
%F A398871 a(n) = n!*2^binomial(n,2)*[x^n] x^2*E(-x/4)/(2*E(-x)*E(-x/2)), where E(x) = Sum_{k>=0} x^k/(k!*2^binomial(k,2)).
%F A398871 Limit_{n->oo} a(n)/A003024(n) = p^2*E(-p/4)/(2*E(-p/2)) = 1.8975989219132281882770528..., where p is the smallest positive root of E(-x) (A245654).
%t A398871 Table[n!*2^(n*(n-1)/2) * SeriesCoefficient[x^2*Sum[(-1)^k*x^k / (k!*2^(k*(k+3)/2)), {k, 0, n}] / (2*Sum[(-1)^k*x^k / (k!*2^(k*(k-1)/2)), {k, 0, n}] * Sum[(-1)^k*x^k / (k!*2^(k*(k+1)/2)), {k, 0, n}]), {x, 0, n}], {n, 0, 15}] (* _Vaclav Kotesovec_, Aug 12 2026 *)
%o A398871 (Python)
%o A398871 from math import comb
%o A398871 def a(n):
%o A398871     d = [1] + [0]*n
%o A398871     A = [0]*(n+1)
%o A398871     for m in range(1, n+1):
%o A398871         d[m] = sum((-1)**(k+1)*comb(m,k)*2**(k*(m-k))*d[m-k] for k in range(1, m+1))
%o A398871         A[m] = sum((-1)**(k+1)*comb(m,k)*2**(k*(m-k-1))*(k*(m-k)*2**(m-k-1)*d[m-k-1] + A[m-k]) for k in range(1, m))
%o A398871     return A[n]
%o A398871 print([a(n) for n in range(16)])
%Y A398871 Cf. A003024, A361718, A081064.
%K A398871 nonn
%O A398871 0,3
