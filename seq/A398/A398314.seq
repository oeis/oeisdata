%I A398314 #16 Aug 08 2026 19:35:02
%S A398314 1,4,18,8,150,36,1470,16,54,300,25410,72,390390,2940,450,32,8678670,
%T A398314 108,184294110,600,4410,50820,5131136010,144,750,780780,162,5880,
%U A398314 187621103670,900,6217375194030,64,76230,17357340,7350,216,274567310987970,368588220,1171170
%N A398314 a(n) = n * A002110(pi(gpf(n))), where pi = A000720 and gpf(n) is the greatest prime factor of n.
%C A398314 Terms in row a(n) of A067255 are increased by 1 from those in row n of A067255.
%C A398314 Sequence is nonprime (all terms are in A018252).
%C A398314 1 is the only squarefree term.
%C A398314 Intersection with A000961 (powers of primes) is A151821 (powers of 2 without 2 itself).
%C A398314 Intersection with A246547 is 2^m, m > 1.
%C A398314 Terms are distinct and in A055932.
%C A398314 a(n) is in A025487 iff n is in A025487.
%C A398314 The range of the terms is exactly the intersection of {1} U A070003 and A055932. - _Peter Munn_, Aug 05 2026
%H A398314 Michael De Vlieger, <a href="/A398314/b398314.txt">Table of n, a(n) for n = 1..2356</a>
%F A398314 a(n) = n * A002110(A000720(A006530(n))).
%e A398314 a(1) = 1 by definition.
%e A398314 a(2) = 4 since 2, multiplied by all primes that do not exceed gpf(2) = 2, is 4.
%e A398314 a(3) = 18 since 3, multiplied by 2 and 3, is 18.
%e A398314 a(4) = 8 since 4 * 2 = 8.
%e A398314 a(5) = 150 since 5 * (2 * 3 * 5) = 150.
%e A398314 a(6) = 36 since 6 * (2 * 3) = 36, etc.
%t A398314 f[x_] := x*Times @@ Prime@ Range@ PrimePi@ FactorInteger[x][[-1, 1]]; f[1] = 1; Array[f, 40]
%o A398314 (PARI) a(n) = if (n==1, 1, n*vecprod(primes(primepi(vecmax(factor(n)[,1]))))); \\ _Michel Marcus_, Aug 01 2026
%Y A398314 Cf. A000720, A002110, A006530, A018252, A025487, A055932, A067255, A070003, A073039, A151821.
%K A398314 nonn,easy,new
%O A398314 1,2
