%I A398473 #17 Aug 12 2026 18:02:29
%S A398473 4,7,7,59,54,51,40,40,81,81,80,77,105,81,135,124,124,173,183,224,224,
%T A398473 246,287,298,376,368,395,363,357,433,447,440,547,546,463,535,520,514,
%U A398473 550,606
%N A398473 Maximum dropping time for numbers between 2^n and 2^(n+1)-1 under the Collatz map A014682.
%C A398473 The dropping time of n under A014682 is given by A126241.
%H A398473 David Barina, <a href="https://pcbarina.fit.vutbr.cz/path-records.htm">Table with found path records</a>
%H A398473 Kazunobu Hikawa, <a href="/A398473/a398473.py.txt">Python Program</a>
%H A398473 Kazunobu Hikawa and Kazuo Nakanishi, <a href="https://doi.org/10.13140/RG.2.2.12065.06240">Parity Vector Analysis in the Study of the Collatz Conjecture</a>, ResearchGate preprint, January 2026.
%H A398473 Eric Roosendaal, <a href="http://www.ericr.nl/wondrous/index.html">On The 3x + 1 Problem</a>
%F A398473 a(n) = max{A126241(m) : 2^n <= m < 2^(n+1)}.
%e A398473 For n = 1, the interval [2,4) contains 2 and 3. Their dropping times (A126241) are 1 and 4. Hence a(1) = 4.
%e A398473 For n = 2, the interval [4,8) contains 4, 5, 6, and 7. Their dropping times (A126241) are 1, 2, 1, and 7. Hence a(2) = 7.
%o A398473 (Python)
%o A398473 def step(n):
%o A398473     return n // 2 if n % 2 == 0 else (3*n + 1) // 2
%o A398473 def dropping_time(n):
%o A398473     m = n
%o A398473     g = 0
%o A398473     while m >= n:
%o A398473         m = step(m)
%o A398473         g += 1
%o A398473     return g
%o A398473 def a(n):
%o A398473     lo = 1 << n
%o A398473     hi = 1 << (n + 1)
%o A398473     max_dt = -1
%o A398473     for m in range(lo + 1, hi, 2):   # Even integers have the same dropping time as their half.
%o A398473         dt = dropping_time(m)
%o A398473         if dt > max_dt:
%o A398473             max_dt = dt
%o A398473     return max_dt
%o A398473 print([a(n) for n in range(1, 11)])
%Y A398473 Cf. A014682, A126241, A398447.
%K A398473 nonn,more
%O A398473 1,1
%A A398473 _Kazunobu Hikawa_, Jul 31 2026
