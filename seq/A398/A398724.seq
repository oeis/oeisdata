%U A398724 382,422,464,511,564,620,680,748,821,900,986,1079,1182,1293,1411,1542,1685,1836
%N A398724 Number of partitions of n into parts congruent to 2, 3 or 7 (mod 8).
%H A398724 Carla D. Savage and Andrew V. Sills, <a href="https://doi.org/10.1016/j.aam.2009.12.009">On an identity of Gessel and Stanton and the new little Göllnitz identities</a>, Advances in Applied Mathematics, Volume 46, Issues 1-4, January 2011, Pages 563-575. See Theorem 2.1 (Göllnitz) p. 565.
%F A398724 G.f.: 1/(1 - Sum_{k == 2, 3, or 7 (mod 8)} x^k );
%o A398724 (PARI) isok(v) = #select(x->(((x % 8)!=2) && ((x%8) != 3) && ((x%8)!= 7)), v) == 0;
%o A398724 a(n) = nb=0; forpart(x=n, if (isok(Vec(x)), nb++)); nb;
%Y A398724 Cf. A131795 (same with signs).
%Y A398724 Cf. A036015, A036016, A108932.
%K A398724 nonn
%O A398724 0,7
