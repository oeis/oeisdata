%S A398221 1,0,0,5,47,466,5370,71841,1099227,18962190,364351110,7719772215,
%T A398221 178842653745,4497914360940,122057451456780,3554931926299635,
%U A398221 110613273135779925,3662094406399572780,128539647752265994860,4768021443310498049985
%N A398221 Number of assembly trees of the complement of the n-path graph.
%C A398221 For n = 2 and 3, the complement of P_n is disconnected, giving a(2) = a(3) = 0.
%C A398221 For n >= 4, the only disconnected induced subgraphs of the complement of P_n are those induced by consecutive pairs and consecutive triples of path vertices.
%C A398221 Inclusion-exclusion over these forbidden clades gives the formula below. A selected pair has net weight -1; a selected triple, after accounting for its two pair subclades, also has net weight -1. The multinomial coefficient counts disjoint pair and triple intervals.
%C A398221 The formal o.g.f. below has radius of convergence 0.
%H A398221 Andrew Vince and Miklos Bona, <a href="https://arxiv.org/abs/1204.3842">The Number of Ways to Assemble a Graph</a>, arXiv:1204.3842 [math.CO], 2012.
%H A398221 Andrew Vince and Miklos Bona, <a href="https://doi.org/10.37236/2644">The Number of Ways to Assemble a Graph</a>, Electron. J. Combin. 19 (2012), no. 4, P54.
%H A398221 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/AssemblyNumber.html">Assembly Number</a>.
%H A398221 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/PathComplementGraph.html">Path Complement Graph</a>.
%F A398221 a(n) = Sum_{q=0..floor(n/3)} Sum_{p=0..floor((n-3*q)/2)} (-1)^(p+q)*multinomial(p,q,n-2*p-3*q)*(2*(n-p-2*q)-3)!!.
%F A398221 G.f.: (x-x^2-x^3)*2F0(1/2,1;;2*(x-x^2-x^3)).
%F A398221 a(n) = (2*n-1)*a(n-1) + (14-4*n)*a(n-2) + (8-2*n)*a(n-3) + (4*n-21)*a(n-4) + (2*n-13)*a(n-5) for n >= 6.
%F A398221 a(n) ~ 2^(n - 1/2) * n^(n-1) / exp(n + 1/2). - _Vaclav Kotesovec_, Jul 24 2026
%e A398221 a(4) = 5 since the complement of P_4 is isomorphic to P_4, whose assembly number is CatalanNumber(3) = 5.
%t A398221 Table[Sum[(-1)^(p + q) Multinomial[p, q, n - 2 p - 3 q] (2 (n - p - 2 q) - 3)!!, {q, 0, Floor[n/3]}, {p, 0, Floor[(n - 3 q)/2]}], {n, 20}]
%t A398221 (* Alternative: *)
%t A398221 CoefficientList[Series[(x - x^2 - x^3) HypergeometricPFQ[{1/2, 1}, {}, 2 (x - x^2 - x^3)]/x, {x, 0, 20}], x]
%t A398221 (* Alternative: *)
%t A398221 RecurrenceTable[{a[n] == (2 n - 1) a[n - 1] + (14 - 4 n) a[n - 2] + (8 - 2 n) a[n - 3] + (4 n - 21) a[n - 4] + (2 n - 13) a[n - 5], a[1] == 1, a[2] == 0, a[3] == 0, a[4] == 5, a[5] == 47}, a[n], {n, 20}]
%Y A398221 Cf. A217523 (complete bipartite graphs).
%Y A398221 Cf. A361072 (complete tripartite graphs).
%K A398221 nonn,easy,new
%O A398221 1,4
