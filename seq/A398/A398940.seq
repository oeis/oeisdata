%S A398940 2,5,9,8,2,7,9,7,8,3,3,2,3,0,8,0,2,1,3,3,9,1,6,7,3,0,1,2,6,9,8,0,0,3,
%T A398940 0,9,4,6,9,3,3,8,1,8,6,3,8,6,7,9,2,9,7,3,8,5,0,3,9,7,0,4,4,8,4,9,9,6,
%U A398940 4,2,0,8,4,5,6,1,6,7,5,5,3,3,1,2,7,1,7,9,0,8
%N A398940 Decimal expansion of the inradius of a canonical (dual-uniform) 10-gonal trapezohedron with unit short edge length.
%C A398940 The 10-gonal trapezohedron is the dual polyhedron of the 10-gonal antiprism.
%H A398940 Paolo Xausa, <a href="/A398940/b398940.txt">Table of n, a(n) for n = 1..10000</a>
%H A398940 Polytope Wiki, <a href="https://polytope.miraheze.org/wiki/Decagonal_antitegum">Decagonal antitegum</a>.
%H A398940 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Trapezohedron.html">Trapezohedron</a>.
%H A398940 <a href="/index/Al#algebraic_08">Index entries for algebraic numbers, degree 8</a>.
%F A398940 Equals sin(Pi/10)*sqrt((2*cos(Pi/10) - 3)*(sec(Pi/20)^2 - 4))/(4*(4 - 5*cos(Pi/10) + cos(Pi/5))) = A019827*sqrt((2*A019881 - 3)*(sec(Pi/20)^2 - 4))/(4*(4 - 5*A019881 + A019863)).
%F A398940 Equals the largest real root of 10496*x^8 - 74496*x^6 + 24496*x^4 + 384*x^2 + 1.
%e A398940 2.5982797833230802133916730126980030946933818638679...
%t A398940 First[RealDigits[Root[10496*#^8 - 74496*#^6 + 24496*#^4 + 384*#^2 + 1 &, 4], 10, 100]]
%t A398940 (* Alternative: *)
%t A398940 First[RealDigits[PolyhedronData[{"Trapezohedron", 10}, "Inradius"], 10, 100]]
%Y A398940 Cf. A398938 (volume), A398939 (surface area), A398941 (midradius), A398942 (height).
%Y A398940 Cf. A398943 (long edge).
%Y A398940 Cf. A398944 (small face angle), A398945 (large face angle), A398946 (dihedral angle).
%Y A398940 Cf. A019827, A019863, A019881.
%K A398940 nonn,cons,easy
%O A398940 1,1
%A A398940 _Paolo Xausa_, Aug 17 2026
