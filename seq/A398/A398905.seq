%I A398905 #10 Sep 15 2026 16:58:45
%S A398905 2,3,4,5,6,7,12,18,30,42,60,72,102,108,138,150,180,192,198,222,228,
%T A398905 240,270,282,312,348,402,420,432,438,462,522,570,600,618,642,660,810,
%U A398905 822,828,858,882,942,1020,1032,1038,1050,1062,1092,1152,1230,1278,1290,1302,1320,1362,1428,1452,1482,1488,1542,1578
%N A398905 Numbers k > 1 such that k^3 - k has no divisors d with k + 1 < d < 2*k - 2.
%C A398905 k > 3 is a term iff A341902(k) = k - 2.
%C A398905 The first term > 7 that is not in A014574 is 222.
%H A398905 Robert Israel, <a href="/A398905/b398905.txt">Table of n, a(n) for n = 1..10000</a>
%e A398905 a(6) = 7 is a term because 7^3 - 7 = 336 has no divisors greater than 7 + 1 = 8 and less than 2*7 - 2 = 12.
%p A398905 filter:= proc(k) local L,U,F,r,rp,t,i,v;
%p A398905   U:= 2*k-2; L:= k+1;
%p A398905   F:= ifactors(k^3-k)[2];
%p A398905   r:= {1};
%p A398905   for t in F do
%p A398905     rp:= r;
%p A398905     for i from 1 to t[2] while t[1]^i < U do
%p A398905       v:= select(`<`, r *~ t[1]^i, U);
%p A398905       if max(v) > L then return false fi;
%p A398905       rp:= rp union v;
%p A398905     od;
%p A398905     r:= rp;
%p A398905   od;
%p A398905   true
%p A398905 end proc:
%p A398905 select(filter, [$2 .. 2000]);
%Y A398905 Cf. A341902. Includes A014574.
%K A398905 nonn,new
%O A398905 1,1
%A A398905 _Robert Israel_, Sep 11 2026
