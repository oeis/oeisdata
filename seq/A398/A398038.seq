%I A398038 #51 Aug 20 2026 03:24:01
%S A398038 1,1,10,4185,216924160,2757843017578125,14251326294864274554617856,
%T A398038 44750206312820249056750306493626846705,
%U A398038 119287800658185325744619170995595352660597314085191680,359403958423249167669520016933033980728137154503065812617853612710167785
%N A398038 a(n) is the number of closed binary operations * on a set N of n elements such that t*(t*t)=(t*t)*t for every t in N (up to equality of operations as functions on N X N into N; i.e., labeled case of elements).
%C A398038 Associative, commutative, and idempotent operations all have this property.
%H A398038 Paolo Xausa, <a href="/A398038/b398038.txt">Table of n, a(n) for n = 0..26</a>
%H A398038 David Pasino, <a href="/A398038/a398038.pdf">Binary Operations with Unique Cubing Function</a>.
%F A398038 a(n) = n^(n^2-2n) * n! * Sum_{k,s,r,t: k=0..n, s=0..floor((n-k)/2), r=0..floor((n-k-2s)/2), t=0..n-k-2s-2r} multinomial(n-s-r,k,s,r,t,n-k-t-2r-2s) * (-1)^(n+k+r+t) * n^(k+s+t) / (2^(s+r) * (n-s-r)!).
%e A398038 On 2 elements the 10 operations of this kind are 2 constants,
%e A398038 00   11
%e A398038 00   11,
%e A398038 2 isomorphs of parity addition,
%e A398038 01   10
%e A398038 10   01,
%e A398038 2 isomorphs of parity multiplication,
%e A398038 00   01
%e A398038 01   11,
%e A398038 2 isomorphs of Sheffer logical connective (not both p and q),
%e A398038 10   11
%e A398038 00   10,
%e A398038 and left and right projection,
%e A398038 00   01
%e A398038 11   01.
%e A398038 All of these but the projections are commutative, hence rather trivially satisfy x(xx) = (xx)x. The projections are idempotent, also rather trivially satisfying x(xx) = (xx)x.
%e A398038 The remaining 6 operations on {0, 1} are the isomorphs of combinatorial exponentiation on {0, 1},
%e A398038 10   00
%e A398038 11   10,
%e A398038 their transposes,
%e A398038 11   11
%e A398038 01   01,
%e A398038 and the left and right "conjections"
%e A398038 (left conjection xy = x', right conjection xy = y',
%e A398038 where 0' = 1 and 1' = 0),
%e A398038 11  10
%e A398038 00  10.
%e A398038 (The isomorph of
%e A398038 ab
%e A398038 cd
%e A398038 is
%e A398038 d'c'
%e A398038 b'a'.)
%e A398038 In the {0, 1}-exponentiation operation
%e A398038 10
%e A398038 11
%e A398038 we have (00)0 = 10 = 1 while 0(00) = 01 = 0.
%e A398038 The property x(xx) = (xx)x is invariant under passage from an operation to its transpose or its isomorph.
%e A398038 For the left conjection we have (00)0 = 10 = 0 and 0(00) = 01 = 1.
%e A398038 For an example that is not idempotent, commutative, or associative, but has unique cubes, an operation on {0, 1, 2}:
%e A398038 220
%e A398038 010
%e A398038 000.
%e A398038 This not idempotent, as 00 = 2 != 0,
%e A398038 not commutative, as 01 = 2 and 10 = 0,
%e A398038 not associative, as 0(12) = 00 = 2 and (01)2 = 22 = 0,
%e A398038 but this operation has unique cubes:
%e A398038 (00)0 = 20 = 0      0(00) = 02 = 0,
%e A398038 (11)1 = 11 = 1      1(11) = 11 = 1,
%e A398038 (22)2 = 02 = 0      2(22) = 20 = 0.
%p A398038 a:= n-> n^(n^2-2*n)*n!*add(add(add(add(combinat[multinomial](n-s-r, k,
%p A398038     s, r, t, n-k-t-2*r-2*s)*(-1)^(n+k+r+t)*n^(k+s+t)/(2^(s+r)*(n-s-r)!),
%p A398038      t=0..n-k-2*s-2*r), r=0..(n-k-2*s)/2), s=0..(n-k)/2), k=0..n):
%p A398038 seq(a(n), n=0..9);  # _Alois P. Heinz_, Aug 12 2026
%t A398038 A398038[n_] := If[n == 0, 1, n^(n*(n - 2))*n!*Sum[Multinomial[k, s, r, t, n - k - t - 2*(r + s)]*(-1)^(n + k + r + t)*n^(k + s + t)/(2^(r + s)*(n - s - r)!), {k, 0, n}, {s, 0, (n - k)/2}, {r, 0, (n - k)/2 - s}, {t, 0, n - k - 2*(r + s)}]];
%t A398038 Array[A398038, 10, 0] (* _Paolo Xausa_, Aug 19 2026 *)
%Y A398038 Cf. A002489, A023813, A023814, A090588.
%K A398038 nonn,new
