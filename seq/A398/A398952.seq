%I A398952 #7 Aug 15 2026 07:57:06
%S A398952 1,5,7,11,13,17,19,29,31,35,37,41,43,53,55,59,61,65,67,71,73,77,79,83,
%T A398952 85,89,91,95,97,101,103,107,109,113,115,127,131,133,137,139,143,145,
%U A398952 149,151,155,157,161,163,179,181,185,187,191,193,197,199,203,205,209
%N A398952 Smaller members in pairs of successive 5-rough numbers that are both squarefree numbers.
%C A398952 The asymptotic density of this sequence is (1/3) * Product_{p prime >= 5} (1 - 2/p^2) = (6/7) * Product_{p prime} (1 - 2/p^2) = (6/7) * A065474 = 0.276543513376495431925... .
%H A398952 Amiram Eldar, <a href="/A398952/b398952.txt">Table of n, a(n) for n = 1..10000</a>
%e A398952 The pairs are {1, 5}, {5, 7}, {7, 11}, {11, 13}, {13, 17}, {17, 19}, {19, 23}, {29, 31}, ...
%t A398952 r[n_] := (6*n - 3 + (-1)^n)/2;
%t A398952 r /@ Select[Range[70], SquareFreeQ[r[#]] && SquareFreeQ[r[# + 1]] &]
%o A398952 (PARI) list(nmax) = {my(s = select(x -> gcd(x, 6) == 1, vector(nmax, n, n))); for(i = 1, #s, if(!issquarefree(s[i]), s[i] = -s[i])); for(i = 1, #s-1, if(!(s[i]>0 && s[i+1]>0), s[i]=0)); s[#s]=0; select(x -> x > 0, s);}
%Y A398952 Subsequence of A005117, A007310 (5-rough numbers), and A276378 (5-rough squarefree numbers).
%Y A398952 Cf. A007674, A065474, A069977.
%K A398952 nonn,easy
%O A398952 1,2
%A A398952 _Amiram Eldar_, Aug 15 2026
