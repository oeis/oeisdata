%I A398442 #13 Aug 08 2026 21:44:32
%S A398442 18,50,75,90,98,126,147,198,234,242,245,306,338,342,350,363,414,507,
%T A398442 522,525,550,558,578,605,630,650,666,722,738,774,825,845,846,847,850,
%U A398442 867,950,954,975,990,1058,1062,1078,1083,1098,1150,1170,1183,1206,1274,1275
%N A398442 Numbers k of the form q(k) * rad(k), where rad = A007947 and q(k) is the second smallest distinct prime factor of k.
%C A398442 Proper subset of A332785 (numbers neither squarefree nor powerful).
%C A398442 Superset of A095990 (numbers with unsorted prime signature (1,2)).
%C A398442 Terms have at least 2 distinct prime factors, therefore, rad(a(n)) is in A120944.
%C A398442 Unsorted prime signature of a(n) is (1,2), followed by zero or more 1's.
%C A398442 Smallest term with m distinct prime factors, with m >= 2, is 3*A002110(m).
%H A398442 Michael De Vlieger, <a href="/A398442/b398442.txt">Table of n, a(n) for n = 1..10000</a>
%e A398442 Table of n, a(n) for select n:
%e A398442    n   a(n)
%e A398442   ---------------------------
%e A398442    1    18 = 2 * 3^2
%e A398442    2    50 = 2 * 5^2
%e A398442    3    75 = 3 * 5^2
%e A398442    4    90 = 2 * 3^2 * 5
%e A398442    5    98 = 2 * 7^2
%e A398442    6   126 = 2 * 3^2 * 7
%e A398442    7   147 = 3 * 7^2
%e A398442    8   198 = 2 * 3^2 * 11
%e A398442    9   234 = 2 * 3^2 * 13
%e A398442   10   242 = 2 * 11^2
%e A398442   11   245 = 5 * 7^2
%e A398442   25   630 = 2 * 3^2 * 5 * 7
%t A398442 nn = 1350; k = 3; mm = nn/k; Union@ Map[If[# <= nn, #, Nothing] &[#*FactorInteger[#][[2, 1]] ] &, Select[Range[mm], And[SquareFreeQ[#], CompositeQ[#] ] &] ]
%o A398442 (Python)
%o A398442 from math import prod
%o A398442 from sympy import factorint
%o A398442 def ok(k):
%o A398442     f = factorint(k)
%o A398442     lpf = min(f, default=0)
%o A398442     q = min(set(f)-{lpf}, default=0)
%o A398442     return q and k == q * prod(f)
%o A398442 print([k for k in range(1276) if ok(k)]) # _Michael S. Branicky_, Aug 02 2026
%Y A398442 Cf. A005117, A007947, A095990, A119288, A120944, A332785.
