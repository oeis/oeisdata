%I A398620 #13 Aug 05 2026 06:00:32
%S A398620 1,2,4,7,12,20,30,46,68,100,144,204,285,394,540,732,984,1312,1740,
%T A398620 2290,2996,3896,5040,6488,8310,10598,13456,17020,21444,26920,33678,
%U A398620 41992,52196,64680,79920,98476,121020,148342,181384,221258,269280,327000
%N A398620 Expansion of eta(q^2) * eta(q^3) * eta(q^6) / (eta(q)^2 * eta(q^9)) in powers of q.
%C A398620 Sequence is 2-convolutive; that is, the generating function A(x) satisfies A(x) + A(-x) = 2*A(x^2)^2.
%H A398620 Shane Chern, Dennis Eichhorn, Shishuo Fu, and James A. Sellers, <a href="https://arxiv.org/abs/2608.01136">Convolutive sequences, II: Parametrizations </a>, arXiv:2608.01136 [math.CO], 2026.
%F A398620 Expansion of eta(q^2) * eta(q^3) * eta(q^6) / (eta(q)^2 * eta(q^9)) in powers of q.
%F A398620 a(n) ~ 5^(1/4) * exp(2*Pi*sqrt(5*n)/3^(3/2)) / (4*3^(3/4)*n^(3/4)). - _Vaclav Kotesovec_, Aug 04 2026
%e A398620 G.f. = 1 + 2*q + 4*q^2 + 7*q^3 + 12*q^4 + 20*q^5 + 30*q^6 + 46*q^7 + 68*q^8 + ...
%p A398620 with(QDifferenceEquations); series(expand(QPochhammer(q^2, q^2, 100)*QPochhammer(q^3, q^3, 100)*QPochhammer(q^6, q^6, 100)/QPochhammer(q^1,q^1,100)^2/QPochhammer(q^9, q^9, 100)), q, 100);
%t A398620 nmax = 50; CoefficientList[Series[Product[(1 - x^(2*k)) * (1 - x^(3*k)) * (1 - x^(6*k)) / ((1 - x^k)^2 * (1 - x^(9*k))), {k, 1, nmax}], {x, 0, nmax}], x] (* _Vaclav Kotesovec_, Aug 04 2026 *)
%Y A398620 Cf. A398619.
%K A398620 nonn,new
%O A398620 0,2
%A A398620 _James Sellers_, Aug 04 2026
