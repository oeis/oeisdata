%I A398671 #15 Aug 13 2026 02:49:08
%S A398671 1,2,3,4,4,5,6,7,8,8,9,10,10,11,11,12,12,13,14,14,15,16,17,18,18,18,
%T A398671 19,20,20,20,21,22,23,23,23,24,24,25,25,25,25,26,27,28,28,29,30,31,32,
%U A398671 32,32,32,32,33,33,34,35,35,36,36,36,37,38,39,39,40,41,41,42,42,43,44
%N A398671 a(n) is the number of positive integers <= n with no prime factors of form 4*k+1.
%C A398671 A102548(n) - a(floor(sqrt(n))) is the number of positive integers <= n that are the sum of 2 nonzero squares (A397450).
%H A398671 Daniel Suteu, <a href="/A398671/b398671.txt">Table of n, a(n) for n = 1..10000</a>
%H A398671 Daniel Shanks, <a href="https://www.fq.math.ca/Scanned/13-4/shanks.pdf">Non-hypotenuse numbers</a>, Fib. Quart., Vol. 13, No. 4 (1975), pp. 319-321.
%H A398671 Daniel Suteu, <a href="/A398671/a398671.cpp.txt">C++ program (sublinear-time algorithm)</a>.
%F A398671 a(A004144(n)) = n.
%F A398671 a(n) ~ (A * n / sqrt(log(n))) * (1 + C/log(n) + O(1/log(n)^2)), where A = A244659 and C = A244662 (Shanks, 1975).
%t A398671 Accumulate[Table[If[n == 1 || AllTrue[FactorInteger[n][[;; , 1]], Mod[#, 4] != 1 &], 1, 0], {n, 1, 72}]] (* _Amiram Eldar_, Aug 06 2026 *)
%o A398671 (PARI) a(n) = sum(k=1, n, !#select(p->p%4==1, factor(k)[,1]));
%Y A398671 Cf. A005089, A004144, A102548, A398087, A397450.
%Y A398671 Cf. A244659, A244662.
%K A398671 nonn,new
%O A398671 1,2
%A A398671 _Daniel Suteu_, Aug 06 2026
