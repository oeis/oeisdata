%N A398193 Triangle read by rows: T(n, k) = n! * [x^n] (T(x) / (1 - T(x)))^(n - k + 1) if k > 0 and delta_{n, 0} if k = 0, where T(x) = -W(-x) is Euler's tree function, and W Lambert's function.
%F A398193 T(n, k) = (n-1)! * (n-k+1) * Sum_{j=0..k-1} binomial(n-j, k-1-j) * n^j / j! for k > 0. - _Peter Bala_, Jul 27 2026
%e A398193 Triangle starts:
%e A398193   [0]  1;
%e A398193   [1]  0,     1;
%e A398193   [2]  0,     2,      4;
%e A398193   [3]  0,     6,     24,      27;
%e A398193   [4]  0,    24,    144,     312,      256;
%e A398193   [5]  0,   120,    960,    3060,     4720,     3125;
%e A398193   [6]  0,   720,   7200,   30240,    67680,    82800,    46656;
%e A398193   [7]  0,  5040,  60480,  315000,   920640,  1617210,  1662024,   823543;
%e A398193   [8]  0, 40320, 564480, 3507840, 12633600, 28775040, 42110208, 37665152, 16777216;
%t A398193 A398193[n_Integer, k_Integer] := If[k == 0, Boole[n==k],
%t A398193 n! * SeriesCoefficient[ (-ProductLog[-x] / (1 + ProductLog[-x]))^(n-k+1), {x, 0, n} ]];
%t A398193 Table[A398193[n, k], {n, 0, 9}, {k, 0, n}]
%o A398193 (Python)
%o A398193 from math import comb, factorial
%o A398193 from fractions import Fraction
%o A398193 def T(n: int, k: int) -> int:
%o A398193     if k == 0: return 1 if n == 0 else 0
%o A398193     term = Fraction(comb(n, k - 1))
%o A398193     total = term
%o A398193     for j in range(1, k):
%o A398193         term *= n * (k - j)
%o A398193         term /= j * (n - j + 1)
%o A398193         total += term
%o A398193     result = factorial(n - 1) * (n - k + 1) * total
%o A398193     return result.numerator
%o A398193 for n in range(10):
%o A398193     print([n], [T(n, k) for k in range(n + 1)])  # _Peter Luschny_, Jul 27 2026
%Y A398193 Cf. A000142 (column 1), A052609 (column 2), A000312 (main diagonal), A001864 (subdiagonal), A308863 (row sums).
