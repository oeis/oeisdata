%U A398968 26732169,26807769,26840169,49766350,70501975,73093225,73955725,74063225,74256025,74466025,74556025,97542046,99090243,109706427,121927435,138183871
%N A398968 Numbers k such that sigma(k) = psi(k) + tau(k)^6.
%C A398968 Includes p * q * r^2 for distinct primes p,q,r such that (p + 1) * (q + 1) = 2985984. For example p = 497663 and q = 5.
%e A398968 9953260 is a term since sigma(9953260) = 20901888 = 17915904 + 12^6 = psi(9953260) + tau(9953260)^6.
%o A398968 (PARI) isok(k) = {my(f = factor(k)); sigma(f) - prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) == numdiv(f)^6; } \\ _Amiram Eldar_, Aug 15 2026
%o A398968 (Python)
%o A398968 from math import prod
%o A398968 from sympy import factorint
%o A398968 def ok(n):
%o A398968     f = factorint(n)
%o A398968     sigma = prod((p**(e+1)-1)//(p-1) for p, e in f.items())
%o A398968     psi = prod((p+1)*p**(e-1) for p, e in f.items())
%o A398968     tau = prod(e+1 for e in f.values())
%o A398968     return sigma == psi + tau**6
%o A398968 # _Michael S. Branicky_, Aug 15 2026
%Y A398968 Cf. A000005 (tau), A000203 (sigma), A001615 (psi), A387953, A390296, A390297, A389546, A390420.
