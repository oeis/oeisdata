%N A398627 Decimal expansion of Sum_{k>=1} 2^(2*k)/(k^5 * binomial(2*k,k)).
%H A398627 Cornel Ioan Vălean, <a href="https://doi.org/10.1007/978-3-031-21262-8">More (Almost) Impossible Integrals, Sums, and Series</a>, Springer Cham, 2023. See section 4.58, p. 455, eq. (4.191), section 5.58, p. 469, section 6.58, pp. 799-802.
%F A398627 Equals 2*log(2)^5/15 + 8*log(2)^3*zeta(2)/3 - 19*log(2)*zeta(4)/2 + 6*zeta(2)*zeta(3) + 31*zeta(5)/8 - 16*Li_5(1/2).
%F A398627 Equals 2 * hypergeom([1, 1, 1, 1, 1, 1], [3/2, 2, 2, 2, 2], 1).
%F A398627 Equals Sum_{k>=1} 4^k * H(k,4) / (k*(2*k+1)*binomial(2*k,k)), where H(k,4) = A007410(k)/A007480(k) is the k-th harmonic number of order 4.
%e A398627 2.102666835144012078235689356487622385299818263615306...
%t A398627 RealDigits[2*Log[2]^5/15 + 8*Log[2]^3*Zeta[2]/3 - 19*Log[2]*Zeta[4]/2 + 6*Zeta[2]*Zeta[3] + 31*Zeta[5]/8 - 16*PolyLog[5, 1/2], 10, 120][[1]]
%t A398627 (* Alternative: *)
%t A398627 RealDigits[2 * HypergeometricPFQ[{1, 1, 1, 1, 1, 1}, {3/2, 2, 2, 2, 2}, 1],10,120][[1]] (* _Stefano Spezia_, Aug 04 2026 *)
%o A398627 (PARI) 2*log(2)^5/15 + 8*log(2)^3*zeta(2)/3 - 19*log(2)*zeta(4)/2 + 6*zeta(2)*zeta(3) + 31*zeta(5)/8 - 16*polylog(5, 1/2)
