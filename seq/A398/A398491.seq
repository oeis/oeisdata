%S A398491 1,2,3,5,6,8,10,12,14,18,19,24,27,27,31,40,40,45,50,50,58,64,67,73,78,
%T A398491 80,87,97,100,107,116,120,123,134,134,150,155,161,164,186,187,199,205,
%U A398491 205,221,237,241,251,257,261,278,289,303,301,314,321,341,353,364,383,389,394,406,421,423
%N A398491 Number of distinct entries q of the n X n multiplication table such that floor(q/n) > floor(q/(n+1)).
%C A398491 Since 1 <= q <= n^2, floor(q/n) - floor(q/(n+1)) is either 0 or 1.
%C A398491 The sequence is not monotone; for example, a(53) = 303 > 301 = a(54).
%H A398491 Chai Wah Wu, <a href="/A398491/b398491.txt">Table of n, a(n) for n = 1..10000</a>
%H A398491 Frédéric D. W. Heidenthal-König, <a href="https://doi.org/10.5281/zenodo.19102497">The Support of the Euclidean Decomposition of the Multiplication Table</a>, Zenodo, 2026.
%H A398491 Frédéric D. W. Heidenthal-König, <a href="https://doi.org/10.5281/zenodo.19273836">Euclidean Transport of Multiplication</a>, Zenodo, 2026.
%F A398491 a(n) = #{q in {i*j: 1 <= i, j <= n}: floor(q/n) > floor(q/(n+1))}.
%F A398491 Equivalently, a(n) = #{q in {i*j: 1 <= i, j <= n}: q mod n < floor(q/n)}.
%F A398491 a(n) = Sum_{q = 1..n^2} A394016(n,q) * (floor(q/n) - floor(q/(n+1))).
%F A398491 a(n) = |{i*j: 1<=i<=j<=n, i*j<(n+1)*floor(i*j/n)}| = |{i*j: 1<=i<=j<=n, i*j>(n+1)*((i*j) % n)}|. Furthermore, q in the set must satisfy k*n <= q < k*(n+1) for some integer k > 0. - _Chai Wah Wu_, Aug 06 2026
%e A398491 The distinct entries of the 4 X 4 multiplication table are 1, 2, 3, 4, 6, 8, 9, 12, 16. The values satisfying floor(q/4) > floor(q/5) are 4, 8, 9, 12, 16, so a(4) = 5.
%t A398491 a[n_]:=Module[{m={}},Do[AppendTo[m,i*Range[i,n]],{i,n}];m=Union[m//Flatten];Total[Floor[m/n]-Floor[m/(n+1)]]];Array[a,65] (* _James C. McMahon_, Aug 06 2026 *)
%o A398491 (Python)
%o A398491 def a(n):
%o A398491     products = set()
%o A398491     for i in range(1, n + 1):
%o A398491         for j in range(1, n + 1):
%o A398491             products.add(i * j)
%o A398491     count = 0
%o A398491     for q in products:
%o A398491         if q // n > q // (n + 1):
%o A398491             count += 1
%o A398491     return count
%o A398491 n = 65
%o A398491 print([a(k) for k in range(1, n + 1)])
%o A398491 (Python)
%o A398491 def A398491(n): return len({q for i in range(1,n+1) for j in range(n//i,i+1) if (q:=i*j)>(n+1)*(q%n)}) # _Chai Wah Wu_, Aug 06 2026
%o A398491 (PARI) a(n) = #select(x->(x\n > x\(n+1)), setbinop((x, y)->x*y, [1..n])); \\ _Michel Marcus_, Jul 31 2026
