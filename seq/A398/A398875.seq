%T A398875 5461275096977233198227,124204463048197079642654515,
%U A398875 4356168698884180533973317793385,225833796949551715673504161110721545,16713499282255360859497457779056871413401,1715119542930589456896641811481470717504628201
%N A398875 a(0) = 1; a(n) = Sum_{k=0..n-1} (-1)^(n-k-1) * binomial(2*n,2*k)^2 * a(k).
%H A398875 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/KelvinFunctions.html">Kelvin Functions</a>.
%F A398875 Sum_{n>=0} a(n) * x^(2*n) / (2*n)!^2 = 1 / ber_0(2*sqrt(x)), where ber_() is the Kelvin ber function.
%F A398875 a(n) ~ Pi * 2^(4*n + 7/2) * n^(4*n+1) / ((-KelvinBei(1, 2*r^(1/4)) - KelvinBer(1, 2*r^(1/4))) * exp(4*n) * r^(n + 1/4)), where r = 4.117178581434113811235424110343458982239155569434462913449... is the root of the equation KelvinBer(0, 2*r^(1/4)) = 0. - _Vaclav Kotesovec_, Sep 11 2026
%t A398875 a[0] = 1; a[n_] := a[n] = Sum[(-1)^(n - k - 1) Binomial[2 n, 2 k]^2 a[k], {k, 0, n - 1}]; Table[a[n], {n, 0, 13}]
%t A398875 (* Alternative: *)
%t A398875 nmax = 13; CoefficientList[Series[1/KelvinBer[0, 2*x^(1/4)], {x, 0, nmax}], x]*(2*Range[0, nmax])!^2 (* _Vaclav Kotesovec_, Sep 11 2026 *)
