%I A398840 #4 Sep 14 2026 16:02:11
%S A398840 0,2,10,24,43,67,97,133,174,220,272,330,393,461,535,615,700,790,886,
%T A398840 988,1095,1207,1325,1449,1578,1712,1852,1998,2149,2305,2467,2635,2808,
%U A398840 2986,3170,3360,3555,3755,3961,4173,4390,4612,4840,5074,5313,5557,5807,6063
%N A398840 Lower (1, 3/2)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398840 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398840 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (3,-4,4,-3,1).
%F A398840 a(n) = 3*a(n-1) - 4*a(n-2) + 4*a(n-3) - 3*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 2, 10, 24, 43).
%F A398840 G.f.: -(x*(2 + 4*x + 2*x^2 + 3*x^3)/((-1 + x)^3 *(1 + x^2))).
%t A398840 z = 60;
%t A398840 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398840 r =1; s = 3/2;
%t A398840 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398840 Table[u[n], {n, 0, z}]
%Y A398840 Cf. A000217, A000326, A398841.
%K A398840 nonn,easy,new
%O A398840 0,2
%A A398840 _Clark Kimberling_, Sep 10 2026
