%I A398704 #7 Aug 10 2026 05:06:06
%S A398704 1,3,8,13,43,9,253,51,277,118,1547,37,555,941,263,3127,29137,169,
%T A398704 10699,311,7229,83641,2083343,449,12109,32333,156721,14389,220723,
%U A398704 1969,327343,12161,71177,618877,307543,12071,78037,367351,5044993,49891,2139911,9231,417293,326537,42451
%N A398704 a(n) = numerator(Sum_{k=1..n} beta(floor(n/k))/floor(n/k)), where beta(n) = A206369(n) is the alternating sum of divisors of n.
%H A398704 Amiram Eldar, <a href="/A398704/b398704.txt">Table of n, a(n) for n = 1..10000</a>
%H A398704 Jing Ma and Huayan Sun, <a href="https://doi.org/10.1007/s11139-022-00588-y">On a sum involving certain arithmetic functions and the integral part function</a>, The Ramanujan Journal, Vol. 60, No. 4 (2023), pp. 1025-1032; <a href="https://doi.org/10.1007/s11139-026-01336-2">Correction</a>, ibid., Vol. 69 (2026); <a href="https://arxiv.org/abs/2109.02924">arXiv preprint</a>, arXiv:2109.02924 [math.NT], 2021; <a href="https://www.researchgate.net/publication/361229857">ResearchGate link</a>. See Theorem 1, p. 1027.
%F A398704 a(n)/A398705(n) = c * n + O(n^(1/3)*log(n)), where c = 0.808426... = A398706 (Ma and Sun, 2023).
%e A398704 Fractions begin with 1, 3/2, 8/3, 13/4, 43/10, 9/2, 253/42, 51/8, 277/36, 118/15, 1547/165, 37/4, ...
%t A398704 f[p_, e_] := Sum[(-1)^(e - k)*p^k, {k, 0, e}];
%t A398704 r[n_] := r[n] = (Times @@ f @@@ FactorInteger[n])/n; r[1] = 1;
%t A398704 a[n_] := Numerator[Sum[r[Floor[n/k]], {k, 1, n}]]; Array[a, 54]
%o A398704 (PARI) beta(n) = my(f = factor(n)); prod(i = 1, #f~, sum(e = 0, f[i, 2], (-1)^(f[i, 2]-e) * f[i, 1]^e));
%o A398704 a(n) = numerator(sum(k = 1, n, beta(n\k)/(n\k)));
%Y A398704 Cf. A206369, A294649, A398698, A398705 (denominators), A398706.
%K A398704 nonn,frac,easy
%O A398704 1,2
%A A398704 _Amiram Eldar_, Aug 07 2026
