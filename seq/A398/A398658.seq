%I A398658 #4 Aug 22 2026 00:53:33
%S A398658 0,3,11,27,55,98,158,238,342,473,633,825,1053,1320,1628,1980,2380,
%T A398658 2831,3335,3895,4515,5198,5946,6762,7650,8613,9653,10773,11977,13268,
%U A398658 14648,16120,17688,19355,21123,22995,24975,27066,29270,31590,34030,36593,39281
%N A398658 Upper (1, 3/2) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398658 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398658 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398658 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6) , with (a(0), ..., a(5)) =  (0, 3, 11, 27, 55, 98).
%t A398658 z = 60;
%t A398658 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398658 r = 1; s = 3/2;
%t A398658 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398658 Table[v[n], {n, 0, z}]
%Y A398658 Cf. A000217, A000330, A398657.
%K A398658 nonn,easy,new
%O A398658 0,2
%A A398658 _Clark Kimberling_, Aug 21 2026
