%I A398557 #53 Oct 13 2026 17:27:11
%S A398557 0,0,2,2,20,2,70,12,36,8,330,10,572,18,28,56,1360,24,1938,36,62,50,
%T A398557 3542,44,700,72,378,78,7308,60,8990,240,170,128,228,102,15540,162,244,
%U A398557 152,21320,126,24682,210,276,242,32430,184,4312,240,432,300,46852,234
%N A398557 Second derivative of n-th cyclotomic polynomial Phi_n(x) evaluated at x = 1.
%C A398557 a(n) = Phi_n''(1), where Phi_n(x) is the n-th cyclotomic polynomial.
%e A398557 For n = 1, Phi_1(x) = x - 1, Phi_1''(x) = 0 => a(1) = 0.
%e A398557 For n = 2, Phi_2(x) = x + 1, Phi_2''(x) = 0 => a(2) = 0.
%e A398557 For n = 3, Phi_3(x) = x^2 + x + 1, Phi_3''(x) = 2 => a(3) = 2.
%e A398557 For n = 5, Phi_5(x) = x^4 + x^3 + x^2 + x + 1, Phi_5''(1) = 12 + 6 + 2 = 20 => a(5) = 20.
%o A398557 (Python)
%o A398557 from sympy import cyclotomic_poly, Symbol
%o A398557 x = Symbol('x')
%o A398557 def a(n):
%o A398557     poly = cyclotomic_poly(n, x)
%o A398557     return int(poly.diff(x, 2).subs(x, 1))
%o A398557 (PARI) a(n) = subst(polcyclo(n,x)'', x, 1); \\ _Michel Marcus_, Oct 08 2026
%Y A398557 Cf. A092502, A020500.
%K A398557 nonn
%O A398557 1,3
%A A398557 _Iurii Kirpichev_, Oct 08 2026
