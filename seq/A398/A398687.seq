%U A398687 12,11,10,9,8,6,5,4,3,2,1,7,13,12,11,10,9,6,5,4,3,2,1,8,7
%N A398687 Triangle T(n,k) read by rows that has the A001710(n)-th permutation in reverse colex order of [1,...,n] as row n.
%C A398687 Put simply, the rows represent the states when the task of generating all permutations of [1,...,n] is halfway complete.
%D A398687 Donald E. Knuth, The Art of Computer Programming, Volume 4A, Combinatorial Algorithms, Part 1,  Pearson Education, 2011. Chapter 7.2.1.2 Generating all permutations, Exercise 2, page 344 with answer on page 703.
%H A398687 Wikiversity, <a href="https://en.wikiversity.org/wiki/Lexicographic_and_colexicographic_order">Lexicographic and colexicographic order</a>
%e A398687 The triangle begins
%e A398687   1,
%e A398687   1, 2,
%e A398687   1, 3, 2,
%e A398687   4, 2, 1, 3,
%e A398687   5, 2, 1, 4, 3,
%e A398687   6, 5, 3, 2, 1, 4,
%e A398687   7, 6, 3, 2, 1, 5, 4,
%e A398687   8, 7, 6, 4, 3, 2, 1, 5,
%e A398687   9, 8, 7, 4, 3, 2, 1, 6, 5,
%e A398687   ...
%Y A398687 Cf. A001710, A375300 (similar, but for permutations in lexicographic order).
%K A398687 nonn,tabl,new
%O A398687 1,3
