%I A398837 #6 Sep 18 2026 06:09:39
%S A398837 0,2,7,14,25,39,55,75,98,123,152,184,218,256,297,340,387,437,489,545,
%T A398837 604,665,730,798,868,942,1019,1098,1181,1267,1355,1447,1542,1639,1740,
%U A398837 1844,1950,2060,2173,2288,2407,2529,2653,2781,2912,3045,3182,3322,3464
%N A398837 Upper (1, 2/3)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398837 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398837 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398837 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 2, 7, 14, 25).
%F A398837 G.f.: x*(-2 - 3*x - 2*x^2 - 2*x^3)/((-1 + x)^3 *(1 + x + x^2)).
%F A398837 a(n) = ceiling(n*(9*n+1)/6). 2*a(n) +2*a(n-1) +2*a(n-2) +(-9*n^2+17*n-16)=0. - _R. J. Mathar_, Sep 18 2026
%t A398837 z = 60;
%t A398837 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398837 r =1; s = 2/3;
%t A398837 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398837 Table[v[n], {n, 0, z}]
%Y A398837 Cf. A000217, A000326, A398836.
%K A398837 nonn,easy,new
%O A398837 0,2
%A A398837 _Clark Kimberling_, Sep 10 2026
