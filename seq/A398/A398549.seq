%I A398549 #7 Aug 06 2026 23:12:14
%S A398549 1,1,3,44,3869,1439876,6106676016
%N A398549 Number of n-tuples (x_1, ..., x_n) of distinct positive integers such that 1/x_1 + 2/x_2 + ... + n/x_n = n.
%C A398549 a(n) is the limit of column n of the triangle A378322: A378322(m,n) = a(n) for all m >= A398550(n).
%C A398549 The number of solutions is finite for every n: if the values x_i are assigned in increasing order, the least value v still to be assigned satisfies v <= S/r, where S is the sum of the remaining numerators and r is the remaining target, so the search tree is finite.
%C A398549 a(8) is approximately 8.4*10^12 (Monte Carlo estimate by Knuth's backtrack-tree method; not exact).
%e A398549 For n = 3 the a(3) = 3 solutions are (1,2,3), (1,4,2) and (2,1,6): 1/1 + 2/2 + 3/3 = 1/1 + 2/4 + 3/2 = 1/2 + 2/1 + 3/6 = 3.
%o A398549 (Python)
%o A398549 from fractions import Fraction
%o A398549 def a(n):
%o A398549     def rec(rem, lo, r):
%o A398549         if len(rem) == 1:
%o A398549             q = Fraction(rem[0]) / r
%o A398549             return int(q.denominator == 1 and q >= lo)
%o A398549         S = sum(rem)
%o A398549         hi = S * r.denominator // r.numerator
%o A398549         c = 0
%o A398549         for m in range(lo, hi + 1):
%o A398549             for i, w in enumerate(rem):
%o A398549                 r2 = r - Fraction(w, m)
%o A398549                 if r2 > 0:
%o A398549                     c += rec(rem[:i] + rem[i+1:], m + 1, r2)
%o A398549         return c
%o A398549     return rec(tuple(range(1, n + 1)), 1, Fraction(n))
%Y A398549 Cf. A378322, A398550.
%K A398549 nonn,hard,more
%O A398549 1,3
%A A398549 _Keisuke Hidaka_, Aug 02 2026
