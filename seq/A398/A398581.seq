%I A398581 #31 Aug 24 2026 23:25:15
%S A398581 11,16,31,56,81,101,106,121,146,151,181,191,196,211,236,241,281,286,
%T A398581 326,331,361,371,376,391,416,451,461,466,506,511,541,551,556,571,596,
%U A398581 601,631,641,646,661,686,691,731,736,751,776,781,811,821,826,866,871,911,916,956,961,991
%N A398581 Numbers k for which the lexicographically first integer solution (x,y,z) of 5/k = 1/x + 1/y + 1/z with 0 < x < y < z differs from a solution having maximal z.
%C A398581 Analog of A257843 for the equation 5/k = 1/x + 1/y + 1/z (strict order 0 < x < y < z).
%C A398581 Example: k = 11 has lexicographically first solution (3, 9, 99) and a maximum-z solution (4, 5, 220).
%C A398581 Conjecture: every term is congruent to 1 modulo 5. Verified for all 86 terms with k <= 1500. The converse is false: many k == 1 (mod 5) are not terms.
%C A398581 If k = 5*q+4 with q >= 1, the lexicographically first solution has maximal z: after x = q+1 the remainder is 1/M with M = k*(q+1), so the largest z is M*(M+1), which exceeds the z of every solution with x >= q+2.
%C A398581 Every k == 11 (mod 45) and every k == 16 (mod 90) is a term, so the sequence is infinite.
%H A398581 David Batista, <a href="/A398581/b398581.txt">Table of n, a(n) for n = 1..86</a> (all terms with k at most 1500)
%e A398581 For k = 11, 5/11 = 1/3 + 1/9 + 1/99 = 1/4 + 1/5 + 1/220. The first triple is lexicographically smaller but has smaller z, so 11 is a term.
%o A398581 (Python)
%o A398581 from math import ceil
%o A398581 def auptok(N=1000):
%o A398581     out = []
%o A398581     for k in range(2, N+1):
%o A398581         lex = mz = None
%o A398581         for x in range(k//5+1, 3*k//5+1):
%o A398581             rn, rd = 5*x-k, k*x
%o A398581             if rn <= 0: continue
%o A398581             y0 = max(x+1, ceil(rd/rn))
%o A398581             for y in range(y0, 2*rd//rn+1):
%o A398581                 sn, sd = rn*y-rd, rd*y
%o A398581                 if sn <= 0 or sd % sn: continue
%o A398581                 z = sd//sn
%o A398581                 if z <= y: continue
%o A398581                 if 5*x*y*z != k*(y*z + x*z + x*y): continue
%o A398581                 sol = (x, y, z)
%o A398581                 if lex is None: lex = sol
%o A398581                 if mz is None or z > mz[2]: mz = sol
%o A398581         if lex and mz and lex != mz: out.append(k)
%o A398581     return out
%Y A398581 Cf. A257843, A075248, A075249, A075250, A075251, A257839.
%K A398581 nonn,new
%O A398581 1,1
