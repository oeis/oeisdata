%I A398415 #17 Aug 18 2026 18:33:03
%S A398415 2,5,10,17,33,42,50,53,58,62,84,89,125,200,218,278,321,370,377,408,
%T A398415 509,609,752,854,992,1025,1102,1246,1248,1320,1364,1509,1624,1769,
%U A398415 1776,1917,2012,2108,2126,2144,2350,2582,2633,2736,2773
%N A398415 Numbers k such that A396781(k) = A397879(k).
%C A398415 A396781(n) is the largest integer of the form r^k whose base-n digital root is r and whose number of base-n digits is k. A397879(n) is the analogous largest integer using the alternating digital root instead of the digital root. This sequence lists the bases n for which these two maxima coincide.
%C A398415 The value of r attaining the maximum may differ for A396781(n) and A397879(n), even though the resulting value r^k is the same. n = 2 is the trivial case, since A396781(2) = A397879(2) = 1 with r = k = 1.
%C A398415 The coincidence at n = 10 has a simple arithmetic explanation. The digital root of every power of 9 is 9. The alternating digital root in base 10 is determined modulo 11. Since 11 is prime, Fermat's little theorem gives 9^10 == 1 (mod 11). As 21 == 1 (mod 10), we obtain 9^21 == 9 (mod 11). Thus r = 9 satisfies both defining conditions with k = 21, so 9^21 is the maximum for both A396781(10) and A397879(10).
%e A398415 For k=2 is a term, since A397879(2) = A396781(2) = 1^1 = 1.
%e A398415 For k=5 is a term, since A397879(5) = A396781(5) = 4^7 = 16384.
%e A398415 For k=10 is a term, since A397879(10) = A396781(10) = 9^21 = 109418989131512359209.
%e A398415 For k=17 is a term, since A397879(17) = A396781(17) = 16^46.
%e A398415 For k=33 is a term, since A397879(33) = A396781(33) = 32^113.
%o A398415 (Python)
%o A398415 from math import*
%o A398415 def S(N):
%o A398415  z=[]
%o A398415  for b in range(2,N+1):
%o A398415   f={};n=b+1;d=2
%o A398415   while d*d<=n:
%o A398415    while n%d<1:f[d]=f.get(d,0)+1;n//=d
%o A398415    d+=1
%o A398415   if n>1:f[n]=f.get(n,0)+1
%o A398415   m=0
%o A398415   for r in range(1,b):
%o A398415    if r<2:l=1
%o A398415    else:
%o A398415     l=max(1,int(1/(1-log(r,b))))
%o A398415     while r**l<b**(l-1):l-=1
%o A398415     while r**(l+1)>=b**l:l+=1
%o A398415    o=1
%o A398415    for p,a in f.items():
%o A398415     e=x=0;t=r
%o A398415     while t and t%p<1:t//=p;e+=1
%o A398415     if e<a:
%o A398415      if e:o=0;break
%o A398415      x=r%p**a;k=1
%o A398415      while x-1:x=x*r%(p**a);k+=1
%o A398415      o=lcm(o,k)
%o A398415    if o:
%o A398415     k=1+o*((l-1)//o)
%o A398415     m=max(m,r**k)
%o A398415   if m==(b-1)**l:z.append(b)
%o A398415  return z
%o A398415 print(S(3000))
%Y A398415 Cf. A397879, A396781.
