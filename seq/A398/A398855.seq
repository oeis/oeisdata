%I A398855 #4 Sep 23 2026 01:32:05
%S A398855 0,2,6,14,26,40,58,80,104,132,164,198,236,278,322,370,422,476,534,596,
%T A398855 660,728,800,874,952,1034,1118,1206,1298,1392,1490,1592,1696,1804,
%U A398855 1916,2030,2148,2270,2394,2522,2654,2788,2926,3068,3212,3360,3512,3666,3824
%N A398855 Upper (1/3, 1)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398855 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical. See A398836 for a guide to related sequences.
%H A398855 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398855 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 2, 6, 14, 26).
%F A398855 G.f.: -(2*x*(1 + x + 2*x^2 + x^3)/((-1 + x)^3 *(1 + x + x^2)).
%t A398855 z = 60;
%t A398855 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398855 r =1/3; s = 1;
%t A398855 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398855 Table[v[n], {n, 0, z}]
%Y A398855 Cf. A000217, A000326, A398854.
%K A398855 nonn,easy,new
%O A398855 0,2
%A A398855 _Clark Kimberling_, Sep 21 2026
