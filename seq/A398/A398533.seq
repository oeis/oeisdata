%S A398533 1,2,3,1,10,2,42,1,3,15,165,6,26,21,21,15,510,3,57,10,105,2310,53130,
%T A398533 6,5,390,390,70,2030,21,3255,30,330,5610,1309,35,3885,3990,25935,195,
%U A398533 7995,35,1505,1155,462,8855,416185,10,210,210,3570,3094,163982,455,30030,385,43890,636405
%N A398533 a(n) = denominator(Sum_{k=1..n} phi(floor(n/k))/floor(n/k)), where phi is the Euler totient function.
%H A398533 Amiram Eldar, <a href="/A398533/b398533.txt">Table of n, a(n) for n = 1..10000</a>
%H A398533 Olivier Bordellès, Lixia Dai, Randell Heyman, Hao Pan, and Igor E. Shparlinski, <a href="https://doi.org/10.1016/j.jnt.2019.01.006">On a sum involving the Euler function</a>, Journal of Number Theory, Vol. 202 (2019), pp. 278-297.
%H A398533 Shane Chern, <a href="https://doi.org/10.1017/S0004972719000066">Note on sums involving the Euler function</a>, Bulletin of the Australian Mathematical Society, Vol. 100, No. 2 (2019), pp. 194-200.
%H A398533 Jing Ma and Huayan Sun, <a href="https://arxiv.org/abs/2109.02924">On a sum involving certain arithmetic functions and the integral part function</a>, arXiv:2109.02924 [math.NT], 2021.
%H A398533 Jie Wu, <a href="https://doi.org/10.1007/s10998-019-00300-6">Note on a paper by Bordellès, Dai, Heyman, Pan and Shparlinski</a>, Periodica Mathematica Hungarica, Vol. 80, (2020), pp. 95-102.
%H A398533 Guang-Liang Zhou and Ya-Fang Feng, <a href="https://doi.org/10.1216/rmj.2024.54.623">Distribution of the Primes Represented by floor(x/n) in Short Intervals</a>, Rocky Mountain Journal of Mathematics, Vol. 54, No. 2 (2024), pp. 623-629.
%e A398533 Fractions begin with 1, 3/2, 8/3, 3, 43/10, 9/2, 253/42, 6, 22/3, 118/15, 1547/165, 53/6, ...
%t A398533 a[n_] := Denominator[Sum[(EulerPhi[#]/# &)@ Floor[n/k], {k, 1, n}]]; Array[a, 58]
%o A398533 (PARI) a(n) = denominator(sum(k = 1, n, eulerphi(n\k)/(n\k)));
%Y A398533 Cf. A000010, A398532 (numerators), A398534.
%K A398533 nonn,frac,easy,new
