%I A398637 #19 Aug 12 2026 22:03:19
%S A398637 1,4,6,16,22,24,46,64,54,88,118,96,166,184,132,256,286,216,358,352,
%T A398637 276,472,526,384,550,664,486,736,838,528,958,1024,708,1144,1012,864,
%U A398637 1366,1432,996,1408,1678,1104,1846,1888,1188,2104,2206,1536,2254,2200,1716,2656,2806
%N A398637 Number of smooth points modulo n on the affine Cayley cubic x^2+y^2+z^2-x*y*z=4.
%H A398637 Alper Ferudun, <a href="/A398637/b398637.txt">Table of n, a(n) for n = 1..10000</a>
%H A398637 S. Cantat and F. Loray, <a href="https://doi.org/10.5802/aif.2512">Dynamics on Character Varieties and Malgrange irreducibility of Painleve VI equation</a>, Ann. Inst. Fourier 59 (2009), 2927-2978.
%F A398637 a(n) = n^2*Product_{p|n, p odd prime} (1-3/p^2).
%F A398637 Multiplicative with a(2^e)=2^(2*e), a(p^e)=p^(2*e-2)*(p^2-3) for odd primes p.
%F A398637 D.g.f.: zeta(s-2)*Product_{p odd prime}(1-3/p^s).
%e A398637 Modulo 2 the four smooth solutions are (1,1,0), (1,0,1), (0,1,1), and (1,1,1), so a(2)=4.
%t A398637 a[n_] := n^2*Times@@((1-3/#^2)& /@ Select[FactorInteger[n][[All,1]], OddQ])
%Y A398637 Cf. A385118 (all points on a different Markoff surface modulo n).
%K A398637 nonn,mult,easy,new
%O A398637 1,2
%A A398637 _Alper Ferudun_, Aug 05 2026
