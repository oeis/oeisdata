%N A398481 a(n) = Sum_{k=0..n} n^n * exp(1/n) * Gamma(n - k + 1, 1/n) for n >= 1, a(0) = 1. Row sums of A398480.
%p A398481 a := n -> ifelse(n = 0, 1, add(n^n*exp(1/n)*GAMMA(n-k+1, 1/n), k = 0..n)):
%p A398481 seq(simplify(a(n)), n = 0..16);
