%S A398836 0,1,6,14,24,38,55,74,97,123,151,183,218,255,296,340,386,436,489,544,
%T A398836 603,665,729,797,868,941,1018,1098,1180,1266,1355,1446,1541,1639,1739,
%U A398836 1843,1950,2059,2172,2288,2406,2528,2653,2780,2911,3045,3181,3321,3464
%N A398836 Lower (1, 2/3)-midsequence of triangular numbers (A000217) and pentagonal numbers (A000326); see Comments.
%C A398836 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h and k are real numbers, then the lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). If s and t are linearly recurrent, and h and k are rational, then the lower and upper (h,k)-midsequences of s and t are linearly recurrent. If h and k are integers, then the lower and upper sequences are identical.
%C A398836 Guide to (h,k)-midsequences of triangular numbers and pentagonal numbers:
%C A398836 (h,k)=(1,1/2): A397978 (lower), A397979 (upper)
%C A398836 (h,k)=(1,1/3): A389316 (lower), A389317 (upper)
%C A398836 (h,k)=(1,2/3): A398836 (lower), A398837 (upper)
%C A398836 (h,k)=(1,4/3): A398838 (lower), A398839 (upper)
%C A398836 (h,k)=(1,3/2): A398840 (lower), A398841 (upper)
%C A398836 (h,k)=(-1,1/2): A391537 (lower), A011848 (upper)
%C A398836 (h,k)=(-2,3/2): A398842 (lower), A398843 (upper)
%C A398836 (h,k)=(1/2,1/3): A398844 (lower), A398845 (upper)
%C A398836 (h,k)=(1/3,1/2): A398846 (lower), A398847 (upper)
%C A398836 (h,k)=(-1/3,1/2): A398848 (lower), A398849 (upper)
%C A398836 (h,k)=(-1/2,1/3): A398850 (lower), A398851 (upper)
%C A398836 (h,k)=(1/2,1): A398852 (lower), A398853 (upper)
%C A398836 (h,k)=(1/3,1): A398854 (lower), A398855 (upper)
%C A398836 (h,k)=(2/3,1): A398856 (lower), A398857 (upper)
%C A398836 (h,k)=(4/3,1): A398858 (lower), A398859 (upper)
%C A398836 (h,k)=(3/2,1): A398860 (lower), A398861 (upper)
%C A398836 Examples in which h and k are integers:
%C A398836 (h,k)=(1,1): A001105 (lower and upper)
%C A398836 (h,k)=(1,4): A186030 (lower and upper)
%C A398836 (h,k)=(2,1): A005475 (lower and upper)
%C A398836 (h,k)=(2,3): A022268 (lower and upper)
%H A398836 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (2,-1,1,-2,1).
%F A398836 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5), (a(0), ..., a(4)) =  (0, 1, 6, 14, 24).
%F A398836 G.f.: -(x*(1 + 4*x + 3*x^2 + x^3)/((-1 + x)^3 *(1 + x + x^2))).
%F A398836 a(n) = floor( n*(9*n+1)/6). 2*a(n) +2*a(n-1) +2*a(n-2) +(-9*n^2+17*n-12)=0. - _R. J. Mathar_, Sep 18 2026
%t A398836 z = 60;
%t A398836 f[n_] := (n^2 + n)/2; g[n_] := (3 n^2 - n)/2;
%t A398836 r =1; s = 2/3;
%t A398836 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398836 Table[u[n], {n, 0, z}]
%Y A398836 Cf. A000217, A000326, A398837.
%K A398836 nonn,easy,new
%O A398836 0,3
%A A398836 _Clark Kimberling_, Sep 10 2026
