%T A398753 78,82,85,86,87,91,93,94,95,102,105,106,111,114,115,118,119,122,123,
%U A398753 129,130,133,134,138,141,142,143,145,146,154,155,158,159,161,165,166
%N A398753 Squarefree composite numbers that are not also oblong.
%C A398753 Oblong numbers k that are squarefree (in A229882) are also composite except for A229882(1) = 2.
%H A398753 Michael De Vlieger, <a href="/A398753/b398753.txt">Table of n, a(n) for n = 1..10000</a>
%F A398753 {a(n)} = A120944 \ A002378 = A120944 \ A229882 \ {2}.
%e A398753 Let s = A120944.
%e A398753 Table of n, a(n) for select n:
%e A398753       n                 a(n)
%e A398753   ----------------------------------------------------
%e A398753       1        s(2) =    10 = 2 * 5
%e A398753       2        s(3) =    14 = 2 * 7
%e A398753       3        s(4) =    15 = 3 * 5
%e A398753       4        s(5) =    21 = 3 * 7
%e A398753       5        s(6) =    22 = 2 * 11
%e A398753       6        s(7) =    26 = 2 * 13
%e A398753       7        s(9) =    33 = 3 * 11
%e A398753       8       s(10) =    34 = 2 * 17
%e A398753      19       s(22) =    66 = 2 * 3 * 11
%e A398753     130      s(136) =   330 = 2 * 3 * 5 * 11
%e A398753    1044     s(1061) =  2310 = 2 * 3 * 5 * 7 * 11
%e A398753   14958    s(15013) = 30030 = 2 * 3 * 5 * 7 * 11 * 13
%e A398753 .
%e A398753 s(1) = 6 = 2*3 is not in this sequence.
%e A398753 s(8) = 30 = 5*6 is not a term.
%e A398753 s(14) = 42 = 6*7 is not a term.
%t A398753 oblongQ[x_] := IntegerQ@ Sqrt[4*x + 1]; fQ[x_] := And[SquareFreeQ[x], CompositeQ[x] ]; Select[Range[180], And[fQ[#], ! oblongQ[#]] &]
