%T A398692 53,106,35,70,23,46,15,18,44,88,29,58,19,32,64,21,24,38,76,25,92,184,
%U A398692 61,122,244,488,976,325,650,1300,433,866,1732,577,1154,2308,4616,9232,3077,6154
%N A398692 Sequence obtained by iteratively appending the reversed Collatz trajectory (excluding terms already present) of the smallest positive integer not included in the sequence, starting from a(1)=1
%C A398692 The sequence is infinite and contains all natural numbers if and only if the Collatz conjecture is true.
%e A398692 Start with 1. The smallest number not in the sequence is 2. We have 2 -> (1), reverse and add 2.
%e A398692 Now we have 1,2. Smallest number not in the sequence is 3. We have 3 -> 10 -> 5 -> 16 -> 8 -> 4 -> (2 -> 1). Reverse the new part to get the first terms of the sequence 1, 2, 4, 8, 16, 5, 10, 3.
%o A398692 (Python)
%o A398692 seq = [1,2,4]
%o A398692 a = 3
%o A398692 def collatz_next(n):
%o A398692     if n%2==0:
%o A398692         return n//2
%o A398692     else:
%o A398692         return 3*n + 1
%o A398692 while len(seq) < 70:
%o A398692     tmp = a
%o A398692     que = []
%o A398692     while a not in seq:
%o A398692         que = [a] + que
%o A398692         a = collatz_next(a)
%o A398692     seq += que
%o A398692     a = tmp + 1
%o A398692 print(seq)
%Y A398692 Cf. A006370 (Collatz mapping), A061641 (the new terms).
%K A398692 nonn,new
%O A398692 1,2
