%U A398160 238986,241362,245565,267597,283815,476377,485250,564450,615250,622750,636650,663850,665353,670450,682125,743325,788375,951090,1106322
%N A398160 Numbers k such that sigma(k) = psi(k) + Omega(k)^6.
%C A398160 The sequence is infinite because it contains all numbers of the form 31 * 127 * p^2, where p is any prime.
%e A398160 15748 is a term since sigma(15748) = 28672 = 24576 + 4^6 = psi(15748) + Omega(15748)^6.
%o A398160 (PARI) isok(k) = {my(f = factor(k)); sigma(f) == prod(i=1, #f~, (f[i, 1]+1) * f[i, 1]^(f[i, 2]-1)) + bigomega(f)^6; } \\ _Amiram Eldar_, Jul 22 2026
%Y A398160 Cf. A244963 (sigma minus psi), A001222 (Omega), A397843, A398159.
%K A398160 nonn,new
%O A398160 1,2
%A A398160 _S. I. Dimitrov_, Jul 22 2026
