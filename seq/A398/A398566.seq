%S A398566 101,110,202,211,220,303,312,321,330,404,413,422,431,440,505,514,523,
%T A398566 532,541,550,606,615,624,633,642,651,660,707,716,725,734,743,752,761,
%U A398566 770,808,817,826,835,844,853,862,871,880,909,918,927,936,945,954,963,972,981,990,1019,1028,1037
%N A398566 Numbers that can be obtained by concatenating the decimal representations of x, y, and x-y for x >= 1 and 0 <= y <= x.
%C A398566 The subtraction analog of A398649, which concatenates x, y, and x+y.
%C A398566 For single-digit x and y the leading digit equals x = y + (x - y), the sum of the other two digits, so the 54 three-digit terms are exactly the three-digit terms of A193772 (numbers whose first digit is the sum of the remaining digits); the two sequences first differ at a(55) = 1019, where x is no longer a single digit.
%C A398566 The three-digit terms also coincide with those of A290725 (3k-digit numbers whose first third minus middle third equals the last third); for longer terms the two differ, since A290725 requires equal-length blocks and permits internal leading zeros (e.g., 100010 is in A290725 but not here, while 1019 is here but not in A290725).
%C A398566 A term may arise from more than one pair (x, y); the smallest such is 11110, from x = 11, y = 1 (11 - 1 = 10) and x = 11, y = 11 (11 - 11 = 0).
%F A398566 If y has q digits and x-y has r digits, then the term formed from (x, y) is x*10^(q + r) + y*10^r + (x - y).
%e A398566 101 is a term because it is the concatenation of x = 1, y = 0 and x - y = 1.
%e A398566 110 is a term because it is the concatenation of x = 1, y = 1 and x - y = 0.
%e A398566 11110 is a term because it can be formed by x = 11, y = 1 or x = 11, y = 11.
%t A398566 f[x_, y_] := FromDigits[Join @@ IntegerDigits /@ {x, y, x - y}];
%t A398566 nn = 1100; Union@Reap[x = 1; While[FromDigits[Join @@ IntegerDigits /@ {x, 0, 0}] <= nn, Do[v = f[x, y]; If[v <= nn, Sow[v]], {y, 0, x}]; x++]][[2, 1]]
%o A398566 (Python)
%o A398566 def aupto(limit):
%o A398566     terms = set()
%o A398566     x = 1
%o A398566     while int(f"{x}00") <= limit:
%o A398566         for y in range(0, x + 1):
%o A398566             v = int(f"{x}{y}{x - y}")
%o A398566             if v <= limit:
%o A398566                 terms.add(v)
%o A398566         x += 1
%o A398566     return sorted(terms)
%o A398566 print(aupto(1100))
%Y A398566 Cf. A398649, A193772, A290725, A352438.
%K A398566 nonn,base,new
%O A398566 1,1
