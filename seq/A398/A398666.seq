%I A398666 #4 Aug 27 2026 00:55:10
%S A398666 0,3,12,31,65,118,193,294,426,593,798,1045,1339,1684,2083,2540,3060,
%T A398666 3647,4304,5035,5845,6738,7717,8786,9950,11213,12578,14049,15631,
%U A398666 17328,19143,21080,23144,25339,27668,30135,32745,35502,38409,41470,44690,48073,51622
%N A398666 Upper (1/2, 2) midsequence of triangular numbers (A000217) and tetrahedral numbers (A000330); see Comments.
%C A398666 Suppose that s = (s(n)) and t = (t(n)) are sequences of numbers and h > 0 and k > 0. The lower (h, k)-midsequence of s and t is floor(h*s + k*t); the upper (h, k)-midsequence of s and t is ceiling(h*s + k*t). See A398651 for a guide to related sequences.
%H A398666 <a href="/index/Rec#order_06">Index entries for linear recurrences with constant coefficients</a>, signature (4,-7,8,-7,4,-1).
%F A398666 a(n) = 4*a(n-1) - 7*a(n-2) + 8*a(n-3) - 7*a(n-4) + 4*a(n-5) - a(n-6), with (a(0), ..., a(4), a(5)) =  (0, 3, 12, 31, 65, 118).
%F A398666 G.f.: x*(3 + 4*x^2 + x^3)/((-1 + x)^4 *(1 + x^2))).
%t A398666 z = 60;
%t A398666 f[n_] := (n^2 + n)/2; g[n_] := n (n + 1) (2 n + 1)/6;
%t A398666 r = 1/2; s = 2;
%t A398666 u[n_] := Floor[r*f[n] + s*g[n]]; v[n_] := Ceiling[r*f[n] + s*g[n]];
%t A398666 Table[v[n], {n, 0, z}]
%Y A398666 Cf. A000217, A000330, A398665.
%K A398666 nonn,easy,new
%O A398666 0,2
%A A398666 _Clark Kimberling_, Aug 25 2026
