%S A398699 1,2,3,4,10,6,42,8,36,3,165,12,156,84,105,240,2040,36,684,60,12,4620,
%T A398699 106260,8,200,1560,7020,315,9135,28,4340,96,880,7480,52360,1260,11655,
%U A398699 5985,155610,520,21320,8,2408,3080,3465,31878,1498266,720,35280,1680,23800,185640,9838920,9828
%N A398699 a(n) = denominator(Sum_{k=1..n} sigma(floor(n/k))/floor(n/k)), where sigma(n) = A000203(n) is the sum of divisors of n.
%H A398699 Amiram Eldar, <a href="/A398699/b398699.txt">Table of n, a(n) for n = 1..10000</a>
%H A398699 Jing Ma and Huayan Sun, <a href="https://doi.org/10.1007/s11139-022-00588-y">On a sum involving certain arithmetic functions and the integral part function</a>, The Ramanujan Journal, Vol. 60, No. 4 (2023), pp. 1025-1032; <a href="https://doi.org/10.1007/s11139-026-01336-2">Correction</a>, ibid., Vol. 69 (2026); <a href="https://arxiv.org/abs/2109.02924">arXiv preprint</a>, arXiv:2109.02924 [math.NT], 2021; <a href="https://www.researchgate.net/publication/361229857">ResearchGate link</a>. See Theorem 1, p. 1027.
%e A398699 Fractions begin with 1, 5/2, 10/3, 21/4, 57/10, 47/6, 335/42, 85/8, 397/36, 37/3, 2083/165, 197/12, ...
%t A398699 a[n_] := Denominator[Sum[DivisorSigma[-1, Floor[n/k]], {k, 1, n}]]; Array[a, 54]
%o A398699 (PARI) a(n) = denominator(sum(k = 1, n, sigma(n\k, -1)));
%Y A398699 Cf. A000203, A017666, A398533, A398698 (numerators), A398700.
