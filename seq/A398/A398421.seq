%I A398421 #23 Aug 09 2026 15:51:48
%S A398421 45,63,75,99,117,147,153,171,175,207,245,261,275,279,325,333,363,369,
%T A398421 387,423,425,475,477,507,531,539,549,575,603,605,637,639,657,711,725,
%U A398421 747,775,801,833,845,847,867,873,909,925,927,931,963,981,1017,1025,1075,1083,1127,1143,1175,1179,1183
%N A398421 Odd numbers of the form p^2*q, where p and q are distinct odd primes.
%C A398421 These are the odd terms k of A072357 with A001221(k) = 2; equivalently, the odd integers k such that A001222(k) = 3 and A001221(k) = 2.
%C A398421 These are the odd terms of A054753.
%C A398421 The relative asymptotic density of this sequence within A054753 is 1 - 1/(4*P(2)) = 0.447205248893..., where P(2) = A085548. - _Amiram Eldar_, Aug 01 2026
%H A398421 Michael De Vlieger, <a href="/A398421/b398421.txt">Table of n, a(n) for n = 1..10000</a>
%F A398421 Equals A054753 \ ( 4*A065091 U 2*(A001248 \ {4}) ).
%F A398421 Equals A054753 intersection A005408.
%e A398421 a(1) = 45 because 45 = 3^2*5.
%e A398421 a(2) = 63 because 63 = 3^2*7.
%e A398421 a(3) = 75 because 75 = 5^2*3.
%p A398421 N:= 2000: # for terms <= N
%p A398421 P:= select(isprime, [seq(i,i=3..N/3,2)]):
%p A398421 R:= NULL:
%p A398421 for p in P while 3*p^2 <= N do
%p A398421   for q in P do
%p A398421     if q = p then next fi;
%p A398421     x:= p^2*q;
%p A398421     if x > N then break fi;
%p A398421     R:= R,x
%p A398421 od od:
%p A398421 sort([R]); # _Robert Israel_, Jul 29 2026
%t A398421 With[{nn = 1200}, Union@ Flatten@ Table[If[i == j, Nothing, Prime[i]^2*Prime[j]], {i, 2, PrimePi@ Sqrt[nn]}, {j, 2, PrimePi[nn/(Prime[i]^2)] } ] ] (* _Michael De Vlieger_, Jul 29 2026 *)
%t A398421 (* Alternative: *)
%t A398421 Select[Range[1, 1200, 2], Sort@ FactorInteger[#][[All, -1]] == {1, 2} &] (* _Michael De Vlieger_, Jul 29 2026 *)
%o A398421 (PARI) isok(k) = if (k%2, my(f=vecsort(factor(k)[,2]~)); f == [1,2]); \\ _Michel Marcus_, Jul 29 2026
%o A398421 (Python)
%o A398421 from math import isqrt
%o A398421 from sympy import primerange, primepi, integer_nthroot
%o A398421 from oeis_sequences.OEISsequences import bisection
%o A398421 def A398421(n):
%o A398421     def f(x): return n+x-sum(primepi(x//(m:=p*p))-(x>=m<<1) for p in primerange(3,isqrt(x)+1))+primepi(integer_nthroot(x,3)[0])-(x>=8)
%o A398421     return bisection(f,n,n) # _Chai Wah Wu_, Aug 06 2026
%Y A398421 Cf. A001248 (squares of primes), A005408 (odd numbers), subsequence of A014612 (triprimes), A054753 (numbers with prime signature [1,2]), A065091 (odd primes), A072357 (minimal mixed composites), A085548.
%K A398421 nonn,easy
%O A398421 1,1
%A A398421 _Charles Kusniec_, Jul 28 2026
