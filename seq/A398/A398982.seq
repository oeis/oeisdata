%S A398982 1,1,1,1,1,0,1,1,5,1,1,-1,1,2,3,1,1,-3,1,-1,5,4,1,-2,19,5,7,0,1,-2,1,
%T A398982 1,9,7,11,-19,1,8,11,-5,1,-2,1,1,3,10,1,-7,41,7,15,3,1,-2,19,-4,17,13,
%U A398982 1,-24,1,14,11,1,23,-2,1,5,21,-2,1,-51,1,17,13,3
%N A398982 a(n) is the number k such that 2*(u*n+k) = Sum_{d|n} (u*d+k), where u and k are coprime and not both are 0.
%C A398982 A398981 is the corresponding sequence for u, so A398981(n)*n+a(n) = Sum_{d|n} (A398981(n)*d+a(n)).
%C A398982 Note that there is exactly one solution to the equation 2*(u*n+v) = Sum_{d|n} (u*d+v) such that u and v are coprime and not both are 0.
%C A398982 a(n) is 0 if and only if n is a term of A000396.
%C A398982 a(n) is negative if and only if n is a term of A005101.
%C A398982 By definition, for f(m) = u*m+a(n), n is always f-perfect.
%F A398982 a(n) = (2*n-sigma(n))/gcd(tau(n)-2, 2*n-sigma(n)).
%e A398982 a(18) = -3, since 4*18-3 = 69, which is equal to 4*1-3 + 4*2-3 + 4*3-3 + 4*6-3 + 4*9-3 = 1 + 5 + 9 + 21 + 33.
%o A398982 (PARI) A398982(n) = (2*n-sigma(n))/gcd(numdiv(n)-2, 2*n-sigma(n))
%Y A398982 Cf. A000005 (tau), A000203 (sigma), A398981, A000396, A005101, A398713.
%K A398982 sign,easy,new
%O A398982 1,9
