%T A398973 729,247,63,11,1,8850,5561,2708,1050,322,75,12,1,26195,17984,9614,
%U A398973 4153,1459,410,88,13,1,76500,56886,32996,15607,6108,1970,512,102,14,1,221016,176784,110292,56436,24166,8690,2598,629,117,15,1
%N A398973 Riordan array (1/(1 - 3*x + x^2)^2, x*(1 - 2*x)/(1 - 3*x + x^2)).
%C A398973 T(n, k) is also the number of Dyck paths of height exactly 4, semilength n+4 (n >= 0) and k+1 peaks at level 4 (k >= 0). By a Dyck massif of altitude 4, we mean a Dyck path of height exactly 4, while its peaks at height 4 are the summits.
%H A398973 Mireille Bousquet-Mélou, <a href="https://www.mat.univie.ac.at/~slc/wpapers/s57bousquet.html">Discrete excursions</a>, Sém. Lothar. Combin., 57:B57d, 2008.
%F A398973 G.f.: G(x, y) = 1/((1 - 3*x + x^2)*(1 - 3*x + x^2 - x*y + 2*x^2*y)).
%F A398973 Sum_{k=0..n} T(n, k) = A262600(n+4).
%e A398973 Triangle T(n,k) begins:
%e A398973      1;
%e A398973      6,    1;
%e A398973     25,    7,    1;
%e A398973     90,   33,    8,   1;
%e A398973    300,  132,   42,   9,    1;
%e A398973    954,  483,  184,  52,   10,  1;
%e A398973   2939, 1671,  729,  247,  63, 11, 1;
%e A398973   8850, 5561, 2708, 1050, 322, 75, 12, 1;
%e A398973   ...
%e A398973 T(2, 1) = 7, since there are 7 Dyck massifs of altitude 4, semilength 6 and 2 summits: UUU(UD)(UD)DDDUD, UDUUU(UD)(UD)DDD, UUU(UD)(UD)DDUDD, UUDUU(UD)(UD)DDD, UUU(UD)(UD)DUDDD, UUUDU(UD)(UD)DDD and UUU(UD)DU(UD)DDD.
%o A398973 (Python)
%o A398973 import sympy as sym
%o A398973 x = sym.symbols('x')
%o A398973 def generate_matrix(k_range, n_range):
%o A398973    N = max(max(k_range), max(n_range)) + 1
%o A398973    elements = []
%o A398973    for k in k_range:
%o A398973       series = sym.series((1/(1-3*x+x**2)**2)*((x*(1-2*x))/(1-3*x+x**2))**k, x, n=N)
%o A398973       elements.append([series.coeff(x, n) for n in n_range])
%o A398973    mat = sym.ImmutableDenseMatrix(elements).T
%o A398973    return mat
%o A398973 n = 8
%o A398973 riordan = generate_matrix(range(n), range(n))
%o A398973 for i in range(riordan.rows): print(riordan.row(i)[:i+1])
%Y A398973 Column k=0 gives A001871.
%Y A398973 Cf. A000012 (diagonal), A262600.
%K A398973 nonn,tabl,new
%O A398973 0,2
