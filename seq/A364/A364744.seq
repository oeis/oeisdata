%T A364744 1165227025,7366475715,46877977451,300049605259,1930395961235,
%U A364744 12476394685445,80968876247330,527424073700966,3447190219684125,22599794010813360
%N A364744 G.f. A(x) satisfies A(x) = 1 / (1 - x*(1 + x*A(x))^5).
%H A364744 Seiichi Manyama, <a href="/A364744/b364744.txt">Table of n, a(n) for n = 0..1000</a>
%H A364744 Robert Israel, <a href="/A364744/a364744.txt">Recurrence of order 13</a>
%F A364744 a(n) = (1/(n+1)) * Sum_{k=0..n} binomial(n+1,k) * binomial(5*k,n-k).
%F A364744 G.f.: (1/x) * Series_Reversion( x / (1 + x * (1 + x)^5) ). - _Seiichi Manyama_, Oct 03 2025
%F A364744 D-finite with recurrence of order 13 (see link). - _Robert Israel_, Aug 03 2026
%p A364744 with(gfun):
%p A364744 eq:= (y*(1-x*(1+x*y)^5)-1):
%p A364744 de:= algeqtodiffeq(eq,y(x)):
%p A364744 rec:= diffeqtorec(de,y(x),a(n)):
%p A364744 f:= rectoproc(rec,a(n),remember):
%p A364744 map(f, [$0..30]); # _Robert Israel_, Aug 03 2026
%o A364744 (PARI) a(n) = sum(k=0, n, binomial(n+1, k)*binomial(5*k, n-k))/(n+1);
%Y A364744 Cf. A001006, A161634, A364742, A364743.
%K A364744 nonn,changed
%O A364744 0,3
