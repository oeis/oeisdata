%S A364742 1,1,4,13,50,201,841,3627,15993,71803,327082,1508002,7023446,32995626,
%T A364742 156173668,744029238,3565030063,17169013899,83061503584,403483653745,
%U A364742 1967217524551,9623463731721,47220968518786,232354408276613,1146254897566224,5668118931395946
%N A364742 G.f. A(x) satisfies A(x) = 1 / (1 - x*(1 + x*A(x))^3).
%H A364742 Seiichi Manyama, <a href="/A364742/b364742.txt">Table of n, a(n) for n = 0..1000</a>
%F A364742 a(n) = (1/(n+1)) * Sum_{k=0..n} binomial(n+1,k) * binomial(3*k,n-k).
%F A364742 G.f.: (1/x) * Series_Reversion( x / (1 + x * (1 + x)^3) ). - _Seiichi Manyama_, Oct 03 2025
%F A364742 D-finite with recurrence: -18091*(n + 3)*(n + 2)*(n + 1)*a(n) - 9*(5956*n + 18325)*(n + 3)*(n + 2)*a(n + 1) - 3*(n + 3)*(20013*n^2 + 150438*n + 285370)*a(n + 2) - 3*(10872*n^3 + 145611*n^2 + 648613*n + 960356)*a(n + 3) - 3*(2367*n^3 + 41364*n^2 + 236065*n + 441460)*a(n + 4) + 18*(3*n + 19)*(9*n^2 + 42*n - 56)*a(n + 5) + 54*(3*n + 22)*(n + 7)*(3*n + 17)*a(n + 6) = 0. - _Robert Israel_, Aug 03 2026
%p A364742 with(gfun):
%p A364742 eq:= y*(1-x*(1+x*y)^3)-1:
%p A364742 de:= algeqtodiffeq(eq,y(x)):
%p A364742 rec:= diffeqtorec(de,y(x),a(n)):
%p A364742 f:= rectoproc(rec,a(n),remember):
%p A364742 map(f, [$0..30]); # _Robert Israel_, Aug 03 2026
%o A364742 (PARI) a(n) = sum(k=0, n, binomial(n+1, k)*binomial(3*k, n-k))/(n+1);
%Y A364742 Cf. A001006, A161634, A364743, A364744.
%K A364742 nonn
%O A364742 0,3
%A A364742 _Seiichi Manyama_, Aug 05 2023
