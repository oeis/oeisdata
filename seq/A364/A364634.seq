%N A364634 a(n) = n * LegendreP(n, 3).
%F A364634 a(n) = A364361(2*n, n).
%F A364634 a(n) = 3*X(n-1) - X(n-2) for n >= 2, where a(0)=0, a(1)=3, and X(n) = Sum_{j=0..floor(n/2)} ((-1)^j* binomial(n-j, j) * binomial(n + 1/2 - j, 1/2) * 6^(n-2*j) ). - _Dmytro Dmytryshyn_, Oct 09 2026
%F A364634 a(n) = n*A001850(n). - _Michel Marcus_, Oct 09 2026
%p A364634 A364634 := n -> n*LegendreP(n, 3):
%p A364634 seq(A364634(n), n = 0..22);
%t A364634 Table[n LegendreP[n,3],{n,0,30}] (* _Harvey P. Dale_, May 23 2026 *)
%o A364634 (PARI) a(n) = n*pollegendre(n, 3); \\ _Michel Marcus_, Oct 09 2026
