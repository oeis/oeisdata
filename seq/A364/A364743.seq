%S A364743 1,1,5,19,85,402,1971,9976,51633,272131,1455486,7879664,43096967,
%T A364743 237777710,1321792096,7396125088,41624735353,235461758085,
%U A364743 1338049873395,7634930866465,43726638130854,251273386911443,1448362622788376,8371936106228253,48516937497849195,281833366623767131
%N A364743 G.f. A(x) satisfies A(x) = 1 / (1 - x*(1 + x*A(x))^4).
%H A364743 Seiichi Manyama, <a href="/A364743/b364743.txt">Table of n, a(n) for n = 0..1000</a>
%H A364743 Robert Israel, <a href="/A364743/a364743.txt">Recurrence of order 9</a>
%F A364743 a(n) = (1/(n+1)) * Sum_{k=0..n} binomial(n+1,k) * binomial(4*k,n-k).
%F A364743 G.f.: (1/x) * Series_Reversion( x / (1 + x * (1 + x)^4) ). - _Seiichi Manyama_, Oct 03 2025
%F A364743 D-finite with recurrence of order 9 (see link). - _Robert Israel_, Aug 03 2026
%F A364743 a(n) = hypergeom([(1-4*n)/5, (2-4*n)/5, (3-4*n)/5, 4*(1-n)/5, -4*n/5], [2, 1/4-n, 1/2-n, 3/4-n], 5^5/2^8). - _Stefano Spezia_, Nov 07 2026
%p A364743 with(gfun):
%p A364743 eq:= (y*(1-x*(1+x*y)^4)-1):
%p A364743 de:= algeqtodiffeq(eq,y(x)):
%p A364743 rec:= diffeqtorec(de,y(x),a(n)):
%p A364743 f:= rectoproc(rec,a(n),remember):
%p A364743 map(f, [$0..30]); # _Robert Israel_, Aug 03 2026
%t A364743 a[n_]:=HypergeometricPFQ[{(1-4*n)/5, (2-4*n)/5, (3-4*n)/5, 4*(1-n)/5, -4*n/5}, {2, 1/4-n, 1/2-n, 3/4-n}, 5^5/2^8]; Array[a,25,0] (* _Stefano Spezia_, Nov 07 2026 *)
%o A364743 (PARI) a(n) = sum(k=0, n, binomial(n+1, k)*binomial(4*k, n-k))/(n+1);
%Y A364743 Cf. A001006, A161634, A364742, A364744.
