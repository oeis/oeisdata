%N A364592 G.f. satisfies A(x) = 1/(1-x) + x*(1-x)*A(x)^4.
%F A364592 a(n) = Sum_{k=0..n} binomial(n+k,2*k) * binomial(4*k,k) / (3*k+1).
%F A364592 D-finite with recurrence 3*n*(3*n-1)*(3*n+1)*a(n) +(-310*n^3+303*n^2+7*n-48)*a(n-1) +3*(-9*n^3+701*n^2-1748*n+1072)*a(n-2) +2*(2*n-5)*(155*n^2-775*n+288)*a(n-3) +3*(-9*n^3-566*n^2+4587*n-8732)*a(n-4) +(-310*n^3+4347*n^2-20213*n+31188)*a(n-5) +3*(n-5)*(3*n-16)*(3*n-14)*a(n-6)=0. - _R. J. Mathar_, Nov 04 2026
%p A364592 a:= n-> coeff(series(RootOf(1/(1-x)+x*(1-x)*A^4-A, A), x, n+1), x, n):
%p A364592 seq(a(n), n=0..22);  # _Alois P. Heinz_, Sep 24 2026
%o A364592 (PARI) a(n) = sum(k=0, n, binomial(n+k, 2*k)*binomial(4*k, k)/(3*k+1));
