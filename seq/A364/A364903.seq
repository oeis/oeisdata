%H A364903 Robert Israel, <a href="/A364903/b364903.txt">Table of n, a(n) for n = 1..10399</a> (all terms <= 10^14)
%p A364903 N:= 10^9: # for terms <= N
%p A364903 filter:= k -> igcd(NumberTheory:-tau(k),NumberTheory:-tau(k+1))=7:
%p A364903 Cands:= {seq(i^2, i = 1 .. floor(N^(1/2))),
%p A364903          seq(i^2-1,i = 2 .. floor((N+1)^(1/2)))}:
