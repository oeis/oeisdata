%S A364740 1,1,3,15,91,607,4298,31720,241321,1879097,14903013,119965086,
%T A364740 977623639,8049579047,66864689674,559650696185,4715304229460,
%U A364740 39960204165865,340395043021399,2912963919210012,25031055321749916,215894227588453950,1868403327770467149,16219514364573237222
%N A364740 G.f. A(x) satisfies A(x) = 1 + x*A(x)^2 / (1 - x*A(x)^5).
%H A364740 Vincenzo Librandi, <a href="/A364740/b364740.txt">Table of n, a(n) for n = 0..600</a>
%F A364740 a(n) = (1/n) * Sum_{k=0..n-1} binomial(n,k) * binomial(2*n+3*k,n-1-k) for n > 0.
%F A364740 G.f.: 1 + Series_Reversion( x / ((1+x)^2 * (1+x*(1+x)^3)) ). - _Seiichi Manyama_, Oct 07 2025
%F A364740 a(n) = (1/n)*binomial(2*n, n-1)*hypergeom([1-n, (1+2*n)/3, 2*(1+n)/3, (3+2*n)/3, -n], [(2+n)/4, (3+n)/4, (4+n)/4, (5+n)/4], 3^3/2^8) for n > 0. - _Stefano Spezia_, Nov 08 2026
%t A364740 a[n_]:=Sum[(1/n)*Binomial[n,k]*Binomial[2*n+3*k,n-1-k],{k,0,n-1}];Table[a[n],{n,0,30}] (* _Vincenzo Librandi_, Oct 23 2025 *)
%t A364740 (* Alternative: *)
%t A364740 a[0]=1; a[n_]:=(1/n)*Binomial[2*n, n-1]*HypergeometricPFQ[{1-n, (1+2*n)/3, 2*(1+n)/3, (3+2*n)/3, -n}, {(2+n)/4, (3+n)/4, (4+n)/4, (5+n)/4}, 3^3/2^8]; Array[a,25,0] (* _Stefano Spezia_, Nov 08 2026 *)
%o A364740 (PARI) a(n) = if(n==0, 1, sum(k=0, n-1, binomial(n, k)*binomial(2*n+3*k, n-1-k))/n);
%o A364740 (Magma) [1] cat [&+[Binomial(n,k) * Binomial(2*n+3*k, n-1-k) *(1/n): k in [0..n-1]] : n in [1..30]]; // _Vincenzo Librandi_, Oct 23 2025
