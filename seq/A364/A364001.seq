%I A364001 #15 Nov 15 2026 21:13:05
%S A364001 5,7,11,13,17,19,23,29,37,47,61,73,79,101,139,179,211,227,229,239,241,
%T A364001 269,431,503,509,601,727,997,1021,1163,1319,1931,2039,2179,3299,3853,
%U A364001 4093,4513,6529,6553,7949,8111,11491,14197,16141,16381,19427,19681,32687
%N A364001 Primes of the form |2^i - 3^j|, i >= 1, j >= 1.
%C A364001 The terms below A014121(3000) = 328256967394000206715, a(1)..a(271), are proved: all numbers |2^i - 3^j| with i, j >= 1 up to that bound are known (see A363999), and their primality is proved by PARI/GP isprime. - _Ruud H.G. van Tol_, Oct 27 2026
%H A364001 Ruud H.G. van Tol, <a href="/A364001/b364001.txt">Table of n, a(n) for n = 1..271</a>
%t A364001 z = 500;
%t A364001 t = Table[Abs[2^i - 3^j], {i, 1, z}, {j, 1, z}];
%t A364001 u = Sort[Flatten[t]];
%t A364001 v = Union[u] ; (* A363999 *)
%t A364001 w = (v - 1)/2 ;  (* A364000 *)
%t A364001 Intersection[v, Prime[Range[200000]]]  (* this sequence *)
%o A364001 (PARI) upto(N) = if(N > 328256967394000206715, error("upto: N beyond the proved range")); my(S=List()); for(i=1, 70, for(j=1, 45, my(v=abs(2^i-3^j)); if(v <= N && isprime(v), listput(~S, v)))); Set(S); \\ _Ruud H.G. van Tol_, Nov 10 2026
%Y A364001 Cf. A014121, A192110, A192111, A363998.
%K A364001 nonn,changed
%O A364001 1,1
%A A364001 _Clark Kimberling_, Aug 09 2023
