%U A076143 67728389790362,601154018261938,14857180576044182,332512692267737018,2442367184129284074,33812110288830577684,1379375022197650336954,18870343642033047851422
%N A076143 Number of permutations p(1),...,p(n) of 1,...,n such that gcd(Sum_{k=1..m} p(k), p(m+1)) = 1 for all positive integers m <= n-1.
%p A076143 b:= proc(s,l) option remember; `if`(s={}, 1, add(
%p A076143      `if`(l>0 and igcd(l, j)<>1, 0, b(s minus {j}, l+j)), j=s))
%p A076143     end:
%p A076143 a:= n-> b({$1..n}, 0):
%p A076143 seq(a(n), n=0..17);  # _Alois P. Heinz_, Nov 04 2026
%K A076143 nonn,changed
%O A076143 0,3
