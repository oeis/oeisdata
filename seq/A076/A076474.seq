%I A076474 #12 Aug 29 2026 09:27:26
%S A076474 1,2,3,5,6,10,11,13,21,23,24,29,45,48,50,51,53,54,57,58,60,68,70,81,
%T A076474 82,98,103,104,106,120,125,128,132,139,149,164,170,192,206,214,226,
%U A076474 228,232,235,241,257,270,275,283,305,307,314,326,351,399,412,423,436,520
%N A076474 Denominators of the slowest decreasing sequence of unit fractions whose partial sums have a prime numerator (or 1 in the first sum).
%C A076474 By Dirichlet's Theorem, it is always possible to find the next term. See A076475 for the list of primes appearing in the numerator. Does this sum of unit fractions converge?
%H A076474 Amiram Eldar, <a href="/A076474/b076474.txt">Table of n, a(n) for n = 1..1000</a>
%H A076474 Amiram Eldar, <a href="/A076474/a076474.png">Plot of Sum_{k=1..n} 1/a(k) for n up to 1000</a>.
%e A076474 2 is a term because 1/1 + 1/2 = 3/2 and 3 is prime.
%e A076474 3 is a term because 1/1 + 1/2 + 1/3 = 11/6 and 11 is prime.
%e A076474 4 is not in a term because 1/1 + 1/2 + 1/3 + 1/4 = 25/12 and 25 is not prime.
%t A076474 nMax = 100; lst = {1}; numer = {1}; s = 1; i = 2; Do[While[ ! PrimeQ[Numerator[s + 1/i]], i++ ]; s = s + 1/i; AppendTo[lst, i]; AppendTo[numer, Numerator[s]]; i++, {n, 2, nMax}]; lst
%Y A076474 Cf. A076475, A127515, A134411.
%K A076474 nonn,frac,changed
%O A076474 1,2
%A A076474 _T. D. Noe_, Oct 14 2002
