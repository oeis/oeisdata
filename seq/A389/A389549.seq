%S A389549 1,2,7,31,155,833,4695,27373,163691,998412,6186990,38841729,246512635,
%T A389549 1579012724,10194690122,66275355102,433462233643,2850148253118,
%U A389549 18829837140303,124932149665461,832085232030114,5561226566642799,37286095996876324,250714051255586025
%N A389549 Expansion of (1/x) * Series_Reversion( x * (1 - x)^2 / (1 + x^3 / (1 - x)^2) ).
%H A389549 Robert Israel, <a href="/A389549/b389549.txt">Table of n, a(n) for n = 0..1168</a>
%H A389549 Robert Israel, <a href="/A389549/a389549.txt">Recurrence of order 10</a>
%F A389549 a(n) = (1/(n+1)) * Sum_{k=0..floor(n/3)} binomial(n+1,k) * binomial(3*n-k+1,n-3*k).
%F A389549 a(n) = (1/(n+1)) * [x^n] ((1 + x^3 / (1 - x)^2) / (1 - x)^2)^(n+1).
%F A389549 D-finite with recurrence of order 10 (see link). - _Robert Israel_, Oct 08 2026
%p A389549 with(gfun):
%p A389549 eq1:= numer(z*(1-z)^2/(1+z^3/(1-z)^2)-x):
%p A389549 eq2:= resultant(eq1, y*x-z, z):
%p A389549 de:= algeqtodiffeq(eq2, y(x)):
%p A389549 rec:= diffeqtorec(de, y(x), a(n)):
%p A389549 f:= rectoproc(rec, a(n), remember):
%p A389549 map(f, [$0..30]); # _Robert Israel_, Oct 08 2026
%o A389549 (PARI) my(N=30, x='x+O('x^N)); Vec(serreverse(x*(1-x)^2/(1+x^3/(1-x)^2))/x)
%Y A389549 Cf. A366052, A369265, A389550.
%K A389549 nonn,changed
%O A389549 0,2
