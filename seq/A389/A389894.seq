%S A389894 1,1,2,5,12,34,102,318,1022,3353,11182,37788,129108,445235,1547710,
%T A389894 5417478,19078334,67548056,240302580,858541455,3079197456,11082288288,
%U A389894 40012944894,144887840770,526041042648,1914572818653,6984052883368,25530203469473,93507748002206
%N A389894 G.f. A(x) satisfies A(x) = 1 + x*(1-x^3)^2*A(x)^2.
%H A389894 Vincenzo Librandi, <a href="/A389894/b389894.txt">Table of n, a(n) for n = 0..1000</a>
%F A389894 G.f.: 2/(1 + sqrt(1 - 4*x*(1-x^3)^2)).
%F A389894 a(n) = Sum_{k=0..floor(n/3)} (-1)^k * binomial(2*(n-3*k),k) * Catalan(n-3*k).
%F A389894 D-finite with recurrence: (14 + 4*n)*a(n) + (-66 - 12*n)*a(n + 3) + (90 + 12*n)*a(n + 6) + (-14 - n)*a(n + 7) + (-38 - 4*n)*a(n + 9) + (11 + n)*a(10 + n) = 0. - _Robert Israel_, Sep 08 2026
%p A389894 with(gfun):
%p A389894 de:= holexprtodiffeq( 2/(1 + sqrt(1 - 4*x*(1-x^3)^2)), y(x)):
%p A389894 rec:= diffeqtorec(de,y(x),a(n)):f:= rectoproc(rec,a(n),remember):map(f, [$0..40]); # _Robert Israel_, Sep 08 2026
%t A389894 Table[Sum[(-1)^k* Binomial[2*(n-3*k),k]*CatalanNumber[n-3*k],{k,0,Floor[n/3]}],{n,0,30}] (* _Vincenzo Librandi_, Oct 29 2025 *)
%o A389894 (PARI) a(n) = sum(k=0, n\3, (-1)^k*binomial(2*(n-3*k), k)*binomial(2*(n-3*k), n-3*k)/(n-3*k+1));
%o A389894 (Magma) [&+[Catalan(n-3*k) * (-1)^k* Binomial(2*(n-3*k),k): k in [0..Floor(n/3)]] : n in [0..30] ]; // _Vincenzo Librandi_, Oct 29 2025
