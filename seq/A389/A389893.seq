%S A389893 1,1,2,3,6,13,32,84,230,646,1846,5344,15632,46128,137148,410469,
%T A389893 1235670,3739182,11367528,34703126,106343338,326994496,1008620692,
%U A389893 3120022642,9676739056,30085166398,93745106004,292716273248,915764667556,2870137752252,9010566764772
%N A389893 G.f. A(x) satisfies A(x) = 1 + x*(1-x^2)^2*A(x)^2.
%H A389893 Vincenzo Librandi, <a href="/A389893/b389893.txt">Table of n, a(n) for n = 0..1000</a>
%F A389893 G.f.: 2/(1 + sqrt(1 - 4*x*(1-x^2)^2)).
%F A389893 a(n) = Sum_{k=0..floor(n/2)} (-1)^k * binomial(2*(n-2*k),k) * Catalan(n-2*k).
%F A389893 D-finite with recurrence: (10 + 4*n)*a(n) + (-46 - 12*n)*a(n + 2) + (62 + 12*n)*a(n + 4) + (-10 - n)*a(n + 5) + (-26 - 4*n)*a(n + 6) + (8 + n)*a(n + 7) = 0. - _Robert Israel_, Sep 08 2026
%p A389893 with(gfun):
%p A389893 de:= holexprtodiffeq( 2/(1 + sqrt(1 - 4*x*(1-x^2)^2)), y(x)):
%p A389893 rec:= diffeqtorec(de,y(x),a(n)):
%p A389893 f:= rectoproc(rec,a(n),remember):
%p A389893 map(f, [$0..40]); # _Robert Israel_, Sep 08 2026
%t A389893 Table[Sum[(-1)^k* Binomial[2*(n-2*k),k]*CatalanNumber[n-2*k],{k,0,Floor[n/2]}],{n,0,30}] (* _Vincenzo Librandi_, Oct 29 2025 *)
%o A389893 (PARI) a(n) = sum(k=0, n\2, (-1)^k*binomial(2*(n-2*k), k)*binomial(2*(n-2*k), n-2*k)/(n-2*k+1));
%o A389893 (Magma) [&+[Catalan(n-2*k) * (-1)^k* Binomial(2*(n-2*k),k): k in [0..Floor(n/2)]] : n in [0..30] ]; // _Vincenzo Librandi_, Oct 29 2025
%Y A389893 Cf. A000108, A157003, A336165, A389871.
