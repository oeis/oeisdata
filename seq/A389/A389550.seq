%S A389550 1,2,7,31,156,848,4848,28710,174505,1082184,6819380,43538377,
%T A389550 281022011,1830738588,12021608943,79486728327,528752655711,
%U A389550 3536154910106,23761619146263,160351080083436,1086265193393688,7384325761403944,50357127973860129,344403734057180652
%N A389550 Expansion of (1/x) * Series_Reversion( x * (1 - x)^2 / (1 + x^3 / (1 - x)^3) ).
%H A389550 Robert Israel, <a href="/A389550/b389550.txt">Table of n, a(n) for n = 0..1158</a>
%H A389550 Robert Israel, <a href="/A389550/a389550.txt">Recurrence of order 10</a>
%F A389550 a(n) = (1/(n+1)) * Sum_{k=0..floor(n/3)} binomial(n+1,k) * binomial(3*n+1,n-3*k).
%F A389550 a(n) = (1/(n+1)) * [x^n] ((1 + x^3 / (1 - x)^3) / (1 - x)^2)^(n+1).
%F A389550 D-finite with recurrence of order 10 (see link). - _Robert Israel_, Oct 08 2026
%p A389550 with(gfun):
%p A389550 eq1:= numer(z*(1-z)^2/(1+z^3/(1-z)^3)-x):
%p A389550 eq2:= resultant(eq1, y*x-z, z):
%p A389550 de:= algeqtodiffeq(eq2, y(x)):
%p A389550 rec:= diffeqtorec(de, y(x), a(n)):
%p A389550 f:= rectoproc(rec, a(n), remember):
%p A389550 map(f, [$0..30]); # _Robert Israel_, Oct 08 2026
%o A389550 (PARI) my(N=30, x='x+O('x^N)); Vec(serreverse(x*(1-x)^2/(1+x^3/(1-x)^3))/x)
%Y A389550 Cf. A366052, A369265, A389549.
%K A389550 nonn,changed
%O A389550 0,2
