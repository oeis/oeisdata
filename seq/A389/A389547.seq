%T A389547 4282488489,41219526899,400350870417,3918882363967,38621309067409,
%U A389547 382891272488764,3816016128704476,38210465843364812,384221401518091453,3878185063610634729,39279785801010277651
%N A389547 Expansion of (1/x) * Series_Reversion( x * (1 - x)^2 / (1 + x / (1 - x)^3) ).
%H A389547 Robert Israel, <a href="/A389547/b389547.txt">Table of n, a(n) for n = 0..965</a>
%H A389547 Robert Israel, <a href="/A389547/a389547.txt">Recurrence of order 11</a>
%F A389547 a(n) = (1/(n+1)) * Sum_{k=0..n} binomial(n+1,k) * binomial(3*n+2*k+1,n-k).
%F A389547 a(n) = (1/(n+1)) * [x^n] ((1 + x / (1 - x)^3) / (1 - x)^2)^(n+1).
%F A389547 D-finite with recurrence of order 11: see link. - _Robert Israel_, Oct 08 2026
%p A389547 with(gfun):
%p A389547 eq1:= numer(z*(1-z)^2/(1+z/(1-z)^3)-x):
%p A389547 eq2:= resultant(eq1,y*x-z,z):
%p A389547 de:= algeqtodiffeq(eq2,y(x)):
%p A389547 rec:= diffeqtorec(de,y(x),a(n)):
%p A389547 f:= rectoproc(rec,a(n),remember):
%p A389547 map(f, [$0..30]); # _Robert Israel_, Oct 08 2026
%o A389547 (PARI) my(N=30, x='x+O('x^N)); Vec(serreverse(x*(1-x)^2/(1+x/(1-x)^3))/x)
%Y A389547 Cf. A006632, A366050.
%Y A389547 Cf. A161797, A389435.
