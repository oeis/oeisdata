%S A389895 1,1,2,5,11,30,87,264,830,2666,8710,28836,96514,326030,1110102,
%T A389895 3805893,13127190,45520316,158600175,554948647,1949261610,6870665634,
%U A389895 24294228065,86151877110,306323342082,1091836997424,3900470359066,13963221054704,50084038430870
%N A389895 G.f. A(x) satisfies A(x) = 1 + x*(1-x^3)^3*A(x)^2.
%H A389895 Vincenzo Librandi, <a href="/A389895/b389895.txt">Table of n, a(n) for n = 0..1000</a>
%F A389895 G.f.: 2/(1 + sqrt(1 - 4*x*(1-x^3)^3)).
%F A389895 a(n) = Sum_{k=0..floor(n/3)} (-1)^k * binomial(3*(n-3*k),k) * Catalan(n-3*k).
%F A389895 D-finite with recurrence: (20 + 4*n)*a(n) + (-110 - 16*n)*a(n + 3) + (210 + 24*n)*a(n + 6) + (-170 - 16*n)*a(n + 9) + (n + 20)*a(10 + n) + (50 + 4*n)*a(n + 12) + (-14 - n)*a(n + 13) = 0. - _Robert Israel_, Sep 08 2026
%p A389895 with(gfun):
%p A389895 de:= holexprtodiffeq(  2/(1 + sqrt(1 - 4*x*(1-x^3)^3)), y(x)):
%p A389895 rec:= diffeqtorec(de,y(x),a(n)):
%p A389895 f:= rectoproc(rec,a(n),remember):
%p A389895 map(f, [$0..40]); # _Robert Israel_, Sep 08 2026
%t A389895 Table[Sum[(-1)^k* Binomial[3*(n-3*k),k]*CatalanNumber[n-3*k],{k,0,Floor[n/3]}],{n,0,30}] (* _Vincenzo Librandi_, Oct 29 2025 *)
%o A389895 (PARI) a(n) = sum(k=0, n\3, (-1)^k*binomial(3*(n-3*k), k)*binomial(2*(n-3*k), n-3*k)/(n-3*k+1));
%o A389895 (Magma) [&+[Catalan(n-3*k) * (-1)^k* Binomial(3*(n-3*k),k): k in [0..Floor(n/3)]] : n in [0..30] ]; // _Vincenzo Librandi_, Oct 29 2025
