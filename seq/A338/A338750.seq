%I A338750 #12 Nov 15 2026 08:02:36
%S A338750 1,2,3,5,5,10,7,14,13,18,11,35,13,26,31,41,17,58,19,65,45,42,23,122,
%T A338750 41,50,63,95,29,154,31,122,73,66,83,241,37,74,87,230,41,226,43,155,
%U A338750 193,90,47,419,85,194,115,185,53,338,135,338,129,114,59,679,61,122,283
%N A338750 a(n) = 1 + Sum_{k=1..n-1} a(gcd(n,k)).
%C A338750 Inverse Moebius transform of A006874.
%H A338750 Robert Israel, <a href="/A338750/b338750.txt">Table of n, a(n) for n = 1..10000</a>
%F A338750 G.f. A(x) satisfies: A(x) = x / (1 - x) + Sum_{k>=2} phi(k) * A(x^k).
%F A338750 a(n) = 1 + Sum_{d|n, d < n} phi(n/d) * a(d).
%F A338750 a(n) = Sum_{d|n} A006874(d).
%F A338750 From _Robert Israel_, Nov 15 2026: (Start)
%F A338750 a(n) >= n, with equality if and only if n is 1 or prime.
%F A338750 If n = p*q is a squarefree semiprime, a(n) = 3*p*q - 2*p - 2*q + 2.
%F A338750 In particular, a(2*p) = 4*p-2 for p an odd prime. (End)
%p A338750 f:= proc(n) option remember; local k;
%p A338750       1 + add(procname(igcd(n,k)),k=1..n-1)
%p A338750 end proc:
%p A338750 map(f, [$1..100]); # _Robert Israel_, Nov 15 2026
%t A338750 a[n_] := a[n] = 1 + Sum[a[GCD[n, k]], {k, 1, n - 1}]; Table[a[n], {n, 1, 63}]
%t A338750 (* Alternative: *)
%t A338750 a[n_] := a[n] = 1 + DivisorSum[n, EulerPhi[n/#] a[#] &, # < n &]; Table[a[n], {n, 1, 63}]
%Y A338750 Cf. A000010, A006874, A038045, A130054.
%K A338750 nonn,changed
%O A338750 1,2
%A A338750 _Ilya Gutkovskiy_, Nov 06 2020
