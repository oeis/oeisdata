%I A338311 #13 Aug 19 2026 01:23:26
%S A338311 4,14,28,164,434,574,1106,5084,5572,7874,8386,13454,13694,19964,21988,
%T A338311 33166,39934,40132,95122,103886,113918,148994,157604,215326,216124,
%U A338311 256004,277564,306404,341342,366148,571154,660674,662494,764956,771374,876644,981646,1070926
%N A338311 Even composites m such that A003499(m)==6 (mod m).
%C A338311 If p is a prime, then A003499(p)==6 (mod p).
%C A338311 This sequence contains the even composite integers for which the congruence holds.
%C A338311 The generalized Pell-Lucas sequence of integer parameters (a,b) defined by V(m+2)=a*V(m+1)-b*V(m) and V(0)=2, V(1)=a, satisfy the identity V(p)==a (mod p) whenever p is prime and b=-1,1.
%C A338311 For a=6 and b=1, V(m) recovers A003499(m).
%D A338311 D. Andrica, O. Bagdasar, Recurrent Sequences: Key Results, Applications and Problems. Springer (2020)
%D A338311 D. Andrica, O. Bagdasar, On some new arithmetic properties of the generalized Lucas sequences, Mediterr. J. Math. (to appear, 2021)
%H A338311 Chai Wah Wu, <a href="/A338311/b338311.txt">Table of n, a(n) for n = 1..362</a>
%t A338311 Select[Range[2, 25000, 2], CompositeQ[#] && Divisible[2*ChebyshevT[#, 3] - 6, #] &]
%o A338311 (Python)
%o A338311 from itertools import islice
%o A338311 from sympy import nextprime
%o A338311 def A338311_gen(): # generator of terms
%o A338311     def f(n,m): # A003499(n) mod m
%o A338311         a2, b2, c2, d2 = 1, 0, 0, 1
%o A338311         for x in bin(n)[2:]:
%o A338311             e, f = b2*c2%m, k if (k:=a2+d2)<m else k-m
%o A338311             a2, b2, c2, d2 = (a2*a2+e)%m, b2*f%m, c2*f%m, (d2*d2+e)%m
%o A338311             if x=='1':
%o A338311                 a2, b2, c2, d2 = (a2*6+b2)%m, k if (k:=m-a2)<m else 0, (c2*6+d2)%m, k if (k:=m-c2)<m else 0
%o A338311         return (6*c2+(d2<<1))%m
%o A338311     p, q = 3, 5
%o A338311     while True:
%o A338311         for m in range(p+1,q,2):
%o A338311             if f(m,m) == 6%m:
%o A338311                 yield m
%o A338311         p, q = q, nextprime(q)
%o A338311 A338311_list = list(islice(A338311_gen(),40)) # _Chai Wah Wu_, Aug 18 2026
%Y A338311 Cf. A337233 (sequence of odd terms), A337777 (a=3).
%K A338311 nonn
%O A338311 1,1
%A A338311 _Ovidiu Bagdasar_, Oct 22 2020
%E A338311 More terms from _Amiram Eldar_, Oct 22 2020
