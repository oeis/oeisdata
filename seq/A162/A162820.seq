%N A162820 Positive numbers n such that 60*n/(60+n) is an integer.
%t A162820 f[a_,b_]:=(a*b)/(a+b); a=60;lst={};Do[If[f[a,n]==IntegerPart[f[a,n]], AppendTo[lst,n]],{n,9!}];lst
%t A162820 (* Alternative: *)
%t A162820 Select[Range[3600],IntegerQ[(60#)/(60+#)]&] (* _Harvey P. Dale_, Jul 29 2026 *)
