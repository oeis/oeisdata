%H A094836 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (2702,-1).
%F A094836 G.f.: -15*(1-2703*x)/(x*(1-2702*x+x^2)). - _Philippe Deléham_, Nov 19 2008
%t A094836 LinearRecurrence[{2702, -1}, {-15, 15}, 13] (* _Michael De Vlieger_, Jul 12 2017 *)
%t A094836 (* Alternative: *)
%t A094836 CoefficientList[Series[15(1+x)/(1 - 2702 x + x^2), {x, 0, 13}], x] (* _Michael De Vlieger_, Jul 12 2017 *)
%o A094836 (PARI) concat(-15, Vec((15 + 15*x)/(1-2702*x+x^2) + O(x^20))) \\ _Michel Marcus_, Jul 09 2017
%o A094836 (Magma)
%o A094836 [n le 2 select (-1)^n*15 else 2702*Self(n-1)-Self(n-2): n in [1..45]]; // _G. C. Greubel_, Oct 27 2026
%o A094836 (SageMath)
%o A094836 A094836=BinaryRecurrenceSequence(2702,-1,-15,15)
