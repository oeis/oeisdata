%S A094856 1,5,29,217,2297,34349,674965,16276481,461527793,14993138773,
%T A094856 548258687501,22272738733865,994870668959209,48451779617935997,
%U A094856 2554818339078836357,144990720049391354449,8811240401831517313505,570857963393730507892901,39275973938444154366908413
%N A094856 Expansion of e.g.f.: exp(4*x)/(1-4*x)^(1/4).
%C A094856 Sum_{k = 0..n} A046716(n,k)*x^k give A000522(n), A081367(n), A094822(n) for x = 1, 2, 3 respectively.
%H A094856 Vincenzo Librandi, <a href="/A094856/b094856.txt">Table of n, a(n) for n = 0..200</a>
%F A094856 a(n) = Sum_{k = 0..n} A046716(n, k)*4^k.
%F A094856 a(n) ~ n^(n-1/4)*4^n*Gamma(3/4)/(exp(n-1)*sqrt(Pi)). - _Vaclav Kotesovec_, Oct 03 2012
%F A094856 Conjectured to be D-finite with recurrence: a(n) -(4*n+1)*a(n-1) +16*(n-1)*a(n-2) = 0. - _R. J. Mathar_, Nov 15 2019
%F A094856 From _Peter Bala_, Oct 27 2026: (Start)
%F A094856 Logarithmically differentiating the e.g.f. A(x) gives A'(x)/A(x) = (16*x - 5)/(4*x - 1). Mathar's conjectured recurrence above follows from this.
%F A094856 Let k be a positive integer. The sequence obtained by reducing a(n) modulo k is an eventually periodic sequence. For example, modulo 7 the sequence becomes [1, 5, 1, 0, 1, 0, 4, 4, 6, 4, 0, 4, 0, 2, 2, 3, 2, 0, 2, 0, 1,  1, 5, 1, 0, 1, 0, 4, 4, 6, 4, 0, 4, 0, 2, 2, 3, 2, 0, 2, 0, 1, ...], a periodic sequence with period 21. (End)
%p A094856 a := proc(n) option remember; if n = 0 then 1 elif n = 1 then 5 else (4*n+1)*a(n-1) - 16*(n-1)*a(n-2) fi; end:
%p A094856 seq(a(n), n = 0..20); # _Peter Bala_, Oct 27 2026
%t A094856 With[{nn=20},CoefficientList[Series[Exp[4x]/(1-4x)^(1/4),{x,0,nn}],x] Range[ 0,nn]!] (* _Harvey P. Dale_, Mar 29 2013 *)
%o A094856 (PARI) my(x='x+O('x^66)); Vec(serlaplace(exp(4*x)/(1-4*x)^(1/4))) \\ _Joerg Arndt_, May 11 2013
%o A094856 (Magma)
%o A094856 R<x>:=PowerSeriesRing(Rationals(), 45);
%o A094856 Coefficients(R!(Laplace( Exp(4*x)*(1-4*x)^(-1/4) ))); // _G. C. Greubel_, Oct 27 2026
%o A094856 (SageMath)
%o A094856 def A094856_list(prec):
%o A094856     P.<x>= PowerSeriesRing(QQ, prec)
%o A094856     return P( exp(4*x)*(1-4*x)^(-1/4) ).egf_to_ogf().list()
%o A094856 print(A094856_list(45)) # _G. C. Greubel_, Oct 27 2026
