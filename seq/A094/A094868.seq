%N A094868 Decimal expansion of e/phi, where phi is the golden ratio (A001622).
%H A094868 G. C. Greubel, <a href="/A094868/b094868.txt">Table of n, a(n) for n = 1..10000</a>
%H A094868 Paul Cooijmans, <a href="http://web.archive.org/web/20050302174449/http://members.chello.nl/p.cooijmans/gliaweb/tests/odds.html">Odds</a>.
%e A094868 1.67999056098890116061169955794022337102949340427887...
%p A094868 evalf[120](2*exp(1)/(1+sqrt(5)));  # _Alois P. Heinz_, Nov 06 2026
%t A094868 RealDigits[E/GoldenRatio, 10, 105][[1]] (* _Amiram Eldar_, May 02 2023 *)
%o A094868 (Magma)
%o A094868 m:= 250; R:=RealField(m); SetDefaultRealField(R);
%o A094868 c:= Exp(1)*(Sqrt(5)-1)/2;
%o A094868 Prune(Reverse(IntegerToSequence(Round( c*10^m )))); // _G. C. Greubel_, Nov 06 2026
%o A094868 (SageMath)
%o A094868 m=130
%o A094868 c=numerical_approx( exp(1)*(sqrt(5)-1)/2 , digits=m+5)
%o A094868 print([ZZ(i) for i in c.str()[:-5] if i.isdigit()]) # _G. C. Greubel_, Nov 06 2026
%Y A094868 Cf. A001113 (e), A001622(phi), A094880 (reciprocal).
%K A094868 cons,nonn,changed
%O A094868 1,2
