%N A094548 Smallest m > n, coprime to n and having as many prime factors as n, with and without repetitions; a(1)=1.
%C A094548 GCD(a(n),n)=1, A001221(a(n))=A001221(n), A001222(a(n))=A001222(n) and (A001221(m)<>A001221(n) or A001222(m)<>A001222(n)) for m: n<m<a(n);
%C A094548 A094549(n) <= a(m).
%t A094548 sm[n_]:=Module[{m=n+1,pf1=PrimeOmega[n],pf2=PrimeNu[n]},While[!CoprimeQ[n,m]||PrimeOmega[m]!=pf1||PrimeNu[m]!=pf2,m++];m]; Join[{1},Array[sm,65,2]] (* _Harvey P. Dale_, Aug 24 2026 *)
