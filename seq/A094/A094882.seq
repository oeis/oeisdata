%N A094882 Decimal expansion of phi/Pi, where phi = (1+sqrt(5))/2.
%H A094882 Ivan Panchenko, <a href="/A094882/b094882.txt">Table of n, a(n) for n = 0..1000</a>
%H A094882 <a href="/index/Tra#transcendental">Index entries for transcendental numbers</a>.
%F A094882 Equals 1/A094881. - _Amiram Eldar_, Apr 11 2026
%e A094882 0.51503621480048386500726510157441589455223715766541...
%t A094882 RealDigits[GoldenRatio/Pi, 10, 120][[1]] (* _Amiram Eldar_, Apr 11 2026 *)
%o A094882 (Magma)
%o A094882 m:= 253; R:=RealField(m+2); SetDefaultRealField(R);
%o A094882 c:= (1+Sqrt(5))/(2*Pi(R));
%o A094882 Prune(Reverse(IntegerToSequence(Round( c*10^m )))); // _G. C. Greubel_, Nov 06 2026
%o A094882 (SageMath)
%o A094882 m=250
%o A094882 c=numerical_approx( (1+sqrt(5))/(2*pi) , digits=m+5)
%o A094882 print([ZZ(i) for i in c.str()[:-5] if i.isdigit()][1:]) # _G. C. Greubel_, Nov 06 2026
%Y A094882 Cf. A000796, A001622, A094881.
%K A094882 cons,nonn,changed
%O A094882 0,1
