%N A094884 Decimal expansion of phi/sqrt(2), where phi = (1+sqrt(5))/2.
%C A094884 An algebraic number with minimal polynomial 4*x^4 - 6*x^2 + 1. - _Charles R Greathouse IV_, Mar 25 2014
%H A094884 Ivan Panchenko, <a href="/A094884/b094884.txt">Table of n, a(n) for n = 1..1000</a>
%H A094884 <a href="/index/Al#algebraic_04">Index entries for algebraic numbers, degree 4</a>.
%F A094884 Equals Product_{k>=0} (1 + (-1)^k/(10*k+5)). - _Amiram Eldar_, Nov 23 2024
%F A094884 Equals A094887/2 = sqrt(A239798). - _Hugo Pfoertner_, Nov 23 2024
%e A094884 1.144122805635368595200145567160604153072306753675541225...
%t A094884 RealDigits[GoldenRatio/Sqrt[2],10,120][[1]] (* _Harvey P. Dale_, Feb 11 2015 *)
%o A094884 (PARI) sqrt(sqrt(5)+3)/2 \\ _Charles R Greathouse IV_, Mar 25 2014
%o A094884 (Magma)
%o A094884 m:= 253; R:=RealField(m+2); SetDefaultRealField(R);
%o A094884 c:= Sqrt(3+Sqrt(5))/2;
%o A094884 Prune(Reverse(IntegerToSequence(Round( c*10^m )))); // _G. C. Greubel_, Sep 27 2018, Nov 06 2026
%o A094884 (SageMath)
%o A094884 m=250
%o A094884 c=numerical_approx( sqrt(3+sqrt(5))/2 , digits=m+5)
%o A094884 print([ZZ(i) for i in c.str()[:-5] if i.isdigit()]) # _G. C. Greubel_, Nov 06 2026
%Y A094884 Cf. A001622 (phi), A002193 (sqrt(2)), A017329, A094883, A094887, A239798.
%K A094884 cons,nonn,changed
%O A094884 1,3
