%S A094902 0,13,0,24,0,36,0,0,60,0,0,84,0,0,0,120,0,0,145,0,162,0,0,0,204,0,216,
%T A094902 0,0,254,0,278,0,298,0,0,330,0,0,362,0,381,0,0,0,0,445,456,0,0,482,0,
%U A094902 506,520,0,540,0,0,567,0,0,612,624,0,0,666,0,693,0,0,0,739,0,762,0,0,798,0
%N A094902 a(n) = half the sum of primes n-3 to n when their Schwarzian-type difference is nonnegative, else 0.
%C A094902 Generally there seem to be more negative values than positive for the integer Schwarzian derivative of the Primes. The nearest primes to this average are the places where the prime curve has positive derivative, for example 13,23,37,61,83, etc.
%C A094902 Refer to Lan and Chen (2017), Eq. (3.2), for an example calculation. - _Adam Reichert_, Sep 11 2026
%H A094902 Baoqin Chen and Sheng Li, <a href="https://doi.org/10.1155/2014/306360">Admissible Solutions of the Schwarzian Type Difference Equation</a>, Abstr. Appl. Anal., 2014 (2014), Article ID 306360.
%H A094902 Shuang-Ting Lan and Zong-Xuan Chen, <a href="https://doi.org/10.1186/s13662-016-1050-9">On difference equations concerning Schwarzian equation</a>, Adv. Differ. Equ., 2017 (2017), Article 2.
%t A094902 f1[n_]=Prime[n]-Prime[n-1];
%t A094902 f2[n_]=Prime[n]-2*Prime[n-1]+Prime[n-2];
%t A094902 f3[n_]=Prime[n]-3*Prime[n-1]+3*Prime[n-2]-Prime[n-3];
%t A094902 sf[n_]=f3[n]/f1[n]-(3/2)*(f2[n]/f1[n])^2;
%t A094902 a=Table[If[sf[n]>0 \[Or] sf[n]==0, (Prime[n-3]+Prime[n-2]+Prime[n-1]+Prime[n])/2, 0], {n, 4, 81}]
%Y A094902 Cf. A000040.
%K A094902 nonn,less,uned,changed
%O A094902 4,2
