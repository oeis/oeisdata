%S A051595 429552,497808,800496,2472912,3329712,4925808,5033808,5470632,5756616,
%T A051595 7584408,7696368,8498952,13172000,14484816,16112304,17901936,18349776,
%U A051595 20867184,21395600,21895920,22581000,24395200,24805872,27369900,29372328,33787296,40087440,43399888
%N A051595 Lesser members of pairs of "(-1)sigma amicable numbers", sorted by their lesser members.
%C A051595 Pairs (a, b) such that (-1)sigma(a) = (-1)sigma(b) = a+b where a < b. Here (-1)sigma(n) = A049060(n): If n = Product p(i)^r(i) then (-1)sigma(n) = Product(-1 + Sum_{s=1..r(i)} p(i)^s). This sequence gives the values of b; A051594 gives the values of b.
%H A051595 Amiram Eldar, <a href="/A051595/b051595.txt">Table of n, a(n) for n = 1..1000</a>
%t A051595 s[k_] := With[{f = FactorInteger[k]}, Times @@ ((f[[;;, 1]]^(f[[;;, 2]]+1) - 1)/(f[[;;, 1]] - 1) - 2)] - k; s[1] = 0;
%t A051595 seq[lim_] := Module[{v = {}, m}, Do[m = s[k]; If[m > k && s[m] == k, AppendTo[v, k]], {k, 1, lim}]; v]; seq[10^6] (* _Amiram Eldar_, Oct 09 2026 *)
%o A051595 (PARI) s(k) = my(f = factor(k)); prod(i = 1, #f~, (f[i, 1]^(f[i, 2]+1) - 1)/(f[i, 1] - 1) - 2) - k;
%o A051595 list(lim) = {my(m); for(k = 1, lim, m = s(k); if(m > k && s(m) == k, print1(k,", ")));} \\ _Amiram Eldar_, Oct 09 2026
%Y A051595 Cf. A051594, A049060.
