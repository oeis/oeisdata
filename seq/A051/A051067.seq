%N A051067 A051066 read mod 2.
%D A051067 Letter from _Gary W. Adamson_ concerning Prouhet-Thue-Morse sequence, Nov. 11, 1999.
%t A051067 Mod[Accumulate[Join[{0}, Mod[Accumulate[Table[IntegerExponent[3*n, 3], {n, 1, 100}]], 2]]], 2] (* _Amiram Eldar_, Jun 02 2025 *)
%o A051067 (Python)
%o A051067 from functools import reduce
%o A051067 from operator import xor
%o A051067 from sympy import integer_log
%o A051067 def A051067(n): return reduce(xor, (i//3**k&1 for i in range(1,n+1) for k in range(integer_log(i,3)[0]+1))) if n else 0 # _Chai Wah Wu_, Oct 19 2026
