%N A051066 Partial sums of A051065.
%D A051066 Letter from Gary W. Adamson concerning Prouhet-Thue-Morse sequence, Nov. 11, 1999.
%F A051066 a(n) = Sum_{k=0..n} A051065(k). - _Wesley Ivan Hurt_, May 25 2024
%t A051066 Accumulate[Join[{0}, Mod[Accumulate[Table[IntegerExponent[3*n, 3], {n, 1, 100}]], 2]]] (* _Amiram Eldar_, Jun 02 2025 *)
%o A051066 (Python)
%o A051066 from functools import reduce
%o A051066 from operator import xor
%o A051066 from sympy import integer_log
%o A051066 def A051066(n): return sum(reduce(xor, (i//3**k&1 for k in range(integer_log(i,3)[0]+1))) for i in range(1,n+1)) if n else 0 # _Chai Wah Wu_, Oct 19 2026
%Y A051066 Cf. A004128, A051065, A051067.
%K A051066 nonn,easy,changed
%O A051066 0,5
%A A051066 _N. J. A. Sloane_ and _Gary W. Adamson_
%E A051066 More terms from _James Sellers_, Dec 11 1999
