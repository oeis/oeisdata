%I A051770 #18 Nov 24 2026 15:05:34
%S A051770 4,11,54,69,77,89,91,155,173,199,202,202,208,218,245,272,286,293,293,
%T A051770 323,324,347,368,370,373,379,413,489,512,514,533,549,552,558,637,650,
%U A051770 674,731,749,759,771,773,782,783,787,811,849,850,883,896,902,927,937
%N A051770 Numbers m such that there exists a binomial coefficient C(m,k) where C(m,k)-1 and C(m,k)+1 are twin primes and 2<=k<=floor(m/2).
%C A051770 The integer 202 occurs twice because both C(202,34) and C(202,69) yield twin prime pairs.
%H A051770 Pierre Colmant, <a href="/A051770/b051770.txt">Table of n, a(n) for n = 1..93</a>
%H A051770 Joe DeMaio, <a href="https://web.archive.org/web/20060217020319/http://science.kennesaw.edu/~jdemaio/twinbc.htm">Twin BC primes</a>
%e A051770 The integer 11 is a member of the sequence because C(11,5)=462 and 461 and 463 are twin primes.
%o A051770 (Python)
%o A051770 from gmpy2 import mpz, is_prime
%o A051770 def A051770_list(N):
%o A051770     L = []
%o A051770     for n in range(4, N+1):
%o A051770         c = mpz(n)
%o A051770         for k in range(2, n//2+1):
%o A051770             c = c*(n-k+1)//k
%o A051770             if is_prime(c-1) and is_prime(c+1): L.append(n)
%o A051770     return L # _Pierre Colmant_, Nov 17 2026
%Y A051770 Cf. A051735, A051771.
%K A051770 nonn,changed
%O A051770 1,1
%A A051770 Joe DeMaio (jdemaio(AT)kennesaw.edu), Dec 08 1999
