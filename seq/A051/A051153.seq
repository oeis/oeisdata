%I A051153 #30 Oct 09 2026 08:44:13
%S A051153 247,988,2808,10440,87696,151200,191052,263520,2630320,3961980,
%T A051153 961182720,1199715840,11850526464,11881499520,20558630400
%N A051153 (-1)-sigma super perfect numbers: numbers k such that (-1)sigma((-1)sigma(k)) = 2*k, where if k = Product p(i)^r(i) then (-1)sigma(k) = Product (-1 + Sum_{s = 1..r(i)} p(i)^s); (-1)sigma(1) = 1.
%C A051153 Factorizations: 13*19, 2^3*3^2*5*29, 2^4*3^3*7*29, 2^5*3^3*5^2*7, 2^2*3^3*29*61, 2^5*3^3*5*61, 2^7*3*5*11*19*29*1021, ...
%F A051153 A049060(A049060(k)) = 2*k. - _R. J. Mathar_, Oct 12 2006
%t A051153 f[p_, e_] := (p^(e+1) - 2*p + 1)/(p - 1); s[1] = 1; s[n_] := Times @@ f @@@ FactorInteger[n]; q[k_] := s[s[k]] == 2*k; Select[Range[300000], q] (* _Amiram Eldar_, Oct 09 2026 *)
%o A051153 (PARI) A049060(n)={ local(i,resul,rmax,p) ; if(n==1, return(1) ) ; i=factor(n) ; rmax=matsize(i)[1] ; resul=1 ; for(r=1,rmax, p=0 ; for(j=1,i[r,2], p += i[r,1]^j ; ) ; resul *= p-1 ; ) ; return(resul) ; }
%o A051153 isA051153(r)={ local(s,t) ; s=A049060(r) ; t=A049060(s) ; if( 2*r == t, return(1), return(0) ) ; }
%o A051153 for(n=1,30000000, if( isA051153(n), print1(n,", ") ) ; ) ; \\ _R. J. Mathar_, Oct 12 2006
%Y A051153 Cf. A049057, A049058, A049059, A049060, A034094, A051152.
%K A051153 nonn,more,changed
%O A051153 1,1
%A A051153 _Yasutoshi Kohmoto_
