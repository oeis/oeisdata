%T A051594 6941160,7780968,7738128,11063448,16588192,14914224,19592496,17928144,
%U A051594 21614544,20934576,23009200,22829040,28157688,29892800,25180848,28536300,30381912,38487456,40208688,44133712
%N A051594 Greater members of pairs of "(-1)sigma amicable numbers", sorted by their lesser members.
%C A051594 Pairs (a, b) such that (-1)sigma(a) = (-1)sigma(b) = a+b where a < b. Here (-1)sigma(n) = A049060(n): If n = Product p(i)^r(i) then (-1)sigma(n) = Product(-1 + Sum_{s=1..r(i)} p(i)^s). This sequence gives the values of b; A051595 gives the values of a.
%H A051594 Amiram Eldar, <a href="/A051594/b051594.txt">Table of n, a(n) for n = 1..1000</a>
%t A051594 s[k_] := With[{f = FactorInteger[k]}, Times @@ ((f[[;;, 1]]^(f[[;;, 2]]+1) - 1)/(f[[;;, 1]] - 1) - 2)] - k; s[1] = 0;
%t A051594 seq[lim_] := Module[{v = {}, m}, Do[m = s[k]; If[m > k && s[m] == k, AppendTo[v, m]], {k, 1, lim}]; v]; seq[10^6] (* _Amiram Eldar_, Oct 09 2026 *)
%o A051594 (PARI) s(k) = my(f = factor(k)); prod(i = 1, #f~, (f[i, 1]^(f[i, 2]+1) - 1)/(f[i, 1] - 1) - 2) - k;
%o A051594 list(lim) = {my(m); for(k = 1, lim, m = s(k); if(m > k && s(m) == k, print1(m,", ")));} \\ _Amiram Eldar_, Oct 09 2026
%Y A051594 Cf. A051595, A049060.
