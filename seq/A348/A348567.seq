%S A348567 1,4,2,32,12,832,232,69632,14416,18719744,2876576,16158392320,
%T A348567 1842788800,44775629275136,3789707472000,398295836867428352,
%U A348567 25017824149678336,11373097448849428185088,530150086868123439616,1042448588682738516631748608,36061941538502686312410112
%N A348567 Number of fully symmetric recurrent sandpiles on an n X n grid.
%H A348567 James Guillochon, <a href="/A348567/b348567.txt">Table of n, a(n) for n = 0..100</a>
%H A348567 Laura Florescu, Daniela Morar, David Perkinson, Nicholas Salter and Tianyuan Xu, <a href="https://doi.org/10.37236/4472">Sandpiles and Dominos</a>, El. J. Comb., 22 (2015), P1.66.
%H A348567 James Guillochon, <a href="https://github.com/guillochon/oeis-results/tree/main/A348567">Product formula for a(n), proof of the sqrt formula, and a(11)-a(100)</a>
%H A348567 James Guillochon, <a href="https://guillochon.github.io/symmetric-sandpiles/">Symmetric Sandpiles</a> (the identity for n <= 200, every symmetric recurrent for n <= 6, the symmetric eigenmodes)
%F A348567 A256046(n) divides a(n), a(n) divides b(n) = A348566(n, n).
%F A348567 From _James Guillochon_, Nov 10 2026: (Start)
%F A348567 a(n) = sqrt(b(n) * 2^A030451(n)), [Conjectured by _Andrei Zabolotskii_, Nov 23 2025]
%F A348567 a(n) = Product_{h=1..ceiling(n/2)} Product_{k=h..ceiling(n/2)} (4 - 2*cos((2*h-1)*Pi/(n+1)) - 2*cos((2*k-1)*Pi/(n+1))),
%F A348567 a(2*n) = 2^n * A065072(n),
%F A348567 log(a(n)) ~ G*n^2/(2*Pi), where G is Catalan's constant A006752. (End)
%e A348567 a(0) = 1, the empty sandpile on an empty grid.
%e A348567 a(1) = 4, all 4 sandpiles on a 1 X 1 grid are fully symmetric.
%e A348567 a(2) = 2 fully symmetric recurrent sandpiles on an 2 X 2 grid are the all-2 and all-3 sandpiles.
%e A348567 Among A348566(4, 4) = 36 sandpiles with horizontal and vertical symmetry, only a(4) = 12 also have diagonal symmetries:
%e A348567   3333  1331  1331  3223  3223  3333  2222  0330  2332  2332  0330  2222
%e A348567   3333  3223  3333  2222  2332  3223  2222  3223  3223  3333  3333  2332
%e A348567   3333  3223  3333  2222  2332  3223  2222  3223  3223  3333  3333  2332
%e A348567   3333  1331  1331  3223  3223  3333  2222  0330  2332  2332  0330  2222
%o A348567 (PARI) a(n) = localprec(n^2\8 + 40); my(m=(n+1)\2, c=vector(m, i, 2*cos((2*i-1)*Pi/(n+1)))); round(prod(i=1, m, prod(j=i, m, 4-c[i]-c[j]))); \\ _James Guillochon_, Nov 10 2026
%Y A348567 Cf. A348566, A256046, A030451, A065072, A004003.
%K A348567 nonn,changed
%O A348567 0,2
%A A348567 _Andrei Zabolotskii_, Oct 22 2021
%E A348567 a(11)-a(20) from _James Guillochon_, Nov 10 2026
