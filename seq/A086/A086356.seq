%N A086356 Fixed point if the nonzero-digit-product function is iterated starting from the central binomial coefficient C(2n,n).
%F A086356 a(n) = A051802(A000984(n)).
%e A086356 n=10, C[20,10]=184756, iteration list={184756,7560,210,2},
%e A086356 a(100)=2.
%t A086356 prd[x_] := Apply[Times, DeleteCases[IntegerDigits[x], 0]] Table[FixedPoint[prd, Binomial[2*n, n]], {w, 1, 128}]
