%N A086158 Concatenation of the smaller members of first n pairs of twin primes.
%t A086158 With[{tw=Select[Partition[Prime[Range[50]],2,1],#[[2]]-#[[1]]==2&][[;;,1]]},Table[FromDigits[Flatten[IntegerDigits/@Take[tw,n]]],{n,Length[tw]}]] (* _Harvey P. Dale_, Sep 05 2026 *)
%o A086158 (PARI) concattwprl(n) = { y=3; print1(3","); forprime(x=5,n, if(isprime(x+2), y=eval(concat(Str(y),Str(x))); print1(y",") ) ) }
