%I A086265 #23 Aug 18 2026 11:09:35
%S A086265 1,17,897,168529,118183389,316386731405,3274879810919935,
%T A086265 132118589086027744171,20886572066414887494230657,
%U A086265 12988767148170531662504971523155,31863483977191283921972219349382830823,309013109208799841446516454038957886046039915,11867174064775033177314321905761005356783612866506763
%N A086265 Total number of s-clusters in all n X n (0,1)-matrices.
%C A086265 a(n)/2^(n^2) gives the mean number of s-clusters.
%C A086265 a(n) is the total number of connected components in all induced subgraphs of the n X n grid graph. - _Andrew Howroyd_, Aug 17 2026
%H A086265 Andrew Howroyd, <a href="/A086265/b086265.txt">Table of n, a(n) for n = 1..16</a>
%H A086265 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/GridGraph.html">Grid Graph</a>.
%H A086265 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/s-Cluster.html">s-Cluster</a>.
%F A086265 a(n) = Sum_{k>=1} k*A086266(n,k). - _Andrew Howroyd_, Aug 17 2026
%e A086265 a(n)/2^(n^2) = 1/2, 17/16, 897/512, 168529/65536, 118183389/33554432...
%t A086265 For[n = 1, n <= 5, n++,
%t A086265 cnt = 0;
%t A086265 For[ii = 0, ii <= 2^(n^2), ii++,
%t A086265   A = Partition[IntegerDigits[ii, 2, n^2], n];
%t A086265   G = EmptyGraph[n^2];
%t A086265   deleteG = 0;
%t A086265   vert = {0, -1};
%t A086265   horiz = {-1, 0};
%t A086265   For[i = 1, i <= n, i++,
%t A086265    For[j = 1, j <= n, j++,
%t A086265     If[A[[i, j]] == 1,
%t A086265      For[k = 1, k <= 2, k++,
%t A086265       If[A[[i + vert[[k]], j + horiz[[k]]]] == 1,
%t A086265        G = AddEdge[G, {j + (i - 1) n, j + horiz[[k]] + (i - 1) n + n vert[[k]]}];
%t A086265        ]
%t A086265       ],
%t A086265      deleteG++;
%t A086265      ]
%t A086265     ]
%t A086265    ];
%t A086265   CC = ConnectedComponents[G];
%t A086265   cnt += (Length[CC] - deleteG);
%t A086265   ];
%t A086265 Print[cnt]
%t A086265 ] (* _Luca Petrone_, May 09 2018 *)
