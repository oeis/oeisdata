%I A086805 #20 Oct 08 2026 14:14:41
%S A086805 5,113,1987,552493,628313002458512784191921,
%T A086805 40755082849497410605337341,6681921617166540622940410282864619819,
%U A086805 2889303557247057098701326417725516604468572074033936774934286952655272259760539
%N A086805 Primes in the numerator of the continued fraction rational approximation of zeta(3).
%H A086805 Cino Hilliard, <a href="https://web.archive.org/web/20080411094846/https://groups.msn.com/BC2LCC/continuedfractions.msnw">Continued fractions rational approximation of numeric constants</a>.
%t A086805 Select[Numerator[Convergents[Zeta[3], 161]], PrimeQ] (* _Amiram Eldar_, Oct 08 2026 *)
%o A086805 (PARI)
%o A086805 cfraczeta(m,f) = { cf = vector(100000); x=f; for(n=0,m, i=floor(x); x=1/(x-i); cf[n+1] = i; ); for(m1=0,m, r=cf[m1+1]; forstep(n=m1,1,-1, r = 1/r; r+=cf[n]; ); numer=numerator(r); denom=denominator(r); if(isprime(numer),print1(numer,", ")); ) }
%Y A086805 Cf. A002117, A013631, A078984.
%K A086805 nonn,changed
%O A086805 1,1
%A A086805 _Cino Hilliard_, Aug 05 2003
%E A086805 Offset changed and a(8) from _Sean A. Irvine_, Oct 07 2026
