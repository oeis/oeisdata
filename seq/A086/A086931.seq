%N A086931 a(0) = 1, a(n) = lpf(n)*a(n-lpf(n)), where lpf=A020639 (least prime factor).
%C A086931 a(n)=n iff n=1 or n=4 or n is prime: see A046022.
%H A086931 Paolo Xausa, <a href="/A086931/b086931.txt">Table of n, a(n) for n = 0..1000</a>
%F A086931 a(2*n) = 2^n.
%t A086931 A086931[n_] := A086931[n] = If[n == 0, 1, #*A086931[n - #] & [FactorInteger[n][[1, 1]]]];
