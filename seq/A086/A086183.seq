%t A086183 a[n_]:=Intersection[FromDigits/@Subsequences[RealDigits[Pi,10,n][[1]]],FromDigits/@Subsequences[Drop[RealDigits[Pi,10,2n-1][[1]],n-1]]][[-1]];Array[a,61] (* _James C. McMahon_, Aug 03 2026 *)
%o A086183 (Python)
%o A086183 from mpmath import mp
%o A086183 def a(n):
%o A086183     mp.dps = 2 * n + 5
%o A086183     digits = [d for d in str(mp.pi).replace('.', '')]
%o A086183     str1 = "".join(digits[:n])
%o A086183     str2 = "".join(digits[n - 1 : 2 * n - 1])
%o A086183     all_sub = set()
%o A086183     for start in range(len(str1)):
%o A086183         for end in range(start + 1, len(str1) + 1):
%o A086183             all_sub.add(str1[start:end])
%o A086183     shared = [sub for sub in all_sub if sub in str2]
%o A086183     shared.sort(key=lambda x: (len(x), int(x)))
%o A086183     return shared[-1]
%o A086183 print([a(i) for i in range(1, 62)]) # _Aitzaz Imtiaz_, Aug 03 2026
