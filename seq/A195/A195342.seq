%F A195342 Minimal polynomial: x^4 - 56*x^2 + 64. - _Amiram Eldar_, May 18 2026
%e A195342 1.0803630269509058144061726281963757019894604...
%t A195342 a = 1; b = 2; c = Sqrt[5]; f = 2 a*b/(a + b + c);
%t A195342 x3 = f*Sqrt[2];
%t A195342 RealDigits[x3, 10, 100]
