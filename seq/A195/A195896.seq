%I A195896 #35 Jul 29 2026 02:19:52
%S A195896 1,2,3,5,8,9,13,14,20,21,25,32,33,37,38,45,50,56,57,61,68,73,81,85,86,
%T A195896 92,93,105,110,117,121,122,128,133,140,141,145,157,158,165,176,177,
%U A195896 182,193,200,201,205,212,213,217,218,225,236,248,253,261,266,273,277,290,297,301,302,308
%N A195896 Numbers of the form 2*p-1 or 3*p-1 where p is 1 or a prime.
%H A195896 Chris R. Rehmann, <a href="/A195896/b195896.txt">Table of n, a(n) for n = 1..10000</a>
%e A195896 a(1)=1 because p=1 and 2*1 - 1 = 1;
%e A195896 a(2)=2 because p=1 and 3*1 - 1 = 2;
%e A195896 a(3)=3 because p=2 and 2*2 - 1 = 3;
%e A195896 a(4)=5 because p=2 and 3*3 - 1 = 5 or p=3 and p=2 and 3*2 - 1 = 5;
%e A195896 a(5)=8 because p=3 and 3*3 - 1 = 8.
%p A195896 isA195896 := proc(n)
%p A195896         for p in {(n+1)/2,(n+1)/3} do
%p A195896         if type(p,'integer') then
%p A195896                 if isprime(p) or p = 1 then
%p A195896                         return true;
%p A195896                 end if;
%p A195896         end if;
%p A195896         end do;
%p A195896         false ;
%p A195896 end proc:
%p A195896 for n from 1 to 400 do
%p A195896         if isA195896(n) then
%p A195896                 printf("%d,",n) ;
%p A195896         end if;
%p A195896 end do: # _R. J. Mathar_, Oct 15 2011
%t A195896 Select[Range[310],PrimeQ[h=(#+1)/2] || h==1 || PrimeQ[k=(#+1)/3] || k==1 &] (* _Stefano Spezia_, Jul 21 2026 *)
%o A195896 (MATLAB)
%o A195896 amax = 308; % List terms < amax, with amax < 2^53
%o A195896 x = 1:min(amax,flintmax); x2 = (x+1)/2; x3 = (x+1)/3;
%o A195896 x2(mod(x2,1)>0) = 1; x3(mod(x3,1)>0) = 1;
%o A195896 ip = isprime(x2) | isprime(x3); ip(1:2) = true;
%o A195896 a = x(ip);
%o A195896 disp(regexprep(num2str(a), ' +', ', ')) % _Chris R. Rehmann_, Jul 21 2026
%o A195896 (PARI) isok(k)=k<3 || (k%2==1 && isprime((k+1)/2)) || (k%3==2&&isprime((k+1)/3)) \\ _Andrew Howroyd_, Jul 21 2026
%o A195896 (Python)
%o A195896 from sympy import primepi
%o A195896 from oeis_sequences.OEISsequences import bisection
%o A195896 def A195896(n):
%o A195896     def f(x): return n+x-primepi(x+1>>1)-primepi((x+1)//3)-(x>=1)-(x>=2)+(x>=5)
%o A195896     return bisection(f,n,n) # _Chai Wah Wu_, Jul 28 2026
%Y A195896 Union of A076274 and A112773.
%Y A195896 Cf. A196127, A008578.
%K A195896 nonn
%O A195896 1,2
%A A195896 _Juri-Stepan Gerasimov_, Sep 24 2011
