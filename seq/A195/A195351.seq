%N A195351 Numbers k such that there are no primes in the range [2^k-k, 2^k+k].
%C A195351 If k is prime then it is not in A000043. - _Alonso del Arte_, Oct 07 2011
%H A195351 Amiram Eldar, <a href="/A195351/b195351.txt">Table of n, a(n) for n = 1..164</a>
%F A195351 A192454(a(n)) = 0.
%t A195351 Select[Range[0, 49], PrimePi[2^# - # - 1] == PrimePi[2^# + #] &] (* _Alonso del Arte_, Oct 07 2011 *)
%o A195351 (PARI) isok(k) = {my(t = 1 << k); for(p = t-k, t+k, if(isprime(p), return(0))); 1;} \\ _Amiram Eldar_, Oct 02 2026
%Y A195351 Cf. A000043, A192454.
