%I A195986 #27 Sep 28 2026 10:30:23
%S A195986 1,4,1,5,1,4,1,6,1,4,1,5,1,4,1,7,1,4,1,5,1,4,1,6,1,4,1,5,1,4,1,8,1,4,
%T A195986 1,5,1,4,1,6,1,4,1,5,1,4,1,7,1,4,1,5,1,4,1,6,1,4,1,5,1,4,1,9,1,4,1,5,
%U A195986 1,4,1,6,1,4,1,5,1,4,1,7,1,4,1,5,1,4
%N A195986 Exponent of the largest power of 2 that divides 5^n - 3^n.
%C A195986 Conjecture: a(n) = 1 if A090740 = 1, else a(n) = A090740(n)+1.
%C A195986 The conjecture is true and follows from the 2nd formula. - _Amiram Eldar_, Sep 28 2026
%H A195986 Antti Karttunen, <a href="/A195986/b195986.txt">Table of n, a(n) for n = 1..16383</a>
%H A195986 Wikipedia, <a href="https://en.wikipedia.org/wiki/Lifting-the-exponent_lemma">Lifting-the-exponent lemma</a>.
%F A195986 a(n) = A007814(A005058(n)). - _Antti Karttunen_, Nov 06 2018
%F A195986 From _Amiram Eldar_, Sep 28 2026: (Start)
%F A195986 a(n) = A007814(n) + 3 if n is even, and a(n) = 1 if n is odd (a consequence of the Lifting-the-exponent lemma).
%F A195986 Asymptotic mean: Limit_{m->oo} (1/m) * Sum_{k=1..m} a(k) = 3. (End)
%t A195986 Table[IntegerExponent[5^n - 3^n, 2], {n, 100}] (* _T. D. Noe_, Oct 12 2011 *)
%t A195986 (* Alternative: *)
%t A195986 a[n_] := If[OddQ[n], 1, IntegerExponent[n, 2] + 3]; Array[a, 100] (* _Amiram Eldar_, Sep 28 2026 *)
%o A195986 (PARI) A195986(n) = valuation(5^n - 3^n,2); \\ _Antti Karttunen_, Nov 06 2018
%o A195986 (PARI) a(n) = if(n%2, 1, valuation(n, 2) + 3); \\ _Amiram Eldar_, Sep 28 2026
%Y A195986 Cf. A005058, A007814, A090740.
%K A195986 nonn,easy,changed
%O A195986 1,2
%A A195986 _John W. Layman_, Oct 12 2011
%E A195986 Name clarified by _Antti Karttunen_, Nov 06 2018
