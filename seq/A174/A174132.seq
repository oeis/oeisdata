%S A174132 3,5,19,53,163,485,1459,4373,13123,39365,118099,354293,1062883,
%T A174132 3188645,9565939,28697813,86093443,258280325,774840979,2324522933,
%U A174132 6973568803,20920706405,62762119219,188286357653,564859072963,1694577218885,5083731656659,15251194969973
%N A174132 a(n) = 2*3^(n-1) - (-1)^n.
%H A174132 Vincenzo Librandi, <a href="/A174132/b174132.txt">Table of n, a(n) for n = 1..200</a>
%H A174132 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (2,3).
%F A174132 From _Bruno Berselli_, Jan 28 2011 - Jan 30 2011: (Start)
%F A174132 G.f.: x*(3-x)/((1+x)*(1-3*x)).
%F A174132 a(n) = A062547(A042963(n-1)).
%F A174132 a(n) = 2*(Sum_{i=1..n-1} a(i)) - 2*(-1)^n + 1 for n>1. (End)
%F A174132 From _Elmo R. Oliveira_, Aug 31 2026: (Start)
%F A174132 a(n) = 2*a(n-1) + 3*a(n-2) for n > 2.
%F A174132 E.g.f.: (1 - exp(-x) + 4*exp(x)*sinh(2*x))/3. (End)
%t A174132 Table[(2 3^(n-1) - (-1)^n), {n, 30}] (* _Vincenzo Librandi_, Aug 21 2014 *)
%t A174132 (* Alternative: *)
%t A174132 CoefficientList[Series[(3 - x)/((1 + x)(1 - 3 x)), {x, 0, 30}], x] (* _Vincenzo Librandi_, Aug 21 2014 *)
%o A174132 (Magma) [2*3^(n-1)-(-1)^n: n in [1..30]]; // _Vincenzo Librandi_, Aug 21 2014
%Y A174132 Cf. A042963, A062547, A154992.
%K A174132 nonn,easy,changed
%O A174132 1,1
%A A174132 _Vincenzo Librandi_, Jan 27 2011
