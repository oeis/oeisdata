%I A395661 #50 Aug 02 2026 18:06:20
%S A395661 0,0,1,5,16,49,140,392,1072,2898,7744,20538,54095,141741,369682,
%T A395661 960555,2487546,6423714,16546566,42527619,109088175,279331712,
%U A395661 714124316,1823077560,4648047917,11836411886,30109030933,76513675399,194258791952,492778499937
%N A395661 Number of rooted binary unlabeled general galled trees with n leaves and exactly 1 gall.
%H A395661 Lily Agranat-Tamir, Michael Fuchs, Bernhard Gittenberger, Noah A. Rosenberg, and Karthik V. Seetharaman, <a href="https://doi.org/10.1016/j.aam.2026.103131">Combinatorial comparison of general galled trees, time-consistent galled trees, and simplex time-consistent galled trees</a>, Adv. Appl. Math. 180, 103131 (2026). See Table 1.
%F A395661 G.f.: A(x)^3/(2*(1-A(x))^3) + (1/2)*A(x)*A(x^2)/((1-A(x))*(1-A(x^2))) + A(x)^2/(1-A(x))^2, where A(x) = x + (1/2)*A(x)^2 + (1/2)*A(x^2) is the g.f. of A001190.
%e A395661 With n=2, a 3-node gall can be placed at the root, so that a(2)=1.
%e A395661 With n=3, a 3-node gall and a leaf can descend from the root. A 3-node gall can be placed at the root in 2 ways; a 4-node gall can be placed at the root in 2 ways. Hence, a(3)=1+2+2=5.
%t A395661 terms = 30;
%t A395661 A[_] = 0;
%t A395661 B[_] = 0;
%t A395661 Do[A[x_] =
%t A395661   x + (1/2)*A[x]^2 + (1/2)*A[x^2] + O[x]^terms //
%t A395661    Normal, terms]; CoefficientList[A[x], x]
%t A395661 Do[B[x_] =
%t A395661   A[x]^3/(2 (1 - A[x])^3) + (1/2)*
%t A395661      A[x] A[x^2]/((1 - A[x]) (1 - A[x^2])) + A[x]^2/(1 - A[x])^2 +
%t A395661     O[x]^terms // Normal, terms]; CoefficientList[B[x], x]
%Y A395661 Cf. A001190.
%Y A395661 Cf. A396352 (number of rooted binary unlabeled general galled trees with n leaves and no restriction on the number of galls), A397580 (number of rooted binary leaf-labeled general galled trees with n leaves and exactly one gall).
%K A395661 nonn,new
%O A395661 0,4
%A A395661 _Noah A Rosenberg_, Jul 28 2026
