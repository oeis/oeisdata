%S A395724 1,1,4,35,544,13201,461272,21937691,1362723584,107134506433,
%T A395724 10398385705304,1221202917278651,170681662421757760,
%U A395724 27996910407216841585,5326019075274161603952,1163112637091924222364035,289000289821870467343202304,81064864236242987090786644225
%N A395724 a(0) = 1; a(n) = Sum_{k=0..floor((n-1)/2)} (-1)^k * binomial(n,2*k+1)^2 * a(n-2*k-1).
%H A395724 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/KelvinFunctions.html">Kelvin Functions</a>.
%F A395724 Sum_{n>=0} a(n) * x^n / n!^2 = 1 / (1 - bei_0(2*sqrt(x))), where bei_() is the Kelvin bei function.
%F A395724 a(n) ~ sqrt(2) * n!^2 / (r^(n + 1/2) * (KelvinBei(1, 2*sqrt(r)) - KelvinBer(1, 2*sqrt(r)))), where r = 1.0302994342299882834644136448981764013037524597794697911... is the root of the equation KelvinBei(0, 2*sqrt(r)) = 1. - _Vaclav Kotesovec_, Sep 11 2026
%t A395724 a[0] = 1; a[n_] := a[n] = Sum[(-1)^k Binomial[n, 2 k + 1]^2 a[n - 2 k - 1], {k, 0, Floor[(n - 1)/2]}]; Table[a[n], {n, 0, 17}]
%t A395724 (* Alternative: *)
%t A395724 nmax = 17; CoefficientList[Series[1/(1 - KelvinBei[0, 2 Sqrt[x]]), {x, 0, nmax}], x] Range[0, nmax]!^2
