%S A395808 0,1,5,22,84,290,922,2773,7922,21752,57757,148822,373764,917421,
%T A395808 2206010,5205610,12077419,27581384,62081765,137855596,302279900,
%U A395808 655000711,1403595863,2976256364,6248580160,12995465941,26786055956,54741175090,110963565488,223183620040
%N A395808 Number of factorizations of (p*q)^n into parts greater than 1 that contain at least one mixed factor (a part divisible by both p and q), where p and q are distinct primes.
%C A395808 This sequence quantifies the "super-multiplicativity defect" for the multiplicative partition function A001055.
%C A395808 For coprime integers A and B, the strict inequality mP(A*B) > mP(A)*mP(B) arises because the product introduces "mixed" factorizations (where a single part contains prime factors from both A and B). This sequence gives exactly the number of these mixed factorizations for the case A = p^n and B = q^n.
%C A395808 The number of factorizations depends only on the prime exponents (n, n) and is independent of the choice of distinct primes p and q.
%C A395808 Equivalently, a(n) is the number of two-column nonnegative integer matrices with column sums equal to n and row sums > 0, up to permutation of rows, that contain at least one row with strictly positive entries in both columns.
%F A395808 a(n) = A002774(n) - A000041(n)^2.
%F A395808 a(n) = [x^n y^n] G(x,y) - ([x^n] P(x))^2, where G(x,y) = Product_{i>=0, j>=0, i+j>0} 1 / (1 - x^i * y^j) and P(x) = Product_{i>=1} 1 / (1 - x^i).
%e A395808 a(1) = 1: For (p*q)^1 = p*q (e.g., 6). The factorizations into parts > 1 are {p*q} and {p, q}. The only one containing a mixed factor (divisible by both p and q) is {p*q}, so a(1) = 1.
%e A395808 a(2) = 5: For (p*q)^2 = p^2*q^2 (e.g., 36). The total number of factorizations is A002774(2) = 9. The pure factorizations (using only parts from {p, p^2, q, q^2}) are {p^2, q^2}, {p, p, q^2}, {p^2, q, q}, and {p, p, q, q}. The remaining 5 factorizations contain at least one mixed part (like p*q or p^2*q). Thus a(2) = 5.
%o A395808 (Python)
%o A395808 import numpy as np
%o A395808 def lista(n):
%o A395808     allowed = [(i, j) for i in range(n + 1) for j in range(n + 1) if (i, j) != (0, 0)]
%o A395808     dp = np.zeros((n + 1, n + 1), dtype=object)
%o A395808     dp[0, 0] = 1
%o A395808     for vec_i, vec_j in allowed:
%o A395808         for x in range(vec_i, n + 1):
%o A395808             for y in range(vec_j, n + 1):
%o A395808                 dp[x, y] += dp[x - vec_i, y - vec_j]
%o A395808     p = [1] + [0] * n
%o A395808     for i in range(1, n + 1):
%o A395808         for x in range(i, n + 1):
%o A395808             p[x] += p[x - i]
%o A395808     return [int(dp[k, k]) - p[k]**2 for k in range(n + 1)]
%o A395808 print(lista(29))
%Y A395808 Cf. A001055, A002774, A000041, A397646.
%K A395808 nonn,easy,new
%O A395808 0,3
