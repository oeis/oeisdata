%S A395768 1,2,4,4,4,8,8,8,12,8,12,16,12,16,16,16,16,24,20,16,32,24,24,32,20,24,
%T A395768 36,32,28,32,32,32,48,32,32,48,36,40,48,32,40,64,44,48,48,48,48,64,56,
%U A395768 40,64,48,52,72,48,64,80,56,60,64,60,64,96,64,48,96,68,64,96,64
%N A395768 The twisted Euler phi-function for the Dirichlet character kronecker(-4,.) mod 4.
%C A395768 For n > 1, we have h(-4*n^2), the class number of the order of Z[i] with discriminant -4*n^2, is equal to (1/2)*a(n).
%C A395768 In general, let d < 0 be a fundamental discriminant and n be a positive integer such that d*n^2 < -4, then h(d*n^2) = L(0,kronecker(d,.)) * n * Product_{p|n, p prime} (1 - kronecker(d,p)/p). This is a combination of Theorem 7.24 in "Primes of the form x^2+ny^2" by Cox and the Dirichlet class number formula. Here L(0,kronecker(-4,.)) = 1/2.
%D A395768 D. A. Cox, Primes of the form x^2+ny^2, Wiley, New York, 1989, p. 146.
%H A395768 Jianing Song, <a href="/A395768/b395768.txt">Table of n, a(n) for n = 1..10000</a>
%F A395768 Multiplicative with a(2^e) = 2^e, a(p^e) = p^(e-1)*(p-1) if p == 1 (mod 4) and a(p^e) = p^(e-1)*(p+1) if p == 3 (mod 4).
%F A395768 a(n) = Sum_{d | n, d odd} (-1)^((d-1)/2) * moebius(d) * (n/d) (Dirichlet convolution f * id, where id(n) = n is a multiplicative function and f(n) = (-1)^((n-1)/2) * moebius(n) for n odd else 0 is also a multiplicative function). Cf. phi(n) = Sum_{d | n} moebius(d) * (n/d). - _Peter Bala_, Sep 13 2026
%e A395768 Given L(0,kronecker(-4,.)) = 1/2, we have: h(-4*2^2) = (1/2)*a(2) = 1, h(-4*3^2) = (1/2)*a(3) = 2, h(-4*4^2) = (1/2)*a(4) = 2, ...
%p A395768 with(numtheory):
%p A395768 a := n -> add((-1)^((d-1)/2)*mobius(d)*(n/d), d in select(type, divisors(n), odd)):
%p A395768 seq(a(n), n = 1..70); # _Peter Bala_, Sep 13 2026
%t A395768 f[p_, e_] := p^(e-1)*(p - KroneckerSymbol[-4, p]); a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 100] (* _Amiram Eldar_, May 07 2026 *)
%o A395768 (PARI) a(n,{d=-4}) = my(f=factor(n)[,1]~, w=#f); n * prod(i=1, w, 1 - kronecker(d,f[i])/f[i])
%Y A395768 A101455 is the corresponding Dirichlet character.
%Y A395768 Cf. for fundamental discriminants -3..-24: A227128, this sequence, A395771, A395769, A395772, A395773, A395774, A395775, A395776, A395777.
%Y A395768 Cf. A000010.
