%S A395050 1,2,4,6,8,16,12,32,64,24,30,128,36,256,48,512,1024,60,72,96,2048,
%T A395050 4096,192,8192,144,16384,120,210,216,384,32768,65536,180,288,768,
%U A395050 131072,262144,240,432,1536,524288,576,1048576,3072,2097152,4194304,360,420,480,864,1152,6144,8388608,1296,16777216
%N A395050 Irregular triangle read by rows: Row n lists terms in A025487 that have n divisors.
%C A395050 There are A001055(n) terms in the n-th row of the table.
%C A395050 n-th row starts at A005179(n) and ends at 2^(n-1).
%H A395050 David A. Corneth, <a href="/A395050/b395050.txt">Table of n, a(n) for n = 1..10003</a> (first 181 terms from Zhicheng Wei, first 1275 rows)
%e A395050 Row 8 has 3 terms: 24, 30, 128. Because there are 3 distinct prime signatures for 8 divisors, and also A001055(8) = 3.
%e A395050 Irregular triangle begins:
%e A395050    1  1
%e A395050    2  2
%e A395050    3  4
%e A395050    4  6 8
%e A395050    5  16
%e A395050    6  12 32
%e A395050    7  64
%e A395050    8  24 30 128
%e A395050    9  36 256
%e A395050   10  48 512
%e A395050   11  1024
%e A395050   12  60 72 96 2048
%e A395050   ...
%o A395050 (PARI)
%o A395050 isA025487(n)=my(k=valuation(n, 2), t); n>>=k; forprime(p=3, default(primelimit), t=valuation(n, p); if(t>k, return(0), k=t); if(k, n/=p^k, return(n==1)))
%o A395050 (prodR(n, maxf)=my(dfs=divisors(n), a=[], r); for(i=2, #dfs, if( dfs[i]<=maxf, if(dfs[i]==n, a=concat(a, [[n]]), r=prodR(n/dfs[i], min(dfs[i], maxf)); for(j=1, #r, a=concat(a, [concat(dfs[i], r[j])]))))); a); A005179(n)=my(pf=prodR(n, n), a=1, b); for(i=1, #pf, b=prod(j=1, length(pf[i]), prime(j)^(pf[i][j]-1)); if(b<a || i==1, a=b)); a
%o A395050 row(t)=for(n=A005179(t),2^(t-1),isA025487(n)&numdiv(n)==t&print1(n","))
%Y A395050 Cf. A001055, A005179, A025487, A033833.
%K A395050 nonn,tabf,new
%O A395050 1,2
%A A395050 _Zhicheng Wei_, Sep 08 2026
