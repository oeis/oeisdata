%S A395541 1,2,3,16384,256,16,7,7776,9,10,216,12,216,14,15,16,17,18,25,20,21,22,
%T A395541 20736,24,81,20736,27,28,64,30,31,32,33,34,104976,36,37,38,39,40,49,
%U A395541 42,43,44,45,46,7962624,48,49,50,51,52,53,54,64,56,57,58,59,60,8000,256,63,64
%N A395541 Largest integer of the form r^k whose product of nonzero base-n digits is r and whose number of base-n digits is k.
%C A395541 Let P_n(m) denote the product of the nonzero digits of m written in base n. For n = 10, P_10 is the function of A051801. This sequence gives the largest integer of the form r^k such that P_n(r^k)=r and r^k has exactly k digits in base n.
%C A395541 The condition that r^k has exactly k base-n digits guarantees that only finitely many exponents k need be considered for each base.
%C A395541 This sequence is analogous to A396781 and A397879, where the defining digit functions are the digital root and alternating digital root, respectively.
%e A395541 For base n=5, the admissible pairs are (1,1), (2,1), (3,1), (4,1), and (4,7). Hence a(5)=4^7=16384.
%e A395541 For base n=8, the maximum is 7^1=7.
%e A395541 For base n=9, the maximum is 6^5=7776.
%e A395541 For base n=24, the maximum is 12^4=20736.
%e A395541 For base n=48, the maximum is 18^6=7962624.
%o A395541 (Python)
%o A395541 def non_zero_digit_product(n, b):
%o A395541     if n == 0:
%o A395541         return 0
%o A395541     p = 1
%o A395541     while n:
%o A395541         d = n % b
%o A395541         if d:
%o A395541             p *= d
%o A395541         n //= b
%o A395541     return p
%o A395541 import numpy as np
%o A395541 def num_digits(n, b):
%o A395541     if n == 0:
%o A395541         return 1
%o A395541     c = 0
%o A395541     while n:
%o A395541         c += 1
%o A395541         n //= b
%o A395541     return c
%o A395541 def largest_rk(b, digit_function):
%o A395541     best = -1
%o A395541     for r in range(1, b):
%o A395541         if r == 1:
%o A395541             k_max = 1
%o A395541         else:
%o A395541             k_max = int(np.floor(1/(1-np.log(r)/np.log(b))))
%o A395541         for k in range(1, k_max+1):
%o A395541             value = r**k
%o A395541             if num_digits(value, b) != k:
%o A395541                 continue
%o A395541             if digit_function(value, b) == r:
%o A395541                 if value > best:
%o A395541                     best = value
%o A395541     return best
%o A395541 def sequence(max_base, digit_function):
%o A395541     return [largest_rk(b, digit_function)
%o A395541             for b in range(2, max_base+1)]
%o A395541 print(sequence(65, non_zero_digit_product))
%Y A395541 Cf. A051801, A396781, A397879.
