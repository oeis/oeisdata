%S A395555 1,2,3,4,6,8,9,10,5,12,14,7,15,16,18,20,21,22,11,24,26,13,27,28,30,25,
%T A395555 32,33,34,17,36,38,19,39,40,35,42,44,45,46,23,48,50,51,52,54,56,49,57,
%U A395555 58,29,60,55,62,31,64,66,63,68,69,70,65,72,74,37,75,76,78,80
%N A395555 a(n) = n for n<=3, then a(n) = smallest number not already used which shares a factor with a(n-1) or a(n-2) or a(n-3).
%H A395555 Michael S. Branicky, <a href="/A395555/b395555.txt">Table of n, a(n) for n = 1..10000</a>
%o A395555 (Python)
%o A395555 from sympy import divisors
%o A395555 a = [1, 2, 3]
%o A395555 for n in range(4, 100):
%o A395555     d1 = sorted(divisors(a[-1]))[1:]
%o A395555     d2 = sorted(divisors(a[-2]))[1:]
%o A395555     d3 = sorted(divisors(a[-3]))[1:]
%o A395555     k = 1
%o A395555     while (k in a) or ((not any(k % p == 0 for p in d1)) and (not any(k % p == 0 for p in d2)) and (not any(k % p == 0 for p in d3))): k += 1
%o A395555     a.append(k)
%o A395555 print(a)
%o A395555 (Python)
%o A395555 from math import gcd, lcm
%o A395555 from itertools import count, islice
%o A395555 def agen(): # generator of terms
%o A395555     an1, an2, an3, aset, m = 3, 2, 1, {1, 2}, 4
%o A395555     yield from [1, 2]
%o A395555     while True:
%o A395555         yield an1
%o A395555         aset.add(an1)
%o A395555         L = lcm(an1, an2, an3)
%o A395555         an3, an2, an1 = an2, an1, next(k for k in count(m) if k not in aset and gcd(L, k) > 1)
%o A395555         while m in aset: m += 1
%o A395555 print(list(islice(agen(), 69))) # _Michael S. Branicky_, Jul 23 2026
