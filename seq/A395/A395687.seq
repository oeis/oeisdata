%T A395687 1170,1478,1862,2319,2897,3591,4436,5457,6699,8181,9982,12127,14701,
%U A395687 17777,21434,25787,30965,37096,44339,52902,62997,74880,88846,105242,124435
%N A395687 Number of partitions of n that can be reduced to a single part by repeatedly replacing two parts x and y with |x - y| >= 3 by their sum x + y.
%C A395687 Equivalently, the number of partitions of n generated by recursively splitting n into two parts (a,b) with a + b = n and |a - b| >= 3.
%C A395687 This is the k=3 member of the family in A397939 (k=2). Unlike k=1 and k=2, no closed form is known: the partitions with at least two parts and no legal move (all parts differing pairwise by at most 2) number (n-1) + binomial(floor(n/2),2), but there are additionally "traps" - partitions all of whose legal moves lead only to non-reducible partitions - and for k=3 some traps lead to other traps (e.g. [1,1,4,4] for n=10, whose only move gives [1,4,5], itself a trap), so the set of non-reducible partitions is a fixed point of a recursion rather than an explicit family.
%H A395687 Sean A. Irvine, <a href="/A395687/b395687.txt">Table of n, a(n) for n = 0..80</a>
%H A395687 Damian Velázquez López, <a href="https://doi.org/10.5281/zenodo.21383079">La familia delta*_k(N) de particiones simétricas restringidas</a>, Zenodo, 2026.
%e A395687 For n = 7, a(7) = 6: the reducible partitions are [7], [1,6], [2,5], [1,1,5], [1,2,4], [1,1,1,4]. The other 9 partitions of 7 cannot be reduced with the rule |x - y| >= 3.
%o A395687 (Python)
%o A395687 from itertools import combinations
%o A395687 from sympy.utilities.iterables import partitions
%o A395687 def a(n):
%o A395687     def reach(lam, k=3):
%o A395687         lam = tuple(sorted(lam)); seen=set(); st=[lam]
%o A395687         while st:
%o A395687             c = st.pop()
%o A395687             if len(c)==1: return True
%o A395687             if c in seen: continue
%o A395687             seen.add(c)
%o A395687             for i,j in combinations(range(len(c)),2):
%o A395687                 if abs(c[i]-c[j])>=k:
%o A395687                     r=[c[m] for m in range(len(c)) if m not in (i,j)]
%o A395687                     st.append(tuple(sorted(r+[c[i]+c[j]])))
%o A395687         return False
%o A395687     if n==0: return 0
%o A395687     return sum(reach(sum(([d]*m for d,m in p.items()),[])) for p in partitions(n))
%Y A395687 Cf. A000041, A397939.
%K A395687 nonn
%O A395687 0,6
