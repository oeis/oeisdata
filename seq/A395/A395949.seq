%I A395949 #78 Sep 09 2026 21:59:39
%S A395949 257,2237,20327,20507,22037,22307,23027,27211,32027,33713,35311,37313,
%T A395949 37717,50207,55313,55717,57719,72211,77317,200237,203207,220307,
%U A395949 222511,222713,223007,227011,232007,250007,253717,255517,257519,272011,273517,273719,303713
%N A395949 Primes p that are a concatenation of a number B whose nonzero digits are prime and a prime number C that is the sum of the digits of B.
%C A395949 All prime numbers p = B || C, where || is concatenation of base-10 digits, such that all the nonzero digits of B are prime, C is the digit sum of B and C is prime.
%H A395949 Daniel Mondot, <a href="/A395949/b395949.txt">Table of n, a(n) for n = 1..10926</a> (all terms under 2^32)
%e A395949 257 is a term since 257 = 25 || 7, where all digits of 25 are prime, the digit sum is 2 + 5 = 7, and 7 is prime.
%e A395949 20507 is a term since 20507 = 2050 || 7, where 2050 has only prime nonzero digits, the digit sum is 2 + 0 + 5 + 0 = 7, and 7 is prime.
%t A395949 ilimit = 30000;
%t A395949 allow = {0, 2, 3, 5, 7};
%t A395949 list = {};
%t A395949 For[i = 1, i <= ilimit, i++,
%t A395949   a = Prime[i];
%t A395949   d = IntegerDigits[a];
%t A395949   If[! MemberQ[allow, d[[1]]], Continue[]];
%t A395949   l = Length[d];
%t A395949   If[l == 1, Continue[]];
%t A395949   For[j = 1, j < l, j++,
%t A395949    b = Take[d, l - j];
%t A395949    c = Take[d, -j];
%t A395949    If[! SubsetQ[allow, b], Continue[]];
%t A395949    intc = FromDigits[c];
%t A395949    If[Total[b] != intc, Continue[]];
%t A395949    If[! PrimeQ[intc], Continue[]];
%t A395949    AppendTo[list, a];
%t A395949    Break[];
%t A395949    ];
%t A395949   ];
%t A395949 list
%t A395949 (* _Robert Price_, Aug 31 2026 *)
%Y A395949 Subsequence of the intersection of A000040 and A108773.
%K A395949 base,nonn,new
%O A395949 1,1
%A A395949 _Daniel Crespo_, Aug 30 2026
