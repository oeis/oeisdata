%T A395912 4039929218727936,6068093820594028544,17593771033428718780416,
%U A395912 104526282003690514118868992,1203370858255764710539873222656,28434373779708072411596876901515264,1304531009029808679325367154103881302016
%N A395912 Numbers of real-algebra involutions of the multicomplex numbers that map each element of its canonical monomial basis to a signed monomial.
%H A395912 N. Doyon, P.-O. Parisé, and W. Verreault, <a href="https://arxiv.org/abs/2211.13875">Classes of Holomorphic Multicomplex-Valued Functions Generated by Elliptic-Admissible Involutions</a>, arXiv:2211.13875 [math.RA], 2022-2026.
%F A395912 a(n) = Sum_{k=ceiling(n/2)..n} (Product_{j=1..k-1} (2^n - 2^j)/(2^k - 2^j)) * (Product_{j=0..n-k-1} (2^k - 2^j)) * 2^k.
%t A395912 a[n_]:=Sum[Product[(2^n - 2^j)/(2^k - 2^j),{j,k-1}]*Product[2^k - 2^j,{j,0,n-k-1}]*2^k,{k,Ceiling[n/2],n}]; Array[a,17,0] (* _Stefano Spezia_, Aug 12 2026 *)
%o A395912 (PARI) a(n) = sum(k=ceil(n/2), n, prod(j=1, k-1, (2^n - 2^j)/(2^k - 2^j)) * prod(j=0, n-k-1, (2^k - 2^j)) * 2^k); \\ _Michel Marcus_, Aug 13 2026
