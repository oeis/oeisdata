%N A395812 Positions of records in A001822.
%C A395812 Numbers k such that k has more divisors == 2 (mod 3) than any smaller positive integer.
%e A395812 a(1) = 1 has no divisors == 2 (mod 3).
%e A395812 a(2) = 2 has one divisor == 2 (mod 3), namely 2.
%e A395812 a(3) = 8 has two divisors == 2 (mod 3), namely 2 and 8.
%e A395812 a(4) = 20 has three divisors == 2 (mod 3), namely 2, 5 and 20.
%p A395812 f:= n -> nops(select(t -> t mod 3 = 2, NumberTheory:-Divisors(n))):
%p A395812 R:= 1: m:= 0: count:= 1:
%p A395812 for n from 1 while count < 40 do
%p A395812   v:= f(n);
%p A395812   if v > m then m:= v; R:= R,n; count:= count+1 fi;
%p A395812 od:
%p A395812 R;
%Y A395812 Cf. A001822.
