%I A395152 #34 Aug 12 2026 22:25:36
%S A395152 1,1,1,7,7,5,13,17,21,11,25,31,33,17,41,46,46,25,55,61,45,33,61,73,82,
%T A395152 40,85,93,91,49,106,113,109,37,109,127,133,69,141,145,155,71,157,155,
%U A395152 139,85,169,181,193,97,157,208,201,103,217,225,233,117,241,241
%N A395152 Exponent k such that the largest alternating-digital-root number in base n (A397879) equals r^k.
%C A395152 A397879(n) is always of the form r^k for some 1 <= r <= n-1; this sequence gives the exponent k, and the companion r-sequence gives the base r. Both are finite and well-defined for every n>=2: since A397879(n) has exactly k digits in base n, it forces r<n, so only finitely many (r,k) pairs need be checked. When A397879(n) has maximal root r=n-1, its exponent k cannot exceed A031435(n-1).
%e A395152 a(5) = 7, since A397879(5) = 4^7 = 16384.
%e A395152 a(10) = 21, since A397879(10) = 9^21.
%o A395152 (Python)
%o A395152 from math import floor, log
%o A395152 def digits(n, b):
%o A395152     d = 1
%o A395152     while n >= b:
%o A395152         n //= b
%o A395152         d += 1
%o A395152     return d
%o A395152 def a(n):
%o A395152     best = 1
%o A395152     best_k = 1
%o A395152     for r in range(1, n):
%o A395152         kmax = 1 if r == 1 else floor(1 / (1 - log(r) / log(n)))
%o A395152         for k in range(1, kmax + 1):
%o A395152             x = r ** k
%o A395152             if digits(x, n) == k and x % (n + 1) == r:
%o A395152                 if x > best:
%o A395152                     best = x
%o A395152                     best_k = k
%o A395152     return best_k
%o A395152 print([a(n) for n in range(2, 62)])
%Y A395152 Cf. A397879, A031435.
%K A395152 nonn,base,new
%O A395152 2,4
%A A395152 _Ali Sidheek_, Aug 05 2026
