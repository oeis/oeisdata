%I A395914 #39 Aug 20 2026 15:00:22
%S A395914 1,3,5,13,31,32,114,199,286,665,1109,2803,7021,9861,24185,59577,96014,
%T A395914 141869,300551,926265,1066854,3239797,6481601,12874814,30919091,
%U A395914 35249217,110103729,179919749,456877618,1071992131
%N A395914 a(n) is the smallest k such that 2^(n-1) <= k < 2^n at which |M(k)|/sqrt(k) attains its maximum value in that interval, where M is the Mertens function A002321.
%C A395914 The Riemann Hypothesis is equivalent to M(x) = O(x^(1/2+e)) for every e > 0, where M is A002321, so |M(k)|/sqrt(k) is the natural normalized quantity to study. This is a known theorem, not a claim about this sequence.
%C A395914 The Mertens conjecture asserted |M(x)| < sqrt(x) for all x > 1, which would have implied RH. Odlyzko and te Riele disproved it in 1985, showing that limsup |M(x)|/sqrt(x) exceeds 1. Their disproof is non-constructive; no explicit x with |M(x)| > sqrt(x) is known. This is a known theorem.
%C A395914 The maximum ratio attained on each block is remarkably flat given the above: from n = 13 to n = 26 it stays within roughly [0.35, 0.47], far below the value 1 that is known to eventually be exceeded. This is an empirical observation based on data to k = 10^8.
%C A395914 Global records of the ratio (ignoring the block structure) are degenerate: |M(5)|/sqrt(5) = 0.894427 is the largest value attained anywhere up to k = 10^8, so a sequence built from plain records rather than per-block maxima would have almost no terms. This is an empirical observation based on computation to k = 10^8, not a proved statement about all k.
%H A395914 A. M. Odlyzko and H. J. J. te Riele, <a href="https://www-users.cse.umn.edu/~odlyzko/doc/arch/mertens.disproof.pdf">Disproof of the Mertens conjecture</a>, J. Reine Angew. Math., 357 (1985), 138-160.
%H A395914 Wikipedia, <a href="https://en.wikipedia.org/wiki/Mertens_conjecture">Mertens conjecture</a>.
%e A395914 a(1) = 1: the interval for n=1 is [2^0, 2^1) = {1}, a single point, so the maximum of |M(k)|/sqrt(k) there is trivially attained at k=1, giving a(1) = 1.
%e A395914 a(2) = 3: the interval for n=2 is [2,4) = {2,3}. Here M(2) = mu(1)+mu(2) = 1-1 = 0, giving ratio 0, while M(3) = 0+mu(3) = -1, giving ratio 1/sqrt(3) = 0.577350. The maximum over the block is attained at k=3, so a(2) = 3.
%o A395914 (Python)
%o A395914 import numpy as np
%o A395914 def calc_terms(maxn):
%o A395914     N = 2**maxn
%o A395914     mu = np.ones(N+1, dtype=np.int8)
%o A395914     sieve = np.ones(N+1, dtype=bool); sieve[:2] = False
%o A395914     for i in range(2, int(N**0.5)+1):
%o A395914         if sieve[i]: sieve[i*i::i] = False
%o A395914     for p in np.flatnonzero(sieve):
%o A395914         mu[p::p] = -mu[p::p]
%o A395914         pp = p*p
%o A395914         if pp <= N: mu[pp::pp] = 0
%o A395914     mu[0] = 0; mu[1] = 1
%o A395914     M = np.cumsum(mu[1:N+1].astype(np.int64))
%o A395914     out = []
%o A395914     for n in range(1, maxn+1):
%o A395914         lo = 2**(n-1); hi = 2**n
%o A395914         ks = np.arange(lo, hi, dtype=np.int64)
%o A395914         Mv = M[lo-1:hi-1]
%o A395914         best_num = None; best_den = None; best_k = None
%o A395914         for k, Mk in zip(ks, Mv):
%o A395914             num = int(Mk)**2; den = int(k)
%o A395914             if best_num is None or num*best_den > best_num*den:
%o A395914                 best_num, best_den, best_k = num, den, int(k)
%o A395914         out.append(best_k)
%o A395914     return out
%o A395914 print(calc_terms(15))
%Y A395914 Cf. A002321, A008683.
%K A395914 nonn,more,new
