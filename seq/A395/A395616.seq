%I A395616 #35 Aug 02 2026 23:43:25
%S A395616 1,1,2,16,1936,66615032
%N A395616 Number of cyclic permutations sigma of Z/2^n such that sigma(i+1) is in {2*sigma(i), 2*sigma(i)+1} for all i in Z/2^n.
%C A395616 Conjecture: a(n) > 0 for all n >= 1. Verified computationally by finding an explicit witness for n <= 24.
%C A395616 Also equal to the number of binary strings of length 2^n where reading the length-n substrings (indexed modulo 2^n) as n-bit integers gives a cyclic permutation of Z/2^n in one-line notation. These binary strings are necessarily de Bruijn sequences.
%C A395616 There are A016031(n) binary de Bruijn sequences of order n, each having 2^n rotations, and each rotation gives one candidate permutation, so a(n) <= 2^n*A016031(n). The fraction of permutations of 2^n elements which are cyclic is 1/2^n, so if the candidates had pseudorandom cycle structure, the expected number of solutions would be A016031(n). Conjecture: a(n)/A016031(n) -> 1 as n -> infinity.
%e A395616 For n = 3 the a(3) = 2 solutions are sigma_1 = (2, 5, 3, 7, 6, 4, 0, 1) (de Bruijn sequence 01011100) and sigma_2 = (1, 3, 7, 6, 5, 2, 4, 0) (de Bruijn sequence 00111010), with permutations specified in zero-indexed one-line notation. For example, sigma_1(i) is the length-3 substring of 01011100 starting at position i, read as a 3-bit integer: 010 = 2, 101 = 5, 011 = 3, 111 = 7, 110 = 6, 100 = 4, 000 = 0, 001 = 1 (the last two substrings wrap around). Both sigma_1 and sigma_2 are cyclic permutations (i.e., they consist of a single cycle of length 2^n).
%o A395616 (C)
%o A395616 #define MAXN 6
%o A395616 int M, pi[1<<MAXN], used[1<<MAXN], count;
%o A395616 void dfs(int p) {
%o A395616   if(p+1 < M) {
%o A395616     used[pi[p]] = 1;
%o A395616     if(!used[pi[p+1] = 2*pi[p] % M]) dfs(p + 1);
%o A395616     if(!used[pi[p+1] = (2*pi[p] + 1) % M]) dfs(p + 1);
%o A395616     used[pi[p]] = 0;
%o A395616   } else {
%o A395616     int len = 0; do { p = pi[p]; len++; } while(p != M-1);
%o A395616     count += len == M;
%o A395616   }
%o A395616 }
%o A395616 int a(int N) {
%o A395616   count = 0;
%o A395616   for(pi[0] = M = 1<<N; pi[0]--;) dfs(0);
%o A395616   return count;
%o A395616 }
%K A395616 nonn,hard,more
%O A395616 1,3
%A A395616 _Noah Weninger_, Timothy Christopher Miller, Bailey Parrish, Jun 28 2026
