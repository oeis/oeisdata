%I A395978 #41 Oct 09 2026 16:26:17
%S A395978 6,15,12,21,45,18,30,63,75,24,35,60,147,135,36,42,175,90,189,225,48,
%T A395978 55,84,245,120,441,375,54,65,275,126,875,150,567,405,72,66,325,605,
%U A395978 168,1225,180,1029,675,96,77,132,845,1375,252,1715,240,1323,1125,108
%N A395978 Square array A(n,k), n, k >= 1, read by ascending antidiagonals, where row n is the ordered set {r*m : rad(m) | r} for squarefree r = A397739(n), where rad = A007947.
%C A395978 This table is an arrangement of A397805, composite numbers j whose 3rd smallest divisor is less than the square of their least prime factor.
%C A395978 Their arrangement is into rows according to their squarefree kernel, rad(j) = A007947(j), so that each row is a row of A284457. Also the column position of j in the row is given by A008479(j), the number of numbers m <= j that share the squarefree kernel. Consequently, the terms in columns 1, 2, 3, ... form subsets of the classes in A005117, A397710, A397742, ... respectively. See A397742 for further information about classifying numbers in this way.
%H A395978 Michael De Vlieger, <a href="/A395978/b395978.txt">Table of n, a(n) for n = 1..11325</a> (rows n = 1..150, flattened.)
%F A395978 A(n,1) = A397739(n).
%F A395978 A(n,2) = A020639(A(n,1)) * A(n,1).
%F A395978 A(n,3) = A119288(A(n,1)) * A(n,1).
%F A395978 A(n,4) = A020639(A(n,1))^2 * A(n,1) or {A(n,1) = A000977(j) for some j and A(n,4) = A400427(j) * A(n,1)}.
%e A395978 Top left corner of table, with n = 1..7 and k = 1..7:
%e A395978   n\k |   1    2    3     4     5     6     7
%e A395978   ----+-------------------------------------------
%e A395978   1   |   6,  12,  18,   24,   36,   48,   54, ...
%e A395978   2   |  15,  45,  75,  135,  225,  375,  405, ...
%e A395978   3   |  21,  63, 147,  189,  441,  567, 1029, ...
%e A395978   4   |  30,  60,  90,  120,  150,  180,  240, ...
%e A395978   5   |  35, 175, 245,  875, 1225, 1715, 4375, ...
%e A395978   6   |  42,  84, 126,  168,  252,  294,  336, ...
%e A395978   7   |  55, 275, 605, 1375, 3025, 6655, 6875, ...
%e A395978 In this table, we have the following rows:
%e A395978   row n=1 is A033845,
%e A395978   row n=2 is A033849,
%e A395978   row n=3 is A033850,
%e A395978   row n=4 is A143207,
%e A395978   row n=5 is A033851, etc.
%t A395978 rad[n_] := Times @@ (First@# & /@ FactorInteger@ n); s = Select[Range[77], And[SquareFreeQ[#], CompositeQ[#]] &]; t = Select[s, Log[#1, #2] < 2 & @@ FactorInteger[#][[1 ;; 2, 1]] &]; A[i_, 1] := t[[i]]; A[i_, 2] := #*FactorInteger[#][[1, 1]] &[t[[i]]]; A[i_, j_] := A[i, j] = Module[{r, k}, r = t[[i]]; k = A[i, j - 1]/r; k++; While[! Divisible[r, rad[k]], k++]; k*r]; Table[A[n - k + 1, k], {n, Length[t]}, {k, n}] // Flatten
%Y A395978 Cf. A007947, A397739 (column 1), A397805 (sorted terms).
%Y A395978 Rows 1..5 are A033845, A033849, A033850, A143207, A033851.
%Y A395978 See the comments for the relationships with A005117, A008479, A284457, A397710, A397742.
%Y A395978 See the formula section for relationships with A000977, A020639, A119288, A400427.
%K A395978 nonn,tabl,new
%O A395978 1,1
