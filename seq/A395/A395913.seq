%I A395913 #57 Sep 06 2026 15:26:13
%S A395913 413,891,2079,2691,2871,4199,4455,20055,21771,23391,40095,43673,60011,
%T A395913 60291,80015,80019,200655,209055,228177,603955,638715,800173,809271,
%U A395913 4046355,6032455,20000015,40073579,60000655,60332415,63973511,200000097,200000535,237735855,400000013,831872511,2000000079
%N A395913 Odd numbers k such that the product (m+n)*p, where m,n are the first and the last digits of k, and p is the number which is the part of k between m and n, is a divisor of k.
%C A395913 Odd terms of A320121.
%C A395913 If k has d digits, p must divide (m*10^(d-1) + n)/gcd(m+n,10).
%C A395913 For any term k = m*10^(d-1) + 10*p + n where (m+n)*p is coprime to 10, let v be the multiplicative order of 10 (mod (m+n)*p). Then m*10^(d-1+j*v) + 10*p + n is a term for all natural numbers j. In particular, the sequence is infinite.
%H A395913 Robert Israel, <a href="/A395913/b395913.txt">Table of n, a(n) for n = 1..3000</a>
%e A395913 a(4) = 2691 is a term because (2+1)*69 = 207 divides 2691 = 207 * 13.
%p A395913 Pairs:= select(t -> t[2] mod igcd(t[1]+t[2], 10) = 0, [seq(seq([m, n], m=1..9), n=1..9,2)]);
%p A395913 Res:= NULL: count:= 0:
%p A395913 for d from 3 to 13 do
%p A395913   for mn in Pairs do
%p A395913     q:= mn[1]*10^(d-1) + mn[2];
%p A395913     ps:= select(t -> t < 10^(d-2) and (q+ 10*t) mod ((mn[1]+mn[2])*t) = 0, NumberTheory:-Divisors(q/igcd(mn[1]+mn[2], 10)));
%p A395913     W:= map(t -> q + 10*t, ps);
%p A395913     if W <> {} then
%p A395913       Res:= Res, op(W); count:= count + nops(W);
%p A395913     fi
%p A395913 od od:
%p A395913 A:= sort([Res]):
%Y A395913 Cf. A320121.
%K A395913 nonn,base,new
%O A395913 1,1
%A A395913 _Robert Israel_, Sep 02 2026
