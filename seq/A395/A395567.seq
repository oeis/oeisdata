%I A395567 #12 Nov 02 2026 15:24:31
%S A395567 2,5,17,29,37,101,109,149,173,197,257,269,401,509,557,577,677,701,773,
%T A395567 1009,1117,1229,1297,1301,1601,1873,1877,1949,1997,2129,2237,2269,
%U A395567 2309,2357,2477,2549,2609,2801,2897,2917,3137,3329,3389,3557,3677,3701,3709,3889
%N A395567 Primes of the form (x^2 + y^2 + z^2) / (x*y + x*z + y*z) with integer x, y, z.
%C A395567 It appears that primes of the form 6*k - 1 are terms about 5 times more often than primes 6*k + 1 are (checked up to 10^7).
%H A395567 Robert Israel, <a href="/A395567/b395567.txt">Table of n, a(n) for n = 1..10000</a>
%e A395567 a(4) = 29 is term since 29 = (1109^2 + 11^2 + 27^2) / (1109*11 + 1109*27 + 11*27).
%e A395567 a(6) = 101 with (x,y,z) = (11321,11,101).
%e A395567 a(7) = 109 with (x,y,z) = (-23,31,103).
%p A395567 filter:= proc(n) local F,t;
%p A395567   if not isprime(n) then return false fi;
%p A395567   F:= ifactors((n-1)*(n+2))[2];
%p A395567   F:= select(s ->s[2]::odd, F)[..,1];
%p A395567   andmap(s -> s mod 3 <> 2,F)
%p A395567 end proc:
%p A395567 select(filter, [2,seq(i,i=3..5000,2)]); # _Robert Israel_, Nov 02 2026
%Y A395567 Intersection of A000040 and A331605.
%K A395567 nonn,changed
%O A395567 1,1
%A A395567 _Michael Shmoish_, Apr 28 2026
