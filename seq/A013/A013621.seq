%N A013621 Triangle of coefficients in expansion of (2+5*x)^n.
%F A013621 G.f.: 1 / (1 - x*(2+5*y)).
%F A013621 From _Ranjan Kumar Dhani_, Sep 08 2026: (Start)
%F A013621 T(n,k) = 5*T(n-1,k-1) + 2*T(n-1,k) with T(0,0)=1, T(n,k)=0 for k<0 or k>n.
%F A013621 T(n,k) = binomial(n,k)*5^k*2^(n - k). (End)
%e A013621 The triangle begins as:
%e A013621    1;
%e A013621    2,    5;
%e A013621    4,   20,    25;
%e A013621    8,   60,   150,   125;
%e A013621   16,  160,   600,  1000,    625;
%e A013621   32,  400,  2000,  5000,   6250,   3125;
%e A013621   64,  960,  6000, 20000,  37500,  37500,  15625;
%e A013621  128, 2240, 16800, 70000, 175000, 262500, 218750, 78125;
%e A013621  ...
%t A013621 Table[Binomial[n, k] 5^k 2^(n - k), {n, 0, 8}, {k, 0, n}] // Flatten (* _Ranjan Kumar Dhani_, Sep 09 2026 *)
%Y A013621 Row sums give A000420.
%Y A013621 Cf. A000079, A000351.
