%I A013625 #32 Sep 08 2026 17:23:23
%S A013625 1,4,7,16,56,49,64,336,588,343,256,1792,4704,5488,2401,1024,8960,
%T A013625 31360,54880,48020,16807,4096,43008,188160,439040,576240,403368,
%U A013625 117649,16384,200704,1053696,3073280,5378240,5647152,3294172,823543
%N A013625 Triangle of coefficients in expansion of (4+7x)^n.
%H A013625 Gábor Kallós, <a href="https://real.mtak.hu/142589/1/AAPASM_24_from11to18.pdf">The generalization of Pascal's triangle from algebraic point of view</a>, Acta Academiae Paedagogicae Agriensis, Sectio Mathematicae, 24. (1997) pp. 11-18. See Fig. 2.
%H A013625 Gábor Kallós, <a href="https://doi.org/10.5802/ambp.211">A generalization of Pascal's triangle using powers of base numbers</a>, Annales mathématiques Blaise Pascal, Volume 13 (2006) no. 1, pp. 1-15. See Figure 2.
%F A013625 G.f.: 1 / (1 - x*(4+7*y)).
%F A013625 From _Ranjan Kumar Dhani_, Sep 06 2026: (Start)
%F A013625 T(n,k) = 7*T(n-1,k-1) + 4*T(n-1,k) with T(0,0)=1, T(n,k)=0 for k<0 or k>n.
%F A013625 T(n,k) = binomial(n,k)*7^k*4^(n - k). (End)
%e A013625 The triangle begins as:
%e A013625     1;
%e A013625     4,    7;
%e A013625    16,   56,    49;
%e A013625    64,  336,   588,   343;
%e A013625   256, 1792,  4704,  5488,  2401;
%e A013625  1024, 8960, 31360, 54880, 48020, 16807;
%e A013625  ...
%t A013625 Table[CoefficientList[Expand[(4+7x)^n],x],{n,0,10}]//Flatten (* _Harvey P. Dale_, May 14 2019 *)
%t A013625 (* Alternative: *)
%t A013625 Table[Binomial[n, k] 7^k 4^(n - k), {n, 0, 8}, {k, 0, n}] // Flatten (* _Ranjan Kumar Dhani_, Sep 06 2026 *)
%Y A013625 Cf. A000302, A000420.
%K A013625 tabl,nonn,easy,changed
%O A013625 0,2
%A A013625 _N. J. A. Sloane_
