%S A013616 1,1,9,1,18,81,1,27,243,729,1,36,486,2916,6561,1,45,810,7290,32805,
%T A013616 59049,1,54,1215,14580,98415,354294,531441,1,63,1701,25515,229635,
%U A013616 1240029,3720087,4782969,1,72,2268,40824,459270,3306744,14880348,38263752,43046721
%N A013616 Triangle of coefficients in expansion of (1+9*x)^n.
%C A013616 T(n,k) equals the number of n-length words on {0,1,...,9} having n-k zeros. - _Milan Janjic_, Jul 24 2015
%F A013616 G.f.: 1 / (1 - x(1+9y)).
%F A013616 From _Mircea Merca_, Apr 28 2012: (Start)
%F A013616 T(n,k) = 9^k*C(n,k).
%F A013616 T(n,k) = Sum_{i=n-k..n} C(i,n-k)*C(n,i)*8^(n-i).
%F A013616 Row sums are 10^n = A011557(n). (End)
%F A013616 From _Ranjan Kumar Dhani_, Aug 14 2026: (Start)
%F A013616 T(n,k) = 9*T(n-1,k-1) + T(n-1,k) with T(0,0)=1, T(n,k)=0 for k<0 or k>n.
%F A013616 T(n,k) = 9*(n+1-k)*T(n,k-1)/k, T(n,0) = 1. (End)
%e A013616 The triangle begins as:
%e A013616   1;
%e A013616   1,  9;
%e A013616   1, 18,  81;
%e A013616   1, 27, 243,  729;
%e A013616   1, 36, 486, 2916,  6561;
%e A013616   1, 45, 810, 7290, 32805, 59049;
%e A013616   ...
%p A013616 T:= n-> (p-> seq(coeff(p, x, k), k=0..n))((1+9*x)^n):
%p A013616 seq(T(n), n=0..10);  # _Alois P. Heinz_, Jun 10 2014
%t A013616 Table[ If [k < 0 || k > n, 0, 9^k Binomial[n, k]], {n, 0, 10}, {k, 0,n}] // Flatten (* _Ranjan Kumar Dhani_, Aug 14 2026 *)
%Y A013616 Cf. A001019, A011557, A007318.
%K A013616 tabl,nonn,easy
%O A013616 0,3
%A A013616 _N. J. A. Sloane_
