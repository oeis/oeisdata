%N A013619 Triangle of coefficients in expansion of (1+12*x)^n.
%C A013619 T(n,k) equals the number of n-length words on {0,1,...,12} having n-k zeros. - _Milan Janjic_, Jul 24 2015
%F A013619 G.f.: 1 / (1 - x*(1+12*y)).
%F A013619 From _Mircea Merca_, Apr 28 2012: (Start)
%F A013619 T(n,k) = 12^k*C(n,k).
%F A013619 T(n,k) = Sum_{i=n-k..n} C(i,n-k)*C(n,i)*11^(n-i).
%F A013619 Row sums are 13^n = A001022. (End)
%F A013619 T(n,k) = 12*T(n-1,k-1) + T(n-1,k) with T(0,0)=1, T(n,k)=0 for k<0 or k>n. - _Ranjan Kumar Dhani_, Aug 21 2026
%e A013619 Triangle begins:
%e A013619   1;
%e A013619   1, 12;
%e A013619   1, 24, 144;
%e A013619   1, 36, 432, 1728;
%e A013619   1, 48, 864, 6912, 20736;
%e A013619   1, 60, 1440, 17280, 103680, 248832;
%e A013619   1, 72, 2160, 34560, 311040, 1492992, 2985984;
%e A013619   1, 84, 3024, 60480, 725760, 5225472, 20901888, 35831808;
%e A013619   ...
%p A013619 T:= n-> (p-> seq(coeff(p, x, k), k=0..n))((1+12*x)^n):
%p A013619 seq(T(n), n=0..10);  # _Alois P. Heinz_, Jul 24 2015
%t A013619 Flatten[Table[CoefficientList[(1+12x)^n,x],{n,0,10}]] (* _Harvey P. Dale_, Oct 18 2015 *)
%Y A013619 Cf. A001021, A001022.
%K A013619 tabl,nonn,easy,changed
%O A013619 0,3
%A A013619 _N. J. A. Sloane_
