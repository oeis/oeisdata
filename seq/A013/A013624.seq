%N A013624 Triangle of coefficients in expansion of (3+7x)^n.
%F A013624 G.f.: 1 / (1 - x*(3+7y)).
%F A013624 From _Ranjan Kumar Dhani_, Sep 06 2026: (Start)
%F A013624 T(n,k) = 7*T(n-1,k-1) + 3*T(n-1,k) with T(0,0)=1, T(n,k)=0 for k<0 or k>n.
%F A013624 T(n,k) = binomial(n,k)*7^k*3^(n - k). (End)
%e A013624 The triangle begins as:
%e A013624    1;
%e A013624    3,     7;
%e A013624    9,    42,    49;
%e A013624   27,   189,   441,    343;
%e A013624   81,   756,  2646,   4116,   2401;
%e A013624  243,  2835, 13230,  30870,  36015,  16807;
%e A013624  729, 10206, 59535, 185220, 324135, 302526, 117649;
%e A013624  ...
%t A013624 Table[Binomial[n, k] 7^k 3^(n - k), {n, 0, 8}, {k, 0, n}] // Flatten (* _Ranjan Kumar Dhani_, Sep 06 2026 *)
