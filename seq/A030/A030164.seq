%I A030164 #22 Oct 04 2026 09:51:53
%S A030164 1,2,3,6,7,8,14,24,31,56,62,127,128,248,254,384,720,896,1016,3968,
%T A030164 8191,16256,16382,32768,65528,98304,103680,131071,229376,262142,
%U A030164 524287,1015808,1048448,1048568,1048574,4161536,4194296,16777088,29719872,50181120
%N A030164 Numbers k such that uphi(sigma(k)) = k, where uphi is the unitary phi function (A047994).
%C A030164 Fixed points of the function uphi(sigma(n)) = 1, 2, 3, 6, 2, 6, 7, 8, 12, 8, 6, 18, 6, 14, 14, 30, 8, 24, 12,.. (Note that this list of numbers contains uphi(sigma(n)), n >= 1, not the fixed points a(n)).
%C A030164 Contains also 50181120 and 2147483648.
%H A030164 Donovan Johnson, <a href="/A030164/b030164.txt">Table of n, a(n) for n = 1..51</a> (terms < 10^11)
%t A030164 uphi[n_] := Times @@ (-1 + Power @@@ FactorInteger[n]); uphi[1] = 1;
%t A030164 q[k_] := uphi[DivisorSigma[1, k]] == k; Select[Range[600000], q] (* _Amiram Eldar_, Oct 04 2026 *)
%o A030164 (PARI) uphi(n) = {my(f = factor(n)); prod(i = 1, #f~, f[i, 1]^f[i, 2]-1);}
%o A030164 isok(k) = uphi(sigma(k)) == k; \\ _Amiram Eldar_, Oct 04 2026
%Y A030164 Cf. A000203, A030165, A047994.
%K A030164 nonn,changed
%O A030164 1,2
%A A030164 _Yasutoshi Kohmoto_
