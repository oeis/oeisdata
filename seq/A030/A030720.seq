%S A030720 1,3,6,11,16,20,25,36,44,52,45,74,192,73,53,103,86,63,121,75,636,951,
%T A030720 88,1023,104,164,122,815,142,120,165,248,949,950,190,1021,1022,140,
%U A030720 218,948
%N A030720 a(n) is the least k such that s(k) = n, where s = A030717.
%C A030720 a(41) > 10^11 if it exists (see a-file for all terms n=1..10000 with a(n) <= 10^11). - _Michael S. Branicky_, Sep 14 2026
%H A030720 Michael S. Branicky, <a href="/A030720/a030720.txt">Table of n, a(n) for n=1..10000 else -1 if a(n) > 10^11</a>
%o A030720 (Python) # uses code/imports from A030717
%o A030720 def agen(): # generator of terms
%o A030720     adict, n = dict(), 1
%o A030720     for k, sk in enumerate(A030717_gen(), 1):
%o A030720         if sk not in adict:
%o A030720             adict[sk] = k
%o A030720             while n in adict:
%o A030720                 yield adict[n]
%o A030720                 n += 1
%o A030720 print(list(islice(agen(), 40))) # _Michael S. Branicky_, Sep 14 2026
%K A030720 nonn,more,changed
%O A030720 1,2
