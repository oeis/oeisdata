%I A007709 M1608 #37 Nov 09 2026 22:34:26
%S A007709 1,1,2,6,15,84,330,1812,9978,65503,449719,3674670,28886593,266242729,
%T A007709 2527701273,25749021720
%N A007709 Number of winning (or reformed) decks with n cards at Mousetrap.
%D A007709 A. M. Bersani, "Reformed permutations in Mousetrap and its generalizations," Preprint Me.Mo.Mat. n. 15/2005.
%D A007709 R. K. Guy, Unsolved Problems Number Theory, E37.
%D A007709 R. K. Guy and R. J. Nowakowski, "Mousetrap," in D. Miklos, V. T. Sos and T. Szonyi, eds., Combinatorics, Paul Erdős is Eighty. Bolyai Society Math. Studies, Vol. 1, pp. 193-206, 1993.
%D A007709 N. J. A. Sloane and Simon Plouffe, The Encyclopedia of Integer Sequences, Academic Press, 1995 (includes this sequence).
%H A007709 A. M. Bersani, <a href="https://www.sbai.uniroma1.it/~alberto.bersani/mousetrap.html">On the game Mousetrap</a>.
%H A007709 Edward Faulkner, <a href="https://wp.technologyreview.com/wp-content/uploads/2026/10/MIT-Alumni-News-Puzzle-Corner-November-December2026.pdf">Puzzle Corner: Problem N/D3</a>, MIT Technology Review, November/December 2026
%H A007709 R. K. Guy and R. J. Nowakowski, <a href="/A002467/a002467_1.pdf">Mousetrap</a>, Preprint, Feb 10 1993 [Annotated scanned copy]
%H A007709 R. K. Guy and R. J. Nowakowski, <a href="https://www.jstor.org/stable/2975171">Mousetrap</a> Amer. Math. Monthly, 101 (1994), 1007-1010.
%H A007709 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Mousetrap.html">Mousetrap</a>.
%t A007709 mouseCompiled = Compile[{{deck, _Integer, 1}},
%t A007709 Module[{cur = deck, count = 1, n = Length[deck], res = -1},
%t A007709 While[res < 0,If[First[cur] == count, cur = Rest[cur];
%t A007709   If[Length[cur] == 0, res = 1, count = 1],cur = RotateLeft[cur];
%t A007709   If[count == n, res = 0, count++]]]; res],RuntimeAttributes -> {Listable} ];
%t A007709 Total[mouseCompiled[Permutations[Range[#]]]] & /@ Range@10  (* _David Dewan_, Oct 26 2026 *)
%Y A007709 Cf. A007710, A007711, A007712, A055459, A067950.
%K A007709 nonn,changed
