%F A183883 From _Mikhail Smirnov_, Nov 08 2026: (Start)
%F A183883 a(n) = 9^(n+2) - (70*n^2 + 786*n + 2076)*4^n + (11*n^3 + 753*n^2 + 5782*n + 12420)*3^(n-1) + (9*n^4 + 78*n^3 - 219*n^2 - 2700*n - 5268)*2^(n-1) - (3*n^5 + 57*n^4 + 245*n^3 + 373*n^2 - 8*n - 438) for n >= 4.
%F A183883 G.f.: x * (1 - 18*x + 1347*x^2 + 8130*x^3 - 480960*x^4 + 4958430*x^5 - 23919752*x^6 + 68752542*x^7 - 269443245*x^8 + 1972877412*x^9 - 11063212995*x^10 + 40529360520*x^11 - 101566144364*x^12 + 180832538856*x^13 - 232806962016*x^14 + 216569643264*x^15 - 142259833920*x^16 + 61792649856*x^17 - 14463422208*x^18 - 121347072*x^19 + 984379392*x^20 - 179159040*x^21) / ((1 - x)^6 * (1 - 2*x)^5 * (1 - 3*x)^4 * (1 - 4*x)^3 * (1 - 9*x)). (End)
