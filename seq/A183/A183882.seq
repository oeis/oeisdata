%N A183882 Number of arrangements of n+2 numbers in 0..7 with each number being the sum mod 8 of two others.
%H A183882 R. H. Hardin, <a href="/A183882/b183882.txt">Table of n, a(n) for n = 1..65</a>
%H A183882 <a href="/index/Rec#order_17">Index entries for linear recurrences with constant coefficients</a>, signature (43, -846, 10140, -83070, 494226, -2213128, 7623556, -20460345, 43040235, -70979346, 91259208, -90367936, 67483120, -36706080, 13706496, -3138048, 331776).
%F A183882 From _Mikhail Smirnov_, Nov 05 2026: (Start)
%F A183882 a(n) = 8^(n+2) - (8*n + 43)*4^(n+2) - (16*n^3 + 156*n^2 - 76*n - 2646)*3^(n-1) + (2*n^4 + 63*n^3 + 435*n^2 + 894*n - 128)*2^(n-1) + 7*n^4 - 28*n^3 - 256*n^2 - 496*n - 263 for n >= 4.
%F A183882 G.f.: x * (4 - 137*x + 3865*x^2 - 43521*x^3 + 271665*x^4 - 2060151*x^5 + 21370343*x^6 - 162636691*x^7 + 797440151*x^8 - 2572908276*x^9 + 5477342868*x^10 - 7137782808*x^11 + 3379929696*x^12 + 6742668000*x^13 - 17136867840*x^14 + 19888669824*x^15 - 14226912000*x^16 + 6424344576*x^17 - 1691725824*x^18 + 199065600*x^19) / ((1 - x)^5 * (1 - 2*x)^5 * (1 - 3*x)^4 * (1 - 4*x)^2 * (1 - 8*x)). (End)
