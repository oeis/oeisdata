%N A183891 Number of arrangements of n+3 numbers in 0..8 with each number being the sum mod 9 of three others.
%H A183891 R. H. Hardin, <a href="/A183891/b183891.txt">Table of n, a(n) for n = 1..22</a>
%H A183891 <a href="/index/Rec#order_17">Index entries for linear recurrences with constant coefficients</a>, signature (37, -615, 6159, -41874, 205926, -760606, 2159566, -4778997, 8299617, -11322651, 12074979, -9950248, 6206788, -2832048, 891216, -172800, 15552).
%F A183891 From _Mikhail Smirnov_, Nov 13 2026: (Start)
%F A183891 a(n) = 9^(n+3) - (17*n^2 + 193*n + 522)*3^(n+2) - (17*n^5 + 641*n^4 + 7661*n^3 + 32335*n^2 + 41330*n - 17184)*2^(n-4) - (16*n^6 + 142*n^5 - 95*n^4 - 4054*n^3 - 14569*n^2 - 21112*n - 11024)/2 for n >= 6.
%F A183891 G.f.: x * (1 + 204*x + 73449*x^2 - 416196*x^3 - 8328358*x^4 + 117874270*x^5 - 644748896*x^6 + 1600853306*x^7 + 410000095*x^8 - 16155342678*x^9 + 54581673451*x^10 - 87821335438*x^11 + 26434212094*x^12 + 217004748196*x^13 - 591702709276*x^14 + 879510404064*x^15 - 882058610256*x^16 + 624361211328*x^17 - 310133378880*x^18 + 103458124800*x^19 - 20888098560*x^20 + 1933424640*x^21) / ((1 - x)^7 * (1 - 2*x)^6 * (1 - 3*x)^3 * (1 - 9*x)). (End)
