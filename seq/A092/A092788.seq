%I A092788 #12 Oct 03 2026 08:20:48
%S A092788 1,1,1,1,1,1,2,2,1,2,1,2,2,2,2,2,2
%N A092788 Ratios m/A109712(m) for USUP perfect numbers m (A092760).
%C A092788 USUP stands for UnitarySigmaUnitaryPhi(n) = A109712(n).
%F A092788 a(n) = m/A109712(m) where m = A092760(n). - _R. J. Mathar_, Sep 04 2018
%o A092788 (PARI) list(kmax) = {my(f, r); for(k = 1, kmax, f = factor(k); r = k / prod(i = 1, #f~, if(f[i, 1] == 2, 2^f[i, 2]+1, f[i, 1]^f[i, 2]-1)); if(denominator(r) == 1, print1(r, ", "))); } \\ _Amiram Eldar_, Oct 03 2026
%Y A092788 Cf. A092760, A109712.
%K A092788 nonn,more,changed
%O A092788 1,7
%A A092788 _Yasutoshi Kohmoto_, Apr 14 2004
%E A092788 Adapted to match A092760. - _R. J. Mathar_, Sep 04 2018
