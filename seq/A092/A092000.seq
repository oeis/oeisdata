%N A092000 Numbers that can be expressed as the difference of the squares of primes in exactly four distinct ways.
%H A092000 Robert Israel, <a href="/A092000/b092000.txt">Table of n, a(n) for n = 1..10000</a>
%e A092000 240 = 17^2-7^2 = 19^2-11^2 = 23^2-17^2 = 61^2-59^2
%p A092000 f:= proc(n)
%p A092000    nops(select(d -> d^2 > n and (d-n/d)::even and isprime((d + n/d)/2) and isprime((d - n/d)/2),
%p A092000      NumberTheory:-Divisors(n)))
%p A092000 end proc:
%p A092000 select(f=4, [$1..20000]); # _Robert Israel_, Nov 12 2026
