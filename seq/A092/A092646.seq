%I A092646 #26 Sep 05 2026 23:45:51
%S A092646 0,0,1,15,111,1013,8963,78496,703783,6388533,58446494,538638118,
%T A092646 4993304254
%N A092646 Number of consecutive prime runs of just 4 primes congruent to 3 mod 4 below 10^n.
%C A092646 Generate the prime sequence with primes labeled 1 mod 4 or 3 mod 4. Add count of primes to sequence if just 4 primes occur before interruption by a prime congruent to 1 mod 4.
%H A092646 Carlo Corti, <a href="https://doi.org/10.5281/zenodo.22194072">A092645-A092647: maximal four-prime runs modulo 4</a>, Zenodo archive, 2026.
%e A092646 a(5)=111 because 111 sets of 4 primes occur below 10^5, each run interrupted by a prime congruent to 1 mod 4.
%t A092646 p1 = p3 = 0; p = 15; s = Mod[{2, 3, 5, 7, 11, 13}, 4]; Do[ While[p < 10^n, If[s == {3, 1, 1, 1, 1, 3}, p1++]; If[s == {1, 3, 3, 3, 3, 1}, p3++]; p = NextPrime@ p; s = Join[ Take[s, -5], {Mod[p, 4]}]]; Print[{p1, p3}], {n, 2, 9}] (* _Robert G. Wilson v_, Sep 30 2011 *)
%Y A092646 Cf. A092645, A092647.
%K A092646 more,nonn,changed
%O A092646 1,4
%A A092646 _Enoch Haga_, Mar 02 2004
%E A092646 a(11) from _Chai Wah Wu_, Mar 18 2018
%E A092646 a(12)-a(13) from _Carlo Corti_, Aug 31 2026
