%N A092004 Numbers that can be expressed as the difference of the squares of primes in exactly eight distinct ways.
%H A092004 Robert Israel, <a href="/A092004/b092004.txt">Table of n, a(n) for n = 1..1000</a>
%e A092004 7728 = 97^2-41^2 = 107^2-61^2 = 113^2-71^2 = 173^2-149^2 =
%e A092004 283^2-269^2 = 487^2-479^2 = 647^2-641^2 = 1933^2-1931^2
%p A092004 f:= proc(n)
%p A092004    nops(select(d -> d^2 > n and (d-n/d)::even and isprime((d + n/d)/2) and isprime((d - n/d)/2),
%p A092004      NumberTheory:-Divisors(n)))
%p A092004 end proc:
%p A092004 select(f=8, [$1..200000]); # _Robert Israel_, Nov 12 2026
