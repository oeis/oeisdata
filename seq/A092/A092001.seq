%N A092001 Numbers that can be expressed as the difference of the squares of primes in exactly five distinct ways.
%H A092001 Robert Israel, <a href="/A092001/b092001.txt">Table of n, a(n) for n = 1..5000</a>
%e A092001 1560 = 41^2-11^2 = 43^2-17^2 = 71^2-59^2 = 83^2-73^2 =
%e A092001 197^2-193^2
%p A092001 f:= proc(n)
%p A092001    nops(select(d -> d^2 > n and (d-n/d)::even and isprime((d + n/d)/2) and isprime((d - n/d)/2),
%p A092001      NumberTheory:-Divisors(n)))
%p A092001 end proc:
%p A092001 select(f=5, [$1..40000]); # _Robert Israel_, Nov 12 2026
