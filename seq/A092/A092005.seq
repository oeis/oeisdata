%N A092005 Numbers that can be expressed as the difference of the squares of primes in exactly nine distinct ways.
%H A092005 Robert Israel, <a href="/A092005/b092005.txt">Table of n, a(n) for n = 1..800</a>
%e A092005 9240 = 97^2-13^2 = 101^2-31^2 = 103^2-37^2 = 107^2-47^2 =
%e A092005 127^2-83^2 = 131^2-89^2 = 179^2-151^2 = 467^2-457^2 = 2311^2-2309^2
%p A092005 f:= proc(n)
%p A092005    nops(select(d -> d^2 > n and (d-n/d)::even and isprime((d + n/d)/2) and isprime((d - n/d)/2),
%p A092005      NumberTheory:-Divisors(n)))
%p A092005 end proc:
%p A092005 select(f=9, [$1..300000]); # _Robert Israel_, Nov 12 2026
