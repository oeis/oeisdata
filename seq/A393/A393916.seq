%T A393916 252,234,17,26,138,331,374,260,4,77,22,105,55,73,547,16,67,631,49,62,
%U A393916 165,784,752,188,378,47,919,990,89,21,106,490,266,84,439,295,239
%N A393916 a(n) is the least positive integer k such that k times the n-th triangular number is pentagonal.
%H A393916 Wikipedia, <a href="https://en.wikipedia.org/wiki/Pentagonal_number">Pentagonal number</a>
%o A393916 (Python)
%o A393916 def a(n):
%o A393916     triangular = n*(n+1)//2
%o A393916     j = 1
%o A393916     while True:
%o A393916         pentagonal = j*(3*j-1)//2
%o A393916         if pentagonal % triangular == 0:
%o A393916             return pentagonal//triangular
%o A393916         j += 1
%o A393916 print([a(n) for n in range(1, 63)])
%o A393916 (PARI) a(n) = my(k=1, t=n*(n+1)/2); while (!ispolygonal(k*t, 5), k++); k; \\ _Michel Marcus_, Aug 14 2026
