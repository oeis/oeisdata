%I A393382 #13 Aug 03 2026 12:58:40
%S A393382 1,3,7,17,37,77,161,329,665,1347,2711,5439,10915,21867,43771,87619,
%T A393382 175315,350707,701575,1403311,2806783,5613895,11228119,22456567,
%U A393382 44913799,89828263,179657191,359315729,718632805,1437266957,2874536625,5749075961,11498154633,22996314705
%N A393382 a(0) = 1; a(n) = 2 * a(n-1) + a(floor(n/3)).
%C A393382 a(n) == 1 (mod 4) if 3^i <= n < 3^(i+1) where i is odd, otherwise a(n) == 3 (mod 4). - _Robert Israel_, Aug 03 2026
%H A393382 Robert Israel, <a href="/A393382/b393382.txt">Table of n, a(n) for n = 0..3303</a>
%F A393382 G.f. A(x) satisfies: A(x) = (1 + x + x^2) * A(x^3) / (1 - 2*x).
%F A393382 G.f.: (1/(1 - x)) * Product_{k>=0} 1 / (1 - 2*x^(3^k)).
%p A393382 f:= proc(n) option remember;
%p A393382      2*procname(n-1) + procname(floor(n/3))
%p A393382 end proc:
%p A393382 f(0):= 1:
%p A393382 map(f, [$0..40]); # _Robert Israel_, Aug 03 2026
%t A393382 a[0] = 1; a[n_] := a[n] = 2 a[n - 1] + a[Floor[n/3]]; Table[a[n], {n, 0, 33}]
%t A393382 (* Alternative: *)
%t A393382 nmax = 33; A[_] = 1; Do[A[x_] = (1 + x + x^2) A[x^3]/(1 - 2 x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%Y A393382 Cf. A005704, A033489, A393384.
%K A393382 nonn
%O A393382 0,2
