%S A393973 1,2,3,5,6,9,11,15,17,23,26,34,37,47,53,65,71,87,96,116,126,149,164,
%T A393973 195,211,246,270,312,339,393,427,489,532,604,660,749,810,915,997,1120,
%U A393973 1213,1361,1475,1648,1789,1985,2154,2394,2587,2863,3103,3422,3700,4080,4409,4845,5234
%N A393973 Number of partitions p of n such that max(p) <= 3*min(p).
%F A393973 G.f.: Sum_{j>=1} q^j / Product_{k=j..3*j} (1-q^k).
%t A393973 nmax = 60; Rest[CoefficientList[Series[Sum[x^j/Product[1 - x^k, {k, j, 3*j}], {j, 1, nmax}], {x, 0, nmax}], x]] (* _Vaclav Kotesovec_, Nov 17 2026 *)
%t A393973 (* Alternative: *)
%t A393973 nmax = 60; p = 1; s = 0; Do[p = Simplify[p*(1 - x^(3*k - 2))*(1 - x^(3*k - 1))*(1 - x^(3*k))/(1 - x^k)]; p = Normal[p + O[x]^nmax]; s += x^k/(1 - x^k)/p;, {k, 1, nmax}]; Rest[CoefficientList[Series[s, {x, 0, nmax}], x]] (* _Vaclav Kotesovec_, Nov 17 2026 *)
%Y A393973 Cf. A237824, A237825, A393972.
%K A393973 nonn,changed
%O A393973 1,2
