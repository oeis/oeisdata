%N A393384 a(0) = 1; a(n) = a(n-1) + 2 * a(floor(n/3)).
%H A393384 Robert Israel, <a href="/A393384/b393384.txt">Table of n, a(n) for n = 0..10000</a>
%F A393384 G.f. A(x) satisfies: A(x) = (2 * (1 + x + x^2) * A(x^3) - 1) / (1 - x).
%F A393384 a(n) + a(n+3) == 4 (mod 8). - _Robert Israel_, Aug 03 2026
%p A393384 f:= proc(n) option remember;
%p A393384      procname(n-1) + 2*procname(floor(n/3))
%p A393384 end proc:
%p A393384 f(0):= 1:
%p A393384 map(f, [$0..50]); # _Robert Israel_, Aug 03 2026
%t A393384 a[0] = 1; a[n_] := a[n] = a[n - 1] + 2 a[Floor[n/3]]; Table[a[n], {n, 0, 48}]
%t A393384 (* Alternative: *)
%t A393384 nmax = 48; A[_] = 1; Do[A[x_] = (2 (1 + x + x^2) A[x^3] - 1)/(1 - x) + O[x]^(nmax + 1) // Normal, nmax + 1]; CoefficientList[A[x], x]
%Y A393384 Cf. A005704, A058039, A393382.
