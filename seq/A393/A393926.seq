%U A393926 71185826063,298051854208,1251772703567,5272090327112,22262068842095,94229389184598,399731071346335,1699185944920853
%N A393926 a(0) = 1; a(n) = 3 - 2*n + Sum_{k=0..n-1} a(k) * a(n-1-k).
%H A393926 Robert Israel, <a href="/A393926/b393926.txt">Table of n, a(n) for n = 0..1533</a>
%F A393926 G.f. A(x) satisfies A(x) = 1 + 3*x/(1-x) - 2*x/(1-x)^2 + x*A(x)^2.
%F A393926 G.f.: (1 - sqrt(1 - 4*x*(1 + 3*x/(1-x) - 2*x/(1-x)^2)))/(2*x).
%F A393926 D-finite with recurrence: (4 + 8*n)*a(n) + (6 - 3*n)*a(1 + n) + (-31 - 11*n)*a(n + 2) + (26 + 7*n)*a(n + 3) + (-5 - n)*a(n + 4) = 0. - _Robert Israel_, Nov 06 2026
%p A393926 with(gfun):
%p A393926 eq:= numer(-y + 1 + 3*x/(1-x) - 2*x/(1-x)^2 + x*y^2):
%p A393926 de:= algeqtodiffeq(eq,y(x)):
%p A393926 rec:= diffeqtorec(de,y(x),a(n)):
%p A393926 f:= rectoproc(rec,a(n),remember):
%p A393926 map(f, [$0..30]); # _Robert Israel_, Nov 06 2026
%o A393926 (PARI) my(N=30, x='x+O('x^N)); Vec((1-sqrt(1-4*x*(1+3*x/(1-x)-2*x/(1-x)^2)))/(2*x))
%Y A393926 Cf. A007317, A086611.
