%I A393855 #28 Oct 01 2026 08:58:43
%S A393855 1,25,117,325,697,1281,2125,3277,4785,6697,9061,11925,15337,19345,
%T A393855 23997,29341,35425,42297,50005,58597,68121,78625,90157,102765,116497,
%U A393855 131401,147525,164917,183625,203697,225181,248125,272577,298585,326197,355461,386425,419137
%N A393855 Sum of the distinct entries in the central row and central column of the (2*n + 1) X (2*n + 1) square array formed by the integers 1, 2, ..., (2*n + 1)^2 in order.
%C A393855 The sum of the entries on the two main diagonals gives the same sequence.
%H A393855 Paolo Xausa, <a href="/A393855/b393855.txt">Table of n, a(n) for n = 0..10000</a>
%H A393855 Wikipedia, <a href="https://en.wikipedia.org/wiki/Calculator#Key_layout">Calculator (Key layout)</a>.
%H A393855 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (4,-6,4,-1).
%F A393855 a(n) = (4*n + 1)*(2*n^2 + 2*n + 1).
%F A393855 From _Jianing Song_, Oct 01 2026: (Start)
%F A393855 G.f.: (1 + 21*x + 23*x^2 + 3*x^3)/(1 - x)^4.
%F A393855 E.g.f.: (1 + 24*x + 34*x^2 + 8*x^3)*exp(x). (End)
%e A393855 a(0) = 1. For n = 1, the array is the usual 3 X 3 calculator digit layout:
%e A393855 7 8 9
%e A393855 4 5 6
%e A393855 1 2 3
%e A393855 and a(1) = 2 + 4 + 5 + 6 + 8 = 25.
%t A393855 A393855[n_] := (4*n + 1)*(2*n*(n + 1) + 1); Array[A393855, 50, 0] (* _Paolo Xausa_, Oct 01 2026 *)
%t A393855 (* Alternative: *)
%t A393855 LinearRecurrence[{4, -6, 4, -1}, {1, 25, 117, 325}, 50] (* _Paolo Xausa_, Oct 01 2026 *)
%Y A393855 Cf. A399589, A399778.
%K A393855 nonn,easy,new
%O A393855 0,2
%A A393855 _Marco Ripà_, Sep 24 2026
