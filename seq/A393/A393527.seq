%S A393527 1,1,1,3,6,10,22,38,82,142,306,530,1142,1978,4262,7382,15906,27550,
%T A393527 59362,102818,221542,383722,826806,1432070,3085682,5344558,11515922,
%U A393527 19946162,42978006,74440090,160396102,277814198,598606402,1036816702,2234029506,3869452610
%N A393527 a(0) = a(1) = a(2) = 1; thereafter odd indexed terms are the sum of the last 3 terms and even indexed terms are the sum of all previous terms.
%H A393527 James S. DeArmon, <a href="/A393527/a393527.txt">R Code for A393527</a>
%H A393527 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (0,4,0,-1).
%F A393527 a(n) = a(n-1) + a(n-2) + a(n-3) for odd n >= 3;
%F A393527 a(n) = Sum_{k=1..n-1} a(k) for even n >= 4.
%F A393527 From _Robert Israel_, Nov 13 2026: (Start)
%F A393527 a(n+4) - 4*a(n+6) + a(n+8) = 0.
%F A393527 G.f.: (1 + x - 3*x^2 - x^3 + 3*x^4 - x^5 - x^6 + x^7)/(1 - 4*x^2 + x^4).
%F A393527 (End)
%p A393527 f:= gfun:-rectoproc({a(n+4) - 4*a(n+6) + a(n+8) = 0, a(0)=1,a(1)=1,a(2)=1,a(3)=3,a(4)=6,a(5)=10,a(6)=22,a(7)=38},a(n),remember):
%p A393527 map(f, [$0..40]); # _Robert Israel_, Nov 13 2026
%t A393527 s={1,1,1};Do[AppendTo[s,s[[-3]]+s[[-2]]+s[[-1]]];AppendTo[s,Total[s]],{i,17}];s (* _James C. McMahon_, Feb 27 2026 *)
