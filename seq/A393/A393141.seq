%I A393141 #14 Aug 31 2026 10:24:44
%S A393141 1,3,17,71,1569,899,355081,425331,16541017,5719087,99920609601,
%T A393141 144619817,98139640241473,485223422289,21844512889051,
%U A393141 2648261961071387,236389784118231290049,458182173298217,536484538620663729658993,3387894135040576041
%N A393141 a(n) = numerator(hypergeom([1, -n], [], -1/(n + 1))).
%C A393141 Ramanujan's Q-function, as defined by Knuth, is a sequence of rational numbers given by Q(n) = Sum_{k=1..n} FallingFactorial(n, k) / n^k. The initial values are:
%C A393141   Q(n) = 0/1, a(0)/A036505(0), ..., a(n-1)/A036505(n-1), ...
%C A393141        = 0, 1, 3/2, 17/9, 71/32, 1569/625, ...
%C A393141   Q is defined for n >= 0, and Q(0) = 0 by the empty sum convention. An efficient implementation is shown below. - _Peter Luschny_, Aug 30 2026
%D A393141 Donald E. Knuth, The Art of Computer Programming, Vol. 1, Fundamental Algorithms, Third Edition, Section 1.2.11.3, Addison-Wesley, 2021.
%F A393141 a(n) = numerator(Gamma(n+1, n+1) * exp(n + 1) / (n + 1)^n).
%F A393141 a(n) = numerator(Sum_{k=0..n} n! / ((n - k)! * (n + 1)^k)).
%F A393141 a(n) = numerator(Sum_{k=0..n} FallingFactorial(n, k) / (n + 1)^k ).
%p A393141 P := n -> hypergeom([1, -n], [], -1/(n + 1)):
%p A393141 seq(numer(simplify(P(n))), n = 0..19);
%o A393141 (Python)
%o A393141 from math import gcd
%o A393141 def A393141(n: int) -> int:
%o A393141     t_num, t_den = 1, 1   # term
%o A393141     s_num, s_den = 0, 1   # sum
%o A393141     for k in range(n + 1):
%o A393141         if k > 0:
%o A393141             t_num *= (n - k + 1)
%o A393141             t_den *= (n + 1)
%o A393141             g = gcd(t_num, t_den)
%o A393141             t_num //= g
%o A393141             t_den //= g
%o A393141         num = s_num * t_den + t_num * s_den
%o A393141         den = s_den * t_den
%o A393141         g = gcd(num, den)
%o A393141         s_num, s_den = num // g, den // g
%o A393141     return s_num
%o A393141 L = [A393141(n) for n in range(20)]; print(L)
%o A393141 (SageMath)
%o A393141 def a(n: int) -> int:
%o A393141     s = sum(falling_factorial(n, k) / (n + 1) ** k for k in range(n + 1))
%o A393141     return s.numerator()
%o A393141 print([a(n) for n in range(20)])
%o A393141 (Python)
%o A393141 from sympy import Rational
%o A393141 def Ramanujan_Q(n: int):
%o A393141     if n == 0: return Rational(0)
%o A393141     res = Rational(1)
%o A393141     for k in range(1, n):
%o A393141         res = 1 + Rational(k, n) * res
%o A393141     return res
%o A393141 print([Ramanujan_Q(n).numerator for n in range(1, 21)])  # _Peter Luschny_, Aug 30 2026
