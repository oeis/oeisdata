%N A393216 Number of transitive relations on an n-set with exactly six ordered pairs.
%H A393216 <a href="/index/Rec#order_13">Index entries for linear recurrences with constant coefficients</a>, signature (13,-78,286,-715,1287,-1716,1716,-1287,715,-286,78,-13,1).
%F A393216 a(n) = 12*C(n,3) + 758*C(n,4) + 11600*C(n,5) + 87943*C(n,6) + 393960*C(n,7) + 1137752*C(n,8) + 2172240*C(n,9) + 2696400*C(n,10) + 1995840*C(n,11) + 665280*C(n,12).
%F A393216 From _Elmo R. Oliveira_, Nov 04 2026: (Start)
%F A393216 G.f.: x^3 * (12 + 650*x + 5968*x^2 + 26959*x^3 + 68966*x^4 + 132645*x^5 + 166532*x^6 + 162929*x^7 + 86138*x^8 + 14481*x^9) / (1 - x)^13.
%F A393216 E.g.f.: (x^3/6!) * (1440 + 22740*x + 69600*x^2 + 87943*x^3 + 56280*x^4 + 20317*x^5 + 4310*x^6 + 535*x^7 + 36*x^8 + x^9) * exp(x).
%F A393216 a(n) = (n*(n^2 - 3*n + 2)/6!) * (n^9 - 27*n^8 + 397*n^7 - 3670*n^6 + 22826*n^5 - 96998*n^4 + 277941*n^3 - 513981*n^2 + 554879*n - 267000). (End)
%e A393216 a(0)=a(1)=a(2)=0 because there are no transitive relations on a 0-set/1-set/2-set with six ordered pairs.
%t A393216 a[n_] := Total[{12, 758, 11600, 87943, 393960, 1137752, 2172240, 2696400, 1995840, 665280} * Binomial[n, Range[3, 12]]]; Array[a, 25, 0] (* _Amiram Eldar_, Feb 07 2026 *)
