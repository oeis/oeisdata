%U A393643 39346408075296538398967,20880467999847912043271133358823,88817841970012523233890533447265881
%N A393643 Primes of the form x^^y + w^^z, where x, y, w, z >= 2 and ^^ denotes tetration.
%C A393643 Since x^^y has the same parity as x, in every representation of a term as x^^y + w^^z, exactly one of x and w is even.
%C A393643 Here, a(1) = 2^^2 + 3^^2, a(2) = 2^^3 + 3^^2, a(3) = 3^^2 + 4^^2, and a(4) = 3^^2 + 2^^4. In particular, a(2) is the only known prime of the form x^^y + y^^x (x, y >= 2), and it is unknown whether another such prime exists.
%C A393643 No a(n) can be of the form x^^y + x^^w since x^^y + x^^w is divisible by x^^(min(y,w)) > 1.
%e A393643 a(2) = 43 since 2^^3 + 3^^2 = 16 + 27 = 43 is prime.
%o A393643 (Python)
%o A393643 from sympy import isprime
%o A393643 def tet(a,b,m):
%o A393643     x=a
%o A393643     for _ in range(b-1):
%o A393643         if x>=m.bit_length():
%o A393643             return m+1
%o A393643         x=a**x
%o A393643     return x
%o A393643 def a(n):
%o A393643     m=32
%o A393643     while True:
%o A393643         T=set()
%o A393643         r=2
%o A393643         while r**r<=m:
%o A393643             s=2
%o A393643             while (x:=tet(r,s,m))<=m:
%o A393643                 T.add(x)
%o A393643                 s+=1
%o A393643             r+=1
%o A393643         T=sorted(T)
%o A393643         A=sorted({x+y for i,x in enumerate(T) for y in T[i:] if x+y<=m and isprime(x+y)})
%o A393643         if len(A)>=n:
%o A393643             return A[n-1]
%o A393643         m*=2
%o A393643 print([a(n) for n in range(1,21)])
