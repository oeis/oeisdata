%I A190150 #25 Oct 11 2026 09:27:19
%S A190150 18,34,38,50,66,68,70,74,78,82,98,102,114,130,132,134,138,140,142,146,
%T A190150 150,154,158,162,166,178,194,196,198,202,206,210,226,230,242,258,260,
%U A190150 262,264,266,268,270,274,276,278,282,284,286,290,294,298,302,306,310,314,318,322,324,326,330,334,338,354,358,370,386,388,390,394,396,398,402,406
%N A190150 A190149 converted to base 10.
%H A190150 Amiram Eldar, <a href="/A190150/b190150.txt">Table of n, a(n) for n = 1..10000</a>
%H A190150 David Applegate, Marc LeBrun, and N. J. A. Sloane, <a href="https://arxiv.org/abs/1107.1130">Dismal Arithmetic</a>, arXiv:1107.1130 [math.NT], 2011. [Note: we have now changed the name from "dismal arithmetic" to "lunar arithmetic" - the old name was too depressing]
%H A190150 David Applegate, Marc LeBrun, and N. J. A. Sloane, <a href="https://cs.uwaterloo.ca/journals/JIS/VOL14/Sloane/carry2.html">Dismal Arithmetic</a>, J. Int. Seq. 14 (2011), Article 11.9.8.
%H A190150 <a href="/index/Di#dismal">Index entries for sequences related to dismal (or lunar) arithmetic</a>.
%t A190150 mult[i_, j_] := BitOr @@ BitShiftLeft[j, Flatten@ Position[Reverse@IntegerDigits[i, 2], 1] - 1];
%t A190150 zeroQ[n_] := n+1 != 2^IntegerExponent[n+1, 2];
%t A190150 q[n_] := zeroQ[Fold[BitOr, 0, Select[Range[1, n], Function[d, AnyTrue[Range[Floor[(2*n-1)/d]], mult[d, #] == n &]]]]];
%t A190150 Select[Range[2, 406, 2], q] (* _Amiram Eldar_, Oct 11 2026 *)
%Y A190150 Cf. A188548, A190149, A190151.
%K A190150 base,nonn
%O A190150 1,1
%A A190150 _N. J. A. Sloane_, May 05 2011
