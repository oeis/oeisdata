%I A190151 #31 Oct 11 2026 09:27:07
%S A190151 9,17,19,25,33,34,35,37,39,41,49,51,57,65,66,67,69,70,71,73,75,77,79,
%T A190151 81,83,89,97,98,99,101,103,105,113,115,121,129,130,131,132,133,134,
%U A190151 135,137,138,139,141,142,143,145,147,149,151,153,155,157,159,161,162,163,165,167,169,177,179,185,193,194,195,197,198,199,201,203,205,207,209,211
%N A190151 A190149 converted to base 10 and halved.
%C A190151 Take the even numbers n such that in base 2 lunar arithmetic, the sum of the divisors of n is not of the form 2^k-1, and divide them (in ordinary arithmetic) by 2 (cf. A190149, A190150).
%H A190151 Amiram Eldar, <a href="/A190151/b190151.txt">Table of n, a(n) for n = 1..10000</a>
%H A190151 David Applegate, Marc LeBrun, and N. J. A. Sloane, <a href="https://arxiv.org/abs/1107.1130">Dismal Arithmetic</a>, arXiv:1107.1130 [math.NT], 2011. [Note: we have now changed the name from "dismal arithmetic" to "lunar arithmetic" - the old name was too depressing]
%H A190151 David Applegate, Marc LeBrun, and N. J. A. Sloane, <a href="https://cs.uwaterloo.ca/journals/JIS/VOL14/Sloane/carry2.html">Dismal Arithmetic</a>, J. Int. Seq. 14 (2011), Article 11.9.8.
%H A190151 <a href="/index/Di#dismal">Index entries for sequences related to dismal (or lunar) arithmetic</a>.
%t A190151 mult[i_, j_] := BitOr @@ BitShiftLeft[j, Flatten@ Position[Reverse@IntegerDigits[i, 2], 1] - 1];
%t A190151 zeroQ[n_] := n+1 != 2^IntegerExponent[n+1, 2];
%t A190151 q[n_] := zeroQ[Fold[BitOr, 0, Select[Range[1, n], Function[d, AnyTrue[Range[Floor[(2*n-1)/d]], mult[d, #] == n &]]]]];
%t A190151 Select[Range[211], q[2*#] &] (* _Amiram Eldar_, Oct 11 2026 *)
%Y A190151 Cf. A188548, A190149, A190150.
%K A190151 nonn,base,changed
%O A190151 1,1
%A A190151 _N. J. A. Sloane_, May 05 2011
