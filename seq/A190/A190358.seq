%N A190358 Least number having exactly two prime factors that differ by 2^n.
%H A190358 G. C. Greubel, <a href="/A190358/b190358.txt">Table of n, a(n) for n = 0..1000</a>
%F A190358 a(n) = A056206(n) * A056208(n). - _Andrew Howroyd_, Oct 06 2026
%e A190358 a(5) = 185 because 185 = 5 * 37 , and 37 - 5 = 32 = 2^5.
%t A190358 f[n_] := Block[{p = 3}, While[! PrimeQ[p] || ! PrimeQ[p + 2^n], p++]; p (p + 2^n)]; Table[f[n], {n, 1, 60}]
%Y A190358 Cf. A056206, A056208, A190052.
