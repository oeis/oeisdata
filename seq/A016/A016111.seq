%U A016111 837259855674756215,14340645378939543110,242413466664747823900,4050839332552222408401,67009572335458714226265
%N A016111 Expansion of g.f. 1/((1-11*x)*(1-12*x)*(1-13*x)*(1-14*x)*(1-15*x)).
%H A016111 Vincenzo Librandi, <a href="/A016111/b016111.txt">Table of n, a(n) for n = 0..200</a>
%H A016111 Anthony J. Macula, <a href="https://www.jstor.org/stable/2690571">Lewis Carroll and the enumeration of minimal covers</a>, Math. Mag., Vol. 68, No. 4 (1995), pp. 269-274.
%H A016111 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/MinimalCover.html">Minimal Cover</a>.
%H A016111 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (65,-1685,21775,-140274,360360).
%F A016111 From _Elmo R. Oliveira_, Sep 30 2026: (Start)
%F A016111 a(n) = (15^(n+4) - 4*14^(n+4) + 6*13^(n+4) - 4*12^(n+4) + 11^(n+4))/24.
%F A016111 a(n) = 65*a(n-1) - 1685*a(n-2) + 21775*a(n-3) - 140274*a(n-4) + 360360*a(n-5).
%F A016111 E.g.f.: (1/24)*(14641*exp(11*x) - 82944*exp(12*x) + 171366*exp(13*x) - 153664*exp(14*x) + 50625*exp(15*x)). (End)
%t A016111 CoefficientList[Series[1 / ((1 - 11 x) (1 - 12 x) (1 - 13 x) (1 - 14 x) (1 - 15 x)), {x, 0, 20}], x] (* _Vincenzo Librandi_, Jun 24 2013 *)
%o A016111 (PARI) Vec(1/((1-11*x)*(1-12*x)*(1-13*x)*(1-14*x)*(1-15*x))+O(x^99)) \\ _Charles R Greathouse IV_, Sep 26 2015
