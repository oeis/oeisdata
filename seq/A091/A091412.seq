%H A091412 Paolo Xausa, <a href="/A091412/b091412.txt">Table of n, a(n) for n = 1..10000</a>
%H A091412 Fokko J. van de Bult, Dion C. Gijswijt, John P. Linderman, N. J. A. Sloane, and Allan R. Wilks, <a href="https://cs.uwaterloo.ca/journals/JIS/VOL10/Sloane/sloane55.html">A Slow-Growing Sequence Defined by an Unusual Recurrence</a>, J. Int. Seq. 10 (2007), Art. 07.1.2.
%H A091412 Fokko J. van de Bult, Dion C. Gijswijt, John P. Linderman, N. J. A. Sloane, and Allan R. Wilks, A Slow-Growing Sequence Defined by an Unusual Recurrence [<a href="https://neilsloane.com/doc/gijs.pdf">pdf</a>, <a href="https://neilsloane.com/doc/gijs.ps">ps</a>].
%H A091412 <a href="/index/Ge#Gijswijt">Index entries for sequences related to Gijswijt's sequence</a>
%t A091412 Clear[g]; reversed = {g[2] = 1, g[1] = 1}; blocs[len_] := Module[{bloc1, par, pos}, bloc1 = Take[reversed, len]; par = Partition[reversed, len]; pos = Position[par, bloc_ /; bloc != bloc1, 1, 1]; If[pos == {}, Length[par], pos[[1, 1]] - 1]]; g[n_] := g[n] = Module[{g0}, g0 = Table[{blocs[len], len}, {len, 1, Quotient[n - 1, 2]}] // Sort // Last // First; PrependTo[reversed, g0]; g0]; A090822 = Table[g[n], {n, 1, 200}]; A091412 = Length /@ Split[A090822] (* _Jean-François Alcover_, Oct 07 2013 *)
%t A091412 (* Alternative: *)
%t A091412 Map[Length, Most[Split[Reverse[Nest[Prepend[#, Max[1, Table[Length[First[Split[Partition[#, k]]]], {k, Length[#]/2}]]] &, {1}, 200]]]]] (* _Paolo Xausa_, Oct 08 2026 *)
