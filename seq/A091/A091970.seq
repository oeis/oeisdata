%S A091970 0,0,1,0,0,1,1,1,1,2,0,0,1,0,0,1,1,1,1,2,1,0,0,1,0,0,1,1,1,1,2,0,0,1,
%T A091970 0,0,1,1,1,1,2,1,1,1,1,2,1,1,1,1,2,1,1,1,1,2,2,1,0,0,1,0,0,1,1,1,1,2,
%U A091970 0,0,1,0,0,1,1,1,1,2,1,0,0,1,0,0,1,1,1,1,2,0,0,1,0,0,1,1,1,1,2
%N A091970 a(1) = 0; for n>1, find largest integer k such that the word a(1)a(2)...a(n-1) is of the form xy^k for words x and y (where y has positive length), i.e., k = the maximal number of repeating blocks at the end of the sequence so far; then a(n) = floor(k/2).
%C A091970 When does the first 3 occur? The first 4?
%H A091970 Paolo Xausa, <a href="/A091970/b091970.txt">Table of n, a(n) for n = 1..3000</a>
%H A091970 Fokko J. van de Bult, Dion C. Gijswijt, John P. Linderman, N. J. A. Sloane, and Allan R. Wilks, <a href="https://cs.uwaterloo.ca/journals/JIS/VOL10/Sloane/sloane55.html">A Slow-Growing Sequence Defined by an Unusual Recurrence</a>, J. Int. Seq. 10 (2007), Art. 07.1.2.
%H A091970 Fokko J. van de Bult, Dion C. Gijswijt, John P. Linderman, N. J. A. Sloane, and Allan R. Wilks, A Slow-Growing Sequence Defined by an Unusual Recurrence [<a href="https://neilsloane.com/doc/gijs.pdf">pdf</a>, <a href="https://neilsloane.com/doc/gijs.ps">ps</a>].
%H A091970 <a href="/index/Ge#Gijswijt">Index entries for sequences related to Gijswijt's sequence</a>
%t A091970 Reverse[Nest[Prepend[#, Quotient[Max[1, Table[Length[First[Split[Partition[#, k]]]], {k, Length[#]/2}]], 2]] &, {0}, 100]] (* _Paolo Xausa_, Oct 08 2026 *)
%Y A091970 A (presumably) even slower-growing sequence than A090822.
%K A091970 nonn,changed
%O A091970 1,10
