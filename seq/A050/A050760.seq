%S A050760 0,1,3,6,10,15,21,28,36,45,78,91,105,120,136,153,171,190,210,231,253,
%T A050760 276,325,351,378,406,435,465,496,528,561,595,630,703,741,780,820,861,
%U A050760 903,946,1035,1081,1275,1326,1378,1431,1485,1540,1596,1653,1830,1891
%N A050760 Triangular numbers whose decimal expansion contains no pair of consecutive equal digits.
%C A050760 For indices, see A050759.
%C A050760 For k = d*(10^(9t)-1)/9, where t >= 1 and d = 1,...,9, the triangular number k*(k+1)/2 is a term of the sequence if and only if d is in {1,2,4,5,8}. In particular, this gives an explicit infinite family of terms. - _Lien-Hung Su_, Oct 06 2026
%H A050760 Harvey P. Dale, <a href="/A050760/b050760.txt">Table of n, a(n) for n = 1..1000</a>
%H A050760 Lien-Hung Su, <a href="https://doi.org/10.5281/zenodo.23161388">Adjacent-Digit Distinctness in Triangular Numbers of 9t-Digit Repdigits</a>, Zenodo, 2026.
%t A050760 Select[Accumulate[Range[0,70]],FreeQ[Differences[IntegerDigits[#]],0]&] (* _Harvey P. Dale_, Jun 20 2021 *)
