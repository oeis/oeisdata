%I A221010 #29 Aug 14 2026 08:41:00
%S A221010 84,2328,23070,161322,951906,5097426,25678002,124125810,582682098,
%T A221010 2676493554,12091136754,53909403378,237825453810,1040070008562,
%U A221010 4515386474226,19482038992626,83610263027442,357169749688050,1519594327768818,6442039704551154,27222810546929394,114709853412261618
%N A221010 The Wiener index of the nanostar dendrimer G[n], defined pictorially in the Nadjafi-Arani et al. reference.
%C A221010 a(2) has been checked by the direct computation of the Wiener index (using Maple).
%C A221010 The formula on p. 163 of the Nadjafi-Arani reference seems to be mistaken.
%H A221010 Paolo Xausa, <a href="/A221010/b221010.txt">Table of n, a(n) for n = 1..1000</a>
%H A221010 M. J. Nadjafi-Arani, H. Khodashenas, and A. R. Ashrafi, <a href="https://match.pmf.kg.ac.rs/electronic_versions/Match69/n1/match69n1_159-164.pdf">A new method for computing Wiener index of dendrimer nanostars</a>, MATCH Commun. Math. Comput. Chem. 69, 2013, 159-164.
%H A221010 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (11,-42,64,-32).
%F A221010 a(n) = -270 + 2^(n-1)*2055+4^(n-1)*(1323*n-3024).
%F A221010 G.f.: -6*x*(-14-234*x-165*x^2+8*x^3) / ( (2*x-1)*(x-1)*(-1+4*x)^2 ). - _R. J. Mathar_, Apr 11 2013
%F A221010 E.g.f.: 3*(126*exp(4*x)*(7*x - 4) + 685*exp(2*x) - 180*exp(x) - 1)/2. - _Stefano Spezia_, Nov 12 2025
%p A221010 a := proc (n) options operator, arrow: -270+2055*2^(n-1)+4^(n-1)*(1323*n-3024) end proc: seq(a(n), n = 1 .. 20);
%t A221010 A221010[n_] := 189*4^(n - 1)*(7*n - 16) + 2055*2^(n - 1) - 270;
%t A221010 Array[A221010, 25] (* _Paolo Xausa_, Aug 14 2026 *)
%Y A221010 Cf. A221011.
%K A221010 nonn,easy,changed
%O A221010 1,1
%A A221010 _Emeric Deutsch_, Mar 28 2013
%E A221010 More terms from _Paolo Xausa_, Aug 14 2026
