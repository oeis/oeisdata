%T A221952 32,4,12,8,8,16,18,4,8,8,32,4,16,4,12,24,8,4,20,6,28,8,12,4,16,16,16,
%U A221952 8,8,4,48,4,8,12,14,16,16,4,12,8,32,4,24,4,8,28,12,8,16,4,40
%N A221952 Number of subgroups of C_5 X C_n.
%H A221952 Amiram Eldar, <a href="/A221952/b221952.txt">Table of n, a(n) for n = 1..10000</a>
%F A221952 From _Amiram Eldar_, Oct 26 2026: (Start)
%F A221952 a(n) = A000005(n) + Sum_{d|n} gcd(d, 5).
%F A221952 a(n) = 2 * ((3*A112765(n)+1)/(A112765(n)+1)) * A000005(n).
%F A221952 Dirichlet g.f.: 2 * (1 + 2/5^s) * zeta(s)^2.
%F A221952 Sum_{k=1..n} a(k) ~ (14/5)*n*(log(n) + 2*gamma - 1 - 2*log(5)/7), where gamma is Euler's constant (A001620). (End)
%t A221952 a[n_] := With[{e = IntegerExponent[n, 5]}, 2 * ((3*e+1)/(e+1)) * DivisorSigma[0, n]]; Array[a, 80] (* _Amiram Eldar_, Oct 26 2026 *)
%o A221952 (PARI) a(n) = {my(e = valuation(n, 5)); 2 * ((3*e+1)/(e+1)) * numdiv(n);} \\ _Amiram Eldar_, Oct 26 2026
