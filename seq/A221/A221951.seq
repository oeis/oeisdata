%U A221951 6,32,12,44,12,16,6,60,6,16,18,43,12,32,6,30,12,32,6,66,6,16,18,30,12,32,6,58
%N A221951 Number of subgroups of C_4 X C_n.
%H A221951 Antti Karttunen, <a href="/A221951/b221951.txt">Table of n, a(n) for n = 1..65537</a>
%F A221951 a(n) = Sum_{d|n} (1+gcd(2,d)+gcd(4,d)). - _Antti Karttunen_, Sep 30 2018
%F A221951 From _Amiram Eldar_, Oct 26 2026: (Start)
%F A221951 a(n) = (2 - (-1)^n) * (7*A007814(n)+1)/(A007814(n)+1)) * A000005(n).
%F A221951 Dirichlet g.f.: (3 + 1/2^(s-1) + 1/2^(2*s-1)) * zeta(s)^2.
%F A221951 Sum_{k=1..n} a(k) ~ (9/2)*n*(log(n) + 2*gamma - 1 - 4*log(2)/9), where gamma is Euler's constant (A001620). (End)
%t A221951 a[n_] := With[{e = IntegerExponent[n, 2]}, (2-(-1)^n) * ((7*e+1)/(e+1)) * DivisorSigma[0, n]]; Array[a, 80] (* _Amiram Eldar_, Oct 26 2026 *)
%o A221951 (PARI) A221951(n) = sumdiv(n,d,(1+gcd(2,d)+gcd(4,d))); \\ _Antti Karttunen_, Sep 30 2018
%o A221951 (PARI) a(n) = {my(e = valuation(n, 2)); (2-(-1)^n) * ((7*e+1)/(e+1)) * numdiv(n);} \\ _Amiram Eldar_, Oct 26 2026
