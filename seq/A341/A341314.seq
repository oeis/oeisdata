%p A341314 fa:= (m,n) -> if m=0 and n=0 then 0 else (m+n)/igcd(m,n); fi;
%p A341314 for m from 0 to 12 do lprint([seq(fa(m-n,n),n=0..m)]); od:
%p A341314 for m from 0 to 12 do lprint([seq(fa(m,n),n=0..12)]); od:
