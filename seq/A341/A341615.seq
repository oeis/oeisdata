%S A341615 4,8,9,10,14,15,16,21,27,32,35,39,44,45,49,50,52,57,63,64,68,69,75,76,
%T A341615 81,91,92,98,99,105,110,116,117,124,125,128,130,135,136,147,148,152,
%U A341615 153,154,164,165,170,171,172,175,182,184,188,189,190,195,207,212,225,230,231,232,236,238,242,243,244,245,248,250,255,256
%N A341615 Numbers k for which sigma(k) < 2k < A003961(k).
%C A341615 Deficient numbers in A246282.
%C A341615 Not all odd terms are in A337372.
%H A341615 Amiram Eldar, <a href="/A341615/b341615.txt">Table of n, a(n) for n = 1..10000</a>
%t A341615 f1[p_, e_] := (p^(e+1) - 1)/(p - 1); f2[p_, e_] := NextPrime[p]^e;
%t A341615 q[k_] := Module[{fct = FactorInteger[k]}, Times @@ f1 @@@ fct < 2*k < Times @@ f2 @@@ fct ]; Select[Range[2, 256], q] (* _Amiram Eldar_, Oct 12 2026 *)
%o A341615 (PARI)
%o A341615 A003961(n) = { my(f = factor(n)); for (i=1, #f~, f[i, 1] = nextprime(f[i, 1]+1)); factorback(f); };
%o A341615 isA341615(n) = A341613(n);
%Y A341615 Intersection of A005100 and A246282. Subsequence of A341614.
%Y A341615 Cf. A341613 (characteristic function).
%Y A341615 Cf. A000203, A003961, A252748, A286385, A326057, A326134, A337372.
%K A341615 nonn
%O A341615 1,1
