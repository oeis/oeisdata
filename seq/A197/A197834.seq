%N A197834 Decimal expansion of the first local maximum of (cos(x))^2+(sin(3*Pi*x))^2 at x > 0.
%C A197834 For a discussion and guide to related sequences, see A197739.
%e A197834 1.9727766369395095624370979608845877218621869292825767480835998970688428257742....
%t A197834 b = 1; c = 3*Pi;
%t A197834 f[x_] := Cos[b*x]^2; g[x_] := Sin[c*x]^2; s[x_] := f[x] + g[x];
%t A197834 r = x /. FindRoot[b*Sin[2 b*x] == c*Sin[2 c*x], {x, .16, .17}, WorkingPrecision -> 110];
%t A197834 m = s[r];
%t A197834 RealDigits[m]
%o A197834 (PARI) my(t=solve(x=0.1,0.2,-2*cos(x)*sin(x)+6*sin(3*x*Pi)*cos(3*x*Pi)*Pi)); cos(t)^2+sin(3*t*Pi)^2 \\ _Charles R Greathouse IV_, Jul 22 2026
