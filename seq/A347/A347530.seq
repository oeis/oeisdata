%I A347530 #25 Oct 23 2026 15:27:28
%S A347530 17,29,89,149,269,929,1109,1409,3449,5309,6389,8069,12329,14969,33029,
%T A347530 34589,42929,47129,48989,60209,67349,78809,98129,109049,118589,136769,
%U A347530 158489,175829,213209,264269,317609,338669,363809,367229,389849,438989,454109,467549
%N A347530 Primes of the form (p^2 + 9)/2 where p is prime.
%C A347530 Each p is an odd number, so p^2 == 1 (mod 8), thus (p^2 + 9)/2 == 1 (mod 4).
%C A347530 Also (p^2 + 9)/2 == 2 (mod 3) and 4 (mod 5) except for 17, thus == 29 (mod 60). - _Robert Israel_, Oct 22 2026
%H A347530 Robert Israel, <a href="/A347530/b347530.txt">Table of n, a(n) for n = 1..10000</a>
%e A347530 17 is in the sequence as 17 = (p^2 + 9)/2 where p = 5 is prime.
%e A347530 29 is in the sequence as 29 = (p^2 + 9)/2 where p = 7 is prime.
%p A347530 R:= NULL: count:= 0:
%p A347530 p:= 2:
%p A347530 while count < 100 do
%p A347530   p:= nextprime(p);
%p A347530   q:= (p^2+9)/2;
%p A347530   if isprime(q) then
%p A347530     R:= R,q; count:= count+1;
%p A347530   fi;
%p A347530 od:
%p A347530 R; # _Robert Israel_, Oct 22 2026
%t A347530 Select[(Select[Range[3, 1000], PrimeQ]^2 + 9)/2, PrimeQ] (* _Amiram Eldar_, Sep 05 2021 *)
%Y A347530 Cf. A000040, A045637, A062324.
%Y A347530 Subsequence of A076727 and of A103739.
%K A347530 nonn,changed
%O A347530 1,1
%A A347530 _Burak Muslu_, Sep 05 2021
