%S A104544 1,1,0,1,1,0,3,0,1,0,5,3,0,1,0,11,6,3,0,1,0,25,13,9,3,0,1,0,55,40,16,
%T A104544 12,3,0,1,0,129,95,60,20,15,3,0,1,0,303,250,155,80,25,18,3,0,1,0,721,
%U A104544 661,415,235,100,31,21,3,0,1,0,1743,1708,1206,620,335,120,38,24,3,0,1,0,4241,4515,3262,1946,875,455,140,46,27,3,0,1,0
%N A104544 Triangle read by rows: T(n,k) is the number of Motzkin paths of length n having k HH's, where H = (1,0).
%H A104544 Alois P. Heinz, <a href="/A104544/b104544.txt">Rows n = 0..150, flattened</a>
%F A104544 G.f.: = G = G(t,z) satisfies z^2*(1+z-t*z)*G^2-(1-t*z)*G+1+z-t*z = 0.
%F A104544 Sum_{k=0..n} k * T(n,k) = A005717(n-1) for n>=2. - _Alois P. Heinz_, Aug 04 2026
%e A104544 Triangle starts:
%e A104544    1;
%e A104544    1, 0;
%e A104544    1, 1, 0;
%e A104544    3, 0, 1, 0;
%e A104544    5, 3, 0, 1, 0;
%e A104544   11, 6, 3, 0, 1, 0;
%e A104544   ...
%e A104544 T(4,1) = 3 because we have HHUD, UDHH and UHHD, where U=(1,1), D=(1,-1) and H=(1,0).
%p A104544 b:= proc(x, y, t) option remember; `if`(y<0 or y>x, 0, `if`(x=0, 1,
%p A104544       b(x-1, y-1, 1)+ expand(b(x-1, y, z)*t)+b(x-1, y+1, 1)))
%p A104544     end:
%p A104544 T:= (n, k)-> coeff(b(n, 0, 1), z, k):
%p A104544 seq(seq(T(n, k), k=0..n), n=0..12);  # _Alois P. Heinz_, Aug 04 2026
%Y A104544 Column 0 yields A104545.
%Y A104544 Row sums yield the Motzkin numbers (A001006).
%Y A104544 Cf. A005717.
%K A104544 nonn,tabl
%O A104544 0,7
%A A104544 _Emeric Deutsch_, Mar 14 2005
