%U A104024 514382400,635040000,768398400,1366041600,4629441600,2540160000,3073593600,4292870400,6915585600,9658958400
%N A104024 Least number k which can be written as k^2 * j, 0 < j <= k in exactly n ways.
%H A104024 Amiram Eldar, <a href="/A104024/b104024.txt">Table of n, a(n) for n = 0..32</a>
%t A104024 t = Sort[ Flatten[ Table[n = k^2*j; If[n < 10^7, n, {}], {k, 10000}, {j, k}]]]; l = Length[t]; t[[Select[ Range[l - 11], t[[ # ]] == t[[ # + 11]] &]]]
%o A104024 (PARI) s(n) = sumdiv(n, d, issquare(d) && sqrtint(d) >= n/d);
%o A104024 list(len) = {my(c = 0, v = vector(len), k = 1); while(c < len, i = s(k) + 1; if(i <= len && v[i] == 0, c++; v[i] = k); k++); v;} \\ _Amiram Eldar_, Oct 10 2026
