%N A104025 Least number k that can be written as k^2 * j with 0 < j <= k and gcd(k, j) = 1 in exactly n ways.
%t A104025 t = Sort[ Flatten[ Table[n = k^2*j; If[ GCD[k, j] == 1 && 10^5 < n < 10^8, n, {}], {k, 15000}, {j, k}]]]; l = Length[t]; t[[Select[ Range[l - 11], t[[ # ]] == t[[ # + 9]] &]]]
%o A104025 (PARI) s(n) = sumdiv(n, d, gcd(d, n/d) == 1 && issquare(d) && sqrtint(d) >= n/d);
%o A104025 list(len) = {my(c = 0, v = vector(len), k = 1); while(c < len, i = s(k) + 1; if(i <= len && v[i] == 0, c++; v[i] = k); k++); v;} \\ _Amiram Eldar_, Oct 10 2026
