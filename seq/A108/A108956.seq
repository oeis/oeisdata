%N A108956 a(n) = floor(R(2n) - R(n)).
%F A108956 R(x) = Riemann Pi(x) approximation.
%o A108956 (PARI) p(n) = for(x=2,n,y=R(2*x)-R(x);print1(floor(y)", "))
%o A108956 R(x) = { local(j); 1 + sum(j=1,200,log(x)^j/(j*j!*zeta(j+1))) } \\ Riemann approx of Pi(x) [Corrected by _Alper Ferudun_, Oct 17 2026]
%o A108956 Li(x) = -eint1(log(1/x));
