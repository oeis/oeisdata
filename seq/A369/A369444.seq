%S A369444 1,1,1,1,2,7,22,57,131,298,738,2003,5600,15380,41224,109769,296009,
%T A369444 813315,2261647,6305930,17554044,48851034,136350556,382408995,
%U A369444 1077164245,3042452536,8606495236,24377127256,69159381856,196600128592,559990599808,1597797525833
%N A369444 Expansion of (1/x) * Series_Reversion( x / ((1+x) * (1+x^4)) ).
%C A369444 Binomial transform of A365730. - _Seiichi Manyama_, Sep 19 2025
%H A369444 Robert Israel, <a href="/A369444/b369444.txt">Table of n, a(n) for n = 0..2101</a>
%H A369444 Robert Israel, <a href="/A369444/a369444.txt">Recurrence of order 11</a>
%H A369444 <a href="/index/Res#revert">Index entries for reversions of series</a>
%F A369444 a(n) = (1/(n+1)) * Sum_{k=0..floor(n/4)} binomial(n+1,k) * binomial(n+1,n-4*k).
%F A369444 a(n) = Sum_{k=0..n} binomial(n,k) * A365730(k). - _Seiichi Manyama_, Sep 19 2025
%F A369444 D-finite with recurrence of order 11 (see link). - _Robert Israel_, Sep 23 2026
%p A369444 with(gfun):
%p A369444 eq1:= numer(z/((1+z)*(1+z^4))-x):
%p A369444 eq:= resultant(eq1, z-y*x, z):
%p A369444 de:=algeqtodiffeq(eq, y(x)):
%p A369444 rec:=diffeqtorec(de, y(x), a(n)):
%p A369444 f:= rectoproc(rec, a(n), remember):
%p A369444 map(f, [$0..35]); # _Robert Israel_, Sep 23 2026
%o A369444 (PARI) my(N=40, x='x+O('x^N)); Vec(serreverse(x/((1+x)*(1+x^4)))/x)
%o A369444 (PARI) a(n, s=4, t=1, u=1) = sum(k=0, n\s, binomial(t*(n+1), k)*binomial(u*(n+1), n-s*k))/(n+1);
%Y A369444 Cf. A036765, A198951.
%Y A369444 Cf. A365730, A387125.
%K A369444 nonn,changed
%O A369444 0,5
%A A369444 _Seiichi Manyama_, Jan 23 2024
