%S A369747 0,0,0,1,0,3,0,2,2,4,0,5,0,5,5,4,0,7,0,6,6,6,0,9,3,7,4,8,0,13,0,6,7,8,
%T A369747 7,12,0,9,8,12,0,17,0,10,10,10,0,15,4,13,9,11,0,16,8,13,10,11,0,23,0,
%U A369747 12,12,11,9,22,0,13,11,21,0,20,0,13,15,14,9,24,0,18,9
%N A369747 a(n) = Sum_{p|n, p prime} pi(n/p), where pi(n) is the number of primes <= n, A000720.
%C A369747 Dirichlet convolution of c(n) and pi(n), where c = A010051, and pi = A000720. - _Wesley Ivan Hurt_, Jun 24 2026
%H A369747 Antti Karttunen, <a href="/A369747/b369747.txt">Table of n, a(n) for n = 1..10000</a>
%F A369747 a(p^k) = pi(p^(k-1)), for p prime and k >= 1. - _Wesley Ivan Hurt_, Jun 26 2024
%F A369747 a(n) = Sum_{d|n} pi(d)*c(n/d) = Sum_{d|n} A000720(d)*A010051(n/d). - _Wesley Ivan Hurt_, Jun 24 2026
%t A369747 Table[DivisorSum[n, PrimePi[n/#] &, PrimeQ[#] &], {n, 100}]
%o A369747 (PARI) A369747(n) = { my(f=factor(n)); sum(i=1,#f~, primepi(n/f[i,1])); }; \\ _Antti Karttunen_, Nov 24 2026
%o A369747 (PARI) A369747(n) = sumdiv(n,d, isprime(d)*primepi(n/d)); \\ _Antti Karttunen_, Nov 24 2026
%Y A369747 Cf. A000040, A000720 (pi), A010051, A062774, A345301, A369745.
%K A369747 nonn,easy,changed
%O A369747 1,6
