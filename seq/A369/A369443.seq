%I A369443 #15 Sep 24 2026 01:26:22
%S A369443 1,2,5,15,52,198,796,3306,14042,60698,266235,1182315,5306085,24028162,
%T A369443 109654887,503797703,2328343326,10816971516,50487762906,236635814984,
%U A369443 1113297830297,5255647026534,24888156618738,118194065746758,562773777767295,2686074452484012
%N A369443 Expansion of (1/x) * Series_Reversion( x / ((1+x)^2 * (1+x^3)) ).
%H A369443 Robert Israel, <a href="/A369443/b369443.txt">Table of n, a(n) for n = 0..1419</a>
%H A369443 <a href="/index/Res#revert">Index entries for reversions of series</a>
%F A369443 a(n) = (1/(n+1)) * Sum_{k=0..floor(n/3)} binomial(n+1,k) * binomial(2*n+2,n-3*k).
%F A369443 D-finite with recurrence: -39858075*(3*n + 8)*(3*n + 4)*(n + 2)*(n + 1)*a(n) + 13286025*(n + 2)*(51*n^3 + 426*n^2 + 1194*n + 1115)*a(n + 1) - 10935*(39553*n^4 + 493621*n^3 + 2301041*n^2 + 4743725*n + 3645030)*a(n + 2) + 4374*(28359*n^4 + 402908*n^3 + 2095576*n^2 + 4685792*n + 3740535)*a(n + 3) - 108*(75590*n^4 + 937996*n^3 + 2953123*n^2 - 3008728*n - 18883965)*a(n + 4) - 24*(67868*n^4 + 1654616*n^3 + 15129601*n^2 + 61487026*n + 93694773)*a(n + 5) + 16*(9368*n^4 + 244416*n^3 + 2381644*n^2 + 10268181*n + 16518681)*a(n + 6) + 64*(2*n + 15)*(4*n + 31)*(n + 8)*(4*n + 33)*a(n + 7) = 0. - _Robert Israel_, Sep 23 2026
%p A369443 with(gfun):
%p A369443 eq1:= numer(z/((1+z)^2*(1+z^3))-x):
%p A369443 eq:= resultant(eq1, z-y*x, z):
%p A369443 de:=algeqtodiffeq(eq, y(x)):
%p A369443 rec:=diffeqtorec(de, y(x), a(n)):
%p A369443 f:= rectoproc(rec, a(n), remember):
%p A369443 map(f, [$0..30]); # _Robert Israel_, Sep 23 2026
%o A369443 (PARI) my(N=30, x='x+O('x^N)); Vec(serreverse(x/((1+x)^2*(1+x^3)))/x)
%o A369443 (PARI) a(n, s=3, t=1, u=2) = sum(k=0, n\s, binomial(t*(n+1), k)*binomial(u*(n+1), n-s*k))/(n+1);
%Y A369443 Cf. A198951.
%K A369443 nonn,changed
%O A369443 0,2
%A A369443 _Seiichi Manyama_, Jan 23 2024
