%N A369256 Positions of odd terms in A140773.
%C A369256 Squarefree terms are the products of an even number of distinct primes (A030229). - _Robert Israel_, Nov 19 2026
%H A369256 Robert Israel, <a href="/A369256/b369256.txt">Table of n, a(n) for n = 1..10000</a>
%p A369256 filter:= proc(n) local D,d;
%p A369256   D:= NumberTheory:-Divisors(n);
%p A369256   add(nops(select(`<=`,NumberTheory:-Divisors(n/d),d)), d = D)::odd
%p A369256 end proc:
%p A369256 select(filter, [$1..300]); # _Robert Israel_, Nov 19 2026
