%I A070945 #38 Aug 11 2026 01:07:45
%S A070945 1,1,2,6,24,96,456,2472,14736,92304,632736,4661856,36364032,297668736,
%T A070945 2583425664,23550535296,224086162176,2221083839232,22976670905856,
%U A070945 246829966447104,2745834333566976,31605782067081216,376290722808502272
%N A070945 Number of permutations on n letters that have only cycles of length 4 or less.
%D A070945 Dennis P. Walsh, The Number of Permutations with Only Small Cycles, preprint [From _Geoffrey Critzer_, May 24 2009]
%H A070945 Michael De Vlieger, <a href="/A070945/b070945.txt">Table of n, a(n) for n = 0..499</a>
%H A070945 P. L. Krapivsky and J. M. Luck, <a href="https://arxiv.org/abs/1902.04365">Coverage fluctuations in theater models</a>, arXiv:1902.04365 [cond-mat.stat-mech], 2019.
%H A070945 I. Mezo, <a href="https://arxiv.org/abs/1308.1637">Periodicity of the last digits of some combinatorial sequences</a>, arXiv preprint arXiv:1308.1637 [math.CO], 2013 and <a href="https://cs.uwaterloo.ca/journals/JIS/VOL17/Mezo/mezo19.html">J. Int. Seq. 17 (2014) #14.1.1</a> .
%H A070945 R. Petuchovas, <a href="https://arxiv.org/abs/1611.02934">Asymptotic analysis of the cyclic structure of permutations</a>, arXiv:1611.02934 [math.CO], p. 6, 2016.
%F A070945 E.g.f.: exp(x + 1/2*x^2 + 1/3*x^3 + 1/4*x^4).
%F A070945 From _Peter Bala_, Jul 30 2026: (Start)
%F A070945 a(n) = a(n-1) + (n-1)*a(n-2) + (n-1)*(n-2)*a(n-3) + (n-1)*(n-2)*(n-3)*a(n-4) with a(0) = a(1) = 1, a(2) = 2 and a(3) = 6.
%F A070945 a(n+k) == a(n)*a(k) (mod k) for n, k >= 0.
%F A070945 For k >= 1, a(k*n) == a(n)^k (mod n).
%F A070945 For k >= 1, the sequence obtained by reducing a(n) modulo k is an eventually periodic sequence. For example, modulo 10 the sequence becomes [1, 1,  2, 6, 4, 6, 6,  2, 6, 4, 6, 6,  2, 6, 4, 6, 6, ...], with period 5 starting at n = 2.
%F A070945 For n >= 1, v_2(a(2*n)) >= n, v_2(a(2*n+1)) >= n and v_2(a(2*n+1) - a(n)) >= n + 1, where v_2(n) denotes the 2-adic value of n (inductive proof using the recurrence).
%F A070945 Conjecturally, for k >= 1, the terms of the sequence are eventually divisible by 3^k. More precisely, we conjecture the following 3-adic values (each one checked up to n = 1000):
%F A070945 v_3(a(6*n)) = v_3(a(6*n+1)) = n + floor((n+1)/3);
%F A070945 v_3(a(6*n+2)) >= n + floor((n+1)/3);
%F A070945 v_3(a(6*n+3)) = v_3(a(6*n+4)) = n + floor(n/3) + 1;
%F A070945 v_3(a(6*n+5)) >= n + floor(n/3) + 1.  (End)
%p A070945 with (combstruct):a:=proc(m) [ZL, {ZL=Set(Cycle(Z, m>=card))}, labeled]; end: A:=a(4):seq(count(A, size=n), n=0..22); # _Zerinvary Lajos_, Jun 11 2008
%p A070945 # Alternative:
%p A070945 G := exp(x+(1/2)*x^2+(1/3)*x^3+(1/4)*x^4): seq(factorial(n)*coeftayl(G, x = 0, n), n = 0 .. 22); # _Emeric Deutsch_, Jun 21 2009
%t A070945 Table[Sum[Binomial[n, 4 i]*(4 i)!/(i!*4^i)* Sum[Binomial[n - 4 i, 3 j]*(3 j)!/(j!*3^j)* Sum[Binomial[n - 4 i - 3 j, 2 k]*(2 k)!/(k!*2^k), {k, 0, n}], {j, 0, n}], {i, 0, n}], {n, 0, 22}] (* _Geoffrey Critzer_, May 24 2009 *)
%t A070945 (* Alternative: *)
%t A070945 With[{nn = 23, k = 5}, CoefficientList[Exp[-Log[1 - x] + O[x]^k // Normal] + O[x]^nn, x] Range[0, nn - 1]!] (* _Michael De Vlieger_, Mar 29 2019, after _Jean-François Alcover_ at A070947 *)
%Y A070945 Cf. A000085, A057693, A070946, A070947.
%K A070945 nonn
%O A070945 0,3
%A A070945 _N. J. A. Sloane_ and Sharon Sela, May 18 2002
