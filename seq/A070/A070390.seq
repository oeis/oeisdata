%U A070390 25,37,9,1,5,25,37,9,1,5,25,37,9,1,5,25,37,9,1,5,25,37,9,1,5,25,37,9,1,5
%N A070390 a(n) = 5^n mod 44.
%C A070390 Continued fraction expansion of (sqrt(3042074029) + 45821)/84258. - _Amiram Eldar_, Aug 06 2026
%H A070390 G. C. Greubel, <a href="/A070390/b070390.txt">Table of n, a(n) for n = 0..1000</a>
%H A070390 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (0,0,0,0,1).
%F A070390 From _R. J. Mathar_, Apr 20 2010: (Start)
%F A070390 a(n) = a(n-5).
%F A070390 G.f.: ( -1-5*x-25*x^2-37*x^3-9*x^4 ) / ( (x-1)*(1+x+x^2+x^3+x^4) ). (End)
%t A070390 PowerMod[5,Range[0,90],44] (* _Harvey P. Dale_, Apr 21 2011 *)
%t A070390 (* Alternative: *)
%t A070390 LinearRecurrence[{0,0,0,0,1}, {1,5,25,37,9},90] (* _Harvey P. Dale_, Apr 21 2011 *)
%o A070390 (SageMath) [power_mod(5,n,44)for n in range(0,87)] # _Zerinvary Lajos_, Nov 26 2009
%o A070390 (PARI) a(n) = lift(Mod(5, 44)^n); \\ _Altug Alkan_, Mar 18 2016
%K A070390 nonn,easy
%O A070390 0,2
