%I A070901 #23 Aug 01 2026 16:13:05
%S A070901 1,3,8,85,103,349,361,429,500,505,1832,1895,1996,2195,2202,2290,2531,
%T A070901 2575,2688,3040,3189,3280,3792,5103,5151,7712,21398,21914,22472,22603,
%U A070901 22814,23184,23375,24368,24370,24545,24812,25015,25262,25613,26171,26680,27376,28761,29355
%N A070901 a(1)=1, a(n) is the smallest integer > a(n-1) such that the largest element in the simple continued fraction for S(n)=1/a(1)+1/a(2)+...+1/a(n) equals prime(n).
%C A070901 Sum(k >= 1} 1/a(k) < 1.5
%H A070901 David A. Corneth, <a href="/A070901/b070901.txt">Table of n, a(n) for n = 1..1000</a> (first 157 terms from Robert Israel)
%e A070901 The continued fraction for S(4)=1+1/3+1/8+1/85 is [1, 2, 7, 1, 6, 5, 1, 2] where the largest element is 7=prime(4).
%p A070901 S:= 1: R:= 1: j:= 1:
%p A070901 for n from 2 to 50 do
%p A070901   p:= ithprime(n);
%p A070901   for j from j+1 do
%p A070901    F:= NumberTheory:-ContinuedFraction(S+1/j);
%p A070901    if max(Term(F,all)) = p then break fi;
%p A070901   od;
%p A070901   R:= R,j; S:= S + 1/j;
%p A070901 od:
%p A070901 R; # _Robert Israel_, Jul 31 2026
%o A070901 (PARI) lista(n) = my(a=vector(n), s=1, t=1); a[1] = t; for(n=2, #a, my(m=prime(n)); s=s+1/t; t++; while(vecmax(contfrac(s+1/t))!=m, t++); a[n]=t); a
%K A070901 nonn,changed
%O A070901 1,2
%A A070901 _Benoit Cloitre_, May 19 2002
%E A070901 More terms from b-file made by Robert Israel. - _David A. Corneth_, Aug 01 2026
