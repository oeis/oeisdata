%I A255885 #29 Sep 12 2026 22:02:19
%S A255885 17,65,145,485,649,1297,577,2024,5185,8182,7057,8749,14401,30753,
%T A255885 56449,57601,77401,129473,51841,129601,254017,296449,202501,389377,
%U A255885 821339,762049,583201,902501,19601,470449,1822501,2073601,4120901,4064257,2822401,1587601,3484801
%N A255885 Smallest base b such that there exist exactly n Wieferich pseudoprimes (composites c satisfying b^(c-1) == 1 (mod c^2)) less than b.
%C A255885 An exhaustive computation for b <= 2000000000 determines a(n) for n = 87..96, 98..106, 117, 129, 131, and 160. The known values and unresolved entries are listed in the linked a-file; computational details and certification are provided in the linked Zenodo archive. - _Carlo Corti_, Sep 06 2026
%H A255885 Carlo Corti, <a href="/A255885/b255885.txt">Table of n, a(n) for n = 1..85</a>
%H A255885 T. Agoh, K. Dilcher, and L. Skula, <a href="https://doi.org/10.1006/jnth.1997.2162">Fermat Quotients for Composite Moduli</a>, Journal of Number Theory 66 (1997), 29-50.
%H A255885 Carlo Corti, <a href="https://doi.org/10.5281/zenodo.22519077">A255885: Interval-aware inverse root sieve and certified extension</a>, Zenodo archive, 2026.
%H A255885 Carlo Corti, <a href="/A255885/a255885.txt">Known values of a(n) for n = 1..160</a>.
%o A255885 (PARI) for(n=1, 10, b=2; while(b > 0, i=0; forcomposite(c=2, b, if(Mod(b, c^2)^(c-1)==1, i++)); if(i==n, print1(b, ", "); break({1})); b++))
%o A255885 (Python)
%o A255885 from itertools import count
%o A255885 from sympy import isprime
%o A255885 def A255885(n):
%o A255885     for b in count(1):
%o A255885         if n == sum(1 for c in range(2,b+1) if not isprime(c) and pow(b,c-1,c**2) == 1):
%o A255885             return b # _Chai Wah Wu_, May 18 2022
%Y A255885 Cf. A244752, A252232, A255901, A256517, A267288, A273785.
%K A255885 nonn,hard,changed
%O A255885 1,1
