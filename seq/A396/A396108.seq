%N A396108 Expansion of e.g.f. 1/(1 - sinh(x) - sinh(x)^2).
%F A396108 a(n) = Sum_{k=0..floor(n/2)} (n-2*k)! * A000045(n-2*k+1) * A136630(n,n-2*k).
%F A396108 a(0) = 1; a(n) = Sum_{k=0..floor((n-1)/2)} binomial(n,2*k+1) * a(n-2*k-1) + 2 * Sum_{k=1..floor(n/2)} 4^(k-1) * binomial(n,2*k) * a(n-2*k).
%F A396108 a(n) ~ 2*n! / (sqrt(10*(5 - sqrt(5))) * log(2/(1 - sqrt(5) + sqrt(10 - 2*sqrt(5))))^(n+1)). - _Vaclav Kotesovec_, Aug 17 2026
%o A396108 (PARI) my(N=30, x='x+O('x^N)); Vec(serlaplace(1/(1-sinh(x)-sinh(x)^2)))
