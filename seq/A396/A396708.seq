%S A396708 1,3,23,31,1721,609,293679,5323,1991573,4118807,1714417503,2761249,
%T A396708 1182667697873,6902164877,13723818368263,101859913599,
%U A396708 1365666332203558537,38170651863,32683788506905343311,12248312522521419,22851854738964410661,341546942528359361
%N A396708 Numerators of Sum_{k=1..n} n^2/(k^2 + (n-k)^2).
%C A396708 Let R(n) = Sum_{k=1..n} n^2/(k^2 + (n-k)^2), so that a(n) is the numerator of R(n).
%C A396708 The rational sequence R(n) arises from the exact telescoping specialization r = 2/n^2 of the family S(r) = Sum_{k>=1} 2*sqrt(2*r)*k/(1 + r^2*k^4).
%C A396708 The limit R(n)/n -> Pi/2 follows from its Riemann-sum interpretation.
%C A396708 a(n) is odd.
%H A396708 Ginés Pérez Teruel, <a href="https://periodicos.uem.br/ojs/index.php/BSocParanMat/article/view/78986">A Diophantine Identity of Sophie Germain Type and a Telescoping Family of Series with Zeta Asymptotics</a>, Bol. Soc. Paran. Mat. (3s.), 44 (2026), no. 6, 1-16.
%F A396708 a(n) = numerator(Sum_{k=1..n} n^2/(k^2 + (n-k)^2)).
%F A396708 a(n) = numerator(Sum_{k=1..n} 1/(1 - 2*k/n + 2*k^2/n^2)).
%F A396708 a(n)/A399057(n) = Pi*n/2 - 1/(3*n) + O(n^(-3)).
%e A396708 1/1, 3/1, 23/5, 31/5, 1721/221, 609/65, ...
%t A396708 a[n_] := Numerator[Together[Sum[n^2/(k^2 + (n - k)^2), {k, 1, n}]]]
%t A396708 Table[a[n], {n, 1, 20}]
%Y A396708 Cf. A399057 (denominators).
%K A396708 frac,nonn,new
%O A396708 1,2
%A A396708 _Ginés Pérez Teruel_, Aug 17 2026
