%T A396757 54485,71333,83777,117725,130645,177557,207145,250597,280325,378505,
%U A396757 401041,487985,561289,675049,708065,926245,924421,1141669,1252985,1424209,1562117,1918225,1875457,2220965,2439925,2854373
%N A396757 a(n) = Sum_{1 <= x_1, x_2, x_3, x_4 <= n} gcd(x_1, x_2, x_3, n)/gcd(x_1, x_2, x_3, x_4, n).
%H A396757 Amiram Eldar, <a href="/A396757/b396757.txt">Table of n, a(n) for n = 1..10000</a>
%F A396757 a(n) = Sum_{d|n} J_3(n/d) * (n/d) * sigma_2(d^2)/sigma(d^2), where J_k is the k-th Jordan totient function.
%F A396757 Multiplicative with a(p^e) = (p^(4*e)*(p^2+p+1)^2 - p^(2*e)*(p^2+1) + 1)/((p+1)^2*(p^2+1)).
%F A396757 From _Amiram Eldar_, Aug 13 2026: (Start)
%F A396757 Dirichlet g.f.: zeta(s)*zeta(s-2)*zeta(s-4)/zeta(s-1)^2.
%F A396757 Sum_{k=1..n} a(k) ~ c * n^5, where c = zeta(3)*zeta(5)/(5*zeta(4)^2) = 0.212808788393017729835... . (End)
%t A396757 f[p_, e_] := (p^(4*e)*(p^2 + p + 1)^2 - p^(2*e)*(p^2 + 1) + 1)/((p + 1)^2*(p^2 + 1)); a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 40] (* _Amiram Eldar_, Aug 13 2026 *)
%o A396757 (PARI) J(n, k) = sumdiv(n, d, d^k*moebius(n/d));
%o A396757 a(n) = sumdiv(n, d, J(n/d, 3)*n/d*sigma(d^2, 2)/sigma(d^2));
%o A396757 (PARI) a(n) = {my(f = factor(n), p, e); prod(i = 1, #f~, p=f[i,1]; e=f[i,2]; (p^(4*e)*(p^2+p+1)^2 - p^(2*e)*(p^2+1) + 1)/((p+1)^2*(p^2+1)));} \\ _Amiram Eldar_, Aug 13 2026
