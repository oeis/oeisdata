%S A396529 1,1,2,3,5,7,12,20,33,60,106,193,354,661,1229,2315,4371,8289,15777,
%T A396529 30109,57613,110510,212382,408897,788557,1522938,2945201,5702675,
%U A396529 11054271,21450158,41662844,80994478,157588421,306854875,597945020,1165978872,2275122922,4442105498
%N A396529 Number of compositions of n such that the set of parts of each composition covers an interval and parts appear in order.
%C A396529 The smallest part of each composition is the first part and for subsequent parts, part c must appear before b where c = b - 1.
%H A396529 Alois P. Heinz, <a href="/A396529/b396529.txt">Table of n, a(n) for n = 0..3333</a>
%F A396529 G.f.: 1 + Sum_{n>0} q^n * B(n,q)/(1 - q^n), where B(n,q) is the n-th row polynomial of A126347.
%e A396529 a(5) = 7: (1,1,1,1,1), (1,1,1,2), (1,1,2,1), (1,2,1,1), (1,2,2), (2,3), (5).
%p A396529 b:= proc(n, i, m) option remember; `if`(n=0, 1,
%p A396529       `if`(n<i, 0, `if`(i=0, add(b(n-j, j$2), j=1..n),
%p A396529        add(b(n-j, i, max(m, j)), j=i..min(n, m+1)))))
%p A396529     end:
%p A396529 a:= n-> b(n, 0$2):
%p A396529 seq(a(n), n=0..37);  # _Alois P. Heinz_, Aug 18 2026
%o A396529 (PARI)
%o A396529 B_nlist(N) = {my(B = vector(N+1,i,0^(i-1))); for(i=1,N, B[i+1] = sum(k=0,i-1, binomial(i-1,k)*B[k+1]*q^k)); return(B)}
%o A396529 A_q(N) = {my(q='q+O('q^(N+1)), B = B_nlist(N)); Vec(1 + sum(m=1,N, q^m *B[m+1]/(1-q^m)))}
%Y A396529 Cf. A000110, A011782, A126347, A383253, A383713.
%K A396529 nonn
%O A396529 0,3
%A A396529 _John Tyler Rascoe_, Aug 17 2026
