%S A396974 1,1,1,1,1,3,3,1,6,15,16,3,1,10,45,110,140,72,10,1,15,105,435,1125,
%T A396974 1773,1560,660,105,10,1,21,210,1295,5355,15204,29344,37110,28875,
%U A396974 12670,2961,420,35,1,28,378,3220,19075,81900,258510,598000,996975,1163540,913528,462336,147728,31360,5040,616,35
%N A396974 Irregular triangle read by rows: T(n,k) is the number of labeled triangle-free graphs on n nodes with exactly k edges, 0 <= k <= floor(n^2/4).
%C A396974 By Mantel's theorem a triangle-free graph on n nodes has at most floor(n^2/4) edges.
%H A396974 Sean A. Irvine, <a href="/A396974/b396974.txt">Table of n, a(n) for n = 0..266</a> (rows 0..14; rows 1..9 from Brian Klemm, row 10 from Andrew Howroyd).
%H A396974 Brian Klemm, <a href="https://brianklemm.com/publications/CliqueBlockWeighting.pdf">Counting Clique-Containing Graphs by Transitive Block Weighting</a>, 2026.
%F A396974 T(n,k) = binomial(binomial(n,2),k) for k <= 2.
%e A396974 Triangle begins:
%e A396974   n=0:  1;
%e A396974   n=1:  1;
%e A396974   n=2:  1, 1;
%e A396974   n=3:  1, 3, 3;
%e A396974   n=4:  1, 6, 15, 16, 3;
%e A396974   n=5:  1, 10, 45, 110, 140, 72, 10;
%e A396974   n=6:  1, 15, 105, 435, 1125, 1773, 1560, 660, 105, 10;
%e A396974   ...
%o A396974 (Python)
%o A396974 from itertools import combinations
%o A396974 def row(n):
%o A396974     E = list(combinations(range(n), 2)); N = len(E)
%o A396974     cnt = [0]*(N+1); adj = [0]*n
%o A396974     def dfs(i, k):
%o A396974         cnt[k] += 1
%o A396974         for e in range(i, N):
%o A396974             u, v = E[e]
%o A396974             if adj[u] & adj[v]: continue          # would close a triangle
%o A396974             adj[u] |= 1<<v; adj[v] |= 1<<u
%o A396974             dfs(e+1, k+1)
%o A396974             adj[u] &= ~(1<<v); adj[v] &= ~(1<<u)
%o A396974     dfs(0, 0)
%o A396974     return cnt[:n*n//4 + 1]
%o A396974 print([x for n in range(9) for x in row(n)])
%Y A396974 Cf. A213434 (row sums), A002620, A084546 (all labeled graphs), A399108 (K_4-free analog).
