%I A396113 #37 Aug 18 2026 00:07:36
%S A396113 0,2,6,4,20,10,42,8,18,28,110,20,156,54,64,16,272,30,342,56,120,130,
%T A396113 506,40,100,180,54,108,812,80,930,32,280,304,288,60,1332,378,384,112,
%U A396113 1640,144,1806,260,192,550,2162,80,294,140,640,360,2756,90,640,216,792
%N A396113 a(n) = sopf(n) * phi(n), where sopf = A008472 and phi = A000010.
%C A396113 All terms are even.
%F A396113 a(n) = A008472(n) * A000010(n).
%F A396113 a(p) = p^2 - p for prime p.
%e A396113 For n = 2: The only distinct prime factor is 2, so sopf(2) = 2. The positive integers less than or equal to 2 that are coprime to 2 is {1}, so phi(2) = 1. Thus, a(2) = 2 * 1 = 2.
%e A396113 For n = 3: The only distinct prime factor is 3, so sopf(3) = 3. The positive integers less than or equal to 3 that are coprime to 3 are {1, 2}, so phi(3) = 2. Thus, a(3) = 3 * 2 = 6.
%e A396113 For n = 4: The only distinct prime factor is 2, so sopf(4) = 2. The positive integers less than or equal to 4 that are coprime to 4 are {1, 3}, so phi(4) = 2. Thus, a(4) = 2 * 2 = 4.
%p A396113 a := proc(n)
%p A396113     if n = 1 then return 0; fi;
%p A396113     return add(p, p in factorset(n)) * phi(n);
%p A396113 end proc:
%p A396113 seq(a(n), n=1..40);
%o A396113 (PARI) a(n) = my(f=factor(n)); vecsum(f[, 1]~) * eulerphi(f);
%Y A396113 Cf. A008472 (sum of distinct prime factors), A000010 (Euler totient).
%K A396113 nonn,easy,new
%O A396113 1,2
%A A396113 _Sajid Khan Hussain_, Aug 10 2026
