%N A396701 a(n) = Sum_{d|n} tau_3(d) * sigma(n/d).
%F A396701 Multiplicative with a(p^e) = Sum_{k=0..e} binomial(e-k+3,e-k) * p^k.
%F A396701 Dirichlet g.f.: zeta(s-1) * zeta(s)^4.
%F A396701 a(n) = Sum_{d|n} tau_5(d) * phi(n/d).
%F A396701 a(n) = n * Sum_{d|n} tau_4(d) / d.
%F A396701 a(n) = Sum_{d|n} tau(d) * A007429(n/d).
%F A396701 a(n) = Sum_{d|n} A007430(d).
%t A396701 f[p_, e_] := Sum[Binomial[e - k + 3, e - k] p^k, {k, 0, e}]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Table[a[n], {n, 1, 70}]
