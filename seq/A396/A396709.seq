%I A396709 #30 Aug 06 2026 19:31:33
%S A396709 2,10,42,170,602,1626,3626,7082,12570,20762,32426,48426,69722,97370,
%T A396709 132522,176426,230426,295962,374570,467882,577626,705626,853802,
%U A396709 1024170,1218842,1440026,1690026,1971242,2286170,2637402,3027626,3459626,3936282,4460570,5035562,5664426,6350426
%N A396709 Partial sums of A396280.
%C A396709 The total number of coordinate entries across the first n cyclic squares (Bassey, 2026).
%D A396709 B. G. Bassey, Cyclic Squares: The Discovery of a New Combinatorial Structure, First Edition, Glasgow, United Kingdom, 2026. ISBN 9798198234383.
%H A396709 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (5,-10,10,-5,1).
%F A396709 a(n) = 26 + 4*((n-1)*(n-2))^2 for n >= 3; a(1) = 2, a(2) = 10.
%F A396709 a(n) = 5*a(n-1) - 10*a(n-2) + 10*a(n-3) - 5*a(n-4) + a(n-5) for n >= 8.
%F A396709 G.f.: 2*x*(1 + 6*x^2 + 20*x^3 + 41*x^4 - 28*x^5 + 8*x^6)/(1 - x)^5. - _Stefano Spezia_, Aug 01 2026
%e A396709 a(5) = 26 + 4*(4*3)^2 = 26 + 576 = 602, matching A396280(1)+...+A396280(5) = 2+8+32+128+432 = 602.
%o A396709 (PARI) a(n) = if(n==1, 2, if(n==2, 10, 26 + 4*((n-1)*(n-2))^2));
%Y A396709 Cf. A396280 (first differences).
%K A396709 nonn,easy,new
%O A396709 1,1
%A A396709 _Bassey Godwin Bassey_, Jul 26 2026
