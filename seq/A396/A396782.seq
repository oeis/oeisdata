%S A396782 1,2,4,6,10,14,21,29,40,56,72,94,123,155,192,238,294,358,425,504,596,
%T A396782 702,823,951,1088,1242,1414,1605,1816,2048,2302,2558,2835,3136,3462,
%U A396782 3814,4193,4600,5036,5502,5999,6511,7040,7602,8198,8829,9496,10200,10942,11723
%N A396782 Index of 2^n - 1 in A007665.
%H A396782 Jianing Song, <a href="/A396782/b396782.txt">Table of n, a(n) for n = 1..10000</a>
%H A396782 Jianing Song, <a href="/A396782/a396782.pdf">Finding the index of 2^n - 1 in A007665</a>.
%F A396782 Set f(k) = k + 2^(k/2) - 1/2. For n >= 1, suppose that f(k) < n < f(k+1), then a(n) = -1 + (n-k)^3/6 + 5*(n-k)/6 + 2^k.
%e A396782 Let b(n) = A007665(n) be number of moves needed to solve the Towers of Hanoi puzzle with 5 pegs and n disks, then b(1) = 1, b(2) = 3, b(4) = 7, b(6) = 15, b(10) = 31, ...
%o A396782 (PARI) a(n) = my(k = logint(n^2,2), m); while(n<k+2^(k/2)-1/2, k--); m=n-k; return(-1+(m^3+5*m)/6+2^k)
%Y A396782 Cf. A127419 (indices of {2^n+1} in A007664), A396783 (indices of {2^n+1} in A182058).
%K A396782 nonn,new
%O A396782 1,2
%A A396782 _Jianing Song_, Sep 02 2026
