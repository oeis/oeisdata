%U A396947 1978419655651397488675723,20880467999847900922348207352551,6156119580207156483556412402063439599,205891132094648999998021580344339686410876021
%N A396947 Primes of the form x^^y - w^^z, where x >= w >= 2 and y >= z >= 2, and ^^ denotes tetration.
%C A396947 Since x^^y has the same parity as x, in every representation of a term as x^^y - w^^z, exactly one of x and w is even.
%C A396947 No term can be of the form x^^y - x^^z: if y > z, then x^^y - x^^z is divisible by x^^z > 1, while, for y = z, x^^y - x^^z = 0.
%H A396947 MathOverflow, <a href="https://mathoverflow.net/questions/514251/are-there-infinitely-many-primes-of-the-form-hspace1mm-b-a-pm-a-b-w">Are there infinitely many primes of the form a^^b +- b^^a, with integers a, b >= 2?</a>.
%e A396947 a(1) = 3^^2 - 2^^2.
%e A396947 a(2) = 4^^2 - 3^^2.
%e A396947 a(3) = 5^^2 - 2^^2.
%e A396947 a(4) = 7^^2 - 6^^2.
%e A396947 a(5) = 8^^2 - 5^^2.
%o A396947 (Python)
%o A396947 from sympy import isprime
%o A396947 def tet(a,b,m):
%o A396947     x=a
%o A396947     for _ in range(b-1):
%o A396947         if x>=m.bit_length():
%o A396947             return m+1
%o A396947         x=a**x
%o A396947     return x
%o A396947 def a(n):
%o A396947     m=32
%o A396947     while True:
%o A396947         T=[]
%o A396947         r=2
%o A396947         while r**r<=2*m:
%o A396947             s=2
%o A396947             while (v:=tet(r,s,2*m))<=2*m:
%o A396947                 T.append((r,s,v))
%o A396947                 s+=1
%o A396947             r+=1
%o A396947         A=sorted({v-u for r,s,v in T for q,t,u in T
%o A396947                   if r>=q and s>=t and 0<v-u<=m and isprime(v-u)})
%o A396947         if len(A)>=n:
%o A396947             return A[n-1]
%o A396947         m*=2
%o A396947 print([a(n) for n in range(1,15)])
