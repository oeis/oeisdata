%S A396698 1,1,1,2,8,41,267,2187,21657,254160,3485514,55030435,987810795,
%T A396698 19970573153,451128798205,11303889953992,312142647514418,
%U A396698 9446161929610103,311752902877034989,11171060060635782383,432869891169544130041,18072611597503231615914,810321820344405547872460
%N A396698 Number of n X n upper triangular binary matrices in which every row and every column has sum 0 or 2.
%C A396698 Equivalently, a(n) is the number of bipartite graphs with vertex classes {L_1,...,L_n} and {R_1,...,R_n}, where L_i can be adjacent to R_j only if i <= j, and every nonisolated vertex has degree 2.
%H A396698 Alois P. Heinz, <a href="/A396698/b396698.txt">Table of n, a(n) for n = 0..346</a>
%H A396698 Vladeta Jovovic, <a href="/A396698/a396698_2.png">The 8 matrices and corresponding bipartite graphs for n=4</a>.
%F A396698 Let T = v*(1+(1/2)*d/du+u*(d/du+d/dv)^2), P_0(u,v) = v, and P_{n+1}(u,v) = T P_n(u,v). Then a(n) = P_n(0,1).
%F A396698 If a(n,k) is the number of matrices counted by a(n) having exactly k zero rows (equivalently, k zero columns), then Sum_{k=0..n} a(n,k)*v^(k+1) = P_n(0,v).
%F A396698 More generally, let T_t = v*(1+(t/2)*d/du+u*(d/du+d/dv)^2), P_0(u,v;t) = v, and P_{n+1}(u,v;t) = T_t P_n(u,v;t). Then C_n(t) = P_n(0,1;t) is the generating polynomial for the number of cycles in the corresponding bipartite graphs.
%e A396698 The first polynomials P_n(u,v) are P_0=v, P_1=v^2, P_2=v^3+2*u*v, P_3=v^4+v^2+8*u*v^2+4*u*v, P_4=v^5+5*v^3+2*v^2+20*u*v^3+36*u*v^2+10*u*v+16*u^2*v; hence a(0),...,a(4)=1,1,1,2,8.
%e A396698 P_0(0,v)=v, P_1(0,v)=v^2, P_2(0,v)=v^3, P_3(0,v)=v^4+v^2, and P_4(0,v)=v^5+5*v^3+2*v^2. The coefficient of v^(k+1) in P_n(0,v) is the number of matrices having exactly k zero rows (equivalently,k zero columns).
%e A396698 C_5(t) = 1 + 39*t + t^2, since among the 41 graphs counted by a(5), 1 has no cycles, 39 have one cycle, and 1 has two cycles.
%p A396698 T:= f-> v*(f+diff(f, u)/2+u*((g-> diff(g, u)+diff(g, v))@@2)(f)):
%p A396698 p:= proc(n) option remember; `if`(n=0, v, expand(T(p(n-1)))) end:
%p A396698 a:= n-> subs(u=0, v=1, p(n)):
%p A396698 seq(a(n), n=0..22);  # _Alois P. Heinz_, Sep 21 2026
%o A396698 (Python)
%o A396698 import sympy as sp
%o A396698 u,v=sp.symbols('u v')
%o A396698 p=v
%o A396698 for n in range(23):
%o A396698     print(n,p.subs({u:0,v:1}))
%o A396698     p=sp.expand(v*(p+sp.diff(p,u)/2+u*(sp.diff(p,u,2)+2*sp.diff(p,u,v)+sp.diff(p,v,2))))
%Y A396698 Cf. A001499 (n X n binary matrices with exactly two 1's in each row and column), A195885.
%K A396698 nonn,new
%O A396698 0,4
%A A396698 _Vladeta Jovovic_, Sep 20 2026
