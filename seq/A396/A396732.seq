%S A396732 0,0,0,1,1,4,14,130,1981,62616,2806508,158937367,10773254138,
%T A396732 855658147835,78558952717697,8251166899391905,982806390787024038,
%U A396732 131756175056788118280,19748565975967016243119,3289970442222096451929444,605948437043763561137063765
%N A396732 Number of equivalence classes of n X n binary matrices with all row sums and column sums equal to 4, under row permutations, column permutations, and transposition.
%H A396732 Miles Lord, <a href="/A396732/b396732.txt">Table of n, a(n) for n = 1..24</a>
%F A396732 a(n) = (A000513(n) + A000843(n))/2.
%F A396732 a(n) >= A333730(n).
%e A396732 For n = 14 there are 855658147832 4-regular bipartite graphs on 14+14 nodes (A333730), but a(14) = 855658147835: the excess 3 counts the unordered pairs of two chiral components on 7+7 nodes each (2 chiral pairs give 2*3/2 = 3 such combinations), which are single graphs but distinct matrix classes.
%Y A396732 First differs from A333730 at n = 14.
%Y A396732 Cf. A333732, A000513, A000843, A004066 (the k=3 member of this family), A396753 (k=5).
%K A396732 nonn,new
%O A396732 1,6
%A A396732 _Miles Lord_, Aug 27 2026
