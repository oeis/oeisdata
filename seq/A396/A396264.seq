%I A396264 #28 Oct 03 2026 15:36:56
%S A396264 60,728,60512,1099176108032,288229001763749888
%N A396264 Numbers j such that Sum_{d|j, d < j} (-1)^d * d is equal to j.
%C A396264 Numbers k such that A058344(k) = -k.
%C A396264 a(4) > 10^10. - _Amiram Eldar_, May 22 2026
%C A396264 From _Rus Zay_, Sep 23 2026: (Start)
%C A396264 Terms are even. Writing j = 2^k*m with m odd, j is a term iff sigma(m)*(2^(k+1)-3) = 2^(k+1)*m; in particular 2^(k+1)-3 divides m.
%C A396264 The known terms are all of the form 2^p*(2^p-1)*(2^(p+1)-3) with 2^p-1 and 2^(p+1)-3 both prime, i.e., p = 2, 3, 5, 13, 19. No further p of this kind among the first 20 Mersenne exponents.
%C A396264 a(6) > 10^18. (End)
%H A396264 Rus Zay, <a href="/A396264/a396264.txt">C program</a>.
%e A396264 60 is a term since 60 has 11 proper divisors {1, 2, 3, 4, 5, 6, 10, 12, 15, 20, 30} and -1 + 2 - 3 + 4 - 5 + 6 + 10 + 12 - 15 + 20 + 30 = 60.
%t A396264 f[p_, e_] := If[p == 2, 3 - 2^(e + 1), (p^(e + 1) - 1)/(p - 1)]; q[1] = False; q[k_] := Times @@ f @@@ FactorInteger[k] == k*(-(-1)^k - 1); Select[Range[10^5], q] (* _Amiram Eldar_, May 20 2026 *)
%o A396264 (PARI) isok(k) = {my(f = factor(k)); prod(i = 1, #f~, if(f[i,1] == 2, 3 - 2^(f[i,2] + 1), (f[i,1]^(f[i,2] + 1) - 1)/(f[i,1] - 1))) == k*(-(-1)^k - 1);} \\ _Amiram Eldar_, May 20 2026
%Y A396264 Cf. A000396, A002129, A058344, A348583.
%K A396264 nonn,more,changed
%O A396264 1,1
