%I A396627 #9 Nov 18 2026 15:00:34
%S A396627 5,16,120,55440,267154604196480000
%N A396627 a(1) = 5; thereafter a(n+1) = least k with a(n) divisors.
%t A396627 minDiv[d_] := Module[{g}, g[1, b_, i_] := 1; g[m_, b_, i_] := g[m, b, i] =
%t A396627 Min[Table[ Prime[i]^(q - 1) g[m/q, q, i + 1], {q, Select[Divisors[m], 1 < # <= b &]}
%t A396627  ]]; g[d, d, 1] ]; NestList[minDiv, 5, 4] (* _Vincenzo Librandi_, Nov 12 2026 *)
%o A396627 (Magma) function g(m,b,i) if m eq 1 then return 1; end if; V := [NthPrime(i)^(q-1)*g(m div q,q,i+1)
%o A396627 : q in Divisors(m) | 1 lt q and q le b]; V := [x : x in V | x gt 0];return #V eq 0
%o A396627 select 0 else Min(V);end function; minDiv := func<d | g(d,d,1)>; L := [5]; for j in [1..4]
%o A396627 do v := minDiv(L[#L]);if v eq 0 then break; end if; Append(~L,v); end for; L; // _Vincenzo Librandi_, Nov 12 2026
