%S A396146 1,1,4,18,132,1140,12600,161280,2414160,40778640,772934400,
%T A396146 16181272800,371495678400,9270866404800,249989198659200,
%U A396146 7241246812800000,224266644489888000,7394638814218656000,258627987363537792000,9563202745771042368000,372757850968184922240000,15275486215276368681600000
%N A396146 Expansion of e.g.f. 1/sqrt((1-x^2)*(1-2*x)).
%C A396146 Divided by n!, these are the coefficients c_n in (2.45) and (2.46) in the article by Deléglise and Nicolas, which are needed in the calculation for A395934.
%H A396146 Robert Israel, <a href="/A396146/b396146.txt">Table of n, a(n) for n = 0..402</a>
%H A396146 Marc Deléglise and Jean-Louis Nicolas, <a href="https://doi.org/10.1017/S1446788718000083">An arithmetic equivalence of the Riemann hypothesis</a>, Journal of the Australian Mathematical Society, Volume 106, Issue 2, April 2019, pp. 235-273.
%F A396146 D-finite with recurrence: (3 + 2*n)*(n + 2)*(n + 1)*a(n) + (-n - 2)*(n + 2)*a(n + 1) + (-5 - 2*n)*a(n + 2) + a(n + 3) = 0. - _Robert Israel_, Oct 20 2026
%F A396146 a(n) ~ 2^(n + 3/2) * n^n / (sqrt(3) * exp(n)). - _Vaclav Kotesovec_, Oct 21 2026
%p A396146 with(gfun):
%p A396146 eq:= y^2*(1-x^2)*(1-2*x)-1:
%p A396146 de:= eval(algeqtodiffeq(eq,y(x)),RootOf(_Z^2-1)=1):
%p A396146 erec:= diffeqtorec(de,y(x),b(n)):
%p A396146 rec:= collect(eval((n+1)*(n+2)*erec[1],{seq(b(n+i)=a(n+i)/mul(n+j,j=1..i),i=0..3)}),a):
%p A396146 f:= rectoproc({rec,a(0)=1,a(1)=1,a(2)=4},a(n),remember):
%p A396146 map(f, [$0..30]); # _Robert Israel_, Oct 20 2026
%o A396146 (PARI) my(x='x+O('x^22)); Vec(serlaplace(1/sqrt((1-x^2)*(1-2*x))))
%Y A396146 Cf. A395934.
%K A396146 nonn,changed
%O A396146 0,3
%A A396146 _Hugo Pfoertner_, May 18 2026
