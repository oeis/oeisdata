%U A396080 761555609,1989370291,5208187599,13662915689,35910791152,94552928076,249369652061,658696065514,1742441700899
%N A396080 Number of rooted trees with total node weight n where nodes have positive integer weights and no node has the same weight as its parent node.
%F A396080 G.f.: A(x) = Sum_{i>0} B_i(x) where B_i(x) = x^i * exp( Sum_{k>0} (A(x^k) - B_i(x^k))/k ).
%e A396080 a(4) = 5: (4)   (3)   (1)    (2)    (1)
%e A396080                  |     |     / \     |
%e A396080                 (1)   (3)  (1) (1)  (2)
%e A396080                                      |
%e A396080                                     (1).
%o A396080 (PARI)
%o A396080 A_x(N) = { my(B=vector(N,i,x^i)); for(i=1,N, my(R=vecsum(B)); for(j=1,N, my(S= sum(k=1,N, ( subst(R, x, x^k + 'x*O(x^(N+1))) - subst(B[j], x, x^k + 'x*O(x^(N+1))))/k )); B[j] = x^j * exp(S) + O(x^(N+1)))); concat([0],Vec(vecsum(B))) }
%Y A396080 Cf. A000081, A036249, A384747, A384748, A399985.
