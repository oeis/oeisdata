%N A396702 a(n) = Sum_{d|n} tau_4(d) * sigma(n/d).
%H A396702 Amiram Eldar, <a href="/A396702/b396702.txt">Table of n, a(n) for n = 1..10000</a>
%F A396702 Multiplicative with a(p^e) = Sum_{k=0..e} binomial(e-k+4,e-k) * p^k.
%F A396702 Dirichlet g.f.: zeta(s-1) * zeta(s)^5.
%F A396702 a(n) = Sum_{d|n} tau_6(d) * phi(n/d).
%F A396702 a(n) = n * Sum_{d|n} tau_5(d) / d.
%F A396702 a(n) = Sum_{d|n} tau_3(d) * A007429(n/d).
%F A396702 a(n) = Sum_{d|n} tau(d) * A007430(n/d).
%F A396702 Sum_{k=1..n} a(k) ~ (Pi^10/15552) * n^2. - _Amiram Eldar_, Sep 02 2026
%t A396702 f[p_, e_] := Sum[Binomial[e - k + 4, e - k] p^k, {k, 0, e}]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Table[a[n], {n, 1, 70}]
%o A396702 (PARI) a(n) = my(f = factor(n)); prod(i = 1, #f~, sum(k = 0, f[i,2], binomial(f[i,2]-k+4, f[i,2]-k)*f[i,1]^k)); \\ _Amiram Eldar_, Sep 02 2026
