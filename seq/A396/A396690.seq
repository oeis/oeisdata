%N A396690 Number of permutations p of [n+2] such that |p(i+1)-p(i)| <> n for all 1 <= i < n+2.
%F A396690 a(n) = A398634(n+2,n).
%F A396690 a(n) = Sum_{k=0..2} (-2)^k * binomial(2,k) * (n+2-k)! for n >= 2.
%o A396690 (PARI) a(n) = my(v=[2, 0]); if(n<2, v[n+1], sum(k=0, 2, (-2)^k*binomial(2, k)*(n+2-k)!));
%Y A396690 Diagonal of A398634.
%Y A396690 Cf. A062119, A397570, A398631, A398632.
