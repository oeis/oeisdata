%S A396783 2,3,5,7,11,17,25,38,54,78,110,150,212,276,367,495,623,797,1027,1283,
%T A396783 1580,1956,2424,2936,3510,4205,5037,6023,7047,8205,9554,11114,12906,
%U A396783 14952,17000,19323,21947,24897,28199,31880,35968,40064,44588,49578,55065,61081,67659
%N A396783 Index of 2^n + 1 in A182058.
%H A396783 Jianing Song, <a href="/A396783/b396783.txt">Table of n, a(n) for n = 1..10000</a>
%H A396783 Jianing Song, <a href="/A396783/a396783.pdf">Finding the index of 2^n + 1 in A182058</a>.
%F A396783 Set f(s) = s + F(2^(s-1)) - 1, where F in the inverse function of (x^3+5*x)/6. For n >= 1, suppose that f(s) < n <= f(s+1), then a(n) = 1 + (n-s-1)*(n-s)*((n-s)^2+3*(n-s)+14)/24 + 2^s.
%e A396783 Let b(n) = A182058(n) be number of moves needed to solve the Towers of Hanoi puzzle with 6 pegs and n disks, then b(2) = 3, b(3) = 5, b(5) = 9, b(7) = 17, b(11) = 33, ...
%o A396783 (PARI) a(n) = my(s = logint((n^3+5*n)/6, 2), m); while(((n-s+1)^3+5*(n-s+1))/6<2^(s-1), s--); k=n-s; return(1+k*(k-1)*(k^2+3*k+14)/24+2^s)
%Y A396783 Cf. A127419 (indices of {2^n+1} in A007664), A396782 (indices of {2^n-1} in A007665).
%K A396783 nonn,new
%O A396783 1,1
%A A396783 _Jianing Song_, Sep 02 2026
