%S A396951 0,1,0,1,0,2,0,1,1,3,2,2,2,1,1,3,0,2,0,1,0,1,0,2,2,4,1,3,2,3,2,1,0,4,
%T A396951 0,2,0,3,0,3,2,1,1,1,3,2,2,1,0,3,0,2,0,1,0,3,2,3,1,1,1,5,2,2,0,4,0,2,
%U A396951 0,5,0,1,1,4,2,3,1,3,1,2,0,5,0,1,0,2,0,3,1,3,1
%N A396951 Sprague-Grundy value of the subtraction game on a pile of n counters in which a player subtracts any positive square if n == 1 (mod 4), and otherwise subtracts 3, 8, or 9.
%C A396951 The sequence itself does not appear to be eventually periodic: no period p <= 2000 with preperiod <= 200 fits the first 10001 terms, and every value in 0..23 is attained for n <= 10000.
%C A396951 The game arose from an automated search over "mode-switching" subtraction games, whose legal moves depend on n modulo a fixed m.
%H A396951 Hamza Gul Hassan, <a href="/A396951/b396951.txt">Table of n, a(n) for n = 0..10000</a>
%H A396951 Hamza Gul Hassan, <a href="https://github.com/hamzagul07/gamehunter/blob/main/paper/main.pdf">Chains, Clearings, and Rebels: Solving a Family of Mode-Switching Subtraction Games</a>, preprint, 2026.
%F A396951 a(n) = 0 if and only if n == 0, 2, 4, or 6 (mod 16); see the Hassan link.
%e A396951 For n = 5: since 5 == 1 (mod 4), the legal moves subtract the squares 1 and 4, reaching positions 4 and 1 with values a(4) = 0 and a(1) = 1; the smallest nonnegative integer not in {0, 1} is 2, so a(5) = 2.
%o A396951 (Python)
%o A396951 from functools import lru_cache
%o A396951 import sys
%o A396951 sys.setrecursionlimit(100000)
%o A396951 @lru_cache(maxsize=None)
%o A396951 def a(n):
%o A396951     if n % 4 == 1:
%o A396951         opts = []
%o A396951         k = 1
%o A396951         while k * k <= n:
%o A396951             opts.append(a(n - k * k))
%o A396951             k += 1
%o A396951     else:
%o A396951         opts = [a(n - s) for s in (3, 8, 9) if s <= n]
%o A396951     m = 0
%o A396951     while m in opts:
%o A396951         m += 1
%o A396951     return m
%o A396951 print([a(n) for n in range(91)])
%Y A396951 Cf. A030193.
%K A396951 nonn,new
