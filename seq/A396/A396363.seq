%I A396363 #36 Nov 15 2026 19:33:04
%S A396363 1,6,30,144,606,1002,8856,65664,141048,551484,1065096,14369358,
%T A396363 16495194,145799526,3120623748,4798998360,36549049998,46535355966,
%U A396363 662919512508,988496761674,24137244286770,26688254956950,1061103265910850,2685481116356262,9267684799858524
%N A396363 Numbers k >= 1 for which a record number of trailing digits in 2 different bases are equal.
%C A396363 Conjecture: a(8) = 65664 (= 10100002000_3 = 100002000_4) is the largest term for which a base other than 2 or 3 gives rise to the record.
%e A396363 a(1) = 1: 1 matching digit in all bases.
%e A396363 a(2) = 6: 6 = 110_2 = 10_6, 2 matching trailing digits.
%e A396363 a(3) = 30: 30 = 11110_2 = 110_5, 3 matching trailing digits.
%e A396363 a(4) = 144: 144 = 12100_3 = 2100_4, 4 matching trailing digits.
%o A396363 (PARI) my(r=-oo); for(k=1, 10^12, for(b1=3, oo, my(d1=Vecrev(digits(k, b1))); if(#d1<=r, break); for(b2=2, b1-1, my(d2=Vecrev(digits(k, b2))); if(#d2<=r, break(2)); my(c=0); while(c+1<=#d1 && d1[c+1]==d2[c+1], c++); if(c>r, r=c; print(k)))))
%Y A396363 Cf. A169828.
%K A396363 nonn,base,new
%O A396363 1,2
%A A396363 _Charles L. Hohn_, Nov 02 2026
