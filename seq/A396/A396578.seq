%U A396578 521560685121034516574287178,18669817992841186622493980942550,1439166716118985076364469956794968622,237703676092100327767348665775373226741378
%N A396578 a(n) is the number of labeled directed acyclic graphs on [n] with no isolated points.
%C A396578 An isolated point in an acyclic digraph is a vertex with in-degree zero and out-degree zero.
%H A396578 Alois P. Heinz, <a href="/A396578/b396578.txt">Table of n, a(n) for n = 0..77</a>
%F A396578 E.g.f.: exp(-x) * D(x) where D(x) = Sum_{n>=0} A003024(n)/n! * x^n.
%F A396578 Inverse binomial transform of A003024.
%p A396578 b:= proc(n) option remember; `if`(n=0, 1, -add((-1)^k
%p A396578       *binomial(n, k)*2^(k*(n-k))*b(n-k), k=1..n))
%p A396578     end:
%p A396578 a:= n-> add(binomial(n, j)*b(j)*(-1)^(n-j), j=0..n):
%p A396578 seq(a(n), n=0..15);  # _Alois P. Heinz_, Sep 12 2026
%t A396578 nn = 15; B[n_] := n!;ggf[egf_] := Normal[Series[egf, {z, 0, nn}]] /.Table[z^i -> z^i/2^Binomial[i, 2], {i, 1, nn + 1}];egf[ggf_] :=Normal[Series[ggf, {z, 0, nn}]] /. Table[z^i -> z^i*2^Binomial[i, 2], {i, 1, nn + 1}];Table[B[n], {n, 0, nn}] CoefficientList[Series[Exp[- z]*egf[1/ggf[Exp[-z]]], {z, 0, nn}], z]
