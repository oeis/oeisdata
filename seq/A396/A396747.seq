%U A396747 1944,1972,2025,2100,2173,2187,2220,2295,2296,2352,2430,2494,2542,2544,2560
%N A396747 Numbers m that are vampire numbers in at least one base b.
%C A396747 By definition, a vampire number in base b must have an even number of digits k >= 4, and it must be factorable into two "fangs" each having exactly k/2 digits.
%C A396747 The smallest possible number with 4 digits in base b is 1000_b, which equals b^3. Therefore, for an integer n to be a vampire number in a generic base b, the geometric condition n >= b^3 must hold, which implies b <= n^(1/3).
%C A396747 Thus, to check if a number n belongs to this sequence, one only needs to test bases b in the range 2 <= b <= floor(n^(1/3)). This eliminates any artificial or arbitrary upper bound.
%C A396747 The sequence is infinite. For any base b, if a vampire number exists, a parametric family of larger vampire numbers can be generated by inserting an equal number of zeros into the center of the first fang and at the end of the second fang.
%C A396747 Prime numbers cannot belong to this sequence since vampire numbers must be composite by definition.
%e A396747 108 is a term because 108 is a vampire number in base 4. In base 4, 108 is written as 1230_4 (which has 4 digits). Its fangs are 9 (21_4) and 12 (30_4). The product 21_4 * 30_4 = 1230_4 uses exactly the same digits as the original number, and 2 <= 4 <= floor(108^(1/3)) = 4.
%e A396747 192 is a term because 192 is a vampire number in base 5. In base 5, 192 is written as 1232_5. Its fangs are 12 (22_5) and 16 (31_5). The product 22_5 * 31_5 = 1232_5 uses exactly the same digits, and 2 <= 5 <= floor(192^(1/3)) = 5.
%o A396747 (Python)
%o A396747 import math
%o A396747 def get_digits(n, base):
%o A396747     if n == 0:
%o A396747         return [0]
%o A396747     digits = []
%o A396747     while n > 0:
%o A396747         digits.append(n % base)
%o A396747         n //= base
%o A396747     return digits[::-1]
%o A396747 def is_vampire_in_base(n, base):
%o A396747     digits = get_digits(n, base)
%o A396747     k = len(digits)
%o A396747     if k % 2 != 0 or k < 4:
%o A396747         return False
%o A396747     half = k // 2
%o A396747     min_fang = base ** (half - 1)
%o A396747     max_fang = base ** half - 1
%o A396747     sorted_digits = sorted(digits)
%o A396747     for x in range(min_fang, math.isqrt(n) + 1):
%o A396747         if n % x == 0:
%o A396747             y = n // x
%o A396747             if min_fang <= y <= max_fang and not (x % base == 0 and y % base == 0):
%o A396747                 if sorted(get_digits(x, base) + get_digits(y, base)) == sorted_digits:
%o A396747                     return True
%o A396747     return False
%o A396747 def is_vampire_any_base(n):
%o A396747     if n < 108:
%o A396747         return False
%o A396747     max_base = int(n ** (1 / 3)) + 2
%o A396747     for b in range(2, max_base + 1):
%o A396747         if is_vampire_in_base(n, b):
%o A396747             return True
%o A396747     return False
%o A396747 # Example generation of initial terms
%o A396747 print([n for n in range(1, 2601) if is_vampire_any_base(n)])
%Y A396747 Cf. A014575 (vampire numbers in base 10), A394373 (smallest vampire number in base n).
