%S A396352 0,1,2,8,43,255,1637,11004,76634,547539,3992150,29579670,222089534,
%T A396352 1685986096,12919393824,99796767191,776276621151,6075293243558,
%U A396352 47803485488141,377950979871133,3001079299277562,23922162788835569,191357525466243744,1535590660291245498
%N A396352 Number of rooted binary unlabeled general galled trees with n leaves.
%C A396352 The asymptotic growth of a(n) follows ((0.19659...)*(0.11647...)^(-n))/(2*sqrt(Pi)*n^(3/2)) (eq. 18 of Agranat-Tamir et al. 2026).
%C A396352 From _Vaclav Kotesovec_, Aug 27 2026: (Start)
%C A396352 More precise values of the constants listed above are:
%C A396352 0.1965908830386510257555194380655615157267712288988370313618379...
%C A396352 0.1164742652194721689846433227363749045221776952267967196749166... (End)
%H A396352 Vaclav Kotesovec, <a href="/A396352/b396352.txt">Table of n, a(n) for n = 0..1000</a>
%H A396352 Lily Agranat-Tamir, Michael Fuchs, Bernhard Gittenberger, Noah A. Rosenberg, and Karthik V. Seetharaman, <a href="https://doi.org/10.1016/j.aam.2026.103131">Combinatorial comparison of general galled trees, time-consistent galled trees, and simplex time-consistent galled trees</a>, Adv. Appl. Math. 180, 103131 (2026). See Table 1.
%H A396352 Michael Fuchs and Bernhard Gittenberger, <a href="https://doi.org/10.1007/s00285-025-02205-0">Sackin indices for labeled and unlabeled classes of galled trees</a>, J. Math. Biol. 90, 42 (2026). See Section 6.1.
%F A396352 G.f. satisfies A(x) = x + (1/2)*A(x)^2 + (1/2)*A(x^2) + (A(x)/2)*((A(x)/(1-A(x)))^2 + A(x^2)/(1-A(x^2))) + A(x)^2/(1-A(x)). See eq. 17 of Agranat-Tamir et al. (2026).
%e A396352 For n=3, there is 1 tree with no galls. There is 1 tree from whose root a leaf and a 3-node gall descend. There are 2 trees with a 3-node root gall from which a leaf and a cherry descend; these differ in the placement of the reticulation node. There are 2 trees with a 3-node root gall from which a leaf and a 3-node gall descend; these differ in the placement of the reticulation node in the root gall. There are 2 trees with a 4-node root gall from which three leaves descend; these differ in the placement of the reticulation node. Hence, a(3)=1+1+2+2+2=8.
%t A396352 terms = 24;
%t A396352 A[_] = 0; Do[
%t A396352  A[x_] = x + (1/2)*(A[x]^2 + A[x^2]) + (A[x]/2) ((A[x]/(1 - A[x]))^2 +
%t A396352         A[x^2]/(1 - A[x^2])) + A[x]^2/(1 - A[x]) + O[x]^terms //
%t A396352    Normal, terms]; CoefficientList[A[x], x]
%Y A396352 Cf. A001190 (rooted binary unlabeled trees with n leaves and 0 galls), A380211 (rooted binary unlabeled time-consistent galled trees with n leaves).
%K A396352 nonn,changed
%O A396352 0,3
%A A396352 _Noah A Rosenberg_, Jul 26 2026
