%I A396857 #74 Sep 09 2026 22:10:27
%S A396857 0,11,12,23,229,240,252,2869,3098,3109,3121,18880,43531,46400,46629,
%T A396857 46640,46652,62411,65280,65509,65520,65532,758007,776887,820418,
%U A396857 823287,823516,823527,823539,15953673,16711680,16730560,16774091,16776960,16777189,16777200,16777212
%N A396857 Conjectured numbers of the form abs(x^^y - w^^z), where x, y, w, z are integers greater than 1 and ^^ denotes tetration.
%C A396857 a(1), a(2), and a(3) are certified terms (see Links for a proof that a(2) = 11 is the minimum positive difference between distinct integer tetrations with bases and heights all greater than 1; a(3) = 2^^3 - 2^^2 = 12 then follows immediately). In particular, a(1) = 0 has infinitely many representations, arising exactly when x^^y = w^^z.
%C A396857 For each n >= 4, the conjectured a(n) has been obtained by an exhaustive computational search over all integer tetrations up to 10^50000.
%C A396857 Consecutive terms can be used to bracket real numbers between absolute differences of two integer tetrations, giving lower and upper approximations in terms of power towers (e.g., a(2) < Pi^e/2 < a(3)).
%H A396857 MathOverflow, <a href="https://mathoverflow.net/questions/514311/tetrational-analogue-of-catalans-conjecture-is-2-3-3-2-11-the-smallest">Tetrational analogue of Catalan's conjecture: is 2^^3 - 3^^2 = 11?</a>.
%e A396857 a(1) = 2^^2 - 2^^2 = 3^^2 - 3^^2 = ... = 0.
%e A396857 a(2) = 3^^2 - 2^^3 = 11.
%e A396857 a(3) = 2^^3 - 2^^2 = 12.
%o A396857 (Python)
%o A396857 def tet(x,y,B):
%o A396857     v=x
%o A396857     for _ in range(y-1):
%o A396857         if v>=B.bit_length(): return B+1
%o A396857         v=x**v
%o A396857     return v
%o A396857 E=50000
%o A396857 B=10**E
%o A396857 M=16777200
%o A396857 T=set()
%o A396857 x=2
%o A396857 while x**x<=B:
%o A396857     y=2
%o A396857     while (v:=tet(x,y,B))<=B:
%o A396857         T.add(v)
%o A396857         y+=1
%o A396857     x+=1
%o A396857 T=sorted(T)
%o A396857 D={0}
%o A396857 for i,v in enumerate(T):
%o A396857     j=i-1
%o A396857     while j>=0 and v-T[j]<=M:
%o A396857         D.add(v-T[j])
%o A396857         j-=1
%o A396857 D=sorted(D)
%o A396857 print("Certified:",D[:3])
%o A396857 print("Conjectured after exhaustive search over tetrations <= 10^%d:"%E,D[3:])
%Y A396857 Cf. A074981, A076427, A321312, A393643, A396947, A399068.
%K A396857 nonn,hard,new
%O A396857 1,2
%A A396857 _Marco Ripà_, Aug 19 2026
