%I A396796 #33 Sep 11 2026 23:29:34
%S A396796 1,1,0,0,2,10,32,164,1290,10404,93566,971256,11230254,141645552,
%T A396796 1935993604,28498370740,449077050122,7538223190980,134244525340518,
%U A396796 2527396958407380,50148298072678244,1045816256261329304,22866942869988432582,523066451213871050872,12492044879543305073636
%N A396796 Number of ways to place n nonattacking rook-plus-range-2-diagonal pieces on an n X n chessboard with rotations and reflections counted separately.
%C A396796 For n>=2, a(n) is even by vertical reflection.
%C A396796 The range-1 analog is A002464.
%C A396796 A000170(n) <= a(n) <= A002464(n).
%e A396796 a(4)=2, represented by the column permutations 2413 and 3142.
%o A396796 (Python)
%o A396796 from functools import lru_cache
%o A396796 def a(n):
%o A396796     full = (1 << n) - 1
%o A396796     @lru_cache(maxsize=None)
%o A396796     def f(mask, prev2, prev1, depth):
%o A396796         if mask == full:
%o A396796             return 1
%o A396796         ans = 0
%o A396796         for x in range(n):
%o A396796             if mask >> x & 1:
%o A396796                 continue
%o A396796             if depth >= 1 and abs(x-prev1) == 1:
%o A396796                 continue
%o A396796             if depth >= 2 and abs(x-prev2) == 2:
%o A396796                 continue
%o A396796             ans += f(mask | 1 << x, prev1, x, depth+1)
%o A396796         return ans
%o A396796     return f(0, -1, -1, 0)
%Y A396796 Cf. A000170, A002464 (diagonal range 1).
%K A396796 nonn,new
%O A396796 0,5
%A A396796 _Duc Ngo_, Sep 02 2026
%E A396796 a(17)-a(24) from _Martin Fuller_, Sep 06 2026
