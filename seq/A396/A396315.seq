%N A396315 a(n) = Sum_{r=0..n} 2^(r*(n-r))*Sum_{s=0..r} 2^(s*(r-s)).
%F A396315 a(n) ~ c * 2^(n^2/3), where
%F A396315 c = 5.233518874470575267506863441892994049155756336676225252314... if mod(n,3)=0
