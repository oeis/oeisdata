%I A396925 #64 Aug 04 2026 23:05:36
%S A396925 2,12,18,24,40,50,60,63,80,96,98,120,126,162,240,242,252,273,300,320,
%T A396925 338,360,364,384,450,468,480,513,544,546,578,588,600,680,720,722,728,
%U A396925 756,816,825,882,936,1008,1020,1026,1058,1088,1092,1100,1176,1250,1280,1360,1365
%N A396925 Numbers k which have a divisor d such that d^2 < k and phi(d) = phi(k/d), where phi = A000010.
%C A396925 Equivalently, k is a term if it has a divisor d such that d^2 < k and phi(d) = phi(k/d).
%C A396925 The sequence is infinite. In particular, 2m^2 is a term for every odd positive integer m since phi(2m) = phi(m).
%C A396925 Except for the initial term 2, all terms are composite.
%e A396925 2 is a term because 2 = 1*2 and phi(1) = phi(2) = 1.
%e A396925 40 is a term because 40 = 5*8 and phi(5) = phi(8) = 4.
%t A396925 Select[Range[1400], Function[k, AnyTrue[Divisors[k], Function[d, d^2 < k && EulerPhi[d] == EulerPhi[k/d]]]]]
%Y A396925 Cf. A000010 (Euler totient function), A014197, A014573.
%K A396925 nonn,new
%O A396925 1,1
%A A396925 _Pang Ern_, Jul 23 2026
