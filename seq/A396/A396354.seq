%I A396354 #32 Jul 28 2026 19:27:49
%S A396354 10,831,9641,50018,183940,549145,1416331,3270676,6922158,13649155,
%T A396354 25379805,44915606,76201736,124648573,197508895,304315240,457381906,
%U A396354 672376071,968962513,1371526410,1909978700,2620648481,3547266931,4742047228,6266864950,8194543435
%N A396354 Number of unsatisfiable 3-SAT formulas with n variables and 4 clauses in the multiset clause model.
%C A396354 Clauses are multisets of 3 literals chosen from {x_1, ..., x_n, not x_1, ..., not x_n}; repeated literals inside a clause are allowed. A formula is a multiset of 4 such clauses, so repeated clauses are also allowed.
%C A396354 This is the m=4 column of A396351.
%C A396354 For fixed m, the corresponding column is expected to be a polynomial in n, since an m-clause formula involves only finitely many literal positions. The polynomial in the Formula section was obtained by interpolation from the listed terms and should be treated as conjectural unless independently verified.
%C A396354 From _Alper Ferudun_, Jul 22 2026: (Start)
%C A396354 Every unsatisfiable formula contains an inclusion-minimal unsatisfiable core of c clauses. Such a core has no tautological clause. Deleting repeated occurrences of a literal preserves its truth function and variable support, so Tarsi's lemma gives at most c-1 variables in the core. Since c >= 2 and each of the other 4-c clauses introduces at most 3 variables, the complete formula has support size at most (c-1)+3*(4-c) = 11-2*c <= 7.
%C A396354 If b(k) is the number of formulas whose support is exactly a specified labeled k-set, relabeling gives a(n) = Sum_{k=1..7} b(k)*binomial(n,k). Binomial inversion of a(0),...,a(7) gives (b(1),...,b(7)) = (10,811,7178,16400,22000,15360,4480). (End)
%D A396354 Stephen A. Cook, The complexity of theorem-proving procedures, Proceedings of the Third Annual ACM Symposium on Theory of Computing, 1971, 151-158.
%H A396354 Alper Ferudun, <a href="/A396354/b396354.txt">Table of n, a(n) for n = 1..1000</a>
%H A396354 R. Aharoni and N. Linial, <a href="https://doi.org/10.1016/0097-3165(86)90060-9">Minimal non-two-colorable hypergraphs and minimal unsatisfiable formulas</a>, Journal of Combinatorial Theory, Series A, 43 (1986), 196-204.
%H A396354 <a href="/index/Rec#order_08">Index entries for linear recurrences with constant coefficients</a>, signature (8,-28,56,-70,56,-28,8,-1).
%F A396354 Conjecture: a(n) = n*(16*n^6 + 48*n^5 + 340*n^4 + 180*n^3 + 2818*n^2 - 10011*n + 6789)/18.
%F A396354 From _Alper Ferudun_, Jul 22 2026: (Start)
%F A396354 The conjectured formula is true.
%F A396354 a(n) = 10*binomial(n,1) + 811*binomial(n,2) + 7178*binomial(n,3) + 16400*binomial(n,4) + 22000*binomial(n,5) + 15360*binomial(n,6) + 4480*binomial(n,7).
%F A396354 G.f.: (10*x + 751*x^2 + 3273*x^3 - 4402*x^4 + 7908*x^5 - 4157*x^6 + 1097*x^7)/(1 - x)^8.
%F A396354 a(n) = 8*a(n-1) - 28*a(n-2) + 56*a(n-3) - 70*a(n-4) + 56*a(n-5) - 28*a(n-6) + 8*a(n-7) - a(n-8) for n >= 9. (End)
%o A396354 (Python)
%o A396354 from itertools import combinations_with_replacement
%o A396354 def clauses(n):
%o A396354     lits = list(range(-n, 0)) + list(range(1, n+1))
%o A396354     return list(combinations_with_replacement(lits, 3))
%o A396354 def lit_value(lit, a):
%o A396354     v = abs(lit)-1
%o A396354     val = (a >> v) & 1
%o A396354     return val if lit > 0 else 1-val
%o A396354 def unsat(n, formula):
%o A396354     for a in range(1 << n):
%o A396354         if all(any(lit_value(lit, a) for lit in clause) for clause in formula):
%o A396354             return False
%o A396354     return True
%o A396354 def a(n):
%o A396354     cl = clauses(n)
%o A396354     s = 0
%o A396354     for idxs in combinations_with_replacement(range(len(cl)), 4):
%o A396354         if unsat(n, [cl[i] for i in idxs]):
%o A396354             s += 1
%o A396354     return s
%o A396354 print([a(n) for n in range(1, 8)])
%o A396354 (Python)
%o A396354 from math import comb
%o A396354 B = (0, 10, 811, 7178, 16400, 22000, 15360, 4480)
%o A396354 def a(n): return sum(B[k]*comb(n,k) for k in range(1,8)) # _Alper Ferudun_, Jul 22 2026
