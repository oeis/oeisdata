%I A059381 #34 Sep 03 2026 01:03:53
%S A059381 1,3,24,288,6912,165888,7962624,382205952,27518828544,1981355655168,
%T A059381 237762678620160,22825217147535360,3834636480785940480,
%U A059381 552187653233175429120,106020029420769682391040,20355845648787779019079680,5862483546850880357494947840
%N A059381 a(n) = Product_{i=1..n} J_2(i).
%C A059381 a(n) is also the determinant of the symmetric n X n matrix M defined by M(i,j) = gcd(i,j)^2 for 1 <= i,j <= n. - Avi Peretz, (njk(AT)netvision.net.il), Mar 22 2001
%D A059381 Louis Comtet, Advanced Combinatorics, Reidel, 1974, p. 203, #17.
%H A059381 G. C. Greubel, <a href="/A059381/b059381.txt">Table of n, a(n) for n = 1..250</a>
%H A059381 Antal Bege, <a href="https://acta.sapientia.ro/content/docs/hadamard-product-of-gcd-matrices.pdf">Hadamard product of GCD matrices</a>, Acta Univ. Sapientiae, Mathematica, 1, 1 (2009), 43-49.
%H A059381 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/LePaigesTheorem.html">Le Paige's Theorem</a>.
%F A059381 a(n) = A001088(n)*A175836(n). - _Enrique Pérez Herrero_, Oct 08 2011
%F A059381 Limit_{n->oo} a(n)^(1/n) / n^2 = c / e^2 = 0.111244212720614709127..., where c = Product_{p prime} (1-1/p^2)^(1/p) = A124175 * A272028 = 0.821989728473996738636... . - _Amiram Eldar_, Sep 03 2026
%p A059381 f:= n-> LinearAlgebra:-Determinant(Matrix(n,n,(i,j) -> igcd(i,j)^2)):
%p A059381 map(f, [$1..40]); # _Robert Israel_, Dec 01 2017
%t A059381 JordanTotient[n_,k_:1] := DivisorSum[n,#^k*MoebiusMu[n/#]&]/;(n>0)&&IntegerQ[n]; A059381[n_]:=Times@@(JordanTotient[#,2]&/@Range[n] ); (* _Enrique Pérez Herrero_, Dec 29 2010 *)
%t A059381 (* Alternative: *)
%t A059381 f[p_, e_] := p^(2*e) - p^(2*(e-1)); j2[1] = 1; j2[n_] := Times @@ f @@@ FactorInteger[n]; FoldList[Times, Array[j2, 17]] (* _Amiram Eldar_, Sep 03 2026 *)
%Y A059381 Cf. A001088, A007434 (J_2), A059382, A059383, A059384, A175836, A239672.
%Y A059381 Cf. A124175 * A272028.
%K A059381 nonn,changed
%O A059381 1,2
%A A059381 _N. J. A. Sloane_, Jan 28 2001
