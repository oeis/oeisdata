%N A196831 Decimal expansion of the number x satisfying 0 < x < 2*Pi and x^2 + 2*x*tan(x) + 1 = 0.
%H A196831 <a href="/index/Tra#transcendental">Index entries for transcendental numbers</a>.
%e A196831 2.214416905079636330679565960367792215966376475...
%t A196831 Plot[{1/(1 + x^2), .205 Sin[x]}, {x, 0, Pi}]
%t A196831 t = x /. FindRoot[x^2 + 2 x*Tan[x] + 1 == 0, {x, 2, 3}, WorkingPrecision -> 100]
%t A196831 RealDigits[t]     (* A196831 *)
%t A196831 c = N[Csc[t]/(1 + t^2), 100]
%t A196831 RealDigits[c]     (* A196832 *)
%t A196831 slope = N[c*Cos[t], 100]
%t A196831 RealDigits[slope] (* A196833 *)
%o A196831 (PARI) solve(x=2,3, x^2+2*x*tan(x)+1) \\ _Charles R Greathouse IV_, Jul 25 2026
