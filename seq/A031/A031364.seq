%T A031364 64,0,0,0,0,50,0,0,0,0,84,0,0,120,60,0,0,0,50,0,0,0,0,0,144,0,0,0,120,
%U A031364 0,124,0,0,80,0,0,0,0,0,0,144,0,0,0,0,200,0,0
%N A031364 Number of coincidence site modules of index 10n+1 in an icosahedral module.
%C A031364 a(n) is nonzero iff n is of the form x^2+x*y+y^2 (A031363).
%D A031364 Michael Baake, "Solution of coincidence problem in dimensions d<=4", in R. V. Moody, ed., Math. of Long-Range Aperiodic Order, Kluwer 1997, pp. 9-44.
%H A031364 Amiram Eldar, <a href="/A031364/b031364.txt">Table of n, a(n) for n = 1..10000</a>
%H A031364 M. Baake, <a href="https://arxiv.org/abs/math/0605222">Solution of the coincidence problem in dimensions d <= 4</a>, arxiv:math/0605222 (2006), Prop. 5.4.
%H A031364 Michael Baake and Peter AB Pleasants, <a href="https://doi.org/10.1515/zna-1995-0802">Algebraic solution of the coincidence problem in two and three dimensions</a>, Zeitschrift für Naturforschung A 50.8 (1995): 711-717. See page 716.
%H A031364 Sean A. Irvine, <a href="https://github.com/archmageirvine/joeis/blob/master/src/irvine/oeis/a031/A031364.java">Java program</a> (github).
%F A031364 Dirichlet series: ((1+5^(-s))/(1-5^(1-s))) * Product_{p = +-2 (mod 5)} ((1+p^(-2*s))/(1-p^(2*(1-s)))) * Product_{p = +-1 (mod 5)} ((1+p^(-s))/(1-p^(1-s)))^2. - _Sean A. Irvine_, Apr 29 2020
%F A031364 From _Amiram Eldar_, Oct 25 2026:
%F A031364 Multiplicative with a(5^e) = 5^e + 5^(e-1) = 6*5^(e-1), for p == -2 or 2 (mod 5), a(p^e) = 0 if e is odd, and p^e + p^(e-2) = (p^2+1)*p^(e-2) if e is even, and for p == -1 or 1 (mod 5), a(p^e) = (e+1)*p^e + 2*e*p^(e-1) + (e-1)*p^(e-2).
%F A031364 Sum_{k=1..n} a(k) ~ c * n^2, where c = (26*log(phi)/(25*sqrt(5)) * Product_{prime p == -2 or 2 (mod 5)} (1 + 1/p^4) * Product_{prime p == -1 or 1 (mod 5)} (1 + 1/p^2)^2 = 0.248544593448..., and phi is the golden ratio (A001622). (End)
%t A031364 f[p_, e_] := Switch[KroneckerSymbol[p, 5], 0, 6*5^(e-1), 1, (e+1)*p^e + 2*e*p^(e-1) + (e-1)*p^(e-2), -1, If[OddQ[e], 0, (p^2 + 1)*p^(e-2)]]; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 78] (* _Amiram Eldar_, Oct 25 2026 *)
%o A031364 (PARI) a(n) = vecprod([if(f[1] == 5, 6*5^(f[2]-1), if(kronecker(f[1], 5) == 1, (f[2]+1)*f[1]^f[2] + 2*f[2]*f[1]^(f[2]-1) + (f[2]-1)*f[1]^(f[2]-2), if(f[2]%2,0,(f[1]^2+1)*f[1]^(f[2]-2))))| f<-factor(n)~]); \\ _Amiram Eldar_, Oct 25 2026
%Y A031364 Cf. A001622, A031363.
%K A031364 nonn,easy,mult,changed
%O A031364 1,4
%A A031364 _N. J. A. Sloane_
