%I A167448 #12 Sep 26 2026 04:15:37
%S A167448 1,2,768,4403012567040,384637545508886260255243527782400000000
%N A167448 Smallest number with n distinct positive cubic exponents in its prime factorization.
%H A167448 Amiram Eldar, <a href="/A167448/b167448.txt">Table of n, a(n) for n = 0..8</a>
%F A167448 a(n) = Product_{k=1..n} prime(k)^((n-k+1)^3).
%e A167448 a(2) = 768, which has a prime factorization of 2^8 * 3^1.
%t A167448 Table[Product[Prime[k]^((n - k + 1)^3), {k, 1, n}], {n, 0, 5}] (* _Vaclav Kotesovec_, Aug 10 2021 *)
%o A167448 (PARI) a(n) = prod(k = 1, n, prime(k)^((n-k+1)^3)); \\ _Amiram Eldar_, Sep 26 2026
%Y A167448 Subsequence of A025487.
