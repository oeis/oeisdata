%N A178330 Numbers n such that d(1)^1 + d(2)^2 +... + d(p)^p is a power of 2, where d(i), i=1..p, are the decimal digits of n.
%e A178330 7496 is in the sequence because 7 + 4^2 + 9^3 + 6^4 = 2048 = 2^11.
%e A178330 73 is in the sequence because 7 + 3^2 = 16 = 2^4.
%p A178330 with(numtheory):for n from 1 to 10000 do:l:=length(n):n0:=n:s:=0:for m from
%p A178330   1 to l do:q:=n0:u:=irem(q,10):v:=iquo(q,10):n0:=v :s:=s+u^(l-m+1):od: x:=evalf(log[2](s)):if x=floor(x) then printf(`%d, `,n):else fi:od:
%p A178330 # Alternative:
%p A178330 q:= n-> (l-> (w-> w=2^ilog[2](w))(add(l[-i]^i, i=1..nops(l))))(convert(n, base, 10)):
%p A178330 select(q, [$1..4433])[];  # _Alois P. Heinz_, Oct 22 2026
