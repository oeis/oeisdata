%N A178610 n-th semiprime minus difference between the prime indices of the two factors of n-th semiprime.
%F A178610 a(n)=A001358(n)-A176506(n).
%o A178610 (Python)
%o A178610 from math import comb, isqrt
%o A178610 from operator import sub
%o A178610 from sympy import primepi, primerange, primefactors
%o A178610 from oeis_sequences.OEISsequences import bisection
%o A178610 def A178610(n):
%o A178610     def f(x): return int(n+x+comb(primepi(s:=isqrt(x)),2)-sum(primepi(x//p) for p in primerange(s+1)))
%o A178610     return k+sub(*m) if len(m:=list(map(primepi,primefactors(k:=bisection(f,n,n)))))>1 else k # _Chai Wah Wu_, Oct 05 2026
