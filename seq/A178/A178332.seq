%T A178332 123,136,156,200,208,217,224,248,277,305,314,321,361,400,480,503,512,
%U A178332 664,800,1000,1001,1003,1007,1010,1012,1016,1023,1036,1056,1100,1102,1106,1111,1115,1122,1135,1155,1207,1216,1223,1247,1276,1304,1313,1320,1360,1502,1511,1663,2000,2037,2040,2136,2208,2217,2224,2264,2345,2394,2648,3263,3344
%N A178332 Numbers n such that d(1)^p + d(2)^(p-1) + ... + d(p)^1 is a power of 2, where d(i), i=1..p, are the digits of n.
%e A178332 2394 is in the sequence because 2^4 + 3^3 + 9^2 + 4^1 = 128 = 2^7.
%e A178332 37 is in the sequence because 3^2 + 7^1 = 16 = 2^4.
%p A178332 with(numtheory):for n from 1 to 4000 do:l:=length(n):n0:=n:s1:=0:s2:=0:for
%p A178332   m from 1 to l do:q:=n0:u:=irem(q,10):v:=iquo(q,10):n0:=v :s2:=s2+u^m:od:x:=evalf(log[2](s2)):if  x=floor(x) then printf(`%d, `,n):else fi:od:
%p A178332 # Alternative:
%p A178332 q:= n-> (l-> (w-> w=2^ilog[2](w))(add(l[i]^i, i=1..nops(l))))(convert(n, base, 10)):
%p A178332 select(q, [$1..3344])[];  # _Alois P. Heinz_, Oct 22 2026
