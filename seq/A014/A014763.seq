%N A014763 Inverse of 754th cyclotomic polynomial.
%C A014763 Periodic with period length 754. - _Ray Chandler_, Apr 06 2017
%H A014763 Ray Chandler, <a href="/A014763/b014763.txt">Table of n, a(n) for n = 0..1000</a>
%H A014763 <a href="/index/Per#periodic">Index entries for periodic sequences</a>.
%H A014763 <a href="/index/Rec#order_336">Index entries for linear recurrences with constant coefficients</a>, order 336.
%H A014763 <a href="/index/Pol#poly_cyclo_inv">Index to sequences related to inverse of cyclotomic polynomials</a>
%p A014763 with(numtheory,cyclotomic); c := n->series(1/cyclotomic(n,x),x,80);
%t A014763 Module[{x, nmax = 100}, PadRight[CoefficientList[Series[1/Cyclotomic[754, x], {x, 0, nmax}], x], nmax + 1]] (* _Paolo Xausa_, Sep 26 2026 *)
%o A014763 (PARI) Vec(1/polcyclo(754)+O(x^99)) \\ _Charles R Greathouse IV_, Jun 01 2026
%K A014763 sign,easy,changed
%O A014763 0,1
%A A014763 _Simon Plouffe_
