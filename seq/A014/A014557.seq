%S A014557 0,0,0,0,0,0,2,4,8,12,20,28,40,52,70,88,112,136,168,200,240,280,330,
%T A014557 380,440,500,572,644,728,812,910,1008,1120,1232,1360,1488,1632,1776,
%U A014557 1938,2100,2280,2460,2660,2860,3080,3300,3542,3784,4048,4312,4600,4888,5200
%N A014557 Multiplicity of K_3 in K_n.
%C A014557 The multiplicity of triangles in K_n is defined to be the minimum number of monochromatic copies of K_3 that occur in any 2-coloring of the edges of K_n. - _Allan Bickle_, Mar 04 2023
%C A014557 Twice A008804 (up to offset).
%H A014557 Alexander Adamchuk, <a href="/A014557/b014557.txt">Table of n, a(n) for n = 0..100</a>
%H A014557 Alexander Adamchuk, <a href="/A014557/a014557.txt">Notes on divisibility</a>, 2006.
%H A014557 R. Ehrenborg, <a href="https://doi.org/10.1080/0025570X.2021.1977581">Bounding monochromatic triangles using squares</a>, Math. Magazine, 94 (2021), 383-386.
%H A014557 A. W. Goodman, <a href="https://www.jstor.org/stable/2310464">On Sets of Acquaintances and Strangers at Any Party</a>, Amer. Math. Monthly 66, 778-783, 1959.
%H A014557 L. Sauvé, <a href="https://www.jstor.org/stable/2312470">On chromatic graphs</a>, Amer. Math. Monthly, 68 (1961), 107-111.
%H A014557 A. J. Schwenk, <a href="https://doi.org/10.1080/00029890.1972.11993198">Acquaintance Party Problem</a>, Amer. Math. Monthly 79 (1972), 1113-1117.
%H A014557 V. Vijayalakshmi, <a href="https://doi.org/10.1016/S0012-365X(98)00410-5">Multiplicity of triangles in cocktail party graphs</a>, Discrete Math., 206 (1999), 217-218.
%H A014557 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/ExtremalGraph.html">Extremal Graph.</a>
%H A014557 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/MonochromaticForcedTriangle.html">Monochromatic Forced Triangle.</a>
%H A014557 <a href="/index/Rec#order_08">Index entries for linear recurrences with constant coefficients</a>, signature (2,0,-2,2,-2,0,2,-1).
%F A014557 a(n) = binomial(n,3) - floor(n/2 * floor(((n-1)/2)^2)). - _Alexander Adamchuk_, Nov 29 2006
%F A014557 G.f.: 2*x^6/((x-1)^4*(x+1)^2*(x^2+1)). - _Colin Barker_, Nov 28 2012
%F A014557 E.g.f.: ((x - 3)*x^2*cosh(x) - 6*sin(x) + (6 + 3*x - 3*x^2 + x^3)*sinh(x))/24. - _Stefano Spezia_, May 15 2023
%e A014557 Any 2-coloring of the edges of K_6 produces at least two monochromatic triangles.  Having colors induce K_3,3 and 2K_3 shows this is attained, so a(6) = 2.
%p A014557 A049322 := proc(n) local u; if n mod 2 = 0 then u := n/2; RETURN(u*(u-1)*(u-2)/3); elif n mod 4 = 1 then u := (n-1)/4; RETURN(u*(u-1)*(4*u+1)*2/3); else u := (n-3)/4; RETURN(u*(u+1)*(4*u-1)*2/3); fi; end;
%t A014557 Table[Binomial[n,3] - Floor[n/2*Floor[((n-1)/2)^2]],{n,0,100}] (* _Alexander Adamchuk_, Nov 29 2006 *)
%o A014557 (PARI) my(x='x+O('x^99)); concat(vector(6), Vec(2*x^6/((x-1)^4*(x+1)^2*(x^2+1)))) \\ _Altug Alkan_, Apr 08 2016
%o A014557 (Magma) [n*(n-1)*(n-2)/6 - Floor((n/2)*Floor(((n-1)/2)^2)): n in [1..20]]; // _G. C. Greubel_, Oct 06 2017
