%N A014714 Inverse of 705th cyclotomic polynomial.
%C A014714 Periodic with period length 705. - _Ray Chandler_, Apr 06 2017
%H A014714 Ray Chandler, <a href="/A014714/b014714.txt">Table of n, a(n) for n = 0..1000</a>
%H A014714 <a href="/index/Per#periodic">Index entries for periodic sequences</a>.
%H A014714 <a href="/index/Rec#order_368">Index entries for linear recurrences with constant coefficients</a>, order 368.
%H A014714 <a href="/index/Pol#poly_cyclo_inv">Index to sequences related to inverse of cyclotomic polynomials</a>
%p A014714 with(numtheory,cyclotomic); c := n->series(1/cyclotomic(n,x),x,80);
%t A014714 Module[{x, nmax = 100}, PadRight[CoefficientList[Series[1/Cyclotomic[705, x], {x, 0, nmax}], x], nmax + 1]] (* _Paolo Xausa_, Sep 25 2026 *)
%o A014714 (PARI) Vec(1/polcyclo(705)+O(x^99)) \\ _Charles R Greathouse IV_, Jun 01 2026
%K A014714 sign,easy,changed
%O A014714 0,1
%A A014714 _Simon Plouffe_
