%e A376167    7 |   9, 11, 14, 16, 19, 22, 23, 25, 26, 28, 29, 31, 32, 34, ...
%e A376167    8 |  10, 12, 15, 18, 20, 23, 25, 27, 29, 31, 33, 34, 36, 37, ...
