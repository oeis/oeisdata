%I A239611 #30 Nov 10 2026 06:40:15
%S A239611 1,4,16,32,32,64,96,192,216,128,240,512,288,384,512,1024,512,864,720,
%T A239611 1024,1536,960,1056,3072,1200,1152,2592,3072,1568,2048,1920,5120,3840,
%U A239611 2048,3072,6912,2592,2880,4608,6144,3200,6144,3696,7680,6912,4224,4416
%N A239611 a(n) = Sum_{0 < x,y <= n and gcd(x^2 + y^2, n)=1} gcd(x^2 + y^2 - 1, n).
%C A239611 Related to Menon's identity. See Conclusions and further work section of the arXiv file linked.
%C A239611 Multiplicative by the Chinese remainder theorem since gcd(x, m*n) = gcd(x, m)*gcd(x, n) for gcd(m, n) = 1. - _Andrew Howroyd_, Aug 07 2018
%H A239611 Amiram Eldar, <a href="/A239611/b239611.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..2101 from Antti Karttunen)
%H A239611 Catalina Calderón, José María Grau, Antonio M. Oller-Marcén, and László Tóth, <a href="https://doi.org/10.5486/PMD.2015.7098">Counting invertible sums of squares modulo n and a new generalization of Euler totient function</a>, Publ. Math. Debrecen, Vol. 87 (2015), pp. 133-145; <a href="https://arxiv.org/abs/1403.7878">arXiv preprint</a>, arXiv:1403.7878 [math.NT], 2014.
%F A239611 Multiplicative with a(2^e) = e*4^e, a(p^e) = (e+1)*(p-1)^2*p^(2*e-2) if p == 1 (mod 4), and a(p^e) = (e+1)*(p^2-1)*p^(2*e-2) if p == 3 (mod 4). - _Amiram Eldar_, Nov 10 2026
%t A239611 g2[n_] := Sum[If[GCD[x^2 + y^2, n] == 1, GCD[x^2 + y^2 - 1, n], 0], {x, 1, n}, {y, 1, n}]; Array[g2,100]
%t A239611 (* Alternative: *)
%t A239611 f[p_, e_] := (e+1)*(p-1)*p^(2*e-2) * If[Mod[p, 4] == 1, p-1, p+1]; f[2, e_] := e*4^e; a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 47] (* _Amiram Eldar_, Nov 10 2026 *)
%o A239611 (PARI) a(n) = {s = 0; for (x=1, n, for (y=1, n, if (gcd(x^2+y^2,n) == 1, s += gcd(x^2+y^2-1,n)););); s;} \\ _Michel Marcus_, Jun 29 2014
%o A239611 (PARI) a(n) = vecprod([if(f[1] == 2, f[2]*4^f[2], (f[2]+1)*(f[1]-1)*f[1]^(2*f[2]-2) * if(f[1] % 4 == 1, f[1]-1, f[1]+1)) | f <- factor(n)~]); \\ _Amiram Eldar_, Nov 10 2026
