%I A239613 #26 Nov 10 2026 06:43:22
%S A239613 1,16,96,384,960,1536,4032,8192,11664,15360,26400,36864,52416,64512,
%T A239613 92160,163840,156672,186624,246240,368640,387072,422400,534336,786432,
%U A239613 900000,838656,1259712,1548288,1364160,1474560,1785600,3145728
%N A239613 a(n) = Sum_{0 < x,y,z,t <= n and gcd(x^2 + y^2 + z^2 + t^2, n)=1} gcd(x^2 + y^2 + z^2 + t^2 - 1, n).
%C A239613 Related to Menon's identity. See Conclusions and further work section of the arXiv file linked.
%H A239613 Amiram Eldar, <a href="/A239613/b239613.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from Andrew Howroyd)
%H A239613 Catalina Calderón, José María Grau, Antonio M. Oller-Marcén, and László Tóth, <a href="https://doi.org/10.5486/PMD.2015.7098">Counting invertible sums of squares modulo n and a new generalization of Euler totient function</a>, Publ. Math. Debrecen, Vol. 87 (2015), pp. 133-145; <a href="https://arxiv.org/abs/1403.7878">arXiv preprint</a>, arXiv:1403.7878 [math.NT], 2014.
%F A239613 Multiplicative with a(2^e) = (e+1)*2^(4*e-1), and a(p^e) = (e+1)*(p-1)*(p^2-1)*p^(4*e-3) for an odd prime p. - _Amiram Eldar_, Nov 10 2026
%t A239613 g4[n_] := Sum[If[GCD[x^2 + y^2+ z^2+ t^2, n] == 1, GCD[x^2 + y^2+ z^2+ t^2 - 1, n], 0], {x, 1, n}, {y, 1, n},{z,1,n},{t,1,n}]; Array[g4,100]
%t A239613 (* Alternative: *)
%t A239613 f[p_, e_] := (e+1)*(p-1)*(p^2-1)*p^(4*e-3); f[2, e_] := (e+1)*2^(4*e-1); a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 32] (* _Amiram Eldar_, Nov 10 2026 *)
%o A239613 (PARI) a(n) = {s = 0; for (x=1, n, for (y=1, n, for (z=1, n, for (t=1, n, if (gcd(x^2+y^2+z^2+t^2,n) == 1, s += gcd(x^2+y^2+z^2+t^2-1,n)););););); s;} \\ _Michel Marcus_, Jun 29 2014
%o A239613 (PARI) a(n)={my(p=lift(Mod(sum(i=0, n-1, x^(i^2%n)), x^n-1)^4)); sum(i=0, n-1, if(gcd(i,n)==1, polcoeff(p,i)*gcd((i-1)%n,n)))} \\ _Andrew Howroyd_, Aug 07 2018
%o A239613 (PARI) a(n) = vecprod([if(f[1] == 2, (f[2]+1)*2^(4*f[2]-1), (f[2]+1)*(f[1]-1)*(f[1]^2-1)*f[1]^(4*f[2]-3)) | f <- factor(n)~]); \\ _Amiram Eldar_, Nov 10 2026
