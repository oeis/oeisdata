%S A239444 1,2,-1,8,41,-2,-1,32,81,82,-1,-8,313,-2,-41,128,545,162,-1,328,1,-2,
%T A239444 -1,-32,1425,626,-81,-8,1625,-82,-1,512,1,1090,-41,648,2665,-2,-313,
%U A239444 1312,3281,2,-1,-8,3321,-2,-1,-128,2401,2850,-545,2504,5513,-162,-41,-32,1,3250,-1,-328,7321
%N A239444 a(n) = Sum_{0 < k,t <= n} gcd(k^2 + t^2, n) * cos(2*Pi*(k^2 + t^2)/n).
%F A239444 From _Amiram Eldar_, Oct 24 2026: (Start)
%F A239444 Multiplicative with a(2^e) = 2^(2*e-1), if p == 1 (mod 4) then a(p^e) = p^(2*e-2)*(p^2 + e*(p-1)^2), and if p == 3 (mod 4) then a(p^e) = -p^(2*e-2) for an odd e, and p^(2*e) for an even e.
%F A239444 Sum_{k=1..n} a(k) ~ c * n^3, where c = (Pi/16) * A334427 * Product_{primes p == 1 (mod 4) (1 - (2*p-1)/p^3) = 0.170117963701... . (End)
%t A239444 GGG[n_] := Sum[GCD[k^2 + t^2, n] Cos[2 Pi (k^2 + t^2)/n], {k, 1, n}, {t, 1, n}];Table[Round[GGG[n]], {n, 1, 111}]
%t A239444 (* Alternative: *)
%t A239444 f[p_, e_] := If[Mod[p, 4] == 1, p^(2*e-2)*(p^2 + e*(p-1)^2), If[OddQ[e], -p^(2*e-2), p^(2*e)]]; f[2, e_] := 2^(2*e-1); a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 61] (* _Amiram Eldar_, Oct 24 2026 *)
%o A239444 (PARI) a(n) = {my(f = factor(n), p, e); prod(i = 1, #f~, p = f[i, 1]; e = f[i, 2]; if(p == 2, 2^(2*e-1), if(p % 4 == 1, p^(2*e-2)*(p^2 + e*(p-1)^2), if(e % 2, -p^(2*e-2), p^(2*e)))));} \\ _Amiram Eldar_, Oct 24 2026
