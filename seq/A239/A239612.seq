%I A239612 #26 Nov 10 2026 06:41:41
%S A239612 1,8,30,112,220,240,546,1280,1134,1760,2310,3360,4212,4368,6600,13312,
%T A239612 9520,9072,12654,24640,16380,18480,22770,38400,42500,33696,39366,
%U A239612 61152,47908,52800,56730,131072,69300,76160,120120,127008,99900,101232,126360,281600
%N A239612 a(n) = Sum_{0 < x,y,z <= n and gcd(x^2 + y^2 + z^2, n)=1} gcd(x^2 + y^2 + z^2 - 1, n).
%C A239612 Related to Menon's identity. See Conclusions and further work section of the arXiv file linked.
%H A239612 Amiram Eldar, <a href="/A239612/b239612.txt">Table of n, a(n) for n = 1..10000</a> (terms 1..1000 from Andrew Howroyd)
%H A239612 Catalina Calderón, José María Grau, Antonio M. Oller-Marcén, and László Tóth, <a href="https://doi.org/10.5486/PMD.2015.7098">Counting invertible sums of squares modulo n and a new generalization of Euler totient function</a>, Publ. Math. Debrecen, Vol. 87 (2015), pp. 133-145; <a href="https://arxiv.org/abs/1403.7878">arXiv preprint</a>, arXiv:1403.7878 [math.NT], 2014.
%F A239612 Multiplicative with a(2^e) = (3*e+1)*2^(3*e-2), a(p^e) = (p-1) * p^(3*e-2) * ((e+1)*p + e) if p == 1 (mod 4), and a(p^e) = (p-1) * p^(3*e-2) * ((e+1)*p - e) if p == 3 (mod 4). - _Amiram Eldar_, Nov 10 2026
%t A239612 g3[n_] := Sum[If[GCD[x^2 + y^2 + z^2, n] == 1, GCD[x^2 + y^2 + z^2 - 1, n], 0],{x, 1, n},{y, 1, n},{z,1,n}]; Array[g3,100]
%t A239612 (* Alternative: *)
%t A239612 f[p_, e_] := (p-1) * p^(3*e-2) * ((e+1)*p + e*If[Mod[p, 4] == 1, 1, -1]); f[2, e_] := (3*e+1)*2^(3*e-2); a[1] = 1; a[n_] := Times @@ f @@@ FactorInteger[n]; Array[a, 40] (* _Amiram Eldar_, Nov 10 2026 *)
%o A239612 (PARI) a(n) = {s = 0; for (x=1, n, for (y=1, n, for (z=1, n, if (gcd(x^2+y^2+z^2,n) == 1, s += gcd(x^2+y^2+z^2-1,n));););); s;} \\ _Michel Marcus_, Jun 29 2014
%o A239612 (PARI) a(n)={my(p=lift(Mod(sum(i=0, n-1, x^(i^2%n)), x^n-1)^3)); sum(i=0, n-1, if(gcd(i,n)==1, polcoeff(p,i)*gcd((i-1)%n,n)))} \\ _Andrew Howroyd_, Aug 07 2018
%o A239612 (PARI) a(n) = vecprod([if(f[1] == 2, (3*f[2]+1)*2^(3*f[2]-2), (f[1]-1) * f[1]^(3*f[2]-2) * ((f[2]+1)*f[1] + f[2] * if(f[1] % 4 == 1, 1, -1))) | f <- factor(n)~]); \\ _Amiram Eldar_, Nov 10 2026
