%I A239769 #29 Nov 21 2026 18:57:30
%S A239769 1,1,10,195,7000,397445,32540976,3612881587,520731462784,
%T A239769 94312294639497,20929138371078400,5577128473384886231,
%U A239769 1755478020849619203072,643798549193343508673917,271915976600905826731300864,130956701266414213878987466875,71298552679072447120532120436736
%N A239769 Number of pairs of functions (f, g) from a size n set into itself satisfying f(g(f(x))) = g(g(f(x))).
%H A239769 Alois P. Heinz, <a href="/A239769/b239769.txt">Table of n, a(n) for n = 0..150</a>
%p A239769 s:= proc(n, i) option remember; `if`(i=0, [[]],
%p A239769        map(x-> seq([j, x[]], j=1..n), s(n, i-1)))
%p A239769     end:
%p A239769 a:= proc(n) (l-> add(add(`if`([true$n]=[seq(evalb(
%p A239769        f[g[f[i]]]=g[g[f[i]]]), i=1..n)], 1, 0), g=l), f=l))(s(n$2))
%p A239769     end:
%p A239769 seq(a(n), n=0..5);  # _Alois P. Heinz_, Jul 16 2014
%p A239769 # Alternative:
%p A239769 b:= proc(n, m) option remember;
%p A239769      `if`(n=0, x^m, m*b(n-1, m)+b(n-1, m+1))
%p A239769     end:
%p A239769 s:= proc(u, v, c) option remember; `if`(u<v, 0, add(
%p A239769       binomial(c, j)*(v+j)!*coeff(b(u, 0), x, v+j), j=0..c))
%p A239769     end:
%p A239769 a:= proc(n) option remember; `if`(n=0, 1, add(add(add(n!/
%p A239769       (k-r)!/(r-c)!*coeff(b(r, 0), x, c)*s(n-r, k-c, c)*
%p A239769        add(n^(n-k-m+r)/(n-k-m+r)!/(m-r)!*s(k-r, m-c, c),
%p A239769          m=max(1, r)..n-k+r), c=0..r), r=0..k), k=1..n))
%p A239769     end:
%p A239769 seq(a(n), n=0..16);  # _Alois P. Heinz_, Nov 21 2026
%t A239769 a[n_] := a[n] = If[n == 0, 1, Module[{f, g, T}, T = Tuples[Range[n], n]; Table[f = T[[j, #]]&; g = T[[k, #]]&; Table[True, {n}] == Table[f[g[f[i]]] == g[g[f[i]]], {i, n}], {j, n^n}, {k, n^n}] // Flatten // Count[#, True]&]];
%t A239769 Table[Print[n, " ", a[n]]; a[n], {n, 0, 5}] (* _Jean-François Alcover_, Sep 22 2022 *)
