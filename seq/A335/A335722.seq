%T A335722 107767,151987,232379,238539,289155,306859,331115,360267,411803,
%U A335722 427467,471115,576987,611187,681963,713767,742467,765195,811947,871827,982315,1043915,1174859,1211115
%N A335722 Integers m such that A014448(m) == 1 (mod m).
%C A335722 Inspired by A335670.
%C A335722 All terms > 3 are odd and composite. - _Michel Marcus_, Jun 19 2020
%H A335722 Chai Wah Wu, <a href="/A335722/b335722.txt">Table of n, a(n) for n = 1..861</a>
%t A335722 Select[Range[10^4], Divisible[LucasL[3#] - 1, #] &] (* _Amiram Eldar_, Jun 19 2020 *)
%o A335722 (Python)
%o A335722 from itertools import islice
%o A335722 from sympy import nextprime
%o A335722 from oeis_sequences.OEISsequences import lucas_mod
%o A335722 def A335722_gen(): # generator of terms
%o A335722     yield from (1,3)
%o A335722     a, b = 7, 11
%o A335722     while True:
%o A335722         for k in range(a+2,b,2):
%o A335722             if lucas_mod(3*k,k)==1:
%o A335722                 yield k
%o A335722         a, b = b, nextprime(b)
%o A335722 A335722_list = list(islice(A335722_gen(),20)) # _Chai Wah Wu_, Aug 07 2026
%Y A335722 Cf. A014448, A335670, A335721.
%K A335722 nonn,changed
%O A335722 1,2
%A A335722 _Chai Wah Wu_, Jun 18 2020
