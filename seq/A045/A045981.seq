%I A045981 #21 Aug 19 2026 00:55:57
%S A045981 1,11,1121,1121211211,112121121121121112211221,
%T A045981 112121121121121112211221211211122112211221123122212211
%N A045981 Describe all the previous terms! Version 1: term by term.
%C A045981 Previous terms are described one by one in succession. Next terms are 118, 256, 564 and 1262 digits long.
%H A045981 Reinhard Zumkeller, <a href="/A045981/b045981.txt">Table of n, a(n) for n = 1..9</a>
%H A045981 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/LookandSaySequence.html">Look and Say Sequence</a>
%H A045981 Wikipedia, <a href="https://en.wikipedia.org/wiki/Look-and-say_sequence">Look-and-say sequence</a>
%t A045981 g[n_]:=Split[IntegerDigits[a[n-1]]];
%t A045981 f[n_]:=Flatten[Riffle[Length[#]&/@g[n],Union/@g[n]]];
%t A045981 a[1]=1;a[2]=11;a[3]=1121;
%t A045981 a[n_]:=a[n]=FromDigits[Join[IntegerDigits[a[n-1]],f[n]]];
%t A045981 a/@Range[9] (* _Ivan N. Ianakiev_, Aug 13 2026 *)
%o A045981 (Haskell)
%o A045981 a045981 n = a045981_list !! (n-1)
%o A045981 a045981_list = 1 : f 1 [] where
%o A045981    f x zs = y : f y zs' where
%o A045981      y = read (concatMap show zs')
%o A045981      zs' = zs ++ [a045918 x]
%o A045981 -- _Reinhard Zumkeller_, Feb 28 2014
%o A045981 (Python)
%o A045981 from itertools import groupby, islice
%o A045981 def LS(n): return "".join(str(len(list(g)))+k for k, g in groupby(str(n)))
%o A045981 def agen(): # generator of terms
%o A045981     alst = [1]
%o A045981     while True:
%o A045981         yield alst[-1]
%o A045981         an = int("".join(LS(ai) for ai in alst))
%o A045981         alst.append(an)
%o A045981 print(list(islice(agen(), 7))) # _Michael S. Branicky_, Aug 13 2026
