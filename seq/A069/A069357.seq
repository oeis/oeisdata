%I A069357 #15 Jul 30 2026 01:23:17
%S A069357 1,3,4,6,8,11,15,20,21,28,30,37,40,53,58,70,77,85,102,113,135,150,167,
%T A069357 199,222,248,264,295,330,392,439,492,521,584,655,735,777,872,979,1034,
%U A069357 1161,1304,1465,1546,1737,1952,2059,2194,2314,2601,2924,3083,3466,3897
%N A069357 Numbers of form 2^i*3^j + (i+j) with i, j >= 0.
%C A069357 Is 11 = 2^0 * 3^2 + 0 + 2 = 2^3 * 3^0 + 3 + 0 the only term that occurs in more than one way? - _Robert Israel_, Jul 29 2026
%H A069357 Robert Israel, <a href="/A069357/b069357.txt">Table of n, a(n) for n = 1..10000</a>
%F A069357 Distinct values of A003586(k) + A069352(k). [Corrected by _Georg Fischer_, Dec 11 2022, further clarification by _Sean A. Irvine_, Apr 28 2024]
%p A069357 N:= 4000: # for terms <= N
%p A069357 S:= {}:
%p A069357 for i from 0 while 2^i + i < N do
%p A069357   for j from 0 do
%p A069357     x:= 2^i*3^j + i + j;
%p A069357     if x > N then break fi;
%p A069357     S:= S union {x}
%p A069357 od od:
%p A069357 sort(convert(S,list)); # _Robert Israel_, Jul 29 2026
%Y A069357 Cf. A055600, A069358, A064800, A022328, A022329.
%K A069357 nonn,changed
%O A069357 1,2
%A A069357 _Reinhard Zumkeller_, Mar 18 2002
%E A069357 Missing a(1)=1 inserted and duplicate values removed by _Sean A. Irvine_, Apr 28 2024
