%I A069781 #37 Oct 31 2026 12:39:32
%S A069781 432,576,648,1600,2000,2160,2880,2916,3024,3136,3240,4032,4536,4752,
%T A069781 4800,5000,5488,5616,6000,6336,7128,7344,7488,7744,8208,8424,9408,
%U A069781 9792,9936,10125,10800,10816,10944,11016,11200,12312,12528,13248,13392
%N A069781 Numbers k such that gcd(d(k^3), d(k)) is not a power of 2.
%C A069781 Numbers k such that log_2(gcd(A000005(k^3), A000005(k))) is nonintegral.
%C A069781 The complement of this sequence in the positive integers A000027 is A069782. - _M. F. Hasler_, Jan 18 2015
%C A069781 The numbers of the form 4*3^(7*m - 1), m >= 1, are terms. - _Marius A. Burtea_, Oct 18 2019
%C A069781 From _Amiram Eldar_, Oct 30 2026: (Start)
%C A069781 Numbers whose prime factorization exponents include at least one pair (e_1, e_2) such that gcd(e_1 + 1, 3*e_2 + 1) has an odd prime factor. Both e_1 and e_2 must be larger than 1.
%C A069781 For example, the pairs of exponents with members not exceeding 10 are (4, 3), (4, 8), (6, 2), (6, 9), (9, 3), (9, 8) and (10, 7).
%C A069781 The characteristic function of this sequence depends only on the prime signature (A118914).
%C A069781 The primitive terms of this sequence are the powerful terms. Every term in this sequence can be represented as the product of a powerful term and a coprime squarefree number.
%C A069781 The asymptotic density of this sequence can be evaluated by considering first the terms that have an exponent 2 in their prime factorization. These have at least one additional exponent of the form 7*k + 6 (k >= 0), and their asymptotic density is 1 - Product_{p prime} (1-(p-1)/p^3) - Product_{p prime} (1-(p-1)/(p^7-1)) + Product_{p prime} (1-(p-1)/p^3-(p-1)/(p^7-1)) = 0.0013262426812504028828... .
%C A069781 Terms without exponent 2 in their prime factorization have density that can be evaluated by summing over 3-full terms in this sequence: Sum_{n>=1, a(n) in A036966} f(a(n)) = 0.001906252974..., where f(k) = (1/(zeta(3)*k)) * Product_{p|k} p^2/(p^2+p+1).
%C A069781 Thus, the asymptotic density of this sequence is the sum of these two densities: 0.003232495656... . (End)
%H A069781 Charles R Greathouse IV, <a href="/A069781/b069781.txt">Table of n, a(n) for n = 1..10000</a>
%e A069781 For k < 100000, gcd(d(k^3),d(k)) = {5, 7, 10, 14, 20, 28, 40, 80} which is obtained for k = {20736, 576, 432, 2880, 54000, 20160, 2160, 15120}, respectively.
%t A069781 f[x_] := GCD[DivisorSigma[0, x^3], DivisorSigma[0, x]]; seq = {}; Do[s = f[n]; If[!IntegerQ[Log[2, s]], AppendTo[seq, n]], {n, 1, 13400}]; seq
%t A069781 (* Alternative: *)
%t A069781 Select[Range[14000],!IntegerQ[Log[2,GCD[DivisorSigma[0,#^3], DivisorSigma[ 0,#]]]]&] (* _Harvey P. Dale_, Mar 20 2018 *)
%o A069781 (PARI) is(n)=my(f=factor(n)[,2], g=gcd(prod(i=1,#f,3*f[i]+1), prod(i=1,#f,f[i]+1))); g!=1<<valuation(g, 2) \\ _Charles R Greathouse IV_, Oct 16 2015
%o A069781 (Magma) f:=func<n| Gcd(#Divisors(n^3),#Divisors(n))>; [k:k in [1..14000]| not IsIntegral(Log(2,f(k)))]; // _Marius A. Burtea_, Oct 18 2019
%Y A069781 Cf. A000005, A036966, A037992, A061701, A069780, A069782 (complement), A118914.
%K A069781 nonn,changed
%O A069781 1,1
