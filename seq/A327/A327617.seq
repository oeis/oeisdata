%T A327617 9,2,15,17,3,5,63,11,6,8,3,23,18,11,33,8,3,5,27,2,6,8,3,50,18,2,6,35,
%U A327617 3,5,18,2,6,44,3,41,90,2,6,35,3,32,90,2,186,62,3,32,9,20,6
%N A327617 a(n) is the least integer k such that digit_sum(A007494(n)*k) = digit_sum(A007494(n)+k).
%C A327617 It appears that most terms are less than 100.
%H A327617 Robert Israel, <a href="/A327617/b327617.txt">Table of n, a(n) for n = 0..10000</a>
%p A327617 ds:= n -> convert(convert(n,base,10),`+`):
%p A327617 f:= proc(n) local k,t;
%p A327617   t:=  (3*n+(n mod 2))/2;
%p A327617   for k from 0 do if ds(t*k) = ds(t+k) then return k fi od
%p A327617 end proc:
%p A327617 map(f, [$0..100]); # _Robert Israel_, Oct 12 2026
%o A327617 (PARI) lista(nn) = {for (n=0, nn, if ((n%3) != 1, my(k=0); while(sumdigits(n+k) != sumdigits(n*k), k++); print1(k, ", ");););} \\ _Michel Marcus_, Sep 19 2019
%Y A327617 Cf. A007494, A007953 (sum of digits).
%K A327617 nonn,base,changed
%O A327617 0,2
