%I A242817 #59 Oct 11 2026 21:06:46
%S A242817 1,1,6,57,756,12880,268098,6593839,187104200,6016681467,216229931110,
%T A242817 8588688990640,373625770888956,17666550789597073,902162954264563306,
%U A242817 49482106424507339565,2901159958960121863952,181069240855214001514460,11985869691525854175222222
%N A242817 a(n) = B(n,n), where B(n,x) = Sum_{k=0..n} Stirling2(n,k)*x^k are the Bell polynomials (also known as exponential polynomials or Touchard polynomials).
%C A242817 A030019(n) = B(n-1,n)/n counts hypertrees on [n], A035051(n) = B(n-1,n) counts hypertrees rooted at a node, and A052888(n) = B(n,n)/n counts hypertrees rooted at a (hyper)edge. a(n) = B(n,n) counts hypertrees with both an edge and a node distinguished; equivalently, rooted at an edge and a node simultaneously. - _Natalia L. Skirrow_, Aug 28 2026
%H A242817 Alois P. Heinz, <a href="/A242817/b242817.txt">Table of n, a(n) for n = 0..370</a>
%H A242817 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/BellPolynomial.html">Bell Polynomial</a>.
%H A242817 Wikipedia, <a href="https://en.wikipedia.org/wiki/Touchard_polynomials">Touchard polynomials</a>
%F A242817 E.g.f.: x*f'(x)/f(x), where f(x) is the generating series for sequence A035051.
%F A242817 a(n) ~ (exp(1/LambertW(1)-2)/LambertW(1))^n * n^n / sqrt(1+LambertW(1)). - _Vaclav Kotesovec_, May 23 2014
%F A242817 Conjecture: It appears that the equation a(n)*e^n = Sum_{k>=0} k^n*n^k/k! is true for every positive integer n. - _Nicolas Nagel_, Apr 20 2016 [This is just the special case k=x of the formula B(n,x) = e^(-x) * Sum_{k>=0} k^n*x^k/k!; see for example the World of Mathematics link. - _Pontus von Brömssen_, Dec 05 2020]
%F A242817 a(n) = n! * [x^n] exp(n*(exp(x)-1)). - _Alois P. Heinz_, May 17 2016
%F A242817 a(n) = [x^n] Sum_{k=0..n} n^k*x^k/Product_{j=1..k} (1 - j*x). - _Ilya Gutkovskiy_, May 31 2018
%F A242817 From _Natalia L. Skirrow_, Aug 28 2026: (Start)
%F A242817 E.g.f.: A(x) = 1 + x*g'(x) = 1 + x*h(x)*f'(x) = 1/(1 - f(x)*h(x)), where f(x) = x*exp(g(x)) is the e.g.f. of A035051, g(x) = exp(f(x)) - 1 is the e.g.f. of A052888, and h(x) = exp(f(x)) = g(x) + 1.
%F A242817 a(n) = n*A052888(n) for n>0.
%F A242817 a(n) = Sum_{k=0..n-1} C(n-1,k)*A006153(n-k)*B(k,n) for n>0.
%F A242817 a(n) = n*Sum_{k=1..n} C(n-1,k-1)*A035051(k)*A052888(n-k) for n>0.
%F A242817 a(n) = (n-1)! * [x^(n-1)] exp(n*(LambertW(x) + x/LambertW(x) - 1))/(1-x)^2 for n>0.
%F A242817 a(n) = n! + Sum_{k=1..n-1} k*ff(n,k)*Sum_{j=0..n-k-1} C(n-r,j)*B(j,n)*(k^(n-k-j) + (k+1)^(n-k-1-j)).
%F A242817 (End)
%p A242817 A:= proc(n, k) option remember; `if`(n=0, 1, (1+
%p A242817       add(binomial(n-1, j-1)*A(n-j, k), j=1..n-1))*k)
%p A242817     end:
%p A242817 a:= n-> A(n$2):
%p A242817 seq(a(n), n=0..20);  # _Alois P. Heinz_, May 17 2016
%t A242817 Table[BellB[n, n], {n, 0, 20}]
%o A242817 (Maxima) a(n):=stirling2(n,0)+sum(stirling2(n,k)*n^k,k,1,n);
%o A242817 makelist(a(n),n,0,30);
%o A242817 (PARI) a(n) = sum(k=0, n, stirling(n,k,2)*n^k); \\ _Michel Marcus_, Apr 20 2016
%o A242817 (Python)
%o A242817 from functools import cache
%o A242817 A052888=cache(lambda n: n and (c:=1)*n*A030019(n) + sum((c:=c*(n-k)//k)*(n-k)*A030019(n-k)*A052888(k) for k in range(1, n)))
%o A242817 A030019=cache(lambda n: int(n<2) or (c:=1)*A030019(n-1) + sum((c:=c*(n-k)//(k-1))*A030019(n-k)*A052888(k) for k in range(2, n)))
%o A242817 A242817=lambda n: n*A052888(n) # Natalia L. Skirrow, Aug 28 2026
%Y A242817 Cf. A006153, A035051, A292866, A346654, A346655.
%Y A242817 Main diagonal of A189233 and of A292860.
%K A242817 nonn,changed
%O A242817 0,3
