%I A248127 #65 Sep 23 2026 01:25:52
%S A248127 2,4,5,10,31,72,75,80,162,270,383,640,1250,2000,2160,3430,4000,5000,
%T A248127 5120,7290,10000,13310,17280,21970,27440,28875,31000,33750,40960,
%U A248127 49130,58320,68590,72000,75000,80000,92610,106480,112625,121670,138240,156250,162000,175760,196830
%N A248127 Numbers whose squares became cubes if some digit is prepended, inserted or appended.
%C A248127 From  _Adam Reichert_, Sep 20 2026: (Start)
%C A248127 Prepending 0 is not permitted.
%C A248127 The sequence is infinite, since it contains k = 10*m^3 for all m >= 1: k^2 = 100*m^6 and appending 0 yields 1000*m^6 = (10*m^2)^3. (End)
%C A248127 Are there any terms larger than 170734875 that are no multiple of 10? - _David A. Corneth_, Sep 22 2026
%H A248127 Michael S. Branicky, <a href="/A248127/b248127.txt">Table of n, a(n) for n = 1..10046</a> (all terms <= 10^13)
%H A248127 Michael S. Branicky, <a href="/A248127/a248127.py.txt">Python program for OEIS A248127</a>
%H A248127 David A. Corneth, <a href="/A248127/a248127.gp.txt">PARI program</a>
%e A248127 10 is a term since 10^2 = 100 and if we append a 0 we have 1000 = 10^3.
%e A248127 31 is a term since 31^2 = 961 and if we insert a 2 we have 9261 = 21^3.
%e A248127 112625 is a term since 112625^2 = 12684390625 and if we insert an 8 we have 126884390625 = 5025^3.
%e A248127 8 is not term even though 8^2 = 64 and 064 = 4^3 since prepending 0 is not allowed.
%p A248127 with(numtheory): P:=proc(q) local a, b, c, j, k, ok, n;
%p A248127 for n from 1 to q do a:=n^2; c:=ilog10(a)+1; ok:=1; for k from 0 to ilog10(a)+1 do
%p A248127 if ok=1 then for j from 0 to 9 do if not (k=c and j=0) then b:=trunc(a/10^k)*10^(k+1)+j*10^k+(a mod 10^k);
%p A248127 if b=trunc(evalf((b)^(1/3)))^3 then print(n); ok:=0; break; fi; fi; od; fi; od; od; end: P(10^9);
%t A248127 f[n_] := ! MissingQ@SelectFirst[Rest@Flatten[Outer[Insert[IntegerDigits[n^2], #2, #1] &, Range[IntegerLength[n^2] + 1], Range[0, 9]], 1], IntegerQ@CubeRoot@FromDigits@# &];
%t A248127 Select[Range[100], f] (* _Davin Park_, Dec 30 2016 *)
%o A248127 (Python)
%o A248127 from gmpy2 import digits, iroot, mpz
%o A248127 def ok(n):
%o A248127     s = digits(n*n)
%o A248127     return any(iroot(mpz(s[:i]+d+s[i:]), 3)[1] for i in range(len(s)+1) for d in "0123456789"[i==0:])
%o A248127 print([k for k in range(1, 2*10**5) if ok(k)]) # _Michael S. Branicky_, Sep 21 2026
%o A248127 (Python) # see linked program for an alternative, faster algorithm for producing b-file
%o A248127 (PARI) \\ See Corneth link
