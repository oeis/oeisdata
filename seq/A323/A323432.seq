%e A323432 .
%e A323432   [3]
%e A323432   [2]
%e A323432   [1]
%t A323432 Table[Sum[Length[Select[Union[Tuples[IntegerPartitions[#,{k}]&/@ptn]],And@@(OrderedQ[#,Greater]&/@Transpose[#])&]],{ptn,IntegerPartitions[n]},{k,Min[ptn]}],{n,30}]
