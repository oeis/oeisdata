%I A323531 #11 Nov 14 2026 09:21:43
%S A323531 1,1,1,1,2,2,4,5,9,12,18,24,36,48,69,97,139,196,283,402,576,819,1161,
%T A323531 1635,2301,3209,4469,6193,8571,11812,16291,22404,30850,42414,58393,
%U A323531 80305,110578,152091,209308,287686,395352,542413,743603,1017489,1390510,1896482
%N A323531 Number of square multiset partitions of integer partitions of n.
%C A323531 A multiset partition is square if the number of parts is equal to the number of parts in each part.
%H A323531 Vladeta Jovovic, <a href="/A323531/b323531.txt">Table of n, a(n) for n = 0..5000</a>
%F A323531 G.f.: 1 + Sum_{r>=1} [z^r] Product_{m>=r} (1-z*x^m)^(-p_r(m)), where p_r(m) is the number of integer partitions of m into exactly r positive parts. For the coefficient of x^n, only r <= floor(sqrt(n)) and m <= n-r*(r-1) are needed. - _Vladeta Jovovic_, Nov 13 2026
%e A323531 The a(3) = 1 through a(9) = 12 square multiset partitions:
%e A323531   (3)  (4)       (5)       (6)       (7)       (8)       (9)
%e A323531        (11)(11)  (21)(11)  (21)(21)  (22)(21)  (22)(22)  (32)(22)
%e A323531                            (22)(11)  (31)(21)  (31)(22)  (32)(31)
%e A323531                            (31)(11)  (32)(11)  (31)(31)  (33)(21)
%e A323531                                      (41)(11)  (32)(21)  (41)(22)
%e A323531                                                (33)(11)  (41)(31)
%e A323531                                                (41)(21)  (42)(21)
%e A323531                                                (42)(11)  (43)(11)
%e A323531                                                (51)(11)  (51)(21)
%e A323531                                                          (52)(11)
%e A323531                                                          (61)(11)
%e A323531                                                          (111)(111)(111)
%t A323531 Table[Sum[Length[Union@@(Union[Sort/@Tuples[IntegerPartitions[#,{k}]&/@#]]&/@IntegerPartitions[n,{k}])],{k,Sqrt[n]}],{n,30}]
%t A323531 (* Alternative: *)
%t A323531 nmax = 50; CoefficientList[Series[1 + Sum[SeriesCoefficient[Product[1/(1 - z*x^m)^SeriesCoefficient[x^r/Product[1 - x^j, {j, 1, r}], {x, 0, m}], {m, r, nmax - r*(r-1)}], {z, 0, r}], {r, 1, Floor[Sqrt[nmax]]}], {x, 0, nmax}], x] (* _Vaclav Kotesovec_, Nov 14 2026, after _Vladeta Jovovic_ *)
