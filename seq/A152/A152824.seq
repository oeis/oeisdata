%N A152824 Numbers such that each digit leaves the same nonzero remainder when each is divided into the number.
%H A152824 Joshua Zucker, <a href="/A152824/b152824.txt">Table of n, a(n) for n = 1..2588</a> (corrected by Alper Ferudun)
%H A152824 <a href="/index/Ar#10-automatic">Index entries for 10-automatic sequences</a>.
%e A152824 289 is a term since 289 == 1 (mod 2) == 1 (mod 8) == 1 (mod 9).
%e A152824 338 is a term since 388 == 2 (mod 3) == 2 (mod 8).
%t A152824 fQ[n_] := Block[{a = Union@ Mod[n, IntegerDigits@n]}, a != {0} && Length@ a == 1]; Select[Range@ 4248, fQ@# &] (* _Robert G. Wilson v_, Dec 14 2008 *)
%o A152824 (PARI) is(n)=my(d=Set(digits(n)),t); if(#d<2 || d[1]==0, return(0)); t=n%d[1]; if(t==0, return(0)); for(i=2,#d, if(n%d[i]!=t, return(0))); 1 \\ _Charles R Greathouse IV_, Feb 15 2017
%o A152824 (Python)
%o A152824 def ok(n):
%o A152824     digs = set(map(int, str(n)))
%o A152824     return 0 not in digs and len(rems:=set(n%d for d in digs)) == 1 and 0 not in rems
%o A152824 print([k for k in range(4000) if ok(k)]) # _Michael S. Branicky_, Oct 18 2026
