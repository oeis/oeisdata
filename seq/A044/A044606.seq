%I A044606 #14 Sep 02 2026 13:51:05
%S A044606 38,102,166,230,294,311,358,422,486,550,614,678,742,806,823,870,934,
%T A044606 998,1062,1126,1190,1254,1318,1335,1382,1446,1510,1574,1638,1702,1766,
%U A044606 1830,1847,1894,1958,2022,2086,2150,2214,2278,2342
%N A044606 Numbers k such that string 4,6 occurs in the base 8 representation of k but not of k+1.
%H A044606 Harvey P. Dale, <a href="/A044606/b044606.txt">Table of n, a(n) for n = 1..1000</a>
%t A044606 SequencePosition[Table[If[SequenceCount[IntegerDigits[n,8],{4,6}]>0,1,0],{n,2500}],{1,0}][[All,1]] (* Requires Mathematica version 10 or later *) (* _Harvey P. Dale_, Apr 09 2018 *)
%t A044606 (* Alternative: *)
%t A044606 SequencePosition[Table[Boole[StringContainsQ[IntegerString[n,8],"46"]],{n,2500}],{1,0}][[;;,1]] (* _Harvey P. Dale_, Aug 18 2026 *)
%K A044606 nonn,base,changed
%O A044606 1,1
%A A044606 _Clark Kimberling_
