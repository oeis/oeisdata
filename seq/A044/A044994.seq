%S A044994 0,3,10,12,31,37,39,94,112,118,120,283,337,355,361,363,850,1012,1066,
%T A044994 1084,1090,1092,2551,3037,3199,3253,3271,3277,3279,7654,9112,9598,
%U A044994 9760,9814,9832,9838,9840,22963,27337,28795,29281,29443
%N A044994 Numbers whose base-3 representation contains exactly one 0 and no 2's.
%t A044994 Select[Range[0,30000],DigitCount[#,3,0]==1&&DigitCount[#,3,2]==0&] (* _Harvey P. Dale_, Jun 20 2021 *)
%o A044994 (Python)
%o A044994 from math import comb, isqrt
%o A044994 def A044994(n): return -3**(comb((m:=isqrt(k:=n-1<<1))+(k>m*(m+1))+1,2)-n+1)+(3**((isqrt(k<<2)+1>>1)+1)-1>>1) # _Chai Wah Wu_, Oct 15 2026
%Y A044994 Cf. A007089.
