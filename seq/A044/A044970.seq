%S A044970 0,6,20,24,62,74,78,188,224,236,240,566,674,710,722,726,1700,2024,
%T A044970 2132,2168,2180,2184,5102,6074,6398,6506,6542,6554,6558,15308,18224,
%U A044970 19196,19520,19628,19664,19676,19680,45926,54674,57590,58562,58886,58994,59030,59042
%N A044970 Numbers whose base-3 representation contains exactly one 0 and no 1's.
%H A044970 Zhuorui He, <a href="/A044970/b044970.txt">Table of n, a(n) for n = 1..10000</a> (first 92 terms from Vincenzo Librandi)
%F A044970 From _Zhuorui He_, Oct 12 2026: (Start)
%F A044970 a(n) = 2*A044994(n).
%F A044970 a(n) = 3^(A002024(n-1) + 1) - 1 - 2*3^(A004736(n-1) - 1) for n >= 2. (End)
%t A044970 Select[Range[0, 2 10^6], DigitCount[#, 3, 0]==1 && DigitCount[#, 3, 1]==0 &] (* _Vincenzo Librandi_, Jun 28 2019 *)
%o A044970 (Python)
%o A044970 from math import comb, isqrt
%o A044970 def A044970(n): return (-3**(comb((m:=isqrt(k:=n-1<<1))+(k>m*(m+1))+1,2)-n+1)<<1)+(3**((isqrt(k<<2)+1>>1)+1)-1) # _Chai Wah Wu_, Oct 15 2026
%Y A044970 Cf. A007089, A044994, A002024, A004736.
%K A044970 nonn,base,easy
%O A044970 1,2
