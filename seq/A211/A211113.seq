%N A211113 Decimal expansion of -zeta(-1/2).
%H A211113 G. C. Greubel, <a href="/A211113/b211113.txt">Table of n, a(n) for n = 0..20000</a>
%H A211113 Wikipedia, <a href="https://en.wikipedia.org/wiki/Riemann_zeta_function">Riemann zeta function</a>
%F A211113 Equals -zeta(-1/2) = zeta(3/2)/(4*Pi) = A078434/ (10*A019694).
%e A211113 0.207886224977354566017306725397049302226...
%p A211113 -Zeta(-1/2) ; evalf(%) ;
%t A211113 RealDigits[-Zeta[-1/2], 10, 100][[1]] (* _Amiram Eldar_, Mar 24 2021 *)
%o A211113 (PARI) -zeta(-1/2) \\ _Charles R Greathouse IV_, May 18 2012
%o A211113 (Magma)
%o A211113 m:= 250; R:=RealField(m+2); SetDefaultRealField(R);
%o A211113 c:= Evaluate(RiemannZeta(), 3/2)/(4*Pi(R));
%o A211113 Prune(Reverse(IntegerToSequence(Round( (c)*10^m )))); // _G. C. Greubel_, Nov 13 2026
%o A211113 (SageMath)
%o A211113 m=250
%o A211113 c=numerical_approx( -zeta(-1/2) , digits=m+5)
%o A211113 print([ZZ(i) for i in c.str()[:-5] if i.isdigit()][1:]) # _G. C. Greubel_, Nov 13 2026
%Y A211113 Cf. A019694, A059750, A078434.
%K A211113 nonn,cons,easy,changed
%O A211113 0,1
%A A211113 _Stanislav Sykora_, May 17 2012
