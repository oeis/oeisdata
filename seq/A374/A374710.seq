%I A374710 #19 Nov 14 2026 18:36:21
%S A374710 1,4,10,20,35,56,82,117,162,215,279,352,426,528,645,772,899,1057,1235,
%T A374710 1429,1647,1883,2133,2415,2694,3022,3374,3721,4130,4564,5011,5503,
%U A374710 5986,6531,7045,7664,8273,8945,9659,10383,11127,11949,12809,13713,14649,15633,16644,17715,18735,19916
%N A374710 Number of distinct sums i^3 + j^3 + k^3 for 0<=i<=j<=k<=n.
%H A374710 Robert Israel, <a href="/A374710/b374710.txt">Table of n, a(n) for n = 0..200</a>
%p A374710 N:= 30; # for a(0)..a(N)
%p A374710 V:= {}:
%p A374710 r:= 0:
%p A374710 for n from 0 to N do
%p A374710   for j from 0 to n do
%p A374710     for i from 0 to j do
%p A374710       v:= i^3 + j^3 + n^3;
%p A374710       if not member(v,V) then
%p A374710         V:= V union {v};
%p A374710         r:= r + 1;
%p A374710       fi
%p A374710   od od;
%p A374710   R[n]:= r
%p A374710 od:
%p A374710 seq(R[i],i=0..N); # _Robert Israel_, Nov 13 2026
%o A374710 (PARI) a(n) = my(v=vector(3*n^3+1)); for(i=0, n, for(j=i, n, for(k=j, n, v[i^3+j^3+k^3+1]+=1))); sum(i=1, #v, v[i]>0);
%Y A374710 Cf. A374707, A374711, A402120.
%Y A374710 Cf. A034966.
%K A374710 nonn,changed
%O A374710 0,2
%A A374710 _Seiichi Manyama_, Jul 17 2024
