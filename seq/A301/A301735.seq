%S A301735 1,-1,-2,-2,-2,0,1,5,7,11,13,16,14,14,8,0,-12,-26,-46,-66,-90,-114,
%T A301735 -135,-155,-169,-174,-165,-147,-105,-48,37,142,280,435,627,828,1060,
%U A301735 1293,1543,1770,1994,2169,2309,2362,2342,2191,1925,1480,873,46,-984,-2268,-3785
%N A301735 Coefficients of q-series associated with the colored tetrahedron graph J_{6j,0}. Also the q-series J0(q,1) of Flajolet and Sedgewick.
%C A301735 The reference gives the first 36 terms.
%H A301735 Philippe Flajolet and Robert Sedgewick, <a href="https://algo.inria.fr/flajolet/Publications/books.html">Analytic Combinatorics</a>, 2009; Chapter IX, §IX.6, Eq. (43), page 661.
%H A301735 S. Garoufalidis, <a href="https://doi.org/10.1007/s40687-018-0127-3">Quantum knot invariants</a>, Research in the Mathematical Sciences, Vol. 5 (2018), p.15.
%F A301735 From _Peter Luschny_, Sep 30 2026: (Start)
%F A301735 Garoufalidis gives the normalized tetrahedron 6j-symbol series phi_{6j,0}(q) as:
%F A301735 phi_{6j, 0}(q) = (q)_{oo} * Sum_{n>=0} (-1)^n * q^((3/2)*n^2 + (1/2)*n) / ((q)_n)^3.
%F A301735 A simpler single-sum q-series representation is:
%F A301735 a(n) = [q^n] Sum_{n>=0} (-1)^n * q^(n*(n+1)/2) / (q; n)^2 where (q; n) is the q-Pochhammer symbol.
%F A301735 This q-series is called J0(q, 1) in [Flajolet/Sedgewick, 2009]. (End)
%t A301735 (* Formula of Garoufalidis: *)
%t A301735 qpoch[q_, n_Integer?NonNegative] := Product[1 - q^j, {j, 1, n}];
%t A301735 phi[q_, N_Integer?NonNegative] := Product[1 - q^j, {j, 1, N}] * Sum[(-1)^n q^((3 n^2 + n)/2) / qpoch[q, n]^3, {n, 0, N} ];
%t A301735 CoefficientList[Series[phi[q, 52], {q, 0, 52}], q]  (* _Peter Luschny_, Sep 30 2026 *)
%t A301735 (* Alternative: *)
%t A301735 J0[q_, Nmax_Integer : 100] := Sum[(-1)^n q^(n (n + 1)/2) / qpoch[q, n]^2, {n, 0, Nmax} ];
%t A301735 CoefficientList[Series[J0[q, 52], {q, 0, 52}], q]  (* _Peter Luschny_, Sep 30 2026 *)
%Y A301735 Cf. A400284 (J1).
%K A301735 sign,changed
