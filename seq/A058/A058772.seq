%I A058772 #16 Oct 29 2026 14:43:21
%S A058772 2,3,4,19,25,61,100,143,144,159,304,1973,4433,4921,6076,12876,16895,
%T A058772 30180
%N A058772 Numbers k such that k * (1+i)^k - i is a Gaussian prime.
%H A058772 <a href="/index/Ga#gaussians">Index entries for Gaussian integers and primes</a>
%t A058772 Do[ If[ PrimeQ[ n * (1 + I)^n - I], Print[n] ], {n, 1, 35000} ]
%t A058772 (* Alternative: *)
%t A058772 Select[Range[31000],PrimeQ[# (1+I)^#-I]&] (* _Harvey P. Dale_, Mar 06 2018 *)
%o A058772 (Python)
%o A058772 from sympy import I
%o A058772 from sympy.ntheory import is_gaussian_prime
%o A058772 def ok(k): return is_gaussian_prime( k*(1+I)**k - I )
%o A058772 print([k for k in range(2000) if ok(k)]) # _Michael S. Branicky_, Oct 29 2026
%Y A058772 Cf. A058770, A058771, A058782.
%K A058772 nonn,hard,more,changed
%O A058772 1,1
%A A058772 _Robert G. Wilson v_, Jan 02 2001
