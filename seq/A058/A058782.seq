%T A058782 6076,12876,17790,20038,30180,30349,37171
%N A058782 Numbers k such that k * (1+i)^k + i is a Gaussian prime.
%H A058782 <a href="/index/Ga#gaussians">Index entries for Gaussian integers and primes</a>
%t A058782 Do[ If[ PrimeQ[ n * (1 + I)^n + I], Print[n] ], {n, 1, 35000} ]
%o A058782 (Python)
%o A058782 from sympy import I
%o A058782 from sympy.ntheory import is_gaussian_prime
%o A058782 def ok(k): return is_gaussian_prime( k*(1+I)**k + I )
%o A058782 print([k for k in range(2000) if ok(k)]) # _Michael S. Branicky_, Oct 29 2026
