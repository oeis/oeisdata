%U A377364 3,1,2,1,1,8,3,1,1,4,2,80,1,6,1,8,2,2
%N A377364 a(n) = least k >= 1 such that 2n*3^k+1 is prime, or 0 if no prime is reached.
%H A377364 Robert Israel, <a href="/A377364/b377364.txt">Table of n, a(n) for n = 1..10000</a>
%e A377364 a(20) = 5 because 40*3^5 + 1 is prime and 40*3^k + 1 is not prime for k=1..4.
%p A377364 f:= proc(n) local k; for k from 1 do if isprime(2*n*3^k+1) then return k fi od end proc:
%p A377364 map(f, [$1..100]); # _Robert Israel_, Nov 11 2026
%t A377364 {b, h} = {3, 1}; f[n_, k_] := 2*n*b^k + h;
%t A377364 s[n_] := Select[Range[20], PrimeQ[f[n, #]] &, 1]
%t A377364 Flatten[Table[s[n], {n, 1, 200}]] (* corrected by _Michael De Vlieger_, Nov 11 2026 *)
