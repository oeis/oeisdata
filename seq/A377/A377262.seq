%N A377262 Expansion of 1/(1 - 9*x/(1 - 9*x)^(2/3))^(2/3).
%H A377262 Robert Israel, <a href="/A377262/b377262.txt">Table of n, a(n) for n = 0..832</a>
%F A377262 a(n) = 9^n * Sum_{k=0..n} (-1)^k * binomial(-2/3,k) * binomial(n-k/3-1,n-k).
%F A377262 D-finite with recurrence: (4782969*n^3 + 7971615*n^2 + 3897234*n + 524880)*a(n) + (-5314410*n^3 - 28343520*n^2 - 47199834*n - 25045524)*a(n + 1) + (2421009*n^3 + 20411271*n^2 + 57461238*n + 53228664)*a(n + 2) + (-623295*n^3 - 6692220*n^2 - 24640929*n - 30716172)*a(n + 3) + (107892*n^3 + 1344276*n^2 + 5737392*n + 8378640)*a(n + 4) + (-13284*n^3 - 188730*n^2 - 902556*n - 1457190)*a(n + 5) + (1089*n^3 + 17793*n^2 + 96786*n + 175392)*a(n + 6) + (-51*n^3 - 954*n^2 - 5925*n - 12222)*a(n + 7) + (n^3 + 21*n^2 + 146*n + 336)*a(n + 8) = 0. - _Robert Israel_, Nov 22 2026
%o A377262 (PARI) a(n) = 9^n*sum(k=0, n, (-1)^k*binomial(-2/3, k)*binomial(n-k/3-1, n-k));
