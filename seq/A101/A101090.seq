%S A101090 1,19,135,605,2054,5778,14178,31350,63855,121693,219505,378027,625820,
%T A101090 1001300,1555092,2352732,3477741,5035095,7155115,9997801,13757634,
%U A101090 18668870,25011350,33116850,43375995,56245761,72257589,92026135,116258680,145765224,181469288
%N A101090 Third partial sums of fourth powers (A000583).
%C A101090 In general, the r-th successive summation of the fourth powers from 1 to n = (2*n+r)*(12*n^2+12*n*r+r^2-5*r)*(r+n)!/((r+4)!*(n-1)!). Here r = 3. - _Gary Detlefs_, Mar 01 2013
%H A101090 Paolo Xausa, <a href="/A101090/b101090.txt">Table of n, a(n) for n = 1..10000</a>
%H A101090 <a href="/index/Rec#order_08">Index entries for linear recurrences with constant coefficients</a>, signature (8,-28,56,-70,56,-28,8,-1).
%F A101090 a(n) = (n*(1+n)*(2+n)*(3+n)*(3+2*n)*(-1+2*n*(3+n)))/840.
%F A101090 G.f.: x*(1+x)*(1+10*x+x^2)/(1-x)^8. - _Colin Barker_, Apr 04 2012
%F A101090 a(n) = (2*n+3)*(12*n^2+36*n-6)*(n+3)!/(5040*(n-1)!). - _Gary Detlefs_, Mar 01 2013
%F A101090 From _Elmo R. Oliveira_, Nov 09 2026: (Start)
%F A101090 a(n) = binomial(n+3,4)*(4*n^3 + 18*n^2 + 16*n - 3)/35.
%F A101090 a(n) = 8*a(n-1) -28*a(n-2) +56*a(n-3) -70*a(n-4) +56*a(n-5) -28*a(n-6) +8*a(n-7) -a(n-8).
%F A101090 E.g.f.: exp(x)*x*(7*5! + 1190*3!*x + 1890*3!*x^2 + 6125*x^3 + 679*2!*x^4 + 21*3!*x^5 + 2*2!*x^6) / (7*5!). (End)
%t A101090 Nest[Accumulate, Range[50]^4, 3] (* _Paolo Xausa_, Jun 17 2024 *)
%Y A101090 Cf. A000583, A101089, A101091.
%K A101090 easy,nonn,changed
