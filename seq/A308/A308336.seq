%I A308336 #10 Oct 05 2026 15:54:06
%S A308336 1,1,2,8,31,147,884,5567,39176,311400,2644490,24206327,239684768,
%T A308336 2519262527,28077597357,331892965533,4130002336563,53944450834303,
%U A308336 738940309779760,10577568411051305,157846971489443335,2452481386778640564,39589449956634478543
%N A308336 Expansion of e.g.f. exp(-1 + Product_{k>=1} (1 + x^k/k!)).
%H A308336 Alois P. Heinz, <a href="/A308336/b308336.txt">Table of n, a(n) for n = 0..499</a>
%F A308336 a(0) = 1; a(n) = Sum_{k=1..n} binomial(n-1,k-1)*A007837(k)*a(n-k).
%p A308336 b:= proc(n, i) option remember; `if`(i*(i+1)/2<n, 0, `if`(n=0, 1,
%p A308336       b(n, i-1)+b(n-i, min(n-i, i-1))*binomial(n, i)))
%p A308336     end:
%p A308336 a:= proc(n) option remember; `if`(n=0, 1,
%p A308336       add(a(n-j)*b(j$2)*binomial(n-1, j-1), j=1..n))
%p A308336     end:
%p A308336 seq(a(n), n=0..22);  # _Alois P. Heinz_, Oct 05 2026
%t A308336 nmax = 22; CoefficientList[Series[Exp[Product[(1 + x^k/k!), {k, 1, nmax}] - 1], {x, 0, nmax}], x] Range[0, nmax]!
%Y A308336 Cf. A007837, A143463, A182927, A308338.
%K A308336 nonn,changed
%O A308336 0,3
%A A308336 _Ilya Gutkovskiy_, May 20 2019
