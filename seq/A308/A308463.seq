%N A308463 a(n) = Sum_{k=1..n, gcd(n,k) = 1} Stirling2(n,k).
%H A308463 Alois P. Heinz, <a href="/A308463/b308463.txt">Table of n, a(n) for n = 0..576</a>
%p A308463 a:= proc(k) option remember; local b; b:=
%p A308463       proc(n, m) option remember; `if`(n=0,
%p A308463         `if`(igcd(k, m)=1, 1, 0), m*b(n-1, m)+b(n-1, m+1))
%p A308463       end: b(k, 0)
%p A308463     end:
%p A308463 seq(a(n), n=0..25);  # _Alois P. Heinz_, Oct 06 2026
%t A308463 a[n_] := Sum[If[GCD[n, k] == 1, StirlingS2[n, k] , 0], {k, 1, n}]; Table[a[n], {n, 1, 25}]
%o A308463 (PARI) a(n) = sum(k=1, n, if (gcd(n,k)==1, stirling(n, k, 2))); \\ _Michel Marcus_, May 28 2019
