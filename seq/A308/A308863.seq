%I A308863 #21 Jul 27 2026 16:35:44
%S A308863 1,1,6,57,736,11985,235296,5403937,142073856,4206560769,138483596800,
%T A308863 5017244970441,198363105460224,8498001799768273,392127481640165376,
%U A308863 19388814120804416625,1022681739669784231936,57317273018414456262273,3401527253966521309200384
%N A308863 Expansion of e.g.f. (1 + LambertW(-x))/(1 + 2*LambertW(-x)).
%H A308863 Alois P. Heinz, <a href="/A308863/b308863.txt">Table of n, a(n) for n = 0..375</a> (first 101 terms from Vaclav Kotesovec)
%F A308863 E.g.f.: 1 / (1 - Sum_{k>=1} k^k*x^k/k!).
%F A308863 a(0) = 1; a(n) = Sum_{k=1..n} binomial(n,k) * k^k * a(n-k).
%F A308863 a(n) ~ sqrt(Pi) * 2^(n - 3/2) * n^(n + 1/2) / exp(n/2). - _Vaclav Kotesovec_, Jun 29 2019
%F A308863 a(n) = n^n + n!*2^(n-2)*Sum_{k = 0..n-2} n^k/(k!*2^k). - _Peter Bala_, Jul 27 2026
%p A308863 seq(n^n + n!*2^(n-2)*add(n^k/(k!*2^k), k = 0..n-2), n = 0..18); # _Peter Bala_, Jul 27 2026
%p A308863 # Alternative:
%p A308863 a:= proc(n) option remember; `if`(n=0, 1,
%p A308863       add(j^j*binomial(n, j)*a(n-j), j=1..n))
%p A308863     end:
%p A308863 seq(a(n), n=0..20);  # _Alois P. Heinz_, Jul 27 2026
%t A308863 nmax = 18; CoefficientList[Series[(1 + LambertW[-x])/(1 + 2 LambertW[-x]), {x, 0, nmax}], x] Range[0, nmax]!
%t A308863 a[0] = 1; a[n_] := a[n] = Sum[Binomial[n, k] k^k a[n - k], {k, 1, n}]; Table[a[n], {n, 0, 18}]
%o A308863 (Python)  # after _Peter Bala_'s formula
%o A308863 from math import factorial
%o A308863 def a(n: int) -> int:
%o A308863     if n < 2: return 1
%o A308863     nn = n ** n
%o A308863     if n == 1: return nn
%o A308863     F = factorial(n) * (2 ** (n - 2))
%o A308863     total = F
%o A308863     for k in range(1, n - 1):
%o A308863         F = F * n // (2 * k)
%o A308863         total += F
%o A308863     return nn + total
%o A308863 print([a(n) for n in range(20)])  # _Peter Luschny_, Jul 27 2026
%Y A308863 Cf. A000312, A002866, A086331, A218688, A277610, A308861, A308862.
%Y A308863 Are the row sums of A398193.
