%S A308338 1,1,2,9,44,270,2064,17682,171296,1867968,22470840,294493320,
%T A308338 4195969392,64416698112,1059685905264,18609306423120,347179119075840,
%U A308338 6855335163907200,142889687354283264,3133647091691585280,72124075333003155840,1738384773846440146560
%N A308338 Expansion of e.g.f. exp(-1 + Product_{k>=1} (1 + x^k/k)).
%C A308338 Number of nested cycle partitions on n nodes. See A392471. - _Marko Riedel_, Jan 14 2026
%H A308338 Alois P. Heinz, <a href="/A308338/b308338.txt">Table of n, a(n) for n = 0..445</a>
%F A308338 a(0) = 1; a(n) = Sum_{k=1..n} binomial(n-1,k-1)*A007838(k)*a(n-k).
%F A308338 a(n) = Sum_{k=1..n} A392471(n,k). - _Marko Riedel_, Jan 14 2026
%p A308338 b:= proc(n, i) option remember; `if`(i*(i+1)/2<n, 0, `if`(n=0, 1,
%p A308338       b(n, i-1)+b(n-i, min(n-i, i-1))*binomial(n, i)*(i-1)!))
%p A308338     end:
%p A308338 a:= proc(n) option remember; `if`(n=0, 1,
%p A308338       add(a(n-j)*b(j$2)*binomial(n-1, j-1), j=1..n))
%p A308338     end:
%p A308338 seq(a(n), n=0..21);  # _Alois P. Heinz_, Oct 05 2026
%t A308338 nmax = 21; CoefficientList[Series[Exp[Product[(1 + x^k/k), {k, 1, nmax}] - 1], {x, 0, nmax}], x] Range[0, nmax]!
%Y A308338 Cf. A007838, A308336, A308337, A392471.
%K A308338 nonn,changed
%O A308338 0,3
%A A308338 _Ilya Gutkovskiy_, May 20 2019
