%I A308337 #10 Oct 05 2026 16:27:32
%S A308337 1,1,4,21,146,1210,11894,133000,1677668,23439684,359651232,6000427884,
%T A308337 108157599120,2092493844480,43240336406136,950021322002904,
%U A308337 22108068716440272,543048769028068944,14037848562783308160,380851191359082217488,10818262594065294568416
%N A308337 Expansion of e.g.f. exp(-1 + Product_{k>=1} 1/(1 - x^k/k)).
%H A308337 Alois P. Heinz, <a href="/A308337/b308337.txt">Table of n, a(n) for n = 0..436</a>
%F A308337 a(0) = 1; a(n) = Sum_{k=1..n} binomial(n-1,k-1)*A007841(k)*a(n-k).
%p A308337 with(combinat):
%p A308337 b:= proc(n, i) option remember; `if`(n=0, 1, `if`(i<1, 0, add(
%p A308337      (i-1)!^j*b(n-i*j, i-1)*multinomial(n, n-i*j, i$j), j=0..n/i)))
%p A308337     end:
%p A308337 a:= proc(n) option remember; `if`(n=0, 1,
%p A308337       add(a(n-j)*b(j$2)*binomial(n-1, j-1), j=1..n))
%p A308337     end:
%p A308337 seq(a(n), n=0..20);  # _Alois P. Heinz_, Oct 05 2026
%t A308337 nmax = 20; CoefficientList[Series[Exp[Product[1/(1 - x^k/k), {k, 1, nmax}] - 1], {x, 0, nmax}], x] Range[0, nmax]!
%Y A308337 Cf. A007841, A143463, A308338.
%K A308337 nonn,changed
%O A308337 0,3
%A A308337 _Ilya Gutkovskiy_, May 20 2019
