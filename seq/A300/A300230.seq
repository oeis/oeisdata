%S A300230 1,2,2,3,2,4,2,5,3,6,2,7,2,6,8,9,2,10,2,11,12,6,2,13,3,6,5,14,2,15,2,
%T A300230 16,8,6,12,17,2,6,12,18,2,15,2,7,10,6,2,19,3,20,8,11,2,21,12,22,12,6,
%U A300230 2,23,2,6,20,24,12,15,2,11,8,25,2,26,2,6,20,7,12,15,2,27,9,6,2,28,12,6,8,29,2,30,31,7,12,6,32,33,2,20,10,17,2,15,2,34,35
%N A300230 Lexicographically earliest infinite sequence such that a(i) = a(j) => A046523(i) = A046523(j) and A009194(i) = A009194(j), for all i, j >= 1, where A046523(n) is the smallest number with same prime signature as n, and A009194(n) = gcd(n, sigma(n)).
%C A300230 Restricted growth sequence transform of A286570, or equally, of the ordered pair [A046523(n), A009194(n)].
%C A300230 For all i, j >= 1: A305800(i) = A305800(j) => a(i) = a(j) => A388270(i) = A388270(j).
%H A300230 Antti Karttunen, <a href="/A300230/b300230.txt">Table of n, a(n) for n = 1..65537</a>
%o A300230 (PARI)
%o A300230 rgs_transform(invec) = { my(om = Map(), outvec = vector(length(invec)), u=1); for(i=1, length(invec), if(mapisdefined(om, invec[i]), my(pp = mapget(om, invec[i])); outvec[i] = outvec[pp] , mapput(om, invec[i], i); outvec[i] = u; u++ )); outvec; };
%o A300230 A009194(n) = gcd(n, sigma(n));
%o A300230 A046523(n) = { my(f=vecsort(factor(n)[, 2], , 4), p); prod(i=1, #f, (p=nextprime(p+1))^f[i]); };
%o A300230 v300230 = rgs_transform(vector(up_to, n, [A046523(n), A009194(n)]));
%o A300230 A300230(n) = v300230[n];
%Y A300230 Cf. A009194, A046523, A286570, A305800, A388270.
%Y A300230 Cf. also A300223, A300226, A300229, A300231, A300232, A300233, A300235.
%K A300230 nonn,easy,changed
%O A300230 1,2
