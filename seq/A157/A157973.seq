%I A157973 #12 Aug 12 2026 12:46:50
%S A157973 9,12,20,21,24,25,28,35,40,44,49,52,54,55,56,57,63,65,72,77,81,88,90,
%T A157973 91,92,93,95,96,98,105,108,111,115,116,119,121,125,126,128,130,133,
%U A157973 143,144,145,147,148,150,155,161,164,165,169,170,172,180,184,185,187,188,189
%N A157973 Numbers m > 1 with sopfr(m) < m such that there is a number k, m < k <= 2*m, with k - sopfr(k) = m - sopfr(m), where sopfr = A001414.
%C A157973 Condition sopfr(m) < m excludes 4 and the primes.
%C A157973 It appears that if a number k > m with k - sopfr(k) = m - sopfr(m) exists at all, then k <= 2*m. If this can be proved, the corresponding condition in the definition could be omitted.
%H A157973 Amiram Eldar, <a href="/A157973/b157973.txt">Table of n, a(n) for n = 1..10000</a>
%e A157973 For m = 77, m-sopfr(m) = 77-18 = 59; for k = 93, k-sopfr(k) = 93-34 =59. Hence 77 is a term.
%t A157973 f[1] = 1; f[n_] := n - Plus @@ Times @@@ FactorInteger@n; aQ[n_] := (fn = f[n]) > 0 && Module[{ans = False}, Do[If[f[k] == fn, ans = True; Break[]], {k, n + 1, 2 n}]; ans]; Select[Range[200], aQ] (* _Amiram Eldar_, Sep 08 2019 *)
%o A157973 (Magma) sopfr:=func< n | &+[a[1]*a[2]: a in Factorization(n)] >; [ n: n in [2..190] | d gt 0 and exists(t){ k: k in [n+1..2*n] | d eq k-sopfr(k) } where d is n-sopfr(n) ];
%o A157973 (PARI)
%o A157973 sofpr(n)=if(n<1, 0, my(f=factor(n)); sum(k=1, matsize(f)[1], f[k, 1]*f[k, 2]))
%o A157973 isok(m) = {my(s=sopfr(m)); if(m > 1 && s < m, for(k=m+1, 2*m, if(k-sopfr(k) == m-s, return(1)))); 0} \\ _Andrew Howroyd_, Aug 12 2026
%Y A157973 Cf. A001414 (sum of primes dividing n with repetition).
%K A157973 nonn,changed
%O A157973 1,1
