%I A157188 #20 Nov 08 2026 23:08:11
%S A157188 0,2,1,1,2,0,1,1,2,1,1,0,1,1,1,0,3,0,0,4,0,1,1,0,0,1,1,2,0,0,0,2,1,1,
%T A157188 1,0,0,1,2,0,3,0,3,0,1,1,1,1,1,0,0,3,0,2,0,2,1,1,0,1,0,0,0,4,0,0,1,0,
%U A157188 2,0,0,4,0,0,1,2,0,0,0,0,4,0,4,0,0,1,0,0,1,1,1,3,0,1,1,3,0,1,1,0,0,0,1,1,0
%N A157188 Number of ways to write prime(n) as p*q-(p+q) with primes p<=q.
%C A157188 Records in this sequence are given in A157189, the corresponding primes in A157190.
%H A157188 Robert Israel, <a href="/A157188/b157188.txt">Table of n, a(n) for n = 1..10000</a>
%H A157188 Carlos Rivera, <a href="http://www.primepuzzles.net/puzzles/puzz_482.htm">Puzzle 482. Two Bergot questions</a>, The Prime Puzzles & Problems Connection.
%F A157188 From _Robert Israel_, Nov 08 2026: (Start)
%F A157188 a(A160594(k)) = 0.
%F A157188 a(A080147(k)) <= 1.
%F A157188 (End)
%e A157188 a(1)=0 since prime(1) = 2 cannot be written as pq-(p+q) for primes p,q.
%e A157188 a(2)=2 since prime(2) = 3 = 2*5-(2+5) = 3*3-(3+3) are the two possibilities.
%p A157188 f:= proc(n) local r,Q;
%p A157188   r:= ithprime(n);
%p A157188   Q:= select(isprime, map(t -> t+1, NumberTheory:-Divisors(r+1)));
%p A157188   nops(select(t -> t[2]<= t[1] and isprime(t[2]),map(q -> [q,(q+r)/(q-1)], Q)));
%p A157188 end proc:
%p A157188 map(f, [$1..200]); # _Robert Israel_, Nov 08 2026
%o A157188 (PARI) A157188(n)={ local(c=0,L=sqrtint(n=prime(n)+1)); fordiv( n,d, d>L&break; isprime(d+1) || next; isprime(n/d+1) & c++);c}
%Y A157188 Cf. A080147, A157187, A157189, A157190, A160594.
%K A157188 nonn,changed
%O A157188 1,2
%A A157188 _M. F. Hasler_, Mar 11 2009
