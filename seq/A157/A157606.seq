%U A157606 1368,1441,1520,1599,1679,1763,1848,1933,2024,2115,2207,2303,2400,2497,2600
%N A157606 a(1)=1. a(n) = the largest integer coprime to a(n-1) and less than n^2.
%H A157606 Amiram Eldar, <a href="/A157606/b157606.txt">Table of n, a(n) for n = 1..10000</a>
%t A157606 a[n_] := a[n] = Block[{k = n^2 - 1}, While[ GCD[k, a[n - 1]] > 1, k-- ]; k]; a[1] = 1; Array[a, 55] (* _Robert G. Wilson v_, May 04 2009 *)
%o A157606 (PARI) list(nmax) = {my(s = List(1), a, a1 = 1); for(n = 2, nmax, a = n^2 - 1; while(gcd(a, a1) > 1, a--); a1 = a; listput(s, a1)); Set(s);} \\ _Amiram Eldar_, Oct 01 2026
