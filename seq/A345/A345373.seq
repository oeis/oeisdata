%S A345373 0,1,1,0,1,5,1,0,0,7,1,4,1,9,8,0,1,9,1,4,10,13,1,8,0,15,0,4,1,31,1,0,
%T A345373 14,19,12,0,1,21,16,8,1,41,1,4,9,25,1,16,0,25,20,4,1,27,16,8,22,31,1,
%U A345373 32,1,33,9,0,18,61,1,4,26,59,1,0,1,39,25,4,18,71,1,16,0,43
%N A345373 Sum of the divisor complements of the unitary prime divisors of n.
%C A345373 a(p) = 1 for p prime.
%H A345373 Antti Karttunen, <a href="/A345373/b345373.txt">Table of n, a(n) for n = 1..10000</a>
%F A345373 a(n) = n * Sum_{p|n, p prime} floor(1/gcd(p,n/p)) / p.
%F A345373 a(A055231(n)) = A003415(A055231(n)). - _Antti Karttunen_, Nov 24 2026
%e A345373 a(30) = 30 * Sum_{p|30, p prime} floor(1/gcd(p,30/p))/p = 30 * (1/2 + 1/3 + 1/5) = 31.
%o A345373 (PARI) A345373(n) = { my(f=factor(n)); n*sum(i=1,#f~, ((1==f[i,2])/f[i,1])); }; \\ _Antti Karttunen_, Nov 24 2026
%Y A345373 Cf. A003415, A055231, A063956.
