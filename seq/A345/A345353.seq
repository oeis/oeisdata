%S A345353 5,11,19,569,523,10103,207593,23456789,23581073,6609635987,
%T A345353 12445558319,646972529377,19199908193159,9927935178558959,
%U A345353 694140212317957,14707209648376466477,17758293160466332549,1450505927977839335179,96209320840499118292907,35191494265562720310441017
%N A345353 Largest prime with strictly ascending digits in base n.
%C A345353 The first few terms a(n) written in base n starting with n=3: 12, 23, 34, 2345, 1345, 23567, 345678, 23456789, 1234689a, 13456789ab, 12345678bc, 2345689abcd, 2346789abcde, 23456789abcdef, 1345689bcdefg, 23456789abcdefgh, 1345789abcdefghi, 2456789abcdefghij, 3456789abcdefghijk, 123456789bcdefghijkl, 12456789abcdeghijklm, 23456789abcdefghiklmn, 12345678bcdefghijklmno, 12456789abcdeghijklmnop.
%H A345353 Robert Israel, <a href="/A345353/b345353.txt">Table of n, a(n) for n = 3..388</a>
%F A345353 a(n) >= A344549(n).
%p A345353 f:= proc(b) local d,L,X,x,i;
%p A345353       for d from b-1 by -1 do
%p A345353         L:= combinat:-choose(b-1,d);
%p A345353         X:= sort(map(t -> add(t[-i]*b^(i-1),i=1..d), L),`>`);
%p A345353         for x in X do if isprime(x) then return x fi od
%p A345353       od
%p A345353 end proc:
%p A345353 map(f, [$3..20]); # _Robert Israel_, Nov 19 2026
%Y A345353 Cf. A344549.
%K A345353 nonn,base,changed
%O A345353 3,1
