%T A074702 35673657942572,4670006130663971,723461783075360174,
%U A074702 130890931830249779173,27346855400248614577216,6534075316966068976316143,1770326031190494313270654994,539845302687736618823239734641
%N A074702 a(n) = ((n+1)^2*(n-1)*a(n-1)+(-1)^(n+1))/n.
%D A074702 The sequence taken modulo a positive integer k is periodic, with period dividing k when k is even and dividing 2*k when k is odd. This follows from the congruence a(n+k) == (-1)^k*a(n) (mod k), which holds for all n and k (proved by induction making use of the recurrence). - _Peter Bala_, Sep 21 2026
%H A074702 Harvey P. Dale, <a href="/A074702/b074702.txt">Table of n, a(n) for n = 1..252</a>
%F A074702 a(n) = round((n+1)!^2*BesselJ(0, 2))/n.
%F A074702 From _Peter Bala_, Sep 21 2026: (Start)
%F A074702 a(n) = (1/n) * (n+1)!^2 * Sum_{k = 0..n+1} (-1)^k/k!^2.
%F A074702 a(n) == (-1)^n mod(n+1).
%F A074702 a(n) = A073701(n+1)/n. (End)
%t A074702 nxt[{n_,a_}]:={n+1,(n*a*(n+2)^2+(-1)^(n+2))/(n+1)}; Transpose[ NestList[ nxt,{1,1},15]][[2]] (* _Harvey P. Dale_, Jun 26 2013 *)
