%T A074625 9,5,4,7,1,19,2,3,13,5,4,7,10,1,6,2,3,8,5,4,7,18,19,1,9,2,3,24,5,4,7,
%U A074625 16,21,43,1,13,2,3,2401,5,4,7,49,31213,9604,6,1,8,2,3,10,5,4,7,33,22,14,6,9
%N A074625 Triangular array T(n,k) (n >= 1, 1 <= k <= n) read by rows, where T(n,k) = smallest number x such that sigma(x) == k (mod n).
%C A074625 In the table output, one can observe constant columns (or rows in the square output). The indices of these are: 1, 3, 4, 6, 7, 8, 12, 13, ... (see A002191). And the corresponding values are: 1, 2, 3, 5, 4, 7, 6, 9, ... (see A002192). - _Michel Marcus_, Dec 19 2013 [Edited by _M. F. Hasler_, Nov 09 2026]
%C A074625 The larger values  like T(6, 5) = 2401 occur mainly in rows n == 0 (mod 6) and columns k == 5 (mod 6), because it is quite rare to have sigma(x) == 5 (mod 6), cf. A074384. - _M. F. Hasler_, Nov 09 2026
%H A074625 Ruud H.G. van Tol, <a href="/A074625/b074625.txt">Table of n, a(n) for n = 1..20100</a> (rows 1..200, flattened; rows 1..101 from Michel Marcus)
%H A074625 Ruud H.G. van Tol, <a href="/A074625/a074625.cpp.txt">C++ program</a> (did 1200 rows (720600 terms) in 63 seconds).
%H A074625 Ruud H.G. van Tol, <a href="/A074625/a074625_1.gp.txt">PARI program</a> (did 102 rows in 7 seconds).
%F A074625 Min{x; Mod[sigma[x], n]=r}, r=1..n, n=1, ...
%F A074625 T(n, A002191(k)) = A002192(k), cf. comment by _Michel Marcus_. - _M. F. Hasler_, Nov 09 2026
%e A074625 Triangle begins
%e A074625   1;
%e A074625   1, 3;
%e A074625   1, 7, 2;
%e A074625   1, 5, 2, 3;
%e A074625   1, 4, 2, 3, 8;
%e A074625   1, 7, 2, 3, 2401, 5;
%e A074625   ...
%e A074625 T(102, 5) = 16540489, T(102, 11) = 3841600,  T(102, 17) = 103^16 = 160470643909878751793805444097921, ..., T(102, 101) = 21609 are all terms of A074384. - _M. F. Hasler_, Nov 09 2026
%t A074625 {k=0, s=0, fl=1}; Table[Print["#"]; Table[fl=1; Print[{r, m}]; Do[s=Mod[DivisorSigma[1, n], m]; If[(s==r)&&(fl==1), Print[n]; fl=0], {n, 1, 150000}], {r, 0, m-1}], {m, 1, 25}]
%o A074625 (PARI) T(n,k) = my(x=1); while (Mod(sigma(x), n) != k, x++); x; \\ _Michel Marcus_, Nov 08 2026
%o A074625 (PARI) \\ See Links. - _Ruud H.G. van Tol_, Nov 09 2026
