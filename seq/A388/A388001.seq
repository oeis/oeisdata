%S A388001 80,608,16830,149984,216568,251392,534114,1329174,2135104,4087864,
%T A388001 47959496,70884608,227556608,974754272,2154622208,4210790624,
%U A388001 34963314688,42710603776,63839574016,304968650752,456486270976,533959161856,1590460567552,84304066495688,161884933578752,674188191967626
%N A388001 Numbers k such that sigma(k) = psi(k) + phi(k) + tau(k).
%H A388001 Max Alekseyev, <a href="/A388001/b388001.txt">Table of n, a(n) for n = 1..34</a>
%H A388001 Robert Israel, <a href="/A388001/a388001.txt">Some additional terms</a> of the form 2^a * p * q.
%e A388001 80 is in the sequence since sigma(80) = 186 = 144 + 32 + 10 = psi(80) + phi(80) + tau(80).
%t A388001 f1[p_, e_] := (p^(e + 1) - 1)/(p - 1);
%t A388001 f2[p_, e_] := (p + 1)*p^(e - 1);
%t A388001 f3[p_, e_] := (p - 1)*p^(e - 1);
%t A388001 f4[p_, e_] := e + 1;
%t A388001 q[k_] := Module[{f = FactorInteger[k]}, Times @@ f1 @@@ f == Times @@ f2 @@@ f + Times @@ f3 @@@ f + Times @@ f4 @@@ f]; Select[Range[2, 6*10^5], q] (* _Amiram Eldar_, Oct 14 2025 *)
%Y A388001 Cf. A000005, A000010, A000203, A001615, A387953, A389478.
