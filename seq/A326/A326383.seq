%I A326383 #23 Oct 08 2026 21:28:43
%S A326383 4095,262143,265720,531440,1048575,5592405,11184810,122070312,
%T A326383 183105468,193710244,244140624,268435455,387420488,926512314,
%U A326383 1743392200,1853024628,2306881200,3486784400
%N A326383 Numbers m such that beta(m) = tau(m)/2 + 3 where beta(m) is the number of Brazilian representations of m and tau(m) is the number of divisors of m.
%C A326383 As tau(m) = 2 * (beta(m) - 3), the terms of this sequence are not squares.
%C A326383 The current known terms are non-oblong composites that have exactly four Brazilian representations with three digits or more; but, maybe, there exist oblong integers that have exactly five Brazilian representations with three digits or more.
%H A326383 <a href="/index/Br#Brazilian_numbers">Index entries for sequences related to Brazilian numbers</a>.
%e A326383 The 24 divisors of 4095 = M_12 are {1, 3, 5, 7, 9, 13, 15, 21, 35, 39, 45, 63, 65, 91, 105, 117, 195, 273, 315, 455, 585, 819, 1365, 4095} and tau(4095) = 24; also, 4095 = R(12)_2 = 333333_4 = 7777_8 = (15,15,15)_16, so, beta(4095) = 15 with beta'(4095)= 11 and beta''(4095) = 4. The relation is beta(4095) = tau(4095)/2 + 3 = 15 and 4095 is a term.
%o A326383 (Python)
%o A326383 from itertools import count, islice
%o A326383 from sympy import divisors
%o A326383 from oeis_sequences.OEISsequences import bsearch
%o A326383 def A326383_gen(startvalue=1): # generator of terms >= startvalue
%o A326383     for n in count(max(startvalue,1)):
%o A326383         c, a = 0, 6
%o A326383         for d in divisors(n,generator=True):
%o A326383             a += 1
%o A326383             if 1<d:
%o A326383                 for k in range(2,n.bit_length()+1):
%o A326383                     f = lambda x: (x**k-1)//(x-1)
%o A326383                     b = bsearch(f,d,kmin=2,kmax=3)
%o A326383                     if b<n-1 and n<b*d and f(b)==d:
%o A326383                         c += 2
%o A326383         if a == c:
%o A326383             yield n
%o A326383 A326383_list = list(islice(A326383_gen(),4)) # _Chai Wah Wu_, Oct 01 2026
%Y A326383 Cf. A000005 (tau), A220136 (beta).
%Y A326383 Subsequence of A167782, A167783 and A290869.
%Y A326383 Cf. A326378 (tau(m)/2 - 2), A326379 (tau(m)/2 - 1), A326380 (tau(m)/2), A326381 (tau(m)/2 + 1), A326382 (tau(m)/2 + 2).
%K A326383 nonn,base,more,changed
%O A326383 1,1
