%S A326926 1,1,-2,0,-3,3,-1,0,6,-4,-1,5,0,-10,5,0,6,-15,0,15,-6,1,0,-21,35,0,
%T A326926 -21,7,1,-8,0,56,-70,0,28,-8,0,-9,36,0,-126,126,0,-36,9,-1,0,45,-120,
%U A326926 0,252,-210,0,45,-10,-1,11,0,-165,330,0,-462,330,0,-55,11,0
%N A326926 Triangular array read by rows: row n shows the coefficients of this polynomial of degree n: (1/n!)*(numerator of n-th derivative of 1/(1-x+x^2)).
%C A326926 It appears that each nonconstant polynomial is irreducible if and only if its degree is p-1 for some prime p other than 3.
%H A326926 Mark Norfleet, <a href="https://www.fq.math.ca/Papers1/43-2/paper43-2-12.pdf">Characterization of second-order strong divisibility sequences of polynomials</a>, The Fibonacci Quarterly, 43(2) (2005), 166-169.
%F A326926 From _Peter Bala_, Nov 08 2026: (Start)
%F A326926 The following assumes that the row indexing starts at n = 1.
%F A326926 G.f.: A(t, x) = t*P(x)/P(x + t*P(x)) = t/(1 + t*(2*x - 1) + t^2*(x^2 - x + 1)) = t + (1 - 2*x)*t^2 + (-3*x + 3*x^2)*t^3 + (-1 + 6*x^2 - 4*x^3)*t^4 + ..., where P(x) = 1 - x + x^2.
%F A326926 Recurrence for row polynomials: R(n, x) = (1 - 2*x)*R(n-1, x) - (1 - x + x^2)*R(n-2, x) with R(1, x) = 1 and R_(2, x) = 1 - 2*x.
%F A326926 R(n, x) = (-1)^(n+1) * R(n, 1 - x).
%F A326926 R(n, x) =  (alpha^n - beta^n)/(alpha - beta), where alpha = (1 - 2*x + i*sqrt(3))/2 and beta = (1 - 2*x - i*sqrt(3))/2.
%F A326926 R(n, x) = (sqrt(y^2 + 3)/2)^n * U(n, y/sqrt(y^2 + 3)), where y = 1 - 2*x and U(n, x) is the n_th Chebyshev polynomial of the second kind.
%F A326926 R(n, x) = n * Product_{j = 1..n-1} ((1/2)*(1 - sqrt(3)*cot(j*Pi/n)) - x).
%F A326926 The sequence of row polynomials [1, 1 - 2*x, (-3*x + 3*x^2), (1 - 2*x )*(-1 - 2*x + 2*x^2), ...] is a strong divisibility sequence of polynomials in the ring Z[x] (apply Norfleet, Theorem 3).
%F A326926 R(n, 1) = A049347(n-1); R(n, 2) = A000748(n-1); R(n, -2) = A099450(n-1). (End)
%e A326926 First eight rows:
%e A326926    1;
%e A326926    1,  -2;
%e A326926    0,  -3,   3;
%e A326926   -1,   0,   6,  -4;
%e A326926   -1,   5,   0, -10,   5;
%e A326926    0,   6, -15,   0,  15,  -6;
%e A326926    1,   0, -21,  35,   0, -21,   7;
%e A326926    1,  -8,   0,  56, -70,   0,  28,  -8;
%e A326926 First eight polynomials:
%e A326926   1
%e A326926   1 - 2*x
%e A326926     - 3*x + 3*x^2 = 3 (-1 + x)*x
%e A326926  -1 + 6*x^2 - 4*x^3 = (-1 + 2*x) (1 + 2*x - 2*x^2)
%e A326926  -1 + 5*x - 10*x^3 + 5*x^4
%e A326926       6*x - 15*x^2 + 15*x^4 - 6*x^5 = -3*x*(-2 + x)*(-1 + x)*(1 + x)*(-1 + 2*x)
%e A326926   1 - 21*x^2 + 35*x^3 - 21*x^5 + 7*x^6
%e A326926   1 - 8*x + 56*x^3 - 70*x^4 + 28*x^6 - 8*x^7 = -(-1 + 2*x)*(-1 - 2*x + 2*x^2)*(-1 + 8*x - 6*x^2 - 4*x^3 + 2*x^4)
%t A326926 g[x_, n_] := Numerator[ Factor[D[1/(x^2 - x + 1), {x, n}]]];
%t A326926 Column[Expand[Table[g[x, n]/n!, {n, 0, 12}]]] (* polynomials *)
%t A326926 h[n_] := CoefficientList[g[x, n]/n!, x]
%t A326926 Table[h[n], {n, 0, 10}]  (* A326926 *)
%t A326926 Column[%]
%t A326926 Table[-1 + Length[FactorList[g[x, n]/n!]], {n, 0, 100}]  (* A326933 *)
%Y A326926 Cf. A326933.
