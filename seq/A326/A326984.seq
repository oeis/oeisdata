%S A326984 1,0,1,1,3,13,57,271,1467,8905,58965,420331,3212391,26227477,
%T A326984 227640033,2090172631,20222758995,205524856129,2188159483341,
%U A326984 24344716477411,282390978550239,3408195810080461,42719427069801369,555174137978970511,7469189351830156683
%N A326984 Coefficients in asymptotic expansion of sequence A309619.
%C A326984 From _Natalia L. Skirrow_, Sep 19 2026: (Start)
%C A326984 With rf(x, n) = (x + n - 1)!/(x - 1)! and ff(x, n) = x!/(x - n)! the rising and falling factorial, we have: rf(x, n) = Sum_{k=0..n} |Stirling1(n, k)| * x^k and x^n = Sum_{k=0..n} Stirling2(n, k) * ff(x, k).
%C A326984 Their duals (derived from Stirling2(n+x, x) = |Stirling1(-x, -n-x)|, are discussed in the Knuth link): rf(x, -k) = 1/ff(x-1, k) = Sum_{n>=k} Stirling2(n, k) / x^n converges for |x| > k-1 and x^(-k) = Sum_{n>=k} |Stirling1(n, k)| * ff(x, -n) converges for x > 0.
%C A326984 These formulas can be restated as: 1/ff(x, k) = Sum_{n>=k} Stirling2(n-1, k-1) / x^n for |x| > k-1 and 1/x^k = Sum_{n>=k} |Stirling1(n-1, k-1)| / rf(x, n) for x > 0.
%C A326984 The formula for this sequence emerges from writing A309619(n)/n! = Sum_{k=0..floor(n/2)} k!/ff(n,2*k) and applying the last of these. (End)
%H A326984 Vaclav Kotesovec, <a href="/A326984/b326984.txt">Table of n, a(n) for n = 0..122</a>
%H A326984 Donald E. Knuth, <a href="https://arxiv.org/abs/math/9205211v1">Two notes on notation</a> (arXiv preprint, 1992).
%H A326984 Natalia L. Skirrow, <a href="/wiki/User:Natalia_L._Skirrow/an_introduction_to_Stirling_numbers/more_on_Faulhabernoulli_and_Gregory">more on Faulhabernoulli and Gregory</a>.
%F A326984 From _Natalia L. Skirrow_, Sep 19 2026: (Start)
%F A326984 a(n) = Sum_{k=0..floor(n/2)} Stirling2(n-1,2*k-1)*k!, with Stirling2(-1,-1) = 1.
%F A326984 E.g.f. F(x) satisfies F'(x) = G'(e^x-1), where G'(x) = hypergeom([2],[3/2],x^2/4)*x = x/2 + sqrt(Pi)*(2+x^2)*exp(x^2/4)*erf(x/2)/4 is the derivative of A361522's e.g.f.
%F A326984 a(n+1) ~ n! * exp(y^2/4) * (2+y^2) / (4 * sqrt(2*n*(1+2*r+r/y)) * r^n), where r ~ log(n/log(n))/2 + log(2) + o(1) is the positive real solution to r*e^r*(e^r-1)/2 = n, and y = e^r-1 ~ 2*sqrt(n/log(n)) satisfies y*(y+1)/2 = n/r.
%F A326984 a(n+1) ~ n! * sqrt(n) * exp(n/(2*r)-sqrt(n/(8*r))+1/8) / (4 * r^(n+3/2)).
%F A326984 (End)
%e A326984 A309619(n) / n! ~ 1 + 1/n^2 + 1/n^3 + 3/n^4 + 13/n^5 + 57/n^6 + ...
%e A326984 G'(e^x-1) = 1*x + 1*x^2/2! + 3*x^3/3! + 13*x^4/4! + ... - _Natalia L. Skirrow_, Sep 19 2026
%t A326984 Join[{1},CoefficientList[Series[Hypergeometric1F1[2,3/2,x^2/4]*x/.x->E^x-1,{x,0,9}],x]*Range[0,9]!] (* _Natalia L. Skirrow_, Sep 19 2026 *)
%o A326984 (Python)
%o A326984 from sympy import bell,Poly
%o A326984 from sympy.abc import x
%o A326984 A326984=lambda n: (c:=1)+sum((c:=c*k)*a for k,a in enumerate(Poly(bell(n-1,x),x).as_list()[-4::-2],start=2)) if n>1 else 1-n # _Natalia L. Skirrow_, Sep 19 2026
%o A326984 (SageMath)
%o A326984 def A326984(n):
%o A326984     x = polygen(QQ, 'x')
%o A326984     coeffs = bell_polynomial(n - 1, x).coefficients(sparse=False)
%o A326984     sel_coeffs = coeffs[::-1][-4::-2]
%o A326984     c = 1; total = 1
%o A326984     for k, a in enumerate(sel_coeffs, start=2):
%o A326984         c *= k
%o A326984         total += c * a
%o A326984     return total  # _Peter Luschny_, Sep 22 2026
%Y A326984 Cf. A293266, A309619, A361522.
