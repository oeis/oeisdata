%I A100474 #16 Nov 25 2026 10:21:37
%S A100474 1,5,380,96197,58546472,42588477041,42945524659398,62170660055541623,
%T A100474 133274332258941430724,322874181064180119947025,
%U A100474 950049250593734799731643802,4193776877793643794299905615515
%N A100474 a(1) = 1; a(n) is the smallest integer such that a(n) + a(n-1) has the first n distinct prime factors not used before in this construction.
%C A100474 a(11) is the first semiprime in the sequence. What is the next? After a(2) = 5, is there another prime?
%F A100474 a(n) + a(n-1) = primorial(triangular(n)-1)/primorial(triangular(n-1)-1) = A002110(A000217(n)-1)/A002110(A000217(n-1)-1)
%e A100474 a(2) = 5 because 5 + a(1) = 2 * 3.
%e A100474 a(3) = 380 because 380 + a(2) = 5 * 7 * 11.
%e A100474 a(4) = 96197 because 96197 + a(3) = 13 * 17 * 19 * 23 (note that 96197 is coincidentally the 3-brilliant 19 * 61 * 83).
%o A100474 (Python)
%o A100474 from math import comb
%o A100474 from itertools import count, islice
%o A100474 from sympy import primorial
%o A100474 def A100474_gen():
%o A100474     yield 1
%o A100474     a = 5
%o A100474     for n in count(3):
%o A100474         yield a
%o A100474         a = -a+primorial(comb(n+1,2)-1)//primorial(comb(n,2)-1)
%o A100474 A100747_list = list(islice(A100474_gen(),12)) # _Chai Wah Wu_, Nov 24 2026
%Y A100474 Cf. A000040, A001358, A002110, A000217.
%K A100474 easy,nonn,more,changed
%O A100474 1,2
