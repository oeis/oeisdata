%N A100651 Numerator of 1 - Sum_{i=1..n} |Bernoulli(i)|.
%H A100651 Alois P. Heinz, <a href="/A100651/b100651.txt">Table of n, a(n) for n = 0..545</a>
%e A100651 1, 1/2, 1/3, 1/3, 3/10, 3/10, 29/105, 29/105, 17/70, 17/70, 193/1155, 193/1155, -123/1430, -123/1430, -2687/2145, -2687/2145, -202863/24310, -202863/24310, -307072861/4849845, ... = A100651/A100652.
%p A100651 b:= proc(n) option remember; `if`(n=0, 1, b(n-1)-abs(bernoulli(n))) end:
%p A100651 a:= n-> numer(b(n)):
%p A100651 seq(a(n), n=0..30);  # _Alois P. Heinz_, Sep 06 2026
%o A100651 (PARI) for(n=0, 32, print1(",", numerator(1 - sum(i=1,n,abs(bernfrac(i)))))) /* _Georg Fischer_, Sep 06 2026 */
