%N A229902 a(n) is the smallest m such that 19*m^k+1 is prime for k=1, 2,...,n.
%C A229902 10 divides all terms.
%H A229902 Jacob Glickman, <a href="https://github.com/jhg023/first-knowns">first-knowns: exhaustive search for A229902</a>, GitHub, 2026.
%t A229902 a[1]=10;a[n_]:=a[n]=(For[m=a[n-1]/10,Union[Table[PrimeQ[19(10m)^k+1],{k,n}]]=={True},m++];10m) (* _Farideh Firoozbakht_ Oct 05 2013 *)
