%S A332778 1,1,2,3,4,8,6,15,14,24,10,96,12,48,56,255,16,344,18,656,108,120,22,
%T A332778 9840,84,168,434,2448,28,4608,30,65535,260,288,264,137376,36,360,360,
%U A332778 432512,40,16776,42,14720,7208,528,46,96974880,258,9464,608,28656,52,425864,600
%N A332778 a(1) = 1; a(n) = Sum_{d|n, d < n} phi(n/d) * a(d)^2.
%C A332778 From _Robert Israel_, Nov 26 2026: (Start)
%C A332778 a(p) = p-1 if p is prime.
%C A332778 a(p*q) = (p-1)*(q-1)*(p+q-1) if p and q are prime.
%C A332778 (End)
%H A332778 Robert Israel, <a href="/A332778/b332778.txt">Table of n, a(n) for n = 1..6143</a>
%F A332778 a(1) = 1; a(n) = Sum_{k=1..n-1} a(gcd(n, k))^2.
%p A332778 f:= proc(n) option remember; local d;
%p A332778    add(NumberTheory:-phi(n/d) * procname(d)^2, d = NumberTheory:-Divisors(n) minus {n})
%p A332778 end proc:
%p A332778 f(1):= 1:
%p A332778 map(f, [$1..100]); # _Robert Israel_, Nov 26 2026
%t A332778 a[1] = 1; a[n_] := Sum[If[d < n, EulerPhi[n/d] a[d]^2, 0], {d, Divisors[n]}]; Table[a[n], {n, 1, 55}]
%t A332778 a[1] = 1; a[n_] := Sum[a[GCD[n, k]]^2, {k, 1, n - 1}]; Table[a[n], {n, 1, 55}]
%Y A332778 Cf. A000010, A006874, A007018, A023900, A069097, A082588.
