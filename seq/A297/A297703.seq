%S A297703 1,1,1,2,3,3,8,14,17,17,56,104,138,155,155,608,1160,1608,1918,2073,
%T A297703 2073,9440,18272,25944,32008,36154,38227,38227,198272,387104,557664,
%U A297703 702280,814888,891342,929569,929569,5410688,10623104,15448416,19716064,23281432,26031912,27891050,28820619,28820619
%N A297703 The Genocchi triangle read by rows: T(n, k) = (-1)^n * Sum_{j=0..floor((n-k)/2)} binomial(n-k, 2*j) * (2*(n-j+1)) * Euler(2*(n-j)+1, 1).
%C A297703 From _Peter Luschny_, Nov 07 2026: (Start)
%C A297703 The triangle combines the unsigned Genocchi numbers of first kind of even index (A110501) and the Genocchi numbers of second kind (or Genocchi medians, A005439). Our indexing is the same as in [Deb-Sokal, 2022], but different from [Lazar-Wachs, 2022] and from the OEIS entries.
%C A297703 Let D_n be the set of permutations sigma in S_{2*n+1} satisfying sigma(i) > sigma(i+1) <=> sigma(i) is even for every 1 <= i <= 2*n, the [Dumont, 1974] characterization of the Genocchi numbers [Lazar-Wachs, formula (2.4)]. Then T(n, k) = card{sigma in D_n: n-k <= sigma(1) <= n+k+1 }. In other words: T(n, k) is the number of Dumont permutations of 2*n + 1 elements whose first entry lies in the central interval of 2*k + 2 consecutive integers.
%C A297703 (End)
%H A297703 Peter Luschny, <a href="/A297703/b297703.txt">Rows n = 0..141</a>.
%H A297703 Bishal Deb and Alan D. Sokal, <a href="https://arxiv.org/abs/2212.07232">Classical continued fractions for some multivariate polynomials generalizing the Genocchi and median Genocchi numbers</a>, arXiv:2212.07232 [math.CO], 2022.
%H A297703 Dominique Dumont, <a href="https://doi.org/10.1215/S0012-7094-74-04134-9">Interprétations combinatoires des nombres de Genocchi</a>, Duke Math. J. 41(2): 305-318 (June 1974).
%H A297703 Richard Ehrenborg and Einar Steingrímsson, <a href="https://doi.org/10.1006/eujc.1999.0370">Yet Another Triangle for the Genocchi Numbers</a>, European Journal of Combinatorics 21 (2000), 593-600.
%H A297703 Germain Kreweras, <a href="https://doi.org/10.1006/eujc.1995.0081">Sur les permutations comptées par les nombres de Genocchi de 1-ière et 2-ième espèce</a>, Europ. J. Comb., vol. 18, pp. 49-58, 1997.
%H A297703 Alexander Lazar and Michelle L. Wachs, <a href="https://doi.org/10.5070/C62156874">The homogenized Linial arrangement and Genocchi numbers</a>, Combinatorial Theory 2(1) (2022); and <a href="https://arxiv.org/abs/1910.07651">arXiv version</a>, arXiv:1910.07651 [math.CO], 2019.
%H A297703 Peter Luschny, <a href="https://oeis.org/wiki/User:Peter_Luschny/SeidelTransform">An old operation on sequences: the Seidel transform</a>.
%H A297703 Peter Luschny, <a href="/A297703/a297703.txt">SageMath implementation</a>.
%H A297703 Ludwig Seidel, <a href="http://publikationen.badw.de/de/003384831">Über eine einfache Entstehungsweise der Bernoulli'schen Zahlen und einiger verwandten Reihen</a>, Sitzungsberichte der mathematisch-physikalischen Classe der königlich bayerischen Akademie der Wissenschaften zu München, Vol. 7 (1877), pp. 157-187.
%F A297703 From _Peter Luschny_, Nov 07 2026: (Start)
%F A297703 T(n, n) = A110501(n + 1).
%F A297703 T(n, n - 1) = T(n, n) for n >= 1.
%F A297703 T(n, 0) = A005439(n).
%F A297703 T(n+1, 0) = Sum_{k=0..n} T(n, k).
%F A297703 T(n, k) - T(n, k-1) = Sum_{j=k..n-1} T(n-1, j) for 1 <= k <= n.
%F A297703 T(n, k)^2 > T(n, k-1)*T(n, k+1) for 1 <= k <= n (log-concavity).
%F A297703 T(n, k) = 2 * (-1)^n * Sum_{j=0..floor((n-k)/2)} binomial(n-k, 2*j) * (2^(2*(n-j+1)) - 1) * Bernoulli(2*(n-j+1)). This generalizes a formula given in A005439 by _Ralf Stephan_.
%F A297703 T(n, k) = 2 * (-1)^n * Sum_{j=0..floor((n-k)/2)} binomial(n-k, 2*j) * (j-n-1) * Euler(2*(n-j) + 1, 0).
%F A297703 T(n, k) = (n - k)!*(n + k + 1)!*[x^(n-k) y^(n+k+1)] egf(x, y), where
%F A297703 egf(x, y) = cos(x)*(x + y + sin(x+y)) / (1 + cos(x+y)).
%F A297703 Using the generating functions of the Genocchi and the median Genocchi numbers given by [Lazar-Wachs, 2022], formulas (2.7) and (2.8), one obtains the bivariate generating function gf(x, y) = (A(x) + (1 - y)*(1 - y*B(x*y))) / ((1 - y)^2 + x*y), where A(x) = Sum_{m>=1} m!^2 * x^m / Product{j=1..m} (1 + j*(j+1)*x) and B(z) = Sum_{m>=0} m!^2 * z^m / Product{j=1..m} (1 + j^2*z).
%F A297703 (End)
%e A297703 The indexing and naming as used here: Gn = T(n, n) for the Genocchi, and Hn = T(n, 0) for the Genocchi median numbers:
%e A297703   |  n | 0 | 1 | 2 |  3 |   4 |    5 |     6 |
%e A297703   |------------------------------------------|
%e A297703   | Gn | 1 | 1 | 3 | 17 | 155 | 2073 | 38227 |
%e A297703   | Hn | 1 | 1 | 2 |  8 |  56 |  608 |  9440 |
%e A297703 .
%e A297703 The triangle starts:
%e A297703   0: [     1]
%e A297703   1: [     1,      1]
%e A297703   2: [     2,      3,      3]
%e A297703   3: [     8,     14,     17,     17]
%e A297703   4: [    56,    104,    138,    155,    155]
%e A297703   5: [   608,   1160,   1608,   1918,   2073,   2073]
%e A297703   6: [  9440,  18272,  25944,  32008,  36154,  38227,  38227]
%e A297703   7: [198272, 387104, 557664, 702280, 814888, 891342, 929569, 929569]
%p A297703 T := (n, k) -> (-1)^n*2*add(binomial(n-k, 2*j) * (j-n-1) * euler(2*(n-j)+1, 0), j = 0..iquo(n-k, 2)):
%p A297703 for n from 0 to 8 do seq(T(n, k), k = 0..n) od; # _Peter Luschny_, Nov 06 2026
%t A297703 T[0, 0] := 1; T[n_, 0] /;n>0 := T[n, 0] = Sum[T[n-1, j], {j, 0, n-1}]; T[n_, k_] /;0<k<=n := T[n, k] = 2 T[n, k-1]-T[n, k-2]-T[n-1, k-1]; T[n_, k_] := 0; Flatten@Table[T[n, k], {n, 0, 8}, {k, 0, n}] (* _Oliver Seipel_, Jan 20 2026 *)
%t A297703 (* Alternative: polynomial recursion *)
%t A297703 P[0] = 1; P[n_] := P[n] = Module[{p = P[n - 1]},
%t A297703    Normal@Series[((p /. x -> 1) - x*p) / (1 - x)^2, {x, 0, n} ]];
%t A297703 rowT[n_] := CoefficientList[P[n], x]; Table[rowT[n], {n, 0, 8}] // Flatten
%t A297703 (* _Peter Luschny_, Nov 07 2026 *)
%t A297703 (* Alternative: exponential generating function *)
%t A297703 egf[x_, y_] := Cos[x] (x + y + Sin[x + y]) / (1 + Cos[x + y]);
%t A297703 T[n_, k_] := (n - k)! (n + k + 1)! SeriesCoefficient[egf[x, y], {x, 0, n - k}, {y, 0, n + k + 1}]; Table[Table[T[n, k], {k, 0, n}], {n, 0, 8}] // Flatten
%t A297703 (* _Peter Luschny_, Nov 07 2026 *)
%o A297703 (Julia)
%o A297703 function A297703Triangle(len::Int)
%o A297703     A = fill(BigInt(0), len+2); A[2] = 1
%o A297703     for n in 2:len+1
%o A297703         for k in n:-1:2 A[k] += A[k+1] end
%o A297703         for k in 2: 1:n A[k] += A[k-1] end
%o A297703         println(A[2:n])
%o A297703     end
%o A297703 end
%o A297703 println(A297703Triangle(9))
%o A297703 (Python)
%o A297703 from functools import cache
%o A297703 @cache
%o A297703 def T(n):  # returns row n
%o A297703     if n == 0: return [1]
%o A297703     row = [0] + T(n - 1) + [0]
%o A297703     for k in range(n, 0, -1): row[k] += row[k + 1]
%o A297703     for k in range(2, n + 2): row[k] += row[k - 1]
%o A297703     return row[1:]
%o A297703 for n in range(9): print(T(n))  # _Peter Luschny_, Jun 03 2022
