%I A129137 #19 Aug 03 2026 01:08:35
%S A129137 0,0,1,5,37,366,4553,68408,1206405,24447440,560041201,14315792256,
%T A129137 404057805989,12482986261760,419042630871225,15189786100468736,
%U A129137 591374264243364037,24612549706061862912,1090556290466098198625
%N A129137 Number of trees on [n], rooted at 1, in which 2 is a descendant of 3.
%H A129137 Washington G. Bomfim, <a href="/A129137/b129137.txt">Table of n, a(n) for n = 1..50</a>
%H A129137 H. Bergeron, E. M. F. Curado, J. P. Gazeau and L. M. C. S. Rodrigues, <a href="https://arxiv.org/abs/1309.6910">A note about combinatorial sequences and Incomplete Gamma function</a>, arXiv preprint arXiv: 1309.6910, 2013
%F A129137 Sum_{r=1..n-2} (n-3)!*n^(n-2-r)/(n-2-r)! counts these trees by the length r of the path from 1 to 3.
%F A129137 A057500(n) = binomial(n-1, 2)*a(n).
%e A129137 a(4)=5 counts {1->3->2, 1->4}, {1->3->2, 3->4}, {1->3->2->4}, {1->3->4->2}, {1->4->3->2}.
%t A129137 Table[Exp[n]*Gamma[n-2, n] // Round, {n, 1, 50}] (* _Jean-François Alcover_, Jan 15 2014 *)
%o A129137 (Python) # b(n) computes 0-based column 3 of A398187.
%o A129137 def b(n: int) -> int:
%o A129137     if n == 0: return 1
%o A129137     x = n + 3; v = 1; F = 1
%o A129137     for k in range(1, n + 1):
%o A129137         F *= (n - k + 1)
%o A129137         v = v * x + F
%o A129137     return v
%o A129137 A129137 = lambda n: 0 if n < 3 else b(n - 3)
%o A129137 print([A129137(n) for n in range(1, 20)])  # _Peter Luschny_, Jul 29 2026
%Y A129137 Cf. A057500, A398187.
%K A129137 nonn
%O A129137 1,4
%A A129137 _David Callan_, Mar 30 2007
