%F A129342 a(n) = Sum_{k=0..A007814(n)} 2^(n/2^k).
%F A129342 G.f.: Sum_{k>=0} 1/(1-2*x^2^k).
%t A129342 a[n_] := a[n] = If[OddQ[n], 2^n, a[n/2] + 2^n]; a[0] = 0; Array[a, 35, 0] (* _Amiram Eldar_, Sep 18 2026 *)
%o A129342 (PARI) a(n) = if(n, sum(k = 0, valuation(n, 2), 1 << (n >> k)), 0); \\ _Amiram Eldar_, Sep 18 2026
