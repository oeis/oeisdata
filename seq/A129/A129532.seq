%I A129532 #13 Aug 19 2026 01:27:17
%S A129532 0,0,6,72,576,3840,23040,129024,688128,3538944,17694720,86507520,
%T A129532 415236096,1962934272,9160359936,42278584320,193273528320,
%U A129532 876173328384,3942779977728,17626545782784,78340203479040,346346162749440
%N A129532 a(n) = 3*n*(n-1)*4^(n-2).
%C A129532 Number of inversions in all 4-ary words of length n on {0,1,2,3}. Example: a(2)=6 because each of the words 10,20,30,21,31,32 has one inversion and the words 00,01,02,03,11,12,13,22,23,33 have no inversions.
%H A129532 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (12,-48,64).
%F A129532 G.f.: 6*x^2/(1-4*x)^3.
%F A129532 a(n) = Sum_{k>=0} k*A129531(n,k).
%F A129532 a(n) = 6*A038845(n-2).
%F A129532 From _Elmo R. Oliveira_, Aug 18 2026: (Start)
%F A129532 E.g.f.: 3*x^2*exp(4*x).
%F A129532 a(n) = 12*a(n-1) - 48*a(n-2) + 64*a(n-3). (End)
%p A129532 seq(3*n*(n-1)*4^(n-2),n=0..25);
%t A129532 Table[3n(n-1)4^(n-2),{n,0,30}] (* _Harvey P. Dale_, May 25 2018 *)
%t A129532 (* Alternative: *)
%t A129532 LinearRecurrence[{12,-48,64},{0,0,6},30] (* _Harvey P. Dale_, May 25 2018 *)
%o A129532 (PARI) a(n)=3*n*(n-1)*4^(n-2) \\ _Charles R Greathouse IV_, May 26 2026
%Y A129532 Cf. A001788, A038845, A129530, A129531.
