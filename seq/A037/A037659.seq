%I A037659 #27 Sep 19 2026 19:34:25
%S A037659 3,30,302,3023,30230,302302,3023023,30230230,302302302,3023023023,
%T A037659 30230230230,302302302302,3023023023023,30230230230230,
%U A037659 302302302302302,3023023023023023,30230230230230230,302302302302302302,3023023023023023023,30230230230230230230
%N A037659 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 3,0,2.
%H A037659 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037659 G.f.: x*(3+2*x^2) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Aug 04 2013
%F A037659 From _Elmo R. Oliveira_, Sep 19 2026: (Start)
%F A037659 a(n) = floor((302/999)*10^n).
%F A037659 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). (End)
%F A037659 E.g.f.: exp(-x/2)*(exp(3*x/2)*(302*exp(9*x) - 185) - 117*cos(sqrt(3)*x/2) + 69*sqrt(3)*sin(sqrt(3)*x/2))/999. - _Stefano Spezia_, Sep 19 2026
%p A037659 a:= proc(n) option remember; `if`(n=0, 0,
%p A037659       a(n-1)*10+[3, 0, 2][irem(n-1, 3)+1])
%p A037659     end:
%p A037659 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 19 2026
%o A037659 (PARI) Vec(x*(3+2*x^2)/((x-1)*(10*x-1)*(1+x+x^2)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037659 nonn,base,easy,changed
%O A037659 1,1
%A A037659 _Clark Kimberling_
%E A037659 More terms from _Elmo R. Oliveira_, Sep 19 2026
