%I A037638 #33 Sep 20 2026 13:56:06
%S A037638 2,21,213,2132,21321,213213,2132132,21321321,213213213,2132132132,
%T A037638 21321321321,213213213213,2132132132132,21321321321321,
%U A037638 213213213213213,2132132132132132,21321321321321321,213213213213213213,2132132132132132132,21321321321321321321
%N A037638 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 2,1,3.
%H A037638 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037638 G.f.: x*(2+x+3*x^2) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Nov 21 2011
%F A037638 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). - _Wesley Ivan Hurt_, Jun 05 2026
%F A037638 a(n) = floor((71/333)*10^n). - _Elmo R. Oliveira_, Sep 20 2026
%F A037638 E.g.f.: exp(-x/2)*(71*exp(21*x/2) - 74*exp(3*x/2) + 3*cos(sqrt(3)*x/2) + 21*sqrt(3)*sin(sqrt(3)*x/2))/333. - _Stefano Spezia_, Sep 20 2026
%p A037638 a:= proc(n) option remember; `if`(n=0, 0,
%p A037638       a(n-1)*10+[2, 1, 3][irem(n-1, 3)+1])
%p A037638     end:
%p A037638 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 20 2026
%t A037638 Table[FromDigits[PadRight[{},n,{2,1,3}]],{n,20}] (* _Harvey P. Dale_, Jun 23 2016 *)
%t A037638 (* Alternative: *)
%t A037638 LinearRecurrence[{10,0,1,-10},{2,21,213,2132},20] (* _Harvey P. Dale_, Jun 23 2016 *)
%o A037638 (PARI) Vec(x*(2+x+3*x^2)/((x-1)*(10*x-1)*(1+x+x^2)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037638 nonn,base,easy,changed
%O A037638 1,1
%A A037638 _Clark Kimberling_
%E A037638 More terms from _Elmo R. Oliveira_, Sep 20 2026
