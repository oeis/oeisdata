%I A037722 #31 Sep 23 2026 21:52:29
%S A037722 2,20,201,2013,20132,201320,2013201,20132013,201320132,2013201320,
%T A037722 20132013201,201320132013,2013201320132,20132013201320,
%U A037722 201320132013201,2013201320132013,20132013201320132,201320132013201320,2013201320132013201,20132013201320132013
%N A037722 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 2,0,1,3.
%H A037722 Paolo Xausa, <a href="/A037722/b037722.txt">Table of n, a(n) for n = 1..1000</a>
%H A037722 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (11,-11,11,-10).
%F A037722 G.f.: x*(2-2*x+3*x^2) / ( (x-1)*(10*x-1)*(x^2+1) ). - _R. J. Mathar_, Nov 21 2011
%F A037722 From _Elmo R. Oliveira_, Sep 23 2026: (Start)
%F A037722 a(n) = floor(671*10^n/3333).
%F A037722 a(n) = 11*a(n-1) - 11*a(n-2) + 11*a(n-3) - 10*a(n-4). (End)
%F A037722 E.g.f.: (-101*exp(x) + 122*exp(10*x) - 21*cos(x) + 93*sin(x))/606. - _Stefano Spezia_, Sep 23 2026
%t A037722 Quotient[671*10^Range[25], 3333] (* _Paolo Xausa_, Sep 23 2026 *)
%t A037722 (* Alternative: *)
%t A037722 LinearRecurrence[{11, -11, 11, -10}, {2, 20, 201, 2013}, 25] (* _Paolo Xausa_, Sep 23 2026 *)
%o A037722 (PARI) Vec(x*(2-2*x+3*x^2)/((x-1)*(10*x-1)*(x^2+1)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037722 nonn,base,easy,changed
%O A037722 1,1
