%I A037511 #28 Sep 19 2026 19:30:00
%S A037511 1,12,120,1201,12012,120120,1201201,12012012,120120120,1201201201,
%T A037511 12012012012,120120120120,1201201201201,12012012012012,
%U A037511 120120120120120,1201201201201201,12012012012012012,120120120120120120,1201201201201201201,12012012012012012012
%N A037511 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 1,2,0.
%H A037511 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037511 G.f.: x*(1+2*x) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Aug 04 2013
%F A037511 From _Elmo R. Oliveira_, Sep 19 2026: (Start)
%F A037511 a(n) = floor(4*10^(n+1)/333).
%F A037511 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). (End)
%p A037511 a:= proc(n) option remember; `if`(n=0, 0,
%p A037511       a(n-1)*10+[1, 2, 0][irem(n-1, 3)+1])
%p A037511     end:
%p A037511 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 19 2026
%t A037511 Table[FromDigits[PadRight[{},n,{1,2,0}]],{n,20}] (* _Harvey P. Dale_, Jan 03 2023 *)
%t A037511 (* Alternative: *)
%t A037511 LinearRecurrence[{10,0,1,-10},{1,12,120,1201},20] (* _Harvey P. Dale_, Jan 03 2023 *)
%o A037511 (PARI) Vec(x*(1+2*x)/((x-1)*(10*x-1)*(1+x+x^2)) + O(x^30)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037511 nonn,base,easy,changed
%O A037511 1,2
%A A037511 _Clark Kimberling_
%E A037511 More terms from _Elmo R. Oliveira_, Sep 19 2026
