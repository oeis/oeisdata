%I A037535 #28 Sep 19 2026 19:35:54
%S A037535 1,11,112,1121,11211,112112,1121121,11211211,112112112,1121121121,
%T A037535 11211211211,112112112112,1121121121121,11211211211211,
%U A037535 112112112112112,1121121121121121,11211211211211211,112112112112112112,1121121121121121121,11211211211211211211
%N A037535 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 1,1,2.
%H A037535 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037535 G.f.: x*(1+x+2*x^2) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Aug 12 2013
%F A037535 From _Elmo R. Oliveira_, Sep 19 2026: (Start)
%F A037535 a(n) = floor((112/999)*10^n).
%F A037535 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). (End)
%F A037535 E.g.f.: 2*exp(-x/2)*(18*cos(sqrt(3)*x/2) + 15*sqrt(3)*sin(sqrt(3)*x/2) - 74*exp(3*x/2) + 56*exp(21*x/2))/999. - _Stefano Spezia_, Sep 19 2026
%p A037535 a:= proc(n) option remember; `if`(n=0, 0,
%p A037535       a(n-1)*10+[1, 1, 2][irem(n-1, 3)+1])
%p A037535     end:
%p A037535 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 19 2026
%t A037535 Table[FromDigits[PadRight[{},n,{1,1,2}]],{n,20}] (* _Harvey P. Dale_, Aug 03 2017 *)
%o A037535 (PARI) Vec(x*(1+x+2*x^2)/((x-1)*(10*x-1)*(1+x+x^2)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037535 nonn,base,easy,changed
%O A037535 1,2
%A A037535 _Clark Kimberling_
%E A037535 More terms from _Elmo R. Oliveira_, Sep 19 2026
