%T A037588 10983370863,98850337768,889653039915,8006877359236,72061896233127,
%U A037588 648557066098144,5837013594883299,52533122353949692,472798101185547231,4255182910669925080,38296646196029325723
%N A037588 Base 9 digits are, in order, the first n terms of the periodic sequence with initial period 3,1.
%H A037588 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (9,1,-9).
%F A037588 From _R. J. Mathar_, Apr 27 2015: (Start)
%F A037588 G.f.: x*(3+x) / ( (x-1)*(9*x-1)*(1+x) ).
%F A037588 a(n) = 7*9^n/20 -1/4 +(-1)^(n+1)/10. (End)
%F A037588 From _Elmo R. Oliveira_, Sep 12 2026: (Start)
%F A037588 a(n) = floor(7*9^n/20).
%F A037588 a(n) = 9*a(n-1) + a(n-2) - 9*a(n-3).
%F A037588 E.g.f.: (7*(exp(9*x) - cosh(x)) - 3*sinh(x))/20. (End)
%t A037588 With[{c=PadLeft[{},22,{3,1}]},Table[FromDigits[Take[c,n],9],{n,22}]] (* _Harvey P. Dale_, Oct 15 2011 *)
