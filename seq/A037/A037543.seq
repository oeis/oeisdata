%S A037543 1,12,121,1211,12112,121121,1211211,12112112,121121121,1211211211,
%T A037543 12112112112,121121121121,1211211211211,12112112112112,
%U A037543 121121121121121,1211211211211211,12112112112112112,121121121121121121,1211211211211211211,12112112112112112112
%N A037543 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 1,2,1.
%H A037543 Paolo Xausa, <a href="/A037543/b037543.txt">Table of n, a(n) for n = 1..1000</a>
%H A037543 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037543 G.f.: x*(1+x)^2 / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Aug 12 2013
%F A037543 From _Elmo R. Oliveira_, Sep 19 2026: (Start)
%F A037543 a(n) = floor((121/999)*10^n).
%F A037543 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). (End)
%p A037543 a:= proc(n) option remember; `if`(n=0, 0,
%p A037543       a(n-1)*10+[1, 2, 1][irem(n-1, 3)+1])
%p A037543     end:
%p A037543 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 19 2026
%t A037543 Quotient[121*10^Range[25], 999] (* _Paolo Xausa_, Sep 21 2026 *)
%t A037543 (* Alternative: *)
%t A037543 LinearRecurrence[{10, 0, 1, -10}, {1, 12, 121, 1211}, 25] (* _Paolo Xausa_, Sep 21 2026 *)
%o A037543 (PARI) Vec(x*(1+x)^2/((x-1)*(10*x-1)*(1+x+x^2)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
