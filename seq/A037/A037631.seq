%I A037631 #32 Sep 20 2026 13:55:02
%S A037631 2,23,230,2302,23023,230230,2302302,23023023,230230230,2302302302,
%T A037631 23023023023,230230230230,2302302302302,23023023023023,
%U A037631 230230230230230,2302302302302302,23023023023023023,230230230230230230,2302302302302302302,23023023023023023023
%N A037631 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 2,3,0.
%H A037631 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037631 G.f.: x*(2+3*x) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Nov 21 2011
%F A037631 From _Elmo R. Oliveira_, Sep 20 2026: (Start)
%F A037631 a(n) = floor(23*10^(n+1)/999).
%F A037631 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). (End)
%F A037631 E.g.f.: exp(-x/2)*(230*exp(21*x/2) - 185*exp(3*x/2) - 45*cos(sqrt(3)*x/2) - 93*sqrt(3)*sin(sqrt(3)*x/2))/999. - _Stefano Spezia_, Sep 20 2026
%p A037631 a:= proc(n) option remember; `if`(n=0, 0,
%p A037631       a(n-1)*10+[2, 3, 0][irem(n-1, 3)+1])
%p A037631     end:
%p A037631 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 20 2026
%t A037631 Table[FromDigits[PadRight[{},n,{2,3,0}]],{n,20}] (* _Harvey P. Dale_, Jul 03 2024 *)
%t A037631 (* Alternative: *)
%t A037631 LinearRecurrence[{10,0,1,-10},{2,23,230,2302},20] (* _Harvey P. Dale_, Jul 03 2024 *)
%o A037631 (PARI) Vec(x*(2+3*x)/((x-1)*(10*x-1)*(1+x+x^2)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037631 nonn,base,easy,changed
%O A037631 1,1
%A A037631 _Clark Kimberling_
%E A037631 More terms from _Elmo R. Oliveira_, Sep 20 2026
