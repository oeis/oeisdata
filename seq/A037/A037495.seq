%I A037495 #38 Sep 08 2026 10:58:16
%S A037495 2,21,212,2121,21212,212121,2121212,21212121,212121212,2121212121,
%T A037495 21212121212,212121212121,2121212121212,21212121212121,
%U A037495 212121212121212,2121212121212121,21212121212121212,212121212121212121,2121212121212121212,21212121212121212121
%N A037495 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 2,1.
%H A037495 Vincenzo Librandi, <a href="/A037495/b037495.txt">Table of n, a(n) for n = 1..1000</a>
%H A037495 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (10,1,-10).
%F A037495 G.f.: x*(2+x) / ((x-1)*(10*x-1)*(1+x)). - _R. J. Mathar_, Nov 21 2011
%F A037495 From _Elmo R. Oliveira_, Sep 07 2026: (Start)
%F A037495 a(n) = floor((7/33)*10^n).
%F A037495 a(n) = 10*a(n-1) + a(n-2) - 10*a(n-3).
%F A037495 E.g.f.: (7*(exp(10*x) - cosh(x)) - 4*sinh(x))/33. (End)
%t A037495 Table[-(1/6)-(1/22)*(-1)^n+(7/33)*10^n,{n,1,20}] (* _Vincenzo Librandi_, Nov 23 2011 *)
%t A037495 (* Alternative: *)
%t A037495 Table[FromDigits[PadRight[{},n,{2,1}]],{n,20}] (* _Harvey P. Dale_, Aug 21 2013 *)
%o A037495 (Magma) [-(1/6)-(1/22)*(-1)^n+(7/33)*10^n: n in [1..20]]; // _Vincenzo Librandi_, Nov 23 2011
%Y A037495 Cf. A037589.
%K A037495 nonn,easy,base,changed
%O A037495 1,1
%A A037495 _Clark Kimberling_
