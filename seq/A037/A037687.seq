%I A037687 #30 Sep 23 2026 08:50:37
%S A037687 1,10,103,1032,10321,103210,1032103,10321032,103210321,1032103210,
%T A037687 10321032103,103210321032,1032103210321,10321032103210,
%U A037687 103210321032103,1032103210321032,10321032103210321,103210321032103210,1032103210321032103,10321032103210321032,103210321032103210321
%N A037687 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 1,0,3,2.
%H A037687 Paolo Xausa, <a href="/A037687/b037687.txt">Table of n, a(n) for n = 1..1000</a>
%H A037687 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,0,1,-10).
%F A037687 G.f.: x*(1+3*x^2+2*x^3) / ( (x-1)*(10*x-1)*(1+x)*(x^2+1) ). - _R. J. Mathar_, Aug 12 2013
%F A037687 From _Elmo R. Oliveira_, Sep 22 2026: (Start)
%F A037687 a(n) = floor(344*10^n/3333).
%F A037687 a(n) = 10*a(n-1) + a(n-4) - 10*a(n-5). (End)
%F A037687 E.g.f.: (-303*exp(-x) - 1111*exp(x) + 688*exp(10*x) + 726*cos(x) + 594*sin(x))/6666. - _Stefano Spezia_, Sep 22 2026
%p A037687 a:= proc(n) option remember; `if`(n=0, 0,
%p A037687       a(n-1)*10+[1, 0, 3, 2][irem(n-1, 4)+1])
%p A037687     end:
%p A037687 seq(a(n), n=1..21);  # _Alois P. Heinz_, Sep 22 2026
%t A037687 Quotient[344*10^Range[25], 3333] (* _Paolo Xausa_, Sep 23 2026 *)
%t A037687 (* Alternative: *)
%t A037687 LinearRecurrence[{10, 0, 0, 1, -10}, {1, 10, 103, 1032, 10321}, 25] (* _Paolo Xausa_, Sep 23 2026 *)
%o A037687 (PARI) Vec(x*(1+3*x^2+2*x^3)/((x-1)*(10*x-1)*(1+x)*(x^2+1)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037687 nonn,base,easy,changed
