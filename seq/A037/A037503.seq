%I A037503 #37 Sep 23 2026 01:18:21
%S A037503 1,10,102,1021,10210,102102,1021021,10210210,102102102,1021021021,
%T A037503 10210210210,102102102102,1021021021021,10210210210210,
%U A037503 102102102102102,1021021021021021,10210210210210210,102102102102102102,1021021021021021021,10210210210210210210,102102102102102102102
%N A037503 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 1,0,2.
%H A037503 Paolo Xausa, <a href="/A037503/b037503.txt">Table of n, a(n) for n = 1..1000</a>
%H A037503 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037503 G.f.: x*(1+2*x^2) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Aug 12 2013
%F A037503 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). - _Wesley Ivan Hurt_, Sep 22 2020
%F A037503 a(n) = floor(34*10^n/333). - _Elmo R. Oliveira_, Sep 19 2026
%F A037503 E.g.f.: exp(-x/2)*(-37*exp(3*x/2) + 34*exp(21*x/2) + 3*cos(sqrt(3)*x/2) + 21*sqrt(3)*sin(sqrt(3)*x/2))/333. - _Stefano Spezia_, Sep 22 2026
%p A037503 a:= proc(n) option remember; `if`(n=0, 0,
%p A037503       a(n-1)*10+[1, 0, 2][irem(n-1, 3)+1])
%p A037503     end:
%p A037503 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 19 2026
%t A037503 Quotient[34*10^Range[25], 333] (* _Paolo Xausa_, Sep 21 2026 *)
%t A037503 (* Alternative: *)
%t A037503 LinearRecurrence[{10, 0, 1, -10}, {1, 10, 102, 1021}, 25] (* _Paolo Xausa_, Sep 21 2026 *)
%o A037503 (PARI) Vec(x*(1+2*x^2)/((x-1)*(10*x-1)*(1+x+x^2)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
