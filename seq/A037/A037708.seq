%N A037708 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 1,3,0,2.
%H A037708 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,0,1,-10).
%F A037708 G.f.: x*(1+3*x+2*x^3) / ( (x-1)*(10*x-1)*(1+x)*(x^2+1) ). - _R. J. Mathar_, Aug 04 2013
%F A037708 From _Elmo R. Oliveira_, Sep 22 2026: (Start)
%F A037708 a(n) = floor(434*10^n/3333).
%F A037708 a(n) = 10*a(n-1) + a(n-4) - 10*a(n-5). (End)
%t A037708 Table[FromDigits[PadRight[{},n,{1,3,0,2}]],{n,20}] (* _Harvey P. Dale_, Apr 23 2020 *)
%t A037708 (* Alternative: *)
%t A037708 LinearRecurrence[ {10,0,0,1,-10},{1,13,130,1302,13021},20] (* _Harvey P. Dale_, Apr 23 2020 *)
%K A037708 nonn,easy,base,changed
%O A037708 1,2
