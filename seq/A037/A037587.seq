%S A037587 3,25,203,1625,13003,104025,832203,6657625,53261003,426088025,
%T A037587 3408704203,27269633625,218157069003,1745256552025,13962052416203,
%U A037587 111696419329625,893571354637003,7148570837096025,57188566696768203,457508533574145625,3660068268593165003,29280546148745320025
%N A037587 Base 8 digits are, in order, the first n terms of the periodic sequence with initial period 3,1.
%H A037587 Paolo Xausa, <a href="/A037587/b037587.txt">Table of n, a(n) for n = 1..1000</a>
%H A037587 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (8,1,-8).
%F A037587 G.f.: x*(3+x) / ( (x-1)*(-1+8*x)*(1+x) ). - _R. J. Mathar_, Apr 26 2015
%F A037587 E.g.f.: exp(-x)*(25*exp(9*x) - 18*exp(2*x) - 7)/63. - _Stefano Spezia_, Sep 13 2026
%F A037587 From _Elmo R. Oliveira_, Sep 14 2026: (Start)
%F A037587 a(n) = 8*a(n-1) + a(n-2) - 8*a(n-3).
%F A037587 a(n) = floor(25*8^n/63) = (25*8^n - 7*(-1)^n - 18)/63. (End)
%t A037587 A037587[n_] := Quotient[25*8^n, 63]; Array[A037587, 25] (* _Paolo Xausa_, Sep 17 2026 *)
%t A037587 (* Alternative: *)
%t A037587 LinearRecurrence[{8, 1, -8}, {3, 25, 203}, 25] (* _Paolo Xausa_, Sep 17 2026 *)
