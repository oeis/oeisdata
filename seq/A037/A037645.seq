%I A037645 #31 Sep 21 2026 17:22:50
%S A037645 2,23,231,2312,23123,231231,2312312,23123123,231231231,2312312312,
%T A037645 23123123123,231231231231,2312312312312,23123123123123,
%U A037645 231231231231231,2312312312312312,23123123123123123,231231231231231231,2312312312312312312,23123123123123123123
%N A037645 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 2,3,1.
%H A037645 Paolo Xausa, <a href="/A037645/b037645.txt">Table of n, a(n) for n = 1..1000</a>
%H A037645 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037645 G.f.: x*(x+2)*(1+x) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Nov 21 2011
%F A037645 From _Elmo R. Oliveira_, Sep 19 2026: (Start)
%F A037645 a(n) = floor(77*10^n/333).
%F A037645 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). (End)
%F A037645 E.g.f.: exp(-x/2)*(-74*exp(3*x/2) + 77*exp(21*x/2) - 3*cos(sqrt(3)*x/2) - 21*sqrt(3)*sin(sqrt(3)*x/2))/333. - _Stefano Spezia_, Sep 20 2026
%t A037645 Quotient[77*10^Range[25], 333] (* _Paolo Xausa_, Sep 21 2026 *)
%t A037645 (* Alternative: *)
%t A037645 LinearRecurrence[{10, 0, 1, -10}, {2, 23, 231, 2312}, 25] (* _Paolo Xausa_, Sep 21 2026 *)
%o A037645 (PARI) a(n) = 77*10^n \ 333; \\ _Elmo R. Oliveira_, Sep 19 2026
%K A037645 nonn,base,easy,changed
%O A037645 1,1
%A A037645 _Clark Kimberling_
%E A037645 More terms from _Elmo R. Oliveira_, Sep 19 2026
