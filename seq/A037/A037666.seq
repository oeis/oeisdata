%I A037666 #28 Sep 19 2026 19:28:55
%S A037666 3,31,310,3103,31031,310310,3103103,31031031,310310310,3103103103,
%T A037666 31031031031,310310310310,3103103103103,31031031031031,
%U A037666 310310310310310,3103103103103103,31031031031031031,310310310310310310,3103103103103103103,31031031031031031031
%N A037666 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 3,1,0.
%H A037666 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037666 G.f.: x*(3+x) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Aug 04 2013
%F A037666 From _Elmo R. Oliveira_, Sep 19 2026: (Start)
%F A037666 a(n) = floor(31*10^(n+1)/999).
%F A037666 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). (End)
%p A037666 a:= proc(n) option remember; `if`(n=0, 0,
%p A037666       a(n-1)*10+[3, 1, 0][irem(n-1, 3)+1])
%p A037666     end:
%p A037666 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 19 2026
%t A037666 Table[FromDigits[PadRight[{},n,{3,1,0}]],{n,30}] (* _Harvey P. Dale_, Oct 11 2020 *)
%t A037666 (* Alternative: *)
%t A037666 LinearRecurrence[ {10,0,1,-10},{3,31,310,3103},30] (* _Harvey P. Dale_, Oct 11 2020 *)
%o A037666 (PARI) Vec(x*(3+x)/((x-1)*(10*x-1)*(1+x+x^2)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037666 nonn,base,easy,changed
%O A037666 1,1
%A A037666 _Clark Kimberling_
%E A037666 More terms from _Elmo R. Oliveira_, Sep 19 2026
