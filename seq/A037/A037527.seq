%I A037527 #35 Sep 23 2026 01:18:15
%S A037527 2,21,210,2102,21021,210210,2102102,21021021,210210210,2102102102,
%T A037527 21021021021,210210210210,2102102102102,21021021021021,
%U A037527 210210210210210,2102102102102102,21021021021021021,210210210210210210,2102102102102102102,21021021021021021021
%N A037527 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 2,1,0.
%H A037527 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037527 G.f.: x*(2+x) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Nov 21 2011
%F A037527 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4); a(1)=2, a(2)=21, a(3)=210, a(4)=2102. - _Harvey P. Dale_, Jan 02 2013
%F A037527 a(n) = floor(7*10^(n+1)/333). - _Elmo R. Oliveira_, Sep 19 2026
%F A037527 E.g.f.: exp(-x/2)*(-37*exp(3*x/2) + 70*exp(21*x/2) - 33*cos(sqrt(3)*x/2) - 9*sqrt(3)*sin(sqrt(3)*x/2))/333. - _Stefano Spezia_, Sep 22 2026
%p A037527 a:= proc(n) option remember; `if`(n=0, 0,
%p A037527       a(n-1)*10+[2, 1, 0][irem(n-1, 3)+1])
%p A037527     end:
%p A037527 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 19 2026
%t A037527 Module[{nn=30,c},c=PadRight[{},nn,{2,1,0}];Table[FromDigits[Take[c,n]],{n,nn}]] (* _Harvey P. Dale_, Jan 02 2013 *)
%t A037527 (* Alternative: *)
%t A037527 LinearRecurrence[{10,0,1,-10},{2,21,210,2102},30] (* _Harvey P. Dale_, Jan 02 2013 *)
%o A037527 (PARI) Vec(x*(2+x)/((x-1)*(10*x-1)*(1+x+x^2)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037527 nonn,base,easy,changed
%O A037527 1,1
%A A037527 _Clark Kimberling_
