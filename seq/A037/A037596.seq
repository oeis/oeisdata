%I A037596 #23 Sep 23 2026 01:18:07
%S A037596 1,10,103,1031,10310,103103,1031031,10310310,103103103,1031031031,
%T A037596 10310310310,103103103103,1031031031031,10310310310310,
%U A037596 103103103103103,1031031031031031,10310310310310310,103103103103103103,1031031031031031031,10310310310310310310
%N A037596 Numbers written in base 4 whose digits are, in order, the first n terms of the periodic sequence with initial period 1,0,3.
%H A037596 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037596 G.f.: x*(1+3*x^2) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Apr 27 2015
%F A037596 From _Elmo R. Oliveira_, Sep 20 2026: (Start)
%F A037596 a(n) = floor((103/999)*10^n).
%F A037596 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). (End)
%F A037596 E.g.f.: exp(-x/2)*(-148*exp(3*x/2) + 103*exp(21*x/2) + 45*cos(sqrt(3)*x/2) + 93*sqrt(3)*sin(sqrt(3)*x/2))/999. - _Stefano Spezia_, Sep 22 2026
%p A037596 a:= proc(n) option remember; `if`(n=0, 0,
%p A037596       a(n-1)*10+[1, 0, 3][irem(n-1, 3)+1])
%p A037596     end:
%p A037596 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 20 2026
%t A037596 With[{c=PadRight[{},21,{1,0,3}]},Table[FromDigits[Take[c,n]],{n,20}]] (* _Harvey P. Dale_, Dec 29 2011 *)
%o A037596 (PARI) a(n) = 103*10^n \ 999; \\ _Elmo R. Oliveira_, Sep 20 2026
%K A037596 nonn,base,easy,changed
%O A037596 1,2
%A A037596 _Clark Kimberling_
%E A037596 More terms from _Elmo R. Oliveira_, Sep 20 2026
