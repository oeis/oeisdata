%I A037673 #30 Sep 21 2026 17:22:57
%S A037673 3,32,320,3203,32032,320320,3203203,32032032,320320320,3203203203,
%T A037673 32032032032,320320320320,3203203203203,32032032032032,
%U A037673 320320320320320,3203203203203203,32032032032032032,320320320320320320,3203203203203203203,32032032032032032032
%N A037673 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 3,2,0.
%H A037673 Paolo Xausa, <a href="/A037673/b037673.txt">Table of n, a(n) for n = 1..1000</a>
%H A037673 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037673 G.f.: x*(3+2*x) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Aug 04 2013
%F A037673 From _Elmo R. Oliveira_, Sep 19 2026: (Start)
%F A037673 a(n) = floor(32*10^(n+1)/999).
%F A037673 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). (End)
%F A037673 E.g.f: exp(-x/2)*(-185*exp(3*x/2) + 320*exp(21*x/2) - 135*cos(sqrt(3)*x/2) - 57*sqrt(3)*sin(sqrt(3)*x/2))/999. - _Stefano Spezia_, Sep 20 2026
%p A037673 a:= proc(n) option remember; `if`(n=0, 0,
%p A037673       a(n-1)*10+[3, 2, 0][irem(n-1, 3)+1])
%p A037673     end:
%p A037673 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 20 2026
%t A037673 Quotient[32*10^(Range[25] + 1), 999] (* _Paolo Xausa_, Sep 21 2026 *)
%t A037673 (* Alternative: *)
%t A037673 LinearRecurrence[{10, 0, 1, -10}, {3, 32, 320, 3203}, 25] (* _Paolo Xausa_, Sep 21 2026 *)
%o A037673 (PARI) Vec(x*(3+2*x)/((x-1)*(10*x-1)*(1+x+x^2)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037673 nonn,base,easy,changed
%O A037673 1,1
%A A037673 _Clark Kimberling_
