%I A037799 #31 Sep 24 2026 01:23:48
%S A037799 3,32,321,3210,32103,321032,3210321,32103210,321032103,3210321032,
%T A037799 32103210321,321032103210,3210321032103,32103210321032,
%U A037799 321032103210321,3210321032103210,32103210321032103,321032103210321032,3210321032103210321,32103210321032103210,321032103210321032103,3210321032103210321032
%N A037799 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 3,2,1,0.
%H A037799 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,0,1,-10).
%F A037799 G.f.: x*(3+2*x+x^2) / ( (x-1)*(10*x-1)*(1+x)*(x^2+1) ). - _R. J. Mathar_, Aug 04 2013
%F A037799 E.g.f.: (2140*exp(10*x) - 1111*exp(x) - 303*exp(-x) - 726*cos(x) - 594*sin(x))/6666. - _Stefano Spezia_, Sep 20 2026
%F A037799 From _Elmo R. Oliveira_, Sep 23 2026: (Start)
%F A037799 a(n) = floor(107*10^(n+1)/3333).
%F A037799 a(n) = 10*a(n-1) + a(n-4) - 10*a(n-5). (End)
%p A037799 a:= proc(n) option remember; `if`(n=0, 0,
%p A037799       a(n-1)*10+[3, 2, 1, 0][irem(n-1, 4)+1])
%p A037799     end:
%p A037799 seq(a(n), n=1..22);  # _Alois P. Heinz_, Sep 20 2026
%t A037799 Table[FromDigits[PadRight[{},n,{3,2,1,0}]],{n,20}] (* _Harvey P. Dale_, Apr 06 2017 *)
%t A037799 (* Alternative: *)
%t A037799 LinearRecurrence[ {10,0,0,1,-10},{3,32,321,3210,32103},20] (* _Harvey P. Dale_, Apr 06 2017 *)
%K A037799 nonn,base,easy,changed
%O A037799 1,1
%A A037799 _Clark Kimberling_
%E A037799 a(17)-a(22) from _Stefano Spezia_, Sep 20 2026
