%N A037628 Base 7 digits are, in order, the first n terms of the periodic sequence with initial period 2,3,0.
%H A037628 Paolo Xausa, <a href="/A037628/b037628.txt">Table of n, a(n) for n = 1..1000</a>
%H A037628 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (7,0,1,-7).
%F A037628 G.f.: x*(2+3*x) / ( (x-1)*(7*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Nov 21 2011
%F A037628 From _Elmo R. Oliveira_, Sep 20 2026: (Start)
%F A037628 a(n) = floor(17*7^(n+1)/342).
%F A037628 a(n) = 7*a(n-1) + a(n-3) - 7*a(n-4). (End)
%t A037628 Quotient[17*7^(Range[25] + 1), 342] (* _Paolo Xausa_, Sep 23 2026 *)
%t A037628 (* Alternative: *)
%t A037628 LinearRecurrence[{7, 0, 1, -7}, {2, 17, 119, 835}, 25] (* _Paolo Xausa_, Sep 23 2026 *)
%o A037628 (PARI) a(n) = 119*7^n \ 342; \\ _Elmo R. Oliveira_, Sep 20 2026
