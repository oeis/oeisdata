%S A037575 2,21,212,2122,21221,212212,2122122,21221221,212212212,2122122122,
%T A037575 21221221221,212212212212,2122122122122,21221221221221,
%U A037575 212212212212212,2122122122122122,21221221221221221,212212212212212212,2122122122122122122,21221221221221221221
%N A037575 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 2,1,2.
%H A037575 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,1,-10).
%F A037575 G.f.: x*(2+x+2*x^2) / ( (x-1)*(10*x-1)*(1+x+x^2) ). - _R. J. Mathar_, Nov 21 2011
%F A037575 From _Elmo R. Oliveira_, Sep 20 2026: (Start)
%F A037575 a(n) = floor((212/999)*10^n).
%F A037575 a(n) = 10*a(n-1) + a(n-3) - 10*a(n-4). (End)
%p A037575 a:= proc(n) option remember; `if`(n=0, 0,
%p A037575       a(n-1)*10+[2, 1, 2][irem(n-1, 3)+1])
%p A037575     end:
%p A037575 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 20 2026
%t A037575 LinearRecurrence[{10,0,1,-10},{2,21,212,2122},30] (* _Harvey P. Dale_, Dec 12 2014 *)
%t A037575 (* Alternative: *)
%t A037575 Table[ FromDigits[ PadRight[{},n,{2,1,2}]],{n,30}] (* _Harvey P. Dale_, Dec 12 2014 *)
%o A037575 (PARI) Vec(x*(2+x+2*x^2)/((x-1)*(10*x-1)*(1+x+x^2)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
