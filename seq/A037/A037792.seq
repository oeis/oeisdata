%I A037792 #28 Sep 20 2026 13:59:59
%S A037792 3,32,320,3201,32013,320132,3201320,32013201,320132013,3201320132,
%T A037792 32013201320,320132013201,3201320132013,32013201320132,
%U A037792 320132013201320,3201320132013201,32013201320132013,320132013201320132,3201320132013201320,32013201320132013201,320132013201320132013
%N A037792 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 3,2,0,1.
%H A037792 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (11,-11,11,-10).
%F A037792 G.f.: x*(3-x+x^2) / ( (x-1)*(10*x-1)*(x^2+1) ). - _R. J. Mathar_, Aug 04 2013
%F A037792 E.g.f.: (194*exp(10*x) - 101*exp(x) - 93*cos(x) - 21*sin(x))/606. - _Stefano Spezia_, Sep 20 2026
%p A037792 a:= proc(n) option remember; `if`(n=0, 0,
%p A037792       a(n-1)*10+[3, 2, 0, 1][irem(n-1, 4)+1])
%p A037792     end:
%p A037792 seq(a(n), n=1..21);  # _Alois P. Heinz_, Sep 20 2026
%t A037792 Table[FromDigits[PadRight[{},n,{3,2,0,1}]],{n,20}] (* _Harvey P. Dale_, Jan 18 2014 *)
%t A037792 (* Alternative: *)
%t A037792 LinearRecurrence[ {11,-11,11,-10},{3,32,320,3201},20] (* _Harvey P. Dale_, Jan 18 2014 *)
%K A037792 nonn,base,easy,changed
%O A037792 1,1
%A A037792 _Clark Kimberling_
%E A037792 a(17)-a(21) from _Stefano Spezia_, Sep 20 2026
