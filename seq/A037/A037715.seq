%I A037715 #33 Sep 23 2026 21:52:24
%S A037715 1,13,132,1320,13201,132013,1320132,13201320,132013201,1320132013,
%T A037715 13201320132,132013201320,1320132013201,13201320132013,
%U A037715 132013201320132,1320132013201320,13201320132013201,132013201320132013,1320132013201320132,13201320132013201320
%N A037715 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 1,3,2,0.
%H A037715 Paolo Xausa, <a href="/A037715/b037715.txt">Table of n, a(n) for n = 1..1000</a>
%H A037715 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (11,-11,11,-10).
%F A037715 G.f.: x*(1+2*x) / ( (x-1)*(10*x-1)*(x^2+1) ). - _R. J. Mathar_, Aug 04 2013
%F A037715 a(n) = 11*a(n-1) - 11*a(n-2) + 11*a(n-3) - 10*a(n-4). - _Wesley Ivan Hurt_, Sep 06 2022
%F A037715 a(n) = floor(44*10^(n+1)/3333). - _Elmo R. Oliveira_, Sep 23 2026
%F A037715 E.g.f.: (-101*exp(x) + 80*exp(10*x) + 21*cos(x) - 93*sin(x))/606. - _Stefano Spezia_, Sep 23 2026
%t A037715 Quotient[44*10^(Range[25] + 1), 3333] (* _Paolo Xausa_, Sep 23 2026 *)
%t A037715 (* Alternative: *)
%t A037715 LinearRecurrence[{11, -11, 11, -10}, {1, 13, 132, 1320}, 25] (* _Paolo Xausa_, Sep 23 2026 *)
%o A037715 (PARI) Vec(x*(1+2*x)/((x-1)*(10*x-1)*(x^2+1)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037715 nonn,base,easy,changed
%O A037715 1,2
