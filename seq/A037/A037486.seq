%I A037486 #26 Sep 27 2026 11:03:19
%S A037486 1,11,100,902,8119,73073,657658,5918924,53270317,479432855,4314895696,
%T A037486 38834061266,349506551395,3145558962557,28310030663014,
%U A037486 254790275967128,2293112483704153,20638012353337379,185742111180036412,1671679000620327710,15045111005582949391
%N A037486 Base 9 digits are, in order, the first n terms of the periodic sequence with initial period 1,2.
%H A037486 <a href="/index/Rec#order_03">Index entries for linear recurrences with constant coefficients</a>, signature (9,1,-9).
%F A037486 a(n) = 9*a(n-1) + a(n-2) - 9*a(n-3).
%F A037486 From _Bruno Berselli_, Jan 20 2011: (Start)
%F A037486 G.f.: x*(1+2*x)/((1-9*x)*(1-x^2)).
%F A037486 a(n) = (11*9^n+4*(-1)^n-15)/80. (End)
%F A037486 From _Elmo R. Oliveira_, Sep 24 2026: (Start)
%F A037486 a(n) = floor(11*9^n/80).
%F A037486 E.g.f.: (11*(exp(9*x) - cosh(x)) - 19*sinh(x))/80 = (11*exp(5*x)*sinh(4*x) - 4*sinh(x))/40. (End)
%t A037486 Table[FromDigits[PadRight[{},n,{1,2}],9],{n,25}] (* _Harvey P. Dale_, Feb 15 2020 *)
%t A037486 (* Alternative: *)
%t A037486 LinearRecurrence[ {9,1,-9},{1,11,100},25] (* _Harvey P. Dale_, Feb 15 2020 *)
%K A037486 nonn,base,easy,changed
%O A037486 1,2
%A A037486 _Clark Kimberling_
%E A037486 More terms from _Elmo R. Oliveira_, Sep 24 2026
