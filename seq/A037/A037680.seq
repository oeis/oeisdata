%I A037680 #30 Sep 22 2026 16:17:02
%S A037680 1,10,102,1023,10231,102310,1023102,10231023,102310231,1023102310,
%T A037680 10231023102,102310231023,1023102310231,10231023102310,
%U A037680 102310231023102,1023102310231023,10231023102310231,102310231023102310,1023102310231023102,10231023102310231023
%N A037680 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 1,0,2,3.
%H A037680 <a href="/index/Rec#order_04">Index entries for linear recurrences with constant coefficients</a>, signature (11,-11,11,-10).
%F A037680 G.f.: x*(1-x+3*x^2) / ( (x-1)*(10*x-1)*(x^2+1) ). - _R. J. Mathar_, Aug 12 2013
%F A037680 From _Elmo R. Oliveira_, Sep 22 2026: (Start)
%F A037680 a(n) = floor(341*10^n/3333).
%F A037680 a(n) = 11*a(n-1) - 11*a(n-2) + 11*a(n-3) - 10*a(n-4). (End)
%F A037680 E.g.f.: (-101*exp(x) + 62*exp(10*x) + 39*cos(x) + 87*sin(x))/606. - _Stefano Spezia_, Sep 22 2026
%p A037680 a:= proc(n) option remember; `if`(n=0, 0,
%p A037680       a(n-1)*10+[1, 0, 2, 3][irem(n-1, 4)+1])
%p A037680     end:
%p A037680 seq(a(n), n=1..20);  # _Alois P. Heinz_, Sep 22 2026
%t A037680 Table[FromDigits[PadRight[{},n,{1,0,2,3}]],{n,20}] (* _Harvey P. Dale_, Sep 26 2021 *)
%o A037680 (PARI) Vec(x*(1-x+3*x^2)/((x-1)*(10*x-1)*(x^2+1)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037680 nonn,base,easy,changed
%O A037680 1,2
%A A037680 _Clark Kimberling_
%E A037680 More terms from _Elmo R. Oliveira_, Sep 22 2026
