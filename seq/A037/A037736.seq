%I A037736 #25 Sep 22 2026 15:46:04
%S A037736 2,21,210,2103,21032,210321,2103210,21032103,210321032,2103210321,
%T A037736 21032103210,210321032103,2103210321032,21032103210321,
%U A037736 210321032103210,2103210321032103,21032103210321032,210321032103210321,2103210321032103210,21032103210321032103,210321032103210321032
%N A037736 Decimal expansion of a(n) is given by the first n terms of the periodic sequence with initial period 2,1,0,3.
%H A037736 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (10,0,0,1,-10).
%F A037736 From _R. J. Mathar_, Oct 05 2009: (Start)
%F A037736 a(n) = 10*a(n-1) + a(n-4) - 10*a(n-5).
%F A037736 G.f: x*(2+x+3*x^3) / ((x-1)*(10*x-1)*(1+x)*(1+x^2)). (End)
%F A037736 E.g.f.: (303*exp(-x) - 1111*exp(x) + 1402*exp(10*x) - 594*cos(x) + 726*sin(x))/6666. - _Stefano Spezia_, Sep 22 2026
%p A037736 a:= proc(n) option remember; `if`(n=0, 0,
%p A037736       a(n-1)*10+[2, 1, 0, 3][irem(n-1, 4)+1])
%p A037736     end:
%p A037736 seq(a(n), n=1..21);  # _Alois P. Heinz_, Sep 22 2026
%o A037736 (PARI) Vec(x*(2+x+3*x^3)/((x-1)*(10*x-1)*(1+x)*(1+x^2)) + O(x^25)) \\ _Jinyuan Wang_, Apr 14 2020
%K A037736 nonn,base,easy,changed
%O A037736 1,1
%A A037736 _Clark Kimberling_
