%I A263830 #19 Oct 24 2026 02:27:06
%S A263830 1,5,9,23,19,53,33,93,74,119,73,255,99,213,219,363,163,482,201,581,
%T A263830 393,485,289,1085,422,663,634,1047,451,1463,513,1417,897,1103,915,
%U A263830 2374,723,1365,1227,2511,883,2661,969,2399,2078,1973,1153,4419
%N A263830 The number c_{Z^3,pi_1(B_2)}(2n) of 3-torus 2n-coverings over the second amphicosm.
%H A263830 Gheorghe Coserea, <a href="/A263830/b263830.txt">Table of n, a(n) for n = 1..20000</a>
%H A263830 G. Chelnokov, M. Deryagina, A. Mednykh, <a href="https://arxiv.org/abs/1502.01528">On the Coverings of Amphicosms; Revised title: On the coverings of Euclidian manifolds B_1 and B_2</a>, arXiv preprint arXiv:1502.01528 [math.AT], 2015.
%F A263830 From _Amiram Eldar_, Oct 24 2026: (Start)
%F A263830 a(n) = (f(n) - f(n/2) + 4*f(n/4) + A001001(n))/2, where f(k) = A007429(k) if k is an integer and 0 otherwise.
%F A263830 a(n) = (A007429(n) + A001001(n))/2 for an odd n.
%F A263830 Dirichlet g.f.: zeta(s-1) * zeta(s) * (zeta(s-2) + (1 - 1/2^s + 1/2^(2*s-2))*zeta(s)) / 2.
%F A263830 Sum_{k=1..n} a(k) ~ c * n^3, where c = Pi^2*zeta(3)/36 = 0.329550725049... . (End)
%t A263830 a[n_] := 1/2 Sum[Sum[(d^2 + 3/2 + 1/2 (-1)^Mod[d, 2] + (-1)^Mod[Quotient[n, d m], 2] + (-1)^Mod[d+Quotient[n, d m], 2])m, {m, Divisors[Quotient[n, d] ]}], {d, Divisors[n]}];
%t A263830 Array[a, 48] (* _Jean-François Alcover_, Sep 16 2018, after _Gheorghe Coserea_ *)
%t A263830 (* Alternative: *)
%t A263830 f1[p_, e_] := (p*(p^(e+1) - 1) - (e+1)*(p-1))/(p-1)^2;
%t A263830 f2[p_, e_] := Product[(p^(e+k) - 1)/(p^k - 1), {k, 1, 2}];
%t A263830 f[n_] := If[IntegerQ[n], Times @@ f1 @@@ FactorInteger[n], 0]; f[1] = 1;
%t A263830 g[n_] := Times @@ f2 @@@ FactorInteger[n]; g[1] = 1;
%t A263830 a[n_] := (f[n] - f[n/2] + 4*f[n/4] + g[n])/2; Array[a, 48] (* _Amiram Eldar_, Oct 24 2026 *)
%o A263830 (PARI)
%o A263830 a(n) = {
%o A263830   1/2 * sumdiv(n, d, sumdiv(n\d, m,
%o A263830   (sqr(d) + 3/2 + 1/2*(-1)^(d%2) + (-1)^((n\(d*m))%2) +
%o A263830   (-1)^((d + n\(d*m))%2)) * m));
%o A263830 };
%o A263830 vector(48, n, a(n))  \\ _Gheorghe Coserea_, May 05 2016
%Y A263830 Cf. A001001, A007429, A263825-A263830, A263832.
%K A263830 nonn,changed
%O A263830 1,2
%A A263830 _N. J. A. Sloane_, Oct 28 2015
%E A263830 More terms from _Gheorghe Coserea_, May 05 2016
