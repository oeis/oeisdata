%I A263160 #21 Nov 09 2026 11:10:40
%S A263160 1,1,13,5419,328504401,7622403922836151,125076804896889941384267749,
%T A263160 2283244029676857615289372083169016508547,
%U A263160 66656513992169790340795231563272399566454175106315563265,4218602489837041203989313097616905233039652652837921715487541815010092122991
%N A263160 Number of lattice paths starting at {n}^n and ending when n or any component equals 0 and using steps that decrement one or more components by one.
%H A263160 Alois P. Heinz, <a href="/A263160/b263160.txt">Table of n, a(n) for n = 0..26</a> (terms n = 11..12 from Vaclav Kotesovec)
%F A263160 a(n) = A263159(n,n).
%F A263160 For n >= 1, let F_n(k) = (Sum_{r=0..n-1} binomial(k,r))^n. Then a(n) = 1 + (2^n - 2)*Sum_{t=0..n*(n-1)} Sum_{j=0..t} (-1)^j*binomial(t,j)*F_n(t-j), with a(0) = 1. - _Vladeta Jovovic_, Nov 08 2026
%F A263160 Conjecture: Limit_{n->oo} a(n)^(1/n^2)/n = 1/log(2). - _Vaclav Kotesovec_, Nov 09 2026
%t A263160 Join[{1}, Table[1 + (2^n - 2) * Sum[Sum[(-1)^j * Binomial[t, j] * Sum[Binomial[t-j, r], {r, 0, n-1}]^n, {j, 0, t}], {t, 0, n*(n-1)}], {n, 1, 9}]] (* _Vaclav Kotesovec_, Nov 09 2026, after _Vladeta Jovovic_ *)
%Y A263160 Main diagonal of A263159.
%K A263160 nonn,changed
%O A263160 0,3
%A A263160 _Alois P. Heinz_, Oct 11 2015
