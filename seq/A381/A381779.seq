%U A381779 1912922793362142,27190770354633287,388734441118885467,5586079818959767743,80638973170989453862,1168864771263296930809
%N A381779 G.f. A(x) satisfies A(x) = (1 + x*A(x)) * C(x*A(x)^3), where C(x) is the g.f. of A000108.
%H A381779 Robert Israel, <a href="/A381779/b381779.txt">Table of n, a(n) for n = 0..838</a>
%H A381779 Robert Israel, <a href="/A381779/a381779.txt">Recurrence of order 19</a>
%F A381779 a(n) = Sum_{k=0..n} binomial(n+4*k+1,k) * binomial(n+2*k+1,n-k)/(n+4*k+1).
%F A381779 From _Robert Israel_, Sep 17 2026: (Start)
%F A381779 G.f. A(x) satisfies x*A(x)^5 + x^2*A(x)^2 - x*A(x)^2 + 2*x*A(x) - A(x) + 1 = 0.
%F A381779 D-finite with recurrence of order 19 (see link). (End)
%p A381779 with(gfun):
%p A381779 C:=  (x,y) -> 1+x*y^2-y:
%p A381779 e1:= y - (1+x*y)*z:
%p A381779 e2:= C(x*y^3,z):
%p A381779 e3:= resultant(e1,e2,z):
%p A381779 de:= algeqtodiffeq(e3,y(x)):
%p A381779 rec:= diffeqtorec(de,y(x),a(n)):
%p A381779 f:= rectoproc(rec,a(n),remember):
%p A381779 map(f, [$0..30]); # _Robert Israel_, Sep 17 2026
%o A381779 (PARI) a(n) = sum(k=0, n, binomial(n+4*k+1, k)*binomial(n+2*k+1, n-k)/(n+4*k+1));
%Y A381779 Cf. A054727, A381778.
