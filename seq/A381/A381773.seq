%U A381773 21481625997258747,357350097625089497,5978708468143961925,100537111802285439375,1698302173359384479307
%N A381773 Expansion of ( (1/x) * Series_Reversion( x/((1+x) * C(x))^3 ) )^(1/3), where C(x) is the g.f. of A000108.
%H A381773 Robert Israel, <a href="/A381773/b381773.txt">Table of n, a(n) for n = 0..792</a>
%H A381773 Robert Israel, <a href="/A381773/a381773.txt">Recurrence of order 9</a>
%F A381773 G.f. A(x) satisfies A(x) = (1 + x*A(x)^3) * C(x*A(x)^3).
%F A381773 a(n) = Sum_{k=0..n} binomial(3*n+2*k+1,k) * binomial(3*n+1,n-k)/(3*n+2*k+1).
%F A381773 From _Robert Israel_, Sep 02 2026: (Start)
%F A381773 G.f. A(x) satisfies x^2*A(x)^6 + x*A(x)^5 - A(x)^4*x + 2*x*A(x)^3 - A(x) + 1 = 0.
%F A381773 D-finite with recurrence of order 9 (see link).
%F A381773 (End)
%p A381773 with(gfun):
%p A381773 eq:= x^2*y^6 + x*y^5 - x*y^4 + 2*x*y^3 - y + 1:
%p A381773 de:= algeqtodiffeq(eq,y(x)):
%p A381773 rec:= diffeqtorec(de,y(x),a(n)):
%p A381773 f:= rectoproc(rec,a(n),remember):
%p A381773 map(f, [$0..20]); # _Robert Israel_, Sep 02 2026
%o A381773 (PARI) my(N=30, x='x+O('x^N)); Vec((serreverse(x/((1+x)*(1-sqrt(1-4*x))/(2*x))^3)/x)^(1/3))
