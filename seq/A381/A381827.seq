%S A381827 1,2,10,69,562,5042,48100,478547,4908338,51522174,550758208,
%T A381827 5974753990,65608248500,727835313461,8144965594184,91834891588099,
%U A381827 1042244963201914,11896871741939462,136493661712053752,1573151972820654218,18205626549920314728,211468167403628323318
%N A381827 G.f. A(x) satisfies A(x) = C(x) / (1 - x*A(x)^3), where C(x) is the g.f. of A000108.
%H A381827 Robert Israel, <a href="/A381827/b381827.txt">Table of n, a(n) for n = 0..912</a>
%H A381827 Robert Israel, <a href="/A381827/a381827.txt">Recurrence of order 16</a>
%F A381827 a(n) = Sum_{k=0..n} binomial(3*n-k+1,k) * binomial(4*n-4*k,n-k)/(3*n-k+1).
%F A381827 a(n) ~ 3^(6*n+3) / (sqrt(Pi*(16 + 101/sqrt(91))) * n^(3/2) * 2^(4*n+3) * (283*sqrt(91) - 2696)^(n + 1/2)). - _Vaclav Kotesovec_, Jun 06 2026
%F A381827 D-finite with a recurrence of order 16 (see link). - _Robert Israel_, Oct 23 2026
%p A381827 with(gfun):
%p A381827 e1:= -c + 1 + x*c^2:
%p A381827 e2:= -y*(1-x*y^3) + c:
%p A381827 eq:= resultant(e1,e2,c):
%p A381827 de:= algeqtodiffeq(eq,y(x)) union {D(y)(0)=2}:
%p A381827 rec:= subs(_C[0]=2,diffeqtorec(de,y(x),a(n))):
%p A381827 f:= rectoproc(rec,a(n),remember):
%p A381827 map(f, [$0..30]);
%o A381827 (PARI) a(n) = sum(k=0, n, binomial(3*n-k+1, k)*binomial(4*n-4*k, n-k)/(3*n-k+1));
%Y A381827 Cf. A014137, A129442, A381826.
%Y A381827 Cf. A000108, A381782.
%K A381827 nonn,changed
%O A381827 0,2
