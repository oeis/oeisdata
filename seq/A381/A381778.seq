%S A381778 1,2,9,60,474,4105,37681,360122,3545320,35705553,366126614,3809497971,
%T A381778 40119258081,426829897847,4580629916321,49527776299522,
%U A381778 539025763347730,5900193301962178,64913644702760248,717433047054489969,7961616716665723173,88679610762886209459
%N A381778 G.f. A(x) satisfies A(x) = (1 + x*A(x)) * C(x*A(x)^2), where C(x) is the g.f. of A000108.
%H A381778 Robert Israel, <a href="/A381778/b381778.txt">Table of n, a(n) for n = 0..928</a>
%F A381778 a(n) = Sum_{k=0..n} binomial(n+3*k+1,k) * binomial(n+k+1,n-k)/(n+3*k+1).
%F A381778 From _Robert Israel_, Sep 17 2026: (Start)
%F A381778 G.f. A(x) satisfies x*A(x)^4 + x^2*A(x)^2 - x*A(x)^2 + 2*x*A(x) - A(x) + 1 = 0.
%F A381778 D-finite with recurrence: 30*(2*n - 1)*(n + 2)*(n + 1)*a(n) - 6*(n + 2)*(204*n^2 + 743*n + 323)*a(n + 1) + 4*(2117*n^3 + 17886*n^2 + 47158*n + 37764)*a(n + 2) - 4*(5570*n^3 + 61635*n^2 + 220504*n + 253776)*a(n + 3) + 2*(374*n^3 + 19899*n^2 + 132817*n + 238890)*a(n + 4) + 3*(36675*n^3 + 510530*n^2 + 2368129*n + 3663670)*a(n + 5) - 3*(58905*n^3 + 966290*n^2 + 5260211*n + 9510618)*a(n + 6) - (78025*n^3 + 1654020*n^2 + 11611301*n + 26973966)*a(n + 7) + (52363*n^3 + 1265406*n^2 + 10178273*n + 27247158)*a(n + 8) - 2*(2027*n^3 + 53112*n^2 + 462769*n + 1340556)*a(n + 9) + 3*(n + 10)*(3*n + 29)*(3*n + 31)*a(n + 10) = 0. (End)
%p A381778 with(gfun):
%p A381778 C:=  (x,y) -> 1+x*y^2-y:
%p A381778 e1:= y - (1+x*y)*z:
%p A381778 e2:= C(x*y^2,z):
%p A381778 e3:= resultant(e1,e2,z):
%p A381778 de:= algeqtodiffeq(e3,y(x)):
%p A381778 rec:= diffeqtorec(de,y(x),a(n)):
%p A381778 f:= rectoproc(rec,a(n),remember):
%p A381778 map(f, [$0..40]); # _Robert Israel_, Sep 17 2026
%o A381778 (PARI) a(n) = sum(k=0, n, binomial(n+3*k+1, k)*binomial(n+k+1, n-k)/(n+3*k+1));
%Y A381778 Cf. A054727, A381779.
%Y A381778 Cf. A000108.
%K A381778 nonn,changed
