%U A381772 212095541328931,2531001870925559,30376237591559863,366417240105654587,4440000077166319993,54020150448778625847,659665548217188211288
%N A381772 Expansion of ( (1/x) * Series_Reversion( x/((1+x) * C(x))^2 ) )^(1/2), where C(x) is the g.f. of A000108.
%H A381772 Robert Israel, <a href="/A381772/b381772.txt">Table of n, a(n) for n = 0..895</a>
%F A381772 G.f. A(x) satisfies A(x) = (1 + x*A(x)^2) * C(x*A(x)^2).
%F A381772 a(n) = Sum_{k=0..n} binomial(2*n+2*k+1,k) * binomial(2*n+1,n-k)/(2*n+2*k+1).
%F A381772 From _Robert Israel_, Sep 02 2026: (Start)
%F A381772 G.f. A(x) satisfies x^2*A(x)^4 + x*A(x)^4 - x*A(x)^3 + 2*x*A(x)^2 - A(x) + 1 = 0.
%F A381772 D-finite with recurrence: -37500*(2*n + 3)*(2*n + 1)*(n + 1)*a(n) - 250*(2*n + 3)*(631*n^2 + 1663*n + 1108)*a(n + 1) - 5*(44203*n^3 + 285388*n^2 + 652339*n + 530010)*a(n + 2) - 15*(5043*n^3 + 55216*n^2 + 197259*n + 231210)*a(n + 3) - 3*(5711*n^3 + 70554*n^2 + 288831*n + 391384)*a(n + 4) + 54*(54*n^3 + 795*n^2 + 3902*n + 6389)*a(n + 5) - 9*(3*n + 17)*(3*n + 19)*(n + 6)*a(n + 6) = 0. (End)
%p A381772 with(gfun):
%p A381772 eq:= x^2*y^4 + x*y^4 - x*y^3 + 2*x*y^2 - y + 1:
%p A381772 de:= algeqtodiffeq(eq,y(x)):
%p A381772 rec:= diffeqtorec(de,y(x),a(n)):
%p A381772 f:= rectoproc(rec,a(n),remember):
%p A381772 map(f, [$0..21]); # _Robert Israel_, Sep 02 2026
%o A381772 (PARI) my(N=30, x='x+O('x^N)); Vec((serreverse(x/((1+x)*(1-sqrt(1-4*x))/(2*x))^2)/x)^(1/2))
