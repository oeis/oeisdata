%I A381018 #16 Nov 22 2026 22:58:51
%S A381018 1,2,3,3,3,4,5,6,6,7,7,7,7,8,9,10,10,11,12,12,13,13,13,13,13,13,13,13,
%T A381018 13,13,14,15,15,15,16,16,16,17,17,17,18,18,18,18,19,19,19,20,20,20,20,
%U A381018 20,20,20,20,20,20,20,20,20,21,21,21,22,22,22,22,22,22,23,23,23
%N A381018 a(n) is the number of primes in A000328 for r <= n.
%C A381018 Number of Gauss circle primes for r <= n.
%H A381018 G. C. Greubel, <a href="/A381018/b381018.txt">Table of n, a(n) for n = 1..10000</a>
%H A381018 Thomas Ehrenborg, <a href="https://arxiv.org/abs/2502.06804">Gauss Circle Primes</a>, arXiv:2502.06804 [math.GM], 2025. See Table 2 p. 4.
%t A381018 A000328[n_]:= A000328[n]= 1 +4*Sum[Floor[Sqrt[n^2 -k^2]], {k,0,n}];
%t A381018 A381018[n_]:= A381018[n]= Sum[If[PrimeQ[A000328[j]], 1, 0], {j,0,n}];
%t A381018 Table[A381018[n], {n,100}] (* _G. C. Greubel_, Nov 21 2026 *)
%o A381018 (PARI) a(n) = sum(k=0, n, isprime(1 + 4*sum(j=0, k^2\4, k^2\(4*j+1) - k^2\(4*j+3))));
%o A381018 (Python)
%o A381018 from math import isqrt
%o A381018 from sympy import isprime
%o A381018 def A381018(n): return sum(1 for m in range(1,n+1) if isprime(1+(sum(isqrt(k*((m<<1)-k)) for k in range(1,m+1))<<2))) # _Chai Wah Wu_, Feb 13 2025
%o A381018 (Magma)
%o A381018 m:=200;
%o A381018 A000328:= [ 1 + 4*(&+[Isqrt(j^2 -k^2): k in [0..j]]): j in [0..m]];
%o A381018 b:= func< n | IsPrime(A000328[n+1]) select 1 else 0 >;
%o A381018 A381018:= func< n | (&+[b(j): j in [0..n]]) >;
%o A381018 [A381018(n): n in [1..m]]; // _G. C. Greubel_, Nov 21 2026
%o A381018 (SageMath)
%o A381018 p=200
%o A381018 A000328 = [1 + 4*sum(isqrt(m^2-j^2) for j in range(m+1)) for m in range(p+5)]
%o A381018 def A381018(n): return sum(1 if is_prime(A000328[j]) else 0 for j in range(n+1))
%o A381018 print([A381018(n) for n in range(1,p+1)]) # _G. C. Greubel_, Nov 21 2026
%Y A381018 Cf. A000328, A000720, A381017, A381020.
%K A381018 nonn,changed
