%I A378916 #44 Oct 22 2026 23:39:14
%S A378916 1,2,7,12,21,24,30,70,42,45,57,60,75,84,90,117,126,156,105,135,150,
%T A378916 189,180,165,234,288,303,195,231,240,210,285,255,396,378,438,357,444,
%U A378916 345,360,315,330,603,390,480,435,462,450,546,609,627,420,663,540,555,615
%N A378916 a(n) is the smallest positive integer having n decompositions of twice its value into sums of two noncomposite numbers.
%C A378916 a(n) is the index of first n in A001031.
%H A378916 Robert Israel, <a href="/A378916/b378916.txt">Table of n, a(n) for n = 1..3600</a> (a(1..200) from David Consiglio, Jr.)
%H A378916 David Consiglio, Jr., <a href="/A378916/a378916.py.txt">Python</a>
%e A378916 For n = 3 we have that the first 3 in A001031 has index 7 and twice 7 is 14 and 14 has 3 decompositions into sums of two noncomposite numbers as follows: [1 + 13], [3 + 11], [7 + 7], so a(3) = 7.
%p A378916 N:= 5000:
%p A378916 P:= [1, op(select(isprime, [seq(i,i=3..N,2)]))]:
%p A378916 nP:= nops(P):
%p A378916 V:= Vector(N/2):
%p A378916 for i from 1 to nP do for j from 1 to i do
%p A378916   k:= (P[i]+P[j])/2;
%p A378916   if k <= N/2 then V[k]:= V[k]+1 fi
%p A378916 od od:
%p A378916 A:= 'A': A[2]:= 2:
%p A378916 for i from 1 to N/2 do
%p A378916   if not assigned(A[V[i]]) then A[V[i]]:= i fi
%p A378916 od:
%p A378916 Aind:=map(op,{indices(A)}):
%p A378916 seq(A[i],i=1 .. min({$1..max(Aind)} minus Aind)-1); # _Robert Israel_, Oct 21 2026
%Y A378916 Cf. A001031, A008578, A378917.
%K A378916 nonn,changed
%O A378916 1,2
