%U A378851 1321,1433,1439,1447,1481,1483,1499,1667,1693,1709,1747,1867,1877,1931,1933,2063
%N A378851 Primes p dividing the reduced denominator of g(p), where g(n) is Goebel's sequence.
%C A378851 Here g(0)=1, g(1)=2 and (n+1)*g(n+1)=g(n)*(n+g(n)) for n>=1. - _Eric W. Weisstein_, Oct 06 2026
%C A378851 Equivalently, compute s(1)=2 and s(k+1)=s(k)+(s(k)/k)^2 modulo p for 1 <= k < p and require s(p) != 0. - _Eric W. Weisstein_, Oct 06 2026
%H A378851 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/GoebelsSequence.html">Göbel's Sequence</a>.
%t A378851 Select[Prime[Range[100]], Function[p, Fold[Mod[#1 + #1^2 PowerMod[#2, -2, p], p] &, 2, Range[p - 1]] != 0]] (* _Eric W. Weisstein_, Oct 06 2026 *)
