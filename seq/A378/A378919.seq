%S A378919 1,1,5,39,355,3532,37206,407861,4604493,53169811,625067441,7456004083,
%T A378919 90015754691,1097834790182,13505674728174,167395320811562,
%U A378919 2088350145491232,26203315734195937,330460721192844017,4186559092558049570,53255890990455126082,679954025388880445771
%N A378919 G.f. A(x) satisfies A(x) = 1 + x*A(x)^6/(1 + x*A(x)).
%H A378919 Robert Israel, <a href="/A378919/b378919.txt">Table of n, a(n) for n = 0..880</a>
%H A378919 Robert Israel, <a href="/A378919/a378919.txt">Recurrence of order 16</a>
%F A378919 G.f. A(x) satisfies A(x) = 1/(1 - x*A(x)^5/(1 + x*A(x))).
%F A378919 If g.f. satisfies A(x) = ( 1 + x*A(x)^(t/r) * (1 + x*A(x)^(u/r))^s )^r, then a(n) = r * Sum_{k=0..n} binomial(t*k+u*(n-k)+r,k) * binomial(s*k,n-k)/(t*k+u*(n-k)+r).
%F A378919 D-finite with recurrence of order 16 (see link). - _Robert Israel_, Oct 21 2026
%p A378919 with(gfun):
%p A378919 eq:= (1-y)*(1+x*y) + x*y^6:
%p A378919 de:= algeqtodiffeq(eq,y(x)):
%p A378919 rec:= diffeqtorec(de,y(x),a(n)):
%p A378919 f:= rectoproc(rec,a(n),remember):
%p A378919 map(f, [$0..30]); # _Robert Israel_, Oct 21 2026
%o A378919 (PARI) a(n, r=1, s=-1, t=6, u=1) = r*sum(k=0, n, binomial(t*k+u*(n-k)+r, k)*binomial(s*k, n-k)/(t*k+u*(n-k)+r));
