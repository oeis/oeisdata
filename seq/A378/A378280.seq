%U A378280 2574351155329920,48782895470336256,1016531798366151120,21390736685126714640,490035720832463861440,10832078369172674620160
%N A378280 Number of subgroups of S_n isomorphic to S_4, where S_n is the n-th symmetric group.
%H A378280 Alois P. Heinz, <a href="/A378280/b378280.txt">Table of n, a(n) for n = 0..462</a>
%F A378280 E.g.f.: (exp(x + x^2/2 + x^3 + x^4 + 7*x^6/6 + x^8/2 + 3*x^12/4 + x^24/24) - exp(x + x^2/2 + x^3 + x^6/6))/24. - _Vladeta Jovovic_, Nov 10 2026
%o A378280 (GAP) A378280 := function(n)
%o A378280 local S;
%o A378280 S := SymmetricGroup(n);
%o A378280 return Sum(IsomorphicSubgroups(S, SymmetricGroup(4)), x->Index(S, Normalizer(S, Image(x))));
%o A378280 end; # See A378163
%Y A378280 Column k=4 of A378163.
%Y A378280 Cf. A000085, A378279, A378281.
%K A378280 nonn,changed
