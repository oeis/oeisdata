%U A378281 4248100355879808,115411773579143424,3053064747111373008,78827475839867891136,1652749712782880810560,32316986378867228822784
%N A378281 Number of subgroups of S_n isomorphic to S_5, where S_n is the n-th symmetric group.
%H A378281 Alois P. Heinz, <a href="/A378281/b378281.txt">Table of n, a(n) for n = 0..459</a>
%F A378281 E.g.f.: (exp(x + x^2/2 + x^5 + x^6 + 3*x^10/2 + x^12/2 + x^15) - exp(x + x^2/2))/120. - _Vladeta Jovovic_, Nov 10 2026
%o A378281 (GAP) A378281 := function(n)
%o A378281 local S;
%o A378281 S := SymmetricGroup(n);
%o A378281 return Sum(IsomorphicSubgroups(S, SymmetricGroup(5)), x->Index(S, Normalizer(S, Image(x))));
%o A378281 end;
