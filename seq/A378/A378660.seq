%N A378660 Smallest divisor d of n for which n/d is non-abundant, i.e. sigma(n/d) <= 2*(n/d).
%H A378660 Antti Karttunen, <a href="/A378660/b378660.txt">Table of n, a(n) for n = 1..100000</a>
%F A378660 a(n) = n / A378665(n).
%F A378660 a(n) = A020639(n) if n is primitive abundant number (A091191). - _Amiram Eldar_, Oct 13 2026
%t A378660 a[n_] := Min[Select[Divisors[n], DivisorSigma[-1, n/#] <= 2 &]]; Array[a, 105] (* _Amiram Eldar_, Oct 13 2026 *)
%o A378660 (PARI)
%o A378660 A294935(n) = (sigma(n)<=(2*n));
%o A378660 A378660(n) = { fordiv(n,d,if(A294935(n/d), return(d))); (n); };
%Y A378660 Cf. A000203, A020639, A091191, A263837, A294935, A378665.
%K A378660 nonn,changed
%O A378660 1,12
