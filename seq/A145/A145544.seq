%N A145544 a(n) = 4*(4^n-3^n).
%C A145544 Suggested by a discussion on the Sequence Fans Mailing List; the formula is due to Jaume Oliver Lafont.
%H A145544 Paolo Xausa, <a href="/A145544/b145544.txt">Table of n, a(n) for n = 0..1000</a>
%H A145544 <a href="/index/Rec#order_02">Index entries for linear recurrences with constant coefficients</a>, signature (7,-12)
%F A145544 From _R. J. Mathar_, Mar 18 2009: (Start)
%F A145544 a(n) = 4*A005061(n) = 7*a(n-1)-12*a(n-2).
%F A145544 G.f.: 4*x/((4*x-1)*(3*x-1)). (End)
%t A145544 A145544[n_] := 4*(4^n - 3^n); Array[A145544, 30, 0] (* _Paolo Xausa_, Oct 25 2026 *)
