%S A144135 1,32,766,16288,324611,6209728,115482108,2103688896,37722047493,
%T A144135 668043002336,11712290384122,203643199520096,3516151119566855,
%U A144135 60351015599244160,1030570380421823480,17520003341519977344
%N A144135 a(n) = GegenbauerC[n,2,8].
%H A144135 Robert Israel, <a href="/A144135/b144135.txt">Table of n, a(n) for n = 0..825</a>
%H A144135 Wikipedia, <a href="https://en.wikipedia.org/wiki/Gegenbauer_polynomials">Gegenbauer Polynomials</a>
%F A144135 Conjecture: a(n) = 32*a(n-1)-258*a(n-2)+32*a(n-3)-a(n-4). - _Colin Barker_, Oct 27 2014
%F A144135 Empirical g.f.: x / (x^2-16*x+1)^2. - _Colin Barker_, Oct 27 2014
%F A144135 Conjecture and empirical g.f. verified. - _Robert Israel_, Jul 26 2026
%p A144135 f:= gfun:-rectoproc({a(0) = 1, a(1) = 32, a(n) = 16*(n + 1)*a(n - 1)/n - (n + 2)*a(n - 2)/n},a(n),remember):
%p A144135 map(f, [$0..50]); # _Robert Israel_, Jul 26 2026
%t A144135 lst={};Do[AppendTo[lst,GegenbauerC[n,2,8]],{n,0,5^2}];lst
%K A144135 nonn,changed
%O A144135 0,2
