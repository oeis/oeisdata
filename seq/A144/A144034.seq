%N A144034 Eigentriangle read by rows, T(n,k) = A123932(n-k)*A046717(k-1), 1 <= k <= n.
%C A144034 Row sums = A046717 shifted: (1, 5, 13, 41, 121,...). Right border = A046717.
%C A144034 Sum of n-th row terms = rightmost term of (n+1)-th row.
%F A144034 Eigentriangle read by rows, T(n,k) = A123932(n-k)*A046717(k-1), 1 <= k <= n
%e A144034 First few rows of the triangle =
%e A144034   1;
%e A144034   4, 1;
%e A144034   4, 4, 5;
%e A144034   4, 4, 20, 13;
%e A144034   4, 4, 20, 52, 41;
%e A144034   4, 4, 20, 52, 164, 121;
%e A144034   4, 4, 20, 52, 164, 484, 365;
%e A144034   ...
%e A144034 Row 4 = (4, 4, 20, 13) = termwise products (4, 4, 4, 1) and (1, 1, 5, 13).
%o A144034 (PARI) T(n, k) = if(n > k, 4, 1)*(3^(k-1) + (-1)^(k-1))/2; \\ A123932(n-k)*A046717(k-1)
%o A144034 for(n=1, 10, for(k=1, n, print1(T(n, k), ", "))) \\ _Alper Ferudun_, Oct 17 2026
