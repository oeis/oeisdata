%S A144024 1,0,1,1,0,1,1,1,0,2,0,1,1,0,4,1,0,1,2,0,6,0,1,0,2,4,0,10,1,0,1,0,4,6,
%T A144024 0,17,1,1,0,2,0,6,10,0,29,0,1,1,0,4,0,10,17,0,49,1,0,1,2,0,6,0,17,29,
%U A144024 0,82,1,1,0,2,4,0,10,0,29,49,0,138,0,1,1,0,4,6,0,17,0,49,82,0,234
%N A144024 Eigentriangle by rows, T(n,k) = A005614(n-k)*b(k-1), where b(0)=1 and b(j)=A144023(j) for j >= 1.
%C A144024 Row sums = A144023, the INVERT transform of the rabbit sequence, A005614.
%C A144024 Left border = A005614.
%C A144024 Sum of n-th row terms = rightmost term of next row.
%F A144024 Eigentriangle by rows, T(n,k) = A005614(n-k)*b(k-1), where b(0)=1 and b(j)=A144023(j) for j >= 1. [Corrected by _Alper Ferudun_, Oct 17 2026]
%F A144024 A005614 = the rabbit sequence, (1, 0, 1, 1, 0, 1, 0, 1,...)
%F A144024 b(k-1) runs through (1, 1, 1, 2, 4, 6, 10, 17, 29,...), obtained by prepending 1 to A144023. [Corrected by _Alper Ferudun_, Oct 17 2026]
%e A144024 First few rows of the triangle =
%e A144024   1;
%e A144024   0, 1;
%e A144024   1, 0, 1;
%e A144024   1, 1, 0, 2;
%e A144024   0, 1, 1, 0, 4;
%e A144024   1, 0, 1, 2, 0, 6;
%e A144024   0, 1, 0, 2, 4, 0, 10;
%e A144024   1, 0, 1, 0, 4, 6, 0, 17;
%e A144024   1, 1, 0, 2, 0, 6, 10, 0, 29;
%e A144024   ...;
%e A144024 Row 4 = (1, 1, 0, 2) = termwise product of (1, 1, 0, 1) and (1, 1, 1, 2); where (1, 1, 0, 1) = the first 4 terms of A005614 reversed. (1, 1, 1, 2) = the first 4 terms of shifted A144023.
%o A144024 (PARI) A005614(n) = (sqrtint(5*(n+2)^2) - n - 2)\2 - (sqrtint(5*(n+1)^2) - n - 1)\2;
%o A144024 b(n) = polcoeff(1/(1 - sum(j=1, n, A005614(j-1)*x^j) + O(x^(n+1))), n); \\ b(0) = 1, b(n) = A144023(n)
%o A144024 T(n, k) = A005614(n-k)*b(k-1);
%o A144024 for(n=1, 13, for(k=1, n, print1(T(n, k), ", "))) \\ _Alper Ferudun_, Oct 17 2026
%Y A144024 Cf. A005614, A144023.
