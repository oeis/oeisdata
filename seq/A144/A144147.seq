%I A144147 #10 Sep 24 2026 04:55:07
%S A144147 2,3,5,6,7,10,11,13,14,17,19,22,23,26,29,30,31,34,37,38,40,41,42,43,
%T A144147 45,46,47,53,56,58,59,61,62,63,66,67,71,73,74,75,78,79,82,83,86,88,89,
%U A144147 94,96,97,99,101,102,103,104,105,106,107,109,113,114,117,118,122,127,131
%N A144147 A positive integer k is included if every exponent in the prime factorization of k is coprime to k and if the sum of these prime-factorization exponents divides k.
%C A144147 All primes are included in the sequence. Any integer = 2*(odd prime) is included in the sequence. This sequence contains those terms in both sequence A074946 and sequence A144146.
%H A144147 Amiram Eldar, <a href="/A144147/b144147.txt">Table of n, a(n) for n = 1..10000</a>
%e A144147 40 has the prime factorization 2^3 * 5^1. The exponents are therefore 3 and 1. Both 3 and 1 are coprime to 40. And 3+1 = 4 divides 40. So, 40 is included in the sequence.
%t A144147 q[k_] := k > 1 && Module[{e = FactorInteger[k][[;;, 2]]}, AllTrue[e, CoprimeQ[k, #] &] && Divisible[k, Total[e]]]; Select[Range[131], q] (* _Amiram Eldar_, Sep 24 2026 *)
%o A144147 (PARI) isok(k) = if(k == 1, 0, my(e = factor(k)[, 2]); for(i = 1, #e, if(gcd(e[i], k) > 1, return(0))); !(k % vecsum(e))); \\ _Amiram Eldar_, Sep 24 2026
%Y A144147 Intersection of A074946 and A144146.
%K A144147 nonn,changed
%O A144147 1,1
