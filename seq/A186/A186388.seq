%I A186388 #17 Sep 10 2026 23:32:37
%S A186388 1,2,4,5,7,9,11,14,16,19,22,25,28,31,35,38,42,46,50,55,59,64,69,74,79,
%T A186388 84,90,95,101,107,113,120,126,133,140,147,154,161,169,176,184,192,200,
%U A186388 209,217,226,235,244,253,262,272,281,291,301,311,322,332,343,354,365,376,387,399,410,422,434,446,459,471,484,497,510,523,536,550,563,577,591,605,620,634,649,664,679,694,709,725,740,756,772,788,805,821
%N A186388 Adjusted joint rank sequence of (f(i)) and (g(j)) with f(i) before g(j) when f(i)=g(j), where f(i)=6*i and g(j)=j*(j+1)/2 (triangular number). Complement of A186387.
%C A186388 Both conjectures from _Chai Wah Wu_ hold. Proof: Let T_n = n*(n+1)/2. In the joint ranking, there are n triangular numbers up to T_n. Since multiples of 6 are ranked before T_n in case of equality, the number of positive multiples of 6 counted up to T_n is floor(T_n/6). Hence a(n) = n + floor(T_n/6) = n + floor(n*(n+1)/12). Checking the residue classes of n modulo 12 shows that this formula gives the conjectured generating function; multiplying that generating function by its denominator gives the stated recurrence. - _Kaiming Sun_, Sep 03 2026
%F A186388 Conjectures from _Chai Wah Wu_, May 12 2026: (Start)
%F A186388 a(n) = 2*a(n-1) - a(n-2) + a(n-3) - 2*a(n-4) + a(n-5) - a(n-6) + 2*a(n-7) - a(n-8) + a(n-9) - 2*a(n-10) + a(n-11) for n > 11.
%F A186388 G.f.: x*(x^9 - 2*x^6 + x^5 - x^4 + 2*x^3 - x^2 - 1)/((x - 1)^3*(x^2 + 1)*(x^2 + x + 1)*(x^4 - x^2 + 1)). (End)
%F A186388 a(n) = n + floor(n*(n+1)/12) for n >= 1. - _Kaiming Sun_, Sep 03 2026
%e A186388 First, write
%e A186388 ......6.....12..18....24..30. (6i)
%e A186388 1..3..6..10...15....21..28... (triangular)
%e A186388 Then replace each number by its rank, where ties are settled by ranking 6i before the triangular:
%e A186388 a=(3,6,8,10,12,13,15,17,...)=A186387
%e A186388 b=(1,2,4,5,7,9,11,14,16,...)=A186388.
%t A186388 (* See A186387 *)
%t A186388 d=1/2; u=6; v=0; x=1/2; y=1/2; (* 6i and triangular *)
%t A186388 h[n_]:=(-y+(4x(u*n+v-d)+y^2)^(1/2))/(2x);
%t A186388 a[n_]:=n+Floor[h[n]]; (* rank of u*n+v *)
%t A186388 k[n_]:=(x*n^2+y*n-v+d)/u;
%t A186388 b[n_]:=n+Floor[k[n]]; (* rank of x*n^2+y*n+d *)
%t A186388 Table[b[n], {n, 1, 100}]  (* A186388 *)
%Y A186388 Cf. A186350, A186387, A186389, A186390.
%K A186388 nonn,easy,changed
%O A186388 1,2
