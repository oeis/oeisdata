%I A224383 #14 Nov 03 2026 00:31:54
%S A224383 11,19,59,67,131,227,251,499,1019,1987,4091,4099,8179,32707,32771,
%T A224383 57347,65027,65539,114691,130051,131011,131059,262139,262147,507907,
%U A224383 1040387,1048571,2097091,4161539,8372227,8388547,14680067,16744451,33538051,33554371,67108739,67108859,133955587
%N A224383 Primes of the form (2^n - 1)*(2^(m+2)) + 3 where n >= 1, m >= 1.
%C A224383 These are the primes arising in A224380.
%H A224383 Robert Israel, <a href="/A224383/b224383.txt">Table of n, a(n) for n = 1..2500</a>
%p A224383 N:= 10^9: # for terms <= N
%p A224383 R:= NULL:
%p A224383 for k from 4 while 2^k <= 2*N do
%p A224383   for n from 1 to k-3 do
%p A224383     v:= (2^n-1)*2^(k-n) +3;
%p A224383     if v > N then break fi;
%p A224383     if isprime(v) then R:= R,v fi
%p A224383 od od:
%p A224383 R; # _Robert Israel_, Nov 02 2026
%Y A224383 Cf. A224380.
%K A224383 nonn,changed
%O A224383 1,1
%A A224383 _Brad Clardy_, Apr 05 2013
