%I A141238 #15 Aug 13 2026 13:03:31
%S A141238 2,1,2,37,16,181,220,273,959,1151,4270,3673,9421
%N A141238 Sequence of k such that starting with P(0)=23 then k(n)*P(n-1)*(k(n)*P(n-1)-1)-1 is the least prime = P(n).
%e A141238 1*23*(1*23-1)-1=505 composite,
%e A141238 2*23*(2*23-1)-1=2069 prime so k(1)=2 and P(1)=2069.
%o A141238 (PARI) P=23;for(i=1,20,k=0;while(!ispseudoprime(t=k++*P*(k*P-1)-1),);P=t;print1(k", ")) \\ _Charles R Greathouse IV_, Dec 27 2011
%o A141238 (Python)
%o A141238 from gmpy2 import is_prime
%o A141238 from itertools import count
%o A141238 P = 23
%o A141238 for n in range(1, 10):
%o A141238     for k in count(1):
%o A141238         if is_prime(k*P*(k*P-1)-1):
%o A141238             break
%o A141238     print(k, end=", ")
%o A141238     P = k*P*(k*P-1)-1
%o A141238 # _Michael S. Branicky_, Aug 13 2026
