%I A141236 #18 Aug 12 2026 10:42:04
%S A141236 1,2,22,9,12,140,76,1376,49,1030,4771,6409,6209
%N A141236 Sequence of k such that starting with P(0)=17 then k(n)*P(n-1)*(k(n)*P(n-1)-1)-1 is the least prime = P(n).
%e A141236 1*17*(1*17-1)-1=271 prime so k(1)=1 and P(1)=271.
%o A141236 (PARI) P=17;for(i=1,20,k=0;while(!ispseudoprime(t=k++*P*(k*P-1)-1),);P=t;print1(k", ")) \\ _Charles R Greathouse IV_, Dec 27 2011
%o A141236 (Python)
%o A141236 from gmpy2 import is_prime
%o A141236 from itertools import count
%o A141236 P = 17
%o A141236 for n in range(1, 11):
%o A141236     for k in count(1):
%o A141236         if is_prime(k*P*(k*P-1)-1):
%o A141236             break
%o A141236     print(k, end=", ")
%o A141236     P = k*P*(k*P-1)-1
%o A141236 # _Michael S. Branicky_, Aug 12 2026
