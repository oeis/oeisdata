%I A141237 #12 Aug 12 2026 10:40:18
%S A141237 3,1,9,14,123,39,39,549,96,701,2691,7028,4996
%N A141237 Sequence of k such that starting with P(0)=19 then k(n)*P(n-1)*(k(n)*P(n-1)-1)-1 is the least prime = P(n).
%e A141237 1*19*(1*19-1)-1=341 composite,
%e A141237 2*19*(2*19-1)-1=1405 composite,
%e A141237 3*19*(3*19-1)-1=3191 prime so k(1)=3 and P(1)=3191.
%o A141237 (PARI) P=19;for(i=1,20,k=0;while(!ispseudoprime(t=k++*P*(k*P-1)-1),);P=t;print1(k", ")) \\ _Charles R Greathouse IV_, Dec 27 2011
%o A141237 (Python)
%o A141237 from gmpy2 import is_prime
%o A141237 from itertools import count
%o A141237 P = 19
%o A141237 for n in range(1, 11):
%o A141237     for k in count(1):
%o A141237         if is_prime(k*P*(k*P-1)-1):
%o A141237             break
%o A141237     print(k, end=", ")
%o A141237     P = k*P*(k*P-1)-1
%o A141237 # _Michael S. Branicky_, Aug 12 2026
