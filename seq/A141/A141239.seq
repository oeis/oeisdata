%I A141239 #16 Aug 13 2026 13:04:02
%S A141239 1,2,16,3,9,11,136,219,51,1428,1794,151,6673
%N A141239 Sequence of k such that starting with P(0) = 29 then k(n)*P(n-1)*(k(n)*P(n-1)-1)-1 is the least prime = P(n).
%e A141239 1*29*(1*29-1)-1 = 811 (prime) so k(1) = 1, P(1) = 811.
%o A141239 (PARI) P=29;for(i=1,20,k=0;while(!ispseudoprime(t=k++*P*(k*P-1)-1),);P=t;print1(k", ")) \\ _Charles R Greathouse IV_, Dec 27 2011
%o A141239 (Python)
%o A141239 from gmpy2 import is_prime
%o A141239 from itertools import count
%o A141239 P = 29
%o A141239 for n in range(1, 10):
%o A141239     for k in count(1):
%o A141239         if is_prime(k*P*(k*P-1)-1):
%o A141239             break
%o A141239     print(k, end=", ")
%o A141239     P = k*P*(k*P-1)-1
%o A141239 # _Michael S. Branicky_, Aug 12 2026
