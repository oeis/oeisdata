%N A137147 Numbers k such that k and k^2 use only the digits 5, 6, 7, 8 and 9.
%C A137147 Generated with DrScheme.
%H A137147 Jonathan Wellons, <a href="/A137147/b137147.txt">Table of n, a(n) for n = 1..183</a>
%H A137147 Jonathan Wellons, <a href="https://web.archive.org/web/20090206165028/http://jonathanwellons.com/shared-digits/">Tables of Shared Digits</a>. [archived]
%H A137147 <a href="/index/Sq#squares">OEIS Index to sequences related to squares</a>.
%e A137147 989878759589576^2 = 979859958686597599779967859776.
%o A137147 (Python)
%o A137147 from itertools import count, islice
%o A137147 from sympy import integer_log
%o A137147 def A137147_gen(): # generator of terms
%o A137147     for n in count(1):
%o A137147         m = integer_log(k:=(n<<2)+1,5)[0]
%o A137147         k = sum((5+(k-5**m)//(5**j<<2)%5)*10**j for j in range(m))
%o A137147         if k%10<8 and min(str(k**2))>'4':
%o A137147             yield k
%o A137147 A137147_list = list(islice(A137147_gen(),30)) # _Chai Wah Wu_, Oct 13 2026
%Y A137147 Cf. A136808, A136809, ..., A137146 for other digit combinations.
