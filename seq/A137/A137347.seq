%N A137347 Triangle of polynomial coefficients read by rows where P(-1,x)=0, P(0,x)=1, P(1,x)=x-1, and P(n,x) = x*P(n-1,x) - 2*x^2*P(n-2,x) + x^3*P(n-3,x).
%e A137347 Triangle begins:
%e A137347   {1},
%e A137347   {-1, 1},
%e A137347   {0, -1, -1},
%e A137347   {0, 0, 1, -2},
%e A137347   {0, 0, 0, 2, 1},
%e A137347   {0, 0, 0, 0, -1, 4},
%e A137347   {0, 0, 0, 0, 0, -4},
%e A137347   {0, 0, 0, 0, 0, 0, 0, -7},
%e A137347   {0, 0, 0, 0, 0, 0, 0, 7, -3},
%e A137347   ...
%t A137347 p[x, -1] = 0; p[x, 0] = 1; p[x, 1] = x - 1;
%t A137347 p[x_, n_] := p[x, n] = x*p[x, n - 1] - 2*x^2*p[x, n - 2] + x^3*p[x, n - 3];
%t A137347 g = Table[ExpandAll[p[x, n]], {n, 0, 15}];
%t A137347 a = Table[CoefficientList[p[x, n], x], {n, 0, 15}];
%t A137347 Flatten[a]
%K A137347 tabf,sign,less,dumb,changed
%O A137347 1,10
%A A137347 _Roger L. Bagula_, Apr 08 2008
