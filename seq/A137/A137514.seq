%N A137514 Triangle of coefficients of row polynomials with e.g.f. p(x,t) = exp(x*t)*(1 - 6*t + 9*t^2 - 4*t^3 + t^4)/(4*t - 1)/(2*t - 1).
%F A137514 p(x,t) = exp(x*t)*(1 - 6*t + 9*t^2 - 4*t^3 + t^4)/(4*t - 1)/(2*t - 1) = Sum_{n>=0, m=0..n} T(n,m)*x^m*t^n/n!.
%e A137514 Triangle begins:
%e A137514   {1},
%e A137514   {0, 1},
%e A137514   {2, 0, 1},
%e A137514   {12, 6, 0, 1},
%e A137514   {120, 48, 12, 0, 1},
%e A137514   {1680, 600, 120, 20, 0, 1},
%e A137514   {31680, 10080, 1800, 240, 30, 0, 1},
%e A137514   {766080, 221760, 35280, 4200, 420, 42, 0, 1},
%e A137514   {22579200, 6128640, 887040, 94080, 8400, 672, 56, 0, 1},
%e A137514   {778014720, 203212800, 27578880, 2661120, 211680, 15120, 1008, 72, 0, 1},
%e A137514   ...
%t A137514 p = Exp[x*t]*(1 - 6*t + 9*t^2 - 4*t^3 + t^4)/(4*t - 1)/(2*t - 1);
%t A137514 a = Table[ CoefficientList[n!*SeriesCoefficient[ FullSimplify[Series[p, {t, 0, 30}]], n], x], {n, 0, 10}]; Flatten[a]
