%I A303664 #17 Nov 17 2026 19:49:04
%S A303664 1,2,3,6,9,14,25,38,57,84,141,206,307,440,633,984,1419,2036,2887,4064,
%T A303664 5619,8370,11667,16424,22717,31478,42783,58386,82701,113162,155029,
%U A303664 210770,285645,383688,514497,682922,940327,1256300,1687365,2245692,2997183,3955448,5233315,6854588,8978175,11998806
%N A303664 Expansion of (1/(1 - x))*Sum_{k>=0} k!*x^(k*(k+1)/2)/Product_{j=1..k} (1 - x^j).
%C A303664 Partial sums of A032020.
%H A303664 Vaclav Kotesovec, <a href="/A303664/b303664.txt">Table of n, a(n) for n = 0..10000</a>
%H A303664 <a href="/index/Com#comp">Index entries for sequences related to compositions</a>
%e A303664 From _Gus Wiseman_, Nov 17 2026: (Start)
%e A303664 Also the number of subsets of {1..n} whose 0-prepended first differences are all distinct. For example, {1,4,6} is counted under a(6) because its 0-prepended first differences (1,3,2) are all distinct. The a(0) = 1 through a(6) = 25 subsets are:
%e A303664   {}  {}   {}   {}     {}     {}     {}
%e A303664       {1}  {1}  {1}    {1}    {1}    {1}
%e A303664            {2}  {2}    {2}    {2}    {2}
%e A303664                 {3}    {3}    {3}    {3}
%e A303664                 {1,3}  {4}    {4}    {4}
%e A303664                 {2,3}  {1,3}  {5}    {5}
%e A303664                        {1,4}  {1,3}  {6}
%e A303664                        {2,3}  {1,4}  {1,3}
%e A303664                        {3,4}  {1,5}  {1,4}
%e A303664                               {2,3}  {1,5}
%e A303664                               {2,5}  {1,6}
%e A303664                               {3,4}  {2,3}
%e A303664                               {3,5}  {2,5}
%e A303664                               {4,5}  {2,6}
%e A303664                                      {3,4}
%e A303664                                      {3,5}
%e A303664                                      {4,5}
%e A303664                                      {4,6}
%e A303664                                      {5,6}
%e A303664                                      {1,3,6}
%e A303664                                      {1,4,6}
%e A303664                                      {2,3,6}
%e A303664                                      {2,5,6}
%e A303664                                      {3,4,6}
%e A303664                                      {3,5,6}
%e A303664 (End)
%p A303664 T:= proc(n, k) option remember; `if`(k<0 or n<0, 0,
%p A303664       `if`(k=0, `if`(n=0, 1, 0), T(n-k, k) +k*T(n-k, k-1)))
%p A303664     end:
%p A303664 b:= n-> add(T(n, k), k=0..floor((sqrt(8*n+1)-1)/2)):
%p A303664 a:= proc(n) option remember;
%p A303664       `if`(n<0, 0, b(n)+a(n-1))
%p A303664     end:
%p A303664 seq(a(n), n=0..50);  # _Alois P. Heinz_, Apr 28 2018
%t A303664 nmax = 45; CoefficientList[Series[1/(1 - x) Sum[k! x^(k (k + 1)/2)/Product[1 - x^j, {j, 1, k}], {k, 0, nmax}], {x, 0, nmax}], x]
%t A303664 (* Alternative: *)
%t A303664 Table[Length[Select[Subsets[Range[n]],UnsameQ@@Differences[Prepend[#,0]]&]],{n,0,15}] (* _Gus Wiseman_, Nov 17 2026 *)
%Y A303664 Cf. A000079, A032020, A036469.
%Y A303664 For partitions instead of subsets we have A325325, strict A320347.
%Y A303664 The non 0-prepended version is A364465 (not A303665).
%Y A303664 A007318 counts subsets by length.
%Y A303664 A053632 counts subsets by sum.
%Y A303664 A364463 counts subsets disjoint from differences, complement A364466.
%Y A303664 Cf. A000009, A008289, A011782, A072574, A196723, A275972, A325864, A325878, A326083, A363260.
%K A303664 nonn,changed
%O A303664 0,2
%A A303664 _Ilya Gutkovskiy_, Apr 28 2018
