%p A303380 Alph:= [$"a".."z"]:
%p A303380 for i from 1 to 26 do J[Alph[i]]:= i od:
%p A303380 g:= proc(n) option remember; local c,V;
%p A303380   V:= Vector(26,datatype=integer[4]);
%p A303380   for c in StringTools:-Explode(convert(n,english)) do
%p A303380    if StringTools:-IsAlpha(c) then V[J[c]]:= V[J[c]]+1 fi
%p A303380   od;
%p A303380   V;
%p A303380 end proc:
%p A303380 succ:= proc(n) option remember; local r,k,s;
%p A303380   r:= g(n);
%p A303380   for k from n+1 do
%p A303380    s:= g(k);
%p A303380    if andmap(i -> s[i]>=r[i],[$1..26]) then return k fi
%p A303380   od
%p A303380 end proc:
%p A303380 N:= 35:
%p A303380 A:= Matrix(N,N):
%p A303380 for n from 1 to N do
%p A303380   A[n,1]:= n;
%p A303380   for k from 2 to N+1-n do
%p A303380     A[n,k]:= succ(A[n,k-1])
%p A303380   od;
%p A303380 od:
%p A303380 seq(seq(A[k,j-k],k=1 .. j-1),j=2..N+1); # _Robert Israel_, Aug 11 2026
%o A303380 (PARI) T(n, k) = if (k == 1, n, a303475(T(n, k-1)));
%o A303380 tabl(nn) = for (n=1, nn, for (k=1, nn, print1(T(n,k), ", ")); print); \\ _Michel Marcus_, Apr 24 2018
