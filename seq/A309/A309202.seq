%U A309202 0,1,176,1,1830,1,0,15,0,1,200,23,36,1,0,1,2628,37,24,1,66,1,236,27,0,1,0,55,0,43
%N A309202 Peter Munn showed in A111273 that if A111273(n)=m then if m is odd, n <= m, and if m is even, n <= 2*m-1; a(n) is either m-n or 2*m-1-n in the two cases.
%C A309202 It is known that if p is an odd prime, a(p-1) = 1 (see A111273).
%H A309202 Robert Israel, <a href="/A309202/b309202.txt">Table of n, a(n) for n = 1..10000</a>
%p A309202 S:= {}: R:= NULL:
%p A309202 for n from 1 to 100 do
%p A309202   m:= min(numtheory:-divisors(n*(n+1)/2) minus S);
%p A309202   S:= S union {m};
%p A309202   if m::odd then R:= R,m-n else R:= R, 2*m-1-n fi
%p A309202 od:
%p A309202 R; # _Robert Israel_, Nov 10 2026
%Y A309202 Cf. A111273.
%K A309202 nonn,look,changed
%O A309202 1,5
%A A309202 _N. J. A. Sloane_, Jul 26 2019
