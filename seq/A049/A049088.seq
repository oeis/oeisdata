%I A049088 #20 Nov 07 2026 08:05:43
%S A049088 1,3,26,451,12951,551681,32512618,2525962461,249675308081,
%T A049088 30551602194811,4528860725614746,799069823975939363,
%U A049088 165374947602000265231,39654053930039468491521,10900817711883556591556906,3404265715022353551494548021,1198175785461867097633422235713
%N A049088 Number of n X n matrices with nonnegative integer entries and every row and column sum <= 2.
%D A049088 R. P. Stanley, Enumerative Combinatorics, Cambridge, Vol. 2, 1999; see Problem 5.65(b).
%H A049088 Mikel Mcdaniel, <a href="/A049088/b049088.txt">Table of n, a(n) for n = 0..150</a>
%F A049088 Stanley gives an explicit generating function.
%F A049088 From _Vaclav Kotesovec_, Nov 07 2026: (Start)
%F A049088 a(n) ~ 2^(-1/4) * exp(1 + sqrt(8*n) - 2*n) * n^(2*n + 1/4) * (1 - 113/(48*sqrt(2*n))).
%F A049088 Recurrence: 8*a(n) = 4*n*(5*n + 1)*a(n-1) - 4*(n-1)^2*n*(4*n - 1)*a(n-2) + 2*(n-2)^2*(n-1)^2*(2*n^2 + 2*n + 1)*a(n-3) - (n-3)^2*(n-2)^2*(n-1)*n*(4*n - 3)*a(n-4) + (n-4)^2*(n-3)^2*(n-2)*(n-1)^2*n*a(n-5). (End)
%t A049088 nmax = 20; CoefficientList[Series[Exp[x*(3-x)/(2*(1-x))]/Sqrt[1-x] * Sum[x^k/k!^2*((1 - x/2)/(1 - x))^(2*k), {k, 0, nmax}], {x, 0, nmax}], x] * Range[0, nmax]!^2 (* _Vaclav Kotesovec_, Nov 07 2026 *)
%t A049088 (* Alternative: *)
%t A049088 nmax = 20; CoefficientList[Series[Exp[x*(3-x)/(2*(1-x))]/Sqrt[1-x] * BesselI[0, (2-x)*Sqrt[x]/(1-x)], {x, 0, nmax}], x] * Range[0, nmax]!^2 (* _Vaclav Kotesovec_, Nov 07 2026 *)
%Y A049088 Cf. A073178, A073179. Diagonal of A131235.
%K A049088 nonn,easy,nice,changed
%O A049088 0,2
%A A049088 _N. J. A. Sloane_, Jan 23 2000
