%S A078331 2,3,2,3,11,5,13,3,17,11,23,5,53,13,11,7,67,17,37,11,13,23,47,5,101,
%T A078331 53,53,13,59,11,61,17,23,67,29,17,73,37,53,11,83,13,173,23,19,47,281,
%U A078331 7,97,101,67,53,107,53,89,13,37,59,353,11,367,61,71,31,79,23,269,67,47,29
%N A078331 First prime such that p^2==1 (mod n).
%H A078331 Harvey P. Dale, <a href="/A078331/b078331.txt">Table of n, a(n) for n = 1..1000</a>
%e A078331 a(2)=3 because 3^2=9==1 (mod 2), while 2^2==0 (mod 2).
%t A078331 Join[{2},Table[Module[{k=2},While[PowerMod[k,2,n]!=1,k=NextPrime[k]];k],{n,2,70}]] (* _Harvey P. Dale_, Sep 06 2026 *)
%o A078331 (PARI) for (n=1,100, forprime(p=2,1000,if ((p^2-1)%n==0,print1(p","); break)))
%K A078331 nonn,changed
%O A078331 1,1
