%T A305729 934,958,1006,1094,1126,1142,1174,1382,1438,1678,1718,1726,1774,1822,
%U A305729 1934,1966,2038,2246,2374,2462,2566,2582,2606,2614,2638,2654,2734,2878,2966,2974,3046,3238,3446
%N A305729 Numbers k such that A000010(k) = A023900(k) and A000010(A023900(k)) = A023900(A000010(k)).
%C A305729 For known terms with n > 1:
%C A305729 - a(n) and phi(a(n)) are squarefree integers with an even number of prime factors. For example a(5) = 94 = 2 * 47, and phi(a(5)) = 46 = 2 * 23.
%C A305729 - When omega(a(n)) = omega(phi(a(n))) = 2 then a(n)/2 are the safe primes (see A005385).
%C A305729 - When omega(a(n)) = omega(phi(a(n))) = 2 then ((a(n)/2)-1)/2 = phi(a(n))/2 are the Sophie Germain primes (see A005384).
%H A305729 Amiram Eldar, <a href="/A305729/b305729.txt">Table of n, a(n) for n = 1..10000</a>
%e A305729 1 is a term because A000010(1) = A023900(2) and A000010(A023900(1)) = A023900(A000010(1)).
%t A305729 f[p_, e_] := 1 - p; d[1] = 1; d[n_] := Times @@ f @@@ FactorInteger[n]; Select[Range[5000], (d1 = d[#]) > 0 && (p1 = EulerPhi[#]) == d[#] && d[p1] == EulerPhi[d1] &] (* _Amiram Eldar_, Sep 08 2026 *)
%Y A305729 Cf. A000010, A023900, A005384, A005385.
