%I A087750 #14 Aug 01 2026 17:07:15
%S A087750 1,2,3,5,6,10,13,19,24,33,41,56,68,90,111,143,172,219,263,328,392,483,
%T A087750 573,700,823,993,1166,1396,1626,1936,2249,2655,3070,3603,4151,4848,
%U A087750 5562,6461,7395,8548,9741,11219,12754,14624,16578,18943,21415,24388
%N A087750 Number of partitions of n into numbers of the form 2^i - 2^j with i > j.
%C A087750 Numbers of the form 2^i - 2^j with i > j are the nonzero terms of A023758 and have a binary representation consisting of 1 or more 1's followed by 0 or more 0's.
%C A087750 a(n) <= A000041(n), a(n) < A000041(n) for n >= 5 -> '101'.
%H A087750 Robert Israel, <a href="/A087750/b087750.txt">Table of n, a(n) for n = 1..10000</a>
%H A087750 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/Partition.html">Partition</a>
%H A087750 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/PartitionFunctionP.html">Partition Function P</a>
%e A087750 n=8, the 8th partition number is 22: three (5+3, 5+2+1 and 5+1+1+1) do not count, as 5 = '101', therefore a(8)=19.
%p A087750 Q:= [seq(seq(2^m-2^k,k=m-1..0,-1),m=1..30)]:
%p A087750 g:= proc(n,kmax)
%p A087750   option remember;
%p A087750   local k,j;
%p A087750   if kmax <= 1 or n<=1 then return 1 fi;
%p A087750   k:= min(n,kmax);
%p A087750   k:= Q[ListTools:-BinaryPlace(Q,k+1)];
%p A087750   add(procname(n-j*k,k-1),j=0..floor(n/k))
%p A087750 end proc:
%p A087750 seq(g(n,n),n=1..100); # _Robert Israel_, Jul 27 2026
%Y A087750 Cf. A023758, A007088.
%K A087750 nonn,changed
%O A087750 1,2
%A A087750 _Reinhard Zumkeller_, Oct 02 2003
