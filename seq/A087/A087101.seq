%S A087101 0,0,0,0,1,1,0,1,1,3,0,3,1,2,3,3,1,4,0,6,2,1,0,10,3,4,4,5,1,14,0,8,1,
%T A087101 3,3,12,1,1,3,15,1,10,0,3,8,1,0,23,1,9,2,7,1,13,5,11,2,3,0,35,1,1,7,
%U A087101 20,5,5,0,7,1,11,0,36,1,3,8,3,1,12,0,36,12,3
%N A087101 Number of symmetric quartic graphs on n nodes.
%C A087101 Graphs are simple and undirected, and are counted up to isomorphism. Here "symmetric" means vertex- and edge-transitive; half-arc-transitive graphs are included. - _Eric W. Weisstein_, Oct 29 2026
%C A087101 Both connected and disconnected graphs are included. Every such graph is a disjoint union of isomorphic connected symmetric quartic graphs. - _Eric W. Weisstein_, Oct 29 2026
%C A087101 The counts through n = 640 are obtained from the complete arc-transitive and half-arc-transitive censuses of Potocnik, Spiga and Verret. - _Eric W. Weisstein_, Oct 29 2026
%H A087101 Eric W. Weisstein, <a href="/A087101/b087101.txt">Table of n, a(n) for n = 1..640</a>
%H A087101 P. Potocnik, <a href="https://graphsym.net/">Datasets of Highly Symmetric Objects</a>.
%H A087101 P. Potocnik, P. Spiga and G. Verret, <a href="https://users.fmf.uni-lj.si/potocnik/work_datoteke/Census4val-640.mgm">Arc-transitive tetravalent graph census through 640 vertices</a>; <a href="https://users.fmf.uni-lj.si/potocnik/ATDcensus-OnLine/Census-HAT-1k-data.csv">Half-arc-transitive graph census through 1000 vertices</a>.
%H A087101 P. Potocnik, P. Spiga and G. Verret, <a href="https://arxiv.org/abs/1010.2546">Bounding the order of the vertex-stabiliser in 3-valent vertex-transitive and 4-valent arc-transitive graphs</a>, arXiv:1010.2546 [math.CO], 2010; J. Combin. Theory Ser. B 111 (2015), 148-180.
%H A087101 P. Potocnik, P. Spiga and G. Verret, <a href="https://arxiv.org/abs/1201.5317">Cubic vertex-transitive graphs on up to 1280 vertices</a>, arXiv:1201.5317 [math.CO], 2012; J. Symbolic Comput. 50 (2013), 465-477.
%H A087101 P. Potocnik, P. Spiga and G. Verret, <a href="https://arxiv.org/abs/1310.6543">A census of 4-valent half-arc-transitive graphs and arc-transitive digraphs of valence two</a>, arXiv:1310.6543 [math.CO], 2013; Ars Math. Contemp. 8 (2015), 133-148.
%H A087101 Eric Weisstein's World of Mathematics, <a href="https://mathworld.wolfram.com/QuarticSymmetricGraph.html">Quartic Symmetric Graph</a>.
%H A087101 S. Wilson and P. Potocnik, <a href="https://jan.ucc.nau.edu/~swilson/C4FullSite/index.html">A Census of Edge-Transitive Tetravalent Graphs</a>; <a href="https://jan.ucc.nau.edu/~swilson/C4FullSite/BigTable.html">Table</a>.
%F A087101 a(n) = Sum_{d|n} A401566(d) = A401566(n) + A401567(n). - _Eric W. Weisstein_, Oct 29 2026
%e A087101 a(10) = 3: two connected graphs and the disjoint union of two copies of K_5. - _Eric W. Weisstein_, Oct 29 2026
%t A087101 Module[{arc, hat, c},
%t A087101 	arc = Counts[StringCases[Import["https://users.fmf.uni-lj.si/potocnik/work_datoteke/Census4val-640.mgm", "Text"], "AT4val[" ~~ n : DigitCharacter .. :> FromDigits[n]]];
%t A087101 	hat = Counts[Rest[Import["https://users.fmf.uni-lj.si/potocnik/ATDcensus-OnLine/Census-HAT-1k-data.csv"]][[All, 2]]];
%t A087101 	c = Lookup[arc, Range[640], 0] + Lookup[hat, Range[640], 0];
%t A087101 	Table[Total[c[[Divisors[n]]]], {n, 640}]
%t A087101 ] (* _Eric W. Weisstein_, Oct 29 2026 *)
%Y A087101 Cf. A401566 (connected).
%Y A087101 Cf. A401567 (disconnected).
%K A087101 nonn,changed
%O A087101 1,10
%A A087101 _Eric W. Weisstein_, Aug 10 2003
%E A087101 Additional terms from _Eric W. Weisstein_, Oct 29 2026
