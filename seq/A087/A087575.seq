%N A087575 Smallest prime p such that 2+p^n is a prime, or 0 if no such prime exists.
%C A087575 If n is even, then a(n) is either 3 or 0. - _Robert Israel_, Oct 19 2026
%H A087575 Robert Israel, <a href="/A087575/b087575.txt">Table of n, a(n) for n = 1..1000</a>
%e A087575 a(2)=a(3)=a(4)=3, as 3^2 + 2, 3^3 + 2, 3^4 + 2 are all prime.
%p A087575 f:= proc(n) local p,q;
%p A087575    if n::even then if isprime(3^n+2) then return 3 else return 0 fi fi;
%p A087575    p:= 2;
%p A087575    do
%p A087575      p:= nextprime(p);
%p A087575      q:= p^n+2;
%p A087575      if isprime(q) then return p fi;
%p A087575   od;
%p A087575 end proc:
%p A087575 map(f, [$1..100]); # _Robert Israel_, Oct 19 2026
%o A087575 (PARI) for(j=1,50, forprime (i=1,50000,if(isprime(i^j+2),print1(i,",");break())))
%K A087575 nonn,changed
%O A087575 1,1
