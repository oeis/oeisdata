%U A394515 9133780827770488,224013625463486888,5817301917823018863,159459274558492328034,4601022224438345458974,139395312100275648890541
%N A394515 Number of mixed partitions of an n-element set with at least one unlabeled block and at least one labeled block.
%H A394515 Michael De Vlieger, <a href="/A394515/b394515.txt">Table of n, a(n) for n = 0..424</a>
%H A394515 Daniel Yaqubi and Madjid Mirzavaziri, <a href="https://arxiv.org/abs/2608.07293">Arithmetic Properties of Mixed Stirling Numbers of the Second Kind</a>, arxiv:2608.07293 [math.CO], 2026.
%H A394515 Daniel Yaqubi and Madjid Mirzavaziri, <a href="https://arxiv.org/abs/2608.30097">Prime and Touchard Congruences of Mixed-Type Bell Numbers</a>, arXiv:2608.30097 [math.CO], 2026. See p. 13 (Table 5).
%F A394515 a(n) = Sum_{r=2..n} r! * (Sum_{m=1..r-1} 1/m!) * StirlingS2(n, r).
%F A394515 E.g.f.: (exp(x)-1)*(exp(exp(x)-1)-1)/(2-exp(x)).
%e A394515 For n=3, a(3) = 2!*(1/1!)*Stirling2(3,2) + 3!*(1/1! + 1/2!)*Stirling2(3,3) = 15.
%t A394515 TB[n_] := Sum[Factorial[m + k]/Factorial[m] * StirlingS2[n, m + k], {m, 1, n - 1}, {k, 1, n - m}];
%t A394515 Table[TB[n], {n, 0, 21}]
%o A394515 (PARI) seq(n)=my(g=(exp(x + O(x^n))-1)); Vec(serlaplace(g*(exp(g)-1)/(1-g)), -n-1) \\ _Andrew Howroyd_, Sep 09 2026
