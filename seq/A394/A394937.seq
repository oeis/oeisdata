%T A394937 7,14,21,24,28,30,35,36,42,49,8,16,24,32,35,36,40,42,48,49,56,64,9,18,
%U A394937 27,36,40,45,48,49,54,56,63,64,72,81,10,20,30,40,50,54,60,63,64,70,72,80,81,90,100
%N A394937 Irregular triangle T(n,k) read by rows: row n lists in increasing order the distinct entries m of the n X n multiplication table that can be written in the form (n-u)*(n-v), where 1 <= u <= v, u+v <= n, and u*v <= n.
%C A394937 The number of entries in row n is A091627(n) = (A006218(n) + A000196(n) - 2)/2.
%C A394937 The entries in row n are a subset of the products counted by A398590(n). Also, A091627(n) < A398590(n) for n >= 4.
%C A394937 Every prime p occurs exactly once in the triangle, as the first entry of row p+1.
%H A394937 Frédéric D. W. Heidenthal-König, <a href="https://doi.org/10.5281/zenodo.21328264">Across Bases</a>, Zenodo, 2026.
%H A394937 Frédéric D. W. Heidenthal-König, <a href="https://doi.org/10.5281/zenodo.19102497">The Support of the Euclidean Decomposition of the Multiplication Table</a>, Zenodo, 2026.
%H A394937 Frédéric D. W. Heidenthal-König, <a href="/A394937/a394937.png">Square-grid display of the positive-indexed support sequence A394016 for n = 256, with the positions corresponding to row 256 of A394937 highlighted</a>.
%F A394937 Row n is the increasing list of elements of the set {(n-u)*(n-v): 1 <= u <= v, u+v <= n, u*v <= n}.
%F A394937 If m = (n-y)*n + x with 1 <= x,y <= n, then m occurs in row n iff z^2 - y*z + x has positive integer roots.
%F A394937 Equivalently, m occurs in row n iff y^2 - 4*x is a nonnegative perfect square.
%F A394937 T(n, 1) = n-1.
%F A394937 T(n, A091627(n)) = (n-1)^2 = A000290(n-1).
%F A394937 T(n, A091627(n)) = T(n+1, A091627(n+1)-2) = (n-1)^2 for n >= 3. Equivalently, the last entry of row n is the third-last entry of row n+1.
%e A394937 Rows for n = 2 to 10:
%e A394937    n=2: 1;
%e A394937    n=3: 2, 4;
%e A394937    n=4: 3, 4, 6, 9;
%e A394937    n=5: 4, 8, 9, 12, 16;
%e A394937    n=6: 5, 10, 12, 15, 16, 20, 25;
%e A394937    n=7: 6, 12, 18, 20, 24, 25, 30, 36;
%e A394937    n=8: 7, 14, 21, 24, 28, 30, 35, 36, 42, 49;
%e A394937    n=9: 8, 16, 24, 32, 35, 36, 40, 42, 48, 49, 56, 64;
%e A394937   n=10: 9, 18, 27, 36, 40, 45, 48, 49, 54, 56, 63, 64, 72, 81;
%e A394937   ...
%o A394937 (Python)
%o A394937 def row(n):
%o A394937     values = set()
%o A394937     for u in range(1, n + 1):
%o A394937         for v in range(u, n + 1):
%o A394937             if u + v <= n and u * v <= n:
%o A394937                 values.add((n - u) * (n - v))
%o A394937     return sorted(values)
%o A394937 terms = []
%o A394937 for n in range(2, 12):
%o A394937     terms.extend(row(n))
%o A394937 print(terms)
%Y A394937 Cf. A394016, A398590, A000290.
%Y A394937 Cf. A091627 (row lengths), A006218, A000196.
%K A394937 nonn,tabf,changed
