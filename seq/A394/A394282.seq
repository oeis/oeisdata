%I A394282 #15 Sep 14 2026 00:04:43
%S A394282 2,3,2,5,3,7,2,3,2,11,2,13,5,2,17,3,19,2,23,2,5,3,7,29,31,2,2,2,2,37,
%T A394282 2,41,3,43,3,47,2,7,53,3,59,61,2,5,11,67,2,71,2,73,5,79,2,3,83,89,13,
%U A394282 2,97,101,103,107,109,113,11,3,5,3,127,2,2,2,131,2,3,2,137,139
%N A394282 a(n) is the largest prime p such that A284665(n) = p^i + p^j with i, j > 0.
%H A394282 Robert Israel, <a href="/A394282/b394282.txt">Table of n, a(n) for n = 1..10000</a>
%p A394282 N:= 300: # for terms corresponding to terms <= N of A284665.
%p A394282 p:= N/2+1:
%p A394282 while p > 2 do
%p A394282   p:= prevprime(p);
%p A394282   for i from 1 while 2*p^i <= N do
%p A394282     for j from i do
%p A394282       v:= p^i + p^j;
%p A394282       if v > N then break fi;
%p A394282       if not assigned(T[v]) then T[v]:= p fi;
%p A394282 od od od:
%p A394282 map(t -> T[t], sort(map(op,[indices(T)]))); # _Robert Israel_, Sep 10 2026
%o A394282 (PARI) lista(limit) = my(v=vector(limit), vp=vector(limit)); for(n=1, limit, forprime(p=2, n/2, for(k=1, logint(n\2, 2), for(j=k, logint(n, 2), if(n-p^k==p^j, v[n]++; vp[n]=p ))))); for(n=1, limit, if(v[n]>0, print1(vp[n], ", ")));
%Y A394282 Cf. A284665, A284667.
%K A394282 nonn,changed
%O A394282 1,1
%A A394282 _Michel Marcus_, Apr 13 2026
