%N A394742 a(n) = number of triples (x, y, z) such that x^2 + y*z = n, where x < y < z are primes.
%H A394742 Antti Karttunen, <a href="/A394742/b394742.txt">Table of n, a(n) for n = 0..20000</a>
%e A394742 a(1362) = 4 counts these triples: (5, 7, 191), (7, 13, 101), (11, 17, 73), (17, 29, 37).
%e A394742 a(212) = 2 counts these two triples: (3, 7, 29), (5, 11, 17), and is the first point where the sequence attains value larger than 1. - _Antti Karttunen_, Nov 26 2026
%t A394742 t[n_, c_] := Module[{r}, r = Flatten[Table[If[n - x^2 <= 0, {},
%t A394742        Map[({x, #, Quotient[n - x^2, #]} &),
%t A394742        Select[Divisors[n - x^2], Divisible[n - x^2, #] &]]], {x, 1,
%t A394742        Floor[Sqrt[n - 1]]}], 1]; Select[r, Apply[c, #] &]];
%t A394742 c = (#1 < #2 && #2 < #3 && PrimeQ[#1] && PrimeQ[#2] && PrimeQ[#3] &); Table[{n, t[n, c]}, {n, 1, 30}]
%t A394742 Join[{0}, Table[Length[t[n, c]], {n, 1, 130}]]
%t A394742 (* _Peter J. C. Moses_, Mar 29 2026 *)
%o A394742 (PARI) A394742(n) = if(!n, 0, my(r, s=0); forprime(x=2,sqrtint(n-1), r = n - (x^2); forprime(y=x+1,sqrtint(r), if(!(r%y) && (y < (r/y)) && isprime(r/y), s++))); (s)); \\ _Antti Karttunen_, Nov 26 2026
