%U A394732 11116712473,19932794912,34647071560,58558172324,96487250498,155347652550,244882989111,378611450006,575020279367,859061019988,1264003479362
%N A394732 Number of transitive relations on an n-set with at most five ordered pairs.
%H A394732 <a href="/index/Rec#order_11">Index entries for linear recurrences with constant coefficients</a>, signature (11,-55,165,-330,462,-462,330,-165,55,-11,1).
%F A394732 a(n) = 1 + A000290(n) + A349919(n) + A349927(n) + A349849(n) + A348634(n).
%F A394732 From _Elmo R. Oliveira_, Nov 01 2026: (Start)
%F A394732 G.f.: (1 + x) * (1 - 10*x + 56*x^2 - 102*x^3 + 845*x^4 + 800*x^5 + 4026*x^6 + 2990*x^7 + 5048*x^8 + 1466*x^9) / (1 - x)^11.
%F A394732 E.g.f.: (1/5!) * (5! + 5!*x + 5*5!*x^2 + 2360*x^3 + 5815*x^4 + 6831*x^5 + 4147*x^6 + 1380*x^7 + 255*x^8 + 25*x^9 + x^10) * exp(x).
%F A394732 a(n) = (n^10 - 20*n^9 + 225*n^8 - 1560*n^7 + 7150*n^6 - 21774*n^5 + 43375*n^4 - 53660*n^3 + 37209*n^2 - 10826*n + 5!) / 5!.
%F A394732 a(n) = 11*a(n-1)-55*a(n-2)+165*a(n-3)-330*a(n-4)+462*a(n-5)-462*a(n-6)+330*a(n-7)-165*a(n-8)+55*a(n-9)-11*a(n-10)+a(n-11). (End)
%e A394732 a(2) = 13 because all 13 transitive relations on a 2-set have at most 5 (actually less than 5) ordered pairs.
%Y A394732 Cf. A000290, A348634, A349849, A349919, A349927.
