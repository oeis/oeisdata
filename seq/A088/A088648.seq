%I A088648 #15 Sep 07 2026 14:10:08
%S A088648 1,5,11,15,19,25,35,45,55,65,75,85,95,105,115,125,135,145,155,165,175,
%T A088648 185,195,205,215,225,235,245,255,265,275,285,295,305,315,325,335,345,
%U A088648 355,365,375,385,395,405,415,425,435,445,455,465,475,485,495,505,515
%N A088648 a(1) = 1, then the smallest odd number not occurring earlier such that the concatenation a(r), a(s) is composite for all s > r.
%C A088648 The sequence is infinite with trivial terms of the form 10k+5. Subsidiary sequence: sequence of nontrivial terms. Conjecture: the subsidiary sequence is infinite.
%H A088648 Chris R. Rehmann, <a href="/A088648/b088648.txt">Table of n, a(n) for n = 1..10000</a>
%e A088648 a(5) = 19 as 119, 519, 1119, and 1519 are all composite.
%o A088648 (MATLAB)
%o A088648 N = 55; a = NaN(1,N); a(1) = 1; k = 3; j = 2;
%o A088648 while any(isnan(a))
%o A088648     x = k+a(1:j-1)*10^ceil(log10(k));
%o A088648     if any(x>flintmax), break, end
%o A088648     if all(~isprime(x))
%o A088648         a(j) = k; j = j+1;
%o A088648     end
%o A088648     k = k+2;
%o A088648     if mod(k,10)==5
%o A088648         a(j) = k; j = j+1; k = k+2;
%o A088648     end
%o A088648 end
%o A088648 disp(regexprep(num2str(a), ' +', ', ')) % _Chris R. Rehmann_, Sep 06 2026
%o A088648 (Python)
%o A088648 from sympy import isprime
%o A088648 from itertools import count, islice
%o A088648 def cond(strk, strlst): return all(not isprime(int(si+strk)) for si in strlst)
%o A088648 def agen(): # generator of terms
%o A088648     an, aset, astrlst = 1, set(), []
%o A088648     while True:
%o A088648         yield an; aset.add(an); astrlst.append(str(an))
%o A088648         an = next(k for k in count(an+2, 2) if k not in aset and cond(str(k), astrlst))
%o A088648 print(list(islice(agen(), 55))) # _Michael S. Branicky_, Sep 07 2026
%Y A088648 Cf. A088647, A017329.
%K A088648 base,nonn,changed
%O A088648 1,2
