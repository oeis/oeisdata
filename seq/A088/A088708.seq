%I A088708 #35 Nov 26 2026 20:35:39
%S A088708 6,10,15,22,57,85,87,142,187,217,235,267,274,295,339,382,505,565,579,
%T A088708 589,667,694,799,835,849,862,889,922,1059,1111,1159,1317,1339,1555,
%U A088708 1569,1797,1969,1977,2122,2182,2217,2227,2229,2245,2319,2335,2359,2497,2577
%N A088708 Numbers m which are a product of two primes p and q such that m+p-q and m-p+q are both primes.
%C A088708 In other words, numbers m which are a product of two distinct primes p and q such that n+-d are primes, where d is the difference between p and q.
%C A088708 The neighbors are (p-1)*(q+1)+1 and (p+1)*(q-1)+1. If 5 < p < q, then m == 1, 7 or 19 (mod 30). - _Bruno Paiva Viana_, Nov 17 2026
%H A088708 Robert Israel, <a href="/A088708/b088708.txt">Table of n, a(n) for n = 1..10000</a>
%e A088708 217 is a term because 217 has only one pair of prime factors (7 and 31) and both 217+7-31 and 217-7+31 (193 and 241) are primes.
%p A088708 N:= 10^4: # for terms <= N
%p A088708 P:= select(isprime, [2,seq(i,i=3..N,2)]):
%p A088708 S:= {}:
%p A088708 for i from 2 to nops(P) do
%p A088708   for j from 1 to i-1 do
%p A088708     m:= P[i]*P[j];
%p A088708     if m > N then break fi;
%p A088708     if isprime(m+P[i]-P[j]) and isprime(m-P[i]+P[j]) then S:= S union {m} fi
%p A088708 od od:
%p A088708 sort(convert(S,list)); # _Robert Israel_, Nov 26 2026
%t A088708 pdpQ[{a_,b_}]:=Module[{d=b-a},AllTrue[a*b+{d,-d},PrimeQ]]; With[{upto = 2600}, Select[ Times@@@Select[Subsets[Prime[Range[upto/2]],{2}],pdpQ]// Union, #<=upto&]] (* _Harvey P. Dale_, Aug 02 2016 *)
%Y A088708 Cf. A001358.
%K A088708 nonn,changed
%O A088708 1,1
