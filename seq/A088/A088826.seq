%S A088826 12,42,1242,6137440,1385119360,1588268480,479535318548480,
%T A088826 983990190817280,528322308638228480,1374972658786140160,
%U A088826 9222951307429806080,13732480001814200320,248248256622696037089280
%N A088826 Numbers k such that sigma(k)-2*k = phi(k): abundance of k equals Eulerphi of k.
%C A088826 29053620223944172891013120 is the next term of the form 2^k*5*p*q where p&q are distinct primes. 12, 42 and 1242 are the only terms of one of the three forms 4*p, 2*p*q and 2*p^3*q where p and q are two distinct primes. _Farideh Firoozbakht_, Aug 19 2013
%e A088826 n=1242, sigma(1242)=2880, 2880-2484=396=phi(1242).
%t A088826 Do[If[Equal[DivisorSigma[1, n]-2*n, EulerPhi[n]], Print[n]], {n, 1, 10000000}]
%o A088826 (PARI) isok(k) = sigma(k)-2*k == eulerphi(k); \\ _Michel Marcus_, Oct 31 2025
%Y A088826 Cf. A000203, A000010, A077374, A033880.
%Y A088826 Solutions to sigma(m) = 2*m + k*phi(m): A008578 (k=-1), A000396 (k=0), A088826 (k=1), A099650 (k=2), A392691 (k=3), A392692 (k=4), A392693 (k=5).
