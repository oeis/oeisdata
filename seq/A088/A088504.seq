%T A088504 261836,521968,1038884,2044440,4029984,7607296,15306272,27305280,
%U A088504 53360192,77448960,201334784,268451840,536870912,0,4294967294,8589934524,17179868060,34359724016,68719358924,137437949512
%N A088504 Sum of even entries in row n of Pascal's triangle.
%H A088504 G. C. Greubel, <a href="/A088504/b088504.txt">Table of n, a(n) for n = 0..1000</a>
%F A088504 a(n) = 0 iff n = 2^k - 1.
%F A088504 A088560(n) = a(n) iff n = 2^k - 2, k > 1.
%F A088504 A088560(n) > a(n) iff n = 2^k - 1.
%F A088504 a(n) = 2^n - A088560(n).
%F A088504 a(n) = A088560(n) + A085814(n).
%t A088504 f[n_] := Plus @@ Select[ Table[ Binomial[n, i], {i, 0, n}], EvenQ[ # ] & ]; Table[ f[n], {n, 0, 35}] (* _Robert G. Wilson v_, Nov 19 2003 *)
%o A088504 (Magma)
%o A088504 b:= func< n,k | (Binomial(n,k) mod 2) eq 0 select Binomial(n,k) else 0 >;
%o A088504 A088504:= func< n | (&+[b(n,k): k in [0..n]]) >;
%o A088504 [A088504(n): n in [0..40]]; // _G. C. Greubel_, Nov 19 2026
%o A088504 (SageMath)
%o A088504 @CachedFunction
%o A088504 def b(n,k):
%o A088504     if binomial(n,k)%2==0: return binomial(n,k)
%o A088504     else: return 0
%o A088504 def A088504(n): return sum(b(n,k) for k in range(n+1))
%o A088504 print([A088504(n) for n in range(1,41)]) # _G. C. Greubel_, Nov 19 2026
%Y A088504 Cf. A048967, A085814, A088560.
%Y A088504 Cf. A000225, A000918.
