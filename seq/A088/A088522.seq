%S A088522 2,1,4,1,6,12,2,10,19,0,11,23,36,7,22,38,55,12,31,51,72,15,38,62,87,
%T A088522 12,39,67,96,13,44,76,109,4,39,75,112,150,22,62,103,145,188,39,84,130,
%U A088522 177,2,51,101,152,204,16,70,125,181,238,25,84,144,205,267,23,87,152,218,285
%N A088522 a(1) = 2; for n > 1, a(n) = (a(n-1) + n) mod prime(n).
%H A088522 Harvey P. Dale, <a href="/A088522/b088522.txt">Table of n, a(n) for n = 1..1000</a>
%t A088522 a[1]= 2; a[n_]:= a[n]= Mod[a[n-1] + n, Prime[n]]; Table[a[n], {n, 67}]
%t A088522 (* Alternative: *)
%t A088522 nxt[{n_,a_}]:={n+1,Mod[a+n+1,Prime[n+1]]}; NestList[nxt,{1,2},70][[;;,2]] (* _Harvey P. Dale_, Jul 19 2023 *)
%o A088522 (Magma)
%o A088522 A088522:= func< n | n eq 1 select 2 else ($$(n-1) + n) mod NthPrime(n) >;
%o A088522 [A088522(n): n in [1..200]]; // _G. C. Greubel_, Nov 15 2026
%o A088522 (PARI)
%o A088522 A088522(n) = if(n==1, 2, (A088522(n-1)+n)%prime(n));
%o A088522 vector(100, n, A088522(n)) \\ _G. C. Greubel_, Nov 15 2026
%o A088522 (SageMath)
%o A088522 def A088522(n):
%o A088522     if n==1: return 2
%o A088522     else: return (A088522(n-1) + n)%nth_prime(n)
%o A088522 print([A088522(n) for n in range (1,101)]) # _G. C. Greubel_, Nov 15 2026
