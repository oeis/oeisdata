%I A088492 #17 Nov 26 2026 23:11:24
%S A088492 2,3,4,5,3,7,2,9,3,11,3,13,2,15,3,17,3,19,3,21,3,23,3,25,3,27,3,29,3,
%T A088492 31,3,33,3,35,3,37,3,39,3,41,3,43,3,45,3,47,3,49,3,51,3,53,3,55,3,57,
%U A088492 3,59,3,61,3,63,3,65,3,67,3,69,3,71,3,73,3,75,3,77,3,79,3,81,3,83,3,85,3,87
%N A088492 a(2*n+1) = 2*n+1, a(2*n) = floor(2*n/A005185(n)), a weighted inverse of Hofstadter's Q-sequence.
%C A088492 Define a sequence of partial products of Hofstadter's Q-sequence, H(n) = Product_{i=1..n} A005185(i) = 1, 1, 2, 6, 18, 72, 360, 1800,.. for n>=1 (which differs from A004395).
%C A088492 The original definition was equivalent to a(n) = [n * H([(n-1)/2])/H([n/2])], where [..] is the floor function.
%C A088492 A consequence of this construction is a(2*n+1) = 2*n+1 at the odd indices. At the even indices, a(2*n) = [2*n*H(n-1)/H(n)] = [2*n/A005185(n)], which is used to simplify the definition.
%C A088492 a(2*n) = 3 for 8 <= n <= 48. The first 5 at an even index occurs at a(2*193) = 5.
%H A088492 G. C. Greubel, <a href="/A088492/b088492.txt">Table of n, a(n) for n = 2..10000</a>
%t A088492 Hof[n_]:= Hof[n] = If[n<3, 1, Hof[n -Hof[n-1]] +Hof[n -Hof[n-2]]]; (* Hof = A005185 *)
%t A088492 A088492[n_]:= A088492[n]= If[EvenQ[n], Floor[n/Hof[Floor[n/2]]], n];
%t A088492 Table[A088492[n], {n,2,90}] (* modified from original form by _G. C. Greubel_, Nov 21 2026 *)
%o A088492 (Magma)
%o A088492 m:=90;
%o A088492 A005185:=[n le 2 select 1 else Self(n-Self(n-1))+Self(n-Self(n-2)): n in [1..m+5]];
%o A088492 A088492:= function(n)
%o A088492     if (n mod 2) eq 0 then return Floor(n/A005185[Floor(n/2)]);
%o A088492     else return n;
%o A088492     end if;
%o A088492 end function;
%o A088492 [A088492(n): n in [2..m]]; // _G. C. Greubel_, Nov 21 2026
%o A088492 (SageMath)
%o A088492 @CachedFunction
%o A088492 def A005185(n):
%o A088492     if (n<3): return 1
%o A088492     else: return A005185(n -A005185(n-1)) + A005185(n -A005185(n-2))
%o A088492 def A088492(n):
%o A088492     if n%2==0: return floor(n/A005185(n/2))
%o A088492     else: return n
%o A088492 print([A088492(n) for n in range(2,90)]) # _G. C. Greubel_, Nov 21 2026
%Y A088492 Cf. A005185.
%K A088492 nonn,changed
%O A088492 2,1
