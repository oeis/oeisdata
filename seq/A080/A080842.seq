%U A080842 18,6,2,3,1,18,6,2,3,1,6,2,3,1,20,21,7,8,9,3,1,21,7,8,9,3,1,7,8,9,3,1,23,24
%N A080842 Triangle read by rows: trajectory of n under the map if x is divisible by 3 then divide by 3, otherwise add 1 with each row terminating when 1 is reached.
%C A080842 These numbers converge to various last-3-digit endings and only two last-2-digit numbers: 2,1 or 3,1.
%C A080842 Every row terminates at 1.
%C A080842 Apart from n=1, the starting value of the trajectory is not included. - _Sean A. Irvine_, Oct 24 2026
%e A080842 Triangle begins:
%e A080842   1;
%e A080842   3, 1;
%e A080842   1
%e A080842   5, 6, 2, 3, 1;
%e A080842   6, 2, 3, 1;
%e A080842   2, 3, 1;
%e A080842   8, 9, 3, 1;
%e A080842   ...
%t A080842 Join[{1},Flatten[Table[Rest[NestWhileList[If[Divisible[#,3],#/3,#+1]&,n, #!=1&]],{n,2,30}]]] (* _Harvey P. Dale_, Feb 02 2012 *)
%o A080842 (PARI) mult3p1(n, p) = { print1(1" "); for(j=1, n, x=j; while(x>1, if(x%3==0, x/=3, x = x*p+1 ) ; print1(x" ") ; ); ) ; print1(" ") ; }
%o A080842 { mult3p1(30,1) ; } \\ _R. J. Mathar_, Feb 01 2008
%Y A080842 Cf. A080828, A067433.
