%I A080454 #10 Jul 31 2026 23:49:32
%S A080454 0,10,21,3212,43210,543210,6543215,76543216,87654321,9876543210,
%T A080454 109876543216,11109876543216,1211109876543216,131211109876543214,
%U A080454 14131211109876543210,1514131211109876543216,1615141312111098765432108
%N A080454 Smallest multiple of n beginning with the backward concatenation of numbers from (n-1) to 1.
%H A080454 Robert Israel, <a href="/A080454/b080454.txt">Table of n, a(n) for n = 1..368</a>
%p A080454 bcat:= proc(n) option remember;
%p A080454   local r;
%p A080454   r:= procname(n-1);
%p A080454   n*10^(1+ilog10(r))+r
%p A080454 end proc:
%p A080454 bcat(1):= 1: bcat(0):= 0:
%p A080454 f:= proc(n) local r,rm,d,w;
%p A080454   r:= bcat(n-1);
%p A080454   rm:= r mod n;
%p A080454   if rm = 0 then return r fi;
%p A080454   for d from 1 do
%p A080454     w:= -10^d*rm mod n;
%p A080454     if w < 10^d then return 10^d*r + w fi
%p A080454   od;
%p A080454 end proc:
%p A080454 map(f, [$1..20]); # _Robert Israel_, Jul 30 2026
%K A080454 base,nonn
%O A080454 1,2
%A A080454 _Amarnath Murthy_, Feb 23 2003
%E A080454 Corrected and extended by Antonio G. Astudillo (afg_astudillo(AT)lycos.com), Jul 04 2003
