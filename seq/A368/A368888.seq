%S A368888 1,1,5,19,305,1976,54613,494901,19460545,226000855,11535280901,
%T A368888 163226844144,10246715573041,170910034261721,12736193619206485,
%U A368888 244588264748170651,21100437309369290497,458426839205360652760,44935948904379592796101,1089502959858914644843965,119602747025485355544487601
%N A368888 a(n) = Sum_{k=0..floor(n/2)} n^(2*k) * binomial(n-k,k).
%C A368888 a(n) is the permanent of the n X n symmetric tridiagonal Toeplitz matrix M with the elements on the diagonals equal to 1, except M(n,n-1) = M(n-1,n) = n. For n > 1, A080322 gives the values of the determinant. - _Stefano Spezia_, Aug 01 2026
%F A368888 a(n) = [x^n] 1/(1 - x - (n*x)^2).
%F A368888 a(n) ~ (exp(1/2) + (-1)^n*exp(-1/2)) * n^n / 2. - _Vaclav Kotesovec_, Jan 09 2024
%t A368888 Table[Hypergeometric2F1[1/2 - n/2, -n/2, -n, -4*n^2], {n, 0, 20}] (* _Vaclav Kotesovec_, Jan 09 2024 *)
%o A368888 (PARI) a(n) = sum(k=0, n\2, n^(2*k)*binomial(n-k, k));
