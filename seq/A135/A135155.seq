%N A135155 Decimal expansion of e*Pi*phi/5, where phi = (1 + sqrt(5))/2.
%H A135155 G. C. Greubel, <a href="/A135155/b135155.txt">Table of n, a(n) for n = 1..2000</a>
%F A135155 From _G. C. Greubel_, Nov 11 2026: (Start)
%F A135155 Equals e*Pi*(1 + sqrt(5))/10 = (A001113 * A000796 * A001622)/5.
%F A135155 Equals (A019609 * A001622)/5 = (A001113 * A094886)/5 = (A094885 * A000796)/5.
%F A135155 Equals A131563/5. (End)
%e A135155 2.763516045435...
%t A135155 RealDigits[(E Pi GoldenRatio)/5, 10, 200][[1]] (* _G. C. Greubel_, Sep 29 2016 *)
%o A135155 (Magma)
%o A135155 m:= 250; R:=RealField(m+2); SetDefaultRealField(R);
%o A135155 c:= Exp(1)*Pi(R)*(1+Sqrt(5))/10;
%o A135155 Prune(Reverse(IntegerToSequence(Round( c*10^m )))); // _G. C. Greubel_, Nov 11 2026
%o A135155 (SageMath)
%o A135155 m=250
%o A135155 c=numerical_approx( exp(1)*pi*(1+sqrt(5))/10 , digits=m+5)
%o A135155 print([ZZ(i) for i in c.str()[:-5] if i.isdigit()]) # _G. C. Greubel_, Nov 11 2026
%Y A135155 Cf. A000796 (Pi), A001113 (e), A001622 (phi), A019609 (e*Pi), A094885 (e*phi), A094886 (Pi*phi), A131563.
%K A135155 cons,nonn,changed
%O A135155 1,1
%A A135155 _Omar E. Pol_, Nov 26 2007
