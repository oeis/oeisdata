%I A210391 #63 Nov 07 2026 12:13:09
%S A210391 1,1,0,1,1,0,1,2,1,0,1,3,4,1,0,1,4,9,6,1,0,1,5,16,19,9,1,0,1,6,25,44,
%T A210391 39,12,1,0,1,7,36,85,116,69,16,1,0,1,8,49,146,275,260,119,20,1,0,1,9,
%U A210391 64,231,561,751,560,189,25,1,0,1,10,81,344,1029,1812,1955,1100,294,30,1,0
%N A210391 Number A(n,k) of semistandard Young tableaux over all partitions of n with maximal element <= k; square array A(n,k), n>=0, k>=0, read by antidiagonals.
%C A210391 From _Rajmohan Kookkal_, Nov 06 2026: (Start)
%C A210391 A(n,k) is the degree-n complete-graph denumerant coefficient: the coefficient of x^n in G_{K_k}(x) = 1 / ((1 - x)^k * (1 - x^2)^binomial(k,2)).
%C A210391 A(n,k) is also the number of sub-multigraph configurations of total weight n on the complete graph K_k, where the k vertices have weight 1 and the binomial(k,2) edges have weight 2.
%C A210391 Equivalently, the number of nonnegative integer solutions to Sum_{i=1..k} v_i + 2 * Sum_{1 <= i < j <= k} e_{i,j} = n.
%C A210391 For any fixed n, row n is given by a polynomial P_n(k) in k of degree n (for k >= 0). The generating function satisfies G_{K_{-k}}(-x) = G_{K_k}(x), which proves the combinatorial reciprocity P_n(-k) = (-1)^n * P_n(k). Thus row n is an even polynomial in k for even n, and an odd polynomial for odd n.
%C A210391 (End)
%H A210391 Alois P. Heinz, <a href="/A210391/b210391.txt">Antidiagonals n = 0..140, flattened</a>
%H A210391 FindStat - Combinatorial Statistic Finder, <a href="https://www.findstat.org/CollectionsDatabase/SemistandardTableaux/">Semistandard Young tableaux</a>
%H A210391 Y. Teranishi, <a href="https://doi.org/10.1017/S0027763000022728">The ring of invariants of matrices</a>, Nagoya Math. J., 104 (1986), 149-161.
%H A210391 Wikipedia, <a href="https://en.wikipedia.org/wiki/Young_tableau">Young tableau</a>
%F A210391 G.f. of column k: 1/((1-x)^k*(1-x^2)^(k*(k-1)/2)).
%F A210391 A(n,k) = Sum_{i=0..k} C(k,i) * A138177(n,k-i). - _Alois P. Heinz_, Apr 06 2015
%F A210391 A(n,k) = Sum_{j=0..floor(n/2)} binomial(k + n - 2*j - 1, n - 2*j) * binomial(binomial(k,2) + j - 1, j). - _Rajmohan Kookkal_, Nov 06 2026
%e A210391 Square array A(n,k) begins:
%e A210391   1,  1,   1,   1,   1,    1,    1, ...
%e A210391   0,  1,   2,   3,   4,    5,    6, ...
%e A210391   0,  1,   4,   9,  16,   25,   36, ...
%e A210391   0,  1,   6,  19,  44,   85,  146, ...
%e A210391   0,  1,   9,  39, 116,  275,  561, ...
%e A210391   0,  1,  12,  69, 260,  751, 1812, ...
%e A210391   0,  1,  16, 119, 560, 1955, 5552, ...
%p A210391 h:= (l, k)-> mul(mul((k+j-i)/(1+l[i] -j +add(`if`(l[t]>=j, 1, 0)
%p A210391                  , t=i+1..nops(l))), j=1..l[i]), i=1..nops(l)):
%p A210391 g:= proc(n, i, k, l)
%p A210391       `if`(n=0, h(l, k), `if`(i<1, 0, g(n, i-1, k, l)+
%p A210391       `if`(i>n, 0, g(n-i, i, k, [l[], i]))))
%p A210391     end:
%p A210391 A:= (n, k)-> `if`(n=0, 1, g(n, n, k, [])):
%p A210391 seq(seq(A(n, d-n), n=0..d), d=0..12);
%p A210391 # Alternative:
%p A210391 gf:= k-> 1/((1-x)^k*(1-x^2)^(k*(k-1)/2)):
%p A210391 A:= (n, k)-> coeff(series(gf(k), x, n+1), x, n):
%p A210391 seq(seq(A(n, d-n), n=0..d), d=0..12);
%t A210391 h[l_, k_] := Product[Product[(k+j-i)/(1+l[[i]]-j + Sum[If[l[[t]] >= j, 1, 0], {t, i+1, Length[l]}]), {j, 1, l[[i]]}], {i, 1, Length[l]}]; g [n_, i_, k_, l_] := If[n == 0, h[l, k], If[i < 1, 0, g[n, i-1, k, l] + If[i > n, 0, g[n-i, i, k, Append[l, i]]]]]; a[n_, k_] := If[n == 0, 1, g[n, n, k, {}]]; Table[Table[a[n, d-n], {n, 0, d}], {d, 0, 12}] // Flatten (* _Jean-François Alcover_, Dec 09 2013, translated from Maple *)
%t A210391 (* Alternative: *)
%t A210391 gf[k_] := 1/((1-x)^k*(1-x^2)^(k*(k-1)/2)); a[n_, k_] := Coefficient[Series[gf[k], {x, 0, n+1}], x, n]; Table[Table[a[n, d-n], {n, 0, d}], {d, 0, 12}] // Flatten (* _Jean-François Alcover_, Dec 09 2013, translated from Maple *)
%o A210391 (Python)
%o A210391 from math import comb
%o A210391 def A(n, k):
%o A210391     if k == 0:
%o A210391         return 1 if n == 0 else 0
%o A210391     if k == 1:
%o A210391         return 1  # Fixes the ValueError caused by math.comb(-1, 0)
%o A210391     edges = k * (k - 1) // 2
%o A210391     return sum(comb(k + n - 2*j - 1, n - 2*j) * comb(edges + j - 1, j) for j in range(n // 2 + 1))
%o A210391 print([A(n, d - n) for d in range(13) for n in range(d + 1)])
%o A210391 # _Rajmohan Kookkal_, Nov 06 2026
%Y A210391 Rows n=0-10 give: A000012, A001477, A000290, A005900, A139594, A210427, A210428, A210429, A210430, A210431, A210432.
%Y A210391 Columns k=0-8 give: A000007, A000012, A002620(n+2), A038163, A054498, A181477, A181478, A181479, A181480.
%Y A210391 Main diagonal gives: A209673.
%Y A210391 Cf. A138177, A191714.
