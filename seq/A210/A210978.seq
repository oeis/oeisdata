%N A210978 A186029 and positive terms of A001106 interleaved.
%C A210978 Vertex number of a square spiral similar to A118277.
%H A210978 Paolo Xausa, <a href="/A210978/b210978.txt">Table of n, a(n) for n = 0..10000</a>
%H A210978 <a href="/index/Rec#order_05">Index entries for linear recurrences with constant coefficients</a>, signature (1,2,-2,-1,1).
%F A210978 From _Colin Barker_, Sep 15 2013: (Start)
%F A210978 a(n) = (3*(-1+(-1)^n)+2*(5+(-1)^n)*n+14*n^2)/16.
%F A210978 a(n) = a(n-1)+2*a(n-2)-2*a(n-3)-a(n-4)+a(n-5).
%F A210978 G.f.: -x*(2*x^2+4*x+1) / ((x-1)^3*(x+1)^2). (End)
%t A210978 A210978[n_] := (3*(# - 1) + 2*n*(7*n + # + 5))/16 & [(-1)^n];
%t A210978 Array[A210978, 60, 0] (* _Paolo Xausa_, Sep 09 2026 *)
%t A210978 (* Alternative: *)
%t A210978 LinearRecurrence[{1, 2, -2, -1, 1}, {0, 1, 5, 9, 17}, 60] (* _Paolo Xausa_, Sep 09 2026 *)
