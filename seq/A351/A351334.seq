%N A351334 a(n) = Sum_{k=0..n} k! * (-k)^k * Stirling2(n,k).
%H A351334 Alois P. Heinz, <a href="/A351334/b351334.txt">Table of n, a(n) for n = 0..233</a>
%F A351334 E.g.f.: Sum_{k>=0} (k * (1 - exp(x)))^k.
%p A351334 b:= proc(n, m) option remember; `if`(n=0,
%p A351334       m!*(-m)^m, m*b(n-1, m)+b(n-1, m+1))
%p A351334     end:
%p A351334 a:= n-> b(n, 0):
%p A351334 seq(a(n), n=0..17);  # _Alois P. Heinz_, Sep 30 2026
%o A351334 (PARI) a(n) = sum(k=0, n, k!*(-k)^k*stirling(n, k, 2));
%o A351334 (PARI) my(N=20, x='x+O('x^N)); Vec(serlaplace(sum(k=0, N, (k*(1-exp(x)))^k)))
