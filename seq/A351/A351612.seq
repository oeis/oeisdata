%T A351612 4,12,2,4,4,9,2,8,2,7,7,4,2,12,4,7,4,7,2,10,4,9,4,4,2,13,2,4,7,11,4,8,
%U A351612 2,7,4,8,2,15,2,4,7,7,4,8,2,12,8,4,2,13,4,4,4,9,2,13
%N A351612 Number of ordered pairs, (s,t), 1 <= s <= t, such that (t^s) | n.
%H A351612 Robert Israel, <a href="/A351612/b351612.txt">Table of n, a(n) for n = 1..10000</a>
%F A351612 a(n) = Sum_{(t^s)|n, 1<=s<=t<=n} 1.
%e A351612 a(9) = 4; The ordered pairs are (1,1), (1,3), (1,9), (2,3).
%e A351612 a(36) = 12; The ordered pairs are (1,1), (1,2), (1,3), (1,4), (1,6), (1,9), (1,12), (1,18), (1,36), (2,2), (2,3), (2,6).
%p A351612 f:= proc(n) local count,t,s;
%p A351612    count:= 0:
%p A351612    for t in NumberTheory:-Divisors(n) do
%p A351612      for s from 1 to t do
%p A351612        if n mod t^s = 0 then count:= count+1 else break fi
%p A351612    od od;
%p A351612    count
%p A351612 end proc:
%p A351612 map(f, [$1..100]); # _Robert Israel_, Nov 09 2026
%K A351612 nonn,changed
%O A351612 1,2
