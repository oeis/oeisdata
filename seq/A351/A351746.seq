%T A351746 22,28,28,30,5,24,34,20,18,36,38,28,22,40,36,42,34,20,46,46,18,12,19,
%U A351746 36,40,52,16,28,30,40,58,58,44,60,62,26,6,32,52,66,52,48,44,70,25,72,74
%N A351746 a(n) = Sum_{p|n, p prime} (p-1) * tau(n/p).
%C A351746 Dirichlet convolution of (n-1)*c(n) and tau(n), where c = A010051. - _Wesley Ivan Hurt_, Nov 09 2026
%H A351746 Robert Israel, <a href="/A351746/b351746.txt">Table of n, a(n) for n = 1..10000</a>
%F A351746 a(n) = A351711(n) - A248577(n).
%F A351746 a(n) = Sum_{d|n} (d-1) * tau(n/d) * c(d), where c = A010051. - _Wesley Ivan Hurt_, Nov 09 2026
%e A351746 a(12) = 10; a(12) = Sum_{p|12, p prime} (p-1) * tau(12/p) = (2-1)*tau(12/2) + (3-1)*tau(12/3) = tau(6) + 2*tau(4) = 4 + 2*3 = 10.
%p A351746 f:= proc(n) local p; uses NumberTheory;
%p A351746      add((p-1)*tau(n/p), p = PrimeFactors(n))
%p A351746 end proc:
%p A351746 map(f, [$1..100]); # _Robert Israel_, Nov 09 2026
%o A351746 (PARI) a(n) = my(f=factor(n)); sum(k=1, #f~, (f[k,1]-1)*numdiv(n/f[k,1])); \\ _Michel Marcus_, Feb 18 2022
%Y A351746 Cf. A000005 (tau), A001221 (omega), A010051, A248577, A351711.
