%T A351613 1,11,1,2,1,7,1,8,1,5,1,3,1,10,1,4,1,5,1,7,1,5,1,4,1,17,1,2,1,4,1,8,1,
%U A351613 4,1,8,1,14,1,2,1,4,1,8,1,8,1,4,1,15,1,2,1,7,1,15
%N A351613 Number of pairs of divisors of n, (d1,d2) d1<=d2, such that d1+d2 is prime.
%C A351613 a(n) = 1 if and only if n is odd. - _Robert Israel_, Nov 09 2026
%H A351613 Robert Israel, <a href="/A351613/b351613.txt">Table of n, a(n) for n = 1..10000</a>
%F A351613 a(n) = Sum_{d1|n, d2|n, d1<=d2} c(d1 + d2), where c is the prime characteristic (A010051).
%e A351613 a(12) = 7; The pairs are (1,1), (1,2), (1,4), (1,6), (1,12), (2,3), (3,4).
%p A351613 f:= proc(n) local D,i,j;
%p A351613    D:= NumberTheory:-Divisors(n);
%p A351613    nops(select(t -> isprime(t[1]+t[2]), [seq(seq([D[i],D[j]],j=1..i),i=1..nops(D))]))
%p A351613 end proc:
%p A351613 map(f, [$1..100]); # _Robert Israel_, Nov 09 2026
%Y A351613 Cf. A010051.
%K A351613 nonn,changed
%O A351613 1,2
