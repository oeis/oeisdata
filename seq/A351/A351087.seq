%I A351087 #25 Oct 07 2026 16:45:02
%S A351087 0,1,7,8,16,25,80,91,161,175,203,343,392,440,539,588,616,968,1100,
%T A351087 1225,1331,1333,1337,1375,1400,2556,3025,3773,5112,5875,6655,7280,
%U A351087 7668,8281,8575,8600,9604,9800,10224,10820,10868,11011,11492,12595,12980,13013,15925,17303,17576,17875,20449,22308,23677,24067,24167
%N A351087 Numbers k such that A327860(k) is a multiple of k, where A327860 is the arithmetic derivative of the primorial base exp-function.
%C A351087 From _Antti Karttunen_, Sep 28 2026: (Start)
%C A351087 Sequence A276085(A400171(.)) sorted into ascending order.
%C A351087 It seems that A328620(.), when computed for these terms, i.e., the number of nonleading 0-digits (in primorial base) stays quite small. Among the initial 10320 terms, the number of terms having k=0..5 nonleading zeros are: 1357, 5248, 3056, 597, 58, 4 and none with more than 5 nonleading zeros.
%C A351087 Conjecture: For all terms k, A328581(k) = 1 <=> k = A327860(k). This is equal to the conjecture given in A400171. But compare also to the refuted conjecture given in A380527.
%C A351087 (End)
%H A351087 Antti Karttunen, <a href="/A351087/b351087.txt">Table of n, a(n) for n = 1..10320</a>
%H A351087 <a href="/index/Pri#primorialbase">Index entries for sequences related to primorial base</a>.
%e A351087 0 is included as a term, because A327860(0) = 0 is a multiple of 0.
%e A351087 1 is included, because A327860(1) = 1 is a multiple of 1.
%e A351087 16 is included, because A327860(16) = 240 = 15*16.
%t A351087 Select[Range[25000], Block[{i, m, n = #, p}, m = i = 1; While[n > 0, p = Prime[i]; m *= p^Mod[n, p]; n = Quotient[n, p]; i++]; # == GCD[#, If[m < 2, 0, m Total[#2/#1 & @@@ FactorInteger[m]]]]] &] (* _Michael De Vlieger_, Feb 04 2022 *)
%o A351087 (PARI)
%o A351087 A327860(n) = { my(s=0, m=1, p=2, e); while(n, e = (n%p); m *= (p^e); s += (e/p); n = n\p; p = nextprime(1+p)); (s*m); };
%o A351087 isA351087(n) = (!n || !(A327860(n)%n));
%Y A351087 Fixed points of A351083.
%Y A351087 Cf. A003415, A276085, A276086, A327860, A328581, A400171.
%Y A351087 Cf. A328110 (a subsequence).
%Y A351087 Cf. also A380527.
%K A351087 nonn,changed
%O A351087 1,3
%A A351087 _Antti Karttunen_, Feb 03 2022
%E A351087 Name edited by _Antti Karttunen_, Sep 23 2026
