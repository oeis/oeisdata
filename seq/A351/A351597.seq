%I A351597 #26 Nov 09 2026 11:59:57
%S A351597 11,1481,27701,165701,317921,326141,397751,558791,585911,661091,
%T A351597 716411,739391,959831,1015361,1022501,1068701,1156031,1161401,1246361,
%U A351597 1265861,1461401,1514321,1917731,1940711,2183921,2188871,2296871,2725781,2896931,3058871,3075341
%N A351597 Primes p such that the 6 consecutive primes starting with p are congruent to 11, 13, 17, 19, 23, 29 (modulo 30) in this order.
%C A351597 All terms are congruent to 11 (modulo 30) by definition.
%H A351597 Robert Israel, <a href="/A351597/b351597.txt">Table of n, a(n) for n = 1..2000</a>
%e A351597 The six consecutive primes starting with 1481: 1481, 1483, 1487, 1489, 1493, 1499 are congruent to 11, 13, 17, 19, 23, 29 (modulo 30) in this order.
%p A351597 filter:= proc(p) local q;
%p A351597    if not isprime(p) then return false fi;
%p A351597    q:= nextprime(p); if q mod 30 <> 13 then return false fi;
%p A351597    q:= nextprime(q); if q mod 30 <> 17 then return false fi;
%p A351597    q:= nextprime(q); if q mod 30 <> 19 then return false fi;
%p A351597    q:= nextprime(q); if q mod 30 <> 23 then return false fi;
%p A351597    q:= nextprime(q); q mod 30 = 29
%p A351597 end proc:
%p A351597 select(filter, [seq(p,p=11 .. 4000000,30)]); # _Robert Israel_, Nov 09 2026
%t A351597 Select[Partition[Prime[Range[222000]], 6, 1], Mod[#, 30] == {11, 13, 17, 19, 23, 29} &][[;; , 1]] (* _Amiram Eldar_, May 03 2022 *)
%Y A351597 Subsequence of A132232.
%K A351597 nonn,changed
%O A351597 1,1
%A A351597 _Zak Seidov_, May 02 2022
