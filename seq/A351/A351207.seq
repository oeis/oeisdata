%I A351207 #23 Sep 23 2026 01:07:00
%S A351207 1,3,2,7,4,8,2,9,4,12,2,22,4,8,6,11,2,18,2,24,8,10,2,32,8,10,6,22,4,
%T A351207 32,2,15,8,10,8,48,4,10,8,32,4,28,2,24,12,8,2,40,2,22,4,24,2,28,8,34,
%U A351207 8,12,2,80,4,8,16,19,14,34,2,26,8,32,2,72,4,10,12,26,6,30,2,42
%N A351207 Number of ordered pairs of divisors of n whose sum is squarefree.
%C A351207 From _Robert Israel_, Sep 22 2026: (Start)
%C A351207 One such ordered pair is (1,1).  If n has an odd prime factor p, then (p,p) is another, while if n is even (1,2) and (2,1) are two more.  Thus a(n) >= 2 for all n >= 2, with a(n) >= 3 if n is even.
%C A351207 If n is in A049098, then a(n) = 2. For composites n with a(n) = 2, see A400307.
%C A351207 (End)
%H A351207 Robert Israel, <a href="/A351207/b351207.txt">Table of n, a(n) for n = 1..10000</a>
%F A351207 a(n) = Sum_{d1|n, d2|n} mu(d1 + d2)^2.
%e A351207 a(6) = 8; There are 8 ordered pairs of divisors of 6 whose sum is squarefree: (1,1), (1,2), (1,6), (2,1), (2,3), (3,2), (3,3), (6,1).
%p A351207 f:= proc(n) uses NumberTheory; local D,  P, i,j,t;
%p A351207   D:= Divisors(n);
%p A351207   t:= 0;
%p A351207   for i from 1 to nops(D) do
%p A351207     for j from 1 to i do
%p A351207       if IsSquareFree(D[i]+D[j]) then
%p A351207         if i=j then t:= t+1 else t:= t+2 fi
%p A351207       fi
%p A351207   od od;
%p A351207   t
%p A351207 end proc:
%p A351207 map(f, [$1..100]); # _Robert Israel_, Sep 22 2026
%t A351207 a[n_] := Count[Tuples[Divisors[n], 2], _?(SquareFreeQ[Total[#]] &)]; Array[a, 80] (* _Amiram Eldar_, Feb 05 2022 *)
%o A351207 (PARI) a(n) = my(d=divisors(n)); sum (i=1, #d, sum (j=1, #d, issquarefree(d[i]+d[j]))); \\ _Michel Marcus_, Feb 05 2022
%Y A351207 Cf. A008683 (mu), A005117 (squarefree), A008966, A049098, A400307.
%K A351207 nonn,changed
%O A351207 1,2
%A A351207 _Wesley Ivan Hurt_, Feb 04 2022
